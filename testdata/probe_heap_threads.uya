// testdata/probe_heap_threads.uya — P26 探针：工具链的堆**不能**支持两条线程并发 malloc/free
//
//   UYA_ROOT=/home/winger/uya-0.10/lib/ UYA_SPLIT_C_DIR=build/uyacache \
//     /home/winger/uya-0.10/bin/uya build testdata/probe_heap_threads.uya -o testdata/probe_heap_threads
//   for i in $(seq 1 8); do timeout 30 testdata/probe_heap_threads; echo "rc=$?"; done
//     → 8/8 崩：`free(): double free detected in tcache 2`（SIGABRT 134）或 SIGSEGV 139
//   PROBE_BIG=1（8 KiB 块，绕过 per-thread tcache 走大块路径）
//   PROBE_WARM=1（两条线程都先 pthread_current_heap_cache() 预热）
//     → 四种组合全崩，**与块大小、预热无关**
//
// 这是 P26 从「进程内两条线程」退回「单线程 + 泵点加密」的**唯一原因**：
// libc/heap.uya 是工具链自带的分配器（per-thread tcache + 一把全局自旋锁），
// 实测在两条线程各自 malloc/free（没有任何指针共享！）时就会把堆写坏；
// 而界面渲染与 agent 组请求都必然要分配内存，所以进程内分线程在这套工具链上不成立。
// 相关：probe_thx_mutex.uya（连 pthread mutex 在对称争用下也会丢唤醒）。
//
// 本文件是证据，不进 SRC 列表，单独 build。
// 探针：并发 malloc/free 崩在哪 —— (a) 每线程先「预热」heap cache；(b) 分配块超过 tcache 上限
use libc.pthread;
use libc.syscall;
use libc.heap;

var g_done: atomic i32 = 0;
var g_size: usize = 200;
var g_iters: i32 = 40000;

fn w(p: &const byte, n: usize) void {
    _ = sys_write(1, p as *const byte, n) catch {};
}

fn conc_main(arg: &void) &void {
    _ = arg;
    // 预热：先拿到本线程的 heap cache（拿不到也没关系，走全局锁那条路）
    const c: &pthread_heap_cache_t = pthread_current_heap_cache();
    if c == null as &pthread_heap_cache_t {
        w("worker: no-cache\n", 18);
    }
    var i: i32 = 0;
    while i < g_iters {
        const p: &void = malloc(g_size);
        if p != null {
            free(p);
        }
        i = i + 1;
    }
    g_done = 1;
    return null;
}

export fn main() i32 {
    var warm: bool = false;
    var big: bool = false;
    const e1: &byte = getenv("PROBE_WARM" as *const byte);
    if (e1 as usize) != 0 && e1[0] == 49 as byte {
        warm = true;
    }
    const e2: &byte = getenv("PROBE_BIG" as *const byte);
    if (e2 as usize) != 0 && e2[0] == 49 as byte {
        big = true;
        g_size = 8192;
    }
    if warm {
        const c: &pthread_heap_cache_t = pthread_current_heap_cache();
        if c == null as &pthread_heap_cache_t {
            w("main: no-cache\n", 16);
        }
    }
    var th: pthread_t = pthread_t{ tid: 0, stack: null, stack_size: 0, detached: 1, exited: 0, result: null, start_routine: null, arg: null };
    if pthread_create(&th, null as &const pthread_attr_t, &conc_main as &void, null as &void) != 0 {
        w("spawn-fail\n", 11);
        return 1;
    }
    var i: i32 = 0;
    while i < g_iters {
        const p: &void = malloc(g_size);
        if p != null {
            free(p);
        }
        i = i + 1;
    }
    var nap: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 2000000 };
    var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    var guard: i32 = 0;
    while g_done == 0 && guard < 2000 {
        _ = sys_nanosleep(&nap, &rem) catch {};
        guard = guard + 1;
    }
    if g_done == 0 {
        w("heap: WORKER-STUCK\n", 19);
        return 2;
    }
    w("heap: ok\n", 9);
    return 0;
}
