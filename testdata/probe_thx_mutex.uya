// testdata/probe_thx_mutex.uya — P26 探针：uya 0.10 的 pthread mutex 在**对称争用**下会不会挂
//
// 复现步骤（本文件是证据，不进 SRC 列表，单独 build）：
//   UYA_ROOT=/home/winger/uya-0.10/lib/ UYA_SPLIT_C_DIR=build/uyacache \
//     /home/winger/uya-0.10/bin/uya build testdata/probe_thx_mutex.uya -o testdata/probe_thx_mutex
//   PROBE_MUTEX=normal  timeout 20 testdata/probe_thx_mutex   # 普通锁：4/4 挂（等不到 worker）
//   PROBE_MUTEX=recursive timeout 20 testdata/probe_thx_mutex # 递归锁：2/3 挂
//
// 现场：两条线程各做 2 万次 lock/increment/unlock，**对称争用**。挂的时候纯阻塞、
// CPU 几乎为 0（都在 futex_wait 里）。换成本项目自己的 futex 锁（见 probe_thx_lock.uya）
// 同一负载 5/5 通过。
//
// 根因（读 src 之外的 stdlib 源码就能对上）：
//   * 递归锁：等待者 `futex_wait(&state, 1)`（只等「值变成 1」），而解锁在 state 从 1 → 0 时
//     **故意不 wake**（只有 `prev != 1` 才 wake）—— 先睡下的等待者再也醒不过来。
//   * 普通锁：那份两态协议的慢路径在对称争用下也会丢唤醒（本探针就是现场）。
// 所以 threadx.uya 的 ThxMutex/ThxCond 是自实现的（普通两态 futex 锁 + 自建 cond）。
use libc.pthread;
use libc.syscall;

var g_m: pthread_mutex_t = pthread_mutex_t{ state: 0, owner: 0, type: 0 };
var g_t: i64 = 0;
var g_done: atomic i32 = 0;

fn w(p: &const byte, n: usize) void {
    _ = sys_write(1, p as *const byte, n) catch {};
}

fn worker(arg: &void) &void {
    _ = arg;
    var i: i32 = 0;
    while i < 20000 {
        _ = pthread_mutex_lock(&g_m);
        g_t = g_t + 1;
        _ = pthread_mutex_unlock(&g_m);
        i = i + 1;
    }
    g_done = 1;
    return null;
}

export fn main() i32 {
    const mode: &byte = getenv("PROBE_MUTEX" as *const byte);
    var recursive: bool = false;
    if (mode as usize) != 0 {
        if mode[0] == 114 as byte {   // 'r'
            recursive = true;
        }
    }
    if recursive {
        var attr: pthread_mutexattr_t = pthread_mutexattr_t{ type: PTHREAD_MUTEX_RECURSIVE };
        _ = pthread_mutex_init(&g_m, &attr);
        w("probe: recursive mutex, symmetric contention\n", 44);
    } else {
        _ = pthread_mutex_init(&g_m, null as &const pthread_mutexattr_t);
        w("probe: normal mutex, symmetric contention\n", 41);
    }
    var th: pthread_t = pthread_t{ tid: 0, stack: null, stack_size: 0, detached: 1, exited: 0, result: null, start_routine: null, arg: null };
    const cr: i32 = pthread_create(&th, null as &const pthread_attr_t, &worker as &void, null as &void);
    if cr != 0 {
        w("create-fail\n", 12);
        return 1;
    }
    var i: i32 = 0;
    while i < 20000 {
        _ = pthread_mutex_lock(&g_m);
        g_t = g_t + 1;
        _ = pthread_mutex_unlock(&g_m);
        i = i + 1;
    }
    var nap: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 2000000 };
    var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    var guard: i32 = 0;
    while g_done == 0 && guard < 3000 {
        _ = sys_nanosleep(&nap, &rem) catch {};
        guard = guard + 1;
    }
    if g_done == 0 {
        w("probe: WORKER-STUCK (lost wakeup under symmetric contention)\n", 58);
        return 2;
    }
    if g_t != 40000 {
        w("probe: COUNT-WRONG\n", 19);
        return 3;
    }
    w("probe: ok\n", 10);
    return 0;
}
