// src/tools.uya — 三个工具：read_file / write_file / run_shell
//
// 设计要点：
//   * 工具内部任何失败都不抛错，一律写成文本结果回给模型（让它自己纠正）；
//   * 路径相对 --workspace 解析，拒绝绝对路径与含 ".." 的路径（best-effort 防手滑，不是安全边界）；
//   * run_shell 用 fork + pipe + dup2 + execve(/bin/sh -c)，带 poll 超时 → SIGKILL。

use libc.syscall;
use libc.unistd;
use libc.fcntl;
use libc.heap;
use libc.signal;
use std.runtime.saved_envp;
use std.string.strlen;

const TOOL_READ_MAX: usize = 65536;
const TOOL_WRITE_CHUNK: usize = 32768;

fn tool_err(out: &Buf, msg: &const byte) void {
    _ = buf_append_cstr(out, "error: ");
    _ = buf_append_cstr(out, msg);
}

// -------------------- 路径安全 / 拼接 --------------------
fn path_is_safe(rel: &const byte, rel_len: usize) bool {
    if rel_len == 0 {
        return false;
    }
    if rel[0] == '/' as byte {
        return false;   // 绝对路径
    }
    // 逐段检查 ".."（也拒绝以 ~ 开头的路径）
    if rel[0] == '~' as byte {
        return false;
    }
    var i: usize = 0;
    while i < rel_len {
        // 段起点
        const seg_start: usize = i;
        while i < rel_len && rel[i] != '/' as byte {
            i = i + 1;
        }
        const seg_len: usize = i - seg_start;
        if seg_len == 2 && rel[seg_start] == '.' as byte && rel[seg_start + 1] == '.' as byte {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// workspace + "/" + rel
fn path_join(ws: &const byte, ws_len: usize, rel: &const byte, rel_len: usize, out: &Buf) bool {
    if !buf_append(out, ws, ws_len) {
        return false;
    }
    if ws_len > 0 && ws[ws_len - 1] != '/' as byte {
        if !buf_append_byte(out, 47) {
            return false;
        }
    }
    if !buf_append(out, rel, rel_len) {
        return false;
    }
    return buf_append_byte(out, 0);
}

// 取 path 参数并拼成绝对路径；失败时向 out 写错误文本并返回 false
fn tool_resolve_path(cfg: &const Config, args: &JsonValue, out: &Buf, full: &Buf) bool {
    var rel: Buf = buf_empty();
    defer { buf_free(&rel); }
    if !js_obj_get_str_unescaped(args, "path", 4, &rel) || rel.len == 0 {
        tool_err(out, "missing string argument \"path\"");
        return false;
    }
    if !path_is_safe(rel.ptr as &const byte, rel.len) {
        tool_err(out, "unsafe path (absolute paths and \"..\" are rejected): ");
        _ = buf_append(out, rel.ptr, rel.len);
        return false;
    }
    if !path_join(cfg.workspace.ptr as &const byte, cfg.workspace.len, rel.ptr as &const byte, rel.len, full) {
        tool_err(out, "out of memory building path");
        return false;
    }
    return true;
}

// -------------------- read_file --------------------
export fn tool_read_file(cfg: &const Config, args: &JsonValue, out: &Buf) void {
    var full: Buf = buf_empty();
    defer { buf_free(&full); }
    if !tool_resolve_path(cfg, args, out, &full) {
        return;
    }
    const fd: i32 = sys_open(&full.ptr[0] as *const byte, O_RDONLY as i32, 0) catch {
        tool_err(out, "cannot open file: ");
        _ = buf_append(out, full.ptr, full.len - 1);
        return;
    };
    defer { _ = sys_close(fd) catch {}; }
    var chunk: [byte: 8192] = [0: 8192];
    var total: usize = 0;
    while total < TOOL_READ_MAX {
        const n: isize = sys_read(fd, &chunk[0], 8192) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        const un: usize = n as usize;
        if !buf_append(out, &chunk[0], un) {
            tool_err(out, "out of memory");
            return;
        }
        total = total + un;
    }
    if total >= TOOL_READ_MAX {
        _ = buf_append_cstr(out, "\n...[truncated at 64 KiB]");
    }
}

// -------------------- write_file --------------------
fn mkdir_parent(full_path: &Buf) bool {
    // 找到最后一个 '/'，创建该目录（一层）
    var i: usize = full_path.len;
    if i == 0 {
        return false;
    }
    i = i - 1;
    while i > 0 && full_path.ptr[i] != '/' as byte {
        i = i - 1;
    }
    if i == 0 {
        return false;
    }
    var dir: Buf = buf_new(i + 2);
    defer { buf_free(&dir); }
    if !buf_append(&dir, full_path.ptr, i) {
        return false;
    }
    if !buf_append_byte(&dir, 0) {
        return false;
    }
    _ = sys_mkdir(&dir.ptr[0] as *const byte, 493 as u32) catch {
        return false;   // 0755
    };
    return true;
}

fn write_all_fd(fd: i32, p: &const byte, n: usize) bool {
    var off: usize = 0;
    while off < n {
        const q: *const byte = @ptr_from_usize(@usize_from_ptr(p as &const void) + off) as *const byte;
        const w: isize = sys_write(fd, q, n - off) catch { 0 as isize; };
        if w <= 0 {
            return false;
        }
        off = off + (w as usize);
    }
    return true;
}

export fn tool_write_file(cfg: &const Config, args: &JsonValue, out: &Buf) void {
    var rel: Buf = buf_empty();
    defer { buf_free(&rel); }
    if !js_obj_get_str_unescaped(args, "path", 4, &rel) || rel.len == 0 {
        tool_err(out, "missing string argument \"path\"");
        return;
    }
    var content: Buf = buf_empty();
    defer { buf_free(&content); }
    if !js_obj_get_str_unescaped(args, "content", 7, &content) {
        tool_err(out, "missing string argument \"content\"");
        return;
    }
    if !path_is_safe(rel.ptr as &const byte, rel.len) {
        tool_err(out, "unsafe path (absolute paths and \"..\" are rejected)");
        return;
    }
    var full: Buf = buf_empty();
    defer { buf_free(&full); }
    if !path_join(cfg.workspace.ptr as &const byte, cfg.workspace.len, rel.ptr as &const byte, rel.len, &full) {
        tool_err(out, "out of memory building path");
        return;
    }
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    var fd: i32 = sys_open(&full.ptr[0] as *const byte, flags, 420) catch {
        -1;
    };
    if fd < 0 {
        // 父目录可能不存在：创建一层后重试
        if mkdir_parent(&full) {
            fd = sys_open(&full.ptr[0] as *const byte, flags, 420) catch {
                -1;
            };
        }
    }
    if fd < 0 {
        tool_err(out, "cannot create file: ");
        _ = buf_append(out, full.ptr, full.len - 1);
        return;
    }
    var ok: bool = true;
    var off: usize = 0;
    while off < content.len {
        var take: usize = content.len - off;
        if take > TOOL_WRITE_CHUNK {
            take = TOOL_WRITE_CHUNK;
        }
        const seg: &const byte = @ptr_from_usize(@usize_from_ptr(content.ptr as &void) + off) as &const byte;
        if !write_all_fd(fd, seg, take) {
            ok = false;
            break;
        }
        off = off + take;
    }
    _ = sys_close(fd) catch {};
    if !ok {
        tool_err(out, "write failed");
        return;
    }
    _ = buf_append_cstr(out, "wrote ");
    _ = buf_append_u64(out, content.len as u64);
    _ = buf_append_cstr(out, " bytes to ");
    _ = buf_append(out, full.ptr, full.len - 1);
}

// -------------------- run_shell --------------------
fn ua_now_ms() u64 {
    var tv: TimeVal = TimeVal{ tv_sec: 0, tv_usec: 0 };
    const r: !i32 = sys_gettimeofday(&tv, null as &void);
    _ = r catch {
        return 0 as u64;
    };
    return ((tv.tv_sec as u64) * (1000 as u64)) + ((tv.tv_usec as u64) / (1000 as u64));
}

fn i64_to_i32(v: i64) i32 {
    const r: !i32 = v as! i32;
    return r catch { -1; };
}

export fn tool_run_shell(cfg: &const Config, args: &JsonValue, out: &Buf) void {
    if !cfg.allow_shell {
        tool_err(out, "run_shell is disabled (started with --no-shell)");
        return;
    }
    var cmd: Buf = buf_empty();
    defer { buf_free(&cmd); }
    if !js_obj_get_str_unescaped(args, "command", 7, &cmd) || cmd.len == 0 {
        tool_err(out, "missing string argument \"command\"");
        return;
    }
    if !buf_append_byte(&cmd, 0) {
        tool_err(out, "out of memory");
        return;
    }
    var timeout_ms: u32 = cfg.shell_timeout_ms;
    var tv: JsonValue = JsonValue.json_null();
    if js_obj_get(args, "timeout_ms", 10, &tv) {
        var n: i64 = 0;
        if js_i64_of(&tv, &n) && n > 0 && n < 3600000 {
            timeout_ms = n as u32;
        }
    }

    var fds: [i32: 2] = [0: 2];
    sys_pipe2(&fds[0], 0) catch {
        tool_err(out, "pipe() failed");
        return;
    };
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(fds[0]) catch {};
        _ = sys_close(fds[1]) catch {};
        tool_err(out, "fork() failed");
        return;
    };
    if pid64 == 0 {
        // ---- 子进程：stdout/stderr 都接进管道，切到工作目录后 exec /bin/sh -c ----
        // P38：和 bash 工具同一条口径 —— 命令没有终端（stdin=/dev/null + 自成会话），并且顺手补上
        // P1 那条这里漏掉的信号处置重置（否则子进程收到 TERM 会去写父进程的终端）
        sigx_reset_for_child();
        sh_child_detach_stdio();
        _ = sys_close(fds[0]) catch {};
        _ = sys_dup2(fds[1], 1) catch {};
        _ = sys_dup2(fds[1], 2) catch {};
        _ = sys_close(fds[1]) catch {};
        var ws: Buf = buf_new(cfg.workspace.len + 1);
        if buf_valid(&ws) {
            _ = buf_append(&ws, cfg.workspace.ptr, cfg.workspace.len);
            _ = buf_append_byte(&ws, 0);
            _ = sys_chdir(&ws.ptr[0] as *const byte) catch {};
        }
        var sh: [byte: 4] = "sh";
        var dashc: [byte: 4] = "-c";
        var shpath: [byte: 8] = "/bin/sh";
        var argv: [&const byte: 4] = [&sh[0], &dashc[0], &cmd.ptr[0], null as &const byte];
        _ = sys_execve(&shpath[0], &argv[0], saved_envp) catch {};
        sys_exit(127);
    }
    // ---- 父进程 ----
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(fds[1]) catch {};
    var chunk: [byte: 8192] = [0: 8192];
    var pfds: [PollFd: 1] = [PollFd{ fd: fds[0], events: POLLIN, revents: 0 }];
    const started_ms: u64 = ua_now_ms();
    var timed_out: bool = false;
    var truncated: bool = false;
    var output_len: usize = 0;
    var done: bool = false;
    while !done {
        const pr: i32 = sys_poll(&pfds[0], 1, 100) catch { 0; };
        // 注意：子进程写完就退出时 poll 只给 POLLHUP（不给 POLLIN），
        // 漏掉它就是「命令早就结束、却一直读到超时」的经典 bug。
        if pr > 0 && ((pfds[0].revents & POLLIN) != 0 || (pfds[0].revents & POLLHUP) != 0 || (pfds[0].revents & POLLERR) != 0) {
            const n: isize = sys_read(fds[0], &chunk[0], 8192) catch { 0 as isize; };
            if n <= 0 {
                done = true;
            } else {
                const un: usize = n as usize;
                var i: usize = 0;
                while i < un {
                    if output_len < cfg.max_tool_out {
                        if !buf_append_byte(out, chunk[i]) {
                            done = true;
                            break;
                        }
                        output_len = output_len + 1;
                    } else {
                        truncated = true;
                    }
                    i = i + 1;
                }
            }
        }
        if !done && timeout_ms > 0 {
            // 墙钟超时：一直有输出的命令也不会跑飞
            const elapsed: u64 = ua_now_ms() - started_ms;
            if elapsed >= (timeout_ms as u64) {
                timed_out = true;
                // P38：按进程组收
                sh_kill_tree(pid);
                while true {
                    const n2: isize = sys_read(fds[0], &chunk[0], 8192) catch { 0 as isize; };
                    if n2 <= 0 {
                        break;
                    }
                }
                done = true;
            }
        }
    }
    _ = sys_close(fds[0]) catch {};
    var st: i32 = 0;
    _ = sys_waitpid(pid, &st, 0) catch {};
    const code: i32 = (st >> (8 as i32)) & 255;
    var head: Buf = buf_new(64);
    defer { buf_free(&head); }
    _ = buf_append_cstr(&head, "\nexit=");
    _ = buf_append_u64(&head, code as u64);
    if timed_out {
        _ = buf_append_cstr(&head, " (timeout, killed)");
    }
    if truncated {
        _ = buf_append_cstr(&head, " [output truncated]");
    }
    _ = buf_append(&out[0], head.ptr, head.len);
}
