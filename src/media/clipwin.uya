// src/media/clipwin.uya — 剪贴板来源之四：**Windows 系统剪贴板**（Win32）
//
// 本文件：把「用户眼前那块板子」从 Win32 的 `OpenClipboard` 读回来。两条腿 ——
//   ① 文本（`CF_UNICODETEXT`，回退 `CF_TEXT` 按 CP_ACP 转 UTF-8）：直接交字节；
//   ② 位图（`CF_DIB` / `CF_DIBV5`）：**Uya 侧**解析 BITMAPINFOHEADER、把 DIB 的
//      像素（BGR 序、可能自底向上、行按 4 字节对齐）转成标准库的 RGB 位图，
//      再用标准库的 JPEG 编码器压成一坨 `image/jpeg` 交出去。
//
// 不变量：
//   ① **不新造图片格式**：本仓只认 PNG/JPEG/GIF/WebP 四类（media/imgx 的
//      `imgx_sniff`），而标准库只有 JPEG 编码器 ⇒ 位图一律转 JPEG。这条不是取舍，
//      是「下游的 `imgx_check` 只吃认识的头」逼出来的；
//   ② **超限明确拒绝、绝不截断**：`CF_DIB` 超过 `CLIPW_MAX_DIB` 或编码缓冲不够
//      一律返回 `CLIPW_TOO_BIG`（半个 JPEG 发给模型只会换回一个坏请求）；
//   ③ **只认 24/32 位**：1/4/8 位是调色板图（要展开调色板），16 位是掩码压缩，
//      它们在真机剪贴板里几乎不出现（截图工具都给 32 位）——不认识就返回
//      `CLIPW_NONE` 让仲裁层落到文本腿，而不是猜出一种错颜色；
//   ④ 全程**不做像素变换**（不缩放、不锐化）：那是 media/imgz 的职责。
//
// 依赖：term/wincon（Win32 垫片的 Uya 面）、foundation/bufx（Buf）、
//   std.image.*（Image / jpeg_encode_q / jpeg_max_bytes）、std.mem.allocator。
// 命名：`clipwin_*`、`CLIPW_*`。
//
// 为什么 Windows 需要这一条**新的来源**：OSC 5522 是「问终端要剪贴板」，而 Windows
// 的控制台宿主（conhost，cmd.exe / PowerShell 都在里面）**不实现这条协议** ——
// DECRQM `ESC[?5522$p` 零应答，与 deepin-terminal 同款。于是 Windows 上
// 「终端协议」这条路永远是 `CLIPW_NONE`，必须有一条直接读系统剪贴板的腿，否则
// `Ctrl+V` 在 cmd / PowerShell 里就是「读不到剪贴板」。

use std.image.image.Image;
use std.image.image.image_new;
use std.image.image.image_free;
use std.image.jpeg_encode.jpeg_encode_q;
use std.image.jpeg_encode.jpeg_max_bytes;
use std.mem.allocator.get_allocator;
use std.mem.allocator.MallocAllocator;

// 结果码（与 CLIPT_/CLIPX_/CLIPH_ 保持同一套语义，仲裁层直译）
export const CLIPW_NONE: i32 = 0;          // 板子是空的 / 格式不认识
export const CLIPW_TEXT: i32 = 1;          // 读到文本
export const CLIPW_IMAGE: i32 = 2;         // 读到图片（mime 恒为 image/jpeg）
export const CLIPW_TOO_BIG: i32 = 3;       // 超过上限
export const CLIPW_ERR: i32 = 4;           // 打开剪贴板失败

// 文本上限：与 CLIPT_MAX_BYTES 的量级对齐（1 MiB 文本已经是「一本小书」）
const CLIPW_MAX_TEXT: usize = 1024 * 1024;
// DIB 上限：4K 截图（3840x2160x4B）≈ 33 MiB，留一倍余量。
// 为什么给这么宽：DIB 是**未压缩**的，比同画面的 PNG 大一个数量级；卡太小会让
// 「截图直接粘贴」这条最主要的用法失效。
const CLIPW_MAX_DIB: usize = 64 * 1024 * 1024;
// 位图的 JPEG 质量：与 imgz 的重编码同值（80），像素数受 imgx 的预算约束。
const CLIPW_QUALITY: i32 = 80;

// DIB 头里我们认识的压缩方式
const CLIPW_BI_RGB: u32 = 0;
const CLIPW_BI_BITFIELDS: u32 = 3;

// 小端读整数（DIB 全是小端；Windows 上 memcpy 到结构体也行，但那要 ABI 对齐，
// 这里逐字节取，跨平台也可测）。
fn clipw_u16(p: &const byte, off: usize) u32 {
    return ((p[off] as u32) | ((p[off + 1] as u32) << 8));
}

// 小端读 32 位（DIB 头里的宽/高/压缩方式都是 4 字节小端）。
fn clipw_u32(p: &const byte, off: usize) u32 {
    return ((p[off] as u32) |
        ((p[off + 1] as u32) << 8) |
        ((p[off + 2] as u32) << 16) |
        ((p[off + 3] as u32) << 24));
}

// 小端读 32 位并按有符号解释（`biHeight` 的负值表示「自顶向下」）。
fn clipw_i32(p: &const byte, off: usize) i32 {
    return clipw_u32(p, off) as i32;
}

// 一个 DIB 的解析结果（只保留转换像素需要的字段）。
export struct ClipwDib {
    width: i32,
    height: i32,       // 恒为正（自底向上已折算成行序标记）
    bottom_up: bool,   // true = 数据自底向上
    bpp: i32,
    data_off: usize,   // 像素起点（相对 DIB 起始）
    stride: usize,     // 每行字节数（已按 4 字节对齐）
}

// 解析 DIB 头。返回 true = 我们认得并能转（24/32 位、BI_RGB 或 BI_BITFIELDS）。
//
// DIB 的布局（CF_DIB 不带文件头）：
//   [0..4)   biSize（40 = BITMAPINFOHEADER，108/124 = V4/V5）
//   [4..8)   biWidth（i32）
//   [8..12)  biHeight（i32；**负值 = 自顶向下**）
//   [12..14) biPlanes  [14..16) biBitCount
//   [16..20) biCompression  [20..24) biSizeImage
//   调色板（≤8 位时 4 字节一项）跟在头后面；BI_BITFIELDS 且 biSize==40 时，
//   三/四个 DWORD 掩码也跟在头后面（各 4 字节）。
export fn clipwin_dib_parse(p: &const byte, n: usize, out: &ClipwDib) bool {
    if n < 40 {
        return false;
    }
    const hdr: usize = clipw_u32(p, 0) as usize;
    if hdr < 40 || hdr > n {
        return false;
    }
    const raw_h: i32 = clipw_i32(p, 8);
    const w: i32 = clipw_i32(p, 4);
    const bpp: i32 = clipw_u16(p, 14) as i32;
    const comp: u32 = clipw_u32(p, 16);
    if w <= 0 || raw_h == 0 {
        return false;
    }
    if bpp != 24 && bpp != 32 {
        return false;
    }
    if comp != CLIPW_BI_RGB && !(comp == CLIPW_BI_BITFIELDS && bpp == 32) {
        return false;
    }
    var ah: i32 = raw_h;
    var bottom_up: bool = true;
    if ah < 0 {
        ah = 0 -% ah;
        bottom_up = false;
    }
    // 行宽按 4 字节对齐（24 位、宽为奇数时每行末尾有填充）
    const stride: usize = ((((w as usize) * (bpp as usize)) + 31) / 32) * 4;
    var off: usize = hdr;
    if comp == CLIPW_BI_BITFIELDS && hdr == 40 {
        off = off + 12;         // 三个掩码紧跟 40 字节头（V4/V5 头自带掩码字段）
    }
    if off > n {
        return false;
    }
    out.width = w;
    out.height = ah;
    out.bottom_up = bottom_up;
    out.bpp = bpp;
    out.data_off = off;
    out.stride = stride;
    return true;
}

// 这张 DIB 的像素总量是不是在预算内（防「恶意/异常大的 DIB 撑爆分配」）。
fn clipw_dib_fits(d: &const ClipwDib, n: usize) bool {
    const need: usize = d.data_off + d.stride * (d.height as usize);
    return need <= n;
}

// 把 DIB 的像素搬进一张 RGB 位图（丢掉 alpha：模型侧只要颜色）。
// 返回 true = 成功。
fn clipwin_dib_to_image(p: &const byte, d: &const ClipwDib,
                        img: &Image) bool {
    const w: usize = d.width as usize;
    const h: usize = d.height as usize;
    const bppb: usize = (d.bpp as usize) / 8;
    const pix: &u8 = img.pixels;
    var y: usize = 0;
    while y < h {
        // 自底向上：DIB 的最后一行才是图像的第一行
        const src_row: usize = if d.bottom_up { h - 1 - y } else { y };
        const base: usize = d.data_off + src_row * d.stride;
        var x: usize = 0;
        while x < w {
            const s: usize = base + x * bppb;
            if s + bppb > d.data_off + d.stride * h {
                return false;
            }
            const dst: usize = (y * w + x) * 3;
            // DIB 是 BGR 序
            pix[dst] = p[s + 2] as u8;
            pix[dst + 1] = p[s + 1] as u8;
            pix[dst + 2] = p[s] as u8;
            x = x + 1;
        }
        y = y + 1;
    }
    return true;
}

// 位图腿：DIB → RGB 位图 → JPEG，交进 `out`。返回 CLIPW_*。
fn clipwin_take_image(out: &Buf) i32 {
    var raw: Buf = buf_new(CLIPW_MAX_DIB);
    defer { buf_free(&raw); }
    // 先把 DIB 读进 Uya 的缓冲：解析、换算、编码全在 Uya 侧做（可用自测钉住）。
    raw.len = 0;
    const got: isize = wincon_clip_dib(raw.ptr, raw.cap);
    if got == -2 {
        return CLIPW_TOO_BIG;
    }
    if got <= 0 {
        return CLIPW_NONE;
    }
    raw.len = got as usize;
    var d: ClipwDib = ClipwDib{
        width: 0, height: 0, bottom_up: true, bpp: 0,
        data_off: 0, stride: 0,
    };
    if !clipwin_dib_parse(raw.ptr as &const byte, raw.len, &d) {
        return CLIPW_NONE;
    }
    if !clipw_dib_fits(&d, raw.len) {
        return CLIPW_NONE;      // 头说有这么高，实际字节不够：畸形，不猜
    }
    const alc: MallocAllocator = get_allocator()[0];
    var img: Image = image_new(d.width, d.height, 3, alc) catch {
        return CLIPW_TOO_BIG;
    };
    defer { image_free(&img); }
    if !clipwin_dib_to_image(raw.ptr as &const byte, &d, &img) {
        return CLIPW_ERR;
    }
    const cap: usize = jpeg_max_bytes(d.width, d.height);
    if cap == 0 {
        return CLIPW_TOO_BIG;
    }
    const jb: &u8 = alc.alloc(cap) catch {
        return CLIPW_TOO_BIG;
    };
    defer { alc.dealloc(jb as &byte); }
    var n: usize = 0;
    const enc: !bool = jpeg_encode_q(&img, CLIPW_QUALITY, jb, cap, alc, &n);
    const okv: bool = enc catch { false; };
    if !okv || n == 0 {
        return CLIPW_ERR;
    }
    if !buf_append(out, jb as &const byte, n) {
        return CLIPW_TOO_BIG;
    }
    return CLIPW_IMAGE;
}

// 文本腿：读 UTF-8 文本进 `out`。返回 CLIPW_*。
fn clipwin_take_text(out: &Buf) i32 {
    var raw: Buf = buf_new(CLIPW_MAX_TEXT);
    defer { buf_free(&raw); }
    raw.len = 0;
    const got: isize = wincon_clip_text(raw.ptr, raw.cap);
    if got < 0 {
        return CLIPW_ERR;
    }
    if got == 0 {
        return CLIPW_NONE;
    }
    raw.len = got as usize;
    if !buf_append(out, raw.ptr as &const byte, raw.len) {
        return CLIPW_TOO_BIG;
    }
    return CLIPW_TEXT;
}

// 读一次 Windows 剪贴板。`mime_out` 只在图片时被写成 "image/jpeg"。
//
// 顺序：**先图后文** —— 与另外三条来源同款（用户粘一张截图时期望的是图；
// 很多截图工具同时写一份文本形式的路径，先读文本会把图挤掉）。
export fn clipwin_paste(out: &Buf, mime_out: &Buf) i32 {
    buf_reset(out);
    buf_reset(mime_out);
    const kind: i32 = wincon_clip_kind();
    if kind == 2 {
        const c: i32 = clipwin_take_image(out);
        if c == CLIPW_IMAGE {
            _ = buf_append_cstr(mime_out, "image/jpeg" as &const byte);
            return CLIPW_IMAGE;
        }
        if c == CLIPW_TOO_BIG {
            return c;
        }
        // 位图这条路没走通（格式不认识 / 转换失败）：继续试文本
        buf_reset(out);
    }
    if kind == 0 {
        return CLIPW_NONE;
    }
    return clipwin_take_text(out);
}
