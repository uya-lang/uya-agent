// src/session/procx.uya — 进程采样（P18/P24）：**本会话进程树**的综合 CPU 与内存
//
// 本文件：模块级采样状态（`g_px_*`）与 `procx_reset`、只读读数（`procx_cpu_pct`/
//   `procx_mem_kb`/`procx_mem_kind`/`procx_mem_kind_name`/`procx_proc_count`/
//   `procx_last_span_ms`/`procx_failed`/`procx_hz`）、纯函数（`procx_pid_ok`/
//   `procx_parse_stat`/`procx_pct_of`/`procx_tree_mark`）、行表与枚举（`PxRow`/
//   `procx_scan_rows`）、内存读取与格式化（`procx_find_kb`/`procx_fmt_mem_kb`）、
//   以及采样驱动 `procx_sample_once`/`procx_tick`。
// 不变量：① 采样范围是**本进程 + 它的全部后代**里 comm 与本进程**相同**的那些
//   （本进程、子代理、工作流子进程；口径与理由见下）；自己的 comm 取自
//   `/proc/self/stat`（二进制改名也照样匹配），
//   comm 取第一个 `(` 与**最后一个** `)` 之间（comm 里可以有空格和括号）；
//   ② 只取 `utime + stime`，**不取** cutime/cstime —— 父子都是我们的进程时会把同一份 CPU
//   算两遍；③ `PROCX_HZ`=100 是**常数**（USER_HZ，Linux 全架构固定），不是 sysconf 读数；
//   ④ 公式 `pct = Δticks * 1000 / Δms`（四舍五入，1 tick = 10ms CPU），间隔按**墙上时间**
//   算，结果钳在 0…999；口径是**单核百分比**，多进程/多核时可 >100%（父 + 2 个子代理最多
//   约 300%）；⑤ 内存口径**整批统一**：认准 PSS 后某进程 `smaps_rollup` 读不到就跳过它，
//   **绝不**偷偷换回 RSS 混加（内核 < 4.14 无 smaps_rollup 时整批退回 `VmRSS:`）；
//   ⑥ 节奏：CPU 1 秒一次（`PROCX_SAMPLE_MS`），第一次只建基线不产生数字；内存 5 秒一次
//   （`PROCX_MEM_SAMPLE_MS`，算 PSS 要遍历页表，3GB 进程实测 ~60ms/次，1 秒一次会拖住心跳）；
//   ⑦ `/proc` 读不到 → 不可用，界面省略该字段；`procx_tick(now_ms == 0)`（无时钟的画布模式）
//   直接返回，不碰 `/proc`。
// 依赖：libc.syscall/unistd（open/read/getdents）、foundation/bufx；本文件不依赖别的域。
// 命名：对外 `procx_*`（读数 + 纯函数 + 采样驱动）+ 常量 `PROCX_*`；"px" 前缀的
//   `g_px_*` 静态状态。
//
// 口径：
//   * 范围：**本进程 + 它的后代**（进程树），且 comm 必须与本进程相同。不是
//     机器上所有同名进程 —— 那是本文件最初（P18）的写法，症状是脚注把**别人的**
//     会话算到用户头上：实测同机 14 个同名进程 PSS 合计 338 MB，而本会话树只有
//     9 MB，一个空闲 agent 显示「内存 300M」就是这么来的（§16 踩坑 104）。
//     过滤条件有两层，缺一不可：
//       ① **树**：从本进程出发按 ppid 传递闭包（`procx_tree_mark`）。判别沿**所有**
//          进程走，不只沿同名进程 —— agent → `bash`（工具子进程）→ 嵌套 agent
//          这种链是真实存在的（selftest / workflow 就会跑出来），只沿同名进程走
//          会把它整条丢掉。
//       ② **comm**：只在**最后求和**时过滤。工具子进程（bash / node / python）
//          不是我们的进程，峰值可达 GB 级，算进来会把数字顶爆（P18 的刻意排除，
//          这条保留）。
//     自己的 comm 从 `/proc/self/stat` 读出（二进制被改名也照样匹配；comm 上限
//     15 字符，两侧同样截断，所以逐字节比较成立）。
//   * 取值：`/proc/<pid>/stat` 的 utime + stime。**不取** cutime/cstime —— 父子
//     都是我们的进程时，取子进程累计会把同一份 CPU 时间算两遍。
//   * 单位：这两个字段是 `USER_HZ = 100` 时钟节拍（Linux 对所有架构固定，与内核
//     HZ 无关），所以 `PROCX_HZ = 100` 是常数而不是 sysconf 读数；`cpu-live` 自测
//     用「忙循环子进程 + 400ms」把这条钉死。
//   * 计算：pct = Δticks * 1000 / Δms（1 tick = 10ms CPU）。采样间隔按**墙上时间**
//     算，所以事件循环被长任务占住、tick 稀疏时数值依然精确。
//   * 口径是**单核百分比**：多进程/多核并行时可以 > 100%（父 + 2 个子代理最多
//     约 300%）。显示时钳在 0…999。
//   * 只在 TUI 活跃时采样（由 tui_tick 这个统一心跳驱动），1 秒一次；第一次采样
//     只建立基线（不产生数字）。`/proc` 读不到 → 返回不可用，界面直接省略该字段。
//
// P24：同一次走查里顺带累加**内存**（`内存 312M`）：
//   * 范围与 CPU 完全一致（同一次走查定下的那个进程集：树上 comm 相同的那批）；
//     取 `/proc/<pid>/smaps_rollup` 的 `Pss:`（比例分摊 —— 子代理是 fork 出来的，
//     PSS 不会把父子共享的页算两遍，RSS 会）。
//   * 口径**整批统一**：一旦认准 PSS 就不再改；内核没有 `smaps_rollup`（< 4.14）时
//     整批退回 `/proc/<pid>/status` 的 `VmRSS:`，不会 PSS/RSS 混着加。
//   * 节奏 5 秒一次，比 CPU 慢一档：算 PSS 要遍历页表，3GB 进程实测 ~60ms/次，
//     1 秒一次会把心跳（也就是界面）拖住；uya-agent 这类几十 MB 的进程 ~1ms。
//     所以**先定集、后读数**：只有树上的同名进程才去读页表。

use libc.syscall;
use libc.unistd;

const PROCX_HZ: i64 = 100;            // USER_HZ（见文件头）
export const PROCX_SAMPLE_MS: u64 = 1000;
export const PROCX_MEM_SAMPLE_MS: u64 = 5000;   // 内存比 CPU 慢一档（见文件头）
const PROCX_MAX_PROCS: i32 = 4096;    // 防御上限（正常机器几百个）
const PROCX_STAT_MAX: usize = 2048;   // /proc/<pid>/stat 一行的上限
const PROCX_MEM_MAX: usize = 4096;    // smaps_rollup / status 前几 KB 就够（要的行都在头部）

// 内存口径：0 = 还没探明（先试 PSS），1 = PSS（smaps_rollup），2 = VmRSS（status）
const PROCX_MEM_NONE: i32 = 0;
const PROCX_MEM_PSS: i32 = 1;
const PROCX_MEM_RSS: i32 = 2;

// ============================================================
// 行表（一次走查的快照）
// ============================================================

// 一行 = 一个 /proc 条目里我们要的三样东西 + 两个判定位。
//   * `mine`：comm 与本进程相同（求和时只看它）；
//   * `mark`：落在**本进程的进程树**里（procx_tree_mark 填）。
// 为什么把「树」与「同名」分成两个位而不是合成一个 bool：判别必须先沿**所有**
// 进程的 ppid 做传递闭包，而「是不是同名」只在最后求和时才有用 —— 合成一个位
// 就得在遍历中途同时判两件事，跨 comm 的链（agent → bash → agent）会被切断。
export struct PxRow {
    pid: i32,
    ppid: i32,
    ticks: i64,
    mine: bool,
    mark: bool,
}

// 行表。一次采样走查要装下全机 /proc 的条目（本机实测 866 个），4096 × 24B
// ≈ 96 KiB 放栈上太肥（心跳路径上的栈帧），所以是**模块级**的 —— 这个模块本来
// 就是「进程内唯一一份采样状态」的定位（见下面那批 g_px_*）。
var g_px_rows: [PxRow: PROCX_MAX_PROCS] = [PxRow{
    pid: 0, ppid: 0, ticks: 0, mine: false, mark: false
}: PROCX_MAX_PROCS];

var g_px_comm: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_px_have_comm: bool = false;
var g_px_prev_ticks: i64 = 0;
var g_px_prev_ms: u64 = 0;
var g_px_have_prev: bool = false;
var g_px_pct: i32 = -1;
var g_px_count: i32 = 0;
var g_px_span_ms: i64 = 0;
var g_px_failed: bool = false;
var g_px_mem_kb: i64 = -1;
var g_px_mem_kind: i32 = PROCX_MEM_NONE;
var g_px_prev_mem_ms: u64 = 0;
var g_px_have_mem_prev: bool = false;

// 自测用：清零状态（不影响 comm 缓存）
export fn procx_reset() void {
    g_px_prev_ticks = 0;
    g_px_prev_ms = 0;
    g_px_have_prev = false;
    g_px_pct = -1;
    g_px_count = 0;
    g_px_span_ms = 0;
    g_px_failed = false;
    g_px_mem_kb = -1;
    g_px_mem_kind = PROCX_MEM_NONE;
    g_px_prev_mem_ms = 0;
    g_px_have_mem_prev = false;
}

// 最近一次算出的 CPU 百分比（0…999，单核口径可 >100）；还没采到过是 0
export fn procx_cpu_pct() i32 {
    return g_px_pct;
}

// 内存合计（kB）；-1 = 不可用（还没采到 / 读不到 /proc）。
// 口径 = **本会话进程树**里 comm 相同的那些进程（见文件头「口径」），不是全机同名。
export fn procx_mem_kb() i64 {
    return g_px_mem_kb;
}

// 0 = 还没探明，1 = PSS 合计，2 = VmRSS 合计
export fn procx_mem_kind() i32 {
    return g_px_mem_kind;
}

// 口径名字（/status 里写明是哪种合计）
export fn procx_mem_kind_name() &const byte {
    if g_px_mem_kind == PROCX_MEM_PSS {
        return "PSS" as &const byte;
    }
    if g_px_mem_kind == PROCX_MEM_RSS {
        return "RSS" as &const byte;
    }
    return "" as &const byte;
}

// 最近一次采到的进程数（**本会话进程树**里 comm 相同的那些）；没采到过是 0。
// 注意它**不是**全机同名进程数：别的终端/别的 worktree 的实例不算（见文件头）。
export fn procx_proc_count() i32 {
    return g_px_count;
}

// 上次 CPU 采样的墙钟间隔（毫秒，分母）；0 = 只有基线、还没算出百分比
export fn procx_last_span_ms() i64 {
    return g_px_span_ms;
}

// /proc 读不到了（不可用）；界面据此省略这段数字，而不是显示 0
export fn procx_failed() bool {
    return g_px_failed;
}

// ============================================================
// 纯函数（自测逐字节断言的就是这三个）
// ============================================================

// 目录项是不是一个 pid（纯数字、非空、不超过 10 位）
export fn procx_pid_ok(name: &[byte]) bool {
    if name.len == 0 || name.len > 10 {
        return false;
    }
    var i: usize = 0;
    while i < name.len {
        if !is_digit(name.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 解析一行 `/proc/<pid>/stat`：comm = 第一个 '(' 与**最后一个** ')' 之间
// （comm 里可以有空格和括号，所以不能按空格切），ppid = ')' 之后的第 2 个字段，
// utime/stime = ')' 之后的第 12、13 个字段（第 1 个字段是 state）。
//
// ppid 是**进程树判别**要的（`procx_tree_mark`）：只保留这一份解析器，
// 不另写一份「只取 ppid」的 —— 同一行两种切法迟早会漂移（comm 里带括号那条
// 边界就是这么被踩出来的）。失败返回 false，此时 comm/ticks/ppid 都不可信。
export fn procx_parse_stat(line: &[byte], comm: &Buf, ticks: &i64,
    ppid: &i32) bool {
    buf_reset(comm);
    ticks[0] = 0;
    ppid[0] = 0;
    const open_at: isize = bufx_find_byte(line, 40, 0);      // '('
    if open_at < 0 {
        return false;
    }
    // 收尾括号取**最后一个** ')'：comm 里允许出现 ')'（内核不转义），而 ')' 之后的
    // 字段只有状态字母与数字，不可能再有 ')' —— 取第一个会把 `(uya (agent) x)` 切坏。
    var close_at: isize = -1;
    var scan: usize = (open_at as usize) + 1;
    while scan < line.len {
        if line.ptr[scan] == 41 as byte {
            close_at = scan as isize;
        }
        scan = scan + 1;
    }
    if close_at < 0 {
        return false;
    }
    const cs: usize = (open_at as usize) + 1;
    const ce: usize = close_at as usize;
    if !buf_append(comm, &line.ptr[cs], ce - cs) {
        return false;
    }
    var i: usize = ce + 1;
    var field: i32 = 0;
    var utime: i64 = -1;
    var stime: i64 = -1;
    var have_ppid: bool = false;
    while i < line.len {
        // 跳空格
        while i < line.len && line.ptr[i] == 32 as byte {
            i = i + 1;
        }
        if i >= line.len {
            break;
        }
        field = field + 1;
        var v: i64 = 0;
        var digits: i32 = 0;
        while i < line.len && is_digit(line.ptr[i]) {
            v = (v * 10) + ((line.ptr[i] as i64) - 48);
            digits = digits + 1;
            i = i + 1;
        }
        if field == 2 {
            // ppid 必须是数字：它不是可选字段 —— 缺了就没法做进程树判别，
            // 让它过会把「这一行不属于任何树」静默当成「根进程」（ppid=0）。
            if digits == 0 {
                return false;
            }
            ppid[0] = i64_to_i32(v);
            have_ppid = true;
        } else if field == 12 {
            if digits == 0 {
                return false;   // utime 必须是数字（缺字段 = 不是我们要的形状）
            }
            utime = v;
        } else if field == 13 {
            if digits == 0 {
                return false;
            }
            stime = v;
            break;
        }
        // 第 1 个字段是 state（字母 R/S/D…），第 2..11 个是各种计数 —— 一律跳过，
        // 只要能被空格切出来就行（早期实现在这里要求「数字」，真行会直接解析失败）
        // 跳过本字段剩下的非空格字节（正常情况下数字后面就是空格）
        while i < line.len && line.ptr[i] != 32 as byte {
            i = i + 1;
        }
    }
    if utime < 0 || stime < 0 || !have_ppid {
        return false;
    }
    ticks[0] = utime + stime;
    return true;
}

// Δticks / Δms → 单核百分比（-1 = 不可算）
export fn procx_pct_of(dticks: i64, dms: i64) i32 {
    if dms <= 0 {
        return -1;
    }
    var d: i64 = dticks;
    if d < 0 {
        d = 0;
    }
    const p: i64 = ((d * 1000) + (dms / 2)) / dms;
    if p > 999 {
        return 999;
    }
    if p < 0 {
        return 0;
    }
    return p as i32;
}

// 在行表 rows[0, n) 里标出**以 root 为根的那棵进程树**（`mark = true`），
// 返回被标的行数（含 root 自己）。root 不在表里 → 0。
//
// 为什么是**不动点**而不是「一趟扫下来」：行表按 `/proc` 的枚举顺序填，子进程
// **完全可能排在父进程前面**（readdir 的顺序不是拓扑序）。一趟扫会漏掉「父还没
// 被标时先遇到子」的那些行，而漏掉的正是链路中段 —— 症状是数字偶尔偏小、
// 复现不了。所以反复扫，直到某一轮一个都没新增（内层 while 的 hit 哨兵）；
// 最坏 O(n²) 但对全机 866 行、且通常 2–3 轮就收敛。
//
// 判别沿**所有**行的 ppid 走，与 comm 无关 —— 跨 comm 的链
// （agent → bash → 嵌套 agent）必须能穿过去，否则嵌套会话树会被切断。
// 自环（ppid == pid）不会让它转不停：标记只从 false 变 true，每轮至少新增一个
// 才会继续，总量被 n 封顶。
export fn procx_tree_mark(rows: &PxRow, n: usize, root: i32) i32 {
    var marked: i32 = 0;
    var i: usize = 0;
    while i < n && i < PROCX_MAX_PROCS {
        rows[i].mark = false;
        if rows[i].pid == root {
            rows[i].mark = true;
            marked = marked + 1;
        }
        i = i + 1;
    }
    var again: bool = true;
    while again {
        again = false;
        var k: usize = 0;
        while k < n && k < PROCX_MAX_PROCS {
            if !rows[k].mark && procx_row_parent_marked(rows, n, k) {
                rows[k].mark = true;
                marked = marked + 1;
                again = true;
            }
            k = k + 1;
        }
    }
    return marked;
}

// 第 k 行的 ppid 是否指向一个**已被标**的行（纯查表，不改状态）。
// 单独一个函数是为了让「父在不在表里 / 父是不是被标」这两件事写在一处：
// ppid 指向表外的行（父进程已经退出、或超出 PROCX_MAX_PROCS）→ 不算。
fn procx_row_parent_marked(rows: &PxRow, n: usize, k: usize) bool {
    const pp: i32 = rows[k].ppid;
    if pp <= 0 {
        return false;
    }
    var j: usize = 0;
    while j < n && j < PROCX_MAX_PROCS {
        if rows[j].pid == pp {
            return rows[j].mark;
        }
        j = j + 1;
    }
    return false;
}

// 在 /proc/<pid>/smaps_rollup（`Pss:  1234 kB`）或 /proc/<pid>/status（`VmRSS:\t1234 kB`）
// 的文本里取一个 `<label> <数字>` 行的数字（kB）。返回 false = 没有这一行 / 形状不对
// （此时 out_kb = 0）。只认**行首**匹配，所以 `Pss_Dirty:` 不会被当成 `Pss:`。
export fn procx_find_kb(text: &[byte], label: &const byte, out_kb: &i64) bool {
    out_kb[0] = 0;
    const ln: usize = bufx_cstr_len(label);
    if ln == 0 || ln > text.len {
        return false;
    }
    var i: usize = 0;
    while i + ln <= text.len {
        const line_start: bool = i == 0 || text.ptr[i - 1] == 10 as byte;
        if line_start && bufx_mem_eq(&text.ptr[i] as &const byte, label, ln) {
            var j: usize = i + ln;
            // 标签后面是空格/制表符（status 用 \t，smaps_rollup 用若干空格）
            while j < text.len && (text.ptr[j] == 32 as byte || text.ptr[j] == 9 as byte) {
                j = j + 1;
            }
            var v: i64 = 0;
            var digits: i32 = 0;
            while j < text.len && is_digit(text.ptr[j]) {
                v = (v * 10) + ((text.ptr[j] as i64) - 48);
                digits = digits + 1;
                j = j + 1;
            }
            if digits == 0 {
                return false;   // 标签对上了但后面不是数字：不猜
            }
            out_kb[0] = v;
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 非负整数的四舍五入除法（d <= 0 时回 0）
fn procx_round_div(v: i64, d: i64) i64 {
    if d <= 0 {
        return 0;
    }
    return (v + (d / 2)) / d;
}

// 内存显示（二进制单位）：`512K` / `312M` / `1.2G`。kb < 0（不可用）→ 返回 false，不写字节。
export fn procx_fmt_mem_kb(out: &Buf, kb: i64) bool {
    if kb < 0 {
        return false;
    }
    if kb < 1024 {
        _ = buf_append_i64(out, kb);
        _ = buf_append_byte(out, 75);                       // 'K'
        return true;
    }
    if kb < 1024 * 1024 {
        _ = buf_append_i64(out, procx_round_div(kb, 1024));
        _ = buf_append_byte(out, 77);                       // 'M'
        return true;
    }
    const t10: i64 = procx_round_div(kb, 1024 * 1024 / 10);   // 十分之一 G（四舍五入）
    _ = buf_append_i64(out, t10 / 10);
    _ = buf_append_byte(out, 46);                           // '.'
    _ = buf_append_byte(out, (48 + (t10 % 10)) as byte);
    _ = buf_append_byte(out, 71);                           // 'G'
    return true;
}

// ============================================================
// 采样
// ============================================================

// 读 `/proc/self/stat` 拿自己的 comm（缓存在 g_px_comm，读过一次就不再读）。
// 返回 false = 读不到/解析失败（这时整个采样判不可用）。
fn procx_self_comm() bool {
    if g_px_have_comm {
        return true;
    }
    if !buf_valid(&g_px_comm) {
        g_px_comm = buf_new(64);
        if !buf_valid(&g_px_comm) {
            return false;
        }
    }
    var line: Buf = buf_new(PROCX_STAT_MAX);
    defer { buf_free(&line); }
    if !fs_read_file_all("/proc/self/stat" as &const byte, &line, PROCX_STAT_MAX) {
        return false;
    }
    var ticks: i64 = 0;
    var ppid: i32 = 0;
    if !procx_parse_stat(line.ptr[0: line.len], &g_px_comm, &ticks, &ppid) {
        return false;
    }
    if g_px_comm.len == 0 {
        return false;
    }
    g_px_have_comm = true;
    return true;
}

// 把 base（`/proc/<pid>`，长度 base_len）拼上 `/<suffix>` 读进来，再按 label 取数
fn procx_read_label(path: &Buf, base_len: usize, suffix: &const byte, label: &const byte, text: &Buf, kb: &i64) bool {
    path.len = base_len;
    if !buf_append_byte(path, 47) {                         // '/'
        return false;
    }
    if !buf_append_cstr(path, suffix) {
        return false;
    }
    if !buf_append_byte(path, 0) {
        return false;
    }
    if !fs_read_file_all(path.ptr as &const byte, text, PROCX_MEM_MAX) {
        return false;
    }
    return procx_find_kb(text.ptr[0: text.len], label, kb);
}

// 读一个已匹配进程的内存（kB）。kind[0]：0 = 还没探明（先试 PSS），1 = PSS，2 = VmRSS。
// 口径一旦定下就不再改：认准 PSS 之后某个进程的 smaps_rollup 读不到就跳过它，
// 不会偷偷换回 RSS 把两种口径混着加。
fn procx_read_mem(path: &Buf, base_len: usize, kind: &i32, kb: &i64) bool {
    var text: Buf = buf_new(PROCX_MEM_MAX);
    defer { buf_free(&text); }
    if kind[0] != PROCX_MEM_RSS {
        if procx_read_label(path, base_len, "smaps_rollup" as &const byte, "Pss:" as &const byte, &text, kb) {
            kind[0] = PROCX_MEM_PSS;
            return true;
        }
        if kind[0] == PROCX_MEM_PSS {
            return false;
        }
    }
    if procx_read_label(path, base_len, "status" as &const byte, "VmRSS:" as &const byte, &text, kb) {
        kind[0] = PROCX_MEM_RSS;
        return true;
    }
    return false;
}

// 枚举 `/proc`，把每一条能解析的 `/proc/<pid>/stat` 收进行表 g_px_rows。
// 返回 false = 枚举/comm 初始化失败；成功时 *out_n = 收进来的行数。
//
// 这一步**只收集、不判断**：`mine`（comm 同名）在这里填，`mark`（在不在树上）留给
// `procx_tree_mark` —— 见 PxRow 的注释（两件事必须分开才穿得过跨 comm 的链）。
fn procx_scan_rows(comm: &Buf, out_n: &i32) bool {
    out_n[0] = 0;
    if !procx_self_comm() {
        return false;
    }
    const dp: &DIR = opendir("/proc" as &const byte);
    if dp == null {
        return false;
    }
    defer { _ = closedir(dp); }
    var path: Buf = buf_new(64);
    defer { buf_free(&path); }
    var line: Buf = buf_new(PROCX_STAT_MAX);
    defer { buf_free(&line); }
    var n: i32 = 0;
    while n < PROCX_MAX_PROCS {
        const de: &Dirent = readdir(dp);
        if de == null {
            break;
        }
        const nm: &const byte = &de.d_name[0] as &const byte;
        const ln: usize = bufx_cstr_len(nm);
        if !procx_pid_ok(nm[0: ln]) {
            continue;
        }
        buf_reset(&path);
        if !buf_append_cstr(&path, "/proc/") {
            break;
        }
        if !buf_append(&path, nm, ln) {
            break;
        }
        if !buf_append_cstr(&path, "/stat") {
            break;
        }
        if !buf_append_byte(&path, 0) {
            break;
        }
        if !fs_read_file_all(path.ptr as &const byte, &line, PROCX_STAT_MAX) {
            continue;   // 进程刚消失 / 权限不足：跳过
        }
        var t: i64 = 0;
        var pp: i32 = 0;
        if !procx_parse_stat(line.ptr[0: line.len], comm, &t, &pp) {
            continue;
        }
        const pid: i64 = parse_u64_at(nm[0: ln], 0, ln);
        if pid <= 0 {
            continue;
        }
        const idx: usize = n as usize;
        g_px_rows[idx].pid = i64_to_i32(pid);
        g_px_rows[idx].ppid = pp;
        g_px_rows[idx].ticks = t;
        g_px_rows[idx].mine = procx_comm_is_mine(comm);
        g_px_rows[idx].mark = false;
        n = n + 1;
    }
    out_n[0] = n;
    return true;
}

// 这一行的 comm 是不是本进程的（长度先比，再逐字节）。
fn procx_comm_is_mine(comm: &const Buf) bool {
    if comm.len == 0 || comm.len != g_px_comm.len {
        return false;
    }
    return bufx_mem_eq(comm.ptr as &const byte, g_px_comm.ptr as &const byte,
        comm.len);
}

// 求和：树上（mark）且同名（mine）的那些行 —— CPU 直接累加 ticks，内存按需读。
// **只对这批行读页表**（先定集后读数，理由见文件头 P24 那段）。
fn procx_sum_tree(rows: &PxRow, n: i32, with_mem: bool, ticks: &i64,
    count: &i32, mem_kb: &i64, mem_kind: &i32) void {
    ticks[0] = 0;
    count[0] = 0;
    mem_kb[0] = -1;
    var sum: i64 = 0;
    var c: i32 = 0;
    var mem_sum: i64 = 0;
    var mem_n: i32 = 0;
    var i: i32 = 0;
    while i < n && i < PROCX_MAX_PROCS {
        const k: usize = i as usize;
        if rows[k].mark && rows[k].mine {
            sum = sum + rows[k].ticks;
            c = c + 1;
            if with_mem {
                var kb: i64 = 0;
                if procx_read_mem_pid(rows[k].pid, mem_kind, &kb) {
                    mem_sum = mem_sum + kb;
                    mem_n = mem_n + 1;
                }
            }
        }
        i = i + 1;
    }
    ticks[0] = sum;
    count[0] = c;
    if with_mem && mem_n > 0 {
        mem_kb[0] = mem_sum;
    }
}

// 读一个 pid 的内存（kB）：拼 `/proc/<pid>` 走 procx_read_mem。
// kind[0] 的语义与「整批统一」的纪律见 procx_read_mem。
fn procx_read_mem_pid(pid: i32, kind: &i32, kb: &i64) bool {
    var path: Buf = buf_new(64);
    defer { buf_free(&path); }
    if !buf_append_cstr(&path, "/proc/" as &const byte) {
        return false;
    }
    if !buf_append_i64(&path, pid as i64) {
        return false;
    }
    const base_len: usize = path.len;
    return procx_read_mem(&path, base_len, kind, kb);
}

// 扫一遍 /proc，累加**本会话进程树**上 comm 相同的那些进程的 utime+stime
// （with_mem 时顺带累加内存）。返回 false = 枚举失败。
fn procx_scan(ticks: &i64, count: &i32, with_mem: bool, mem_kb: &i64,
    mem_kind: &i32) bool {
    ticks[0] = 0;
    count[0] = 0;
    mem_kb[0] = -1;
    var comm: Buf = buf_new(64);
    defer { buf_free(&comm); }
    var n: i32 = 0;
    if !procx_scan_rows(&comm, &n) {
        return false;
    }
    const me: i32 = i64_to_i32(sys_getpid() catch { 0 as i64; });
    if me <= 0 {
        return false;
    }
    _ = procx_tree_mark(&g_px_rows[0], n as usize, me);
    procx_sum_tree(&g_px_rows[0], n, with_mem, ticks, count, mem_kb, mem_kind);
    return true;
}

// 立刻采一次（自测/诊断入口）。with_mem = 顺带采内存（慢一档，见文件头）。
// 返回值 = 这次扫描是否成功。数字的口径是**本会话进程树**（文件头「口径」）。
export fn procx_sample_once(now_ms: u64, with_mem: bool) bool {
    var ticks: i64 = 0;
    var count: i32 = 0;
    var mem_kb: i64 = -1;
    var mem_kind: i32 = g_px_mem_kind;
    const ok: bool = procx_scan(&ticks, &count, with_mem, &mem_kb, &mem_kind);
    if !ok {
        g_px_failed = true;
        g_px_pct = -1;
        g_px_count = 0;
        g_px_span_ms = 0;
        g_px_have_prev = false;
        g_px_mem_kb = -1;
        g_px_have_mem_prev = false;
        return false;
    }
    g_px_failed = false;
    g_px_count = count;
    if with_mem {
        g_px_mem_kb = mem_kb;
        if mem_kind != g_px_mem_kind {
            g_px_mem_kind = mem_kind;
        }
        g_px_prev_mem_ms = now_ms;
        g_px_have_mem_prev = true;
    }
    if g_px_have_prev && now_ms > g_px_prev_ms {
        const span: i64 = (now_ms - g_px_prev_ms) as i64;
        g_px_pct = procx_pct_of(ticks - g_px_prev_ticks, span);
        g_px_span_ms = span;
    } else {
        g_px_pct = -1;      // 第一次只建基线（也可能是时钟没走）
        g_px_span_ms = 0;
    }
    g_px_prev_ticks = ticks;
    g_px_prev_ms = now_ms;
    g_px_have_prev = true;
    return true;
}

// 心跳（由 tui_tick 调）：CPU 到点（1s）或内存到点（5s）才真扫。
// now_ms == 0 = 无时钟的画布模式（自测的 headless 帧）→ 不碰 /proc。
export fn procx_tick(now_ms: u64) void {
    if now_ms == 0 {
        return;
    }
    const cpu_due: bool = !g_px_have_prev || (now_ms - g_px_prev_ms) >= PROCX_SAMPLE_MS;
    const mem_due: bool = !g_px_have_mem_prev || (now_ms - g_px_prev_mem_ms) >= PROCX_MEM_SAMPLE_MS;
    if !cpu_due && !mem_due {
        return;
    }
    _ = procx_sample_once(now_ms, mem_due);
}

// 采样节拍（USER_HZ 单位，恒 100 —— 报告给界面做单位换算用）
export fn procx_hz() i64 {
    return PROCX_HZ;
}
