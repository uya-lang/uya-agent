// src/session/modelx.uya — P37：模型目录（对齐 DSH 的 /model popupSelect + composer 的 Model/Effort 两级菜单）
//
// 本文件：把 settings.yaml 里的 provider / model / 推理档位摊平成一张只读表 —— 类型
//   `McEntry`（一个模型条目）、`MxWin`（一条上下文窗口映射）与 `McTable`
//   （`MX_MAX`=256 条模型 + `MX_WIN_MAX`=32 条窗口映射 + loaded 标志），
//   档位名与序号的互转（`mx_level_name`/`mx_level_index`，`MX_LEVELS`=7），
//   只读查询（`mx_count`/`mx_loaded`/`mx_entry_at`/`mx_has_level`/`mx_levels_into`/
//   `mx_default_level`/`mx_find`/`mx_win_find`/`mx_win_count`/`mx_win_bad`），
//   以及装载路径 `mx_load`（含 `mx_collect_provider` / `mx_read_efforts` /
//   `mx_read_windows` / `mx_plain_positive` / `mx_compat_bool`）与 `mx_seed_sole`
//   （兜底：读不到设置时把当前模型当唯一条目）。
// 不变量：三条硬规则 —— ① **不发明档位** —— 只认模型自己 `reasoningEfforts:` 里公布的键
//   （集合是固定的七档 off/minimal/low/medium/high/xhigh/max，顺序即展示序）；
//   ② `reasoningEfforts: false` = 非推理模型 ⇒ 界面**不显示** Effort 那一行（显示一个做不到
//   事的控件比不显示更坏）；③ **目录只读** —— 解析失败 / 没有 DSH 设置都只是「目录为空」
//   （`loaded` 区分「没设置」与「设置里没有模型」），绝不报错退出（离线要能跑）；
//   ④ `mx_levels_into` **不 reset out**：它常被用在「先写前缀再补清单」的地方，reset 会把前缀
//   抹掉；⑤ compat 三键只认 `true`/`false` 字面量（别的写法 -1 = 未声明），provider 级是默认、
//   模型级同名键覆盖；⑥ uya 的约束：**整条结构体不能在循环里赋值**（「循环中的变量不能移动」），
//   所以填表一律「拿槽位指针 + 逐字段写」；⑦ `uya-agent.contextWindows` 的值必须是**纯十进制
//   正整数** —— `256K` 这类缩写**拒绝**（不静默截断成 256），非法条目跳过并计数，让
//   `--print-config` 说得出「跳过了几条」。
// 依赖：libc.syscall/unistd、foundation/yamlcfg（复用 `YTree` 导航，**不**新写解析器）、
//   foundation/bufx。
// 命名：对外 `mx_*`（装载 + 查询）+ 类型 `McEntry`/`MxWin`/`McTable` + 常量
//   `MX_MAX`/`MX_LEVELS`/`MX_WIN_MAX`；私有同样 `mx_*` 前缀（非 export）。
//
// 事实源就是 DSH 的 settings.yaml：`llm-pi-ai.providers.<prov>.models[]`（外加官方路线的
// `llm-deepseek.models[]`），以及**本仓自己**的 `uya-agent.contextWindows`（模型 → 上下文窗口，
// 给「目录里没写 contextWindow」的路线兜底：`autodl.art` 那类纯 env 部署）。这一层只做一件事：
// 把「有哪些提供方 / 模型 / 该模型公布了哪些推理档位 / 每个模型的窗口是多少」摊平成一个只读
// 清单，供 `/model`、`/effort`、压缩阈值与 `--print-config` 用。
//
// 对齐 DSH 的三条硬规则（都是从 dsh-llm-pi-ai 的实测语义抄来的）：
//   1) **不发明档位**：只认模型自己 `reasoningEfforts:` 里公布的键。DSH 的 THINKING_LEVELS 是
//      固定七个（off/minimal/low/medium/high/xhigh/max），这里按同一套顺序收集。
//   2) **`reasoningEfforts: false` = 非推理模型**：一个档位都不公布 ⇒ 界面**不显示** Effort
//      那一行（显示一个做不到事的控件比不显示更坏）。
//   3) **目录只读**：解析失败 / 没有 DSH 设置都只是「目录为空」，绝不报错退出（离线要能跑）。
//
// 复用 yamlcfg.uya 的 YTree 导航，不新写解析器。

use libc.syscall;
use libc.unistd;

export const MX_MAX: usize = 256;       // 目录条目上限（真机 settings.yaml 远小于此）

// `uya-agent.contextWindows` 的条目上限（一张人工维护的映射表，几十条足够）
export const MX_WIN_MAX: usize = 32;

// 窗口值的上限：9 位十进制（1..999999999）。比任何模型公布的窗口都大，同时挡住
// `10 位数字` 这类明显的误写 —— 也正因为定了位数，解析里不会溢出 i64。
export const MX_WIN_MAX_VALUE: i64 = 999999999;

// DSH 的七个推理档位（顺序即「从弱到强」，也是浮层里的展示序）
export const MX_LEVELS: usize = 7;

// P84：`McEntry.input_image` 的三个取值。**必须区分「没声明」与「声明了不支持」**：
//   * `MX_IMG_UNSET`  —— settings.yaml 里**没有** `input:` 这个键（含目录里根本没这条）。
//                        按「默认支持」的口径：**不动**现行值（沿用），不是关闭。
//   * `MX_IMG_YES`    —— `input:` 里含 `image`。
//   * `MX_IMG_NO`     —— `input:` **存在**、但不含 `image`（如 `[text]`）—— 这才是
//                        「这个模型不收图」的**明确声明**，要真的把收图关掉。
export const MX_IMG_UNSET: u8 = 0;
export const MX_IMG_YES: u8 = 1;
export const MX_IMG_NO: u8 = 2;

// 第 i 个档位的名字；i 越界时返回 "max"（调用方应先按 MX_LEVELS 判界）
export fn mx_level_name(i: usize) &const byte {
    if i == 0 {
        return "off" as &const byte;
    }
    if i == 1 {
        return "minimal" as &const byte;
    }
    if i == 2 {
        return "low" as &const byte;
    }
    if i == 3 {
        return "medium" as &const byte;
    }
    if i == 4 {
        return "high" as &const byte;
    }
    if i == 5 {
        return "xhigh" as &const byte;
    }
    return "max" as &const byte;
}

// 档位名 → 序号；-1 = 不认识（`none` 是 off 的同义词，DSH 与我们的 --reasoning-effort 都收）
export fn mx_level_index(p: &const byte, n: usize) i32 {
    if n == 0 {
        return -1;
    }
    var i: usize = 0;
    while i < MX_LEVELS {
        if bufx_eq_cstr(p, n, mx_level_name(i)) {
            return i as i32;
        }
        i = i + 1;
    }
    if bufx_eq_cstr(p, n, "none" as &const byte) {
        return 0;   // none == off
    }
    return -1;
}

// 一个模型条目。`reasoning` = 公布过档位；`levels[i]` = 档位 i 可用。
// `declared` = settings.yaml 里显式写了 `reasoningEfforts:`（哪怕只写 off 一档，也是「声明过」，
// 与「没写这个键」分开 —— 没写时我们不做任何推断）。
export struct McEntry {
    provider: Buf,
    model: Buf,
    name: Buf,            // 展示名（DSH 的 name，缺省用 id）
    context_window: i64,
    max_tokens: i64,
    // P84：收不收图，**三态**（`MX_IMG_*`）—— 「写了 input 且不含 image」与
    // 「根本没写 input」是两件事：前者是**声明了不支持**（要关掉收图），后者是
    // **没声明**（按 P84 的「默认支持」口径当支持，不动现状）。
    // 以前这里是个 bool，「没写」与「写了但不含 image」分不开 —— 于是能力位只能
    // 单方向写（只 OR 真、从不清零），切到纯文本模型照收图，收下的必然 400。
    input_image: u8,
    reasoning: bool,      // 公布了档位（含只公布 off）
    levels: [bool: MX_LEVELS],
    declared: bool,       // 显式写了 reasoningEfforts
    compat_dev_role: i8,
    compat_store: i8,
    compat_reasoning: i8,
}

// 一条空条目（BUF 全空、上限 -1、无档位、compat 全 -1）；表初始化与释放后复位用
fn mx_entry_empty() McEntry {
    return McEntry{
        provider: buf_empty(),
        model: buf_empty(),
        name: buf_empty(),
        context_window: -1,
        max_tokens: -1,
        input_image: MX_IMG_UNSET,
        reasoning: false,
        levels: [false: MX_LEVELS],
        declared: false,
        compat_dev_role: -1,
        compat_store: -1,
        compat_reasoning: -1,
    };
}

// 释放一个条目的三个 Buf（provider / model / name；其它都是标量）
fn mx_free_entry(e: &McEntry) void {
    buf_free(&e.provider);
    buf_free(&e.model);
    buf_free(&e.name);
}

export struct McTable {
    items: [McEntry: MX_MAX],
    n: usize,
    loaded: bool,         // 真读到过 settings.yaml（目录为空时用来区分「没设置」与「设置里没有模型」）
    // `uya-agent.contextWindows` 的映射条目（0..nwin-1 有效），nwin_bad = 被跳过的非法条目数
    wins: [MxWin: MX_WIN_MAX],
    nwin: usize,
    nwin_bad: usize,
}

// `uya-agent.contextWindows` 的一条：`key` 是 `提供方/名字`（精确口径）或裸名字（粗口径），
// `window` 恒 > 0（非法值在装载时就被跳过了）。
export struct MxWin {
    key: Buf,
    window: i64,
}

// 一条空映射（装载前复位用）
fn mx_win_empty() MxWin {
    return MxWin{ key: buf_empty(), window: -1 };
}

// 第 i 条映射（只读）；越界回第 0 条 —— 与 `mx_at_ref` 同一条理由（固定数组下标要带
// 字面量上界检查，编译器的安全证明才过，见 §16 坑 6）
fn mx_win_ref(t: &const McTable, i: usize) &const MxWin {
    if i >= MX_WIN_MAX {
        return &t.wins[0];
    }
    return &t.wins[i];
}

// 同上但给可写指针（填表用）
fn mx_win_mut(t: &McTable, i: usize) &MxWin {
    if i >= MX_WIN_MAX {
        return &t.wins[0];
    }
    return &t.wins[i];
}

// 把表清成 MX_MAX 条空条目 + MX_WIN_MAX 条空映射 + n/nwin/nwin_bad = 0、loaded = false
export fn mx_init(t: &McTable) void {
    var i: usize = 0;
    while i < MX_MAX {
        t.items[i] = mx_entry_empty();
        i = i + 1;
    }
    var w: usize = 0;
    while w < MX_WIN_MAX {
        t.wins[w] = mx_win_empty();
        w = w + 1;
    }
    t.n = 0;
    t.nwin = 0;
    t.nwin_bad = 0;
    t.loaded = false;
}

// 释放前 n 条条目的 Buf 与前 nwin 条映射的 key，并置 n/nwin = 0
// （loaded 与 nwin_bad 不动，留给调用方自己重置）
export fn mx_free(t: &McTable) void {
    var i: usize = 0;
    while i < t.n {
        mx_free_entry(&t.items[i]);
        i = i + 1;
    }
    var w: usize = 0;
    while w < t.nwin {
        buf_free(&mx_win_mut(t, w).key);
        w = w + 1;
    }
    t.n = 0;
    t.nwin = 0;
}

// 固定数组的下标必须带**字面量上界**检查，编译器的安全证明才过（§16 坑 6）
// 只读取第 i 条；i 越界回第 0 条并置（调用方必须先 mx_count 判界再取）
// 固定数组的下标必须带**字面量上界**检查，编译器的安全证明才过（§16 坑 6）
fn mx_at_ref(t: &const McTable, i: usize) &const McEntry {
    if i >= MX_MAX {
        return &t.items[0];
    }
    return &t.items[i];
}

// 同上但给可写指针（填表用）；i 越界同样回第 0 条
fn mx_at_mut(t: &McTable, i: usize) &McEntry {
    if i >= MX_MAX {
        return &t.items[0];
    }
    return &t.items[i];
}

// 目录里的条目数（`/model` 浮层的行数）
export fn mx_count(t: &const McTable) usize {
    return t.n;
}

// 真读到过 settings.yaml 吗（true 但 count==0 = 「设置里没有模型」；false = 「没设置」）
export fn mx_loaded(t: &const McTable) bool {
    return t.loaded;
}

// 对外取第 i 条（越界时回第 0 条；判界应当是调用方的责任）
export fn mx_entry_at(t: &const McTable, i: usize) &const McEntry {
    return mx_at_ref(t, i);
}

// 某个档位在这个模型上可用吗？
export fn mx_has_level(e: &const McEntry, lvl: usize) bool {
    if lvl >= MX_LEVELS {
        return false;
    }
    return e.levels[lvl];
}

// 该模型的档位清单（逗号 + 空格，与 DSH 的呈现口径一致）；没有公布档位时是空串。
// 正好回应「不发明档位」：非推理模型这里就是空的，界面据此整行不画。
// ⚠ 这里**不 reset out**：本函数大量用在「先写一段前缀再补清单」的地方
// （`error: xxx 不是…；可选：<清单>`、`efforts    <清单>`），reset 会把前缀一起抹掉。
export fn mx_levels_into(e: &const McEntry, out: &Buf) void {
    if !e.reasoning {
        return;
    }
    var first: bool = true;
    var i: usize = 0;
    while i < MX_LEVELS {
        if mx_has_level(e, i) {
            if !first {
                _ = buf_append_cstr(out, ", ");
            }
            _ = buf_append_cstr(out, mx_level_name(i));
            first = false;
        }
        i = i + 1;
    }
}

// 该模型的**默认**档位：公布过就用第一个公布的（DSH 的 defaultEffort 缺省时也是这个口径）；
// 没公布就 -1（调用方据此决定「不发 reasoning」还是「保留现有值」）。
export fn mx_default_level(e: &const McEntry) i32 {
    if !e.reasoning {
        return -1;
    }
    var i: usize = 0;
    while i < MX_LEVELS {
        if mx_has_level(e, i) {
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

// 查 (provider, model)；未命中返回 -1。provider 为空时只按 model 找（DSH 里 model id 一般唯一）。
export fn mx_find(t: &const McTable, provider: &const byte, pn: usize, model: &const byte, mn: usize) i32 {
    if mn == 0 {
        return -1;
    }
    var i: usize = 0;
    while i < t.n {
        const e: &const McEntry = mx_at_ref(t, i);
        if e.model.len == mn && bufx_mem_eq(e.model.ptr as &const byte, model, mn) {
            if pn == 0 || (e.provider.len == pn && bufx_mem_eq(e.provider.ptr as &const byte, provider, pn)) {
                return i as i32;
            }
        }
        i = i + 1;
    }
    return -1;
}

// ============================================================
// 上下文窗口映射（`uya-agent.contextWindows`）
// ============================================================

// 映射里的条目数（`--print-config` 用）
export fn mx_win_count(t: &const McTable) usize {
    return t.nwin;
}

// 装载时被跳过的非法条目数（> 0 时调用方要打一行 warning：静默丢配置比报错更坏）
export fn mx_win_bad(t: &const McTable) usize {
    return t.nwin_bad;
}

// 这个 (provider, model) 在映射里写了窗口吗？返回 > 0 = 写了，-1 = 没写。
//
// 两级、**精确**匹配：
//   ① `提供方/名字`（提供方为空时不参与）—— 同名模型跨提供方时用它指定是哪一家；
//   ② 裸名字 —— 「这个模型名在这儿都是这个窗口」的粗口径。
// 整串逐字节比（不做前缀、不做大小写折叠）：模型名是标识符，不是路径。两级都不命中才 -1。
export fn mx_win_find(t: &const McTable, provider: &const byte, pn: usize,
                      model: &const byte, mn: usize) i64 {
    if mn == 0 {
        return -1;
    }
    if pn > 0 {
        var pair: Buf = buf_new(pn + mn + 8);
        defer { buf_free(&pair); }
        _ = buf_append(&pair, provider, pn);
        _ = buf_append_byte(&pair, 47);            // '/'
        _ = buf_append(&pair, model, mn);
        const hit: i64 = mx_win_scan(t, pair.ptr as &const byte, pair.len);
        if hit > 0 {
            return hit;
        }
    }
    return mx_win_scan(t, model, mn);
}

// 在映射里找**整串等于** (key, kn) 的那一条；没有就 -1
fn mx_win_scan(t: &const McTable, key: &const byte, kn: usize) i64 {
    if kn == 0 {
        return -1;
    }
    var i: usize = 0;
    while i < t.nwin {
        const w: &const MxWin = mx_win_ref(t, i);
        if w.key.len == kn && bufx_mem_eq(w.key.ptr as &const byte, key, kn) {
            return w.window;
        }
        i = i + 1;
    }
    return -1;
}

// ============================================================
// 解析
// ============================================================

// settings.yaml 里 provider / 模型条目的 compat 开关（键在嵌套的 `compat:` 映射里，
// 与 dshcfg.uya 的 dsh_compat_bool 同一口径）。provider 级是默认，模型级覆盖。
fn mx_compat_bool(t: &const YTree, node: i32, key: &const byte) i8 {
    if node < 0 {
        return -1;
    }
    const c: i32 = yt_get(t, node, "compat");
    if c < 0 {
        return -1;
    }
    const v: &[byte] = yt_get_str(t, c, key);
    if v.len == 4 && bufx_mem_eq(v.ptr as &const byte, "true" as &const byte, 4) {
        return 1;
    }
    if v.len == 5 && bufx_mem_eq(v.ptr as &const byte, "false" as &const byte, 5) {
        return 0;
    }
    return -1;
}

// 一个模型条目的 `reasoningEfforts`：映射的**键**就是公布的档位。
//   * 键不存在      → declared=false, reasoning=false（不推断）
//   * `false` 标量  → declared=true,  reasoning=false（非推理模型，界面不显示 Effort）
//   * 映射          → declared=true, reasoning=true, levels=键位图
fn mx_read_efforts(t: &const YTree, e: i32, out: &McEntry) void {
    const node: i32 = yt_get(t, e, "reasoningEfforts");
    if node < 0 {
        return;   // 没写这个键：什么都不推断
    }
    out.declared = true;
    const k: u8 = yt_kind(t, node);
    if k != YK_MAP {
        // 标量：DSH 只认 `false`（zk 的 union 另一支就是它）；别的值一律当「有声明、无档位」，
        // 不认识就不公布档位 —— 绝不猜成「全档位可用」。
        out.reasoning = false;
        return;
    }
    var c: i32 = yt_child(t, node);
    var any: bool = false;
    while c >= 0 {
        const key: &[byte] = yt_key(t, c);
        const li: i32 = mx_level_index(key.ptr as &const byte, key.len);
        if li >= 0 {
            const liu: usize = li as usize;
            if liu < MX_LEVELS {
                out.levels[liu] = true;
            }
            any = true;
        }
        c = yt_next(t, c);
    }
    out.reasoning = any;
}// 把 provider 节点下 models[] 的每一条摊进表里。
// 注意 uya 的约束：**整条结构体不能在循环里赋值**（「循环中的变量不能移动」），所以这里是
// 「拿到槽位指针 + 逐字段写」的写法（与 agent.uya 的 hist_push_msg_kind 同一手法）。
fn mx_collect_provider(t: &const YTree, prov: i32, pname: &const byte, pn: usize, out: &McTable) void {
    const models: i32 = yt_get(t, prov, "models");
    if models < 0 {
        return;
    }
    // provider 级 compat 是默认值
    const pdev: i8 = mx_compat_bool(t, prov, "supportsDeveloperRole");
    const pstore: i8 = mx_compat_bool(t, prov, "supportsStore");
    const preason: i8 = mx_compat_bool(t, prov, "supportsReasoningEffort");
    const n: usize = yt_len(t, models);
    var i: usize = 0;
    while i < n && out.n < MX_MAX {
        const ent: i32 = yt_at(t, models, i);
        if ent >= 0 && yt_kind(t, ent) == YK_MAP {
            const id: &[byte] = yt_get_str(t, ent, "id");
            if id.len > 0 {
                const slot: &McEntry = mx_at_mut(out, out.n);
                slot.context_window = yt_get_i64(t, ent, "contextWindow", -1);
                slot.max_tokens = yt_get_i64(t, ent, "maxTokens", -1);
                slot.input_image = MX_IMG_UNSET;
                slot.reasoning = false;
                slot.declared = false;
                slot.compat_dev_role = pdev;
                slot.compat_store = pstore;
                slot.compat_reasoning = preason;
                var li: usize = 0;
                while li < MX_LEVELS {
                    slot.levels[li] = false;
                    li = li + 1;
                }
                slot.provider = buf_new(pn + 8);
                _ = buf_append(&slot.provider, pname, pn);
                slot.model = buf_new(id.len + 8);
                _ = buf_append(&slot.model, id.ptr as &const byte, id.len);
                const nm: &[byte] = yt_get_str(t, ent, "name");
                slot.name = buf_new(id.len + 8);
                if nm.len > 0 {
                    _ = buf_append(&slot.name, nm.ptr as &const byte, nm.len);
                } else {
                    _ = buf_append(&slot.name, id.ptr as &const byte, id.len);
                }
                // P84：`input:` **存在**就先记「声明过」（MX_IMG_NO），扫到 `image` 再翻成 YES。
                // 键**不存在** ⇒ 留 MX_IMG_UNSET（= 没声明 ⇒ 按「默认支持」沿用现状）。
                const inp: i32 = yt_get(t, ent, "input");
                if inp >= 0 {
                    slot.input_image = MX_IMG_NO;
                    const nn: usize = yt_len(t, inp);
                    var m: usize = 0;
                    while m < nn {
                        const iv: i32 = yt_at(t, inp, m);
                        const sv: &[byte] = yt_str(t, iv);
                        if sv.len == 5 && bufx_mem_eq(sv.ptr as &const byte, "image" as &const byte, 5) {
                            slot.input_image = MX_IMG_YES;
                        }
                        m = m + 1;
                    }
                }
                mx_read_efforts(t, ent, slot);
                // 模型级 compat 覆盖 provider 级（DSH：模型级赢）
                const md: i8 = mx_compat_bool(t, ent, "supportsDeveloperRole");
                if md >= 0 {
                    slot.compat_dev_role = md;
                }
                const ms: i8 = mx_compat_bool(t, ent, "supportsStore");
                if ms >= 0 {
                    slot.compat_store = ms;
                }
                const mr: i8 = mx_compat_bool(t, ent, "supportsReasoningEffort");
                if mr >= 0 {
                    slot.compat_reasoning = mr;
                }
                out.n = out.n + 1;
            }
        }
        i = i + 1;
    }
}

// 载入目录。返回 false = 文件读不到（目录保持为空）。
// 装载：读 `<home>/settings.yaml`，`llm-pi-ai.providers.<prov>.models[]` 是主路线，
// `llm-deepseek.models[]` 是官方回退（不带 providers 一层），`uya-agent.contextWindows`
// 是本仓自己的「模型 → 上下文窗口」映射。provider 的枚举顺序就是 settings.yaml 里的
// 书写顺序（DSH 也是这个序）。
export fn mx_load(home: &const byte, out: &McTable) bool {
    // 0.2.0 的目录来源是**两份合起来**：`settings.yaml`（legacy，可能已经被导入并改名
    // 成 `.imported` ⇒ 读不到）+ profile 的 patch 文档（`cordis.patch.yml`，页面写的就是
    // 它）。`dshd_settings_text` 做这次合并，并把它翻译成本函数认识的形状 ——
    // 于是「页面里加的提供方」与「模型选择器里能选的」是同一份真值源。
    // home 用**调用方传进来的**那个（它是 `dsh_home_resolve` 的结果）；下游不再读 env。
    var text: Buf = buf_new(65536);
    defer { buf_free(&text); }
    var spath: Buf = buf_new(bufx_cstr_len(home) + 32);
    defer { buf_free(&spath); }
    _ = buf_append_cstr(&spath, home);
    _ = buf_append_cstr_z(&spath, "/settings.yaml");
    var legacy: Buf = buf_new(65536);
    defer { buf_free(&legacy); }
    _ = dshd_read_text(spath.ptr as &const byte, &legacy);
    if !dshd_settings_text(&legacy, home, &text) {
        return false;
    }
    if text.len == 0 {
        return false;
    }
    var tree: YTree = YTree{ nodes: [], n: 0, lines: [], nlines: 0, raw: buf_empty(), cur: 0, err_line: 0 };
    yt_init(&tree);
    defer { yt_free(&tree); }
    if !yt_parse_text(&text, &tree) {
        return false;
    }
    const root: i32 = yt_root(&tree);
    if root < 0 {
        return false;
    }
    out.loaded = true;
    // llm-pi-ai.providers.<prov>.models[]（真机的主路线）
    const pi: i32 = yt_get(&tree, root, "llm-pi-ai");
    if pi >= 0 {
        const provs: i32 = yt_get(&tree, pi, "providers");
        if provs >= 0 && yt_kind(&tree, provs) == YK_MAP {
            var c: i32 = yt_child(&tree, provs);
            while c >= 0 {
                const key: &[byte] = yt_key(&tree, c);
                if key.len > 0 && yt_kind(&tree, c) == YK_MAP {
                    mx_collect_provider(&tree, c, key.ptr as &const byte, key.len, out);
                }
                c = yt_next(&tree, c);
            }
        }
    }
    // llm-deepseek.models[]（官方路线的回退形态：没有 providers 包一层）
    const dd: i32 = yt_get(&tree, root, "llm-deepseek");
    if dd >= 0 {
        const ddname: &const byte = "llm-deepseek" as &const byte;
        mx_collect_provider(&tree, dd, ddname, bufx_cstr_len(ddname), out);
    }
    // uya-agent.contextWindows（本仓自己的映射；别人的设置文件里没有这一节 = 零影响）
    mx_read_windows(&tree, root, out);
    return true;
}

// 纯十进制正整数（无正负号、无空白、无 `K`/`M` 后缀，1..MX_WIN_MAX_VALUE）；
// 不合规返回 -1。`uya-agent.contextWindows` 的值与 `--context-window` / 
// `UYA_AGENT_CONTEXT_WINDOW` 三个入口**共用这一份**判据（口径分叉过一次，不再分）。
//
// 为什么不用 `yt_get_i64` / `parse_i32_arg`：它们「解析到第一个非数字字符即停止」，于是
// `256K` 静默变成 256、`abc` 变成 0 —— 一个**静默误读的上下文窗口**会让压缩触发线跑到一个
// 谁也不认识的位置（太小则每步都压缩、太大则永不压缩），比直接拒绝这条配置坏得多。
export fn mx_plain_positive(p: &const byte, n: usize) i64 {
    if n == 0 || n > 9 {
        return -1;
    }
    var v: i64 = 0;
    var i: usize = 0;
    while i < n {
        if !is_digit(p[i]) {
            return -1;
        }
        const mch: i64 = p[i] as i64;
        const mv10: i64 = v *% 10;
        v = mv10 +% (mch -% 48);
        i = i + 1;
    }
    if v <= 0 || v > MX_WIN_MAX_VALUE {
        return -1;
    }
    return v;
}

// 读 `uya-agent.contextWindows`：一个映射，`<键>: <窗口>`，键是 `提供方/名字` 或裸名字。
//   * 值非法（非纯十进制正整数）/ 键为空 / 超出 MX_WIN_MAX 条 ⇒ **跳过并计数**（`nwin_bad`），
//     不中止装载 —— `--print-config` 据此说得出「跳过了几条」，不静默丢配置；
//   * 没有这一节时 `nwin` 与 `nwin_bad` 都留 0（与没有这个键**逐字一致**，自测钉这条）；
//   * 键**原样存整串**（不 trim、不折大小写）：查找是整串逐字节比较，写错了就是查不到，
//     不做任何「猜测性」匹配。
fn mx_read_windows(t: &const YTree, root: i32, out: &McTable) void {
    const ua: i32 = yt_get(t, root, "uya-agent");
    if ua < 0 {
        return;
    }
    const node: i32 = yt_get(t, ua, "contextWindows");
    if node < 0 || yt_kind(t, node) != YK_MAP {
        return;
    }
    var c: i32 = yt_child(t, node);
    while c >= 0 {
        const key: &[byte] = yt_key(t, c);
        const val: &[byte] = yt_str(t, c);
        const w: i64 = mx_plain_positive(val.ptr as &const byte, val.len);
        if key.len == 0 || w <= 0 || out.nwin >= MX_WIN_MAX {
            out.nwin_bad = out.nwin_bad + 1;
        } else {
            const slot: &MxWin = mx_win_mut(out, out.nwin);
            slot.key = buf_new(key.len + 8);
            _ = buf_append(&slot.key, key.ptr as &const byte, key.len);
            slot.window = w;
            out.nwin = out.nwin + 1;
        }
        c = yt_next(t, c);
    }
}

// 「没设置」也要能给出一个可用的单条目录（--no-dsh-config / 读不到设置）：把当前 model 当唯一条目
// 塞进去 —— 界面于是仍能显示「现在用的是它」，只是没有别的可选（不合成别的模型）。
export fn mx_seed_sole(t: &McTable, provider: &const byte, pn: usize, model: &const byte, mn: usize) void {
    if t.n > 0 || mn == 0 {
        return;
    }
    const slot: &McEntry = mx_at_mut(t, 0);
    slot.provider = buf_new(pn + 8);
    _ = buf_append(&slot.provider, provider, pn);
    slot.model = buf_new(mn + 8);
    _ = buf_append(&slot.model, model, mn);
    slot.name = buf_new(mn + 8);
    _ = buf_append(&slot.name, model, mn);
    t.n = 1;
}
