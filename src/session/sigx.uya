// src/session/sigx.uya — 信号层（P0）
//
// 本文件：信号号常量（`SIGX_SIGHUP`/`INT`/`PIPE`/`TERM`/`TTOU`/`USR1`/`WINCH`）、宿主 glibc
//   `sigaction` 的 `SigxAction` 布局、安装/卸载（`sigx_set`/`sigx_install_terminal`/
//   `sigx_install_winch`/`sigx_disarm`/`sigx_reset_for_child`）、两个处理器
//   （`sigx_on_term`/`sigx_on_winch`）、恢复信息登记（`sigx_capture_termios`/`sigx_arm`）
//   与取用（`sigx_winch_take`/`sigx_seq_len`/`sigx_seq_at`）。
// 不变量：① **绝不用 `libc.signal.signal`** —— 它传 `sa_flags=0`/`sa_restorer=null`，
//   x86-64 上内核要 sa_restorer 里的 `rt_sigreturn` 垫片，缺了处理器一次都不执行、进程直接
//   SIGSEGV(139)（实测复现）；本文件绑**宿主 glibc 的 `sigaction`**，由宿主负责 SA_RESTORER
//   与掩码翻译；② 处理器体内只允许**异步信号安全**调用（`sys_write`/`sys_ioctl`/`sys_exit`/
//   `sigaction`），数据全部来自启动时填好的**静态数组**（不分配、不用 Buf、不打印）；
//   ③ 终止类信号（TERM/INT/HUP/PIPE）一律**先恢复终端再退出**：临时把 SIGTTOU 置 `SIG_IGN`
//   （进程组不是终端前台组时 `tcsetattr` 会让内核给整个进程组发 SIGTTOU、默认处置是停住 ⇒
//   终端留在 raw、进程既不退出也杀不动），然后还原 termios、写静态恢复序列、`sys_exit(128+sig)`；
//   ④ SIGWINCH **只置标志**，主循环 `sigx_winch_take()` 取用后立刻重排；
//   ⑤ fork 出来的子进程**一律**调 `sigx_reset_for_child()` 把处置恢复默认（信号处置是继承的，
//   否则子进程收到 TERM 会去写父进程的终端）；⑥ `sigx_set` 的 `handler == null` 是 `SIG_DFL`，
//   忽略处置必须用 `SIGX_SIG_IGN`（glibc 的 `(void*)1`）；⑦ `SigxAction` 是**宿主 glibc** 的
//   布局，不是内核 `rt_sigaction` 的布局；恢复序列静态缓冲 `SIGX_SEQ_MAX`=64（最长形态 47 字节）。
// 依赖：libc.syscall/unistd + 宿主 glibc 的 `sigaction` 符号（`extern "libc"`）；本文件没有
//   本仓其它域的依赖。
// 命名：对外 `sigx_*`（安装 / 登记 / 取用）+ `SIGX_*` 常量与类型 `SigxAction`；
//   静态状态一律 `g_sigx_*`。
//
// 为什么不用 `libc.signal.signal`：
//   uya 0.10 / 1.0 的 signal() 自己走裸 rt_sigaction，传的是 `sa_flags = 0`、
//   `sa_restorer = null`。x86-64 上内核交付信号时要用 sa_restorer 里的 rt_sigreturn
//   垫片（glibc/musl 一律置 SA_RESTORER = 0x04000000 并指向自己的垫片），缺了它
//   处理器体一次都不会执行、进程直接以 SIGSEGV(139) 退出 —— 本项目实测复现过
//   （见 §16 踩坑 20/28）。
//   该缺陷已在 uya 项目侧修复（uya 仓库 commit fad26acd，lib/libc/signal.uya 与 0.11
//   的同名实现对齐）。**本项目仍然走自己的路径**：绑定宿主 glibc 的 sigaction，
//   让宿主负责 SA_RESTORER 与掩码翻译，这样在没修过的工具链上也能工作。
//
// 本模块提供三件事（都只依赖 libc.syscall 与 glibc 的 sigaction 符号）：
//   1) 终止类信号（TERM/INT/HUP/PIPE）→ **先恢复终端再退出**（备用屏幕 + termios +
//      终端标题栈，见 `sigx_arm` 的 `title_pop`）；
//   2) SIGWINCH → 只置一个标志，主循环取用后立刻重排；
//   3) fork 出来的子进程用 `sigx_reset_for_child()` 把处置恢复成默认（否则子进程
//      收到信号会去写父进程的终端）。
//
// 处理器里只允许异步信号安全的东西：`sys_write` / `sys_ioctl` / `sys_exit`，
// 数据全部来自启动时填好的**静态数组**（不分配、不用 Buf、不打印）。

use libc.syscall;
use libc.unistd;

const SIGX_TCGETS: i64 = 0x5401;
const SIGX_TCSETS: i64 = 0x5402;

export const SIGX_SIGHUP: i32 = 1;
export const SIGX_SIGINT: i32 = 2;
export const SIGX_SIGPIPE: i32 = 13;
export const SIGX_SIGTERM: i32 = 15;
export const SIGX_SIGTTOU: i32 = 22;
export const SIGX_SIGUSR1: i32 = 10;
export const SIGX_SIGWINCH: i32 = 28;

// SIG_IGN（glibc 的 `(void*)1`）。`sigx_set` 的 null 是 SIG_DFL，所以忽略处置要单独给这个值。
const SIGX_SIG_IGN: usize = 1;

// glibc 的 struct sigaction（x86-64）：handler(8) + mask(128) + flags(4)+pad(4) + restorer(8)
// 注意：这是**宿主 glibc** 的布局，不是内核 rt_sigaction 的布局 —— 我们不碰裸系统调用。
export struct SigxAction {
    handler: &void,
    mask: [byte: 128],
    flags: i32,
    pad: i32,
    restorer: &void,
}

extern "libc" fn sigaction(sig: i32, act: &const SigxAction, old: &SigxAction) i32;

const SIGX_SA_RESTART: i32 = 0x10000000;
const SIGX_TERMIOS_SIZE: usize = 64;
// 恢复序列的静态缓冲：最长形态 = 8(关鼠标编码) + 8(关鼠标协议) + 8(关括起粘贴)
// + 4(复位) + 6(显示光标) + 5(弹标题栈, P22) + 8(离开备用屏幕) = 47 字节
const SIGX_SEQ_MAX: usize = 64;

// ---- 处理器要用的静态状态（启动时填好，处理器只读）----
var g_sigx_armed: bool = false;                 // 是否登记过恢复信息
var g_sigx_alt: bool = false;                   // 是否在备用屏幕
var g_sigx_out_fd: i32 = -1;                    // 输出 fd（TUI 的私有 dup）
var g_sigx_have_termios: bool = false;
var g_sigx_termios: [byte: SIGX_TERMIOS_SIZE] = [0: SIGX_TERMIOS_SIZE];
var g_sigx_seq: [byte: SIGX_SEQ_MAX] = [0: SIGX_SEQ_MAX];
var g_sigx_seq_len: usize = 0;

// ---- 观测用 ----
var g_sigx_winch: bool = false;
var g_sigx_term_hits: usize = 0;
var g_sigx_winch_hits: usize = 0;
var g_sigx_term_installed: bool = false;
var g_sigx_winch_installed: bool = false;
var g_sigx_last_err: i32 = 0;

// 取一个指针的整数值（`sys_ioctl` 的请求参数要整数形式；处理器里不许解引用）
fn sigx_addr(p: &const void) i64 {
    return (@usize_from_ptr(p)) as i64;
}

// ============================================================
// 安装 / 卸载
// ============================================================

// 装一个处理器；handler == null 表示恢复默认处置（SIG_DFL）。返回 0 成功。
export fn sigx_set(sig: i32, handler: &void) i32 {
    var act: SigxAction = SigxAction{
        handler: handler,
        mask: [0: 128],
        flags: SIGX_SA_RESTART,
        pad: 0,
        restorer: null,
    };
    const r: i32 = sigaction(sig, &act, null as &SigxAction);
    if r != 0 {
        g_sigx_last_err = r;
    }
    return r;
}

// 处理器里只做：恢复 termios → 写「离开备用屏幕」的序列 → 退出（128+sig）
//
// P38：「把终端还回去」这一步**绝不能被 SIGTTOU 停住**。进程组不是终端前台组时（被后台化、
// 或被测试/父进程放在后台组里跑），对控制终端 `tcsetattr` 会让内核给**整个进程组**发 SIGTTOU
// —— 默认处置是"停住"，于是终端留在 raw 模式、进程既不退出也杀不动，只能等外面超时（详见
// §16 踩坑 60）。POSIX 规定 SIGTTOU 被忽略（或阻塞）时该调用照常生效，所以这里在动手之前
// 临时把它置 SIG_IGN：`sigaction` 是异步信号安全的，而且我们紧接着就 `sys_exit`，处置不必还原。
export fn sigx_on_term(sig: i32) void {
    g_sigx_term_hits = g_sigx_term_hits + 1;
    if g_sigx_armed {
        _ = sigx_set(SIGX_SIGTTOU, SIGX_SIG_IGN as &void);
        if g_sigx_have_termios {
            _ = sys_ioctl(0, SIGX_TCSETS, sigx_addr(&g_sigx_termios[0] as &const void)) catch {};
        }
        if g_sigx_out_fd >= 0 && g_sigx_seq_len > 0 {
            _ = sys_write(g_sigx_out_fd, &g_sigx_seq[0] as *const byte, g_sigx_seq_len) catch {};
        }
    }
    sys_exit(128 + sig);
}

// SIGWINCH 处理器：**只加计数 + 置标志**，真正重排留给主循环（处理器里不许干重活）
export fn sigx_on_winch(sig: i32) void {
    g_sigx_winch_hits = g_sigx_winch_hits + 1;
    g_sigx_winch = true;
}

// 保存「原始终端属性」（进入 raw 模式**之前**调用；处理器用它把终端还原回去）
export fn sigx_capture_termios(fd: i32) bool {
    var zero: [byte: SIGX_TERMIOS_SIZE] = [0: SIGX_TERMIOS_SIZE];
    var i: usize = 0;
    while i < SIGX_TERMIOS_SIZE {
        g_sigx_termios[i] = zero[i];
        i = i + 1;
    }
    const r: !i32 = sys_ioctl(fd, SIGX_TCGETS, sigx_addr(&g_sigx_termios[0] as &const void));
    const rc: i32 = r catch { -1; };
    g_sigx_have_termios = rc == 0;
    return g_sigx_have_termios;
}

// 登记「退出时怎么把终端还回去」：输出 fd + 是否在备用屏幕 + 是否要弹标题栈。
// 序列固定为：关鼠标上报 → 关闭括起粘贴 → 复位属性 → 显示光标 →（可选）弹标题栈
// →（可选）离开备用屏幕。
// 弹标题栈（`ESC [ 2 3 t`）配合 `tty_title_begin` 的压栈（`ESC [ 2 2 t`）：被信号打断时
// 也要把标题还给用户（终端不支持标题栈就忽略这两条，见 §11.7）。
//
// P25：TUI 现在会开鼠标上报（`ESC[?1000h/1006h`，否则滚轮会被 xterm.js 伪装成 ↑/↓）。
// 被信号打断时**必须**把这两条关回去，否则退出后鼠标事件继续往 shell/编辑器里灌
// —— 用户会在终端里看到一串 `\e[<64;12;5M`。
export fn sigx_arm(out_fd: i32, alt: bool, title_pop: bool) void {
    g_sigx_out_fd = out_fd;
    g_sigx_alt = alt;
    var k: usize = 0;
    // ESC[?1006l（与 tui_term_enter 的开法相反：先关编码再关协议）
    g_sigx_seq[k] = 27; k = k + 1;
    g_sigx_seq[k] = 91; k = k + 1;
    g_sigx_seq[k] = 63; k = k + 1;
    g_sigx_seq[k] = 49; k = k + 1;
    g_sigx_seq[k] = 48; k = k + 1;
    g_sigx_seq[k] = 48; k = k + 1;
    g_sigx_seq[k] = 54; k = k + 1;
    g_sigx_seq[k] = 108; k = k + 1;
    // ESC[?1000l
    g_sigx_seq[k] = 27; k = k + 1;
    g_sigx_seq[k] = 91; k = k + 1;
    g_sigx_seq[k] = 63; k = k + 1;
    g_sigx_seq[k] = 49; k = k + 1;
    g_sigx_seq[k] = 48; k = k + 1;
    g_sigx_seq[k] = 48; k = k + 1;
    g_sigx_seq[k] = 48; k = k + 1;
    g_sigx_seq[k] = 108; k = k + 1;
    // ESC[?2004l
    g_sigx_seq[k] = 27; k = k + 1;
    g_sigx_seq[k] = 91; k = k + 1;
    g_sigx_seq[k] = 63; k = k + 1;
    g_sigx_seq[k] = 50; k = k + 1;
    g_sigx_seq[k] = 48; k = k + 1;
    g_sigx_seq[k] = 48; k = k + 1;
    g_sigx_seq[k] = 52; k = k + 1;
    g_sigx_seq[k] = 108; k = k + 1;
    // ESC[0m
    g_sigx_seq[k] = 27; k = k + 1;
    g_sigx_seq[k] = 91; k = k + 1;
    g_sigx_seq[k] = 48; k = k + 1;
    g_sigx_seq[k] = 109; k = k + 1;
    // ESC[?25h
    g_sigx_seq[k] = 27; k = k + 1;
    g_sigx_seq[k] = 91; k = k + 1;
    g_sigx_seq[k] = 63; k = k + 1;
    g_sigx_seq[k] = 50; k = k + 1;
    g_sigx_seq[k] = 53; k = k + 1;
    g_sigx_seq[k] = 104; k = k + 1;
    if title_pop {
        // ESC[23t（弹标题栈）：P22 的终端标题
        g_sigx_seq[k] = 27; k = k + 1;
        g_sigx_seq[k] = 91; k = k + 1;
        g_sigx_seq[k] = 50; k = k + 1;
        g_sigx_seq[k] = 51; k = k + 1;
        g_sigx_seq[k] = 116; k = k + 1;
    }
    if alt {
        // ESC[?1049l
        g_sigx_seq[k] = 27; k = k + 1;
        g_sigx_seq[k] = 91; k = k + 1;
        g_sigx_seq[k] = 63; k = k + 1;
        g_sigx_seq[k] = 49; k = k + 1;
        g_sigx_seq[k] = 48; k = k + 1;
        g_sigx_seq[k] = 52; k = k + 1;
        g_sigx_seq[k] = 57; k = k + 1;
        g_sigx_seq[k] = 108; k = k + 1;
    }
    g_sigx_seq_len = k;
    g_sigx_armed = true;
}

// 安装终止类处理器（TERM/INT/HUP/PIPE）。term_fd 用来读原始终端属性（一般传 0）。
// 返回是否全部装好；失败不致命（只是没有「退出前恢复终端」）。
export fn sigx_install_terminal(term_fd: i32) bool {
    _ = sigx_capture_termios(term_fd);
    var ok: bool = true;
    if sigx_set(SIGX_SIGTERM, &sigx_on_term as &void) != 0 {
        ok = false;
    }
    if sigx_set(SIGX_SIGINT, &sigx_on_term as &void) != 0 {
        ok = false;
    }
    if sigx_set(SIGX_SIGHUP, &sigx_on_term as &void) != 0 {
        ok = false;
    }
    if sigx_set(SIGX_SIGPIPE, &sigx_on_term as &void) != 0 {
        ok = false;
    }
    g_sigx_term_installed = ok;
    return ok;
}

// 装 SIGWINCH 处理器（只置标志那种）；返回是否装成功，结果记在 g_sigx_winch_installed
export fn sigx_install_winch() bool {
    const r: i32 = sigx_set(SIGX_SIGWINCH, &sigx_on_winch as &void);
    g_sigx_winch_installed = r == 0;
    return r == 0;
}

// 退出前把处置恢复成默认：这样 TUI 正常退出之后残留的信号不会再触发「恢复终端」
export fn sigx_disarm() void {
    g_sigx_armed = false;
    _ = sigx_set(SIGX_SIGTERM, null);
    _ = sigx_set(SIGX_SIGINT, null);
    _ = sigx_set(SIGX_SIGHUP, null);
    _ = sigx_set(SIGX_SIGPIPE, null);
    _ = sigx_set(SIGX_SIGWINCH, null);
    g_sigx_term_installed = false;
    g_sigx_winch_installed = false;
}

// fork 之后、子进程 exec 之前（或 fork 不 exec 的子代理进程里）调用：
// 信号处置是继承的，子进程若带着我们的处理器，收到 TERM 会去写**父进程的终端**。
export fn sigx_reset_for_child() void {
    g_sigx_armed = false;
    g_sigx_winch = false;
    _ = sigx_set(SIGX_SIGTERM, null);
    _ = sigx_set(SIGX_SIGINT, null);
    _ = sigx_set(SIGX_SIGHUP, null);
    _ = sigx_set(SIGX_SIGPIPE, null);
    _ = sigx_set(SIGX_SIGWINCH, null);
}

// ============================================================
// 取用 / 观测
// ============================================================

// SIGWINCH 到了没有（取用即清零）
export fn sigx_winch_take() bool {
    if !g_sigx_winch {
        return false;
    }
    g_sigx_winch = false;
    return true;
}







// 恢复序列的字节数（`sigx_arm` 写进去的那串；都被信号处理器直接 sys_write 出去）
export fn sigx_seq_len() usize {
    return g_sigx_seq_len;
}

// 恢复序列第 i 个字节；i 越界回 0（自测逐字节断言这串转义序列）
export fn sigx_seq_at(i: usize) byte {
    if i >= SIGX_SEQ_MAX {
        return 0;
    }
    return g_sigx_seq[i];
}





// ============================================================
// P60：web 模式的退出握手
// ============================================================
//
// 与 TUI 的区别：web 模式下**没有终端要还原**（stdout 是日志），但**有一堆子进程
// 要收**（每个会话一个真 PTY 上的 agent）。而 `sigx_on_term` 是「self-contained」
// 的 —— 它立刻 `sys_exit`（那是对的：终端必须马上还回去）。所以 web 模式**不能**
// 用它：`sys_exit` 会让所有会话子进程变成孤儿，用户会在 `ps` 里看到一堆残留的
// agent（而它们的父进程已经没了、PTY master 也关了，等于一堆等着写 EIO 的僵尸）。
//
// 所以这里用**第二种处理器**：只置一个标志，主循环看到之后走正常收尾（逐个按进程
// 组收子进程），然后自己返回、正常退出。这是「异步信号安全」那条纪律的同一个理由：
// 处理器里只做能做的事（写一个 bool），把重活留给主循环。
var g_sigx_web_quit: bool = false;

// web 模式的终止处理器：**只置标志**（见上面那段）。
export fn sigx_on_web_term(sig: i32) void {
    _ = sig;
    g_sigx_web_quit = true;
}

// 装 web 模式的终止处理器（SIGINT / SIGTERM / SIGHUP）。
// SIGPIPE 仍然忽略：往已经关掉的 PTY 写会拿到 EPIPE，我们不想被它杀掉。
export fn sigx_install_web() bool {
    const a: i32 = sigx_set(SIGX_SIGINT, &sigx_on_web_term as &void);
    const b: i32 = sigx_set(SIGX_SIGTERM, &sigx_on_web_term as &void);
    const c: i32 = sigx_set(SIGX_SIGHUP, &sigx_on_web_term as &void);
    _ = sigx_set(SIGX_SIGPIPE, SIGX_SIG_IGN as &void);
    return a == 0 && b == 0 && c == 0;
}

// web 模式收到过终止信号没有（主循环每圈问它一次）。
export fn sigx_web_quit_wanted() bool {
    return g_sigx_web_quit;
}
