// src/session/dshcred.uya — 凭据文件（`$DSH_HOME/.credentials.yaml`）的读写
//
// 本文件：`dshd_cred_get` / `dshd_cred_set` / `dshd_cred_unset` —— 设置页那一簇
//   （`credentials/describe|set|unset`）背后的那一层。形状（DSH 的
//   `dsh-credentials-local` 定的，**不等于** patch 文档那套）：
//     version: 1
//     refs:
//       OPENCODE_API_KEY: "oc_…"
//     records: {…}
// 一行逻辑都在 `session/dshdoc.uya` 的 `dshd_kv_*`（顶层一个 map、里面一堆键值），
// 这里只管**文件这一层**的三件事：拼路径、文件不在时建一份骨架、把返回码翻成人话。
//
// 不变量：三条都有真现场 ——
//   ① **模式必须 0600** —— DSH 自己拒绝启动在更宽的权限上（`dsh-credentials-local`
//      会 stat 一次），所以骨架按 0600 现建、改写走 `dshd_kv_set`（临时文件 0600 + rename）；
//   ② **文件不存在也允许写** —— 那份文件是 DSH 自己管的机器文件（它第一次输密钥时
//      也是现建的），与「不替用户造 settings.yaml」不是同一件事（那条说的是人写的设置）；
//   ③ **读不到就是「没配」**，不是错误 —— 界面上那是一颗灰点，不是一片红字。
// 依赖：本仓 session/dshdoc（`dshd_kv_get|set`）、session/dshfile（`dshd_write_new`）、
//   foundation/bufx。
// 命名：对外 `dshd_cred_*`；私有 `dshc_*`。

// 拼 `<home>/.credentials.yaml`（尾 NUL：`dshd_write_new` 等吃 C 串）。
fn dshc_path(home: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if home.len == 0 {
        return false;
    }
    if !buf_append(out, home.ptr as &const byte, home.len) {
        return false;
    }
    if !buf_append_cstr(out, "/.credentials.yaml") {
        return false;
    }
    return buf_append_byte(out, 0);
}

// DSH 的骨架（`version: 1` + **块状**的空 `refs:`：写侧只认块状写法）。
const DSHC_SKELETON: &const byte = "version: 1\nrefs:\n" as &const byte;

// 读一个 ref。0 = 有（值写进 out，已去引号）、1 = 没有、2 = 没有文件 / 读不出来。
export fn dshd_cred_get(home: &const Buf, ref: &const Buf, out: &Buf) i32 {
    buf_reset(out);
    var path: Buf = buf_new(home.len + 64);
    defer { buf_free(&path); }
    if !dshc_path(home, &path) {
        return 2;
    }
    var top: Buf = buf_new(16);
    defer { buf_free(&top); }
    _ = buf_append_cstr(&top, "refs");
    const rc: i32 = dshd_kv_get(home, path.ptr as &const byte, &top, ref, out);
    if rc == 0 {
        return 0;
    }
    if rc == 1 {
        return 1;
    }
    return 2;
}

// 写一个 ref（文件不在就按骨架现建一份）。
export fn dshd_cred_set(home: &const Buf, ref: &const Buf,
    val: &const Buf) i32 {
    var path: Buf = buf_new(home.len + 64);
    defer { buf_free(&path); }
    var top: Buf = buf_new(16);
    defer { buf_free(&top); }
    if !dshc_path(home, &path) {
        return DSHD_NOFILE;
    }
    _ = buf_append_cstr(&top, "refs");
    // 先试一次（文件多半在）：读不到就建骨架，再试。
    var rc: i32 = dshd_kv_set(home, path.ptr as &const byte, &top, ref, val);
    if rc == DSHD_NOFILE {
        var skel: Buf = buf_new(64);
        defer { buf_free(&skel); }
        _ = buf_append_cstr(&skel, DSHC_SKELETON);
        const crc: i32 = dshd_write_new(path.ptr as &const byte, &skel);
        if crc != DSHD_OK {
            return crc;
        }
        rc = dshd_kv_set(home, path.ptr as &const byte, &top, ref, val);
    }
    return rc;
}

// 删一个 ref（幂等：文件不在、键不在都是成功）。
export fn dshd_cred_unset(home: &const Buf, ref: &const Buf) i32 {
    var path: Buf = buf_new(home.len + 64);
    defer { buf_free(&path); }
    var top: Buf = buf_new(16);
    defer { buf_free(&top); }
    const empty: Buf = buf_empty();
    if !dshc_path(home, &path) {
        return DSHD_NOFILE;
    }
    _ = buf_append_cstr(&top, "refs");
    const rc: i32 = dshd_kv_set(home, path.ptr as &const byte, &top, ref,
        &empty);
    if rc == DSHD_NOFILE {
        return DSHD_OK;
    }
    return rc;
}
