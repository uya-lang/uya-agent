// src/session/inbox.uya — 用户输入收件箱（P3）
//
// 本文件：`Inbox`（`INBOX_MAX`=8 条 Buf 槽位 + 长度）与它的操作
//   `inbox_new`/`inbox_free`/`inbox_len`/`inbox_item`/`inbox_push`/`inbox_pop`，
//   加上进程级全局 `g_steer` 与 `inbox_globals_init`/`inbox_globals_free`。
// 不变量：① FIFO —— `inbox_pop` 从**队首**取并且把后面的整体前移；② 上限：条数
//   `INBOX_MAX`=8（满了 push 返回 false，**不**顶掉旧的）、单条 `INBOX_ITEM_MAX`=200000 字节
//   （超了直接拒）；③ `inbox_pop` 把内容**拷贝**到出参 `out`（出参由调用方负责释放），
//   箱内的那份随即 free —— 领取即拥有；④ 收件箱是**模块级全局**：单进程单前台界面才成立，
//   子代理是 fork 出来的独立进程所以各有一份。
// 依赖：foundation/bufx（Buf 与 `buf_new`/`buf_append`/`buf_free`）；本文件没有别域依赖。
// 命名：对外 `inbox_*`（六个操作 + 两个全局初始化）+ 类型 `Inbox` + 常量 `INBOX_MAX`/
//   `INBOX_ITEM_MAX`；进程级全局 `g_steer`。
//
// 对齐 DSH 的 steer 语义：**回合运行期间**用户敲进来的文本投到 next-step 收件箱，
// driver 在下一个 step 边界领取，作为普通 user 消息进入下一次请求（DSH 明确不给它
// 加任何包装文案）；如果回合在领取之前就结束了，文本留在箱里，成为下一轮的 prompt
// （对应 DSH `cancel(cause, { keepInbox: true })` 的保留语义）。
//
// 单进程单前台界面，所以用模块级全局；子代理是 fork 出来的独立进程，各有一份。

const INBOX_MAX: usize = 8;
const INBOX_ITEM_MAX: usize = 200000;

export struct Inbox {
    items: [Buf: INBOX_MAX],
    len: usize,
}

// 一个空收件箱：INBOX_MAX 条空 Buf 槽位、len = 0（Buf 都是 buf_empty，不分配）
export fn inbox_new() Inbox {
    var ib: Inbox = Inbox{ items: [], len: 0 };
    var i: usize = 0;
    while i < INBOX_MAX {
        ib.items[i] = buf_empty();
        i = i + 1;
    }
    return ib;
}

// 释放箱里**已用**的那些 Buf（只到 len，后面的槽位本来就没分配）并置 len = 0
export fn inbox_free(ib: &Inbox) void {
    var i: usize = 0;
    while i < ib.len {
        buf_free(&ib.items[i]);
        i = i + 1;
    }
    ib.len = 0;
}

// 现有条数（0 = 没有待领取的输入）
export fn inbox_len(ib: &const Inbox) usize {
    return ib.len;
}

// 越界时返回的那个空 Buf（inbox_item 的兜底，别让调用方拿到悬垂指针）。
var g_inbox_nil: Buf = Buf{ ptr: null, len: 0, cap: 0 };

// 只读看第 i 条：返回**内容的一份拷贝**（Buf 只有三个字，拷贝比取地址便宜也更安全）。
// 越界返回空 Buf。为什么需要它：显示层（TUI 的待发块）要按条读内容，而 `inbox_pop`
// 是**破坏性**的（取走即从箱里删掉）—— 「看一眼队列」不能等于把它们领走。
// 注意：返回值是**快照**，槽位随后的前移不会污染它（但也就不是活视图了）。
export fn inbox_item(ib: &const Inbox, i: usize) Buf {
    var r: Buf = g_inbox_nil;
    // `i < INBOX_MAX &&` 是给**检查器**看的：它推不出 `ib.len <= INBOX_MAX`，只看后者时
    // 「数组索引安全证明」会失败。而且它只认「**正的 if 里**做索引」（§16 踩坑 6）——
    // 写成 `if !(…) { return }` 再索引一样红，所以这里必须把索引放进正分支里。
    if i < INBOX_MAX && i < ib.len {
        r = ib.items[i];
    }
    return r;
}

// 入队一条（内容**拷贝**进箱）。n == 0、n > INBOX_ITEM_MAX 或箱满（INBOX_MAX=8）时返回
// false 且什么都不改 —— 满箱是丢弃新输入，不顶掉队列里已有的那些。
export fn inbox_push(ib: &Inbox, p: &const byte, n: usize) bool {
    if n == 0 || n > INBOX_ITEM_MAX {
        return false;
    }
    const idx: usize = ib.len;
    if idx >= INBOX_MAX {
        return false;
    }
    const slot: &Buf = &ib.items[idx];
    slot[0] = buf_new(n + 8);
    if !buf_valid(&slot[0]) {
        return false;
    }
    if !buf_append(&slot[0], p, n) {
        buf_free(&slot[0]);
        return false;
    }
    ib.len = idx + 1;
    return true;
}

// FIFO 弹出：内容**拷贝**到 out（out 由调用方负责释放），返回是否弹出一条
export fn inbox_pop(ib: &Inbox, out: &Buf) bool {
    if ib.len == 0 {
        return false;
    }
    buf_reset(out);
    if !buf_append(out, ib.items[0].ptr, ib.items[0].len) {
        return false;
    }
    buf_free(&ib.items[0]);
    var i: usize = 0;
    while i + 1 < ib.len {
        ib.items[i] = ib.items[i + 1];
        i = i + 1;
    }
    ib.len = ib.len - 1;
    return true;
}

// ============================================================
// 进程级全局（前台界面唯一）
// ============================================================
export var g_steer: Inbox = Inbox{ items: [], len: 0 };

// 初始化进程级收件箱（启动时调一次；重复调会丢掉箱里已有的内容）
export fn inbox_globals_init() void {
    g_steer = inbox_new();
}

// 释放进程级收件箱（退出时调一次；箱里没领取的 steer 就丢掉了）
export fn inbox_globals_free() void {
    inbox_free(&g_steer);
}
