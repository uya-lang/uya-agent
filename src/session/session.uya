// src/session/session.uya — 会话日志：写入 / 读取 / 崩溃尾部裁剪 / 索引（P4）
//
// 本文件：写侧 `SessionLog`（id / path / cwd / model / fd / seq / events）与
//   `sess_open*`/`sess_begin_at`/`sess_end`/`sess_write_index`/`sess_close`；读侧
//   `SessReader`（整文件读入后逐行取事件）、`SessMeta`（header + 最后一条
//   session/workspace 与 session/model）、`sess_read_header`/`sess_reader_load`/`sess_next`/
//   `sess_line_seq`/`sess_line_type`/`sess_find`/`sess_find_last`；索引侧
//   `SessIdxRow` 与 `sess_index_rows_sorted`（同 id 取最后一条 + lastActiveAt 倒序）；
//   以及本文件自带的 JSON 转义 / 反转义 / 数组原文抽取（`jw_str_into`、`sess_extract_array`）。
// 不变量：① `seq` 从 0 连续递增，日志**追加-only**，`time` 字段由调用方给
//   （`sess_begin_at`），必须与 stats 折叠用的时间**逐位相同**，否则 resume 前后数字不一致；
//   ② 写日志过程中**绝不许**补 NUL（`buf_append_cstr_z` 会把 `\0` 写进缓冲，
//   之后追加的内容落在 NUL 之后、系统调用只看得到前半截）；③ 最后一行没有换行结尾 =
//   崩溃时写了一半 ⇒ `sess_next` 置 `dropped_tail` 并停止，前面的行仍然全部算数；
//   ④ 索引是追加写，同一个 id **以最后一条为准**（读侧必须先按它去重）；
//   ⑤ 恢复会话只往**原文件**续写（`sess_open_resume`），不许按当前 cwd 重算路径；
//   ⑥ uya 的 `p[a: b]` 是「从 a 起 b 个**字节**」不是「到 b 为止」，切片必须写 `[pos: len]`。
// 依赖：libc.syscall/unistd/stdlib/heap（open/read/write/mkdir/opendir）、
//   std.json（encoder.JsonWriter、value.JsonStrView）、foundation/jsonx（`sv_unescape`
//   的唯一一份完整反转义）、foundation/bufx（Buf 与子串/字节查找）。
// 命名：`sess_*`（会话与索引的全部对外函数）、`session.uya` 私有的 `sess_idx_*` 排序辅助、
//   类型 `SessionLog` / `SessReader` / `SessMeta` / `SessIdxRow`、常量 `SESS_VERSION`；
//   `jw_str_into` 是给索引写入用的转义出口，规则必须与 jsonx 的 `jw_str` 保持一致。
//
// 布局（沿用 DSH 的形状，只是不压缩）：
//   <agent-home>/sessions/--<normalized-cwd>--/<session-id>/session.jsonl
//   <agent-home>/index.jsonl        每行一条索引记录，同一个 id 以**最后一条**为准
//
// 首行是 header：
//   {"type":"session","version":0,"id":"session-…","createdAt":N,"cwd":"…",
//    "delegationDepth":0,"agentPreset":"standard","model":"…","provider":"…"}
// 之后每行一个事件：
//   {"type":"<event>","seq":N,"time":N,"data":{…}}
// `seq` 从 0 连续递增；追加-only；崩溃时最后一行可能不完整 —— 读取时丢弃它。
//
// P34：header 的 `cwd` 是**创建时**的工作区（元数据，不再改写）；会话当前在哪个工作区由
// `session/workspace` 事件记录（最后一条为准），索引里的 `cwd` 是它的一份「最后已知」缓存。
// 恢复会话时日志**只往原来那份文件里续写**（sess_open_resume），不再按当前目录重算路径。
//
// 为什么不用 zstd：纯 Uya 没有 zstd 实现（DSH 默认 `.jsonl.zstd`），所以这里写裸 JSONL；
// 读 DSH 会话时改走 `unzstd` 子进程（见 dshsess.uya）。

use libc.syscall;
use libc.unistd;
use libc.stdlib;
use libc.heap;
use std.json.encoder.JsonWriter;
use std.json.value.JsonStrView;

export const SESS_VERSION: i64 = 0;
const SESS_LINE_MAX: usize = 4194304;   // 单行上限（工具结果可能很大）

// ============================================================
// 路径工具
// ============================================================
// "/home/winger/x" → "--home-winger-x--"
export fn sess_norm_cwd(cwd: &const byte, n: usize, out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "--") {
        return false;
    }
    var i: usize = 0;
    while i < n {
        const c: byte = cwd[i];
        if c == 47 as byte {
            if !buf_append_byte(out, 45) {
                return false;
            }
        } else {
            if !buf_append_byte(out, c) {
                return false;
            }
        }
        i = i + 1;
    }
    return buf_append_cstr(out, "--");
}

// 逐级 mkdir（已存在不算错）
export fn sess_mkdir_p(path: &const byte) bool {
    var i: usize = 1;
    const n: usize = bufx_cstr_len(path);
    while i <= n {
        if i == n || path[i] == 47 as byte {
            var part: Buf = buf_new(i + 2);
            if !buf_valid(&part) {
                return false;
            }
            _ = buf_append(&part, path, i);
            _ = buf_append_byte(&part, 0);
            _ = sys_mkdir(&part.ptr[0] as *const byte, 493 as u32) catch {};
            buf_free(&part);
        }
        i = i + 1;
    }
    return true;
}

// <home>/sessions/--cwd--/<id>/session.jsonl
// id 用「指针 + 长度」而不是 C 字符串：调用方手里的 id 常常是没有 NUL 结尾的 Buf
export fn sess_session_path(home: &const byte, cwd: &const byte, id: &const byte, id_len: usize, out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, home) {
        return false;
    }
    if !buf_append_cstr(out, "/sessions/") {
        return false;
    }
    var norm: Buf = buf_new(1024);
    defer { buf_free(&norm); }
    if !sess_norm_cwd(cwd, bufx_cstr_len(cwd), &norm) {
        return false;
    }
    if !buf_append(&out[0], norm.ptr, norm.len) {
        return false;
    }
    if !buf_append_byte(out, 47) {
        return false;
    }
    if !buf_append(out, id, id_len) {
        return false;
    }
    return buf_append_cstr(out, "/session.jsonl");
}

// ============================================================
// 会话 id：/dev/urandom 16 字节 → session-xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx
// ============================================================
export fn sess_new_id(out: &Buf) bool {
    buf_reset(out);
    var raw: [byte: 16] = [0: 16];
    var got: bool = false;
    var dev: [byte: 16] = "/dev/urandom";
    const fd: i32 = sys_open(&dev[0] as *const byte, O_RDONLY as i32, 0) catch {
        -1;
    };
    if fd >= 0 {
        var off: usize = 0;
        while off < 16 {
            const n: isize = sys_read(fd, &raw[off], 16 - off) catch { 0 as isize; };
            if n <= 0 {
                break;
            }
            off = off + (n as usize);
        }
        _ = sys_close(fd) catch {};
        if off == 16 {
            got = true;
        }
    }
    if !got {
        // 兜底：时间 + pid 派生
        const t: u64 = ua_now_ms();
        var i: usize = 0;
        while i < 16 {
            const mix: u64 = (t >> ((i % 8) as i32)) + ((i as u64) * (2654435761 as u64));
            raw[i] = ((mix >> 3) & 255 as u64) as byte;
            i = i + 1;
        }
    }
    raw[6] = ((raw[6] as i32 & 15) | 64) as byte;      // version 4
    raw[8] = ((raw[8] as i32 & 63) | 128) as byte;     // variant
    var hex: [byte: 32] = [0: 32];
    _ = hex_of(&raw[0], 16, &hex[0]);
    if !buf_append_cstr(out, "session-") {
        return false;
    }
    var i: usize = 0;
    while i < 32 {
        if i == 8 || i == 12 || i == 16 || i == 20 {
            if !buf_append_byte(out, 45) {
                return false;
            }
        }
        if !buf_append_byte(out, hex[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ============================================================
// 写
// ============================================================
export struct SessionLog {
    id: Buf,
    path: Buf,
    cwd: Buf,
    model: Buf,
    fd: i32,
    seq: i64,
    events: usize,
    save: bool,          // false = --no-save：不落盘（seq 仍推进）
    title: Buf,
    turns: i64,
    deleg_depth: i32,    // >0 = 这是子代理的会话（--continue 不选它）
}

// 空闲的 SessionLog：fd = -1、save = false，**不建目录不落盘**（先放进 defer 里安全）
export fn sess_log_empty() SessionLog {
    return SessionLog{
        id: buf_empty(),
        path: buf_empty(),
        cwd: buf_empty(),
        model: buf_empty(),
        fd: -1,
        seq: 0,
        events: 0,
        save: false,
        title: buf_empty(),
        turns: 0,
    };
}

// 释放 id / path / cwd / model / title 五个 Buf；fd 归 sess_close 关
export fn sess_log_free(l: &SessionLog) void {
    buf_free(&l.id);
    buf_free(&l.path);
    buf_free(&l.cwd);
    buf_free(&l.model);
    buf_free(&l.title);
}

// 把一行事件落盘（line 里已是完整的 `…}\n`）。`--no-save` 或 fd < 0 时**直接成功返回**
// 什么也不写 —— seq 的推进交给 sess_end，两者不许互相代劳。
fn sess_write_line(l: &SessionLog, line: &const Buf) bool {
    if !l.save || l.fd < 0 {
        return true;
    }
    return write_all_fd(l.fd, line.ptr as &const byte, line.len);
}

// <home>/sessions/--cwd--/<id> 逐级建目录
// 注意**不要**在中间补 NUL：buf_append_cstr_z 会把 \0 也写进缓冲，
// 之后追加的内容就落在 NUL 之后，系统调用只看到前半截（踩过）。
fn sess_mkdir_for(home: &const byte, cwd: &const byte, id: &const byte, id_len: usize) bool {
    var dir: Buf = buf_new(1600);
    defer { buf_free(&dir); }
    var norm: Buf = buf_new(1024);
    defer { buf_free(&norm); }
    if !sess_norm_cwd(cwd, bufx_cstr_len(cwd), &norm) {
        return false;
    }
    _ = buf_append_cstr(&dir, home);
    _ = buf_append_cstr(&dir, "/sessions/");
    _ = buf_append(&dir, norm.ptr, norm.len);
    _ = buf_append_byte(&dir, 47);
    _ = buf_append(&dir, id, id_len);
    _ = buf_append_byte(&dir, 0);
    _ = sess_mkdir_p(dir.ptr as &const byte);
    return true;
}

// 新建 / 续写（日志路径按 cwd 算）—— 绝大多数调用方走的入口
// want_id 为空 = 新生成一个 id；save=false 时只维护内存态（seq 照常推进，不进日志）。
export fn sess_open(
    l: &SessionLog,
    home: &const byte,
    cwd: &const byte,
    model: &const byte,
    provider: &const byte,
    want_id: &const byte,
    save: bool,
    start_seq: i64,
    write_header: bool
) bool {
    return sess_open_full(l, home, cwd, model, provider, want_id, save, start_seq, write_header, "" as &const byte, 0);
}

// P34：恢复会话 —— 往**已经解析出来的那份日志**里续写（write_header 恒 false）。
//
// 为什么不复用 sess_open：它按 cwd 重算路径，而恢复时「cwd」是会话记录的工作区、
// 日志却在**找到它的那个目录**里（sess_find 会扫全部 --*-- 目录）。用当前工作区重算
// 就会在同 id 下造出一个没有 header 的空文件，把会话劈成两半、顺手改掉索引里的
// 工作区（旧实现实测如此，见 §16 踩坑 48）。
export fn sess_open_resume(
    l: &SessionLog,
    home: &const byte,
    cwd: &const byte,
    path: &const byte,
    path_len: usize,
    model: &const byte,
    provider: &const byte,
    want_id: &const byte,
    save: bool,
    start_seq: i64
) bool {
    return sess_open_full(l, home, cwd, model, provider, want_id, save, start_seq, false, path, path_len);
}

// 建目录、写 header、打开追加 fd
// want_path 非空 = 直接用这份路径（恢复），不再按 cwd 重算、也不建目录。
fn sess_open_full(
    l: &SessionLog,
    home: &const byte,
    cwd: &const byte,
    model: &const byte,
    provider: &const byte,
    want_id: &const byte,
    save: bool,
    start_seq: i64,
    write_header: bool,
    want_path: &const byte,
    want_path_len: usize
) bool {
    l.fd = -1;
    l.seq = start_seq;
    l.events = 0;
    l.save = save;
    l.turns = 0;
    l.id = buf_new(64);
    l.cwd = buf_new(bufx_cstr_len(cwd) + 8);
    l.model = buf_new(bufx_cstr_len(model) + 8);
    l.title = buf_new(256);
    if !buf_append_cstr(&l.cwd, cwd) || !buf_append_cstr(&l.model, model) {
        return false;
    }
    if bufx_cstr_len(want_id) > 0 {
        if !buf_append_cstr(&l.id, want_id) {
            return false;
        }
    } else if !sess_new_id(&l.id) {
        return false;
    }
    if want_path_len > 0 {
        l.path = buf_new(want_path_len + 16);
        if !buf_append(&l.path, want_path, want_path_len) {
            return false;
        }
    } else {
        l.path = buf_new(1200);
        if !sess_session_path(home, cwd, l.id.ptr as &const byte, l.id.len, &l.path) {
            return false;
        }
    }
    if !l.save {
        return true;
    }
    if want_path_len == 0 {
        if !sess_mkdir_for(home, cwd, l.id.ptr as &const byte, l.id.len) {
            l.save = false;
            return false;
        }
    }

    const flags: i32 = (O_WRONLY | O_CREAT | O_APPEND) as i32;
    var pz: Buf = buf_new(l.path.len + 1);
    defer { buf_free(&pz); }
    _ = buf_append(&pz, l.path.ptr, l.path.len);
    _ = buf_append_byte(&pz, 0);
    l.fd = sys_open(&pz.ptr[0] as *const byte, flags, 420) catch {
        -1;
    };
    if l.fd < 0 {
        l.save = false;
        return false;
    }
    if !write_header {
        return true;   // 续写已有日志：header 与 seq 都已经在文件里了
    }
    // header（只写一次：新会话才写）
    var line: Buf = buf_new(2048);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "{\"type\":\"session\",\"version\":");
    _ = buf_append_i64(&line, SESS_VERSION);
    _ = buf_append_cstr(&line, ",\"id\":\"");
    _ = buf_append(&line, l.id.ptr, l.id.len);
    _ = buf_append_cstr(&line, "\",\"createdAt\":");
    _ = buf_append_u64(&line, ua_now_ms());
    _ = buf_append_cstr(&line, ",\"cwd\":");
    if !jw_str_into(&line, l.cwd.ptr as &const byte, l.cwd.len) {
        return false;
    }
    _ = buf_append_cstr(&line, ",\"delegationDepth\":");
    _ = buf_append_i64(&line, l.deleg_depth as i64);
    _ = buf_append_cstr(&line, ",\"agentPreset\":\"standard\",\"model\":");
    if !jw_str_into(&line, l.model.ptr as &const byte, l.model.len) {
        return false;
    }
    _ = buf_append_cstr(&line, ",\"provider\":");
    if !jw_str_into(&line, provider, bufx_cstr_len(provider)) {
        return false;
    }
    _ = buf_append_cstr(&line, "}\n");
    if !sess_write_line(l, &line) {
        return false;
    }
    return true;
}

// 把一个 JSON 字符串（已转义内容）追加进 out
//
// 规则必须与 jsonx.uya::jw_str（请求体那一套）保持一致：`"` `\` 与**全部** < 0x20 的控制字节
// 都要转义（短转义优先，其余走 \u00XX）—— 改一边就得改另一边，否则「写进去能读回、
// 发上去就 400」（踩坑 27）。读回那一端是 sess_json_str，它用的是同一个完整实现。
export fn jw_str_into(out: &Buf, p: &const byte, n: usize) bool {
    if !buf_append_byte(out, 34) {
        return false;
    }
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c == 34 as byte {
            if !buf_append_cstr(out, "\\\"") {
                return false;
            }
        } else if c == 92 as byte {
            if !buf_append_cstr(out, "\\\\") {
                return false;
            }
        } else if c == 10 as byte {
            if !buf_append_cstr(out, "\\n") {
                return false;
            }
        } else if c == 13 as byte {
            if !buf_append_cstr(out, "\\r") {
                return false;
            }
        } else if c == 9 as byte {
            if !buf_append_cstr(out, "\\t") {
                return false;
            }
        } else if c < 32 as byte {
            if !buf_append_cstr(out, "\\u00") {
                return false;
            }
            const hi: i32 = ((c as i32) >> 4) & 15;
            const lo: i32 = (c as i32) & 15;
            const hexd: &[byte] = &"0123456789abcdef"[0: 16];
            if !buf_append_byte(out, hexd[hi as usize]) {
                return false;
            }
            if !buf_append_byte(out, hexd[lo as usize]) {
                return false;
            }
        } else {
            if !buf_append_byte(out, c) {
                return false;
            }
        }
        i = i + 1;
    }
    return buf_append_byte(out, 34);
}

// 从事件行里取出 `"key":[...]` 的**原始数组文本**（括号配平、跳过字符串内部）。
// 恢复历史时用它把 tool_calls 原样还原（不能重新序列化，否则 arguments 会被二次转义）。
export fn sess_extract_array(line: &[byte], key: &const byte, out: &Buf) bool {
    var pat: Buf = buf_new(64);
    defer { buf_free(&pat); }
    _ = buf_append_byte(&pat, 34);
    _ = buf_append_cstr(&pat, key);
    _ = buf_append_cstr(&pat, "\":[");
    const at: isize = find_sub(line, pat.ptr[0: pat.len], 0);
    if at < 0 {
        return false;
    }
    const start: usize = (at as usize) + pat.len - 1;   // 指向 '['
    var depth: i32 = 0;
    var i: usize = start;
    var in_str: bool = false;
    var esc: bool = false;
    while i < line.len {
        const c: byte = line.ptr[i];
        if in_str {
            if esc {
                esc = false;
            } else if c == 92 as byte {
                esc = true;
            } else if c == 34 as byte {
                in_str = false;
            }
        } else if c == 34 as byte {
            in_str = true;
        } else if c == 91 as byte {
            depth = depth + 1;
        } else if c == 93 as byte {
            depth = depth - 1;
            if depth == 0 {
                buf_reset(out);
                return buf_append(out, &line.ptr[start], (i - start) + 1);
            }
        }
        i = i + 1;
    }
    return false;
}

// 开始一个事件：out 里得到 `{"type":"…","seq":N,"time":N,"data":`
//
// 时间由调用方给（P18）。为什么需要这个变体：统计折叠的边界时刻必须与事件时间**逐位
// 相同** —— `assistant/first-token` 是流结束之后才补写的，用 ua_now_ms() 会把 TTFT
// 记成整段流式时间；而且实时折叠（agent 把同一个毫秒值喂给 stats）与日志回放（读
// `time` 字段）必须对得上，否则 resume 前后数字会不一样。
export fn sess_begin_at(l: &const SessionLog, typ: &const byte, time_ms: u64, out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "{\"type\":\"") {
        return false;
    }
    if !buf_append_cstr(out, typ) {
        return false;
    }
    if !buf_append_cstr(out, "\",\"seq\":") {
        return false;
    }
    if !buf_append_i64(out, l.seq) {
        return false;
    }
    if !buf_append_cstr(out, ",\"time\":") {
        return false;
    }
    if !buf_append_u64(out, time_ms) {
        return false;
    }
    return buf_append_cstr(out, ",\"data\":");
}

// 开始一个事件，时间取**当下**（ua_now_ms()）。统计边界事件一律别用它，见 sess_begin_at。
export fn sess_begin(l: &const SessionLog, typ: &const byte, out: &Buf) bool {
    return sess_begin_at(l, typ, ua_now_ms(), out);
}

// 结束事件并落盘（seq 推进；--no-save 时只推进 seq）
export fn sess_end(l: &SessionLog, out: &Buf) bool {
    if !buf_append_cstr(out, "}\n") {
        return false;
    }
    const ok: bool = sess_write_line(l, out);
    l.seq = l.seq + 1;
    l.events = l.events + 1;
    return ok;
}

// 往索引追加一条（读的时候同 id 取最后一条）
export fn sess_write_index(home: &const byte, l: &const SessionLog) bool {
    if !l.save {
        return true;
    }
    var line: Buf = buf_new(1024);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "{\"id\":\"");
    _ = buf_append(&line, l.id.ptr, l.id.len);
    _ = buf_append_cstr(&line, "\",\"cwd\":");
    if !jw_str_into(&line, l.cwd.ptr as &const byte, l.cwd.len) {
        return false;
    }
    _ = buf_append_cstr(&line, ",\"lastActiveAt\":");
    _ = buf_append_u64(&line, ua_now_ms());
    _ = buf_append_cstr(&line, ",\"title\":");
    if !jw_str_into(&line, l.title.ptr as &const byte, l.title.len) {
        return false;
    }
    _ = buf_append_cstr(&line, ",\"model\":");
    if !jw_str_into(&line, l.model.ptr as &const byte, l.model.len) {
        return false;
    }
    _ = buf_append_cstr(&line, ",\"delegationDepth\":");
    _ = buf_append_i64(&line, l.deleg_depth as i64);
    _ = buf_append_cstr(&line, ",\"turns\":");
    _ = buf_append_i64(&line, l.turns);
    _ = buf_append_cstr(&line, ",\"events\":");
    _ = buf_append_i64(&line, l.events as i64);
    _ = buf_append_cstr(&line, ",\"path\":");
    if !jw_str_into(&line, l.path.ptr as &const byte, l.path.len) {
        return false;
    }
    _ = buf_append_cstr(&line, "}\n");

    var pz: Buf = buf_new(bufx_cstr_len(home) + 32);
    defer { buf_free(&pz); }
    _ = buf_append_cstr(&pz, home);
    _ = buf_append_cstr(&pz, "/index.jsonl");
    _ = buf_append_byte(&pz, 0);
    const flags: i32 = (O_WRONLY | O_CREAT | O_APPEND) as i32;
    const fd: i32 = sys_open(&pz.ptr[0] as *const byte, flags, 420) catch {
        -1;
    };
    if fd < 0 {
        return false;
    }
    const ok: bool = write_all_fd(fd, line.ptr as &const byte, line.len);
    _ = sys_close(fd) catch {};
    return ok;
}

// 关掉 fd 并写一条索引；`--no-save` 时只关 fd、不写索引（save 为 false 的会话不进列表）
export fn sess_close(l: &SessionLog, home: &const byte) void {
    if l.fd >= 0 {
        _ = sys_close(l.fd) catch {};
        l.fd = -1;
    }
    if l.save {
        _ = sess_write_index(home, l);
    }
}

// ============================================================
// 读
// ============================================================
export struct SessReader {
    data: Buf,
    pos: usize,
    seq_expected: i64,
    header_ok: bool,
    bad_seq: bool,
    dropped_tail: bool,
    n_events: usize,
    id: Buf,
    cwd: Buf,
    model: Buf,
}

// 零值 SessReader：data / id / cwd / model 都是空 Buf，可安全 defer sess_reader_free
export fn sess_reader_empty() SessReader {
    return SessReader{
        data: buf_empty(),
        pos: 0,
        seq_expected: 0,
        header_ok: false,
        bad_seq: false,
        dropped_tail: false,
        n_events: 0,
        id: buf_empty(),
        cwd: buf_empty(),
        model: buf_empty(),
    };
}

// 释放 data / id / cwd / model 四个 Buf（不关任何 fd）
export fn sess_reader_free(r: &SessReader) void {
    buf_free(&r.data);
    buf_free(&r.id);
    buf_free(&r.cwd);
    buf_free(&r.model);
}

// 取 `"key":<数字>` 的值（按实际位数，不能要求固定宽度）
export fn sess_json_i64(line: &[byte], key: &const byte) i64 {
    var pat: Buf = buf_new(64);
    defer { buf_free(&pat); }
    _ = buf_append_byte(&pat, 34);
    _ = buf_append_cstr(&pat, key);
    _ = buf_append_cstr(&pat, "\":");
    const at: isize = find_sub(line, pat.ptr[0: pat.len], 0);
    if at < 0 {
        return -1;
    }
    var i: usize = (at as usize) + pat.len;
    var v: i64 = 0;
    var digits: i32 = 0;
    while i < line.len && is_digit(line.ptr[i]) {
        v = v * 10 + ((line.ptr[i] as i64) - 48);
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        return -1;
    }
    return v;
}

// hay 里是否含 C 字符串字面量（find_sub 要的是切片，这里算好长度）
fn sess_has_cstr(hay: &[byte], lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    return find_sub(hay, lit[0: n], 0) >= 0;
}

// 从 JSON 行里取 "key":"value"（我们自己写的格式，够用且不依赖 std.json 的生命周期）
//
// 反斜杠转义走 jsonx.sv_unescape（唯一一份「完整」实现）：只有 \n \t \r \" \\ 这类短转义
// 在手写循环里认得出是不够的 —— 日志写入端为了不往文件里塞裸控制字节，把 0x00…0x1f 写成
// \u00XX，读回时若只「去一个反斜杠留一个字符」，`\u0000` 就变成字面量 `u0000`（P15 实测：
// 一条带 NUL 的工具结果恢复后内容里多出 4 个字符、NUL 本身消失）。DSH 的会话里还有
// 代理对（\uD83D\uDE00），也只有完整实现认得。
fn sess_json_str(line: &[byte], key: &const byte, out: &Buf) bool {
    var pat: Buf = buf_new(64);
    defer { buf_free(&pat); }
    _ = buf_append_byte(&pat, 34);
    _ = buf_append_cstr(&pat, key);
    _ = buf_append_cstr(&pat, "\":\"");
    const at: isize = find_sub(line, pat.ptr[0: pat.len], 0);
    if at < 0 {
        return false;
    }
    const start: usize = (at as usize) + pat.len;
    // 找收尾的引号：反斜杠后面的字符一律跳过（\" 不是收尾）
    var i: usize = start;
    var end: usize = line.len;
    while i < line.len {
        const c: byte = line.ptr[i];
        if c == 92 as byte {
            i = i + 2;
            continue;
        }
        if c == 34 as byte {
            end = i;
            break;
        }
        i = i + 1;
    }
    if end == line.len {
        return false;   // 没有收尾引号（截断的行）
    }
    const sv: JsonStrView = JsonStrView{ ptr: &line[start], len: end - start };
    buf_reset(out);
    if sv_unescape(&sv, out) {
        return true;
    }
    // 认不出的转义（外来/手改过的日志）：退回「原文照抄」，别把整条消息丢掉
    buf_reset(out);
    return buf_append(out, &line[start], end - start);
}

// 读**第一行**作为 header（列目录/校验用，不读全文件）
// 4096 字节的读缓冲足够放下 header；只认带 `"type":"session"` 的首行。
export fn sess_read_header(path: &const byte, r: &SessReader) bool {
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var tmp: [byte: 4096] = [0: 4096];
    const n: isize = sys_read(fd, &tmp[0], 4096) catch { 0 as isize; };
    if n <= 0 {
        return false;
    }
    const got: usize = n as usize;
    const view: &[byte] = &tmp[0: got];
    const nl: isize = bufx_find_byte(view, 10, 0);
    if nl <= 0 {
        return false;
    }
    const line: &[byte] = &tmp[0: nl as usize];
    if !sess_has_cstr(line, "\"type\":\"session\"") {
        return false;
    }
    r.header_ok = true;
    _ = sess_json_str(line, "id", &r.id);
    _ = sess_json_str(line, "cwd", &r.cwd);
    _ = sess_json_str(line, "model", &r.model);
    return r.header_ok;
}

// ============================================================
// P34：会话身份 + 「当前工作区」
//
// 一次读盘拿两样：
//   * header 行给 id 与**创建时**的工作区（cwd 是创建元数据，之后不再改写）；
//   * 之后每一行里**最后一条** `session/workspace` 事件给「当前工作区」——
//     会话在工作区之间搬过（工具切换 / 用户 /workspace / 恢复）时它就是最新那个。
// 恢复路径按它决定运行期工作区，所以必须一次拿到（日志可能好几 MB，不想扫两遍）。
// ============================================================
export struct SessMeta {
    id: Buf,
    cwd: Buf,          // header：创建时的工作区
    workspace: Buf,    // 最后一条 session/workspace（空 = 没有记录）
    // P37：最后一条 session/model（provider / model / reasoningEffort；空 = 没有记录）
    provider: Buf,
    model: Buf,
    effort: Buf,
    header_ok: bool,
}

// 零值 SessMeta：三份 Buf 全空 = 「没有记录」，header_ok = false
export fn sess_meta_empty() SessMeta {
    return SessMeta{
        id: buf_empty(),
        cwd: buf_empty(),
        workspace: buf_empty(),
        provider: buf_empty(),
        model: buf_empty(),
        effort: buf_empty(),
        header_ok: false,
    };
}

// 释放 SessMeta 的全部 Buf（六个）
export fn sess_meta_free(m: &SessMeta) void {
    buf_free(&m.id);
    buf_free(&m.cwd);
    buf_free(&m.workspace);
    buf_free(&m.provider);
    buf_free(&m.model);
    buf_free(&m.effort);
}

// 一次读盘拿齐 header(id/cwd) + 最后一条 session/workspace + 最后一条 session/model。
// 返回 false = header 读不到（文件不存在/不是会话）；返回 true 时 workspace 等字段可能为空
// （那就是「没有记录」，调用方按空处理）。必须在 hist 重建**之前**调，工作区定了才能求值
// system prompt、AGENTS.md 与技能目录。切片长度一律写 `nl - pos`（踩坑 51/54，见文件内注释）。
export fn sess_read_meta(path: &const byte, m: &SessMeta) bool {
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_read_header(path, &r) {
        m.header_ok = false;
        return false;
    }
    m.header_ok = true;
    buf_reset(&m.id);
    _ = buf_append(&m.id, r.id.ptr as &const byte, r.id.len);
    buf_reset(&m.cwd);
    _ = buf_append(&m.cwd, r.cwd.ptr as &const byte, r.cwd.len);
    buf_reset(&m.workspace);
    buf_reset(&m.provider);
    buf_reset(&m.model);
    buf_reset(&m.effort);
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return true;   // header 拿到了：工作区按「没有记录」处理
    };
    defer { _ = sys_close(fd) catch {}; }
    var data: Buf = buf_new(65536);
    defer { buf_free(&data); }
    var tmp: [byte: 16384] = [0: 16384];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 16384) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        if !buf_append(&data, &tmp[0], n as usize) {
            break;
        }
    }
    var pos: usize = 0;
    while pos < data.len {
        var nl: usize = data.len;
        var i: usize = pos;
        while i < data.len {
            if data.ptr[i] == 10 as byte {
                nl = i;
                break;
            }
            i = i + 1;
        }
        // ⚠ 切片第二个数是**长度**，不是终点（§16 踩坑 51/54）：写成 `data.ptr[pos: nl]`
        // 拿到的是「从 pos 起 nl 个字节」≈ 真实行长 + pos，于是每行的 view.len 约等于真实行长的
        // 两倍。这个 view 只喂给 sess_has_cstr 做子串扫描，扫不过就继续往后读 ——
        // 小日志时只是**静默越过本行**做匹配（读到漂移的工作区，不报错），
        // 大日志（data 缓冲经 realloc 走 mmap，cap 1–2 MiB）读到映射尾就 SIGSEGV：
        // 实测 913690 字节的真机会话一 /resume 必崩（见 §16 踩坑 54 的 gdb/valgrind 证据）。
        const view: &[byte] = data.ptr[pos: nl - pos];
        // 同 id 取最后一条：后面的覆盖前面的
        if sess_has_cstr(view, "\"type\":\"session/workspace\"") {
            _ = sess_json_str(view, "workspace", &m.workspace);
        }
        // P37：同一条 line 也是「最后一条为准」（会话中途换过模型就是最后那条）
        if sess_has_cstr(view, "\"type\":\"session/model\"") {
            _ = sess_json_str(view, "provider", &m.provider);
            _ = sess_json_str(view, "model", &m.model);
            _ = sess_json_str(view, "reasoningEffort", &m.effort);
        }
        if nl >= data.len {
            break;
        }
        pos = nl + 1;
    }
    return true;
}

// 整个文件读进内存并跳过 header（后续用 sess_next 逐行取事件）
export fn sess_reader_load(path: &const byte, r: &SessReader) bool {
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    r.data = buf_new(65536);
    if !buf_valid(&r.data) {
        return false;
    }
    var tmp: [byte: 16384] = [0: 16384];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 16384) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        if !buf_append(&r.data, &tmp[0], n as usize) {
            return false;
        }
    }
    if r.data.len == 0 {
        return false;
    }
    const view: &[byte] = r.data.ptr[0: r.data.len];
    const nl: isize = bufx_find_byte(view, 10, 0);
    if nl <= 0 {
        return false;
    }
    const hline: &[byte] = r.data.ptr[0: nl as usize];
    if !sess_has_cstr(hline, "\"type\":\"session\"") {
        return false;
    }
    r.header_ok = true;
    _ = sess_json_str(hline, "id", &r.id);
    _ = sess_json_str(hline, "cwd", &r.cwd);
    _ = sess_json_str(hline, "model", &r.model);
    r.pos = (nl as usize) + 1;
    return true;
}

// 取下一行事件（整行 JSON 文本）。返回 false = 读完了。
// 最后一行不完整（没有换行结尾）时置 dropped_tail 并停止 —— 对应 DSH 的
// 「保留有效尾部工作」：崩在写一半的那条记录丢掉，前面的都算数。
export fn sess_next(r: &SessReader, out: &Buf) bool {
    if r.pos >= r.data.len {
        return false;
    }
    const view: &[byte] = r.data.ptr[0: r.data.len];
    const nl: isize = bufx_find_byte(view, 10, r.pos);
    buf_reset(out);
    if nl < 0 {
        r.dropped_tail = true;
        return false;
    }
    const end: usize = nl as usize;
    if end > r.pos {
        if !buf_append(out, &r.data.ptr[r.pos], end - r.pos) {
            return false;
        }
    }
    r.pos = end + 1;
    r.n_events = r.n_events + 1;
    return true;
}

// 事件行里的 seq（用于连续性校验）
export fn sess_line_seq(line: &const Buf) i64 {
    var key: Buf = buf_new(16);
    defer { buf_free(&key); }
    _ = buf_append_cstr(&key, "\"seq\":");
    const view: &[byte] = line.ptr[0: line.len];
    const at: isize = find_sub(view, key.ptr[0: key.len], 0);
    if at < 0 {
        return -1;
    }
    var i: usize = (at as usize) + key.len;
    var v: i64 = 0;
    var digits: i32 = 0;
    while i < line.len && is_digit(line.ptr[i]) {
        v = v * 10 + ((line.ptr[i] as i64) - 48);
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        return -1;
    }
    return v;
}

// 事件类型
export fn sess_line_type(line: &const Buf, out: &Buf) bool {
    return sess_json_str(line.ptr[0: line.len], "type", out);
}

// ============================================================
// 定位 / 列表
// ============================================================
// 按 id 找会话文件：先看当前 cwd 的目录，再扫所有 --*-- 目录
export fn sess_find(home: &const byte, cwd: &const byte, id: &const byte, id_len: usize, out: &Buf) bool {
    var p: Buf = buf_new(1200);
    if !sess_session_path(home, cwd, id, id_len, &p) {
        buf_free(&p);
        return false;
    }
    _ = buf_append_byte(&p, 0);
    if sess_file_exists(p.ptr as &const byte) {
        buf_reset(out);
        _ = buf_append(out, p.ptr, p.len - 1);
        buf_free(&p);
        return true;
    }
    buf_free(&p);
    // 扫 <home>/sessions/*/<id>/session.jsonl
    var root: Buf = buf_new(bufx_cstr_len(home) + 32);
    defer { buf_free(&root); }
    _ = buf_append_cstr(&root, home);
    _ = buf_append_cstr(&root, "/sessions");
    _ = buf_append_byte(&root, 0);
    const dirp: &DIR = opendir(&root.ptr[0] as *const byte);
    if dirp == null {
        return false;
    }
    defer { _ = closedir(dirp); }
    while true {
        const de: &Dirent = readdir(dirp);
        if de == null {
            break;
        }
        var name: Buf = buf_new(272);
        defer { buf_free(&name); }
        if !buf_append_cstr(&name, &de.d_name[0] as &const byte) {
            continue;
        }
        if name.len < 2 || name.ptr[0] != 45 as byte || name.ptr[1] != 45 as byte {
            continue;
        }
        var cand: Buf = buf_new(1200);
        _ = buf_append_cstr(&cand, home);
        _ = buf_append_cstr(&cand, "/sessions/");
        _ = buf_append(&cand, name.ptr, name.len);
        _ = buf_append_cstr(&cand, "/");
        _ = buf_append(&cand, id, id_len);
        _ = buf_append_cstr(&cand, "/session.jsonl");
        _ = buf_append_byte(&cand, 0);
        const ok: bool = sess_file_exists(cand.ptr as &const byte);
        if ok {
            buf_reset(out);
            _ = buf_append(out, cand.ptr, cand.len - 1);
            buf_free(&cand);
            return true;
        }
        buf_free(&cand);
    }
    return false;
}

// 文件能不能打开（只 open + close 探一下，不读内容）；目录也会返回 true
export fn sess_file_exists(path: &const byte) bool {
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    _ = sys_close(fd) catch {};
    return true;
}

// 最近的会话（按索引里的 lastActiveAt）：cwd 为空表示不限
export fn sess_find_last(home: &const byte, cwd: &const byte, out: &Buf) bool {
    var idx: Buf = buf_new(65536);
    defer { buf_free(&idx); }
    if !sess_read_index(home, &idx) {
        return false;
    }
    var best_id: Buf = buf_new(64);
    defer { buf_free(&best_id); }
    var best_path: Buf = buf_new(1200);
    defer { buf_free(&best_path); }
    var best_at: i64 = -1;
    var pos: usize = 0;
    var line: Buf = buf_new(2048);
    defer { buf_free(&line); }
    while pos < idx.len {
        // 取一行
        buf_reset(&line);
        var nl: usize = idx.len;
        var i: usize = pos;
        while i < idx.len {
            if idx.ptr[i] == 10 as byte {
                nl = i;
                break;
            }
            i = i + 1;
        }
        if nl > pos {
            _ = buf_append(&line, &idx.ptr[pos], nl - pos);
        }
        pos = nl + 1;
        if line.len == 0 {
            continue;
        }
        var id: Buf = buf_new(64);
        var cwdv: Buf = buf_new(1024);
        var pth: Buf = buf_new(1200);
        defer { buf_free(&id); buf_free(&cwdv); buf_free(&pth); }
        if !sess_json_str(line.ptr[0: line.len], "id", &id) {
            continue;
        }
        _ = sess_json_str(line.ptr[0: line.len], "cwd", &cwdv);
        if bufx_cstr_len(cwd) > 0 && !bufx_eq_cstr(cwdv.ptr as &const byte, cwdv.len, cwd) {
            continue;
        }
        _ = sess_json_str(line.ptr[0: line.len], "path", &pth);
        // 子代理的会话（delegationDepth>0）不参与「最近会话」的选择：
        // 它们和父会话共用 cwd，否则 --continue 会接到子代理身上（踩过）
        if sess_json_i64(line.ptr[0: line.len], "delegationDepth") > 0 {
            continue;
        }
        const when: i64 = sess_json_i64(line.ptr[0: line.len], "lastActiveAt");
        if when > best_at {
            best_at = when;
            buf_reset(&best_id);
            _ = buf_append(&best_id, id.ptr, id.len);
            buf_reset(&best_path);
            _ = buf_append(&best_path, pth.ptr, pth.len);
        }
    }
    _ = best_id;
    if best_path.len == 0 {
        return false;
    }
    buf_reset(out);
    return buf_append(out, best_path.ptr, best_path.len);
}

// ============================================================
// P33：会话列表的数据源 —— 索引去重 + 按 lastActiveAt 倒序
// ============================================================
// `/sessions`（浮层）、`--list-sessions`、滚动模式的 `/sessions` 共用这一份：
//   * 索引是**追加写**的：同一个会话每关一次就多一条记录，所以列表侧必须先按索引
//     自己的契约「同 id 取最后一条」去重，否则同一个会话会在列表里出现好几份
//     （真机 index.jsonl 实测：308 行 / 298 个会话，其中一个 id 出现 4 次）。
//   * 顺序按 `lastActiveAt` **倒序**（最新在最上）；缺这个字段的记录排最后。
// 输出：每行一条**索引记录原文**（JSON，行尾 '\n'），不做列排版 ——
// 索引与日志归 session.uya，呈现（三列 / 宽度自适应）归 agent.uya。
//
// id 的比较用**原始切片**（不反转义）：我们自己写的 id 一定是 `session-` + hex + 短横线，
// 不含转义。真遇到带转义的 id，最坏是去重漏一次（退化成「同一个会话列两次」的旧行为），
// 不会写错数据；排版与 /resume 用的仍是 sess_json_str 反转义出来的那个 id。
struct SessIdxRow {
    at: i64,            // lastActiveAt（缺字段 = -1 → 排最后）
    line_off: usize,    // 该条索引记录在 idx 里的起始偏移
    line_len: usize,
    id_off: usize,      // id 的原始字节区间（指向 idx 内部，只用于去重比较）
    id_len: usize,
}

// 第 i 个 SessIdxRow 的只读指针（表是一整块 malloc 出来的连续内存，手算偏移）
fn sess_idx_at(base: &const SessIdxRow, i: usize) &const SessIdxRow {
    const esz: usize = @size_of(SessIdxRow) as usize;
    return @ptr_from_usize(@usize_from_ptr(base as &const void) + i * esz) as &const SessIdxRow;
}

// 同上但给可写指针（归并排序写目标区用；表是手算偏移的裸内存，没有借用检查兜底）
fn sess_idx_at_mut(base: &SessIdxRow, i: usize) &SessIdxRow {
    const esz: usize = @size_of(SessIdxRow) as usize;
    return @ptr_from_usize(@usize_from_ptr(base as &void) + i * esz) as &SessIdxRow;
}

// 记录整体拷贝：**逐字段**写。
// 不能写成 `const cur: SessIdxRow = sess_idx_at(rows, i)[0];` —— 从指针解引用里
// 「移动」出一个结构体值会被类型检查拦下（"循环中的变量不能移动"，实测）。
fn sess_idx_copy(dst: &SessIdxRow, src: &const SessIdxRow) void {
    dst.at = src.at;
    dst.line_off = src.line_off;
    dst.line_len = src.line_len;
    dst.id_off = src.id_off;
    dst.id_len = src.id_len;
}

// 行里 `"id":"…"` 的原始字节区间（相对行首，不含两端引号）。不在行里返回 false。
// 与 sess_json_str 同一套扫法：反斜杠后面的字符一律跳过（\" 不是收尾引号）。
fn sess_idx_find_id(line: &[byte], off: &usize, len: &usize) bool {
    const at: isize = find_sub(line, &"\"id\":\""[0: 6], 0);
    if at < 0 {
        return false;
    }
    const start: usize = (at as usize) + 6;
    var i: usize = start;
    while i < line.len {
        const c: byte = line.ptr[i];
        if c == 92 as byte {
            i = i + 2;
            continue;
        }
        if c == 34 as byte {
            off[0] = start;
            len[0] = i - start;
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 两个 id 原始切片比较：<0 / 0 / >0（按字节，id 全是小写 hex 与短横线）
fn sess_idx_id_cmp(idx: &const Buf, a: &const SessIdxRow, b: &const SessIdxRow) i32 {
    var n: usize = a.id_len;
    if b.id_len < n {
        n = b.id_len;
    }
    var i: usize = 0;
    while i < n {
        const ca: byte = idx.ptr[a.id_off + i];
        const cb: byte = idx.ptr[b.id_off + i];
        if ca < cb {
            return -1;
        }
        if ca > cb {
            return 1;
        }
        i = i + 1;
    }
    if a.id_len < b.id_len {
        return -1;
    }
    if a.id_len > b.id_len {
        return 1;
    }
    return 0;
}

// 排序键（见 sess_idx_sort）
const SESS_IDX_BY_ID: u8 = 0;    // (id 升序, 行号升序)
const SESS_IDX_BY_AT: u8 = 1;    // (lastActiveAt 降序, 行号降序)

// a 是否应当排在 b 前面。两把键都是**严格全序**：次级键 line_off 在同一个索引文件里
// 唯一（每条记录占不同的一行），所以不存在并列 ⇒ 排序结果唯一（这一点是
// 「归并排序的输出与老插入排序逐字节相同」的依据，见 sess_idx_sort）。
fn sess_idx_before(mode: u8, idx: &const Buf, a: &const SessIdxRow, b: &const SessIdxRow) bool {
    if mode == SESS_IDX_BY_ID {
        const c: i32 = sess_idx_id_cmp(idx, a, b);
        if c < 0 {
            return true;
        }
        if c > 0 {
            return false;
        }
        return a.line_off < b.line_off;      // 同 id：文件里后写的那条在后
    }
    if a.at > b.at {
        return true;
    }
    if a.at < b.at {
        return false;
    }
    // 时间戳相同或都缺失（-1）：后写的排前面，于是「缺时间戳」的那批一起落到列表末尾
    return a.line_off > b.line_off;
}

// 自底向上归并排序：O(n log n)。
//
// 老实现是插入排序（O(n²)）：真机索引 1.4 K 行时 `--list-sessions` 已经要 70 ms，
// 纯数据侧在 12.8 K 行 / 时间戳升序时要 ~1.4 s（实测，见 §16 踩坑 68）。会话索引
// 是**追加写**的，时间戳天然升序 ⇒ 插入排序每次都把新记录一路挪到最前，正好是最坏情况。
//
// 与插入排序**逐字节等价**：比较键是严格全序（见 sess_idx_before），排序结果唯一。
//
// rows 的布局：前 n 格是数据，接着 n 格是归并目标区（调用方按 2n+2 分配），
// 每趟在两侧之间来回搬；整个排序不产生结构体值（一律走 sess_idx_copy 逐字段拷）。
fn sess_idx_sort(idx: &const Buf, rows: &SessIdxRow, n: usize, mode: u8) void {
    if n < 2 {
        return;
    }
    var src_base: usize = 0;
    var dst_base: usize = n;
    var width: usize = 1;
    while width < n {
        var lo: usize = 0;
        while lo < n {
            var mid: usize = lo + width;
            if mid > n {
                mid = n;
            }
            var hi: usize = lo + width * 2;
            if hi > n {
                hi = n;
            }
            // 归并 [lo, mid) 与 [mid, hi)
            var i: usize = lo;
            var j: usize = mid;
            var k: usize = lo;
            while i < mid && j < hi {
                const a: &const SessIdxRow = sess_idx_at(rows, src_base + i);
                const b: &const SessIdxRow = sess_idx_at(rows, src_base + j);
                if sess_idx_before(mode, idx, a, b) {
                    sess_idx_copy(sess_idx_at_mut(rows, dst_base + k), a);
                    i = i + 1;
                } else {
                    sess_idx_copy(sess_idx_at_mut(rows, dst_base + k), b);
                    j = j + 1;
                }
                k = k + 1;
            }
            while i < mid {
                sess_idx_copy(sess_idx_at_mut(rows, dst_base + k), sess_idx_at(rows, src_base + i));
                i = i + 1;
                k = k + 1;
            }
            while j < hi {
                sess_idx_copy(sess_idx_at_mut(rows, dst_base + k), sess_idx_at(rows, src_base + j));
                j = j + 1;
                k = k + 1;
            }
            lo = hi;
        }
        const t: usize = src_base;
        src_base = dst_base;
        dst_base = t;
        width = width * 2;
    }
    // 收在目标区（src_base != 0）就搬回 0 起：调用方只认「结果从第 0 格开始」
    if src_base != 0 {
        var m: usize = 0;
        while m < n {
            sess_idx_copy(sess_idx_at_mut(rows, m), sess_idx_at(rows, src_base + m));
            m = m + 1;
        }
    }
}

// 索引里的会话列表（去重 + 倒序）。没有索引 / 没有可解析的记录 → false，out 清空。
export fn sess_index_rows_sorted(home: &const byte, out: &Buf) bool {
    buf_reset(out);
    var idx: Buf = buf_new(65536);
    defer { buf_free(&idx); }
    if !sess_read_index(home, &idx) {
        return false;
    }
    // 1) 先数一遍非空行 → 一次分配紧凑记录表（不做逐条 realloc）
    var n: usize = 0;
    var pos: usize = 0;
    while pos < idx.len {
        var e: usize = pos;
        while e < idx.len && idx.ptr[e] != 10 as byte {
            e = e + 1;
        }
        if e > pos {
            n = n + 1;
        }
        pos = e + 1;
    }
    if n == 0 {
        return false;
    }
    const esz: usize = @size_of(SessIdxRow) as usize;
    // 2n+2 格：前 n 格数据，接着 n 格归并目标区，末尾 1 格余量（见 sess_idx_sort）
    const raw: &void = malloc(((n * 2) + 2) * esz);
    if ((raw as &byte) as usize) == 0 {
        return false;
    }
    defer { free(raw); }
    const rows: &SessIdxRow = raw as &SessIdxRow;
    // 2) 填表：没有 id 的行直接丢掉（索引是外部文件，可能被手改过）
    //
    // ⚠ 每一行先**拷进 line** 再解析，不要写 `idx.ptr[lo: ll]`：uya 0.10 的 `p[a: b]`
    // 是「从 a 起 **b 个字节**」（偏移 + 长度），不是「到 b 为止」—— 传 `[lo: lo+ll]`
    // 会拿到 `lo+ll` 字节的窗口，越读到后面几行去（实测：D 那条没有 lastActiveAt 的
    // 记录被解析成了下一行的 9000，倒序于是全错，还顺带 OOB 读）。全仓的 `[0: n]`
    // 恰好两种语义一样，所以这个坑一直没露头（见 §16 踩坑 51）。
    var line: Buf = buf_new(4096);
    defer { buf_free(&line); }
    var m: usize = 0;
    pos = 0;
    while pos < idx.len {
        var e: usize = pos;
        while e < idx.len && idx.ptr[e] != 10 as byte {
            e = e + 1;
        }
        const lo: usize = pos;
        const ll: usize = e - pos;
        pos = e + 1;
        if ll == 0 {
            continue;
        }
        buf_reset(&line);
        if !buf_append(&line, idx.ptr + lo, ll) {
            return false;
        }
        const view: &[byte] = line.ptr[0: line.len];
        var ido: usize = 0;
        var idl: usize = 0;
        if !sess_idx_find_id(view, &ido, &idl) {
            continue;
        }
        const r: &SessIdxRow = sess_idx_at_mut(rows, m);
        r.at = sess_json_i64(view, "lastActiveAt");
        r.line_off = lo;
        r.line_len = ll;
        r.id_off = lo + ido;
        r.id_len = idl;
        m = m + 1;
    }
    if m == 0 {
        return false;
    }
    // 3) 同 id 归到相邻 → 4) 每个 id 只留组内最后一条（「同 id 取最后一条」）
    sess_idx_sort(&idx, rows, m, SESS_IDX_BY_ID);
    var keep: usize = 0;
    var i: usize = 0;
    while i < m {
        var j: usize = i + 1;
        while j < m {
            if sess_idx_id_cmp(&idx, sess_idx_at(rows, i), sess_idx_at(rows, j)) != 0 {
                break;
            }
            j = j + 1;
        }
        const src: &const SessIdxRow = sess_idx_at(rows, j - 1);
        if keep != j - 1 {
            sess_idx_copy(sess_idx_at_mut(rows, keep), src);
        }
        keep = keep + 1;
        i = j;
    }
    // 5) 最新在最上
    sess_idx_sort(&idx, rows, keep, SESS_IDX_BY_AT);
    // 6) 原样输出索引记录（排版交给调用方）
    var k: usize = 0;
    while k < keep {
        const r: &const SessIdxRow = sess_idx_at(rows, k);
        if !buf_append(out, idx.ptr + r.line_off, r.line_len) {
            return false;
        }
        if !buf_append_byte(out, 10) {
            return false;
        }
        k = k + 1;
    }
    return out.len > 0;
}

// 读索引文件（不存在返回 false）
export fn sess_read_index(home: &const byte, out: &Buf) bool {
    var p: Buf = buf_new(bufx_cstr_len(home) + 32);
    defer { buf_free(&p); }
    _ = buf_append_cstr(&p, home);
    _ = buf_append_cstr(&p, "/index.jsonl");
    _ = buf_append_byte(&p, 0);
    const fd: i32 = sys_open(&p.ptr[0] as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    buf_reset(out);
    var tmp: [byte: 8192] = [0: 8192];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 8192) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        if !buf_append(out, &tmp[0], n as usize) {
            return false;
        }
    }
    return out.len > 0;
}
