// src/modelx.uya — P37：模型目录（对齐 DSH 的 /model popupSelect + composer 的 Model/Effort 两级菜单）
//
// 事实源就是 DSH 的 settings.yaml：`llm-pi-ai.providers.<prov>.models[]`（外加官方路线的
// `llm-deepseek.models[]`）。这一层只做一件事：把「有哪些提供方 / 模型 / 该模型公布了哪些推理档位」
// 摊平成一个只读清单，供 `/model`、`/effort` 与 `--print-config` 用。
//
// 对齐 DSH 的三条硬规则（都是从 dsh-llm-pi-ai 的实测语义抄来的）：
//   1) **不发明档位**：只认模型自己 `reasoningEfforts:` 里公布的键。DSH 的 THINKING_LEVELS 是
//      固定七个（off/minimal/low/medium/high/xhigh/max），这里按同一套顺序收集。
//   2) **`reasoningEfforts: false` = 非推理模型**：一个档位都不公布 ⇒ 界面**不显示** Effort
//      那一行（显示一个做不到事的控件比不显示更坏）。
//   3) **目录只读**：解析失败 / 没有 DSH 设置都只是「目录为空」，绝不报错退出（离线要能跑）。
//
// 复用 yamlcfg.uya 的 YTree 导航，不新写解析器。

use libc.syscall;
use libc.unistd;

export const MX_MAX: usize = 256;       // 目录条目上限（真机 settings.yaml 远小于此）

// DSH 的七个推理档位（顺序即「从弱到强」，也是浮层里的展示序）
export const MX_LEVELS: usize = 7;

export fn mx_level_name(i: usize) &const byte {
    if i == 0 {
        return "off" as &const byte;
    }
    if i == 1 {
        return "minimal" as &const byte;
    }
    if i == 2 {
        return "low" as &const byte;
    }
    if i == 3 {
        return "medium" as &const byte;
    }
    if i == 4 {
        return "high" as &const byte;
    }
    if i == 5 {
        return "xhigh" as &const byte;
    }
    return "max" as &const byte;
}

// 档位名 → 序号；-1 = 不认识（`none` 是 off 的同义词，DSH 与我们的 --reasoning-effort 都收）
export fn mx_level_index(p: &const byte, n: usize) i32 {
    if n == 0 {
        return -1;
    }
    var i: usize = 0;
    while i < MX_LEVELS {
        if bufx_eq_cstr(p, n, mx_level_name(i)) {
            return i as i32;
        }
        i = i + 1;
    }
    if bufx_eq_cstr(p, n, "none" as &const byte) {
        return 0;   // none == off
    }
    return -1;
}

// 一个模型条目。`reasoning` = 公布过档位；`levels[i]` = 档位 i 可用。
// `declared` = settings.yaml 里显式写了 `reasoningEfforts:`（哪怕只写 off 一档，也是「声明过」，
// 与「没写这个键」分开 —— 没写时我们不做任何推断）。
export struct McEntry {
    provider: Buf,
    model: Buf,
    name: Buf,            // 展示名（DSH 的 name，缺省用 id）
    context_window: i64,
    max_tokens: i64,
    input_image: bool,
    reasoning: bool,      // 公布了档位（含只公布 off）
    levels: [bool: MX_LEVELS],
    declared: bool,       // 显式写了 reasoningEfforts
    compat_dev_role: i8,
    compat_store: i8,
    compat_reasoning: i8,
}

fn mx_entry_empty() McEntry {
    return McEntry{
        provider: buf_empty(),
        model: buf_empty(),
        name: buf_empty(),
        context_window: -1,
        max_tokens: -1,
        input_image: false,
        reasoning: false,
        levels: [false: MX_LEVELS],
        declared: false,
        compat_dev_role: -1,
        compat_store: -1,
        compat_reasoning: -1,
    };
}

fn mx_free_entry(e: &McEntry) void {
    buf_free(&e.provider);
    buf_free(&e.model);
    buf_free(&e.name);
}

export struct McTable {
    items: [McEntry: MX_MAX],
    n: usize,
    loaded: bool,         // 真读到过 settings.yaml（目录为空时用来区分「没设置」与「设置里没有模型」）
}

export fn mx_init(t: &McTable) void {
    var i: usize = 0;
    while i < MX_MAX {
        t.items[i] = mx_entry_empty();
        i = i + 1;
    }
    t.n = 0;
    t.loaded = false;
}

export fn mx_free(t: &McTable) void {
    var i: usize = 0;
    while i < t.n {
        mx_free_entry(&t.items[i]);
        i = i + 1;
    }
    t.n = 0;
}

// 固定数组的下标必须带**字面量上界**检查，编译器的安全证明才过（README 坑 6）
fn mx_at_ref(t: &const McTable, i: usize) &const McEntry {
    if i >= MX_MAX {
        return &t.items[0];
    }
    return &t.items[i];
}

fn mx_at_mut(t: &McTable, i: usize) &McEntry {
    if i >= MX_MAX {
        return &t.items[0];
    }
    return &t.items[i];
}

export fn mx_count(t: &const McTable) usize {
    return t.n;
}

export fn mx_loaded(t: &const McTable) bool {
    return t.loaded;
}

export fn mx_entry_at(t: &const McTable, i: usize) &const McEntry {
    return mx_at_ref(t, i);
}

// 某个档位在这个模型上可用吗？
export fn mx_has_level(e: &const McEntry, lvl: usize) bool {
    if lvl >= MX_LEVELS {
        return false;
    }
    return e.levels[lvl];
}

// 该模型的档位清单（逗号 + 空格，与 DSH 的呈现口径一致）；没有公布档位时是空串。
// 正好回应「不发明档位」：非推理模型这里就是空的，界面据此整行不画。
// ⚠ 这里**不 reset out**：本函数大量用在「先写一段前缀再补清单」的地方
// （`error: xxx 不是…；可选：<清单>`、`efforts    <清单>`），reset 会把前缀一起抹掉。
export fn mx_levels_into(e: &const McEntry, out: &Buf) void {
    if !e.reasoning {
        return;
    }
    var first: bool = true;
    var i: usize = 0;
    while i < MX_LEVELS {
        if mx_has_level(e, i) {
            if !first {
                _ = buf_append_cstr(out, ", ");
            }
            _ = buf_append_cstr(out, mx_level_name(i));
            first = false;
        }
        i = i + 1;
    }
}

// 该模型的**默认**档位：公布过就用第一个公布的（DSH 的 defaultEffort 缺省时也是这个口径）；
// 没公布就 -1（调用方据此决定「不发 reasoning」还是「保留现有值」）。
export fn mx_default_level(e: &const McEntry) i32 {
    if !e.reasoning {
        return -1;
    }
    var i: usize = 0;
    while i < MX_LEVELS {
        if mx_has_level(e, i) {
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

// 查 (provider, model)；未命中返回 -1。provider 为空时只按 model 找（DSH 里 model id 一般唯一）。
export fn mx_find(t: &const McTable, provider: &const byte, pn: usize, model: &const byte, mn: usize) i32 {
    if mn == 0 {
        return -1;
    }
    var i: usize = 0;
    while i < t.n {
        const e: &const McEntry = mx_at_ref(t, i);
        if e.model.len == mn && bufx_mem_eq(e.model.ptr as &const byte, model, mn) {
            if pn == 0 || (e.provider.len == pn && bufx_mem_eq(e.provider.ptr as &const byte, provider, pn)) {
                return i as i32;
            }
        }
        i = i + 1;
    }
    return -1;
}

// 某个 provider 的第一个模型（`/model` 浮层换 provider 时用）
export fn mx_first_of_provider(t: &const McTable, provider: &const byte, pn: usize) i32 {
    if pn == 0 {
        return -1;
    }
    var i: usize = 0;
    while i < t.n {
        const e: &const McEntry = mx_at_ref(t, i);
        if e.provider.len == pn && bufx_mem_eq(e.provider.ptr as &const byte, provider, pn) {
            return i as i32;
        }
        i = i + 1;
    }
    return -1;
}

// 目录里第一个模型的 provider（--print-config 之类要「现在是在哪条路线上」时用）
export fn mx_first_provider(t: &const McTable, out: &Buf) void {
    buf_reset(out);
    if t.n == 0 {
        return;
    }
    const e: &const McEntry = mx_at_ref(t, 0);
    _ = buf_append(out, e.provider.ptr as &const byte, e.provider.len);
}

// ============================================================
// 解析
// ============================================================

// settings.yaml 里 provider / 模型条目的 compat 开关（键在嵌套的 `compat:` 映射里，
// 与 dshcfg.uya 的 dsh_compat_bool 同一口径）。provider 级是默认，模型级覆盖。
fn mx_compat_bool(t: &const YTree, node: i32, key: &const byte) i8 {
    if node < 0 {
        return -1;
    }
    const c: i32 = yt_get(t, node, "compat");
    if c < 0 {
        return -1;
    }
    const v: &[byte] = yt_get_str(t, c, key);
    if v.len == 4 && bufx_mem_eq(v.ptr as &const byte, "true" as &const byte, 4) {
        return 1;
    }
    if v.len == 5 && bufx_mem_eq(v.ptr as &const byte, "false" as &const byte, 5) {
        return 0;
    }
    return -1;
}

// 一个模型条目的 `reasoningEfforts`：映射的**键**就是公布的档位。
//   * 键不存在      → declared=false, reasoning=false（不推断）
//   * `false` 标量  → declared=true,  reasoning=false（非推理模型，界面不显示 Effort）
//   * 映射          → declared=true, reasoning=true, levels=键位图
fn mx_read_efforts(t: &const YTree, e: i32, out: &McEntry) void {
    const node: i32 = yt_get(t, e, "reasoningEfforts");
    if node < 0 {
        return;   // 没写这个键：什么都不推断
    }
    out.declared = true;
    const k: u8 = yt_kind(t, node);
    if k != YK_MAP {
        // 标量：DSH 只认 `false`（zk 的 union 另一支就是它）；别的值一律当「有声明、无档位」，
        // 不认识就不公布档位 —— 绝不猜成「全档位可用」。
        out.reasoning = false;
        return;
    }
    var c: i32 = yt_child(t, node);
    var any: bool = false;
    while c >= 0 {
        const key: &[byte] = yt_key(t, c);
        const li: i32 = mx_level_index(key.ptr as &const byte, key.len);
        if li >= 0 {
            const liu: usize = li as usize;
            if liu < MX_LEVELS {
                out.levels[liu] = true;
            }
            any = true;
        }
        c = yt_next(t, c);
    }
    out.reasoning = any;
}// 把 provider 节点下 models[] 的每一条摊进表里。
// 注意 uya 的约束：**整条结构体不能在循环里赋值**（「循环中的变量不能移动」），所以这里是
// 「拿到槽位指针 + 逐字段写」的写法（与 agent.uya 的 hist_push_msg_kind 同一手法）。
fn mx_collect_provider(t: &const YTree, prov: i32, pname: &const byte, pn: usize, out: &McTable) void {
    const models: i32 = yt_get(t, prov, "models");
    if models < 0 {
        return;
    }
    // provider 级 compat 是默认值
    const pdev: i8 = mx_compat_bool(t, prov, "supportsDeveloperRole");
    const pstore: i8 = mx_compat_bool(t, prov, "supportsStore");
    const preason: i8 = mx_compat_bool(t, prov, "supportsReasoningEffort");
    const n: usize = yt_len(t, models);
    var i: usize = 0;
    while i < n && out.n < MX_MAX {
        const ent: i32 = yt_at(t, models, i);
        if ent >= 0 && yt_kind(t, ent) == YK_MAP {
            const id: &[byte] = yt_get_str(t, ent, "id");
            if id.len > 0 {
                const slot: &McEntry = mx_at_mut(out, out.n);
                slot.context_window = yt_get_i64(t, ent, "contextWindow", -1);
                slot.max_tokens = yt_get_i64(t, ent, "maxTokens", -1);
                slot.input_image = false;
                slot.reasoning = false;
                slot.declared = false;
                slot.compat_dev_role = pdev;
                slot.compat_store = pstore;
                slot.compat_reasoning = preason;
                var li: usize = 0;
                while li < MX_LEVELS {
                    slot.levels[li] = false;
                    li = li + 1;
                }
                slot.provider = buf_new(pn + 8);
                _ = buf_append(&slot.provider, pname, pn);
                slot.model = buf_new(id.len + 8);
                _ = buf_append(&slot.model, id.ptr as &const byte, id.len);
                const nm: &[byte] = yt_get_str(t, ent, "name");
                slot.name = buf_new(id.len + 8);
                if nm.len > 0 {
                    _ = buf_append(&slot.name, nm.ptr as &const byte, nm.len);
                } else {
                    _ = buf_append(&slot.name, id.ptr as &const byte, id.len);
                }
                const inp: i32 = yt_get(t, ent, "input");
                if inp >= 0 {
                    const nn: usize = yt_len(t, inp);
                    var m: usize = 0;
                    while m < nn {
                        const iv: i32 = yt_at(t, inp, m);
                        const sv: &[byte] = yt_str(t, iv);
                        if sv.len == 5 && bufx_mem_eq(sv.ptr as &const byte, "image" as &const byte, 5) {
                            slot.input_image = true;
                        }
                        m = m + 1;
                    }
                }
                mx_read_efforts(t, ent, slot);
                // 模型级 compat 覆盖 provider 级（DSH：模型级赢）
                const md: i8 = mx_compat_bool(t, ent, "supportsDeveloperRole");
                if md >= 0 {
                    slot.compat_dev_role = md;
                }
                const ms: i8 = mx_compat_bool(t, ent, "supportsStore");
                if ms >= 0 {
                    slot.compat_store = ms;
                }
                const mr: i8 = mx_compat_bool(t, ent, "supportsReasoningEffort");
                if mr >= 0 {
                    slot.compat_reasoning = mr;
                }
                out.n = out.n + 1;
            }
        }
        i = i + 1;
    }
}

// 载入目录。返回 false = 文件读不到（目录保持为空）。
// provider 的枚举顺序就是 settings.yaml 里的书写顺序（DSH 也是这个序）。
export fn mx_load(home: &const byte, out: &McTable) bool {
    var spath: Buf = buf_new(bufx_cstr_len(home) + 32);
    defer { buf_free(&spath); }
    _ = buf_append_cstr(&spath, home);
    _ = buf_append_cstr_z(&spath, "/settings.yaml");
    var tree: YTree = YTree{ nodes: [], n: 0, lines: [], nlines: 0, raw: buf_empty(), cur: 0, err_line: 0 };
    yt_init(&tree);
    defer { yt_free(&tree); }
    if !yt_load_file(&spath.ptr[0] as &const byte, &tree) {
        return false;
    }
    const root: i32 = yt_root(&tree);
    if root < 0 {
        return false;
    }
    out.loaded = true;
    // llm-pi-ai.providers.<prov>.models[]（真机的主路线）
    const pi: i32 = yt_get(&tree, root, "llm-pi-ai");
    if pi >= 0 {
        const provs: i32 = yt_get(&tree, pi, "providers");
        if provs >= 0 && yt_kind(&tree, provs) == YK_MAP {
            var c: i32 = yt_child(&tree, provs);
            while c >= 0 {
                const key: &[byte] = yt_key(&tree, c);
                if key.len > 0 && yt_kind(&tree, c) == YK_MAP {
                    mx_collect_provider(&tree, c, key.ptr as &const byte, key.len, out);
                }
                c = yt_next(&tree, c);
            }
        }
    }
    // llm-deepseek.models[]（官方路线的回退形态：没有 providers 包一层）
    const dd: i32 = yt_get(&tree, root, "llm-deepseek");
    if dd >= 0 {
        const ddname: &const byte = "llm-deepseek" as &const byte;
        mx_collect_provider(&tree, dd, ddname, bufx_cstr_len(ddname), out);
    }
    return true;
}

// 「没设置」也要能给出一个可用的单条目录（--no-dsh-config / 读不到设置）：把当前 model 当唯一条目
// 塞进去 —— 界面于是仍能显示「现在用的是它」，只是没有别的可选（不合成别的模型）。
export fn mx_seed_sole(t: &McTable, provider: &const byte, pn: usize, model: &const byte, mn: usize) void {
    if t.n > 0 || mn == 0 {
        return;
    }
    const slot: &McEntry = mx_at_mut(t, 0);
    slot.provider = buf_new(pn + 8);
    _ = buf_append(&slot.provider, provider, pn);
    slot.model = buf_new(mn + 8);
    _ = buf_append(&slot.model, model, mn);
    slot.name = buf_new(mn + 8);
    _ = buf_append(&slot.name, model, mn);
    t.n = 1;
}
