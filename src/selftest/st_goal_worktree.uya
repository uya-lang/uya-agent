// src/selftest/st_goal_worktree.uya — 离线自测轮（selftest.uya 的拆分片 11/11）
//
// 本文件：P37：Git worktree（建 → 闸门 → finish 合并并删除）；P49：残留 worktree 的回收（真 git）
// 不变量：① mock 与断言必须**确定性**（同一夹具同一 verdict，不依赖真实网络/时钟/环境）；
//   ② 判定码只用**低 8 位**（子进程 `sys_exit` 会截断，261 显示成 5，见踩坑 89）；
//   ③ 每轮可单跑（`UYA_SELFTEST_*_ONLY`）且幂等，轮次之间不许残留全局状态；
//   ④ 轮次自己 fork 的子进程必须由该轮收干净，不许留孤儿。
// 依赖：libc（syscall/unistd/heap/fcntl/signal）、foundation/bufx、net（LLM 协议与 SSE）、
//   term 与 term/tui、tools、session、agent、vcs/gitx、diff；`mock_*` 全局与 `cfg_pin_api`
//   在锚点文件 selftest.uya 里（锚点只留文件头、mock 全局与入口 `selftest_main`）。
// 命名：对外 `probe_main`（--probe）/`selftest_main`（--selftest）在锚点；
//   本片私有前缀 `mock_*`、`sse_*`、`ty_*`、`resp_*`、`stx_*`、`tsx_*`、`dp_/dg_/gcr_/mx_/wt_`。

// ============================================================
// P37：Git worktree（建 → 闸门 → finish 合并并删除）
// ============================================================
// 每个测试进程一个**独占**的 fixture 仓。为什么按 pid 分：整轮 selftest 会 fork 一堆
// 模式的子进程，它们跑的是**同一份** selftest、会按**不同顺序**到达这一轮；共享一个目录时
// 「A 建的 worktree 还挂在里面、B 来 git init」会互相踩（实测：往 worktree 写文件失败，
// 因为父进程 / resume 那几轮已经把 build/selftest_p37_wt 建成过仓库并留了 worktree 注册）。
// 绝对路径（/tmp 下）：整轮 selftest 里前面好几轮会**真的 chdir**（工作区那几轮），
// 用相对路径的话这一轮到的时候 cwd 已经不是仓库根了 —— fixture 会被造到别处、
// worktree 又建在仓库根下，两边对不上（实测：往 worktree 写文件失败）。
// 绝对路径 + pid 唯一，两点一起把「谁跑过什么」的影响摘干净。
fn wt_ws_pid(out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, "/tmp/selftest_p37_wt_");
    const pid: i64 = sys_getpid() catch { 0 as i64; };
    _ = buf_append_i64(out, pid);
}

// worktree 轮的 git 执行器：跑 gitx_run，stdout 丢弃，stderr 交给调用方。
// 返回 git 的退出码；argv 以 null 结尾，errout 不扩容。
fn wt_test_git(argv: &(&const byte), errout: &Buf) i32 {
    var o: Buf = buf_new(8192);
    defer { buf_free(&o); }
    return gitx_run(null as &const byte, argv, &o, errout, 8192);
}

// 造一个只有一次提交的真仓库（wsp 是独占目录的绝对路径）
fn wt_fixture_make(wsp: &const Buf, errout: &Buf) bool {
    // wsp 是 Buf（没有尾 NUL）：先补一份带 NUL 的给收 C 字符串的那几个调用
    var wsz: Buf = buf_new(1024);
    defer { buf_free(&wsz); }
    _ = buf_append(&wsz, wsp.ptr as &const byte, wsp.len);
    _ = buf_append_byte(&wsz, 0);
    _ = sess_mkdir_p(wsz.ptr as &const byte);
    var p: Buf = buf_new(1024);
    defer { buf_free(&p); }
    var av: [&const byte: 8] = [null as &const byte: 8];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = wsz.ptr as &const byte;
    av[3] = "init" as &const byte;
    av[4] = "-q" as &const byte;
    av[5] = null as &const byte;
    _ = wt_test_git(&av[0], errout);
    _ = buf_append(&p, wsp.ptr as &const byte, wsp.len);
    _ = buf_append_cstr_z(&p, "/base.txt");
    if !write_text_file(p.ptr as &const byte, "base\n" as &const byte) {
        return false;
    }
    var av2: [&const byte: 16] = [null as &const byte: 16];
    av2[0] = "git" as &const byte;
    av2[1] = "-C" as &const byte;
    av2[2] = wsz.ptr as &const byte;
    av2[3] = "add" as &const byte;
    av2[4] = "-A" as &const byte;
    av2[5] = null as &const byte;
    _ = wt_test_git(&av2[0], errout);
    var av3: [&const byte: 20] = [null as &const byte: 20];
    av3[0] = "git" as &const byte;
    av3[1] = "-C" as &const byte;
    av3[2] = wsz.ptr as &const byte;
    av3[3] = "-c" as &const byte;
    av3[4] = "user.email=t@t" as &const byte;
    av3[5] = "-c" as &const byte;
    av3[6] = "user.name=t" as &const byte;
    av3[7] = "commit" as &const byte;
    av3[8] = "-q" as &const byte;
    av3[9] = "-m" as &const byte;
    av3[10] = "init" as &const byte;
    av3[11] = null as &const byte;
    _ = wt_test_git(&av3[0], errout);
    return true;
}

// 一轮：建 worktree（真 git）→ 闸门拒绝 → finish 合并并删除
fn worktree_round(tag: &const byte) bool {
    var ok: bool = true;
    if !gitx_available() {
        out_err("selftest[");
        out_err(tag);
        out_err("] skip（本机 PATH 里没有 git）\n");
        return ok;
    }
    var errout: Buf = buf_new(4096);
    defer { buf_free(&errout); }
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        ty_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    var wsz: Buf = buf_new(128);
    defer { buf_free(&wsz); }
    wt_ws_pid(&wsz);
    if !wt_fixture_make(&wsz, &errout) {
        ty_fail(tag, "造 fixture 仓失败", &ok);
        return ok;
    }
    wt_reset();
    wt_set_on(true);
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("m");
    const rc: i32 = wt_provision(&cfg, wsz.ptr as &const byte, wsz.len,
        "session-00000000-0000-4000-8000-000000000000" as &const byte, 43);
    if rc != 0 || !wt_ready() {
        ty_fail(tag, "wt_provision 没建出 worktree", &ok);
        out_err("  note=");
        const st: &const WtState = wt_state();
        out_err_bytes(st.note.ptr as &const byte, st.note.len);
        out_err("\n  err=");
        out_err_bytes(errout.ptr as &const byte, errout.len);
        out_err("\n");
        return ok;
    }
    const st0: &const WtState = wt_state();
    if !ty_buf_is(&st0.base, "master" as &const byte) && !ty_buf_is(&st0.base, "main" as &const byte) {
        ty_fail(tag, "基分支应当探测到 master 或 main（不是 HEAD）", &ok);
    }
    // ---- 闸门 1：往共享 checkout 写文件 → 拒 ----
    var shared_file: Buf = buf_new(1024);
    defer { buf_free(&shared_file); }
    _ = buf_append(&shared_file, wsz.ptr as &const byte, wsz.len);
    _ = buf_append_cstr(&shared_file, "/base.txt");
    if !wt_guard_path_crosses(shared_file.ptr as &const byte, shared_file.len) {
        ty_fail(tag, "共享 checkout 里的文件应当被闸门判定为越界", &ok);
    }
    // fs_stat / write_text_file 收 C 字符串：这些路径缓冲末尾都得有 NUL
    // （没有的话 sys_open 会读堆里的旧字节 —— 小轮子里恰好是 0 就「碰巧通过」，
    //   整轮里堆脏了必失败，实测踩过）
    // worktree 里的路径不算越界
    var in_wt: Buf = buf_new(1200);
    defer { buf_free(&in_wt); }
    _ = buf_append(&in_wt, st0.worktree_path.ptr as &const byte, st0.worktree_path.len);
    _ = buf_append_cstr(&in_wt, "/base.txt");
    if wt_guard_path_crosses(in_wt.ptr as &const byte, in_wt.len) {
        ty_fail(tag, "worktree 里的文件不该被判成越界", &ok);
    }
    // ---- 闸门 2：bash 在共享 checkout 里跑 git commit → 拒；只读命令放行 ----
    if !wt_guard_bash_crosses(wsz.ptr as &const byte, wsz.len,
            "git commit -m x" as &const byte, 16) {
        ty_fail(tag, "共享 checkout 里的 git commit 应当被拒", &ok);
    }
    if wt_guard_bash_crosses(wsz.ptr as &const byte, wsz.len,
            "git status" as &const byte, 10) {
        ty_fail(tag, "只读的 git status 不该被拒", &ok);
    }
    // ---- 在 worktree 里改一个文件，然后 finish：合并 + 删除 ----
    var wt_file: Buf = buf_new(1200);
    defer { buf_free(&wt_file); }
    _ = buf_append(&wt_file, st0.worktree_path.ptr as &const byte, st0.worktree_path.len);
    _ = buf_append_cstr_z(&wt_file, "/added.txt");
    if !write_text_file(wt_file.ptr as &const byte, "from the worktree\n" as &const byte) {
        ty_fail(tag, "往 worktree 里写文件失败", &ok);
    }
    var fout: Buf = buf_new(8192);
    defer { buf_free(&fout); }
    const frc: i32 = wt_finish("p37 merge" as &const byte, false, &fout);
    if frc != 0 {
        ty_fail(tag, "wt_finish 失败", &ok);
        out_err("  out=");
        out_err_bytes(fout.ptr as &const byte, fout.len);
        out_err("\n");
    } else {
        // worktree 目录没了
        var stt: FsStat = FsStat{ exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0 };
        _ = fs_stat(st0.worktree_path.ptr as &const byte, &stt);
        if stt.exists {
            ty_fail(tag, "finish 之后 worktree 目录还在（没删掉）", &ok);
        }
        // 主干上真的有那次改动（合并成功）
        var merged: Buf = buf_new(1200);
        defer { buf_free(&merged); }
        _ = buf_append(&merged, wsz.ptr as &const byte, wsz.len);
        _ = buf_append_cstr_z(&merged, "/added.txt");
        var mst: FsStat = FsStat{ exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0 };
        _ = fs_stat(merged.ptr as &const byte, &mst);
        if !mst.exists {
            ty_fail(tag, "finish 之后主干上没有合并进来的文件", &ok);
        }
        if wt_phase() != WT_PHASE_FINISHED {
            ty_fail(tag, "finish 之后 phase 应当是 FINISHED", &ok);
        }
    }
    wt_set_on(false);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（建 worktree + 基分支探测 + 两道闸门 + finish 合并并删除）\n");
    }
    return ok;
}

// P48：`worktree` 工具带 `message` 的 finish —— 钉「msg 是 C 串口径」这条契约。
//
// 为什么单独一轮：`wt_finish(msg)` 里用 `bufx_cstr_len(msg)` / `buf_append_cstr(msg)`
// （C 串口径），而**工具那条路**的 msg 来自 `js_obj_get_str_unescaped`，它只写内容、
// **不补 NUL**。以前那条路只有「直接传字面量」的自测（字面量天然有 NUL），所以从没红过 ——
// 而真机走工具时，`bufx_cstr_len` 会一路读到堆尾巴：实测 merge 的 commit message 后面
// 黏上了 `.rodata` 里的工具 schema（`"function","funct1"type":"function",…`），
// 提交说明被污染，读到的字节数还不确定（踩坑 57/67 同族）。
// 这一轮走**真工具入口**（`wt_tool_worktree` + JSON arguments），并直接读回 git 的
// commit subject 逐字节比对。
fn worktree_tool_msg_round(tag: &const byte) bool {
    var ok: bool = true;
    if !gitx_available() {
        out_err("selftest[");
        out_err(tag);
        out_err("] skip（本机 PATH 里没有 git）\n");
        return ok;
    }
    var errout: Buf = buf_new(4096);
    defer { buf_free(&errout); }
    var wsz: Buf = buf_new(128);
    defer { buf_free(&wsz); }
    wt_ws_pid(&wsz);
    if !wt_fixture_make(&wsz, &errout) {
        ty_fail(tag, "造 fixture 仓失败", &ok);
        return ok;
    }
    wt_reset();
    wt_set_on(true);
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.workspace = buf_new(wsz.len + 8);
    _ = buf_append(&cfg.workspace, wsz.ptr as &const byte, wsz.len);
    cfg.agent_home = buf_new(64);
    _ = buf_append_cstr(&cfg.agent_home, "build/selftest_agent_home");
    const prc: i32 = wt_provision(&cfg, wsz.ptr as &const byte, wsz.len,
        "session-00000000-0000-4000-8000-000000000001" as &const byte, 43);
    if prc != 0 || !wt_ready() {
        ty_fail(tag, "wt_provision 没建出 worktree", &ok);
        wt_set_on(false);
        return ok;
    }
    const st0: &const WtState = wt_state();
    var wt_file: Buf = buf_new(1200);
    defer { buf_free(&wt_file); }
    _ = buf_append(&wt_file, st0.worktree_path.ptr as &const byte, st0.worktree_path.len);
    _ = buf_append_cstr_z(&wt_file, "/added.txt");
    if !write_text_file(wt_file.ptr as &const byte, "tool message\n" as &const byte) {
        ty_fail(tag, "往 worktree 里写文件失败", &ok);
    }
    // 走真工具入口：arguments 里的 message 由 JSON 解出来（**没有 NUL**）
    var arena_raw: &void = malloc(65536);
    if ((arena_raw as &byte) as usize) == 0 {
        ty_fail(tag, "malloc 失败", &ok);
        wt_set_on(false);
        return ok;
    }
    defer { free(arena_raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, 65536);
    var argsb: Buf = buf_new(256);
    defer { buf_free(&argsb); }
    _ = buf_append_cstr(&argsb, `{"action":"finish","message":"tool-message-marker"}`);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, argsb.ptr as &const byte, argsb.len, &root) {
        ty_fail(tag, "工具参数不是合法 JSON", &ok);
        wt_set_on(false);
        return ok;
    }
    var tout: Buf = buf_new(8192);
    defer { buf_free(&tout); }
    wt_tool_worktree(&cfg, &root, &tout);
    if wt_phase() != WT_PHASE_FINISHED {
        ty_fail(tag, "带 message 的工具 finish 没成功", &ok);
        out_err("  out=");
        out_err_bytes(tout.ptr as &const byte, tout.len);
        out_err("\n");
        wt_set_on(false);
        return ok;
    }
    // `-C <dir>` 是 C 串口径：路径缓冲必须补 NUL（wsz 是裸 Buf，直接传会读到堆尾巴）
    var wsz_z: Buf = buf_new(wsz.len + 8);
    defer { buf_free(&wsz_z); }
    _ = buf_append(&wsz_z, wsz.ptr as &const byte, wsz.len);
    _ = buf_append_byte(&wsz_z, 0);
    // 读回 git 的提交说明：必须**恰好**是那个 marker，后面不许黏任何字节
    var av: [&const byte: 8] = [null as &const byte: 8];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = wsz_z.ptr as &const byte;
    av[3] = "log" as &const byte;
    av[4] = "-1" as &const byte;
    av[5] = "--pretty=%s" as &const byte;
    av[6] = null as &const byte;
    var subject: Buf = buf_new(4096);
    defer { buf_free(&subject); }
    var gerr: Buf = buf_new(4096);
    defer { buf_free(&gerr); }
    if gitx_run(null as &const byte, &av[0], &subject, &gerr, 32768) != 0 {
        ty_fail(tag, "读不回 git log 的 subject", &ok);
        out_err("  git err=[");
        out_err_bytes(gerr.ptr as &const byte, gerr.len);
        out_err("]\n");
    } else {
        while subject.len > 0 && (subject.ptr[subject.len - 1] == 10 as byte
                || subject.ptr[subject.len - 1] == 13 as byte) {
            subject.len = subject.len - 1;
        }
        if !bufx_eq_cstr(subject.ptr as &const byte, subject.len, "tool-message-marker" as &const byte) {
            ty_fail(tag, "工具传的 message 没有逐字节落到提交说明上（读越界会把后面的字节也带上）", &ok);
            out_err("  subject=[");
            out_err_bytes(subject.ptr as &const byte, subject.len);
            out_err("]\n");
        }
    }
    wt_set_on(false);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（工具带 message 的 finish：提交说明逐字节 = 传入的 marker）\n");
    }
    return ok;
}

// discard：不合并、直接删（主干上不该出现 worktree 里的文件）
fn worktree_discard_round(tag: &const byte) bool {
    var ok: bool = true;
    if !gitx_available() {
        out_err("selftest[");
        out_err(tag);
        out_err("] skip（本机 PATH 里没有 git）\n");
        return ok;
    }
    var errout: Buf = buf_new(4096);
    defer { buf_free(&errout); }
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        ty_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    var wsz: Buf = buf_new(128);
    defer { buf_free(&wsz); }
    wt_ws_pid(&wsz);
    if !wt_fixture_make(&wsz, &errout) {
        ty_fail(tag, "造 fixture 仓失败", &ok);
        return ok;
    }
    wt_reset();
    wt_set_on(true);
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("m");
    _ = wt_provision(&cfg, wsz.ptr as &const byte, wsz.len,
        "session-11111111-1111-4111-8111-111111111111" as &const byte, 43);
    if !wt_ready() {
        ty_fail(tag, "discard 轮没能建出 worktree", &ok);
        return ok;
    }
    const st0: &const WtState = wt_state();
    var wt_file: Buf = buf_new(1200);
    defer { buf_free(&wt_file); }
    _ = buf_append(&wt_file, st0.worktree_path.ptr as &const byte, st0.worktree_path.len);
    _ = buf_append_cstr_z(&wt_file, "/discarded.txt");
    _ = write_text_file(wt_file.ptr as &const byte, "gone\n" as &const byte);
    var dout: Buf = buf_new(8192);
    defer { buf_free(&dout); }
    if wt_discard(&dout) != 0 {
        ty_fail(tag, "wt_discard 失败", &ok);
    }
    // 主干上没有那个文件（没合并）
    var merged: Buf = buf_new(1200);
    defer { buf_free(&merged); }
    _ = buf_append(&merged, wsz.ptr as &const byte, wsz.len);
    _ = buf_append_cstr_z(&merged, "/discarded.txt");
    var mst: FsStat = FsStat{ exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0 };
    _ = fs_stat(merged.ptr as &const byte, &mst);
    if mst.exists {
        ty_fail(tag, "discard 之后主干上不该出现那个文件", &ok);
    }
    if wt_phase() != WT_PHASE_DISCARDED {
        ty_fail(tag, "discard 之后 phase 应当是 DISCARDED", &ok);
    }
    // 非仓库目录：skipped（fail soft），不报错退出
    wt_reset();
    wt_set_on(true);
    var nrcfg: Config = cfg_default();
    defer { cfg_free(&nrcfg); }
    nrcfg.model = buf_from_cstr("m");
    var nrz: Buf = buf_new(128);
    defer { buf_free(&nrz); }
    _ = buf_append_cstr(&nrz, "/tmp/selftest_p37_norepo_");
    _ = buf_append_i64(&nrz, sys_getpid() catch { 0 as i64; });
    _ = buf_append_byte(&nrz, 0);
    _ = sess_mkdir_p(nrz.ptr as &const byte);
    var nr: Buf = buf_new(128);
    defer { buf_free(&nr); }
    _ = buf_append_cstr(&nr, "/tmp/selftest_p37_norepo_");
    _ = buf_append_i64(&nr, sys_getpid() catch { 0 as i64; });
    // 关键：p37_wt 这个 fixture 仓就在 build/ 下面，`git -C build/selftest_p37_norepo`
    // 会**往上**找到 build/../ 的仓库（实测确实找到了）—— 所以先放一个 .git **文件**挡住
    // （git 把它当成 gitdir 指针，解析失败 → rev-parse 非零 → 判成非仓库）
    var guard: Buf = buf_new(1024);
    defer { buf_free(&guard); }
    _ = buf_append(&guard, nrz.ptr as &const byte, nrz.len - 1);
    _ = buf_append_cstr_z(&guard, "/.git");
    _ = write_text_file(guard.ptr as &const byte, "gitdir: /nonexistent\n" as &const byte);
    _ = wt_provision(&nrcfg, nr.ptr as &const byte, nr.len, "session-x" as &const byte, 9);
    if wt_phase() != WT_PHASE_SKIPPED {
        ty_fail(tag, "非仓库目录应当判成 skipped（fail soft）", &ok);
    }
    wt_set_on(false);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（discard 不合并 + 清理 / 非仓库目录 fail soft）\n");
    }
    return ok;
}

// ============================================================
// P49：残留 worktree 的回收（真 git）
//
// 这一轮盯的是**判据**：什么该清、什么一个字节都不许动。四组场景：
//   A) 干净 + 零提交 → 清掉（目录与分支都没了）；
//   B) 有未提交改动 → **留**（git 的 remove 不带 --force 也会拒，判据只是提前一步）；
//   C) 有提交（未合并）→ **留**（否则就是「悄悄扔掉别人没合的工作」）；
//   D) 干净 + 零提交，但有活进程 cwd 在里面 → **留**（并发会话正在用）。
// 外加：`wt_reclaim_own` 对自己的 worktree 走同一条判据，清掉之后 phase 翻成 DISCARDED。
// D 用**真子进程**（sh -c 'cd <dir>; sleep'）当「活着的占用者」—— fork 出来的子进程
// 在 /proc 里的 cwd 是那个目录，正是这条判据要抓的东西。
// ============================================================

// 造一个「会话残留」：在 repo 里建一个 worktree + 分支（不通过 wt_provision，
// 免得动全局状态），返回它的路径（无 NUL）
// 造一个「会话残留」：在 repo 里建一个 worktree + 分支（不通过 wt_provision，
// 免得动全局状态），返回它的路径（无 NUL）。
//
// 分支名 = "dsh/" + slug + "-" + 序号（进程内递增）。为什么要那个序号：这个 fixture 是
// **同一个进程里所有 worktree 轮共用**的仓库，上一轮留下的 dsh/* 分支会让这一轮的
// `worktree add -b <同名>` 直接失败（实测：完整 selftest 时 worktree-reclaim 轮红在
// 「F 准备失败：它还被 worktree 占着」，单独跑却是绿的）。带序号之后名字永不复用，
// 于是「这一轮建的一定是新的」。返回的名字（不带 dsh/ 前缀）写进 out_slug，供断言用。
var g_wt_residue_seq: i32 = 0;

// 给残留 worktree 轮的 slug 加**进程内单调序号**，避免与上一轮同名（同名会让
// `worktree add -b <同名>` 直接失败）。结果（不带 dsh/ 前缀）写进 out_slug，每轮调用一次。
//
// 结果**必须带尾 NUL**（但不算进 len）：这个名字马上要被当 C 字符串用 —— 它经
// `wt_residue_make_named` / `wt_branch_gone` / `wt_branch_checked_out` 之后走的是
// `buf_append_cstr` 与 `bufx_cstr_len`（C 串口径）。不补 NUL 就会一路读到 `buf_new`
// 那块堆后面的脏字节（踩坑 57 的形状），分支名与 worktree 路径都会黏上垃圾：
// 实测 `dsh/inuse1-4` 后面跟着 `\x9d\x13@\0\0\0\0` 与半截 fixture 路径，
// `git worktree add -b <那个名字>` 于是时好时坏 —— 这正是完整 selftest 里
// `worktree-reclaim` 轮偶发「造 D/F 失败」的根因（单独跑 model-only 轮时堆还干净，
// 所以三十次也不红）。`len` 仍是**可见长度**，调用方按 len 用的地方不受影响。
fn wt_residue_slug(slug: &const byte, out_slug: &Buf) void {
    g_wt_residue_seq = g_wt_residue_seq + 1;
    buf_reset(out_slug);
    _ = buf_append_cstr(out_slug, slug);
    _ = buf_append_cstr(out_slug, "-");
    _ = buf_append_i64(out_slug, g_wt_residue_seq as i64);
    _ = buf_append_byte(out_slug, 0);
    if out_slug.len > 0 {
        out_slug.len = out_slug.len - 1;
    }
}

// 造一个残留：分支名由调用方给全（断言要按名字查「还在不在」）。
// 名字一律走 wt_residue_slug（带进程内序号），永不复用。
fn wt_residue_make_named(repo: &const Buf, slug: &const byte, out_path: &Buf, errout: &Buf) bool {
    var rz: Buf = buf_new(1024);
    defer { buf_free(&rz); }
    _ = buf_append(&rz, repo.ptr as &const byte, repo.len);
    _ = buf_append_byte(&rz, 0);
    var br: Buf = buf_new(64);
    defer { buf_free(&br); }
    _ = buf_append_cstr(&br, "dsh/");
    _ = buf_append_cstr(&br, slug);
    var brz: Buf = buf_new(br.len + 1);
    defer { buf_free(&brz); }
    _ = buf_append(&brz, br.ptr as &const byte, br.len);
    _ = buf_append_byte(&brz, 0);
    buf_reset(out_path);
    _ = buf_append(out_path, repo.ptr as &const byte, repo.len);
    _ = buf_append_cstr(out_path, "/.git/dsh-worktrees/");
    _ = buf_append_cstr(out_path, slug);
    var pz: Buf = buf_new(out_path.len + 1);
    defer { buf_free(&pz); }
    _ = buf_append(&pz, out_path.ptr as &const byte, out_path.len);
    _ = buf_append_byte(&pz, 0);
    var av: [&const byte: 12] = [null as &const byte: 12];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = rz.ptr as &const byte;
    av[3] = "worktree" as &const byte;
    av[4] = "add" as &const byte;
    av[5] = "-b" as &const byte;
    av[6] = brz.ptr as &const byte;
    av[7] = pz.ptr as &const byte;
    av[8] = "master" as &const byte;
    av[9] = null as &const byte;
    return wt_test_git(&av[0], errout) == 0;
}

// 这个路径还存在吗？
fn wt_path_gone(path: &const Buf) bool {
    var pz: Buf = buf_new(path.len + 1);
    defer { buf_free(&pz); }
    _ = buf_append(&pz, path.ptr as &const byte, path.len);
    _ = buf_append_byte(&pz, 0);
    var st: FsStat = FsStat{ exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0 };
    _ = fs_stat(pz.ptr as &const byte, &st);
    return !st.exists;
}

// 这个分支还在吗？
fn wt_branch_gone(repo: &const Buf, br: &const byte) bool {
    var rz: Buf = buf_new(repo.len + 1);
    defer { buf_free(&rz); }
    _ = buf_append(&rz, repo.ptr as &const byte, repo.len);
    _ = buf_append_byte(&rz, 0);
    var bz: Buf = buf_new(64);
    defer { buf_free(&bz); }
    _ = buf_append_cstr(&bz, "refs/heads/dsh/");
    _ = buf_append_cstr(&bz, br);
    _ = buf_append_byte(&bz, 0);
    var av: [&const byte: 8] = [null as &const byte: 8];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = rz.ptr as &const byte;
    av[3] = "show-ref" as &const byte;
    av[4] = "--verify" as &const byte;
    av[5] = "--quiet" as &const byte;
    av[6] = bz.ptr as &const byte;
    av[7] = null as &const byte;
    var o: Buf = buf_new(256);
    defer { buf_free(&o); }
    return wt_test_git(&av[0], &o) != 0;   // 非零 = 找不到这个 ref
}

// worktree-reclaim 轮（P49）：残留 worktree 的回收判据 —— 干净零提交才清，
// 有改动 / 有提交 / 有人用一律留。本机没 git 就 skip（返回 true）；返回 false = 本轮红。
fn worktree_reclaim_round(tag: &const byte) bool {
    var ok: bool = true;
    if !gitx_available() {
        out_err("selftest[");
        out_err(tag);
        out_err("] skip（本机 PATH 里没有 git）\n");
        return ok;
    }
    var errout: Buf = buf_new(4096);
    defer { buf_free(&errout); }
    var wsz: Buf = buf_new(128);
    defer { buf_free(&wsz); }
    wt_ws_pid(&wsz);
    if !wt_fixture_make(&wsz, &errout) {
        ty_fail(tag, "造 fixture 仓失败", &ok);
        return ok;
    }
    var repo: Buf = buf_new(1200);
    defer { buf_free(&repo); }
    var rout: Buf = buf_new(4096);
    defer { buf_free(&rout); }
    // wsz 是**没有尾 NUL** 的（wt_ws_pid 只写内容），而它要当 git 的 `-C` 参数用 ——
    // 直接传 wsz.ptr 会把堆里后面的脏字节一起读进去（踩坑 57 的形状）。实测在完整
    // selftest 里就炸了：报 `fatal: cannot change to '/tmp/selftest_p37_wt_2300741111-
    // 111111111111ce":"/selftest/meta-big/TRUNCuild/...'`（后面黏的正是前面轮次留在堆里
    // 的字节）。所以这里备一份带 NUL 的 wszz，凡是把它当 argv 的地方都用它。
    var wszz: Buf = buf_new(wsz.len + 1);
    defer { buf_free(&wszz); }
    _ = buf_append(&wszz, wsz.ptr as &const byte, wsz.len);
    _ = buf_append_byte(&wszz, 0);
    if wt_repo_of(wsz.ptr as &const byte, wsz.len, &repo) != 0 {
        ty_fail(tag, "wt_repo_of 拿不到仓库根", &ok);
        return ok;
    }
    // fixture 是**同一个进程里所有 worktree 轮共用**的仓库（按 pid 独占，但 worktree /
    // worktree-discard / worktree-tool-msg / 这一轮都用它），前面那几轮会在里面留下
    // 自己建过又删掉的注册与分支。这一轮先把 dsh/* 扫一遍再从确定状态开始：
    //   * 上一轮留下的**零提交**残留会被清掉（清法就用被测的这条 reclaim，顺手也算一次
    //     「连扫两遍不炸、第二遍没事可做」的旁证）；
    //   * 有提交的（`dsh/commit*` 之类）清不掉，但这一轮的分支名一律带进程内序号
    //     （wt_residue_slug），所以不会再撞名 —— 见下面那段注释记的实测。
    var pre: Buf = buf_new(4096);
    defer { buf_free(&pre); }
    _ = wt_reclaim_scan(repo.ptr as &const byte, &pre);
    _ = wt_reclaim_scan(repo.ptr as &const byte, &pre);
    // 四条判据的扫描入口：先建出 A/B/C 三个残留，一次 reclaim 之后逐个验
    var pa: Buf = buf_new(1200);
    defer { buf_free(&pa); }
    var pb: Buf = buf_new(1200);
    defer { buf_free(&pb); }
    var pc: Buf = buf_new(1200);
    defer { buf_free(&pc); }
    var pa_slug: Buf = buf_new(64);
    defer { buf_free(&pa_slug); }
    wt_residue_slug("clean0" as &const byte, &pa_slug);
    // 判据钉：slug 是 C 串口径的 argv（下面 `wt_residue_make_named` 拿它当 `-b` 的值，
    // 内部走 `buf_append_cstr`）。没有尾 NUL 时 `bufx_cstr_len` 会读到堆尾巴，分支名与
    // 路径一起黏上垃圾、`git worktree add` 时好时坏 —— 完整 selftest 里表现为偶发
    // 「造 D/F 失败」（单独跑 model-only 时堆干净，所以三十次都不红，见踩坑 57）。
    // 这一条把「可见长度 == C 串长度」钉住：补错/漏补都当场红，不必等下一次偶发。
    if bufx_cstr_len(pa_slug.ptr as &const byte) != pa_slug.len {
        ty_fail(tag, "slug 没补尾 NUL（C 串口径会读到堆尾巴 —— 造 D/F 偶发失败的根因）", &ok);
    }
    if !wt_residue_make_named(&wsz, pa_slug.ptr as &const byte, &pa, &errout) {
        ty_fail(tag, "造 A（干净零提交）失败", &ok);
        return ok;
    }
    var pb_slug: Buf = buf_new(64);
    defer { buf_free(&pb_slug); }
    wt_residue_slug("dirty1" as &const byte, &pb_slug);
    if !wt_residue_make_named(&wsz, pb_slug.ptr as &const byte, &pb, &errout) {
        ty_fail(tag, "造 B（有改动）失败", &ok);
        return ok;
    }
    var pc_slug: Buf = buf_new(64);
    defer { buf_free(&pc_slug); }
    wt_residue_slug("commit1" as &const byte, &pc_slug);
    if !wt_residue_make_named(&wsz, pc_slug.ptr as &const byte, &pc, &errout) {
        ty_fail(tag, "造 C（有提交）失败", &ok);
        return ok;
    }
    // B：写一个未提交文件；C：写一个文件并提交
    var bf: Buf = buf_new(1400);
    defer { buf_free(&bf); }
    _ = buf_append(&bf, pb.ptr as &const byte, pb.len);
    _ = buf_append_cstr_z(&bf, "/dirty.txt");
    if !write_text_file(bf.ptr as &const byte, "half done\n" as &const byte) {
        ty_fail(tag, "往 B 里写文件失败", &ok);
    }
    var cf: Buf = buf_new(1400);
    defer { buf_free(&cf); }
    _ = buf_append(&cf, pc.ptr as &const byte, pc.len);
    _ = buf_append_cstr_z(&cf, "/done.txt");
    if !write_text_file(cf.ptr as &const byte, "committed\n" as &const byte) {
        ty_fail(tag, "往 C 里写文件失败", &ok);
    }
    // C：在它的目录里 add -A 再 commit（-C 要 **worktree 目录**，不是那个文件 ——
    // 写成 cf 的话 git 会去那个文件里找仓库，报「不是 git 仓库」，判据 3 就测不出来）
    var pcz: Buf = buf_new(pc.len + 1);
    defer { buf_free(&pcz); }
    _ = buf_append(&pcz, pc.ptr as &const byte, pc.len);
    _ = buf_append_byte(&pcz, 0);
    var cav: [&const byte: 12] = [null as &const byte: 12];
    cav[0] = "git" as &const byte;
    cav[1] = "-C" as &const byte;
    cav[2] = pcz.ptr as &const byte;
    cav[3] = "-c" as &const byte;
    cav[4] = "user.email=t@t" as &const byte;
    cav[5] = "-c" as &const byte;
    cav[6] = "user.name=t" as &const byte;
    cav[7] = "add" as &const byte;
    cav[8] = "-A" as &const byte;
    cav[9] = null as &const byte;
    _ = wt_test_git(&cav[0], &errout);
    var cav2: [&const byte: 12] = [null as &const byte: 12];
    cav2[0] = "git" as &const byte;
    cav2[1] = "-C" as &const byte;
    cav2[2] = pcz.ptr as &const byte;
    cav2[3] = "-c" as &const byte;
    cav2[4] = "user.email=t@t" as &const byte;
    cav2[5] = "-c" as &const byte;
    cav2[6] = "user.name=t" as &const byte;
    cav2[7] = "commit" as &const byte;
    cav2[8] = "-q" as &const byte;
    cav2[9] = "-m" as &const byte;
    cav2[10] = "wip" as &const byte;
    cav2[11] = null as &const byte;
    if wt_test_git(&cav2[0], &errout) != 0 {
        ty_fail(tag, "给 C 提交失败（这一轮的判据 3 就测不出来了）", &ok);
        out_err("  git=");
        out_err_bytes(errout.ptr as &const byte, errout.len);
        out_err("\n");
    }
    const n: i32 = wt_reclaim_scan(repo.ptr as &const byte, &rout);
    if n != 1 {
        ty_fail(tag, "应当只清掉 1 个（A），实际清了别的数", &ok);
        out_err("  报告=");
        out_err_bytes(rout.ptr as &const byte, rout.len);
        out_err("\n");
    }
    // A：目录与分支都得没了
    if !wt_path_gone(&pa) {
        ty_fail(tag, "A（干净零提交）的目录应当被清掉", &ok);
    }
    if !wt_branch_gone(&wsz, pa_slug.ptr as &const byte) {
        ty_fail(tag, "A 的分支应当被删掉", &ok);
    }
    // B：目录与分支都在（有未提交的活）
    if wt_path_gone(&pb) {
        ty_fail(tag, "B（有未提交改动）被误删了 —— 那是别人的半成品", &ok);
    }
    if wt_branch_gone(&wsz, pb_slug.ptr as &const byte) {
        ty_fail(tag, "B 的分支被误删了", &ok);
    }
    // C：目录与分支都在（有没合并的提交）
    if wt_path_gone(&pc) {
        ty_fail(tag, "C（有未合并的提交）被误删了 —— 那会悄悄扔掉别人没合的工作", &ok);
    }
    if wt_branch_gone(&wsz, pc_slug.ptr as &const byte) {
        ty_fail(tag, "C 的分支被误删了", &ok);
    }

    // ---- D) 有活进程 cwd 在里面 → 留着（真子进程）----
    var pd: Buf = buf_new(1200);
    defer { buf_free(&pd); }
    var pd_slug: Buf = buf_new(64);
    defer { buf_free(&pd_slug); }
    wt_residue_slug("inuse1" as &const byte, &pd_slug);
    if !wt_residue_make_named(&wsz, pd_slug.ptr as &const byte, &pd, &errout) {
        ty_fail(tag, "造 D 失败", &ok);
    } else {
        // 真子进程：fork 之后 chdir 进那个 worktree 再 exec `sleep 5` ——
        // 于是 /proc/<pid>/cwd 指向它，正是判据 4 要抓的东西。
        var pd_z: Buf = buf_new(pd.len + 1);
        defer { buf_free(&pd_z); }
        _ = buf_append(&pd_z, pd.ptr as &const byte, pd.len);
        _ = buf_append_byte(&pd_z, 0);
        const dpid64: i64 = sys_fork() catch { -1 as i64; };
        if dpid64 == 0 {
            _ = sys_chdir(pd_z.ptr as *const byte) catch {};
            var sav: [&const byte: 4] = [null as &const byte: 4];
            sav[0] = "sleep" as &const byte;
            sav[1] = "5" as &const byte;
            sav[2] = null as &const byte;
            _ = sys_execve("/bin/sleep" as &const byte, &sav[0], saved_envp) catch {};
            _ = sys_execve("/usr/bin/sleep" as &const byte, &sav[0], saved_envp) catch {};
            sys_exit(127);
        }
        if dpid64 < 0 {
            ty_fail(tag, "起不来「占用者」子进程（这条判据就测不出来）", &ok);
        } else {
            const dpid: i32 = i64_to_i32(dpid64);
            // 等它真的 cd 进去（fork/exec 有延迟，不等就是随机绿）
            var tries: i32 = 0;
            while tries < 100 {
                if (sys_kill(dpid as i64, 0) catch { -1; }) != 0 {
                    break;   // 已经没了（exec 失败之类），下面的断言会照实报
                }
                if wt_any_cwd_under(pd.ptr as &const byte, pd.len, 0) == 1 {
                    break;
                }
                tries = tries + 1;
                var ts: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 20000000 as i64 };
                var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
                _ = sys_nanosleep(&ts, &rem) catch {};
            }
            if wt_any_cwd_under(pd.ptr as &const byte, pd.len, 0) != 1 {
                ty_fail(tag, "占用者没进到 D 里（判据 4 这一条没测到）", &ok);
            }
            var rout2: Buf = buf_new(4096);
            defer { buf_free(&rout2); }
            const n2: i32 = wt_reclaim_scan(repo.ptr as &const byte, &rout2);
            if n2 != 0 {
                ty_fail(tag, "有活进程在里面时不该清掉任何东西", &ok);
                out_err("  报告=");
                out_err_bytes(rout2.ptr as &const byte, rout2.len);
                out_err("\n");
            }
            if wt_path_gone(&pd) {
                ty_fail(tag, "D（有活进程 cwd 在里面）被误删了 —— 那会把正在用的会话拆掉", &ok);
            }
            _ = sys_kill(dpid as i64, 9) catch {};
            var stt: i32 = 0;
            _ = sys_waitpid(dpid, &stt, 0) catch {};
            // 死了之后这就变回「确定的垃圾」⇒ 再扫一次应当清掉它（证明判据 4 是真的在判
            // 「活着」，而不是恰好因为这个目录被别的原因挡着）
            var tries2: i32 = 0;
            while tries2 < 100 {
                if wt_any_cwd_under(pd.ptr as &const byte, pd.len, 0) != 1 {
                    break;
                }
                tries2 = tries2 + 1;
                var ts2: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 20000000 as i64 };
                var rem2: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
                _ = sys_nanosleep(&ts2, &rem2) catch {};
            }
            var rout2b: Buf = buf_new(4096);
            defer { buf_free(&rout2b); }
            const n2b: i32 = wt_reclaim_scan(repo.ptr as &const byte, &rout2b);
            if n2b != 1 {
                ty_fail(tag, "占用者死了之后 D 应当能被清掉（判据 4 得真在判活着）", &ok);
                out_err("  报告=");
                out_err_bytes(rout2b.ptr as &const byte, rout2b.len);
                out_err("\n");
            }
            if !wt_path_gone(&pd) {
                ty_fail(tag, "占用者死了之后 D 还是没清掉", &ok);
            }
        }
    }

    // ---- F) 孤儿分支：目录已经没了、只剩一条零提交的 dsh/* 分支 ----
    //
    // 这才是真机上残留的大头：清完目录之后仓库里还躺着 25 条零提交孤儿分支（实测）。
    // 造法：建一个残留，再用 `worktree remove` 把目录与注册一起清掉 —— 分支会留下，
    // 于是就成了「没有 worktree 的孤儿分支」，`git worktree list` 再也列不到它。
    var pf: Buf = buf_new(1200);
    defer { buf_free(&pf); }
    var pf_slug: Buf = buf_new(64);
    defer { buf_free(&pf_slug); }
    wt_residue_slug("orphan1" as &const byte, &pf_slug);
    if !wt_residue_make_named(&wsz, pf_slug.ptr as &const byte, &pf, &errout) {
        ty_fail(tag, "造 F 失败", &ok);
    } else {
        var pz: Buf = buf_new(pf.len + 1);
        defer { buf_free(&pz); }
        _ = buf_append(&pz, pf.ptr as &const byte, pf.len);
        _ = buf_append_byte(&pz, 0);
        var avr: [&const byte: 8] = [null as &const byte: 8];
        avr[0] = "git" as &const byte;
        avr[1] = "-C" as &const byte;
        avr[2] = wszz.ptr as &const byte;
        avr[3] = "worktree" as &const byte;
        avr[4] = "remove" as &const byte;
        avr[5] = "--force" as &const byte;
        avr[6] = pz.ptr as &const byte;
        avr[7] = null as &const byte;
        var orr: Buf = buf_new(4096);
        defer { buf_free(&orr); }
        const rrc: i32 = wt_test_git(&avr[0], &orr);
        if wt_branch_gone(&wsz, pf_slug.ptr as &const byte) {
            ty_fail(tag, "F 准备失败：分支没留下来，孤儿分支这一条就测不出来了", &ok);
        } else {
            // 先确认它**真的**是个孤儿（list 里已经没有它了）。
            //
            // 这一步实测在完整 selftest 里红过：`worktree remove` 的返回值原先被丢弃，
            // 而它**可能失败**（fixture 是同一个进程里好几个 worktree 轮共用的仓库，
            // 前面轮次留下的注册会让 remove 报「already registered」之类）—— 于是注册
            // 还在，这里就判成「还被占着」。所以：① 检查 remove 的返回值；
            // ② 失败时把 git 的 stderr 打出来（否则只看到一句「不算孤儿」，查不出为什么）。
            if rrc != 0 {
                ty_fail(tag, "F 准备失败：git worktree remove 没成功（注册还在）", &ok);
                out_err("  git=");
                out_err_bytes(orr.ptr as &const byte, orr.len);
                out_err("\n");
            } else if wt_branch_checked_out(repo.ptr as &const byte, pf_slug.ptr as &const byte) {
                ty_fail(tag, "F 准备失败：它还被 worktree 占着，不算孤儿", &ok);
            }
            var r1: Buf = buf_new(4096);
            defer { buf_free(&r1); }
            const nb: i32 = wt_reclaim_scan(repo.ptr as &const byte, &r1);
            if nb < 1 {
                ty_fail(tag, "零提交的孤儿分支没被回收（扫不到只剩分支的残留）", &ok);
                out_err("  报告=");
                out_err_bytes(r1.ptr as &const byte, r1.len);
                out_err("\n");
            }
            if !wt_branch_gone(&wsz, pf_slug.ptr as &const byte) {
                ty_fail(tag, "零提交的孤儿分支应当被删掉", &ok);
            }
        }
    }
    // F2) 有提交的孤儿分支**必须留着**（目录没了也不能替他扔没合并的活）
    var pf2: Buf = buf_new(1200);
    defer { buf_free(&pf2); }
    var pf2_slug: Buf = buf_new(64);
    defer { buf_free(&pf2_slug); }
    wt_residue_slug("orphan2" as &const byte, &pf2_slug);
    if !wt_residue_make_named(&wsz, pf2_slug.ptr as &const byte, &pf2, &errout) {
        ty_fail(tag, "造 F2 失败", &ok);
    } else {
        var pz2: Buf = buf_new(pf2.len + 1);
        defer { buf_free(&pz2); }
        _ = buf_append(&pz2, pf2.ptr as &const byte, pf2.len);
        _ = buf_append_byte(&pz2, 0);
        // 在里面提交一笔（-C 要 worktree 目录）
        var f2: Buf = buf_new(1400);
        defer { buf_free(&f2); }
        _ = buf_append(&f2, pf2.ptr as &const byte, pf2.len);
        _ = buf_append_cstr_z(&f2, "/wip.txt");
        _ = write_text_file(f2.ptr as &const byte, "unmerged work\n" as &const byte);
        var c1: [&const byte: 12] = [null as &const byte: 12];
        c1[0] = "git" as &const byte;
        c1[1] = "-C" as &const byte;
        c1[2] = pz2.ptr as &const byte;
        c1[3] = "-c" as &const byte;
        c1[4] = "user.email=t@t" as &const byte;
        c1[5] = "-c" as &const byte;
        c1[6] = "user.name=t" as &const byte;
        c1[7] = "add" as &const byte;
        c1[8] = "-A" as &const byte;
        c1[9] = null as &const byte;
        _ = wt_test_git(&c1[0], &errout);
        var c2: [&const byte: 12] = [null as &const byte: 12];
        c2[0] = "git" as &const byte;
        c2[1] = "-C" as &const byte;
        c2[2] = pz2.ptr as &const byte;
        c2[3] = "-c" as &const byte;
        c2[4] = "user.email=t@t" as &const byte;
        c2[5] = "-c" as &const byte;
        c2[6] = "user.name=t" as &const byte;
        c2[7] = "commit" as &const byte;
        c2[8] = "-q" as &const byte;
        c2[9] = "-m" as &const byte;
        c2[10] = "wip" as &const byte;
        c2[11] = null as &const byte;
        if wt_test_git(&c2[0], &errout) != 0 {
            ty_fail(tag, "F2 准备失败：提交没成", &ok);
        }
        // 删掉目录 + 注册 ⇒ 剩一条**有提交**的孤儿分支
        var avr2: [&const byte: 8] = [null as &const byte: 8];
        avr2[0] = "git" as &const byte;
        avr2[1] = "-C" as &const byte;
        avr2[2] = wszz.ptr as &const byte;
        avr2[3] = "worktree" as &const byte;
        avr2[4] = "remove" as &const byte;
        avr2[5] = "--force" as &const byte;
        avr2[6] = pz2.ptr as &const byte;
        avr2[7] = null as &const byte;
        var orr2: Buf = buf_new(4096);
        defer { buf_free(&orr2); }
        const rrc2: i32 = wt_test_git(&avr2[0], &orr2);
        if rrc2 != 0 {
            ty_fail(tag, "F2 准备失败：git worktree remove 没成功（注册还在）", &ok);
            out_err("  git=");
            out_err_bytes(orr2.ptr as &const byte, orr2.len);
            out_err("\n");
        }
        var r2: Buf = buf_new(4096);
        defer { buf_free(&r2); }
        _ = wt_reclaim_scan(repo.ptr as &const byte, &r2);
        if wt_branch_gone(&wsz, pf2_slug.ptr as &const byte) {
            ty_fail(tag, "有未合并提交的孤儿分支被误删了 —— 那会悄悄扔掉没合并的活", &ok);
        }
        // 上面那条「还在」**单独**不够：git 自己的 `branch -d` 也会拒掉有提交的分支
        // （第二道闸门），所以判据被旁路掉时分支照样「还在」—— 实测确实漏过一次。
        // 这里钉的是**判据自己**有没有拦住它：它连试都不该去试删，报告里既不该出现
        // 「reclaimed branch …」也不该出现「kept branch …(git refused)」—— 后者正说明
        // 判据放行了、只是被 git 兜住（实测：把零提交判据改成恒真，报告里就会出现
        // 「kept branch dsh/orphan2 (git refused to delete it)」，而分支照样在）。
        const mark: &const byte = "kept branch " as &const byte;
        const nm2: &const byte = pf2_slug.ptr as &const byte;
        if ty_has(&r2, mark, bufx_cstr_len(mark)) && ty_has(&r2, nm2, bufx_cstr_len(nm2)) {
            ty_fail(tag, "零提交判据没拦住有提交的孤儿分支（去试删了，只是被 git 兜住）", &ok);
        }
    }

    // ---- 收尾：B / C 还在（有内容）、F2 还挂着（有提交的孤儿分支），再扫一次也不该动它们 ----
    var rout3: Buf = buf_new(4096);
    defer { buf_free(&rout3); }
    const n3: i32 = wt_reclaim_scan(repo.ptr as &const byte, &rout3);
    if n3 != 0 {
        ty_fail(tag, "这一轮已经没有可清的了，不该再清出东西", &ok);
        out_err("  报告=");
        out_err_bytes(rout3.ptr as &const byte, rout3.len);
        out_err("\n");
    }
    if wt_path_gone(&pb) || wt_path_gone(&pc) {
        ty_fail(tag, "收尾时把有内容的 B/C 清掉了", &ok);
    }
    if wt_branch_gone(&wsz, pf2_slug.ptr as &const byte) {
        ty_fail(tag, "收尾时把有提交的孤儿分支清掉了", &ok);
    }

    // ---- E) wt_reclaim_own：自己的 worktree 走同一条判据 ----
    wt_reset();
    wt_set_on(true);
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("m");
    _ = wt_provision(&cfg, wsz.ptr as &const byte, wsz.len,
        "session-reclaim-own" as &const byte, 19);
    if !wt_ready() {
        ty_fail(tag, "E 准备失败：没能建出自己的 worktree", &ok);
    } else {
        var ow: Buf = buf_new(1024);
        defer { buf_free(&ow); }
        if !wt_reclaim_own(&ow) {
            ty_fail(tag, "wt_reclaim_own 没清掉自己的空 worktree", &ok);
            out_err("  out=");
            out_err_bytes(ow.ptr as &const byte, ow.len);
            out_err("\n");
        }
        if wt_phase() != WT_PHASE_DISCARDED {
            ty_fail(tag, "wt_reclaim_own 清掉之后 phase 应当是 DISCARDED", &ok);
        }
        const stn: &const WtState = wt_state();
        if !wt_path_gone(&stn.worktree_path) {
            ty_fail(tag, "wt_reclaim_own 之后目录还在", &ok);
        }
    }
    wt_set_on(false);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（干净零提交才清 / 有改动·有提交·有人用一律留）\n");
    }
    return ok;
}
