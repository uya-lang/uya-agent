// src/selftest/st_mem_leak.uya — mem-leak 轮：定量钉住「每 LLM 交互回合漏 2 个大帧」
//
// 背景（session-92d72e9a 的 419 MB RSS）：每次 `rt_run(allm_stream_chat)` 都在
// 堆上留两块**永不归还**的 async 帧池 heap 块 —— `ahc_open_run` 的 box
//（malloc 51,391 B）与 `ahc_fill_run` 的 box（malloc 33,871 B）。生产里
// 9,659 个交互步累计 10,371 块 ≈ 419 MB（直读堆链实测）。
//
// 判据（拆掉修复会当场红）：跑 N 回合真实 HTTP+SSE（mock 在子进程里回一段
// 最短 SSE），前后各读一次 `heap_large_count()` / `heap_large_bytes()`。
//   修复前：每回合 +2 块、每回合 +85,262 B，N 回合后 live − baseline ≥ 2N；
//   修复后：live 回到基线（±小块常数，mock 侧 fork 与 SSE 文本不构成大块）。
//
// 不变量：① mock 在子进程（sys_fork），每回合一条连接一个新端口，回合后由
// 本轮收尸；② 计数用 `heap_large_*`（`libc.heap` 导出），不猜；
// ③ 每回合的请求体/响应体都走 `ChatOut` 正常释放路径（defer free）。

fn mleak_write(cfd: i32, p: &const byte, n: usize) bool {
    const w: !void = https_write_all(cfd, p, n);
    _ = w catch {
        return false;
    };
    return true;
}

// 读掉请求头（\r\n\r\n 为界），回响应前必须先看到完整请求。
fn mleak_read_head(cfd: i32) bool {
    var tmp: [byte: 4096] = [0: 4096];
    var seen: usize = 0;
    while seen < 65536 {
        const n: isize = sys_read(cfd, &tmp[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            return false;
        }
        var i: usize = 0;
        while i + 3 < (n as usize) {
            if tmp[i] == 13 && tmp[i + 1] == 10 &&
                tmp[i + 2] == 13 && tmp[i + 3] == 10 {
                return true;
            }
            i = i + 1;
        }
        seen = seen + (n as usize);
    }
    return false;
}

// mock 的响应：Content-Length 定长 SSE（与 st_async_turn 同形，最短两帧）。
fn mleak_serve(cfd: i32) i32 {
    if !mleak_read_head(cfd) {
        return 51;
    }
    var wire: Buf = buf_new(2048);
    defer { buf_free(&wire); }
    // 行宽豁免：下面是 HTTP/SSE 协议报文（`data: ` 前缀与空行都是判据），
    // 拆开等于改协议 —— 与 st_async_turn 的豁免条款同款。
    _ = buf_append_cstr(&wire,
        "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n" as &const byte);
    _ = buf_append_cstr(&wire,
        "data: {\"choices\":[{\"delta\":{\"content\":\"x\"}}]}\n\n" as &const byte);
    _ = buf_append_cstr(&wire, "data: [DONE]\n\n" as &const byte);
    _ = buf_append_cstr(&wire, "Connection: close\r\nContent-Length: ");
    const body_off: usize = wire.len;
    _ = buf_append_cstr(&wire, "0000");
    _ = buf_append_cstr(&wire, "\r\n\r\n");
    _ = buf_append_cstr(&wire,
        "data: {\"choices\":[{\"delta\":{\"content\":\"x\"}}]}\n\n" as &const byte);
    _ = buf_append_cstr(&wire, "data: [DONE]\n\n" as &const byte);
    const blen: usize = wire.len - body_off - 4;
    var num: [byte: 24] = [0: 24];
    var nv: u64 = blen as u64;
    var ni: usize = 0;
    if nv == 0 {
        num[0] = 48 as byte;
        ni = 1;
    }
    while nv > 0 {
        num[ni] = (((nv % (10 as u64)) as i32) + 48) as byte;
        nv = nv / (10 as u64);
        ni = ni + 1;
    }
    var k: usize = 0;
    while k < ni {
        wire.ptr[body_off + k] = num[ni - 1 - k];
        k = k + 1;
    }
    if !mleak_write(cfd, wire.ptr as &const byte, wire.len) {
        return 52;
    }
    return 0;
}

// 起一条一次性 mock（fork 子进程，accept 一条连接即退出）。
fn mleak_spawn() u16 {
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return 0 as u16;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR,
        &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    const br: !i32 = sys_bind(lfd, &addr[0] as &void, 16 as u32);
    _ = br catch {
        _ = sys_close(lfd) catch {};
        return 0 as u16;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return 0 as u16;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return 0 as u16;
    };
    const port: u16 = (((got[2] as u16) as u16) << (8 as i32)) |
        (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return 0 as u16;
    };
    if pid64 == 0 {
        var peer: [byte: 16] = [0: 16];
        var plen: u32 = 16;
        const c: i32 = sys_accept(lfd, &peer[0] as &void, &plen) catch {
            0 - 1;
        };
        var rc: i32 = 60;
        if c >= 0 {
            rc = mleak_serve(c);
            _ = sys_close(c) catch {};
        }
        _ = sys_close(lfd) catch {};
        sys_exit(rc);
    }
    _ = sys_close(lfd) catch {};
    return port;
}

// 收掉子进程（防孤儿，selftest 不变量④）。
fn mleak_reap() void {
    var st: i32 = 0;
    _ = sys_waitpid(0 - 1, &st, 0) catch {};
}

// ---------- 请求侧（与 agent 生产同路径：rt_run(allm_stream_chat)） ----------

@async_fn fn mleak_call_run(
    url: &[byte],
    hdrs: &[byte],
    body: &const byte,
    body_len: usize,
    o: &ChatOut,
    status_out: &i32
) Future<!i32> {
    status_out[0] = 0;
    const res: !i32 = @await allm_stream_chat(url, hdrs,
        body, body_len, 15000 as u32, 262144 as usize,
        HC_VERIFY_NONE, &""[0: 0], o, false, false, false, status_out);
    const got: i32 = res catch |err| {
        _ = err;
        0 - 1;
    };
    return got;
}

struct MleakWrap : Future<!i32> {
    inner: Future<!i32>,
    last_ms: u64,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        _ = waker;
        return self.inner.poll(waker);
    }

    fn release(self: &Self) void {
        self.inner.release();
    }
}

var g_mleak_sched: Scheduler = Scheduler{};
var g_mleak_sched_ready: bool = false;

// 一回合：一次完整 HTTP+SSE 请求，返回 status==200。
fn mleak_turn(port: u16, url: &Buf, hdrs: &const Buf, body: &const Buf) bool {
    buf_reset(url);
    _ = buf_append_cstr(url, "http://127.0.0.1:" as &const byte);
    _ = buf_append_u64(url, port as u64);
    _ = buf_append_cstr(url, "/v1/chat/completions" as &const byte);

    var o: ChatOut = chat_out_new();
    defer { chat_out_free(&o); }
    var status: i32 = 0;
    const f: Future<!i32> = mleak_call_run(url.ptr[0: url.len],
        hdrs.ptr[0: hdrs.len], body.ptr as &const byte, body.len,
        &o, &status);
    if !g_mleak_sched_ready {
        g_mleak_sched = scheduler_new();
        g_mleak_sched_ready = true;
    }
    var loop: LinuxEpoll = linux_epoll_create_config(0, 256, 256)
        catch { return false; };
    const wrapped: MleakWrap = MleakWrap{ inner: f, last_ms: 0 };
    const r: !i32 = scheduler_run_i32_with_event_loop(
        &g_mleak_sched, loop, wrapped, 16);
    const rv: i32 = r catch |err| {
        _ = err;
        0 - 1;
    };
    _ = rv;
    f.release();
    linux_epoll_close(&loop);
    mleak_reap();
    return status == 200;
}

// 轮入口：mem-leak。
fn mem_leak_round(tag: &const byte) bool {
    var ok: bool = true;
    const rounds: i32 = 6;

    // 基线：先跑 2 回合暖身（首次路径会分配一次性大块：池本体、桶表等），
    // 再读基线；之后 6 回合只允许小抖动（±4 块），不允许 +2/回合。
    var hdrs: Buf = buf_new(128);
    defer { buf_free(&hdrs); }
    _ = buf_append_cstr(&hdrs,
        "Content-Type: application/json\r\n"
            as &const byte);
    _ = buf_append_cstr(&hdrs, "Accept: text/event-stream\r\n" as &const byte);
    var body: Buf = buf_new(128);
    defer { buf_free(&body); }
    _ = buf_append_cstr(&body,
        "{\"model\":\"selftest-model\",\"stream\":true,"
            as &const byte);
    _ = buf_append_cstr(&body, "\"messages\":[]}" as &const byte);
    var url: Buf = buf_new(64);
    defer { buf_free(&url); }

    var warm: i32 = 0;
    while warm < 2 {
        const port: u16 = mleak_spawn();
        if port == 0 {
            ty_fail(tag, "起 mock 失败（暖身）", &ok);
            return false;
        }
        _ = mleak_turn(port, &url, &hdrs, &body);
        warm = warm + 1;
    }

    const base_cnt: usize = heap_large_count();
    const base_bytes: usize = heap_large_bytes();
    var i: i32 = 0;
    while i < rounds {
        const port: u16 = mleak_spawn();
        if port == 0 {
            ty_fail(tag, "起 mock 失败", &ok);
            return false;
        }
        if !mleak_turn(port, &url, &hdrs, &body) {
            ty_fail(tag, "mock 回合没拿到 200", &ok);
            return false;
        }
        i = i + 1;
    }
    const live_cnt: usize = heap_large_count();
    const live_bytes: usize = heap_large_bytes();

    // 修复前判据（泄漏）：live ≥ base + 2×rounds，bytes ≥ base + 85262×rounds。
    // 修复后要求：块数抖动 ≤ 4、字节抖动 ≤ 128 KiB（mock/分配器噪声）。
    const cnt_grow: i64 = (live_cnt as i64) - (base_cnt as i64);
    const byte_grow: i64 = (live_bytes as i64) - (base_bytes as i64);
    if cnt_grow > 4 {
        ty_fail(tag, "每回合漏大块（块数线性上涨）", &ok);
    }
    if byte_grow > (128 * 1024) as i64 {
        ty_fail(tag, "每回合漏大块（字节线性上涨）", &ok);
    }
    if cnt_grow < 0 - 4 {
        ty_fail(tag, "块数异常回落（判据自身不可信）", &ok);
    }
    if !ok {
        return false;
    }
    out_err("selftest[");
    out_err(tag);
    out_err("] ok: 6 回合 live 大块稳定（无每回合 +2 大帧泄漏）\n");
    return true;
}
