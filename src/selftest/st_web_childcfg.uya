// src/selftest/st_web_childcfg.uya — web 会话子进程的配置继承（P73）
//
// 本文件：`web_childcfg_round`（父进程配置注入子进程环境的判据）、`web_t_env_*`
//   （按「名字 → 期望值」表查环境数组）与 `web_t_env_have` / `web_t_env_lack`
//   （两组表的遍历）。单独一片的理由见 CODING.md §1.3：`st_web.uya` 已 1902 行，
//   再往它里面加就会越过「文件 ≤2000 行」那条硬指标。
// 不变量：① 判据看的是 `web_child_env` 排好的**环境数组**（`sh_env_array()`），
//   **不是 `getenv`** —— 后者读的是本进程的真环境，看不见刚排好的那张表；
//   ② 查表取**第一处**命中，与 `getenv` 的「先命中的赢」同口径（那正是 `env_set_kv`
//   要对付的语义：继承下来的同名旧项必须被换掉）；
//   ③ 本片不真起子进程（只到「环境排好了」这一步），所以它快、且与 PTY 无关。
// 依赖：见锚点 selftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：沿用原文件前缀（本片是同一历史模块的内部拆分）：`web_childcfg_*` / `web_t_*`。

// 一条「该在的环境项」：名字 + 期望值 + 红的时候说什么
struct WebCfgWant {
    name: &const byte,
    want: &const byte,
    why: &const byte,
}

// 父进程给了非默认值 ⇒ 这些必须出现在子进程环境里。
// **权限排第一**：它曾经被悄悄放宽成 Full access（安全性最坏的一条）。
const WEB_CFG_WANTS: [WebCfgWant: 16] = [
    // 访问模式：CLI 给 read-only，子进程就必须是 read-only
    WebCfgWant{ name: "UYA_AGENT_PERMISSION" as &const byte,
        want: "read-only" as &const byte,
        why: "权限没传进子进程（浏览器里会被放宽成 Full access）" as &const byte },
    WebCfgWant{ name: "UYA_AGENT_SANDBOX" as &const byte,
        want: "off" as &const byte,
        why: "--no-sandbox 没传进子进程" as &const byte },
    // 模型路线：错一条就是整轮失败（自建网关会被换成默认端点）
    WebCfgWant{ name: "UYA_AGENT_BASE_URL" as &const byte,
        want: "http://127.0.0.1:1/v1" as &const byte,
        why: "base-url 没传进子进程（自建网关会被换掉）" as &const byte },
    WebCfgWant{ name: "UYA_AGENT_MODEL" as &const byte,
        want: "childcfg-model" as &const byte,
        why: "模型没传进子进程" as &const byte },
    // P90：提供方键 —— 漏了它子进程会按设置里的 `agent-default-model.provider` 发请求
    // （宿主明明是 `--provider beta`，标签页里却打在默认那一家的端点上）
    WebCfgWant{ name: "UYA_AGENT_PROVIDER" as &const byte,
        want: "childcfg-prov" as &const byte,
        why: "提供方没传进子进程（浏览器里会打回设置里的默认路线）" as &const byte },
    WebCfgWant{ name: "UYA_AGENT_API_KEY" as &const byte,
        want: "childcfg-key" as &const byte,
        why: "凭据没传进子进程" as &const byte },
    WebCfgWant{ name: "UYA_AGENT_REASONING_EFFORT" as &const byte,
        want: "high" as &const byte,
        why: "推理档位没传进子进程" as &const byte },
    // 信任策略：漏了它子进程会按 chain 校验 ⇒ 一律失败
    WebCfgWant{ name: "UYA_AGENT_TLS_VERIFY" as &const byte,
        want: "pin" as &const byte,
        why: "TLS 信任策略没传进子进程（pin 会退成 chain 而失败）" as &const byte },
    WebCfgWant{ name: "UYA_AGENT_TLS_PIN" as &const byte,
        want: "abcdef0123456789" as &const byte,
        why: "leaf 指纹没传进子进程" as &const byte },
    // 落点：子进程自己算会落到它的 cwd 与默认 home
    WebCfgWant{ name: "UYA_AGENT_WORKSPACE" as &const byte,
        want: "/tmp/web_childcfg_ws" as &const byte,
        why: "工作区没传进子进程" as &const byte },
    WebCfgWant{ name: "UYA_AGENT_HOME" as &const byte,
        want: "/tmp/web_childcfg_home" as &const byte,
        why: "agent-home 没传进子进程（会话日志会落到别处）" as &const byte },
    // 其余一次性旋钮
    WebCfgWant{ name: "UYA_AGENT_MAX_STEPS" as &const byte,
        want: "7" as &const byte,
        why: "max-steps 没传进子进程" as &const byte },
    WebCfgWant{ name: "UYA_AGENT_TITLE" as &const byte,
        want: "0" as &const byte,
        why: "--no-title 没传进子进程" as &const byte },
    WebCfgWant{ name: "UYA_AGENT_MOUSE" as &const byte,
        want: "0" as &const byte,
        why: "--no-mouse 没传进子进程" as &const byte },
    WebCfgWant{ name: "UYA_AGENT_MCP" as &const byte,
        want: "0" as &const byte,
        why: "--no-mcp 没传进子进程" as &const byte },
    // P84：收图能力位 —— 父进程显式关掉时子进程必须也关（否则终端里挂不上图，
    // 标签页里却照收，每挂一张吃一个网关 400）
    WebCfgWant{ name: "UYA_AGENT_INPUT_IMAGE" as &const byte,
        want: "0" as &const byte,
        why: "收图能力位没传进子进程（终端关了、浏览器里还开着）" as &const byte },
];

// 父进程**没给**（出厂默认）⇒ 这些不许被注入 —— 注入了就把默认值钉死在环境里，
// 挡住子进程自己去读 `settings.yaml`（那是它的合法来源）。
const WEB_CFG_ABSENT: [&const byte: 3] = [
    "UYA_AGENT_PERMISSION" as &const byte,
    "UYA_AGENT_MAX_STEPS" as &const byte,
    // P84：出厂值（支持）**不许**注入 —— 注入了等于把「支持」钉死在子进程环境里，
    // 挡住它自己去读设置里那条 `input: [text]`
    "UYA_AGENT_INPUT_IMAGE" as &const byte,
];

// ============================================================
// web-childcfg：会话子进程拿到父进程的配置（P73）
// ============================================================
//
// 现场：会话子进程是 fork + execve 出来的，argv **只带 `--tui`**；父进程从**命令行**
// 拿到的配置以前一个都没传过去。于是「服务端好好的、标签页里却不是那个设置」：
// `--permission read-only` 在浏览器里变成 `Full access`（**权限被悄悄放宽**，最坏的一条）、
// `--base-url` 指的自建网关变成打 api.deepseek.com（页面上报「请求失败」）、
// 会话日志落到默认 home。见 §16 踩坑 124。
export fn web_childcfg_round(tag: &const byte) bool {
    var ok: bool = true;
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    // 父进程「从命令行拿到」一份非默认配置
    cfg.workspace = buf_from_cstr("/tmp/web_childcfg_ws" as &const byte);
    cfg.agent_home = buf_from_cstr("/tmp/web_childcfg_home" as &const byte);
    cfg.base_url = buf_from_cstr("http://127.0.0.1:1/v1" as &const byte);
    cfg.model = buf_from_cstr("childcfg-model" as &const byte);
    cfg.provider = buf_from_cstr("childcfg-prov" as &const byte);
    cfg.provider_set = true;
    cfg.src_provider = 3;              // 3 = cli：只有显式给过才注入
    cfg.api_key = buf_from_cstr("childcfg-key" as &const byte);
    cfg.reasoning_effort = buf_from_cstr("high" as &const byte);
    cfg.pin = buf_from_cstr("abcdef0123456789" as &const byte);
    cfg.access = PERM_READ_ONLY;
    cfg.src_access = 3;                 // 3 = cli：只有显式给过才注入
    cfg.sandbox = SAN_OFF;
    cfg.sandbox_src = 3;
    cfg.verify = HC_VERIFY_PIN;
    cfg.src_verify = 3;
    cfg.max_steps = 7;
    cfg.title = false;
    cfg.mouse = false;
    cfg.mcp_off = true;
    cfg.input_image = false;
    cfg.src_input_image = 3;            // 3 = cli：只有显式给过才注入
    var s: WebSession = WebSession{ id: buf_empty(), pending: buf_empty(),
        scratch: buf_empty(), pid: 0, master: -1, cols: 100, rows: 30,
        alive: false, close_wanted: false, replay_n: 0, replay_at: 0,
        replay: [buf_empty(): WEB_REPLAY_FRAMES] };
    s.id = buf_from_cstr("session-childcfg-test" as &const byte);
    defer { buf_free(&s.id); }
    const empty: Buf = buf_empty();
    if !web_child_env(&cfg, &s, &empty) {
        tuis_fail(tag, "web_child_env 返回 false", &ok);
        return ok;
    }
    // ① 该传的都得在（整张表逐条查）
    var i: usize = 0;
    while i < 16 {
        const w: &const WebCfgWant = &WEB_CFG_WANTS[i];
        if !web_t_env_is(w.name, w.want) {
            tuis_fail(tag, w.why, &ok);
        }
        i = i + 1;
    }
    // UYA_AGENT_WEB 恒为 0：漏了它子进程会递归起 web 服务器（踩坑 103）
    if !web_t_env_is("UYA_AGENT_WEB" as &const byte, "0" as &const byte) {
        tuis_fail(tag, "没关掉 UYA_AGENT_WEB（子进程会再起一个 web 服务器）", &ok);
    }
    // ② 出厂默认（父进程什么都没给）⇒ 上面那几条不许注入
    var d: Config = cfg_default();
    defer { cfg_free(&d); }
    if !web_child_env(&d, &s, &empty) {
        tuis_fail(tag, "web_child_env(默认配置) 返回 false", &ok);
        return ok;
    }
    var k: usize = 0;
    while k < 3 {
        if web_t_env_present(WEB_CFG_ABSENT[k]) {
            tuis_fail(tag, "父进程没给却注入了 —— 会把默认值钉死、挡住子进程读设置",
                &ok);
        }
        k = k + 1;
    }
    if !web_t_env_is("UYA_AGENT_WEB" as &const byte, "0" as &const byte) {
        tuis_fail(tag, "默认配置下也必须关掉 UYA_AGENT_WEB", &ok);
    }
    // ③ P90：来自 **DSH 设置**的提供方（src == 1）不许注入 —— 那是部署默认路线，
    // 子进程自己会解析（注入了等于把它钉成「env 显式」：之后切模型只换模型名、
    // 端点留在原地，正是 §16 踩坑 96 那个现场）
    var d2: Config = cfg_default();
    defer { cfg_free(&d2); }
    d2.provider = buf_from_cstr("from-dsh" as &const byte);
    d2.provider_set = true;
    d2.src_provider = 1;                  // 1 = dsh-settings：不注入
    if !web_child_env(&d2, &s, &empty) {
        tuis_fail(tag, "web_child_env(设置来源的 provider) 返回 false", &ok);
        return ok;
    }
    if web_t_env_present("UYA_AGENT_PROVIDER" as &const byte) {
        tuis_fail(tag, "设置里来的提供方被注入了（子进程会钉死在默认路线上）", &ok);
    }
    if ok {
        tuis_ok(tag, "父进程配置进了子进程环境；默认值不注入；WEB 恒为 0");
    }
    return ok;
}

// 排好的子进程环境数组里，name 的值是不是 want（名字逐字节相等 + 紧跟 `=` +
// 值逐字节相等）。取**第一处**命中 —— 与 `getenv` 的「先命中的赢」同口径。
fn web_t_env_is(name: &const byte, want: &const byte) bool {
    const n: usize = bufx_cstr_len(name);
    const w: usize = bufx_cstr_len(want);
    var i: usize = 0;
    while i < 256 {
        const p: &const byte = sh_env_array()[i];
        if (p as usize) == 0 {
            return false;
        }
        if bufx_mem_eq(p, name, n) && p[n] == 61 as byte {
            const v: &const byte = p + (n + 1);
            return bufx_cstr_len(v) == w && bufx_mem_eq(v, want, w);
        }
        i = i + 1;
    }
    return false;
}

// 排好的子进程环境数组里有 name 这一项吗（只看有没有，不看值）
fn web_t_env_present(name: &const byte) bool {
    const n: usize = bufx_cstr_len(name);
    var i: usize = 0;
    while i < 256 {
        const p: &const byte = sh_env_array()[i];
        if (p as usize) == 0 {
            return false;
        }
        if bufx_mem_eq(p, name, n) && p[n] == 61 as byte {
            return true;
        }
        i = i + 1;
    }
    return false;
}
