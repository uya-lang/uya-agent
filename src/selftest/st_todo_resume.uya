// src/selftest/st_todo_resume.uya — 清单的落盘与折回（todo-resume）
//
// 本文件：一条链的四个判据 —— `todo_write` 提交 → 日志里那条 `todo/write`（逐字段）→
//   `agent_hist_from_log` 折回内存 → `turn/start` 复位；外加面板口径（`任务 1/3`）。
// 不变量：① 判据落在**可观察**的东西上（日志文本 / `g_todos` / 面板块成品），
//   不看「某个函数返回了 true」；② 每条断言都要能在「把对应那一段改坏」时变红
//   （写、折、复位三截**各自**可测，防假绿）；③ 夹具 home 每轮重建、连跑两次都 PASS。
// 依赖：见锚点 selftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：本文件私有小工具统一 `tsr_` 前缀，轮次入口 `todo_resume_round`。
//
// 修前的现场（用户报的「恢复会话后 tasks 没了」）：清单只在内存里（`g_todos`），
// 日志里一个字节都不写 ⇒ `--resume` / `/resume` / `--continue` 之后恒为空。
// 现在提交成功的整表落一条 `todo/write`（形状对齐 DSH 的
// `exec.agent.session.append("todo/write", { todos })`），恢复时后写覆盖先写。

// 把 3 条夹具清单写进状态：**走真工具入口**（`todo_tool_write`），不是手填 `g_todos` ——
// 手填的话「工具入口有没有接线到落盘」这一截就绕过去了（那正是本文件要钉的东西之一）。
fn tsr_fill(s: &TodoState, out: &Buf) bool {
    var raw: Buf = buf_new(1024);
    defer { buf_free(&raw); }
    // 行宽豁免：不可断的 JSON 字面量（三条清单的完整参数）
    _ = buf_append_cstr(&raw, `{"todos":[{"content":"读现状","status":"completed"},{"content":"改一行","status":"in_progress"},{"content":"跑一遍验收","status":"pending"}]}`);
    var arena_raw: &void = malloc(65536);
    defer { free(arena_raw); }
    if ((arena_raw as &byte) as usize) == 0 {
        return false;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, raw.ptr as &const byte, raw.len, &root) {
        return false;
    }
    buf_reset(out);
    todo_tool_write(s, &root, out);
    return contains(out, "Updated todo list: 1 pending, 1 in progress, 1 completed." as &const byte);
}

// 数一数日志里 `todo/write` 事件的**条数**（写那一截的判据）。
fn tsr_count_todo_events(path: &const byte) usize {
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path, &r) {
        return 0;
    }
    var line: Buf = buf_new(65536);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var n: usize = 0;
    while sess_next(&r, &line) {
        if sess_line_type(&line, &typ) && sv_eq_cstr(&typ, "todo/write" as &const byte) {
            n = n + 1;
        }
    }
    return n;
}

// 日志里那条 `todo/write` 的**原文**（没有就返回 false）。
// 为什么要拿原文：折回那条路（`todo_from_json`）自己会解析，若判据也只调它，
// 「写出来的字节到底长什么样」就没人看了 —— 形状错了照样绿（DSH 客户端就认不出来）。
fn tsr_todo_event_text(path: &const byte, out: &Buf) bool {
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path, &r) {
        return false;
    }
    var line: Buf = buf_new(65536);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var found: bool = false;
    while sess_next(&r, &line) {
        if sess_line_type(&line, &typ) && sv_eq_cstr(&typ, "todo/write" as &const byte) {
            buf_reset(out);
            _ = buf_append(out, line.ptr as &const byte, line.len);
            found = true;      // 不早退：留**最后**一条（后写覆盖先写）
        }
    }
    return found;
}

// 把状态折叠成一行便于逐字节比对的摘要：`content|status;content|status;…`
// （状态名用与日志同一套字面量，于是断言直接读得懂）。
fn tsr_dump(s: &const TodoState, out: &Buf) void {
    buf_reset(out);
    var i: usize = 0;
    while i < s.n {
        if i > 0 {
            _ = buf_append_byte(out, 59);
        }
        _ = buf_append(out, s.items[i].content.ptr as &const byte, s.items[i].content.len);
        _ = buf_append_byte(out, 124);
        if s.items[i].status == TD_INPROGRESS {
            _ = buf_append_cstr(out, "in_progress" as &const byte);
        } else if s.items[i].status == TD_COMPLETED {
            _ = buf_append_cstr(out, "completed" as &const byte);
        } else {
            _ = buf_append_cstr(out, "pending" as &const byte);
        }
        i = i + 1;
    }
}

// A 段：写那一截 —— 提交一条整表之后，日志里必须**正好一条** `todo/write`，
// 且它的 `data.todos` 逐字段对得上（内容 + 状态字面量），顺序也不许换。
fn tsr_case_write(tag: &const byte, c: &const Config, ok: &bool) bool {
    if !agent_session_create(c) {
        ty_fail(tag, "开不出会话（写那一截）", ok);
        return false;
    }
    var out: Buf = buf_new(1024);
    defer { buf_free(&out); }
    if !tsr_fill(&g_todos, &out) {
        ty_fail(tag, "夹具清单没提交成功（todo_tool_write 的回显不对）", ok);
        return false;
    }
    // 日志路径当场抄进调用方的 out（`g_sess` 在 `agent_session_close` 之后会被复位）
    var spath: Buf = buf_new(1200);
    defer { buf_free(&spath); }
    _ = buf_append(&spath, g_sess.path.ptr as &const byte, g_sess.path.len);
    var sz: Buf = buf_new(spath.len + 1);
    defer { buf_free(&sz); }
    _ = buf_append(&sz, spath.ptr, spath.len);
    _ = buf_append_byte(&sz, 0);
    if tsr_count_todo_events(sz.ptr as &const byte) != 1 {
        ty_fail(tag, "提交之后日志里不是正好一条 todo/write", ok);
    }
    var ev: Buf = buf_new(4096);
    defer { buf_free(&ev); }
    if !tsr_todo_event_text(sz.ptr as &const byte, &ev) {
        ty_fail(tag, "日志里没有 todo/write 事件（清单没落盘）", ok);
        return false;
    }
    // 形状：数组在 data 里面（`…"data":{"todos":[…]}`）—— 折回那一侧要往里钻一层，
    // 这里把**线上字节**钉住，两侧就都对得上
    if !contains(&ev, ",\"data\":{\"todos\":[" as &const byte) {
        ty_fail(tag, "todo/write 的载荷形状不对（todos 不在 data 里）", ok);
    }
    // 三条逐字段：内容与状态字面量都要在，且顺序不变（拼接串一次钉完）
    if !contains(&ev, "{\"content\":\"读现状\",\"status\":\"completed\"},{\"content\":\"改一行\",\"status\":\"in_progress\"},{\"content\":\"跑一遍验收\",\"status\":\"pending\"}" as &const byte) {
        ty_fail(tag, "todo/write 里的三条清单逐字段对不上", ok);
    }
    // 会话日志是**同一份文件逐行追加**的：上面那次读（`tsr_todo_event_text`）已经把
    // 内容读出来了，所以「文件里真有这一条」这件事本身就已经被钉住了 —— 不必再走
    // `fs_read_file_all`（那条路的失败形态与这里要判的东西无关，加进去只会多一处噪声源）。
    agent_session_close();
    return true;
}

// B 段：折回那一截 —— 另起一个进程状态（清空内存）后折日志，清单必须回到**原样**。
//
// ⚠ 判据**不能**用 `agent_hist_from_log` 的返回条数（它数的是**历史消息**）：清单不是
// 模型消息（DSH 同口径：那是 UI/replay 状态），所以「折出一条 user 消息都没有、只有
// 清单」的那份日志返回 0 —— 拿它当判据会**假红**（实测踩到：事件类型读出来了、
// 清单一恢复就是对的，却报「折不出内容」）。这里只要求日志里有那条事件，然后看状态。
fn tsr_case_fold(tag: &const byte, c: &const Config, ok: &bool, spath: &const Buf) bool {
    var sz: Buf = buf_new(spath.len + 1);
    defer { buf_free(&sz); }
    _ = buf_append(&sz, spath.ptr as &const byte, spath.len);
    _ = buf_append_byte(&sz, 0);
    if tsr_count_todo_events(sz.ptr as &const byte) != 1 {
        ty_fail(tag, "折回之前日志里那条 todo/write 不见了", ok);
        return false;
    }
    todo_free(&g_todos);
    todo_init(&g_todos);
    var h: History = hist_init();
    defer { hist_free(&h); }
    var next_seq: i64 = 0;
    var sp: Buf = buf_new(spath.len + 8);
    defer { buf_free(&sp); }
    _ = buf_append(&sp, spath.ptr as &const byte, spath.len);
    _ = agent_hist_from_log(c, &h, &sp, &next_seq, false);
    var got: Buf = buf_new(512);
    defer { buf_free(&got); }
    tsr_dump(&g_todos, &got);
    if !bufx_eq_cstr(got.ptr as &const byte, got.len,
            "读现状|completed;改一行|in_progress;跑一遍验收|pending" as &const byte) {
        ty_fail(tag, "折回来的清单与提交的那份不一致（恢复会话看不到清单）", ok);
    }
    return true;
}

// C 段：复位那一截 —— **同一条日志**里 `todo/write` 之后再写一条 `turn/start`，
// 折回来清单必须为空（DSH 口径：todo 是这一回合的执行清单）。
//
// ⚠ 那条 `turn/start` 必须写进**同一份**日志：写到别处去等于没测（实测踩到过 ——
// 第一版新建一个会话去写它，折的还是原来那份，「复位」自然测不出来）。
fn tsr_case_turn_reset(tag: &const byte, c: &const Config, ok: &bool) bool {
    if !agent_session_create(c) {
        ty_fail(tag, "开不出会话（复位那一截）", ok);
        return false;
    }
    var spath: Buf = buf_new(1200);
    defer { buf_free(&spath); }
    _ = buf_append(&spath, g_sess.path.ptr as &const byte, g_sess.path.len);
    var out: Buf = buf_new(1024);
    defer { buf_free(&out); }
    if !tsr_fill(&g_todos, &out) {
        ty_fail(tag, "复位那一截的夹具清单没提交成功", ok);
        agent_session_close();
        return false;
    }
    // 真写盘路径（sess_begin/sess_end）：紧跟着 todo/write 写一条 turn/start
    var ev: Buf = buf_new(64);
    defer { buf_free(&ev); }
    if !sess_begin(&g_sess, "turn/start", &ev) {
        ty_fail(tag, "turn/start 事件写不进去", ok);
        agent_session_close();
        return false;
    }
    _ = buf_append_cstr(&ev, "{\"turn\":1}");
    _ = sess_end(&g_sess, &ev);
    agent_session_close();

    // 折回：清单是**上一回合**的，回合一开始就该复位
    todo_free(&g_todos);
    todo_init(&g_todos);
    var h: History = hist_init();
    defer { hist_free(&h); }
    var next_seq: i64 = 0;
    var sp: Buf = buf_new(spath.len + 8);
    defer { buf_free(&sp); }
    _ = buf_append(&sp, spath.ptr as &const byte, spath.len);
    _ = agent_hist_from_log(c, &h, &sp, &next_seq, false);
    if g_todos.n != 0 {
        ty_fail(tag, "折到 turn/start 之后清单没复位（那是上一回合的清单）", ok);
    }
    return true;
}

// D 段：面板口径 —— 折回来的清单要真的出现在常驻块的成品文本里（`任务 1/3`）。
// 只看 `g_todos` 是不够的：那份投影还差一次 `tasks_panel_sync` 才算「推下去」，
// 而用户看到的是屏幕（这条与踩坑 69 的「清状态还得推显示」同一族）。
fn tsr_case_panel(tag: &const byte, ok: &bool) bool {
    // 显示层要自己打开（与 tasks-scroll 轮同一条）：非 TUI 那条分支才走「推面板块」
    tui_headless_enable(false);
    view_init(true, 0);
    tasks_init();
    tasks_expand_set(false);
    _ = tasks_panel_sync();
    var txt: Buf = buf_new(16384);
    defer { buf_free(&txt); }
    tasks_latest(&txt);
    if txt.len == 0 {
        ty_fail(tag, "常驻块的成品文本是空的（清单没推到面板）", ok);
        return false;
    }
    if !contains(&txt, "任务 1/3" as &const byte) {
        ty_fail(tag, "常驻块里没有折回来的清单（面板没跟着折回更新）", ok);
    }
    return true;
}

// E 段：**产品侧**的「回合开始清空」—— `agent_log_turn_start()` 自己那一句
// （`todo_clear`）。为什么与 C 段分开：C 段测的是**折叠侧**认不认 `turn/start`，
// 而这一段测的是「写那条事件的函数有没有顺手把内存里的清单清掉」—— 两件事各有一条腿，
// 任一截坏掉时**只有对应那一条**红（对照实验 D 与 C 分得开）。
fn tsr_case_start_clear(tag: &const byte, c: &const Config, ok: &bool) bool {
    if !agent_session_create(c) {
        ty_fail(tag, "开不出会话（回合开始那一截）", ok);
        return false;
    }
    var out: Buf = buf_new(1024);
    defer { buf_free(&out); }
    if !tsr_fill(&g_todos, &out) {
        ty_fail(tag, "回合开始那一截的夹具清单没提交成功", ok);
        agent_session_close();
        return false;
    }
    if g_todos.n != 3 {
        ty_fail(tag, "夹具清单没进状态（提交之后就不是三条）", ok);
    }
    agent_log_turn_start();          // 产品侧：回合开始
    if g_todos.n != 0 {
        ty_fail(tag, "回合开始没清空上一回合的清单（todo_clear 没接线）", ok);
    }
    agent_session_close();
    return true;
}

// todo-resume 轮：清单的落盘与折回。返回 false = 本轮红。
//
// 五段（判据在各自函数的注释里）：① 写（日志里有那一条且逐字段对）；
// ② 折（清空内存后折回来一模一样）；③ 面板（`任务 1/3` 上屏）；
// ④ 复位（折到 turn/start 出空）；⑤ 回合开始清空（产品侧那一句 `todo_clear`）。
//
// cfg 在**本轮**持有（不借进程全局）：`agent_session_create` 要读它的 home 与会话开关。
// 表回收一律走 `g_todos` / `tasks_free()` —— 它们本来就是进程级的，轮末必须还原。
fn todo_resume_round(tag: &const byte) bool {
    var ok: bool = true;
    var c: Config = cfg_default();
    defer { cfg_free(&c); }
    const home: &const byte = "build/selftest_todo_resume" as &const byte;
    _ = sess_mkdir_p(home);
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, home);
    c.model = buf_from_cstr("selftest-model");
    c.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&c);
    c.save_session = true;

    var spath: Buf = buf_empty();
    defer { buf_free(&spath); }
    // 写那一截自己开会话：它留下的 `g_sess.path` 就是后面两段的输入
    if !tsr_case_write(tag, &c, &ok) {
        todo_free(&g_todos);
        todo_init(&g_todos);
        tasks_free();
        return ok;
    }
    spath = buf_new(g_sess.path.len + 8);
    _ = buf_append(&spath, g_sess.path.ptr as &const byte, g_sess.path.len);
    // 顺序要紧：面板那一截必须在折回（清单非空）之后、复位（清单清空）之前看，
    // 否则看到的是一份已经清掉的清单，报出来的是「面板空的」而不是真缺陷
    if tsr_case_fold(tag, &c, &ok, &spath) {
        if tsr_case_panel(tag, &ok) {
            if tsr_case_turn_reset(tag, &c, &ok) {
                _ = tsr_case_start_clear(tag, &c, &ok);
            }
        }
    }

    // 收尾：清单与面板不留状态给后面的轮次
    todo_free(&g_todos);
    todo_init(&g_todos);
    tasks_free();
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（提交落 todo/write 且逐字段对得上；清空内存折回来一致；面板出现「任务 1/3」；turn/start 折出空；回合开始清空内存清单）\n");
    }
    return ok;
}
