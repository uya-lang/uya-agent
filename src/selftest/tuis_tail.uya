// src/selftest/tuis_tail.uya — 全屏 TUI 的离线自测轮（tuiselftest.uya 的拆分片 7/7）
//
// 本文件：tui-mouse：鼠标上报开关（踩坑 72，「不能复制文本」）；tui-paste（P50）：括起粘贴（bracketed paste）+ 输入上限；P37：/model 与 /effort 浮层（模型选择 / 推理强度选择）；P41：/worktree 的动作选择浮层（+ finish/discard 的二次确认）；tui-watch-pick：/watch 现役清单 ↔ 「选中即跟随」这一条链（P46）
// 不变量：① 断言走**字节级**屏幕快照 `tui_screen_text`，必须与画帧同源；② 每轮开头用独立夹具
//   + `tui_reset_all()` + `tui_set_headless`/`tui_set_size` 复位，不许残留全局状态；③ 需要真终端的
//   行为一律 fork 到 PTY/子进程，父进程只读回快照；④ 判定码只用低 8 位（`sys_exit` 会截断）。
// 依赖：libc（syscall/unistd）、foundation/bufx、term/tui 各子段、term/tty、session、agent、tools、net。
// 命名：`tuis_*`（断言与夹具）、`tui*_round`（轮次）；本片私有，入口 `tui_selftest_all` 在锚点文件。

// ============================================================
// tui-mouse：鼠标上报开关（踩坑 72，「不能复制文本」）
//
// 症状（用户报告）：uya-agent 的 TUI 里**拖选不了文本、复制不了**。
// 根因（真机复现 + 逐字节）：P25 为了滚轮无条件开了 `ESC[?1000h`+`ESC[?1006h`，
// 而终端只要把鼠标交给我们，**自己的拖选复制就没了** —— 左键按下/拖动全变成
// `ESC[<b;x;yM` 事件灌过来（TUI 只吃滚轮、其余丢弃），于是拖选什么都没有。
// 实测：同一块屏幕，鼠标上报开着时普通拖选 PRIMARY 一个字节都不变；关掉之后
// 选中 TUI 正文立刻拿到文本（拖选得到的正是屏幕上的文字）。
//
// 这一轮钉住三件事：
//   ① 开关本身（tui_set_mouse / tui_mouse_enabled 幂等）；
//   ② **字节级**：开→`1000h`+`1006h`、关→`1006l`+`1000l`，且 `tui_term_enter`
//      发的序列**跟着开关走**（只信标志位的话，把 tui_term_enter 那行改坏了照样绿）；
//   ③ F2（`ESC O Q` 与 CSI 形态 `ESC [ 12 ~`）与 `/mouse [on|off]` 命令都真的翻转。
// ============================================================

// 从 pipe 收一帧（tui_term_enter / set_mouse 刚写下的那些字节）

fn tuis_mouse_enter(rfd: i32, cap: &Buf) void {
    buf_reset(cap);
    tuis_pipe_drain(rfd, cap);
}

// 踩坑 72：跑一个**真的**带 uya-agent TUI 的子进程，把「鼠标上报有没有开」这件事在
// 真终端上量出来 —— 上面 C/D 两段是 headless 的标志位与字节级，这一段补的是
// 「配置 → agent_tui_start → tui_set_mouse → 真终端序列」这条端到端链。
// 判据：mouse=false 时整段 PTY 捕获里**一个** `?1000h`/`?1006h` 都没有；
//       mouse=true（默认）时至少各一个。

fn tuis_mouse_spawn(mouse: bool, want_on: bool, tag: &const byte, ok: &bool) void {
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    }
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    };
    if cpid64 == 0 {
        tuis_child_run_tui_mouse(&slave_path, port, "build/selftest_ws_tui_pty" as &const byte, mouse);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(131072);
    defer { buf_free(&cap); }
    // 首帧（进备用屏幕那一段就把鼠标序列写出来了）
    tuis_drain(m, &cap, 40);
    const has_on: bool = tuis_has(&cap, "\x1b[?1000h" as &const byte);
    if want_on && !has_on {
        tuis_fail(tag, "默认（mouse=true）的真 PTY 里没有开鼠标上报（1000h）", ok);
    }
    if !want_on && has_on {
        tuis_fail(tag, "mouse=false 的真 PTY 里仍然开了鼠标上报（1000h）—— 拖选复制会失效", ok);
    }
    if !want_on && tuis_has(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "mouse=false 的真 PTY 里仍然开了 SGR 鼠标（1006h）", ok);
    }
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 20000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
}

// ============================================================
// tui-paste（P50）：括起粘贴（bracketed paste）+ 输入上限
// 本轮钉住的缺陷（踩坑 81）：`tui_esc_final` 在**内部**把状态置成 5（粘贴中）之后，
// 两个调用点又各补了一句无条件 `g_tui_esc = 0` —— 粘贴态被当场冲掉，`ESC[200~` 从来没
// 生效过。症状是粘多行时 CR 变成回车**逐行提交**（粘 3 行 → 提交 3 次），TAB 变成
// plan 模式开关。LF 恰好与裸 LF 等价，所以老自测（喂 LF）一直是绿的。
//
// 为什么这些断言现在才有意义：修好之前，凡是「粘贴里出现控制字节」的用例在真机上
// 都走不到 —— 状态早被冲掉了。
// ============================================================

fn tui_paste_round(tag: &const byte) bool {
    var ok: bool = true;
    const on: &const byte = "\x1b[200~" as &const byte;
    const off: &const byte = "\x1b[201~" as &const byte;
    // 「PASTE-L1\nPASTE-L2\nPASTE-L3」在**会话日志里**的转义形式：JSON 把换行写成
    // `\` + `n` 两个字符，所以是 28 字节（8+2+8+2+8）。函数内 const 才不会把
    // 数组推断成 int32（模块级 const 会，见上面的编译错误）。
    // 「(输入已达上限 」的 UTF-8 字节（数组字面量，避免「切片描述符 → char*」强转，
    // 见 §16 踩坑 22 与 Makefile 的 codegen-audit）
    const over_lit: [byte: 20] = [
        40, 232, 190, 147, 229, 133, 165, 229, 183, 178, 232, 190, 190, 228, 184, 138, 233, 153, 144, 32
    ];

    // ---- A) 基本：括起粘贴里的 LF 多行 → 一次提交、内容逐字节 ----
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("A1\nA2\nA3" as &const byte, 8);
    tui_keys_inject(off, 6);
    if !tuis_in_is("A1\nA2\nA3" as &const byte) {
        tuis_fail(tag, "括起粘贴里的 LF 多行没有原样进输入行", &ok);
    }
    // 粘贴里**不许**有回车提交（旧实现这里会拿到提交）
    if tui_has_submit() {
        tuis_fail(tag, "括起粘贴把内容当成提交了（粘贴态被冲掉）", &ok);
    }

    // ---- B) CR 不许提交：粘贴态生效的核心判据 ----
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("A1\rA2" as &const byte, 5);
    if tui_has_submit() {
        tuis_fail(tag, "粘贴里的 CR 被当成了回车提交（踩坑 83 的原始症状）", &ok);
    }
    tui_keys_inject(off, 6);
    if !tuis_in_is("A1\nA2" as &const byte) {
        tuis_fail(tag, "粘贴里的 CR 没有折成换行", &ok);
    }

    // ---- C) CRLF 折叠成一个换行（Windows 剪贴板 / 部分终端的形状）----
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("W1\r\nW2\r\nW3" as &const byte, 10);
    tui_keys_inject(off, 6);
    if !tuis_in_is("W1\nW2\nW3" as &const byte) {
        tuis_fail(tag, "CRLF 没有折成一个换行（会一行变两行）", &ok);
    }

    // ---- D) TAB 是字面内容，不是 plan 模式开关 ----
    tuis_reset(100, 30);
    const plan_before: bool = tui_plan_on();
    tui_keys_inject(on, 6);
    tui_keys_inject("\t" as &const byte, 1);
    tui_keys_inject(off, 6);
    if tui_plan_on() != plan_before {
        tuis_fail(tag, "粘贴里的 TAB 切换了计划模式（应当是字面内容）", &ok);
    }
    if tui_input_len() != 1 || tui_input_text().ptr[0] != 9 as byte {
        tuis_fail(tag, "粘贴里的 TAB 没有原样进输入缓冲", &ok);
    }
    // 但**输入缓冲**是原样字节、**帧里**不许出现 TAB（TAB 会让列宽算错）
    // （headless 下 tui_render 直接返回，重排必须走 tui_build）
    tui_build();
    if tui_rows_have_esc() {
        tuis_fail(tag, "粘贴 TAB 之后正文层出现了 ESC", &ok);
    }
    var tab_row: Buf = buf_new(4096);
    defer { buf_free(&tab_row); }
    var found_tab: bool = false;
    var rr: usize = 0;
    while rr < tui_nrows() {
        buf_reset(&tab_row);
        tui_row_text(rr, &tab_row);
        var bb: usize = 0;
        while bb < tab_row.len {
            if tab_row.ptr[bb] == 9 as byte {
                found_tab = true;
            }
            bb = bb + 1;
        }
        rr = rr + 1;
    }
    if found_tab {
        tuis_fail(tag, "TAB 字节直接上屏了（列宽会错，必须清洗成空格）", &ok);
    }

    // ---- E) 粘贴里的 ESC 序列逐字节保留（不许吞内容）----
    // 旧实现把 `ESC[31m` 里的数字丢了（它复用 CSI 参数累加器，分不清 31 和 201）。
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("x \x1b[31mR\x1b[0m y" as &const byte, 14);
    tui_keys_inject(off, 6);
    if !tuis_in_is("x \x1b[31mR\x1b[0m y" as &const byte) {
        tuis_fail(tag, "粘贴里的 ESC 序列没有逐字节保留（旧实现在这里丢数字）", &ok);
    }

    // ---- F) 粘贴收尾标记被切开也认（真终端会分片）----
    // 注意长度：`"\x1b[20"` 是 **4** 个字节（ESC [ 2 0）—— 手写长度写大一个字节会
    // 把 NUL 也喂进去（§16 踩坑 77 同族）。
    tuis_reset(100, 30);
    tui_keys_feed(on, 6);
    tui_keys_feed("S1" as &const byte, 2);
    tui_keys_feed("\x1b[20" as &const byte, 4);
    if !tuis_in_is("S1" as &const byte) {
        tuis_fail(tag, "粘贴收尾序列被切开时内容被提前改动了", &ok);
    }
    tui_keys_feed("1~" as &const byte, 2);
    tui_key_flush_esc();
    tui_handle_keys();
    // 收尾标记收全 → 粘贴态结束；再来的普通字节按普通按键走（不许还留在粘贴里）
    tui_keys_inject("Z" as &const byte, 1);
    if !tuis_in_is("S1Z" as &const byte) {
        tuis_fail(tag, "粘贴收尾标记被切开后没有正确收尾", &ok);
    }

    // ---- G) 结尾悬着 ESC（buffer 正好断在 ESC 上）不许吞字节 ----
    tuis_reset(100, 30);
    tui_keys_feed(on, 6);
    tui_keys_feed("E1" as &const byte, 2);
    tui_keys_feed("\x1b" as &const byte, 1);
    tui_key_flush_esc();
    tui_handle_keys();
    if !tuis_in_is("E1\x1b" as &const byte) {
        tuis_fail(tag, "粘贴末尾悬着的 ESC 被吞了（断流时应当吐回内容）", &ok);
    }

    // ---- H) 上限：超限要提示、且不静默丢（对齐 MSG_CONTENT_MAX）----
    // 每次只喂 400 字节：`tui_key_feed` 每次调用最多产出「1 字节 1 事件」，
    // 而事件队列 TUI_EVQ_MAX = 512（真实读键的 sys_read 上限同样是 512，两者本来就配套）。
    // 一次喂 4096 会先在队列上截掉（这是**测试**的喂法不真实，不是产品缺陷）。
    tuis_reset(100, 30);
    var chunk: Buf = buf_new(512);
    defer { buf_free(&chunk); }
    var ci: usize = 0;
    while ci < 400 {
        _ = buf_append_byte(&chunk, 97);   // 'a'
        ci = ci + 1;
    }
    var sent: usize = 0;
    var over_notice: bool = false;
    while sent < 200400 {
        const before: usize = tui_input_len();
        tui_keys_inject(chunk.ptr as &const byte, chunk.len);
        sent = sent + chunk.len;
        if tui_input_len() == before {
            // 已经到顶：找那条 notice（走屏幕文本，与「用户看得见」同口径）。
            // 用 tui_build() 而不是 tui_render()：后者在 headless（g_tui_on=false）下
            // 直接返回，什么都不会重排。
            tui_build();
            var scr: Buf = buf_new(65536);
            defer { buf_free(&scr); }
            tui_screen_text(&scr);
            if find_sub(scr.ptr[0: scr.len], &over_lit[0: 20], 0) >= 0 {
                over_notice = true;
            }
            break;
        }
    }
    if tui_input_len() != 200000 {
        tuis_fail(tag, "输入上限不是 MSG_CONTENT_MAX（200000）—— 与入史上限脱钩", &ok);
    }
    if !over_notice {
        tuis_fail(tag, "输入到上限时没有提示（旧实现是静默丢弃）", &ok);
    }
    // 超限之后输入行仍然是合法内容（不是半截 UTF-8 / 不是垃圾）
    if tui_input_text().ptr[0] != 97 as byte {
        tuis_fail(tag, "到达上限后输入内容被破坏", &ok);
    }

    // ---- I) 光标列按显示口径（TAB 四个空格）----
    // 必须走**粘贴**那条路进：裸 TAB 是 plan 模式开关（键位口径不变），
    // 只有粘贴进来的 TAB 才是字面内容。
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("ab\t" as &const byte, 3);
    tui_keys_inject(off, 6);
    if !tuis_in_is("ab\t" as &const byte) {
        tuis_fail(tag, "粘贴里的 TAB 没有进输入缓冲", &ok);
    }
    var cl: usize = 0;
    var cc: usize = 0;
    tui_input_cursor_line_col(&cl, &cc);
    if cl != 0 || cc != 6 {
        tuis_fail(tag, "TAB 之后光标列没按显示口径算（应当 2+4=6）", &ok);
    }

    // ---- J) 真 PTY：粘 3 行（CR 分隔）必须只提交**一次** ----
    // 这是踩坑 81 的真机判据：修前 CR 被当成回车逐行提交（粘 3 行 → 3 条 user 消息）。
    // 与 `tui-pty` 同一条路：真 /dev/ptmx + fork + 真实按键字节（不经注入钩子）。
    if !tui_paste_pty_case(tag, &ok) {
        ok = false;
    }

    return ok;
}

// 取目录里第一个**非隐藏**条目的完整路径（P49 的会话日志定位用）。
// 为什么不用 sess_find_last：那条路要 index.jsonl，而索引是 sess_close 写的。

fn tui_paste_first_dir(dir: &const Buf, out: &Buf) bool {
    var dz: Buf = buf_new(dir.len + 2);
    defer { buf_free(&dz); }
    _ = buf_append(&dz, dir.ptr as &const byte, dir.len);
    _ = buf_append_byte(&dz, 0);
    const dp: &DIR = opendir(&dz.ptr[0] as *const byte);
    if dp == null {
        return false;
    }
    defer { _ = closedir(dp); }
    while true {
        const de: &Dirent = readdir(dp);
        if de == null {
            return false;
        }
        var nm: Buf = buf_new(272);
        defer { buf_free(&nm); }
        if !buf_append_cstr(&nm, &de.d_name[0] as &const byte) {
            continue;
        }
        if nm.len == 0 || nm.ptr[0] == 46 as byte {
            continue;   // 跳过 "." / ".." 与隐藏项
        }
        buf_reset(out);
        _ = buf_append(out, dir.ptr as &const byte, dir.len);
        _ = buf_append_byte(out, 47);
        _ = buf_append(out, nm.ptr as &const byte, nm.len);
        return true;
    }
}

// 真 PTY：粘贴 3 行必须合成**一条**消息（走会话日志断言，不看屏幕）。

fn tui_paste_pty_case(tag: &const byte, ok: &bool) bool {
    var good: bool = true;
    const paste_body: [byte: 28] = [
        80, 65, 83, 84, 69, 45, 76, 49, 92, 110, 80, 65, 83, 84, 69, 45, 76, 50, 92, 110, 80, 65, 83, 84, 69, 45, 76, 51
    ];
    const wsdir: &const byte = "build/selftest_ws_paste" as &const byte;
    if !ws_prepare(wsdir) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return false;
    }
    // 独立的 agent home：按会话日志断言时不能被别的轮次留下的日志盖住
    const phome: &const byte = "build/selftest_agent_home_paste" as &const byte;
    _ = sys_mkdir(phome as *const byte, 493 as u32) catch {};
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return false;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return false;
    }
    tuis_reset(100, 30);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork 失败", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return false;
    };
    if cpid64 == 0 {
        tuis_child_run_tui_paste(&slave_path, port, wsdir, phome);
        sys_exit(3);
        return false;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(131072);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 8);
    // 括起粘贴三行（**CR 分隔**：真实剪贴板里 CR 与 CRLF 都常见，LF 那条老自测已覆盖）
    const paste: &const byte = "\x1b[200~PASTE-L1\rPASTE-L2\rPASTE-L3\x1b[201~" as &const byte;
    tuis_write_master(m, paste, bufx_cstr_len(paste));
    tuis_drain(m, &cap, 8);
    // 粘贴**本身不许提交**：屏幕上还该是输入面板（没有用户条目「▎ 你」）
    if tuis_has(&cap, "▎ 你" as &const byte) {
        tuis_fail(tag, "真 PTY：粘贴里的 CR 被当成了回车提交（踩坑 83 的原始症状）", ok);
        good = false;
    }
    // 再单独敲一次回车 → 提交。
    // 等的是**用户条目上屏**（`▎ 你`）：那才是「提交真的发生了」的证据。
    // 等 "PASTE-L3" 不行 —— 粘贴刚落进输入行时它就在屏幕上了，那只是回显。
    tuis_write_master(m, "\r" as &const byte, 1);
    if !tuis_drain_until(m, &cap, "▎ 你" as &const byte, 5000) {
        tuis_fail(tag, "真 PTY：回车之后没有出现用户条目（粘贴内容没提交）", ok);
        tuis_dump_tail(&cap, 700);
        good = false;
    }
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 15000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
    // 会话日志：**恰好一条** user 消息，且正文是三行合一。
    //
    // 不走 `sess_find_last`：它读 `index.jsonl`，而索引是 `sess_close` 才写的 ——
    // 这一轮对子进程发的是 SIGKILL，索引根本不存在。所以直接按
    // `<home>/sessions/<cwd-dir>/<session-dir>/session.jsonl` 三级目录找。
    //
    // 两处长度都不许手写（本轮实测两次踩同一个坑，见 §16 踩坑 77）：
    //   * `"type":"user/message"` 是 21 字节（写成 23 就整段匹配不上）；
    //   * 正文在日志里是**转义后**的形式（换行 = `\` + `n` 两个字符，共 28 字节）。
    var found: bool = false;
    var extra: bool = false;
    var sessions_dir: Buf = buf_new(512);
    defer { buf_free(&sessions_dir); }
    _ = buf_append_cstr(&sessions_dir, phome);
    _ = buf_append_cstr(&sessions_dir, "/sessions");
    var level2: Buf = buf_new(1024);
    defer { buf_free(&level2); }
    if tui_paste_first_dir(&sessions_dir, &level2) {
        var level3: Buf = buf_new(1024);
        defer { buf_free(&level3); }
        if tui_paste_first_dir(&level2, &level3) {
            var logp: Buf = buf_new(1200);
            defer { buf_free(&logp); }
            _ = buf_append(&logp, level3.ptr as &const byte, level3.len);
            _ = buf_append_cstr(&logp, "/session.jsonl");
            _ = buf_append_byte(&logp, 0);
            if sess_file_exists(logp.ptr as &const byte) {
                var rd: SessReader = sess_reader_empty();
                defer { sess_reader_free(&rd); }
                if sess_reader_load(logp.ptr as &const byte, &rd) && rd.data.len > 0 {
                    var nmsg: usize = 0;
                    const lit: &const byte = "\"type\":\"user/message\"" as &const byte;
                    const lit_n: usize = bufx_cstr_len(lit);
                    var scan: usize = 0;
                    while scan + lit_n <= rd.data.len {
                        if bufx_mem_eq(rd.data.ptr + scan, lit, lit_n) {
                            nmsg = nmsg + 1;
                        }
                        scan = scan + 1;
                    }
                    const has_body: bool = find_sub(rd.data.ptr[0: rd.data.len], &paste_body[0: 28], 0) >= 0;
                    if nmsg == 1 && has_body {
                        found = true;
                    }
                    if nmsg > 1 {
                        extra = true;
                    }
                }
            }
        }
    }
    if extra {
        tuis_fail(tag, "真 PTY：粘贴 3 行变成了多条 user 消息（CR 提交没被按住）", ok);
        good = false;
    } else if !found {
        tuis_fail(tag, "真 PTY：会话日志里没有那条三行合一的 user 消息", ok);
        good = false;
    }
    return good;
}

// tui-mouse 轮：鼠标上报开关（默认开、set_mouse 翻转、同值幂等）+ 真 PTY 里滚轮/点击事件
// 被解码。返回 false = 本轮红；PTY 那条腿自己在子进程里跑。

fn tui_mouse_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- A) 标志位：默认开；set_mouse 翻转；同值幂等 ----
    tuis_reset(100, 30);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "默认应当是开（滚轮依赖它）", &ok);
    }
    tui_set_mouse(false);
    if tui_mouse_enabled() {
        tuis_fail(tag, "tui_set_mouse(false) 没把状态翻过去", &ok);
    }
    tui_set_mouse(false);   // 幂等：不应崩、也不应再写序列
    if tui_mouse_enabled() {
        tuis_fail(tag, "tui_set_mouse(false) 重复调用把状态翻成了开", &ok);
    }
    tui_set_mouse(true);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "tui_set_mouse(true) 没把状态翻回来", &ok);
    }

    // ---- B) F2（两种编码）都翻转状态 ----
    tuis_reset(100, 30);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "F2 用例前置：默认应是开", &ok);
    }
    tui_keys_inject("\x1bOQ" as &const byte, 3);        // F2（SS3 形态）
    if tui_mouse_enabled() {
        tuis_fail(tag, "F2（ESC O Q）没有关掉鼠标上报", &ok);
    }
    tui_keys_inject("\x1bOQ" as &const byte, 3);        // 再按一次开回来
    if !tui_mouse_enabled() {
        tuis_fail(tag, "F2 第二下没有开回来", &ok);
    }
    tui_keys_inject("\x1b[12~" as &const byte, 5);      // F2（CSI 形态）
    if tui_mouse_enabled() {
        tuis_fail(tag, "F2 的 CSI 形态（ESC[12~）没有关掉鼠标上报", &ok);
    }
    // 翻回来后别让这一轮的状态漏给下一段
    tui_set_mouse(true);

    // ---- C) 命令：/mouse off / on / 裸 / 非法取值 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);   // agent_cmd_display 先看 tui_active()（滚动模式只回一行说明）
    var line: Buf = buf_new(64);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "/mouse off");
    agent_cmd_display(&line, 0);
    if tui_mouse_enabled() {
        tuis_fail(tag, "/mouse off 没有关掉鼠标上报", &ok);
    }
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/mouse on");
    agent_cmd_display(&line, 0);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "/mouse on 没有开回来", &ok);
    }
    // 非法取值：状态不许被改（默认还是开）
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/mouse bogus");
    agent_cmd_display(&line, 0);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "/mouse bogus 把状态改掉了（非法取值应当只报错）", &ok);
    }

    // ---- D) 字节级：真写进 pipe，开/关的序列逐字节 ----
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "pipe2 失败（字节级那条腿没跑成）", &ok);
        tui_reset_all();
        tui_headless_enable(true);
        tui_set_size(100, 30);
        return ok;
    }
    var cap: Buf = buf_new(4096);
    defer { buf_free(&cap); }

    // D1) 默认开：tui_term_enter 必须发 1000h + 1006h
    tuis_reset(100, 30);
    tui_set_mouse(true);
    tui_term_enter(fds[1]);
    tuis_mouse_enter(fds[0], &cap);
    if !bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "开鼠标时 tui_term_enter 没发 1000h", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "开鼠标时 tui_term_enter 没发 1006h", &ok);
    }

    // D2) 运行中关：立刻写 1006l + 1000l
    tui_set_mouse(false);
    tuis_mouse_enter(fds[0], &cap);
    if !bufx_contains(&cap, "\x1b[?1006l" as &const byte) {
        tuis_fail(tag, "运行中关鼠标没有写 1006l", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1000l" as &const byte) {
        tuis_fail(tag, "运行中关鼠标没有写 1000l", &ok);
    }
    if bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "运行中关鼠标却又写了 1000h", &ok);
    }

    // D3) 运行中再开：写 1000h + 1006h
    tui_set_mouse(true);
    tuis_mouse_enter(fds[0], &cap);
    if !bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "运行中再开鼠标没有写 1000h", &ok);
    }

    // D3b) 帮助浮层里必须写清这个出口（改了 help 文案就要钉住，否则以后又悄悄丢）
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    tui_help_open();
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "/help 没有开出帮助浮层", &ok);
    } else {
        tui_build();
        if !tuis_screen_has("F2 切换鼠标上报" as &const byte) {
            tuis_fail(tag, "帮助浮层里没有 F2 切换鼠标上报那一条（用户找不到出口）", &ok);
        }
    }
    tui_overlay_close();
    tuis_reset(100, 30);
    tui_set_mouse(true);
    tui_term_enter(fds[1]);
    tuis_mouse_enter(fds[0], &cap);

    // D4) **关着进 TUI**：tui_term_enter 一个鼠标字节都不许发（这是「启动就能拖选」
    //     的关键 —— 若这里仍按默认开，`--no-mouse` 与 UYA_AGENT_MOUSE=0 就白给了）
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    tui_set_mouse(false);
    tui_term_enter(fds[1]);
    tuis_mouse_enter(fds[0], &cap);
    if bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "关着进 TUI 时 tui_term_enter 仍发了 1000h（--no-mouse 会失效）", &ok);
    }
    if bufx_contains(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "关着进 TUI 时 tui_term_enter 仍发了 1006h（--no-mouse 会失效）", &ok);
    }
    // 离开 TUI 仍要关鼠标（此刻其实是关着的，但 teardown 必须写 —— 免得上一轮开着时漏关）
    var leave_cap: Buf = buf_new(1024);
    defer { buf_free(&leave_cap); }
    tui_term_leave(fds[1]);
    tuis_mouse_enter(fds[0], &leave_cap);
    if !bufx_contains(&leave_cap, "\x1b[?1000l" as &const byte) {
        tuis_fail(tag, "离开 TUI 没有关鼠标上报（会拖累后面的 shell）", &ok);
    }

    // 收尾：收回 headless，关 pipe
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    _ = sys_close(fds[1]) catch {};
    _ = sys_close(fds[0]) catch {};

    // ---- E) 真 PTY：配置 → 终端序列这条端到端链（两个方向都量）----
    if !ws_prepare("build/selftest_ws_tui_pty" as &const byte) {
        tuis_fail(tag, "PTY 腿的工作目录准备失败", &ok);
    } else {
        tuis_mouse_spawn(true, true, tag, &ok);      // 默认开：PTY 里必须有 1000h
        tuis_mouse_spawn(false, false, tag, &ok);    // 关：PTY 里一个 1000h 都不许有
    }

    if ok {
        tuis_ok(tag, "鼠标上报开关（默认开 + 幂等 + F2 两种编码 + /mouse on·off·非法 + 字节级：进/关/再开/关着进都与开关一致 + 真 PTY 两个方向）");
    }
    return ok;
}


// ============================================================
// P37：/model 与 /effort 浮层（模型选择 / 推理强度选择）
// ============================================================
// fixture 用一份手写的 settings.yaml（真机那份一直在长，不能当断言基准）。
// 断言四件事：清单按提供方分组且当前项带 ✓；回车交回的行能反解出**模型名**；
// 强度浮层只列模型**公布**的档位；不公布档位的模型上 /effort 不开浮层、只给一行说明。

const TUIM_HOME: &const byte = "build/selftest_p37_tuim_home" as &const byte;

// 把 DSH home 指向模型轮自己的 fixture 目录（TUIM_HOME），让模型目录从它读设置。

fn tuim_home_set() void {
    var hb: Buf = buf_new(128);
    defer { buf_free(&hb); }
    _ = buf_append_cstr(&hb, TUIM_HOME);
    _ = agent_set_dsh_home(hb.ptr[0: hb.len]);
}

// 写模型轮的 settings.yaml fixture（只有我们关心的那几节）。
// 返回 false = 建目录或写文件失败。

fn tuim_fixture_write() bool {
    _ = sess_mkdir_p(TUIM_HOME);
    var p: Buf = buf_new(256);
    defer { buf_free(&p); }
    _ = buf_append_cstr(&p, TUIM_HOME);
    _ = buf_append_cstr_z(&p, "/settings.yaml");
    const body: &const byte = "llm-pi-ai:\n  providers:\n    {\n      alpha:\n        {\n          api: openai-responses,\n          baseURL: https://alpha.example/v1,\n          models:\n            [\n              { id: a-one },\n              { id: a-two, contextWindow: 333000, reasoningEfforts: { off: none, low: low, high: high } }\n            ]\n        },\n      beta:\n        {\n          api: openai-completions,\n          baseURL: https://beta.example/v1,\n          models: [ { id: b-plain, reasoningEfforts: false } ]\n        }\n    }\n" as &const byte;
    return write_text_file(p.ptr as &const byte, body);
}

// tui-model 轮（P37）：/model 与 /effort 浮层 —— 清单按提供方分组且当前项带 ✓、
// 回车交回的行能反解出模型名、强度浮层只列**公布**的档位。返回 false = 本轮红。

fn tui_model_round(tag: &const byte) bool {
    var ok: bool = true;
    if !tuim_fixture_write() {
        tuis_fail(tag, "造 settings.yaml fixture 失败", &ok);
        return ok;
    }
    agent_models_reset();
    tuim_home_set();
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("a-one");
    cfg.provider = buf_from_cstr("alpha");
    cfg.provider_set = true;
    cfg.context_window = -1;
    agent_models_ensure(&cfg);
    if agent_models_count() != 3 {
        tuis_fail(tag, "目录条目数不是 3（alpha 2 + beta 1）", &ok);
        return ok;
    }

    // ---- 1) /model 浮层：分组标题 + ✓ 标当前 ----
    tuis_reset(100, 28);
    agent_model_overlay_open(&cfg);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_MODEL {
        tuis_fail(tag, "/model 没有开出模型浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("模型（enter 切换 · esc 取消）" as &const byte) {
        tuis_fail(tag, "模型浮层标题不对", &ok);
    }
    if !tuis_screen_has("# alpha" as &const byte) || !tuis_screen_has("# beta" as &const byte) {
        tuis_fail(tag, "模型浮层没有按提供方分组", &ok);
    }
    if !tuis_screen_has("a-two" as &const byte) || !tuis_screen_has("b-plain" as &const byte) {
        tuis_fail(tag, "模型浮层没有列出全部模型", &ok);
    }
    if !tuis_screen_has("effort: off, low, high" as &const byte) {
        tuis_fail(tag, "模型浮层没有显示公布的档位", &ok);
    }
    if !tuis_screen_has("（不公布推理档位）" as &const byte) {
        tuis_fail(tag, "非推理模型没有标成「不公布推理档位」", &ok);
    }
    // ✓ 只出现在当前模型（a-one）那一行
    var cur_ok: bool = false;
    var other_ok: bool = true;
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, "✓" as &const byte) {
            if tui_row_has(r, "a-one" as &const byte) {
                cur_ok = true;
            } else {
                other_ok = false;
            }
        }
        r = r + 1;
    }
    if !cur_ok {
        tuis_fail(tag, "当前模型（a-one）那一行没有 ✓", &ok);
    }
    if !other_ok {
        tuis_fail(tag, "非当前模型的行也带了 ✓", &ok);
    }

    // ---- 2) 反解：分组行不是模型名、模型行是；选中 a-two 能切过去 ----
    var sel: Buf = buf_new(1024);
    defer { buf_free(&sel); }
    var mnm: Buf = buf_new(128);
    defer { buf_free(&mnm); }
    // 反解吃的是 Buf（浮层交回的就是 Buf）；先包一层
    var lgrp: Buf = buf_new(64);
    defer { buf_free(&lgrp); }
    _ = buf_append_cstr(&lgrp, "# alpha");
    if agent_model_item_parse(&lgrp, &mnm) {
        tuis_fail(tag, "分组行不该被反解成模型名", &ok);
    }
    var lmod: Buf = buf_new(128);
    defer { buf_free(&lmod); }
    _ = buf_append_cstr(&lmod, "  a-two  effort: off, low, high");
    if !agent_model_item_parse(&lmod, &mnm) {
        tuis_fail(tag, "普通模型行应当能反解出模型名", &ok);
    } else if !tuis_has(&mnm, "a-two" as &const byte) {
        tuis_fail(tag, "反解出来的不是 a-two", &ok);
    }
    // 键路：关掉再开，↓ 一次到 a-two。条目序是 [# alpha, a-one, a-two, # beta, b-plain]，
    // 而**游标默认停在当前模型（a-one，第 1 项）**上 —— 所以一次 ↓ 就是 a-two（早先按「从 0 起」
    // 写了两次 ↓，落到 # beta 上，回车交回的是分组行）。
    tui_overlay_close();
    agent_model_overlay_open(&cfg);
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "模型浮层没有可交回的条目", &ok);
    } else if !agent_model_item_parse(&sel, &mnm) || !tuis_has(&mnm, "a-two" as &const byte) {
        tuis_fail(tag, "↓ + 回车没有落在 a-two 那一行", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "模型浮层没有交出选中项", &ok);
    }
    _ = agent_tui_model_handle(&cfg, null as &History, &sel);
    if !tuis_has(&cfg.model, "a-two" as &const byte) {
        tuis_fail(tag, "选中 a-two 之后 cfg.model 没换", &ok);
    }
    if cfg.context_window == -1 {
        tuis_fail(tag, "选中 a-two 之后能力没跟随（context_window 还是 -1）", &ok);
    }

    // ---- 3) /effort 浮层：只列公布的档位 ----
    tui_overlay_close();
    agent_effort_overlay_open(&cfg);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_EFFORT {
        tuis_fail(tag, "/effort 没有开出强度浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("推理强度（enter 切换 · esc 取消）" as &const byte) {
        tuis_fail(tag, "强度浮层标题不对", &ok);
    }
    if !tuis_screen_has("high" as &const byte) || !tuis_screen_has("low" as &const byte) {
        tuis_fail(tag, "强度浮层没有列出公布的档位", &ok);
    }
    if tuis_screen_has("medium" as &const byte) {
        tuis_fail(tag, "强度浮层列出了没公布的档位（medium）—— 不该发明档位", &ok);
    }
    var esel: Buf = buf_new(256);
    defer { buf_free(&esel); }
    var ev: Buf = buf_new(64);
    defer { buf_free(&ev); }
    var lef: Buf = buf_new(64);
    defer { buf_free(&lef); }
    _ = buf_append_cstr(&lef, "✓ high");
    if !agent_effort_item_parse(&lef, &ev) || !tuis_has(&ev, "high" as &const byte) {
        tuis_fail(tag, "强度行反解不出档位名", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&esel) {
        tuis_fail(tag, "强度浮层没有交出选中项", &ok);
    } else {
        _ = agent_tui_model_handle(&cfg, null as &History, &esel);
        if cfg.reasoning_effort.len == 0 || !cfg.effort_set {
            tuis_fail(tag, "选中的档位没有落到 cfg.reasoning_effort", &ok);
        }
    }

    // ---- 4) 不公布档位的模型：/effort 不开浮层、只给一行说明 ----
    _ = agent_model_apply(&cfg, "beta" as &const byte, 4, "b-plain" as &const byte, 7,
        "human" as &const byte, false);
    tui_overlay_close();
    agent_effort_overlay_open(&cfg);
    if tui_overlay_open() {
        tuis_fail(tag, "不公布档位的模型上 /effort 不该开浮层（那会是个做不到事的控件）", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("没有公布推理档位" as &const byte) {
        tuis_fail(tag, "不公布档位时没有留下可见说明", &ok);
    }

    // ---- 5) 信息行里的强度：设了才挂 `· <强度>`，清掉就一个字节都不多 ----
    tuis_reset(100, 28);
    tui_set_effort("high" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has(" · high" as &const byte) {
        tuis_fail(tag, "信息行没有显示推理强度", &ok);
    }
    tui_set_effort("" as &const byte, 0);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tuis_screen_has(" · high" as &const byte) {
        tuis_fail(tag, "清掉强度之后还在画它", &ok);
    }

    agent_models_reset();
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（/model 分组+✓+反解 / /effort 只列公布档位 / 非推理模型不开浮层 / 信息行强度）\n");
    }
    return ok;
}

// ============================================================
// P41：/worktree 的动作选择浮层（+ finish/discard 的二次确认）
// ============================================================
// 两段：
//   A) 不需要 git：浮层排版（标题 / 八个动作 / ✓ 标当前模式）、反解（认动作行，不认
//      「取消」与别的浮层的条目）、默认游标 = status、不可逆动作**选定不生效**；
//   B) 真 git：建 worktree → 键盘走到 finish → 确认浮层上**什么都不许动**（目录还在、
//      phase 还是 READY）→ 只按回车（游标默认停在「取消」）同样什么都不做 →
//      真的把游标挪到 finish 那一行才合并 + 删除。
// fixture 是 pid 独占的 /tmp 仓（与 P37 那两轮同一套理由：整轮 selftest 会 fork 出一堆
// 子进程，共享目录会互相踩；相对路径会被前面几轮的 chdir 带跑）。造仓复用 selftest.uya
// 的 wt_fixture_make（同一份 fixture，不写第二遍）。

fn tuis_wt_ws_pid(out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, "/tmp/selftest_p41_wt_");
    const pid: i64 = sys_getpid() catch { 0 as i64; };
    _ = buf_append_i64(out, pid);
}

// 路径 + 尾 NUL（fs_stat / write_text_file 收 C 字符串；Buf.ptr 没有尾 NUL）

fn tuis_wt_z(src: &const Buf, suffix: &const byte, out: &Buf) void {
    buf_reset(out);
    _ = buf_append(out, src.ptr as &const byte, src.len);
    _ = buf_append_cstr_z(out, suffix);
}

// path_z（C 串）指向的路径是否存在（经 fs_stat，不跟随符号链接的细节由 fs_stat 定）。

fn tuis_wt_exists(path_z: &const byte) bool {
    var st: FsStat = FsStat{ exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0 };
    _ = fs_stat(path_z, &st);
    return st.exists;
}

// ============================================================
// tui-watch-pick：/watch 现役清单 ↔ 「选中即跟随」这一条链（P46）
// ============================================================
// 用户报的「敲了 /watch 没反应」在 TUI 里是三件事叠在一起，逐个钉住：
//   A) 清单浮层的 kind 必须是**自己的** TUI_OVK_WATCH_LIST —— 以前借 /tasks 的
//      TUI_OVK_TASKS，而那个 kind 在接收端是「纯查看」语义，回车交出来的行没人接、
//      被静默丢掉（「选中代理」与「什么都没发生」是同一屏）；
//   B) 默认游标要落在**第一个代理行**上（第 0 行是表头）：不放的话「打开就回车」落在表头上，
//      用户拿到的是一句「没认出编号」；
//   C) 选中之后的**每条失败路**都要有回执：认不出编号、目标已经不在了（清单还开着的时候
//      子代理可能刚跑完）、目标写错（`/watch sub-9`）——静默是最难查的一种。
// 真终端那半（清单 → 回车 → 跟随浮层 + 实时事件）走 `make e2e-watch-pick`。

fn tui_watch_pick_round(tag: &const byte) bool {
    var ok: bool = true;
    const wsa: &const byte = "build/selftest_ws_watch_pick" as &const byte;
    if !ws_prepare(wsa) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    var c: Config = cfg_default();
    tuis_cmd_cfg(&c, wsa);
    defer { cfg_free(&c); }
    var h: History = hist_init();
    defer { hist_free(&h); }

    // ---- A) 裸 /watch 走 agent_tui_command 这条真路：开出清单浮层，kind 是 WATCH_LIST ----
    tuis_reset(100, 30);
    tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
    tui_begin_session();
    var cmd: Buf = buf_new(32);
    defer { buf_free(&cmd); }
    _ = buf_append_cstr(&cmd, "/watch");
    _ = agent_tui_command(&c, &h, &cmd);
    if !tui_overlay_open() {
        tuis_fail(tag, "裸 /watch 没有开出清单浮层", &ok);
        return ok;
    }
    if tui_overlay_kind() != TUI_OVK_WATCH_LIST {
        tuis_fail(tag, "清单浮层的 kind 不是 TUI_OVK_WATCH_LIST（借 /tasks 的 kind ⇒ 回车的结果没人接）", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("跟随子代理（" as &const byte) {
        tuis_fail(tag, "清单浮层没有画出来", &ok);
    }
    if !tuis_screen_has("回车跟随" as &const byte) {
        tuis_fail(tag, "清单标题里没写「回车跟随」（用户不知道回车能干什么）", &ok);
    }
    if !tuis_screen_has("（没有正在跑的子代理）" as &const byte) {
        tuis_fail(tag, "现役空态没画出来（清单内容不是 agent_watch_list 那一份？）", &ok);
    }

    // ---- B) 默认游标 = 第一个代理行（纯函数，喂一份带表头的清单）----
    var items: Buf = buf_new(512);
    defer { buf_free(&items); }
    _ = buf_append_cstr(&items,
        "[watch] 现役子代理（/watch sub-N 跟随，/watch off 停）：\n  sub-1 [running] a\n  sub-2 [idle] b\n");
    if agent_watch_list_first_row(&items) != 1 {
        tuis_fail(tag, "默认游标没落在第一个代理行上（打开就回车会落在表头上）", &ok);
    }
    buf_reset(&items);
    _ = buf_append_cstr(&items, "[watch] 现役子代理（/watch sub-N 跟随，/watch off 停）：\n  （没有正在跑的子代理）\n");
    if agent_watch_list_first_row(&items) != 0 {
        tuis_fail(tag, "空态清单的游标不该越界", &ok);
    }

    // ---- C1) 回车：浮层把**选中行原文**交出来（且交给主循环那条落点）----
    tui_keys_inject("\r" as &const byte, 1);
    var got: Buf = buf_new(256);
    defer { buf_free(&got); }
    if !tui_overlay_take(&got) {
        tuis_fail(tag, "清单没把选中行交出来（回车的结果被丢了？）", &ok);
    }
    // 空态清单上选中行是表头：认不出编号 ⇒ 必须落一条 notice，不许静默
    if agent_tui_watch_pick(&c, &got) {
        tuis_fail(tag, "空态清单上回车不该开始跟随", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("没认出子代理编号" as &const byte) {
        tuis_fail(tag, "选中表头行时没有回执（静默）", &ok);
    }

    // ---- C2) 选中一个**已经不在**的编号：回执里要点名（清单开着时子代理可能刚跑完）----
    var fake: Buf = buf_new(64);
    defer { buf_free(&fake); }
    _ = buf_append_cstr(&fake, "  sub-7 [running] 早就跑完了");
    if agent_tui_watch_pick(&c, &fake) {
        tuis_fail(tag, "目标不存在却报「已开始跟随」", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("没有 sub-7 这个子代理" as &const byte) {
        tuis_fail(tag, "目标不存在时没有回执（TUI 里就是「敲了没反应」）", &ok);
    }

    // ---- C3) /watch 的三种落点码（TUI 靠它决定开哪张浮层、要不要给回执）----
    var out: Buf = buf_new(256);
    defer { buf_free(&out); }
    if agent_cmd_watch(&c, "" as &const byte, 0, &out) != WATCH_CMD_LIST {
        tuis_fail(tag, "裸 /watch 该回 WATCH_CMD_LIST", &ok);
    }
    buf_reset(&out);
    if agent_cmd_watch(&c, " sub-9" as &const byte, 6, &out) != WATCH_CMD_BAD {
        tuis_fail(tag, "不存在的编号该回 WATCH_CMD_BAD（回 true 的话回执会被丢掉）", &ok);
    }
    buf_reset(&out);
    if agent_cmd_watch(&c, " off" as &const byte, 4, &out) != WATCH_CMD_STOPPED {
        tuis_fail(tag, "/watch off 该回 WATCH_CMD_STOPPED", &ok);
    }

    // ---- D) 回合运行中敲 /watch sub-1：只读命令要能**当场**派发（不许被当成给模型的文本）----
    var live: Buf = buf_new(32);
    defer { buf_free(&live); }
    _ = buf_append_cstr(&live, "/watch sub-1");
    if !agent_tui_cmd_safe(&live) {
        tuis_fail(tag, "带参数的 /watch 不在「只读当场派发」集合里（回合里敲它会等到回合结束）", &ok);
    }
    if agent_steer_line(&live) {
        tuis_fail(tag, "泵点上下文没登记时不该当场派发（那条路归主循环）", &ok);
    }
    var txt: Buf = buf_new(32);
    defer { buf_free(&txt); }
    _ = buf_append_cstr(&txt, "顺便看看日志");
    if agent_steer_line(&txt) {
        tuis_fail(tag, "普通文本不该被当成命令派发", &ok);
    }

    if ok {
        tuis_ok(tag, "清单 kind 是自己的（回车结果有人接）+ 默认游标在第一个代理行 + 选中即跟随的三条失败路都有回执 + 三种落点码 + 带参数的 /watch 在只读集合里" as &const byte);
    }
    return ok;
}

// tui-worktree 轮（P37）：TUI 里的 worktree 建/切/收 —— 建之前先从关开始（wt_set_on(false)），
// 断言清单、切换、finish/discard 的分支与错误文案。返回 false = 本轮红。

fn tui_worktree_round(tag: &const byte) bool {
    var ok: bool = true;
    wt_set_on(false);
    wt_reset();
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        tuis_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    defer { wst_back(&root); }
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("wt-model");
    var h: History = hist_init();
    defer { hist_free(&h); }
    var sel: Buf = buf_new(1024);
    defer { buf_free(&sel); }
    var act: Buf = buf_new(64);
    defer { buf_free(&act); }
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    var cmd: Buf = buf_new(64);
    defer { buf_free(&cmd); }

    // ---- A1) 裸 /worktree（走 agent_tui_command 那条真路）→ 动作选择浮层 ----
    tuis_reset(100, 28);
    tui_overlay_close();
    _ = buf_append_cstr(&cmd, "/worktree");
    _ = agent_tui_command(&cfg, &h, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_WORKTREE {
        tuis_fail(tag, "裸 /worktree 没有开出动作选择浮层", &ok);
        return ok;
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("Git worktree（enter 执行 · esc 取消）" as &const byte) {
        tuis_fail(tag, "动作浮层的标题不对", &ok);
    }
    var i: usize = 0;
    while i < WT_ACT_N {
        if !tuis_screen_has(wt_act_name(i)) {
            tuis_fail(tag, "动作浮层里少了某个动作（动作表与排版对不上）", &ok);
        }
        i = i + 1;
    }
    if !tuis_screen_has("合并回基分支" as &const byte) {
        tuis_fail(tag, "动作行没有带一行说明", &ok);
    }
    // 模式关：✓ 只挂在 off 那一行
    if !tuis_screen_has("✓ off" as &const byte) {
        tuis_fail(tag, "模式关时 ✓ 没有挂在 off 那一行", &ok);
    }
    if tuis_screen_has("✓ on" as &const byte) {
        tuis_fail(tag, "模式关时 on 那一行也带了 ✓", &ok);
    }
    // 模式开：✓ 跟着挪过去
    wt_set_on(true);
    tui_overlay_close();
    agent_tui_worktree_open();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("✓ on" as &const byte) {
        tuis_fail(tag, "模式开时 ✓ 没挪到 on 那一行", &ok);
    }
    if tuis_screen_has("✓ off" as &const byte) {
        tuis_fail(tag, "模式开时 off 那一行还挂着 ✓", &ok);
    }
    wt_set_on(false);
    tui_overlay_close();

    // ---- A2) 反解：动作行认得出，别的浮层的条目与「取消」认不出 ----
    agent_tui_worktree_line(WT_ACT_STATUS, &line);
    if !agent_tui_worktree_parse(&line, &act) || !tuis_has(&act, "status" as &const byte) {
        tuis_fail(tag, "status 行反解不出动作名", &ok);
    }
    agent_tui_worktree_line(WT_ACT_FINISH, &line);
    if !agent_tui_worktree_parse(&line, &act) || !tuis_has(&act, "finish" as &const byte) {
        tuis_fail(tag, "finish 行反解不出动作名", &ok);
    }
    if wt_act_needs_confirm(&act) == false {
        tuis_fail(tag, "finish 没被判成需要确认的不可逆动作", &ok);
    }
    var alien: Buf = buf_new(64);
    defer { buf_free(&alien); }
    _ = buf_append_cstr(&alien, "取消");
    if agent_tui_worktree_parse(&alien, &act) {
        tuis_fail(tag, "「取消」被反解成了动作（那会误执行）", &ok);
    }
    buf_reset(&alien);
    _ = buf_append_cstr(&alien, "✓ Read Only        — 只读");
    if agent_tui_worktree_parse(&alien, &act) {
        tuis_fail(tag, "别的浮层的条目被反解成了动作", &ok);
    }
    buf_reset(&alien);
    _ = buf_append_cstr(&alien, "✓ discard");
    if !agent_tui_worktree_parse(&alien, &act) || !tuis_has(&act, "discard" as &const byte) {
        tuis_fail(tag, "带 ✓ 的动作行反解不出动作名", &ok);
    }
    if wt_act_needs_confirm(&act) == false {
        tuis_fail(tag, "discard 没被判成需要确认的不可逆动作", &ok);
    }

    // ---- A3) 打开就回车 = status（游标默认落在 status，P37 的老手感不变）----
    tui_overlay_close();
    agent_tui_worktree_open();
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "动作浮层没有可交回的条目", &ok);
    } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "status" as &const byte) {
        tuis_fail(tag, "打开就回车没有落在 status 那一行", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "动作浮层没有交出选中项", &ok);
    }
    _ = agent_tui_worktree_handle(&cfg, &h, &sel);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("worktree mode is off" as &const byte) {
        tuis_fail(tag, "status 的结果没有落进转录", &ok);
    }

    // ---- A4) on / off：真翻模式，结果以 notice 落进转录 ----
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(0, &line);          // on 那一行
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if !wt_on() {
        tuis_fail(tag, "选 on 之后模式没打开", &ok);
    }
    // 浮层还开着会盖住转录：先关掉再看屏幕（看得见的才是「落进转录」）
    tui_overlay_close();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("worktree 模式：开" as &const byte) {
        tuis_fail(tag, "on 的结果没有落进转录", &ok);
    }
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(1, &line);          // off 那一行
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if wt_on() {
        tuis_fail(tag, "选 off 之后模式没关掉", &ok);
    }

    // ---- A5) finish / discard：选定**不生效**，先翻确认浮层；默认游标在「取消」----
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(WT_ACT_FINISH, &line);
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
        tuis_fail(tag, "选 finish 没有翻出确认浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("确认 finish？" as &const byte) {
        tuis_fail(tag, "确认浮层的标题不对", &ok);
    }
    if wt_phase() != WT_PHASE_NONE {
        tuis_fail(tag, "还没确认就动了 worktree（phase 变了）", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "确认浮层没有可交回的条目", &ok);
    } else if agent_tui_worktree_parse(&sel, &act) {
        tuis_fail(tag, "确认浮层的默认游标不在「取消」上（回车会真执行）", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "确认浮层没有交出选中项", &ok);
    }
    _ = agent_tui_worktree_handle(&cfg, &h, &sel);
    if wt_phase() != WT_PHASE_NONE {
        tuis_fail(tag, "取消之后 worktree 状态被动了", &ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "取消之后浮层还开着", &ok);
    }
    // discard 走同一条闸门（标题与提示词是另一份，得单独看一眼）
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(WT_ACT_DISCARD, &line);
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
        tuis_fail(tag, "选 discard 没有翻出确认浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("确认 discard？" as &const byte) {
        tuis_fail(tag, "discard 的确认浮层标题不对", &ok);
    }
    if wt_phase() != WT_PHASE_NONE {
        tuis_fail(tag, "discard 还没确认就动了 worktree", &ok);
    }
    tui_overlay_close();

    // ---- B) 真 git：确认之前一个字节都不许动，确认之后才合并 + 删除 ----
    if !gitx_available() {
        out_err("selftest[");
        out_err(tag);
        out_err("] skip B（本机 PATH 里没有 git）\n");
    } else {
        var errout: Buf = buf_new(4096);
        defer { buf_free(&errout); }
        var wsz: Buf = buf_new(128);
        defer { buf_free(&wsz); }
        tuis_wt_ws_pid(&wsz);
        if !wt_fixture_make(&wsz, &errout) {
            tuis_fail(tag, "造 fixture 仓失败", &ok);
        } else {
            wt_reset();
            wt_set_on(true);
            const prc: i32 = wt_provision(&cfg, wsz.ptr as &const byte, wsz.len,
                "session-41414141-4141-4141-8141-414141414141" as &const byte, 43);
            if prc != 0 || !wt_ready() {
                tuis_fail(tag, "wt_provision 没建出 worktree", &ok);
                const stx: &const WtState = wt_state();
                out_err("  note=");
                out_err_bytes(stx.note.ptr as &const byte, stx.note.len);
                out_err("\n");
            } else {
                const st0: &const WtState = wt_state();
                var wtz: Buf = buf_new(1200);
                defer { buf_free(&wtz); }
                tuis_wt_z(&st0.worktree_path, "/p41.txt" as &const byte, &wtz);
                if !write_text_file(wtz.ptr as &const byte, "p41 from the worktree\n" as &const byte) {
                    tuis_fail(tag, "往 worktree 里写文件失败", &ok);
                }
                var wtrootz: Buf = buf_new(1200);
                defer { buf_free(&wtrootz); }
                tuis_wt_z(&st0.worktree_path, "" as &const byte, &wtrootz);
                var mergedz: Buf = buf_new(1200);
                defer { buf_free(&mergedz); }
                tuis_wt_z(&wsz, "/p41.txt" as &const byte, &mergedz);

                // 键盘走一遍：浮层 → ↓（status→finish）→ 回车 → 确认浮层
                tui_overlay_close();
                agent_tui_worktree_open();
                tui_keys_inject("\x1b[B" as &const byte, 3);
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_peek(&sel) {
                    tuis_fail(tag, "动作浮层没有可交回的条目", &ok);
                } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "finish" as &const byte) {
                    tuis_fail(tag, "↓ 一次没有落在 finish 那一行", &ok);
                }
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "动作浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
                    tuis_fail(tag, "finish 没有翻成确认浮层", &ok);
                }
                if wt_phase() != WT_PHASE_READY {
                    tuis_fail(tag, "还没确认就把 worktree 合并/删掉了", &ok);
                }
                if !tuis_wt_exists(wtrootz.ptr as &const byte) {
                    tuis_fail(tag, "还没确认 worktree 目录就没了", &ok);
                }
                // 确认浮层上只按回车（默认游标 = 取消）：什么都不该发生
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_peek(&sel) {
                    tuis_fail(tag, "确认浮层没有可交回的条目", &ok);
                } else if agent_tui_worktree_parse(&sel, &act) {
                    tuis_fail(tag, "确认浮层的默认游标不在「取消」上", &ok);
                }
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "确认浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if wt_phase() != WT_PHASE_READY {
                    tuis_fail(tag, "取消之后 worktree 的 phase 变了", &ok);
                }
                if !tuis_wt_exists(wtrootz.ptr as &const byte) {
                    tuis_fail(tag, "取消之后 worktree 目录没了", &ok);
                }
                if tuis_wt_exists(mergedz.ptr as &const byte) {
                    tuis_fail(tag, "取消之后改动竟然合并到主干上了", &ok);
                }
                // 真的确认：重新走到确认浮层，把游标从「取消」挪到 finish 那一行
                tui_overlay_close();
                agent_tui_worktree_open();
                tui_keys_inject("\x1b[B" as &const byte, 3);
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "动作浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
                    tuis_fail(tag, "第二次选 finish 没有翻出确认浮层", &ok);
                }
                tui_keys_inject("\x1b[A" as &const byte, 3);   // 取消 → finish 那一行
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_peek(&sel) {
                    tuis_fail(tag, "确认浮层没有可交回的条目", &ok);
                } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "finish" as &const byte) {
                    tuis_fail(tag, "↑ 一次没有落在 finish 那一行", &ok);
                }
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "确认浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if wt_phase() != WT_PHASE_FINISHED {
                    tuis_fail(tag, "确认之后没有走完 finish", &ok);
                }
                if tuis_wt_exists(wtrootz.ptr as &const byte) {
                    tuis_fail(tag, "finish 之后 worktree 目录还在", &ok);
                }
                if !tuis_wt_exists(mergedz.ptr as &const byte) {
                    tuis_fail(tag, "finish 之后主干上没有合并进来的文件", &ok);
                }
                tui_build();
                tuis_scan_rows(100, &ok, tag);
                if !tuis_screen_has("removed worktree" as &const byte) {
                    tuis_fail(tag, "finish 的结果没有落进转录", &ok);
                }
            }
        }
    }
    wt_set_on(false);
    wt_reset();
    tui_overlay_close();
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（浮层排版+✓ / 反解只认动作行 / 默认游标=status / finish·discard 先确认 / 真 git：确认前不动、确认后才合并删除）\n");
    }
    return ok;
}

