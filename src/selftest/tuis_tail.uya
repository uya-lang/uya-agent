// src/selftest/tuis_tail.uya — tuiselftest.uya 的拆分片 7/7（纯搬移）
//
// 本文件：tui-marquee（P75）：放不下的文本滚动显示（脚注 cwd 的 30 列窗口 +
//   通用跑马灯）；tui-mouse：鼠标上报开关（踩坑 72，「不能复制文本」）；
//   tui-paste（P50）：括起粘贴（bracketed paste）+ 输入上限；P37：/model 与
//   /effort 浮层（模型选择 / 推理强度选择）；P41：/worktree 的动作选择浮层
//   （+ finish/discard 的二次确认）；tui-watch-pick：/watch 现役清单 ↔
//   「选中即跟随」这一条链（P46）。
// 不变量：与原文件一致 —— 拆分只搬移，不改任何声明的代码；同族轮/段集中在一片里。
// 依赖：见锚点 tuiselftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：沿用原文件前缀（本片是同一历史模块的内部拆分）。

// ============================================================
// tui-mouse：鼠标上报开关（踩坑 72，「不能复制文本」）
//
// 症状（用户报告）：uya-agent 的 TUI 里**拖选不了文本、复制不了**。
// 根因（真机复现 + 逐字节）：P25 为了滚轮无条件开了 `ESC[?1000h`+`ESC[?1006h`，
// 而终端只要把鼠标交给我们，**自己的拖选复制就没了** —— 左键按下/拖动全变成
// `ESC[<b;x;yM` 事件灌过来（TUI 只吃滚轮、其余丢弃），于是拖选什么都没有。
// 实测：同一块屏幕，鼠标上报开着时普通拖选 PRIMARY 一个字节都不变；关掉之后
// 选中 TUI 正文立刻拿到文本（拖选得到的正是屏幕上的文字）。
//
// 这一轮钉住三件事：
//   ① 开关本身（tui_set_mouse / tui_mouse_enabled 幂等）；
//   ② **字节级**：开→`1000h`+`1006h`、关→`1006l`+`1000l`，且 `tui_term_enter`
//      发的序列**跟着开关走**（只信标志位的话，把 tui_term_enter 那行改坏了照样绿）；
//   ③ F2（`ESC O Q` 与 CSI 形态 `ESC [ 12 ~`）与 `/mouse [on|off]` 命令都真的翻转。
// ============================================================

// 从 pipe 收一帧（tui_term_enter / set_mouse 刚写下的那些字节）
fn tuis_mouse_enter(rfd: i32, cap: &Buf) void {
    buf_reset(cap);
    tuis_pipe_drain(rfd, cap);
}

// 踩坑 72：跑一个**真的**带 uya-agent TUI 的子进程，把「鼠标上报有没有开」这件事在
// 真终端上量出来 —— 上面 C/D 两段是 headless 的标志位与字节级，这一段补的是
// 「配置 → agent_tui_start → tui_set_mouse → 真终端序列」这条端到端链。
// 判据：mouse=false 时整段 PTY 捕获里**一个** `?1000h`/`?1006h` 都没有；
//       mouse=true（默认）时至少各一个。
fn tuis_mouse_spawn(mouse: bool, want_on: bool, tag: &const byte, ok: &bool) void {
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    }
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    };
    if cpid64 == 0 {
        tuis_child_run_tui_mouse(&slave_path, port, "build/selftest_ws_tui_pty" as &const byte, mouse);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(131072);
    defer { buf_free(&cap); }
    // 首帧（进备用屏幕那一段就把鼠标序列写出来了）
    tuis_drain(m, &cap, 40);
    const has_on: bool = tuis_has(&cap, "\x1b[?1000h" as &const byte);
    if want_on && !has_on {
        tuis_fail(tag, "默认（mouse=true）的真 PTY 里没有开鼠标上报（1000h）", ok);
    }
    if !want_on && has_on {
        tuis_fail(tag, "mouse=false 的真 PTY 里仍然开了鼠标上报（1000h）—— 拖选复制会失效", ok);
    }
    if !want_on && tuis_has(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "mouse=false 的真 PTY 里仍然开了 SGR 鼠标（1006h）", ok);
    }
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 20000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
}

// ============================================================
// ============================================================
// tui-marquee（P75）：放不下的文本滚动显示
//
// 用户报的是脚注那条工作区路径（要求「30 个字符宽、滚动显示」）。落地时收成一条
// **通用**纪律：凡是「一格放不下」的单行文本都按同一套槽位 + 时间闸门滚
// （style.uya 的 tui_marquee_put / tui_marquee_tick），不是各画各的。
//
// 分段（每段一个小函数，日志里红在哪一眼可见）：
//   A 装得下时与 P75 之前**逐字节相同**：短路径不加 `…`、tick 恒 false 不置脏；
//   B 30 列窗口：宽终端（200 列）上长路径也只占 30 列，尾巴不在屏幕里；
//   C 滚动：时间闸门、一列一步、两端各停 4 步、滚到尾后归零重来；
//   D 复位：兄弟路径（真 worktree 形态）换过去必须从头显示、自测复位同理；
//   E 不变量：滚动中整行 ≤ cols、右半区仍右对齐 cols-3、窄终端退化不变；
//   F 真心跳：只走 tui_tick（一次都不直接调 tui_marquee_tick）也能滚到尾。
// ============================================================

// 脚注行（最后一行非空文本），不含行号与换行。
fn tuis_footer_text(out: &Buf) bool {
    buf_reset(out);
    var scr: Buf = buf_new(65536);
    defer { buf_free(&scr); }
    tui_screen_text(&scr);
    var end: usize = scr.len;
    while end > 0 && scr.ptr[end - 1] == 10 as byte {
        end = end - 1;
    }
    if end == 0 {
        return false;
    }
    var start: usize = end;
    while start > 0 && scr.ptr[start - 1] != 10 as byte {
        start = start - 1;
    }
    _ = buf_append(out, scr.ptr + start, end - start);
    return true;
}

// 脚注「cwd 段」占的显示列：跳掉左侧 2 列缩进，量到第一个 ` · ` 分界。
// 返回 false = 这一格没有分界可量（cwd 整段让位那种）。
fn tuis_footer_cwd_cols(cols: &usize) bool {
    var line: Buf = buf_new(4096);
    defer { buf_free(&line); }
    if !tuis_footer_text(&line) {
        return false;
    }
    const p: &const byte = line.ptr as &const byte;
    const sep: usize = tuis_first_at(&line, " · " as &const byte);
    if sep == 0 {
        return false;
    }
    var a: usize = 0;
    while a < sep && p[a] == 32 as byte {
        a = a + 1;
    }
    if a >= sep {
        return false;
    }
    cols[0] = tty_cols_between(p, a, sep);
    return true;
}

// 走 n 步（每步 400 ms = 跨过时间闸门一次），返回末次时刻。
fn tuis_mq_advance(t: u64, n: usize) u64 {
    var now: u64 = t;
    var k: usize = 0;
    while k < n {
        now = now + 400;
        _ = tui_marquee_tick(now);
        k = k + 1;
    }
    return now;
}

// 长路径夹具：74 列的 worktree 形态（尾巴是独一无二的段名，用来判「滚到尾」）。
// 行宽豁免：路径字面量**不可断**（断了就改了被测的输入；Uya 没有相邻字面量拼接）
const TUIS_MQ_CWD: &const byte = "/home/tester/aaaaaaaaaa/bbbbbbbbbb/cccccccccc/dddddddddd/eeeeeeeeee/zzz_tail_dir" as &const byte;
const TUIS_MQ_HOME: &const byte = "/home/tester" as &const byte;
// 同一台机器上另一个 worktree：与上面**同长、前 16 字节逐字节相同**（真 worktree 正是
// 这个形态）—— D 段的复位判据必须在这种夹具上才立得住（见该段注释）。
const TUIS_MQ_WT_A: &const byte = "/home/tester/proj/.git/dsh-worktrees/session-aaaaaaaa" as &const byte;
const TUIS_MQ_WT_B: &const byte = "/home/tester/proj/.git/dsh-worktrees/session-bbbbbbbb" as &const byte;

// 装好长路径夹具（cwd + 分支 + ctx），尺寸与统计由调用方给。
fn tuis_mq_setup_long(cols: usize, rows: usize) void {
    tuis_reset(cols, rows);
    tui_set_cwd(TUIS_MQ_CWD, bufx_cstr_len(TUIS_MQ_CWD),
        TUIS_MQ_HOME, bufx_cstr_len(TUIS_MQ_HOME));
    tui_set_branch("main" as &const byte, 4);
    tui_set_ctx(21);
    tui_build();
}

// A 段：装得下 ⇒ 与 P75 之前逐字节相同，且 tick 是空调用（不置脏）。
fn tuis_mq_leg_a(tag: &const byte, ok: &bool) void {
    var cols: usize = 0;
    tuis_reset(100, 24);
    tui_set_ctx(21);
    tui_build();
    if !tuis_footer_cwd_cols(&cols) || cols != 11 {
        tuis_fail(tag, "短路径（~/proj:main）的 cwd 段不是 11 列", ok);
    }
    var t: u64 = 10000;
    var k: usize = 0;
    while k < 4 {
        t = t + 1000;
        if tui_marquee_tick(t) {
            tuis_fail(tag, "装得下时 tick 仍报「动了」（应为空调用）", ok);
            break;
        }
        k = k + 1;
    }
    tui_build();
    if tui_row_has(tui_nrows() - 1, "…" as &const byte) {
        tuis_fail(tag, "短路径的脚注里出现了 `…`（逐字节不变那条破了）", ok);
    }
}

// B 段：200 列终端上长路径也只占 30 列窗口，尾段不在屏上。
// 返回偏移上限（C 段接着用）。
fn tuis_mq_leg_b(tag: &const byte, ok: &bool) usize {
    var cols: usize = 0;
    tuis_mq_setup_long(200, 30);
    tuis_scan_rows(200, ok, tag);
    if !tuis_footer_cwd_cols(&cols) || cols != TUI_FOOT_WIN {
        tuis_fail(tag, "200 列下 cwd 段没有夹在 30 列", ok);
    }
    if tui_row_has(tui_nrows() - 1, "zzz_tail_dir" as &const byte) {
        tuis_fail(tag, "第一帧就把路径尾部露出来了（窗口没生效）", ok);
    }
    if !tui_row_has(tui_nrows() - 1, "…" as &const byte) {
        tuis_fail(tag, "窗口装不下时脚注没有 `…`（看不出「后面还有」）", ok);
    }
    // 左段（`~` + 去掉 home 的路径 + `:` + 分支）的列数：偏移上限 = 它 - 窗口 + 1
    // 行宽豁免：同上（这一条要逐字节等于脚注左段）
    const left: &const byte = "~/aaaaaaaaaa/bbbbbbbbbb/cccccccccc/dddddddddd/eeeeeeeeee/zzz_tail_dir:main" as &const byte;
    return bufx_cstr_len(left) - TUI_FOOT_WIN + 1;
}

// C 段：时间闸门 → 一列一步 → 端点停留 → 到头归零。maxoff 由 B 段给。
fn tuis_mq_leg_c(tag: &const byte, ok: &bool, maxoff: usize) void {
    var cols: usize = 0;
    var k: usize = 0;
    var t: u64 = 0;
    // 时刻没到：同一毫秒里连推 5 次，一次都不该动
    const t0: u64 = 555000;
    var early: bool = false;
    while k < 5 {
        if tui_marquee_tick(t0) {
            early = true;
        }
        k = k + 1;
    }
    if early {
        tuis_fail(tag, "时钟没走却往前滚了（时间闸门失效）", ok);
    }
    // 走 6 步（1 步认领 + 4 步停留 + 1 步推进）= 偏移 1：前导 `…` 出现、还没到尾
    t = tuis_mq_advance(t0, 6);
    tui_build();
    tuis_scan_rows(200, ok, tag);
    if !tui_row_has(tui_nrows() - 1, "…" as &const byte) {
        tuis_fail(tag, "滚动之后脚注里没有前导 `…`", ok);
    }
    if tui_row_has(tui_nrows() - 1, "zzz_tail_dir" as &const byte) {
        tuis_fail(tag, "才滚 6 步就到尾了（步长不是一列）", ok);
    }
    if !tuis_footer_cwd_cols(&cols) || cols != TUI_FOOT_WIN {
        tuis_fail(tag, "滚动中 cwd 段的宽度跑了（必须恒等于窗口宽）", ok);
    }
    // 一直推到尾部上屏（5×maxoff + 8 步足够走完全程；到不了就是滚不到尾）
    var at_tail: bool = false;
    const push_max: usize = maxoff *% 5;
    const push_lim: usize = push_max +% 8;
    k = 0;
    while k < push_lim {
        t = tuis_mq_advance(t, 1);
        tui_build();
        if tui_row_has(tui_nrows() - 1, "zzz_tail_dir" as &const byte) {
            at_tail = true;
            break;
        }
        k = k + 1;
    }
    if !at_tail {
        tuis_fail(tag, "滚不到尾部（尾段 / 分支永远上不了屏）", ok);
        return;
    }
    // 尾部上屏之后要停满 4 步，第 5 步才归零、路径头部回来。
    // 判据数**步数**而不是算相位：尾段比窗口长时，上屏会发生在到达上限之前。
    var tail_steps: usize = 0;
    var wrapped: bool = false;
    const stay_max: usize = maxoff *% 5;
    const stay_lim: usize = stay_max +% 8;
    k = 0;
    while k < stay_lim {
        t = tuis_mq_advance(t, 1);
        tui_build();
        if tui_row_has(tui_nrows() - 1, "zzz_tail_dir" as &const byte) {
            tail_steps = tail_steps + 1;
        } else {
            wrapped = true;
            break;
        }
        k = k + 1;
    }
    if !wrapped {
        tuis_fail(tag, "滚到尾之后没有归零重来（一直停在尾部）", ok);
    } else if tail_steps < TUI_MQ_HOLD {
        tuis_fail(tag, "尾部停留不足 4 步（端点停留失效，滚得太快）", ok);
    }
}

// D 段：复位。夹具用**兄弟路径**（同长、前 16 字节逐字节相同）—— 跑马灯的「换内容
// 就归零」判据是头部指纹，兄弟路径换过去指纹不变，于是**只有** tui_set_cwd 里那次
// 显式复位能让新路径回到起点。用两条长度/头部都不同的路径测这一条是**假绿**
// （指纹自己就归零了 —— 对照实验④第一版当场绿）。
fn tuis_mq_leg_d(tag: &const byte, ok: &bool) void {
    if bufx_cstr_len(TUIS_MQ_WT_A) != bufx_cstr_len(TUIS_MQ_WT_B) {
        tuis_fail(tag, "复位腿的夹具不成立（两条路径不等长）", ok);
        return;
    }
    tuis_reset(200, 30);
    tui_set_cwd(TUIS_MQ_WT_A, bufx_cstr_len(TUIS_MQ_WT_A),
        TUIS_MQ_HOME, bufx_cstr_len(TUIS_MQ_HOME));
    tui_set_branch("main" as &const byte, 4);
    tui_set_ctx(21);
    tui_build();
    // 前置：A 的尾段必须能被滚上来（否则这一段什么都没测）
    var t: u64 = 300000;
    var k: usize = 0;
    var seen_a: bool = false;
    while k < 300 {
        t = tuis_mq_advance(t, 1);
        tui_build();
        if tui_row_has(tui_nrows() - 1, "session-aaaaaaaa" as &const byte) {
            seen_a = true;
            break;
        }
        k = k + 1;
    }
    if !seen_a {
        tuis_fail(tag, "复位腿的前置不成立（A 的路径尾段没滚上来）", ok);
        return;
    }
    tui_set_cwd(TUIS_MQ_WT_B, bufx_cstr_len(TUIS_MQ_WT_B),
        TUIS_MQ_HOME, bufx_cstr_len(TUIS_MQ_HOME));
    tui_build();
    if !tui_row_has(tui_nrows() - 1, "~/proj/.git/dsh" as &const byte) {
        tuis_fail(tag, "换工作区之后脚注没有从头显示新路径（偏移没复位）", ok);
    }
    if tui_row_has(tui_nrows() - 1, "session-bbbbbbbb" as &const byte) {
        tuis_fail(tag, "换工作区之后偏移接着上一条路径滚", ok);
    }
    tuis_scan_rows(200, ok, tag);
    // 自测复位同理（下一轮不该接着上一轮的偏移）
    tuis_reset(200, 30);
    tui_set_cwd(TUIS_MQ_WT_A, bufx_cstr_len(TUIS_MQ_WT_A),
        TUIS_MQ_HOME, bufx_cstr_len(TUIS_MQ_HOME));
    tui_set_branch("main" as &const byte, 4);
    tui_set_ctx(21);
    tui_build();
    if tui_row_has(tui_nrows() - 1, "session-aaaaaaaa" as &const byte) {
        tuis_fail(tag, "自测复位之后偏移没有归零", ok);
    }
}

// E 段：滚动中排版不变量不破 + 窄终端退化仍归老规则。
fn tuis_mq_leg_e(tag: &const byte, ok: &bool) void {
    var cols: usize = 0;
    var fw: usize = 0;
    var fs: usize = 0;
    var sline: Buf = buf_new(512);
    defer { buf_free(&sline); }
    agent_stats_fixture_demo();
    _ = st_line(&sline);
    tuis_mq_setup_long(200, 30);
    tui_set_stats(sline.ptr as &const byte, sline.len);
    tui_set_cpu(37);
    tui_set_mem(319488);
    betui_add_user("滚动不变量" as &const byte,
        bufx_cstr_len("滚动不变量" as &const byte));
    tui_close_stream_entries();
    tui_build();
    _ = tuis_mq_advance(777000, 10);
    tui_build();
    tuis_scan_rows(200, ok, tag);
    if !tui_row_has(tui_nrows() - 1, "1 轮 · 12 步" as &const byte) {
        tuis_fail(tag, "滚动时把右半区的统计行挤没了", ok);
    }
    if !tuis_footer_tail(&fw, &fs) || fs != 3 {
        tuis_fail(tag, "滚动时脚注不再右对齐到 cols-3", ok);
    }
    if !tuis_footer_cwd_cols(&cols) || cols != TUI_FOOT_WIN {
        tuis_fail(tag, "有统计行时 cwd 段的宽度不是 30 列", ok);
    }
    // 40 列：cwd 整段让位这条退化规则不许被滚动改动
    tuis_mq_setup_long(40, 12);
    tui_set_stats(sline.ptr as &const byte, sline.len);
    tui_set_cpu(37);
    tui_set_mem(319488);
    betui_add_user("改一行" as &const byte, 6);
    tui_close_stream_entries();
    tui_build();
    tuis_scan_rows(40, ok, tag);
    if tui_row_has(tui_nrows() - 1, "~/aa" as &const byte) {
        tuis_fail(tag, "40 列下 cwd 该整段让位（滚动不该改这条规则）", ok);
    }
}

// F 段：真心跳接线 —— 只走 tui_tick，一次都不直接调 tui_marquee_tick。
//
// 这一段是**三次假绿**教出来的，每次都得换判据才立住 —— 记下来因为这一类太容易重犯：
//   ① C 段里自测自己调 tick ⇒ 「心跳那一行忘了接」照样全绿；改成只走 tui_tick 才红。
//   ② 判据当时每拍都自己调 `tui_build()` 重画 ⇒ **绕过 `tui_render()` 的脏闸门**：
//      漏掉 `tui_mark_dirty()` 时偏移在内存里照样涨、`tui_build` 画出来也对，可生产路径
//      上 `tui_render()` 看见 `g_tui_dirty == false` 当场早退 ⇒ **真机上路径夹到 30 列却
//      一个字节都不滚**（用户报「我验证了不会滚动」；真 PTY A/B：25 秒末行纹丝不动）。
//   ③ 改成「只认心跳画的那一帧」+「帧数必须涨」还不够：心跳里**还有 procx 采样与任务块**
//      那两路，它们本来就出帧，噪声把「这一路没置脏」盖住了 —— 把 mark_dirty 摘掉重编，
//      这一段照样全绿。所以硬判据只能是**脏位本身**（`tui_dirty_pending()`）：
//      「偏移推进了」与「有一帧等着画」必须同时成立。
fn tuis_mq_leg_f(tag: &const byte, ok: &bool) void {
    var k: usize = 0;
    tuis_mq_setup_long(200, 30);
    tui_headless_enable(true);       // tui_tick 要 g_tui_on 为真；渲染走 tui_render
    var hb: u64 = 900000;
    // 头两拍（认领 + 停留）：尾部不许上来。读屏**不重建**（见上面 ②）
    _ = tui_tick(hb);
    hb = hb + 400;
    _ = tui_tick(hb);
    if tui_row_has(tui_nrows() - 1, "zzz_tail_dir" as &const byte) {
        tuis_fail(tag, "心跳刚开始就把尾部露出来了（端点停留失效）", ok);
    }
    // 只走心跳：300 拍内尾部必须出现在**心跳自己画的那一帧**上
    var hb_tail: bool = false;
    while k < 300 {
        hb = hb + 400;
        _ = tui_tick(hb);
        if tui_row_has(tui_nrows() - 1, "zzz_tail_dir" as &const byte) {
            hb_tail = true;
            break;
        }
        k = k + 1;
    }
    if !hb_tail {
        tuis_fail(tag, "只走心跳滚不到尾部（tui_tick 没接上滚动？）", ok);
    }
    tuis_scan_rows(200, ok, tag);

    // ③ 脏位硬断言（这一段的真判据，见上面 ③）：先画一帧把脏位收掉，再推进一拍，
    // 「偏移动了」与「脏位置起了」必须同时成立。漏 `tui_mark_dirty()` 时后者为假。
    tui_render();
    var rolled: bool = false;
    var dirtied: bool = false;
    k = 0;
    while k < 8 && !rolled {
        hb = hb + 400;
        // 只看这一路：tui_marquee_tick 自己的返回值 + 它留下的脏位
        rolled = tui_marquee_tick(hb);
        k = k + 1;
    }
    dirtied = tui_dirty_pending();
    if !rolled {
        tuis_fail(tag, "前置不成立：8 拍内这一格没推进（判据无从谈起）", ok);
    } else if !dirtied {
        tuis_fail(tag, "偏移动了却没置脏（漏了 tui_mark_dirty —— 真机上就是不滚）", ok);
    }

    // 反向断言：装得下时这一格不参与滚动（判据用返回值，不数帧数 —— 心跳里还有
    // procx 采样与任务块两路会出帧，数帧数会把它们算进来）
    tuis_reset(200, 30);
    tui_set_cwd("/home/tester/proj" as &const byte, 17,
        TUIS_MQ_HOME, bufx_cstr_len(TUIS_MQ_HOME));
    tui_set_branch("main" as &const byte, 4);
    tui_set_ctx(21);
    tui_render();                    // 先画一帧，把这一格的 maxoff 落定
    k = 0;
    var rolled_short: bool = false;
    while k < 6 {
        hb = hb + 400;
        if tui_marquee_tick(hb) {
            rolled_short = true;
            break;
        }
        k = k + 1;
    }
    if rolled_short {
        tuis_fail(tag, "装得下时仍在滚（短路径不该参与滚动）", ok);
    }
    tui_headless_enable(false);
}

// 逐级建目录（`sess_mkdir_p` 的薄封装，语义见它的注释）。G 段要一条**多级**长路径，
// `ws_prepare` 只建最末一级。
fn tuis_mkdir_p(path: &const byte) bool {
    return sess_mkdir_p(path);
}

// G 段：**真 PTY** 端到端 —— 用户报「我验证了不会滚动」那一幕的机器判据。
//
// 为什么非要有这一段（而不是 F 段就够）：headless 下 `tui_flush` 因为 `out_fd < 0`
// **当场早退**，`g_tui_dirty` 于是**永远清不掉** —— 任何「脏位」判据在 headless 里都
// 恒为真、全是假绿。F 段那三条判据先后都在这里栽过（本轮实测：把 `tui_mark_dirty()`
// 摘掉重编，F 段照样全绿）。只有真 PTY（真 fd、真 flush、真脏闸门）才看得见
// 「偏移动了但一帧都没画」。
//
// 判据：起一个真 TUI 子进程，工作区给一条长路径，然后**只收帧、不按键**，
// 隔一段时间取末行 —— 末行文本必须随时间**变化**（滚动），且变化只能来自窗口左移
// （路径尾段先不出现，最后才出现）。
fn tuis_mq_leg_g(tag: &const byte, ok: &bool) void {
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    // 长工作区（比 30 列窗口长得多，且尾段独一无二）。
    // 必须逐级 mkdir：`ws_prepare` 只建**最末一级**，中间目录不存在时子进程的 chdir
    // 会失败并退回进程 cwd ⇒ 那这条腿测就成了「仓库根路径」（实测就是这样：滚是滚了，
    // 但断言里那个 `long/workspace` 永远不出现）。
    const ws: &const byte = "build/selftest_mq_pt/g/g/very/long/workspace/tail_dir" as &const byte;
    if !tuis_mkdir_p(ws) {
        tuis_fail(tag, "长工作区准备失败", ok);
        return;
    }
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 200, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    }
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    };
    if cpid64 == 0 {
        // 与 tui-mouse 那条腿同一个子进程入口（真 tui + 真 fd），只是工作区更长
        tuis_child_run_tui_mouse(&slave_path, port, ws, true);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    // 首帧：脚注应当已经被 30 列窗口夹住（长路径 ⇒ 尾段不在屏上、带 `…`）
    tuis_drain(m, &cap, 30);
    if !tuis_has(&cap, "…" as &const byte) {
        tuis_fail(tag, "真 PTY 首帧里没有 `…`（窗口没生效？）", ok);
    }
    // 只收帧、不按键：**等路径后段滚上来**（`tuis_drain_until`，不是固定睡一段 ——
    // 固定睡会与节奏耦合：第一版停留加在每一列之后时 2 秒才走一列，睡 3 秒只挪 5 列，
    // 断言「看到后段」就红；那是节奏的账，不该由这段的睡眠时长来背）。
    if !tuis_drain_until(m, &cap, "long/workspace" as &const byte, 12000) {
        tuis_fail(tag, "真 PTY 里路径后段一直没滚上来（不滚 / 滚得太慢）", ok);
    }
    // 再确认它确实在动：这一段的字节数必须比首帧之后涨了（真有重画）
    if !tuis_has(&cap, "tail_dir" as &const byte) {
        tuis_fail(tag, "真 PTY 里滚到尾部也没露出路径末段", ok);
    }
    // 反向：滚过之后头部的段名应当已经被吃掉（窗口左移了，而不是整条都在）
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 20000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
}

// tui-marquee 轮：七段各管一件事，任一段红就置 ok=false（跑完全部，不早退）。
fn tui_marquee_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_mq_leg_a(tag, &ok);
    const maxoff: usize = tuis_mq_leg_b(tag, &ok);
    tuis_mq_leg_c(tag, &ok, maxoff);
    tuis_mq_leg_d(tag, &ok);
    tuis_mq_leg_e(tag, &ok);
    tuis_mq_leg_f(tag, &ok);
    tuis_mq_leg_g(tag, &ok);
    if ok {
        tuis_ok(tag, "放不下的文本滚动显示：装得下逐字节不变 / 30 列窗口 / 一步一列与端点停留 / 到头归零 / 兄弟路径复位 / 排版不变量与窄终端退化不破 / 心跳置脏 / 真 PTY 三秒内末行真的变了");
    }
    return ok;
}
// ============================================================
// tui-paste（P50）：括起粘贴（bracketed paste）+ 输入上限
// 本轮钉住的缺陷（踩坑 81）：`tui_esc_final` 在**内部**把状态置成 5（粘贴中）之后，
// 两个调用点又各补了一句无条件 `g_tui_esc = 0` —— 粘贴态被当场冲掉，`ESC[200~` 从来没
// 生效过。症状是粘多行时 CR 变成回车**逐行提交**（粘 3 行 → 提交 3 次），TAB 变成
// plan 模式开关。LF 恰好与裸 LF 等价，所以老自测（喂 LF）一直是绿的。
//
// 为什么这些断言现在才有意义：修好之前，凡是「粘贴里出现控制字节」的用例在真机上
// 都走不到 —— 状态早被冲掉了。
// ============================================================
fn tui_paste_round(tag: &const byte) bool {
    var ok: bool = true;
    const on: &const byte = "\x1b[200~" as &const byte;
    const off: &const byte = "\x1b[201~" as &const byte;
    // 「PASTE-L1\nPASTE-L2\nPASTE-L3」在**会话日志里**的转义形式：JSON 把换行写成
    // `\` + `n` 两个字符，所以是 28 字节（8+2+8+2+8）。函数内 const 才不会把
    // 数组推断成 int32（模块级 const 会，见上面的编译错误）。
    // 「(输入已达上限 」的 UTF-8 字节（数组字面量，避免「切片描述符 → char*」强转，
    // 见 §16 踩坑 22 与 Makefile 的 codegen-audit）
    const over_lit: [byte: 20] = [
        40, 232, 190, 147, 229, 133, 165, 229, 183, 178, 232, 190, 190, 228, 184, 138, 233, 153, 144, 32
    ];

    // ---- A) 基本：括起粘贴里的 LF 多行 → 一次提交、内容逐字节 ----
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("A1\nA2\nA3" as &const byte, 8);
    tui_keys_inject(off, 6);
    if !tuis_in_is("A1\nA2\nA3" as &const byte) {
        tuis_fail(tag, "括起粘贴里的 LF 多行没有原样进输入行", &ok);
    }
    // 粘贴里**不许**有回车提交（旧实现这里会拿到提交）
    if tui_has_submit() {
        tuis_fail(tag, "括起粘贴把内容当成提交了（粘贴态被冲掉）", &ok);
    }

    // ---- B) CR 不许提交：粘贴态生效的核心判据 ----
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("A1\rA2" as &const byte, 5);
    if tui_has_submit() {
        tuis_fail(tag, "粘贴里的 CR 被当成了回车提交（踩坑 83 的原始症状）", &ok);
    }
    tui_keys_inject(off, 6);
    if !tuis_in_is("A1\nA2" as &const byte) {
        tuis_fail(tag, "粘贴里的 CR 没有折成换行", &ok);
    }

    // ---- C) CRLF 折叠成一个换行（Windows 剪贴板 / 部分终端的形状）----
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("W1\r\nW2\r\nW3" as &const byte, 10);
    tui_keys_inject(off, 6);
    if !tuis_in_is("W1\nW2\nW3" as &const byte) {
        tuis_fail(tag, "CRLF 没有折成一个换行（会一行变两行）", &ok);
    }

    // ---- D) TAB 是字面内容，不是 plan 模式开关 ----
    tuis_reset(100, 30);
    const plan_before: bool = tui_plan_on();
    tui_keys_inject(on, 6);
    tui_keys_inject("\t" as &const byte, 1);
    tui_keys_inject(off, 6);
    if tui_plan_on() != plan_before {
        tuis_fail(tag, "粘贴里的 TAB 切换了计划模式（应当是字面内容）", &ok);
    }
    if tui_input_len() != 1 || tui_input_text().ptr[0] != 9 as byte {
        tuis_fail(tag, "粘贴里的 TAB 没有原样进输入缓冲", &ok);
    }
    // 但**输入缓冲**是原样字节、**帧里**不许出现 TAB（TAB 会让列宽算错）
    // （headless 下 tui_render 直接返回，重排必须走 tui_build）
    tui_build();
    if tui_rows_have_esc() {
        tuis_fail(tag, "粘贴 TAB 之后正文层出现了 ESC", &ok);
    }
    var tab_row: Buf = buf_new(4096);
    defer { buf_free(&tab_row); }
    var found_tab: bool = false;
    var rr: usize = 0;
    while rr < tui_nrows() {
        buf_reset(&tab_row);
        tui_row_text(rr, &tab_row);
        var bb: usize = 0;
        while bb < tab_row.len {
            if tab_row.ptr[bb] == 9 as byte {
                found_tab = true;
            }
            bb = bb + 1;
        }
        rr = rr + 1;
    }
    if found_tab {
        tuis_fail(tag, "TAB 字节直接上屏了（列宽会错，必须清洗成空格）", &ok);
    }

    // ---- E) 粘贴里的 ESC 序列逐字节保留（不许吞内容）----
    // 旧实现把 `ESC[31m` 里的数字丢了（它复用 CSI 参数累加器，分不清 31 和 201）。
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("x \x1b[31mR\x1b[0m y" as &const byte, 14);
    tui_keys_inject(off, 6);
    if !tuis_in_is("x \x1b[31mR\x1b[0m y" as &const byte) {
        tuis_fail(tag, "粘贴里的 ESC 序列没有逐字节保留（旧实现在这里丢数字）", &ok);
    }

    // ---- F) 粘贴收尾标记被切开也认（真终端会分片）----
    // 注意长度：`"\x1b[20"` 是 **4** 个字节（ESC [ 2 0）—— 手写长度写大一个字节会
    // 把 NUL 也喂进去（§16 踩坑 77 同族）。
    tuis_reset(100, 30);
    tui_keys_feed(on, 6);
    tui_keys_feed("S1" as &const byte, 2);
    tui_keys_feed("\x1b[20" as &const byte, 4);
    if !tuis_in_is("S1" as &const byte) {
        tuis_fail(tag, "粘贴收尾序列被切开时内容被提前改动了", &ok);
    }
    tui_keys_feed("1~" as &const byte, 2);
    tui_key_flush_esc();
    tui_handle_keys();
    // 收尾标记收全 → 粘贴态结束；再来的普通字节按普通按键走（不许还留在粘贴里）
    tui_keys_inject("Z" as &const byte, 1);
    if !tuis_in_is("S1Z" as &const byte) {
        tuis_fail(tag, "粘贴收尾标记被切开后没有正确收尾", &ok);
    }

    // ---- G) 结尾悬着 ESC（buffer 正好断在 ESC 上）不许吞字节 ----
    tuis_reset(100, 30);
    tui_keys_feed(on, 6);
    tui_keys_feed("E1" as &const byte, 2);
    tui_keys_feed("\x1b" as &const byte, 1);
    tui_key_flush_esc();
    tui_handle_keys();
    if !tuis_in_is("E1\x1b" as &const byte) {
        tuis_fail(tag, "粘贴末尾悬着的 ESC 被吞了（断流时应当吐回内容）", &ok);
    }

    // ---- H) 上限：超限要提示、且不静默丢（对齐 MSG_CONTENT_MAX）----
    // 每次只喂 400 字节：`tui_key_feed` 每次调用最多产出「1 字节 1 事件」，
    // 而事件队列 TUI_EVQ_MAX = 512（真实读键的 sys_read 上限同样是 512，两者本来就配套）。
    // 一次喂 4096 会先在队列上截掉（这是**测试**的喂法不真实，不是产品缺陷）。
    tuis_reset(100, 30);
    var chunk: Buf = buf_new(512);
    defer { buf_free(&chunk); }
    var ci: usize = 0;
    while ci < 400 {
        _ = buf_append_byte(&chunk, 97);   // 'a'
        ci = ci + 1;
    }
    var sent: usize = 0;
    var over_notice: bool = false;
    while sent < 200400 {
        const before: usize = tui_input_len();
        tui_keys_inject(chunk.ptr as &const byte, chunk.len);
        sent = sent + chunk.len;
        if tui_input_len() == before {
            // 已经到顶：找那条 notice（走屏幕文本，与「用户看得见」同口径）。
            // 用 tui_build() 而不是 tui_render()：后者在 headless（g_tui_on=false）下
            // 直接返回，什么都不会重排。
            tui_build();
            var scr: Buf = buf_new(65536);
            defer { buf_free(&scr); }
            tui_screen_text(&scr);
            if find_sub(scr.ptr[0: scr.len], &over_lit[0: 20], 0) >= 0 {
                over_notice = true;
            }
            break;
        }
    }
    if tui_input_len() != 200000 {
        tuis_fail(tag, "输入上限不是 MSG_CONTENT_MAX（200000）—— 与入史上限脱钩", &ok);
    }
    if !over_notice {
        tuis_fail(tag, "输入到上限时没有提示（旧实现是静默丢弃）", &ok);
    }
    // 超限之后输入行仍然是合法内容（不是半截 UTF-8 / 不是垃圾）
    if tui_input_text().ptr[0] != 97 as byte {
        tuis_fail(tag, "到达上限后输入内容被破坏", &ok);
    }

    // ---- I) 光标列按显示口径（TAB 四个空格）----
    // 必须走**粘贴**那条路进：裸 TAB 是 plan 模式开关（键位口径不变），
    // 只有粘贴进来的 TAB 才是字面内容。
    tuis_reset(100, 30);
    tui_keys_inject(on, 6);
    tui_keys_inject("ab\t" as &const byte, 3);
    tui_keys_inject(off, 6);
    if !tuis_in_is("ab\t" as &const byte) {
        tuis_fail(tag, "粘贴里的 TAB 没有进输入缓冲", &ok);
    }
    var cl: usize = 0;
    var cc: usize = 0;
    tui_input_cursor_line_col(&cl, &cc);
    if cl != 0 || cc != 6 {
        tuis_fail(tag, "TAB 之后光标列没按显示口径算（应当 2+4=6）", &ok);
    }

    // ---- J) 真 PTY：粘 3 行（CR 分隔）必须只提交**一次** ----
    // 这是踩坑 81 的真机判据：修前 CR 被当成回车逐行提交（粘 3 行 → 3 条 user 消息）。
    // 与 `tui-pty` 同一条路：真 /dev/ptmx + fork + 真实按键字节（不经注入钩子）。
    if !tui_paste_pty_case(tag, &ok) {
        ok = false;
    }

    return ok;
}

// 取目录里第一个**非隐藏**条目的完整路径（P49 的会话日志定位用）。
// 为什么不用 sess_find_last：那条路要 index.jsonl，而索引是 sess_close 写的。
fn tui_paste_first_dir(dir: &const Buf, out: &Buf) bool {
    var dz: Buf = buf_new(dir.len + 2);
    defer { buf_free(&dz); }
    _ = buf_append(&dz, dir.ptr as &const byte, dir.len);
    _ = buf_append_byte(&dz, 0);
    const dp: &DIR = opendir(&dz.ptr[0] as *const byte);
    if dp == null {
        return false;
    }
    defer { _ = closedir(dp); }
    while true {
        const de: &Dirent = readdir(dp);
        if de == null {
            return false;
        }
        var nm: Buf = buf_new(272);
        defer { buf_free(&nm); }
        if !buf_append_cstr(&nm, &de.d_name[0] as &const byte) {
            continue;
        }
        if nm.len == 0 || nm.ptr[0] == 46 as byte {
            continue;   // 跳过 "." / ".." 与隐藏项
        }
        buf_reset(out);
        _ = buf_append(out, dir.ptr as &const byte, dir.len);
        _ = buf_append_byte(out, 47);
        _ = buf_append(out, nm.ptr as &const byte, nm.len);
        return true;
    }
}

// 粘贴轮失败时把「日志里到底有什么」写进诊断文件。
//
// 断言只说「没有那条三行合一的消息」，可原因有好几种（找不到文件 / 有多条 / 正文被
// 转义成别的样子），而客机上没有 `python3`，也没法把屏幕上的字认准 —— 于是把
// 条数、正文命中与否、文件长度、路径都落盘，回传一次日志就能定性。
fn tui_paste_diag(nmsg: usize, body: bool, len: usize, logp: &const Buf) void {
    var b: Buf = buf_new(1400);
    defer { buf_free(&b); }
    _ = buf_append_cstr(&b, "paste-log: nmsg=");
    _ = buf_append_u64(&b, nmsg as u64);
    _ = buf_append_cstr(&b, " body=");
    if body {
        _ = buf_append_cstr(&b, "1");
    } else {
        _ = buf_append_cstr(&b, "0");
    }
    _ = buf_append_cstr(&b, " len=");
    _ = buf_append_u64(&b, len as u64);
    _ = buf_append_cstr(&b, " path=");
    if logp.len > 0 {
        _ = buf_append(&b, logp.ptr as &const byte, logp.len);
    } else {
        _ = buf_append_cstr(&b, "(none)");
    }
    _ = buf_append_cstr(&b, "\n");
    // 落盘（客户机上没 python3 时靠它）+ 同时打 fd 2。
    // 打 fd 2 这条是给 CI 用的：GitHub 的 job 日志只收 stdout/stderr，盘上的文件
    // 随 runner 一起没了 —— run #8 在 arm64 上红在本轮，可证据只落进了那个文件，
    // 日志里只剩一句「没有那条三行合一的 user 消息」，白跑一轮。
    const dp: &const byte = "selftest_pty_diag.txt" as &const byte;
    const f: i32 = sys_open(dp as *const byte, TUIS_O_DIAG, 420) catch { -1; };
    if f >= 0 {
        _ = sys_write(f, b.ptr as *const byte, b.len) catch {};
        _ = sys_close(f) catch {};
    }
    _ = sys_write(2, b.ptr as *const byte, b.len) catch {};
}

// 真 PTY：粘贴 3 行必须合成**一条**消息（走会话日志断言，不看屏幕）。
fn tui_paste_pty_case(tag: &const byte, ok: &bool) bool {
    var good: bool = true;
    const paste_body: [byte: 28] = [
        80, 65, 83, 84, 69, 45, 76, 49, 92, 110, 80, 65, 83, 84, 69, 45, 76, 50, 92, 110, 80, 65, 83, 84, 69, 45, 76, 51
    ];
    const wsdir: &const byte = "build/selftest_ws_paste" as &const byte;
    if !ws_prepare(wsdir) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return false;
    }
    // 独立的 agent home：按会话日志断言时不能被别的轮次留下的日志盖住
    const phome: &const byte = "build/selftest_agent_home_paste" as &const byte;
    // 每轮**整棵删掉**再重建（踩坑 133）。只清 `sessions/` 不够：这一轮自己会种下
    // 两路残留，下一次运行就被自己的上一轮打红 ——
    //   A) `sessions/<cwd>/<id>/session.jsonl` 越堆越多，而下面 `tui_paste_first_dir`
    //      取的是 `readdir` 的**第一个**条目（ext4 哈希序，不是最新）⇒ 取到旧的那份，
    //      日志里自然没有那三行 ⇒ 报「没有那条三行合一的 user 消息」；
    //   B) 绿的那一次把 `bash echo SELFTEST-SHELL-OK; pwd` 摄进
    //      `memory/<repo-key>/obs/*.jsonl`，下一次 `agent_pm_inject` 把开工包当
    //      **ROLE_USER** 消息压进历史，TUI 就照用户条目的样子画出一个 `▎ 你` ⇒
    //      下面「粘贴不许提交」那条断言命中的是它，报成「CR 被当成了回车提交」。
    // 返回值忽略：目录不存在返回 false，正是我们要的「已经是干净的」。
    _ = pm_rm_rf(phome, bufx_cstr_len(phome));
    _ = sys_mkdir(phome as *const byte, 493 as u32) catch {};
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return false;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return false;
    }
    tuis_reset(100, 30);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork 失败", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return false;
    };
    if cpid64 == 0 {
        tuis_child_run_tui_paste(&slave_path, port, wsdir, phome);
        sys_exit(3);
        return false;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(131072);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 8);
    // 绊线（踩坑 133）：全新子进程的**启动屏**上不该有用户条目 —— 有就说明夹具 home
    // 又脏了（记忆开工包会被当 user 消息回放，见上面 phome 那段）。这一条只当绊线用：
    // 子进程画得慢时捕获里没这个标记，照样过；一旦出现，失败文案自己指出根因，
    // 不必再让人从「CR 被当成了回车提交」反推。
    if tuis_has(&cap, "▎ 你" as &const byte) {
        tuis_fail(tag, "真 PTY：启动屏上就有用户条目（夹具 home 有残留：记忆开工包被回放）", ok);
        good = false;
    }
    // 括起粘贴三行（**CR 分隔**：真实剪贴板里 CR 与 CRLF 都常见，LF 那条老自测已覆盖）
    const paste: &const byte = "\x1b[200~PASTE-L1\rPASTE-L2\rPASTE-L3\x1b[201~" as &const byte;
    tuis_write_master(m, paste, bufx_cstr_len(paste));
    tuis_drain(m, &cap, 8);
    // 粘贴**本身不许提交**：屏幕上还该是输入面板（没有用户条目「▎ 你」）
    if tuis_has(&cap, "▎ 你" as &const byte) {
        tuis_fail(tag, "真 PTY：粘贴里的 CR 被当成了回车提交（踩坑 83 的原始症状）", ok);
        good = false;
    }
    // 再单独敲一次回车 → 提交。
    // 等的是**用户条目上屏**（`▎ 你`）：那才是「提交真的发生了」的证据。
    // 等 "PASTE-L3" 不行 —— 粘贴刚落进输入行时它就在屏幕上了，那只是回显。
    tuis_write_master(m, "\r" as &const byte, 1);
    if !tuis_drain_until(m, &cap, "▎ 你" as &const byte, 5000) {
        tuis_fail(tag, "真 PTY：回车之后没有出现用户条目（粘贴内容没提交）", ok);
        tuis_dump_tail(&cap, 700);
        good = false;
    }
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 15000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
    // 子进程是怎么退的也是证据：arm64 上「一条消息都没有」既可能是粘贴没进 TUI，
    // 也可能是子进程半路崩了。status 打进 fd 2（CI 只收 stdout/stderr）。
    var sb: Buf = buf_new(64);
    defer { buf_free(&sb); }
    _ = buf_append_cstr(&sb, "paste-child: status=");
    _ = buf_append_i64(&sb, stt as i64);
    _ = buf_append_cstr(&sb, "\n");
    _ = sys_write(2, sb.ptr as *const byte, sb.len) catch {};
    // 会话日志：**恰好一条** user 消息，且正文是三行合一。
    //
    // 不走 `sess_find_last`：它读 `index.jsonl`，而索引是 `sess_close` 才写的 ——
    // 这一轮对子进程发的是 SIGKILL，索引根本不存在。所以直接按
    // `<home>/sessions/<cwd-dir>/<session-dir>/session.jsonl` 三级目录找。
    //
    // 两处长度都不许手写（本轮实测两次踩同一个坑，见 §16 踩坑 77）：
    //   * `"type":"user/message"` 是 21 字节（写成 23 就整段匹配不上）；
    //   * 正文在日志里是**转义后**的形式（换行 = `\` + `n` 两个字符，共 28 字节）。
    var found: bool = false;
    var extra: bool = false;
    // 失败时的证据（macOS 上没有 python3 也没有 `file`，屏幕 OCR 又不可靠 —— 只能自己写盘）
    var dbg_nmsg: usize = 0;
    var dbg_body: bool = false;
    var dbg_len: usize = 0;
    var dbg_log: Buf = buf_new(1200);
    defer { buf_free(&dbg_log); }
    var sessions_dir: Buf = buf_new(512);
    defer { buf_free(&sessions_dir); }
    _ = buf_append_cstr(&sessions_dir, phome);
    _ = buf_append_cstr(&sessions_dir, "/sessions");
    var level2: Buf = buf_new(1024);
    defer { buf_free(&level2); }
    if tui_paste_first_dir(&sessions_dir, &level2) {
        var level3: Buf = buf_new(1024);
        defer { buf_free(&level3); }
        if tui_paste_first_dir(&level2, &level3) {
            var logp: Buf = buf_new(1200);
            defer { buf_free(&logp); }
            _ = buf_append(&logp, level3.ptr as &const byte, level3.len);
            _ = buf_append_cstr(&logp, "/session.jsonl");
            _ = buf_append_byte(&logp, 0);
            buf_reset(&dbg_log);
            _ = buf_append(&dbg_log, logp.ptr as &const byte, logp.len - 1);
            if sess_file_exists(logp.ptr as &const byte) {
                var rd: SessReader = sess_reader_empty();
                defer { sess_reader_free(&rd); }
                if sess_reader_load(logp.ptr as &const byte, &rd) && rd.data.len > 0 {
                    var nmsg: usize = 0;
                    const lit: &const byte = "\"type\":\"user/message\"" as &const byte;
                    const lit_n: usize = bufx_cstr_len(lit);
                    var scan: usize = 0;
                    while scan + lit_n <= rd.data.len {
                        if bufx_mem_eq(rd.data.ptr + scan, lit, lit_n) {
                            nmsg = nmsg + 1;
                        }
                        scan = scan + 1;
                    }
                    const has_body: bool = find_sub(rd.data.ptr[0: rd.data.len], &paste_body[0: 28], 0) >= 0;
                    if nmsg == 1 && has_body {
                        found = true;
                    }
                    dbg_nmsg = nmsg;
                    dbg_body = has_body;
                    dbg_len = rd.data.len;
                    if nmsg > 1 {
                        extra = true;
                    }
                }
            }
        }
    }
    if extra {
        tuis_fail(tag, "真 PTY：粘贴 3 行变成了多条 user 消息（CR 提交没被按住）", ok);
        good = false;
    } else if !found {
        tuis_fail(tag, "真 PTY：会话日志里没有那条三行合一的 user 消息", ok);
        good = false;
        tui_paste_diag(dbg_nmsg, dbg_body, dbg_len, &dbg_log);
    }
    return good;
}

// tui-mouse 轮：鼠标上报开关（默认开、set_mouse 翻转、同值幂等）+ 真 PTY 里滚轮/点击事件
// 被解码。返回 false = 本轮红；PTY 那条腿自己在子进程里跑。
fn tui_mouse_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- A) 标志位：默认开；set_mouse 翻转；同值幂等 ----
    tuis_reset(100, 30);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "默认应当是开（滚轮依赖它）", &ok);
    }
    tui_set_mouse(false);
    if tui_mouse_enabled() {
        tuis_fail(tag, "tui_set_mouse(false) 没把状态翻过去", &ok);
    }
    tui_set_mouse(false);   // 幂等：不应崩、也不应再写序列
    if tui_mouse_enabled() {
        tuis_fail(tag, "tui_set_mouse(false) 重复调用把状态翻成了开", &ok);
    }
    tui_set_mouse(true);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "tui_set_mouse(true) 没把状态翻回来", &ok);
    }

    // ---- B) F2（两种编码）都翻转状态 ----
    tuis_reset(100, 30);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "F2 用例前置：默认应是开", &ok);
    }
    tui_keys_inject("\x1bOQ" as &const byte, 3);        // F2（SS3 形态）
    if tui_mouse_enabled() {
        tuis_fail(tag, "F2（ESC O Q）没有关掉鼠标上报", &ok);
    }
    tui_keys_inject("\x1bOQ" as &const byte, 3);        // 再按一次开回来
    if !tui_mouse_enabled() {
        tuis_fail(tag, "F2 第二下没有开回来", &ok);
    }
    tui_keys_inject("\x1b[12~" as &const byte, 5);      // F2（CSI 形态）
    if tui_mouse_enabled() {
        tuis_fail(tag, "F2 的 CSI 形态（ESC[12~）没有关掉鼠标上报", &ok);
    }
    // 翻回来后别让这一轮的状态漏给下一段
    tui_set_mouse(true);

    // ---- C) 命令：/mouse off / on / 裸 / 非法取值 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);   // agent_cmd_display 先看 tui_active()（滚动模式只回一行说明）
    var line: Buf = buf_new(64);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "/mouse off");
    agent_cmd_display(&line, 0);
    if tui_mouse_enabled() {
        tuis_fail(tag, "/mouse off 没有关掉鼠标上报", &ok);
    }
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/mouse on");
    agent_cmd_display(&line, 0);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "/mouse on 没有开回来", &ok);
    }
    // 非法取值：状态不许被改（默认还是开）
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/mouse bogus");
    agent_cmd_display(&line, 0);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "/mouse bogus 把状态改掉了（非法取值应当只报错）", &ok);
    }

    // ---- D) 字节级：真写进 pipe，开/关的序列逐字节 ----
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "pipe2 失败（字节级那条腿没跑成）", &ok);
        tui_reset_all();
        tui_headless_enable(true);
        tui_set_size(100, 30);
        return ok;
    }
    var cap: Buf = buf_new(4096);
    defer { buf_free(&cap); }

    // D1) 默认开：tui_term_enter 必须发 1000h + 1006h
    tuis_reset(100, 30);
    tui_set_mouse(true);
    tui_term_enter(fds[1]);
    tuis_mouse_enter(fds[0], &cap);
    if !bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "开鼠标时 tui_term_enter 没发 1000h", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "开鼠标时 tui_term_enter 没发 1006h", &ok);
    }

    // D2) 运行中关：立刻写 1006l + 1000l
    tui_set_mouse(false);
    tuis_mouse_enter(fds[0], &cap);
    if !bufx_contains(&cap, "\x1b[?1006l" as &const byte) {
        tuis_fail(tag, "运行中关鼠标没有写 1006l", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1000l" as &const byte) {
        tuis_fail(tag, "运行中关鼠标没有写 1000l", &ok);
    }
    if bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "运行中关鼠标却又写了 1000h", &ok);
    }

    // D3) 运行中再开：写 1000h + 1006h
    tui_set_mouse(true);
    tuis_mouse_enter(fds[0], &cap);
    if !bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "运行中再开鼠标没有写 1000h", &ok);
    }

    // D3c) P85：**按住拖动**必须被认成拖选事件（真机形状的钉子）。
    // 真机实测（deepin-terminal 6.5.21 / QTermWidget，xdotool 驱动）：只开 `?1000h`
    // 就会送来 `ESC[<32;x;yM`（bit5 = 32 = 拖动）—— 老实现把 b < 64 的**一律丢弃**，
    // 于是拖选期间屏幕上什么都不动（踩坑 72 的现场）。这一条钉住那个分支不被改回去。
    tuis_reset(100, 30);
    tui_key_reset();
    // 用 `tui_key_feed`（只解码）而不是 inject（解码 + 派发）：这一节断言的是
    // 「解出来是什么事件」，派发一趟会把队列取空（实测第一版全红就是这个原因）。
    tui_key_feed("\x1b[<0;10;5M" as &const byte, 11);    // 按下
    tui_key_feed("\x1b[<32;12;5M" as &const byte, 12);   // 拖动（bit5）
    tui_key_feed("\x1b[<0;14;5m" as &const byte, 11);    // 抬起（'m'）
    if tui_key_next() != TUI_K_MOUSE_PRESS {
        tuis_fail(tag, "左键按下没有变成 PRESS（拖选的起点丢了）", &ok);
    }
    if tui_key_next() != TUI_K_MOUSE_DRAG {
        tuis_fail(tag, "按住拖动（b=32）没有被认成拖选（老实现就是在这里丢弃的）", &ok);
    }
    if tui_key_next() != TUI_K_MOUSE_RELEASE {
        tuis_fail(tag, "左键抬起没有变成 RELEASE（拖选收不了尾）", &ok);
    }
    // 拖选事件**不许**进输入行（与滚轮同一条纪律）
    if tui_input_len() != 0 {
        tuis_fail(tag, "拖选事件漏进了输入行", &ok);
    }
    // 滚轮口径一个字节不变：64/65 仍是轮上/轮下，且不带坐标
    tui_key_reset();
    tui_key_feed("\x1b[<64;10;5M" as &const byte, 12);
    if tui_key_next() != TUI_K_WHEEL_UP {
        tuis_fail(tag, "滚轮上（64）被拖选改动带歪了", &ok);
    }

    // D3b) 帮助浮层里必须写清这个出口（改了 help 文案就要钉住，否则以后又悄悄丢）
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    tui_help_open();
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "/help 没有开出帮助浮层", &ok);
    } else {
        tui_build();
        if !tuis_screen_has("F2 切换鼠标上报" as &const byte) {
            tuis_fail(tag, "帮助浮层里没有 F2 切换鼠标上报那一条（用户找不到出口）", &ok);
        }
    }
    tui_overlay_close();
    tuis_reset(100, 30);
    tui_set_mouse(true);
    tui_term_enter(fds[1]);
    tuis_mouse_enter(fds[0], &cap);

    // D4) **关着进 TUI**：tui_term_enter 一个鼠标字节都不许发（这是「启动就能拖选」
    //     的关键 —— 若这里仍按默认开，`--no-mouse` 与 UYA_AGENT_MOUSE=0 就白给了）
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    tui_set_mouse(false);
    tui_term_enter(fds[1]);
    tuis_mouse_enter(fds[0], &cap);
    if bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "关着进 TUI 时 tui_term_enter 仍发了 1000h（--no-mouse 会失效）", &ok);
    }
    if bufx_contains(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "关着进 TUI 时 tui_term_enter 仍发了 1006h（--no-mouse 会失效）", &ok);
    }
    // 离开 TUI 仍要关鼠标（此刻其实是关着的，但 teardown 必须写 —— 免得上一轮开着时漏关）
    var leave_cap: Buf = buf_new(1024);
    defer { buf_free(&leave_cap); }
    tui_term_leave(fds[1]);
    tuis_mouse_enter(fds[0], &leave_cap);
    if !bufx_contains(&leave_cap, "\x1b[?1000l" as &const byte) {
        tuis_fail(tag, "离开 TUI 没有关鼠标上报（会拖累后面的 shell）", &ok);
    }

    // 收尾：收回 headless，关 pipe
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    _ = sys_close(fds[1]) catch {};
    _ = sys_close(fds[0]) catch {};

    // ---- E) 真 PTY：配置 → 终端序列这条端到端链（两个方向都量）----
    if !ws_prepare("build/selftest_ws_tui_pty" as &const byte) {
        tuis_fail(tag, "PTY 腿的工作目录准备失败", &ok);
    } else {
        tuis_mouse_spawn(true, true, tag, &ok);      // 默认开：PTY 里必须有 1000h
        tuis_mouse_spawn(false, false, tag, &ok);    // 关：PTY 里一个 1000h 都不许有
    }

    if ok {
        tuis_ok(tag, "鼠标上报开关（默认开 + 幂等 + F2 两种编码 + /mouse on·off·非法 + 字节级：进/关/再开/关着进都与开关一致 + 真 PTY 两个方向）");
    }
    return ok;
}


// ============================================================
// P37：/model 与 /effort 浮层（模型选择 / 推理强度选择）
// ============================================================
// fixture 用一份手写的 settings.yaml（真机那份一直在长，不能当断言基准）。
// 断言四件事：清单按提供方分组且当前项带 ✓；回车交回的行能反解出**模型名**；
// 强度浮层只列模型**公布**的档位；不公布档位的模型上 /effort 不开浮层、只给一行说明。
const TUIM_HOME: &const byte = "build/selftest_p37_tuim_home" as &const byte;

// 把 DSH home 指向模型轮自己的 fixture 目录（TUIM_HOME），让模型目录从它读设置。
fn tuim_home_set() void {
    var hb: Buf = buf_new(128);
    defer { buf_free(&hb); }
    _ = buf_append_cstr(&hb, TUIM_HOME);
    _ = agent_set_dsh_home(hb.ptr[0: hb.len]);
}

// 写模型轮的 settings.yaml fixture（只有我们关心的那几节）。
// 返回 false = 建目录或写文件失败。
fn tuim_fixture_write() bool {
    _ = sess_mkdir_p(TUIM_HOME);
    var p: Buf = buf_new(256);
    defer { buf_free(&p); }
    _ = buf_append_cstr(&p, TUIM_HOME);
    _ = buf_append_cstr_z(&p, "/settings.yaml");
    const body: &const byte = "llm-pi-ai:\n  providers:\n    {\n      alpha:\n        {\n          api: openai-responses,\n          baseURL: https://alpha.example/v1,\n          models:\n            [\n              { id: a-one },\n              { id: a-two, contextWindow: 333000, reasoningEfforts: { off: none, low: low, high: high } }\n            ]\n        },\n      beta:\n        {\n          api: openai-completions,\n          baseURL: https://beta.example/v1,\n          models: [ { id: b-plain, reasoningEfforts: false }, { id: a-two, contextWindow: 444000, reasoningEfforts: { off: none } } ]\n        }\n    }\n" as &const byte;
    return write_text_file(p.ptr as &const byte, body);
}

// P71：写回那条腿用的 fixture —— 在模型轮的表上多加**一个 `agent-default-model` 节**
// （值故意是旧的），于是「浮层切完有没有把新值写进去」可观测。表本身与
// `tuim_fixture_write` 逐字节相同，这样前面几条腿读到的目录不会变。
fn tuim_settings_old() &const byte {
    // 行宽豁免：settings.yaml 的逐字节夹具（断了就改了被测的输入），形状与 tuim_fixture_write 相同
    return "agent-default-model:\n  provider: alpha\n  model: a-one\nllm-pi-ai:\n  providers:\n    {\n      alpha:\n        {\n          api: openai-responses,\n          baseURL: https://alpha.example/v1,\n          models:\n            [\n              { id: a-one },\n              { id: a-two, contextWindow: 333000, reasoningEfforts: { off: none, low: low, high: high } }\n            ]\n        },\n      beta:\n        {\n          api: openai-completions,\n          baseURL: https://beta.example/v1,\n          models: [ { id: b-plain, reasoningEfforts: false }, { id: a-two, contextWindow: 444000, reasoningEfforts: { off: none } } ]\n        }\n    }\n" as &const byte;
}

// tui-model 轮（P37）：/model 与 /effort 浮层 —— 清单按提供方分组且当前项带 ✓、
// 回车交回的行能反解出模型名、强度浮层只列**公布**的档位。返回 false = 本轮红。
fn tui_model_round(tag: &const byte) bool {
    var ok: bool = true;
    if !tuim_fixture_write() {
        tuis_fail(tag, "造 settings.yaml fixture 失败", &ok);
        return ok;
    }
    agent_models_reset();
    tuim_home_set();
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("a-one");
    cfg.provider = buf_from_cstr("alpha");
    cfg.provider_set = true;
    cfg.context_window = -1;
    agent_models_ensure(&cfg);
    if agent_models_count() != 4 {
        tuis_fail(tag, "目录条目数不是 4（alpha 2 + beta 2，其中 a-two 是**同名跨提供方**）", &ok);
        return ok;
    }

    // ---- 1) /model 浮层：分组标题 + ✓ 标当前 ----
    tuis_reset(100, 28);
    agent_model_overlay_open(&cfg);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_MODEL {
        tuis_fail(tag, "/model 没有开出模型浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("模型（enter 切换 · esc 取消）" as &const byte) {
        tuis_fail(tag, "模型浮层标题不对", &ok);
    }
    if !tuis_screen_has("# alpha" as &const byte) || !tuis_screen_has("# beta" as &const byte) {
        tuis_fail(tag, "模型浮层没有按提供方分组", &ok);
    }
    if !tuis_screen_has("a-two" as &const byte) || !tuis_screen_has("b-plain" as &const byte) {
        tuis_fail(tag, "模型浮层没有列出全部模型", &ok);
    }
    if !tuis_screen_has("effort: off, low, high" as &const byte) {
        tuis_fail(tag, "模型浮层没有显示公布的档位", &ok);
    }
    if !tuis_screen_has("（不公布推理档位）" as &const byte) {
        tuis_fail(tag, "非推理模型没有标成「不公布推理档位」", &ok);
    }
    // ✓ 只出现在当前模型（a-one）那一行
    var cur_ok: bool = false;
    var other_ok: bool = true;
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, "✓" as &const byte) {
            if tui_row_has(r, "a-one" as &const byte) {
                cur_ok = true;
            } else {
                other_ok = false;
            }
        }
        r = r + 1;
    }
    if !cur_ok {
        tuis_fail(tag, "当前模型（a-one）那一行没有 ✓", &ok);
    }
    if !other_ok {
        tuis_fail(tag, "非当前模型的行也带了 ✓", &ok);
    }

    // ---- 2) 反解：分组行不是模型名、模型行是（**并且带出提供方**）；选中 a-two 能切过去 ----
    var sel: Buf = buf_new(1024);
    defer { buf_free(&sel); }
    var mnm: Buf = buf_new(128);
    defer { buf_free(&mnm); }
    var mpr: Buf = buf_new(128);
    defer { buf_free(&mpr); }
    // 反解吃的是 Buf（浮层交回的就是 Buf）；先包一层
    var lgrp: Buf = buf_new(64);
    defer { buf_free(&lgrp); }
    _ = buf_append_cstr(&lgrp, "# alpha");
    if agent_model_item_parse(&lgrp, &mnm, &mpr) {
        tuis_fail(tag, "分组行不该被反解成模型名", &ok);
    }
    // P62：条目里带提供方 ⇒ 反解必须把它一起交出来（同名模型选不中的根因就在这一环）
    var lmod: Buf = buf_new(128);
    defer { buf_free(&lmod); }
    _ = buf_append_cstr(&lmod, "  a-two · beta  effort: off");
    if !agent_model_item_parse(&lmod, &mnm, &mpr) {
        tuis_fail(tag, "普通模型行应当能反解出模型名", &ok);
    } else if !tuis_has(&mnm, "a-two" as &const byte) {
        tuis_fail(tag, "反解出来的不是 a-two", &ok);
    } else if !tuis_has(&mpr, "beta" as &const byte) {
        tuis_fail(tag, "反解没有带出提供方（同名模型会选回当前那一家）", &ok);
    }
    // P62：老格式（不带提供方）仍要能反解 —— 交回空提供方，由调用方退回当前那个
    var lold: Buf = buf_new(128);
    defer { buf_free(&lold); }
    _ = buf_append_cstr(&lold, "  a-two  effort: off, low, high");
    if !agent_model_item_parse(&lold, &mnm, &mpr) {
        tuis_fail(tag, "不带提供方的老格式行应当仍能反解", &ok);
    } else if mpr.len != 0 {
        tuis_fail(tag, "没有提供方标记时不该凭空造一个提供方出来", &ok);
    }
    // 键路：关掉再开，↓ 一次到 a-two。条目序是 [# alpha, a-one, a-two, # beta, b-plain, a-two]，
    // 而**游标默认停在当前模型（a-one，第 1 项）**上 —— 所以一次 ↓ 就是 alpha 的 a-two。
    tui_overlay_close();
    agent_model_overlay_open(&cfg);
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "模型浮层没有可交回的条目", &ok);
    } else if !agent_model_item_parse(&sel, &mnm, &mpr) || !tuis_has(&mnm, "a-two" as &const byte) {
        tuis_fail(tag, "↓ + 回车没有落在 a-two 那一行", &ok);
    } else if !tuis_has(&mpr, "alpha" as &const byte) {
        tuis_fail(tag, "交回的 a-two 行没有带 alpha（同名两行时选哪家全看它）", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "模型浮层没有交出选中项", &ok);
    }
    _ = agent_tui_model_handle(&cfg, null as &History, &sel);
    if !tuis_has(&cfg.model, "a-two" as &const byte) {
        tuis_fail(tag, "选中 a-two 之后 cfg.model 没换", &ok);
    }
    if cfg.context_window == -1 {
        tuis_fail(tag, "选中 a-two 之后能力没跟随（context_window 还是 -1）", &ok);
    }
    if !tuis_has(&cfg.provider, "alpha" as &const byte) {
        tuis_fail(tag, "选中的是 alpha 的 a-two，提供方不该换", &ok);
    }

    // ---- 2b) P62 回归：**同名跨提供方**时选另一家必须真的换过去 ----
    // 这是用户报的那条路：两家都发布 a-two，键盘走到 beta 那张同名行回车。
    // 老实现里条目只有模型名、hover 的 ✓ 又只看名字 ⇒ 解析回「当前提供方 + a-two」⇒
    // 命中当前那条 ⇒ 幂等返回 1 ⇒ 屏幕上什么都不发生（用户：「同名模型选不了」）。
    // 现在：条目带提供方、反解带出提供方、apply 用二元组 ⇒ 必须真的换到 beta 且能力跟着换。
    tuis_reset(100, 28);
    agent_model_overlay_open(&cfg);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    // ✓ 只该挂**一条**（alpha 的 a-two）：同名第二条必须没有 ✓，否则屏幕上分不出哪条是当前路线
    var nth_rows: usize = 0;
    var nth_marked_alpha: bool = false;
    var r2: usize = 0;
    while r2 < tui_nrows() {
        if tui_row_has(r2, "✓ " as &const byte) && tui_row_has(r2, "a-two" as &const byte) {
            nth_rows = nth_rows + 1;
            if tui_row_has(r2, "alpha" as &const byte) {
                nth_marked_alpha = true;
            }
        }
        r2 = r2 + 1;
    }
    if nth_rows != 1 || !nth_marked_alpha {
        tuis_fail(tag, "同名 a-two 两行里，✓ 应当只挂在当前那一家（alpha）那一行上", &ok);
    }
    // P62：回车落在分组标题上不许静默（同名模型恰好夹在标题之间，多按一下再回车就是经典现场）
    // ⚠ 顺序：handler 靠 `tui_overlay_kind()` 认「这是哪张浮层的结果」，所以浮层得**开着**调它；
    // 而 notice 进的是**转录**（浮层开着时那一块被盖住）⇒ 调完再关浮层，然后才扫屏幕。
    var grp: Buf = buf_new(64);
    defer { buf_free(&grp); }
    _ = buf_append_cstr(&grp, "# beta");
    var gsel: Buf = buf_new(64);
    defer { buf_free(&gsel); }
    _ = buf_append(&gsel, grp.ptr as &const byte, grp.len);
    _ = agent_tui_model_handle(&cfg, null as &History, &gsel);
    tui_overlay_close();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("这是一行提供方标题" as &const byte) {
        tuis_fail(tag, "回车落在分组标题上时没有给出可见说明（静默 = 分不清『没选中』与『选了没生效』）", &ok);
    }
    if !tuis_has(&cfg.provider, "alpha" as &const byte) {
        tuis_fail(tag, "回车落在分组标题上不该改提供方", &ok);
    }
    // 重新开一次浮层（上面把浮层收掉了），游标默认仍落在当前模型那一行
    agent_model_overlay_open(&cfg);
    // 条目序 [# alpha, a-one, a-two, # beta, b-plain, a-two]，游标默认在 alpha 的 a-two（第 2 项）
    // ⇒ 三次 ↓ 到 beta 的同名 a-two（第 5 项）
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "同名第二条 a-two 没有交出选中项", &ok);
    } else if !agent_model_item_parse(&sel, &mnm, &mpr) || !tuis_has(&mpr, "beta" as &const byte) {
        tuis_fail(tag, "走到同名第二条时交回的行没有带 beta", &ok);
    } else {
        _ = agent_tui_model_handle(&cfg, null as &History, &sel);
        if !tuis_has(&cfg.provider, "beta" as &const byte) {
            tuis_fail(tag, "选中 beta 的同名 a-two 之后提供方没换（同名模型选不中，用户报的那条）", &ok);
        }
        if cfg.context_window != 444000 {
            tuis_fail(tag, "换到 beta 的同名 a-two 之后能力没跟着换（contextWindow 不是 beta 那条的）", &ok);
        }
        if !tuis_has(&cfg.base_url, "beta.example" as &const byte) {
            tuis_fail(tag, "换到 beta 的同名 a-two 之后端点没跟过去", &ok);
        }
    }
    // ---- 2c) P62：`provider/model` 写法（文本 / CLI 那条路也能指定同名里的哪一家）----
    // 从 beta 切回 alpha 的同名 a-two —— 只有名字是切不回去的（同名会有歧义），所以必须有这条写法。
    const rcSlash: i32 = agent_model_apply(&cfg, "" as &const byte, 0,
        "alpha/a-two" as &const byte, 11, "human" as &const byte, false);
    if rcSlash != 0 {
        tuis_fail(tag, "`alpha/a-two` 写法应当能切（返回 0）", &ok);
    }
    if !tuis_has(&cfg.provider, "alpha" as &const byte) {
        tuis_fail(tag, "`alpha/a-two` 没有把提供方切到 alpha", &ok);
    }
    if cfg.context_window != 333000 {
        tuis_fail(tag, "`alpha/a-two` 换过去之后能力没跟着换", &ok);
    }
    if !tuis_has(&cfg.base_url, "alpha.example" as &const byte) {
        tuis_fail(tag, "`alpha/a-two` 换过去之后端点没跟着回 alpha", &ok);
    }
    // ---- 2d) P62：同名歧义要**说出来**（切到 beta 的同名 a-two 时屏幕上有「另有提供方发布同名模型」）----
    // 光把选择修对还不够：同名两行都像当前路线，用户得能从回执里看出「刚才那一下落在哪一家，
    // 另一家怎么指定」。
    tuis_reset(100, 28);
    _ = agent_model_apply(&cfg, "beta" as &const byte, 4, "a-two" as &const byte, 5,
        "human" as &const byte, true);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("另有提供方发布同名模型" as &const byte) {
        tuis_fail(tag, "同名模型切过去之后没有说明「另有提供方发布同名模型」", &ok);
    }
    if !tuis_screen_has("要指定用 beta/a-two" as &const byte) {
        tuis_fail(tag, "同名歧义的提示里没有给出「现在这家」的 `提供方/名字` 写法", &ok);
    }
    // 切回 alpha（后面的腿按 alpha/a-two 的口径继续）
    _ = agent_model_apply(&cfg, "" as &const byte, 0, "alpha/a-two" as &const byte, 11,
        "human" as &const byte, false);

    // ---- 3) /effort 浮层：只列公布的档位 ----
    tui_overlay_close();
    agent_effort_overlay_open(&cfg);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_EFFORT {
        tuis_fail(tag, "/effort 没有开出强度浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("推理强度（enter 切换 · esc 取消）" as &const byte) {
        tuis_fail(tag, "强度浮层标题不对", &ok);
    }
    if !tuis_screen_has("high" as &const byte) || !tuis_screen_has("low" as &const byte) {
        tuis_fail(tag, "强度浮层没有列出公布的档位", &ok);
    }
    if tuis_screen_has("medium" as &const byte) {
        tuis_fail(tag, "强度浮层列出了没公布的档位（medium）—— 不该发明档位", &ok);
    }
    var esel: Buf = buf_new(256);
    defer { buf_free(&esel); }
    var ev: Buf = buf_new(64);
    defer { buf_free(&ev); }
    var lef: Buf = buf_new(64);
    defer { buf_free(&lef); }
    _ = buf_append_cstr(&lef, "✓ high");
    if !agent_effort_item_parse(&lef, &ev) || !tuis_has(&ev, "high" as &const byte) {
        tuis_fail(tag, "强度行反解不出档位名", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&esel) {
        tuis_fail(tag, "强度浮层没有交出选中项", &ok);
    } else {
        _ = agent_tui_model_handle(&cfg, null as &History, &esel);
        if cfg.reasoning_effort.len == 0 || !cfg.effort_set {
            tuis_fail(tag, "选中的档位没有落到 cfg.reasoning_effort", &ok);
        }
    }

    // ---- 4) 不公布档位的模型：/effort 不开浮层、只给一行说明 ----
    _ = agent_model_apply(&cfg, "beta" as &const byte, 4, "b-plain" as &const byte, 7,
        "human" as &const byte, false);
    tui_overlay_close();
    agent_effort_overlay_open(&cfg);
    if tui_overlay_open() {
        tuis_fail(tag, "不公布档位的模型上 /effort 不该开浮层（那会是个做不到事的控件）", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("没有公布推理档位" as &const byte) {
        tuis_fail(tag, "不公布档位时没有留下可见说明", &ok);
    }

    // ---- 5) 信息行里的强度：设了才挂 `· <强度>`，清掉就一个字节都不多 ----
    tuis_reset(100, 28);
    tui_set_effort("high" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has(" · high" as &const byte) {
        tuis_fail(tag, "信息行没有显示推理强度", &ok);
    }
    tui_set_effort("" as &const byte, 0);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tuis_screen_has(" · high" as &const byte) {
        tuis_fail(tag, "清掉强度之后还在画它", &ok);
    }

    // ---- 6) 回合运行中选完模型：**泵点当场收口**（P37 修复的第二半）----
    // 老实现里模型/强度浮层的结果只有主循环那条分支会取，而主循环整个回合都不跑 ——
    // 于是「回合运行中在浮层里选完模型」要等最后一轮工具跑完才生效（实测回车后 6 s 才切）。
    // 这里钉住：泵点一收，cfg.model 立刻变、结果不再挂着、浮层已关。
    tuis_reset(100, 28);
    tui_headless_enable(true);
    tui_set_run(TUI_RUN_THINK, "跑着呢" as &const byte, bufx_cstr_len("跑着呢" as &const byte));
    _ = agent_model_apply(&cfg, "alpha" as &const byte, 5,
        "a-one" as &const byte, 5, "human" as &const byte, false);
    var ph: History = hist_init();
    defer { hist_free(&ph); }
    agent_model_overlay_open(&cfg);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_MODEL {
        tuis_fail(tag, "运行中裸 /model 没开出模型浮层", &ok);
    }
    // 游标停在当前模型（a-one）那一行：↓ 一次到 a-two，回车交出选中项
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_result_pending() {
        tuis_fail(tag, "模型浮层的选中项没有挂进结果队列", &ok);
    }
    agent_tui_poll_pending_cmd(&cfg, &ph);
    if !tuis_has(&cfg.model, "a-two" as &const byte) {
        tuis_fail(tag, "泵点没有当场收下模型选择（运行中选中要等回合结束才生效）", &ok);
    }
    if tui_overlay_result_pending() {
        tuis_fail(tag, "泵点收完之后结果还挂着（主循环会再派发一次）", &ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "泵点收完之后模型浮层还开着", &ok);
    }
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);

    // ---- 7) P71：浮层里选完 ⇒ 把这份选择**写回** DSH 设置（agent-default-model）----
    // 这一条钉的是「浮层那条路真的接了写回」，不是只接了函数：本轮 fixture（TUIM_HOME）
    // 那张表走过上面几条腿之后 provider/model 早被切过好几轮，所以这里不看具体值，只看
    // 「那两行已经跟着当前选择改了、同一份设置里的**别的条目**还在」—— 与 `dsh-writeback`
    // 轮的分工是「写回的规则」vs「浮层这条入口的接线」。
    var wbp: Buf = buf_new(256);
    defer { buf_free(&wbp); }
    _ = buf_append_cstr(&wbp, TUIM_HOME);
    _ = buf_append_cstr_z(&wbp, "/settings.yaml");
    if !write_text_file(wbp.ptr as &const byte, tuim_settings_old()) {
        tuis_fail(tag, "重写模型轮 fixture 失败", &ok);
    }
    // 走**浮层那条真路**：开浮层 → 键盘选到另一家的同名 a-two → 回车 → 主循环收口。
    // 直接调 agent_model_save_default 证明不了接线（那条路测的是函数，不是入口）——
    // 浮层里 `agent_tui_model_handle` 那一支漏了写回，这条腿必须红。
    var wbh: History = hist_init();
    defer { hist_free(&wbh); }
    _ = agent_model_apply(&cfg, "alpha" as &const byte, 5,
        "a-one" as &const byte, 5, "human" as &const byte, false);
    tuis_reset(100, 28);
    tui_headless_enable(true);
    agent_model_overlay_open(&cfg);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_MODEL {
        tuis_fail(tag, "写回那条腿上裸 /model 没开出模型浮层", &ok);
    }
    // 条目序是 [# alpha, a-one, a-two, # beta, b-plain, a-two]，游标默认停在当前模型
    // （a-one = 第 1 行）⇒ 按 4 次 ↓ 走到**第 5 行**（beta 那一家的同名 a-two）。
    // 特意挑跨提供方那一行：写回要连 provider 一起落，选本家的同名行就分不出这一点。
    // 一次一个序列注入（`\x1b[B` = 3 字节）—— 与上面那几条腿同一写法，长度不用手数。
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\r" as &const byte, 1);
    agent_tui_poll_pending_cmd(&cfg, &wbh);
    if !tuis_has(&cfg.model, "a-two" as &const byte) {
        tuis_fail(tag, "写回那条腿上浮层的选择没生效", &ok);
    }
    if !tuis_has(&cfg.provider, "beta" as &const byte) {
        tuis_fail(tag, "写回那条腿没走到 beta 那一家（键盘步数与该轮的条目序对不上）", &ok);
    }
    var wbfile: Buf = buf_new(4096);
    defer { buf_free(&wbfile); }
    if !fs_read_file_all(wbp.ptr as &const byte, &wbfile, 262144) {
        tuis_fail(tag, "写回之后读不回 fixture 的 settings.yaml", &ok);
    } else {
        if !tuis_has(&wbfile, "provider: beta" as &const byte) ||
            !tuis_has(&wbfile, "model: a-two" as &const byte) {
            tuis_fail(tag, "浮层里选完没有写回 settings.yaml（这条入口漏了写回）", &ok);
        }
        if !tuis_has(&wbfile, "b-plain" as &const byte) {
            tuis_fail(tag, "写回把同一份设置里的别的条目弄丢了（只许改那两行）", &ok);
        }
    }

    agent_models_reset();
    if ok {
        out_err("selftest[");
        out_err(tag);
        // 行宽豁免：整轮结语是一句话，断了反而不好核对（与别的轮同一写法）
        out_err("] ok（/model 分组+✓+反解 / 同名跨提供方（行带提供方·✓ 只挂当前那家·选中另一家真换过去·提供方/名字写法·歧义提示·分组标题不静默）/ /effort 只列公布档位 / 非推理模型不开浮层 / 信息行强度 / 运行中泵点当场收口 / 浮层选择写回 DSH 设置）\n");
    }
    return ok;
}

// ============================================================
// P41：/worktree 的动作选择浮层（+ finish/discard 的二次确认）
// ============================================================
// 两段：
//   A) 不需要 git：浮层排版（标题 / 七个动作 / ✓ 标当前模式）、反解（认动作行，不认
//      「取消」与别的浮层的条目）、默认游标 = status、不可逆动作**选定不生效**；
//   B) 真 git：建 worktree → 键盘走到 finish → 确认浮层上**什么都不许动**（目录还在、
//      phase 还是 READY）→ 只按回车（游标默认停在「取消」）同样什么都不做 →
//      真的把游标挪到 finish 那一行才合并 + 删除。
// fixture 是 pid 独占的 /tmp 仓（与 P37 那两轮同一套理由：整轮 selftest 会 fork 出一堆
// 子进程，共享目录会互相踩；相对路径会被前面几轮的 chdir 带跑）。造仓复用 selftest.uya
// 的 wt_fixture_make（同一份 fixture，不写第二遍）。
fn tuis_wt_ws_pid(out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, "/tmp/selftest_p41_wt_");
    const pid: i64 = sys_getpid() catch { 0 as i64; };
    _ = buf_append_i64(out, pid);
}

// 路径 + 尾 NUL（fs_stat / write_text_file 收 C 字符串；Buf.ptr 没有尾 NUL）
fn tuis_wt_z(src: &const Buf, suffix: &const byte, out: &Buf) void {
    buf_reset(out);
    _ = buf_append(out, src.ptr as &const byte, src.len);
    _ = buf_append_cstr_z(out, suffix);
}

// path_z（C 串）指向的路径是否存在（经 fs_stat，不跟随符号链接的细节由 fs_stat 定）。
fn tuis_wt_exists(path_z: &const byte) bool {
    var st: FsStat = FsStat{ exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0 };
    _ = fs_stat(path_z, &st);
    return st.exists;
}

// ============================================================
// tui-watch-pick：/watch 现役清单 ↔ 「选中即跟随」这一条链（P46）
// ============================================================
// 用户报的「敲了 /watch 没反应」在 TUI 里是三件事叠在一起，逐个钉住：
//   A) 清单浮层的 kind 必须是**自己的** TUI_OVK_WATCH_LIST —— 以前借 /tasks 的
//      TUI_OVK_TASKS，而那个 kind 在接收端是「纯查看」语义，回车交出来的行没人接、
//      被静默丢掉（「选中代理」与「什么都没发生」是同一屏）；
//   B) 默认游标要落在**第一个代理行**上（第 0 行是表头）：不放的话「打开就回车」落在表头上，
//      用户拿到的是一句「没认出编号」；
//   C) 选中之后的**每条失败路**都要有回执：认不出编号、目标已经不在了（清单还开着的时候
//      子代理可能刚跑完）、目标写错（`/watch sub-9`）——静默是最难查的一种。
// 真终端那半（清单 → 回车 → 跟随浮层 + 实时事件）走 `make e2e-watch-pick`。
fn tui_watch_pick_round(tag: &const byte) bool {
    var ok: bool = true;
    const wsa: &const byte = "build/selftest_ws_watch_pick" as &const byte;
    if !ws_prepare(wsa) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    var c: Config = cfg_default();
    tuis_cmd_cfg(&c, wsa);
    defer { cfg_free(&c); }
    var h: History = hist_init();
    defer { hist_free(&h); }

    // ---- A) 裸 /watch 走 agent_tui_command 这条真路：开出清单浮层，kind 是 WATCH_LIST ----
    tuis_reset(100, 30);
    tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
    tui_begin_session();
    var cmd: Buf = buf_new(32);
    defer { buf_free(&cmd); }
    _ = buf_append_cstr(&cmd, "/watch");
    _ = agent_tui_command(&c, &h, &cmd);
    if !tui_overlay_open() {
        tuis_fail(tag, "裸 /watch 没有开出清单浮层", &ok);
        return ok;
    }
    if tui_overlay_kind() != TUI_OVK_WATCH_LIST {
        tuis_fail(tag, "清单浮层的 kind 不是 TUI_OVK_WATCH_LIST（借 /tasks 的 kind ⇒ 回车的结果没人接）", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("跟随子代理（" as &const byte) {
        tuis_fail(tag, "清单浮层没有画出来", &ok);
    }
    if !tuis_screen_has("回车跟随" as &const byte) {
        tuis_fail(tag, "清单标题里没写「回车跟随」（用户不知道回车能干什么）", &ok);
    }
    if !tuis_screen_has("（没有正在跑的子代理）" as &const byte) {
        tuis_fail(tag, "现役空态没画出来（清单内容不是 agent_watch_list 那一份？）", &ok);
    }

    // ---- B) 默认游标 = 第一个代理行（纯函数，喂一份带表头的清单）----
    var items: Buf = buf_new(512);
    defer { buf_free(&items); }
    _ = buf_append_cstr(&items,
        "[watch] 现役子代理（/watch sub-N 跟随，/watch off 停）：\n  sub-1 [running] a\n  sub-2 [idle] b\n");
    if agent_watch_list_first_row(&items) != 1 {
        tuis_fail(tag, "默认游标没落在第一个代理行上（打开就回车会落在表头上）", &ok);
    }
    buf_reset(&items);
    _ = buf_append_cstr(&items, "[watch] 现役子代理（/watch sub-N 跟随，/watch off 停）：\n  （没有正在跑的子代理）\n");
    if agent_watch_list_first_row(&items) != 0 {
        tuis_fail(tag, "空态清单的游标不该越界", &ok);
    }

    // ---- C1) 回车：浮层把**选中行原文**交出来（且交给主循环那条落点）----
    tui_keys_inject("\r" as &const byte, 1);
    var got: Buf = buf_new(256);
    defer { buf_free(&got); }
    if !tui_overlay_take(&got) {
        tuis_fail(tag, "清单没把选中行交出来（回车的结果被丢了？）", &ok);
    }
    // 空态清单上选中行是表头：认不出编号 ⇒ 必须落一条 notice，不许静默
    if agent_tui_watch_pick(&c, &got) {
        tuis_fail(tag, "空态清单上回车不该开始跟随", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("没认出子代理编号" as &const byte) {
        tuis_fail(tag, "选中表头行时没有回执（静默）", &ok);
    }

    // ---- C2) 选中一个**已经不在**的编号：回执里要点名（清单开着时子代理可能刚跑完）----
    var fake: Buf = buf_new(64);
    defer { buf_free(&fake); }
    _ = buf_append_cstr(&fake, "  sub-7 [running] 早就跑完了");
    if agent_tui_watch_pick(&c, &fake) {
        tuis_fail(tag, "目标不存在却报「已开始跟随」", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("没有 sub-7 这个子代理" as &const byte) {
        tuis_fail(tag, "目标不存在时没有回执（TUI 里就是「敲了没反应」）", &ok);
    }

    // ---- C3) /watch 的三种落点码（TUI 靠它决定开哪张浮层、要不要给回执）----
    var out: Buf = buf_new(256);
    defer { buf_free(&out); }
    if agent_cmd_watch(&c, "" as &const byte, 0, &out) != WATCH_CMD_LIST {
        tuis_fail(tag, "裸 /watch 该回 WATCH_CMD_LIST", &ok);
    }
    buf_reset(&out);
    if agent_cmd_watch(&c, " sub-9" as &const byte, 6, &out) != WATCH_CMD_BAD {
        tuis_fail(tag, "不存在的编号该回 WATCH_CMD_BAD（回 true 的话回执会被丢掉）", &ok);
    }
    buf_reset(&out);
    if agent_cmd_watch(&c, " off" as &const byte, 4, &out) != WATCH_CMD_STOPPED {
        tuis_fail(tag, "/watch off 该回 WATCH_CMD_STOPPED", &ok);
    }

    // ---- D) 回合运行中敲 /watch sub-1：只读命令要能**当场**派发（不许被当成给模型的文本）----
    var live: Buf = buf_new(32);
    defer { buf_free(&live); }
    _ = buf_append_cstr(&live, "/watch sub-1");
    if !agent_tui_cmd_safe(&live) {
        tuis_fail(tag, "带参数的 /watch 不在「只读当场派发」集合里（回合里敲它会等到回合结束）", &ok);
    }
    if agent_steer_line(&live) {
        tuis_fail(tag, "泵点上下文没登记时不该当场派发（那条路归主循环）", &ok);
    }
    var txt: Buf = buf_new(32);
    defer { buf_free(&txt); }
    _ = buf_append_cstr(&txt, "顺便看看日志");
    if agent_steer_line(&txt) {
        tuis_fail(tag, "普通文本不该被当成命令派发", &ok);
    }

    if ok {
        tuis_ok(tag, "清单 kind 是自己的（回车结果有人接）+ 默认游标在第一个代理行 + 选中即跟随的三条失败路都有回执 + 三种落点码 + 带参数的 /watch 在只读集合里" as &const byte);
    }
    return ok;
}

// tui-worktree 轮（P37/P111）：TUI 里的 worktree 建/切/收 —— 建之前先从关开始
// （wt_set_on(false)：出厂默认已经是开，所以这一行是本轮自己的复位），断言清单、
// 模式标记、finish/discard 的分支与错误文案。返回 false = 本轮红。
// P111 之后：`on` 不再是动作，`start` 会**无条件把模式开回来** —— A4 那一节钉的就是
// 「关着敲 start = 开 + 建」，而不再是「关着敲 start 报错」。
fn tui_worktree_round(tag: &const byte) bool {
    var ok: bool = true;
    wt_set_on(false);
    wt_reset();
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        tuis_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    defer { wst_back(&root); }
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("wt-model");
    var h: History = hist_init();
    defer { hist_free(&h); }
    var sel: Buf = buf_new(1024);
    defer { buf_free(&sel); }
    var act: Buf = buf_new(64);
    defer { buf_free(&act); }
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    var cmd: Buf = buf_new(64);
    defer { buf_free(&cmd); }

    // ---- A1) 裸 /worktree（走 agent_tui_command 那条真路）→ 动作选择浮层 ----
    tuis_reset(100, 28);
    tui_overlay_close();
    _ = buf_append_cstr(&cmd, "/worktree");
    _ = agent_tui_command(&cfg, &h, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_WORKTREE {
        tuis_fail(tag, "裸 /worktree 没有开出动作选择浮层", &ok);
        return ok;
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("Git worktree（enter 执行 · esc 取消）" as &const byte) {
        tuis_fail(tag, "动作浮层的标题不对", &ok);
    }
    var i: usize = 0;
    while i < WT_ACT_N {
        if !tuis_screen_has(wt_act_name(i)) {
            tuis_fail(tag, "动作浮层里少了某个动作（动作表与排版对不上）", &ok);
        }
        i = i + 1;
    }
    if !tuis_screen_has("合并回基分支" as &const byte) {
        tuis_fail(tag, "动作行没有带一行说明", &ok);
    }
    // P111：`on` 那一行已经撤了（出厂就开着，想开是 start），只剩 `off` 带 ✓
    if !tuis_screen_has("✓ off" as &const byte) {
        tuis_fail(tag, "模式关时 ✓ 没有挂在 off 那一行", &ok);
    }
    if tuis_screen_has("✓ on" as &const byte) {
        tuis_fail(tag, "动作表里还留着 on 那一行（P111 之后打开不是动作）", &ok);
    }
    // 模式开（出厂默认）：✓ 从 off 那一行挪走
    wt_set_on(true);
    tui_overlay_close();
    agent_tui_worktree_open();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tuis_screen_has("✓ off" as &const byte) {
        tuis_fail(tag, "模式开时 off 那一行还挂着 ✓", &ok);
    }
    wt_set_on(false);
    tui_overlay_close();

    // ---- A2) 反解：动作行认得出，别的浮层的条目与「取消」认不出 ----
    agent_tui_worktree_line(WT_ACT_STATUS, &line);
    if !agent_tui_worktree_parse(&line, &act) || !tuis_has(&act, "status" as &const byte) {
        tuis_fail(tag, "status 行反解不出动作名", &ok);
    }
    agent_tui_worktree_line(WT_ACT_FINISH, &line);
    if !agent_tui_worktree_parse(&line, &act) || !tuis_has(&act, "finish" as &const byte) {
        tuis_fail(tag, "finish 行反解不出动作名", &ok);
    }
    if wt_act_needs_confirm(&act) == false {
        tuis_fail(tag, "finish 没被判成需要确认的不可逆动作", &ok);
    }
    var alien: Buf = buf_new(64);
    defer { buf_free(&alien); }
    _ = buf_append_cstr(&alien, "取消");
    if agent_tui_worktree_parse(&alien, &act) {
        tuis_fail(tag, "「取消」被反解成了动作（那会误执行）", &ok);
    }
    buf_reset(&alien);
    _ = buf_append_cstr(&alien, "✓ Read Only        — 只读");
    if agent_tui_worktree_parse(&alien, &act) {
        tuis_fail(tag, "别的浮层的条目被反解成了动作", &ok);
    }
    buf_reset(&alien);
    _ = buf_append_cstr(&alien, "✓ discard");
    if !agent_tui_worktree_parse(&alien, &act) || !tuis_has(&act, "discard" as &const byte) {
        tuis_fail(tag, "带 ✓ 的动作行反解不出动作名", &ok);
    }
    if wt_act_needs_confirm(&act) == false {
        tuis_fail(tag, "discard 没被判成需要确认的不可逆动作", &ok);
    }

    // ---- A3) 打开就回车 = status（游标默认落在 status，P37 的老手感不变）----
    tui_overlay_close();
    agent_tui_worktree_open();
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "动作浮层没有可交回的条目", &ok);
    } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "status" as &const byte) {
        tuis_fail(tag, "打开就回车没有落在 status 那一行", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "动作浮层没有交出选中项", &ok);
    }
    _ = agent_tui_worktree_handle(&cfg, &h, &sel);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("worktree mode is off" as &const byte) {
        tuis_fail(tag, "status 的结果没有落进转录", &ok);
    }

    // ---- A4) P111：打开不再是动作，off 是逃生口；start 无条件把模式开回来 ----
    // 模式关着时选 off（浮层最后一行）：仍然关着，且回执落进转录
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(WT_ACT_OFF_ROW, &line);     // off 那一行
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if wt_on() {
        tuis_fail(tag, "选 off 之后模式没关掉", &ok);
    }
    // 浮层还开着会盖住转录：先关掉再看屏幕（看得见的才是「落进转录」）
    tui_overlay_close();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("worktree 模式：关" as &const byte) {
        tuis_fail(tag, "off 的结果没有落进转录", &ok);
    }
    // 键盘：回到浮层，↑ 一次从 status 走到 start（P111 之后 start 是第一行）。
    // 只按一次：底对齐浮层的 ↑ 到顶之后会**回绕**到最后一行（off），多按一下就把
    // 「关掉」当成选中项执行了 —— 这条实测红过一次，别再「顺手多按一下」。
    tui_overlay_close();
    agent_tui_worktree_open();
    tui_keys_inject("\x1b[A" as &const byte, 3);
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "动作浮层没有可交回的条目", &ok);
    } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "start" as &const byte) {
        tuis_fail(tag, "↑ 一次没有落在 start 那一行", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "动作浮层没有交出选中项", &ok);
    }
    // 模式关着敲 start：**不报错**，而是把模式开回来（这条就是 P111 的判据）。
    // 注意它会**真的去 provision**：cfg.workspace 是空串，`git -C ''` 落到当前仓库，
    // 于是这个临时目录当场被建出来 —— A5 后面那几条「还没确认就不许 phase 变」的断言
    // 依赖 phase = NONE，所以这里把状态与模式都复位回去（这正是自测该干的事）。
    _ = agent_tui_worktree_handle(&cfg, &h, &sel);
    if !wt_on() {
        tuis_fail(tag, "模式关着敲 start 之后模式没开回来", &ok);
    }
    wt_set_on(false);
    wt_reset();

    // ---- A5) finish / discard：选定**不生效**，先翻确认浮层；默认游标在「取消」----
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(WT_ACT_FINISH, &line);
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
        tuis_fail(tag, "选 finish 没有翻出确认浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("确认 finish？" as &const byte) {
        tuis_fail(tag, "确认浮层的标题不对", &ok);
    }
    if wt_phase() != WT_PHASE_NONE {
        tuis_fail(tag, "还没确认就动了 worktree（phase 变了）", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "确认浮层没有可交回的条目", &ok);
    } else if agent_tui_worktree_parse(&sel, &act) {
        tuis_fail(tag, "确认浮层的默认游标不在「取消」上（回车会真执行）", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "确认浮层没有交出选中项", &ok);
    }
    _ = agent_tui_worktree_handle(&cfg, &h, &sel);
    if wt_phase() != WT_PHASE_NONE {
        tuis_fail(tag, "取消之后 worktree 状态被动了", &ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "取消之后浮层还开着", &ok);
    }
    // discard 走同一条闸门（标题与提示词是另一份，得单独看一眼）
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(WT_ACT_DISCARD, &line);
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
        tuis_fail(tag, "选 discard 没有翻出确认浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("确认 discard？" as &const byte) {
        tuis_fail(tag, "discard 的确认浮层标题不对", &ok);
    }
    if wt_phase() != WT_PHASE_NONE {
        tuis_fail(tag, "discard 还没确认就动了 worktree", &ok);
    }
    tui_overlay_close();

    // ---- B) 真 git：确认之前一个字节都不许动，确认之后才合并 + 删除 ----
    if !gitx_available() {
        out_err("selftest[");
        out_err(tag);
        out_err("] skip B（本机 PATH 里没有 git）\n");
    } else {
        var errout: Buf = buf_new(4096);
        defer { buf_free(&errout); }
        var wsz: Buf = buf_new(128);
        defer { buf_free(&wsz); }
        tuis_wt_ws_pid(&wsz);
        if !wt_fixture_make(&wsz, &errout) {
            tuis_fail(tag, "造 fixture 仓失败", &ok);
        } else {
            wt_reset();
            wt_set_on(true);
            const prc: i32 = wt_provision(&cfg, wsz.ptr as &const byte, wsz.len,
                "session-41414141-4141-4141-8141-414141414141" as &const byte, 43);
            if prc != 0 || !wt_ready() {
                tuis_fail(tag, "wt_provision 没建出 worktree", &ok);
                const stx: &const WtState = wt_state();
                out_err("  note=");
                out_err_bytes(stx.note.ptr as &const byte, stx.note.len);
                out_err("\n");
            } else {
                const st0: &const WtState = wt_state();
                var wtz: Buf = buf_new(1200);
                defer { buf_free(&wtz); }
                tuis_wt_z(&st0.worktree_path, "/p41.txt" as &const byte, &wtz);
                if !write_text_file(wtz.ptr as &const byte, "p41 from the worktree\n" as &const byte) {
                    tuis_fail(tag, "往 worktree 里写文件失败", &ok);
                }
                var wtrootz: Buf = buf_new(1200);
                defer { buf_free(&wtrootz); }
                tuis_wt_z(&st0.worktree_path, "" as &const byte, &wtrootz);
                var mergedz: Buf = buf_new(1200);
                defer { buf_free(&mergedz); }
                tuis_wt_z(&wsz, "/p41.txt" as &const byte, &mergedz);

                // 键盘走一遍：浮层 → ↓（status→finish）→ 回车 → 确认浮层
                tui_overlay_close();
                agent_tui_worktree_open();
                tui_keys_inject("\x1b[B" as &const byte, 3);
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_peek(&sel) {
                    tuis_fail(tag, "动作浮层没有可交回的条目", &ok);
                } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "finish" as &const byte) {
                    tuis_fail(tag, "↓ 一次没有落在 finish 那一行", &ok);
                }
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "动作浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
                    tuis_fail(tag, "finish 没有翻成确认浮层", &ok);
                }
                if wt_phase() != WT_PHASE_READY {
                    tuis_fail(tag, "还没确认就把 worktree 合并/删掉了", &ok);
                }
                if !tuis_wt_exists(wtrootz.ptr as &const byte) {
                    tuis_fail(tag, "还没确认 worktree 目录就没了", &ok);
                }
                // 确认浮层上只按回车（默认游标 = 取消）：什么都不该发生
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_peek(&sel) {
                    tuis_fail(tag, "确认浮层没有可交回的条目", &ok);
                } else if agent_tui_worktree_parse(&sel, &act) {
                    tuis_fail(tag, "确认浮层的默认游标不在「取消」上", &ok);
                }
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "确认浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if wt_phase() != WT_PHASE_READY {
                    tuis_fail(tag, "取消之后 worktree 的 phase 变了", &ok);
                }
                if !tuis_wt_exists(wtrootz.ptr as &const byte) {
                    tuis_fail(tag, "取消之后 worktree 目录没了", &ok);
                }
                if tuis_wt_exists(mergedz.ptr as &const byte) {
                    tuis_fail(tag, "取消之后改动竟然合并到主干上了", &ok);
                }
                // 真的确认：重新走到确认浮层，把游标从「取消」挪到 finish 那一行
                tui_overlay_close();
                agent_tui_worktree_open();
                tui_keys_inject("\x1b[B" as &const byte, 3);
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "动作浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
                    tuis_fail(tag, "第二次选 finish 没有翻出确认浮层", &ok);
                }
                tui_keys_inject("\x1b[A" as &const byte, 3);   // 取消 → finish 那一行
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_peek(&sel) {
                    tuis_fail(tag, "确认浮层没有可交回的条目", &ok);
                } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "finish" as &const byte) {
                    tuis_fail(tag, "↑ 一次没有落在 finish 那一行", &ok);
                }
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "确认浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if wt_phase() != WT_PHASE_FINISHED {
                    tuis_fail(tag, "确认之后没有走完 finish", &ok);
                }
                if tuis_wt_exists(wtrootz.ptr as &const byte) {
                    tuis_fail(tag, "finish 之后 worktree 目录还在", &ok);
                }
                if !tuis_wt_exists(mergedz.ptr as &const byte) {
                    tuis_fail(tag, "finish 之后主干上没有合并进来的文件", &ok);
                }
                tui_build();
                tuis_scan_rows(100, &ok, tag);
                if !tuis_screen_has("removed worktree" as &const byte) {
                    tuis_fail(tag, "finish 的结果没有落进转录", &ok);
                }
            }
        }
    }
    wt_set_on(false);
    wt_reset();
    tui_overlay_close();
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（浮层排版+✓ / 反解只认动作行 / 默认游标=status / finish·discard 先确认 / 真 git：确认前不动、确认后才合并删除）\n");
    }
    return ok;
}

// tui-demo-size：`--tui-demo` 的画布尺寸决策。
//
// 为什么值得单独一轮：这条判据的失败形态是**用户报的「输出错乱」** —— demo 默认画布
// 160 列，而终端只有 80/120 列时每一行都被折成两行，脚注、输入行、表格当场散架。
// 它只在真机真终端上看得见（重定向与 wine 都照不出来），所以决策本身抽成纯函数
// （agent_demo_canvas_size）、在这里把三种输入钉死；渲染侧只负责照给定画布排。
// 三个不变量：
//   ① 终端比画布窄 ⇒ 按终端收窄（不然就是折行错乱）；
//   ② TTY 但尺寸为 0 ⇒ 兜 80x24（与真界面 tty_init/tui_size_refresh 同一口径，
//      否则同一台机器上 demo 与真界面排版对不上）；
//   ③ 非 TTY（重定向）⇒ 原样返回内置画布（`--tui-demo > out.txt` 必须与从前
//      **逐字节相同**，它是基准/夹具/文档快照的来源）。
fn tui_demo_size_round(tag: &const byte) bool {
    var ok: bool = true;
    const CC: usize = 160;      // 与 cfg_default 的内置画布同值
    const CR: usize = 40;
    var c: usize = 0;
    var r: usize = 0;

    // ① 终端 120x30：按终端收窄（这就是 Windows 客户机上报的那条）
    agent_demo_canvas_size(true, 120, 30, true, false, CC, CR, &c, &r);
    if c != 120 || r != 30 {
        tuis_fail(tag, "终端 120x30 时画布没有收窄到终端尺寸（会折行错乱）", &ok);
    }
    // ①b 终端 80x24
    agent_demo_canvas_size(true, 80, 24, true, false, CC, CR, &c, &r);
    if c != 80 || r != 24 {
        tuis_fail(tag, "终端 80x24 时画布没有收窄到终端尺寸", &ok);
    }
    // ①c 终端更宽：**不放大**（基准屏是照 160 排的）
    agent_demo_canvas_size(true, 200, 60, true, false, CC, CR, &c, &r);
    if c != CC || r != CR {
        tuis_fail(tag, "终端比画布宽时不应放大（基准排版是照 160x40 排的）", &ok);
    }
    // ①d 只有一维更小：另一维保持内置值
    agent_demo_canvas_size(true, 120, 60, true, false, CC, CR, &c, &r);
    if c != 120 || r != CR {
        tuis_fail(tag, "只有列更窄时行数不应跟着变", &ok);
    }

    // ② TTY 但尺寸为 0：兜 80x24（与真界面同一条兜底）
    agent_demo_canvas_size(false, 0, 0, true, false, CC, CR, &c, &r);
    if c != 80 || r != 24 {
        tuis_fail(tag, "stdin 是 TTY 但尺寸为 0 时应兜 80x24（与真界面同口径）", &ok);
    }

    // ③ 非 TTY：原样内置画布（重定向输出必须逐字节不变）
    agent_demo_canvas_size(false, 0, 0, false, false, CC, CR, &c, &r);
    if c != CC || r != CR {
        tuis_fail(tag, "非 TTY（重定向）时应保持内置画布，否则基准快照会变", &ok);
    }

    // ④ 显式给了 WxH：任何情形都照用（含非 TTY 与 TTY-无尺寸）
    agent_demo_canvas_size(false, 0, 0, false, true, 100, 30, &c, &r);
    if c != 100 || r != 30 {
        tuis_fail(tag, "显式 --tui-demo 100x30 在非 TTY 下被改写了", &ok);
    }
    agent_demo_canvas_size(false, 0, 0, true, true, 100, 30, &c, &r);
    if c != 100 || r != 30 {
        tuis_fail(tag, "显式 --tui-demo 100x30 在 TTY-无尺寸下被兜底改写了", &ok);
    }
    agent_demo_canvas_size(true, 200, 60, true, true, 100, 30, &c, &r);
    if c != 100 || r != 30 {
        tuis_fail(tag, "显式 --tui-demo 100x30 被终端尺寸改写了", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（按终端取小 / 更宽不放大 / TTY 无尺寸兜 80x24 / 非 TTY 保持 160x40 / 显式 WxH 一律照用）\n");
    }
    return ok;
}
