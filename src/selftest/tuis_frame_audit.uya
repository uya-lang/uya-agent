// src/selftest/tuis_frame_audit.uya — 帧自检（P135）：帧必须**放得进终端**
//
// 本文件：tui-faudit 轮 —— ① 健康基线（普通屏 audit=0）；② 敌意正文 × 多尺寸 ×
//   多通道（助手/工具/思考/诊断/用户/输入行/待发队列），每一条都是真会话里出现过的
//   脏文本：长 URL、百分号编码的 SVG、CJK 表格、深缩进列表、末列宽字符、代码围栏；
//   ③ 行预算压满（任务块 + 待发块 + 2 行状态 + 10 行输入）在窄屏/矮屏上；
//   ④ 浮层（列表浮层 / 帮助全屏浮层）；⑤ 两条**反假绿**对照：手工造一行超宽、
//   手工造一帧超出终端行数 —— 自检必须当场报出对应的位。
//
// 不变量：本轮的判据就是它 —— `tui_frame_audit()` 恒 0。它的三位各对应一件真终端
// 会做的坏事（位定义见 frame.uya 那段注释）：行比屏幕宽 → 终端自动折行，超出的字
// 落到**下一行**；帧比终端高 → `ESC[<r>H` 被夹到最后一行，那一行被挤成两段叠字；
// 行区间不自洽 → 一行读到别的行的正文。而帧差分（`tui_row_bytes_eq`）只按「我发过
// 什么」记账，一旦发错就再也不会自愈 —— 用户看到的就是「偶发乱码、一直留着」。
//
// 为什么单开一轮：`tuis_scan_rows` 一直在断言「每行 ≤ cols」，但它只在**造出来的
// 夹具**上跑；真会话里的脏文本（尤其不可断的长 URL 与 CJK 表格）从来没进去过。
// 两套终端模拟器（`testdata/shot.py`、`src/web/ttyemu.uya`）都**不模拟折行**
// （越过右边界的字符直接丢），所以这类溢出在别的轮次里恒绿、只在真终端上花屏。
//
// 依赖：见 tuiselftest.uya 的文件头（本文件与它同处合并命名空间，无本地 use）。
// 命名：轮次 `tui_faudit_round`，夹具 `tuifa_*`。

// 自检位图的读法（报红时打人话，省得再回去数位）。
fn tuifa_bits(v: u32, ok: &bool, tag: &const byte) void {
    if v == 0 {
        return;
    }
    tuis_fail(tag, "帧自检报违规（真终端上会折行/夹行 ⇒ 两段文字叠在一格）", ok);
    tuis_puts("  bits=" as &const byte);
    tuis_num(v as usize);
    tuis_puts("（HEIGHT=" as &const byte);
    if (v & TUI_FV_HEIGHT) != 0 {
        tuis_puts("1" as &const byte);
    } else {
        tuis_puts("0" as &const byte);
    }
    tuis_puts(" WIDTH=" as &const byte);
    if (v & TUI_FV_WIDTH) != 0 {
        tuis_puts("1" as &const byte);
    } else {
        tuis_puts("0" as &const byte);
    }
    tuis_puts(" RANGE=" as &const byte);
    if (v & TUI_FV_RANGE) != 0 {
        tuis_puts("1" as &const byte);
    } else {
        tuis_puts("0" as &const byte);
    }
    tuis_puts("）\n" as &const byte);
    tuis_puts("  nrows=" as &const byte);
    tuis_num(tui_nrows());
    tuis_puts("\n" as &const byte);
    // 逐行打最宽的那几行（只打行号/列数，正文可能很长，别刷屏）
    var r: usize = 0;
    var printed: usize = 0;
    while r < tui_nrows() && printed < 8 {
        const w: usize = tui_row_cols_n(r);
        tuis_puts("  row " as &const byte);
        tuis_num(r);
        tuis_puts(" cols " as &const byte);
        tuis_num(w);
        tuis_puts("\n" as &const byte);
        printed = printed + 1;
        r = r + 1;
    }
}

// 建帧 + 全部断言（健康闸门 + 自检 + 行数不超过终端）。cols/rows 是本帧的尺寸。
fn tuifa_frame(cols: usize, rows: usize, ok: &bool, tag: &const byte) void {
    tui_build();
    tuifa_bits(tui_frame_audit(), ok, tag);
    if tui_nrows() > rows {
        tuis_fail(tag, "整帧行数超过终端行数（屏幕外的行号会被夹到最后一行）", ok);
    }
    tuis_scan_rows(cols, ok, tag);
}

// 敌意正文：把真会话里出现过的那几类脏文本拼进 out（用 buf 拼，避免超宽字面量）。
// 往 out 追加一段字面量（只为把敌意夹具的每一行都压进行宽 80 列：
// 直接写 `_ = buf_append_cstr(out, "…" as &const byte);` 光壳子就吃掉 30 列）。
fn tuifa_ap(out: &Buf, s: &const byte) void {
    _ = buf_append_cstr(out, s);
}

// ① 不可断的长 URL（含 % 编码的 SVG，正是截图里那段 matrix(...) 的来源）
// ② CJK 表格（每格都宽，边框字符还占一整列）
// ③ 深缩进列表 + 代码围栏里的超长行
// ④ 恰好卡在末列的宽字符与 emoji（终端不能把一个宽字形劈成两半）
fn tuifa_hostile(out: &Buf) void {
    buf_reset(out);
    tuifa_ap(out, "v2.5.2_waveshare-esp32-s3-touch-amoled-" as &const byte);
    tuifa_ap(out, "1.43c.zip 3158702 https://" as &const byte);
    tuifa_ap(out, "github.com/78/xiaozhi-esp32/releases/" as &const byte);
    tuifa_ap(out, "download/v2.5.2/v2.5.2_waveshare-" as &const byte);
    tuifa_ap(out, "esp32-s3-touch-amoled-1.8-v2.zip\n" as &const byte);
    tuifa_ap(out, "style='display:block' transform=" as &const byte);
    tuifa_ap(out, "'matrix(1.22 0 0 1.22 -35.6 -23.6)'" as &const byte);
    tuifa_ap(out, "%3E%3Cg%3E%3C/g%3E%3C/svg%3E\n" as &const byte);
    tuifa_ap(out, "| 型号 | 分辨率 | 备注 |\n" as &const byte);
    tuifa_ap(out, "|---|---|---|\n" as &const byte);
    tuifa_ap(out, "| 板子甲 | 240×320 | 排线方向要反过来 |\n" as &const byte);
    tuifa_ap(out, "| 板子乙 | 466×466 | 圆屏 |\n" as &const byte);
    tuifa_ap(out, "- 一级条目：把上板/回归验证做完\n" as &const byte);
    tuifa_ap(out, "    - 二级：更新 docs/todo.md 并提交\n" as &const byte);
    tuifa_ap(out, "        - 三级：中文字段名很长很长很长很长" as &const byte);
    tuifa_ap(out, "很长很长很长很长很长很长\n" as &const byte);
    tuifa_ap(out, "```\n" as &const byte);
    tuifa_ap(out, "if (a.out_col == 0 && !a.out_wrap" as &const byte);
    tuifa_ap(out, " && b == 0x7f) { /* 超长行 */ }\n" as &const byte);
    tuifa_ap(out, "```\n" as &const byte);
    tuifa_ap(out, "汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉" as &const byte);
    tuifa_ap(out, "汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉汉🙂🙂🙂\n" as &const byte);
    tuifa_ap(out, "末尾就是一个宽字符：块\n" as &const byte);
}

// 把敌意正文灌进**所有**通道（助手/工具/思考/诊断/用户），再压一条多行输入与
// 两条待发队列条目 —— 一条路径漏了清洗/裁剪，audit 就会报出来。
fn tuifa_feed(hostile: &const byte, n: usize) void {
    betui_add_user(hostile, n);
    tui_sink_bytes(1, hostile, n);
    tui_sink_bytes(1, "\n" as &const byte, 1);
    tui_sink_bytes(2, hostile, n);
    tui_sink_bytes(3, hostile, n);
    tui_input_set(hostile, n);
    _ = tui_submit_push(hostile, n);
    _ = tui_submit_push("排队第二条：把 doc-audit 的告警清零" as &const byte, 40);
}

// ② 敌意正文 × 多尺寸：每一档都要求 audit=0 且整帧不超过终端。
fn tuifa_hostile_widths(ok: &bool, tag: &const byte) void {
    var hostile: Buf = buf_new(4096);
    defer { buf_free(&hostile); }
    tuifa_hostile(&hostile);
    const widths: [usize: 6] = [40, 60, 80, 100, 120, 200];
    var i: usize = 0;
    while i < 6 {
        const cols: usize = widths[i];
        tuis_reset(cols, 30);
        tuifa_feed(hostile.ptr as &const byte, hostile.len);
        tuifa_frame(cols, 30, ok, tag);
        i = i + 1;
    }
}

// ③ 行预算压满：任务块 + 待发块 + 2 行状态 + 10 行输入，同时在场，窄屏/矮屏。
// 这是「几块抢同一批行」的最坏情形 —— 谁多占一行，整帧就会顶出屏幕。
fn tuifa_tight_budget(ok: &bool, tag: &const byte) void {
    const sizes: [usize: 8] = [100, 30, 80, 24, 60, 16, 40, 12];
    var k: usize = 0;
    while k < 4 {
        const cols: usize = sizes[k * 2];
        const rows: usize = sizes[k * 2 + 1];
        tuis_reset(cols, rows);
        agent_tasks_fixture_demo();
        tui_set_run(TUI_RUN_TOOL, "bash -lc 'make build'" as &const byte, 21);
        // 10 行输入（面板高度上限）——占满面板行数预算
        tui_input_set(
            "第一行\n第二行\n第三行\n第四行\n第五行" as &const byte, 49);
        tui_input_set("第一行\n第二行\n第三行\n第四行\n第五行\n第六行" as &const byte, 59);
        _ = tui_submit_push("排队一" as &const byte, 9);
        _ = tui_submit_push("排队二" as &const byte, 9);
        _ = tui_submit_push("排队三" as &const byte, 9);
        tuifa_frame(cols, rows, ok, tag);
        k = k + 1;
    }
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
}

// ④ 浮层：列表浮层与帮助浮层（全屏）各一档 —— 浮层是**中途 rewind 行游标**
// 重画整屏的唯一路径，行区间最容易在这里出错。
fn tuifa_overlays(ok: &bool, tag: &const byte) void {
    const sizes: [usize: 6] = [80, 24, 60, 16, 40, 12];
    var k: usize = 0;
    while k < 3 {
        const cols: usize = sizes[k * 2];
        const rows: usize = sizes[k * 2 + 1];
        tuis_reset(cols, rows);
        betui_add_user("改一行" as &const byte, 9);
        tui_sink_bytes(1, "好，我来改。\n" as &const byte, 19);
        tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6,
            "条目一：很长的说明文字，窄屏上要按框宽折行再画" as &const byte,
            bufx_cstr_len("条目一：很长的说明文字，窄屏上要按框宽折行再画" as &const byte));
        tuifa_frame(cols, rows, ok, tag);
        tui_overlay_close();
        tui_help_open();
        tuifa_frame(cols, rows, ok, tag);
        tui_overlay_close();
        k = k + 1;
    }
}

// ⑤ 健康基线：普通一屏本来就该 audit=0（这一条是「自检不是恒报」的对照）。
fn tuifa_baseline(ok: &bool, tag: &const byte) void {
    tuis_reset(80, 24);
    tui_build();
    if tui_frame_audit() != 0 {
        tuis_fail(tag, "空态屏就报了违规（自检本身坏了？）", ok);
    }
    tuis_reset(80, 24);
    betui_add_user("把 hello.uya 的问候语改成 Hello, uya!" as &const byte, 44);
    tui_sink_bytes(1, "我先读文件。\n" as &const byte, 19);
    tui_sink_bytes(2, "✓ Read(hello.uya) · 4 lines\n" as &const byte, 29);
    tuifa_frame(80, 24, ok, tag);
}

// ⑥ 反假绿：自检必须**能报**。手工造一条超宽行、一帧超出终端行数，两位都要出来。
// 若这两条不红，说明 tui_frame_audit 是恒 0 的死代码，上面所有「绿」都不算证据。
fn tuifa_negative(ok: &bool, tag: &const byte) void {
    var long: Buf = buf_new(512);
    defer { buf_free(&long); }
    var i: usize = 0;
    while i < 200 {
        _ = buf_append_byte(&long, 32);
        i = i + 1;
    }
    // 超宽：一帧里塞一行 200 列（终端只有 40 列）
    tui_reset_all();
    tui_set_headless(true);
    tui_set_size(40, 10);
    tui_frame_begin(0, 0);
    tui_row_new();
    tui_put(long.ptr as &const byte, long.len, TUI_ST_DEFAULT);
    if (tui_frame_audit() & TUI_FV_WIDTH) == 0 {
        tuis_fail(tag, "200 列的行没被自检抓住（WIDTH 位恒 0）", ok);
    }
    // 超高：10 行终端上画 12 行
    tui_frame_begin(0, 0);
    i = 0;
    while i < 12 {
        tui_row_new();
        tui_put("x" as &const byte, 1, TUI_ST_DEFAULT);
        i = i + 1;
    }
    if (tui_frame_audit() & TUI_FV_HEIGHT) == 0 {
        tuis_fail(tag, "12 行的帧没被自检抓住（HEIGHT 位恒 0）", ok);
    }
    tui_reset_all();
}

// ⑥ 字节级钉子：进屏必须**关自动折行**（`?7l`）、退屏必须**还原**（`?7h`）。
// 这是本轮修的那条根因的两颗钉子：Linux 虚拟控制台（fbcon，用户的 Deepin tty）
// 在写屏幕右下角那一格时会**当场滚一行**（它的 terminfo 没有 `xenl`），滚过之后
// 每行内容与差分记账差整整一行，新画的字就压在旧残片上 —— 看起来就是「偶发乱码」。
// 只断言「进屏/退屏里各有那 5 个字节」：多一个少一个都算红。
fn tuifa_decawm(ok: &bool, tag: &const byte) void {
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "pipe2 失败（自动折行那两条腿没跑成）", ok);
        return;
    }
    var cap: Buf = buf_new(8192);
    defer { buf_free(&cap); }
    tui_term_enter(fds[1]);
    tuis_pipe_drain(fds[0], &cap);
    if tuis_count(&cap, "\x1b[?7l" as &const byte) != 1 {
        tuis_fail(tag, "进屏没有关自动折行（真终端写右下角会当场滚一行）", ok);
    }
    buf_reset(&cap);
    tui_term_leave(fds[1]);
    tuis_pipe_drain(fds[0], &cap);
    if tuis_count(&cap, "\x1b[?7h" as &const byte) != 1 {
        tuis_fail(tag, "退屏没有还原自动折行（退出后别的输出会糊在末列）", ok);
    }
    // 收尾：TUI 收回 headless（out_fd 归位），再关 pipe 两端
    tui_reset_all();
    _ = sys_close(fds[1]) catch {};
    _ = sys_close(fds[0]) catch {};
}

// tui-faudit 轮（P135）：帧必须放得进终端。返回 false = 本轮红；不网络。
fn tui_faudit_round(tag: &const byte) bool {
    var ok: bool = true;
    tuifa_baseline(&ok, tag);
    tuifa_hostile_widths(&ok, tag);
    tuifa_tight_budget(&ok, tag);
    tuifa_overlays(&ok, tag);
    tuifa_negative(&ok, tag);
    tuifa_decawm(&ok, tag);
    tui_reset_all();
    if ok {
        tuis_ok(tag, "帧自检恒 0（敌意正文 / 行预算 / 浮层 / 反假绿）+ 进屏 ?7l·退屏 ?7h");
    }
    return ok;
}
