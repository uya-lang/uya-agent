// src/selftest/st_view_watch.uya — selftest.uya 的拆分片 7/12（纯搬移）
//
// 本文件：P14 显示层自测：diff 渲染 + 工具内容块（逐字节断言；off 态用 fd 2 ；踩坑 35：tool_calls 序列化容量（真机踩坑）；P42：/watch —— 事件渲染 + 增量读（纯函数轮，不碰网络/终端）；P46：/watch 现役清单的「选中即跟随」——清单行 → 子代理编号（纯函数轮）；P15：子代理窗口面板（2 行/个、最多 4 个、边框每行等宽）
// 不变量：与原文件一致 —— 拆分只搬移，不改任何声明的代码；同族轮/段集中在一片里。
// 依赖：见锚点 selftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：沿用原文件前缀（本片是同一历史模块的内部拆分）。

// ============================================================
// P14 显示层自测：diff 渲染 + 工具内容块（逐字节断言；off 态用 fd 2 捕获验证「零输出」）
// ============================================================
fn vw_mk(text: &const byte) Buf {
    var b: Buf = buf_new(bufx_cstr_len(text) + 16);
    if buf_valid(&b) {
        _ = buf_append_cstr(&b, text);
    }
    return b;
}

// 把 fd 2 接到 path（返回 saved fd，-1 = 没接上）；cfd 回传打开的文件 fd
fn vw_cap_on(path: &const byte, cfd: &i32) i32 {
    cfd[0] = -1;
    const saved: i32 = sys_dup(2) catch { -1; };
    if saved < 0 {
        return -1;
    }
    const fd: i32 = sys_open(path as *const byte, (1 | 64 | 512) as i32, 420) catch { -1; };
    if fd < 0 {
        _ = sys_close(saved) catch {};
        return -1;
    }
    _ = sys_dup2(fd, 2) catch {};
    cfd[0] = fd;
    return saved;
}

// 还原 fd 2，并把捕获到的字节读回 out
fn vw_cap_off(path: &const byte, saved: i32, cfd: i32, out: &Buf) void {
    buf_reset(out);
    if cfd >= 0 {
        _ = sys_dup2(saved, 2) catch {};
        _ = sys_close(cfd) catch {};
    }
    if saved >= 0 {
        _ = sys_close(saved) catch {};
    }
    const fd: i32 = sys_open(path as *const byte, 0 as i32, 0) catch { -1; };
    if fd < 0 {
        return;
    }
    // 关键：dup2 之后 fd 2 和这个文件共用**同一个文件描述**，偏移量是一起走的 ——
    // 写完不复位就读，读回来的是「跳过前 N 字节」的内容（P15 自测在这里绕过一圈）。
    _ = sys_lseek(fd, 0, SEEK_SET) catch {};
    var tmp: [byte: 4096] = [0: 4096];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        _ = buf_append(out, &tmp[0], n as usize);
    }
    _ = sys_close(fd) catch {};
}

// P15：请求体字符串转义的纯函数轮。
// 不联网、不起服务端 —— 直接把「必须转义的字节全集」喂给 jw_str/jw_key，逐字节比对输出。
// std.json.encoder.json_write_str_view 只认 " \ \n \r \t，其余控制字节原样上线；
// 这条测试就是防止再退回那个实现（真机后果见 §16 踩坑 27）。
fn jsonesc_round(tag: &const byte) bool {
    var ok: bool = true;
    // 输入：a NUL 0x01 0x1f " \ LF TAB BS FF CR B
    var raw: [byte: 12] = [97, 0, 1, 31, 34, 92, 10, 9, 8, 12, 13, 66];
    var out: Buf = buf_new(128);
    defer { buf_free(&out); }
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_str(&w, &raw[0], 12);
    if jw_overflow(&w) {
        ty_fail(tag, "转义输出溢出", &ok);
        return ok;
    }
    out.len = jw_used(&w);
    // 期望：短转义用 \b \f \n \r \t，其余控制字节用 \u00XX（\u0000 就是 NUL）
    const want: &const byte = "\"a\\u0000\\u0001\\u001f\\\"\\\\\\n\\t\\b\\f\\rB\"";
    if !ty_buf_is(&out, want) {
        ty_fail(tag, "控制字节转义文本不对", &ok);
        out_err("[json-esc] 得到 ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    // 输出（含引号）里不允许再有裸控制字节
    var i: usize = 0;
    while i < out.len {
        if out.ptr[i] < 32 as byte {
            ty_fail(tag, "转义后的字面量里还有裸控制字节", &ok);
            break;
        }
        i = i + 1;
    }
    // key 走同一套转义，再补一个冒号
    var out2: Buf = buf_new(64);
    defer { buf_free(&out2); }
    var w2: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w2, out2.ptr, out2.cap);
    jw_key(&w2, "k");
    out2.len = jw_used(&w2);
    if !ty_buf_is(&out2, "\"k\":") {
        ty_fail(tag, "jw_key 输出不对", &ok);
    }
    // 空串 / 普通 UTF-8 中文不能被改坏
    var out3: Buf = buf_new(64);
    defer { buf_free(&out3); }
    var w3: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w3, out3.ptr, out3.cap);
    jw_str(&w3, &raw[0], 0);
    jw_str_cstr(&w3, "中文 ok");
    out3.len = jw_used(&w3);
    if !ty_buf_is(&out3, "\"\"\"中文 ok\"") {
        ty_fail(tag, "空串/中文被改坏了", &ok);
    }
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// ============================================================
// 踩坑 35：tool_calls 序列化容量（真机踩坑）
//
// 症状（用户截图那一幕）：模型给一个「参数比 8 KiB 大」的调用（写文件的正文、长 heredoc
// 的命令行），这一步直接以
//     error: out of memory serializing tool_calls
// 中止整轮 —— 内存一点问题都没有，只是当年把容量写死成 buf_new(8192)
// （见 agent.uya 的 calls_json_need）。命令行的参数刚过 8 KiB 就中招。
//
// 这一轮钉三件事：
//   1) jw_str_esc_len 与 jw_str 实际写出的字节数**逐字节相等**（转义规则一改就红）；
//   2) calls_json_need 的预算 = 实际序列化长度 + CALLS_JSON_SLACK（预算不许算少）；
//   3) 9 KiB 出头的参数：按预算分配成功，按老的固定 8192 装不下 —— 后者就是这个 bug。
// ============================================================
const CAP_TEST_CHUNKS: usize = 600;   // 16 × 600 = 9600 字节正文

// 造一段 9600 字节的正文（CAP-HEAD| + 600×16 字节 + |CAP-TAIL），钉「工具调用序列化容量」的
// 正文体量。返回 false = out 容量不够。
fn cap_test_body(out: &Buf) bool {
    if !buf_append_cstr(out, "CAP-HEAD|") {
        return false;
    }
    var i: usize = 0;
    while i < CAP_TEST_CHUNKS {
        if !buf_append_cstr(out, "0123456789abcdef") {
            return false;
        }
        i = i + 1;
    }
    return buf_append_cstr(out, "|CAP-TAIL");
}

// tool_calls 序列化容量轮（踩坑 35）：① jw_str_esc_len 与实际写出字节数逐字节相等；
// ② calls_json_need 的预算 = 实际长度 + CALLS_JSON_SLACK（不许算少）；③ 9 KiB 出头的参数要按
// 预算分配成功（老的固定 8192 装不下就是线上那个 bug）。返回 false = 本轮红。
fn toolcalls_cap_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- 1) 转义长度 vs 实际写出 ----
    // 输入：a NUL 0x01 0x1f " \ LF TAB BS FF CR B 中 !
    var raw: [byte: 16] = [97, 0, 1, 31, 34, 92, 10, 9, 8, 12, 13, 66, 228, 184, 173, 33];
    var esc: Buf = buf_new(256);
    defer { buf_free(&esc); }
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, esc.ptr, esc.cap);
    jw_str(&w, &raw[0], 16);
    esc.len = jw_used(&w);
    // 手工口径：a(1) + 三个六字节 \u00XX(18) + " \ LF TAB BS FF CR(14) + B(1) + 中(3) + !(1)
    //           + 两侧引号(2) = 40
    const esc_want: usize = 40;
    if esc.len != esc_want {
        ty_fail(tag, "用例失效：jw_str 的实际长度不是 40", &ok);
    }
    if jw_str_esc_len(&raw[0] as &const byte, 16) != esc_want {
        ty_fail(tag, "jw_str_esc_len 与实际写出长度不一致", &ok);
    }
    if jw_str_esc_len(&raw[0] as &const byte, 0) != 2 {
        ty_fail(tag, "空串的转义长度应当是 2（一对引号）", &ok);
    }

    // ---- 2) 造两个调用：第一个是 9 KiB 出头的 write，第二个专挑转义字节 ----
    // 两个元素是故意的：calls_json_need 的骨架里「元素之间的逗号」只有多元素才走得到。
    var o: ChatOut = chat_out_new();
    defer { chat_out_free(&o); }
    var body: Buf = buf_new(16384);
    defer { buf_free(&body); }
    if !cap_test_body(&body) {
        ty_fail(tag, "用例内部：正文构造失败", &ok);
        return ok;
    }
    _ = buf_append_cstr(&o.calls[0].id, "call_cap");
    _ = buf_append_cstr(&o.calls[0].name, "write");
    _ = buf_append_cstr(&o.calls[0].args, "{\"file_path\":\"note.txt\",\"content\":");
    if !jw_str_into(&o.calls[0].args, body.ptr as &const byte, body.len) {
        ty_fail(tag, "用例内部：arguments 构造失败", &ok);
        return ok;
    }
    _ = buf_append_cstr(&o.calls[0].args, "}");
    // 第二个：id/name 带引号，args 里塞 NUL / LF / TAB / 反斜杠 / 非法 UTF-8 尾巴
    var tricky: [byte: 13] = [123, 34, 97, 34, 58, 34, 10, 9, 0, 92, 34, 200, 173];
    _ = buf_append_cstr(&o.calls[1].id, "call_esc\"x");
    _ = buf_append_cstr(&o.calls[1].name, "bash");
    _ = buf_append(&o.calls[1].args, &tricky[0], 13);
    o.ncalls = 2;

    // ---- 3) 预算：必须 > 老的 8192，且与实际序列化长度严丝合缝 ----
    const need: usize = calls_json_need(&o);
    if need <= 8192 {
        ty_fail(tag, "用例失效：预算没有超过老的固定容量 8192", &ok);
    }
    // 走**生产那条路**（calls_json_make 内部算容量）：老代码这里是 buf_new(8192)，
    // 所以这一条就是那个 bug 的回归锚点 —— 谁把容量改回固定值，这一轮立刻红。
    var cj: Buf = buf_empty();
    defer { buf_free(&cj); }
    if !calls_json_make(&o, &cj) {
        ty_fail(tag, "按预算分配仍然写不下（容量没按需要算？）", &ok);
    } else {
        if cj.len + CALLS_JSON_SLACK != need {
            ty_fail(tag, "序列化长度与预算不符（预算必须精确）", &ok);
        }
        if cj.len <= 8192 {
            ty_fail(tag, "用例失效：序列化结果没超过 8192", &ok);
        }
        // 大参数的**头尾**都在：中间被截掉、尾字节被漏写都会在这里露出来
        if !contains(&cj, "CAP-HEAD|") || !contains(&cj, "|CAP-TAIL") {
            ty_fail(tag, "序列化结果里找不到大参数的标记", &ok);
        }
    }
    // 老的固定容量：必须装不下 —— 这就是那个 bug 的形状（回归的锚点）
    var small: Buf = buf_new(8192);
    defer { buf_free(&small); }
    if calls_json_from_chat(&o, &small) {
        ty_fail(tag, "8192 的固定容量居然装下了 9 KiB 参数（用例失效）", &ok);
    }

    // ---- 4) 回读：两个元素的 id/name/arguments 都必须与原文逐字节相同 ----
    // （不许二次转义、不许丢字节；只看 3) 真序列化成功的情况 —— 失败时 cj 是空的，
    //   继续往下跑只会用「不是合法 JSON」盖住真正的病因）
    if cj.len == 0 {
        if ok {
            out_err("selftest[");
            out_err(tag);
            out_err("] ok\n");
        }
        return ok;
    }
    const raw_arena: &void = malloc(1 << 20);
    if ((raw_arena as &byte) as usize) == 0 {
        ty_fail(tag, "用例内部：arena 分配失败", &ok);
        return ok;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw_arena as &byte, 1 << 20);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, cj.ptr, cj.len, &root) {
        ty_fail(tag, "序列化结果不是合法 JSON", &ok);
    } else if js_arr_len(&root) != o.ncalls {
        ty_fail(tag, "序列化结果的元素个数不对", &ok);
    } else {
        var un: Buf = buf_empty();
        defer { buf_free(&un); }
        var k: usize = 0;
        while k < o.ncalls {
            var call: JsonValue = JsonValue.json_null();
            var fnv: JsonValue = JsonValue.json_null();
            if !js_arr_get(&root, k, &call) {
                ty_fail(tag, "回读 tool_calls 元素失败", &ok);
            } else if !js_obj_get(&call, "function", 8, &fnv) {
                ty_fail(tag, "回读 function 失败", &ok);
            } else if !js_obj_get_str_unescaped(&call, "id", 2, &un) {
                ty_fail(tag, "回读 id 失败", &ok);
            } else if un.len != o.calls[k].id.len || !bufx_mem_eq(un.ptr as &const byte, o.calls[k].id.ptr as &const byte, un.len) {
                ty_fail(tag, "回读的 id 与原文不一致", &ok);
            } else if !js_obj_get_str_unescaped(&fnv, "name", 4, &un) {
                ty_fail(tag, "回读 name 失败", &ok);
            } else if un.len != o.calls[k].name.len || !bufx_mem_eq(un.ptr as &const byte, o.calls[k].name.ptr as &const byte, un.len) {
                ty_fail(tag, "回读的 name 与原文不一致", &ok);
            } else if !js_obj_get_str_unescaped(&fnv, "arguments", 9, &un) {
                ty_fail(tag, "回读 arguments 失败", &ok);
            } else if un.len != o.calls[k].args.len || !bufx_mem_eq(un.ptr as &const byte, o.calls[k].args.ptr as &const byte, un.len) {
                ty_fail(tag, "回读的 arguments 与原文不一致", &ok);
            }
            k = k + 1;
        }
    }
    free(raw_arena);

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（tool_calls 原文 ");
        out_err_dec(cj.len);
        out_err(" 字节，老的固定容量是 8192）\n");
    }
    return ok;
}

// ============================================================
// P42：/watch —— 事件渲染 + 增量读（纯函数轮，不碰网络/终端）
// ============================================================
// 一条事件行 → 渲染文本（逐字节断言）。行格式就是会话日志的真实格式
// （`{"type":…,"seq":N,"time":N,"data":{…}}`）。
fn watch_render_round(tag: &const byte) bool {
    var ok: bool = true;
    var out: Buf = buf_new(4096);
    defer { buf_free(&out); }

    // ---- 1) 步边界：step 是**数字**，必须渲染成 `[step 1]`（不是 `[step ]`）----
    var e1: Buf = vw_mk("{\"type\":\"step/start\",\"seq\":0,\"time\":1,\"data\":{\"turn\":1,\"step\":1}}");
    _ = watch_render_event(e1.ptr[0: e1.len], &out);
    if !ty_buf_is(&out, "[step 1]\n") {
        ty_fail(tag, "step/start 该渲染成 [step 1]", &ok);
        out_err("[got] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&e1);

    // ---- 2) 工具调用：`▸ <name> <args 首行>`；冷门键（description）不抢戏 ----
    buf_reset(&out);
    var e2: Buf = vw_mk("{\"type\":\"tool/call\",\"seq\":1,\"time\":2,\"data\":{\"turn\":1,\"step\":1,\"callId\":\"c1\",\"name\":\"bash\",\"arguments\":\"{\\\"command\\\": \\\"ls -la\\\"}\"}}");
    _ = watch_render_event(e2.ptr[0: e2.len], &out);
    if !ty_buf_is(&out, "▸ bash {\"command\": \"ls -la\"}\n") {
        ty_fail(tag, "tool/call 的渲染不对", &ok);
        out_err("[got] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&e2);

    // ---- 3) 工具结果：`  ← <首行>` ----
    buf_reset(&out);
    var e3: Buf = vw_mk("{\"type\":\"tool/result\",\"seq\":2,\"time\":3,\"data\":{\"turn\":1,\"step\":1,\"callId\":\"c1\",\"content\":\"CHILD_TOOL_DONE\"}}");
    _ = watch_render_event(e3.ptr[0: e3.len], &out);
    if !ty_buf_is(&out, "  ← CHILD_TOOL_DONE\n") {
        ty_fail(tag, "tool/result 的渲染不对", &ok);
        out_err("[got] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&e3);

    // ---- 4) 思考：只取首行、内部空白折叠 ----
    buf_reset(&out);
    var e4: Buf = vw_mk("{\"type\":\"assistant/reasoning\",\"seq\":3,\"time\":4,\"data\":{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"reasoning_content\":\"先看看  这个文件\\n再看下一行\"}}}");
    _ = watch_render_event(e4.ptr[0: e4.len], &out);
    if !ty_buf_is(&out, "✻ 思考 · 先看看 这个文件\n") {
        ty_fail(tag, "assistant/reasoning 该取首行并折叠空白", &ok);
        out_err("[got] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&e4);

    // ---- 5) 助手正文：`⏺ <首行>`；只有 tool_calls 的消息（content 为空）不单独出一行 ----
    buf_reset(&out);
    var e5: Buf = vw_mk("{\"type\":\"assistant/message\",\"seq\":4,\"time\":5,\"data\":{\"turn\":1,\"step\":2,\"message\":{\"role\":\"assistant\",\"content\":\"做完了\\n更多细节\"}}}");
    _ = watch_render_event(e5.ptr[0: e5.len], &out);
    if !ty_buf_is(&out, "⏺ 做完了\n") {
        ty_fail(tag, "assistant/message 该取正文首行", &ok);
        out_err("[got] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&e5);
    buf_reset(&out);
    var e5b: Buf = vw_mk("{\"type\":\"assistant/message\",\"seq\":5,\"time\":6,\"data\":{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":\"\",\"tool_calls\":[{\"id\":\"c1\"}]}}}");
    if watch_render_event(e5b.ptr[0: e5b.len], &out) || out.len != 0 {
        ty_fail(tag, "只有 tool_calls 的助手消息不该单独出一行", &ok);
    }
    buf_free(&e5b);

    // ---- 6) 无关事件（step/end）不显示；未知类型静默跳过 ----
    buf_reset(&out);
    var e6: Buf = vw_mk("{\"type\":\"step/end\",\"seq\":6,\"time\":7,\"data\":{\"turn\":1,\"step\":1}}");
    if watch_render_event(e6.ptr[0: e6.len], &out) || out.len != 0 {
        ty_fail(tag, "step/end 不该单独出一行", &ok);
    }
    buf_free(&e6);
    buf_reset(&out);
    var e7: Buf = vw_mk("{\"type\":\"完全不认识的事件\",\"seq\":7,\"time\":8,\"data\":{}}");
    if watch_render_event(e7.ptr[0: e7.len], &out) || out.len != 0 {
        ty_fail(tag, "未知事件类型该静默跳过", &ok);
    }
    buf_free(&e7);

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// 增量读：分批写文件 → 只取新增；半行不吐；一条事件刚好一行
fn watch_poll_round(tag: &const byte, ws: &const byte) bool {
    var ok: bool = true;
    // 临时目录（sess_mkdir_p 收 NUL 结尾的 C 串）
    var dir: Buf = buf_new(1200);
    defer { buf_free(&dir); }
    _ = buf_append_cstr(&dir, ws);
    _ = buf_append_cstr(&dir, "/watch_inc");
    _ = buf_append_byte(&dir, 0);
    _ = sess_mkdir_p(dir.ptr as &const byte);
    var path: Buf = buf_new(1300);
    defer { buf_free(&path); }
    _ = buf_append_cstr(&path, ws);
    _ = buf_append_cstr(&path, "/watch_inc/session.jsonl");
    // 清空重来（幂等：连跑两次结果一致）
    var pz: Buf = buf_new(path.len + 1);
    defer { buf_free(&pz); }
    _ = buf_append(&pz, path.ptr, path.len);
    _ = buf_append_byte(&pz, 0);
    const cfd: i32 = sys_open(pz.ptr as *const byte, (O_WRONLY | O_CREAT | O_TRUNC) as i32, 420) catch {
        ty_fail(tag, "建不了临时日志", &ok);
        return ok;
    };
    _ = sys_close(cfd) catch {};

    var w: Watch = watch_empty();
    defer { watch_free(&w); }
    watch_begin(&w, 0, 1, &path);

    // 第 1 批：两条完整事件
    _ = watch_append_file(pz.ptr as &const byte,
        "{\"type\":\"step/start\",\"seq\":0,\"time\":1,\"data\":{\"turn\":1,\"step\":1}}\n{\"type\":\"tool/call\",\"seq\":1,\"time\":2,\"data\":{\"turn\":1,\"step\":1,\"callId\":\"c1\",\"name\":\"bash\",\"arguments\":\"{}\"}}\n" as &const byte);
    _ = watch_poll(&w, 0);
    if !ty_buf_is(&w.rendered, "[step 1]\n▸ bash {}\n") {
        ty_fail(tag, "第一批增量读出来的文本不对", &ok);
        out_err("[got] ");
        out_err_bytes(w.rendered.ptr as &const byte, w.rendered.len);
        out_err("\n");
    }

    // 第 2 批：**半行**（没有换行）→ 一个字节都不该吐出来
    _ = watch_append_file(pz.ptr as &const byte,
        "{\"type\":\"tool/result\",\"seq\":2,\"time\":3,\"data\":{\"turn\":1,\"step\":1,\"call" as &const byte);
    _ = watch_poll(&w, 0);
    if !ty_buf_is(&w.rendered, "[step 1]\n▸ bash {}\n") {
        ty_fail(tag, "半行不该被渲染出来（会解出坏 JSON）", &ok);
    }

    // 第 3 批：补齐这一行 → 这一条才出现，且**前面两条不会重复**
    _ = watch_append_file(pz.ptr as &const byte,
        "Id\":\"c1\",\"content\":\"OK\"}}\n" as &const byte);
    _ = watch_poll(&w, 0);
    if !ty_buf_is(&w.rendered, "[step 1]\n▸ bash {}\n  ← OK\n") {
        ty_fail(tag, "补齐半行之后应当只追加这一条", &ok);
        out_err("[got] ");
        out_err_bytes(w.rendered.ptr as &const byte, w.rendered.len);
        out_err("\n");
    }

    // 第 4 批：再读一次（没有新字节）→ 内容必须一个字节都不变
    const before: usize = w.rendered.len;
    _ = watch_poll(&w, 0);
    if w.rendered.len != before {
        ty_fail(tag, "没有新内容时不该重复渲染", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// ============================================================
// P46：/watch 现役清单的「选中即跟随」——清单行 → 子代理编号（纯函数轮）
// ============================================================
// 清单行就是 agent_watch_list 打出来的那一行（两空格缩进 + `sub-N` + `[状态]` + 标签）。
// 这一轮只钉「认编号」这一件事：表头里也有 `sub-`，空态行、面板那种前缀都不认。
fn watch_pick_round(tag: &const byte) bool {
    var ok: bool = true;
    var id: Buf = buf_new(16);
    defer { buf_free(&id); }

    // ---- 1) 代理行：取行首那个编号，两位数要整段取出 ----
    var l1: Buf = vw_mk("  sub-1 [running] watch 实时性验收");
    if !watch_line_id(l1.ptr as &const byte, l1.len, &id) || !ty_buf_is(&id, "1") {
        ty_fail(tag, "`  sub-1 [running] …` 该认出编号 1", &ok);
    }
    buf_free(&l1);
    var l2: Buf = vw_mk("  sub-12 [idle] 标签里还有个 sub-3");
    if !watch_line_id(l2.ptr as &const byte, l2.len, &id) || !ty_buf_is(&id, "12") {
        ty_fail(tag, "两位数编号要整段取出来，标签里的 sub-3 不许抢先", &ok);
    }
    buf_free(&l2);
    var l3: Buf = vw_mk("\tsub-7");
    if !watch_line_id(l3.ptr as &const byte, l3.len, &id) || !ty_buf_is(&id, "7") {
        ty_fail(tag, "制表符缩进 + 行尾没有状态段也该认", &ok);
    }
    buf_free(&l3);

    // ---- 2) 表头：`sub-N` 的 N 不是数字 ⇒ 不认（这是表头与代理行唯一的分界线）----
    var h: Buf = vw_mk("[watch] 现役子代理（/watch sub-N 跟随，/watch off 停）：");
    if watch_line_id(h.ptr as &const byte, h.len, &id) {
        ty_fail(tag, "清单表头被当成代理行了（回车会去跟随一个不存在的编号）", &ok);
    }
    buf_free(&h);
    // ---- 3) 空态行 / 别的前缀 / `sub-1x` ----
    var n1: Buf = vw_mk("  （没有正在跑的子代理）");
    if watch_line_id(n1.ptr as &const byte, n1.len, &id) {
        ty_fail(tag, "空态行不该认出编号", &ok);
    }
    buf_free(&n1);
    var n2: Buf = vw_mk("  ● sub-1 [subagent]");
    if watch_line_id(n2.ptr as &const byte, n2.len, &id) {
        ty_fail(tag, "行首不是 sub- 就不认（面板那一列不是清单行）", &ok);
    }
    buf_free(&n2);
    var n3: Buf = vw_mk("  sub-1x [running]");
    if watch_line_id(n3.ptr as &const byte, n3.len, &id) {
        ty_fail(tag, "sub-1x 不是编号", &ok);
    }
    buf_free(&n3);

    // ---- 4) 认出来的编号必须能过 deleg_id_parse（清单那条路与 /watch sub-N 同口径）----
    var l4: Buf = vw_mk("  sub-3 [running] x");
    var pid: i32 = -1;
    if !watch_line_id(l4.ptr as &const byte, l4.len, &id) || !deleg_id_parse(&id, &pid) || pid != 3 {
        ty_fail(tag, "认出的编号过不了 deleg_id_parse（/watch 那条路会当场拒掉它）", &ok);
    }
    buf_free(&l4);

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// 往文件追加一段文本（O_APPEND；测试辅助）
fn watch_append_file(pathz: &const byte, text: &const byte) bool {
    const fd: i32 = sys_open(pathz, (O_WRONLY | O_CREAT | O_APPEND) as i32, 420) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    return write_all_fd(fd, text, bufx_cstr_len(text));
}

// 显示层 diff 渲染轮（P14）：工具内容块与 diff 的逐字节断言，off 态用 fd 2 捕获验证「零输出」。
// 返回 false = 本轮红；不碰 git、不碰 TUI。
fn diffx_round(tag: &const byte) bool {
    var ok: bool = true;
    var out: Buf = buf_new(16384);
    defer { buf_free(&out); }
    var a: usize = 0;
    var r: usize = 0;

    // ---- 1) 新旧一样 → 空 ----
    var e1: Buf = vw_mk("a\nb\nc\n");
    var e2: Buf = vw_mk("a\nb\nc\n");
    const e1v: &[byte] = e1.ptr[0: e1.len];
    const e2v: &[byte] = e2.ptr[0: e2.len];
    diffx_render_ex(&out, e1v, e2v, 6, 72, &a, &r);
    if out.len != 0 {
        ty_fail(tag, "相同内容不该产生 diff", &ok);
    }
    buf_free(&e1);
    buf_free(&e2);

    // ---- 2) 中间一行改动：前后 2 行上下文 + -/+ ----
    var f1: Buf = vw_mk("a\nb\nc\nd\ne\n");
    var f2: Buf = vw_mk("a\nb\nX\nd\ne\n");
    const f1v: &[byte] = f1.ptr[0: f1.len];
    const f2v: &[byte] = f2.ptr[0: f2.len];
    diffx_render_ex(&out, f1v, f2v, 6, 72, &a, &r);
    if !ty_buf_is(&out, "      a\n      b\n    - c\n    + X\n      d\n      e\n") {
        ty_fail(tag, "单行改动的 diff 文本不对", &ok);
        out_err("[diff] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    if a != 1 || r != 1 {
        ty_fail(tag, "单行改动的增删计数不对", &ok);
    }
    buf_free(&f1);
    buf_free(&f2);

    // ---- 3) 新文件（旧内容为空）→ 全是 + ----
    var g1: Buf = vw_mk("");
    var g2: Buf = vw_mk("x\ny\n");
    const g1v: &[byte] = g1.ptr[0: g1.len];
    const g2v: &[byte] = g2.ptr[0: g2.len];
    diffx_render_ex(&out, g1v, g2v, 6, 72, &a, &r);
    if !ty_buf_is(&out, "    + x\n    + y\n") || a != 2 || r != 0 {
        ty_fail(tag, "新文件的 diff 应该全是 +", &ok);
    }
    buf_free(&g1);
    buf_free(&g2);

    // ---- 4) 整体重写（两侧都 > 60 行）→ 只给精确汇总 ----
    var h1: Buf = buf_new(2048);
    var h2: Buf = buf_new(2048);
    var i: usize = 0;
    while i < 100 {
        _ = buf_append_cstr(&h1, "old line\n");
        _ = buf_append_cstr(&h2, "new line\n");
        i = i + 1;
    }
    const h1v: &[byte] = h1.ptr[0: h1.len];
    const h2v: &[byte] = h2.ptr[0: h2.len];
    diffx_render_ex(&out, h1v, h2v, 6, 72, &a, &r);
    if !ty_buf_is(&out, "    - (100 行旧内容)\n    + (100 行新内容)\n") || a != 100 || r != 100 {
        ty_fail(tag, "大改写的汇总行不对", &ok);
        out_err("[diff] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&h1);
    buf_free(&h2);

    // ---- 5) 头截断：60 行编辑脚本 → 只留 24 行 + 省略标记 ----
    var k1: Buf = buf_new(1024);
    var k2: Buf = buf_new(1024);
    i = 0;
    while i < 30 {
        _ = buf_append_cstr(&k1, "a");
        _ = buf_append_u64(&k1, i as u64);
        _ = buf_append_byte(&k1, 10);
        _ = buf_append_cstr(&k2, "b");
        _ = buf_append_u64(&k2, i as u64);
        _ = buf_append_byte(&k2, 10);
        i = i + 1;
    }
    const k1v: &[byte] = k1.ptr[0: k1.len];
    const k2v: &[byte] = k2.ptr[0: k2.len];
    diffx_render_ex(&out, k1v, k2v, 6, 72, &a, &r);
    if a != 30 || r != 30 {
        ty_fail(tag, "30 行改写的增删计数不对", &ok);
    }
    if view_count_lines(out.ptr as &const byte, out.len) != 25 {
        ty_fail(tag, "头截断后应该正好 24 行 diff + 1 行省略标记", &ok);
    }
    if !contains(&out, "… (省略 36 行)") {
        ty_fail(tag, "头截断缺少「省略 36 行」标记", &ok);
    }
    buf_free(&k1);
    buf_free(&k2);

    // ---- 6) 一行都不改但末尾多一个换行 ----
    var l1: Buf = vw_mk("a\nb");
    var l2: Buf = vw_mk("a\nb\n");
    const l1v: &[byte] = l1.ptr[0: l1.len];
    const l2v: &[byte] = l2.ptr[0: l2.len];
    diffx_render_ex(&out, l1v, l2v, 6, 72, &a, &r);
    if out.len != 0 {
        ty_fail(tag, "只差结尾换行不该产生 diff", &ok);
    }
    buf_free(&l1);
    buf_free(&l2);

    // ---- 7) 显示列截断（宽字符按 2 列算，不砍半个字）----
    var wide: Buf = vw_mk("中文abc");
    const wv: &const byte = wide.ptr as &const byte;
    const keep4: usize = tty_clip_bytes(wv, wide.len, 4);
    if keep4 != 6 {
        ty_fail(tag, "按列截断：两个汉字（4 列）应保留 6 字节", &ok);
    }
    const keepall: usize = tty_clip_bytes(wv, wide.len, 100);
    if keepall != wide.len {
        ty_fail(tag, "按列截断：不超预算时应原样返回", &ok);
    }
    // P16：从尾部保留（思考行滚动显示用它 —— 屏幕上只留最新的一段）
    const tail4: usize = tty_clip_tail_bytes(wv, wide.len, 4);
    if tail4 != 3 {
        ty_fail(tag, "尾部按列截断：4 列装不下 '文'（2 列），应只保留 'abc' 3 字节", &ok);
    }
    if !bufx_mem_eq(&wv[wide.len - tail4], "abc", 3) {
        ty_fail(tag, "尾部按列截断保留的不是最后 3 个字节 'abc'", &ok);
    }
    const tail5: usize = tty_clip_tail_bytes(wv, wide.len, 5);
    if tail5 != 6 {
        ty_fail(tag, "尾部按列截断：5 列 = '文'（2 列）+ 'abc'（3 列）共 6 字节", &ok);
    }
    const tailall: usize = tty_clip_tail_bytes(wv, wide.len, 100);
    if tailall != wide.len {
        ty_fail(tag, "尾部按列截断：不超预算时应原样返回", &ok);
    }
    // 坏字节：孤续字节 0x80 落在 C1 控制区（0 列），半截 3 字节序列按 U+FFFD（1 列）。
    // 关键是「一定前进、结果不超预算」，不是具体留几个字节。
    const lone: [byte: 1] = [0x80];
    if tty_clip_tail_bytes(&lone[0], 1, 1) != 1 {
        ty_fail(tag, "尾部按列截断：0 列宽的坏字节也要留下（否则指针不前进）", &ok);
    }
    const half: [byte: 2] = [0xE4, 0xB8];       // 少了最后一字节的 3 字节序列
    if tty_clip_tail_bytes(&half[0], 2, 1) != 2 {
        ty_fail(tag, "尾部按列截断：半截序列按 1 列算，2 字节都留", &ok);
    }
    if tty_clip_tail_bytes(&half[0], 2, 0) != 0 {
        ty_fail(tag, "尾部按列截断：预算为 0 时一个字节都不留", &ok);
    }
    buf_free(&wide);

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// 把面板文本按「行」打印出来（换行换成 |，便于在自测输出里肉眼看对齐）
fn win_dump_lines(b: &const Buf) void {
    out_err("[panel] len=");
    out_err_dec(b.len);
    out_err(" lines=");
    out_err_dec(view_count_lines(b.ptr as &const byte, b.len));
    out_err("\n");
    var i: usize = 0;
    var k: usize = 0;
    while i < b.len {
        const nl: isize = bufx_find_byte(b.ptr[0: b.len], 10 as byte, i);
        var stop: usize = b.len;
        var last: bool = true;
        if nl >= 0 {
            stop = nl as usize;
            last = false;
        }
        out_err("  ");
        out_err_dec(k);
        out_err(" cols=");
        out_err_dec(tty_cols_between(b.ptr as &const byte, i, stop));
        out_err(" bytes=");
        out_err_dec(stop - i);
        out_err(" last=");
        if (stop - i) > 0 {
            out_err_dec(b.ptr[stop - 1] as usize);
        }
        out_err(" <");
        out_err_bytes(b.ptr + i, stop - i);
        out_err(">\n");
        k = k + 1;
        if last {
            i = b.len;
        } else {
            i = stop + 1;
        }
    }
}

// ============================================================
// P15：子代理窗口面板（2 行/个、最多 4 个、边框每行等宽）
// ============================================================
fn win_add(t: &DelegTable, i: usize, id: i32, kind: u8, st: u8, secs_ago: u64, label: &const byte, prompt: &const byte, outline: &const byte) void {
    const si: usize = i;
    if si >= DELEG_MAX {
        return;
    }
    t.items[si].used = true;
    t.items[si].id = id;
    t.items[si].kind = kind;
    t.items[si].pid = -1;
    t.items[si].fd = -1;
    t.items[si].status = st;
    t.items[si].code = 0;
    t.items[si].reaped = true;          // 不真 fork：只测显示
    t.items[si].read_off = 0;
    t.items[si].rounds = 0;
    t.items[si].max_rounds = 0;
    t.items[si].ended_noted = false;
    const now: u64 = ua_now_ms();
    if secs_ago > 0 && now > secs_ago * (1000 as u64) {
        t.items[si].started_ms = now - (secs_ago * (1000 as u64));
    } else {
        t.items[si].started_ms = now;
    }
    t.items[si].label = buf_new(bufx_cstr_len(label) + 8);
    _ = buf_append_cstr(&t.items[si].label, label);
    t.items[si].prompt = buf_new(bufx_cstr_len(prompt) + 8);
    _ = buf_append_cstr(&t.items[si].prompt, prompt);
    t.items[si].sid = buf_empty();
    t.items[si].objective = buf_empty();
    t.items[si].buf = buf_empty();
    if bufx_cstr_len(outline) > 0 {
        t.items[si].buf = buf_new(256);
        _ = buf_append_cstr(&t.items[si].buf, outline);
    }
}

// 面板每一行的显示列数是否完全相等（边框不能错位 —— 就是这条断言守着）
fn win_cols_uniform(b: &const Buf, out: &usize) bool {
    if b.len == 0 {
        return false;
    }
    const data: &[byte] = b.ptr[0: b.len];
    var i: usize = 0;
    var w0: usize = 0;
    var k: usize = 0;
    while i < b.len {
        const nl: isize = bufx_find_byte(data, 10 as byte, i);
        var stop: usize = b.len;
        var last: bool = true;
        if nl >= 0 {
            stop = nl as usize;
            last = false;
        }
        const w: usize = tty_cols_between(b.ptr as &const byte, i, stop);
        if k == 0 {
            w0 = w;
        } else if w != w0 {
            return false;
        }
        k = k + 1;
        if last {
            i = b.len;
        } else {
            i = stop + 1;
        }
    }
    out[0] = w0;
    return k > 0;
}

// 子代理面板的宽度断言用「确定性的终端宽度」，不要用跑测试这台机器的 tty 宽度 ——
// 老实现写死 78 列，那是「80 列的终端」下的期望值；在 213 列的终端里跑就必然红
// （而它跟被测逻辑一点关系都没有）。这里自己钉死 80 列，再把期望值算出来。
fn win_width_init() void {
    tty_init(&tty_ui, 0);
    tty_ui.is_tty = true;
    tty_ui.cols = 80;
}

// 80 列的终端下面板总列宽（= tty_body_width - tui 侧留白）
fn win_expected_cols() usize {
    return 78;
}

// 子代理窗口面板轮（P15）：2 行/个、最多 4 个、边框每行等宽（80 列下总宽 78）。
// 夹具直接装 DelegTable，不 poll 不写屏；返回 false = 本轮红。
fn win_round(tag: &const byte) bool {
    var ok: bool = true;
    var txt: Buf = buf_new(8192);
    defer { buf_free(&txt); }
    var t: DelegTable = DelegTable{ items: [], next_id: 1 };
    deleg_init(&t);
    defer { deleg_free(&t); }

    view_init(true, 6);
    win_width_init();

    // ---- A0) buf 原语：字面量必须逐字节落进缓冲区（这里抓过「标题里混进随机字节」）----
    {
        var pb: Buf = buf_new(8);          // 故意给很小：逼出 realloc 路径
        _ = buf_append_cstr(&pb, "agent ");
        _ = buf_append_u64(&pb, 1);
        _ = buf_append_cstr(&pb, "/4");
        if pb.len != 9 || !bufx_mem_eq(pb.ptr as &const byte, "agent 1/4" as &const byte, 9) {
            ty_fail(tag, "buf 原语拼出来的字面量不对", &ok);
        }
        buf_free(&pb);
    }

    // ---- A) 空表：没有窗口可显示 ----
    if view_agents_text(&t, &txt) {
        ty_fail(tag, "空表不该产出面板", &ok);
    }
    if txt.len != 0 {
        ty_fail(tag, "空表时输出必须清空", &ok);
    }

    // ---- B) 混合状态：只有 running 进面板，最多 4 个 ----
    win_add(&t, 0, 1, DELEG_KIND_SUB, DELEG_RUNNING, 3, "审计 deleg 的等待循环与 fork/exec 差异",
            "检查 1030-1120 行的 fork/exec 差异", "l1
l2
");
    win_add(&t, 1, 2, DELEG_KIND_RALPH, DELEG_RUNNING, 12, "ralph loop",
            "Round 2 of 4. Objective: 把骨架补齐", "r1
");
    win_add(&t, 2, 3, DELEG_KIND_SUB, DELEG_DONE, 27, "已经跑完的（不该出现）", "不该出现的预览", "");
    win_add(&t, 3, 4, DELEG_KIND_SUB, DELEG_FAILED, 40, "失败窗口（不该出现）", "不该出现的预览", "");
    if !view_agents_text(&t, &txt) {
        ty_fail(tag, "有两个运行中的子代理，必须产出面板", &ok);
    }
    if !contains(&txt, "sub-1") || !contains(&txt, "sub-2") {
        ty_fail(tag, "运行中的两个窗口都要在面板里", &ok);
    }
    if contains(&txt, "sub-3") || contains(&txt, "sub-4") {
        ty_fail(tag, "跑完/失败的窗口不该留在面板里（跑完即隐）", &ok);
    }
    if !contains(&txt, "● running") || !contains(&txt, "[subagent]") || !contains(&txt, "[ralph]") {
        ty_fail(tag, "状态字形与种类标注不对", &ok);
    }
    if !contains(&txt, "· 2 ·") {
        ty_fail(tag, "状态行少了「已收输出行数」", &ok);
    }
    if !ty_starts(&txt, "┌─ agents ") {
        ty_fail(tag, "面板首行应该是带标题的上边框", &ok);
    }
    if !ty_ends(&txt, "┘\n" as &const byte, 4) {
        ty_fail(tag, "面板末行应该是底框", &ok);
    }
    var w0: usize = 0;
    if !win_cols_uniform(&txt, &w0) {
        ty_fail(tag, "面板每一行的显示列数必须完全相等（边框不能错位）", &ok);
    } else if w0 != win_expected_cols() {
        ty_fail(tag, "面板宽度应该是显示宽 - 2 = 78 列", &ok);
        out_err("[w0] ");
        out_err_dec(w0);
        out_err("\n");
    }
    if view_count_lines(txt.ptr as &const byte, txt.len) != 6 {
        ty_fail(tag, "两个窗口的面板应该是 6 行（1 标题 + 2×2 内容 + 1 底框）", &ok);
    }

    // ---- C) 表满 + 只有一个 running：标题写成 agents 1/N，面板 4 行 ----
    t.items[1].status = DELEG_DONE;
    if !view_agents_text(&t, &txt) {
        ty_fail(tag, "还剩一个运行中的窗口", &ok);
    }
    if contains(&txt, "sub-2") {
        ty_fail(tag, "跑完的窗口必须立刻从面板消失", &ok);
    }
    if !contains(&txt, "agent 1/4") {
        ty_fail(tag, "标题应写明「运行中/总数」", &ok);
    }
    if view_count_lines(txt.ptr as &const byte, txt.len) != 4 {
        ty_fail(tag, "单个窗口的面板应该是 4 行", &ok);
    }
    var w1: usize = 0;
    if !win_cols_uniform(&txt, &w1) || w1 != win_expected_cols() {
        ty_fail(tag, "单个窗口时每行也要等宽 78 列", &ok);
    }

    // ---- C2) 秒数：窗口文本必须随「已跑时长」变（1Hz 重画的依据）----
    {
        var t2: DelegTable = DelegTable{ items: [], next_id: 1 };
        deleg_init(&t2);
        win_add(&t2, 0, 7, DELEG_KIND_SUB, DELEG_RUNNING, 1, "beats", "tick", "");
        // 直接改 started_ms：把它推到「刚刚 3 秒前」，再渲染
        t2.items[0].started_ms = ua_now_ms() - (3 as u64) * (1000 as u64);
        var a1: Buf = buf_new(2048);
        _ = view_agents_text(&t2, &a1);
        if !contains(&a1, "3s") {
            ty_fail(tag, "面板状态行应显示已跑 3s", &ok);
            win_dump_lines(&a1);
        }
        t2.items[0].started_ms = ua_now_ms() - (9 as u64) * (1000 as u64);
        var a2: Buf = buf_new(2048);
        _ = view_agents_text(&t2, &a2);
        if !contains(&a2, "9s") {
            ty_fail(tag, "面板状态行应显示已跑 9s（秒数在跳）", &ok);
            win_dump_lines(&a2);
        }
        if a1.len == a2.len && bufx_mem_eq(a1.ptr as &const byte, a2.ptr as &const byte, a1.len) {
            ty_fail(tag, "秒数变化必须改变面板文本（否则 1Hz 重画不会发生）", &ok);
        }
        buf_free(&a1);
        buf_free(&a2);
        deleg_free(&t2);
    }

    // ---- D) 超长中文标签 + 超长预览：截断后每行仍然等宽 ----
    win_add(&t, 1, 5, DELEG_KIND_SUB, DELEG_RUNNING, 127,
            "审计一个名字特别特别长的子代理描述描述描述描述描述描述描述描述描述描述描述",
            "很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览",
            "");
    if !view_agents_text(&t, &txt) {
        ty_fail(tag, "超长内容也要能出面板", &ok);
    }
    var w2: usize = 0;
    if !win_cols_uniform(&txt, &w2) || w2 != win_expected_cols() {
        ty_fail(tag, "超长中文下每行仍须等宽 78 列", &ok);
    }
    if !contains(&txt, "…") {
        ty_fail(tag, "超长内容必须按列截断并补 …", &ok);
    }
    if !contains(&txt, "2m07s") && !contains(&txt, "2m06s") && !contains(&txt, "2m08s") {
        ty_fail(tag, "127 秒应该显示成 2m07s 这种「分+秒」格式", &ok);
    }

    // ---- E) 秒数格式：<60s 是 Ns、≥1h 是 Nm+、字段宽度恒定 ----
    var sb: Buf = buf_new(32);
    defer { buf_free(&sb); }
    view_ag_secs(&sb, 1, 1 + 3 * (1000 as u64));
    if !ty_buf_is(&sb, "3s") {
        ty_fail(tag, "3 秒应显示 3s", &ok);
    }
    view_ag_secs(&sb, 1, 1 + 65 * (1000 as u64));
    if !ty_buf_is(&sb, "1m05s") {
        ty_fail(tag, "65 秒应显示 1m05s", &ok);
    }
    view_ag_secs(&sb, 1, 1 + (4000 as u64) * (1000 as u64));
    if !ty_buf_is(&sb, "59m+") {
        ty_fail(tag, "超过 1 小时应显示 59m+", &ok);
    }
    if tty_cols_between("  12s" as &const byte, 0, 5) != 5 || tty_cols_between("1m05s" as &const byte, 0, 5) != 5 {
        ty_fail(tag, "秒数字段必须是固定 5 列（否则后面的 · 会左右横跳）", &ok);
    }

    // ---- E2) 走「活」路径：view_agents_sync → 面板块 → tty_draw_line 真画一帧 ----
    {
        tty_init(&tty_ui, 0);
        tty_ui.is_tty = true;
        tty_ui.raw = true;
        tty_ui.cols = 100;                 // 面板宽 = 100 - 2 = 98
        tty_set_block_provider(&tty_ui, true);
        tty_set_prompt(&tty_ui, "[step 1] > ");
        tty_line_clear(&tty_ui);
        var live: DelegTable = DelegTable{ items: [], next_id: 1 };
        deleg_init(&live);
        win_add(&live, 0, 11, DELEG_KIND_SUB, DELEG_RUNNING, 3, "活路径", "验证秒数进了面板块", "");
        live.items[0].started_ms = ua_now_ms() - (3 as u64) * (1000 as u64);
        if !view_agents_sync(&live) {
            ty_fail(tag, "第一次同步必须把面板推给 tty", &ok);
        }
        if tty_block_len() == 0 {
            ty_fail(tag, "同步后面板块里应该有内容", &ok);
        }
        var tpath: [byte: 64] = "build/selftest_panel_live.txt";
        const tp2: &const byte = &tpath[0] as &const byte;
        var lcfd: i32 = -1;
        var lcap: Buf = buf_new(16384);
        defer { buf_free(&lcap); }
        const lsaved: i32 = vw_cap_on(tp2, &lcfd);
        tty_draw_line(&tty_ui, 2);
        vw_cap_off(tp2, lsaved, lcfd, &lcap);
        if !contains(&lcap, "3s") {
            ty_fail(tag, "活路径画出来的帧里应该有 3s", &ok);
        }
        if !contains(&lcap, "sub-11") {
            ty_fail(tag, "活路径画出来的帧里应该有 sub-11", &ok);
        }
        // 每一行（去掉擦除序列后）必须正好 98 列
        var bad: bool = false;
        var li: usize = 0;
        while li < lcap.len {
            const nl2: isize = bufx_find_byte(lcap.ptr[0: lcap.len], 10 as byte, li);
            var stop2: usize = lcap.len;
            var last2: bool = true;
            if nl2 >= 0 {
                stop2 = nl2 as usize;
                last2 = false;
            }
            const ln2: usize = stop2 - li;
            if ln2 > 0 && lcap.ptr[li] == 226 as byte {
                if tty_cols_between(lcap.ptr as &const byte, li, stop2) != 98 {
                    bad = true;
                }
            }
            if last2 {
                li = lcap.len;
            } else {
                li = stop2 + 1;
            }
        }
        if bad {
            ty_fail(tag, "活路径画出来的面板行不都是 98 列", &ok);
        }
        tty_set_block_provider(&tty_ui, false);
        tty_free(&tty_ui);
        tty_init(&tty_ui, 0);
        deleg_free(&live);
    }

    // ---- G) P40：状态行里的消息预览**贴尾**（`…` + 最新的一段），锚那半截不许被挤掉 ----
    {
        // G1) 纯函数 view_ag_msg：放得下原样给；放不下前置 `…` 后留**尾部**；宽字符按显示列算
        var p40_mb: Buf = buf_new(256);
        defer { buf_free(&p40_mb); }
        const p40_ascii: &const byte = "0123456789" as &const byte;
        const p40_ascii_n: usize = bufx_cstr_len(p40_ascii);
        buf_reset(&p40_mb);
        view_ag_msg(&p40_mb, p40_ascii, p40_ascii_n, p40_ascii_n);
        if !ty_buf_is(&p40_mb, "0123456789") {
            ty_fail(tag, "P40：消息放得下时必须一个字节都不截", &ok);
        }
        buf_reset(&p40_mb);
        view_ag_msg(&p40_mb, p40_ascii, p40_ascii_n, 5);
        if !ty_buf_is(&p40_mb, "…6789") {
            ty_fail(tag, "P40：消息超宽时必须前置 `…` 后留**最新**一段（…6789）", &ok);
            out_err("[msg] ");
            out_err_bytes(p40_mb.ptr as &const byte, p40_mb.len);
            out_err("\n");
        }
        // CJK：1 字 = 3 字节 = 2 列。5 列预算 = `…` + 两个字（4 列）—— 不能留半个汉字
        const p40_cjk: &const byte = "很长的消息" as &const byte;
        buf_reset(&p40_mb);
        view_ag_msg(&p40_mb, p40_cjk, bufx_cstr_len(p40_cjk), 5);
        if !ty_buf_is(&p40_mb, "…消息") {
            ty_fail(tag, "P40：宽字符必须按显示列贴尾（…消息）", &ok);
            out_err("[msg] ");
            out_err_bytes(p40_mb.ptr as &const byte, p40_mb.len);
            out_err("\n");
        }
        // 只剩 1 列（连 `…` 都放不下）或 0 列：一个字节都不写，这一列留给补空格
        buf_reset(&p40_mb);
        view_ag_msg(&p40_mb, p40_ascii, p40_ascii_n, 1);
        if p40_mb.len != 0 {
            ty_fail(tag, "P40：只剩 1 列时消息预览必须一个字节都不写", &ok);
        }
        buf_reset(&p40_mb);
        view_ag_msg(&p40_mb, p40_ascii, p40_ascii_n, 0);
        if p40_mb.len != 0 {
            ty_fail(tag, "P40：预算为 0 时消息预览必须一个字节都不写", &ok);
        }
        buf_reset(&p40_mb);
        view_ag_msg(&p40_mb, p40_ascii, 0, 8);
        if p40_mb.len != 0 {
            ty_fail(tag, "P40：空消息不该产生任何输出", &ok);
        }

        // G2) 纯函数 view_ag_preview：只看第一行、空白折叠；超长**从头部丢**并前置 `…`
        var p40_pv: Buf = buf_new(1024);
        defer { buf_free(&p40_pv); }
        const p40_multi: &const byte = "第一行   有   空格\n第二行不该出现" as &const byte;
        view_ag_preview(&p40_pv, p40_multi, bufx_cstr_len(p40_multi));
        if !ty_buf_is(&p40_pv, "第一行 有 空格") {
            ty_fail(tag, "P40：预览只取第一行并把空白折叠成单空格", &ok);
            out_err("[preview] ");
            out_err_bytes(p40_pv.ptr as &const byte, p40_pv.len);
            out_err("\n");
        }
        // 字节上限：400 个 ASCII 字符 → 留最后 VIEW_AG_MSG_MAX 字节 + 前置 `…`
        var p40_long: Buf = buf_new(512);
        defer { buf_free(&p40_long); }
        var p40_k: usize = 0;
        while p40_k < 400 {
            _ = buf_append_byte(&p40_long, 120 as byte);
            p40_k = p40_k + 1;
        }
        view_ag_preview(&p40_pv, p40_long.ptr as &const byte, p40_long.len);
        if !ty_starts(&p40_pv, "…") {
            ty_fail(tag, "P40：超长消息的预览必须以 `…` 开头（头部被丢掉）", &ok);
        }
        if p40_pv.len > VIEW_AG_MSG_MAX + 3 || p40_pv.len < VIEW_AG_MSG_MAX {
            ty_fail(tag, "P40：超长消息的预览必须收在 VIEW_AG_MSG_MAX 字节附近", &ok);
            out_err("[preview len] ");
            out_err_dec(p40_pv.len);
            out_err("\n");
        }
        // 同一件事用 CJK 再做一遍：360 字节的「消息」×60 —— 丢头必须落在**字符边界**上
        var p40_cjkl: Buf = buf_new(512);
        defer { buf_free(&p40_cjkl); }
        var p40_k2: usize = 0;
        const p40_cjk2: &const byte = "消息" as &const byte;
        while p40_k2 < 60 {
            _ = buf_append(&p40_cjkl, p40_cjk2, bufx_cstr_len(p40_cjk2));
            p40_k2 = p40_k2 + 1;
        }
        if p40_cjkl.len != 360 {
            ty_fail(tag, "P40：CJK 夹具应当是 360 字节（60 × 「消息」）", &ok);
        }
        view_ag_preview(&p40_pv, p40_cjkl.ptr as &const byte, p40_cjkl.len);
        if !ty_starts(&p40_pv, "…") || !ty_ends(&p40_pv, "消息" as &const byte, 6) {
            ty_fail(tag, "P40：CJK 超长消息的预览要「… + 最新的一段」", &ok);
        }
        if p40_pv.len < 4 || ((p40_pv.len - 3) % (3 as usize)) != 0 {
            ty_fail(tag, "P40：丢掉头部时不能停在半个汉字上（留下的必须是整数个 CJK 字符）", &ok);
            out_err("[preview len] ");
            out_err_dec(p40_pv.len);
            out_err("\n");
        }

        // G3) 整块面板：状态行 = 锚（原样）+ 贴尾的消息（用真机上那一幕：一条两百来字节的催促）
        var p40_t: DelegTable = DelegTable{ items: [], next_id: 1 };
        deleg_init(&p40_t);
        defer { deleg_free(&p40_t); }
        win_width_init();                        // 80 列终端 → 面板 78 列
        const p40_msg: &const byte = "Your output was still far too verbose: 325 lines / 68 KB, with bullets 500+ characters long. The target was 15-20% of the original (about 20-25 KB). Do a second pass and cut it to under 25 KB." as &const byte;
        win_add(&p40_t, 0, 41, DELEG_KIND_SUB, DELEG_RUNNING, 53,
                "Condense code structure section (continued)" as &const byte, p40_msg, "" as &const byte);
        var p40_txt3: Buf = buf_new(4096);
        defer { buf_free(&p40_txt3); }
        if !view_agents_text(&p40_t, &p40_txt3) {
            ty_fail(tag, "P40：带长消息的运行中窗口必须能出面板", &ok);
        }
        // 锚那半截：字形、状态、秒数、已收行数——一个都不许被消息挤掉
        if !contains(&p40_txt3, "● running") || !contains(&p40_txt3, "53s") || !contains(&p40_txt3, "· 0 ·") {
            ty_fail(tag, "P40：状态行的锚（字形/状态/秒数/已收行数）被消息挤掉了", &ok);
            win_dump_lines(&p40_txt3);
        }
        // 贴尾：最新那半句看得见，开头已经让位
        if !contains(&p40_txt3, "…KB). Do a second pass and cut it to under 25 KB.") {
            ty_fail(tag, "P40：消息的最新一段必须出现在面板里（贴尾失效）", &ok);
            win_dump_lines(&p40_txt3);
        }
        if contains(&p40_txt3, "Your output was still") {
            ty_fail(tag, "P40：面板里还留着消息开头 —— 那是「贴左」的老口径", &ok);
            win_dump_lines(&p40_txt3);
        }
        var p40_w3: usize = 0;
        if !win_cols_uniform(&p40_txt3, &p40_w3) || p40_w3 != win_expected_cols() {
            ty_fail(tag, "P40：贴尾之后每行仍须等宽 78 列", &ok);
            win_dump_lines(&p40_txt3);
        }

        // G4) 窄终端：锚照旧、消息继续收窄（预算变小，贴尾的规则不变）
        tty_ui.cols = 40;                        // 面板 38 列，内容区 34 列
        var p40_txt4: Buf = buf_new(4096);
        defer { buf_free(&p40_txt4); }
        if !view_agents_text(&p40_t, &p40_txt4) {
            ty_fail(tag, "P40：窄终端下也要能出面板", &ok);
        }
        if !contains(&p40_txt4, "● running") || !contains(&p40_txt4, "53s") {
            ty_fail(tag, "P40：窄终端下锚同样不许被挤掉", &ok);
            win_dump_lines(&p40_txt4);
        }
        if !contains(&p40_txt4, "…") || !contains(&p40_txt4, "25 KB.") || contains(&p40_txt4, "verbose") {
            ty_fail(tag, "P40：窄终端下消息仍须贴尾（`…` + 最新一段）", &ok);
            win_dump_lines(&p40_txt4);
        }
        var p40_w4: usize = 0;
        if !win_cols_uniform(&p40_txt4, &p40_w4) || p40_w4 != 38 {
            ty_fail(tag, "P40：40 列终端下面板每行应当是 38 列", &ok);
            win_dump_lines(&p40_txt4);
        }

        // G4b) 最宽的面板（200 列终端 → 面板 198 列、内容行 194 列）：
        //      可见的最新一段仍是消息**真正的结尾** —— 字节上限（VIEW_AG_MSG_MAX = 320）
        //      只兜内存，绝不许成为「看得见多少」的那个约束。
        //      夹具 418 B：「HEADMARK」+ 400 个 a + 「 TAILMARK」（两端的标记都能一眼认出来）。
        {
            var p40_wide: Buf = buf_new(512);
            defer { buf_free(&p40_wide); }
            _ = buf_append_cstr(&p40_wide, "HEADMARK");
            var p40_j: usize = 0;
            while p40_j < 400 {
                _ = buf_append_byte(&p40_wide, 97 as byte);
                p40_j = p40_j + 1;
            }
            _ = buf_append_cstr(&p40_wide, " TAILMARK");
            _ = buf_free(&p40_t.items[0].prompt);
            p40_t.items[0].prompt = buf_new(p40_wide.len + 8);
            _ = buf_append(&p40_t.items[0].prompt, p40_wide.ptr, p40_wide.len);
            tty_ui.cols = 200;
            var p40_txt5: Buf = buf_new(8192);
            defer { buf_free(&p40_txt5); }
            if !view_agents_text(&p40_t, &p40_txt5) {
                ty_fail(tag, "P40：200 列终端下也要能出面板", &ok);
            }
            if !contains(&p40_txt5, " TAILMARK") {
                ty_fail(tag, "P40：宽面板下可见的最新一段被字节上限吃掉了", &ok);
                win_dump_lines(&p40_txt5);
            }
            if contains(&p40_txt5, "HEADMARK") {
                ty_fail(tag, "P40：418 B 的消息在 194 列里放不下，开头不该还在屏幕上", &ok);
                win_dump_lines(&p40_txt5);
            }
            // 「用满预算」：消息够长时，可见的那一段正好顶到内容行的列预算（随后只有 1 列补白），
            // 于是收尾标记后面**紧跟**一个空格加右竖线 —— 字节上限要是偏小（比如老口径的 160），
            // 这一行会提前收窄、在标记后面留一大片空白，这条断言就是钉它的。
            if !contains(&p40_txt5, "TAILMARK │") {
                ty_fail(tag, "P40：宽面板下消息必须用满列预算（字节上限不许提前收窄）", &ok);
                win_dump_lines(&p40_txt5);
            }
            var p40_w5: usize = 0;
            if !win_cols_uniform(&p40_txt5, &p40_w5) || p40_w5 != 198 {
                ty_fail(tag, "P40：200 列终端下面板每行应当是 198 列", &ok);
                win_dump_lines(&p40_txt5);
            }
        }
        win_width_init();                        // 还回 80 列，别把状态带下去

        // G5) 贴着超长消息的**标签行**不受影响：它仍然贴左（丢尾巴）
        if !view_agents_text(&p40_t, &p40_txt3) {
            ty_fail(tag, "P40：面板生成失败", &ok);
        }
        if !contains(&p40_txt3, "sub-41 [subagent] Condense code structure section (continued)") {
            ty_fail(tag, "P40：标签行必须原样贴左（它没超宽，不该被动）", &ok);
            win_dump_lines(&p40_txt3);
        }
    }

    // ---- F) 显示层关闭时（--quiet / 子代理进程）不许产生任何输出 ----
    view_init(false, 6);
    if view_agents_sync(&t) {
        ty_fail(tag, "显示层关闭时不该刷新面板", &ok);
    }
    if tty_block_len() != 0 {
        ty_fail(tag, "显示层关闭时不该往面板块里写东西", &ok);
    }
    view_init(true, 6);

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// 工具内容块 / 视图轮（P14）：把一次工具调用的输入输出渲染成块，断言逐字节排版、截断与折叠。
// 返回 false = 本轮红。
fn view_round(tag: &const byte) bool {
    var ok: bool = true;
    var out: Buf = buf_new(16384);
    defer { buf_free(&out); }
    var cap: Buf = buf_new(16384);
    defer { buf_free(&cap); }
    var nm: Buf = buf_new(64);
    defer { buf_free(&nm); }
    var ar: Buf = buf_new(1024);
    defer { buf_free(&ar); }
    var rs: Buf = buf_new(1024);
    defer { buf_free(&rs); }

    var raw: &void = malloc(262144);
    if ((raw as &byte) as usize) == 0 {
        ty_fail(tag, "cannot allocate arena", &ok);
        return false;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 262144);

    view_init(true, 6);
    diffx_init(true, 6);

    // P16：默认（tool_lines = 0）每次调用**只出一行**；正文（diff / 首尾行 / todo 清单）
    // 只在 --tool-lines N（N>0）时才出现 —— A–H 用 0，D2/E/E2 用 6 覆盖正文。

    // ---- A) bash 失败：摘要取 description（DSH 口径），字形 ✗，后缀 exit 1 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "bash");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"command\":\"npm test\",\"description\":\"run tests\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "FAIL src/a.uya\n2 tests failed\n[exit code: 1]");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✗ Bash · run tests · exit 1\n") {
        ty_fail(tag, "bash 失败行不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- B) bash 成功：exit 0 / ✓ ----
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "hi\n[exit code: 0]");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Bash · run tests · exit 0\n") {
        ty_fail(tag, "bash 成功行不对", &ok);
    }

    // ---- B3) bash 被停住（P38）→ ✗ + `stopped by signal 19`（与「被杀」区分开）----
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "[stopped by signal: 19]\n[exit code: 147]");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✗ Bash · run tests · stopped by signal 19\n") {
        ty_fail(tag, "bash 被停住那一行不对（P38 的新标记没进卡片）", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    // 下面几条用例吃的是 B 的结果，这里把 fixture 还原（这条用例插在中间，别把状态带下去）
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "hi\n[exit code: 0]");

    // ---- B2) bash 没有 description → 摘要退回命令行 ----
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"command\":\"npm test\"}");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Bash · npm test · exit 0\n") {
        ty_fail(tag, "没有 description 时摘要应退回命令行", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- C) read 带 offset/limit → · lines a-b ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "read");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"file_path\":\"src/agent.uya\",\"offset\":100,\"limit\":50}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "src/agent.uya\nline body\n(End of file - total 9 lines)");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Read · src/agent.uya · lines 100-149\n") {
        ty_fail(tag, "read 行不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- D) todo_write（正文关闭）→ 只有计数后缀，没有清单 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "todo_write");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"todos\":[{\"content\":\"a\",\"status\":\"completed\"},{\"content\":\"b\",\"status\":\"in_progress\"},{\"content\":\"c\",\"status\":\"pending\"}]}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "Updated todo list: 1 pending, 1 in progress, 1 completed.");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Todo · 3 items (1 done)\n") {
        ty_fail(tag, "tool_lines=0 时 todo 不该有清单", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- D2) todo_write + tool_lines=6 → 清单正文本回来 ----
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 72);
    if !ty_buf_is(&out, "\n✓ Todo · 3 items (1 done)\n    ✓ a\n    ▸ b\n    · c\n") {
        ty_fail(tag, "tool_lines=6 时 todo 清单不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- E) write + diff：行只有 +A -D；正文（diff）要 tool_lines=6 才有 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "write");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"file_path\":\"note.txt\",\"content\":\"a\\nB\\nc\\n\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "Updated file");
    var d1: Buf = vw_mk("a\nb\nc\n");
    var d2: Buf = vw_mk("a\nB\nc\n");
    const d1v: &[byte] = d1.ptr[0: d1.len];
    const d2v: &[byte] = d2.ptr[0: d2.len];
    diffx_note(d1v, d2v);
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Write · note.txt · +1 -1\n") {
        ty_fail(tag, "tool_lines=0 时 write 不该有 diff 正文", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    diffx_note(d1v, d2v);   // take 过一次就清了，重新采一份给 6 行的断言
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 72);
    if !ty_buf_is(&out, "\n✓ Write · note.txt · +1 -1\n      a\n    - b\n    + B\n      c\n") {
        ty_fail(tag, "write 的 diff 块不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&d1);
    buf_free(&d2);

    // ---- E2) write 失败：不显示假 diff，正文（tool_lines>0 时）用错误文本 ----
    var d3: Buf = vw_mk("a\nb\nc\n");
    var d4: Buf = vw_mk("a\nB\nc\n");
    const d3v: &[byte] = d3.ptr[0: d3.len];
    const d4v: &[byte] = d4.ptr[0: d4.len];
    diffx_note(d3v, d4v);
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "Error: cannot create \"note.txt\"");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✗ Write · note.txt · 1 lines\n") {
        ty_fail(tag, "tool_lines=0 时失败的 write 不该有正文", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    diffx_note(d3v, d4v);
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 72);
    if !ty_buf_is(&out, "\n✗ Write · note.txt · 1 lines\n    Error: cannot create \"note.txt\"\n") {
        ty_fail(tag, "失败的 write 不该显示 diff", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&d3);
    buf_free(&d4);

    // ---- F) 工具报错（Error: 前缀）→ ✗ + 兜底后缀 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "bash");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"command\":\"false\",\"description\":\"x\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "Error: cannot spawn bash");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✗ Bash · x · 1 lines\n") {
        ty_fail(tag, "错误结果行不对", &ok);
    }

    // ---- G) 参数不是合法 JSON → 标题后面没有摘要 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "read");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{not json");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "error: tool arguments are not valid JSON");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✗ Read · 1 lines\n") {
        ty_fail(tag, "坏参数的行不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- H) 中文摘要 + 窄终端 → 行按列截断并补 '…' ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "read");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"file_path\":\"文档/这是一个很长的中文文件名字用来测试按显示列截断.txt\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "ok");
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 30);
    if !contains(&out, "…") {
        ty_fail(tag, "窄终端下应该按列截断并补省略号", &ok);
    }

    // ---- I) 结果首尾 + 省略标记 ----
    var many: Buf = buf_new(256);
    var i: usize = 0;
    while i < 10 {
        _ = buf_append_cstr(&many, "l");
        _ = buf_append_u64(&many, i as u64);
        _ = buf_append_byte(&many, 10);
        i = i + 1;
    }
    view_head_tail(&out, many.ptr as &const byte, many.len, 2, 72);
    if !ty_buf_is(&out, "    l0\n    l1\n    … (省略 6 行)\n    l8\n    l9\n") {
        ty_fail(tag, "首尾 + 省略标记不对", &ok);
        out_err("[body] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    // tool_lines=0 → 没有正文
    view_head_tail(&out, many.ptr as &const byte, many.len, 0, 72);
    if out.len != 0 {
        ty_fail(tag, "--tool-lines 0 时不该有正文", &ok);
    }
    buf_free(&many);

    // ---- J) 关闭态：fd 2 上一个字节都不许出现 ----
    var cap_path: [byte: 64] = "build/selftest_view_stderr.txt";
    const cap_p: &const byte = &cap_path[0] as &const byte;
    view_init(false, 6);
    diffx_init(false, 6);
    if view_enabled() || diffx_enabled() {
        ty_fail(tag, "view_init(false) 之后两个开关都该是关的", &ok);
    }
    var cfd: i32 = -1;
    const saved: i32 = vw_cap_on(cap_p, &cfd);
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "read");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"file_path\":\"x\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "ok\n");
    view_end_tool(&arena, &nm, &ar, &rs);
    vw_cap_off(cap_p, saved, cfd, &cap);
    if cap.len != 0 {
        ty_fail(tag, "--quiet（显示关闭）时不该往 fd 2 写任何字节", &ok);
        out_err("[captured] ");
        out_err_bytes(cap.ptr as &const byte, cap.len);
        out_err("\n");
    }

    // ---- K) 打开态：fd 2 上必须是与 view_render_block 完全一致的那一块 ----
    view_init(true, 6);
    diffx_init(true, 6);
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "body one\nbody two\n");
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 72);
    cfd = -1;
    const saved2: i32 = vw_cap_on(cap_p, &cfd);
    view_end_tool(&arena, &nm, &ar, &rs);
    vw_cap_off(cap_p, saved2, cfd, &cap);
    if cap.len != out.len || (cap.len > 0 && !bufx_mem_eq(cap.ptr as &const byte, out.ptr as &const byte, cap.len)) {
        ty_fail(tag, "打开态写到 fd 2 的内容与渲染结果不一致", &ok);
        out_err("[want] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n[got] ");
        out_err_bytes(cap.ptr as &const byte, cap.len);
        out_err("\n");
    }

    view_init(false, 6);
    diffx_init(false, 6);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}
