// src/selftest/tuis_exit_cmd.uya — tuiselftest.uya 的拆分片 3/7（纯搬移）
//
// 本文件：tui-exit（P28）：命令面板的选择**真的会执行**（headless，走完整主；tui-cmd：命令面板 ↔ /status 浮层这一条链（P23）；tui-scroll：长内容翻看这条链（P32）；tui-p30（P30）：运行中的命令不再等 step 边界；tui-p31（P31）：请求在飞的那段也插泵点 + 命令派发**当场出帧**；浮层方框：右边框必须逐行对齐（tui-frame 轮的一个小节）
// 不变量：与原文件一致 —— 拆分只搬移，不改任何声明的代码；同族轮/段集中在一片里。
// 依赖：见锚点 tuiselftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：沿用原文件前缀（本片是同一历史模块的内部拆分）。

// ============================================================
// tui-exit（P28）：命令面板的选择**真的会执行**（headless，走完整主循环）
//
// 为什么单独一轮：浮层 accept 是「先 close 再交结果」，而 close 会把 kind 清零 ——
// 主循环读到的永远是 0，于是面板里选出来的东西（包括 /exit）被**静默丢掉**：
// 「按了没反应」。这一轮用 /help 做钉子（它会把帮助正文写进转录），
// 面板选择一旦没被执行，屏幕上就找不到帮助正文。
// ============================================================

// tui-exit 轮（P28）：命令面板的选择真的会执行（headless 走完整主循环）。
// 用 /help 当钉子（选中没被执行屏幕上就找不到帮助正文）；返回 false = 本轮红。
fn tui_exit_round(tag: &const byte) bool {
    var ok: bool = true;
    const wsdir: &const byte = "build/selftest_ws_tui_exit" as &const byte;
    if !ws_prepare(wsdir) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    mock_mode = 0;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;

    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", &ok);
        return false;
    }

    var c: Config = cfg_default();
    cfg_pin_api(&c, LLM_STYLE_CHAT);
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(64);
    _ = buf_append_cstr(&c.workspace, wsdir);
    c.task = buf_empty();
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.quiet = false;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    c.tui = true;
    c.tui_headless = true;
    c.tui_cols = 100;
    c.tui_rows = 30;

    tui_reset_all();
    tui_set_headless(true);
    tui_set_size(100, 30);
    tui_set_color(false, false);
    tui_begin_session();
    tui_sink_flush_partial();
    // 命令表：sel 默认在第 0 项 —— 也就是 /help
    tui_set_commands("/help      帮助\n/status    状态\n" as &const byte, 34);
    tui_keys_inject("/" as &const byte, 1);
    if !tui_overlay_open() {
        tuis_fail(tag, "输入 / 没有打开命令面板", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if tui_quit_wanted() {
        tuis_fail(tag, "选了 /help 却置了退出标志", &ok);
    }
    const rc: i32 = agent_run_tui(&c);
    if rc != AGENT_OK {
        tuis_fail(tag, "选完命令之后主循环没有正常收工", &ok);
        tuis_puts("  rc=");
        tuis_num(rc as usize);
        tuis_puts("\n");
    }
    // 面板选择真的被执行了吗？判据是**派发的后果**：`/help` 在 TUI 里是浮层
    // （P23 起），它开出来才说明面板那一下真的走到了 agent_tui_command。
    // 不看转录里的「命令回显」notice：浮层正好盖在转录区上，那一行在屏幕上看不见
    // （notice 本身是加了的 —— 本轮调试时用 g_tui_nent 确认过）。
    // 老代码里 kind 在 close 时被清零，主循环两个分支都不成立 → 这里什么都开不出来。
    tuis_screen_refresh();
    if !tui_overlay_open() {
        tuis_fail(tag, "命令面板的选择没有派发（/help 浮层没开）", &ok);
    } else if tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "派发的不是选中的那条命令（浮层 kind 不对）", &ok);
    }
    _ = wait_child(mpid);
    cfg_free(&c);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;

    if ok {
        tuis_ok(tag, "命令面板的选择被执行（kind 跨 close 存活）+ 主循环收工");
    }
    return ok;
}

// ============================================================
// tui-cmd：命令面板 ↔ /status 浮层这一条链（P23）
//
// 用户报的「/status 没反应」其实是四件事叠在一起，这一轮逐个钉住：
//   A) 面板是由输入行里那个 `/` 触发的，派发后必须把它收走 —— 否则第二次敲
//      `/status` 会拼成 `//status`，被当成未知命令丢掉（屏幕上就是「没反应」）；
//   B) 回车但一条都没匹配上时不许静默：文字还回输入行 + 一条 notice；
//   C) 回合运行中接受的面板项要在**下一个 step 边界**就派发（只读命令），
//      不安全的命令必须留在待取队列里给主循环（回合还攥着 History）；
//   D) 浮层内容比框高时要能滚（老实现 24 行只画 14 行，`上下文占用` 永远看不到）。
// A/B/C/D 的纯逻辑在 headless 下断言；C 的真终端形态（回合还在跑时浮层就出来了）
// 走真 PTY，见 tuis_cmd_pty_case。
// ============================================================

const TUIS_CMD_TITLE: &const byte = "状态（esc 关闭）" as &const byte;
const TUIS_CMD_LEAK: &const byte = "<system-remind" as &const byte;
const TUIS_CMD_NOMATCH: &const byte = "没有匹配的命令" as &const byte;

// 浮层标题行（找带 ╭ 的那一行）
fn tuis_cmd_title_row(row: &usize) bool {
    return tuis_find_row("╭─ " as &const byte, row);
}

// 造一个「headless 但真跑主循环」的配置（与 tui-access 第 6 步同一套）
fn tuis_cmd_cfg(c: &Config, ws: &const byte) void {
    c[0] = cfg_default();
    c.sandbox = SAN_OFF;
    c.access = PERM_WORKSPACE_WRITE;
    perm_set(PERM_WORKSPACE_WRITE);
    cfg_pin_api(c, LLM_STYLE_CHAT);
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:1/v1");   // 这一轮不发请求
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_empty();
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.quiet = false;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    c.tui = true;
    c.tui_headless = true;
    c.tui_cols = 100;
    c.tui_rows = 30;
}

// tui-cmd 轮（P23）：命令面板 ↔ /status 浮层这条链 —— 派发到 agent 后浮层内容正确、
// 回合运行中也能当场出帧。返回 false = 本轮红。
fn tui_cmd_round(tag: &const byte) bool {
    var ok: bool = true;
    const wsa: &const byte = "build/selftest_ws_tui_cmd" as &const byte;
    if !ws_prepare(wsa) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    var c: Config = cfg_default();
    tuis_cmd_cfg(&c, wsa);

    // ---- A1) 面板派发 /status：浮层要看得到，标题要逐字节干净，输入行不许留下 "/" ----
    tuis_reset(100, 30);
    tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
    tui_begin_session();
    tui_sink_flush_partial();
    tui_keys_inject("/" as &const byte, 1);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "输入 / 没有打开命令面板", &ok);
    }
    tui_keys_inject("status" as &const byte, 6);
    tui_keys_inject("\r" as &const byte, 1);
    if agent_run_tui(&c) != AGENT_OK {
        tuis_fail(tag, "面板派发那一轮以非 0 退出", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "命令面板选 /status 没有开出状态浮层", &ok);
    }
    var trow: usize = 0;
    if !tuis_cmd_title_row(&trow) {
        tuis_fail(tag, "状态浮层没有标题栏", &ok);
    } else {
        if !tui_row_has(trow, TUIS_CMD_TITLE) {
            tuis_fail(tag, "状态浮层标题不是「状态（esc 关闭）」", &ok);
        }
        // 手写字面量长度越界：标题栏会挂上相邻只读常量里的 `<system-reminder>`
        if tui_row_has(trow, TUIS_CMD_LEAK) {
            tuis_fail(tag, "标题栏里有越界读出来的 <system-reminder>（字面量长度写大了）", &ok);
        }
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "派发之后输入行里还留着触发面板的那个 /", &ok);
    }

    // ---- A2) 连敲第二次：老实现在这里退化成 //status → 「未知命令」----
    tui_begin_session();   // 只清一次性状态（quit/submit/按键队列），转录与浮层都留着
    tui_overlay_close();
    tui_keys_inject("/status\r" as &const byte, 8);
    if agent_run_tui(&c) != AGENT_OK {
        tuis_fail(tag, "第二次派发那一轮以非 0 退出", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "第二次敲 /status 没有开出状态浮层（输入行残留 / → //status？）", &ok);
    }
    if !tui_row_has(trow, TUIS_CMD_TITLE) && !tuis_screen_has(TUIS_CMD_TITLE) {
        tuis_fail(tag, "第二次的状态浮层里没有标题", &ok);
    }
    tui_overlay_close();

    // ---- B) 回车但没有匹配：不许静默（文字还回输入行 + 一条 notice）----
    tui_begin_session();
    tui_input_clear();
    tui_keys_inject("/zzz\r" as &const byte, 5);
    if agent_run_tui(&c) != AGENT_OK {
        tuis_fail(tag, "无匹配那一轮以非 0 退出", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tui_overlay_open() {
        tuis_fail(tag, "无匹配时浮层应当关掉", &ok);
    }
    const inp: &Buf = tui_input_text();
    if inp.len != 4 || !bufx_mem_eq(inp.ptr as &const byte, "/zzz" as &const byte, 4) {
        tuis_fail(tag, "无匹配时敲进去的文字没有还回输入行", &ok);
    }
    if !tuis_screen_has(TUIS_CMD_NOMATCH) {
        tuis_fail(tag, "无匹配时连一条 notice 都没有（静默丢弃）", &ok);
    }

    // ---- C) 运行中的只读命令：step 边界派发；不安全的留在队列里 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);   // 真跑 agent_run_tui 时它自己会开；这里直接调轮询函数，得自己开
    tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
    tui_begin_session();
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    var h: History = hist_init();
    tui_keys_inject("/status\r" as &const byte, 8);
    if tui_overlay_open() {
        tuis_fail(tag, "运行中接受面板项时不该当场开出浮层（应当挂到 step 边界）", &ok);
    }
    if tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "运行中接受的面板结果没有留在待取队列里", &ok);
    }
    agent_tui_poll_pending_cmd(&c, &h);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "step 边界没有派发 /status（回合运行中看不到状态浮层）", &ok);
    }
    if !tuis_screen_has(TUIS_CMD_TITLE) {
        tuis_fail(tag, "step 边界派发出来的浮层没有标题", &ok);
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "step 边界派发之后输入行里还留着 /", &ok);
    }
    tui_overlay_close();
    // 不安全命令（/permission 会改访问模式，/new 会 hist_free）：必须原样留着
    var unsafe_cmds: Buf = buf_new(128);
    defer { buf_free(&unsafe_cmds); }
    _ = buf_append_cstr(&unsafe_cmds, "/permission 切换访问模式\n");
    tui_set_commands(unsafe_cmds.ptr as &const byte, unsafe_cmds.len);
    tui_begin_session();
    tui_input_clear();
    tui_keys_inject("/permission\r" as &const byte, 12);
    agent_tui_poll_pending_cmd(&c, &h);
    if tui_overlay_open() {
        tuis_fail(tag, "不安全的命令（/permission）在回合里被当场派发了", &ok);
    }
    var pend: Buf = buf_new(256);
    defer { buf_free(&pend); }
    if !tui_overlay_peek(&pend) || tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "不安全的命令应当原样留在待取队列里给主循环", &ok);
    }
    _ = tui_overlay_take(&pend);
    hist_free(&h);

    // ---- D) 滚动：24 行内容要能翻到末尾 ----
    tuis_reset(100, 30);
    tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
    tui_begin_session();
    var h2: History = hist_init();
    var st: Buf = buf_new(4096);
    defer { buf_free(&st); }
    _ = buf_append_cstr(&st, "/status");
    _ = agent_tui_command(&c, &h2, &st);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tui_overlay_open() {
        tuis_fail(tag, "/status 没有开出浮层", &ok);
    }
    if tuis_screen_has("上下文已用" as &const byte) {
        tuis_fail(tag, "24 行的状态块一开始就全画出来了？（窗口实现变了，这条断言要跟着改）", &ok);
    }
    if !tuis_screen_has("↓" as &const byte) {
        tuis_fail(tag, "内容没画完却没有滚动指示（↓）", &ok);
    }
    tui_keys_inject("\x1b[6~" as &const byte, 4);   // PgDn
    tui_keys_inject("\x1b[6~" as &const byte, 4);
    tui_keys_inject("\x1b[6~" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("上下文已用" as &const byte) {
        tuis_fail(tag, "PgDn 之后仍然看不到「上下文已用」（滚不动？）", &ok);
    }
    if !tuis_screen_has("version" as &const byte) {
        tuis_fail(tag, "PgDn 到底之后看不到最后一行（version）", &ok);
    }
    if !tuis_screen_has("↑" as &const byte) {
        tuis_fail(tag, "滚下去之后没有「上面还有」的指示（↑）", &ok);
    }
    if tuis_screen_has("base_url" as &const byte) {
        tuis_fail(tag, "滚到底之后窗口顶端还停在最前面（窗口没跟着选中项走）", &ok);
    }
    tui_overlay_close();
    hist_free(&h2);

    // ---- E) 真 PTY：回合还在跑的时候浮层就该出来 ----
    tuis_cmd_pty_case(tag, &ok);

    // ---- F) 浮窗列表：循环选择 + 已输入文本显示 ----
    // 两件事的判据都落在**屏幕**与**游标序号**上，不看内部实现：
    //   ① 循环：3 项列表上 sel=0 → ↑ 必须到第 3 项（不是停在 0），↓ 再回第 1 项；
    //      而 Home/End/PgUp/PgDn 仍必须**夹取**（Home 在 0 不动、End 在末项不动）——
    //      这一条同时咬住「按 delta 大小猜循环」的实现（那样 Home 的 -n 会被回绕成空操作）。
    //   ② 已输入文本：敲 stat 之后标题栏那一行必须出现 `› stat`，退格后跟着变短；
    //      长过滤词保留**尾部**（前面补 …）、脏字节被单行清洗、窄框退让但方框仍闭合。
    tuis_reset(100, 30);
    tui_reset_all();
    tuis_reset(100, 30);      // tui_reset_all 会清浮层状态，尺寸再钉一次
    tui_set_commands("/help      帮助\n/status    状态\n/exit      退出\n" as &const byte,
        bufx_cstr_len("/help      帮助\n/status    状态\n/exit      退出\n" as &const byte));
    tui_keys_inject("/" as &const byte, 1);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "F 段前置：输入 / 没有打开命令面板", &ok);
    }
    if tui_overlay_item_count() != 3 {
        tuis_fail(tag, "F 段前置：面板条目数不是 3（后面按 3 项算循环）", &ok);
    }
    // ① 循环：↑ 从第 1 项绕到最后一项
    if tui_overlay_sel_index() != 0 {
        tuis_fail(tag, "F 段前置：面板打开时游标不在第 1 项", &ok);
    }
    tui_keys_inject("\x1b[A" as &const byte, 3);   // ↑
    if tui_overlay_sel_index() != 2 {
        tuis_fail(tag, "↑ 在第 1 项再按没有回绕到最后一项（循环选择没生效）", &ok);
        tuis_puts("  sel=");
        tuis_num(tui_overlay_sel_index());
        tuis_puts("\n");
    }
    // ①b ↓ 从最后一项绕回第 1 项
    tui_keys_inject("\x1b[B" as &const byte, 3);   // ↓
    if tui_overlay_sel_index() != 0 {
        tuis_fail(tag, "↓ 在最后一项再按没有回绕到第 1 项", &ok);
    }
    // ①c 中间项仍然逐格走（循环没有把普通移动弄坏）
    tui_keys_inject("\x1b[B" as &const byte, 3);   // ↓ → 第 2 项
    if tui_overlay_sel_index() != 1 {
        tuis_fail(tag, "循环选择把普通的 ↓ 走一格弄坏了（应当停在第 2 项）", &ok);
    }
    // ①d Home/End 仍是**夹取**：End 到末项、再按一次不动；Home 回首项、再按一次不动
    tui_keys_inject("\x1b[F" as &const byte, 3);   // End
    if tui_overlay_sel_index() != 2 {
        tuis_fail(tag, "End 没有把游标放到末项", &ok);
    }
    tui_keys_inject("\x1b[F" as &const byte, 3);   // End 再按一次
    if tui_overlay_sel_index() != 2 {
        tuis_fail(tag, "End 在末项再按竟然回绕了（End 应当夹取，不是循环）", &ok);
    }
    tui_keys_inject("\x1b[H" as &const byte, 3);   // Home
    if tui_overlay_sel_index() != 0 {
        tuis_fail(tag, "Home 没有把游标放回首项", &ok);
    }
    tui_keys_inject("\x1b[H" as &const byte, 3);   // Home 再按一次
    if tui_overlay_sel_index() != 0 {
        tuis_fail(tag, "Home 在首项再按竟然回绕了（Home 应当夹取；若按 delta 猜循环，-n 会绕回原位变空操作）", &ok);
    }
    // ①e PgDn 也不能回绕（它一步走一屏；夹取为主）
    tui_keys_inject("\x1b[6~" as &const byte, 4);  // PgDn
    if tui_overlay_sel_index() != 2 {
        tuis_fail(tag, "PgDn 没有把游标推到末项（或推过头了）", &ok);
    }
    tui_overlay_close();

    // ①f **按键分派**的判别腿：极端矮的框里「一屏只有一行」⇒ PgUp/PgDn 的步长也是 ±1。
    // 这一条专门咬「按 delta 大小猜循环」的实现：那种写法会把 PgDn 当成走一步去回绕。
    // 判据：PgDn 在末项**不动**（夹取），而 ↓ 在末项**回绕**（循环）—— 两者在同一屏上
    // 给出不同结果，才说明判定真的看的是按键。
    {
        // 逐步矮下去，直到框里只放得下一行（body_rows == 1）。
        // 推导：body_rows = h - 2（列表型），h = min(3 + n, 16, panel_top - 2)，
        // n = 3 ⇒ 要 body_rows == 1 就得 h == 3 ⇒ panel_top == 5 ⇒ rows == 8
        // （panel_top = rows - panel_h - 1，输入一行时 panel_h = 2）。所以从 4 起搜，
        // 一定能扫到 8；从 9 起就会整条腿都跑不成。
        var tiny_rows: usize = 4;
        var found_tiny: bool = false;
        while tiny_rows <= 20 && !found_tiny {
            tuis_reset(60, tiny_rows);
            // tuis_reset → tui_reset_all 会清掉命令表，每轮都要重新装（否则条目数是 0，
            // 这条腿会「跑不成」而不是「不通过」）
            tui_set_commands("/help      帮助\n/status    状态\n/exit      退出\n" as &const byte,
                bufx_cstr_len("/help      帮助\n/status    状态\n/exit      退出\n" as &const byte));
            // **必须先重画一帧**：panel_top 是 tui_build 阶段按当前画布算出来的，
            // 只 tuis_reset（改尺寸）不 build 的话读到的还是上一轮画布留下的 panel_top，
            // 「一屏几行」永远不随尺寸变 —— 这条腿会永远找不到 body_rows == 1 的高度。
            tui_build();
            tui_keys_inject("/" as &const byte, 1);
            if tui_overlay_open() && tui_overlay_item_count() == 3 {
                // 用 PgDn 探一次：body_rows == 1 时它只走一格
                const sel_before: usize = tui_overlay_sel_index();
                tui_keys_inject("\x1b[6~" as &const byte, 4);
                if tui_overlay_sel_index() == sel_before + 1 && sel_before == 0 {
                    found_tiny = true;   // 一屏一行：PgDn 恰好走一格
                    // PgDn 一路推到末项（每按一次不动一格，夹取不回头）
                    tui_keys_inject("\x1b[6~" as &const byte, 4);
                    tui_keys_inject("\x1b[6~" as &const byte, 4);
                    if tui_overlay_sel_index() != 2 {
                        tuis_fail(tag, "矮框里 PgDn 没有夹取到末项", &ok);
                    }
                    // 在末项：PgDn 必须**不动**（夹取）……
                    tui_keys_inject("\x1b[6~" as &const byte, 4);
                    if tui_overlay_sel_index() != 2 {
                        tuis_fail(tag, "矮框里 PgDn 在末项回绕了（PgDn 应当夹取；若按 delta 大小猜，步长 ±1 会被当成走一步）", &ok);
                    }
                    // ……而 ↓ 必须**回绕**到第 1 项
                    tui_keys_inject("\x1b[B" as &const byte, 3);
                    if tui_overlay_sel_index() != 0 {
                        tuis_fail(tag, "矮框里 ↓ 在末项没有回绕（同一个 ±1 步长，↓ 该回绕、PgDn 该夹取）", &ok);
                    }
                }
            }
            tui_overlay_close();
            tiny_rows = tiny_rows + 1;
        }
        if !found_tiny {
            tuis_fail(tag, "F 段 ①f：没找到「一屏只放得下一行」的终端高度（这条判别腿没跑成）", &ok);
        }
    }
    tuis_reset(100, 30);

    // ② 已输入文本：敲进去的过滤词必须画在标题栏上
    tuis_reset(100, 30);
    tui_keys_inject("/" as &const byte, 1);
    if !tui_overlay_open() {
        tuis_fail(tag, "F 段前置：第二次开面板失败", &ok);
    }
    if tuis_screen_has("› " as &const byte) {
        tuis_fail(tag, "还没敲过滤词，标题栏就已经有 `› ` 了（应当按非空才画）", &ok);
    }
    tui_keys_inject("stat" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("› stat" as &const byte) {
        tuis_fail(tag, "命令面板里敲了 stat，标题栏上看不到已输入文本（过滤词仍是不可见状态）", &ok);
        tuis_dump_screen(tag);
    }
    // 带过滤词的标题栏仍必须是「帧里的一行」（行内不许出现换行，否则方框右边框错位）
    if tuis_row_has_lf() {
        tuis_fail(tag, "带过滤词的标题栏把行拆开了（行内出现了换行）", &ok);
    }
    // ②b 退格：显示跟着变短（盲删的原始症状）
    tui_keys_inject("\x7f" as &const byte, 1);     // backspace
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("› sta" as &const byte) {
        tuis_fail(tag, "退格之后标题栏上的过滤词没有跟着变短", &ok);
    }
    if tuis_screen_has("› stat" as &const byte) {
        tuis_fail(tag, "退格之后标题栏上还留着完整的过滤词（显示没跟着退格走）", &ok);
    }
    tuis_overlay_frame_check(100, &ok, tag);   // 方框仍闭合、每行 ≤ cols
    tui_overlay_close();

    // ②c 长过滤词：保留**尾部**（最新敲的字优先），前面补 '…'，且不顶破边框
    tuis_reset(60, 30);
    tui_keys_inject("/" as &const byte, 1);
    tui_keys_inject("averyveryverylongfilterwordtailX" as &const byte,
        bufx_cstr_len("averyveryverylongfilterwordtailX" as &const byte));
    tui_build();
    tuis_scan_rows(60, &ok, tag);
    if !tuis_screen_has("tailX" as &const byte) {
        tuis_fail(tag, "长过滤词没有保留尾部（最新敲的字被截掉了）", &ok);
        tuis_dump_screen(tag);
    }
    tuis_overlay_frame_check(60, &ok, tag);
    tui_overlay_close();

    // ②d 脏字节：TAB / ESC / 控制字节不许进正文层，也不许把列宽算错
    tuis_reset(80, 30);
    tui_keys_inject("/" as &const byte, 1);
    tui_key_feed("\x0b" as &const byte, 1);        // 0x0b 竖表：控制字节
    tui_keys_inject("ab" as &const byte, 2);
    tui_build();
    tuis_scan_rows(80, &ok, tag);
    if !tuis_screen_has("› ab" as &const byte) {
        tuis_fail(tag, "过滤词里有控制字节时，后半个词没画出来（清洗把内容吃掉了）", &ok);
    }
    tuis_overlay_frame_check(80, &ok, tag);
    tui_overlay_close();

    cfg_free(&c);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    if ok {
        tuis_ok(tag, "面板派发收走触发用的 /（连敲两次都开）+ 无匹配不静默 + 运行中 step 边界派发只读命令 + 浮层滚动/溢出指示 + 循环选择（↑ 顶→底 / ↓ 底→顶，Home·End·PgUp·PgDn 仍夹取，含矮框里 ±1 步长的判别腿）+ 已输入文本画在标题栏（清洗/保尾/退格跟随/方框闭合）+ 真 PTY 回合中可见");
    }
    return ok;
}


// 真 PTY：回合还在跑的时候，运行中接受的面板项必须在下一个 step 边界就把状态浮层
// 开出来 —— 判据是「标题先出现、最终答案标记还没出现」。mock 的两段 SSE 之间插了
// 一个停顿（mock_sse_gap_ns），父进程就靠这个窗口把 /status 敲进去。
fn tuis_cmd_pty_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_cmd_pty" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败（PTY 回合）", ok);
        return;
    }
    mock_mode = 0;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    mock_expect_resp = false;
    mock_usage_on = false;
    mock_sse_gap_ns = 1200000000;   // 1.2s：两个 step 都在这里停一下
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        mock_sse_gap_ns = 0;
        tuis_fail(tag, "mock LLM 起不来（PTY 回合）", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        mock_sse_gap_ns = 0;
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        return;
    }
    tui_reset_all();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        mock_sse_gap_ns = 0;
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        return;
    };
    if cpid64 == 0 {
        tuis_child_run_tui(&slave_path, port, ws);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 40);      // 首帧
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案（PTY 回合）", ok);
    }
    var task: [byte: 64] = "do the slow task\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    // 回合已经卡在 SSE 的停顿里；这时候敲 /status（面板 → 过滤 → 回车）
    var nap: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 300000000 };
    var nrem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_nanosleep(&nap, &nrem) catch {};
    tuis_write_master(m, "/status\r" as &const byte, 8);
    var title_seen: bool = false;
    var ended_too_early: bool = false;
    var k: i32 = 0;
    while k < 200 && !title_seen {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, TUIS_CMD_TITLE) {
            title_seen = true;
            // 这一刻回合必须还没跑完。浮层盖住转录，最终答案的字看不见，所以判据用
            // 脚注：两步的回合跑完时统计行会出现「1 轮 · 2 步」（step 1 结束时是「1 步」）。
            if tuis_has(&cap, "1 轮 · 2 步" as &const byte) {
                ended_too_early = true;
            }
        }
        k = k + 1;
    }
    if !title_seen {
        tuis_fail(tag, "回合运行中敲 /status：浮层一直没有出现", ok);
        tuis_dump_tail(&cap, 1500);
    } else if ended_too_early {
        tuis_fail(tag, "浮层是在回合结束之后才出来的（运行中没有 step 边界派发）", ok);
        tuis_puts("  title at iter=");
        tuis_num(k as usize);
        tuis_puts(" cap=");
        tuis_num(cap.len);
        tuis_puts("\n");
        tuis_dump_tail(&cap, 2500);
    }
    // 浮层开着的时候回合照常跑完：esc 关掉浮层，最终答案就回到转录里
    var esc1: [byte: 1] = [27];
    tuis_write_master(m, &esc1[0], 1);
    var done: bool = false;
    var k2: i32 = 0;
    while k2 < 300 && !done {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, "SELFTEST_OK" as &const byte) {
            done = true;
        }
        k2 = k2 + 1;
    }
    if !done {
        tuis_fail(tag, "浮层打开之后回合没有正常跑完", ok);
        tuis_dump_tail(&cap, 1200);
    }
    if !tuis_child_alive(cpid) {
        tuis_fail(tag, "回合跑完之后子进程不见了", ok);
    }
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 20000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
    mock_sse_gap_ns = 0;
}

// ============================================================
// tui-scroll：长内容翻看这条链（P32）
//
// 用户报的「工作区里文本不能滚动、翻不了旧日志」有三种形态，这一轮逐个钉住：
//   ① 滚轮：DSH 的 web 终端是 xterm.js，没有鼠标协议时它把滚轮伪装成 ↑/↓ ——
//      所以「滚轮向上」变成了输入历史。修法是开 `ESC[?1000h/1006h` 并把
//      `ESC[<64;x;yM` / `ESC[<65;x;yM` 折成滚轮事件（其它按下/移动丢弃）。
//   ② ctrl+home / ctrl+end 解析错：老实现把 `ESC[1;5H` 在第一个 ';' 就收尾，
//      剩下的 `5H` 当普通字符进了输入行（屏幕上明晃晃的 5H），而且没跳到顶。
//   ③ **一个条目上万行**：窗口从尾部收行，`total >= need` 就停 —— 一个长条目被
//      整个装进来时 max_scroll = total - 视口 会夹成 0，于是「往上翻/跳顶」都
//      翻不到这一条的前面部分。修法是按真总量走查（tui_auto_end_scroll）。
// 外加：PgUp/PgDn 按整屏走（不再是写死的 5 行）、两端的 `^`/`v` 溢出指示。
// ============================================================

// 一条 n 行的助手正文（单独一个条目 —— 这是「长条目」那种形状）
fn tuis_long_entry(n: usize) void {
    var many: Buf = buf_new(65536);
    defer { buf_free(&many); }
    var i: usize = 0;
    while i < n {
        _ = buf_append_cstr(&many, "LONG-ROW-");
        _ = buf_append_u64(&many, (i + 1) as u64);
        _ = buf_append_cstr(&many, " 这一行很长，足够把视口吃满，用来验证长条目能不能翻到前面。\n");
        i = i + 1;
    }
    tui_sink_bytes(1, many.ptr as &const byte, many.len);
    tui_close_stream_entries();
}

// 屏幕文本里有没有 "LONG-ROW-<n> "（带后随空格，免得 LONG-ROW-4 命中 LONG-ROW-40）
fn tuis_long_visible(n: usize) bool {
    var pat: Buf = buf_new(32);
    defer { buf_free(&pat); }
    _ = buf_append_cstr(&pat, "LONG-ROW-");
    _ = buf_append_u64(&pat, n as u64);
    _ = buf_append_byte(&pat, 32);
    return tuis_screen_has(pat.ptr as &const byte);
}

// tui-scroll 轮（P32）：长内容翻看 —— 2400 行条目翻到前面、ctrl+home 到顶、ctrl+end 回底、
// 滚动时状态行钉住。返回 false = 本轮红。
fn tui_scroll_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- A) 长条目（2400 行）也能翻到前面 + ctrl+home 到顶 + ctrl+end 回底 ----
    tuis_reset(100, 30);
    tuis_long_entry(2400);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tui_scroll_pos() != 0 {
        tuis_fail(tag, "新内容进来后应当贴尾（scroll == 0）", &ok);
    }
    if !tuis_long_visible(2400) {
        tuis_fail(tag, "贴尾时看不到最后一行 LONG-ROW-2400", &ok);
    }
    // 长条目不许把「往上翻」夹死：一直 PgUp，必须能走到这一条的最前面
    var guard: usize = 0;
    while guard < 400 && !tuis_long_visible(1) {
        tui_scroll_up(10);
        tui_build();
        guard = guard + 1;
    }
    if !tuis_long_visible(1) {
        tuis_fail(tag, "长条目里往上翻不到第一行（max_scroll 被夹死？）", &ok);
        tuis_puts("  scroll=" as &const byte);
        tuis_num(tui_scroll_pos());
        tuis_puts("\n" as &const byte);
    }
    tuis_scan_rows(100, &ok, tag);
    // 再往上：LONG-ROW-1 可见时条目标题（`◆ 助手`）可能还在窗口上面，所以继续滚到
    // 标题也进来 —— 那才是真的到顶，此时 `^` 指示必须消失。
    var guard2: usize = 0;
    var head_row: usize = 0;
    while guard2 < 60 && !tuis_find_row("◆ 助手" as &const byte, &head_row) {
        tui_scroll_up(4);
        tui_build();
        guard2 = guard2 + 1;
    }
    if !tuis_find_row("◆ 助手" as &const byte, &head_row) {
        tuis_fail(tag, "长条目一直往上滚也看不到条目标题（真到不了顶）", &ok);
    }
    if tui_start_line() != 0 {
        tuis_puts("  scroll=" as &const byte); tuis_num(tui_scroll_pos());
        tuis_puts(" start=" as &const byte); tuis_num(tui_start_line());
        tuis_puts("\n" as &const byte);
        tuis_fail(tag, "一直往上滚也没到最顶（start_line 不为 0）", &ok);
    }
    if tui_more_above() {
        tuis_fail(tag, "已经到顶（标题都进来了），转录区第一行还挂着 `^` 溢出指示", &ok);
    }
    tuis_scan_rows(100, &ok, tag);
    // ctrl+end 回底
    tui_scroll_end();
    tui_build();
    if tui_scroll_pos() != 0 {
        tuis_fail(tag, "ctrl+end 之后没有回到底", &ok);
    }
    if !tuis_long_visible(2400) {
        tuis_fail(tag, "回底之后看不到最后一行", &ok);
    }

    // ---- B) ctrl+home / ctrl+end 的字节解析（带修饰键的 CSI 不能把尾巴漏进输入行）----
    tuis_reset(100, 30);
    tuis_long_entry(600);
    tui_build();
    tui_keys_inject("\x1b[1;5H" as &const byte, 6);   // ctrl+home
    tui_build();
    if !tuis_long_visible(1) {
        tuis_fail(tag, "ctrl+home 没有跳到最顶（看不到第一行）", &ok);
        tuis_puts("  scroll=" as &const byte);
        tuis_num(tui_scroll_pos());
        tuis_puts("\n" as &const byte);
    }
    if tui_more_above() || tui_start_line() != 0 {
        tuis_fail(tag, "跳到最顶之后不该再有 `^` 指示（start_line 应为 0）", &ok);
    }
    tui_keys_inject("\x1b[1;5F" as &const byte, 6);   // ctrl+end
    tui_build();
    if tui_input_len() != 0 {
        tuis_fail(tag, "ctrl+end 的尾巴漏进了输入行", &ok);
    }
    if tui_scroll_pos() != 0 {
        tuis_fail(tag, "ctrl+end 没有回到底", &ok);
    }
    // 不带修饰键的 Home/End 依旧只是行内编辑（不许被 ctrl 分支抢走）
    tui_keys_inject("ab" as &const byte, 2);
    tui_keys_inject("\x1b[H" as &const byte, 3);
    tui_keys_inject("Q" as &const byte, 1);
    if !tuis_in_is("Qab" as &const byte) {
        tuis_fail(tag, "裸 Home 没有走行内编辑（被 ctrl+home 分支抢走了？）", &ok);
    }
    tui_input_clear();

    // ---- C) 滚轮：SGR 事件折成滚动，别的鼠标事件一律不落进输入行 ----
    tuis_reset(100, 30);
    tuis_long_entry(600);
    tui_build();
    const before: usize = tui_scroll_pos();
    tui_keys_inject("\x1b[<64;10;10M" as &const byte, 12);   // 滚轮上
    tui_build();
    if tui_scroll_pos() <= before {
        tuis_fail(tag, "SGR 滚轮上（64）没有往上滚", &ok);
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "滚轮事件漏进了输入行", &ok);
    }
    var up: usize = tui_scroll_pos();
    tui_keys_inject("\x1b[<65;10;10M" as &const byte, 12);   // 滚轮下
    tui_build();
    if tui_scroll_pos() >= up {
        tuis_fail(tag, "SGR 滚轮下（65）没有往下滚", &ok);
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "滚轮下的事件漏进了输入行", &ok);
    }
    // 按下/抬起/移动（b < 64）一律丢弃：不许滚动、不许进输入行
    const pos0: usize = tui_scroll_pos();
    tui_keys_inject("\x1b[<0;10;10M" as &const byte, 11);   // 左键按下（11 字节）
    tui_keys_inject("\x1b[<0;10;10m" as &const byte, 11);   // 左键抬起
    tui_keys_inject("\x1b[<35;11;11M" as &const byte, 13);   // 移动
    tui_build();
    if tui_scroll_pos() != pos0 {
        tuis_fail(tag, "非滚轮的鼠标事件（按下/移动）不该滚动", &ok);
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "非滚轮的鼠标事件漏进了输入行", &ok);
    }
    // 录入端真的开了鼠标上报（否则 xterm.js 永远把滚轮伪装成 ↑/↓）
    var cap: Buf = buf_new(1024);
    defer { buf_free(&cap); }
    tui_term_text(&cap);
    if !bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "TUI 进入时没有开鼠标上报（ESC[?1000h）—— 滚轮会被终端转成 ↑/↓", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "没有开 SGR 鼠标编码（ESC[?1006h）", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1006l" as &const byte) {
        tuis_fail(tag, "离开 TUI 时没有关鼠标编码（拖累后面的 shell）", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?2004l" as &const byte) {
        tuis_fail(tag, "离开 TUI 时没有关括起粘贴", &ok);
    }

    // ---- D) PgUp/PgDn 走整屏（老实现写死 5 行）+ 顶部 `^` 溢出指示 ----
    tuis_reset(100, 30);
    tuis_long_entry(600);
    tui_build();
    var row: usize = 0;
    if !tuis_find_row("LONG-ROW-600 " as &const byte, &row) {
        tuis_fail(tag, "贴尾时看不到最后一行", &ok);
    }
    tui_keys_inject("\x1b[5~" as &const byte, 4);   // PgUp
    tui_build();
    const after_pgup: usize = tui_scroll_pos();
    if after_pgup < 20 {
        tuis_fail(tag, "PgUp 只滚了几行（写死 5 行的老毛病）", &ok);
        tuis_puts("  scroll=" as &const byte);
        tuis_num(after_pgup);
        tuis_puts("\n" as &const byte);
    }
    // 顶部（转录区第 0 行）要有 `^` 溢出指示：上面还有内容（P32）
    if !tui_row_has(0, "^" as &const byte) {
        tuis_fail(tag, "往上翻之后转录区第一行没有 `^` 溢出指示", &ok);
    }
    // 指示必须落在**最后一个显示列**（原地覆盖一个空格，不许把行撑宽）
    if tui_row_cols_n(0) != 100 {
        tuis_fail(tag, "带 `^` 指示的那一行列数不是 100（指示把行撑宽/缩窄了）", &ok);
    }
    // 贴尾时指示必须消失（布局与 P32 之前逐字节一致）
    tui_scroll_end();
    tui_build();
    if tui_row_has(0, "^" as &const byte) {
        tuis_fail(tag, "贴尾时第一行不该有 `^` 指示", &ok);
    }
    tuis_scan_rows(100, &ok, tag);

    // ---- E) 贴尾时新内容照旧自动跟随（不被 P32 的指示行改动破坏）----
    tuis_reset(100, 30);
    tuis_long_entry(120);
    tui_build();
    tui_sink_bytes(1, "TAIL-FOLLOW-MARK 新来的一行\n" as &const byte,
        bufx_cstr_len("TAIL-FOLLOW-MARK 新来的一行\n" as &const byte));
    tui_build();
    if !tuis_screen_has("TAIL-FOLLOW-MARK" as &const byte) {
        tuis_fail(tag, "贴尾时新内容没有自动跟随（还在看旧位置？）", &ok);
    }
    if tui_scroll_pos() != 0 {
        tuis_fail(tag, "贴尾状态下新内容进来后 scroll 不是 0", &ok);
    }

    if ok {
        tuis_ok(tag, "长条目翻看（真总量走查）+ ctrl+home/end 参数解析 + SGR 滚轮 + 整屏 PgUp/PgDn + `^` 溢出指示 + 贴尾跟随");
    }
    return ok;
}

// ============================================================
// tui-p30（P30）：运行中的命令不再等 step 边界
//
// 现场（用户报的）：回合只有一个长 step（长流式 / 长 bash）时，敲 `/` 命令十几秒到几分钟
// 没反应 —— 看着就是卡死。根因是派发点只有 step 边界一处。
//
// A) headless：泵点就能派发只读命令；不安全的命令给回执 + 请求中断（结果仍留给主循环）
// B) 真 PTY：单步长流式（mock 先停 2.5s）中敲 /status —— 浮层必须在 800ms 内出现，
//    而旧实现要等这一步走完（≥2.2s）
// ============================================================

const TUIS_P30_LAT_MAX_MS: u64 = 800;     // 派发延迟上限（旧实现 ≥2.2s）

// tui-p30 的 headless 腿（P30）：派发命令**不再等 step 边界**，命令一进来就执行；
// 与 tuis_p30_pty_case 共用 TUIS_P30_LAT_MAX_MS 这个延迟上限。
fn tuis_p30_headless_case(tag: &const byte, ok: &bool, ws: &const byte) void {
    var c: Config = cfg_default();
    tuis_cmd_cfg(&c, ws);                 // 与 tui-cmd 同一套配置（不发请求）
    tuis_reset(100, 30);
    tui_headless_enable(true);            // tui_active() 要为真（tuis_reset 只设了 headless 标志）
    var cmds: Buf = buf_new(1024);
    defer { buf_free(&cmds); }
    agent_tui_commands(&cmds);            // 真实命令表（/status、/new 都在里面）
    tui_set_commands(cmds.ptr as &const byte, cmds.len);
    tui_begin_session();
    var h: History = hist_init();
    defer { hist_free(&h); }

    // ---- A1) 只读命令：泵点当场派发（不再等 step 边界）----
    tui_set_run(TUI_RUN_THINK, "跑着呢" as &const byte, bufx_cstr_len("跑着呢" as &const byte));
    tui_input_clear();
    tui_keys_inject("/status\r" as &const byte, 8);   // 注入即处理：面板开→过滤→选中
    agent_tui_poll_pending_cmd(&c, &h);   // 「泵点」的核心：流式每 ≤50ms 就走一次这里
    if !tui_overlay_open() {
        tuis_fail(tag, "运行中敲 /status：泵点没有当场开出浮层", ok);
    } else {
        tui_build();                     // 浮层标题要看屏幕：重画一帧（与 A2 同一套）
        tuis_scan_rows(100, ok, tag);
        if !tuis_screen_has(TUIS_CMD_TITLE) {
            tuis_fail(tag, "泵点派发的 /status 浮层没有标题", ok);
        }
    }
    tui_overlay_close();
    tui_input_clear();

    // ---- A2) 不安全命令：回执 + 请求中断，结果留给主循环 ----
    tui_keys_inject("/new\r" as &const byte, 5);
    agent_tui_poll_pending_cmd(&c, &h);
    tui_build();                          // 回执是转录里的一行：要重画一帧才看得到
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("已收到 /new" as &const byte) {
        tuis_fail(tag, "运行中敲 /new：没有立刻给出回执（用户看到的还是「没反应」）", ok);
    }
    if !tui_interrupt_pending() {
        tuis_fail(tag, "运行中敲 /new：没有请求中断当前回合（口径是「先中断再执行」）", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "/new 不该在泵点里当场执行（它会 hist_free 掉回合正在用的历史）", ok);
    }
    var pend: Buf = buf_new(256);
    defer { buf_free(&pend); }
    if !tui_overlay_peek(&pend) || tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "/new 的结果应当原样留在队列里给主循环", ok);
    }
    _ = tui_overlay_take(&pend);
    _ = tui_interrupt_take();
    tui_input_clear();

    // ---- A3) /compact：泵点不落、step 边界落（它会改写历史，只能在那儿办）----
    tui_keys_inject("/compact\r" as &const byte, 9);
    agent_tui_poll_pending_cmd(&c, &h);
    if tui_interrupt_pending() {
        tuis_fail(tag, "/compact 不该请求中断（它排在 step 边界，不是「先中断再执行」）", ok);
    }
    if !tui_overlay_peek(&pend) {
        tuis_fail(tag, "/compact 的结果应当留在队列里等 step 边界", ok);
    }
    agent_tui_step_boundary_cmd(&c, &h);      // step 边界到了
    if tui_overlay_peek(&pend) {
        tuis_fail(tag, "step 边界没有把 /compact 落地", ok);
    }
    tui_input_clear();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    cfg_free(&c);
}

// tui-p30 的真 PTY 腿（P30）：单步长流式（mock 先停 2.5s）中敲 /status，浮层必须在
// TUIS_P30_LAT_MAX_MS（800ms）内出现（旧实现要等这一步走完 ≥2.2s）。父子进程分工与 tui-pty 同。
fn tuis_p30_pty_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_p30" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败（PTY 回合）", ok);
        return;
    }
    mock_mode = 40;                 // 单步长流式：响应头+第一帧立刻发，正文停 2.5s
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    mock_expect_resp = false;
    mock_usage_on = false;
    mock_sse_gap_ns = 2500000000;
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        mock_sse_gap_ns = 0;
        tuis_fail(tag, "mock LLM 起不来（P30 的 PTY 回合）", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        mock_sse_gap_ns = 0;
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        return;
    }
    tui_reset_all();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        mock_sse_gap_ns = 0;
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        return;
    };
    if cpid64 == 0 {
        tuis_child_run_tui(&slave_path, port, ws);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 40);      // 首帧
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案（P30 的 PTY 回合）", ok);
    }
    var task: [byte: 64] = "do the slow task\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    tuis_drain(m, &cap, 6);       // ≈300ms：响应头与第一帧已到，正文还停在停顿里
    const t0: u64 = ua_now_ms();
    tuis_write_master(m, "/status\r" as &const byte, 8);
    var title_seen: bool = false;
    var elapsed: u64 = 0;
    var ended_too_early: bool = false;
    var k: i32 = 0;
    while k < 200 && !title_seen {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, TUIS_CMD_TITLE) {
            title_seen = true;
            elapsed = ua_now_ms() - t0;
            // 这一刻正文还没发出来（mock 还在停）：说明浮层是在**这一步的流式过程中**
            // 出来的，而不是等这一步结束。
            if tuis_has(&cap, "SELFTEST_OK" as &const byte) {
                ended_too_early = true;
            }
        }
        k = k + 1;
    }
    if !title_seen {
        tuis_fail(tag, "P30：单步长流式里敲 /status，浮层一直没有出现", ok);
        tuis_dump_tail(&cap, 1500);
    } else if ended_too_early {
        tuis_fail(tag, "P30：浮层是在回合结束之后才出来的（派发点没铺到泵点）", ok);
    } else if elapsed > TUIS_P30_LAT_MAX_MS {
        tuis_fail(tag, "P30：浮层出现得太慢（派发还在等 step 边界？）", ok);
        tuis_puts("  实测延迟 ms = " as &const byte);
        tuis_num(elapsed as usize);
        tuis_puts("  上限 = " as &const byte);
        tuis_num(TUIS_P30_LAT_MAX_MS as usize);
        tuis_puts("\n" as &const byte);
    }
    // 关掉浮层，回合照常跑完
    var esc1: [byte: 1] = [27];
    tuis_write_master(m, &esc1[0], 1);
    var done: bool = false;
    var k2: i32 = 0;
    while k2 < 400 && !done {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, "SELFTEST_OK" as &const byte) {
            done = true;
        }
        k2 = k2 + 1;
    }
    if !done {
        tuis_fail(tag, "P30：浮层关掉之后回合没有正常跑完", ok);
        tuis_dump_tail(&cap, 1200);
    }
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 20000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
    mock_sse_gap_ns = 0;
}

// tui-p30 轮（P30）：先跑 headless 腿再跑 PTY 腿（后者自己 fork）。
// 返回 false = 任一条腿红。
fn tui_p30_round(tag: &const byte) bool {
    var ok: bool = true;
    const ws: &const byte = "build/selftest_ws_tui_p30_headless" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    tuis_p30_headless_case(tag, &ok, ws);
    tuis_p30_pty_case(tag, &ok);
    if ok {
        tuis_ok(tag, "运行中敲 /status 当场出浮层（≤800ms，旧实现要等整个 step）+ /new 立刻回执并请求中断 + 真 PTY 单步长流式复验");
    }
    return ok;
}

// ============================================================
// tui-p31（P31）：请求在飞的那段也插泵点 + 命令派发**当场出帧**
//
//   * A) 只读命令：泵点派发之后**同一次调用里**就画出一帧。旧实现只把浮层标脏，
//     要等下一个泵点（回合内 ≤50ms）或下一次 200ms 轮询才上屏 —— 用户看到的那一下
//     就是「敲完没反应」（真终端实测：空闲 243ms、等响应头那段 4879ms）；
//   * B) 不安全命令的回执（「已收到 /new…」）同样当场出帧，结果仍旧留给主循环；
//   * C) 泵点上下文的口径：登记期间才派发，`agent_pump_ctx_end` 之后必须**不**吞掉
//     面板结果 —— 主循环跑命令时登记/跑完清掉，靠的就是这条不变量。
//
// 帧数用 tui_frame_count()：headless 的 flush fd 是 -1，所以「脏没脏」不成立，
// 能断言的判据是「tui_render 真的被调用过一帧」（build + flush 都走过了）。
// ============================================================

// tui-p31 的 headless 腿（P31）：请求在飞的那段也插泵点，命令派发当场出帧。
// 判据用 tui_frame_count()（headless 的 flush fd 是 -1，「脏没脏」不成立）。
fn tuis_p31_headless_case(tag: &const byte, ok: &bool, ws: &const byte) void {
    var c: Config = cfg_default();
    tuis_cmd_cfg(&c, ws);                 // 与 tui-cmd / tui-p30 同一套配置（不发请求）
    tuis_reset(100, 30);
    tui_headless_enable(true);            // tui_active() 要为真
    var cmds: Buf = buf_new(1024);
    defer { buf_free(&cmds); }
    agent_tui_commands(&cmds);            // 真实命令表（/status、/new 都在里面）
    tui_set_commands(cmds.ptr as &const byte, cmds.len);
    tui_begin_session();
    var h: History = hist_init();
    defer { hist_free(&h); }

    // ---- A) 只读命令：派发之后同一次调用里就出帧 ----
    tui_set_run(TUI_RUN_THINK, "跑着呢" as &const byte, bufx_cstr_len("跑着呢" as &const byte));
    tui_input_clear();
    tui_keys_inject("/status\r" as &const byte, 8);
    const f0: usize = tui_frame_count();
    agent_tui_poll_pending_cmd(&c, &h);
    if !tui_overlay_open() {
        tuis_fail(tag, "P31：泵点没有当场开出浮层", ok);
    }
    if tui_frame_count() != f0 + 1 {
        tuis_fail(tag, "P31：派发之后没有当场出帧（还是等下一个泵点/轮询？）", ok);
        tuis_puts("  帧数 before=" as &const byte);
        tuis_num(f0);
        tuis_puts(" after=" as &const byte);
        tuis_num(tui_frame_count());
        tuis_puts("\n" as &const byte);
    }
    tui_build();                          // 屏幕文本要看：重画一帧（与既有轮同一套）
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_CMD_TITLE) {
        tuis_fail(tag, "P31：派发出来的浮层没有标题", ok);
    }
    tui_overlay_close();
    tui_input_clear();

    // ---- B) 不安全命令：回执也必须当场出帧，结果留给主循环 ----
    tui_keys_inject("/new\r" as &const byte, 5);
    const f1: usize = tui_frame_count();
    agent_tui_poll_pending_cmd(&c, &h);
    if tui_frame_count() != f1 + 1 {
        tuis_fail(tag, "P31：不安全命令的回执没有当场出帧", ok);
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("已收到 /new" as &const byte) {
        tuis_fail(tag, "P31：/new 的回执没有上屏", ok);
    }
    var pend: Buf = buf_new(256);
    defer { buf_free(&pend); }
    if !tui_overlay_peek(&pend) || tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "P31：/new 的结果应当原样留给主循环", ok);
    }
    _ = tui_overlay_take(&pend);
    _ = tui_interrupt_take();
    tui_input_clear();

    // ---- C) 泵点上下文：登记期间派发；清掉之后不许再吞结果 ----
    agent_pump_ctx_begin(&c, &h);
    tui_keys_inject("/status\r" as &const byte, 8);
    agent_pump_light();
    if !tui_overlay_open() {
        tuis_fail(tag, "P31：登记了泵点上下文却不派发命令", ok);
    }
    tui_overlay_close();
    tui_input_clear();
    agent_pump_ctx_end(&c);
    tui_keys_inject("/status\r" as &const byte, 8);
    agent_pump_light();
    if tui_overlay_open() {
        tuis_fail(tag, "P31：清掉泵点上下文之后仍然派发了命令（上下文泄漏）", ok);
    }
    if !tui_overlay_peek(&pend) {
        tuis_fail(tag, "P31：面板结果没有留给主循环（被泵点吞了）", ok);
    }
    _ = tui_overlay_take(&pend);
    tui_input_clear();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    cfg_free(&c);
}

// tui-p31 轮（P31）：跑 headless 腿（请求在飞时也能派发命令并当场出帧）。
// 返回 false = 本轮红。
fn tui_p31_round(tag: &const byte) bool {
    var ok: bool = true;
    const ws: &const byte = "build/selftest_ws_tui_p31" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    tuis_p31_headless_case(tag, &ok, ws);
    if ok {
        tuis_ok(tag, "派发即出帧（只读命令 / 不安全命令的回执各一帧）+ 泵点上下文登记与清掉的口径");
    }
    return ok;
}

// ============================================================
// 浮层方框：右边框必须逐行对齐（tui-frame 轮的一个小节）
//
// 缺陷的样子（真机截图）：命令面板里 /permission 那一行又长又带全角括号，
// 它把右边框顶了出去 —— 方框右边参差，那一行的 │ 落在别的列上。
// 口径：顶边 / 每一行正文 / 底边的「左边界列」「右边界列」必须逐行相同，
//       而且每行的首尾字符必须真的是边框字形（方框闭合成矩形）。
// ============================================================

// 把 [a, b) 的行文本原样打到 stderr（失败现场用）
fn tuis_dump_span(txt: &const byte, a: usize, b: usize) void {
    _ = sys_write(2, txt + a, b - a) catch {};
    tuis_puts("\n" as &const byte);
}

// 踩坑 81：帧里有没有「行内的 '\n'」（不变量：换行只能由行号表表达，段内不许再出现 '\n'）
fn tuis_row_has_lf() bool {
    return tui_rows_have_lf();
}

// 快照里第 row 行的字节区间
fn tuis_line_span(txt: &const byte, n: usize, row: usize, a: &usize, b: &usize) bool {
    var line: usize = 0;
    var start: usize = 0;
    var i: usize = 0;
    while i <= n {
        if i == n || txt[i] == 10 as byte {
            if line == row {
                a[0] = start;
                b[0] = i;
                return true;
            }
            line = line + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// 一行的左边界列（第一个非空白字符所在列）
fn tuis_row_edge_start(txt: &const byte, n: usize, row: usize) usize {
    var a: usize = 0;
    var b: usize = 0;
    if !tuis_line_span(txt, n, row, &a, &b) {
        return 0;
    }
    var i: usize = a;
    while i < b && txt[i] == 32 as byte {
        i = i + 1;
    }
    if i >= b {
        return 0;
    }
    return tty_cols_between(txt, a, i);
}

// 一行的右边界列（最后一个非空白字符的右边界）
fn tuis_row_edge_end(txt: &const byte, n: usize, row: usize) usize {
    var a: usize = 0;
    var b: usize = 0;
    if !tuis_line_span(txt, n, row, &a, &b) {
        return 0;
    }
    var e: usize = b;
    while e > a && txt[e - 1] == 32 as byte {
        e = e - 1;
    }
    return tty_cols_between(txt, a, e);
}

// 一行首 / 尾**非空白字符**的起始字节偏移（空行给 n）
fn tuis_row_edge_offsets(txt: &const byte, n: usize, row: usize, first: &usize, last: &usize) void {
    first[0] = n;
    last[0] = n;
    var a: usize = 0;
    var b: usize = 0;
    if !tuis_line_span(txt, n, row, &a, &b) {
        return;
    }
    var i: usize = a;
    while i < b && txt[i] == 32 as byte {
        i = i + 1;
    }
    if i >= b {
        return;
    }
    first[0] = i;
    var e: usize = b;
    while e > a && txt[e - 1] == 32 as byte {
        e = e - 1;
    }
    var s: usize = e - 1;                       // 回退到该字符的起始字节
    while s > a && tty_is_cont(txt[s]) {
        s = s - 1;
    }
    last[0] = s;
}

// 找出含 lit 的行号（从 from 起）；没有则返回 rows
fn tuis_find_lit_row(txt: &const byte, n: usize, from: usize, rows: usize, lit: &const byte) usize {
    const ln: usize = bufx_cstr_len(lit);
    var r: usize = from;
    while r < rows {
        var a: usize = 0;
        var b: usize = 0;
        if !tuis_line_span(txt, n, r, &a, &b) {
            return rows;
        }
        var i: usize = a;
        while i + ln <= b {
            if bufx_mem_eq(txt + i, lit, ln) {
                return r;
            }
            i = i + 1;
        }
        r = r + 1;
    }
    return rows;
}

// 行首 / 行尾那个字符必须是方框的边（竖边或圆角）
fn tuis_border_left_ok(p: &const byte) bool {
    return bufx_mem_eq(p, "│" as &const byte, 3)
        || bufx_mem_eq(p, "╭" as &const byte, 3)
        || bufx_mem_eq(p, "╰" as &const byte, 3);
}

// p 指向的 3 字节是否是**右边框**字符（│ / ╮ / ╯）。
// diff 浮窗的逐行闭合断言用；p 必须至少有 3 字节。
fn tuis_border_right_ok(p: &const byte) bool {
    return bufx_mem_eq(p, "│" as &const byte, 3)
        || bufx_mem_eq(p, "╮" as &const byte, 3)
        || bufx_mem_eq(p, "╯" as &const byte, 3);
}

// 一屏浮层：渲染 → 断言方框右边逐行对齐（+ 左右两边都在同一列）
fn tuis_overlay_frame_check(cols: usize, ok: &bool, tag: &const byte) void {
    tui_build();
    tuis_scan_rows(cols, ok, tag);
    var txt: Buf = buf_new(65536);
    defer { buf_free(&txt); }
    _ = tui_screen_text(&txt);
    const p: &const byte = txt.ptr as &const byte;
    const n: usize = txt.len;
    const top: usize = tuis_find_lit_row(p, n, 0, tui_nrows(), "╭" as &const byte);
    const bot: usize = tuis_find_lit_row(p, n, top + 1, tui_nrows(), "╰" as &const byte);
    if top >= tui_nrows() || bot >= tui_nrows() {
        tuis_fail(tag, "浮层没有画出来（找不到 ╭ / ╰）", ok);
        return;
    }
    const want_l: usize = tuis_row_edge_start(p, n, top);
    const want_r: usize = tuis_row_edge_end(p, n, top);
    var bad: bool = false;
    var bad_row: usize = 0;
    var got_l: usize = 0;
    var got_r: usize = 0;
    var r: usize = top;
    while r <= bot {
        got_l = tuis_row_edge_start(p, n, r);
        got_r = tuis_row_edge_end(p, n, r);
        var fo: usize = n;
        var lo: usize = n;
        tuis_row_edge_offsets(p, n, r, &fo, &lo);
        const closed: bool = fo < n && lo < n && tuis_border_left_ok(p + fo) && tuis_border_right_ok(p + lo);
        if got_l != want_l || got_r != want_r || !closed {
            bad = true;
            bad_row = r;
            break;
        }
        r = r + 1;
    }
    if bad {
        tuis_fail(tag, "浮层方框没有闭合成矩形（右边框逐行没对齐）", ok);
        tuis_puts("  cols=");
        tuis_num(cols);
        tuis_puts(" row=");
        tuis_num(bad_row);
        tuis_puts(" 该行左/右边界=");
        tuis_num(got_l);
        tuis_puts("/");
        tuis_num(got_r);
        tuis_puts(" 顶边左/右边界=");
        tuis_num(want_l);
        tuis_puts("/");
        tuis_num(want_r);
        tuis_puts("\n");
        var a: usize = 0;
        var b: usize = 0;
        var k: usize = top;
        while k <= bot && k < top + 16 {
            if tuis_line_span(p, n, k, &a, &b) {
                tuis_dump_span(p, a, b);
            }
            k = k + 1;
        }
    }
}

// 一组画布宽度 × 真实浮层内容：命令面板（真实命令表）/ 帮助 / 确认（prompt + 条目）
fn tuis_overlay_frames(ok: &bool, tag: &const byte) void {
    var cmds: Buf = buf_new(4096);
    defer { buf_free(&cmds); }
    agent_tui_commands(&cmds);            // 真机那张截图里的命令表（/permission 是最长的一行）
    const help: &const byte = "enter 发送 · ctrl+j / alt+enter 换行 · esc 中断 · ctrl+c 中断或退出\npgup/pgdn 滚动 · ctrl+home/end 顶/尾 · tab 计划模式 · shift+tab 访问模式 · ctrl+p 命令面板" as &const byte;
    const prompt: &const byte = "启用后不再询问：agent 可以直接改文件、跑任意命令（含关闭文件沙箱）。仅建议在你信任当前任务时使用。" as &const byte;
    const cjk: &const byte = "✓ Read Only（只读）\n✓ Workspace Write（工作区写）\n  Full access（全权）" as &const byte;
    const sizes: [usize: 5] = [120, 100, 80, 70, 60];
    var si: usize = 0;
    while si < 5 {
        const cols: usize = sizes[si];
        const rows: usize = 30;
        // 命令面板：**真实命令表** —— /permission 那一行 69 列，在 60 列的方框里必然要
        // 截断补 '…'，正是踩坑 40 的现场（其余几行都是短的，截断那条路只有它会走到）
        tuis_reset(cols, rows);
        tui_set_commands(cmds.ptr as &const byte, cmds.len);
        tui_overlay_list(TUI_OVK_PALETTE, "命令" as &const byte, 6, cmds.ptr as &const byte, cmds.len);
        tuis_overlay_frame_check(cols, ok, tag);
        tui_overlay_close();
        // 帮助浮层：整行全中文（宽字符 + 折行都走同一条排版）
        tuis_reset(cols, rows);
        tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, help, bufx_cstr_len(help));
        tuis_overlay_frame_check(cols, ok, tag);
        tui_overlay_close();
        // 确认浮层：多一行 prompt（正文预算与条目行同一条路）
        tuis_reset(cols, rows);
        tui_overlay_confirm(TUI_OVK_PLAN, prompt, bufx_cstr_len(prompt), cjk, bufx_cstr_len(cjk));
        tuis_overlay_frame_check(cols, ok, tag);
        tui_overlay_close();
        si = si + 1;
    }
    // 踩坑 81：确认型的 prompt 就是「要批准的东西」——read-only 下一条多行 bash 命令、
    // 或带控制字节的标题，都会被画进「帧里的一行」；不清洗就会把行拆开（文本跑出框外）。
    // 这条腿就把脏 prompt + 脏标题钉死（同族的 ask 型另在 tui-ask 轮）。
    var dirty: Buf = buf_new(512);
    defer { buf_free(&dirty); }
    _ = buf_append_cstr(&dirty, "第一行命令\n第二行命令" as &const byte);
    tuis_reset(120, 30);
    tui_overlay_menu_confirm(TUI_OVK_APPROVE, "标题一\n标题二" as &const byte,
        bufx_cstr_len("标题一\n标题二" as &const byte),
        dirty.ptr as &const byte, dirty.len,
        "批准并执行\n拒绝\n" as &const byte, bufx_cstr_len("批准并执行\n拒绝\n" as &const byte), 1);
    tui_build();
    tuis_scan_rows(120, ok, tag);
    tuis_overlay_frame_check(120, ok, tag);
    if tuis_row_has_lf() {
        tuis_fail(tag, "确认浮层里有行内换行（多行命令/标题没做单行清洗 ⇒ 文本跑出框外）", ok);
        tuis_dump_screen(tag);
    }
    if !tuis_screen_has("第一行命令 第二行命令" as &const byte) {
        tuis_fail(tag, "确认浮层把多行命令的换行丢了（应当折成空格）", ok);
        tuis_dump_screen(tag);
    }
    tui_overlay_close();
}
