// src/selftest/st_version.uya — 版本号的唯一性自测轮（P112，P114 起阶段串为空）
//
// 本文件：`version_rounds`（一条轮，四段判据）—— 版本号的**定义只有一处**这件事的
//   可执行版本：① 拼装函数逐字节正确；② 两个身份串的关系（`--version` 行里带着语义版本，
//   阶段串非空时也带着它 —— P114 之后它是空的，这一条退化成「行里只有语义版本」）；
//   ③ `User-Agent` 的身份段就是 `ver_ident_into` 的输出，且网关契约那段
//   后缀逐字还在；④ 真调一次 `dwh_unary("host.describe")`，它吐的版本就是语义版本。
// 不变量：① **两个身份串的期望值写死**（`VER_WANT_*` 那几个字面量）—— 拿被测函数算
//   期望值等于「改坏了也绿」；④ 那一段相反，它判的是**来源唯一**，所以期望是现场用
//   `VER_SEMVER` 拼的（它要抓的是「适配层自己抄了个数」这件事，不是某个具体数字）；
//   ② 这一轮不联网、不起子进程、不落盘（纯字符串 + 一次零值 host 的分派），几毫秒；
//   ③ 它守的是**唯一性**而不是某一个值：语义版本发版时会改、阶段串随开发线会改，
//   改了之后这一轮要跟着改的只有那几个 `VER_WANT_*` 常量。
// 依赖：foundation/bufx（Buf）、foundation/verx（`VER_NAME` / `VER_SEMVER` /
//   `ver_line_into` / `ver_ident_into`）、
//   net/httpc（`HC_USER_AGENT`
//   的身份段拼装口径）、web/whost（DSH 适配层的版本字段来源）。断言小工具复用
//   `stx_eq` / `out_err` 那一套（与 st_stats_ctx 同源，本文件不再自造一套）。
// 命名：对外只有 `version_rounds`（selftest_main 里一行调用）；私有前缀 `ver_`。
//
// 为什么要有这一轮（§16 踩坑那一族的第 N 个现场）：本轮之前同一份软件有三个版本号 ——
// `--version` 这个入口**根本不存在**，`/status` 与 TUI 脚注印 `p83-clip-any`，
// `User-Agent` 说 `uya-agent/0.1`，DSH 适配层对前端说 `"version":"0.0.1"`。用户问
// 「我装的是哪个版本」时，三个地方三个答案，而**没有任何测试看得见**这件事：
// 每个数都只是某个文件里的一段字面量，谁都不比谁权威。这一轮把「同一个源」变成判据。

// 期望值（**写死的字面量**，见文件头不变量①）。
// P114：阶段串已置空（`AGENT_VERSION` 是空串），所以版本行只剩「程序名 + 语义版本」、
// **不带括号**（`ver_line_into` 对空串一直是不画括号的）。这条字面量是逐字节判据，
// 所以「空阶段串却画了一对空括号」这种改法也会当场红。
const VER_WANT_LINE: &const byte = "uya-agent 0.1.0" as &const byte;
const VER_WANT_IDENT: &const byte = "uya-agent/0.1.0" as &const byte;
// 网关的客户端词表契约（`~/ai-gateway` internal/responses/dimensions.go 认的是**子串**）。
// 它**不是**版本，所以不进 verx；但它必须原样跟在身份段后面，这一条只能由这里钉。
const VER_WANT_UA_SUFFIX: &const byte =
    " (deepseek-harness-compatible)" as &const byte;

// 断言：Buf 与字面量逐字节相同（不等就 FAIL，并把两边都打出来）。
fn ver_eq(tag: &const byte, what: &const byte, got: &const Buf,
    want: &const byte, ok: &bool) void {
    if bufx_eq_cstr(got.ptr as &const byte, got.len, want) {
        return;
    }
    out_err("selftest[");
    out_err(tag);
    out_err("] FAIL: ");
    out_err(what);
    out_err("：期望 \"");
    out_err(want);
    out_err("\"，实际 \"");
    out_err_bytes(got.ptr as &const byte, got.len);
    out_err("\"\n");
    ok[0] = false;
}

// 判据①：`ver_line_into` 逐字节等于写死的那一行。
fn ver_check_line(tag: &const byte, ok: &bool) void {
    var line: Buf = buf_new(96);
    defer { buf_free(&line); }
    if !ver_line_into(&line) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ver_line_into 分配失败\n");
        ok[0] = false;
        return;
    }
    ver_eq(tag, "版本行", &line, VER_WANT_LINE, ok);
}

// 判据②：`ver_ident_into` 逐字节等于写死的那一串（`User-Agent` 的身份段）。
fn ver_check_ident(tag: &const byte, ok: &bool) void {
    var ident: Buf = buf_new(64);
    defer { buf_free(&ident); }
    if !ver_ident_into(&ident) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ver_ident_into 分配失败\n");
        ok[0] = false;
        return;
    }
    ver_eq(tag, "身份串", &ident, VER_WANT_IDENT, ok);
    // 两个串里的语义版本必须是**同一个**：`--version` 说 `uya-agent 0.1.0`，
    // UA 说 `uya-agent/0.1.0`。这一条判的是「那一处定义真的同时喂给了两条路」，
    // 所以它读的是同一份 `VER_SEMVER`，而不是又抄一遍数字。
    var line: Buf = buf_new(96);
    defer { buf_free(&line); }
    if !ver_line_into(&line) {
        return;
    }
    if !contains(&line, VER_SEMVER) || !contains(&ident, VER_SEMVER) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: 版本行与身份串里的语义版本分家了\n");
        ok[0] = false;
    }
}

// 判据③：网关的客户端词表后缀仍在（`User-Agent` 的后半段是不可改的契约）。
// `HC_USER_AGENT` 现在只剩这段后缀 —— 身份段由 `ver_ident_into` 现拼（P112），
// 所以这里钉的就正好是「剩下的那一半还在，且与身份段拼得起来」。
fn ver_check_ua(tag: &const byte, ok: &bool) void {
    if bufx_cstr_len(HC_USER_AGENT) == 0 {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: User-Agent 的网关后缀是空的（网关会落 unknown）\n");
        ok[0] = false;
        return;
    }
    if !bufx_eq_cstr(HC_USER_AGENT, bufx_cstr_len(HC_USER_AGENT),
        VER_WANT_UA_SUFFIX) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: User-Agent 网关后缀变了：实际 \"");
        out_err(HC_USER_AGENT);
        out_err("\"\n");
        ok[0] = false;
    }
    // 身份段 + 后缀 == 完整 UA（拼起来必须是**一句**，中间不许有缝）
    var full: Buf = buf_new(96);
    defer { buf_free(&full); }
    if !ver_ident_into(&full) {
        ok[0] = false;
        return;
    }
    _ = buf_append_cstr(&full, HC_USER_AGENT);
    ver_eq(tag, "完整 User-Agent", &full,
        "uya-agent/0.1.0 (deepseek-harness-compatible)" as &const byte, ok);
}

// 判据④：DSH 适配层（`host.describe`）的版本字段就是语义版本 —— **走真的分派口**。
// 这一条是四段里唯一「端到端」的：零值 host + 真 `dwh_unary`，判据落在**吐出来的 JSON
// 字节**上。修前这里回的是 `"version":"0.0.1"`（一个从来没有过对应发行版的号），
// 而它正是这一轮在修前会当场红的那一段 —— 只断言 `VER_SEMVER` 的形状是抓不到它的
// （`0.0.1` 形状也合法）。
fn ver_check_dsh(tag: &const byte, ok: &bool) void {
    var h: DwhHost = dwh_host_zero();
    defer { dwh_stop(&h); }
    var body: Buf = buf_new(16);
    defer { buf_free(&body); }
    var value: Buf = buf_new(512);
    defer { buf_free(&value); }
    const m: &const byte = "host.describe" as &const byte;
    if !dwh_unary(&h, m, bufx_cstr_len(m), &body, &value) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: host.describe 没实现（DSH 页面拿不到宿主信息）\n");
        ok[0] = false;
        return;
    }
    // 期望串现场拼：`"version":"<VER_SEMVER>"`。它读的是唯一的那份定义，所以这里判的是
    // 「适配层真的取了那一份」而不是「版本号恰好等于某个写死的数」。
    var want: Buf = buf_new(64);
    defer { buf_free(&want); }
    _ = buf_append_cstr(&want, "\"version\":\"");
    _ = buf_append_cstr(&want, VER_SEMVER);
    // 收尾引号用 `buf_append_cstr_z`：`contains` 按 **C 串**量针长（`strlen`），针没有
    // 结尾 NUL 就会一路读到堆里下一块内容 —— 实测那一版把上一轮释放的
    // `deepseek-harness-compatible)` 读了进来，报错信息里带一截垃圾（判据本身也歪了）。
    _ = buf_append_cstr_z(&want, "\"" as &const byte);
    if !contains(&value, want.ptr as &const byte) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: host.describe 报的版本不是唯一的那个（期望 ");
        out_err(want.ptr as &const byte);
        out_err("）：");
        out_err_bytes(value.ptr as &const byte, value.len);
        out_err("\n");
        ok[0] = false;
        return;
    }
    // 修前那三个数的痕迹：`0.0.1` 不许再出现在任何版本字段里（它不是一个版本，
    // 是「随手写的占位」）。判据收在这里，是因为它只可能来自这一处。
    if contains(&value, "\"version\":\"0.0.1\"" as &const byte) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: host.describe 又回 0.0.1 了（那个号从没有对应发行版）\n");
        ok[0] = false;
    }
}

// 版本号唯一性那一轮：四段判据全过才 PASS。任何一段红了都打出行名 + 期望/实际，
// 因为这一轮的全部价值就在「改坏了之后屏幕上要看得出是哪一处分家了」。
fn version_rounds(tag: &const byte) bool {
    var ok: bool = true;
    ver_check_line(tag, &ok);
    ver_check_ident(tag, &ok);
    ver_check_ua(tag, &ok);
    ver_check_dsh(tag, &ok);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}
