// src/selftest/st_mockserver.uya — 离线自测轮（selftest.uya 的拆分片 2/11）
//
// 本文件：mock LLM 服务端（跑在 fork 出的子进程里）；selftest 单轮
// 不变量：① mock 与断言必须**确定性**（同一夹具同一 verdict，不依赖真实网络/时钟/环境）；
//   ② 判定码只用**低 8 位**（子进程 `sys_exit` 会截断，261 显示成 5，见踩坑 89）；
//   ③ 每轮可单跑（`UYA_SELFTEST_*_ONLY`）且幂等，轮次之间不许残留全局状态；
//   ④ 轮次自己 fork 的子进程必须由该轮收干净，不许留孤儿。
// 依赖：libc（syscall/unistd/heap/fcntl/signal）、foundation/bufx、net（LLM 协议与 SSE）、
//   term 与 term/tui、tools、session、agent、vcs/gitx、diff；`mock_*` 全局与 `cfg_pin_api`
//   在锚点文件 selftest.uya 里（锚点只留文件头、mock 全局与入口 `selftest_main`）。
// 命名：对外 `probe_main`（--probe）/`selftest_main`（--selftest）在锚点；
//   本片私有前缀 `mock_*`、`sse_*`、`ty_*`、`resp_*`、`stx_*`、`tsx_*`、`dp_/dg_/gcr_/mx_/wt_`。

fn mock_server(lfd: i32) i32 {
    var round: i32 = 0;
    var verdict: i32 = 0;
    var limit: i32 = 2;
    var is_stream: bool = false;   // 由每轮请求体决定
    // P54：退化响应轮要断言「重发的就是同一个请求」——把第一轮收到的请求原文留一份，
    // 第二轮逐字节比对（比「数请求条数」强得多：改成多发一个带了新内容的请求就会红）。
    var first_rx: Buf = buf_new(8192);
    defer { buf_free(&first_rx); }
    if mock_mode == 3 {
        limit = 1;          // 401 轮：只服务一次，agent 拿到 401 就该退出
    }
    if mock_mode == 5 {
        limit = 3;          // 熔断轮：agent 的 max_steps 是 3
    }
    if mock_mode == 6 {
        limit = 1;          // 中断轮：客户端被打断后不会再发请求，只服务一次
    }
    if mock_mode == 12 {
        limit = 1;          // 压缩轮：只断言「压缩之后的那一次请求」（摘要请求不占轮次）
    }
    if mock_mode == 13 {
        limit = 2;          // 技能轮：工具轮 → 断言轮（/messages 不算轮次）
    }
    if mock_mode == 14 {
        limit = 2;          // 派生轮：工具轮 → 断言轮（子代理的请求不算轮次）
    }
    if mock_mode == 16 {
        limit = 1;          // workflow 轮：假脚本只派 1 个子代理
    }
    if mock_mode == 17 {
        limit = 15;         // 不限步数轮：14 轮工具调用 + 1 轮最终答案
    }
    if mock_mode == 18 {
        limit = HISTCAP_ROUNDS + 1;   // 长历史轮：40 轮工具调用 + 1 轮最终答案
    }
    if mock_mode == 19 {
        limit = 2;          // responses 流式轮：工具轮 + 最终答案
    }
    if mock_mode == 20 {
        limit = 2;          // responses 非流式轮：工具轮 + 最终答案
    }
    if mock_mode == 21 {
        limit = 3;          // 协商轮：responses(404) + chat 工具轮 + chat 最终答案
    }
    if mock_mode == 22 {
        limit = 1;          // responses 压缩轮：只断言「压缩之后的那一次请求」
    }
    if mock_mode == 23 {
        limit = 2;          // 控制字节轮：工具轮（跑出 NUL）→ 断言轮
    }
    if mock_mode == 30 {
        limit = 2;          // P21 只读轮：工具轮（write 被拒 / bash 无通道）→ 断言轮
    }
    if mock_mode == 31 {
        limit = 2;          // P21 沙箱轮：工具轮（沙箱里写文件）→ 断言轮
    }
    if mock_mode == 26 {
        limit = 2;          // P26 plan 闸门轮：工具轮（write/edit 被拒 + 无审阅渠道）→ 断言轮
    }
    if mock_mode == 24 {
        limit = 1;          // 诊断回显轮：只服务一次（agent 拿到 400 就该退出）
    }
    if mock_mode == 25 {
        limit = 2;          // 大参数轮：大参数工具轮 + 断言/最终答案轮
    }
    if mock_mode == 27 {
        limit = 3;          // P28 退不出轮：长命令轮 → 被中断的那一轮 → 第二个任务的答案
    }
    if mock_mode == 40 {
        limit = 1;          // P30 单步长流式轮：一个回合只有一步（长流式就停在中间）
    }
    if mock_mode == 41 || mock_mode == 42 {
        limit = 2;          // P54 退化响应轮：①退化（只有思考）②重发（41 给正文 / 42 再退化一次）
    }
    if mock_limit >= 0 {
        limit = mock_limit; // 各轮自己覆盖（例如「工具跑着就退出」只服务 1 轮）
    }
    while round < limit {
        // accept 最多等 10 秒：客户端不再发请求时 mock 必须自己退出，
        // 否则「mock 卡在 accept」会变成整个自测卡死（踩过）
        var lpfds: [PollFd: 1] = [PollFd{ fd: lfd, events: POLLIN, revents: 0 }];
        const lpr: i32 = sys_poll(&lpfds[0], 1, 10000) catch { 0; };
        if lpr <= 0 || (lpfds[0].revents & POLLIN) == 0 {
            // 请求数不够也用同一个 verdict 通道报出来（否则「断言没跑」会被误判成通过）
            if verdict == 0 && round < limit {
                return 62 + round;   // 62/63/64… 表示只服务了 round 次
            }
            return verdict;
        }
        var peer: [byte: 16] = [0: 16];
        var alen: u32 = 16;
        const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch {
            return 10;
        };
        var rx: Buf = buf_new(8192);
        if !mock_read_request(cfd, &rx) {
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            return 11;
        }
        // 全局不变量：任何请求体都不许带裸控制字节（chat 请求、responses 请求、
        // web_search 的 provider 请求都算）。
        // 判定码 240 与各 mode 自己的码（含 190…234）不冲突，看到 240 就是「转义漏了字节」。
        if verdict == 0 && sel_body_raw_control(&rx) != 0 {
            verdict = 240;
        }
        // P10：web_search 的 provider 请求（Anthropic Messages API）
        if contains(&rx, "POST /messages") || contains(&rx, "/messages HTTP") {
            expect(&rx, "web_search_20250305", 93, &verdict);   // 服务端搜索工具
            expect(&rx, "x-api-key: selftest-web-key", 94, &verdict);
            expect(&rx, "anthropic-version: 2023-06-01", 95, &verdict);
            if sel_count_sub(&rx, "query=uya language") != 1 {
                verdict = 96;   // 重复的 query 必须被去重（只出现一次）
            }
            expect(&rx, "query=second query", 97, &verdict);
            if !mock_send_messages(cfd) {
                verdict = 96;
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            // 注意：provider 的 /messages 请求**不占** chat 轮次
            continue;
        }
        is_stream = contains(&rx, "\"stream\":true");
        if mock_mode == 19 {
            // responses 流式：两轮请求都要断言「真按 responses 形状发」
            var text19: Buf = buf_new(8192);
            if round == 0 {
                expect(&rx, "POST /v1/responses", 190, &verdict);
                expect(&rx, "\"input\":", 191, &verdict);
                expect_absent(&rx, "\"messages\":", 192, &verdict);
                expect(&rx, "\"role\":\"developer\",\"content\":", 193, &verdict);
                expect(&rx, "\"store\":false", 194, &verdict);
                expect(&rx, "\"tools\":[{\"type\":\"function\",\"name\":\"read\"", 195, &verdict);
                expect_absent(&rx, "\"function\":{\"name\"", 196, &verdict);
                if !mock_resp_tool_text(&text19, "RESPONSES-TOOL-OK") {
                    verdict = 197;
                }
            } else {
                expect(&rx, "\"type\":\"function_call\",\"call_id\":\"call_r1\",\"name\":\"bash\"", 198, &verdict);
                expect(&rx, "\"type\":\"function_call_output\",\"call_id\":\"call_r1\"", 199, &verdict);
                expect(&rx, "RESPONSES-TOOL-OK", 200, &verdict);
                expect_absent(&rx, "\"tool_call_id\"", 201, &verdict);
                if !mock_resp_final_text(&text19, "RESPONSES-DONE") {
                    verdict = 202;
                }
            }
            if !mock_send_resp_sse(cfd, &text19) {
                verdict = 203;
            }
            buf_free(&text19);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 20 {
            // responses 非流式：请求必须 stream:false，响应是一次性 JSON
            var body20: Buf = buf_new(8192);
            if round == 0 {
                expect(&rx, "POST /v1/responses", 205, &verdict);
                expect(&rx, "\"stream\":false", 206, &verdict);
                expect(&rx, "\"input\":", 207, &verdict);
                if !mock_resp_json_tool(&body20, "RESPONSES-TOOL-OK") {
                    verdict = 208;
                }
            } else {
                expect(&rx, "\"type\":\"function_call_output\",\"call_id\":\"call_r1\"", 209, &verdict);
                if !mock_resp_json_final(&body20, "RESPONSES-DONE") {
                    verdict = 210;
                }
            }
            if !mock_send(cfd, &body20) {
                verdict = 211;
            }
            buf_free(&body20);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 21 {
            // 协商轮：未声明协议 → 第一个请求必须是 responses（回 404 逼出回退），
            // 之后每一轮都必须是 chat（第二轮也要，钉住「只协商一次」）
            if round == 0 {
                expect(&rx, "POST /v1/responses", 215, &verdict);
                expect(&rx, "\"input\":", 216, &verdict);
                var errb: Buf = buf_new(256);
                _ = buf_append_cstr(&errb, "{\"error\":{\"message\":\"mock: no such endpoint\"}}");
                if !mock_send_404(cfd, &errb) {
                    verdict = 217;
                }
                buf_free(&errb);
            } else {
                expect(&rx, "POST /v1/chat/completions", 218, &verdict);
                expect(&rx, "\"messages\":", 219, &verdict);
                expect_absent(&rx, "\"input\":", 220, &verdict);
                var body21: Buf = buf_new(1024);
                if round == 1 {
                    if !mock_steps_body(&body21) {
                        verdict = 221;
                    }
                } else {
                    expect(&rx, "RESPONSES-FALLBACK-OK", 222, &verdict);
                    if !mock_final_body(&body21, "RESPONSES-DONE") {
                        verdict = 223;
                    }
                }
                if is_stream {
                    if !mock_send_sse(cfd, &body21) {
                        verdict = 224;
                    }
                } else if !mock_send(cfd, &body21) {
                    verdict = 224;
                }
                buf_free(&body21);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 22 {
            // responses 下的自动压缩：摘要请求与随后那次请求都必须走 /v1/responses
            if contains(&rx, "acting as a compaction engine") {
                expect(&rx, "POST /v1/responses", 225, &verdict);
                expect_absent(&rx, "\"messages\":", 226, &verdict);
                expect(&rx, "## Primary Request and Intent", 227, &verdict);
                var sum22: Buf = buf_new(8192);
                if !mock_resp_final_text(&sum22, "## Primary Request and Intent\n- 测试压缩\n\n## Next Step\n- 继续") {
                    verdict = 228;
                }
                if !mock_send_resp_sse(cfd, &sum22) {
                    verdict = 229;
                }
                buf_free(&sum22);
                buf_free(&rx);
                _ = sys_close(cfd) catch {};
                continue;   // 摘要请求不占轮次
            }
            expect(&rx, "POST /v1/responses", 230, &verdict);
            expect(&rx, "automatically generated checkpoint", 231, &verdict);
            expect(&rx, "<compacted-summary>", 232, &verdict);
            var body22: Buf = buf_new(8192);
            if verdict == 0 && !mock_resp_final_text(&body22, "SELFTEST_COMPACT_RESP_OK") {
                verdict = 233;
            }
            if !mock_send_resp_sse(cfd, &body22) {
                verdict = 234;
            }
            buf_free(&body22);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 3 {
            // 直接回 401 + 错误体
            var errb: Buf = buf_new(256);
            _ = buf_append_cstr(&errb, "{\"error\":{\"message\":\"mock unauthorized\",\"type\":\"invalid_request_error\"}}");
            if !mock_send_401(cfd, &errb) {
                verdict = 30;
            }
            buf_free(&errb);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 24 {
            // 400 + 把收到的请求原样回显（转录里不许出现这段原文）
            if !mock_send_400_echo(cfd, &rx) {
                verdict = 34;
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 40 {
            // P30：单步长流式（正文等 mock_sse_gap_ns 之后才发）—— 用来验收「运行中敲 /status」
            var body40: Buf = buf_new(1024);
            if !mock_final_body(&body40, "SELFTEST_OK") {
                verdict = 246;
            }
            if !mock_send_sse_slow(cfd, &body40) {
                verdict = 247;
            }
            buf_free(&body40);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 41 || mock_mode == 42 {
            // P54：**退化响应**轮。第一轮一律回「正常收尾（finish_reason=stop）+ 只有思考、
            // 没有正文」—— 真机上最常见的退化形状，而且带 usage，好让证据里的 reasoning
            // 字节数与 token 读数都有确定的对照值（sse_finish 的 100/40/7/3 那一组）。
            // ⚠ 判定码一律 < 256：mock 是 fork 出来的子进程，码要经 sys_exit 回到父进程，
            // 只留低 8 位（261..268 会显示成 5/8/12…，报出来的码张冠李戴 —— 第一版踩过）。
            var text41: Buf = buf_new(4096);
            var pl41: Buf = buf_new(1024);
            if round == 0 {
                expect(&rx, "POST /v1/chat/completions", 212, &verdict);
                buf_reset(&first_rx);
                _ = buf_append(&first_rx, rx.ptr, rx.len);
                if !sse_delta_text(&text41, &pl41, MOCK_DEGEN_THINK, true) {
                    verdict = 213;
                }
                if !sse_finish(&text41, &pl41, "stop", true) {
                    verdict = 214;
                }
                _ = buf_append_cstr(&text41, "data: [DONE]\n\n");
            } else {
                // 第二轮 = 重发的那一次。**判据是逐字节相同**：退化那一步没有写进历史
                // （也没有写 assistant/message），所以重算出来的请求体必须与第一轮一字不差。
                if !mock_field_eq(&first_rx, &rx) {
                    verdict = 249;
                }
                if mock_mode == 42 {
                    // 第二腿：重发也只给空响应 —— 回合必须按错误收口（只重发一次，不许无限重发）
                    if !sse_delta_text(&text41, &pl41, MOCK_DEGEN_THINK, true) {
                        verdict = 175;
                    }
                    if !sse_finish(&text41, &pl41, "stop", true) {
                        verdict = 176;
                    }
                    _ = buf_append_cstr(&text41, "data: [DONE]\n\n");
                }
            }
            var sent41: bool = false;
            if round == 0 || mock_mode == 42 {
                // mock_send_resp_sse 干的只是「把一段现成的 SSE 文本按 chunked 发出去」（响应头
                // 两条协议完全一样），所以 chat 这条路径照样能用 —— 这里要的是**自己拼帧**
                // （只有思考 + finish_reason=stop + usage），mock_send_sse 那种「给 JSON 体、
                // 它替你转一帧」不够用。
                sent41 = mock_send_resp_sse(cfd, &text41);
            } else {
                // 重发成功：这一轮回正文，回合正常收尾（自测断言 AGENT_OK）
                var body41: Buf = buf_new(1024);
                if !mock_final_body(&body41, "SELFTEST-RETRY-OK") {
                    verdict = 177;
                }
                sent41 = mock_send_sse(cfd, &body41);
                buf_free(&body41);
            }
            if !sent41 {
                verdict = 178;
            }
            buf_free(&text41);
            buf_free(&pl41);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 25 {
            // 踩坑 35：第一轮给一个 arguments > 8 KiB 的 write 调用（老的固定容量
            // 就是在这里把整轮打成 "out of memory serializing tool_calls" 的），
            // 第二轮断言大参数**一字不差**地回到了请求里、工具结果配对完整。
            if round == 0 {
                var sb25: Buf = buf_new(32768);
                if !mock_bigcall_body(&sb25) {
                    verdict = 250;
                }
                var sent25a: bool = false;
                if is_stream {
                    sent25a = mock_send_sse(cfd, &sb25);
                } else {
                    sent25a = mock_send(cfd, &sb25);
                }
                if !sent25a {
                    verdict = 251;
                }
                buf_free(&sb25);
            } else {
                // 头尾标记都在 = arguments 一个字节都没少（截断/漏尾都会在这里露出来）
                if !contains(&rx, "CAP-HEAD|") || !contains(&rx, "|CAP-TAIL") {
                    verdict = 252;
                }
                // 工具真的派发了，结果也回灌了
                if !contains(&rx, "Created file") {
                    verdict = 253;
                }
                // assistant(tool_calls) 与它的 tool 结果必须配对完整（否则端点 400）
                if !mock_pairing_ok(&rx) {
                    verdict = 254;
                }
                var body25b: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body25b, "SELFTEST_BIGCALL_OK") {
                        verdict = 255;
                    }
                } else if !mock_final_body(&body25b, "SELFTEST_FAIL") {
                    verdict = 255;
                }
                var sent25b: bool = false;
                if is_stream {
                    sent25b = mock_send_sse(cfd, &body25b);
                } else {
                    sent25b = mock_send(cfd, &body25b);
                }
                if !sent25b {
                    verdict = 256;
                }
                buf_free(&body25b);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 16 {
            var body16: Buf = buf_new(256);
            if !mock_final_body(&body16, "WF-AGENT-OK") {
                verdict = 150;
            }
            var sent16: bool = false;
            if is_stream {
                sent16 = mock_send_sse(cfd, &body16);
            } else {
                sent16 = mock_send(cfd, &body16);
            }
            if !sent16 {
                verdict = 151;
            }
            buf_free(&body16);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 17 {
            // 不限步数轮：连给 14 轮 tool_calls（旧默认 12 会在第 12 步熔断），
            // 第 15 轮才给最终答案。断言口径是「请求里的 tool_call_id 条数 == 已经跑过的步数」，
            // 所以少跑一步（熔断/丢历史）都会被抓出来。
            const tool_rounds: i32 = 14;
            var body17: Buf = buf_new(512);
            if round < tool_rounds {
                if round > 0 && sel_count_sub(&rx, "\"tool_call_id\":\"call_step\"") != round as usize {
                    verdict = 160;
                }
                if !mock_steps_body(&body17) {
                    verdict = 161;
                }
            } else {
                if sel_count_sub(&rx, "\"tool_call_id\":\"call_step\"") != tool_rounds as usize {
                    verdict = 163;   // 14 步的工具结果必须一条不少地回到请求里
                }
                if !contains(&rx, "SELFTEST-STEP-OK") {
                    verdict = 164;
                }
                if verdict == 0 {
                    if !mock_final_body(&body17, "SELFTEST_UNLIMITED_OK") {
                        verdict = 165;
                    }
                } else if !mock_final_body(&body17, "SELFTEST_FAIL") {
                    verdict = 165;
                }
            }
            var sent17: bool = false;
            if is_stream {
                sent17 = mock_send_sse(cfd, &body17);
            } else {
                sent17 = mock_send(cfd, &body17);
            }
            if !sent17 {
                verdict = 162;
            }
            buf_free(&body17);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 23 {
            // 控制字节轮（P15）：第 1 轮让 agent 跑一条**输出里有 NUL** 的命令，
            // 第 2 轮断言这条工具结果回到请求里时，NUL 已经被转义成 \u0000。
            // 为什么必须转义：裸 NUL 进请求体 = 非法 JSON，Go 网关 400
            // invalid character '\x00' in string literal；而这条结果会一直留在历史里，
            // 于是「继续」也会一轮接一轮地 400（真机踩过）。
            // **两条协议都跑**（chat 与 responses 共用 jsonx 的转义，两边的请求体都要合法）：
