                }
                // glob：*.txt 应当列出 doc.txt 与 note.txt
                if !contains(&rx, "doc.txt") || !contains(&rx, "note.txt") {
                    verdict = 46;
                }
                // grep：按文件分组 + "Line N: 预览"
                if !contains(&rx, "Line 2: beta two") || !contains(&rx, "Line 4: beta four") {
                    verdict = 47;
                }
                if !contains(&rx, "No matches found") {
                    verdict = 48;
                }
                if !contains(&rx, "No files found") {
                    verdict = 49;
                }
                var body7: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body7, "SELFTEST_FS_OK") {
                        verdict = 43;
                    }
                } else if !mock_final_body(&body7, "SELFTEST_FAIL") {
                    verdict = 44;
                }
                var sent7b: bool = false;
                if is_stream {
                    sent7b = mock_send_sse(cfd, &body7);
                } else {
                    sent7b = mock_send(cfd, &body7);
                }
                if !sent7b {
                    verdict = 45;
                }
                buf_free(&body7);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 30 {
            // P21 只读轮：write 必须被硬拒；bash 在非交互会话里必须 fail closed（不给它跑的机会）
            if round == 0 {
                expect(&rx, "Current uya-agent file policy: read-only." as &const byte, 101, &verdict);
                expect(&rx, "The write and edit tools are refused" as &const byte, 102, &verdict);
                expect(&rx, "needs the user's approval for every command" as &const byte, 103, &verdict);
                var sb30: Buf = buf_new(4096);
                if !mock_perm_body(&sb30) {
                    verdict = 104;
                }
                var sent30: bool = false;
                if is_stream {
                    sent30 = mock_send_sse(cfd, &sb30);
                } else {
                    sent30 = mock_send(cfd, &sb30);
                }
                if !sent30 {
                    verdict = 105;
                }
                buf_free(&sb30);
            } else {
                expect(&rx, "write is refused in read-only mode" as &const byte, 106, &verdict);
                expect(&rx, "no answer channel" as &const byte, 110, &verdict);
                expect(&rx, "1: alpha one" as &const byte, 111, &verdict);   // read 仍然照常工作
                expect_absent(&rx, "PERM-BASH-RAN" as &const byte, 112, &verdict);   // bash 一个字都没跑
                var body30: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body30, "SELFTEST_PERM_OK") {
                        verdict = 113;
                    }
                } else if !mock_final_body(&body30, "SELFTEST_FAIL") {
                    verdict = 114;
                }
                var sent30b: bool = false;
                if is_stream {
                    sent30b = mock_send_sse(cfd, &body30);
                } else {
                    sent30b = mock_send(cfd, &body30);
                }
                if !sent30b {
                    verdict = 260;
                }
                buf_free(&body30);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 31 {
            // P21 沙箱轮：工作区内可写、区外被内核拒绝，命令本身确实跑过（TOOL-MARK 打在 stdout）
            if round == 0 {
                var sb31: Buf = buf_new(4096);
                if !mock_san_body(&sb31) {
                    verdict = 115;
                }
                var sent31: bool = false;
                if is_stream {
                    sent31 = mock_send_sse(cfd, &sb31);
                } else {
                    sent31 = mock_send(cfd, &sb31);
                }
                if !sent31 {
                    verdict = 116;
                }
                buf_free(&sb31);
            } else {
                expect(&rx, "TOOL-MARK" as &const byte, 117, &verdict);       // 命令真的在沙箱里跑过
                expect(&rx, "[exit code: " as &const byte, 118, &verdict);    // 区外那次重定向失败 → 非零退出
                var body31: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body31, "SELFTEST_SAN_OK") {
                        verdict = 119;
                    }
                } else if !mock_final_body(&body31, "SELFTEST_FAIL") {
                    verdict = 83;
                }
                var sent31b: bool = false;
                if is_stream {
                    sent31b = mock_send_sse(cfd, &body31);
                } else {
                    sent31b = mock_send(cfd, &body31);
                }
                if !sent31b {
                    verdict = 84;
                }
                buf_free(&body31);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 26 {
            // P26 plan 闸门轮：plan 模式下 write/edit 硬拒、exit_plan_mode 在管道里无渠道
            if round == 0 {
                expect(&rx, "Plan mode is active" as &const byte, 121, &verdict);
                expect(&rx, "refused until the user approves a plan" as &const byte, 122, &verdict);
                expect(&rx, "\"name\":\"exit_plan_mode\"" as &const byte, 123, &verdict);
                var sb26: Buf = buf_new(4096);
                if !mock_plan_body(&sb26) {
                    verdict = 124;
                }
                var sent26: bool = false;
                if is_stream {
                    sent26 = mock_send_sse(cfd, &sb26);
                } else {
                    sent26 = mock_send(cfd, &sb26);
                }
                if !sent26 {
                    verdict = 130;
                }
                buf_free(&sb26);
            } else {
                expect(&rx, "write is refused in plan mode" as &const byte, 125, &verdict);
                expect(&rx, "edit is refused in plan mode" as &const byte, 126, &verdict);
                expect(&rx, "no user-questions channel is available to review the plan" as &const byte, 127, &verdict);
                expect_absent(&rx, "Created file" as &const byte, 128, &verdict);
                expect_absent(&rx, "has been updated" as &const byte, 129, &verdict);
                var body26: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body26, "SELFTEST_PLAN_GATE_OK") {
                        verdict = 131;
                    }
                } else if !mock_final_body(&body26, "SELFTEST_FAIL") {
                    verdict = 132;
                }
                var sent26b: bool = false;
                if is_stream {
                    sent26b = mock_send_sse(cfd, &body26);
                } else {
                    sent26b = mock_send(cfd, &body26);
                }
                if !sent26b {
                    verdict = 133;
                }
                buf_free(&body26);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 6 {
            // 中断轮：发一帧工具调用后挂 300ms（不发 [DONE]），客户端应被 Ctrl-C 打断
            var sb6: Buf = buf_new(512);
            _ = buf_append_cstr(&sb6, "{\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"working on it\",\"tool_calls\":[{\"id\":\"call_x1\",\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"note.txt\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}");
            if !mock_send_sse_nodone(cfd, &sb6) {
                verdict = 33;
            }
            var req6: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 300000000 };
            var rem6: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
            _ = sys_nanosleep(&req6, &rem6) catch {};
            buf_free(&sb6);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 5 {
            // 一直给工具调用：agent 必须靠 max_steps 自己停下
            var sb: Buf = buf_new(2048);
            if !mock_toolcall_body(&sb, true) {
                verdict = 31;
            }
            var sent5: bool = false;
            if is_stream {
                sent5 = mock_send_sse(cfd, &sb);
            } else {
                sent5 = mock_send(cfd, &sb);
            }
            if !sent5 {
                verdict = 32;
            }
            buf_free(&sb);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if round == 0 {
            // 断言：tools schema 里 run_shell 的有无符合预期
            const has_shell: bool = contains(&rx, "\"name\":\"bash\"");
            if has_shell != mock_expect_shell {
                verdict = 12;
            }
            var body: Buf = buf_new(4096);
            var built: bool = false;
            if mock_mode == 2 {
                built = mock_toolcall_tools_body(&body);
            } else {
                built = mock_toolcall_body(&body, mock_expect_shell);
            }
            if !built {
                buf_free(&body);
                buf_free(&rx);
                _ = sys_close(cfd) catch {};
                return 13;
            }
            var sent_a: bool = false;
            if is_stream {
                sent_a = mock_send_sse(cfd, &body);
            } else {
                sent_a = mock_send(cfd, &body);
            }
            if !sent_a {
                verdict = 14;
            }
            buf_free(&body);
        } else {
            // 断言：第二轮请求里必须带上第一轮的工具执行结果
            if mock_mode != 2 {
                // write 的结果信封：<path>note.txt</path> … Created file
                if !contains(&rx, "Created file") || !contains(&rx, "note.txt") {
                    verdict = 15;
                }
            }
            // P3：运行中用户输入（steer）必须在**下一个 step 的请求**里出现
            if mock_expect_steer && !contains(&rx, "STEER-MARKER") {
                verdict = 29;
            }
            // P2 严格协议断言：assistant 的 tool_calls 原样回灌 + 每个结果都有配对的
            // tool_call_id（折叠协议下这些都不该出现，见 --compat-fold 轮）
            if mock_expect_fold {
                // 折叠协议：必须有折叠头，且不能出现 role:"tool"
                if !contains(&rx, "工具执行结果如下") || contains(&rx, "\"role\":\"tool\"") {
                    verdict = 28;
                }
            } else if is_stream {
                if !contains(&rx, "\"role\":\"assistant\"") || !contains(&rx, "\"tool_calls\"") {
                    verdict = 23;
                }
                if !contains(&rx, "\"role\":\"tool\"") || !contains(&rx, "\"tool_call_id\"") {
                    verdict = 24;
                }
                if !contains(&rx, "\"id\":\"call_") {
                    verdict = 25;   // 调用 id 必须原样出现在历史里
                }
                // 配对数：tools 轮有 4 个调用，其它轮 1 个
                // 每轮 mock 发出的调用数：shell 轮 2 个（write+bash）、
                // no-shell 轮 1 个、tools 轮 4 个、熔断轮沿用 2 个
                var want_ids: i32 = 2;
                if mock_mode == 1 {
                    want_ids = 1;
                } else if mock_mode == 2 {
                    want_ids = 4;
                }
                const got_ids: i32 = count_sub(&rx, "\"tool_call_id\":\"call_");
                if got_ids != want_ids {
                    verdict = 27;
                }
                // 折叠协议标记不该出现
                if contains(&rx, "工具执行结果如下") {
                    verdict = 26;
                }
            }
            if mock_expect_shell && mock_mode != 2 {
                if !contains(&rx, "SELFTEST-SHELL-OK") || !contains(&rx, "[exit code: 0]") {
                    verdict = 19;
                }
            }
            if mock_mode == 2 {
                // 读回的文本在请求里应当只被转义一次：line1\nline2 \"q\" tail
                // （如果字段值忘了反转义，这里会是 line1\\nline2，断言就会失败）
                if !contains(&rx, "2: line2 \\\"q\\\" tail") {
                    verdict = 20;
                }
                if !contains(&rx, "unsafe path") {
                    verdict = 21;
                }
                if !contains(&rx, "[timed out after 300ms]") || !contains(&rx, "[killed by signal: 9]") {
                    verdict = 22;
                }
            }
            var body2: Buf = buf_new(1024);
            if verdict == 0 {
                if !mock_final_body(&body2, "SELFTEST_OK 已写入 note.txt") {
                    buf_free(&body2);
                    buf_free(&rx);
                    _ = sys_close(cfd) catch {};
                    return 16;
                }
            } else {
                if !mock_final_body(&body2, "SELFTEST_FAIL") {
                    buf_free(&body2);
                    buf_free(&rx);
                    _ = sys_close(cfd) catch {};
                    return 17;
                }
            }
            var sent: bool = false;
            if is_stream {
                sent = mock_send_sse(cfd, &body2);       // 流式路径（内部就是 chunked）
            } else if mock_mode == 2 {
                sent = mock_send_chunked(cfd, &body2);   // 非流式 + chunked 解码
            } else {
                sent = mock_send(cfd, &body2);
            }
            if !sent {
                verdict = 18;
            }
            buf_free(&body2);
        }
        buf_free(&rx);
        _ = sys_close(cfd) catch {};
        round = round + 1;
    }
    _ = sys_close(lfd) catch {};
    return verdict;
}

// ============================================================
// selftest 单轮
// ============================================================
fn ws_prepare(ws: &const byte) bool {
    _ = sys_mkdir(ws as *const byte, 493 as u32) catch {};
    var f: Buf = buf_new(strlen(ws) + 32);
    defer { buf_free(&f); }
    if !buf_valid(&f) {
        return false;
    }
    _ = buf_append_cstr(&f, ws);
    // 必须补 NUL（§16 坑 2）：否则 unlink 拿到的是缓冲区后面的垃圾路径，
    // 清理静默失败 —— 第二轮就会撞上「write 需要先 read」的观察策略。
    _ = buf_append_cstr_z(&f, "/note.txt");
    _ = sys_unlink(&f.ptr[0] as *const byte) catch {};
    return true;
}

// path 的**前 512 字节**是否恰好等于 expect（多余字节也算不等）。
// 只读一次、不重试；false = 打不开 / 读失败 / 内容不等。
fn file_equals(path: &const byte, expect: &const byte) bool {
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var buf: [byte: 512] = [0: 512];
    const n: isize = sys_read(fd, &buf[0], 512) catch { 0 as isize; };
    if n < 0 {
        return false;
    }
    const got: usize = n as usize;
    const want: usize = strlen(expect);
    if got != want {
        return false;
    }
    var i: usize = 0;
    while i < want {
        if buf[i] != expect[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 逐字节比较「文件」与「一段内存」。
// file_equals 只读 512 字节，装不下大参数轮那 9 KiB 的正文，所以另开一个。
fn file_bytes_eq(path: &const byte, want: &const byte, want_len: usize) bool {
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var got: Buf = buf_new(want_len + 64);
    defer { buf_free(&got); }
    if !buf_valid(&got) {
        return false;
    }
    var chunk: [byte: 4096] = [0: 4096];
    while true {
        const n: isize = sys_read(fd, &chunk[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        if !buf_append(&got, &chunk[0], n as usize) {
            return false;
        }
        if got.len > want_len {
            return false;   // 比期望长：不用读完就知道不等
        }
    }
    if got.len != want_len {
        return false;
    }
    return bufx_mem_eq(got.ptr as &const byte, want, want_len);
}
