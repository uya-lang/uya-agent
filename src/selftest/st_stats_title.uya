// src/selftest/st_stats_title.uya — 离线自测轮（selftest.uya 的拆分片 9/11）
//
// 本文件：P22 轮：终端标题 —— 清洗 / 兜底派生 / 基标题 / 上屏编码；P46：会话标题可在执行过程中修改（/title · set_title 工具 · 自动；P22：任务状态（折叠行 / 箱体 / 报告）—— 纯函数轮；P22：滚动模式（--no-tui）的「活路径」—— 任务块真的被推到 tty 面板块并；P26：/diff 浮窗（git 修改的双列全文比对）；P34：工作区两轮（ws-resolve / ws-tool）—— 全离线，不联网、不用
// 不变量：① mock 与断言必须**确定性**（同一夹具同一 verdict，不依赖真实网络/时钟/环境）；
//   ② 判定码只用**低 8 位**（子进程 `sys_exit` 会截断，261 显示成 5，见踩坑 89）；
//   ③ 每轮可单跑（`UYA_SELFTEST_*_ONLY`）且幂等，轮次之间不许残留全局状态；
//   ④ 轮次自己 fork 的子进程必须由该轮收干净，不许留孤儿。
// 依赖：libc（syscall/unistd/heap/fcntl/signal）、foundation/bufx、net（LLM 协议与 SSE）、
//   term 与 term/tui、tools、session、agent、vcs/gitx、diff；`mock_*` 全局与 `cfg_pin_api`
//   在锚点文件 selftest.uya 里（锚点只留文件头、mock 全局与入口 `selftest_main`）。
// 命名：对外 `probe_main`（--probe）/`selftest_main`（--selftest）在锚点；
//   本片私有前缀 `mock_*`、`sse_*`、`ty_*`、`resp_*`、`stx_*`、`tsx_*`、`dp_/dg_/gcr_/mx_/wt_`。

// ============================================================
// P22 轮：终端标题 —— 清洗 / 兜底派生 / 基标题 / 上屏编码
//
// 这一轮钉四件事（都在纯函数与管道上做，不碰真终端）：
//   1) 清洗是**唯一**的标题规范化实现：OSC/CSI/ESC 序列整段消失（含未终结的尾巴）、
//      C0/C1 与 DEL 丢掉、空白（含 ASCII 空格）折叠成一个空格并去首尾、
//      零宽与方向控制符丢掉、坏 UTF-8 不留半个汉字、截断只落在码点边界；
//   2) 兜底派生对齐 DSH preset（前 5 个词 / ≤40 B / 先分词后按字节截断）；
//   3) 基标题 = `uya-agent · <工作目录名>`；
//   4) 上屏编码逐字节：`ESC[22t` 压栈 → `ESC]2;<标题>BEL` → 同标题不重复写 → `ESC[23t` 弹栈，
//      关掉通道之后一个字节都不写（这就是非 TTY / `--no-title` 路径的保证）。
// ============================================================

// 清洗结果与期望逐字节比，并断言结果是合法 UTF-8（屏幕上不许出现半个汉字）
fn ttx_clean_buf_eq(
    tag: &const byte,
    what: &const byte,
    src: &const byte,
    n: usize,
    max_bytes: usize,
    want: &const byte,
    ok: &bool
) void {
    var got: Buf = buf_new(1024);
    defer { buf_free(&got); }
    _ = tty_title_clean_into(&got, src, n, max_bytes);
    if !bufx_eq_cstr(got.ptr as &const byte, got.len, want)
        || !bufx_utf8_valid(got.ptr as &const byte, got.len) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ");
        out_err(what);
        out_err("：期望 \"");
        out_err(want);
        out_err("\"，实际 \"");
        out_err_bytes(got.ptr as &const byte, got.len);
        out_err("\"（");
        out_err_dec(got.len);
        out_err(" 字节）\n");
        ok[0] = false;
    }
}

// 同上，但输入是 C 串（长度现算，字面量里没有内嵌 NUL）
fn ttx_clean_eq(
    tag: &const byte,
    what: &const byte,
    src: &const byte,
    max_bytes: usize,
    want: &const byte,
    ok: &bool
) void {
    ttx_clean_buf_eq(tag, what, src, bufx_cstr_len(src), max_bytes, want, ok);
}

// 兜底派生：期望值逐字节比 + 结果必须合法 UTF-8 且不超过字节上限
fn ttx_fb_eq(
    tag: &const byte,
    what: &const byte,
    src: &const byte,
    max_words: usize,
    max_bytes: usize,
    want: &const byte,
    ok: &bool
) void {
    var got: Buf = buf_new(1024);
    defer { buf_free(&got); }
    _ = tty_title_fallback_into(&got, src, bufx_cstr_len(src), max_words, max_bytes);
    if !bufx_eq_cstr(got.ptr as &const byte, got.len, want)
        || !bufx_utf8_valid(got.ptr as &const byte, got.len)
        || got.len > max_bytes {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ");
        out_err(what);
        out_err("：期望 \"");
        out_err(want);
        out_err("\"，实际 \"");
        out_err_bytes(got.ptr as &const byte, got.len);
        out_err("\"（");
        out_err_dec(got.len);
        out_err(" 字节）\n");
        ok[0] = false;
    }
}

// 终端标题清洗轮（P22）：控制序列（OSC/CSI/ESC）整段丢弃、空标题兜底派生、基标题、上屏编码。
// 返回 false = 本轮红；纯函数 + 逐字节断言。
fn title_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- 1) 清洗：控制序列整段丢（OSC 到 BEL / ST、CSI、两字节与带中间字节的 ESC）----
    ttx_clean_eq(tag, "OSC（BEL 收尾）整段消失", "a\x1b]2;evil\x07b" as &const byte, 80, "ab" as &const byte, &ok);
    ttx_clean_eq(tag, "OSC（ST 收尾）整段消失", "a\x1b]0;x\x1b\\b" as &const byte, 80, "ab" as &const byte, &ok);
    ttx_clean_eq(tag, "未终结的 OSC 吃到尾", "x\x1b]2;pwn" as &const byte, 80, "x" as &const byte, &ok);
    ttx_clean_eq(tag, "CSI（SGR 颜色）整段消失", "a\x1b[31mb" as &const byte, 80, "ab" as &const byte, &ok);
    ttx_clean_eq(tag, "CSI 最长参数形态", "a\x1b[1;38;5;196mZ" as &const byte, 80, "aZ" as &const byte, &ok);
    ttx_clean_eq(tag, "两字节 ESC 序列", "a\x1bMb" as &const byte, 80, "ab" as &const byte, &ok);
    ttx_clean_eq(tag, "带中间字节的 ESC 序列", "a\x1b(Bb" as &const byte, 80, "ab" as &const byte, &ok);
    ttx_clean_eq(tag, "末尾孤立的 ESC", "ab\x1b" as &const byte, 80, "ab" as &const byte, &ok);

    // ---- 2) 清洗：控制字节 / 空白折叠 / 不可见字符 ----
    ttx_clean_eq(tag, "C0 与 DEL 丢掉", "a\x01\x07\x1f\x7fb" as &const byte, 80, "ab" as &const byte, &ok);
    ttx_clean_eq(tag, "空白折叠成一个空格并去首尾", "  a\t\tb\n\n c  " as &const byte, 80, "a b c" as &const byte, &ok);
    ttx_clean_eq(tag, "CR / VT / FF 也算空白", "a\rb\x0bc\x0cd" as &const byte, 80, "a b c d" as &const byte, &ok);
    ttx_clean_eq(tag, "全空白 → 空", " \t\n " as &const byte, 80, "" as &const byte, &ok);
    ttx_clean_eq(tag, "全控制字节 → 空", "\x1b[2J\x07" as &const byte, 80, "" as &const byte, &ok);
    ttx_clean_eq(tag, "零宽与方向控制符丢掉", "a​b‮c﻿d" as &const byte, 80, "abcd" as &const byte, &ok);
    ttx_clean_eq(tag, "词连接符（U+2060）丢掉", "a⁠b" as &const byte, 80, "ab" as &const byte, &ok);
    ttx_clean_eq(tag, "全角空格当空白", "a　b" as &const byte, 80, "a b" as &const byte, &ok);
    ttx_clean_eq(tag, "NBSP 当空白", "a\xc2\xa0b" as &const byte, 80, "a b" as &const byte, &ok);

    // ---- 3) 清洗：坏 UTF-8 不留半个汉字；截断只落在码点边界 ----
    var bad: Buf = buf_new(64);
    defer { buf_free(&bad); }
    _ = buf_append_cstr(&bad, "a");
    _ = buf_append_byte(&bad, 0xE4);            // 「中」的前两个字节（半截）
    _ = buf_append_byte(&bad, 0xB8);
    _ = buf_append_cstr(&bad, "b");
    _ = buf_append_byte(&bad, 0xFF);            // 坏引导字节
    _ = buf_append_cstr(&bad, "c");
    ttx_clean_buf_eq(tag, "半截汉字与坏字节丢掉", bad.ptr as &const byte, bad.len, 80, "abc" as &const byte, &ok);

    var cjk: Buf = buf_new(128);
    defer { buf_free(&cjk); }
    var k: usize = 0;
    while k < 14 {                              // 14 × 3 = 42 字节 > 40
        _ = buf_append_byte(&cjk, 0xE4);
        _ = buf_append_byte(&cjk, 0xB8);
        _ = buf_append_byte(&cjk, 0xAD);        // 「中」
        k = k + 1;
    }
    ttx_clean_buf_eq(tag, "40 B 上限切在码点边界（13 个字 = 39 B）", cjk.ptr as &const byte, cjk.len, 40, "中中中中中中中中中中中中中" as &const byte, &ok);
    ttx_clean_eq(tag, "上限为 0 → 空", "abc" as &const byte, 0, "" as &const byte, &ok);

    // ---- 4) 兜底派生：DSH 口径（前 5 个词、≤40 B，先分词后按字节截断）----
    ttx_fb_eq(tag, "只留前 5 个词", "一 二 三 四 五 六 七" as &const byte, 5, 40, "一 二 三 四 五" as &const byte, &ok);
    // 真实场景（PTY 验收里打的同一句）：第 5 个词被 40 B 上限切掉一半 → 只留放得下的部分
    ttx_fb_eq(tag, "词没切完就被字节上限截断", "把 tty-title 写进 note.txt 然后回答 ok" as &const byte, 5, 40, "把 tty-title 写进 note.txt 然后回" as &const byte, &ok);
    ttx_fb_eq(tag, "单个超长词按字节截断", "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa b" as &const byte, 5, 40, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" as &const byte, &ok);
    ttx_fb_eq(tag, "首条消息里混进 ESC/BEL 不落地", "任务\x1b]2;hacked\x07" as &const byte, 5, 40, "任务" as &const byte, &ok);
    ttx_fb_eq(tag, "全是空白不产生标题", "   \t " as &const byte, 5, 40, "" as &const byte, &ok);
    ttx_fb_eq(tag, "换行折叠成一个空格", "第一行\n第二行" as &const byte, 5, 40, "第一行 第二行" as &const byte, &ok);
    ttx_fb_eq(tag, "前导空白不占词预算", "  甲 乙 丙 丁 戊 己" as &const byte, 5, 40, "甲 乙 丙 丁 戊" as &const byte, &ok);

    // ---- 5) 基标题：`uya-agent · <工作目录名>` ----
    var base: Buf = buf_new(320);
    defer { buf_free(&base); }
    agent_title_base_into(&base, "/tmp/p21-ws/" as &const byte, 12);
    stx_eq(tag, "基标题带目录名（尾部斜杠不算）", &base, "uya-agent · p21-ws" as &const byte, &ok);
    agent_title_base_into(&base, "/" as &const byte, 1);
    stx_eq(tag, "根目录 → 只有 uya-agent", &base, "uya-agent" as &const byte, &ok);
    agent_title_base_into(&base, "" as &const byte, 0);
    stx_eq(tag, "空工作目录 → 只有 uya-agent", &base, "uya-agent" as &const byte, &ok);
    agent_title_base_into(&base, "/tmp/p21-ws" as &const byte, 11);
    ttx_clean_buf_eq(tag, "基标题过一遍清洗仍是它自己", base.ptr as &const byte, base.len, 80, "uya-agent · p21-ws" as &const byte, &ok);

    // ---- 6) 上屏编码：压栈 → OSC 2 → 去重 → 弹栈（逐字节）----
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        ty_fail(tag, "pipe2 失败", &ok);
        return false;
    }
    const evil: &const byte = "第二\x1b]2;evil\x07个" as &const byte;
    tty_title_begin(fds[1]);
    if !tty_title_active() {
        ty_fail(tag, "tty_title_begin 之后通道没打开", &ok);
    }
    tty_title_set(base.ptr as &const byte, base.len);
    tty_title_set(base.ptr as &const byte, base.len);                    // 同一条：不许重复写
    tty_title_set("" as &const byte, 0);                                 // 空标题：不许写（更不许把标签页清空）
    tty_title_set(evil, bufx_cstr_len(evil));                            // 上屏前再洗一遍
    tty_title_end();
    tty_title_set("通道关了以后" as &const byte, 18);                     // 关掉之后一个字节都不许写
    if tty_title_active() {
        ty_fail(tag, "tty_title_end 之后通道还开着", &ok);
    }
    var want: Buf = buf_new(512);
    defer { buf_free(&want); }
    _ = buf_append_cstr(&want, "\x1b[22t");
    _ = buf_append_cstr(&want, "\x1b]2;uya-agent · p21-ws\x07");
    _ = buf_append_cstr(&want, "\x1b]2;第二个\x07");
    _ = buf_append_cstr(&want, "\x1b[23t");
    var cap: Buf = buf_new(1024);
    defer { buf_free(&cap); }
    var rbuf: [byte: 512] = [0: 512];
    const rn: isize = sys_read(fds[0], &rbuf[0], 512) catch { -1 as isize; };
    if rn > 0 {
        _ = buf_append(&cap, &rbuf[0], rn as usize);
    }
    stx_buf_eq(tag, "压栈 + 两次 OSC 2 + 弹栈（去重 / 空标题 / 关通道都不写）", &cap, &want, &ok);
    _ = sys_close(fds[0]) catch {};
    _ = sys_close(fds[1]) catch {};
    if tty_title_last_len() != 0 {
        ty_fail(tag, "tty_title_end 之后没清掉「最近一次标题」", &ok);
    }
    // 标题串的字节上限：80 B（DSH maxTitleBytes），且切在码点边界上
    var long_t: Buf = buf_new(512);
    defer { buf_free(&long_t); }
    while long_t.len < 200 {
        _ = buf_append_cstr(&long_t, "中");
    }
    _ = tty_title_clean_into(&base, long_t.ptr as &const byte, long_t.len, 80);
    if base.len != 78 || !bufx_utf8_valid(base.ptr as &const byte, base.len) {
        ty_fail(tag, "80 B 上限没切在码点边界（78 = 26 个汉字）", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（清洗 / 兜底派生 5 词 40 B / 基标题 / OSC 2 与标题栈逐字节）\n");
    }
    return ok;
}

// ============================================================
// P46：会话标题可在执行过程中修改（/title · set_title 工具 · 自动起标题）
//
// 这一轮钉的是**语义与落盘**，不联网：
//   A) 显式改名（/title <t> 与 set_title 工具同一条路）：清洗、钉住、落 kind=user、写索引；
//   B) clear：落一条**空标题**的 user 事件（否则 --resume 折叠会把旧标题复活）、解锁自动起；
//   C) 自动起标题的 revision 门控与三条闸门（非交互 / 子代理 / 钉住 都不跑）；
//   D) 事件形状逐字节（kind 三档）+ 索引里的标题就是新值。
// 自动起标题真正发请求那条腿（provider 事件）在 Makefile 的 e2e-title-cmd 里
// 用 testdata/mock_gateway_sse.py 验收 —— 那里能数请求次数，这里不联网。
// ============================================================

// 把当前会话的标题事件从日志里读出来（最后一条的 title + kind），给断言用
fn ttc_last_title_event(path: &const byte, title: &Buf, kind: &Buf) bool {
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path, &r) {
        return false;
    }
    var line: Buf = buf_new(65536);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var found: bool = false;
    while sess_next(&r, &line) {
        if !sess_line_type(&line, &typ) {
            continue;
        }
        if !sv_eq_cstr(&typ, "session/title") {
            continue;
        }
        const view: &[byte] = line.ptr[0: line.len];
        if sess_json_str(view, "title", title) && sess_json_str(view, "kind", kind) {
            found = true;   // latest-wins：最后一条覆盖前面
        }
    }
    return found;
}

// 数日志里某类事件的条数（kind 为空 = 只按类型数）
fn ttc_count_events(path: &const byte, typ_want: &const byte, kind_want: &const byte) usize {
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path, &r) {
        return 0;
    }
    var line: Buf = buf_new(65536);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var n: usize = 0;
    while sess_next(&r, &line) {
        if !sess_line_type(&line, &typ) || !sv_eq_cstr(&typ, typ_want) {
            continue;
        }
        if bufx_cstr_len(kind_want) == 0 {
            n = n + 1;
            continue;
        }
        var kd: Buf = buf_new(32);
        defer { buf_free(&kd); }
        if sess_json_str(line.ptr[0: line.len], "kind", &kd)
            && bufx_eq_cstr(kd.ptr as &const byte, kd.len, kind_want) {
            n = n + 1;
        }
    }
    return n;
}

// 索引里该会话 id 的标题（最后一条记录）。
// 索引是**裸 jsonl**（每行一条会话记录、没有 header），所以不能走 sess_reader_load
// —— 它要求第一行是 `"type":"session"`（那是会话日志的头），这里直接整文件读进来按行切。
fn ttc_index_title(idx_path: &const byte, id: &const byte, out: &Buf) bool {
    buf_reset(out);
    const fd: i32 = sys_open(idx_path as *const byte, 0, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var data: Buf = buf_new(65536);
    defer { buf_free(&data); }
    var tmp: [byte: 8192] = [0: 8192];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 8192) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        _ = buf_append(&data, &tmp[0], n as usize);
    }
    var found: bool = false;
    var from: usize = 0;
    while from < data.len {
        var e: usize = from;
        while e < data.len && data.ptr[e] != 10 as byte {
            e = e + 1;
        }
        if e > from {
            const view: &[byte] = data.ptr[from: e];
            var got_id: Buf = buf_new(64);
            defer { buf_free(&got_id); }
            if sess_json_str(view, "id", &got_id)
                && bufx_eq_cstr(got_id.ptr as &const byte, got_id.len, id) {
                if sess_json_str(view, "title", out) {
                    found = true;   // latest-wins：最后一条覆盖前面
                }
            }
        }
        from = e + 1;
    }
    return found;
}

const TTC_WS: &const byte = "build/selftest_ws_title_cmd" as &const byte;

// 给 /title 的端到端轮铺一份配置：沙箱关、非 TUI、安静、禁 bash，工作区/agent_home 指向
// 本轮的假目录，模型写死 "m" 且不做 TLS 校验（离线）。调用方持有 c。
fn ttc_cfg(c: &Config) void {
    c[0] = cfg_default();
    c.sandbox = SAN_OFF;
    c.tui = false;
    c.quiet = true;
    c.allow_shell = false;
    c.workspace = buf_new(strlen(TTC_WS) + 8);
    _ = buf_append_cstr(&c.workspace, TTC_WS);
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_title_cmd_home");
    // 不发请求：这一轮的裸 /title 只走「没 key / 空历史 ⇒ 起不出来」那条快速返回
    c.api_key = buf_empty();
    c.model = buf_new(16);
    _ = buf_append_cstr(&c.model, "m");
    c.verify = HC_VERIFY_NONE;
}

// title-cmd 轮（P46）：/title 人类命令的端到端（设置/取消/回显）与自动起标题两条链。
// 返回 false = 本轮红；工作区由 TTC_WS 给出。
fn title_cmd_round(tag: &const byte) bool {
    var ok: bool = true;
    if !ws_prepare(TTC_WS) {
        ty_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    if !sess_mkdir_p("build/selftest_title_cmd_home" as &const byte) {
        ty_fail(tag, "会话根目录建不出来", &ok);
        return false;
    }
    var c: Config = cfg_default();
    ttc_cfg(&c);

    // 开一条真会话（--no-save 关掉：这一轮要读日志与索引）
    if !agent_session_create(&c) {
        ty_fail(tag, "建会话失败", &ok);
        cfg_free(&c);
        return false;
    }
    var sid: Buf = buf_new(64);
    defer { buf_free(&sid); }
    _ = buf_append(&sid, g_sess.id.ptr as &const byte, g_sess.id.len);
    _ = buf_append_byte(&sid, 0);   // 下面要当 C 串用（bufx_eq_cstr 走 strlen 口径）
    var spath: Buf = buf_new(1200);
    defer { buf_free(&spath); }
    _ = buf_append(&spath, g_sess.path.ptr as &const byte, g_sess.path.len);
    _ = buf_append_byte(&spath, 0);   // sess_reader_load 走的是 C 串口径（不补 NUL 会一路读到堆尾巴）
    // 命令分发要一份真 History（裸 /title 那条路会读它；没 key 时立刻返回）
    var h: History = hist_init();
    defer { hist_free(&h); }

    // ---- A1）显式改名（/title <t>）：落 kind=user + 钉住 + 清洗 ----
    var line: Buf = buf_new(512);
    var out: Buf = buf_new(2048);
    var suggest: Buf = buf_new(128);
    _ = buf_append_cstr(&line, "/title 把中文文件名修好");
    if !agent_title_cmd(&c, &h, &line, &out, &suggest) {
        ty_fail(tag, "/title <新标题> 应当成功", &ok);
    }
    stx_eq(tag, "/title 之后 g_sess.title 就是新标题", &g_sess.title,
        "把中文文件名修好" as &const byte, &ok);
    if !g_title_pinned {
        ty_fail(tag, "/title 之后标题应当被钉住（自动起标题不该再改写它）", &ok);
    }
    var ev_title: Buf = buf_new(256);
    var ev_kind: Buf = buf_new(32);
    defer { buf_free(&ev_title); }
    defer { buf_free(&ev_kind); }
    if !ttc_last_title_event(spath.ptr as &const byte, &ev_title, &ev_kind) {
        ty_fail(tag, "日志里没有 session/title 事件", &ok);
    } else {
        stx_eq(tag, "title 事件的 title 字段", &ev_title, "把中文文件名修好" as &const byte, &ok);
        stx_eq(tag, "显式改名落的 kind", &ev_kind, "user" as &const byte, &ok);
    }
    var idx_path: Buf = buf_new(1200);
    defer { buf_free(&idx_path); }
    // 用**解析后**的 agent home 拼绝对路径：整轮 selftest 里前面的轮次会 chdir
    // （ws-resolve / sess-list 那些），相对路径到这里已经不是启动时的 cwd 了。
    // agent_home() 的 len 含结尾那个 NUL（g_home 是 buf_append_cstr_z 建出来的），
    // 整段抄过来会把 "/index.jsonl" 落到 NUL 之后 —— 路径读到 NUL 就截断了（实测踩到）。
    var hraw: &[byte] = agent_home();
    var hlen: usize = hraw.len;
    while hlen > 0 && hraw.ptr[hlen - 1] == 0 as byte {
        hlen = hlen - 1;
    }
    _ = buf_append(&idx_path, hraw.ptr as &const byte, hlen);
    _ = buf_append_cstr(&idx_path, "/index.jsonl");
    _ = buf_append_byte(&idx_path, 0);
    var idx_title: Buf = buf_new(256);
    defer { buf_free(&idx_title); }
    if !ttc_index_title(idx_path.ptr as &const byte, sid.ptr as &const byte, &idx_title) {
        ty_fail(tag, "索引里找不到这条会话（/sessions 的标题列会空着）", &ok);
    } else {
        stx_eq(tag, "索引里的标题跟着改了", &idx_title, "把中文文件名修好" as &const byte, &ok);
    }

    // ---- A2）清洗：控制字符与空白全丢掉之后为空 ⇒ 报错且标题一个字节不动 ----
    var before: Buf = buf_new(256);
    defer { buf_free(&before); }
    _ = buf_append(&before, g_sess.title.ptr as &const byte, g_sess.title.len);
    _ = buf_append_byte(&before, 0);   // stx_eq 的 want 是 C 串口径，不补 NUL 会读到堆尾巴
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title \x1b[31m\x07  ");
    if agent_title_cmd(&c, &h, &line, &out, &suggest) {
        ty_fail(tag, "清洗后为空的标题不该被接受", &ok);
    }
    stx_eq(tag, "被拒的改名不许动标题", &g_sess.title, before.ptr as &const byte, &ok);

    // ---- A3）清洗：控制序列整段丢掉、空白折叠（走的是唯一的规范化实现）----
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title  a\x1b]2;evil\x07   b  ");
    _ = agent_title_cmd(&c, &h, &line, &out, &suggest);
    stx_eq(tag, "标题过清洗：OSC 丢掉 + 空白折叠 + 去首尾", &g_sess.title, "a b" as &const byte, &ok);

    // ---- B）clear：落一条**空标题**的 user 事件 + 解锁自动起标题 ----
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title clear");
    _ = agent_title_cmd(&c, &h, &line, &out, &suggest);
    if g_sess.title.len != 0 {
        ty_fail(tag, "/title clear 之后标题应当为空（终端回基标题）", &ok);
    }
    if g_title_pinned {
        ty_fail(tag, "/title clear 之后不该还钉着", &ok);
    }
    if !ttc_last_title_event(spath.ptr as &const byte, &ev_title, &ev_kind) {
        ty_fail(tag, "clear 之后日志里读不出最后一条 title 事件", &ok);
    } else {
        if ev_title.len != 0 {
            ty_fail(tag, "clear 落的必须是空标题事件（否则 --resume 会把旧标题复活）", &ok);
        }
        stx_eq(tag, "clear 落的 kind", &ev_kind, "user" as &const byte, &ok);
    }
    if !ttc_index_title(idx_path.ptr as &const byte, sid.ptr as &const byte, &idx_title) {
        ty_fail(tag, "clear 之后索引里读不到这条会话", &ok);
    } else if idx_title.len != 0 {
        ty_fail(tag, "clear 之后索引里的标题应当清空", &ok);
    }
    if ttc_count_events(spath.ptr as &const byte, "session/title" as &const byte, "user" as &const byte) != 3 {
        ty_fail(tag, "user kind 的 title 事件条数不对（应为 3：改名 / 清洗后改名 / clear；被拒的那次不落）", &ok);
    }

    // ---- C）自动起标题的闸门与 revision 门控 ----
    // C1：标题被钉住 ⇒ 不跑
    _ = agent_title_set_user(&c, "钉住的标题" as &const byte, strlen("钉住的标题" as &const byte));
    g_title_human_msgs = 1;
    g_title_auto_rev = 0;
    if agent_title_auto_on(&c) {
        ty_fail(tag, "标题被钉住时不该自动起标题", &ok);
    }
    // C2：clear 之后解锁 + 交互模式 + 有新的人类消息 ⇒ 会跑
    _ = agent_title_cmd(&c, &h, &line, &out, &suggest);   // line 此刻是 "/title clear"
    agent_set_interactive(true);                          // 自动起标题只服务交互界面
    g_title_human_msgs = 2;
    g_title_auto_rev = 0;
    if !agent_title_auto_on(&c) {
        ty_fail(tag, "clear + 新的人类消息之后自动起标题应当重新生效", &ok);
    }
    // C3：revision 门控：同一条人类消息不重复跑
    g_title_auto_rev = g_title_human_msgs;
    if agent_title_auto_on(&c) {
        ty_fail(tag, "同一条人类消息不该重复自动起标题（revision 门控）", &ok);
    }
    // C4：非交互（管道/CI）不跑
    agent_set_interactive(false);
    g_title_auto_rev = 0;
    if agent_title_auto_on(&c) {
        ty_fail(tag, "非交互模式下不该自动起标题（标题路径在那里本来就是空操作）", &ok);
    }
    // C5：子代理不跑（靠 cfg.is_subagent 门控）
    agent_set_interactive(true);
    c.is_subagent = true;
    if agent_title_auto_on(&c) {
        ty_fail(tag, "子代理不该自动起标题", &ok);
    }
    c.is_subagent = false;
    agent_set_interactive(false);

    // C6：挂待办 ≠ 发请求 —— 回合收尾只置标志，真正发请求在空闲循环
    // （p30-check 抓到过：在回合里同步发会把「回合没结束」的窗口拖长，
    //  运行中敲进来的命令要等 step 边界才被领取 ⇒ 屏幕上没反应）
    agent_set_interactive(true);
    g_title_human_msgs = 3;
    g_title_auto_rev = 0;
    g_title_auto_pending = false;
    agent_title_auto_schedule(&c);
    if !g_title_auto_pending {
        ty_fail(tag, "回合收尾应当挂下自动起标题的待办", &ok);
    }
    // 消费待办前要把两段静默也等掉（非 TUI 时 tui_last_key_ms 恒 0，只有 arm 窗口挡着）
    g_title_auto_arm_ms = 1;   // 很久以前 → 不在静默期内
    agent_title_auto_pending_tick(&c, &h);
    if g_title_auto_pending {
        ty_fail(tag, "待办消费之后标志应当清掉", &ok);
    }
    if g_title_auto_rev != g_title_human_msgs {
        ty_fail(tag, "消费待办时没有记 revision（同一句话会被反复起标题）", &ok);
    }
    // 没有待办时不该动 revision（空闲循环每 200ms 都会调它）
    g_title_auto_rev = 0;
    agent_title_auto_pending_tick(&c, &h);
    if g_title_auto_rev != 0 {
        ty_fail(tag, "没有待办时不该记 revision", &ok);
    }
    // 钉住的标题连待办都不该挂
    _ = agent_title_set_user(&c, "又钉住了" as &const byte, strlen("又钉住了" as &const byte));
    g_title_human_msgs = 4;
    g_title_auto_pending = false;
    agent_title_auto_schedule(&c);
    if g_title_auto_pending {
        ty_fail(tag, "标题被钉住时不该挂自动起标题的待办", &ok);
    }
    agent_set_interactive(false);

    // ---- D）set_title 工具：与 /title 同一条路（钉住 + 落盘 + 写索引）----
    var arena_raw: &void = malloc(65536);
    if ((arena_raw as &byte) as usize) == 0 {
        ty_fail(tag, "malloc 失败", &ok);
    } else {
        var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
        arena_init(&arena, arena_raw as &byte, 65536);
        var topts: Buf = buf_new(256);
        defer { buf_free(&topts); }
        _ = buf_append_cstr(&topts, `{"title":"模型起的标题"}`);
        var root: JsonValue = JsonValue.json_null();
        if !js_parse(&arena, topts.ptr as &const byte, topts.len, &root) {
            ty_fail(tag, "set_title 的参数不是合法 JSON", &ok);
        } else {
            var tout: Buf = buf_new(1024);
            defer { buf_free(&tout); }
            agent_title_tool_set(&c, &root, &tout);
            stx_eq(tag, "set_title 之后标题生效", &g_sess.title, "模型起的标题" as &const byte, &ok);
            if !g_title_pinned {
                ty_fail(tag, "模型改的标题也要钉住（否则下一条消息就被自动起标题覆盖）", &ok);
            }
            if !contains(&tout, "title set to" as &const byte) {
                ty_fail(tag, "set_title 的结果文案不对", &ok);
            }
        }
        // 空标题 = clear（与 /title clear 同语义）
        var empty_args: Buf = buf_new(64);
        defer { buf_free(&empty_args); }
        _ = buf_append_cstr(&empty_args, `{"title":""}`);
        arena_reset(&arena);
        var root2: JsonValue = JsonValue.json_null();
        if js_parse(&arena, empty_args.ptr as &const byte, empty_args.len, &root2) {
            var tout2: Buf = buf_new(1024);
            defer { buf_free(&tout2); }
            agent_title_tool_set(&c, &root2, &tout2);
            if g_sess.title.len != 0 || g_title_pinned {
                ty_fail(tag, "set_title 传空串应当等于 clear（标题清空且解锁）", &ok);
            }
        }
        // 缺 title 键 ⇒ 报用法，不动标题
        _ = agent_title_set_user(&c, "护栏标题" as &const byte, strlen("护栏标题" as &const byte));
        var noargs: Buf = buf_new(64);
        defer { buf_free(&noargs); }
        _ = buf_append_cstr(&noargs, `{}`);
        arena_reset(&arena);
        var root3: JsonValue = JsonValue.json_null();
        if js_parse(&arena, noargs.ptr as &const byte, noargs.len, &root3) {
            var tout3: Buf = buf_new(1024);
            defer { buf_free(&tout3); }
            agent_title_tool_set(&c, &root3, &tout3);
            stx_eq(tag, "缺 title 键时标题不动", &g_sess.title, "护栏标题" as &const byte, &ok);
        }
        free(arena_raw);
    }

    // ---- E）裸 /title：没 key / 空历史 ⇒ 起不出来但给用法，且标题不动 ----
    _ = agent_title_set_user(&c, "别动我" as &const byte, strlen("别动我" as &const byte));
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title");
    var h_empty: History = hist_init();
    defer { hist_free(&h_empty); }
    _ = agent_title_cmd(&c, &h_empty, &line, &out, &suggest);
    stx_eq(tag, "裸 /title 不该改标题（只是要一个建议）", &g_sess.title, "别动我" as &const byte, &ok);
    if !contains(&out, "用法：" as &const byte) {
        ty_fail(tag, "裸 /title 没给出用法", &ok);
    }
    if suggest.len != 0 {
        ty_fail(tag, "没 key 时不该真的生成出建议", &ok);
    }

    // ---- F）工具目录里真的有 set_title（模型要看得见才用得上）----
    var tools: Buf = buf_new(65536);
    defer { buf_free(&tools); }
    if !tools_json(&tools, false, true) {
        ty_fail(tag, "tools_json 失败", &ok);
    } else if !contains(&tools, "set_title" as &const byte) {
        ty_fail(tag, "工具目录里没有 set_title", &ok);
    }

    if g_sess.fd >= 0 {
        sess_close(&g_sess, "build/selftest_title_cmd_home" as &const byte);
    }
    cfg_free(&c);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（/title 改名·清洗·clear / 钉住与 revision 门控 / set_title 工具 / 索引同步 / 空标题事件）\n");
    }
    return ok;
}

// ============================================================
// P22：任务状态（折叠行 / 箱体 / 报告）—— 纯函数轮
//
// 全部用 fixture 表 + 显式 now_ms 调**纯函数**：不 poll、不读盘、不写终端，所以同一份输入
// 永远得到同一份字节。逐字节断言「进度条口径 / 段落排版 / 边框等宽 / 截断与降级」。
// ============================================================

// 在 b 里找 C 字面量 lit 的首次出现，返回偏移（找不到 -1）。
// 任务状态轮的断言辅助（b 是渲染输出）。
fn tsx_at(b: &const Buf, lit: &const byte) isize {
    const view: &[byte] = b.ptr[0: b.len];
    return find_sub(view, lit[0: strlen(lit)], 0);
}

// 断言 b 里**含** lit：不含就 FAIL（报 what），把 ok 置 false。
fn tsx_has(tag: &const byte, what: &const byte, b: &const Buf, lit: &const byte, ok: &bool) void {
    if tsx_at(b, lit) < 0 {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ");
        out_err(what);
        out_err("：输出里没有 \"");
        out_err(lit);
        out_err("\"\n");
        ok[0] = false;
    }
}

// 断言 b 里**不含** lit：含了就 FAIL（报 what），把 ok 置 false。
fn tsx_no(tag: &const byte, what: &const byte, b: &const Buf, lit: &const byte, ok: &bool) void {
    if tsx_at(b, lit) >= 0 {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ");
        out_err(what);
        out_err("：输出里不该有 \"");
        out_err(lit);
        out_err("\"\n");
        ok[0] = false;
    }
}

// 逐行按显示列量宽度：箱体每行必须等宽（P15 的四条硬规则在任务块上同样成立）
fn tsx_box_widths(tag: &const byte, what: &const byte, b: &const Buf, rows: usize, ok: &bool) void {
    var n: usize = 0;
    var want: usize = 0;
    var i: usize = 0;
    while i < b.len {
        var e: usize = i;
        while e < b.len && b.ptr[e] != 10 as byte {
            e = e + 1;
        }
        const w: usize = tty_cols_between(b.ptr as &const byte, i, e);
        if n == 0 {
            want = w;
        } else if w != want {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: ");
            out_err(what);
            out_err("：第 ");
            out_err_dec(n + 1);
            out_err(" 行宽度 ");
            out_err_dec(w);
            out_err(" != 第一行 ");
            out_err_dec(want);
            out_err("\n");
            ok[0] = false;
        }
        n = n + 1;
        i = e + 1;
    }
    if rows > 0 && n != rows {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ");
        out_err(what);
        out_err("：行数 ");
        out_err_dec(n);
        out_err(" != 期望 ");
        out_err_dec(rows);
        out_err("\n");
        ok[0] = false;
    }
}

// 往 TodoState 的第 i 项装一条任务（text + 状态）；i >= TODO_MAX 直接返回。
// 分配的是新 Buf（调用方负责 todo_free）；n 取 max(n, i+1)。
fn tsx_todo(t: &TodoState, i: usize, text: &const byte, st: u8) void {
    if i >= TODO_MAX {
        return;
    }
    t.items[i].content = buf_new(bufx_cstr_len(text) + 8);
    _ = buf_append_cstr(&t.items[i].content, text);
    t.items[i].status = st;
    if t.n < i + 1 {
        t.n = i + 1;
    }
}

// 往 JobTable 的第 i 项装一条作业（id/状态/退出码/多久以前/标签/输出）。
// secs_ago 是**秒**，内部换算成毫秒时间戳（基于 ua_now_ms）；i >= JOB_MAX 直接返回。
fn tsx_job(t: &JobTable, i: usize, id: i32, st: u8, code: i32, secs_ago: u64,
           label: &const byte, out_text: &const byte, trunc: bool) void {
    if i >= JOB_MAX {
        return;
    }
    const j: &Job = &t.items[i];
    const now: u64 = ua_now_ms();
    const back: u64 = secs_ago * (1000 as u64);
    j.used = true;
    j.id = id;
    j.kind = 0;
    j.pid = -1;
    j.rfd = -1;
    j.status = st;
    j.exit_code = code;
    j.truncated = trunc;
    j.start_ms = if now > back { now - back } else { 1 as u64 };
    j.read_off = 0;
    j.reaped = true;      // 不真 fork：只测显示
    j.label = buf_new(bufx_cstr_len(label) + 8);
    _ = buf_append_cstr(&j.label, label);
    j.buf = buf_new(bufx_cstr_len(out_text) + 8);
    _ = buf_append_cstr(&j.buf, out_text);
}

// 往 DelegTable 的第 i 项装一个子代理（id/kind/状态/多久以前/标签/输出行数）。
// secs_ago 是**秒**；out_lines 行 "line" 铺输出；i >= DELEG_MAX 直接返回。
fn tsx_agent(t: &DelegTable, i: usize, id: i32, kind: u8, st: u8, secs_ago: u64,
             label: &const byte, out_lines: usize) void {
    if i >= DELEG_MAX {
        return;
    }
    const d: &Deleg = &t.items[i];
    const now: u64 = ua_now_ms();
    const back: u64 = secs_ago * (1000 as u64);
    d.used = true;
    d.id = id;
    d.kind = kind;
    d.pid = -1;
    d.fd = -1;
    d.status = st;
    d.code = 0;
    d.reaped = true;
    d.read_off = 0;
    d.rounds = 2;
    d.max_rounds = 4;
    d.ended_noted = false;
    d.started_ms = if now > back { now - back } else { 1 as u64 };
    d.label = buf_new(bufx_cstr_len(label) + 8);
    _ = buf_append_cstr(&d.label, label);
    d.prompt = buf_new(16);
    d.sid = buf_new(16);
    d.objective = buf_new(16);
    d.buf = buf_new(16);
    var k: usize = 0;
    while k < out_lines {
        _ = buf_append_cstr(&d.buf, "line\n");
        k = k + 1;
    }
}

// 往 Goal 里装一份 fixture（phase / round / max_rounds / objective）。
// 只写字段不做校验；调用方负责 goal_free。
fn tsx_goal(g: &Goal, phase: &const byte, round: i32, max_rounds: i32, objective: &const byte) void {
    g.active_state = true;
    g.id = 1;
    g.revision = 2;
    g.phase = buf_new(bufx_cstr_len(phase) + 8);
    _ = buf_append_cstr(&g.phase, phase);
    g.objective = buf_new(bufx_cstr_len(objective) + 8);
    _ = buf_append_cstr(&g.objective, objective);
    g.round = round;
    g.max_rounds = max_rounds;
}

// 任务状态轮（P22，纯函数）：进度条口径、折叠行、箱体排版、边框等宽、截断与降级。
// 夹具 + 显式 now_ms，同一输入必须同一字节；返回 false = 本轮红。
fn tasks_render_round(tag: &const byte) bool {
    var ok: bool = true;
    const now: u64 = ua_now_ms();
    var b: Buf = buf_new(8192);
    defer { buf_free(&b); }

    // ---- A) 进度条与百分比口径（四舍五入 half-up）----
    tasks_bar(&b, 2, 4, 20);
    stx_eq(tag, "进度条 2/4", &b, "██████████░░░░░░░░░░" as &const byte, &ok);
    buf_reset(&b);
    tasks_bar(&b, 0, 4, 20);
    stx_eq(tag, "进度条 0/4", &b, "░░░░░░░░░░░░░░░░░░░░" as &const byte, &ok);
    buf_reset(&b);
    tasks_bar(&b, 4, 4, 20);
    stx_eq(tag, "进度条 4/4", &b, "████████████████████" as &const byte, &ok);
    buf_reset(&b);
    tasks_bar(&b, 3, 0, 20);
    stx_eq(tag, "进度条 total=0 不画", &b, "" as &const byte, &ok);
    buf_reset(&b);
    tasks_bar(&b, 3, 4, 0);
    stx_eq(tag, "进度条 cells=0 不画", &b, "" as &const byte, &ok);

    // ---- B) 输出体量 ----
    buf_reset(&b);
    tasks_fmt_bytes(&b, 0);
    stx_eq(tag, "0 字节", &b, "0B" as &const byte, &ok);
    buf_reset(&b);
    tasks_fmt_bytes(&b, 120);
    stx_eq(tag, "120 字节", &b, "120B" as &const byte, &ok);
    buf_reset(&b);
    tasks_fmt_bytes(&b, 1023);
    stx_eq(tag, "1023 字节", &b, "1023B" as &const byte, &ok);
    buf_reset(&b);
    tasks_fmt_bytes(&b, 1024);
    stx_eq(tag, "1024 字节", &b, "1.0K" as &const byte, &ok);
    buf_reset(&b);
    tasks_fmt_bytes(&b, 3277);
    stx_eq(tag, "3.2K", &b, "3.2K" as &const byte, &ok);
    buf_reset(&b);
    tasks_fmt_bytes(&b, 10239);
    stx_eq(tag, "9.9K", &b, "9.9K" as &const byte, &ok);
    buf_reset(&b);
    tasks_fmt_bytes(&b, 10240);
    stx_eq(tag, "10K（整 K 不带小数）", &b, "10K" as &const byte, &ok);
    buf_reset(&b);
    tasks_fmt_bytes(&b, 524288);
    stx_eq(tag, "512K", &b, "512K" as &const byte, &ok);
    buf_reset(&b);
    tasks_fmt_bytes(&b, 1048576);
    stx_eq(tag, "1 MiB", &b, "1.0M" as &const byte, &ok);
    buf_reset(&b);
    tasks_fmt_bytes(&b, 3000000);
    stx_eq(tag, "2.8M", &b, "2.8M" as &const byte, &ok);

    // ---- C) 空状态：折叠行/箱体/报告都要「一个字节都不画」----
    var t0: TodoState = TodoState{ items: [], n: 0 };
    todo_init(&t0);
    defer { todo_free(&t0); }
    var j0: JobTable = JobTable{ items: [], next_id: 1 };
    jobs_init(&j0);
    defer { jobs_free(&j0); }
    var d0: DelegTable = DelegTable{ items: [], next_id: 1 };
    deleg_init(&d0);
    defer { deleg_free(&d0); }
    var g0: Goal = goal_empty();
    defer { goal_free(&g0); }
    buf_reset(&b);
    tasks_line(&t0, &j0, &d0, &g0, 80, &b);
    stx_eq(tag, "空态折叠行", &b, "" as &const byte, &ok);
    buf_reset(&b);
    tasks_box(&t0, &j0, &d0, &g0, now, 80, TASKS_BLOCK_MAX_ROWS, true, &b);
    stx_eq(tag, "空态箱体", &b, "" as &const byte, &ok);
    buf_reset(&b);
    tasks_report(&t0, &j0, &d0, &g0, now, 80, &b);
    stx_eq(tag, "空态报告", &b,
        "（没有任务：todo 清单为空，也没有后台任务 / 子代理 / 目标）\n" as &const byte, &ok);

    // ---- D) 主 fixture：2 完成 / 1 进行中 / 1 待办 + 2 后台任务（1 跑中）+ 1 子代理 + 目标 ----
    var t: TodoState = TodoState{ items: [], n: 0 };
    todo_init(&t);
    defer { todo_free(&t); }
    tsx_todo(&t, 0, "写 src/tasks.uya（聚合 + 文本 + 快照推送）" as &const byte, TD_COMPLETED);
    tsx_todo(&t, 1, "接进 TUI 浮层与常驻块" as &const byte, TD_COMPLETED);
    tsx_todo(&t, 2, "补自测轮与 make 目标" as &const byte, TD_INPROGRESS);
    tsx_todo(&t, 3, "把 doc-audit 的告警清零" as &const byte, TD_PENDING);

    var j: JobTable = JobTable{ items: [], next_id: 3 };
    jobs_init(&j);
    defer { jobs_free(&j); }
    tsx_job(&j, 0, 1, JOB_RUNNING, 0, 12, "编译内核模块" as &const byte, "cc\nld\nok\n", false);
    tsx_job(&j, 1, 2, JOB_DONE, 0, 4, "跑一遍单测" as &const byte, "all 128 tests passed\n", false);

    var d: DelegTable = DelegTable{ items: [], next_id: 2 };
    deleg_init(&d);
    defer { deleg_free(&d); }
    tsx_agent(&d, 0, 1, DELEG_KIND_SUB, DELEG_RUNNING, 7, "审计 deleg 的等待循环" as &const byte, 12);

    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    tsx_goal(&g, "active" as &const byte, 3, 20, "把 /tasks 的任务状态进度接进 TUI 与滚动模式" as &const byte);

    buf_reset(&b);
    tasks_line(&t, &j, &d, &g, 200, &b);
    stx_eq(tag, "折叠行（四段齐）", &b,
        "▸ 任务 2/4 50% · 后台 1/2 · 子代理 1/1 · 目标 3/20" as &const byte, &ok);

    // 只有后台任务：首字形是 ·（没有进行中、清单为空）
    buf_reset(&b);
    tasks_line(&t0, &j, &d0, &g0, 200, &b);
    stx_eq(tag, "折叠行（只有后台任务）", &b, "▸ 后台 1/2" as &const byte, &ok);
    // 清单全完成且没有在跑的 → ✓
    var tc: TodoState = TodoState{ items: [], n: 0 };
    todo_init(&tc);
    defer { todo_free(&tc); }
    tsx_todo(&tc, 0, "甲" as &const byte, TD_COMPLETED);
    tsx_todo(&tc, 1, "乙" as &const byte, TD_COMPLETED);
    buf_reset(&b);
    tasks_line(&tc, &j0, &d0, &g0, 200, &b);
    stx_eq(tag, "折叠行（全完成 → ✓）", &b, "✓ 任务 2/2 100%" as &const byte, &ok);
    // 只有目标
    buf_reset(&b);
    tasks_line(&t0, &j0, &d0, &g, 200, &b);
    stx_eq(tag, "折叠行（只有目标）", &b, "· 目标 3/20" as &const byte, &ok);
    // 目标非 active：只报状态词
    var gb: Goal = goal_empty();
    defer { goal_free(&gb); }
    tsx_goal(&gb, "blocked" as &const byte, 5, 20, "被外部依赖卡住" as &const byte);
    buf_reset(&b);
    tasks_line(&t0, &j0, &d0, &gb, 200, &b);
    stx_eq(tag, "折叠行（目标 blocked）", &b, "· 目标 阻塞" as &const byte, &ok);
    // 窄终端：从尾部丢段补 `…`，恒 1 行、不超宽
    buf_reset(&b);
    tasks_line(&t, &j, &d, &g, 30, &b);
    tsx_has(tag, "窄终端折叠行", &b, "…" as &const byte, &ok);
    tsx_has(tag, "窄终端折叠行保头部", &b, "▸ 任务 2/4 50%" as &const byte, &ok);
    if tty_cols_between(b.ptr as &const byte, 0, b.len) > 31 {
        ty_fail(tag, "窄终端折叠行还是超宽（丢段没生效）", &ok);
    }
    if tsx_at(&b, "\n" as &const byte) >= 0 {
        ty_fail(tag, "折叠行里出现了换行（恒 1 行的约定破了）", &ok);
    }

    // ---- E) 箱体：11 行、逐行等宽、段落齐；agents 段不进箱体 ----
    buf_reset(&b);
    tasks_box(&t, &j, &d, &g, now, 60, TASKS_BLOCK_MAX_ROWS, true, &b);
    tsx_box_widths(tag, "主 fixture 箱体", &b, 11, &ok);
    tsx_has(tag, "箱体标题", &b, "┌─ tasks " as &const byte, &ok);
    tsx_has(tag, "箱体底框", &b, "└─ " as &const byte, &ok);
    tsx_has(tag, "清单段", &b, "清单" as &const byte, &ok);
    tsx_has(tag, "计数", &b, "2/4" as &const byte, &ok);
    tsx_has(tag, "百分比", &b, "50%" as &const byte, &ok);
    tsx_has(tag, "进度条进箱体", &b, "██████████░░░░░░░░░░" as &const byte, &ok);
    tsx_has(tag, "进行中字形", &b, "▸ 补自测轮与 make 目标" as &const byte, &ok);
    tsx_has(tag, "待办字形", &b, "· 把 doc-audit 的告警清零" as &const byte, &ok);
    tsx_has(tag, "完成字形", &b, "✓ 接进 TUI 浮层与常驻块" as &const byte, &ok);
    tsx_has(tag, "后台任务段", &b, "后台任务" as &const byte, &ok);
    tsx_has(tag, "跑中的 job", &b, "● job-1 [bash] running " as &const byte, &ok);
    tsx_has(tag, "job 输出体量", &b, "输出 9B" as &const byte, &ok);
    tsx_has(tag, "完成的 job", &b, "✓ job-2 [bash] completed · exit 0" as &const byte, &ok);
    tsx_has(tag, "目标段", &b, "目标" as &const byte, &ok);
    tsx_has(tag, "目标轮次", &b, "▸ active · round 3/20" as &const byte, &ok);
    tsx_no(tag, "子代理不进常驻箱体（P15 另有窗口）", &b, "子代理" as &const byte, &ok);

    // 折叠态：箱体退化回 1 行
    buf_reset(&b);
    tasks_box(&t, &j, &d, &g, now, 60, TASKS_BLOCK_MAX_ROWS, false, &b);
    stx_eq(tag, "折叠态箱体", &b,
        "▸ 任务 2/4 50% · 后台 1/2 · 子代理 1/1 · 目标 3/20\n" as &const byte, &ok);

    // 行数预算：max_rows 含上下边框；裁掉就补一行 `… 还有 N 行`
    buf_reset(&b);
    tasks_box(&t, &j, &d, &g, now, 60, 5, true, &b);
    tsx_box_widths(tag, "max_rows=5 的箱体", &b, 5, &ok);
    tsx_has(tag, "裁掉的行数标记", &b, "… 还有 " as &const byte, &ok);

    // 窄终端：内容按显示列截断，边框照样等宽（宽字符不许砍半个）
    buf_reset(&b);
    tasks_box(&t, &j, &d, &g, now, 40, TASKS_BLOCK_MAX_ROWS, true, &b);
    tsx_box_widths(tag, "40 列箱体", &b, 0, &ok);
    tsx_has(tag, "40 列下截断补 …", &b, "…" as &const byte, &ok);

    // ---- F) 清单行数上限：cap 之后补一行「还有 N 项」----
    var t8: TodoState = TodoState{ items: [], n: 0 };
    todo_init(&t8);
    defer { todo_free(&t8); }
    var i8: usize = 0;
    while i8 < 8 {
        tsx_todo(&t8, i8, "第 8 项里的某一条" as &const byte, TD_PENDING);
        i8 = i8 + 1;
    }
    buf_reset(&b);
    tasks_rows(&t8, &j0, &d0, &g0, now, 60, true, 6, &b);
    tsx_has(tag, "清单行数上限", &b, "… 还有 2 项（/tasks 看全部）" as &const byte, &ok);

    // ---- G) 报告：段落齐 + 清单按「进行中 → 待办 → 完成」分组（组内保持原序）----
    buf_reset(&b);
    tasks_report(&t, &j, &d, &g, now, 200, &b);
    tsx_has(tag, "报告含清单", &b, "清单" as &const byte, &ok);
    tsx_has(tag, "报告含子代理", &b, "子代理" as &const byte, &ok);
    tsx_has(tag, "报告含子代理行", &b, "● sub-1 [subagent] running " as &const byte, &ok);
    tsx_has(tag, "报告含提示行", &b, "ctrl+t 展开/收起常驻块" as &const byte, &ok);
    const at_ip: isize = tsx_at(&b, "▸ 补自测轮与 make 目标" as &const byte);
    const at_pd: isize = tsx_at(&b, "· 把 doc-audit 的告警清零" as &const byte);
    const at_cp: isize = tsx_at(&b, "✓ 写 src/tasks.uya（聚合 + 文本 + 快照推送）" as &const byte);
    if at_ip < 0 || at_pd < 0 || at_cp < 0 {
        ty_fail(tag, "报告里少了清单条目", &ok);
    } else if !(at_ip < at_pd && at_pd < at_cp) {
        ty_fail(tag, "清单没有按 进行中 → 待办 → 完成 分组（组内原序）", &ok);
    }

    // ralph 子代理才带 `Round n/m`（subagent 没有这个概念）
    var dr: DelegTable = DelegTable{ items: [], next_id: 2 };
    deleg_init(&dr);
    defer { deleg_free(&dr); }
    tsx_agent(&dr, 0, 1, DELEG_KIND_RALPH, DELEG_RUNNING, 12, "ralph loop" as &const byte, 1);
    buf_reset(&b);
    tasks_report(&t0, &j0, &dr, &g0, now, 200, &b);
    tsx_has(tag, "报告含 ralph 段", &b, "● sub-1 [ralph] running " as &const byte, &ok);
    tsx_has(tag, "报告含 ralph 轮次", &b, "Round 2/4" as &const byte, &ok);

    // ---- H) job 的三种终态字形与截断标记 ----
    var jk: JobTable = JobTable{ items: [], next_id: 4 };
    jobs_init(&jk);
    defer { jobs_free(&jk); }
    tsx_job(&jk, 0, 1, JOB_DONE, 1, 2, "失败的" as &const byte, "boom\n", false);
    tsx_job(&jk, 1, 2, JOB_KILLED, 137, 3, "被杀的" as &const byte, "partial\n", true);
    buf_reset(&b);
    tasks_report(&t0, &jk, &d0, &g0, now, 200, &b);
    tsx_has(tag, "非零退出 → ✗", &b, "✗ job-1 [bash] completed · exit 1" as &const byte, &ok);
    tsx_has(tag, "被杀的 → ■", &b, "■ job-2 [bash] killed · exit 137" as &const byte, &ok);
    tsx_has(tag, "输出被截断有标记", &b, "（已截断）" as &const byte, &ok);

    // ---- I) 纯函数性质：同一份输入两次调用逐字节相同 ----
    var b1: Buf = buf_new(8192);
    defer { buf_free(&b1); }
    var b2: Buf = buf_new(8192);
    defer { buf_free(&b2); }
    tasks_report(&t, &j, &d, &g, now, 200, &b1);
    tasks_report(&t, &j, &d, &g, now, 200, &b2);
    if b1.len != b2.len || !bufx_mem_eq(b1.ptr as &const byte, b2.ptr as &const byte, b1.len) {
        ty_fail(tag, "同一份输入的两次报告不一致（函数有隐藏状态？）", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（进度条/字节口径 + 折叠行四段与降级 + 箱体等宽与行数上限 + 报告分组 + job 三态）\n");
    }
    return ok;
}


// ============================================================
// P22：滚动模式（--no-tui）的「活路径」—— 任务块真的被推到 tty 面板块并画到屏幕上
//
// TUI 那条路在 tuiselftest 的 tui-tasks 轮里验（帧模型）；这一轮验的是另一半：
// tasks_panel_sync → view_panel_push → tty_block_* → tty_draw_line 真画一帧。
// 没有它，「折叠行 + agents 箱体拼成一份块」这件事在滚动模式里就是没人断言过的。
// ============================================================
fn tasks_scroll_round(tag: &const byte) bool {
    var ok: bool = true;
    tui_headless_enable(false);        // 走「非 TUI」那条分支
    view_init(true, 0);
    tasks_init();
    tasks_expand_set(false);
    agent_tasks_fixture_demo();

    tty_init(&tty_ui, 0);
    tty_ui.is_tty = true;
    tty_ui.raw = true;
    tty_ui.cols = 100;                 // 面板块宽 = 100 - 2 = 98
    tty_set_block_provider(&tty_ui, true);
    tty_set_prompt(&tty_ui, "[step 5] > " as &const byte);
    tty_line_clear(&tty_ui);

    var blk: Buf = buf_new(8192);
    defer { buf_free(&blk); }

    // ---- A) 折叠态：1 行折叠行 + agents 箱体，一起推下去 ----
    if !tasks_panel_sync() {
        ty_fail(tag, "第一次同步应当把任务块推给 tty", &ok);
    }
    if tty_block_len() == 0 {
        ty_fail(tag, "同步后面板块里应该有内容", &ok);
    }
    _ = buf_append(&blk, tty_ui.block.ptr, tty_ui.block.len);
    if !contains(&blk, "▸ 任务 2/4 50%" as &const byte) {
        ty_fail(tag, "折叠行没进面板块", &ok);
    }
    if !contains(&blk, "· 后台 1/2" as &const byte) {
        ty_fail(tag, "折叠行少了后台任务段", &ok);
    }
    if !contains(&blk, "┌─ agent " as &const byte) {
        ty_fail(tag, "运行中的子代理窗口没跟着一起推（P15 被挤掉了？）", &ok);
    }
    if contains(&blk, "┌─ tasks " as &const byte) {
        ty_fail(tag, "折叠态不该出现任务箱体", &ok);
    }

    // ---- B) 真画一帧：提示符上方必须看得见折叠行 ----
    var path: [byte: 64] = "build/selftest_tasks_scroll.txt";
    const pp: &const byte = &path[0] as &const byte;
    var lcfd: i32 = -1;
    var lcap: Buf = buf_new(16384);
    defer { buf_free(&lcap); }
    const lsaved: i32 = vw_cap_on(pp, &lcfd);
    tty_draw_line(&tty_ui, 2);
    vw_cap_off(pp, lsaved, lcfd, &lcap);
    if !contains(&lcap, "▸ 任务 2/4 50%" as &const byte) {
        ty_fail(tag, "画出来的帧里没有折叠行", &ok);
    }
    if !contains(&lcap, "[step 5] > " as &const byte) {
        ty_fail(tag, "画出来的帧里没有提示符（层序：面板行在提示符上面）", &ok);
    }

    // ---- C) 展开：块里换成箱体，且每一行都是 98 列（含中文按显示列算）----
    tasks_expand_set(true);
    if !tasks_panel_sync() {
        ty_fail(tag, "展开之后必须重推一次面板块", &ok);
    }
    buf_reset(&blk);
    _ = buf_append(&blk, tty_ui.block.ptr, tty_ui.block.len);
    if !contains(&blk, "┌─ tasks " as &const byte) {
        ty_fail(tag, "展开之后面板块里没有任务箱体", &ok);
    }
    if !contains(&blk, "│ 清单" as &const byte) {
        ty_fail(tag, "展开之后箱体里没有清单段", &ok);
    }
    if !contains(&blk, "└─ " as &const byte) {
        ty_fail(tag, "展开之后箱体没有底框", &ok);
    }
    tsx_box_widths(tag, "滚动模式面板块", &blk, 0, &ok);

    // ---- D) 再切回去：箱体消失，只剩折叠行 ----
    tasks_expand_set(false);
    _ = tasks_panel_sync();
    buf_reset(&blk);
    _ = buf_append(&blk, tty_ui.block.ptr, tty_ui.block.len);
    if contains(&blk, "┌─ tasks " as &const byte) {
        ty_fail(tag, "收起之后面板块里还留着任务箱体", &ok);
    }

    // 收尾：块与 fixture 都要清（后面的轮次共用这些全局）
    tty_set_block_provider(&tty_ui, false);
    tty_free(&tty_ui);
    tty_init(&tty_ui, 0);
    ttk_clear_fixtures();

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（滚动模式：折叠行+agents 一起进面板块 / 真画一帧看得见 / 展开成等宽箱体 / 收起即隐）\n");
    }
    return ok;
}

// 清掉任务块用过的四张表（fixture 装在真实 globals 上，必须还回去）
fn ttk_clear_fixtures() void {
    todo_free(&g_todos);
    todo_init(&g_todos);
    jobs_free(&g_jobs);
    jobs_init(&g_jobs);
    deleg_free(&g_deleg);
    deleg_init(&g_deleg);
    tasks_free();
    tasks_expand_set(false);
}

// ============================================================
// P26：/diff 浮窗（git 修改的双列全文比对）
//
//   diff-parse 纯函数：unified diff → 行表（上下文 / 配对 / 落单 / 溢出 / CRLF / 二进制 /
//              mode-only / 非 diff 文本 / 空输入），不碰 git、不碰 TUI
//   diff-git   端到端：真 git 造 fixture 仓（自己用 gitx_run 建），断言文件列表、
//              三栏内容、行号、增删计数、切换/夹取、刷新、文本回退、非仓库报错
// ============================================================

// b 是否恰好等于 C 字面量 lit（长度先比；两者都空也算相等）。diff 行表的断言辅助。
fn dp_eq(b: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if b.len != n {
        return false;
    }
    if n == 0 {
        return true;
    }
    return bufx_mem_eq(b.ptr as &const byte, lit, n);
}

// 取第 i 行第 side 侧的单元格文本
fn dp_cell(b: &Buf, i: usize, side: u8) void {
    var len: usize = 0;
    const p: &const byte = gd_cell(i, side, &len);
    buf_reset(b);
    _ = buf_append(b, p, len);
}

// 第 i 行的 kind（上下文/加/删/空）。越界或 gd_row_meta 失败返回 255（不是合法的 kind）。
fn dp_kind(i: usize) u8 {
    var r: GdRow = GdRow{ l_off: 0, l_len: 0, r_off: 0, r_len: 0, l_no: 0, r_no: 0, kind: 255 };
    if !gd_row_meta(i, &r) {
        return 255;
    }
    return r.kind;
}

// 取第 i 行的左右行号写进 lno/rno（0 表示该侧没有这一行）。
// 返回 false = 越界或取不到元数据（此时不动输出参数）。
fn dp_nos(i: usize, lno: &usize, rno: &usize) bool {
    var r: GdRow = GdRow{ l_off: 0, l_len: 0, r_off: 0, r_len: 0, l_no: 0, r_no: 0, kind: 255 };
    if !gd_row_meta(i, &r) {
        return false;
    }
    lno[0] = r.l_no;
    rno[0] = r.r_no;
    return true;
}

// 深挖失败原因时打出来（只在 FAIL 分支调用）
fn dp_dump(tag: &const byte) void {
    var d: Buf = buf_new(65536);
    defer { buf_free(&d); }
    gd_dump_rows(&d);
    out_err("selftest[");
    out_err(tag);
    out_err("] 行表：\n");
    out_err_bytes(d.ptr as &const byte, d.len);
}

// ============================================================
// P34：工作区两轮（ws-resolve / ws-tool）—— 全离线，不联网、不用模型
//
//   * ws-resolve：手写一份会话日志（header + 两条 session/workspace），断言「最后一条为准」、
//     记录的工作区不存在时退回当前工作区（fallback）、显式指定优先；
//   * ws-tool：走**真实工具入口**（JSON 参数 → 切工作区），断言相对路径规范化、幂等、
//     失败不改状态，以及「会话日志 + 索引」两条记录都跟上，/diff 文本头里写的是工作区。
//
// 两个硬约束：
//   1) 切换是真的 chdir —— 本轮结束必须把进程 cwd 还原（别的轮次都假定 cwd = 仓库根）；
//   2) g_fsctx 里存的是**裸指针** —— 指向本地 cfg 的 workspace 缓冲会在本轮结束后悬垂，
//      所以 ws-tool 收尾用 fsctx_init(base) 把它指回程序级那一份。
// ============================================================
const WST_HOME: &const byte = "build/selftest_ws_home" as &const byte;
const WST_A: &const byte = "build/selftest_ws_p31_a" as &const byte;
const WST_A_SUB: &const byte = "build/selftest_ws_p31_a/sub" as &const byte;
const WST_B: &const byte = "build/selftest_ws_p31_b" as &const byte;
const WST_GONE: &const byte = "build/selftest_ws_p31_gone" as &const byte;
const WST_ID: &const byte = "session-aaaa1111-2222-3333-4444-555566667777" as &const byte;
const WST_LOG: &const byte = "build/selftest_ws_home/sessions/--selftest-ws-p31-a--/session-aaaa1111-2222-3333-4444-555566667777/session.jsonl" as &const byte;

// 相对路径 → 绝对路径。base 必须**显式**传：本轮会真的 chdir，
// 之后再按「当前目录」拼相对路径就会拼到别的目录上去（自测第一版就这么错了）。
fn wst_abs(base: &const Buf, rel: &const byte, out: &Buf) bool {
    buf_reset(out);
    if !buf_append(out, base.ptr as &const byte, base.len) {
        return false;
    }
    if !buf_append_byte(out, 47) {
        return false;
    }
    return buf_append_cstr(out, rel);
}

// 逐字节比较两个 Buf。
// **不要**用 bufx_eq_cstr：它按 strlen 量「字面量」的长度，而 Buf 的缓冲没有 NUL 结尾，
// 于是量出来比实际长、n != m 直接判不等（自测第一版就被这条坑了）。
fn wst_eq(a: &const Buf, b: &const Buf) bool {
    if a.len != b.len {
        return false;
    }
    return bufx_mem_eq(a.ptr as &const byte, b.ptr as &const byte, a.len);
}

// 回到仓库根：本轮会真的 chdir，之后凡是**相对路径**的东西（fixture 仓、git -C）都得先站回来
fn wst_back(root: &const Buf) void {
    var rz: Buf = buf_new(root.len + 1);
    defer { buf_free(&rz); }
    _ = buf_append(&rz, root.ptr as &const byte, root.len);
    _ = buf_append_byte(&rz, 0);
    _ = sys_chdir(&rz.ptr[0] as *const byte) catch {};
}

// 给工作区轮（ws-resolve / ws-tool）铺假目录与 index.jsonl fixture。
// 返回 false = 建目录/写索引失败，本轮应直接判红。
fn wst_prepare() bool {
    _ = sess_mkdir_p(WST_HOME);
    _ = sess_mkdir_p(WST_A);
    _ = sess_mkdir_p(WST_A_SUB);
    _ = sess_mkdir_p(WST_B);
    var idx: Buf = buf_new(600);
    defer { buf_free(&idx); }
    _ = buf_append_cstr(&idx, WST_HOME);
    _ = buf_append_cstr(&idx, "/index.jsonl");
    _ = buf_append_byte(&idx, 0);
    _ = sys_unlink(idx.ptr as *const byte) catch {};
    return true;
}

// 手写一份会话日志：header 的 cwd = A，事件里两条 session/workspace（C → B，最后一条为准）。
// 三个路径按 **Buf** 传：Buf 缓冲没有 NUL 结尾，`bufx_cstr_len` 会一路扫进堆里的别的数据
// （全量 selftest 里当场扫到了状态行的 `| 缓存命中 …`，见踩坑 49 同一类坑）。
fn wst_write_log(cwd_a: &const Buf, ws_c: &const Buf, ws_b: &const Buf) bool {
    var dir: Buf = buf_new(800);
    defer { buf_free(&dir); }
    _ = buf_append_cstr(&dir, WST_HOME);
    _ = buf_append_cstr(&dir, "/sessions/--selftest-ws-p31-a--/session-aaaa1111-2222-3333-4444-555566667777");
    _ = buf_append_byte(&dir, 0);
    _ = sess_mkdir_p(dir.ptr as &const byte);
    var body: Buf = buf_new(4096);
    defer { buf_free(&body); }
    _ = buf_append_cstr(&body, "{\"type\":\"session\",\"version\":0,\"id\":\"");
    _ = buf_append_cstr(&body, WST_ID);
    _ = buf_append_cstr(&body, "\",\"createdAt\":1790993000000,\"cwd\":");
    _ = jw_str_into(&body, cwd_a.ptr as &const byte, cwd_a.len);
    _ = buf_append_cstr(&body, ",\"delegationDepth\":0,\"agentPreset\":\"standard\",\"model\":\"selftest-model\",\"provider\":\"uya-agent\"}\n");
    _ = buf_append_cstr(&body, "{\"type\":\"user/message\",\"seq\":0,\"time\":1790993000001,\"data\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"记住 5150\"}],\"source\":{\"kind\":\"user\"}}}\n");
    _ = buf_append_cstr(&body, "{\"type\":\"session/workspace\",\"seq\":1,\"time\":1790993000002,\"data\":{\"workspace\":");
    _ = jw_str_into(&body, ws_c.ptr as &const byte, ws_c.len);
    _ = buf_append_cstr(&body, ",\"previous\":");
    _ = jw_str_into(&body, cwd_a.ptr as &const byte, cwd_a.len);
    _ = buf_append_cstr(&body, ",\"source\":\"tool\"}}\n");
    _ = buf_append_cstr(&body, "{\"type\":\"session/workspace\",\"seq\":2,\"time\":1790993000003,\"data\":{\"workspace\":");
    _ = jw_str_into(&body, ws_b.ptr as &const byte, ws_b.len);
    _ = buf_append_cstr(&body, ",\"previous\":");
    _ = jw_str_into(&body, ws_c.ptr as &const byte, ws_c.len);
    _ = buf_append_cstr(&body, ",\"source\":\"human\"}}\n");
    var pz: Buf = buf_new(900);
    defer { buf_free(&pz); }
    _ = buf_append_cstr(&pz, WST_LOG);
    _ = buf_append_byte(&pz, 0);
    return write_text_file(pz.ptr as &const byte, body.ptr as &const byte);
}

// 索引里某个 id 的**最后一条**记录的 (cwd, path)。home 传**绝对**路径（本轮会 chdir）
fn wst_index_last(home_abs: &const Buf, id: &const byte, id_len: usize, cwd_out: &Buf, path_out: &Buf) bool {
    var idx: Buf = buf_new(65536);
    defer { buf_free(&idx); }
    var homez: Buf = buf_new(home_abs.len + 1);
    defer { buf_free(&homez); }
    _ = buf_append(&homez, home_abs.ptr as &const byte, home_abs.len);
    _ = buf_append_byte(&homez, 0);
    if !sess_read_index(homez.ptr as &const byte, &idx) {
        return false;
    }
    var found: bool = false;
    var pos: usize = 0;
    var line: Buf = buf_new(4096);
    defer { buf_free(&line); }
    while pos < idx.len {
        buf_reset(&line);
        var nl: usize = idx.len;
        var i: usize = pos;
        while i < idx.len {
            if idx.ptr[i] == 10 as byte {
                nl = i;
                break;
            }
            i = i + 1;
        }
        if nl > pos {
            _ = buf_append(&line, &idx.ptr[pos], nl - pos);
        }
        pos = nl + 1;
        var idv: Buf = buf_new(128);
        var cwdv: Buf = buf_new(1024);
        var pthv: Buf = buf_new(1600);
        defer { buf_free(&idv); buf_free(&cwdv); buf_free(&pthv); }
        if !sess_json_str(line.ptr[0: line.len], "id", &idv) {
            continue;
        }
        // id_len == 0 = 「不挑 id，取最后一条」（本轮只会写自己那一个会话）
        if id_len > 0 && !bufx_eq_cstr(idv.ptr as &const byte, idv.len, id) {
            continue;
        }
        _ = sess_json_str(line.ptr[0: line.len], "cwd", &cwdv);
        _ = sess_json_str(line.ptr[0: line.len], "path", &pthv);
        buf_reset(cwd_out);
        _ = buf_append(cwd_out, cwdv.ptr as &const byte, cwdv.len);
        buf_reset(path_out);
        _ = buf_append(path_out, pthv.ptr as &const byte, pthv.len);
        found = true;
    }
    return found;
}

// ============================================================
// ws-resolve：恢复会话时「这个会话在哪」的判定
// ============================================================
fn ws_resolve_round(tag: &const byte) bool {
    var ok: bool = true;
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        ty_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    // 收尾：把进程 cwd 放回去（本轮的切换是真的 chdir）
    defer {
        var rz: Buf = buf_new(root.len + 1);
        defer { buf_free(&rz); }
        _ = buf_append(&rz, root.ptr as &const byte, root.len);
        _ = buf_append_byte(&rz, 0);
        _ = sys_chdir(&rz.ptr[0] as *const byte) catch {};
    }
    _ = wst_prepare();
    var abs_a: Buf = buf_new(1024);
    defer { buf_free(&abs_a); }
    var abs_b: Buf = buf_new(1024);
    defer { buf_free(&abs_b); }
    var abs_c: Buf = buf_new(1024);
    defer { buf_free(&abs_c); }
    var abs_sub: Buf = buf_new(1024);
    defer { buf_free(&abs_sub); }
    var abs_gone: Buf = buf_new(1024);
    defer { buf_free(&abs_gone); }
    if !wst_abs(&root, WST_A, &abs_a) || !wst_abs(&root, WST_B, &abs_b) ||
        !wst_abs(&root, WST_A_SUB, &abs_sub) || !wst_abs(&root, WST_GONE, &abs_gone) {
        ty_fail(tag, "拿不到临时目录的绝对路径", &ok);
        return ok;
    }
    // C 用 A 的子目录（存在，且与 A/B 都不同）
    _ = buf_append(&abs_c, abs_sub.ptr as &const byte, abs_sub.len);
    if !wst_write_log(&abs_a, &abs_c, &abs_b) {
        ty_fail(tag, "写不出测试会话日志", &ok);
        return ok;
    }

    // ---- 1) sess_read_meta：id / header 的创建时工作区 / 最后一条 session/workspace ----
    var meta: SessMeta = sess_meta_empty();
    defer { sess_meta_free(&meta); }
    var lpz: Buf = buf_new(900);
    defer { buf_free(&lpz); }
    _ = buf_append_cstr(&lpz, WST_LOG);
    _ = buf_append_byte(&lpz, 0);
    if !sess_read_meta(lpz.ptr as &const byte, &meta) {
        ty_fail(tag, "sess_read_meta 读不出自己刚写的日志", &ok);
        return ok;
    }
    if !bufx_eq_cstr(meta.id.ptr as &const byte, meta.id.len, WST_ID) {
        ty_fail(tag, "meta.id 不对", &ok);
    }
    if !wst_eq(&meta.cwd, &abs_a) {
        ty_fail(tag, "meta.cwd 不是 header 里的创建时工作区", &ok);
    }
    if !wst_eq(&meta.workspace, &abs_b) {
        ty_fail(tag, "meta.workspace 不是**最后一条** session/workspace", &ok);
    }

    // ---- 2) pick：记录里是 B（存在）→ 切过去，并记下「会话在哪」 ----
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("selftest-model");
    cfg.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&cfg);
    if agent_workspace_switch(&cfg, abs_a.ptr as &const byte, abs_a.len) != WS_OK {
        ty_fail(tag, "切到工作区 A 失败", &ok);
    }
    var outw: Buf = buf_new(1024);
    defer { buf_free(&outw); }
    var fb: bool = false;
    agent_session_workspace_pick(&cfg, &meta, &outw, &fb);
    if fb {
        ty_fail(tag, "记录的工作区存在时不该报 fallback", &ok);
    }
    if !wst_eq(&cfg.workspace, &abs_b) {
        ty_fail(tag, "恢复会话没有把工作区切到会话记录的那一个（B）", &ok);
    } else if cfg.ws_src != 1 {
        ty_fail(tag, "工作区来源不是 session", &ok);
    }
    if !wst_eq(&cfg.resume_ws, &abs_b) {
        ty_fail(tag, "cfg.resume_ws 没有记下「会话在哪」（/status 与 /workspace 要看它）", &ok);
    }

    // ---- 3) 显式指定优先 ----
    if agent_workspace_switch(&cfg, abs_a.ptr as &const byte, abs_a.len) != WS_OK {
        ty_fail(tag, "第二次切到 A 失败", &ok);
    }
    cfg.ws_explicit = true;
    agent_session_workspace_pick(&cfg, &meta, &outw, &fb);
    if !wst_eq(&cfg.workspace, &abs_a) {
        ty_fail(tag, "显式指定过工作区时不该被会话记录顶掉", &ok);
    }
    cfg.ws_explicit = false;

    // ---- 4) 记录的工作区已经不存在 → 留在当前工作区 + fallback 标记 ----
    var meta2: SessMeta = sess_meta_empty();
    defer { sess_meta_free(&meta2); }
    meta2.id = buf_new(128);
    _ = buf_append(&meta2.id, WST_ID, bufx_cstr_len(WST_ID));
    meta2.cwd = buf_new(abs_gone.len + 8);
    _ = buf_append(&meta2.cwd, abs_gone.ptr as &const byte, abs_gone.len);
    meta2.workspace = buf_new(abs_gone.len + 8);
    _ = buf_append(&meta2.workspace, abs_gone.ptr as &const byte, abs_gone.len);
    meta2.header_ok = true;
    const r3: i32 = agent_workspace_switch(&cfg, abs_a.ptr as &const byte, abs_a.len);
    if r3 != WS_OK && r3 != WS_E_SAME {
        ty_fail(tag, "第三次切到 A 失败", &ok);
    }
    fb = false;
    agent_session_workspace_pick(&cfg, &meta2, &outw, &fb);
    if !fb {
        ty_fail(tag, "记录的工作区不存在时没有报 fallback", &ok);
    }
    if !wst_eq(&cfg.workspace, &abs_a) {
        ty_fail(tag, "fallback 时不该离开当前工作区", &ok);
    }

    // ---- 5) 幂等 + 相对路径规范化 ----
    const same: i32 = agent_workspace_switch(&cfg, abs_a.ptr as &const byte, abs_a.len);
    if same != WS_E_SAME {
        ty_fail(tag, "切到已经在的工作区应当返回 WS_E_SAME", &ok);
    }
    // 相对路径按**当前**工作区解析：此刻在 A，`sub` 就是 A/sub
    const rrel: i32 = agent_workspace_switch(&cfg, "sub" as &const byte, 3);
    if rrel != WS_OK {
        ty_fail(tag, "相对路径切不过去", &ok);
    } else if !wst_eq(&cfg.workspace, &abs_sub) {
        ty_fail(tag, "相对路径没有落成它该在的绝对路径", &ok);
        out_err("  cfg.workspace=");
        out_err_bytes(cfg.workspace.ptr as &const byte, cfg.workspace.len);
        out_err("\n  want(abs_sub)=");
        out_err_bytes(abs_sub.ptr as &const byte, abs_sub.len);
        out_err("\n");
    }
    return ok;
}
