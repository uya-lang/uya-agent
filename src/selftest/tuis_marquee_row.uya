// src/selftest/tuis_marquee_row.uya — TUI 自测：簇里只有选中项滚（P76）
//
// 本文件：tui-marquee-row（P76）：命令面板 / 选项表 / 动作行这些「一格一条」的簇里，
//   只有光标选中那一行滚动，其余行静态截断；选中行**钉住第一列**（命令名），只滑后面的
//   说明。四段：A 面板（只有选中行在动 + 钉住 + 方框闭合）、B 滚到尾与换选复位、
//   C 另两条簇（ask 选项 / reader 动作行，含一行多项的槽位）、D 真 PTY 端到端。
// 不变量：断言走 `tui_screen_text`（与画帧同源）；每段开头 `tuis_reset` 复位（跑马灯槽位
//   由 `tui_reset_all` 里的 `tui_marquee_reset` 清）—— 上一段停在中途的偏移会让这一段的
//   排版断言莫名红。判据只认**字节级屏幕**，不认「内部偏移是多少」。
// 依赖：见锚点 tuiselftest.uya 的文件头（本文件与它同处合并命名空间，无本地 use）；
//   真 PTY 那一段用本仓 web/ttyemu（`emu_*`）把捕获的帧字节解成网格。
// 命名：沿用本目录前缀 —— 夹具 `tuis_mr_*`、轮次入口 `tui_marquee_row_round`。

// 命令行夹具：第 1 条装不下（101 列）、第 2 条装得下、第 3 条装不下。分列口径与真实
// 命令表一致（命令名 + ≥2 个空格 + 说明），钉住段因此是 `/model [名字|提供方/名字] `。
// 行宽豁免：这三条要逐字节等于真命令表里的行（断了就改了被测输入；Uya 没有相邻字面量拼接）
const TUIS_MR_CMDS: &const byte = "/model [名字|提供方/名字]  看/切模型（按提供方分组；同名模型用 提供方/名字 指定；/effort 管推理强度）\n/exit      退出\n/watch     跟随子代理的实时过程消息（/watch sub-N · /watch off）\n" as &const byte;

// 一条**没有分列空格**的长行（钉不出钉住段 ⇒ 整行滑那一支）。
// 行宽豁免：同上，这一条要的就是「一个空格都没有的长中文串」
const TUIS_MR_NOPIN: &const byte = "这是一条没有任何分列空格的很长的说明文本用来钉整行滑的那一支路" as &const byte;

// 屏幕上第一行**包含** lit 的行号（找不到返回 tui_nrows()）。
fn tuis_mr_find(lit: &const byte) usize {
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, lit) {
            return r;
        }
        r = r + 1;
    }
    return tui_nrows();
}

// 把第 r 行的原文打到 fd 2（断言失败的现场，只诊断、不改判据）。
// 没有它就只能靠「猜哪一行不对」——本轮 A/B 两段的失败现场都是靠它一眼看出来的。
fn tuis_mr_dump(msg: &const byte, r: usize) void {
    tuis_puts("    ");
    tuis_puts(msg);
    tuis_puts(" row=");
    tuis_num(r);
    tuis_puts(" |");
    var line: Buf = buf_new(4096);
    defer { buf_free(&line); }
    if r < tui_nrows() {
        tui_row_text(r, &line);
    }
    _ = sys_write(2, line.ptr, line.len) catch {};
    tuis_puts("|\n");
}

// 浮层方框在**当前帧**里的行范围（找不到 ╭ / ╰ 时返回 false）。
// 判据只该看方框里面：脚注（cpu/ctx/时钟）、状态区、面板信息行本来就每拍在变，
// 把它们算进来等于判据恒红。
fn tuis_mr_box(box_top: &usize, box_bot: &usize) bool {
    var r: usize = 0;
    var top: usize = tui_nrows();
    var bot: usize = tui_nrows();
    while r < tui_nrows() {
        if top == tui_nrows() && tui_row_has(r, "╭" as &const byte) {
            top = r;
        }
        if tui_row_has(r, "╰" as &const byte) {
            bot = r;
        }
        r = r + 1;
    }
    box_top[0] = top;
    box_bot[0] = bot;
    return top < tui_nrows() && bot < tui_nrows() && bot > top;
}

// 快照里的第 r 行文本追加进 out（先 reset）。越界时 out 为空。
fn tuis_mr_span(snap: &const Buf, r: usize, out: &Buf) void {
    buf_reset(out);
    var a: usize = 0;
    var b: usize = 0;
    if tuis_line_span(snap.ptr as &const byte, snap.len, r, &a, &b) {
        _ = buf_append(out, snap.ptr + a, b - a);
    }
}

// 在**快照**里找第一行包含 lit 的行号（找不到返回 tui_nrows()）。
//
// 与 tuis_mr_find 的分工：那个查**当前帧**（`tui_row_has`），这个查一份 buf_new 出来的
// 快照 —— C 段的两次快照都在手上，行号必须从被比的那一份里取（本轮实测：拿当前帧的
// `tui_mr_find` 去找，第二帧已经重建过，找到的行号与快照对不上 ⇒「没上屏」假红）。
fn tuis_mr_find_in(snap: &const Buf, lit: &const byte) usize {
    var row: Buf = buf_new(4096);
    defer { buf_free(&row); }
    var r: usize = 0;
    while r < tui_nrows() {
        tuis_mr_span(snap, r, &row);
        if tuis_has(&row, lit) {
            return r;
        }
        r = r + 1;
    }
    return tui_nrows();
}

// 第 r 行在两次快照之间变了吗（逐字节比那一行）。
//
// ⚠ 为什么不能用「两份快照有差异」当判据（本轮实测的**假绿**）：浮层里还有别的会动的
// 东西（选中项说明、标题），整屏一比就恒真 —— 把动作行的槽位改坏重编，那一版**照样绿**。
// 判据必须落在**被测那一行**上。
fn tuis_mr_row_moved(a: &const Buf, b: &const Buf, r: usize) bool {
    var x: Buf = buf_new(4096);
    defer { buf_free(&x); }
    var y: Buf = buf_new(4096);
    defer { buf_free(&y); }
    tuis_mr_span(a, r, &x);
    tuis_mr_span(b, r, &y);
    return tuis_mr_differs(&x, &y);
}

// 两份屏幕快照有差异吗（逐字节）。
fn tuis_mr_differs(a: &const Buf, b: &const Buf) bool {
    if a.len != b.len {
        return true;
    }
    return !bufx_mem_eq(a.ptr, b.ptr, a.len);
}

// 走 n 拍心跳（每拍 400 ms = 跨过时间闸门一次）。不重建帧 —— 调用方自己 tui_build。
fn tuis_mr_ticks(t: &u64, n: usize) void {
    var k: usize = 0;
    while k < n {
        t[0] = t[0] + 400;
        _ = tui_marquee_tick(t[0]);
        k = k + 1;
    }
}

// 打开命令面板夹具并把光标放在第 i 项；返回 false = 前置不成立。
fn tuis_mr_palette(cmds: &const byte, cn: usize, i: usize) bool {
    tui_overlay_list(TUI_OVK_PALETTE, "命令" as &const byte, 6, cmds, cn);
    if !tui_overlay_open() || tui_overlay_item_count() == 0 {
        return false;
    }
    tui_overlay_sel_set(i);
    tui_build();
    return true;
}

// A 段：面板里只有选中那一行在动，且它钉住了命令名、方框仍逐行闭合。
//
// 判据的来历（用户报的现场）：P75 之后 23 条命令里 11 条一起滚 —— 整张面板每 400 ms
// 集体抖。所以必须同时钉两件事：① 非选中行**逐字节**不动；② 选中行**真的**在动。
// 只钉①会假绿（谁都不滚也满足），只钉②也会假绿（全都滚也满足）。
fn tuis_mr_leg_a(tag: &const byte, ok: &bool) void {
    tuis_reset(120, 30);
    if !tuis_mr_palette(TUIS_MR_CMDS, bufx_cstr_len(TUIS_MR_CMDS), 0) {
        tuis_fail(tag, "命令面板没打开（A 段的前置不成立）", ok);
        return;
    }
    // 前置：面板里同时有两条装不下的行（否则「只有一条在动」是空转的判据）
    if tuis_mr_find("看/切模型" as &const byte) >= tui_nrows()
        || tuis_mr_find("/watch" as &const byte) >= tui_nrows() {
        tuis_fail(tag, "两条长命令没同时上屏（A 段测不到东西）", ok);
        return;
    }
    // 前置：第一帧（偏移 0）里选中那一行必须带着命令名 —— 后面「钉住」才有的对比
    var bt0: usize = 0;
    var bb0: usize = 0;
    if !tuis_mr_box(&bt0, &bb0) || !tui_row_has(bt0 + 1, "看/切模型" as &const byte) {
        tuis_fail(tag, "第一帧里正文首行不是那条长命令（A 段测不到东西）", ok);
        return;
    }
    var f1: Buf = buf_new(65536);
    defer { buf_free(&f1); }
    var f2: Buf = buf_new(65536);
    defer { buf_free(&f2); }
    tui_screen_text(&f1);
    var t: u64 = 500000;
    tuis_mr_ticks(&t, 8);
    tui_build();
    tui_screen_text(&f2);
    // 逐行比：变了的行必须**只有**选中那一行（只看方框之内，见 tuis_mr_box）
    var bt: usize = 0;
    var bb: usize = 0;
    if !tuis_mr_box(&bt, &bb) {
        tuis_fail(tag, "找不到命令面板的方框（A 段测不到东西）", ok);
        return;
    }
    // 选中项是第 0 条 ⇒ 窗口首行（top = 0）就是它：正文第一行 = 方框顶边 + 1。
    // 不能用内容认（`看/切模型` 正是会被滑走的那半段），也不能用 `▸`（列表型浮层不带
    // 这个前缀，选中只体现在样式上）。
    const sel_row: usize = bt + 1;
    var r: usize = bt;
    var moved: usize = 0;
    var others: usize = 0;
    var row1: Buf = buf_new(4096);
    defer { buf_free(&row1); }
    var row2: Buf = buf_new(4096);
    defer { buf_free(&row2); }
    while r <= bb {
        tuis_mr_span(&f1, r, &row1);
        tuis_mr_span(&f2, r, &row2);
        if tuis_mr_differs(&row1, &row2) {
            moved = moved + 1;
            if r != sel_row {
                others = others + 1;
                tuis_mr_dump("非选中行也动了：" as &const byte, r);
            }
        }
        r = r + 1;
    }
    if moved == 0 {
        tuis_fail(tag, "选中行一个字节都没动（该滚的那一行不滚了）", ok);
        tuis_mr_dump("选中行当时是：" as &const byte, sel_row);
    } else if others > 0 {
        tuis_fail(tag, "非选中的行也在滚（面板集体抖 —— 用户报的现场）", ok);
    }
    // 钉住：滚过之后这一行仍以命令名开头（认得出是哪条命令）
    if moved > 0 && !tui_row_has(sel_row, "/model [名字|提供方/名字] " as &const byte) {
        tuis_fail(tag, "滚过之后命令名没钉住（认不出这是哪条命令）", ok);
        tuis_mr_dump("选中行当时是：" as &const byte, sel_row);
    }
    tuis_scan_rows(120, ok, tag);
    tuis_overlay_frame_check(120, ok, tag);
    tui_overlay_close();
}

// B 段：一路滚到尾（尾段出现），换选之后原行回到静态形态、再选回来从头开始。
fn tuis_mr_leg_b(tag: &const byte, ok: &bool) void {
    tuis_reset(120, 30);
    if !tuis_mr_palette(TUIS_MR_CMDS, bufx_cstr_len(TUIS_MR_CMDS), 0) {
        tuis_fail(tag, "命令面板没打开（B 段的前置不成立）", ok);
        return;
    }
    var t: u64 = 700000;
    var k: usize = 0;
    var at_tail: bool = false;
    while k < 400 {
        tuis_mr_ticks(&t, 1);
        tui_build();
        if tuis_mr_find("管推理强度）" as &const byte) < tui_nrows() {
            at_tail = true;
            break;
        }
        k = k + 1;
    }
    if !at_tail {
        tuis_fail(tag, "选中行滚不到尾部（尾段永远上不了屏）", ok);
        tui_overlay_close();
        return;
    }
    const sr: usize = tuis_mr_find("管推理强度）" as &const byte);
    // 钉住：尾段上屏时命令名**必须还在同一行**（这就是「只滑说明」那条口径的机器判据）
    if !tui_row_has(sr, "/model [名字|提供方/名字] " as &const byte) {
        tuis_fail(tag, "滚到尾之后命令名丢了（钉住失效）", ok);
        tuis_mr_dump("到尾时选中行是：" as &const byte, sr);
    }
    tuis_scan_rows(120, ok, tag);
    // 换选：光标挪到第 2 条（短的），原来那条必须回到「头部截断 + 尾随 `…`」
    tui_overlay_sel_set(1);
    tui_build();
    if tuis_mr_find("管推理强度）" as &const byte) < tui_nrows() {
        tuis_fail(tag, "光标移走之后那一行还停在尾部（偏移没复位）", ok);
    }
    const head: usize = tuis_mr_find("看/切模型" as &const byte);
    if head >= tui_nrows() {
        tuis_fail(tag, "换选之后原来那条命令整条不见了", ok);
    } else if !tui_row_has(head, "…" as &const byte) {
        tuis_fail(tag, "换选之后原来那条没有尾随 `…`（不是静态截断形态）", ok);
        tuis_mr_dump("换选后那条是：" as &const byte, head);
    }
    // 再挪回来：必须从**头部**重新开始（不是接着刚才的偏移）
    tui_overlay_sel_set(0);
    tui_build();
    if tuis_mr_find("管推理强度）" as &const byte) < tui_nrows() {
        tuis_fail(tag, "光标挪回来之后偏移没从头开始", ok);
    }
    tui_overlay_close();
}

// C 段之一：ask 的选项表 —— 只有光标那一项滚，非光标项静态截断。
fn tuis_mr_leg_c_ask(tag: &const byte, ok: &bool, t: &u64) void {
    // 行宽豁免：两条选项都要长过窗口（否则测的不是滚动那一支）
    const items: &const byte = "先做面板这一条很长的选项说明文字用来撑满宽度并溢出去尾巴甲\n后做另一条同样很长的选项说明文字用来撑满宽度并溢出去尾巴乙\n" as &const byte;
    tuis_reset(60, 30);
    tui_overlay_ask_open("提问" as &const byte, 6, "选哪个？" as &const byte, 10,
        items, bufx_cstr_len(items), false, 0);
    if !tui_overlay_open() {
        tuis_fail(tag, "ask 浮层没打开（C 段的前置不成立）", ok);
        return;
    }
    tui_build();
    var f1: Buf = buf_new(65536);
    defer { buf_free(&f1); }
    var f2: Buf = buf_new(65536);
    defer { buf_free(&f2); }
    tui_screen_text(&f1);
    tuis_mr_ticks(t, 8);
    tui_build();
    tui_screen_text(&f2);
    const o1: usize = tuis_mr_find_in(&f1, "先做面板" as &const byte);
    if o1 >= tui_nrows() {
        tuis_fail(tag, "ask 的选项没上屏（C 段测不到东西）", ok);
        tui_overlay_close();
        return;
    }
    if !tuis_mr_row_moved(&f1, &f2, o1) {
        tuis_fail(tag, "ask 的选中选项不滚", ok);
        tuis_mr_dump("ask 选项当时是：" as &const byte, o1);
    }
    // 非光标那一项不许动：光标下移到第 2 项之后，第 1 项必须回到静态形态
    // （静态截断只画头部 ⇒ 它的尾串「尾巴甲」不该在屏上）
    tui_keys_inject("\x1b[B" as &const byte, 3);     // ↓
    tui_build();
    if tuis_screen_has("尾巴甲" as &const byte) {
        tuis_fail(tag, "ask 的非选中选项没有回到头部静态截断（还在滚）", ok);
    }
    if !tui_row_has(tuis_mr_find("先做面板" as &const byte),
        "先做面板" as &const byte) {
        // 头部被滑走 = 这一项还在滚（对照实验⑤就走到这一条红）
        tuis_fail(tag, "ask 的非选中选项没有回到头部静态截断（头部被滑走了）", ok);
    }
    tuis_scan_rows(60, ok, tag);
    tui_overlay_close();
}

// C 段之二：reader 的动作行 —— 一行里能排好几个动作，只有选中那个滚。
// 这一段顺带钉「一行多项共用槽位」那个缺陷：共用时选中的永远不滚（见 watch.uya 的注释）。
fn tuis_mr_leg_c_reader(tag: &const byte, ok: &bool, t: &u64) void {
    // 行宽豁免：动作说明要长过窗口，才进得了滚动那一支
    const acts: &const byte = "这一条动作的说明文本很长很长很长很长很长很长很长很长很长很长很长很长尾巴甲\n这一条也很长很长很长很长很长很长很长很长很长很长很长很长很长很长尾巴乙\n" as &const byte;
    tuis_reset(80, 30);
    tui_overlay_reader(TUI_OVK_PLAN, "计划" as &const byte, 6,
        "正文" as &const byte, 6, acts, bufx_cstr_len(acts), 0);
    if !tui_overlay_open() {
        tuis_fail(tag, "reader 浮层没打开（C 段的前置不成立）", ok);
        return;
    }
    tui_build();
    var g1: Buf = buf_new(65536);
    defer { buf_free(&g1); }
    var g2: Buf = buf_new(65536);
    defer { buf_free(&g2); }
    tui_screen_text(&g1);
    tuis_mr_ticks(t, 8);
    tui_build();
    tui_screen_text(&g2);
    const a1: usize = tuis_mr_find_in(&g1, "这一条动作" as &const byte);
    if a1 >= tui_nrows() {
        tuis_fail(tag, "reader 的动作行没上屏（C 段测不到东西）", ok);
        tui_overlay_close();
        return;
    }
    // ⚠ 必须判**动作那一行**：整屏一比会被选中项说明那一路盖住（本轮实测的假绿 ——
    // 把动作行的槽位去掉 `+ i` 重编，整屏判据照样绿）
    if !tuis_mr_row_moved(&g1, &g2, a1) {
        tuis_fail(tag, "reader 动作行里选中的那个不滚（一行多项的槽位撞了？）", ok);
        tuis_mr_dump("动作行当时是：" as &const byte, a1);
    }
    tuis_scan_rows(80, ok, tag);
    tui_overlay_close();
}

// C 段之三：没有分列空格的长行 —— 钉不出名字，整行滑（不是「不滚」）。
fn tuis_mr_leg_c_nopin(tag: &const byte, ok: &bool, t: &u64) void {
    tuis_reset(120, 30);
    if !tuis_mr_palette(TUIS_MR_NOPIN, bufx_cstr_len(TUIS_MR_NOPIN), 0) {
        tuis_fail(tag, "无分列空格夹具没上屏", ok);
        return;
    }
    var h1: Buf = buf_new(65536);
    defer { buf_free(&h1); }
    var h2: Buf = buf_new(65536);
    defer { buf_free(&h2); }
    tui_screen_text(&h1);
    tuis_mr_ticks(t, 10);
    tui_build();
    tui_screen_text(&h2);
    const n1: usize = tuis_mr_find_in(&h1, "这是一条没有任何分列空格" as &const byte);
    if n1 >= tui_nrows() {
        tuis_fail(tag, "无分列空格夹具没上屏（C 段测不到东西）", ok);
        tui_overlay_close();
        return;
    }
    if !tuis_mr_row_moved(&h1, &h2, n1) {
        tuis_fail(tag, "没有分列空格时整行滑这一支没生效（钉不出名字就不该钉）", ok);
    }
    tui_overlay_close();
}

// C 段：另两条簇同一条纪律 + 「钉不出名字就整行滑」那一支。
fn tuis_mr_leg_c(tag: &const byte, ok: &bool) void {
    var t: u64 = 900000;
    tuis_mr_leg_c_ask(tag, ok, &t);
    tuis_mr_leg_c_reader(tag, ok, &t);
    tuis_mr_leg_c_nopin(tag, ok, &t);
}

// D 段前半：起真 PTY + 真 TUI 子进程，喂 `/model` 把那条长命令过滤上屏，并把**第一帧**
// 的网格交给调用方；成功返回 true，`m` / `cpid` / `mpid` / `g` 都留给调用方收尾。
//
// 分成两半是为了守住「函数 ≤100 行」那条硬指标：前半是「起一个真终端并等到面板上屏」，
// 后半是「不按键只收帧 + 判据」，两半之间只传一块网格与三个进程号。
fn tuis_mr_pty_up(tag: &const byte, ok: &bool, m: &i32, cpid: &i32, mpid: &i32,
    g: &EmuGrid) bool {
    m[0] = -1;
    cpid[0] = -1;
    mpid[0] = -1;
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    mpid[0] = -1;
    const port: u16 = tuis_start_mock(mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return false;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    m[0] = tuis_open_pty(&slave_path, 120, 30);
    if m[0] < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid[0] as i64, SIGKILL) catch {};
        return false;
    }
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m[0]) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        _ = sys_kill(mpid[0] as i64, SIGKILL) catch {};
        return false;
    };
    if cpid64 == 0 {
        // 与 tui-marquee 的 G 段同一个子进程入口（真 TUI + 真 fd）
        tuis_child_run_tui_mouse(&slave_path, port,
            "build/selftest_mr_pt" as &const byte, false);
        sys_exit(3);
        return false;
    }
    cpid[0] = tuis_i32(cpid64);
    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    tuis_drain(m[0], &cap, 30);
    // 喂 `/model`：第一个斜杠触发命令面板并**当场收走**（见 tui_input_drop_slash_trigger）
    tuis_write_master(m[0], "/model" as &const byte, 6);
    if !tuis_drain_until(m[0], &cap, "看/切模型" as &const byte, 6000) {
        tuis_fail(tag, "真 PTY 里输入 `/model` 没把那条长命令过滤上屏", ok);
        tuis_dump_tail(&cap, 2000);
        return false;
    }
    if !emu_init(g, 120, 30) {
        tuis_fail(tag, "emu_init 失败", ok);
        return false;
    }
    emu_feed(g, cap.ptr as &const byte, cap.len);
    emu_snapshot(g);
    return true;
}

// D 段后半：**不按键**只收帧（4 秒 ≈ 10 列），逐行差分方框之内的行。
//
// 只认**方框之内**：脚注（cpu/ctx/时钟）、状态区、面板信息行本来就每拍在变 —— 把它们
// 算进「非选中行也在动」等于判据恒红（P75 的 F 段正是被这类噪声盖住才假绿的，见 §19 P75）。
// 方框找不到时把整屏打出来（崩溃现场没有别的证据：`tuis_fail` 只报一句「找不到方框」，
// 而 macOS 上可能只是面板画在了别的行 / 被裁掉）。
fn tuis_mr_dump_grid(g: &const EmuGrid) void {
    var line: Buf = buf_new(512);
    defer { buf_free(&line); }
    var y: usize = 0;
    while y < 30 {
        buf_reset(&line);
        emu_row_text(g, y, &line);
        _ = buf_append_byte(&line, 0);
        tuis_puts("  |");
        tuis_puts(line.ptr as &const byte);
        tuis_puts("\n");
        y = y + 1;
    }
}

// 真 PTY 的判据：命令窗口只滚选中那一行、命令名钉住不跟着走。
fn tuis_mr_pty_assert(tag: &const byte, ok: &bool, m: i32, g: &const EmuGrid) void {
    const base_row: isize = emu_find_row(g, "/model" as &const byte);
    if base_row < 0 {
        tuis_fail(tag, "真 PTY 基准帧里没有那条过滤出来的命令", ok);
        return;
    }
    const box_top: isize = emu_find_row(g, "╭" as &const byte);
    const box_bot: isize = emu_find_row(g, "╰" as &const byte);
    if box_top < 0 || box_bot <= box_top {
        tuis_fail(tag, "真 PTY 里找不到命令面板的方框", ok);
        tuis_mr_dump_grid(g);
        return;
    }
    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 80);
    emu_feed(g, cap.ptr as &const byte, cap.len);
    var r: usize = box_top as usize;
    var moved: usize = 0;
    var others: usize = 0;
    var scratch: Buf = buf_new(4096);
    defer { buf_free(&scratch); }
    while r <= box_bot as usize {
        if emu_row_diff(g, r, &scratch) {
            moved = moved + 1;
            if r != base_row as usize {
                others = others + 1;
            }
        }
        r = r + 1;
    }
    if moved == 0 {
        tuis_fail(tag, "真 PTY 里 4 秒方框内一个字节都没变（面板不滚）", ok);
    } else if others > 0 {
        tuis_fail(tag, "真 PTY 里非选中行也在变（集体抖 = 用户报的现场）", ok);
    }
    // 钉住：选中那一行里命令名必须还在
    var line: Buf = buf_new(4096);
    defer { buf_free(&line); }
    emu_row_text(g, base_row as usize, &line);
    if !tuis_has(&line, "/model [名字|提供方/名字] " as &const byte) {
        tuis_fail(tag, "真 PTY 里滚过之后命令名没钉住", ok);
    }
}

// D 段：真 PTY 端到端（前半起终端 + 后半收帧断言，两半都在上面）。
//
// 为什么非要有这一段：headless 下 `tui_flush` 因 `out_fd < 0` 当场早退，任何「帧/脏位」
// 判据都恒真（P75 的三次假绿都栽在这里，见 §19 P75）。这一段测的是**真终端上**那一行
// 到底有没有在动、别的行有没有跟着动。
fn tuis_mr_leg_d(tag: &const byte, ok: &bool) void {
    var m: i32 = -1;
    var cpid: i32 = -1;
    var mpid: i32 = -1;
    var g: EmuGrid = emu_value_empty();
    if !tuis_mr_pty_up(tag, ok, &m, &cpid, &mpid, &g) {
        _ = sys_kill(cpid as i64, SIGKILL) catch {};
        var st1: i32 = 0;
        _ = tuis_wait_raw(cpid, &st1, 5000);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        _ = sys_close(m) catch {};
        return;
    }
    tuis_mr_pty_assert(tag, ok, m, &g);
    emu_free(&g);
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 20000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
}

// tui-marquee-row 轮：四段各管一件事，任一段红就置 ok=false（跑完全部，不早退）。
fn tui_marquee_row_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_mr_leg_a(tag, &ok);
    tuis_mr_leg_b(tag, &ok);
    tuis_mr_leg_c(tag, &ok);
    tuis_mr_leg_d(tag, &ok);
    if ok {
        tuis_ok(tag, "簇里只有选中项滚：面板不集体抖 / 命令名钉住 / 滚得到尾且换选复位 / ask 与动作行同一条纪律 / 无分列空格时整行滑 / 真 PTY 端到端");
    }
    return ok;
}
