// src/selftest/st_tasks_ws.uya — selftest.uya 的拆分片 11/12（纯搬移）
//
// 本文件：ws-tool：workspace 工具（报告 / 切换 / 记录）；diff-git：真 git 造 fixture 仓（用 gitx_run 自己建，顺带；P29：/goal 人类命令（纯函数轮）—— 语法 / 措辞 / 状态机 / 落盘；P37：模型目录 + 模型/强度切换（modelx.uya / agent_model_
// 不变量：与原文件一致 —— 拆分只搬移，不改任何声明的代码；同族轮/段集中在一片里。
// 依赖：见锚点 selftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：沿用原文件前缀（本片是同一历史模块的内部拆分）。

// ============================================================
// ws-tool：workspace 工具（报告 / 切换 / 记录）
// ============================================================
fn ws_tool_round(tag: &const byte, base: &const Config) bool {
    var ok: bool = true;
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        ty_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    defer {
        var rz: Buf = buf_new(root.len + 1);
        defer { buf_free(&rz); }
        _ = buf_append(&rz, root.ptr as &const byte, root.len);
        _ = buf_append_byte(&rz, 0);
        _ = sys_chdir(&rz.ptr[0] as *const byte) catch {};
    }
    _ = wst_prepare();
    var abs_a: Buf = buf_new(1024);
    defer { buf_free(&abs_a); }
    var abs_b: Buf = buf_new(1024);
    defer { buf_free(&abs_b); }
    if !wst_abs(&root, WST_A, &abs_a) || !wst_abs(&root, WST_B, &abs_b) {
        ty_fail(tag, "拿不到临时目录的绝对路径", &ok);
        return ok;
    }
    var raw: &void = malloc(65536);
    if ((raw as &byte) as usize) == 0 {
        ty_fail(tag, "cannot allocate arena", &ok);
        return ok;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 65536);

    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("selftest-model");
    // agent home 必须给**绝对**路径：本轮的切换是真的 chdir，相对路径会被搬到新工作区下面去
    var abs_home: Buf = buf_new(1024);
    defer { buf_free(&abs_home); }
    if !wst_abs(&root, WST_HOME, &abs_home) {
        ty_fail(tag, "拿不到 agent home 的绝对路径", &ok);
        return ok;
    }
    cfg.agent_home = buf_new(abs_home.len + 8);
    _ = buf_append(&cfg.agent_home, abs_home.ptr as &const byte, abs_home.len);
    cfg.save_session = true;
    cfg.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&cfg);
    if agent_workspace_switch(&cfg, abs_a.ptr as &const byte, abs_a.len) != WS_OK {
        ty_fail(tag, "切到工作区 A 失败", &ok);
        return ok;
    }
    // 会话日志开在 A 名下（记录才有地方落）
    if !agent_session_create(&cfg) {
        ty_fail(tag, "agent_session_create 失败", &ok);
        return ok;
    }
    var out: Buf = buf_new(8192);
    defer { buf_free(&out); }

    // ---- 1) 无参 = 报告当前工作区 ----
    var none: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, "{}" as &byte, 2, &none) {
        ty_fail(tag, "解析空参数失败", &ok);
    }
    ws_tool_workspace(&cfg, &none, &out);
    if !ty_has(&out, abs_a.ptr as &const byte, abs_a.len) {
        ty_fail(tag, "无参报告里没有当前工作区", &ok);
        out_err("  报告=");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    if !ty_has(&out, "source: default" as &const byte,
            bufx_cstr_len("source: default" as &const byte)) {
        ty_fail(tag, "无参报告里没有工作区来源", &ok);
    }

    // ---- 2) 不存在 / 不是目录：要有话说，且状态一个字节都不变 ----
    buf_reset(&out);
    var bad: JsonValue = JsonValue.json_null();
    var badj: Buf = buf_new(1200);
    defer { buf_free(&badj); }
    _ = buf_append_cstr(&badj, "{\"path\":\"");
    _ = buf_append(&badj, abs_a.ptr as &const byte, abs_a.len);
    _ = buf_append_cstr(&badj, "/nope\"}");
    if !js_parse(&arena, badj.ptr as &byte, badj.len, &bad) {
        ty_fail(tag, "解析「不存在」的参数失败", &ok);
    }
    ws_tool_workspace(&cfg, &bad, &out);
    if !ty_has(&out, "Error: cannot switch the workspace" as &const byte,
            bufx_cstr_len("Error: cannot switch the workspace" as &const byte)) {
        ty_fail(tag, "切到不存在的目录没有报错", &ok);
    }
    if !wst_eq(&cfg.workspace, &abs_a) {
        ty_fail(tag, "切失败之后工作区被改掉了", &ok);
    }
    buf_reset(&out);
    var notdir: JsonValue = JsonValue.json_null();
    var ndj: Buf = buf_new(1200);
    defer { buf_free(&ndj); }
    _ = buf_append_cstr(&ndj, "{\"path\":\"");
    _ = buf_append(&ndj, abs_a.ptr as &const byte, abs_a.len);
    _ = buf_append_cstr(&ndj, "/f.txt\"}");
    if !js_parse(&arena, ndj.ptr as &byte, ndj.len, &notdir) {
        ty_fail(tag, "解析「不是目录」的参数失败", &ok);
    }
    // 造一个普通文件：切到文件必须被拒（chdir 会 ENOTDIR）
    var fp: Buf = buf_new(1200);
    defer { buf_free(&fp); }
    _ = buf_append(&fp, abs_a.ptr as &const byte, abs_a.len);
    _ = buf_append_cstr(&fp, "/f.txt");
    _ = buf_append_byte(&fp, 0);
    _ = write_text_file(fp.ptr as &const byte, "not a dir\n" as &const byte);
    ws_tool_workspace(&cfg, &notdir, &out);
    if !ty_has(&out, "Error: cannot switch the workspace" as &const byte,
            bufx_cstr_len("Error: cannot switch the workspace" as &const byte)) {
        ty_fail(tag, "切到文件（不是目录）没有报错", &ok);
    }

    // ---- 3) 真切换（相对路径）：状态 + 会话日志 + 索引三处都要跟上 ----
    buf_reset(&out);
    var sw: JsonValue = JsonValue.json_null();
    var swj: Buf = buf_new(1200);
    defer { buf_free(&swj); }
    _ = buf_append_cstr(&swj, "{\"path\":\"");
    _ = buf_append(&swj, abs_b.ptr as &const byte, abs_b.len);
    _ = buf_append_cstr(&swj, "\"}");
    if !js_parse(&arena, swj.ptr as &byte, swj.len, &sw) {
        ty_fail(tag, "解析切换参数失败", &ok);
    }
    ws_tool_workspace(&cfg, &sw, &out);
    if !wst_eq(&cfg.workspace, &abs_b) {
        ty_fail(tag, "工具没有把工作区切到 B", &ok);
        out_err("  cfg.workspace=");
        out_err_bytes(cfg.workspace.ptr as &const byte, cfg.workspace.len);
        out_err("\n  want(abs_b)=");
        out_err_bytes(abs_b.ptr as &const byte, abs_b.len);
        out_err("\n  工具结果=");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    if !ty_has(&out, "switched workspace: " as &const byte,
            bufx_cstr_len("switched workspace: " as &const byte)) {
        ty_fail(tag, "切换结果里没有 switched workspace", &ok);
    }
    if cfg.ws_src != 4 {
        ty_fail(tag, "运行中切换之后来源不是 runtime", &ok);
    }
    // 会话日志（索引里拿到 path 与 id；同 id 最后一条 = 「现在在哪」）
    var last_cwd: Buf = buf_new(1024);
    defer { buf_free(&last_cwd); }
    var last_path: Buf = buf_new(1600);
    defer { buf_free(&last_path); }
    var any_id: Buf = buf_empty();
    defer { buf_free(&any_id); }
    if !wst_index_last(&abs_home, any_id.ptr as &const byte, 0, &last_cwd, &last_path) {
        ty_fail(tag, "索引里找不到刚开的会话（记录没落地？）", &ok);
    } else {
        if !wst_eq(&last_cwd, &abs_b) {
            ty_fail(tag, "索引里的当前工作区不是 B（/sessions 的工作区列会显示错的）", &ok);
            out_err("  索引 cwd=");
            out_err_bytes(last_cwd.ptr as &const byte, last_cwd.len);
            out_err("\n");
        }
        var mz: Buf = buf_new(last_path.len + 1);
        defer { buf_free(&mz); }
        _ = buf_append(&mz, last_path.ptr as &const byte, last_path.len);
        _ = buf_append_byte(&mz, 0);
        var meta: SessMeta = sess_meta_empty();
        defer { sess_meta_free(&meta); }
        if !sess_read_meta(mz.ptr as &const byte, &meta) {
            ty_fail(tag, "会话日志读不回来", &ok);
        } else {
            if !wst_eq(&meta.workspace, &abs_b) {
                ty_fail(tag, "日志里最后一条 session/workspace 不是 B", &ok);
            }
            if !wst_eq(&meta.cwd, &abs_a) {
                ty_fail(tag, "header 的创建时工作区被改写了（应当保持 A）", &ok);
            }
        }
    }

    // ---- 4) 幂等：切到已经在那儿的目录 ----
    buf_reset(&out);
    ws_tool_workspace(&cfg, &sw, &out);
    if !ty_has(&out, "already the current workspace" as &const byte,
            bufx_cstr_len("already the current workspace" as &const byte)) {
        ty_fail(tag, "重复切到同一个目录没有走幂等分支", &ok);
    }

    // ---- 5) /diff 的文本头写的是工作区（真 git；没装 git 就跳过这一段）----
    // fixture 仓与 git -C 都是相对路径：先站回仓库根
    wst_back(&root);
    if !gitx_available() {
        out_err("selftest[");
        out_err(tag);
        out_err("] skip（本机 PATH 里没有 git：/diff 头那一段没跑）\n");
    } else if !dg_fixture_make() {
        ty_fail(tag, "造 git fixture 仓失败", &ok);
    } else {
        var abs_fx: Buf = buf_new(1024);
        defer { buf_free(&abs_fx); }
        _ = wst_abs(&root, DG_WS, &abs_fx);
        if agent_workspace_switch(&cfg, abs_fx.ptr as &const byte, abs_fx.len) != WS_OK {
            ty_fail(tag, "切到 fixture 仓失败", &ok);
            out_err("  want=");
            out_err_bytes(abs_fx.ptr as &const byte, abs_fx.len);
            out_err("\n");
        }
        var txt: Buf = buf_new(8192);
        defer { buf_free(&txt); }
        gd_print_text(cfg.workspace.ptr as &const byte, cfg.workspace.len, &txt);
        if !ty_has(&txt, "[diff] " as &const byte, bufx_cstr_len("[diff] " as &const byte)) {
            ty_fail(tag, "/diff 文本头没了", &ok);
        }
        // 头里写的是**短路径**（$HOME → ~），所以期望值也要按同一条规则拼一遍
        var want: Buf = buf_new(1024);
        defer { buf_free(&want); }
        const hm: &byte = getenv("HOME");
        var hn: usize = 0;
        if (hm as usize) != 0 {
            hn = bufx_cstr_len(hm);
        }
        if hn > 1 && abs_fx.len > hn && abs_fx.ptr[hn] == 47 as byte &&
            bufx_mem_eq(abs_fx.ptr as &const byte, hm, hn) {
            _ = buf_append_cstr(&want, "~");
            _ = buf_append(&want, abs_fx.ptr + hn, abs_fx.len - hn);
        } else {
            _ = buf_append(&want, abs_fx.ptr as &const byte, abs_fx.len);
        }
        if !ty_has(&txt, want.ptr as &const byte, want.len) {
            ty_fail(tag, "/diff 文本头里没有当前会话的工作区", &ok);
            out_err("  want=");
            out_err_bytes(want.ptr as &const byte, want.len);
            out_err("\n  头=");
            out_err_bytes(txt.ptr as &const byte, txt.len);
            out_err("\n");
        }
        if !ty_has(&txt, "个文件（HEAD ↔ 工作区）" as &const byte,
                bufx_cstr_len("个文件（HEAD ↔ 工作区）" as &const byte)) {
            ty_fail(tag, "/diff 文本头里没有文件数", &ok);
        }
    }

    agent_session_close();
    // g_fsctx 存的是裸指针：指回程序级 cfg，别让它悬在本地 cfg 上
    fsctx_init(base);
    return ok;
}

// diff-parse 轮：unified diff → 行表的纯函数（上下文/配对/落单/溢出/CRLF/二进制/
// mode-only/非 diff 文本/空输入），不碰 git、不碰 TUI。返回 false = 本轮红。
fn diff_parse_round(tag: &const byte) bool {
    var ok: bool = true;
    gd_reset();
    var txt: Buf = buf_new(4096);
    defer { buf_free(&txt); }
    var c1: Buf = buf_new(1024);
    defer { buf_free(&c1); }
    var c2: Buf = buf_new(1024);
    defer { buf_free(&c2); }
    var a: usize = 0;
    var r: usize = 0;
    var lno: usize = 0;
    var rno: usize = 0;

    // ---- 1) 上下文 + 配对（2 删 3 增 → 2 个 MIX + 1 个 ADD）----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "diff --git a/src/a.uya b/src/a.uya\n");
    _ = buf_append_cstr(&txt, "index 1111111..2222222 100644\n");
    _ = buf_append_cstr(&txt, "--- a/src/a.uya\n");
    _ = buf_append_cstr(&txt, "+++ b/src/a.uya\n");
    _ = buf_append_cstr(&txt, "@@ -1,5 +1,6 @@\n");
    _ = buf_append_cstr(&txt, " line1\n");
    _ = buf_append_cstr(&txt, "-line2\n");
    _ = buf_append_cstr(&txt, "-old3\n");
    _ = buf_append_cstr(&txt, "+NEW2\n");
    _ = buf_append_cstr(&txt, "+NEW3\n");
    _ = buf_append_cstr(&txt, "+NEW4\n");
    _ = buf_append_cstr(&txt, " line4\n");
    _ = buf_append_cstr(&txt, " line5\n");
    gd_parse_into(&txt, &a, &r);
    if a != 3 || r != 2 {
        ty_fail(tag, "增删计数不对（2 删 3 增）", &ok);
        dp_dump(tag);
    }
    if gd_rows() != 7 {
        ty_fail(tag, "行数不对（1 说明 + 1 上下文 + 2 MIX + 1 ADD + 2 上下文 = 7）", &ok);
        dp_dump(tag);
    } else {
        if dp_kind(0) != GD_K_HDR {
            ty_fail(tag, "@@ 行不是 HDR", &ok);
        }
        if dp_kind(1) != GD_K_CTX || dp_kind(2) != GD_K_MIX || dp_kind(3) != GD_K_MIX {
            ty_fail(tag, "第 2/3/4 行的类型不是 CTX/MIX/MIX", &ok);
            dp_dump(tag);
        }
        if dp_kind(4) != GD_K_ADD || dp_kind(5) != GD_K_CTX || dp_kind(6) != GD_K_CTX {
            ty_fail(tag, "第 5/6/7 行的类型不是 ADD/CTX/CTX", &ok);
            dp_dump(tag);
        }
        dp_cell(&c1, 2, 0);
        dp_cell(&c2, 2, 1);
        if !dp_eq(&c1, "line2" as &const byte) || !dp_eq(&c2, "NEW2" as &const byte) {
            ty_fail(tag, "MIX 行的左右文本不是 line2 / NEW2", &ok);
            dp_dump(tag);
        }
        dp_cell(&c1, 4, 0);
        dp_cell(&c2, 4, 1);
        if c1.len != 0 || !dp_eq(&c2, "NEW4" as &const byte) {
            ty_fail(tag, "落单的增行左侧必须为空、右侧是 NEW4", &ok);
            dp_dump(tag);
        }
        // 行号：上下文两侧同值；MIX 各自推进
        if !dp_nos(1, &lno, &rno) || lno != 1 || rno != 1 {
            ty_fail(tag, "首行上下文的行号应当是 1/1", &ok);
        }
        if !dp_nos(2, &lno, &rno) || lno != 2 || rno != 2 {
            ty_fail(tag, "第一个 MIX 的行号应当是 2/2", &ok);
        }
        if !dp_nos(4, &lno, &rno) || rno != 4 {
            ty_fail(tag, "落单增行的新侧行号应当是 4", &ok);
        }
        if !dp_nos(5, &lno, &rno) || lno != 4 || rno != 5 {
            ty_fail(tag, "尾随上下文的行号应当是 4/5", &ok);
        }
        dp_cell(&c1, 1, 0);
        if !dp_eq(&c1, "line1" as &const byte) {
            ty_fail(tag, "上下文单元格不该带前导空格（- / + / 空格是标记列）", &ok);
        }
    }

    // ---- 2) 纯插入 / 纯删除 ----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "@@ -10,2 +10,4 @@\n ctx\n+new1\n+new2\n ctx2\n");
    gd_parse_into(&txt, &a, &r);
    if a != 2 || r != 0 || gd_rows() != 5 {
        ty_fail(tag, "纯插入块：2 增 0 删 5 行", &ok);
        dp_dump(tag);
    } else {
        dp_cell(&c1, 2, 0);
        dp_cell(&c2, 2, 1);
        if c1.len != 0 || !dp_eq(&c2, "new1" as &const byte) {
            ty_fail(tag, "纯插入的增行左侧应当为空", &ok);
            dp_dump(tag);
        }
        if !dp_nos(4, &lno, &rno) || lno != 11 || rno != 13 {
            ty_fail(tag, "插入之后的上下文行号应当是 11/13", &ok);
            dp_dump(tag);
        }
    }
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "@@ -5,3 +5,1 @@\n keep\n-gone1\n-gone2\n");
    gd_parse_into(&txt, &a, &r);
    if a != 0 || r != 2 || gd_rows() != 4 {
        ty_fail(tag, "纯删除块：0 增 2 删 4 行", &ok);
        dp_dump(tag);
    } else {
        dp_cell(&c1, 2, 0);
        dp_cell(&c2, 2, 1);
        if !dp_eq(&c1, "gone1" as &const byte) || c2.len != 0 {
            ty_fail(tag, "纯删除的删行右侧应当为空", &ok);
            dp_dump(tag);
        }
    }

    // ---- 3) 多个 hunk：两个 @@ 都是说明行 ----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "@@ -1,1 +1,1 @@\n-a\n+A\n@@ -9,1 +9,1 @@\n-b\n+B\n");
    gd_parse_into(&txt, &a, &r);
    if gd_rows() != 4 || a != 2 || r != 2 {
        ty_fail(tag, "两个 hunk 应当是 2 说明 + 2 MIX", &ok);
        dp_dump(tag);
    } else if dp_kind(0) != GD_K_HDR || dp_kind(2) != GD_K_HDR {
        ty_fail(tag, "第二个 @@ 没有被当成说明行", &ok);
        dp_dump(tag);
    }

    // ---- 4) `\ No newline at end of file` ----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "@@ -1,1 +1,1 @@\n-old\n+new\n\\ No newline at end of file\n");
    gd_parse_into(&txt, &a, &r);
    if gd_rows() != 3 || dp_kind(2) != GD_K_HDR {
        ty_fail(tag, "无换行结尾的标记行没有落成说明行", &ok);
        dp_dump(tag);
    } else {
        dp_cell(&c1, 2, 0);
        if !dp_eq(&c1, "\\ No newline at end of file" as &const byte) {
            ty_fail(tag, "说明行的文本不对", &ok);
            dp_dump(tag);
        }
    }

    // ---- 5) CRLF：内容里的 \r 不许带进单元格 ----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "@@ -1,1 +1,1 @@\r\n ctx\r\n-x\r\n+X\r\n");
    gd_parse_into(&txt, &a, &r);
    if gd_rows() != 3 {
        ty_fail(tag, "CRLF 输入的行数不对", &ok);
        dp_dump(tag);
    } else {
        dp_cell(&c1, 1, 0);
        if !dp_eq(&c1, "ctx" as &const byte) {
            ty_fail(tag, "CRLF 的 \\r 没有被去掉（会显示成 ·）", &ok);
            dp_dump(tag);
        }
    }

    // ---- 6) TAB / 控制字节原样保留（清洗是渲染层的事）----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "@@ -1,1 +1,1 @@\n\tif a {\n-\told\n+\tnew\n");
    gd_parse_into(&txt, &a, &r);
    dp_cell(&c1, 1, 0);
    if c1.len != 7 || c1.ptr[0] != 9 as byte {
        ty_fail(tag, "TAB 应当原样保留在单元格里（由渲染层做 4 空格展开）", &ok);
        dp_dump(tag);
    }

    // ---- 7) 二进制：留一行说明 ----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "diff --git a/bin.dat b/bin.dat\nnew file mode 100644\nindex 0000000..1234567\n");
    _ = buf_append_cstr(&txt, "Binary files /dev/null and b/bin.dat differ\n");
    gd_parse_into(&txt, &a, &r);
    if gd_rows() != 1 || dp_kind(0) != GD_K_HDR || a != 0 || r != 0 {
        ty_fail(tag, "二进制文件应当只留一行说明", &ok);
        dp_dump(tag);
    } else {
        dp_cell(&c1, 0, 0);
        if !ty_has(&c1, "Binary files" as &const byte, 12) {
            ty_fail(tag, "二进制说明行的文本不对", &ok);
        }
    }

    // ---- 8) mode-only：没有 hunk ⇒ 0 行（note 由载入侧给）----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "diff --git a/m.uya b/m.uya\nold mode 100644\nnew mode 100755\n");
    gd_parse_into(&txt, &a, &r);
    if gd_rows() != 0 {
        ty_fail(tag, "只改权限不该产生行（载入侧会给「仅文件模式变更」）", &ok);
        dp_dump(tag);
    }

    // ---- 9) 非 diff 文本（git 的报错）：整段一行说明，不许给空面板 ----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "fatal: not a git repository (or any of the parent directories): .git\n");
    gd_parse_into(&txt, &a, &r);
    if gd_rows() != 1 || dp_kind(0) != GD_K_HDR {
        ty_fail(tag, "非 diff 文本应当整段落成一行说明", &ok);
        dp_dump(tag);
    }

    // ---- 10) 空输入 ----
    buf_reset(&txt);
    gd_parse_into(&txt, &a, &r);
    if gd_rows() != 0 || a != 0 || r != 0 {
        ty_fail(tag, "空输入应当是 0 行", &ok);
    }

    // ---- 11) 配对溢出：超过 GD_RUN_MAX 的块放弃配对，但一行不丢、顺序不乱 ----
    buf_reset(&txt);
    _ = buf_append_cstr(&txt, "@@ -1,4100 +1,2 @@\n");
    var i: usize = 0;
    while i < GD_RUN_MAX + 2 {
        _ = buf_append_cstr(&txt, "-old");
        _ = buf_append_u64(&txt, i as u64);
        _ = buf_append_byte(&txt, 10);
        i = i + 1;
    }
    _ = buf_append_cstr(&txt, "+NEWA\n+NEWB\n");
    gd_parse_into(&txt, &a, &r);
    if r != GD_RUN_MAX + 2 || a != 2 {
        ty_fail(tag, "溢出块的增删计数不对（内容一行都不许丢）", &ok);
    }
    if gd_rows() != GD_RUN_MAX + 5 {
        ty_fail(tag, "溢出块的行数不对（4098 删 + 2 增 + 1 说明）", &ok);
    } else {
        dp_cell(&c1, 1, 0);
        if !dp_eq(&c1, "old0" as &const byte) {
            ty_fail(tag, "溢出块的第一行不是 old0（顺序乱了）", &ok);
        }
        if dp_kind(1) != GD_K_DEL {
            ty_fail(tag, "溢出块必须放弃配对（不许出现 MIX）", &ok);
        }
        dp_cell(&c2, GD_RUN_MAX + 4, 1);
        if !dp_eq(&c2, "NEWB" as &const byte) {
            ty_fail(tag, "溢出块末尾的增行内容不对", &ok);
        }
    }

    // ---- P36：改动间跳转 gd_next_change（纯函数，单文件假数据便于钉死行号）----
    // 行表：0 HDR / 1 CTX / 2 MIX / 3 CTX / 4 HDR / 5 CTX / 6 MIX / 7 CTX
    var ff: Buf = buf_new(256);
    defer { buf_free(&ff); }
    var fd: Buf = buf_new(1024);
    defer { buf_free(&fd); }
    _ = buf_append_cstr(&ff, " M  solo.uya  (+2 -2)\n");
    _ = buf_append_cstr(&fd, "diff --git a/solo.uya b/solo.uya\n");
    _ = buf_append_cstr(&fd, "--- a/solo.uya\n+++ b/solo.uya\n");
    _ = buf_append_cstr(&fd, "@@ -1,3 +1,3 @@\n ctx1\n-OLD1\n+NEW1\n ctx2\n");
    _ = buf_append_cstr(&fd, "@@ -10,3 +10,3 @@\n ctx3\n-OLD3\n+NEW3\n ctx4\n");
    gd_load_fixture("solo" as &const byte, &ff, &fd);
    if gd_file_count() != 1 || gd_rows() != 8 {
        ty_fail(tag, "单文件假数据没装成（1 个文件 / 8 行）", &ok);
        dp_dump(tag);
    } else {
        gd_scroll_home();
        if !gd_next_change(1) || gd_scroll() != 2 || dp_kind(2) != GD_K_MIX {
            ty_fail(tag, "n 没有落到第一个改动行（应当是第 2 行的 MIX）", &ok);
        }
        if !gd_next_change(1) || gd_scroll() != 6 {
            ty_fail(tag, "再按 n 没有落到第二个改动行（第 6 行）", &ok);
        }
        // 本文件没有更靠后的改动了 → 环绕回第一个
        if !gd_next_change(1) || gd_scroll() != 2 {
            ty_fail(tag, "最后一个改动之后按 n 没有环绕回本文件的第一个改动", &ok);
        }
        // N 往回：本文件前面没有改动了 → 环绕到最后一个
        if !gd_next_change(-1) || gd_scroll() != 6 {
            ty_fail(tag, "第一个改动之前按 N 没有环绕到最后一个改动", &ok);
        }
        if !gd_next_change(-1) || gd_scroll() != 2 {
            ty_fail(tag, "从第二个改动按 N 没有退到第一个改动", &ok);
        }
    }
    // 一个改动行都没有（只有 hunk 头 + 上下文）→ 两个方向都返回 false，且不动 scroll
    buf_reset(&ff);
    buf_reset(&fd);
    _ = buf_append_cstr(&ff, " M  noop.uya  (+0 -0)\n");
    _ = buf_append_cstr(&fd, "diff --git a/noop.uya b/noop.uya\n--- a/noop.uya\n+++ b/noop.uya\n@@ -1,2 +1,2 @@\n ctxA\n ctxB\n");
    gd_load_fixture("noop" as &const byte, &ff, &fd);
    gd_scroll_home();
    if gd_next_change(1) {
        ty_fail(tag, "没有改动行时 n 不该返回 true", &ok);
        dp_dump(tag);
    }
    if gd_next_change(-1) {
        ty_fail(tag, "没有改动行时 N 不该返回 true", &ok);
    }
    if gd_scroll() != 0 {
        ty_fail(tag, "没有改动行时 jump 不该挪动 scroll", &ok);
    }
    gd_reset();

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（unified diff → 行表：配对/落单/溢出/CRLF/二进制/mode-only/非 diff 文本）\n");
    }
    return ok;
}

// ============================================================
// diff-git：真 git 造 fixture 仓（用 gitx_run 自己建，顺带自测执行器）
// ============================================================
const DG_WS: &const byte = "build/selftest_diff_ws" as &const byte;

// 绝对/相对路径 + **末尾 NUL**（sys_open 收的是 C 字符串：漏了 NUL 就会把缓冲区后面的
// 垃圾当路径的一部分 —— §16 坑 2 反复踩过，这里连 fixture 文件名都被污染过）
fn dg_path(rel: &const byte, out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, DG_WS);
    _ = buf_append_cstr(out, "/");
    _ = buf_append_cstr_z(out, rel);
}

// diff-git 轮的 git 执行器：跑 gitx_run，stdout/stderr 各 4 KiB 丢弃。
// 返回 git 的退出码（0 = 成功）；argv 以 null 结尾。
fn dg_run(argv: &(&const byte)) i32 {
    var o: Buf = buf_new(4096);
    defer { buf_free(&o); }
    var e: Buf = buf_new(4096);
    defer { buf_free(&e); }
    return gitx_run(null as &const byte, argv, &o, &e, 4096);
}

// 同 dg_run，但把 stderr 交给调用方（断言错误文案用）。
// 返回 git 的退出码；errout 不扩容，超出即截断。
fn dg_run2(argv: &(&const byte), errout: &Buf) i32 {
    var o: Buf = buf_new(4096);
    defer { buf_free(&o); }
    return gitx_run(null as &const byte, argv, &o, errout, 4096);
}

// 造 diff 用的 fixture 仓（幂等：每跑一次都把三种状态重新做出来）
//   a.uya = 已跟踪 + 改了一行（line2 → CHANGED）
//   c.uya = 已跟踪 + 删掉
//   b.uya = 未跟踪 + 新增
// 幂等很重要：TUI 的 PTY 轮与 diff-git 轮都调它，谁先跑都要拿到同一份状态。
export fn dg_fixture_make() bool {
    _ = sess_mkdir_p(DG_WS);
    var wsz: Buf = buf_new(256);
    defer { buf_free(&wsz); }
    _ = buf_append_cstr_z(&wsz, DG_WS);
    var p: Buf = buf_new(512);
    defer { buf_free(&p); }
    var av: [&const byte: 10] = [null as &const byte: 10];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = wsz.ptr as &const byte;
    av[3] = "init" as &const byte;
    av[4] = "-q" as &const byte;
    av[5] = null as &const byte;
    _ = dg_run(&av[0]);
    dg_path("b.uya" as &const byte, &p);
    _ = sys_unlink(&p.ptr[0] as *const byte) catch {};
    dg_path("a.uya" as &const byte, &p);
    if !write_text_file(&p.ptr[0] as &const byte, "line1\nline2\nline3\n" as &const byte) {
        return false;
    }
    dg_path("c.uya" as &const byte, &p);
    if !write_text_file(&p.ptr[0] as &const byte, "gone1\ngone2\n" as &const byte) {
        return false;
    }
    var av2: [&const byte: 16] = [null as &const byte: 16];
    av2[0] = "git" as &const byte;
    av2[1] = "-C" as &const byte;
    av2[2] = wsz.ptr as &const byte;
    av2[3] = "add" as &const byte;
    av2[4] = "-A" as &const byte;
    av2[5] = null as &const byte;
    _ = dg_run(&av2[0]);
    var av3: [&const byte: 20] = [null as &const byte: 20];
    av3[0] = "git" as &const byte;
    av3[1] = "-C" as &const byte;
    av3[2] = wsz.ptr as &const byte;
    av3[3] = "-c" as &const byte;
    av3[4] = "user.email=t@t" as &const byte;
    av3[5] = "-c" as &const byte;
    av3[6] = "user.name=t" as &const byte;
    av3[7] = "commit" as &const byte;
    av3[8] = "-q" as &const byte;
    av3[9] = "-m" as &const byte;
    av3[10] = "fixture" as &const byte;
    av3[11] = null as &const byte;
    _ = dg_run(&av3[0]);
    // 已提交的基线之上制造三种状态
    dg_path("a.uya" as &const byte, &p);
    if !write_text_file(&p.ptr[0] as &const byte, "line1\nCHANGED\nline3\n" as &const byte) {
        return false;
    }
    dg_path("b.uya" as &const byte, &p);
    if !write_text_file(&p.ptr[0] as &const byte, "new1\nnew2\n" as &const byte) {
        return false;
    }
    dg_path("c.uya" as &const byte, &p);
    _ = sys_unlink(&p.ptr[0] as *const byte) catch {};
    return true;
}

// 空仓库（没有任何改动 / 没有任何提交）：测「(没有 git 修改)」那条通知
export fn dg_fixture_empty() bool {
    const empty: &const byte = "build/selftest_diff_empty" as &const byte;
    _ = sess_mkdir_p(empty);
    var wsz: Buf = buf_new(256);
    defer { buf_free(&wsz); }
    _ = buf_append_cstr_z(&wsz, empty);
    var av: [&const byte: 8] = [null as &const byte: 8];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = wsz.ptr as &const byte;
    av[3] = "init" as &const byte;
    av[4] = "-q" as &const byte;
    av[5] = null as &const byte;
    return dg_run(&av[0]) == 0;
}

// diff-git 轮（P26）：真 git 造 fixture 仓，断言文件列表、三栏内容、行号、增删计数、
// 切换/夹取、刷新、文本回退、非仓库报错。本机没 git 就 skip（返回 true）；返回 false = 本轮红。
fn diff_git_round(tag: &const byte) bool {
    var ok: bool = true;
    gd_reset();
    if !gitx_available() {
        out_err("selftest[");
        out_err(tag);
        out_err("] skip（本机 PATH 里没有 git）\n");
        return ok;
    }
    var p: Buf = buf_new(512);
    defer { buf_free(&p); }
    var b: Buf = buf_new(1024);
    defer { buf_free(&b); }
    if !dg_fixture_make() {
        ty_fail(tag, "造 fixture 仓失败", &ok);
        return ok;
    }

    // 2) 打开：3 个文件 + 状态码 + numstat 计数
    const rc: i32 = gd_open(DG_WS, bufx_cstr_len(DG_WS));
    if rc != 0 {
        ty_fail(tag, "gd_open 失败（fixture 仓应当能打开）", &ok);
        out_err("  err=");
        out_err_bytes(gd_error().ptr as &const byte, gd_error().len);
        out_err("\n");
        return ok;
    }
    var ia: i64 = -1;
    var ib: i64 = -1;
    var ic: i64 = -1;
    var list: Buf = buf_new(4096);
    defer { buf_free(&list); }
    var i: usize = 0;
    while i < gd_file_count() {
        var len: usize = 0;
        const ft: &const byte = gd_file_text(i, &len);
        _ = buf_append_cstr(&list, "    ");
        _ = buf_append(&list, ft, len);
        _ = buf_append_byte(&list, 10);
        buf_reset(&b);
        _ = buf_append(&b, ft, len);
        if ty_has(&b, "a.uya" as &const byte, 5) { ia = i as i64; }
        if ty_has(&b, "b.uya" as &const byte, 5) { ib = i as i64; }
        if ty_has(&b, "c.uya" as &const byte, 5) { ic = i as i64; }
        i = i + 1;
    }
    var len0: usize = 0;
    const f0: &const byte = gd_file_text(if ia > 0 { ia as usize } else { 0 as usize }, &len0);
    _ = f0;
    if gd_file_count() != 3 {
        ty_fail(tag, "文件数不是 3（a/b/c 三个改动）", &ok);
        out_err("  列表：\n");
        out_err_bytes(list.ptr as &const byte, list.len);
    } else if ia < 0 || ib < 0 || ic < 0 {
        ty_fail(tag, "列表里找不到 a.uya / b.uya / c.uya 三个文件", &ok);
        out_err("  列表：\n");
        out_err_bytes(list.ptr as &const byte, list.len);
    } else {
        // 状态码 + numstat 计数（逐行看）
        var len: usize = 0;
        const fa: &const byte = gd_file_text(ia as usize, &len);
        buf_reset(&b);
        _ = buf_append(&b, fa, len);
        if !ty_has(&b, "M  a.uya" as &const byte, 7) {
            ty_fail(tag, "a.uya 那一行的状态码不是「 M」（git status -z 的 XY）", &ok);
            out_err("  行=");
            out_err_bytes(b.ptr as &const byte, b.len);
            out_err("\n");
        }
        if !ty_has(&b, "(+1 -1)" as &const byte, 7) {
            ty_fail(tag, "a.uya 的 numstat 计数不是 (+1 -1)", &ok);
            out_err("  行=");
            out_err_bytes(b.ptr as &const byte, b.len);
            out_err("\n");
        }
        const fb: &const byte = gd_file_text(ib as usize, &len);
        buf_reset(&b);
        _ = buf_append(&b, fb, len);
        if !ty_has(&b, "??  b.uya" as &const byte, 7) {
            ty_fail(tag, "b.uya 那一行的状态码不是「??」", &ok);
        }
        if !ty_has(&b, "(new)" as &const byte, 5) {
            ty_fail(tag, "未跟踪文件应当标 (new)", &ok);
        }
        const fc: &const byte = gd_file_text(ic as usize, &len);
        buf_reset(&b);
        _ = buf_append(&b, fc, len);
        if !ty_has(&b, "D  c.uya" as &const byte, 7) {
            ty_fail(tag, "c.uya 那一行的状态码不是「 D」", &ok);
        }
        if !ty_has(&b, "(+0 -2)" as &const byte, 7) {
            ty_fail(tag, "c.uya 的 numstat 计数不是 (+0 -2)", &ok);
            out_err("  行=");
            out_err_bytes(b.ptr as &const byte, b.len);
            out_err("\n");
        }
    }

    // 3) 已跟踪文件：两侧内容 + 行号 + 计数
    var c1: Buf = buf_new(1024);
    defer { buf_free(&c1); }
    var c2: Buf = buf_new(1024);
    defer { buf_free(&c2); }
    var lno: usize = 0;
    var rno: usize = 0;
    if gd_sel() != 0 {
        ty_fail(tag, "打开后应当选中第一个文件", &ok);
    }
    if !gd_select(ia as usize) {
        ty_fail(tag, "选不中 a.uya 那一行", &ok);
    }
    if gd_rows() != 4 || gd_added() != 1 || gd_removed() != 1 {
        ty_fail(tag, "a.uya 应当是 4 行（1 说明 + 1 上下文 + 1 MIX + 1 上下文）、+1 -1", &ok);
        dp_dump(tag);
    } else {
        if dp_kind(1) != GD_K_CTX || dp_kind(2) != GD_K_MIX || dp_kind(3) != GD_K_CTX {
            ty_fail(tag, "a.uya 的行类型不是 CTX/MIX/CTX", &ok);
            dp_dump(tag);
        }
        dp_cell(&c1, 2, 0);
        dp_cell(&c2, 2, 1);
        if !dp_eq(&c1, "line2" as &const byte) || !dp_eq(&c2, "CHANGED" as &const byte) {
            ty_fail(tag, "a.uya 的改动行不是 line2 → CHANGED", &ok);
            dp_dump(tag);
        }
        if !dp_nos(2, &lno, &rno) || lno != 2 || rno != 2 {
            ty_fail(tag, "a.uya 改动行的行号应当是 2/2", &ok);
        }
        dp_cell(&c1, 0, 0);
        if !ty_has(&c1, "@@ -1,3 +1,3 @@" as &const byte, 15) {
            ty_fail(tag, "说明行不是 @@ -1,3 +1,3 @@", &ok);
            dp_dump(tag);
        }
    }

    // 4) 未跟踪文件：整份内容都是新增
    if !gd_select(ib as usize) {
        ty_fail(tag, "选不中 b.uya 那一行", &ok);
    }
    if gd_rows() != 3 || gd_added() != 2 || gd_removed() != 0 {
        ty_fail(tag, "b.uya（未跟踪）应当是 3 行、+2 -0", &ok);
        dp_dump(tag);
    } else {
        dp_cell(&c1, 1, 0);
        dp_cell(&c2, 1, 1);
        if c1.len != 0 || !dp_eq(&c2, "new1" as &const byte) {
            ty_fail(tag, "未跟踪文件的第一行应当是「左侧空 / 右侧 new1」", &ok);
            dp_dump(tag);
        }
        if !dp_nos(2, &lno, &rno) || rno != 2 {
            ty_fail(tag, "未跟踪文件的第二行新侧行号应当是 2", &ok);
        }
    }

    // 5) 删除的文件：全在左侧
    _ = gd_select(ic as usize);
    if gd_rows() != 3 || gd_added() != 0 || gd_removed() != 2 {
        ty_fail(tag, "c.uya（已删除）应当是 3 行、+0 -2", &ok);
        dp_dump(tag);
    } else {
        dp_cell(&c1, 1, 0);
        dp_cell(&c2, 1, 1);
        if !dp_eq(&c1, "gone1" as &const byte) || c2.len != 0 {
            ty_fail(tag, "已删除文件的第一行应当是「左侧 gone1 / 右侧空」", &ok);
            dp_dump(tag);
        }
    }

    // 6) 夹取 + 刷新（改一下 a.uya 再看）
    _ = gd_select(ic as usize);
    _ = gd_move(1);
    if gd_sel() + 1 != gd_file_count() {
        ty_fail(tag, "到底之后再 ↓ 应当停在最后一个文件", &ok);
    }
    _ = gd_move(-9);
    if gd_sel() != 0 {
        ty_fail(tag, "到顶之后再 ↑ 应当停在第一个文件", &ok);
    }
    _ = gd_select(ia as usize);
    dg_path("a.uya" as &const byte, &p);
    _ = write_text_file(&p.ptr[0] as &const byte, "line1\nCHANGED2\nline3\n" as &const byte);
    if gd_refresh() != 0 {
        ty_fail(tag, "gd_refresh 失败", &ok);
    }
    if gd_rows() != 4 {
        ty_fail(tag, "刷新之后行数应当是 4", &ok);
    } else {
        dp_cell(&c2, 2, 1);
        if !dp_eq(&c2, "CHANGED2" as &const byte) {
            ty_fail(tag, "刷新之后没看到新内容（r 键的重扫路径）", &ok);
            dp_dump(tag);
        }
    }

    // 7) 滚动：内容装不下时夹取（这里用 view=1 模拟一行的视口）
    gd_set_view(1);
    gd_scroll_end();
    if gd_scroll() == 0 {
        ty_fail(tag, "视口只有 1 行时 gd_scroll_end 应当能滚起来", &ok);
    }
    gd_scroll_home();
    if gd_scroll() != 0 {
        ty_fail(tag, "gd_scroll_home 没有回到顶部", &ok);
    }
    gd_hscroll_by(-1);
    if gd_hscroll() != 0 {
        ty_fail(tag, "左滚不该变成负数", &ok);
    }
    gd_hscroll_by(1);
    if gd_hscroll() != GD_HSTEP {
        ty_fail(tag, "右滚一步应当是 GD_HSTEP 列", &ok);
    }

    // 8) 文本回退（非 TUI 模式打的单列 unified diff）
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    gd_print_text(DG_WS, bufx_cstr_len(DG_WS), &out);
    if !ty_has(&out, "[diff] " as &const byte, bufx_cstr_len("[diff] " as &const byte)) {
        ty_fail(tag, "文本回退没有 [diff] 头", &ok);
    }
    if !ty_has(&out, "3 个文件" as &const byte, 7) {
        ty_fail(tag, "文本回退没有报出文件数", &ok);
    }
    if !ty_has(&out, "M  a.uya" as &const byte, 7) || !ty_has(&out, "??  b.uya" as &const byte, 7) {
        ty_fail(tag, "文本回退的列表里没有三个文件", &ok);
    }
    if !ty_has(&out, "+CHANGED2" as &const byte, 9) {
        ty_fail(tag, "文本回退里没有 a.uya 的新内容", &ok);
    }
    if !ty_has(&out, "+++ b/b.uya" as &const byte, 11) {
        ty_fail(tag, "文本回退里没有未跟踪文件的 diff 段", &ok);
    }

    // 8b) P36：改动间跳转 gd_next_change —— 事实来源是真实行表，断言用「落点是不是改动行」
    //     （不写死行号：git 的 hunk 上下文行数不是这条测试要钉的东西）
    _ = gd_select(ia as usize);   // a.uya：4 行 = 1 说明 + 上下文 + MIX + 上下文
    gd_scroll_home();
    if !gd_next_change(1) {
        ty_fail(tag, "a.uya 里明明有改动行，gd_next_change(1) 却返回 false", &ok);
    } else if dp_kind(gd_scroll()) != GD_K_MIX {
        ty_fail(tag, "gd_next_change(1) 没有落到改动行（MIX）上", &ok);
        dp_dump(tag);
    }
    // 再按一次：本文件已经没有更靠后的改动 → 跨到下一个文件的改动行
    const before_sel: usize = gd_sel();
    if gd_next_change(1) {
        if dp_kind(gd_scroll()) != GD_K_MIX && dp_kind(gd_scroll()) != GD_K_ADD && dp_kind(gd_scroll()) != GD_K_DEL {
            ty_fail(tag, "跨文件之后的落点不是改动行", &ok);
        }
        if gd_sel() == before_sel {
            ty_fail(tag, "本文件没有下一个改动时应当换到下一个文件", &ok);
        }
    }
    // N 往回：应当退回改动行（跨文件或本文件内都算）
    if gd_next_change(-1) {
        if dp_kind(gd_scroll()) != GD_K_MIX && dp_kind(gd_scroll()) != GD_K_ADD && dp_kind(gd_scroll()) != GD_K_DEL {
            ty_fail(tag, "gd_next_change(-1) 的落点不是改动行", &ok);
        }
    } else {
        ty_fail(tag, "前面明明有改动行，gd_next_change(-1) 却返回 false", &ok);
    }

    // 9) 非仓库目录：报错可见（/tmp 不在任何仓库里）
    gd_reset();
    const rc2: i32 = gd_open("/tmp" as &const byte, 4);
    if rc2 >= 0 {
        ty_fail(tag, "在非仓库目录上 gd_open 竟然成功了", &ok);
    }
    if gd_error().len == 0 {
        ty_fail(tag, "非仓库目录没有给出错误文案", &ok);
    }
    gd_reset();

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（真 git：列表/状态码/numstat/三态内容/行号/切换/夹取/刷新/文本回退/非仓库）\n");
    }
    return ok;
}

// ============================================================
// P29：/goal 人类命令（纯函数轮）—— 语法 / 措辞 / 状态机 / 落盘
//
// 逐条对齐 DSH 的 commands/command-goal：控制词只有**独占整行**时才算控制词（否则整行
// 都是字面目标）、已有未完成的 goal 不许被顶掉、edit 不动 phase、pause/resume 翻 armed、
// clear 删文件。TUI 那边的浮层与常驻块刷新在 tuiselftest 的 tui-tasks 轮里验。
// ============================================================
fn gcr_has(tag: &const byte, what: &const byte, b: &const Buf, lit: &const byte, ok: &bool) void {
    if !contains(b, lit) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ");
        out_err(what);
        out_err("：输出里没有 \"");
        out_err(lit);
        out_err("\"\n");
        ok[0] = false;
    }
}

// 断言 b 里**不含** lit（goal 命令轮的输出检查）；命中就 FAIL 并置 ok=false。
fn gcr_no(tag: &const byte, what: &const byte, b: &const Buf, lit: &const byte, ok: &bool) void {
    if contains(b, lit) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ");
        out_err(what);
        out_err("：输出里不该有 \"");
        out_err(lit);
        out_err("\"\n");
        ok[0] = false;
    }
}

// 断言两个返回码相等（goal 命令轮的 rc 检查）；不等就 FAIL 并把两值都打出来。
fn gcr_rc(tag: &const byte, what: &const byte, got: i32, want: i32, ok: &bool) void {
    if got != want {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ");
        out_err(what);
        out_err("：返回码不对（要 ");
        var b: Buf = buf_new(64);
        defer { buf_free(&b); }
        _ = buf_append_i64(&b, want as i64);
        _ = buf_append_cstr(&b, "，实得 ");
        _ = buf_append_i64(&b, got as i64);
        _ = buf_append_cstr(&b, "）\n");
        _ = buf_append_byte(&b, 0);
        out_err(b.ptr as &const byte);
        ok[0] = false;
    }
}

// 一条命令：把整行塞进 line 再跑 goal_cmd_run
fn gcr_run(c: &const Config, line: &Buf, out: &Buf, lit: &const byte) i32 {
    buf_reset(line);
    _ = buf_append_cstr(line, lit);
    return goal_cmd_run(c, line, out);
}

// 盘上现在是什么（没有目标时返回 false）
fn gcr_peek(c: &const Config, g: &Goal) bool {
    goal_free(g);
    g[0] = goal_empty();
    return goal_load(c, g);
}

// goal-cmd 轮（P29，纯函数为主）：/goal 的语法、措辞、状态机与落盘（goal.json）。
// 返回 false = 本轮红；先用 goal_clear 清上一轮残留。
fn goal_cmd_round(tag: &const byte) bool {
    var ok: bool = true;
    const home: &const byte = "build/selftest_goal_home" as &const byte;
    _ = sess_mkdir_p(home);
    var c: Config = cfg_default();
    defer { cfg_free(&c); }
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, home);
    _ = goal_clear(&c);                  // 上一轮留下的 goal.json 先清掉（id 才能从 1 开始）
    var out: Buf = buf_new(4096);
    defer { buf_free(&out); }
    var line: Buf = buf_new(512);
    defer { buf_free(&line); }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }

    // ---- A) 没有目标：裸命令报用法（**成功**——看状态本身不会失败）----
    gcr_rc(tag, "裸 /goal（无目标）应当成功", gcr_run(&c, &line, &out, "/goal" as &const byte), 0, &ok);
    gcr_has(tag, "无目标时没有报「当前没有目标」", &out, "No goal is currently set." as &const byte, &ok);
    gcr_has(tag, "无目标时没有给出用法", &out, "Usage: /goal" as &const byte, &ok);
    gcr_no(tag, "无目标时不该有状态块", &out, "Activation:" as &const byte, &ok);
    if out.len == 0 || out.ptr[out.len - 1] != 10 as byte {
        ty_fail(tag, "输出没有以换行收尾（会与下一行提示符粘在一起）", &ok);
    }

    // ---- B) 没有目标：pause / resume / edit 各自报「需要一个目标」----
    gcr_rc(tag, "无目标时 pause 应当报错", gcr_run(&c, &line, &out, "/goal pause" as &const byte), 1, &ok);
    gcr_has(tag, "pause 的报错没点出是 pause 缺目标", &out,
        "No goal is currently set; /goal pause requires one." as &const byte, &ok);
    gcr_rc(tag, "无目标时 resume 应当报错", gcr_run(&c, &line, &out, "/goal resume" as &const byte), 1, &ok);
    gcr_has(tag, "resume 的报错没点出是 resume 缺目标", &out,
        "No goal is currently set; /goal resume requires one." as &const byte, &ok);
    gcr_rc(tag, "无目标时 edit 应当报错", gcr_run(&c, &line, &out, "/goal edit 新目标" as &const byte), 1, &ok);
    gcr_has(tag, "edit 的报错没点出是 edit 缺目标", &out,
        "No goal is currently set; /goal edit requires one." as &const byte, &ok);

    // ---- C) edit 有控制词、没有替换内容：直接报用法（不是「把 edit 当目标建出来」）----
    gcr_rc(tag, "裸 edit 应当报错", gcr_run(&c, &line, &out, "/goal edit" as &const byte), 1, &ok);
    gcr_has(tag, "裸 edit 没报「需要替换内容」", &out,
        "Goal editing requires a replacement objective." as &const byte, &ok);
    gcr_rc(tag, "`/goal edit   `（只有空白）同样应当报错",
        gcr_run(&c, &line, &out, "/goal edit   " as &const byte), 1, &ok);
    if gcr_peek(&c, &g) {
        ty_fail(tag, "报错的命令不该在盘上留下目标", &ok);
    }

    // ---- D) 创建：状态块四段 + 落盘（id 1 / revision 1 / active / armed / 0 轮）----
    gcr_rc(tag, "创建目标应当成功",
        gcr_run(&c, &line, &out, "/goal 把测试跑绿" as &const byte), 0, &ok);
    gcr_has(tag, "创建没有回执", &out, "Goal created" as &const byte, &ok);
    gcr_has(tag, "创建后 phase 不对", &out, "Status: active" as &const byte, &ok);
    gcr_has(tag, "创建后 objective 不对", &out, "Objective: 把测试跑绿" as &const byte, &ok);
    gcr_has(tag, "创建后轮数不对", &out, "Rounds: 0/20" as &const byte, &ok);
    gcr_has(tag, "创建后激活态不对", &out, "Activation: armed" as &const byte, &ok);
    gcr_has(tag, "创建后没给出下一步命令", &out,
        "Commands: /goal edit <objective>, /goal pause, /goal clear" as &const byte, &ok);
    if !gcr_peek(&c, &g) {
        ty_fail(tag, "创建之后盘上没有 goal.json", &ok);
    } else {
        if g.id != 1 || g.revision != 1 || g.round != 0 || !g.armed {
            ty_fail(tag, "落盘的 id/revision/round/armed 不对", &ok);
        }
        if !bufx_eq_cstr(g.phase.ptr as &const byte, g.phase.len, "active" as &const byte) {
            ty_fail(tag, "落盘的 phase 不是 active", &ok);
        }
        if !bufx_eq_cstr(g.objective.ptr as &const byte, g.objective.len, "把测试跑绿" as &const byte) {
            ty_fail(tag, "落盘的 objective 与命令里写的不一样", &ok);
        }
    }

    // ---- E) 裸 /goal：报当前状态（不是用法）----
    gcr_rc(tag, "裸 /goal（有目标）应当成功", gcr_run(&c, &line, &out, "/goal" as &const byte), 0, &ok);
    gcr_has(tag, "有目标时没有打出状态块", &out, "Goal\nStatus: active" as &const byte, &ok);
    gcr_no(tag, "有目标时不该再报「没有目标」", &out, "No goal is currently set." as &const byte, &ok);

    // ---- F) 已有未完成的目标：不许被顶掉（必须先 edit 或 clear）----
    gcr_rc(tag, "重复创建应当被拒", gcr_run(&c, &line, &out, "/goal 另一个目标" as &const byte), 1, &ok);
    gcr_has(tag, "重复创建的报错措辞不对", &out, "A goal is already active." as &const byte, &ok);
    if gcr_peek(&c, &g) {
        if !bufx_eq_cstr(g.objective.ptr as &const byte, g.objective.len, "把测试跑绿" as &const byte) {
            ty_fail(tag, "被拒的创建居然改了盘上的 objective", &ok);
        }
    } else {
        ty_fail(tag, "被拒的创建之后目标没了", &ok);
    }

    // ---- G) edit：只换 objective，phase/armed/round 不动，revision +1 ----
    gcr_rc(tag, "edit 应当成功",
        gcr_run(&c, &line, &out, "/goal edit 改成跑绿全部测试" as &const byte), 0, &ok);
    gcr_has(tag, "edit 没有回执", &out, "Goal updated" as &const byte, &ok);
    gcr_has(tag, "edit 没换掉 objective", &out, "Objective: 改成跑绿全部测试" as &const byte, &ok);
    gcr_has(tag, "edit 之后 phase 不该变", &out, "Status: active" as &const byte, &ok);
    gcr_has(tag, "edit 之后激活态不该变", &out, "Activation: armed" as &const byte, &ok);
    if gcr_peek(&c, &g) {
        if g.revision != 2 {
            ty_fail(tag, "edit 之后 revision 不是 2", &ok);
        }
    }

    // ---- H) pause / resume：phase 与 armed 一起翻 ----
    gcr_rc(tag, "pause 应当成功", gcr_run(&c, &line, &out, "/goal pause" as &const byte), 0, &ok);
    gcr_has(tag, "pause 之后 phase 不是 paused", &out, "Status: paused" as &const byte, &ok);
    gcr_has(tag, "pause 之后 armed 没关掉", &out, "Activation: disarmed" as &const byte, &ok);
    gcr_has(tag, "paused 时给出的下一步命令不对", &out, "/goal edit <objective>, /goal resume" as &const byte, &ok);
    gcr_rc(tag, "resume 应当成功", gcr_run(&c, &line, &out, "/goal resume" as &const byte), 0, &ok);
    gcr_has(tag, "resume 之后 phase 不是 active", &out, "Status: active" as &const byte, &ok);
    gcr_has(tag, "resume 之后 armed 没打开", &out, "Activation: armed" as &const byte, &ok);

    // ---- I) 控制词只在独占整行时才算控制词：`pause after verification` 是**字面目标** ----
    gcr_rc(tag, "clear 应当成功", gcr_run(&c, &line, &out, "/goal clear" as &const byte), 0, &ok);
    gcr_has(tag, "clear 没有回执", &out, "Goal cleared." as &const byte, &ok);
    if gcr_peek(&c, &g) {
        ty_fail(tag, "clear 之后盘上还有 goal.json", &ok);
    }
    gcr_rc(tag, "clear 之后再 clear 应当成功（幂等）",
        gcr_run(&c, &line, &out, "/goal clear" as &const byte), 0, &ok);
    gcr_has(tag, "重复 clear 的措辞不对", &out, "No goal to clear." as &const byte, &ok);
    gcr_rc(tag, "带后缀的 pause 应当按字面目标创建",
        gcr_run(&c, &line, &out, "/goal pause after verification" as &const byte), 0, &ok);
    gcr_has(tag, "`pause after verification` 没有被当成目标", &out,
        "Objective: pause after verification" as &const byte, &ok);
    // 控制词做前缀（clearx / edits）：同样是字面目标，不是控制词
    gcr_rc(tag, "clearx 应当按字面目标被拒（已有目标）",
        gcr_run(&c, &line, &out, "/goal clearx" as &const byte), 1, &ok);
    gcr_has(tag, "clearx 被当成了 clear", &out, "A goal is already active." as &const byte, &ok);
    if gcr_peek(&c, &g) {
        if !bufx_eq_cstr(g.objective.ptr as &const byte, g.objective.len,
                "pause after verification" as &const byte) {
            ty_fail(tag, "clearx 那条命令动过了 objective", &ok);
        }
    }
    // 大小写不敏感（控制词整行时）：CLEAR
    gcr_rc(tag, "大写 CLEAR 应当照样清掉",
        gcr_run(&c, &line, &out, "/goal CLEAR" as &const byte), 0, &ok);
    gcr_has(tag, "大写 CLEAR 没有回执", &out, "Goal cleared." as &const byte, &ok);
    if gcr_peek(&c, &g) {
        ty_fail(tag, "大写 CLEAR 之后盘上还有 goal.json", &ok);
    }

    // ---- J) complete 的 goal：让位给新身份（id +1，revision 回到 1，round 归零）----
    var cg: Goal = goal_empty();
    defer { goal_free(&cg); }
    cg.active_state = true;
    cg.id = 7;
    cg.revision = 4;
    cg.phase = buf_new(16);
    _ = buf_append_cstr(&cg.phase, "complete");
    cg.objective = buf_new(32);
    _ = buf_append_cstr(&cg.objective, "上一件事");
    cg.round = 3;
    cg.max_rounds = 20;
    cg.blocker = buf_empty();
    cg.armed = false;
    if !goal_save(&c, &cg) {
        ty_fail(tag, "装不上 complete 的 fixture（goal_save 失败）", &ok);
    }
    gcr_rc(tag, "complete 之后允许新目标",
        gcr_run(&c, &line, &out, "/goal 下一件事" as &const byte), 0, &ok);
    gcr_has(tag, "complete 之后的新目标没建出来", &out, "Goal created" as &const byte, &ok);
    if gcr_peek(&c, &g) {
        if g.id != 8 || g.revision != 1 || g.round != 0 || !g.armed {
            ty_fail(tag, "complete 之后的新身份不对（应当是 id 8 / revision 1 / 0 轮 / armed）", &ok);
        }
    }
    // edit 打在 complete 的 goal 上：同样换新身份
    if gcr_peek(&c, &g) {
        buf_reset(&g.phase);
        _ = buf_append_cstr(&g.phase, "complete");
        g.armed = false;
        if !goal_save(&c, &g) {
            ty_fail(tag, "装不上 complete fixture（第二处）", &ok);
        }
    }
    gcr_rc(tag, "edit 打在 complete 的 goal 上应当换新身份",
        gcr_run(&c, &line, &out, "/goal edit 又一件新事" as &const byte), 0, &ok);
    gcr_has(tag, "complete 上的 edit 没建出新目标", &out, "Goal created" as &const byte, &ok);
    if gcr_peek(&c, &g) {
        if g.id != 9 || g.revision != 1 {
            ty_fail(tag, "complete 上的 edit 之后不是新身份（id 9 / revision 1）", &ok);
        }
        if !bufx_eq_cstr(g.objective.ptr as &const byte, g.objective.len,
                "又一件新事" as &const byte) {
            ty_fail(tag, "complete 上的 edit 没换成新的 objective", &ok);
        }
    }
    // ---- K) P58：续跑驱动器的判定（`goal_round_admit` 是纯函数 + 一次落盘）----
    //
    // 这一段的每一腿都钉一条**可判定的**停止理由（DSH 的 idle 检查点同口径）：
    // 未授权 / 无目标 / 非 active / 轮次用尽 / 记账。逐腿开一次，互不串味。
    var rbody: Buf = buf_new(4096);
    defer { buf_free(&rbody); }
    // K1) 盘上有个 active+armed 的目标，但**进程本地没授权** → 一轮都不该开（换会话后的形状）
    _ = goal_clear(&c);
    g_goal_armed = false;
    gcr_rc(tag, "先建一个目标（给续跑腿用）",
        gcr_run(&c, &line, &out, "/goal 把续跑这条腿跑绿" as &const byte), 0, &ok);
    g_goal_armed = false;                // 手工收掉授权：模拟「刚 --resume」
    if goal_round_admit(&c, &rbody) {
        ty_fail(tag, "进程本地没授权时驱动器还是开了一轮", &ok);
    }
    if gcr_peek(&c, &g) && g.round != 0 {
        ty_fail(tag, "没授权的那次居然把轮号推进了", &ok);
    }
    // K2) 授权之后：该开，正文形状对（标签 / objective / 轮号 / 结束标签），并且**记账**
    g_goal_armed = true;
    if !goal_round_admit(&c, &rbody) {
        ty_fail(tag, "授权之后驱动器没有开轮", &ok);
    }
    if !contains(&rbody, "<goal_round>" as &const byte)
        || !contains(&rbody, "</goal_round>" as &const byte) {
        ty_fail(tag, "续跑正文没有 <goal_round> 信封", &ok);
    }
    if !contains(&rbody, "Objective: \"把续跑这条腿跑绿\"" as &const byte) {
        ty_fail(tag, "续跑正文里的 objective 没有走 JSON 转义（DSH 同口径）", &ok);
    }
    if !contains(&rbody, "Round: 1/20" as &const byte) {
        ty_fail(tag, "续跑正文里的轮号不对（应当是 Round: 1/20）", &ok);
    }
    if gcr_peek(&c, &g) {
        // create 落在 revision 1；admit 记账 → round 1 / revision 2
        if g.round != 1 || g.revision != 2 {
            ty_fail(tag, "开了轮之后盘上没有记账（round/revision 不对）", &ok);
        }
    } else {
        ty_fail(tag, "开了轮之后 goal.json 不见了", &ok);
    }
    // K3) 第二轮：轮号递增、revision 继续涨
    if !goal_round_admit(&c, &rbody) {
        ty_fail(tag, "第二轮没有开出来", &ok);
    }
    if !contains(&rbody, "Round: 2/20" as &const byte) {
        ty_fail(tag, "第二轮的轮号没递增", &ok);
    }
    // K4) 模型把目标标成 complete 之后：不该再开（盘上是终态）
    if gcr_peek(&c, &g) {
        buf_reset(&g.phase);
        _ = buf_append_cstr(&g.phase, "complete");
        g.armed = false;
        if !goal_save(&c, &g) {
            ty_fail(tag, "装不上 complete fixture（续跑腿）", &ok);
        }
    }
    if goal_round_admit(&c, &rbody) {
        ty_fail(tag, "complete 的目标还是被驱动了", &ok);
    }
    // K5) **轮次用尽**：把 round 顶到 maxRounds，驱动器应当开不动，并且把盘上标成 blocked
    //     + blocker=round-limit + armed=false（DSH 的 round-limit 同口径，不是悄悄停下）
    g_goal_armed = true;
    if gcr_peek(&c, &g) {
        buf_reset(&g.phase);
        _ = buf_append_cstr(&g.phase, "active");
        g.armed = true;
        g.round = g.max_rounds;
        g.revision = g.revision + 1;
        if !goal_save(&c, &g) {
            ty_fail(tag, "装不上轮次用尽的 fixture", &ok);
        }
    }
    if goal_round_admit(&c, &rbody) {
        ty_fail(tag, "轮次用尽还是开了新轮", &ok);
    }
    if gcr_peek(&c, &g) {
        if !bufx_eq_cstr(g.phase.ptr as &const byte, g.phase.len, "blocked" as &const byte) {
            ty_fail(tag, "轮次用尽之后盘上不是 blocked（应当是终态而不是悄悄停下）", &ok);
        }
        if !bufx_eq_cstr(g.blocker.ptr as &const byte, g.blocker.len, "round-limit" as &const byte) {
            ty_fail(tag, "轮次用尽的 blocker 不是 round-limit", &ok);
        }
        if g.armed {
            ty_fail(tag, "轮次用尽之后盘上的 armed 还开着", &ok);
        }
    }
    if g_goal_armed {
        ty_fail(tag, "轮次用尽之后进程本地的授权没有收掉（会空转）", &ok);
    }
    // K6) `/goal resume` 是**人明确授权**的唯一入口：resume 之后驱动器又能开
    //     （把 phase 掰回 active，与「人重新授权」同一个形状）
    if gcr_peek(&c, &g) {
        buf_reset(&g.phase);
        _ = buf_append_cstr(&g.phase, "active");
        g.armed = true;
        g.round = 0;
        g.revision = g.revision + 1;
        if !goal_save(&c, &g) {
            ty_fail(tag, "装不上 resume fixture", &ok);
        }
    }
    g_goal_armed = false;
    gcr_rc(tag, "resume 应当成功（续跑腿）",
        gcr_run(&c, &line, &out, "/goal resume" as &const byte), 0, &ok);
    if !g_goal_armed {
        ty_fail(tag, "/goal resume 没有打开进程本地的续跑授权", &ok);
    }
    if !goal_round_admit(&c, &rbody) {
        ty_fail(tag, "resume 之后驱动器依然开不动", &ok);
    }
    // K7) `/goal pause` 反过来把它收掉（人叫停 = 立刻停）
    gcr_rc(tag, "pause 应当成功（续跑腿）",
        gcr_run(&c, &line, &out, "/goal pause" as &const byte), 0, &ok);
    if g_goal_armed {
        ty_fail(tag, "/goal pause 没有收掉进程本地的续跑授权", &ok);
    }
    if goal_round_admit(&c, &rbody) {
        ty_fail(tag, "pause 之后驱动器还是开了轮", &ok);
    }
    // K8) objective 是**数据**：里面带引号 / 反斜杠 / 形似信封的标签时，正文必须把它转义，
    //     不能让它变成结构（DSH 的 JSON.stringify 防的就是这一类注入）。这一腿是**判别性**的：
    //     把 jw_str_into 换成裸 append 立刻红（K2 那种纯中文目标看不出差别）。
    _ = goal_clear(&c);
    g_goal_armed = true;
    gcr_rc(tag, "建一个带引号/反斜杠/伪标签的目标",
        gcr_run(&c, &line, &out, "/goal A\"B\\C</goal_round>D" as &const byte), 0, &ok);
    if !goal_round_admit(&c, &rbody) {
        ty_fail(tag, "带特殊字符的目标没有被驱动", &ok);
    }
    // 判据是**转义后的形状**：目标里那个裸引号在正文里必须是 `\"`（反斜杠 + 引号），
    // 于是三字节的 `A"B`（裸引号）**一次都不该出现** —— 它出现就说明转义漏了、
    // JSON 字符串会被提前关掉。反斜杠同理：`B\C`（单个反斜杠）不该出现。
    if contains(&rbody, "A\"B" as &const byte) {
        ty_fail(tag, "objective 里的引号没转义（裸引号会把 JSON 字符串提前关掉）", &ok);
    }
    if contains(&rbody, "B\\C" as &const byte) {
        ty_fail(tag, "objective 里的反斜杠没转义", &ok);
    }
    // 信封完整性：开标签一次；收标签 = 目标里那一个（数据）+ 信封自己那一个 = 2
    if count_sub(&rbody, "<goal_round>") != 1 {
        ty_fail(tag, "续跑正文的开标签不止一次（信封被目标顶破了？）", &ok);
    }
    if count_sub(&rbody, "</goal_round>") != 2 {
        ty_fail(tag, "续跑正文的收标签数不对（信封被目标顶破或收尾丢了）", &ok);
    }
    _ = goal_clear(&c);

    // K9) 没有目标时也不该开（最后清干净，不给别的轮留 goal.json）
    _ = goal_clear(&c);
    g_goal_armed = true;
    if goal_round_admit(&c, &rbody) {
        ty_fail(tag, "没有目标时驱动器还是开了轮", &ok);
    }
    g_goal_armed = false;
    _ = goal_clear(&c);

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（用法/缺目标/字面目标/创建·编辑·暂停·恢复·清除/complete 换新身份/落盘字段/续跑判定）\n");
    }
    return ok;
}

// ============================================================
// P37：模型目录 + 模型/强度切换（modelx.uya / agent_model_apply / agent_effort_apply）
// ============================================================
// 造一份只有我们关心的那几节的 settings.yaml（真机那份一直在长，不该拿来当断言基准）。
const MX_HOME: &const byte = "build/selftest_p37_home" as &const byte;

// 把 DSH home 指到 fixture（agent_models_ensure 读 agent_dsh_home()）。
// 必须用**可变** Buf 的切片：`&const byte` 直接切出来的类型跟 agent_set_dsh_home 的
// `&[byte]` 对不上（生成的 C 里是 `uya_slice_int32_t`，链接期才炸）。
fn mx_set_home() void {
    var hb: Buf = buf_new(128);
    defer { buf_free(&hb); }
    _ = buf_append_cstr(&hb, MX_HOME);
    _ = agent_set_dsh_home(hb.ptr[0: hb.len]);
}

// 给模型目录轮写一份只含关心几节的 settings.yaml（真机那份一直在长，不能当断言基准）。
// 返回 false = 建目录或写文件失败。
fn mx_fixture_write() bool {
    _ = sess_mkdir_p(MX_HOME);
    var p: Buf = buf_new(256);
    defer { buf_free(&p); }
    // 注意：只有**最后**一段能用 append_cstr_z（它会把 NUL 也写进缓冲，
    // 后面的追加就落在 NUL 之后 —— §16 里反复踩过的那条）
    _ = buf_append_cstr(&p, MX_HOME);
    _ = buf_append_cstr_z(&p, "/settings.yaml");
    // delta：**故意**发布与 alpha 同名的 a-two（能力不同）—— P62「同名模型选不中」的回归现场。
    // 真机上 `DeepSeek-V4.1-Flash` 就是这么挂在 `aigw-local` 与 `autodl-api` 两家的。
    const body: &const byte = "llm-pi-ai:\n  providers:\n    {\n      alpha:\n        {\n          api: openai-responses,\n          baseURL: https://alpha.example/v1,\n          apiKeyEnv: ALPHA_KEY,\n          compat: { supportsDeveloperRole: false },\n          models:\n            [\n              { id: a-one, name: A One, contextWindow: 111000, input: [ text, image ] },\n              { id: a-two, contextWindow: 222000, maxTokens: 4096, reasoningEfforts: { off: none, low: low, high: high } }\n            ]\n        },\n      beta:\n        {\n          api: openai-completions,\n          baseURL: https://beta.example/v1,\n          models:\n            [\n              { id: b-plain, reasoningEfforts: false },\n              { id: b-think, reasoningEfforts: { minimal: minimal, high: high, xhigh: xhigh } }\n            ]\n        },\n      gamma:\n        {\n          api: openai-completions,\n          models:\n            [\n              { id: g-one }\n            ]\n        },\n      delta:\n        {\n          api: openai-completions,\n          baseURL: https://delta.example/v1,\n          apiKeyEnv: DELTA_KEY,\n          models:\n            [\n              { id: a-two, contextWindow: 333000, maxTokens: 8192, reasoningEfforts: { off: none } }\n            ]\n        }\n    }\n" as &const byte;
    return write_text_file(p.ptr as &const byte, body);
}

// 一轮：目录解析（分组 / 能力 / 档位；`false` = 一个档位都不公布）+ agent_model_apply 的三种路径。
fn model_catalog_round(tag: &const byte) bool {
    var ok: bool = true;
    agent_models_reset();
    if !mx_fixture_write() {
        ty_fail(tag, "造 settings.yaml fixture 失败", &ok);
        return ok;
    }
    var t: McTable = McTable{ items: [], n: 0, loaded: false };
    mx_init(&t);
    defer { mx_free(&t); }
    if !mx_load(MX_HOME, &t) {
        ty_fail(tag, "mx_load 失败", &ok);
        return ok;
    }
    if mx_count(&t) != 6 {
        ty_fail(tag, "目录条目数不是 6（alpha 2 + beta 2 + gamma 1 + delta 1；gamma 是「没声明 baseURL」那条腿，delta 是**同名跨提供方**那条腿）", &ok);
        return ok;
    }
    // ---- P62：同名 a-two 在目录里必须是**两条**、且各自可定位（二元组查询分得开）----
    // 这是「同名选不中」的地基：显示层与选择层能不能区分两家，全看 mx_find 认不认二元组。
    const ia: i32 = mx_find(&t, "alpha" as &const byte, 5, "a-two" as &const byte, 5);
    const id: i32 = mx_find(&t, "delta" as &const byte, 5, "a-two" as &const byte, 5);
    if ia < 0 || id < 0 {
        ty_fail(tag, "同名 a-two 在 alpha / delta 两家下都应当能查到", &ok);
    } else if ia == id {
        ty_fail(tag, "同名 a-two 的两家被解析成了同一条（二元组查询分不开）", &ok);
    } else {
        const ea: &const McEntry = mx_entry_at(&t, ia as usize);
        const ed: &const McEntry = mx_entry_at(&t, id as usize);
        if ea.context_window != 222000 || ed.context_window != 333000 {
            ty_fail(tag, "同名 a-two 两家的能力应当各是各的（222000 / 333000）", &ok);
        }
    }
    // ---- alpha·a-one：能力齐、**没写** reasoningEfforts（declared=false、无档位）----
    const i0: i32 = mx_find(&t, "alpha" as &const byte, 5, "a-one" as &const byte, 5);
    if i0 < 0 {
        ty_fail(tag, "找不到 alpha/a-one", &ok);
    } else {
        const e: &const McEntry = mx_entry_at(&t, i0 as usize);
        if e.context_window != 111000 || !e.input_image {
            ty_fail(tag, "a-one 的 contextWindow / input 解析错", &ok);
        }
        if e.declared || e.reasoning {
            ty_fail(tag, "a-one 没写 reasoningEfforts，不该被判成「有档位」", &ok);
        }
        if e.compat_dev_role != 0 {
            ty_fail(tag, "a-one 的 provider 级 supportsDeveloperRole=false 没继承", &ok);
        }
    }
    // ---- alpha·a-two：三档 + maxTokens + 模型级能力 ----
    const i1: i32 = mx_find(&t, "alpha" as &const byte, 5, "a-two" as &const byte, 5);
    if i1 < 0 {
        ty_fail(tag, "找不到 alpha/a-two", &ok);
    } else {
        const e2: &const McEntry = mx_entry_at(&t, i1 as usize);
        if !e2.reasoning || !e2.declared {
            ty_fail(tag, "a-two 应当公布推理档位", &ok);
        }
        if !mx_has_level(e2, 0) || !mx_has_level(e2, 2) || !mx_has_level(e2, 4) {
            ty_fail(tag, "a-two 的 off/low/high 三档没收全", &ok);
        }
        if mx_has_level(e2, 1) || mx_has_level(e2, 3) {
            ty_fail(tag, "a-two 没公布的 minimal/medium 不该被判成可用", &ok);
        }
        var lv: Buf = buf_new(64);
        defer { buf_free(&lv); }
        mx_levels_into(e2, &lv);
        if !ty_buf_is(&lv, "off, low, high" as &const byte) {
            ty_fail(tag, "a-two 的档位清单不是「off, low, high」", &ok);
        }
        if mx_default_level(e2) != 0 {
            ty_fail(tag, "a-two 的默认档位应当是第一个公布的（off）", &ok);
        }
        if e2.max_tokens != 4096 {
            ty_fail(tag, "a-two 的 maxTokens 没解析", &ok);
        }
    }
    // ---- beta·b-plain：`reasoningEfforts: false` = 声明过但不公布任何档位 ----
    const i2: i32 = mx_find(&t, "beta" as &const byte, 4, "b-plain" as &const byte, 7);
    if i2 < 0 {
        ty_fail(tag, "找不到 beta/b-plain", &ok);
    } else {
        const e3: &const McEntry = mx_entry_at(&t, i2 as usize);
        if !e3.declared || e3.reasoning {
            ty_fail(tag, "reasoningEfforts=false 应当是「声明过、无档位」", &ok);
        }
        var lv3: Buf = buf_new(32);
        defer { buf_free(&lv3); }
        mx_levels_into(e3, &lv3);
        if lv3.len != 0 {
            ty_fail(tag, "非推理模型的档位清单必须是空的（不发明档位）", &ok);
        }
    }
    // ---- beta·b-think ----
    const i3: i32 = mx_find(&t, "beta" as &const byte, 4, "b-think" as &const byte, 7);
    if i3 < 0 {
        ty_fail(tag, "找不到 beta/b-think", &ok);
    } else {
        const e4: &const McEntry = mx_entry_at(&t, i3 as usize);
        if !mx_has_level(e4, 1) || !mx_has_level(e4, 4) || !mx_has_level(e4, 5) {
            ty_fail(tag, "b-think 的 minimal/high/xhigh 没收全", &ok);
        }
    }
    // 档位名与序号的双向映射（none == off）
    if mx_level_index("none" as &const byte, 4) != 0 {
        ty_fail(tag, "none 应当等价于 off（序号 0）", &ok);
    }
    if mx_level_index("bogus" as &const byte, 5) != -1 {
        ty_fail(tag, "不认识的档位名应当返回 -1", &ok);
    }
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（目录分组/能力/档位；false=无档位；none==off）\n");
    }
    return ok;
}

// agent_model_apply 的三条路：命中（能力跟随 + 档位回落）、幂等、目录外（只换名字不清能力）
fn model_apply_round(tag: &const byte) bool {
    var ok: bool = true;
    agent_models_reset();
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("deepseek-chat");
    cfg.context_window = -1;
    cfg.reasoning_effort = buf_from_cstr("max");
    cfg.src_effort = 3;
    cfg.effort_set = false;
    // 把 DSH home 指向 fixture（agent_models_ensure 读 agent_dsh_home()）
    mx_set_home();
    agent_models_ensure(&cfg);
    if agent_models_count() != 6 {
        ty_fail(tag, "agent_models_ensure 没读到 fixture 目录（应当是 6 条：alpha 2 + beta 2 + gamma 1 + delta 1）", &ok);
        return ok;
    }
    // ---- 0) 换提供方：端点跟着走（beta 的 baseURL 与 alpha 不同）----
    // 起点先落在 alpha（base_url 也是 alpha 的），这样下面切 beta 时才有「换」可言
    cfg.base_url = buf_from_cstr("https://alpha.example/v1");
    cfg.src_base_url = 1;
    const rcB: i32 = agent_model_apply(&cfg, "beta" as &const byte, 4, "b-think" as &const byte, 7,
        "human" as &const byte, false);
    if rcB != 0 {
        ty_fail(tag, "切到 beta/b-think 应当返回 0", &ok);
    }
    if !ty_buf_is(&cfg.base_url, "https://beta.example/v1" as &const byte) {
        ty_fail(tag, "换了提供方之后端点没跟过去（请求会打到旧提供方 —— 本轮修的就是这条）", &ok);
    }
    if cfg.src_base_url != 1 {
        ty_fail(tag, "跟随来的 base_url 来源应当是 dsh-settings(1)", &ok);
    }
    if cfg.api_style != LLM_STYLE_CHAT {
        ty_fail(tag, "beta 声明的是 openai-completions，协议没跟过去", &ok);
    }
    // 回到 alpha：端点也要跟着回（不能只单方向生效）
    const rcA: i32 = agent_model_apply(&cfg, "alpha" as &const byte, 5, "a-two" as &const byte, 5,
        "human" as &const byte, false);
    if rcA != 0 {
        ty_fail(tag, "切回 alpha/a-two 应当返回 0", &ok);
    }
    if !ty_buf_is(&cfg.base_url, "https://alpha.example/v1" as &const byte) {
        ty_fail(tag, "切回 alpha 时端点没跟着回来", &ok);
    }
    if cfg.api_style != LLM_STYLE_RESPONSES {
        ty_fail(tag, "alpha 声明的是 openai-responses，协议没跟着回来", &ok);
    }
    // ---- 0b) 显式钉住：--base-url / --api-key 给过的值不许被目录覆盖 ----
    buf_free(&cfg.base_url);
    cfg.base_url = buf_from_cstr("https://pinned.example/v1");
    cfg.src_base_url = 3;                        // 3 = cli
    buf_free(&cfg.api_key);
    cfg.api_key = buf_from_cstr("pinned-key");
    cfg.src_key = 3;
    const rcP: i32 = agent_model_apply(&cfg, "beta" as &const byte, 4, "b-plain" as &const byte, 7,
        "human" as &const byte, false);
    if rcP != 0 {
        ty_fail(tag, "切到 beta/b-plain 应当返回 0", &ok);
    }
    if !ty_buf_is(&cfg.base_url, "https://pinned.example/v1" as &const byte) {
        ty_fail(tag, "显式 --base-url 被切模型覆盖了（用户钉住的端点必须优先）", &ok);
    }
    if !ty_buf_is(&cfg.api_key, "pinned-key" as &const byte) {
        ty_fail(tag, "显式 --api-key 被切模型覆盖了", &ok);
    }
    // ---- 0c) 提供方没声明 baseURL（gamma）：端点/凭据一个字节都不改 ----
    buf_free(&cfg.base_url);
    cfg.base_url = buf_from_cstr("https://keep.example/v1");
    cfg.src_base_url = 0;                        // 不是显式给的：允许跟随，但这次没有可跟的值
    const rcG: i32 = agent_model_apply(&cfg, "gamma" as &const byte, 5, "g-one" as &const byte, 5,
        "human" as &const byte, false);
    if rcG != 0 {
        ty_fail(tag, "切到 gamma/g-one 应当返回 0", &ok);
    }
    if !ty_buf_is(&cfg.base_url, "https://keep.example/v1" as &const byte) {
        ty_fail(tag, "提供方没声明 baseURL 时端点不该被改（也不该被清空）", &ok);
    }
    // ---- 0d) beta 没写 apiKeyEnv：解析不出新凭据 ⇒ **清空** key（绝不把旧密钥发过去）----
    buf_free(&cfg.api_key);
    cfg.api_key = buf_from_cstr("key-belongs-to-alpha");
    cfg.src_key = 1;                             // 是目录路线来的，允许被替换
    const rcK: i32 = agent_model_apply(&cfg, "beta" as &const byte, 4, "b-plain" as &const byte, 7,
        "human" as &const byte, false);
    if rcK != 0 {
        ty_fail(tag, "切到 beta/b-plain 应当返回 0", &ok);
    }
    if cfg.api_key.len != 0 {
        ty_fail(tag, "新提供方解析不出凭据时应当清空 key（把旧提供方的密钥发过去是泄露）", &ok);
    }
    // 复位成「目录路线」，后面的断言按老口径继续
    buf_free(&cfg.base_url);
    cfg.base_url = buf_empty();
    cfg.src_base_url = 0;
    buf_free(&cfg.api_key);
    cfg.api_key = buf_empty();
    cfg.src_key = 0;
    cfg.provider_set = false;
    // ---- 1) 命中 alpha/a-two：能力跟随 + max 不在档位里 → 回落到 off ----
    const rc1: i32 = agent_model_apply(&cfg, "alpha" as &const byte, 5, "a-two" as &const byte, 5,
        "cli" as &const byte, false);
    if rc1 != 0 {
        ty_fail(tag, "切到 alpha/a-two 应当返回 0", &ok);
    }
    if !ty_buf_is(&cfg.model, "a-two" as &const byte) || !ty_buf_is(&cfg.provider, "alpha" as &const byte) {
        ty_fail(tag, "切过去之后 model/provider 不对", &ok);
    }
    if cfg.context_window != 222000 {
        ty_fail(tag, "切模型没把 contextWindow 搬过来（压缩会失效）", &ok);
    }
    if cfg.max_tokens != 4096 {
        ty_fail(tag, "切模型没把 maxTokens 搬过来", &ok);
    }
    if cfg.api_dev_role {
        ty_fail(tag, "alpha 的 provider 级 supportsDeveloperRole=false 没生效", &ok);
    }
    if !ty_buf_is(&cfg.reasoning_effort, "off" as &const byte) {
        ty_fail(tag, "max 不在 a-two 公布的档位里，应当回落到第一个公布的（off）", &ok);
    }
    if !cfg.effort_set {
        ty_fail(tag, "回落到公布档位后 effort_set 应当为真", &ok);
    }
    // ---- 2) 幂等：同一个 (provider, model) 返回 1，什么都不动 ----
    const rc2: i32 = agent_model_apply(&cfg, "alpha" as &const byte, 5, "a-two" as &const byte, 5,
        "cli" as &const byte, false);
    if rc2 != 1 {
        ty_fail(tag, "同一个模型再切一次应当幂等（返回 1）", &ok);
    }
    // ---- 3) 目录外：只换名字，能力与 provider 保持不动 ----
    const cw_before: i64 = cfg.context_window;
    const rc3: i32 = agent_model_apply(&cfg, cfg.provider.ptr as &const byte, cfg.provider.len,
        "not-in-catalog" as &const byte, 14, "human" as &const byte, false);
    if rc3 != 0 {
        ty_fail(tag, "目录外的模型名也应当换成功（返回 0）", &ok);
    }
    if !ty_buf_is(&cfg.model, "not-in-catalog" as &const byte) {
        ty_fail(tag, "目录外的模型名没换上去", &ok);
    }
    if cfg.context_window != cw_before {
        ty_fail(tag, "目录外的模型不该清掉 contextWindow", &ok);
    }
    if !ty_buf_is(&cfg.provider, "alpha" as &const byte) {
        ty_fail(tag, "目录外的模型不该清掉 provider", &ok);
    }
    // ---- 4) 非推理模型：档位保持原样、effort_set 落回 false（不装成「已校验」）----
    const rc4: i32 = agent_model_apply(&cfg, "beta" as &const byte, 4, "b-plain" as &const byte, 7,
        "cli" as &const byte, false);
    if rc4 != 0 {
        ty_fail(tag, "切到 beta/b-plain 应当返回 0", &ok);
    }
    if cfg.effort_set {
        ty_fail(tag, "不公布档位的模型上 effort_set 不该为真", &ok);
    }
    if !ty_buf_is(&cfg.reasoning_effort, "off" as &const byte) {
        ty_fail(tag, "不公布档位时不该动（或乱改）推理强度", &ok);
    }
    // ---- 5) P62：**同名跨提供方**——切到 delta 的 a-two 必须真换过去（用户报的那条）----
    // 起点先回到 alpha/a-two（上面刚被 b-plain 改过），再切 delta 的同名 a-two。
    // 老实现的口径下这一步「看起来成功」，但同名会让「指定哪一家」丢在名字里 —— 这里逐个钉住
    // provider、能力、端点三样都跟着 delta 走。
    const rcA2: i32 = agent_model_apply(&cfg, "alpha" as &const byte, 5, "a-two" as &const byte, 5,
        "cli" as &const byte, false);
    if rcA2 != 0 {
        ty_fail(tag, "回到 alpha/a-two 应当返回 0", &ok);
    }
    if !ty_buf_is(&cfg.base_url, "https://alpha.example/v1" as &const byte) {
        ty_fail(tag, "回 alpha/a-two 之后端点不对", &ok);
    }
    const rcD: i32 = agent_model_apply(&cfg, "" as &const byte, 0, "delta/a-two" as &const byte, 11,
        "cli" as &const byte, false);
    if rcD != 0 {
        ty_fail(tag, "`delta/a-two`（同名跨提供方的显式写法）应当返回 0", &ok);
    }
    if !ty_buf_is(&cfg.provider, "delta" as &const byte) {
        ty_fail(tag, "同名 a-two 指定 delta 之后 provider 没换过去（同名选不中）", &ok);
    }
    if !ty_buf_is(&cfg.model, "a-two" as &const byte) {
        ty_fail(tag, "同名 a-two 的模型名不该被改成别的", &ok);
    }
    if cfg.context_window != 333000 {
        ty_fail(tag, "同名 a-two 切到 delta 之后能力没跟着换（还是 alpha 那条的 contextWindow）", &ok);
    }
    // ⚠ 这里刻意**不**断言 maxTokens 跟着换：那是 P37 的既有口径 —— 只在 `cfg.max_tokens == 0`
    // 时才从目录补（保住显式 `--max-tokens`），第一条命中的条目填上之后就不再变。本轮的范围是
    // 「同名模型选不中」，不顺手改 maxTokens 的取值语义（改它要连来源码一起动）。
    if !ty_buf_is(&cfg.base_url, "https://delta.example/v1" as &const byte) {
        ty_fail(tag, "同名 a-two 切到 delta 之后端点没跟过去", &ok);
    }
    // 反方向：从 delta 的同名 a-two 回 alpha 的同名 a-two（两个方向都要能指定）
    const rcA3: i32 = agent_model_apply(&cfg, "" as &const byte, 0, "alpha/a-two" as &const byte, 11,
        "cli" as &const byte, false);
    if rcA3 != 0 {
        ty_fail(tag, "`alpha/a-two` 应当返回 0", &ok);
    }
    if !ty_buf_is(&cfg.provider, "alpha" as &const byte) || cfg.context_window != 222000 {
        ty_fail(tag, "同名 a-two 切回 alpha 没生效（provider 或能力不对）", &ok);
    }
    // ---- 6) P62：`/` 不许被误拆 —— 目录里查不到的左半段整串当模型名 ----
    // `Qwen/Qwen3-32B` 这类 id 自带 `/`：拆成一个不存在的提供方会把请求打到别的路线，比不拆更坏。
    const rcQ: i32 = agent_model_apply(&cfg, "" as &const byte, 0, "Qwen/Qwen3-32B" as &const byte, 14,
        "cli" as &const byte, false);
    if rcQ != 0 {
        ty_fail(tag, "目录外带 `/` 的名字也该换成功（返回 0）", &ok);
    }
    if !ty_buf_is(&cfg.model, "Qwen/Qwen3-32B" as &const byte) {
        ty_fail(tag, "目录外带 `/` 的名字被误拆了（整串才是模型名）", &ok);
    }
    if !ty_buf_is(&cfg.provider, "alpha" as &const byte) {
        ty_fail(tag, "目录外带 `/` 的名字不该改 provider", &ok);
    }
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（换提供方端点/协议跟随 / 显式钉住不被覆盖 / 缺 baseURL 不改端点 / 缺凭据清空 key / 命中跟随能力+档位回落 / 幂等 / 目录外只换名字 / 非推理模型不校验 / 同名跨提供方双向指定 / `/` 不被误拆）\n");
    }
    return ok;
}

// agent_effort_apply：公布的档位收、没公布的档位拒、不公布的模型原样透传
fn effort_apply_round(tag: &const byte) bool {
    var ok: bool = true;
    agent_models_reset();
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("a-two");
    cfg.provider = buf_from_cstr("alpha");
    cfg.provider_set = true;
    cfg.context_window = -1;
    cfg.reasoning_effort = buf_empty();
    mx_set_home();
    agent_models_ensure(&cfg);
    // 公布的档位：收
    if agent_effort_apply(&cfg, "high" as &const byte, 4, false, "human" as &const byte) != 0 {
        ty_fail(tag, "切到公布的 high 应当成功", &ok);
    }
    if !ty_buf_is(&cfg.reasoning_effort, "high" as &const byte) || !cfg.effort_set {
        ty_fail(tag, "切到 high 之后值/effort_set 不对", &ok);
    }
    // 同值幂等
    if agent_effort_apply(&cfg, "high" as &const byte, 4, false, "human" as &const byte) != 1 {
        ty_fail(tag, "同一个档位再切一次应当幂等（返回 1）", &ok);
    }
    // 没公布的档位：拒（返回 2）
    if agent_effort_apply(&cfg, "medium" as &const byte, 6, false, "human" as &const byte) != 2 {
        ty_fail(tag, "medium 不在 a-two 公布的档位里，应当被拒（返回 2）", &ok);
    }
    if !ty_buf_is(&cfg.reasoning_effort, "high" as &const byte) {
        ty_fail(tag, "被拒之后值不该变", &ok);
    }
    // 不认识的档位名：拒
    if agent_effort_apply(&cfg, "bogus" as &const byte, 5, false, "human" as &const byte) != 2 {
        ty_fail(tag, "不认识的档位名应当被拒", &ok);
    }
    // 非推理模型：原样透传（与 --reasoning-effort 的老口径一致，不 clamp）
    cfg.model = buf_from_cstr("b-plain");
    cfg.provider = buf_from_cstr("beta");
    if agent_effort_apply(&cfg, "xhigh" as &const byte, 5, false, "human" as &const byte) != 0 {
        ty_fail(tag, "不公布档位的模型上，显式给的档位应当原样透传", &ok);
    }
    if cfg.effort_set {
        ty_fail(tag, "透传的值不该被标成「模型公布」", &ok);
    }
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（公布档位收 / 未公布档位拒 / 不认识的拒 / 非推理模型透传）\n");
    }
    return ok;
}

// 会话日志的 session/model（--resume 靠它跟随）—— 用真落盘验证
fn model_log_round(tag: &const byte) bool {
    var ok: bool = true;
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        ty_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    _ = buf_append(&home, root.ptr as &const byte, root.len);
    _ = buf_append_cstr(&home, "/build/selftest_p37_mlog");
    _ = sess_mkdir_p(home.ptr as &const byte);
    mx_set_home();
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.agent_home = buf_new(home.len + 8);
    _ = buf_append(&cfg.agent_home, home.ptr as &const byte, home.len);
    cfg.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&cfg);
    cfg.model = buf_from_cstr("a-two");
    cfg.provider = buf_from_cstr("alpha");
    cfg.provider_set = true;
    if !agent_session_create(&cfg) {
        ty_fail(tag, "agent_session_create 失败", &ok);
        return ok;
    }
    agent_models_ensure(&cfg);
    _ = agent_model_apply(&cfg, "beta" as &const byte, 4, "b-think" as &const byte, 7,
        "human" as &const byte, false);
    _ = agent_effort_apply(&cfg, "xhigh" as &const byte, 5, false, "human" as &const byte);
    if !ty_buf_is(&cfg.model, "b-think" as &const byte) || !ty_buf_is(&cfg.reasoning_effort, "xhigh" as &const byte) {
        ty_fail(tag, "切换之后内存里的选择不对", &ok);
    }
    // 读回日志：最后一条 session/model 必须是 b-think / xhigh
    var meta: SessMeta = sess_meta_empty();
    defer { sess_meta_free(&meta); }
    var pz: Buf = buf_new(g_sess.path.len + 1);
    defer { buf_free(&pz); }
    _ = buf_append(&pz, g_sess.path.ptr as &const byte, g_sess.path.len);
    _ = buf_append_byte(&pz, 0);
    agent_session_close();
    if !sess_read_meta(pz.ptr as &const byte, &meta) {
        ty_fail(tag, "sess_read_meta 读不回刚写的日志", &ok);
    } else {
        if !ty_buf_is(&meta.model, "b-think" as &const byte) {
            ty_fail(tag, "日志里最后一条 session/model 的 model 不对", &ok);
        }
        if !ty_buf_is(&meta.provider, "beta" as &const byte) {
            ty_fail(tag, "日志里最后一条 session/model 的 provider 不对", &ok);
        }
        if !ty_buf_is(&meta.effort, "xhigh" as &const byte) {
            ty_fail(tag, "日志里最后一条 session/model 的 reasoningEffort 不对", &ok);
        }
    }
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（session/model 落盘 + 最后一条为准 + sess_read_meta 读回）\n");
    }
    return ok;
}
