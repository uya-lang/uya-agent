// src/selftest/tuiselftest.uya — 全屏 TUI（P17）的离线自测轮次
//
// 本文件：全屏 TUI 的离线自测轮：排版、按键与编辑器、显示收口、端到端回合、常驻状态区、真 PTY
//   （备用屏幕、termios 逐位还原、SIGWINCH 重排）、滚动模式标题、访问模式 chip 与 Full access
//   确认、read-only 批准、诊断出口、命令面板与 /status 浮层、长内容滚动、运行中命令的泵点、
//   /diff 浮窗、ask 提问浮层、计划模式、会话列表与切换、光标、markdown、鼠标、模型切换、
//   Git worktree，以及字节级屏幕快照与 PTY 断言所需的小工具。
// 不变量：① 断言走**字节级**屏幕快照 `tui_screen_text`，它必须与画帧**同源** —— 不许另写一份
//   排版逻辑，否则测试绿而屏幕花；② 每轮开头用**独立夹具** + `tui_reset_all()` + `tui_set_headless`
//   / `tui_set_size` 复位，轮次之间不许残留全局状态（任务块夹具装在真实 globals 上，不清会让下一
//   轮排版断言莫名红）；③ 需要真终端的行为一律 fork 到 PTY / 子进程里做，父进程只读回快照，绝不
//   动自己的 fd 1/fd 2；④ 判定码只用低 8 位（子进程 `sys_exit` 会截断，踩坑 89）。
// 依赖：libc（syscall/unistd）、foundation/bufx、term/tui 各子段、term/tty、session（会话/统计/
//   信号）、agent（主循环）、tools、net（mock LLM 端点）；断言工具前缀 `tuis_*`，轮次前缀 `tui_*`。
// 命名：对外只有 `tui_selftest_all`（selftest_main 里一行调用）；其余私有：`tuis_*`（断言与夹具）、
//   `tui*_round`（轮次）、`tuim_*`（模型轮夹具）。
//
// 轮次：
//   tui-frame  纯排版：多种尺寸下「每行显示列 ≤ cols」「正文层里没有 ESC」、空态居中、
//              对话态底对齐、窄终端退化、面板/脚注字段、滚动夹取；浮层方框的左右边界
//              逐行对齐（长行截断时多补的那个 '…' 不能在预算外 —— 见 §16 踩坑 42）
//   tui-keys   键解码与编辑器：分片喂入（ESC[ 被切开、UTF-8 被切开）、多行编辑、
//              历史、回车提交、运行中 esc = 中断、tab 切计划模式
//   tui-sink   显示收口：TUI 激活后 fd 1/fd 2 **一个字节都不写**，正文进了转录；
//              控制字节/ESC 序列被清洗；思考走独立条目；tui_stop 后写入回到真实 fd
//   tui-turn   端到端（headless + mock LLM）：注入「任务+回车」→ 屏幕里出现用户行、
//              工具卡片、最终答案；回合结束后状态回到 idle、状态区不留残影
//   tui-status 常驻状态区与思考实时行（P18）：转录铺满视口也看得见状态行、实时行在状态行
//              下面且只显示最新一行、超宽从左边截断补 '…'、控制字节被清洗、清空/idle 收掉、
//              滚动时钉住、窄终端退化、view_think_live 默认开且 --quiet 不写
//   tui-pty    真 PTY（/dev/ptmx + fork + dup2）：进/出备用屏幕、termios 逐位还原、
//              SIGTERM 先恢复终端再以 143 退出、SIGWINCH 触发重排
//
// 全部离线；需要碰终端的几轮都 fork 到子进程或 PTY 里做。

// 对外入口（selftest_main 里一行调用）：按顺序跑本轮全部 TUI 轮，任一轮红就置 ok=false，
// 但**跑完全部**（不早退，方便一次看到所有红）。返回 false = 本轮有红。

export fn tui_selftest_all() bool {
    var ok: bool = true;
    if !tui_frame_round("tui-frame" as &const byte) {
        ok = false;
    }
    if !tui_access_round("tui-access" as &const byte) {
        ok = false;
    }
    if !tui_approve_round("tui-approve" as &const byte) {
        ok = false;
    }
    if !tui_plan_round("tui-plan" as &const byte) {
        ok = false;
    }
    if !tui_ask_round("tui-ask" as &const byte) {
        ok = false;
    }
    if !tuis_ti_round("tui-title-input" as &const byte) {
        ok = false;
    }
    if !tui_keys_round("tui-keys" as &const byte) {
        ok = false;
    }
    if !tui_sink_round("tui-sink" as &const byte) {
        ok = false;
    }
    if !tui_turn_round("tui-turn" as &const byte) {
        ok = false;
    }
    if !tui_status_round("tui-status" as &const byte) {
        ok = false;
    }
    if !tui_caret_round("tui-caret" as &const byte) {
        ok = false;
    }
    if !tui_cmd_round("tui-cmd" as &const byte) {
        ok = false;
    }
    if !tui_scroll_round("tui-scroll" as &const byte) {
        ok = false;
    }
    if !tui_exit_round("tui-exit" as &const byte) {
        ok = false;
    }
    if !tui_quit_round("tui-quit" as &const byte) {
        ok = false;
    }
    if !tui_p30_round("tui-p30" as &const byte) {
        ok = false;
    }
    if !tui_p31_round("tui-p31" as &const byte) {
        ok = false;
    }
    if !tui_sessions_round("tui-sessions" as &const byte) {
        ok = false;
    }
    if !tui_sessions_big_round("tui-sessions-big" as &const byte) {
        ok = false;
    }
    if !tui_switch_round("tui-switch" as &const byte) {
        ok = false;
    }
    if !tui_ws_round("tui-ws" as &const byte) {
        ok = false;
    }
    if !tui_pty_round("tui-pty" as &const byte) {
        ok = false;
    }
    if !tty_title_pty_round("tty-title-pty" as &const byte) {
        ok = false;
    }
    if !tui_diag_round("tui-diag" as &const byte) {
        ok = false;
    }
    if !tui_tasks_round("tui-tasks" as &const byte) {
        ok = false;
    }
    if !tui_diff_round("tui-diff" as &const byte) {
        ok = false;
    }
    if !tui_model_round("tui-model" as &const byte) {
        ok = false;
    }
    if !tui_worktree_round("tui-worktree" as &const byte) {
        ok = false;
    }
    if !tui_mouse_round("tui-mouse" as &const byte) {
        ok = false;
    }
    // P50：括起粘贴（踩坑 83）+ 输入上限
    if !tui_paste_round("tui-paste" as &const byte) {
        ok = false;
    }
    if !tui_md_round("tui-md" as &const byte) {
        ok = false;
    }
    if !tui_watch_pick_round("tui-watch-pick" as &const byte) {
        ok = false;
    }
    if !tui_full_round("tui-full" as &const byte, false) {
        ok = false;
    }
    return ok;
}
