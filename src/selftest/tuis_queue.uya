// src/selftest/tuis_queue.uya — 待发队列（P105）：执行中敲的提示词挂在输入框上方
//
// 本文件：tui-queue 轮 —— 六段判据：① 空队列零影响（0 行、版面不变）；② 回车之后
//   那条**画得出来**且紧贴输入框上方；③ 多格 FIFO 不静默顶掉（老实现是单格 buf_reset）；
//   ④ 执行中输入的快照与清洗（ESC / TAB / 行内 LF 不进帧）；⑤ 超预算时收尾成
//   「… 还有 N 条」；⑥ 窄屏 + 运行中 + 浮层重画三格（块让位、状态行仍紧贴面板）。
// 不变量：断言只读**帧文本**（tui_screen_text / tui_row_has，与画帧同源）与公开口径
//   （tui_queue_rows / tui_queue_total / tui_submit_count），不读内部记账变量 ——
//   否则「记账实现坏了」会被同一个坏实现掩盖。
// 依赖：见 tuiselftest.uya 的文件头（本文件与它同处合并命名空间，无本地 use）。
// 命名：沿用本目录自测的 `tuis_` 前缀（轮次为 `tui_queue_round`，夹具 `tuisq_*`）。
//
// 为什么单开一轮：这条链上**没有任何屏幕断言看得见**三件事 —— 队列满了不顶掉旧条目、
// 执行中快照不置脏、浮层重画之后块还在。前两件只有状态判据看得见，第三件只有
// 「开一次浮层再截图」看得见，与 tui-mem 单开一轮同一个理由。
//
// 反假绿的对照（各自单独回退都会当场红）：
//   * 把 tui_do_submit 改回单格 buf_reset ⇒ ③ 的「两条都在」红；
//   * 把 screen.uya 的绘制顺序改回「任务块 → 状态区 → 面板」（不画块）⇒ ② 红；
//   * 把 tui_draw_queue_block 的清洗换成直接 tui_put ⇒ ④ 的 ESC/LF 两条红；
//   * 把 tui_build 浮层那段补回去（不画待发块）⇒ ⑥ 的浮层格红。

// 压 n 条夹具进提交槽（文本「排队第i条」）。压不进去直接报红（容量必须 ≥n）。
fn tuisq_push(n: usize, ok: &bool, tag: &const byte) void {
    var m: Buf = buf_new(64);
    defer { buf_free(&m); }
    var i: usize = 0;
    while i < n {
        buf_reset(&m);
        _ = buf_append_cstr(&m, "排队第");
        _ = buf_append_u64(&m, (i + 1) as u64);
        _ = buf_append_cstr(&m, "条");
        if !tui_submit_push(m.ptr as &const byte, m.len) {
            tuis_fail(tag, "tui_submit_push 被拒（容量不够或实现坏了）", ok);
            return;
        }
        i = i + 1;
    }
}

// 在屏幕里找第一个含 lit 的行；找不到返回 tui_nrows()（越界值，便于直接比较）。
fn tuisq_row(lit: &const byte) usize {
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, lit) {
            return r;
        }
        r = r + 1;
    }
    return tui_nrows();
}

// 帧的健康闸门（正文层无 ESC/NUL、每行不超过 cols）+ 本轮独有的两条不变量：
// 行内不许有 '\n'（会把一行拆成两行画出来）。
fn tuisq_scan(cols: usize, ok: &bool, tag: &const byte) void {
    tuis_scan_rows(cols, ok, tag);
    if tui_rows_have_lf() {
        tuis_fail(tag, "正文层里出现了行内 '\\n'（一行会被拆成两行画出来）", ok);
    }
}

// ① 空队列零影响：0 行、没有块、总数为 0。返回空态的行数（后面几段拿它当基线）。
fn tuisq_empty(ok: &bool, tag: &const byte) usize {
    tuis_reset(100, 30);
    tui_build();
    const rows: usize = tui_nrows();
    if tui_queue_rows() != 0 {
        tuis_fail(tag, "空队列却要向排版要行（版面会被它撑开）", ok);
    }
    if tui_queue_total() != 0 {
        tuis_fail(tag, "空队列的总数不是 0", ok);
    }
    if tuis_screen_has("待发" as &const byte) {
        tuis_fail(tag, "空队列却画出了「待发」块", ok);
    }
    tuisq_scan(100, ok, tag);
    return rows;
}

// ② 回车之后那条画得出来，且**紧贴输入框上方**（用户报的「没有地方显示」的正面判据）。
fn tuisq_visible(ok: &bool, tag: &const byte) void {
    const txt: &const byte = "把 hello.uya 的问候语改成 Hello, uya!" as &const byte;
    const n: usize = bufx_cstr_len(txt);
    tui_input_set(txt, n);
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_has_submit() {
        tuis_fail(tag, "回车之后没有待提交的行（提交没进队列）", ok);
        return;
    }
    if tui_submit_count() != 1 {
        tuis_fail(tag, "回车之后提交槽不是 1 条", ok);
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "回车之后输入行没清空", ok);
    }
    tui_build();
    if !tuis_screen_has("待发 1 条" as &const byte) {
        tuis_fail(tag, "屏幕上没有「待发 1 条」的头行（块没画出来）", ok);
    }
    const r: usize = tuisq_row("改成 Hello, uya!" as &const byte);
    if r >= tui_nrows() {
        tuis_fail(tag, "屏幕上没有待发条目的正文", ok);
        return;
    }
    if r + 1 != tui_panel_top_row() {
        tuis_fail(tag, "待发条目没有紧贴输入框上方（块与面板之间还夹着别的行）", ok);
    }
    tuisq_scan(100, ok, tag);
}

// ③ 多格 FIFO：两条都在、按顺序取（老实现是单格 buf_reset —— 第二条会顶掉第一条）。
fn tuisq_fifo(ok: &bool, tag: &const byte) void {
    const a: &const byte = "第一条：先改问候语" as &const byte;
    const b: &const byte = "第二条：再补一个测试" as &const byte;
    if !tui_submit_push(a, bufx_cstr_len(a)) {
        tuis_fail(tag, "第一条压不进提交槽", ok);
    }
    if !tui_submit_push(b, bufx_cstr_len(b)) {
        tuis_fail(tag, "第二条压不进提交槽", ok);
    }
    if tui_submit_count() != 3 {
        tuis_fail(tag, "两条压进去之后提交槽不是 3 条（前一段那条还在）", ok);
    }
    tui_build();
    // 「两条都在」是本段的主判据：单格实现里第一条已经没了
    if !tuis_screen_has("先改问候语" as &const byte) {
        tuis_fail(tag, "前一条被后一条顶掉了（提交槽又退化成单格）", ok);
    }
    if !tuis_screen_has("再补一个测试" as &const byte) {
        tuis_fail(tag, "后一条没画出来", ok);
    }
    var got: Buf = buf_new(4096);
    defer { buf_free(&got); }
    if !tui_take_submit(&got) {
        tuis_fail(tag, "tui_take_submit 取不出队首", ok);
        return;
    }
    // 队首是上一段那条（B 段压的），取走之后才轮到「第一条」
    if !tui_take_submit(&got) {
        tuis_fail(tag, "取第二次时队列已经空了", ok);
        return;
    }
    if got.len != bufx_cstr_len(a)
        || !bufx_mem_eq(got.ptr as &const byte, a, got.len) {
        tuis_fail(tag, "FIFO 顺序不对（取出来的不是「第一条」）", ok);
    }
    if tui_submit_count() != 1 {
        tuis_fail(tag, "取走两条之后提交槽不是 1 条", ok);
    }
    tuisq_scan(100, ok, tag);
}

// ④ 执行中输入的快照：条数合并、清洗（ESC / TAB 不进帧）、行内 LF 不拆行。
fn tuisq_snap(ok: &bool, tag: &const byte) void {
    // 本段自带地基（提交槽 1 条 + 快照 2 行 = 3 条，正好一整块）：上面几段留下的
    // 余量会让块提前进入「… 还有 N 条」的收尾形态，那是 ⑤ 段要测的东西。
    tui_queue_reset();
    // 脏字节：ESC[31m 红 ESC[0m + TAB + 两个中文 —— 粘贴进来的彩色文本就长这样
    const dirty: &const byte = "\x1b[31m红\x1b[0m\t色" as &const byte;
    if !tui_submit_push(dirty, bufx_cstr_len(dirty)) {
        tuis_fail(tag, "带控制字节的那条压不进提交槽", ok);
    }
    const snap: &const byte = "运行中敲的第一句\n运行中敲的第二句" as &const byte;
    tui_queue_set(snap, bufx_cstr_len(snap));
    if tui_queue_total() != 3 {
        tuis_fail(tag, "提交槽 1 条 + 快照 2 行，总数应当是 3", ok);
    }
    if tui_queue_rows() != 4 {
        tuis_fail(tag, "3 条应当是头行 + 3 条 = 4 行", ok);
    }
    tui_build();
    if !tuis_screen_has("待发 3 条" as &const byte) {
        tuis_fail(tag, "头行的总条数不对（快照没并进来）", ok);
    }
    if !tuis_screen_has("运行中敲的第二句" as &const byte) {
        tuis_fail(tag, "执行中快照的最后一行没画出来", ok);
    }
    // 清洗：ESC 与 TAB 都不许进帧（ESC 会改写终端状态、TAB 会让列宽算错）
    tuisq_scan(100, ok, tag);
    if !tuis_screen_has("红" as &const byte) {
        tuis_fail(tag, "ESC 序列被清洗时把正文一起丢了", ok);
    }
    // 快照清空之后总数要退回去（否则「领取后消失」这条不成立）
    tui_queue_set("" as &const byte, 0);
    if tui_queue_total() != 1 {
        tuis_fail(tag, "清空快照之后总数没有退回 1", ok);
    }
}

// ⑤ 超预算：块只画 TUI_QUEUE_MAX_ROWS 行，末行如实收尾「… 还有 N 条」。
fn tuisq_clip(ok: &bool, tag: &const byte) void {
    tui_queue_reset();
    tuisq_push(6, ok, tag);
    if tui_queue_rows() != TUI_QUEUE_MAX_ROWS {
        tuis_fail(tag, "6 条时块高应当是 TUI_QUEUE_MAX_ROWS（再多也画不下）", ok);
    }
    tui_build();
    if !tuis_screen_has("待发 6 条" as &const byte) {
        tuis_fail(tag, "头行的总条数没有如实报 6", ok);
    }
    const head: usize = tuisq_row("待发 6 条" as &const byte);
    if head >= tui_nrows() {
        tuis_fail(tag, "头行没画出来", ok);
        return;
    }
    if head + TUI_QUEUE_MAX_ROWS != tui_panel_top_row() {
        tuis_fail(tag, "块没有正好压在输入框上方（块高与排版算的不一致）", ok);
    }
    // 预算 = 头行 + 2 条 + 收尾 ⇒ 2 条被画、4 条挤进收尾行
    if !tuis_screen_has("排队第1条" as &const byte) {
        tuis_fail(tag, "第一条没画出来", ok);
    }
    if !tuis_screen_has("… 还有 4 条" as &const byte) {
        tuis_fail(tag, "收尾行没有如实说还有几条", ok);
    }
    if tuis_screen_has("排队第3条" as &const byte) {
        tuis_fail(tag, "超出预算的第 3 条还在画（块会比预算高）", ok);
    }
    tuisq_scan(100, ok, tag);
    // 清空 → 行数回到空态基线（「领取/清空之后块消失」的正判据）
    tui_queue_reset();
    tui_build();
    if tui_queue_rows() != 0 || tui_queue_height() != 0 {
        tuis_fail(tag, "清空之后块高没有归零", ok);
    }
    if tuis_screen_has("待发" as &const byte) {
        tuis_fail(tag, "清空之后「待发」块还挂在屏幕上", ok);
    }
}

// ⑥ 运行中（状态区 1 行）+ 浮层：块夹在状态行与转录之间，浮层重画之后三块都还在。
fn tuisq_running(ok: &bool, tag: &const byte) void {
    tuis_reset(100, 30);
    // 必须是**对话态**（转录非空）才走 tui_build_chat —— 空转录走的是 home 屏，
    // 那一屏没有状态区（状态行只在 chat 里钉在面板上方）。
    const seed: &const byte = "先问一句，让屏进对话态" as &const byte;
    betui_add_user(seed, bufx_cstr_len(seed));
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tuisq_push(2, ok, tag);
    tui_build();
    const st: usize = tuisq_row("Bash(make check)" as &const byte);
    // 取**最后一条**（块的最末行）来钉「紧贴状态行」—— 第一条下面还有别的条目
    const it: usize = tuisq_row("排队第2条" as &const byte);
    if st >= tui_nrows() || it >= tui_nrows() {
        tuis_fail(tag, "运行中：状态行或待发条目没画出来", ok);
        return;
    }
    if it + 1 != st {
        tuis_fail(tag, "待发条目没有紧贴状态行上方（层序应为 任务块 → 待发 → 状态）", ok);
    }
    if st + 1 != tui_panel_top_row() {
        tuis_fail(tag, "状态行没有紧贴输入面板上方（P18 的承诺被块挤掉了）", ok);
    }
    // 浮层重画：块与状态行都必须被补回来（tui_build 的浮层那段）
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6,
        "一行\n" as &const byte, bufx_cstr_len("一行\n" as &const byte));
    tui_build();
    if !tuis_screen_has("排队第2条" as &const byte) {
        tuis_fail(tag, "浮层重画之后待发块消失了", ok);
    }
    if !tuis_screen_has("Bash(make check)" as &const byte) {
        tuis_fail(tag, "浮层重画之后状态行消失了", ok);
    }
    tui_overlay_close();
    // 窄屏：状态行 1 行时块最多再要 1 行，放不下就让位（不许把面板顶出屏幕）
    tuis_reset(80, 8);
    betui_add_user(seed, bufx_cstr_len(seed));
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tuisq_push(4, ok, tag);
    tui_build();
    if tui_queue_height() > TUI_QUEUE_MAX_ROWS {
        tuis_fail(tag, "窄屏上块高超过了上限", ok);
    }
    if tui_queue_height() != 1 {
        tuis_fail(tag, "窄屏（80x8）上块没有让位到只剩头行", ok);
    }
    const nst: usize = tuisq_row("Bash(make check)" as &const byte);
    if nst >= tui_nrows() {
        tuis_fail(tag, "窄屏上状态行被挤掉了", ok);
    } else if nst + 1 != tui_panel_top_row() {
        tuis_fail(tag, "窄屏上状态行没有紧贴面板（块让位让错了行）", ok);
    }
    if tui_nrows() != 8 {
        tuis_fail(tag, "窄屏上整帧行数不是画布行数（面板被顶出屏幕）", ok);
    }
    tuisq_scan(80, ok, tag);
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
}

// tui-queue 轮（P105）：待发队列显示在输入框上方。返回 false = 本轮红；不网络。
fn tui_queue_round(tag: &const byte) bool {
    var ok: bool = true;
    const empty_rows: usize = tuisq_empty(&ok, tag);
    tuisq_visible(&ok, tag);
    tuisq_fifo(&ok, tag);
    tuisq_snap(&ok, tag);
    tuisq_clip(&ok, tag);
    tuisq_running(&ok, tag);
    // 收尾：回到 A 段的同一副空态夹具，整帧行数必须与基线一致
    // （空队列零影响的最终判据：块来过又走了，版面一个字节都不留）
    tuis_reset(100, 30);
    tui_build();
    if tui_nrows() != empty_rows {
        tuis_fail(tag, "清空队列之后整帧行数没有回到空态基线", &ok);
    }
    tui_reset_all();
    if ok {
        tuis_ok(tag, "待发队列在输入框上方：空队列 0 行 / 回车可见 / FIFO 不顶掉 / 清洗 / 超预算 / 窄屏让位");
    }
    return ok;
}
