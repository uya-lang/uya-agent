// 子串出现次数（用于断言「去重后只出现一次」）
// 名字带 sel_ 前缀：jsonx.uya 里已经有一个同名同参不同返回值的 count_sub
fn sel_count_sub(rx: &const Buf, lit: &const byte) usize {
    const n: usize = bufx_cstr_len(lit);
    if n == 0 {
        return 0;
    }
    var c: usize = 0;
    var from: usize = 0;
    while from < rx.len {
        const at: isize = find_sub(rx.ptr[0: rx.len], lit[0: n], from);
        if at < 0 {
            break;
        }
        c = c + 1;
        from = (at as usize) + n;
    }
    return c;
}

// 断言助手：第一个失败为准（否则后面的断言会把前面的失败盖掉）
fn expect(rx: &const Buf, lit: &const byte, code: i32, verdict: &i32) void {
    if verdict[0] != 0 {
        return;
    }
    if !contains(rx, lit) {
        verdict[0] = code;
    }
}

// 回收 mock 子进程：**最多等 20 秒**（阻塞式 waitpid 会让「mock 卡住」变成整个自测卡住）
fn wait_child(pid: i32) i32 {
    var st: i32 = 0;
    var waited: usize = 0;
    while waited < 200 {
        const r: i32 = sys_waitpid(pid, &st, 1) catch { 0; };   // WNOHANG
        if r > 0 {
            return (st >> (8 as i32)) & 255;
        }
        var pfds: [PollFd: 1] = [PollFd{ fd: -1, events: 0, revents: 0 }];
        _ = sys_poll(&pfds[0], 1, 100) catch {};
        waited = waited + 1;
    }
    out_err("[selftest] mock server 未在 20s 内退出，强制结束（可能有连接卡住）\n");
    _ = sys_kill(pid as i64, SIGKILL) catch {};
    _ = sys_waitpid(pid, &st, 0) catch {};
    return -1;
}

