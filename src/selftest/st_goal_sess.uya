// src/selftest/st_goal_sess.uya — goal 属于会话（P87）：两条会话各有各的目标
//
// 本文件：goal-sess 轮 —— 目标文件落在**会话目录**里
//   （`<home>/sessions/--<cwd>--/<id>/goal.json`，与 `session.jsonl` 同目录），
//   所以两条会话各有各的目标、互不可见。
// 不变量：① 期望路径由本文件**自己**按 `g_sess.path` 拼（不复用 `goal_path` ——
//   复用等于让断言跟着实现一起错，实现改错时两边一起绿）；
//   ② 每一条断言都必须是「行为可观察」的（乙看不到甲的目标 / 乙能建自己的目标 /
//   甲的目标没被动过），不是「某个函数返回了 true」。
// 依赖：见锚点 selftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：本文件私有小工具统一 `gss_` 前缀，轮次入口 `goal_sess_round`。
//
// 修前的现场（用户报「goal 不是回话级别的」）：目标落在 `<agent_home>/goal.json`，
// 与「会话」完全无关 —— 同一个 home 下所有会话共用一份。甲会话建了目标，乙会话
// 一打开就看到（`armed=true`，甲的目标还会被乙的进程续跑），乙想建自己的目标则被
// 「A goal is already active.」顶回来。web 那种一个 home 下并存 8 条会话的形态最重。

// 读一个**路径已 NUL 结尾**的文件；读不到（不存在是最常见的一种）返回 false。
fn gss_read_z(path_z: &const byte, out: &Buf) bool {
    buf_reset(out);
    return fs_read_file_all(path_z, out, 65536) && out.len > 0;
}

// 由会话日志路径推出**同一个会话目录**下的目标文件路径（本文件自己拼，理由见文件头
// 不变量①）。返回 false = 形状不像会话日志路径。
fn gss_goal_of(sess_path: &const Buf, out: &Buf) bool {
    const tail: usize = 14;              // "/session.jsonl"，逐字节数出来的
    if sess_path.len <= tail {
        return false;
    }
    buf_reset(out);
    const n: usize = sess_path.len - tail;
    return buf_append_span(out, sess_path.ptr as &const byte, 0, n)
        && buf_append_cstr(out, "/goal.json");
}

// 读一个 Buf 形式的路径（内部补一次 NUL，系统调用要的是 C 字符串）。
fn gss_read_path(path: &const Buf, out: &Buf) bool {
    var z: Buf = buf_new(path.len + 1);
    defer { buf_free(&z); }
    if !buf_append(&z, path.ptr, path.len) || !buf_append_byte(&z, 0) {
        return false;
    }
    return gss_read_z(z.ptr as &const byte, out);
}

// 两个路径逐字节相同？（Buf 没有 NUL 结尾，不能用 bufx_eq_cstr 量长度）
fn gss_same(a: &const Buf, b: &const Buf) bool {
    if a.len != b.len {
        return false;
    }
    return bufx_mem_eq(a.ptr as &const byte, b.ptr as &const byte, a.len);
}

// 本会话工作区那个会话目录（`<home>/sessions/--<cwd>--`）。
// 由会话日志路径现推：`…/--<cwd>--/<id>/session.jsonl` 去掉尾名与 id 那一段。
fn gss_sess_root_of(p: &const Buf, out: &Buf) bool {
    const tail: usize = 14;              // "/session.jsonl"，逐字节数出来的
    if p.len <= tail {
        return false;
    }
    var n: usize = p.len - tail;         // 尾名去掉后是 "…/<id>"
    while n > 0 && p.ptr[n - 1] != 47 as byte {
        n = n - 1;
    }
    if n <= 1 {
        return false;
    }
    buf_reset(out);
    return buf_append_span(out, p.ptr as &const byte, 0, n - 1);
}

// 那个会话目录底下有几个 `session-*` 子目录。
//
// 用来钉「恢复一条空会话会不会新造目录」：修前每恢复一次就在 `sessions/` 下多一个空壳
// （现网真机上攒了几十个只有 header 的目录）。判据是**条数**，不是「有没有某个名字」——
// 名字是新生成的，断言不了具体值，而「多了没有」这件事是确定的。
fn gss_count_session_dirs(ok: &bool, tag: &const byte) usize {
    var root: Buf = buf_new(1200);
    defer { buf_free(&root); }
    if !gss_sess_root_of(&g_sess.path, &root) {
        ty_fail(tag, "会话日志路径推不出会话目录（夹具形状不对）", ok);
        return 0;
    }
    var z: Buf = buf_new(root.len + 1);
    defer { buf_free(&z); }
    _ = buf_append(&z, root.ptr, root.len);
    _ = buf_append_byte(&z, 0);
    const dp: &DIR = opendir(&z.ptr[0] as *const byte);
    if dp == null {
        ty_fail(tag, "打不开会话目录（opendir 失败）", ok);
        return 0;
    }
    defer { _ = closedir(dp); }
    var n: usize = 0;
    while true {
        const de: &Dirent = readdir(dp);
        if de == null {
            break;
        }
        if bufx_mem_eq(&de.d_name[0] as &const byte,
                "session-" as &const byte, 8) {
            n = n + 1;
        }
    }
    return n;
}

// A 段：会话甲建目标 → 必须落在**甲的会话目录**里（会话目录即 `session.jsonl` 所在那个），
// 目标文件路径交给调用方（B 段要拿它证明「甲那份没被动过」）。返回 false = 甲的目标建成了、
// 但落点/内容不对（`ok` 已经被置红）。
fn gss_case_a(tag: &const byte, c: &const Config, line: &Buf, out: &Buf,
        goal_a: &Buf, filetxt: &Buf, ok: &bool) bool {
    if !agent_session_create(c) {
        ty_fail(tag, "开不出会话甲（agent_session_create 失败）", ok);
        return false;
    }
    if !gss_goal_of(&g_sess.path, goal_a) {
        ty_fail(tag, "会话甲的日志路径不像会话日志（拿不到会话目录）", ok);
        return false;
    }
    gcr_rc(tag, "会话甲建目标应当成功",
        gcr_run(c, line, out, "/goal 会话甲的目标" as &const byte), 0, ok);
    gcr_has(tag, "会话甲的目标没有建出来", out, "Goal created" as &const byte, ok);
    if !gss_read_path(goal_a, filetxt) {
        ty_fail(tag, "会话甲目录下没有 goal.json（目标没落在会话目录里）", ok);
    } else if !contains(filetxt, "会话甲的目标" as &const byte) {
        ty_fail(tag, "会话甲目录下的 goal.json 里不是甲的目标", ok);
    }
    return true;
}

// B 段：换到会话乙 —— 乙**不许**看到甲的目标（这就是用户报的那件事）、能建自己的目标、
// 且乙建目标不许动甲那一份。返回 false = 会话开不出来（`ok` 已置红）。
fn gss_case_b(tag: &const byte, c: &const Config, line: &Buf, out: &Buf,
        g: &Goal, goal_a: &const Buf, goal_b: &Buf, filetxt: &Buf,
        ok: &bool) bool {
    agent_session_close();
    if !agent_session_create(c) {
        ty_fail(tag, "开不出会话乙", ok);
        return false;
    }
    if !gss_goal_of(&g_sess.path, goal_b) {
        ty_fail(tag, "会话乙的日志路径不像会话日志", ok);
        return false;
    }
    if gss_same(goal_a, goal_b) {
        ty_fail(tag, "两条会话的目标文件是同一个（落点没跟着会话走）", ok);
    }
    // 这一条就是用户报的那件事：乙**不许**看到甲的目标
    if goal_load(c, g) {
        ty_fail(tag, "会话乙看到了会话甲的目标（不同会话不该共享 goal）", ok);
    }
    gcr_rc(tag, "会话乙裸 /goal 应当成功",
        gcr_run(c, line, out, "/goal" as &const byte), 0, ok);
    gcr_has(tag, "会话乙裸 /goal 没有报空态", out,
        "No goal is currently set." as &const byte, ok);
    gcr_no(tag, "会话乙的 /goal 里出现了会话甲的目标", out,
        "会话甲的目标" as &const byte, ok);
    // 修前这里必然红：甲的目标还在，乙被「A goal is already active.」顶回来
    gcr_rc(tag, "会话乙应当能建自己的目标",
        gcr_run(c, line, out, "/goal 会话乙的目标" as &const byte), 0, ok);
    gcr_has(tag, "会话乙的目标没有建出来", out, "Goal created" as &const byte, ok);
    if !gss_read_path(goal_b, filetxt) {
        ty_fail(tag, "会话乙目录下没有 goal.json", ok);
    } else if !contains(filetxt, "会话乙的目标" as &const byte) {
        ty_fail(tag, "会话乙目录下的 goal.json 里不是乙的目标", ok);
    }
    // 乙建目标不许动甲那一份
    if !gss_read_path(goal_a, filetxt) {
        ty_fail(tag, "会话乙建目标之后会话甲的 goal.json 不见了", ok);
    } else if !contains(filetxt, "会话甲的目标" as &const byte) {
        ty_fail(tag, "会话乙建目标把会话甲的目标改掉了", ok);
    }
    _ = goal_cmd_run(c, line, out);      // 收尾：乙的目标清掉
    return true;
}

// C 段：`--no-save` 的会话 —— 目录没人建（`sess_open` 在 `save=false` 时不建目录就返回），
// 目标照样要存得下（落盘前那次 mkdir 就是为它写的）。返回 false = 会话开不出来。
//
// ⚠ 这一段**不动 `c.save_session`**（原来在这里翻成 false 再翻回来）：`c` 是轮内共用的
// 那一份，中途翻它会让后面的段落跑在「不落盘」的配置上（实测：D 段因此永远拿不到目标）。
// 它要的只是「目录没人建也存得下」，而这一点由**目录本来就不存在**决定 —— 不必真把
// 落盘关掉：换一个还没人建过的 home，那条 mkdir 照样是唯一的建目录者。
fn gss_case_c(tag: &const byte, c: &const Config, line: &Buf, out: &Buf,
        filetxt: &Buf, ok: &bool) bool {
    agent_session_close();
    if !agent_session_create(c) {
        ty_fail(tag, "开不出 --no-save 的会话", ok);
        return false;
    }
    var goal_c: Buf = buf_new(1200);
    defer { buf_free(&goal_c); }
    if !gss_goal_of(&g_sess.path, &goal_c) {
        ty_fail(tag, "--no-save 会话的日志路径不像会话日志", ok);
        return false;
    }
    gcr_rc(tag, "--no-save 的会话建目标应当成功",
        gcr_run(c, line, out, "/goal 没有日志也要记得住" as &const byte), 0, ok);
    gcr_has(tag, "--no-save 的会话目标没建出来", out,
        "Goal created" as &const byte, ok);
    if !gss_read_path(&goal_c, filetxt) {
        ty_fail(tag, "--no-save 的会话目标没落到盘上（目录没人建？）", ok);
    } else if !contains(filetxt, "没有日志也要记得住" as &const byte) {
        ty_fail(tag, "--no-save 会话的目标内容不对", ok);
    }
    _ = goal_cmd_run(c, line, out);      // 收尾（清掉刚建的目标）
    agent_session_close();
    return true;
}

// D 段（踩坑 154）：**空日志的恢复不许换会话身份**。
//
// 现场：一条刚开出来、还没说过话的会话（日志只有 header）被 `--resume` 打开时，
// `agent_hist_from_log` 折出 0 条 ⇒ 老实现一律降级成「改为新建会话」⇒ **id 与目录当场换掉**
// ⇒ 落在会话目录里的 `goal.json`（P87：目标属于会话，靠文件位置保证）再也找不到 ——
// 用户报的「恢复会话后目标没了」。每条恢复还会在 `sessions/` 下新造一个空目录。
//
// 三条判据都必须落在**外面看得见**的东西上：目标内容、会话 id/路径、目录条数。
// 只看「`/goal` 有没有报 active」是不够的：新建会话之后立刻建目标同样会让它 active。
fn gss_case_d(tag: &const byte, c: &const Config, line: &Buf, out: &Buf,
        ok: &bool) bool {
    agent_session_close();
    if !agent_session_create(c) {
        ty_fail(tag, "开不出「空会话」那一条", ok);
        return false;
    }
    var id0: Buf = buf_new(128);
    defer { buf_free(&id0); }
    var path0: Buf = buf_new(1200);
    defer { buf_free(&path0); }
    _ = buf_append(&id0, g_sess.id.ptr as &const byte, g_sess.id.len);
    _ = buf_append(&path0, g_sess.path.ptr as &const byte, g_sess.path.len);
    gcr_rc(tag, "空会话里建目标应当成功",
        gcr_run(c, line, out, "/goal 空会话也要记得住" as &const byte), 0, ok);
    // 这一步是关键的夹具：日志里**只有 header**（`/goal` 不写日志）
    if sess_has_events(path0.ptr as &const byte) {
        ty_fail(tag, "夹具不对：这条会话的日志里已经有事件了（空会话没造出来）", ok);
        return false;
    }
    const dirs0: usize = gss_count_session_dirs(ok, tag);
    agent_session_close();

    // 恢复它 —— 走的正是 `--resume` 那条路（agent_session_open + 会话自己的日志路径）
    var h: History = hist_init();
    defer { hist_free(&h); }
    if !agent_session_open(c, &h, &path0) {
        ty_fail(tag, "空会话恢复失败（agent_session_open 返回 false）", ok);
        return false;
    }
    // ⚠ 比的是两个 **Buf**，走 `gss_same`（长度 + 逐字节）—— 不能用 `bufx_eq_cstr`：
    // 它拿第三个参数当 C 串（`bufx_cstr_len`），而 `id0`/`path0` 是 `buf_new` 出来的
    // （cap 大于 len，尾部是 malloc 的脏字节）⇒ 长度恒不相等，这条断言会**假红**
    // （实测：两边打印出来一模一样却报「换了会话 id」）。
    if !gss_same(&g_sess.id, &id0) {
        ty_fail(tag, "空日志的恢复换了会话 id（目标跟着换目录 ⇒ 看不见了）", ok);
    }
    if !gss_same(&g_sess.path, &path0) {
        ty_fail(tag, "空日志的恢复换了会话日志路径", ok);
    }
    if gss_count_session_dirs(ok, tag) != dirs0 {
        ty_fail(tag, "空日志的恢复新造了会话目录（每次恢复都留一个空壳）", ok);
    }
    // 用户报的那件事本身：恢复之后目标还在（同一个会话目录里的那份）
    gcr_rc(tag, "空日志恢复之后裸 /goal 应当成功",
        gcr_run(c, line, out, "/goal" as &const byte), 0, ok);
    gcr_has(tag, "空日志恢复之后目标不见了", out,
        "Objective: 空会话也要记得住" as &const byte, ok);
    agent_session_close();
    return true;
}

// goal-sess 轮：目标按会话隔离。返回 false = 本轮红。
//
// 四段（各自的判据在各自函数的注释里）：① 会话甲建目标 → 落在**甲的会话目录**里；
// ② 换到会话乙 → 看不到甲的目标、能建自己的目标、且甲的没被动过；
// ③ `--no-save` 的会话（目录没人建）也照样存得下；
// ④ 空日志的恢复**不换会话身份**（踩坑 154：目标跟着会话目录走）。
// 本仓行宽/函数长度指标（AGENTS.md）：所以这四段各自成函数，而不是一个长函数。
fn goal_sess_round(tag: &const byte) bool {
    var ok: bool = true;
    const home: &const byte = "build/selftest_goal_sess" as &const byte;
    _ = sess_mkdir_p(home);
    var c: Config = cfg_default();
    defer { cfg_free(&c); }
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, home);
    c.model = buf_from_cstr("selftest-model");
    c.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&c);
    c.save_session = true;

    var out: Buf = buf_new(4096);
    defer { buf_free(&out); }
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    var goal_a: Buf = buf_new(1200);
    defer { buf_free(&goal_a); }
    var goal_b: Buf = buf_new(1200);
    defer { buf_free(&goal_b); }
    var filetxt: Buf = buf_new(4096);
    defer { buf_free(&filetxt); }

    if gss_case_a(tag, &c, &line, &out, &goal_a, &filetxt, &ok) {
        if gss_case_b(tag, &c, &line, &out, &g, &goal_a, &goal_b, &filetxt,
                &ok) {
            if gss_case_c(tag, &c, &line, &out, &filetxt, &ok) {
                _ = gss_case_d(tag, &c, &line, &out, &ok);
            }
        }
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（目标落在会话目录：甲建的不被乙看到、乙能建自己的、");
        out_err("甲那份没被动；--no-save 也存得下；");
        out_err("空日志的恢复不换 id/目录且目标还在）\n");
    }
    return ok;
}
