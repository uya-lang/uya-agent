// 子串出现次数（用于断言「去重后只出现一次」）
// 名字带 sel_ 前缀：jsonx.uya 里已经有一个同名同参不同返回值的 count_sub
fn sel_count_sub(rx: &const Buf, lit: &const byte) usize {
    const n: usize = bufx_cstr_len(lit);
    if n == 0 {
        return 0;
    }
    var c: usize = 0;
    var from: usize = 0;
    while from < rx.len {
        const at: isize = find_sub(rx.ptr[0: rx.len], lit[0: n], from);
        if at < 0 {
            break;
        }
        c = c + 1;
        from = (at as usize) + n;
    }
    return c;
}

// 断言助手：第一个失败为准（否则后面的断言会把前面的失败盖掉）
fn expect(rx: &const Buf, lit: &const byte, code: i32, verdict: &i32) void {
    if verdict[0] != 0 {
        return;
    }
    if !contains(rx, lit) {
        verdict[0] = code;
    }
}

// 回收 mock 子进程：**最多等 20 秒**（阻塞式 waitpid 会让「mock 卡住」变成整个自测卡住）
fn wait_child(pid: i32) i32 {
    var st: i32 = 0;
    var waited: usize = 0;
    while waited < 200 {
        const r: i32 = sys_waitpid(pid, &st, 1) catch { 0; };   // WNOHANG
        if r > 0 {
            return (st >> (8 as i32)) & 255;
        }
        var pfds: [PollFd: 1] = [PollFd{ fd: -1, events: 0, revents: 0 }];
        _ = sys_poll(&pfds[0], 1, 100) catch {};
        waited = waited + 1;
    }
    out_err("[selftest] mock server 未在 20s 内退出，强制结束（可能有连接卡住）\n");
    _ = sys_kill(pid as i64, SIGKILL) catch {};
    _ = sys_waitpid(pid, &st, 0) catch {};
    return -1;
}

// 派生轮：6 个调用（goal 三个 + 子代理三个）
fn mock_deleg_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-deleg");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    mock_call(&w, "dg_1", "create_goal", "{\"objective\":\"把当前目录整理成骨架\",\"max_goal_rounds\":5}");
    jw_byte(&w, 44);
    mock_call(&w, "dg_2", "get_goal", "{}");
    jw_byte(&w, 44);
    mock_call(&w, "dg_3", "update_goal", "{\"goal_id\":\"goal-1\",\"revision\":1,\"action\":\"pause\"}");
    jw_byte(&w, 44);
    mock_call(&w, "dg_4", "subagent", "{\"prompt\":\"SUBAGENT-TASK-MARKER 请回答 6*7\",\"description\":\"compute 6*7\",\"run_in_background\":true}");
    jw_byte(&w, 44);
    mock_call(&w, "dg_5", "subagent_output", "{\"subagent_id\":\"sub-1\",\"wait\":true}");
    jw_byte(&w, 44);
    mock_call(&w, "dg_6", "list_agents", "{}");
    jw_byte(&w, 44);
    mock_call(&w, "dg_7", "subagent_fork", "{\"prompt\":\"SUBAGENT-TASK-MARKER（fork）\",\"description\":\"forked task\",\"run_in_background\":false}");
    jw_byte(&w, 44);
    mock_call(&w, "dg_8", "ralph", "{\"objective\":\"把骨架补齐\",\"maxRounds\":2}");
    jw_byte(&w, 44);
    mock_call(&w, "dg_9", "subagent_output", "{\"subagent_id\":\"sub-3\",\"wait\":true}");
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 44);
    jw_key(&w, "finish_reason");
    jw_str_cstr(&w, "tool_calls");
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// 通用：起一个 mock server、跑一轮 agent_run、比较退出码/mock 判定
fn round_run(base: &const Config, tag: &const byte, ws: &const byte, mode: i32, context_window: i64, task: &const byte) bool {
    return round_run_opts(base, tag, ws, mode, context_window, 4, task);
}

// 与 round_run 相同，但步数上限可调（长历史轮要跑 40 轮工具调用）
fn round_run_opts(base: &const Config, tag: &const byte, ws: &const byte, mode: i32, context_window: i64, max_steps: i32, task: &const byte) bool {
    return round_run_api(base, tag, ws, mode, context_window, max_steps, LLM_STYLE_CHAT, false, task);
}

// 与 round_run_opts 相同，但协议可指定：
//   style      = LLM_STYLE_*（显式声明，等价于 --api=…）
//   negotiable = true 时**故意不声明**（src_api=0），于是首个请求先打 responses，
//                404/405/501 才回退 chat —— 协商轮用它
fn round_run_api(base: &const Config, tag: &const byte, ws: &const byte, mode: i32, context_window: i64, max_steps: i32, style: u8, negotiable: bool, task: &const byte) bool {
    agent_api_reset_negotiation();
    mock_mode = mode;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    if !ws_prepare(ws) {
        out_err("selftest: cannot prepare workspace\n");
        return false;
    }
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var c: Config = cfg_default();
    if negotiable {
        // 故意留 src_api = API_SRC_DEFAULT：未声明 = 先 responses + 一次性协商
        c.api_style = LLM_STYLE_RESPONSES;
    } else {
        cfg_pin_api(&c, style);
    }
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(strlen(task) + 8);
    _ = buf_append_cstr(&c.task, task);
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    // 非流式 responses 轮（mode 20）走一次性响应
    c.stream = !(mode == 20);
    c.max_steps = max_steps;
    c.timeout_ms = 20000;
    c.quiet = true;
    c.context_window = context_window;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    const rc: i32 = agent_run(&c);
    cfg_free(&c);
    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if rc != AGENT_OK {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

