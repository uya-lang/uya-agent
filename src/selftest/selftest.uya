                    verdict = 50;
                }
                var sent9: bool = false;
                if is_stream {
                    sent9 = mock_send_sse(cfd, &sb9);
                } else {
                    sent9 = mock_send(cfd, &sb9);
                }
                if !sent9 {
                    verdict = 51;
                }
                buf_free(&sb9);
            } else {
                if !contains(&rx, "started background job job-1") {
                    verdict = 52;
                }
                if !contains(&rx, "job-2 [bash]") {
                    verdict = 53;   // job_list 必须列出两个任务
                }
                if !contains(&rx, "BG-DONE") {
                    verdict = 54;   // job_output(wait) 拿到增量输出
                }
                if !contains(&rx, "[status: completed") {
                    verdict = 55;
                }
                if !contains(&rx, "requested cancellation of job 2") {
                    verdict = 56;
                }
                if !contains(&rx, "(no output)") || !contains(&rx, "[exit code: 0]") {
                    verdict = 57;
                }
                var body9: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body9, "SELFTEST_JOBS_OK") {
                        verdict = 58;
                    }
                } else if !mock_final_body(&body9, "SELFTEST_FAIL") {
                    verdict = 59;
                }
                var sent9b: bool = false;
                if is_stream {
                    sent9b = mock_send_sse(cfd, &body9);
                } else {
                    sent9b = mock_send(cfd, &body9);
                }
                if !sent9b {
                    verdict = 60;
                }
                buf_free(&body9);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 7 {
            // 文件工具轮：一轮里发 6 个调用，第二轮断言每个结果的文本
            if round == 0 {
                var sb7: Buf = buf_new(4096);
                if !mock_fs_body(&sb7) {
                    verdict = 34;
                }
                var sent7: bool = false;
                if is_stream {
                    sent7 = mock_send_sse(cfd, &sb7);
                } else {
                    sent7 = mock_send(cfd, &sb7);
                }
                if !sent7 {
                    verdict = 35;
                }
                buf_free(&sb7);
            } else {
                if !contains(&rx, "requires reading") {
                    verdict = 36;   // 未读就覆盖 → 被观察策略拦住
                }
                if !contains(&rx, "2: beta two") || !contains(&rx, "3: gamma three") {
                    verdict = 37;   // read 的窗口/行号
                }
                if !contains(&rx, "(Showing lines 2-3 of 5. Use offset=4 to continue.)") {
                    verdict = 38;   // read 的 footer
                }
                if !contains(&rx, "Updated file") {
                    verdict = 39;   // 读后覆盖成功
                }
                if !contains(&rx, "appears 2 times") {
                    verdict = 40;   // edit 要求唯一匹配
                }
                if !contains(&rx, "has been updated successfully.") {
                    verdict = 41;   // edit 成功
                }
                if !contains(&rx, "old_string not found") {
                    verdict = 42;
                }
                // glob：*.txt 应当列出 doc.txt 与 note.txt
                if !contains(&rx, "doc.txt") || !contains(&rx, "note.txt") {
                    verdict = 46;
                }
                // grep：按文件分组 + "Line N: 预览"
                if !contains(&rx, "Line 2: beta two") || !contains(&rx, "Line 4: beta four") {
                    verdict = 47;
                }
                if !contains(&rx, "No matches found") {
                    verdict = 48;
                }
                if !contains(&rx, "No files found") {
                    verdict = 49;
                }
                var body7: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body7, "SELFTEST_FS_OK") {
                        verdict = 43;
                    }
                } else if !mock_final_body(&body7, "SELFTEST_FAIL") {
                    verdict = 44;
                }
                var sent7b: bool = false;
                if is_stream {
                    sent7b = mock_send_sse(cfd, &body7);
                } else {
                    sent7b = mock_send(cfd, &body7);
                }
                if !sent7b {
                    verdict = 45;
                }
                buf_free(&body7);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 30 {
            // P21 只读轮：write 必须被硬拒；bash 在非交互会话里必须 fail closed（不给它跑的机会）
            if round == 0 {
                expect(&rx, "Current uya-agent file policy: read-only." as &const byte, 101, &verdict);
                expect(&rx, "The write and edit tools are refused" as &const byte, 102, &verdict);
                expect(&rx, "needs the user's approval for every command" as &const byte, 103, &verdict);
                var sb30: Buf = buf_new(4096);
                if !mock_perm_body(&sb30) {
                    verdict = 104;
                }
                var sent30: bool = false;
                if is_stream {
                    sent30 = mock_send_sse(cfd, &sb30);
                } else {
                    sent30 = mock_send(cfd, &sb30);
                }
                if !sent30 {
                    verdict = 105;
                }
                buf_free(&sb30);
            } else {
                expect(&rx, "write is refused in read-only mode" as &const byte, 106, &verdict);
                expect(&rx, "no answer channel" as &const byte, 110, &verdict);
                expect(&rx, "1: alpha one" as &const byte, 111, &verdict);   // read 仍然照常工作
                expect_absent(&rx, "PERM-BASH-RAN" as &const byte, 112, &verdict);   // bash 一个字都没跑
                var body30: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body30, "SELFTEST_PERM_OK") {
                        verdict = 113;
                    }
                } else if !mock_final_body(&body30, "SELFTEST_FAIL") {
                    verdict = 114;
                }
                var sent30b: bool = false;
                if is_stream {
                    sent30b = mock_send_sse(cfd, &body30);
                } else {
                    sent30b = mock_send(cfd, &body30);
                }
                if !sent30b {
                    verdict = 260;
                }
                buf_free(&body30);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 31 {
            // P21 沙箱轮：工作区内可写、区外被内核拒绝，命令本身确实跑过（TOOL-MARK 打在 stdout）
            if round == 0 {
                var sb31: Buf = buf_new(4096);
                if !mock_san_body(&sb31) {
                    verdict = 115;
                }
                var sent31: bool = false;
                if is_stream {
                    sent31 = mock_send_sse(cfd, &sb31);
                } else {
                    sent31 = mock_send(cfd, &sb31);
                }
                if !sent31 {
                    verdict = 116;
                }
                buf_free(&sb31);
            } else {
                expect(&rx, "TOOL-MARK" as &const byte, 117, &verdict);       // 命令真的在沙箱里跑过
                expect(&rx, "[exit code: " as &const byte, 118, &verdict);    // 区外那次重定向失败 → 非零退出
                var body31: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body31, "SELFTEST_SAN_OK") {
                        verdict = 119;
                    }
                } else if !mock_final_body(&body31, "SELFTEST_FAIL") {
                    verdict = 83;
                }
                var sent31b: bool = false;
                if is_stream {
                    sent31b = mock_send_sse(cfd, &body31);
                } else {
                    sent31b = mock_send(cfd, &body31);
                }
                if !sent31b {
                    verdict = 84;
                }
                buf_free(&body31);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 26 {
            // P26 plan 闸门轮：plan 模式下 write/edit 硬拒、exit_plan_mode 在管道里无渠道
            if round == 0 {
                expect(&rx, "Plan mode is active" as &const byte, 121, &verdict);
                expect(&rx, "refused until the user approves a plan" as &const byte, 122, &verdict);
                expect(&rx, "\"name\":\"exit_plan_mode\"" as &const byte, 123, &verdict);
                var sb26: Buf = buf_new(4096);
                if !mock_plan_body(&sb26) {
                    verdict = 124;
                }
                var sent26: bool = false;
                if is_stream {
                    sent26 = mock_send_sse(cfd, &sb26);
                } else {
                    sent26 = mock_send(cfd, &sb26);
                }
                if !sent26 {
                    verdict = 130;
                }
                buf_free(&sb26);
            } else {
                expect(&rx, "write is refused in plan mode" as &const byte, 125, &verdict);
                expect(&rx, "edit is refused in plan mode" as &const byte, 126, &verdict);
                expect(&rx, "no user-questions channel is available to review the plan" as &const byte, 127, &verdict);
                expect_absent(&rx, "Created file" as &const byte, 128, &verdict);
                expect_absent(&rx, "has been updated" as &const byte, 129, &verdict);
                var body26: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body26, "SELFTEST_PLAN_GATE_OK") {
                        verdict = 131;
                    }
                } else if !mock_final_body(&body26, "SELFTEST_FAIL") {
                    verdict = 132;
                }
                var sent26b: bool = false;
                if is_stream {
                    sent26b = mock_send_sse(cfd, &body26);
                } else {
                    sent26b = mock_send(cfd, &body26);
                }
                if !sent26b {
                    verdict = 133;
                }
                buf_free(&body26);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 6 {
            // 中断轮：发一帧工具调用后挂 300ms（不发 [DONE]），客户端应被 Ctrl-C 打断
            var sb6: Buf = buf_new(512);
            _ = buf_append_cstr(&sb6, "{\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"working on it\",\"tool_calls\":[{\"id\":\"call_x1\",\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"note.txt\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}");
            if !mock_send_sse_nodone(cfd, &sb6) {
                verdict = 33;
            }
            var req6: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 300000000 };
            var rem6: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
            _ = sys_nanosleep(&req6, &rem6) catch {};
            buf_free(&sb6);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 5 {
            // 一直给工具调用：agent 必须靠 max_steps 自己停下
            var sb: Buf = buf_new(2048);
            if !mock_toolcall_body(&sb, true) {
                verdict = 31;
            }
            var sent5: bool = false;
            if is_stream {
                sent5 = mock_send_sse(cfd, &sb);
            } else {
                sent5 = mock_send(cfd, &sb);
            }
            if !sent5 {
                verdict = 32;
            }
            buf_free(&sb);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if round == 0 {
            // 断言：tools schema 里 run_shell 的有无符合预期
            const has_shell: bool = contains(&rx, "\"name\":\"bash\"");
            if has_shell != mock_expect_shell {
                verdict = 12;
            }
            var body: Buf = buf_new(4096);
            var built: bool = false;
            if mock_mode == 2 {
                built = mock_toolcall_tools_body(&body);
            } else {
                built = mock_toolcall_body(&body, mock_expect_shell);
            }
            if !built {
                buf_free(&body);
                buf_free(&rx);
                _ = sys_close(cfd) catch {};
                return 13;
            }
            var sent_a: bool = false;
            if is_stream {
                sent_a = mock_send_sse(cfd, &body);
            } else {
                sent_a = mock_send(cfd, &body);
            }
            if !sent_a {
                verdict = 14;
            }
            buf_free(&body);
        } else {
            // 断言：第二轮请求里必须带上第一轮的工具执行结果
            if mock_mode != 2 {
                // write 的结果信封：<path>note.txt</path> … Created file
                if !contains(&rx, "Created file") || !contains(&rx, "note.txt") {
                    verdict = 15;
                }
            }
            // P3：运行中用户输入（steer）必须在**下一个 step 的请求**里出现
            if mock_expect_steer && !contains(&rx, "STEER-MARKER") {
                verdict = 29;
            }
            // P2 严格协议断言：assistant 的 tool_calls 原样回灌 + 每个结果都有配对的
            // tool_call_id（折叠协议下这些都不该出现，见 --compat-fold 轮）
            if mock_expect_fold {
                // 折叠协议：必须有折叠头，且不能出现 role:"tool"
                if !contains(&rx, "工具执行结果如下") || contains(&rx, "\"role\":\"tool\"") {
                    verdict = 28;
                }
            } else if is_stream {
                if !contains(&rx, "\"role\":\"assistant\"") || !contains(&rx, "\"tool_calls\"") {
                    verdict = 23;
                }
                if !contains(&rx, "\"role\":\"tool\"") || !contains(&rx, "\"tool_call_id\"") {
                    verdict = 24;
                }
                if !contains(&rx, "\"id\":\"call_") {
                    verdict = 25;   // 调用 id 必须原样出现在历史里
                }
                // 配对数：tools 轮有 4 个调用，其它轮 1 个
                // 每轮 mock 发出的调用数：shell 轮 2 个（write+bash）、
                // no-shell 轮 1 个、tools 轮 4 个、熔断轮沿用 2 个
                var want_ids: i32 = 2;
                if mock_mode == 1 {
                    want_ids = 1;
                } else if mock_mode == 2 {
                    want_ids = 4;
                }
                const got_ids: i32 = count_sub(&rx, "\"tool_call_id\":\"call_");
                if got_ids != want_ids {
                    verdict = 27;
                }
                // 折叠协议标记不该出现
                if contains(&rx, "工具执行结果如下") {
                    verdict = 26;
                }
            }
            if mock_expect_shell && mock_mode != 2 {
                if !contains(&rx, "SELFTEST-SHELL-OK") || !contains(&rx, "[exit code: 0]") {
                    verdict = 19;
                }
            }
            if mock_mode == 2 {
                // 读回的文本在请求里应当只被转义一次：line1\nline2 \"q\" tail
                // （如果字段值忘了反转义，这里会是 line1\\nline2，断言就会失败）
                if !contains(&rx, "2: line2 \\\"q\\\" tail") {
                    verdict = 20;
                }
                if !contains(&rx, "unsafe path") {
                    verdict = 21;
                }
                if !contains(&rx, "[timed out after 300ms]") || !contains(&rx, "[killed by signal: 9]") {
                    verdict = 22;
                }
            }
            var body2: Buf = buf_new(1024);
            if verdict == 0 {
                if !mock_final_body(&body2, "SELFTEST_OK 已写入 note.txt") {
                    buf_free(&body2);
                    buf_free(&rx);
                    _ = sys_close(cfd) catch {};
                    return 16;
                }
            } else {
                if !mock_final_body(&body2, "SELFTEST_FAIL") {
                    buf_free(&body2);
                    buf_free(&rx);
                    _ = sys_close(cfd) catch {};
                    return 17;
                }
            }
            var sent: bool = false;
            if is_stream {
                sent = mock_send_sse(cfd, &body2);       // 流式路径（内部就是 chunked）
            } else if mock_mode == 2 {
                sent = mock_send_chunked(cfd, &body2);   // 非流式 + chunked 解码
            } else {
                sent = mock_send(cfd, &body2);
            }
            if !sent {
                verdict = 18;
            }
            buf_free(&body2);
        }
        buf_free(&rx);
        _ = sys_close(cfd) catch {};
        round = round + 1;
    }
    _ = sys_close(lfd) catch {};
    return verdict;
}

// ============================================================
// selftest 单轮
// ============================================================
fn ws_prepare(ws: &const byte) bool {
    _ = sys_mkdir(ws as *const byte, 493 as u32) catch {};
    var f: Buf = buf_new(strlen(ws) + 32);
    defer { buf_free(&f); }
    if !buf_valid(&f) {
        return false;
    }
    _ = buf_append_cstr(&f, ws);
    // 必须补 NUL（§16 坑 2）：否则 unlink 拿到的是缓冲区后面的垃圾路径，
    // 清理静默失败 —— 第二轮就会撞上「write 需要先 read」的观察策略。
    _ = buf_append_cstr_z(&f, "/note.txt");
    _ = sys_unlink(&f.ptr[0] as *const byte) catch {};
    return true;
}

// path 的**前 512 字节**是否恰好等于 expect（多余字节也算不等）。
// 只读一次、不重试；false = 打不开 / 读失败 / 内容不等。
fn file_equals(path: &const byte, expect: &const byte) bool {
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var buf: [byte: 512] = [0: 512];
    const n: isize = sys_read(fd, &buf[0], 512) catch { 0 as isize; };
    if n < 0 {
        return false;
    }
    const got: usize = n as usize;
    const want: usize = strlen(expect);
    if got != want {
        return false;
    }
    var i: usize = 0;
    while i < want {
        if buf[i] != expect[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 逐字节比较「文件」与「一段内存」。
// file_equals 只读 512 字节，装不下大参数轮那 9 KiB 的正文，所以另开一个。
fn file_bytes_eq(path: &const byte, want: &const byte, want_len: usize) bool {
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var got: Buf = buf_new(want_len + 64);
    defer { buf_free(&got); }
    if !buf_valid(&got) {
        return false;
    }
    var chunk: [byte: 4096] = [0: 4096];
    while true {
        const n: isize = sys_read(fd, &chunk[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        if !buf_append(&got, &chunk[0], n as usize) {
            return false;
        }
        if got.len > want_len {
            return false;   // 比期望长：不用读完就知道不等
        }
    }
    if got.len != want_len {
        return false;
    }
    return bufx_mem_eq(got.ptr as &const byte, want, want_len);
}

// ============================================================
// P19：诊断出口 —— 外来字节不许以原文进转录
//
// 缘起：网关错误体是**外来字节**：可能是回显请求体的 JSON（里面就有 tools 数组和
// `\n` 转义）、可能带 NUL/ESC、也可能正好在多字节字符中间被按字节截断
// （`llm_err_head` 收 240B、`dump_*_error` 收 4096B）。原样打给 fd 2 时 TUI 会把每一行
// 渲染成带 `· ` 前缀的 NOTICE 行 —— 屏幕上就是「半个汉字 + 一屏 JSON」。
// 这一轮钉住四件事：转义、字符边界截断、预览有界、全文另有去处（会话日志/落盘）。
// ============================================================

// 数 p[0:n] 里等于 c 的字节个数（诊断断言用；不做任何转义解释）。
fn diag_count_byte(p: &const byte, n: usize, c: byte) usize {
    var i: usize = 0;
    var k: usize = 0;
    while i < n {
        if p[i] == c {
            k = k + 1;
        }
        i = i + 1;
    }
    return k;
}

// 除结尾那个换行外，不许有控制字节（NUL / ESC / CR / TAB 都算）
fn diag_count_ctrl(p: &const byte, n: usize) usize {
    var i: usize = 0;
    var k: usize = 0;
    while i < n {
        const c: byte = p[i];
        const tail_nl: bool = i + 1 == n && c == 10 as byte;
        if (c < 0x20 as byte || c == 0x7f as byte) && !tail_nl {
            k = k + 1;
        }
        i = i + 1;
    }
    return k;
}

// 填 n 个「中」（3 字节 / 字），用来测「按字节截断会不会切半个字」
fn diag_fill_cjk(out: &Buf, chars: usize) void {
    const cjk: [byte: 3] = [228, 184, 173];
    buf_reset(out);
    var i: usize = 0;
    while i < chars {
        _ = buf_append(out, &cjk[0], 3);
        i = i + 1;
    }
}

// 把 path 全文读进 out（先 buf_reset，读失败返回 false 但 out 已经是空的）。
// 起手就用 O_RDONLY 打开、循环读到 EOF；out 由调用方 free。
fn diag_read_file(path: &const byte, out: &Buf) bool {
    buf_reset(out);
    const fd: i32 = sys_open(path as *const byte, 0 as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var tmp: [byte: 4096] = [0: 4096];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        if !buf_append(out, &tmp[0], n as usize) {
            return false;
        }
    }
    return true;
}

// 纯函数轮：转义规则 + 字符边界 + 预览形态
fn diag_round(tag: &const byte) bool {
    var ok: bool = true;
    var src: Buf = buf_new(4096);
    defer { buf_free(&src); }
    var out: Buf = buf_new(8192);
    defer { buf_free(&out); }

    // ---- A) cap 落在多字节字符中间：必须在字符边界上停 ----
    diag_fill_cjk(&src, 200);                       // 600 字节
    buf_reset(&out);
    const used: usize = tty_diag_escape_into(&out, src.ptr as &const byte, src.len, 320);
    if used != 318 {
        // 320 = 3*106 + 2：只能吃下 106 个整字（318 字节）
        ty_fail(tag, "cap 没有停在字符边界上（应吃 318 字节）", &ok);
    }
    if out.len != used {
        ty_fail(tag, "合法 UTF-8 应当原样透传", &ok);
    }
    if !bufx_utf8_valid(out.ptr as &const byte, out.len) {
        ty_fail(tag, "截断后的预览不是合法 UTF-8（半个汉字会直接上屏）", &ok);
    }

    // ---- B) 半截序列 / 孤立续字节 → 逐字节 \xNN ----
    var half: [byte: 3] = [229, 143, 65];           // 「中」的前两字节 + 'A'
    buf_reset(&out);
    _ = tty_diag_escape_into(&out, &half[0], 3, 64);
    if !bufx_eq_cstr(out.ptr as &const byte, out.len, "\\xe5\\x8fA") {
        ty_fail(tag, "半截序列没有转义成 \\xNN", &ok);
    }
    var lone: [byte: 2] = [143, 65];                // 孤立续字节
    buf_reset(&out);
    _ = tty_diag_escape_into(&out, &lone[0], 2, 64);
    if !bufx_eq_cstr(out.ptr as &const byte, out.len, "\\x8fA") {
        ty_fail(tag, "孤立续字节漏过去了（终端会渲染成半个字）", &ok);
    }

    // ---- C) 控制字节 / 换行的转义（NUL、ESC、CR 走 \xNN；TAB 与换行走短转义）----
    var ctl: [byte: 10] = [97, 0, 98, 27, 91, 50, 74, 99, 13, 10];
    buf_reset(&out);
    _ = tty_diag_escape_into(&out, &ctl[0], 10, 64);
    if !bufx_eq_cstr(out.ptr as &const byte, out.len, "a\\x00b\\x1b[2Jc\\x0d\\n") {
        ty_fail(tag, "控制字节转义不对", &ok);
    }
    var tab: [byte: 3] = [9, 65, 10];
    buf_reset(&out);
    _ = tty_diag_escape_into(&out, &tab[0], 3, 64);
    if !bufx_eq_cstr(out.ptr as &const byte, out.len, "\\tA\\n") {
        ty_fail(tag, "TAB / 换行的短转义不对", &ok);
    }

    // ---- D) 合法 U+FFFD 原样留着（别把合法字符也当坏字节）----
    var repl: [byte: 3] = [239, 191, 189];
    buf_reset(&out);
    _ = tty_diag_escape_into(&out, &repl[0], 3, 64);
    if out.len != 3 || !bufx_mem_eq(out.ptr as &const byte, &repl[0], 3) {
        ty_fail(tag, "合法 U+FFFD 被当成坏字节转义了", &ok);
    }

    // ---- E) out_diag：一行预览 + 截断后缀；--debug-dump 落原始字节 ----
    var cap_path: [byte: 64] = "build/selftest_diag_stderr.txt";
    var dump_path: [byte: 64] = "build/selftest_diag_dump.bin";
    const dump_p: &const byte = &dump_path[0] as &const byte;
    agent_set_debug_dump(dump_p, bufx_cstr_len(dump_p));
    var payload: Buf = buf_new(4096);
    defer { buf_free(&payload); }
    buf_reset(&payload);
    _ = buf_append_cstr(&payload, "relay-said:\n");
    diag_fill_cjk(&payload, 200);
    var cap: Buf = buf_new(8192);
    defer { buf_free(&cap); }
    var cfd: i32 = -1;
    const saved: i32 = vw_cap_on(&cap_path[0] as &const byte, &cfd);
    out_diag("unit-kind", "body: ", payload.ptr as &const byte, payload.len);
    vw_cap_off(&cap_path[0] as &const byte, saved, cfd, &cap);
    agent_set_debug_dump("" as &const byte, 0);
    if diag_count_byte(cap.ptr as &const byte, cap.len, 10) != 1 {
        ty_fail(tag, "out_diag 的预览不是一行（换行没转义 → 转录里会铺成一大块）", &ok);
    }
    if diag_count_ctrl(cap.ptr as &const byte, cap.len) != 0 {
        ty_fail(tag, "out_diag 的预览里有裸控制字节", &ok);
    }
    if !contains(&cap, "bytes total") {
        ty_fail(tag, "out_diag 超长时没有截断后缀", &ok);
    }
    if cap.len > 512 {
        ty_fail(tag, "out_diag 预览太长（>512B）", &ok);
    }
    var raw: Buf = buf_new(8192);
    defer { buf_free(&raw); }
    if !diag_read_file(dump_p, &raw) || raw.len == 0 {
        ty_fail(tag, "--debug-dump 没有落盘", &ok);
    } else {
        const view: &[byte] = raw.ptr[0: raw.len];
        if find_sub(view, payload.ptr[0: payload.len], 0) < 0 {
            ty_fail(tag, "--debug-dump 里没有完整原始字节", &ok);
        }
    }
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// 除换行外的控制字节个数（NUL / CR / ESC / TAB 都算）——诊断预览里一个都不许有
fn diag_count_ctrl_nonl(p: &const byte, n: usize) usize {
    var i: usize = 0;
    var k: usize = 0;
    while i < n {
        const c: byte = p[i];
        if (c < 0x20 as byte || c == 0x7f as byte) && c != 10 as byte {
            k = k + 1;
        }
        i = i + 1;
    }
    return k;
}

// 转录侧断言（mode 24）：回显进来的外来字节只许以**转义后的有界预览**出现
fn diag_capture_check(tag: &const byte, cap: &const Buf, ok: &bool) bool {
    var good: bool = true;
    const view: &const byte = cap.ptr as &const byte;
    if cap.len == 0 {
        ty_fail(tag, "fd 2 上一个字节都没有（诊断根本没打出来）", ok);
        return false;
    }
    if !contains(cap, "model endpoint returned HTTP 400") {
        ty_fail(tag, "没有打出 HTTP 400 诊断", ok);
        good = false;
    }
    // 回显体里带请求头的 CRLF：必须被转义成 \x0d\x0a（原来会原样进终端/转录）
    if !contains(cap, "\\x0d") {
        ty_fail(tag, "回显体里的 CR 没有转义（预览不是终端安全的一行）", ok);
        good = false;
    }
    if diag_count_ctrl_nonl(view, cap.len) != 0 {
        ty_fail(tag, "诊断里有裸控制字节（NUL/CR/ESC 会直接进终端）", ok);
        good = false;
    }
    if diag_count_byte(view, cap.len, 10) > 6 {
        ty_fail(tag, "诊断铺成了很多行（外来字节没被限长/转义成一整行）", ok);
        good = false;
    }
    if cap.len > 1024 {
        ty_fail(tag, "诊断输出太长（>1 KiB）", ok);
        good = false;
    }
    // --debug-dump：原始字节必须完整落盘（这才是「原文另有去处」）
    var raw: Buf = buf_new(16384);
    defer { buf_free(&raw); }
    if !diag_read_file("build/selftest_diag_dump.bin" as &const byte, &raw) || raw.len == 0 {
        ty_fail(tag, "--debug-dump 没有落盘", ok);
        good = false;
    } else if !contains(&raw, "POST /v1/chat/completions") {
        ty_fail(tag, "--debug-dump 里没有完整原文（原始字节该留着）", ok);
        good = false;
    }
    return good;
}

// 会话日志侧断言：转义后的完整原文落在 diag/dump 事件里；日志里没有裸控制字节
fn diag_log_check(tag: &const byte, home: &const byte, ws: &const byte, ok: &bool) bool {
    var path: Buf = buf_new(1200);
    defer { buf_free(&path); }
    if !sess_find_last(home, ws, &path) {
        ty_fail(tag, "找不到刚跑完的会话（会话日志没落盘？）", ok);
        return false;
    }
    if !buf_append_byte(&path, 0) {
        ty_fail(tag, "路径缓冲不够补 NUL", ok);
        return false;
    }
    path.len = path.len - 1;
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path.ptr as &const byte, &r) {
        ty_fail(tag, "会话日志读不出来", ok);
        return false;
    }
    var line: Buf = buf_new(65536);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var txt: Buf = buf_new(65536);
    defer { buf_free(&txt); }
    var kind: Buf = buf_new(64);
    defer { buf_free(&kind); }
    var seen: usize = 0;
    var has_esc: bool = false;
    var has_raw: bool = false;
    var has_ctrl: bool = false;
    while sess_next(&r, &line) {
        buf_reset(&typ);
        if !sess_line_type(&line, &typ) {
            continue;
        }
        if !sv_eq_cstr(&typ, "diag/dump") {
            continue;
        }
        seen = seen + 1;
        buf_reset(&kind);
        _ = sess_json_str(line.ptr[0: line.len], "kind", &kind);
        buf_reset(&txt);
        if sess_json_str(line.ptr[0: line.len], "text", &txt) {
            const tv: &const byte = txt.ptr as &const byte;
            if contains(&txt, "\\x0d") {
                has_esc = true;
            }
            if contains(&txt, "POST /v1/chat/completions") {
                has_raw = true;
            }
            if diag_count_ctrl_nonl(tv, txt.len) != 0 {
                has_ctrl = true;
            }
        }
    }
    if seen == 0 {
        ty_fail(tag, "会话日志里没有 diag/dump 事件（完整原文丢了）", ok);
        return false;
    }
    if !has_esc {
        ty_fail(tag, "diag/dump 的文本里没有转义痕迹（该是转义后的一行）", ok);
        return false;
    }
    if !has_raw {
        ty_fail(tag, "diag/dump 里没有完整原文（截断到转录那份了就丢信息）", ok);
        return false;
    }
    if has_ctrl {
        ty_fail(tag, "diag/dump 的文本里还有裸控制字节（会话日志会被写坏）", ok);
        return false;
    }
    return true;
}

// P54：**退化响应轮**（mode 41 = 重发成功 / 42 = 重发也只给空响应）的两侧证据验收。
//
// 为什么要两侧都查：
//   ① 转录（fd 2 抓下来的）：空回复分支必须**当场**把判据打出来 —— 用户的原话就是
//      「空回复分支要把证据打出来：finish / have_finish / bad_finish、reasoning 字节数、
//      usage、本次 prompt 大小」。只查日志的话，「屏幕上什么都不说」这条会漏过去。
//   ② 会话日志：`llm/degenerate` 事件（真机事后复盘看的是它）——以前这里只有一条
//      content="" 的 assistant/message，分不清「上游说 stop」还是「tool_calls 丢了」。
//
// 另外钉三条语义（都是承重的）：
//   * 退化那一步**不写 assistant/message**（mode 42 里一条都没有；41 里只有重发成功那一条
//     且正文就是 mock 的标记）—— 否则「退化」与「模型真回了空串」在日志里长得一样；
//   * 重发**不推进 step**（step/start 只有一条）—— 对齐 DSH：重发发生在同一步里；
//   * 只重发一次（42 里两条事件：第一条 retrying=true/retries=0，第二条 retrying=false/retries=1）。
fn empty_retry_check(tag: &const byte, cap: &const Buf, home: &const byte, ws: &const byte, mode: i32, ok: &bool) bool {
    var pass: bool = true;
    // ① 转录：重发提示 + 证据字段（字段名与顺序固定，grep 得到）
    if !contains(cap, "[retry] empty response from upstream (no content, no tool_calls)") {
        ty_fail(tag, "转录里没有 [retry] 那一行（退化响应没当场说清，也没说要不要重发）", &pass);
    }
    if !contains(cap, "finish=stop have_finish=1 bad_finish=(none) content=0B reasoning=") {
        ty_fail(tag, "转录的证据里缺 finish/have_finish/bad_finish/content/reasoning", &pass);
    }
    if !contains(cap, "calls=0 usage={in=60 cache_read=40 cache_write=0 out=7 reasoning=3} prompt=") {
        ty_fail(tag, "转录的证据里缺 usage（或与 mock 报的数对不上）", &pass);
    }
    if !contains(cap, "tok retries=0/1]") {
        ty_fail(tag, "转录的证据里缺「本次 prompt 体量 + 重发额度」那一段", &pass);
    }
    if mode == 42 {
        // 第二腿：额度用尽 —— 转录里必须留下同一条证据的**错误**形状（而不是再来一次）
        if !contains(cap, "error: model returned neither content nor tool_calls [step=1 finish=stop") {
            ty_fail(tag, "重发也空之后，转录里没有带证据的错误行", &pass);
        }
        if !contains(cap, "tok retries=1/1]") {
            ty_fail(tag, "重发也空之后，证据里的 retries 不是 1/1", &pass);
        }
    }
    // ② 会话日志
    var path: Buf = buf_new(1200);
    defer { buf_free(&path); }
    if !sess_find_last(home, ws, &path) {
        ty_fail(tag, "找不到刚跑完的会话（会话日志没落盘？）", &pass);
        return false;
    }
    // sess_reader_load 把路径当 C 串（§16 坑 2）：Buf 不带 NUL，自己补一个
    if !buf_append_byte(&path, 0) {
        ty_fail(tag, "路径缓冲不够补 NUL", &pass);
        return false;
    }
    path.len = path.len - 1;
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path.ptr as &const byte, &r) {
        ty_fail(tag, "会话日志读不出来", &pass);
        return false;
    }
    var line: Buf = buf_new(65536);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var txt: Buf = buf_new(256);
    defer { buf_free(&txt); }
    var degen: i32 = 0;
    var degen_bad: i32 = 0;
    var steps: i32 = 0;
    var asst: i32 = 0;
    var asst_ok: bool = false;
    var last_retrying: bool = false;
    var last_retries: i64 = -1;
    while sess_next(&r, &line) {
        buf_reset(&typ);
        if !sess_line_type(&line, &typ) {
            continue;
        }
        const view: &[byte] = line.ptr[0: line.len];
        if sv_eq_cstr(&typ, "step/start") {
            steps = steps + 1;
            continue;
        }
        if sv_eq_cstr(&typ, "assistant/message") {
            asst = asst + 1;
            buf_reset(&txt);
            if sess_json_str(view, "content", &txt)
                && bufx_eq_cstr(txt.ptr as &const byte, txt.len, "SELFTEST-RETRY-OK" as &const byte) {
                asst_ok = true;
            }
            continue;
        }
        if !sv_eq_cstr(&typ, "llm/degenerate") {
            continue;
        }
        degen = degen + 1;
        last_retries = sess_json_i64(view, "retries");
        last_retrying = contains(&line, "\"retrying\":true");
        // 证据字段一个都不能少（缺字段时 sess_json_i64 给 -1、sess_json_str 给 false）
        if sess_json_i64(view, "step") != 1
            || sess_json_i64(view, "maxRetries") != 1
            || sess_json_i64(view, "finishCode") != 1          // 1 = LLM_FINISH_STOP
            || sess_json_i64(view, "contentBytes") != 0
            || sess_json_i64(view, "reasoningBytes") != (bufx_cstr_len(MOCK_DEGEN_THINK) as i64)
            || sess_json_i64(view, "calls") != 0
            || sess_json_i64(view, "promptBytes") <= 0
            || sess_json_i64(view, "promptTokens") != 100      // 60 非缓存 + 40 缓存命中
            || sess_json_i64(view, "events") <= 0
            || sess_json_i64(view, "in") != 60
            || sess_json_i64(view, "cacheRead") != 40
            || sess_json_i64(view, "cacheWrite") != 0
            || sess_json_i64(view, "out") != 7
            || sess_json_i64(view, "reasoning") != 3
            || !contains(&line, "\"finish\":\"stop\"")
            || !contains(&line, "\"haveFinish\":true")
            || !contains(&line, "\"badFinish\":\"\"")
            || !contains(&line, "\"sawDone\":true") {
            degen_bad = degen_bad + 1;
        }
    }
    const want_degen: i32 = if mode == 42 { 2 } else { 1 };
    if degen != want_degen {
        ty_fail(tag, "会话日志里的 llm/degenerate 事件条数不对（重发没发生或发生了不止一次）", &pass);
    }
    if degen_bad != 0 {
        ty_fail(tag, "llm/degenerate 的证据字段不全（finish/reasoning 字节数/usage/prompt 体量）", &pass);
    }
    // 重发不算新的一步：两条腿都只有一个 step/start
    if steps != 1 {
        ty_fail(tag, "step/start 不是 1 条（重发必须发生在**同一步**里）", &pass);
    }
    if mode == 42 {
        if asst != 0 {
            ty_fail(tag, "退化那一步写了 assistant/message（空回复不该在日志里装成一条消息）", &pass);
        }
        if last_retrying || last_retries != 1 {
            ty_fail(tag, "最后一次 llm/degenerate 没有落成「不再重发」（retrying=false/retries=1）", &pass);
        }
    } else {
        if asst != 1 || !asst_ok {
            ty_fail(tag, "重发成功那一步的 assistant/message 不对（期望恰好一条、正文是 SELFTEST-RETRY-OK）", &pass);
        }
        if !last_retrying || last_retries != 0 {
            ty_fail(tag, "llm/degenerate 没有落成「正在重发」（retrying=true/retries=0）", &pass);
        }
    }
    return pass;
}

// **端到端单轮驱动**：设好 mock 开关 → 准备假 DSH_HOME/工作区 → fork 出 mock 子进程 →
// 在父进程里跑完整 agent 循环（build_request → http → 工具执行 → 回灌 → 下一轮），
// 再按 mode 断言转录、退出码与写出的文件。mode 见文件头的「自测轮次模式」表；
// stream=false 走非流式出口，fold/steer/interrupt 分别打开对应断言。返回 false = 本轮红（也用于 fork 失败）。
fn selftest_round(base: &const Config, tag: &const byte, mode: i32, allow_shell: bool, ws: &const byte, stream: bool, fold: bool, steer: bool, interrupt: bool) bool {
    mock_mode = mode;
    mock_expect_shell = allow_shell;
    mock_expect_fold = fold;
    mock_expect_steer = steer;
    if !ws_prepare(ws) {
        out_err("selftest: cannot prepare workspace\n");
        return false;
    }
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        out_err("selftest: socket() failed\n");
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: bind() failed\n");
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: listen() failed\n");
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: getsockname() failed\n");
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);

    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: fork() failed\n");
        return false;
    };
    if pid64 == 0 {
        const rc: i32 = mock_server(lfd);
        sys_exit(rc);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    // 父进程：跑真实 agent 循环
    var c: Config = cfg_default();
    cfg_pin_api(&c, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(128);
    if mode == 2 {
        _ = buf_append_cstr(&c.task, "写文件、读文件、越权路径、超时命令");
    } else {
        _ = buf_append_cstr(&c.task, "把 hello-selftest 写进 note.txt");
    }
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = allow_shell;
    c.stream = stream;
    // 自测默认关沙箱：这些轮次测的不是沙箱，别让「机器上有没有 bwrap」影响结果
    // （沙箱轮自己把 c.sandbox 设回 SAN_AUTO）
    c.sandbox = SAN_OFF;
    // tools 轮要验证路径守卫：不是全权（danger-full-access）才开守卫
    if mode == 2 {
        c.access = PERM_WORKSPACE_WRITE;
    }
    c.compat_fold = fold;
    if mode == 5 {
        c.max_steps = 3;      // 熔断轮：mock 每轮都给 tool_calls，agent 必须在 3 步停下
    } else if mode == 17 {
        // 不限步数轮：**故意不设** max_steps —— 吃的就是 cfg_default() 的默认值（0 = 不限）。
        // 默认值一旦被人改回 12，这轮会因为在第 12 步熔断而失败（mock 只服务了 12 次）。
    } else {
        c.max_steps = 4;
    }
    c.timeout_ms = 15000;
    c.quiet = true;
    // 会话落到 build/ 下，别污染 ~/.uya-agent
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    // P3：预置「运行中用户输入」（steer）与「预置 Ctrl-C 按键」
    inbox_globals_init();
    if steer {
        _ = inbox_push(&g_steer, "STEER-MARKER 追加要求", strlen("STEER-MARKER 追加要求"));
    }
    g_interactive = interrupt;
    if interrupt {
        // 把 Ctrl-C 预先塞进行编辑器的按键队列：第一次 pump 就会取到它
        tty_init(&tty_ui, 0);
        var ctrl_c: [byte: 1] = [3: 1];
        tty_feed(&tty_ui, &ctrl_c[0], 1);
    }
    // 诊断轮（24）：把 fd 2 抓进文件，跑完逐字节断言「到底往转录里打了什么」
    // P54：退化响应轮（41/42）同样要抓 —— 「空回复分支要把证据打出来」这件事只有抓下来
    // 逐字看才算验过（真机上日志里只剩一条 content="" 正是用户报的那个现场）。
    var cap_text: Buf = buf_new(16384);
    var cfd: i32 = -1;
    var cap_saved: i32 = -1;
    if mode == 24 {
        var cap_path: [byte: 64] = "build/selftest_diag_stderr.txt";
        cap_saved = vw_cap_on(&cap_path[0] as &const byte, &cfd);
        agent_set_debug_dump("build/selftest_diag_dump.bin" as &const byte,
            bufx_cstr_len("build/selftest_diag_dump.bin" as &const byte));
    } else if mode == 41 || mode == 42 {
        var cap_path: [byte: 64] = "build/selftest_diag_stderr.txt";
        cap_saved = vw_cap_on(&cap_path[0] as &const byte, &cfd);
    }
    const rc: i32 = agent_run(&c);
    if mode == 24 || mode == 41 || mode == 42 {
        var cap_path: [byte: 64] = "build/selftest_diag_stderr.txt";
        vw_cap_off(&cap_path[0] as &const byte, cap_saved, cfd, &cap_text);
        agent_set_debug_dump("" as &const byte, 0);
    }
    g_interactive = false;
    inbox_globals_free();
    cfg_free(&c);

    const mock_rc: i32 = wait_child(pid);

    var file_path: Buf = buf_new(strlen(ws) + 32);
    defer { buf_free(&file_path); }
    _ = buf_append_cstr(&file_path, ws);
    _ = buf_append_cstr_z(&file_path, "/note.txt");
    file_path.len = file_path.len - 1;

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if mock_mode == 2 && rc == AGENT_OK && mock_rc == 0 {
        // mode 2 还要逐字节校验写出来的文件内容（换行/引号必须是真的）
        var esc_path: Buf = buf_new(strlen(ws) + 32);
        _ = buf_append_cstr(&esc_path, ws);
        _ = buf_append_cstr_z(&esc_path, "/esc.txt");
        const want: &const byte = esc_content();
        if !file_equals(&esc_path.ptr[0] as &const byte, want) {
            out_err("[esc.txt 内容不符] ");
            ok = false;
        }
        buf_free(&esc_path);
    }
    if mode == 25 && rc == AGENT_OK && mock_rc == 0 {
        // 踩坑 35：9 KiB 的正文必须**整段**落到文件里 —— 序列化、入史、回灌、派发这条路上
        // 少一个字节（或者整轮被打成 OOM），这里都会红。
        var want_big: Buf = buf_new(16384);
        defer { buf_free(&want_big); }
        if !cap_test_body(&want_big) {
            out_err("[大参数正文构造失败] ");
            ok = false;
        } else if !file_bytes_eq(&file_path.ptr[0] as &const byte, want_big.ptr as &const byte, want_big.len) {
            out_err("[note.txt 与 9 KiB 正文不一致（期望 ");
            out_err_dec(want_big.len);
            out_err(" 字节）] ");
            ok = false;
        }
    }
    if mode == 24 {
        // 诊断轮：转录（fd 2）里只许有**一行转义预览**，不许出现回显进来的请求体
        if !diag_capture_check(tag, &cap_text, &ok) {
            ok = false;
        }
        if !diag_log_check(tag, "build/selftest_agent_home" as &const byte, ws, &ok) {
            ok = false;
        }
    }
    if mode == 41 || mode == 42 {
        // P54：退化响应轮 —— 转录里的证据 + 会话日志里的 llm/degenerate 事件，两边都要查
        if !empty_retry_check(tag, &cap_text, "build/selftest_agent_home" as &const byte, ws, mode, &ok) {
            ok = false;
        }
    }
    var expect_rc: i32 = AGENT_OK;
    if mode == 3 || mode == 5 || mode == 24 || mode == 42 {
        // 42：重发也只给空响应 —— 回合按协议错误收口（重试只发生一次，第二次就地放弃）
        expect_rc = AGENT_PROTO;
    }
    if interrupt {
        expect_rc = AGENT_INTERRUPTED;
    }
    if rc != expect_rc {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        out_err(" (expected ");
        out_err_dec(expect_rc as usize);
        out_err(")");
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else if mode == 0 || mode == 1 {
        if !file_equals(&file_path.ptr[0] as &const byte, "hello-selftest") {
            out_err("FAIL: note.txt content mismatch");
            ok = false;
        } else {
            out_err("ok");
        }
    } else if !ok {
        out_err("FAIL");
    } else {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

// ============================================================
// P1 流式解析自测
//
// mock 端发 text/event-stream + chunked，并且**按 19 字节切片、每片间隔 2ms** 写出，
// 保证客户端读到的是半截帧（chunk 长度行、data 行、JSON 字符串都可能被切开），
// 从而真正验证 httpstream 的增量解码 + sse 的分帧 + llm 的分片累积。
// 客户端直接调 llm_stream_chat（不经过 agent_run），逐字段断言 ChatOut。
// ============================================================
const SSE_CASE_BASIC: i32 = 0;
const SSE_CASE_TOOLS: i32 = 1;
const SSE_CASE_NODONE: i32 = 2;
const SSE_CASE_BADJSON: i32 = 3;
const SSE_CASE_REASONING_LENGTH: i32 = 4;
// P24：首 token 打点的三条边界（见 llm_note_first_token）
const SSE_CASE_REASONING_ONLY: i32 = 5;   // 只有思考 delta → 必须打点（旧口径不打 → tok/s 永远空）
const SSE_CASE_CALLONLY: i32 = 6;         // 只有工具参数 → 必须打点
const SSE_CASE_NODELTA: i32 = 7;          // 空串 delta + usage-only → 不许打点

// 写出的切片大小与间隔：小到必然把 SSE 帧切碎
const SSE_SLICE: usize = 19;
const SSE_GAP_NS: i64 = 2000000;

var sse_case: i32 = 0;

// p[0:n] 与 C 字面量 lit 逐字节相等（长度先按 bufx_cstr_len 比）。
// SSE 断言的基本单元 —— 比的是解析出来的字节，不是「看起来对」。
fn sse_eq(p: &const byte, n: usize, lit: &const byte) bool {
    return bufx_cstr_len(lit) == n && bufx_mem_eq(p, lit, n);
}

// Buf b 与 C 字面量 lit 逐字节相等（sse_eq 的 Buf 版）。
fn sse_buf_eq(b: &const Buf, lit: &const byte) bool {
    return sse_eq(b.ptr as &const byte, b.len, lit);
}

// 返回同一个响应体时，两段 chunk 之间的间隔（P21：见 mock_send_sse）
const MOCK_SSE_GAP_NS: i64 = 10000000;

// 把 writer 写好的 payload 当作一帧 data 追加到 out
fn sse_emit(out: &Buf, w: &const JsonWriter, payload: &Buf) bool {
    if jw_overflow(w) {
        return false;
    }
    payload.len = jw_used(w);
    if !buf_append_cstr(out, "data: ") {
        return false;
    }
    if !buf_append(out, payload.ptr, payload.len) {
        return false;
    }
    return buf_append_cstr(out, "\n\n");
}

// {"choices":[{"index":0,"delta":{"content"|"reasoning_content":"<text>"}}]}
fn sse_delta_text(out: &Buf, payload: &Buf, text: &const byte, reasoning: bool) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, payload.ptr, payload.cap);
    jw_byte(&w, 123);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "delta");
    jw_byte(&w, 123);
    if reasoning {
        jw_key(&w, "reasoning_content");
    } else {
        jw_key(&w, "content");
    }
    jw_str_cstr(&w, text);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    return sse_emit(out, &w, payload);
}

// {"choices":[{"index":0,"delta":{"tool_calls":[{"index":N,"id":…,"function":{…}}]}}]}
fn sse_delta_tool(out: &Buf, payload: &Buf, index: i64, id: &const byte, name: &const byte, args_frag: &const byte) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, payload.ptr, payload.cap);
    jw_byte(&w, 123);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "delta");
    jw_byte(&w, 123);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, index);
    if bufx_cstr_len(id) > 0 {
        jw_byte(&w, 44);
        jw_key(&w, "id");
        jw_str_cstr(&w, id);
    }
    jw_byte(&w, 44);
    jw_key(&w, "function");
    jw_byte(&w, 123);
    if bufx_cstr_len(name) > 0 {
        jw_key(&w, "name");
        jw_str_cstr(&w, name);
        jw_byte(&w, 44);
    }
    jw_key(&w, "arguments");
    jw_str_cstr(&w, args_frag);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    return sse_emit(out, &w, payload);
}

// finish 帧：{"choices":[{"index":0,"delta":{},"finish_reason":"<why>"}][,"usage":{…}]}
fn sse_finish(out: &Buf, payload: &Buf, why: &const byte, with_usage: bool) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, payload.ptr, payload.cap);
    jw_byte(&w, 123);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "delta");
    jw_byte(&w, 123);
    jw_byte(&w, 125);
    jw_byte(&w, 44);
    jw_key(&w, "finish_reason");
    jw_str_cstr(&w, why);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    if with_usage {
        jw_byte(&w, 44);
        jw_key(&w, "usage");
        jw_byte(&w, 123);
        jw_key(&w, "prompt_tokens");
        jw_i64(&w, 100);
        jw_byte(&w, 44);
        jw_key(&w, "completion_tokens");
        jw_i64(&w, 7);
        jw_byte(&w, 44);
        jw_key(&w, "prompt_tokens_details");
        jw_byte(&w, 123);
        jw_key(&w, "cached_tokens");
        jw_i64(&w, 40);
        jw_byte(&w, 125);
        jw_byte(&w, 44);
        jw_key(&w, "completion_tokens_details");
        jw_byte(&w, 123);
        jw_key(&w, "reasoning_tokens");
        jw_i64(&w, 3);
        jw_byte(&w, 125);
        jw_byte(&w, 125);
    }
    jw_byte(&w, 125);
    return sse_emit(out, &w, payload);
}

// usage-only 帧：{"choices":[],"usage":{…}}
fn sse_usage_only(out: &Buf, payload: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, payload.ptr, payload.cap);
    jw_byte(&w, 123);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 93);
    jw_byte(&w, 44);
    jw_key(&w, "usage");
    jw_byte(&w, 123);
    jw_key(&w, "prompt_tokens");
    jw_i64(&w, 100);
    jw_byte(&w, 44);
    jw_key(&w, "completion_tokens");
    jw_i64(&w, 7);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    return sse_emit(out, &w, payload);
}

// 造一个原始 SSE 帧：`data: <text>` + 空行（text 原样，不做 JSON 转义）。
// 返回 false = out 容量不够（会写出半帧）。
fn sse_raw_frame(out: &Buf, text: &const byte) bool {
    if !buf_append_cstr(out, "data: ") {
        return false;
    }
    if !buf_append_cstr(out, text) {
        return false;
    }
    return buf_append_cstr(out, "\n\n");
}

// 生成一整个 SSE 文本（未分块）
fn sse_mock_text(case_id: i32, out: &Buf, payload: &Buf) bool {
    if case_id == SSE_CASE_BASIC {
        if !sse_delta_text(out, payload, "", false) { return false; }
        if !sse_delta_text(out, payload, "Hello", false) { return false; }
        if !sse_delta_text(out, payload, ", Uya!", false) { return false; }
        if !sse_finish(out, payload, "stop", true) { return false; }
        if !sse_usage_only(out, payload) { return false; }
        return sse_raw_frame(out, "[DONE]");
    }
    if case_id == SSE_CASE_TOOLS {
        if !sse_delta_text(out, payload, "I will read it", false) { return false; }
        if !sse_delta_tool(out, payload, 0, "call_a", "read", "") { return false; }
        if !sse_delta_tool(out, payload, 1, "call_b", "bash", "") { return false; }
        // arguments 分片：拼起来必须是 {"file_path":"a.txt"}
        if !sse_delta_tool(out, payload, 0, "", "", "{\"file") { return false; }
        if !sse_delta_tool(out, payload, 1, "", "", "{\"command\":\"ls") { return false; }
        if !sse_delta_tool(out, payload, 0, "", "", "_path\":\"a.txt\"}") { return false; }
        if !sse_delta_tool(out, payload, 1, "", "", "\"}") { return false; }
        if !sse_finish(out, payload, "tool_calls", false) { return false; }
        return sse_raw_frame(out, "[DONE]");
    }
    if case_id == SSE_CASE_NODONE {
        if !sse_delta_text(out, payload, "partial", false) { return false; }
        if !sse_finish(out, payload, "stop", false) { return false; }
        return true;   // 故意不发 [DONE]
    }
    if case_id == SSE_CASE_BADJSON {
        if !sse_delta_text(out, payload, "before-bad", false) { return false; }
        if !sse_raw_frame(out, "{\"choices\":[{\"index\":0,") { return false; }
        return sse_raw_frame(out, "[DONE]");
    }
    // SSE_CASE_REASONING_ONLY（P21）：只有思考增量，没有任何正文
    if case_id == SSE_CASE_REASONING_ONLY {
        if !sse_delta_text(out, payload, "think1", true) { return false; }
        if !sse_delta_text(out, payload, "think2", true) { return false; }
        if !sse_finish(out, payload, "stop", true) { return false; }
        return sse_raw_frame(out, "[DONE]");
    }
    // SSE_CASE_CALLONLY（P21）：只有工具调用参数，没有正文、没有思考
    if case_id == SSE_CASE_CALLONLY {
        if !sse_delta_tool(out, payload, 0, "call_c", "read", "{\"file_path\":\"a.txt\"}") { return false; }
        if !sse_finish(out, payload, "tool_calls", true) { return false; }
        return sse_raw_frame(out, "[DONE]");
    }
    // SSE_CASE_NODELTA（P21）：空串 delta + usage-only + finish(delta{}) —— 一个增量都没有
    if case_id == SSE_CASE_NODELTA {
        if !sse_delta_text(out, payload, "", false) { return false; }
        if !sse_usage_only(out, payload) { return false; }
        if !sse_finish(out, payload, "stop", false) { return false; }
        return sse_raw_frame(out, "[DONE]");
    }
    // SSE_CASE_REASONING_LENGTH
    if !sse_delta_text(out, payload, "think1", true) { return false; }
    if !sse_delta_text(out, payload, "think2", true) { return false; }
    if !sse_delta_text(out, payload, "cut", false) { return false; }
    return sse_finish(out, payload, "length", false);
}

// mock 端：一次连接，回 SSE（chunked + 受控切片）
fn sse_mock_server(lfd: i32) i32 {
    var peer: [byte: 16] = [0: 16];
    var alen: u32 = 16;
    const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch {
        _ = sys_close(lfd) catch {};
        return 40;
    };
    var rx: Buf = buf_new(8192);
    var verdict: i32 = 0;
    if !mock_read_request(cfd, &rx) {
        verdict = 41;
    } else if !contains(&rx, "\"stream\":true") {
        verdict = 42;   // 必须是流式请求
    } else if !contains(&rx, "Accept: text/event-stream") {
        verdict = 43;
    }
    buf_free(&rx);

    var text: Buf = buf_new(16384);
    var payload: Buf = buf_new(4096);
    if verdict == 0 {
        if !sse_mock_text(sse_case, &text, &payload) {
            verdict = 44;
        }
    }

    // SSE 文本 → chunked 分帧（每 37 字节一个 chunk，切点必然落在帧中间）
    var wire: Buf = buf_new(32768);
    if verdict == 0 {
        var off: usize = 0;
        while off < text.len {
            var take: usize = text.len - off;
            if take > 37 {
                take = 37;
            }
            _ = buf_append_u64_hex(&wire, take);
            _ = buf_append_cstr(&wire, "\r\n");
            _ = buf_append(&wire, &text.ptr[off], take);
            _ = buf_append_cstr(&wire, "\r\n");
            off = off + take;
        }
        _ = buf_append_cstr(&wire, "0\r\n\r\n");
    }

    if verdict == 0 {
        var head: Buf = buf_new(256);
        _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n");
        const hw: !void = https_write_all(cfd, &head.ptr[0] as &const byte, head.len);
        _ = hw catch {
            verdict = 45;
        };
        buf_free(&head);
    }

    if verdict == 0 {
        var woff: usize = 0;
        while woff < wire.len {
            var take: usize = wire.len - woff;
            if take > SSE_SLICE {
                take = SSE_SLICE;
            }
            const w: !void = https_write_all(cfd, &wire.ptr[woff] as &const byte, take);
            _ = w catch {
                verdict = 46;
                break;
            };
            woff = woff + take;
            if woff < wire.len {
                var req: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: SSE_GAP_NS };
                var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
                _ = sys_nanosleep(&req, &rem) catch {};
            }
        }
    }

    buf_free(&wire);
    buf_free(&text);
    buf_free(&payload);
    _ = sys_close(cfd) catch {};
    _ = sys_close(lfd) catch {};
    return verdict;
}

// 客户端：调一次 llm_stream_chat。返回 0=成功 1=malformed 2=stream-closed 3=其它错误 4=状态码非 200
fn sse_call(url: &[byte], hdrs: &[byte], body: &const Buf, o: &ChatOut) i32 {
    var empty_pin: [byte: 0] = [];
    const res: !i32 = llm_stream_chat(
        url,
        hdrs,
        body.ptr as &const byte,
        body.len,
        15000,
        262144,
        HC_VERIFY_NONE,
        &empty_pin[0: 0],
        o,
        false,
        false,
        false
    );
    const status: i32 = res catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        var r: i32 = 3;
        if eid == @error_id(error.LlmMalformed) {
            r = 1;
        } else if eid == @error_id(error.LlmStreamClosed) {
            r = 2;
        }
        r;
    };
    if status == 0 || status == 1 || status == 2 {
        return status;
    }
    if status != 200 {
        return 4;
    }
    return 0;
}

// SSE 解析轮：给 case_id 选夹具、起一个只服务这一轮的本地 TCP，把帧**按 19 字节切片**
// 分片喂进去（模拟真实网络的切分），断言解析出的正文/思考/工具与首 token 打点。
// sse_case 供服务端线程读；返回 false = 本轮红。
fn sse_round(case_id: i32, tag: &const byte) bool {
    sse_case = case_id;
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        out_err("selftest: socket() failed\n");
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: bind() failed\n");
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: listen() failed\n");
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: getsockname() failed\n");
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);

    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: fork() failed\n");
        return false;
    };
    if pid64 == 0 {
        const rc: i32 = sse_mock_server(lfd);
        sys_exit(rc);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var url: Buf = buf_new(96);
    _ = buf_append_cstr(&url, "http://127.0.0.1:");
    _ = buf_append_u64(&url, port as u64);
    _ = buf_append_cstr(&url, "/v1/chat/completions");
    var hdrs: Buf = buf_new(128);
    _ = buf_append_cstr(&hdrs, "Content-Type: application/json\r\nAccept: text/event-stream\r\n");
    var body: Buf = buf_new(256);
    _ = buf_append_cstr(&body, "{\"model\":\"selftest-model\",\"stream\":true,\"messages\":[]}");

    var o: ChatOut = chat_out_new();
    const call_rc: i32 = sse_call(url.ptr[0: url.len], hdrs.ptr[0: hdrs.len], &body, &o);

    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    if mock_rc != 0 {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: mock verdict ");
        out_err_dec(mock_rc as usize);
        out_err("\n");
        ok = false;
    }

    if ok && case_id == SSE_CASE_BASIC {
        if call_rc != 0 || !o.saw_done || o.finish != LLM_FINISH_STOP {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: call_rc/finish");
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.content, "Hello, Uya!") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: content=");
            out_err_bytes(o.content.ptr as &const byte, o.content.len);
            out_err("\n");
            ok = false;
        } else if o.usage_in != 60 || o.usage_out != 7 || o.usage_cache_read != 40 || o.usage_reasoning != 3 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: usage");
            out_err("\n");
            ok = false;
        } else if o.ncalls != 0 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: unexpected tool_calls");
            out_err("\n");
            ok = false;
        } else if o.first_token_ms <= 0 {
            // P21：开头那帧空串 delta 不算，但随后那帧真正文必须打点
            ty_fail(tag, "首个非空正文 delta 之后首 token 没打点", &ok);
        }
    } else if ok && case_id == SSE_CASE_TOOLS {
        if call_rc != 0 || !o.saw_done || o.finish != LLM_FINISH_TOOL_CALLS {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: call_rc/finish");
            out_err("\n");
            ok = false;
        } else if o.ncalls != 2 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: ncalls=");
            out_err_dec(o.ncalls);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.calls[0].id, "call_a") || !sse_buf_eq(&o.calls[0].name, "read")
            || !sse_buf_eq(&o.calls[0].args, "{\"file_path\":\"a.txt\"}") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: call0=");
            out_err_bytes(o.calls[0].args.ptr as &const byte, o.calls[0].args.len);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.calls[1].id, "call_b") || !sse_buf_eq(&o.calls[1].name, "bash")
            || !sse_buf_eq(&o.calls[1].args, "{\"command\":\"ls\"}") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: call1=");
            out_err_bytes(o.calls[1].args.ptr as &const byte, o.calls[1].args.len);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.content, "I will read it") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: content");
            out_err("\n");
            ok = false;
        }
    } else if ok && case_id == SSE_CASE_NODONE {
        if call_rc != 2 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: expected LlmStreamClosed, got ");
            out_err_dec(call_rc as usize);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.content, "partial") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: content before truncation");
            out_err("\n");
            ok = false;
        }
    } else if ok && case_id == SSE_CASE_BADJSON {
        if call_rc != 1 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: expected LlmMalformed, got ");
            out_err_dec(call_rc as usize);
            out_err("\n");
            ok = false;
        } else if o.err_text.len == 0 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: no err_text");
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.content, "before-bad") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: content before bad frame");
            out_err("\n");
            ok = false;
        }
    } else if ok && case_id == SSE_CASE_REASONING_LENGTH {
        if call_rc != 2 {
            // 这一轮故意不发 [DONE]，所以是 stream-closed
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: expected LlmStreamClosed, got ");
            out_err_dec(call_rc as usize);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.reasoning, "think1think2") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: reasoning=");
            out_err_bytes(o.reasoning.ptr as &const byte, o.reasoning.len);
            out_err("\n");
            ok = false;
        } else if o.finish != LLM_FINISH_MAX_TOKENS {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: finish != max-tokens");
            out_err("\n");
            ok = false;
        }
    } else if ok && case_id == SSE_CASE_REASONING_ONLY {
        if call_rc != 0 || !o.saw_done {
            ty_fail(tag, "只有思考 delta 的流没有正常收尾", &ok);
        } else if o.content.len != 0 {
            ty_fail(tag, "只有思考 delta 时不该攒出正文", &ok);
        } else if !sse_buf_eq(&o.reasoning, "think1think2") {
            ty_fail(tag, "思考增量没拼全", &ok);
        } else if o.first_token_ms <= 0 {
            ty_fail(tag, "只有思考 delta 时首 token 没打点（ttft/解码那一组会整组空着）", &ok);
        }
    } else if ok && case_id == SSE_CASE_CALLONLY {
        if call_rc != 0 || !o.saw_done {
            ty_fail(tag, "只有工具参数的流没有正常收尾", &ok);
        } else if o.content.len != 0 || o.ncalls != 1 {
            ty_fail(tag, "只有工具参数时的 content/ncalls 不对", &ok);
        } else if !sse_buf_eq(&o.calls[0].name, "read") || !sse_buf_eq(&o.calls[0].args, "{\"file_path\":\"a.txt\"}") {
            ty_fail(tag, "工具调用参数没拼全", &ok);
        } else if o.first_token_ms <= 0 {
            ty_fail(tag, "只有工具参数时首 token 没打点（解码窗口只盖住生成尾部 → tok/s 爆表）", &ok);
        }
    } else if ok && case_id == SSE_CASE_NODELTA {
        if call_rc != 0 || !o.saw_done {
            ty_fail(tag, "没有增量帧的流没有正常收尾", &ok);
        } else if o.content.len != 0 || o.reasoning.len != 0 || o.ncalls != 0 {
            ty_fail(tag, "空 delta 不该攒出任何内容", &ok);
        } else if o.usage_out != 7 {
            ty_fail(tag, "usage-only 帧的用量没解析出来", &ok);
        } else if o.first_token_ms != 0 {
            ty_fail(tag, "空串 delta / usage-only 帧被当成首 token 了（窗口会从 0 起算）", &ok);
        }
    }

    chat_out_free(&o);
    buf_free(&url);
    buf_free(&hdrs);
    buf_free(&body);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}


// ============================================================
// P3 终端层自测（不需要真 TTY：行编辑器是纯字节流逻辑，转义序列可以分片喂）
// ============================================================
fn ty_fail(tag: &const byte, what: &const byte, ok: &bool) void {
    out_err("selftest[");
    out_err(tag);
    out_err("] FAIL: ");
    out_err(what);
    out_err("\n");
    ok[0] = false;
}

// 把 C 串 s 整段喂进行编辑器（tty_feed，长度现算）。
// 终端层自测的输入口：转义序列可以分片喂，见 ty_feed_byte1。
fn ty_feed_cstr(ui: &TtyUi, s: &const byte) void {
    tty_feed(ui, s, bufx_cstr_len(s));
}

// 喂单个字节：必须用数组取址，&"\x1b"[0:1] 是**切片**不是指针
fn ty_feed_byte1(ui: &TtyUi, b: byte) void {
    var one: [byte: 1] = [0: 1];
    one[0] = b;
    tty_feed(ui, &one[0], 1);
}

// ui.line 是否恰好等于 want（长度先比，再逐字节）。
// 失败时用 ty_line_dump 把实际行打出来。
fn ty_line_is(ui: &const TtyUi, want: &const byte) bool {
    const n: usize = bufx_cstr_len(want);
    if ui.line.len != n {
        return false;
    }
    return bufx_mem_eq(ui.line.ptr as &const byte, want, n);
}

// 把 ui.line 的实际字节按 `[bytes]` 打给 fd 2（断言失败时的现场，写入失败被吞掉）。
fn ty_line_dump(ui: &const TtyUi) void {
    out_err("[");
    out_err_bytes(ui.line.ptr as &const byte, ui.line.len);
    out_err("]");
}

// ---- P15 面板断言用的小工具（与 view 的面板渲染同口径：宽度只按显示列算）----
fn ty_panel_rule(out: &Buf, left: &const byte, right: &const byte, m: usize) void {
    _ = buf_append(out, left, bufx_cstr_len(left));
    const used: usize = tty_cols_between(out.ptr as &const byte, 0, out.len);
    var k: usize = used;
    while k < m - 1 {
        _ = buf_append_cstr(out, "─");
        k = k + 1;
    }
    _ = buf_append(out, right, bufx_cstr_len(right));
}

// 往 out 追加一行面板行：`│ <lit>` 后面补空格到显示宽度 m-1，再补右边框。
// 宽度按 tty_cols_between 算（不是字节数），所以中文/宽字符不会把边框顶歪。
fn ty_panel_row(out: &Buf, lit: &const byte, m: usize) void {
    _ = buf_append_cstr(out, "│ ");
    _ = buf_append_cstr(out, lit);
    const used: usize = tty_cols_between(out.ptr as &const byte, 0, out.len);
    var k: usize = used;
    while k < m - 1 {
        _ = buf_append_byte(out, 32);
        k = k + 1;
    }
    _ = buf_append_cstr(out, "│");
}

// 把多行文本按块写入的口径展开（每个 "\n" 实际写成 "\r\n"）
fn ty_crlf(out: &Buf, s: &[byte]) void {
    var i: usize = 0;
    while i < s.len {
        if s.ptr[i] == 10 as byte {
            _ = buf_append_cstr(out, "\r\n");
        } else {
            _ = buf_append_byte(out, s.ptr[i]);
        }
        i = i + 1;
    }
}

// 子串包含 / 前缀 / 后缀（字节版，给面板块的渲染断言用）
fn ty_has(hay: &const Buf, needle: &const byte, n: usize) bool {
    if n == 0 || hay.len < n {
        return n == 0;
    }
    return find_sub(hay.ptr[0: hay.len], needle[0: n], 0) >= 0;
}

// b 是否以 C 字面量 lit 开头（不足即 false）。
fn ty_starts(b: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if b.len < n {
        return false;
    }
    return bufx_mem_eq(b.ptr as &const byte, lit, n);
}

// b 的最后 n 个字节是否等于 lit（长度显式给，因为 lit 可能含 NUL）。
fn ty_ends(b: &const Buf, lit: &const byte, n: usize) bool {
    if b.len < n {
        return false;
    }
    return bufx_mem_eq((b.ptr + (b.len - n)) as &const byte, lit, n);
}

// P3 终端层自测轮：先钉 ABI（TtyTermios 60 字节 / TtyWinsize 8 字节），再按纯字节流
// 喂歧义转义序列与多字节 UTF-8 分片、跑行编辑/历史/面板宽度。不需要真 TTY；返回 false = 本轮红。
fn tty_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- ABI：termios / winsize 布局与 raw 位运算 ----
    const tsz: usize = @size_of(TtyTermios) as usize;
    if tsz != 60 {
        ty_fail(tag, "TtyTermios 布局不是 60 字节", &ok);
    }
    const wsz: usize = @size_of(TtyWinsize) as usize;
    if wsz != 8 {
        ty_fail(tag, "TtyWinsize 布局不是 8 字节", &ok);
    }
    const all: u32 = 0xFFFFFFFF;
    const lc: u32 = tty_raw_lflag_clear(all);
    if (lc & TTY_LFLAG_TEST_ISIG) != 0 || (lc & TTY_LFLAG_TEST_ICANON) != 0
        || (lc & TTY_LFLAG_TEST_ECHO) != 0 || (lc & TTY_LFLAG_TEST_IEXTEN) != 0 {
        ty_fail(tag, "raw 模式没有清掉 lflag 位", &ok);
    }
    const keep_bit: u32 = 0x00000010;
    if (lc & keep_bit) == 0 {
        ty_fail(tag, "raw 模式误清了无关位", &ok);
    }
    const ic: u32 = tty_raw_iflag_clear(all);
    const icrnl: u32 = 0x00000100;
    const ixon: u32 = 0x00000400;
    if (ic & icrnl) != 0 || (ic & ixon) != 0 {
        ty_fail(tag, "raw 模式没有清掉 iflag 位", &ok);
    }

    // ---- 行编辑 ----
    var ui: TtyUi = tty_ui;
    tty_init(&ui, 0);   // 自测环境下 fd 0 不是 TTY → 只测编辑逻辑，不做渲染

    // 输入 + 回车 → SUBMIT
    ty_feed_cstr(&ui, "abc");
    ty_feed_cstr(&ui, "\r");
    if tty_next_event(&ui) != TTY_EV_SUBMIT {
        ty_fail(tag, "回车没有产生 SUBMIT", &ok);
    }
    if !ty_line_is(&ui, "abc") {
        ty_fail(tag, "提交的行内容不对", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 退格
    ty_feed_cstr(&ui, "abX");
    ty_feed_cstr(&ui, "\x7f");
    if !ty_line_is(&ui, "ab") {
        ty_fail(tag, "退格没删掉最后一个字符", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 左移 + 插入：ac ← + b → abc
    ty_feed_cstr(&ui, "ac");
    ty_feed_cstr(&ui, "\x1b[D");
    ty_feed_cstr(&ui, "b");
    if !ty_line_is(&ui, "abc") {
        ty_fail(tag, "左移插入结果不是 abc", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // Delete 键（ESC [ 3 ~）
    ty_feed_cstr(&ui, "abc");
    ty_feed_cstr(&ui, "\x1b[D\x1b[D");   // 光标到 'b' 前
    ty_feed_cstr(&ui, "\x1b[3~");        // 删 'b'
    if !ty_line_is(&ui, "ac") {
        ty_fail(tag, "Delete 键没有删掉光标处字符", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 转义序列**分片**喂入（状态必须跨调用保持）
    ty_feed_cstr(&ui, "xy");
    ty_feed_byte1(&ui, 27);
    ty_feed_byte1(&ui, 91);
    ty_feed_byte1(&ui, 68);
    ty_feed_cstr(&ui, "z");
    if !ty_line_is(&ui, "xzy") {
        ty_fail(tag, "分片转义序列状态丢了", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 裸 ESC → ESC 事件（中断意图）；由 tty_flush_esc 在一次读取结束时判定
    ty_feed_cstr(&ui, "\x1b");
    tty_flush_esc(&ui);
    if tty_next_event(&ui) != TTY_EV_ESC {
        ty_fail(tag, "裸 ESC 没有产生 ESC 事件", &ok);
    }

    // Ctrl-C / Ctrl-U / Ctrl-D
    ty_feed_cstr(&ui, "keep");
    ty_feed_cstr(&ui, "\x03");
    if tty_next_event(&ui) != TTY_EV_CTRL_C {
        ty_fail(tag, "Ctrl-C 没有产生事件", &ok);
    }
    if !ty_line_is(&ui, "keep") {
        ty_fail(tag, "Ctrl-C 不该清掉已输入文本（由调用方决定）", &ok);
    }
    ty_feed_cstr(&ui, "\x15");   // Ctrl-U
    if tty_next_event(&ui) != TTY_EV_CLEARED || ui.line.len != 0 {
        ty_fail(tag, "Ctrl-U 没有清行", &ok);
    }
    ty_feed_cstr(&ui, "\x04");   // 空行 Ctrl-D
    if tty_next_event(&ui) != TTY_EV_EOF {
        ty_fail(tag, "空行 Ctrl-D 没有产生 EOF", &ok);
    }
    // 非空 Ctrl-D = 删光标处字符（先把光标左移，行尾 Ctrl-D 本就不该删）
    ty_feed_cstr(&ui, "ab");
    ty_feed_cstr(&ui, "\x1b[D");
    ty_feed_cstr(&ui, "\x04");
    if !ty_line_is(&ui, "a") {
        ty_fail(tag, "非空 Ctrl-D 应删除光标处字符", &ok);
        ty_line_dump(&ui);
    }
    // 行尾 Ctrl-D 不应改动内容
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "ab");
    ty_feed_cstr(&ui, "\x04");
    if !ty_line_is(&ui, "ab") {
        ty_fail(tag, "行尾 Ctrl-D 不该改动内容", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // Ctrl-W 删词
    ty_feed_cstr(&ui, "foo bar");
    ty_feed_cstr(&ui, "\x17");
    if !ty_line_is(&ui, "foo ") {
        ty_fail(tag, "Ctrl-W 没有删掉一个词", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 历史：提交 one → 输入 two → Up 回到 one → Down 回到 two
    ty_feed_cstr(&ui, "one");
    ty_feed_cstr(&ui, "\r");
    _ = tty_next_event(&ui);
    tty_line_clear(&ui);   // 真实调用方在消费 SUBMIT 后清行
    ty_feed_cstr(&ui, "two");
    ty_feed_cstr(&ui, "\x1b[A");
    if !ty_line_is(&ui, "one") {
        ty_fail(tag, "上翻历史没有取到上一条", &ok);
        ty_line_dump(&ui);
    }
    ty_feed_cstr(&ui, "\x1b[B");
    if !ty_line_is(&ui, "two") {
        ty_fail(tag, "下翻历史没有回到暂存行", &ok);
        ty_line_dump(&ui);
    }
    // 前面已经提交过 "abc" 与 "one" 两次，所以历史里应有 2 条
    if ui.hist_len != 2 {
        ty_fail(tag, "历史条数不对", &ok);
    }
    // ---- UTF-8 行编辑：中文 1 字符 3 字节 2 列，按字节编辑必出乱码 ----
    // 退格必须删**整个字符**（只删 1 字节会留下 \xe4\xb8 这种半截序列，屏幕上就是乱码）
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "写一篇");
    ty_feed_cstr(&ui, "\x7f");
    if !ty_line_is(&ui, "写一") {
        ty_fail(tag, "退格没有删掉整个中文字符", &ok);
        ty_line_dump(&ui);
    }
    ty_feed_cstr(&ui, "\x7f\x7f");
    if ui.line.len != 0 {
        ty_fail(tag, "连退三次没有清空中文行", &ok);
        ty_line_dump(&ui);
    }

    // 左右方向键按字符走：光标不能停在字符中间
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "中文ab");
    ty_feed_cstr(&ui, "\x1b[D");          // 退到 'b' 前
    ty_feed_cstr(&ui, "\x1b[D");          // 退到 'a' 前
    ty_feed_cstr(&ui, "\x1b[D");          // 退到「文」前
    ty_feed_cstr(&ui, "X");
    if !ty_line_is(&ui, "中X文ab") {
        ty_fail(tag, "方向键没有按字符移动（插到字符中间了）", &ok);
        ty_line_dump(&ui);
    }

    // Delete：一次删掉光标处的整个中文字符
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "中文");
    ty_feed_cstr(&ui, "\x1b[D");          // 光标到「文」前
    ty_feed_cstr(&ui, "\x1b[3~");
    if !ty_line_is(&ui, "中") {
        ty_fail(tag, "Delete 没有删掉整个中文字符", &ok);
        ty_line_dump(&ui);
    }

    // Ctrl-W：整词删除同样要按字符退
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "写 中文任务");
    ty_feed_cstr(&ui, "\x17");
    if !ty_line_is(&ui, "写 ") {
        ty_fail(tag, "Ctrl-W 没有整词删掉中文", &ok);
        ty_line_dump(&ui);
    }

    // UTF-8 原语
    if tty_utf8_len(65 as byte) != 1 || tty_utf8_len(0xE5 as byte) != 3 || tty_utf8_len(0xF0 as byte) != 4 {
        ty_fail(tag, "tty_utf8_len 判定不对", &ok);
    }
    if tty_utf8_len(0x80 as byte) != 1 {
        ty_fail(tag, "孤立续字节应按单字节处理（否则编辑会卡死）", &ok);
    }
    const cjk: &const byte = "写a文" as &const byte;      // 3 + 1 + 3 = 7 字节
    if tty_utf8_prev(cjk, 7) != 4 || tty_utf8_prev(cjk, 4) != 3 || tty_utf8_prev(cjk, 3) != 0 {
        ty_fail(tag, "tty_utf8_prev 没有停在字符边界", &ok);
    }
    if tty_utf8_next(cjk, 0, 7) != 3 || tty_utf8_next(cjk, 3, 7) != 4 || tty_utf8_next(cjk, 4, 7) != 7 {
        ty_fail(tag, "tty_utf8_next 步进不对", &ok);
    }
    if tty_utf8_decode(cjk, 0, 7) != 0x5199 || tty_utf8_decode(cjk, 3, 7) != 97 {
        ty_fail(tag, "tty_utf8_decode 解出来的码点不对", &ok);
    }

    // 显示列宽：中文 2 列、ASCII 1 列、组合符 0 列
    if tty_cols_between(cjk, 0, 7) != 5 {
        ty_fail(tag, "「写a文」的显示列数不是 5（2+1+2）", &ok);
    }
    if tty_char_cols(0x5199) != 2 || tty_char_cols(65) != 1 || tty_char_cols(0x0301) != 0 {
        ty_fail(tag, "tty_char_cols 宽度判定不对", &ok);
    }

    // 折行口径：写满整行时光标停在**本行最后一列**（DECAWM 挂起换行），不是下一行第 0 列。
    // 这两个函数口径必须一致，否则擦除会多上移一行、把上一行输出（banner 之类）擦掉。
    var rrow: usize = 0;
    var rcol: usize = 0;
    tty_end_row_col(80, 80, &rrow, &rcol);
    if rrow != 0 || rcol != 79 {
        ty_fail(tag, "写满整行的光标位置口径不对", &ok);
    }
    tty_end_row_col(81, 80, &rrow, &rcol);
    if rrow != 1 || rcol != 1 {
        ty_fail(tag, "折行第二行的光标位置不对", &ok);
    }
    tty_end_row_col(0, 80, &rrow, &rcol);
    if rrow != 0 || rcol != 0 {
        ty_fail(tag, "空行的光标位置不对", &ok);
    }
    if tty_rows_of(0, 80) != 1 || tty_rows_of(80, 80) != 1 || tty_rows_of(81, 80) != 2 || tty_rows_of(160, 80) != 2 {
        ty_fail(tag, "tty_rows_of 行数计算不对", &ok);
    }

    // 擦除序列（协议错一个字节，屏幕上就是乱码/残影）：单行 = \r ESC[J；折行第二行要先上移
    var eseq: [byte: 20] = [0: 20];
    var ek: usize = tty_build_erase_seq(&eseq[0], 0, 0);
    if ek != 4 || eseq[0] != 13 || eseq[1] != 27 || eseq[2] != 91 || eseq[3] != 74 {
        ty_fail(tag, "单行擦除序列不是 CR ESC[J", &ok);
    }
    ek = tty_build_erase_seq(&eseq[0], 2, 0);
    // ESC [ 2 A CR ESC [ J —— 共 8 字节
    if ek != 8 || eseq[0] != 27 || eseq[1] != 91 || eseq[2] != 50 || eseq[3] != 65
        || eseq[4] != 13 || eseq[5] != 27 || eseq[6] != 91 || eseq[7] != 74 {
        ty_fail(tag, "折行擦除序列不是 ESC[2A CR ESC[J", &ok);
    }
    // 上移行数 0 时不能写 ESC[0A —— CSI 参数 0 是「默认值」，终端会当成上移 1 行
    if tty_build_erase_seq(&eseq[0], 0, 0) != 4 || eseq[0] != 13 {
        ty_fail(tag, "cur_row=0 时不该写 ESC[0A", &ok);
    }
    // 输入行块不在第 0 列时（流式输出没换行）：必须先右移到块首列再清，
    // 否则会把同一行前半段的正文一起擦掉
    ek = tty_build_erase_seq(&eseq[0], 0, 12);
    // CR ESC [ 1 2 C ESC [ J —— 共 9 字节
    if ek != 9 || eseq[0] != 13 || eseq[1] != 27 || eseq[2] != 91 || eseq[3] != 49
        || eseq[4] != 50 || eseq[5] != 67 || eseq[6] != 27 || eseq[7] != 91 || eseq[8] != 74 {
        ty_fail(tag, "带起始列的擦除序列不对", &ok);
    }

    // 物理列追踪（输入行的起始列全靠它算）
    ui.cols = 80;
    ui.out_col = 0;
    ui.out_wrap = false;
    tty_advance_col(&ui, "abc" as &const byte, 3);
    if ui.out_col != 3 || ui.out_wrap {
        ty_fail(tag, "写 3 个 ASCII 后列位置不对", &ok);
    }
    tty_advance_col(&ui, "\n" as &const byte, 1);
    if ui.out_col != 0 || ui.out_wrap {
        ty_fail(tag, "换行后列位置没归零", &ok);
    }
    // 正好写满一行：列停在最后一列并挂起待换行
    var pad: [byte: 80] = [0: 80];
    var pi: usize = 0;
    while pi < 80 {
        pad[pi] = 97;
        pi = pi + 1;
    }
    tty_advance_col(&ui, &pad[0], 80);
    if ui.out_col != 79 || !ui.out_wrap {
        ty_fail(tag, "写满整行后没有置「挂起换行」", &ok);
    }
    // 挂起换行状态下写中文：先落到下一行第 0 列，再占 2 列
    tty_advance_col(&ui, cjk, 3);
    if ui.out_col != 2 || ui.out_wrap {
        ty_fail(tag, "挂起换行后写中文的列位置不对", &ok);
    }
    // 十进制写入（光标回退/列定位都用它）
    var dnum: [byte: 8] = [0: 8];
    if tty_put_dec(&dnum[0], 0, 4) != 1 || dnum[0] != 48 {
        ty_fail(tag, "tty_put_dec(0) 不对", &ok);
    }
    if tty_put_dec(&dnum[0], 1234, 4) != 4 || dnum[0] != 49 || dnum[3] != 52 {
        ty_fail(tag, "tty_put_dec(1234) 不对", &ok);
    }

    // ============================================================
    // P15：多行面板块（子代理窗口面板）
    // ============================================================
    // 行数口径：每行自带 "\r\n"（写完之后光标在下一行第 0 列）；
    // 一行正好写满整行宽时占 **1** 行（DECAWM 挂起换行，与 tty_end_row_col 同口径）。
    var blk: Buf = buf_new(256);
    defer { buf_free(&blk); }
    _ = buf_append_cstr(&blk, "ab\ncd\n");
    const blkv: &[byte] = blk.ptr[0: blk.len];
    if tty_block_rows(blkv, 80, 0) != 2 {
        ty_fail(tag, "两块两行文本应该占 2 行", &ok);
    }
    if tty_block_vis0(blkv, 80, 0) != 1 {
        ty_fail(tag, "输入行应该在第 1 个窗口行之后", &ok);
    }
    buf_reset(&blk);
    _ = buf_append_cstr(&blk, "123456\n123456\n");   // 6 列 = 整行宽（宽度必须用 ASCII 才数得准）
    const blk2: &[byte] = blk.ptr[0: blk.len];
    if tty_block_rows(blk2, 6, 0) != 2 || tty_block_vis0(blk2, 6, 0) != 1 {
        ty_fail(tag, "正好写满整行宽的行应算 1 行（挂起换行口径）", &ok);
    }
    // 不变量：输入行号 = 窗口行行数 - 1（擦除/重画的光标算术都建立在它上面）
    if tty_block_vis0(blk2, 6, 0) + 1 != tty_block_rows(blk2, 6, 0) {
        ty_fail(tag, "tty_block_vis0 与 tty_block_rows 口径不一致", &ok);
    }
    buf_reset(&blk);
    _ = buf_append_cstr(&blk, "1234567\n");
    const blk3: &[byte] = blk.ptr[0: blk.len];
    if tty_block_vis0(blk3, 6, 0) + 1 != tty_block_rows(blk3, 6, 0) {
        ty_fail(tag, "窄宽度下 vis0/rows 也要自洽", &ok);
    }

    // 严格等宽的伪面板（上面 5 行 + 底框）：逐行生成，禁止手写空格
    var pnl: Buf = buf_new(1024);
    defer { buf_free(&pnl); }
    ty_panel_rule(&pnl, "┌" as &const byte, "┐" as &const byte, 20);
    _ = buf_append_byte(&pnl, 10);
    ty_panel_row(&pnl, "● sub-1 [subagent] 审计", 20);
    _ = buf_append_byte(&pnl, 10);
    ty_panel_row(&pnl, "● running       3s · 0", 20);
    _ = buf_append_byte(&pnl, 10);
    ty_panel_row(&pnl, "│ 竖线也要对齐 abcdefg", 20);
    _ = buf_append_byte(&pnl, 10);
    ty_panel_row(&pnl, "很长的中文内容中文内容中文内容中文", 20);
    _ = buf_append_byte(&pnl, 10);
    ty_panel_rule(&pnl, "└" as &const byte, "┘" as &const byte, 20);
    _ = buf_append_byte(&pnl, 10);

    // 擦除序列（逐字节）：块首行不在第 0 列时的右移、上移行数、逐行 ESC[2K
    var bseq: [byte: 512] = [0: 512];
    var bend: usize = 0;
    var bc: usize = tty_build_block_erase(&bseq[0], 1, 0, &bend);
    if bc != 6 || bseq[0] != 13 || bseq[1] != 27 || bseq[2] != 91 || bseq[3] != 50
        || bseq[4] != 75 || bseq[5] != 13 || bend != 0 {
        ty_fail(tag, "单行面板块擦除序列不是 CR ESC[2K CR（6 字节）", &ok);
    }
    bc = tty_build_block_erase(&bseq[0], 4, 0, &bend);
    // ESC[3A CR + 4×(ESC[2K CR) = 4 + 1 + 20 = 25 字节
    if bc != 25 || bseq[0] != 27 || bseq[1] != 91 || bseq[2] != 51 || bseq[3] != 65
        || bseq[4] != 13 || bseq[5] != 27 || bseq[6] != 91 || bseq[7] != 50 || bseq[8] != 75 || bseq[9] != 13 {
        ty_fail(tag, "4 行面板块擦除序列不对（应为 ESC[3A CR + 4×ESC[2K CR）", &ok);
    }
    if bend != 0 {
        ty_fail(tag, "col0=0 时擦完光标应在第 0 列", &ok);
    }
    bc = tty_build_block_erase(&bseq[0], 4, 12, &bend);
    if bend != 12 {
        ty_fail(tag, "擦完光标应停在块首列（12）", &ok);
    }
    // rows=0 不合法：退化成单行，绝不能写 ESC[0A（CSI 参数 0 = 默认值 = 上移 1 行）
    bc = tty_build_block_erase(&bseq[0], 0, 0, &bend);
    if bc != 6 || bseq[0] != 13 {
        ty_fail(tag, "rows=0 时不该写 ESC[0A", &ok);
    }

    // 真画一次：is_tty/raw 手工置位 → tty_draw_line 走渲染路径，fd 2 捕获到文件逐字节断言。
    // 面板 5 行 + 输入行 = 6 行块；输入行 "> " 之后没有文本，所以光标就停在画完的位置。
    var cap2: Buf = buf_new(65536);
    defer { buf_free(&cap2); }
    var tpath: [byte: 64] = "build/selftest_tty_block.txt";
    const tp: &const byte = &tpath[0] as &const byte;
    var tcfd: i32 = -1;
    tty_init(&ui, 0);             // 干净起点（前面的编辑测试留下过事件/行内容）
    tty_set_block_provider(&ui, true);
    tty_block_set(&ui, pnl.ptr as &const byte, pnl.len);
    ui.is_tty = true;
    ui.raw = true;
    ui.cols = 20;                 // 与伪面板等宽（tty_refresh_cols 在自测里读不到真窗口，不会改它）
    tty_set_prompt(&ui, "> ");
    tty_line_clear(&ui);

    // 块按 \n -> \r\n 写出来（自测的期望按同一口径展开）
    var blkexp: Buf = buf_new(4096);
    defer { buf_free(&blkexp); }
    ty_crlf(&blkexp, pnl.ptr[0: pnl.len]);
    _ = buf_append_cstr(&blkexp, "> ");

    // ---- 第一次画：屏幕上什么都没有 → 直接写块 + 提示符，输入行落在块的第 5 行 ----
    var tsaved: i32 = vw_cap_on(tp, &tcfd);
    tty_draw_line(&ui, 2);
    vw_cap_off(tp, tsaved, tcfd, &cap2);
    if !ui.block_on {
        ty_fail(tag, "画完后面板块应为「开」", &ok);
    }
    if ui.cur_row != 5 {
        ty_fail(tag, "输入行应落在块的第 5 行（块内行号 = 行数 - 1）", &ok);
        out_err("[cur_row] ");
        out_err_dec(ui.cur_row);
        out_err("\n");
    }
    if cap2.len == 0 || cap2.ptr[0] != pnl.ptr[0] {
        ty_fail(tag, "第一帧屏幕上没有旧内容，应该直接写块（开头就是块的第一个字节）", &ok);
    }
    if !ty_has(&cap2, blkexp.ptr as &const byte, blkexp.len) {
        ty_fail(tag, "第一帧应该完整写出「块（\\n→\\r\\n）+ 提示符」", &ok);
    }
    if ty_has(&cap2, "\x1b[2K" as &const byte, 4) {
        ty_fail(tag, "第一帧屏幕上没有旧内容，不该有任何擦除序列", &ok);
    }

    // ---- 快照没变：屏幕上那块必须被原样重建（要么空、要么仍以提示符收尾）----
    tsaved = vw_cap_on(tp, &tcfd);
    tty_draw_line(&ui, 2);
    vw_cap_off(tp, tsaved, tcfd, &cap2);
    if cap2.len != 0 && !ty_has(&cap2, blkexp.ptr as &const byte, blkexp.len) {
        ty_fail(tag, "快照没变时的重画必须与原样一致（块仍在、内容不变）", &ok);
    }

    // ---- 块变矮（子代理跑完、窗口收掉）：擦除必须按**老**行数上移 ----
    // 老块 6 行 → 先 CR ESC[5A CR；这一条正是 P15 修掉的「光标已在位就提前返回」的回归。
    var pnl2: Buf = buf_new(256);
    defer { buf_free(&pnl2); }
    _ = buf_append_cstr(&pnl2, "├─ ab ─┤\n");
    var blkexp2: Buf = buf_new(512);
    defer { buf_free(&blkexp2); }
    ty_crlf(&blkexp2, pnl2.ptr[0: pnl2.len]);
    _ = buf_append_cstr(&blkexp2, "> ");
    tty_block_set(&ui, pnl2.ptr as &const byte, pnl2.len);
    tsaved = vw_cap_on(tp, &tcfd);
    tty_draw_line(&ui, 2);
    vw_cap_off(tp, tsaved, tcfd, &cap2);
    if ui.cur_row != 0 {
        ty_fail(tag, "变矮之后输入行应落在块底行（0）", &ok);
    }
    const up5: bool = ty_starts(&cap2, "\r\x1b[5A\r") || ty_starts(&cap2, "\x1b[5A\r");
    if !up5 {
        ty_fail(tag, "变矮时的擦除没有按老行数上移（应先 ESC[5A）", &ok);
        out_err("[f3] len=");
        out_err_dec(cap2.len);
        out_err(" head=");
        var q6: usize = 0;
        while q6 < 20 && q6 < cap2.len {
            out_err_dec(cap2.ptr[q6] as usize);
            out_err(" ");
            q6 = q6 + 1;
        }
        out_err("\n");
    }
    if !ty_has(&cap2, blkexp2.ptr as &const byte, blkexp2.len) {
        ty_fail(tag, "变矮那一帧应该写出新块 + 提示符", &ok);
    }

    // ---- 清掉快照：面板整个消失，只剩提示符 ----
    tty_block_set(&ui, null as &const byte, 0);
    tsaved = vw_cap_on(tp, &tcfd);
    tty_draw_line(&ui, 2);
    vw_cap_off(tp, tsaved, tcfd, &cap2);
    if ui.block_on {
        ty_fail(tag, "清掉快照后面板块应为「关」", &ok);
    }
    if !ty_ends(&cap2, "> " as &const byte, 2) {
        ty_fail(tag, "清掉面板之后应以提示符收尾", &ok);
    }

    tty_set_block_provider(&ui, false);

    tty_free(&ui);

    // 一次喂入多行（粘贴）：必须一行一个 SUBMIT，剩下的一行留在 pend 里等下次处理
    tty_line_clear(&ui);
    while tty_next_event(&ui) != TTY_EV_NONE {
    }
    ty_feed_cstr(&ui, "a\nb\n");
    if tty_next_event(&ui) != TTY_EV_SUBMIT {
        ty_fail(tag, "粘贴多行时第一行没有产生 SUBMIT", &ok);
    }
    if !ty_line_is(&ui, "a") {
        ty_fail(tag, "粘贴多行时第一行内容不对", &ok);
        ty_line_dump(&ui);
    }
    if !tty_has_pending(&ui) {
        ty_fail(tag, "第二行没有留在 pend 缓冲里", &ok);
    }
    tty_line_clear(&ui);
    tty_feed(&ui, null as &const byte, 0);
    if tty_next_event(&ui) != TTY_EV_SUBMIT {
        ty_fail(tag, "pend 里的第二行没有产生 SUBMIT", &ok);
    }
    if !ty_line_is(&ui, "b") {
        ty_fail(tag, "pend 里的第二行内容不对", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // getcwd 的长度含结尾 NUL：剥掉之后工作目录里不能有 NUL（真机踩过）
    var wsc: Config = cfg_default();
    cfg_pin_api(&wsc, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    if agent_workspace_set_cwd(&wsc) {
        if buf_has_nul(&wsc.workspace) {
            ty_fail(tag, "工作目录里残留了 NUL", &ok);
        }
        if wsc.workspace.len == 0 {
            ty_fail(tag, "工作目录为空", &ok);
        }
    }
    cfg_free(&wsc);

    // 中断时保留「非空白前缀」的规则（DSH 语义）
    const trim_in: &const byte = "abc  \n\t " as &const byte;
    const trimmed: usize = agent_trim_trailing_ws(trim_in, 8);
    if trimmed != 3 {
        ty_fail(tag, "尾部空白没有被裁掉", &ok);
    }
    const all_ws: &const byte = "  \n" as &const byte;
    if agent_trim_trailing_ws(all_ws, 3) != 0 {
        ty_fail(tag, "全空白应裁成 0", &ok);
    }
    const none_ws: &const byte = "keep" as &const byte;
    if agent_trim_trailing_ws(none_ws, 4) != 4 {
        ty_fail(tag, "无尾部空白不该改动长度", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}


// ============================================================
// P4 会话自测：写日志 → 逐行校验 → 崩溃尾部裁剪 → 恢复重建历史
// ============================================================
fn sess_round(tag: &const byte) bool {
    var ok: bool = true;
    var home: Buf = buf_new(512);
    defer { buf_free(&home); }
    _ = buf_append_cstr(&home, "build/selftest_sess_home");
    _ = buf_append_byte(&home, 0);
    _ = sess_mkdir_p(home.ptr as &const byte);
    // 清掉旧文件，保证这一轮是干净的
    var idx: Buf = buf_new(600);
    defer { buf_free(&idx); }
    _ = buf_append_cstr(&idx, "build/selftest_sess_home/index.jsonl");
    _ = buf_append_byte(&idx, 0);
    _ = sys_unlink(idx.ptr as *const byte) catch {};

    // ---- 1) 写：header + 若干事件 ----
    var log: SessionLog = sess_log_empty();
    defer { sess_log_free(&log); }
    if !sess_open(&log, "build/selftest_sess_home", "build/selftest_sess_ws", "selftest-model", "uya-agent", "", true, 0 as i64, true) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: sess_open\\n");
        return false;
    }
    if log.id.len < 10 || log.path.len == 0 {
        ty_fail(tag, "会话 id/路径没生成", &ok);
    }
    var ev: Buf = buf_new(4096);
    defer { buf_free(&ev); }
    // user/message
    if !sess_begin(&log, "user/message", &ev) {
        ty_fail(tag, "sess_begin 失败", &ok);
    }
    _ = buf_append_cstr(&ev, "{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":");
    _ = jw_str_into(&ev, "写一个 hello\n带换行 \"引号\"", bufx_cstr_len("写一个 hello\n带换行 \"引号\""));
    _ = buf_append_cstr(&ev, "}],\"source\":{\"kind\":\"user\"}}");
    _ = sess_end(&log, &ev);
    // assistant/message（带 tool_calls，arguments 里有转义）
    if !sess_begin(&log, "assistant/message", &ev) {
        ty_fail(tag, "assistant 事件开始失败", &ok);
    }
    _ = buf_append_cstr(&ev, "{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":\"我来写\",\"tool_calls\":[{\"id\":\"call_s1\",\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"arguments\":");
    _ = jw_str_into(&ev, "{\"path\":\"note.txt\",\"content\":\"hello\"}", bufx_cstr_len("{\"path\":\"note.txt\",\"content\":\"hello\"}"));
    _ = buf_append_cstr(&ev, "}}]},\"usage\":{\"inputTokens\":7}}");
    _ = sess_end(&log, &ev);
    // tool/result
    if !sess_begin(&log, "tool/result", &ev) {
        ty_fail(tag, "tool/result 事件开始失败", &ok);
    }
    _ = buf_append_cstr(&ev, "{\"turn\":1,\"step\":1,\"callId\":\"call_s1\",\"content\":");
    // P15：控制字节（NUL、0x01）必须**按字节**往返 —— 写入端把它们转义成 \u00XX，
    // 读回时若只去一个反斜杠，NUL 就变成字面量 `u0000`（内容被悄悄改掉）。
    var ctrl: Buf = buf_new(16);
    defer { buf_free(&ctrl); }
    _ = buf_append_cstr(&ctrl, "A");
    _ = buf_append_byte(&ctrl, 0);
    _ = buf_append_cstr(&ctrl, "B");
    _ = buf_append_byte(&ctrl, 1);
    _ = buf_append_cstr(&ctrl, "C");
    _ = jw_str_into(&ev, ctrl.ptr as &const byte, ctrl.len);
    _ = buf_append_cstr(&ev, "}");
    _ = sess_end(&log, &ev);
    buf_reset(&log.title);
    _ = buf_append_cstr(&log.title, "写一个 hello");
    if log.events != 3 {
        ty_fail(tag, "事件计数不对", &ok);
    }
    var id_copy: Buf = buf_new(64);
    defer { buf_free(&id_copy); }
    _ = buf_append(&id_copy, log.id.ptr, log.id.len);
    var path_copy: Buf = buf_new(1200);
    defer { buf_free(&path_copy); }
    _ = buf_append(&path_copy, log.path.ptr, log.path.len);
    _ = buf_append_byte(&path_copy, 0);
    sess_close(&log, "build/selftest_sess_home");

    // ---- 2) 读回：header、逐行事件、字段还原 ----
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path_copy.ptr as &const byte, &r) {
        ty_fail(tag, "会话文件读不回来", &ok);
        return ok;
    }
    if !r.header_ok || r.id.len == 0 {
        ty_fail(tag, "header 没解析出来", &ok);
    }
    if !bufx_eq_cstr(r.id.ptr as &const byte, r.id.len, id_copy.ptr as &const byte) && r.id.len != id_copy.len {
        ty_fail(tag, "header id 与写入不一致", &ok);
    }
    var line: Buf = buf_new(8192);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    var args: Buf = buf_new(8192);
    defer { buf_free(&args); }
    var n_lines: i32 = 0;
    var expect_seq: i64 = 0;
    var saw_user: bool = false;
    var saw_calls: bool = false;
    var saw_result: bool = false;
    while sess_next(&r, &line) {
        n_lines = n_lines + 1;
        const seq: i64 = sess_line_seq(&line);
        if seq != expect_seq {
            ty_fail(tag, "seq 不连续", &ok);
        }
        expect_seq = seq + 1;
        if !sess_line_type(&line, &typ) {
            ty_fail(tag, "事件没有 type", &ok);
            continue;
        }
        const view: &[byte] = line.ptr[0: line.len];
        if sv_eq_cstr(&typ, "user/message") {
            saw_user = true;
            if !sess_json_str(view, "text", &text) || !sess_line_has(&text, "带换行") {
                ty_fail(tag, "用户文本没有正确落盘/反转义", &ok);
            }
        } else if sv_eq_cstr(&typ, "assistant/message") {
            if !sess_extract_array(view, "tool_calls", &args) {
                ty_fail(tag, "tool_calls 数组没提取出来", &ok);
            } else {
                saw_calls = true;
                if !sess_line_has(&args, "call_s1") {
                    ty_fail(tag, "tool_calls 里没有 call_s1", &ok);
                }
                if !sess_line_has(&args, "\\\"path\\\"") {
                    ty_fail(tag, "arguments 的转义层级不对", &ok);
                }
            }
        } else if sv_eq_cstr(&typ, "tool/result") {
            saw_result = true;
            if !sess_json_str(view, "callId", &text) || !sess_line_has(&text, "call_s1") {
                ty_fail(tag, "tool/result 的 callId 不对", &ok);
            }
            if !sess_json_str(view, "content", &text) || !sv_buf_eq(&text, &ctrl) {
                ty_fail(tag, "content 里的控制字节没有按字节往返（\\u00XX 被读成字面量？）", &ok);
                out_err("[sess content] 得到 ");
                out_err_bytes(text.ptr as &const byte, text.len);
                out_err("\n");
            }
        }
    }
    if n_lines != 3 || !saw_user || !saw_calls || !saw_result {
        ty_fail(tag, "读回的事件条数/种类不对", &ok);
    }
    if r.dropped_tail {
        ty_fail(tag, "正常文件不该被判为截断", &ok);
    }

    // ---- 3) 崩溃尾部：手动追加半条记录，读的时候必须丢掉它 ----
    var ap: Buf = buf_new(1300);
    defer { buf_free(&ap); }
    _ = buf_append_cstr(&ap, path_copy.ptr as &const byte);
    _ = buf_append_byte(&ap, 0);
    const flags: i32 = (O_WRONLY | O_APPEND) as i32;
    const fd: i32 = sys_open(ap.ptr as *const byte, flags, 420) catch {
        -1;
    };
    if fd >= 0 {
        const half: &const byte = "{\"type\":\"tool/result\",\"seq\":3,\"time\":1,\"data\":{\"callId\":\"call_x\"" as &const byte;
        _ = write_all_fd(fd, half, bufx_cstr_len(half));
        _ = sys_close(fd) catch {};
    }
    var r2: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r2); }
    if !sess_reader_load(ap.ptr as &const byte, &r2) {
        ty_fail(tag, "带残缺尾部的文件读不回来", &ok);
    }
    var n2: i32 = 0;
    while sess_next(&r2, &line) {
        n2 = n2 + 1;
    }
    if n2 != 3 {
        ty_fail(tag, "残缺尾部应被丢弃（应读到 3 条）", &ok);
    }
    if !r2.dropped_tail {
        ty_fail(tag, "没有标记 dropped_tail", &ok);
    }

    // ---- 4) 恢复：用日志重建消息历史 ----
    var h: History = hist_init();
    defer { hist_free(&h); }
    var next_seq0: i64 = 0;
    var c_hist: Config = cfg_default();
    cfg_pin_api(&c_hist, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    c_hist.model = buf_new(32);
    _ = buf_append_cstr(&c_hist.model, "selftest-model");
    c_hist.workspace = buf_new(64);
    _ = buf_append_cstr(&c_hist.workspace, "build/selftest_sess_ws");
    // P18：这个调用点不折叠统计（历史恢复而已）；resume 路径传 true
    const restored: i32 = agent_hist_from_log(&c_hist, &h, &path_copy, &next_seq0, false);
    cfg_free(&c_hist);
    if restored != 3 {
        ty_fail(tag, "恢复的消息条数不对", &ok);
    }
    // system +（运行上下文等注入）+ user + assistant(带 calls) + tool
    // 注入条数不固定（AGENTS.md 取决于工作区），所以从**尾部**校验恢复出来的三条
    const nmsg: usize = h.len;
    if nmsg < 4 {
        ty_fail(tag, "恢复后的历史长度不对", &ok);
    } else if msg_role_at(&h, nmsg - 2) != ROLE_ASSISTANT_CALLS || msg_role_at(&h, nmsg - 1) != ROLE_TOOL {
        ty_fail(tag, "恢复后的角色不对", &ok);
    } else if !msg_extra_is(&h, nmsg - 1, "call_s1") {
        ty_fail(tag, "恢复后的 tool_call_id 不对", &ok);
    } else {
        // 恢复出来的历史必须能原样再序列化成请求
        var req: Buf = buf_new(65536);
        defer { buf_free(&req); }
        var c2: Config = cfg_default();
        cfg_pin_api(&c2, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
        c2.model = buf_new(32);
        _ = buf_append_cstr(&c2.model, "selftest-model");
        if !build_model_request(&c2, &h, &req, LLM_STYLE_CHAT) {
            ty_fail(tag, "恢复的历史无法组装请求", &ok);
        } else if !contains(&req, "\"tool_call_id\":\"call_s1\"") || !contains(&req, "\"tool_calls\"") {
            ty_fail(tag, "恢复的历史里缺少严格协议字段", &ok);
        }
        cfg_free(&c2);
    }

    // ---- 5) 索引 + 最近会话查找 ----
    if !sess_find_last("build/selftest_sess_home", "", &line) {
        ty_fail(tag, "sess_find_last 找不到刚写的会话", &ok);
    }
    var fpath: Buf = buf_new(1200);
    defer { buf_free(&fpath); }
    if !sess_find("build/selftest_sess_home", "build/selftest_sess_ws", id_copy.ptr as &const byte, id_copy.len, &fpath) {
        ty_fail(tag, "sess_find 按 id 找不到会话", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\\n");
    }
    return ok;
}

// 会话日志缓冲 b 里是否含子串 lit（按 C 串取长度，内部 find_sub）。
fn sess_line_has(b: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if b.len < n {
        return false;
    }
    return find_sub(b.ptr[0: b.len], lit[0: n], 0) >= 0;
}

// 两个 Buf 是否逐字节相同（内容里有 NUL 时不能拿 C 字符串比）
fn sv_buf_eq(a: &const Buf, b: &const Buf) bool {
    if a.len != b.len {
        return false;
    }
    return bufx_mem_eq(a.ptr as &const byte, b.ptr as &const byte, a.len);
}


// ============================================================
// P5 自测：DSH 设置解析（假 DSH_HOME）+ YAML 预处理
// ============================================================
// 历史消息的安全访问（历史是堆数组，边界用 h.len 判）
fn msg_role_at(h: &const History, i: usize) u8 {
    if i >= h.len {
        return 255;
    }
    return msg_at(h, i).role;
}

// 历史第 i 条消息的 extra 字段（tool_call_id 之类）是否等于 lit；越界 / extra 为空即 false。
fn msg_extra_is(h: &const History, i: usize, lit: &const byte) bool {
    if i >= h.len {
        return false;
    }
    const m: &const Msg = msg_at(h, i);
    if m.extra_len == 0 {
        return false;
    }
    return bufx_eq_cstr(m.extra as &const byte, m.extra_len, lit);
}

// ============================================================
// hist-repair 轮：尾部修复（hist_trim_incomplete_tail）必须**只丢不完整的一组**
//
// 旧的实现无条件丢掉结尾的 tool / assistant(tool_calls)，于是「恢复会话」这种再正常
// 不过的操作都会把最后一步白丢掉；反过来，只丢一半的组又会留下悬空 tool_calls，
// 端点必然 400（本项目真实踩到过）。
// ============================================================
const HIST_CALLS_1: &const byte = "[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"bash\",\"arguments\":\"{}\"}}]";
const HIST_CALLS_2: &const byte = "[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"bash\",\"arguments\":\"{}\"}},{\"id\":\"c2\",\"type\":\"function\",\"function\":{\"name\":\"bash\",\"arguments\":\"{}\"}}]";

// 往历史里追加一条文本消息（role + C 串正文）。返回 false = 追加失败或超出历史上限。
// 自测夹具专用，走的是 hist_push 的正式路径。
fn hist_push_text(h: &History, role: u8, lit: &const byte) bool {
    return hist_push(h, role, lit, bufx_cstr_len(lit));
}

// 往历史里追加一条 assistant 的 tool_calls 消息（正文为空，calls 为 JSON 串）。
// 返回 false = 追加失败；配套的 tool 结果必须紧跟（见 hist_push_tool）。
fn hist_push_calls(h: &History, calls: &const byte) bool {
    return hist_push_msg(h, ROLE_ASSISTANT_CALLS, null, 0, calls, bufx_cstr_len(calls));
}

// 往历史里追加一条 tool 结果（tool_call_id = id，正文 = lit）。
// 返回 false = 追加失败；必须与前面的 tool_calls 配对，否则端点 400。
fn hist_push_tool(h: &History, id: &const byte, lit: &const byte) bool {
    return hist_push_msg(h, ROLE_TOOL, lit, bufx_cstr_len(lit), id, bufx_cstr_len(id));
}

// 给历史铺底：一条 SYS + 一条 TASK（role 固定）。返回 false = 任一条追加失败。
fn hist_seed(h: &History) bool {
    return hist_push_text(h, ROLE_SYSTEM, "SYS") && hist_push_text(h, ROLE_USER, "TASK");
}

// h.bytes 必须等于各条 text_len+extra_len 之和（裁剪/回滚都要维护它）
fn hist_bytes_ok(h: &const History) bool {
    var sum: usize = 0;
    var i: usize = 0;
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        sum = sum + m.text_len + m.extra_len;
        i = i + 1;
    }
    return sum == h.bytes;
}


// ============================================================
// img-sniff（P50）：图片识别与尺寸解析（纯函数）
//
// 为什么要单独钉：尺寸是**从文件头算出来**的（不解码像素），四种格式的头布局各不相同
// （PNG 大端、GIF 小端、JPEG 要走段链、WebP 有三个变体）。算错的话预算判定会放行一张
// 其实超限的图，网关那边就是一个 400 —— 现场很难看出「是尺寸算错了」。
//
// 用的是**真字节**（下面这张 64×48 的 PNG 是 zlib 压出来再逐字节抄进来的），
// 不是手写的假头：假头只能测到「我们自己的假设」，测不到真实文件布局。
// ============================================================
const IMG_PNG_64x48: [byte: 124] = [
    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
    0, 0, 0, 64, 0, 0, 0, 48, 8, 2, 0, 0, 0, 46, 41, 235,
    72, 0, 0, 0, 67, 73, 68, 65, 84, 120, 218, 237, 207, 65, 9, 0,
    0, 8, 4, 176, 75, 98, 48, 19, 27, 203, 10, 126, 133, 193, 10, 44,
    83, 253, 90, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4,
    4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4,
    4, 4, 4, 4, 4, 174, 22, 52, 131, 0, 226, 233, 119, 149, 144, 0,
    0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130,
];



// img-sniff 轮（P50）：用内嵌的 PNG 字节测纯函数——嗅探类型、解析尺寸与字节大小。
// 夹具是常量数组，不读盘不联网；返回 false = 本轮红。
fn img_round(tag: &const byte) bool {
    var ok: bool = true;
    // 占位行断言的三个片段。函数内 const 才不会把数组推断成 int32
    // （模块级 const 会 —— 本轮实测的编译错误）。
    const img_lbl_dim: [byte: 6] = [54, 52, 195, 151, 52, 56];            // "64×48"
    const img_lbl_mime: [byte: 9] = [105, 109, 97, 103, 101, 47, 112, 110, 103];
    const img_lbl_size: [byte: 5] = [49, 50, 52, 32, 66];                  // "124 B"
    out_err("selftest[");
    out_err(tag);
    out_err("] ");

    // 1) PNG：尺寸从 IHDR 读出来（64×48）
    var info: ImgInfo = ImgInfo{ kind: IMGX_NONE, width: 0, height: 0, bytes: 0 };
    if !imgx_sniff(&IMG_PNG_64x48[0], 124, &info) {
        ty_fail(tag, "真 PNG 没被认出来", &ok);
    } else {
        if info.kind != IMGX_PNG {
            ty_fail(tag, "PNG 的类型不对", &ok);
        }
        if info.width != 64 || info.height != 48 {
            ty_fail(tag, "PNG 尺寸读错了（应当 64×48）", &ok);
        }
        if info.bytes != 124 {
            ty_fail(tag, "PNG 字节数不对", &ok);
        }
    }

    // 2) MIME / 扩展名 / 反查
    if !bufx_eq_cstr(imgx_mime(IMGX_PNG), 9, "image/png") {
        ty_fail(tag, "PNG 的 MIME 不对", &ok);
    }
    if !bufx_eq_cstr(imgx_mime(IMGX_JPEG), 10, "image/jpeg") {
        ty_fail(tag, "JPEG 的 MIME 不对", &ok);
    }
    if !bufx_eq_cstr(imgx_ext(IMGX_WEBP), 4, "webp") {
        ty_fail(tag, "WebP 的扩展名不对", &ok);
    }
    if imgx_kind_of_mime("image/gif" as &const byte, 9) != IMGX_GIF {
        ty_fail(tag, "MIME 反查 GIF 失败", &ok);
    }
    if imgx_kind_of_mime("text/plain" as &const byte, 10) != IMGX_NONE {
        ty_fail(tag, "非图片 MIME 被当成了图片", &ok);
    }

    // 3) GIF：小端 + 魔数两个版本（GIF87a / GIF89a）
    var gif: [byte: 14] = [71,73,70,56,57,97,20,0,10,0,0,0,0,0];
    if !imgx_sniff(&gif[0], 14, &info) || info.kind != IMGX_GIF {
        ty_fail(tag, "GIF89a 没被认出来", &ok);
    } else if info.width != 20 || info.height != 10 {
        ty_fail(tag, "GIF 尺寸读错了（小端 20×10）", &ok);
    }
    gif[3] = 56;   // '8'
    gif[4] = 55;   // '7'  → GIF87a
    if !imgx_sniff(&gif[0], 14, &info) || info.kind != IMGX_GIF {
        ty_fail(tag, "GIF87a 没被认出来", &ok);
    }

    // 4) JPEG：段链要走过去才能到 SOF（长度段在前，尺寸不在固定偏移）
    //    FFD8 + FFE0(APP0, 长度 16) + 14 字节负载 + FFC0(SOF0) + 长度 17 + 精度 + 高 7 + 宽 9
    var jpg: [byte: 34] = [0: 34];
    jpg[0] = 255;
    jpg[1] = 216;
    jpg[2] = 255;
    jpg[3] = 224;
    jpg[4] = 0;
    jpg[5] = 16;
    // APP0 段头在 i=2，长度字段 16 ⇒ 下一段从 2+2+16 = 20 开始
    jpg[20] = 255;
    jpg[21] = 192;
    jpg[22] = 0;
    jpg[23] = 17;
    jpg[24] = 8;
    jpg[25] = 0;
    jpg[26] = 7;    // 高 7
    jpg[27] = 0;
    jpg[28] = 9;    // 宽 9
    if !imgx_sniff(&jpg[0], 34, &info) || info.kind != IMGX_JPEG {
        ty_fail(tag, "JPEG 没被认出来（段链没走过去？）", &ok);
    } else if info.width != 9 || info.height != 7 {
        ty_fail(tag, "JPEG 尺寸读错了（应当 9×7）", &ok);
    }

    // 5) WebP 三变体：VP8X（24 位宽高）、VP8L（14 位打包）、VP8 （14 位）
    var w1: [byte: 30] = [0: 30];
    w1[0] = 82; w1[1] = 73; w1[2] = 70; w1[3] = 70;   // RIFF
    w1[8] = 87; w1[9] = 69; w1[10] = 66; w1[11] = 80; // WEBP
    w1[12] = 86; w1[13] = 80; w1[14] = 56; w1[15] = 88; // VP8X
    w1[24] = 99;  // 宽 = 100（存 99）
    w1[27] = 49;  // 高 = 50（存 49）
    if !imgx_sniff(&w1[0], 30, &info) || info.kind != IMGX_WEBP {
        ty_fail(tag, "WebP/VP8X 没被认出来", &ok);
    } else if info.width != 100 || info.height != 50 {
        ty_fail(tag, "WebP/VP8X 尺寸读错了（应当 100×50）", &ok);
    }
    // VP8L：bits = (宽-1) | (高-1)<<14 → 宽 5 高 3 = 4 | (2<<14) = 32772
    var w2: [byte: 30] = [0: 30];
    w2[0] = 82; w2[1] = 73; w2[2] = 70; w2[3] = 70;
    w2[8] = 87; w2[9] = 69; w2[10] = 66; w2[11] = 80;
    w2[12] = 86; w2[13] = 80; w2[14] = 56; w2[15] = 76; // VP8L
    w2[20] = 47;  // 0x2F 签名
    w2[21] = 4;
    w2[22] = 128; // (2<<14) 的低字节 = 0x80
    if !imgx_sniff(&w2[0], 30, &info) || info.kind != IMGX_WEBP {
        ty_fail(tag, "WebP/VP8L 没被认出来", &ok);
    } else if info.width != 5 || info.height != 3 {
        ty_fail(tag, "WebP/VP8L 尺寸读错了（应当 5×3）", &ok);
    }

    // 6) 不认识的东西一律拒绝（绝不猜一个尺寸往下走）
    const notimg: &const byte = "hello, this is not an image at all" as &const byte;
    if imgx_sniff(notimg, 33, &info) {
        ty_fail(tag, "纯文本被当成了图片", &ok);
    }
    if info.kind != IMGX_NONE {
        ty_fail(tag, "嗅探失败后 kind 没复位", &ok);
    }
    // 截断的 PNG（有签名没 IHDR）也必须拒
    if imgx_sniff(&IMG_PNG_64x48[0], 20, &info) {
        ty_fail(tag, "截断的 PNG 被当成了完整图片", &ok);
    }

    // 7) 预算判定：字节超限 / 像素超限 / 通过
    var why: Buf = buf_new(256);
    defer { buf_free(&why); }
    var small: ImgInfo = ImgInfo{ kind: IMGX_PNG, width: 64, height: 48, bytes: 124 };
    if imgx_check(&small, 0, 0, &why) != IMGX_OK {
        ty_fail(tag, "正常图片被拒了", &ok);
    }
    if why.len != 0 {
        ty_fail(tag, "通过时不该有拒绝理由", &ok);
    }
    if imgx_check(&small, 100, 0, &why) != IMGX_E_TOO_BIG {
        ty_fail(tag, "字节超限没被拒", &ok);
    }
    if why.len == 0 {
        ty_fail(tag, "字节超限没给理由", &ok);
    }
    if imgx_check(&small, 0, 100, &why) != IMGX_E_TOO_MANY_PIXELS {
        ty_fail(tag, "像素超限没被拒", &ok);
    }
    var nokind: ImgInfo = ImgInfo{ kind: IMGX_NONE, width: 0, height: 0, bytes: 0 };
    if imgx_check(&nokind, 0, 0, &why) != IMGX_E_UNKNOWN {
        ty_fail(tag, "不认识的格式没被拒", &ok);
    }

    // 8) 附件 id 是内容寻址（同内容同 id、不同内容不同 id）
    var id1: Buf = buf_new(80);
    defer { buf_free(&id1); }
    var id2: Buf = buf_new(80);
    defer { buf_free(&id2); }
    imgx_id_of(&IMG_PNG_64x48[0], 124, &id1);
    imgx_id_of(&IMG_PNG_64x48[0], 124, &id2);
    if id1.len != 64 || !bufx_mem_eq(id1.ptr as &const byte, id2.ptr as &const byte, 64) {
        ty_fail(tag, "同内容的附件 id 不稳定（应当同 id）", &ok);
    }
    var id3: Buf = buf_new(80);
    defer { buf_free(&id3); }
    imgx_id_of(&IMG_PNG_64x48[0], 123, &id3);
    if bufx_mem_eq(id1.ptr as &const byte, id3.ptr as &const byte, 64) {
        ty_fail(tag, "不同内容算出了同一个附件 id", &ok);
    }

    // 9) base64（与 Python 的 base64 对照：124 字节 → 168 字符含 padding）
    var b64: Buf = buf_new(256);
    defer { buf_free(&b64); }
    if !imgx_b64(&IMG_PNG_64x48[0], 124, &b64) {
        ty_fail(tag, "base64 编码失败", &ok);
    } else {
        if b64.len != 168 {
            ty_fail(tag, "base64 长度不对（124 字节应当是 168 字符）", &ok);
        }
        // PNG 签名 base64 之后固定是 iVBORw0KGgo
        if !bufx_mem_eq(b64.ptr as &const byte, "iVBORw0KGgo" as &const byte, 11) {
            ty_fail(tag, "base64 头部不对（PNG 签名应当是 iVBORw0KGgo）", &ok);
        }
        if b64.ptr[b64.len - 1] != 61 as byte {
            ty_fail(tag, "base64 结尾应当是 '='（padding）", &ok);
        }
    }

    // 10) 附件 JSON 往返（写出去再解析回来，字段逐项相同）
    var list: ImgList = imgx_list_new();
    defer { imgx_list_free(&list); }
    var r: ImgRef = ImgRef{
        kind: IMGX_PNG, width: 64, height: 48, bytes: 124,
        path: buf_empty(), name: buf_empty(),
    };
    var pbuf: Buf = buf_new(64);
    defer { buf_free(&pbuf); }
    _ = buf_append_cstr(&pbuf, "/tmp/x.png");
    var nbuf: Buf = buf_new(16);
    defer { buf_free(&nbuf); }
    _ = buf_append_cstr(&nbuf, "x.png");
    r.path = pbuf;
    r.name = nbuf;
    if !imgx_list_push(&list, &r) {
        ty_fail(tag, "附件入表失败", &ok);
    }
    var js: Buf = buf_new(512);
    defer { buf_free(&js); }
    if !imgx_list_json(&list, &js) {
        ty_fail(tag, "附件 JSON 序列化失败", &ok);
    }
    var back: ImgList = imgx_list_new();
    defer { imgx_list_free(&back); }
    if !imgx_list_parse(js.ptr as &const byte, js.len, &back) {
        ty_fail(tag, "附件 JSON 解析失败", &ok);
    } else {
        if back.len != 1 {
            ty_fail(tag, "往返之后条目数不对", &ok);
        } else {
            if back.items[0].kind != IMGX_PNG || back.items[0].width != 64 || back.items[0].height != 48 || back.items[0].bytes != 124 {
                ty_fail(tag, "往返之后元数据不对", &ok);
            }
            if back.items[0].path.len != 10 || !bufx_mem_eq(back.items[0].path.ptr as &const byte, "/tmp/x.png" as &const byte, 10) {
                ty_fail(tag, "往返之后路径不对", &ok);
            }
            if back.items[0].name.len != 5 || !bufx_mem_eq(back.items[0].name.ptr as &const byte, "x.png" as &const byte, 5) {
                ty_fail(tag, "往返之后展示名不对", &ok);
            }
        }
    }
    // 坏记录不许把整段废掉：一个坏项 + 一个好项 → 只留好的
    const mixed: &const byte = "[{\"mime\":\"image/png\",\"path\":\"\"},{\"mime\":\"image/png\",\"path\":\"/tmp/ok.png\",\"w\":1,\"h\":1,\"bytes\":2}]" as &const byte;
    var mb: ImgList = imgx_list_new();
    defer { imgx_list_free(&mb); }
    if !imgx_list_parse(mixed, bufx_cstr_len(mixed), &mb) {
        ty_fail(tag, "混合记录里好的那一项没留下", &ok);
    } else if mb.len != 1 || mb.items[0].path.len != 11 {
        // "/tmp/ok.png" 是 **11** 字节（不是 12）—— 手数长度又错了一次（踩坑 77 同族）
        ty_fail(tag, "坏记录没被跳过（或者好记录被误删）", &ok);
    }

    // 11) 占位文案（终端不渲染图片，这一行是全部证据 —— 数字必须是真的）
    var lbl: Buf = buf_new(256);
    defer { buf_free(&lbl); }
    imgx_label(&r, &lbl);
    if find_sub(lbl.ptr[0: lbl.len], &img_lbl_dim[0: 6], 0) < 0 {
        ty_fail(tag, "占位行里没有尺寸", &ok);
    }
    if find_sub(lbl.ptr[0: lbl.len], &img_lbl_mime[0: 9], 0) < 0 {
        ty_fail(tag, "占位行里没有 MIME", &ok);
    }
    if find_sub(lbl.ptr[0: lbl.len], &img_lbl_size[0: 5], 0) < 0 {
        ty_fail(tag, "占位行里没有大小", &ok);
    }
    // 大小格式化：B / KiB / MiB 三档
    var fb: Buf = buf_new(64);
    defer { buf_free(&fb); }
    imgx_fmt_bytes(512, &fb);
    if !bufx_eq_cstr(fb.ptr as &const byte, fb.len, "512 B") {
        ty_fail(tag, "512 字节的显示不对", &ok);
    }
    buf_reset(&fb);
    imgx_fmt_bytes(1536, &fb);
    if !bufx_eq_cstr(fb.ptr as &const byte, fb.len, "1.5 KiB") {
        ty_fail(tag, "1536 字节的显示不对（应当 1.5 KiB）", &ok);
    }
    buf_reset(&fb);
    imgx_fmt_bytes(3 * 1024 * 1024 + 512 * 1024, &fb);
    if !bufx_eq_cstr(fb.ptr as &const byte, fb.len, "3.5 MiB") {
        ty_fail(tag, "3.5 MiB 的显示不对", &ok);
    }

    if ok {
        out_err("ok（真 PNG 尺寸/四种格式嗅探/预算/内容寻址 id/base64/JSON 往返/占位文案）");
    }
    out_err("\n");
    return ok;
}


// ============================================================
// clip-parse（P51）：X11 客户端的可测部分（纯函数 + 不依赖 X 会话的行为）
//
// 为什么只测这些：真读剪贴板要一个 X 会话与一个 owner（GTK 才能当 owner），
// 那是 `make e2e-clip` 那条真机腿的事（没有 X 会话就 skip，与 san-shell 缺 bwrap 同口径）。
// 这里钉的是**最容易写错、又不需要环境**的部分：
//   * DISPLAY 解析（`:0` / `unix:0` / `host:0` / `:0.0` / 空 / 畸形）；
//   * ~/.Xauthority 的解析（真格式：family 256 + MIT-MAGIC-COOKIE-1 + display 号配对）；
//   * 请求长度字段（含 pad）—— 这条曾经真错过：长度少算一格会让服务端把请求体尾部
//     当成下一条请求的开头，随后是一连串看不懂的 X 错误；
//   * 结果码 → 人话（绝不留空白文案）。
// ============================================================
// 设一个环境变量（值按 C 串给；自测里改 DISPLAY/HOME 用）。
// 注意函数名是 libc 的 `setenv`（不是 sys_setenv —— 那个不存在，本轮编译错误）。
fn setenv_cstr(name: &const byte, value: &const byte) bool {
    return setenv(name, value, 1) == 0;
}

// 写**定长**字节到文件（write_text_file 按 C 串扫，遇到 0 字节就截断 ——
// Xauthority 这种二进制文件必须用这个）
fn write_raw_file(path_z: &const byte, p: &const byte, n: usize) bool {
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(path_z as *const byte, flags, 420) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    return write_all_fd(fd, p, n);
}

// clip-parse 轮（P51）：X11 客户端里不依赖真 X 会话的那部分——DISPLAY 解析、畸形拒绝、
// Xauthority 配对与失败文案。会让环境变量（DISPLAY/HOME）并在结束时还原；返回 false = 本轮红。
fn clip_round(tag: &const byte) bool {
    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");

    // 1) DISPLAY 解析：正常形态
    var sock: Buf = buf_new(64);
    defer { buf_free(&sock); }
    // 用 setenv 造各种 DISPLAY（自测进程自己的环境，跑完恢复原值）
    var saved: Buf = env_or("DISPLAY" as &const byte, "" as &const byte);
    defer {
        if saved.len > 0 {
            var z: Buf = buf_new(saved.len + 2);
            defer { buf_free(&z); }
            _ = buf_append(&z, saved.ptr as &const byte, saved.len);
            _ = buf_append_byte(&z, 0);
            _ = setenv("DISPLAY" as &const byte, z.ptr as &const byte, 1);
        }
    }
    if !setenv_cstr("DISPLAY" as &const byte, ":0" as &const byte) {
        ty_fail(tag, "设置 DISPLAY 失败", &ok);
    }
    if !clipx_display_socket(&sock) {
        ty_fail(tag, ":0 应当能解析成 socket 路径", &ok);
    } else if !bufx_eq_cstr(sock.ptr as &const byte, sock.len - 1, "/tmp/.X11-unix/X0") {
        ty_fail(tag, ":0 的 socket 路径不对", &ok);
    }
    _ = setenv_cstr("DISPLAY" as &const byte, "unix:7" as &const byte);
    if !clipx_display_socket(&sock) || !bufx_eq_cstr(sock.ptr as &const byte, sock.len - 1, "/tmp/.X11-unix/X7") {
        ty_fail(tag, "unix:7 没解析成 X7", &ok);
    }
    _ = setenv_cstr("DISPLAY" as &const byte, "somehost:1.0" as &const byte);
    if !clipx_display_socket(&sock) || !bufx_eq_cstr(sock.ptr as &const byte, sock.len - 1, "/tmp/.X11-unix/X1") {
        ty_fail(tag, "somehost:1.0 没解析成 X1（屏号要忽略）", &ok);
    }
    // 2) 畸形/空：必须拒绝，绝不猜一个路径去连
    _ = setenv_cstr("DISPLAY" as &const byte, "" as &const byte);
    if clipx_display_socket(&sock) {
        ty_fail(tag, "空 DISPLAY 被当成了可用", &ok);
    }
    _ = setenv_cstr("DISPLAY" as &const byte, "no-colon-here" as &const byte);
    if clipx_display_socket(&sock) {
        ty_fail(tag, "没有冒号的 DISPLAY 被当成了可用", &ok);
    }
    _ = setenv_cstr("DISPLAY" as &const byte, ":abc" as &const byte);
    if clipx_display_socket(&sock) {
        ty_fail(tag, "非数字 display 号被当成了可用", &ok);
    }

    // 3) ~/.Xauthority 解析：写一份真的进去（两个条目，第二个才是本 display）
    var home: Buf = env_or("HOME" as &const byte, "" as &const byte);
    defer { buf_free(&home); }
    if home.len == 0 {
        ty_fail(tag, "HOME 是空的，无法测 Xauthority", &ok);
    } else {
        var authdir: Buf = buf_new(home.len + 32);
        defer { buf_free(&authdir); }
        _ = buf_append(&authdir, home.ptr as &const byte, home.len);
        _ = buf_append_cstr(&authdir, "/.uya_clip_auth_test");
        // sess_mkdir_p 按 **C 串**扫（要 NUL），直接传 Buf 指针会读到缓冲区后面的垃圾
        var adz: Buf = buf_new(authdir.len + 2);
        defer { buf_free(&adz); }
        _ = buf_append(&adz, authdir.ptr as &const byte, authdir.len);
        _ = buf_append_byte(&adz, 0);
        _ = sess_mkdir_p(adz.ptr as &const byte);
        var authp: Buf = buf_new(authdir.len + 32);
        defer { buf_free(&authp); }
        _ = buf_append(&authp, authdir.ptr as &const byte, authdir.len);
        // 文件名必须是 **`.Xauthority`**（带点）—— clipx_auth_cookie 找的就是这个名字。
        // 我第一版写成 `Xauthority`，于是文件明明在磁盘上、解析却永远走「读不到」那条路。
        _ = buf_append_cstr(&authp, "/.Xauthority");
        // 条目：family(2,be) + addr + num + name + data（长度都是 be u16）
        var raw: Buf = buf_new(256);
        defer { buf_free(&raw); }
        // 条目一：display "9"（不该命中）
        _ = buf_append_byte(&raw, 1);
        _ = buf_append_byte(&raw, 0);         // family 256 = Local
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 0);         // addr 长度 0
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 1);
        _ = buf_append_byte(&raw, 57);        // num = "9"
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 18);
        _ = buf_append_cstr(&raw, "MIT-MAGIC-COOKIE-1");
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 2);
        _ = buf_append_byte(&raw, 170);
        _ = buf_append_byte(&raw, 187);
        // 条目二：display "0"，cookie = 4 字节 0xDE 0xAD 0xBE 0xEF
        _ = buf_append_byte(&raw, 1);
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 1);
        _ = buf_append_byte(&raw, 48);        // num = "0"
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 18);
        _ = buf_append_cstr(&raw, "MIT-MAGIC-COOKIE-1");
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 4);
        _ = buf_append_byte(&raw, 222);
        _ = buf_append_byte(&raw, 173);
        _ = buf_append_byte(&raw, 190);
        _ = buf_append_byte(&raw, 239);
        // write_text_file 的第二个参数按 **C 串**读（bufx_cstr_len 扫到 NUL 为止），
        // 而 raw 里有 0 字节（family 的高位、长度字段……）—— 直接传会被截断成空文件。
        // 所以这里自己补 NUL 并走原始 write。
        var rawz: Buf = buf_new(raw.len + 2);
        defer { buf_free(&rawz); }
        _ = buf_append(&rawz, raw.ptr as &const byte, raw.len);
        _ = buf_append_byte(&rawz, 0);
        var authz: Buf = buf_new(authp.len + 2);
        defer { buf_free(&authz); }
        _ = buf_append(&authz, authp.ptr as &const byte, authp.len);
        _ = buf_append_byte(&authz, 0);
        if !write_raw_file(authz.ptr as &const byte, rawz.ptr as &const byte, raw.len) {
            ty_fail(tag, "写假 Xauthority 失败", &ok);
        } else {
            // 让 clipx_auth_cookie 去读它：临时把 HOME 指到 authdir
            var saved_home: Buf = env_or("HOME" as &const byte, "" as &const byte);
            defer { buf_free(&saved_home); }
            // setenv 要 C 串：authdir 是 Buf（没有 NUL），必须借上面那个已补 NUL 的副本
            _ = setenv_cstr("HOME" as &const byte, adz.ptr as &const byte);
            var cookie: Buf = buf_new(64);
            defer { buf_free(&cookie); }
            if !clipx_auth_cookie("0" as &const byte, 1, &cookie) {
                ty_fail(tag, "display 0 的 cookie 没读出来", &ok);
            } else if cookie.len != 4 || cookie.ptr[0] != 222 as byte || cookie.ptr[3] != 239 as byte {
                ty_fail(tag, "cookie 的内容不对（应当 DE AD BE EF）", &ok);
            }
            // display 9 命中第一条（2 字节）
            var c9: Buf = buf_new(64);
            defer { buf_free(&c9); }
            if !clipx_auth_cookie("9" as &const byte, 1, &c9) || c9.len != 2 {
                ty_fail(tag, "display 9 应当命中第一条（2 字节）", &ok);
            }
            // 不存在的 display：必须失败，不许回退到别的条目
            var c5: Buf = buf_new(64);
            defer { buf_free(&c5); }
            if clipx_auth_cookie("5" as &const byte, 1, &c5) {
                ty_fail(tag, "不存在的 display 号竟然读到了 cookie", &ok);
            }
            var zh: Buf = buf_new(saved_home.len + 2);
            defer { buf_free(&zh); }
            _ = buf_append(&zh, saved_home.ptr as &const byte, saved_home.len);
            _ = buf_append_byte(&zh, 0);
            _ = setenv("HOME" as &const byte, zh.ptr as &const byte, 1);
        }
    }

    // 4) 结果码 → 人话：每个码都要有非空说明（空白文案等于静默失败）
    if bufx_cstr_len(clipx_reason(CLIPX_NO_X11)) == 0 {
        ty_fail(tag, "CLIPX_NO_X11 没有文案", &ok);
    }
    if bufx_cstr_len(clipx_reason(CLIPX_ERR)) == 0 {
        ty_fail(tag, "CLIPX_ERR 没有文案", &ok);
    }
    if bufx_cstr_len(clipx_reason(CLIPX_NONE)) == 0 {
        ty_fail(tag, "CLIPX_NONE 没有文案", &ok);
    }
    if bufx_cstr_len(clipx_reason(CLIPX_OK_UNUSED)) != 0 {
        ty_fail(tag, "成功码不该有「失败理由」文案", &ok);
    }

    if ok {
        out_err("ok（DISPLAY 解析/畸形拒绝/Xauthority 配对/失败文案）");
    }
    out_err("\n");
    return ok;
}

// hist-repair 轮：尾部修复（hist_trim_incomplete_tail）必须**只丢不完整的一组** ——
// 完整的一组（tool_calls + 等量 tool 结果）一条都不许少，半组要整体丢掉。返回 false = 本轮红。
fn hist_round(tag: &const byte) bool {
    var ok: bool = true;
    // 1) 完整的一组（2 个调用 + 2 条应答）：一条都不许丢
    var h1: History = hist_init();
    defer { hist_free(&h1); }
    if !hist_seed(&h1) || !hist_push_calls(&h1, HIST_CALLS_2) || !hist_push_tool(&h1, "c1", "R1") || !hist_push_tool(&h1, "c2", "R2") {
        ty_fail(tag, "构造历史失败(1)", &ok);
        return ok;
    }
    if !hist_pairing_ok(&h1) {
        ty_fail(tag, "完整的一组被判成不完整(1)", &ok);
    }
    if hist_trim_incomplete_tail(&h1) != 0 || h1.len != 5 {
        ty_fail(tag, "完整的一组被裁掉了（旧实现对完整组也照丢）", &ok);
    }
    if !hist_bytes_ok(&h1) {
        ty_fail(tag, "h.bytes 记账不对(1)", &ok);
    }

    // 2) 2 个调用只回了 1 条：整组丢掉
    var h2: History = hist_init();
    defer { hist_free(&h2); }
    if !hist_seed(&h2) || !hist_push_calls(&h2, HIST_CALLS_2) || !hist_push_tool(&h2, "c1", "R1") {
        ty_fail(tag, "构造历史失败(2)", &ok);
        return ok;
    }
    if hist_pairing_ok(&h2) {
        ty_fail(tag, "缺应答的历史被判成配对完整(2)", &ok);
    }
    if hist_trim_incomplete_tail(&h2) != 2 || h2.len != 2 {
        ty_fail(tag, "缺应答的一组没有整组丢掉(2)", &ok);
    }
    if !hist_pairing_ok(&h2) || !hist_bytes_ok(&h2) {
        ty_fail(tag, "修复后的历史仍不合法(2)", &ok);
    }

    // 3) 一个应答都没有（真实故障留下的形状）：丢掉那条 assistant
    var h3: History = hist_init();
    defer { hist_free(&h3); }
    if !hist_seed(&h3) || !hist_push_calls(&h3, HIST_CALLS_1) {
        ty_fail(tag, "构造历史失败(3)", &ok);
        return ok;
    }
    if hist_trim_incomplete_tail(&h3) != 1 || h3.len != 2 {
        ty_fail(tag, "零应答的 assistant 没有丢掉(3)", &ok);
    }

    // 4) tool_call_id 对不上：整组丢掉
    var h4: History = hist_init();
    defer { hist_free(&h4); }
    if !hist_seed(&h4) || !hist_push_calls(&h4, HIST_CALLS_2) || !hist_push_tool(&h4, "c1", "R1") || !hist_push_tool(&h4, "cX", "R2") {
        ty_fail(tag, "构造历史失败(4)", &ok);
        return ok;
    }
    if hist_pairing_ok(&h4) {
        ty_fail(tag, "id 对不上的历史被判成配对完整(4)", &ok);
    }
    if hist_trim_incomplete_tail(&h4) != 3 || h4.len != 2 {
        ty_fail(tag, "id 对不上的一组没有整组丢掉(4)", &ok);
    }

    // 5) 完整的一组后面接了 user：尾部合法，什么都不该动
    var h5: History = hist_init();
    defer { hist_free(&h5); }
    if !hist_seed(&h5) || !hist_push_calls(&h5, HIST_CALLS_1) || !hist_push_tool(&h5, "c1", "R1") || !hist_push_text(&h5, ROLE_USER, "NEXT") {
        ty_fail(tag, "构造历史失败(5)", &ok);
        return ok;
    }
    if hist_trim_incomplete_tail(&h5) != 0 || h5.len != 5 {
        ty_fail(tag, "尾部是 user 时不该裁剪(5)", &ok);
    }
    if !hist_pairing_ok(&h5) {
        ty_fail(tag, "完整组 + user 被判成不合法(5)", &ok);
    }

    // 6) 孤儿 tool（assistant 已经不在）：丢掉
    var h6: History = hist_init();
    defer { hist_free(&h6); }
    if !hist_seed(&h6) || !hist_push_tool(&h6, "c1", "R1") {
        ty_fail(tag, "构造历史失败(6)", &ok);
        return ok;
    }
    if hist_pairing_ok(&h6) {
        ty_fail(tag, "孤儿 tool 被判成配对完整(6)", &ok);
    }
    if hist_trim_incomplete_tail(&h6) != 1 || h6.len != 2 {
        ty_fail(tag, "孤儿 tool 没有丢掉(6)", &ok);
    }

    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if ok {
        out_err("ok");
    } else {
        out_err("FAIL");
    }
    out_err("\n");
    return ok;
}

// 用 O_WRONLY|O_CREAT|O_TRUNC（mode 0644）把 text 写进 path，写完即关。
// text 按 C 串取长度；返回 false = 打不开或写不满（关了 fd 再返回，不泄漏）。
fn write_text_file(path: &const byte, text: &const byte) bool {
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(path as *const byte, flags, 420) catch {
        return false;
    };
    const n: usize = bufx_cstr_len(text);
    const ok: bool = write_all_fd(fd, text, n);
    _ = sys_close(fd) catch {};
    return ok;
}

// ============================================================
// P33：/sessions 列表（时间倒序 · 三列 · 宽度自适应）—— 纯函数轮
// ============================================================
// 这一轮盯的是数据侧与排版侧：索引去重（同 id 取最后一条）、lastActiveAt 倒序、
// 三列的退化阶梯、条目文本里 id 必须完整（选中项就是靠它 /resume 的）、
// 标题里的控制字节必须被清洗。TUI 浮层那条腿在 tuiselftest 的 tui-sessions 轮。

// 造一行索引记录（has_at = false 时整个 lastActiveAt 字段都不写 = 「缺字段」的样子）
fn sesslist_fixture_line(id: &const byte, cwd: &const byte, at: i64, has_at: bool, title: &const byte, out: &Buf) void {
    _ = buf_append_cstr(out, "{\"id\":\"");
    _ = buf_append_cstr(out, id);
    _ = buf_append_cstr(out, "\",\"cwd\":");
    _ = jw_str_into(out, cwd, bufx_cstr_len(cwd));
    if has_at {
        _ = buf_append_cstr(out, ",\"lastActiveAt\":");
        _ = buf_append_i64(out, at);
    }
    _ = buf_append_cstr(out, ",\"title\":");
    _ = jw_str_into(out, title, bufx_cstr_len(title));
    _ = buf_append_cstr(out, ",\"model\":\"m\",\"delegationDepth\":0,\"turns\":0,\"events\":0,\"path\":\"/x\"}\n");
}

// 数 b 里的换行符个数（= 行数，末尾无换行时最后一行也算）。
fn sesslist_count_lines(b: &Buf) usize {
    var n: usize = 0;
    var i: usize = 0;
    while i < b.len {
        if b.ptr[i] == 10 as byte {
            n = n + 1;
        }
        i = i + 1;
    }
    if b.len > 0 && b.ptr[b.len - 1] != 10 as byte {
        n = n + 1;
    }
    return n;
}

// 第 k 个非空行的字节区间
fn sesslist_span(b: &Buf, k: usize, off: &usize, len: &usize) bool {
    var line: usize = 0;
    var i: usize = 0;
    while i < b.len {
        var e: usize = i;
        while e < b.len && b.ptr[e] != 10 as byte {
            e = e + 1;
        }
        if e > i {
            if line == k {
                off[0] = i;
                len[0] = e - i;
                return true;
            }
            line = line + 1;
        }
        i = e + 1;
    }
    return false;
}

// 渲染出来的第 k 行 → 行尾那个 token（= 该行的完整 id）。
// 走的是**真实**的选中口径 agent_tui_sessions_head（不是另写一套取词规则）：
// 顺序翻转最容易踩的坑就是「行序对了、选中项取错了」。
fn sesslist_render_row_id(rendered: &Buf, k: usize, out: &Buf) bool {
    var o: usize = 0;
    var l: usize = 0;
    if !sesslist_span(rendered, k, &o, &l) {
        return false;
    }
    var line: Buf = buf_new(1024);
    defer { buf_free(&line); }
    if !buf_append(&line, rendered.ptr + o, l) {
        return false;
    }
    buf_reset(out);
    agent_tui_sessions_head(&line, out);
    return out.len > 0;
}

// 取 /sessions 列表里第 k 行的 id 写进 out（先按 sesslist_span 定位该行）。
// 返回 false = 行号越界 / 该行没有 id 字段 / out 容量不够。
fn sesslist_row_id(b: &Buf, k: usize, out: &Buf) bool {
    var o: usize = 0;
    var l: usize = 0;
    if !sesslist_span(b, k, &o, &l) {
        return false;
    }
    // 拷进 scratch 再按 [0: len] 解析：`p[o: o+l]` 在 uya 里是「偏移 + 长度」，会越读
    var scratch: Buf = buf_new(4096);
    defer { buf_free(&scratch); }
    _ = buf_append(&scratch, b.ptr + o, l);
    return sess_json_str(scratch.ptr[0: scratch.len], "id", out);
}

// 取 /sessions 列表里第 k 行的 lastActiveAt（毫秒时间戳）。
// 行号越界 / 该行没有该字段返回 -2（不是 0 —— 0 是合法时间戳）；负数即失败。
fn sesslist_row_at(b: &Buf, k: usize) i64 {
    var o: usize = 0;
    var l: usize = 0;
    if !sesslist_span(b, k, &o, &l) {
        return -2;
    }
    var scratch: Buf = buf_new(4096);
    defer { buf_free(&scratch); }
    _ = buf_append(&scratch, b.ptr + o, l);
    return sess_json_i64(scratch.ptr[0: scratch.len], "lastActiveAt");
}

// exp 第 k 行的裸 id（取出来单独比较，别拿它当 C 字符串用 —— Buf 不保证末尾有 NUL）
fn sesslist_exp_id(exp: &Buf, k: usize, out: &Buf) bool {
    var eo: usize = 0;
    var el: usize = 0;
    if !sesslist_span(exp, k, &eo, &el) {
        return false;
    }
    buf_reset(out);
    return buf_append(out, exp.ptr + eo, el);
}

// rows（每行一条索引记录原文）第 k 行的 id == exp（每行一个裸 id）第 k 行？
fn sesslist_id_eq(rows: &Buf, exp: &Buf, k: usize) bool {
    var got: Buf = buf_new(128);
    defer { buf_free(&got); }
    if !sesslist_row_id(rows, k, &got) {
        return false;
    }
    var eo: usize = 0;
    var el: usize = 0;
    if !sesslist_span(exp, k, &eo, &el) {
        return false;
    }
    if got.len != el {
        return false;
    }
    return bufx_mem_eq(got.ptr as &const byte, exp.ptr + eo, el);
}

// hay 里是否含字面量（测试断言用）
fn sesslist_has(hay: &Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if n == 0 || hay.len < n {
        return false;
    }
    var i: usize = 0;
    while i + n <= hay.len {
        if bufx_mem_eq(hay.ptr + i, lit, n) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 在给定可用列数下渲染一次并逐行检查：
//   * 行宽 <= body（除非窄到连 id 都放不下 —— 那一档 id 必须**完整**，裁剪交给显示层）；
//   * 行尾 token 能还出这一行完整的 id（agent_tui_sessions_head 的口径）；
//   * 正文里一个控制字节都没有（标题里的 \u0001 / TAB 必须被清洗掉）。
// exp = 期望的 id 列表（每行一个，'\n' 结尾）—— 按**数据层**口径给（第 0 行 = 最新）。
// P35：渲染是「最新在最后一行」，所以把渲染出来的第 k 行按镜像去比 exp 的第 n-1-k 行；
// 镜像本身也是断言的一部分（顺序错了这里必然红）。
fn sesslist_check_width(rows: &Buf, exp: &Buf, body: usize, want_title: bool, want_ws: bool, tag: &const byte, ok: &bool) bool {
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    sess_rows_render(rows, body, &out, true);
    const n: usize = sesslist_count_lines(&out);
    const en: usize = sesslist_count_lines(exp);
    if n != en {
        ty_fail(tag, "会话列表的行数与去重后的会话数不一致", ok);
        return false;
    }
    var k: usize = 0;
    while k < n {
        var o: usize = 0;
        var l: usize = 0;
        if !sesslist_span(&out, k, &o, &l) {
            break;
        }
        // 渲染序 ↔ 数据序的镜像（最新在最后一行）
        if !sesslist_id_eq(rows, exp, n - 1 - k) {
            ty_fail(tag, "渲染出来的第 k 行不是期望的会话（顺序或去重错了）", ok);
            break;
        }
        const cols: usize = tty_cols_between(out.ptr + o, 0, l);
        // 只剩 id 那一档（body < id 本身的 44 列）允许超宽：那份 id 必须完整，
        // 裁剪交给显示层（浮层画的时候裁 / 滚动模式打印前 sess_rows_clip_into 裁）。
        if cols > body && body >= 44 {
            ty_fail(tag, "会话列表某行超过可用列数", ok);
        }
        // 选中项取 id：必须是这一行完整的 id（拿标题当 id 是最典型的错法）
        var line: Buf = buf_new(1024);
        defer { buf_free(&line); }
        var sid: Buf = buf_new(128);
        defer { buf_free(&sid); }
        _ = buf_append(&line, out.ptr + o, l);
        agent_tui_sessions_head(&line, &sid);
        var want_id: Buf = buf_new(128);
        defer { buf_free(&want_id); }
        if !sesslist_exp_id(exp, n - 1 - k, &want_id) {
            ty_fail(tag, "期望列表里少了一行", ok);
            break;
        }
        // 按长度比较：两边都是 Buf（不保证 NUL 结尾），bufx_eq_cstr 只收 C 字符串
        if sid.len != want_id.len || !bufx_mem_eq(sid.ptr as &const byte, want_id.ptr as &const byte, want_id.len) {
            ty_fail(tag, "选中项里没取到完整的 session id（把标题当 id 了？）", ok);
        }
        // 控制字节：正文层不许有（TAB / 0x01 都在清洗这一步被换掉）
        var c: usize = 0;
        while c < l {
            const ch: byte = out.ptr[o + c];
            if ch < 0x20 as byte || ch == 0x7f as byte {
                ty_fail(tag, "会话列表里出现了控制字节（标题没清洗？）", ok);
                break;
            }
            c = c + 1;
        }
        k = k + 1;
    }
    // 列的存在性：能放下就该看得见，放不下就不该出现（退化阶梯）
    const has_title: bool = sesslist_has(&out, "TITLE" as &const byte);
    const has_ws: bool = sesslist_has(&out, "MARK" as &const byte);
    if has_title != want_title {
        ty_fail(tag, "标题列的可见性与预期不符（列宽分配 / 退化阶梯错了）", ok);
    }
    if has_ws != want_ws {
        ty_fail(tag, "工作区列的可见性与预期不符（列宽分配 / 退化阶梯错了）", ok);
    }
    return true;
}

// /sessions 列表轮（P33，纯函数）：造四份假日志，断言索引去重（同 id 取最后一条）、
// lastActiveAt 倒序、三列排版与宽度退阶梯（工作区列该藏就藏）。返回 false = 本轮红。
fn sess_list_round(tag: &const byte) bool {
    var ok: bool = true;
    const home: &const byte = "build/selftest_sess_list" as &const byte;
    _ = sess_mkdir_p(home);
    const ida: &const byte = "session-aaaa1111-1111-4111-8111-111111111111" as &const byte;
    const idb: &const byte = "session-bbbb2222-2222-4222-8222-222222222222" as &const byte;
    const idc: &const byte = "session-cccc3333-3333-4333-8333-333333333333" as &const byte;
    const idd: &const byte = "session-dddd4444-4444-4444-8444-444444444444" as &const byte;

    // ---- fixture：真实索引的形状（追加写 ⇒ 同 id 两条；时间戳乱序；缺字段；空标题；
    //      带控制字节的标题；超长 cwd）----
    var btitle: Buf = buf_new(128);
    defer { buf_free(&btitle); }
    _ = buf_append_cstr(&btitle, "TITLE B");     // 后面补控制字节与 TAB（必须被清洗）
    _ = buf_append_byte(&btitle, 9);
    _ = buf_append_cstr(&btitle, "tab");
    _ = buf_append_byte(&btitle, 1);
    _ = buf_append_cstr(&btitle, "ctrl 尾巴");
    _ = buf_append_byte(&btitle, 0);
    var idx: Buf = buf_new(8192);
    defer { buf_free(&idx); }
    sesslist_fixture_line(ida, "/w/old-a" as &const byte, 1000, true, "TITLE A 第一条（应当被取代）" as &const byte, &idx);
    sesslist_fixture_line(idb, "/w/x/MARK" as &const byte, 5000, true, btitle.ptr as &const byte, &idx);
    sesslist_fixture_line(idc, "/w/c" as &const byte, 7000, true, "" as &const byte, &idx);
    sesslist_fixture_line(idd, "/w/d" as &const byte, 0, false, "TITLE D 没有时间戳" as &const byte, &idx);
    sesslist_fixture_line(ida, "/w/new-a" as &const byte, 9000, true, "TITLE A 后一条（生效的那条）" as &const byte, &idx);
    _ = buf_append_byte(&idx, 10);   // 尾随空行：必须被忽略
    var ipath: Buf = buf_new(128);
    defer { buf_free(&ipath); }
    _ = buf_append_cstr(&ipath, home);
    _ = buf_append_cstr_z(&ipath, "/index.jsonl");
    _ = buf_append_byte(&idx, 0);    // write_text_file 收 C 字符串
    if !write_text_file(ipath.ptr as &const byte, idx.ptr as &const byte) {
        ty_fail(tag, "写 fixture 索引失败", &ok);
        return false;
    }

    // ---- 1) 索引 → 去重 + 倒序 ----
    var hz: Buf = buf_new(128);
    defer { buf_free(&hz); }
    _ = buf_append_cstr(&hz, home);
    _ = buf_append_byte(&hz, 0);
    var rows: Buf = buf_new(8192);
    defer { buf_free(&rows); }
    if !sess_index_rows_sorted(hz.ptr as &const byte, &rows) {
        ty_fail(tag, "索引里读不出会话记录", &ok);
        return false;
    }
    if sesslist_count_lines(&rows) != 4 {
        ty_fail(tag, "去重后不是 4 条（同 id 只该留最后一条）", &ok);
    }
    // 顺序：A 的后一条（9000）→ C（7000）→ B（5000）→ D（缺时间戳，最后）
    const exp_ids: &const byte = "session-aaaa1111-1111-4111-8111-111111111111\nsession-cccc3333-3333-4333-8333-333333333333\nsession-bbbb2222-2222-4222-8222-222222222222\nsession-dddd4444-4444-4444-8444-444444444444\n" as &const byte;
    var exp: Buf = buf_new(256);
    defer { buf_free(&exp); }
    _ = buf_append_cstr(&exp, exp_ids);
    const exp_at: [i64: 4] = [9000, 7000, 5000, -1];
    var k: usize = 0;
    while k < 4 {
        if !sesslist_id_eq(&rows, &exp, k) {
            ty_fail(tag, "倒序不对（最新的一条必须在最上面）", &ok);
        }
        if sesslist_row_at(&rows, k) != exp_at[k] {
            ty_fail(tag, "lastActiveAt 取值不对（去重应当保留最后一条记录）", &ok);
        }
        k = k + 1;
    }

    // ---- 2) 三列排版：去重取的是后一条、空标题落到占位串；P35 最新在最后一行 ----
    var wide: Buf = buf_new(65536);
    defer { buf_free(&wide); }
    sess_rows_render(&rows, 198, &wide, true);
    if sesslist_has(&wide, "后一条" as &const byte) == false {
        ty_fail(tag, "同 id 没取「最后一条」记录（去重取错了那条）", &ok);
    }
    if sesslist_has(&wide, "第一条" as &const byte) {
        ty_fail(tag, "被取代的那条记录还在列表里", &ok);
    }
    if !sesslist_has(&wide, "(无标题)" as &const byte) {
        ty_fail(tag, "空标题没有落到占位串上", &ok);
    }
    // P35：最新的那条（ida 的后一条，9000）必须在**最后一行**，最旧的（idd，缺时间戳）在第一行。
    // 只比「出现在最后一行」还不够 —— 得把那一行的 id 取出来比，免得把别的会话排到末尾也蒙混过关。
    const nwide: usize = sesslist_count_lines(&wide);
    var last_id: Buf = buf_new(128);
    defer { buf_free(&last_id); }
    if !sesslist_render_row_id(&wide, nwide - 1, &last_id) {
        ty_fail(tag, "渲染出来的最后一行取不到完整 id", &ok);
    } else if !bufx_mem_eq(last_id.ptr as &const byte, ida, bufx_cstr_len(ida)) {
        ty_fail(tag, "最新的会话没有排在最后一行", &ok);
    }
    var first_id: Buf = buf_new(128);
    defer { buf_free(&first_id); }
    if !sesslist_render_row_id(&wide, 0, &first_id) {
        ty_fail(tag, "渲染出来的第一行取不到完整 id", &ok);
    } else if !bufx_mem_eq(first_id.ptr as &const byte, idd, bufx_cstr_len(idd)) {
        ty_fail(tag, "最旧的会话（缺 lastActiveAt 那条）没有排在第一行", &ok);
    }

    // ---- 3) 宽度扫描：三列 → 两列（丢工作区）→ 只剩 id ----
    // 三列的门槛 = id(44) + 2 个间隔(4) + 两列各 6 列 = 60；两列 = 44 + 2 + 6 = 52
    _ = sesslist_check_width(&rows, &exp, 198, true, true, tag, &ok);
    _ = sesslist_check_width(&rows, &exp, 78, true, true, tag, &ok);     // 80 列终端
    _ = sesslist_check_width(&rows, &exp, 60, true, true, tag, &ok);     // 三列最小档
    _ = sesslist_check_width(&rows, &exp, 59, true, false, tag, &ok);    // 掉工作区列
    _ = sesslist_check_width(&rows, &exp, 52, true, false, tag, &ok);    // 两列最小档
    _ = sesslist_check_width(&rows, &exp, 51, false, false, tag, &ok);   // 只剩 id
    _ = sesslist_check_width(&rows, &exp, 44, false, false, tag, &ok);   // id 正好放得下
    _ = sesslist_check_width(&rows, &exp, 40, false, false, tag, &ok);   // 放不下（行宽 = id 的 44）

    // ---- 4) 滚动模式打印前的硬裁（窄终端上 44 列的 id 不能让行折行）----
    var clip: Buf = buf_new(65536);
    defer { buf_free(&clip); }
    sess_rows_clip_into(&wide, 21, &clip);
    const cn: usize = sesslist_count_lines(&clip);
    if cn == 0 {
        ty_fail(tag, "硬裁之后一行都不剩了", &ok);
    }
    k = 0;
    while k < cn {
        var o: usize = 0;
        var l: usize = 0;
        if !sesslist_span(&clip, k, &o, &l) {
            break;
        }
        if tty_cols_between(clip.ptr + o, 0, l) > 21 {
            ty_fail(tag, "硬裁之后仍有超过终端列数的行", &ok);
        }
        if !sesslist_has(&clip, "…" as &const byte) {
            ty_fail(tag, "被裁掉 id 的行没有补 '…'（半截 id 抄去 /resume 一定失败）", &ok);
        }
        k = k + 1;
    }
    // 放得下就不许裁：三列排版本来就正好 body 列，多留一列 '…' 会把好端端的 id 截掉
    var clip_fit: Buf = buf_new(65536);
    defer { buf_free(&clip_fit); }
    sess_rows_clip_into(&wide, 198, &clip_fit);
    if sesslist_has(&clip_fit, "…" as &const byte) {
        ty_fail(tag, "行本来放得下却被硬裁了（'…' 预算算错）", &ok);
    }

    // ---- 5) 没有索引：不能假装有会话 ----
    var norows: Buf = buf_new(256);
    defer { buf_free(&norows); }
    var nz: Buf = buf_new(64);
    defer { buf_free(&nz); }
    _ = buf_append_cstr(&nz, "build/selftest_sess_list_none");
    _ = buf_append_byte(&nz, 0);
    if sess_index_rows_sorted(nz.ptr as &const byte, &norows) {
        ty_fail(tag, "没有索引时不该返回记录", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（去重取最后一条 + 数据层倒序 / 展示层最新在最后一行 + 三列/两列/只剩 id 的退化 + id 完整 + 控制字节清洗）\n");
    }
    return ok;
}

// ============================================================
// sess-list-big（踩坑 68）：大索引上的排序 —— 与参考插入排序逐行等价 + 结果确定
// ============================================================
// 现场（用户报的「session 选择框显示后很卡」）：数据层两处 `sess_idx_sort_*` 是**插入排序**
// （O(n²)）。会话索引是追加写的，lastActiveAt 天然升序 ⇒ 插入排序每次都把新记录一路挪到
// 最前，正好是最坏情况（实测 12.8 K 行：升序 1.4 s、降序 0.19 s）。改成自底向上归并
// （O(n log n)）之后两种顺序都是 0.2 s 量级。
//
// 这一轮盯两件事：
//   1) **等价性**：归并的结果与「金标准（就用未修版本的插入排序）」逐行相同 —— 比较键
//      必须是严格全序，否则同键记录的顺序会漂（`line_off` 是次级键，在一份索引里唯一）；
//   2) **确定性**：同一份输入排两次，结果逐行相同。

// 金标准：按 (id 升序, 行号升序) 的插入排序（未修版本原文，只给自测当参照）
fn sessbig_ref_sort_by_id(idx: &const Buf, rows: &SessIdxRow, n: usize) void {
    const tmp: &SessIdxRow = sess_idx_at_mut(rows, n);
    var i: usize = 1;
    while i < n {
        sess_idx_copy(tmp, sess_idx_at(rows, i));
        var j: usize = i;
        while j > 0 {
            const prev: &const SessIdxRow = sess_idx_at(rows, j - 1);
            const c: i32 = sess_idx_id_cmp(idx, prev, tmp);
            var stop: bool = false;
            if c < 0 {
                stop = true;
            } else if c == 0 && prev.line_off < tmp.line_off {
                stop = true;
            }
            if stop {
                break;
            }
            sess_idx_copy(sess_idx_at_mut(rows, j), prev);
            j = j - 1;
        }
        sess_idx_copy(sess_idx_at_mut(rows, j), tmp);
        i = i + 1;
    }
}

// 金标准：按 (lastActiveAt 降序, 行号降序) 的插入排序
fn sessbig_ref_sort_by_at(rows: &SessIdxRow, n: usize) void {
    const tmp: &SessIdxRow = sess_idx_at_mut(rows, n);
    var i: usize = 1;
    while i < n {
        sess_idx_copy(tmp, sess_idx_at(rows, i));
        var j: usize = i;
        while j > 0 {
            const prev: &const SessIdxRow = sess_idx_at(rows, j - 1);
            var before: bool = false;
            if prev.at > tmp.at {
                before = true;
            } else if prev.at == tmp.at && prev.line_off > tmp.line_off {
                before = true;
            }
            if before {
                break;
            }
            sess_idx_copy(sess_idx_at_mut(rows, j), prev);
            j = j - 1;
        }
        sess_idx_copy(sess_idx_at_mut(rows, j), tmp);
        i = i + 1;
    }
}

const SESSBIG_N: usize = 6000;      // 索引记录数（去重后 2000 条会话）
const SESSBIG_ESZ_MUL: usize = 2;   // 每行记录占的格数（数据 n 格 + 归并目标区 n 格）

// 造一份大索引的**内存镜像**（不落盘）：形状对齐真索引 —— 追加写 ⇒ 时间戳升序；
// 每 3 条同 id（后一条生效）；每 7 条缺一条 lastActiveAt；每 11 条重复一次时间戳。
fn sessbig_build_fixture(rows: &Buf) bool {
    buf_reset(rows);
    var i: usize = 0;
    while i < SESSBIG_N {
        var line: Buf = buf_new(256);
        defer { buf_free(&line); }
        _ = buf_append_cstr(&line, "{\"id\":\"session-");
        const gid: usize = i / 3;
        var hex: Buf = buf_new(32);
        defer { buf_free(&hex); }
        _ = buf_append_u64(&hex, gid as u64);
        var pad: usize = hex.len;
        while pad < 8 {
            _ = buf_append_byte(&line, 48);   // '0'：id 补齐 8 位十六进制
            pad = pad + 1;
        }
        _ = buf_append(&line, hex.ptr, hex.len);
        _ = buf_append_cstr(&line, "-1111-4111-8111-111111111111\",\"cwd\":\"/w/");
        _ = buf_append_u64(&line, (i % 5) as u64);
        _ = buf_append_cstr(&line, "\",\"title\":\"T");
        _ = buf_append_u64(&line, i as u64);
        _ = buf_append_cstr(&line, "\"");
        if (i % (7 as usize)) != (3 as usize) {
            const at: i64 = (1700000000000 as i64) + ((i / 11) as i64);
            _ = buf_append_cstr(&line, ",\"lastActiveAt\":");
            var num: Buf = buf_new(32);
            defer { buf_free(&num); }
            _ = buf_append_i64(&num, at);
            _ = buf_append(&line, num.ptr, num.len);
        }
        _ = buf_append_cstr(&line, "}\n");
        if !buf_append(rows, line.ptr, line.len) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 把 rows（每行一条索引记录原文）填进紧凑记录表；返回填了几条。
// 表必须能放下 2n+2 格（归并排序的目标区），所有字段逐项写。
fn sessbig_fill_rows(rows: &Buf, tab: &SessIdxRow, cap: usize) usize {
    var m: usize = 0;
    var p: usize = 0;
    while p < rows.len && m < cap {
        var e: usize = p;
        while e < rows.len && rows.ptr[e] != 10 as byte {
            e = e + 1;
        }
        const lo: usize = p;
        const ll: usize = e - p;
        p = e + 1;
        if ll == 0 {
            continue;
        }
        var line: Buf = buf_new(4096);
        defer { buf_free(&line); }
        _ = buf_append(&line, rows.ptr + lo, ll);
        const view: &[byte] = line.ptr[0: line.len];
        var ido: usize = 0;
        var idl: usize = 0;
        if !sess_idx_find_id(view, &ido, &idl) {
            continue;
        }
        const r: &SessIdxRow = sess_idx_at_mut(tab, m);
        r.at = sess_json_i64(view, "lastActiveAt");
        r.line_off = lo;
        r.line_len = ll;
        r.id_off = lo + ido;
        r.id_len = idl;
        m = m + 1;
    }
    return m;
}

// 两张表逐行的 line_off 是否相同（不同就返回首个不同的行号，相同返回 -1）
fn sessbig_first_diff(a: &const SessIdxRow, b: &const SessIdxRow, n: usize) i64 {
    var i: usize = 0;
    while i < n {
        if sess_idx_at(a, i).line_off != sess_idx_at(b, i).line_off {
            return i as i64;
        }
        i = i + 1;
    }
    return -1 as i64;
}

// 表是否按 mode 排好（含次级键）
fn sessbig_sorted_ok(idx: &const Buf, tab: &const SessIdxRow, n: usize, mode: u8, why: &Buf) bool {
    var i: usize = 1;
    while i < n {
        const prev: &const SessIdxRow = sess_idx_at(tab, i - 1);
        const cur: &const SessIdxRow = sess_idx_at(tab, i);
        // 「cur 不该排在 prev 前面」——把 sess_idx_before 反过来问
        if sess_idx_before(mode, idx, cur, prev) {
            buf_reset(why);
            _ = buf_append_cstr(why, "第 ");
            _ = buf_append_u64(why, i as u64);
            _ = buf_append_cstr(why, " 行乱序");
            return false;
        }
        i = i + 1;
    }
    return true;
}

// sess-list-big 轮（踩坑 68）：6000 行大索引上，归并排序必须与参考插入排序**逐行等价**、
// 两把键各自有序、结果确定、去重 2000 条、行尾 id 完整。返回 false = 本轮红。
fn sess_list_big_round(tag: &const byte) bool {
    var ok: bool = true;
    var rows: Buf = buf_new(1 << 20);
    defer { buf_free(&rows); }
    if !sessbig_build_fixture(&rows) {
        ty_fail(tag, "大索引 fixture 造不出来", &ok);
        return ok;
    }
    // fixture 自检：非空行数 == SESSBIG_N
    var nl: usize = 0;
    var p: usize = 0;
    while p < rows.len {
        var e: usize = p;
        while e < rows.len && rows.ptr[e] != 10 as byte {
            e = e + 1;
        }
        if e > p {
            nl = nl + 1;
        }
        p = e + 1;
    }
    if nl != SESSBIG_N {
        ty_fail(tag, "fixture 的非空行数与预期不一致", &ok);
        return ok;
    }

    // 两张表：A 走生产实现（sess_idx_sort），B 走金标准插入排序。
    // 按 2n+2 格分配（生产实现要归并目标区；金标准只用末格暂存）。
    const esz: usize = @size_of(SessIdxRow) as usize;
    const nalloc: usize = (SESSBIG_N * SESSBIG_ESZ_MUL) + 2;
    const rawA: &void = malloc(nalloc * esz);
    const rawB: &void = malloc(nalloc * esz);
    if ((rawA as &byte) as usize) == 0 || ((rawB as &byte) as usize) == 0 {
        if ((rawA as &byte) as usize) != 0 {
            free(rawA);
        }
        if ((rawB as &byte) as usize) != 0 {
            free(rawB);
        }
        ty_fail(tag, "排序表分配失败", &ok);
        return ok;
    }
    defer {
        free(rawA);
        free(rawB);
    }
    const ta: &SessIdxRow = rawA as &SessIdxRow;
    const tb: &SessIdxRow = rawB as &SessIdxRow;
    const m: usize = sessbig_fill_rows(&rows, ta, SESSBIG_N);
    if m != SESSBIG_N {
        ty_fail(tag, "填表条数与 fixture 不符", &ok);
        return ok;
    }
    // B 表照抄 A（填两遍比 memcpy 一份结构体数组更省事，也不碰移动语义）
    var ci: usize = 0;
    while ci < m {
        sess_idx_copy(sess_idx_at_mut(tb, ci), sess_idx_at(ta, ci));
        ci = ci + 1;
    }

    // ---- 1) 第一把键（id 升序）：生产实现 vs 金标准，逐行 line_off 全等 ----
    sess_idx_sort(&rows, ta, m, SESS_IDX_BY_ID);
    sessbig_ref_sort_by_id(&rows, tb, m);
    const d1: i64 = sessbig_first_diff(ta, tb, m);
    if d1 >= 0 {
        ty_fail(tag, "按 id 排序的结果与金标准（插入排序）不一致", &ok);
        out_err("  首个不同的行号 = ");
        out_err_dec(d1 as usize);
        out_err("\n");
    }
    var why1: Buf = buf_new(96);
    defer { buf_free(&why1); }
    if ok && !sessbig_sorted_ok(&rows, ta, m, SESS_IDX_BY_ID, &why1) {
        ty_fail(tag, "按 id 排序之后不是「id 升序 / 同 id 行号升序」", &ok);
        out_err("  ");
        out_err_bytes(why1.ptr as &const byte, why1.len);
        out_err("\n");
    }

    // ---- 2) 第二把键（lastActiveAt 降序 / 同行号降序）：同样比对，再验有序 ----
    // B 表已经被步骤 1 排过；先把它还原成 A 的当前顺序再比第二把键
    ci = 0;
    while ci < m {
        sess_idx_copy(sess_idx_at_mut(tb, ci), sess_idx_at(ta, ci));
        ci = ci + 1;
    }
    sess_idx_sort(&rows, ta, m, SESS_IDX_BY_AT);
    sessbig_ref_sort_by_at(tb, m);
    const d2: i64 = sessbig_first_diff(ta, tb, m);
    if d2 >= 0 {
        ty_fail(tag, "按 lastActiveAt 排序的结果与金标准（插入排序）不一致", &ok);
        out_err("  首个不同的行号 = ");
        out_err_dec(d2 as usize);
        out_err("\n");
    }
    var why2: Buf = buf_new(96);
    defer { buf_free(&why2); }
    if ok && !sessbig_sorted_ok(&rows, ta, m, SESS_IDX_BY_AT, &why2) {
        ty_fail(tag, "按 lastActiveAt 排序之后不是「时间降序 / 同时间戳行号降序」", &ok);
        out_err("  ");
        out_err_bytes(why2.ptr as &const byte, why2.len);
        out_err("\n");
    }

    // ---- 3) 确定性：把同一份输入排两次，逐行相同 ----
    const rawC: &void = malloc(nalloc * esz);
    if ((rawC as &byte) as usize) == 0 {
        ty_fail(tag, "确定性用的第三张表分配失败", &ok);
        return ok;
    }
    defer { free(rawC); }
    const tc: &SessIdxRow = rawC as &SessIdxRow;
    ci = 0;
    while ci < m {
        sess_idx_copy(sess_idx_at_mut(tc, ci), sess_idx_at(ta, ci));
        ci = ci + 1;
    }
    sess_idx_sort(&rows, tc, m, SESS_IDX_BY_AT);
    const d3: i64 = sessbig_first_diff(ta, tc, m);
    if d3 >= 0 {
        ty_fail(tag, "同一份输入排两次结果不同（排序不确定）", &ok);
        out_err("  首个不同的行号 = ");
        out_err_dec(d3 as usize);
        out_err("\n");
    }

    // ---- 4) 端到端：去重 → 三列排版，行数 == 去重后的会话数，行尾 id 完整 ----
    // 去重口径照抄 sess_index_rows_sorted：先按 id 排，再每组只留最后一条
    sess_idx_sort(&rows, ta, m, SESS_IDX_BY_ID);
    var rows_only: Buf = buf_new(1 << 20);
    defer { buf_free(&rows_only); }
    var keep: usize = 0;
    var i: usize = 0;
    while i < m {
        var j: usize = i + 1;
        while j < m {
            if sess_idx_id_cmp(&rows, sess_idx_at(ta, i), sess_idx_at(ta, j)) != 0 {
                break;
            }
            j = j + 1;
        }
        const lastr: &const SessIdxRow = sess_idx_at(ta, j - 1);
        _ = buf_append(&rows_only, rows.ptr + lastr.line_off, lastr.line_len);
        _ = buf_append_byte(&rows_only, 10);
        keep = keep + 1;
        i = j;
    }
    const want_keep: usize = SESSBIG_N / 3;
    if keep != want_keep {
        ty_fail(tag, "去重之后的会话数不对", &ok);
        out_err("  实际 = ");
        out_err_dec(keep);
        out_err(" 期望 = ");
        out_err_dec(want_keep);
        out_err("\n");
    }
    var render: Buf = buf_new(1 << 20);
    defer { buf_free(&render); }
    sess_rows_render(&rows_only, 198, &render, true);
    var rl: usize = 0;
    p = 0;
    while p < render.len {
        if render.ptr[p] == 10 as byte {
            rl = rl + 1;
        }
        p = p + 1;
    }
    if rl != want_keep {
        ty_fail(tag, "大索引渲染出来的行数与会话数不一致", &ok);
        out_err("  实际 = ");
        out_err_dec(rl);
        out_err(" 期望 = ");
        out_err_dec(want_keep);
        out_err("\n");
    }
    // 抽查首 / 中 / 末三行的行尾 id：必须是完整的 44 字节、且以 session- 开头
    const probes: [usize: 3] = [0, want_keep / 2, want_keep - 1];
    var full_id: Buf = buf_new(128);
    defer { buf_free(&full_id); }
    var pk: usize = 0;
    while pk < 3 {
        const row: usize = probes[pk];
        if !sesslist_render_row_id(&render, row, &full_id) {
            ty_fail(tag, "大索引渲染出来的行取不到行尾 id", &ok);
        } else if full_id.len != 44 {
            ty_fail(tag, "大索引渲染出来的行尾 id 长度不对（半截 id 会让 /resume 失败）", &ok);
            out_err("  行 = ");
            out_err_dec(row);
            out_err("  len = ");
            out_err_dec(full_id.len);
            out_err("\n");
        } else if !bufx_mem_eq(full_id.ptr as &const byte, "session-" as &const byte, 8) {
            ty_fail(tag, "大索引渲染出来的行尾 id 不以 session- 开头", &ok);
        }
        pk = pk + 1;
    }
    // P35 展示序：最新的（时间戳最大）必须在最后一行，最旧的（缺时间戳那批）在第一行
    var first_id: Buf = buf_new(128);
    defer { buf_free(&first_id); }
    if sesslist_render_row_id(&render, 0, &first_id) {
        // 缺 lastActiveAt 的记录 at = -1，排最后 ⇒ 展示序（最新在最后）里它就该在最上
        var first_row: Buf = buf_new(1024);
        defer { buf_free(&first_row); }
        if sesslist_span(&render, 0, &p, &nl) {
            _ = buf_append(&first_row, render.ptr + p, nl);
            if sesslist_has(&first_row, "\"lastActiveAt\"" as &const byte) {
                ty_fail(tag, "缺 lastActiveAt 的记录没有垫到最上面（展示序反了？）", &ok);
            }
        }
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（6000 行大索引：归并与金标准逐行等价 + 两把键各自有序 + 排序确定 + 去重 2000 条 + 行尾 id 完整）\n");
    }
    return ok;
}

// DSH 设置解析轮（假 DSH_HOME）：settings.yaml 的预处理（顶层与行尾注释去掉、块标量里的
// 井号保留）与各段读取（provider / model / permission / tls / !!js 行被忽略）。返回 false = 本轮红。
fn dshcfg_round(tag: &const byte) bool {
    var ok: bool = true;
    const home: &const byte = "build/selftest_dsh_home";
    _ = sess_mkdir_p("build/selftest_dsh_home");
    var spath: Buf = buf_new(256);
    defer { buf_free(&spath); }
    _ = buf_append_cstr(&spath, home);
    _ = buf_append_cstr_z(&spath, "/settings.yaml");
    const settings: &const byte = "# 顶层注释：这一行必须被去掉\nllm-pi-ai:\n  providers:\n    {\n      fakeprov:\n        {\n          apiKeyEnv: FAKE_API_KEY,\n          api: openai-responses,\n          baseURL: https://fake.example/v1,   # 行尾注释\n          compat: { supportsDeveloperRole: false, supportsStore: false, supportsReasoningEffort: false },\n          models:\n            [\n              { id: fake-model, contextWindow: 65536, maxTokens: 4096, input: [ text, image ], compat: { supportsDeveloperRole: true } }\n            ]\n        }\n    }\nagent-presets:\n  default: standard\nagent-default-model:\n  provider: fakeprov\n  model: fake-model\n  reasoningEffort: high\npermission:\n  defaultPreset: workspace-write\nuya-agent:\n  tls: { verify: pin, pin: abc123 }\nplan: |\n  # 块标量里的井号必须保留\n  second line\ndisabled_row: !!js process.platform === 'win32'\n";
    if !write_text_file(&spath.ptr[0] as &const byte, settings) {
        ty_fail(tag, "写 settings.yaml 失败", &ok);
        return false;
    }
    var cpath: Buf = buf_new(256);
    defer { buf_free(&cpath); }
    _ = buf_append_cstr(&cpath, home);
    _ = buf_append_cstr_z(&cpath, "/.credentials.yaml");
    const creds: &const byte = "version: 1\nrefs:\n  FAKE_API_KEY: sk-fake-123456\n";
    if !write_text_file(&cpath.ptr[0] as &const byte, creds) {
        ty_fail(tag, "写 .credentials.yaml 失败", &ok);
    }
    // 确保环境变量不会抢先（否则测的是 env 而不是当前逻辑）

    var dsh: DshCfg = dsh_cfg_empty();
    defer { dsh_cfg_free(&dsh); }
    if !dsh_cfg_load(home, "build/selftest_dsh_ws", &dsh) {
        ty_fail(tag, "dsh_cfg_load 失败", &ok);
        return false;
    }
    if !ty_buf_is(&dsh.provider, "fakeprov") {
        ty_fail(tag, "provider 解析错", &ok);
    }
    if !ty_buf_is(&dsh.model, "fake-model") {
        ty_fail(tag, "model 解析错", &ok);
    }
    if !ty_buf_is(&dsh.base_url, "https://fake.example/v1") {
        ty_fail(tag, "baseURL 解析错（行尾注释没被去掉？）", &ok);
        out_err("[dbg] base_url=");
        out_err_bytes(dsh.base_url.ptr, dsh.base_url.len);
        out_err("\n");
    }
    if !ty_buf_is(&dsh.api_key_env, "FAKE_API_KEY") {
        ty_fail(tag, "apiKeyEnv 解析错", &ok);
    }
    if !ty_buf_is(&dsh.api_key, "sk-fake-123456") || dsh.key_src != DSHSRC_CREDS {
        ty_fail(tag, "凭据没有从 .credentials.yaml 取到", &ok);
    }
    if dsh.context_window != 65536 {
        ty_fail(tag, "contextWindow 解析错", &ok);
    }
    if dsh.max_tokens != 4096 {
        ty_fail(tag, "maxTokens 解析错", &ok);
    }
    if !dsh.input_image {
        ty_fail(tag, "input 里的 image 没识别出来", &ok);
    }
    if !ty_buf_is(&dsh.reasoning_effort, "high") {
        ty_fail(tag, "reasoningEffort 解析错", &ok);
    }
    // 线协议 + 三个 compat 开关：路由级读得到，模型级同名键覆盖路由级
    if !ty_buf_is(&dsh.api_style, "openai-responses") {
        ty_fail(tag, "api 解析错", &ok);
    }
    if dsh.compat_dev_role != 1 {
        ty_fail(tag, "模型级 compat.supportsDeveloperRole=true 应当覆盖路由级的 false", &ok);
    }
    if dsh.compat_store != 0 {
        ty_fail(tag, "路由级 compat.supportsStore=false 没读到", &ok);
    }
    if dsh.compat_reasoning != 0 {
        ty_fail(tag, "路由级 compat.supportsReasoningEffort=false 没读到", &ok);
    }
    if !dsh.access_set || dsh.access != PERM_WORKSPACE_WRITE {
        ty_fail(tag, "workspace-write 预设应当推出 PERM_WORKSPACE_WRITE", &ok);
    }
    if !ty_buf_is(&dsh.tls_verify, "pin") || !ty_buf_is(&dsh.tls_pin, "abc123") {
        ty_fail(tag, "uya-agent.tls 命名空间没读到", &ok);
    }
    if !ty_buf_is(&dsh.preset_default, "standard") {
        ty_fail(tag, "agent-presets.default 解析错", &ok);
    }

    // YAML 预处理：注释被去掉、块标量里的 # 保留、!!js 被中和成带引号标量
    var ytree: YTree = YTree{ nodes: [], n: 0, lines: [], nlines: 0, raw: buf_empty(), cur: 0, err_line: 0 };
    yt_init(&ytree);
    defer { yt_free(&ytree); }
    if !yt_load_file(&spath.ptr[0] as &const byte, &ytree) {
        ty_fail(tag, "yt_load_file 失败", &ok);
        return ok;
    }
    const r: i32 = yt_root(&ytree);
    const plan: i32 = yt_get(&ytree, r, "plan");
    const pv: &[byte] = yt_str(&ytree, plan);
    if pv.len == 0 || !sess_has_cstr(pv, "# 块标量里的井号必须保留") {
        ty_fail(tag, "块标量里的注释被误删了", &ok);
    }
    const dis: i32 = yt_get(&ytree, r, "disabled_row");
    const dv: &[byte] = yt_str(&ytree, dis);
    if dv.len == 0 || !sess_has_cstr(dv, "process.platform") {
        ty_fail(tag, "!!js 标签没有被中和成标量", &ok);
    }
    if pv.len > 0 && sess_has_cstr(pv, "# 顶层注释") {
        ty_fail(tag, "顶层注释没有被去掉", &ok);
    }

    // 真机 DSH：存在就顺带校验一次（不存在就跳过，保持自测离线）
    const realhome: &byte = getenv("HOME");
    if (realhome as usize) != 0 {
        var rh: Buf = buf_new(1024);
        defer { buf_free(&rh); }
        _ = buf_append_cstr(&rh, realhome);
        _ = buf_append_cstr(&rh, "/.dsh");
        _ = buf_append_byte(&rh, 0);
        var rsettings: Buf = buf_new(1200);
        defer { buf_free(&rsettings); }
        _ = buf_append_cstr(&rsettings, rh.ptr as &const byte);
        _ = buf_append_cstr_z(&rsettings, "/settings.yaml");
        if sess_file_exists(rsettings.ptr as &const byte) {
            var real: DshCfg = dsh_cfg_empty();
            defer { dsh_cfg_free(&real); }
            if dsh_cfg_load(&rh.ptr[0] as &const byte, ".", &real) {
                if real.provider.len == 0 || real.model.len == 0 {
                    ty_fail(tag, "真实 ~/.dsh 里没解析出 provider/model", &ok);
                }
            } else {
                ty_fail(tag, "真实 ~/.dsh/settings.yaml 解析失败", &ok);
            }
        }
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// Buf b 是否恰好等于 C 字面量 lit（长度先比，再逐字节）。
fn ty_buf_is(b: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if b.len != n {
        return false;
    }
    return bufx_mem_eq(b.ptr as &const byte, lit, n);
}

// 文件工具轮的 6 个调用（write 未读→拒 / read 窗口 / write 读后覆盖 / edit 多匹配→拒 /
// edit 成功 / edit 找不到）
fn mock_fs_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-fs");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    mock_call(&w, "fs_1", "write", "{\"file_path\":\"doc.txt\",\"content\":\"x\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_2", "read", "{\"file_path\":\"doc.txt\",\"offset\":2,\"limit\":2}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_3", "write", "{\"file_path\":\"doc.txt\",\"content\":\"alpha one\\nbeta two\\ngamma three\\nbeta four\\ndelta five\\n\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_4", "edit", "{\"file_path\":\"doc.txt\",\"old_string\":\"beta\",\"new_string\":\"BETA\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_5", "edit", "{\"file_path\":\"doc.txt\",\"old_string\":\"alpha\",\"new_string\":\"ALPHA\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_6", "edit", "{\"file_path\":\"doc.txt\",\"old_string\":\"zzz\",\"new_string\":\"y\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_7", "glob", "{\"pattern\":\"*.txt\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_8", "grep", "{\"pattern\":\"beta\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_9", "grep", "{\"pattern\":\"nosuchthingzzz\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_10", "glob", "{\"pattern\":\"*.nomatch\"}");
    jw_byte(&w, 93);       // ] tool_calls
    jw_byte(&w, 125);      // } message
    jw_byte(&w, 44);       // ,   ← finish_reason 属于 choice，不能写到 choices 外面
    jw_key(&w, "finish_reason");
    jw_str_cstr(&w, "tool_calls");
    jw_byte(&w, 125);      // } choice
    jw_byte(&w, 93);       // ] choices
    jw_byte(&w, 125);      // } root
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);   // 必须回填长度，否则发出去的是 0 字节（踩过）
    return true;
}

// 文件工具轮的 workspace 准备：先放一个 doc.txt（内容已知）
fn fs_ws_prepare(ws: &const byte) bool {
    if !ws_prepare(ws) {
        return false;
    }
    var p: Buf = buf_new(256);
    defer { buf_free(&p); }
    _ = buf_append_cstr(&p, ws);
    _ = buf_append_cstr_z(&p, "/doc.txt");
    if !write_text_file(&p.ptr[0] as &const byte, "alpha one\nbeta two\ngamma three\nbeta four\ndelta five\n") {
        return false;
    }
    buf_reset(&p);
    _ = buf_append_cstr(&p, ws);
    _ = buf_append_cstr_z(&p, "/note.txt");
    return write_text_file(&p.ptr[0] as &const byte, "hello-selftest");
}

// 文件工具轮：断言最终落盘内容（write 覆盖 + edit 替换各一次）
// ============================================================
// read-window：read 工具的行窗口（P19）
//
// 现场（真实会话踩到，§16 踩坑 34）：`read` 只读文件头 cap 字节，再把这段**前缀**的行数
// 当成全文行数 —— 226 KB / 5756 行的 agent.uya 被报成 3149 行；offset 落在那段前缀之外时
// `fs_line_at` 直接失败，输出只剩 "(End of file - total 3149 lines)" + 空内容，模型据此
// 以为文件读完了。这一轮用一个**比 cap 还大**的文件把四件事钉死：真实 total、能读到后半段、
// 只有真越界才报 EOF、行号是绝对行号。
// ============================================================

// 把 body 本体写进 path（path 自动补 NUL；用于 read 行窗口轮的 fixture 文件）。
// 返回 false = 路径缓冲分配失败 / 打不开 / 写不满（关 fd 再返回）。
fn read_ws_write(path: &const byte, body: &const Buf) bool {
    var z: Buf = buf_new(bufx_cstr_len(path) + 1);
    defer { buf_free(&z); }
    if !buf_append(&z, path, bufx_cstr_len(path)) {
        return false;
    }
    if !buf_append_byte(&z, 0) {
        return false;
    }
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(&z.ptr[0] as *const byte, flags, 420 as u32) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    if body.len == 0 {
        return true;
    }
    return write_all_fd(fd, body.ptr as &const byte, body.len);
}

// 拼 `<ws>/<name>`：**必须补 NUL**（§16 坑 2）—— 下面 read_ws_write / sys_open 都按
// C 字符串取路径，Buf 不带头部 NUL 时它们会读到缓冲区后面的垃圾（文件名会带上乱码尾巴）。
fn read_ws_path(ws: &const byte, name: &const byte, out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, ws);
    _ = buf_append_cstr(out, "/");
    _ = buf_append_cstr(out, name);
    _ = buf_append_byte(out, 0);
    out.len = out.len - 1;      // NUL 留在内存里、不算长度
}

// 直接调 read 工具：args 现造并走真实 JSON 解析路径（不经过模型/工具分发）
fn read_call(rel: &const byte, offset: usize, limit: usize, out: &Buf) bool {
    var args: Buf = buf_new(256);
    defer { buf_free(&args); }
    _ = buf_append_cstr(&args, "{\"file_path\":\"");
    _ = buf_append(&args, rel, bufx_cstr_len(rel));
    _ = buf_append_cstr(&args, "\"");
    if offset > 0 {
        _ = buf_append_cstr(&args, ",\"offset\":");
        _ = buf_append_u64(&args, offset as u64);
    }
    if limit > 0 {
        _ = buf_append_cstr(&args, ",\"limit\":");
        _ = buf_append_u64(&args, limit as u64);
    }
    _ = buf_append_cstr(&args, "}");
    var raw: Buf = buf_new(args.len + 1);
    defer { buf_free(&raw); }
    if !buf_append(&raw, args.ptr, args.len) || !buf_append_byte(&raw, 0) {
        return false;
    }
    const cap: usize = 65536;
    const arena_raw: &void = malloc(cap);
    if (arena_raw as usize) == 0 {
        return false;
    }
    defer { free(arena_raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, cap);
    var root: JsonValue = JsonValue.json_null();
    buf_reset(out);
    if !js_parse(&arena, raw.ptr as &byte, raw.len - 1, &root) {
        return false;
    }
    fs_tool_read(&g_fsctx, &g_fsobs, &root, out);
    return true;
}

// 断言失败时把工具输出尾部打出来（几百字节，便于定位）
fn read_dump_tail(tag: &const byte, out: &const Buf) void {
    var from: usize = 0;
    if out.len > 400 {
        from = out.len - 400;
    }
    out_err("[");
    out_err(tag);
    out_err(" got tail] ");
    out_err_bytes(&out.ptr[from], out.len - from);
    out_err("\n");
}

// read-window 轮（P19）：read 工具的行窗口必须报**真实全文行数**、能读到 cap 之外的后半段、
// 只有真越界才报 EOF、输出有上限、残行处理正确（旧实现只按文件头 cap 数行，5756 行报成 3149）。
// 返回 false = 本轮红；工作目录由 ws 给出。
fn read_window_round(tag: &const byte, ws: &const byte) bool {
    var ok: bool = true;
    if !ws_prepare(ws) {
        ty_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    var c: Config = cfg_default();
    // g_fsctx 存的是 workspace 的**指针**：绝不能在这里就 cfg_free（那就是 use-after-free，
    // 表现是工具报 "file not found"）—— 交到函数结束时再放。
    defer { cfg_free(&c); }
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.sandbox = SAN_OFF;   // P21：自测不测沙箱（访问模式用默认的全权）
    fsctx_init(&c);

    // 大文件：4000 行 × 40 字节 = 160 KB > cap（fs_read_max_bytes + 65536 = 116736）
    var big: Buf = buf_new(200000);
    defer { buf_free(&big); }
    var i: usize = 0;
    while i < 4000 {
        _ = buf_append_cstr(&big, "L");
        var digits: [byte: 5] = [48: 5];
        var d: usize = 5;
        var v: usize = i + 1;
        while d > 0 {
            d = d - 1;
            digits[d] = (48 + (v % (10 as usize))) as byte;
            v = v / (10 as usize);
        }
        _ = buf_append(&big, &digits[0], 5);
        _ = buf_append_cstr(&big, " ");
        var pad: usize = 0;
        while pad < 32 {                 // L + 5 位 + 空格 + 32 = 39，加 '\n' 正好 40
            _ = buf_append_cstr(&big, "x");
            pad = pad + 1;
        }
        _ = buf_append_byte(&big, 10);
        i = i + 1;
    }
    var big_path: Buf = buf_new(256);
    defer { buf_free(&big_path); }
    read_ws_path(ws, "big.txt" as &const byte, &big_path);
    if !read_ws_write(big_path.ptr as &const byte, &big) {
        ty_fail(tag, "写大文件失败", &ok);
        return false;
    }
    var out: Buf = buf_new(131072);
    defer { buf_free(&out); }

    // A) 前段窗口：total 必须是**真值 4000**（旧实现会拿前缀行数冒充）
    if !read_call("big.txt" as &const byte, 0, 1000, &out) {
        ty_fail(tag, "read(big.txt, limit=1000) 调用失败", &ok);
    } else {
        if !contains(&out, "of 4000. Use offset=1001 to continue.") {
            ty_fail(tag, "total 不是真值（前缀行数被当成了全文行数）", &ok);
            read_dump_tail(tag, &out);
        }
        if !contains(&out, "1000: L01000") {
            ty_fail(tag, "窗口内容/行号不对（第 1000 行应是 L01000）", &ok);
            read_dump_tail(tag, &out);
        }
    }

    // B) 后段窗口：旧实现在这里假 EOF（前缀之外直接返回空 + End of file）
    if !read_call("big.txt" as &const byte, 3500, 100, &out) {
        ty_fail(tag, "read(big.txt, offset=3500) 调用失败", &ok);
    } else {
        if !contains(&out, "3500: L03500") {
            ty_fail(tag, "offset 落在旧前缀之外读不到内容（假 EOF 回归）", &ok);
            read_dump_tail(tag, &out);
        }
        if !contains(&out, "of 4000.") {
            ty_fail(tag, "后段窗口的 total 不对", &ok);
        }
    }

    // C) 真越界才报 EOF，而且 total 必须是真值
    if !read_call("big.txt" as &const byte, 4001, 0, &out) {
        ty_fail(tag, "read(big.txt, offset=4001) 调用失败", &ok);
    } else if !contains(&out, "End of file - total 4000 lines") {
        ty_fail(tag, "越界时没有报真 total 的 EOF", &ok);
        read_dump_tail(tag, &out);
    }

    // D) 撞输出字节上限（1000 行 × 39 B = 39 KB 不撞；2000 行 = 78 KB > 51200 → 撞）
    if !read_call("big.txt" as &const byte, 0, 2000, &out) {
        ty_fail(tag, "read(big.txt, limit=2000) 调用失败", &ok);
    } else if !contains(&out, "Output capped. Showing lines 1-") {
        ty_fail(tag, "撞到输出上限时没有走 Output capped 分支", &ok);
        read_dump_tail(tag, &out);
    }

    // E) 末尾没有换行的残行也算一行（total 口径与 fs_count_lines 一致）
    var small: Buf = buf_new(64);
    defer { buf_free(&small); }
    _ = buf_append_cstr(&small, "a\nb\nc");
    var tail_path: Buf = buf_new(256);
    defer { buf_free(&tail_path); }
    read_ws_path(ws, "tail.txt" as &const byte, &tail_path);
    if !read_ws_write(tail_path.ptr as &const byte, &small) {
        ty_fail(tag, "写 tail.txt 失败", &ok);
    } else if !read_call("tail.txt" as &const byte, 0, 0, &out) {
        ty_fail(tag, "read(tail.txt) 调用失败", &ok);
    } else if !contains(&out, "End of file - total 3 lines") {
        ty_fail(tag, "末尾残行没有算进 total", &ok);
        read_dump_tail(tag, &out);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（真实 total + 后段窗口 + 真 EOF + 输出上限 + 残行）\n");
    }
    return ok;
}

// fs 轮（P6，mode 7）：read/write/edit 三个工具端到端 —— 观察策略（先读才能写）、
// 越权路径被拒、行窗口与 diff 视图。返回 false = 本轮红；工作区由 ws 给出。
fn fs_round(base: &const Config, tag: &const byte, ws: &const byte) bool {
    mock_mode = 7;
    mock_expect_shell = false;
    mock_expect_fold = false;
    mock_expect_steer = false;
    if !fs_ws_prepare(ws) {
        out_err("selftest: cannot prepare fs workspace\n");
        return false;
    }
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        out_err("selftest: socket() failed\n");
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var c: Config = cfg_default();
    cfg_pin_api(&c, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append_cstr(&c.task, "玩一下文件工具");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = false;
    c.stream = true;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.quiet = true;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    const rc: i32 = agent_run(&c);
    cfg_free(&c);
    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if rc != AGENT_OK {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else {
        // 最终内容：write 覆盖成 5 行，edit 把 alpha → ALPHA
        var p2: Buf = buf_new(256);
        defer { buf_free(&p2); }
        _ = buf_append_cstr(&p2, ws);
        _ = buf_append_cstr_z(&p2, "/doc.txt");
        const want: &const byte = "ALPHA one\nbeta two\ngamma three\nbeta four\ndelta five\n";
        if !file_equals(&p2.ptr[0] as &const byte, want) {
            out_err("FAIL: doc.txt 内容不符");
            ok = false;
        } else {
            out_err("ok");
        }
    }
    out_err("\n");
    _ = base;
    return ok;
}

