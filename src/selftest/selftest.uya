// src/selftest/selftest.uya — 离线自测（内置 mock LLM）+ 传输层探针
//
// 本文件：全部离线自测轮的宿主：mock LLM 服务端子进程（HTTP 解析 + 按 `mock_mode` 出响应体 +
//   请求体内的断言）、单轮驱动 `selftest_round`（fork → 假 DSH_HOME/工作区 → 跑完整 agent 循环
//   → 收退出码与写盘内容）、探针 `probe_main`，以及各域的自测轮：SSE 流式、终端层、会话日志与
//   恢复、DSH 设置、图片、剪贴板、/sessions 列表、read 行窗口、workflow、工具调用序列化上限、
//   diff、子代理窗口、/watch、Responses 接口、访问模式/沙箱、plan 闸门、统计与上下文占用、
//   进程采样、终端标题、任务状态、/goal、模型目录、模型选择的写回、Git worktree 与残留回收。
// 不变量：① mock 与断言必须**确定性** —— 同一夹具必须给出同一 verdict，不许依赖真实网络 / 时钟 /
//   环境（唯一允许的外来输入是显式设置的 `mock_*` 全局开关）；② 判定码只用**低 8 位**：子进程用
//   `sys_exit` 收尾，256 起会被截断（261 显示成 5，踩坑 89），所以外部命令/工具的返回码要先折进
//   0..255 再当 verdict；③ 每轮可单跑（`UYA_SELFTEST_*_ONLY` 环境变量）且幂等 —— 连跑两次必须
//   都 PASS，轮次之间不许残留全局状态（工作区 / DSH_HOME 每轮重建）；④ 轮次自己 fork 的子进程
//   必须由该轮收干净，不许留孤儿。
// 依赖：libc（syscall/unistd/heap/fcntl/signal）、std.json.encoder、foundation/bufx、net（LLM
//   协议与 SSE）、term 与 term/tui、tools（fs/shell）、session（日志/DSH 配置/统计/信号）、agent
//   （历史与主循环）、vcs/gitx、diff；另三个自测文件经合并命名空间提供 `sigx_*` / `shellx_*` /
//   `tui_*` 入口。
// 命名：对外只有 `probe_main`（--probe）、`selftest_main`（--selftest）与 diff fixture 的
//   `dg_fixture_make`/`dg_fixture_empty`；私有前缀 `mock_*`（mock LLM）、`sse_*`、`ty_*`（终端层）、
//   `resp_*`（Responses）、`stx_*`（统计）、`tsx_*`（任务）、`dp_/dg_/gcr_/mx_/wt_`，以及各轮的
//   `*_round`。
//
// --selftest 完全不联网、不需要 API key：
//   1) 父进程 bind 127.0.0.1:0 拿到端口，fork 出子进程跑 mock LLM；
//   2) 父进程用 http://127.0.0.1:<port>/v1 跑完整的 agent 循环（build_request →
//      http_request → std.json 解析 → 工具执行 → 结果回灌 → 第二轮）；
//   3) mock 端断言：第一轮请求的 tools 里 run_shell 的出现与否符合预期，
//      第二轮请求里必须带上工具执行结果；父进程断言写出的文件内容与退出码。
//   共跑两轮：allow_shell=true / false，覆盖 A3 与 A6。

use libc.syscall;
use libc.unistd;
use libc.heap;
use std.runtime.saved_envp;
use std.json.encoder.JsonWriter;

var mock_expect_shell: bool = true;

// 自测轮次模式（fork 前设置，子进程继承）：
//   0 = shell 轮（write_file，tools 里应有 run_shell）
//   1 = no-shell 轮（write_file，tools 里不应有 run_shell）
//   2 = tools 轮（read_file 成功 / read_file 越权被拒 / run_shell 超时被杀；末轮响应用 chunked）
//   3 = HTTP 401（非 200 必须报错退出，且把错误体打出来）
//   5 = max-steps 熔断（模型每轮都调工具，agent 必须在 N 步后停下）
//   6 = 中断轮：发若干帧后挂住不发 [DONE]，客户端应被 Ctrl-C 打断
//  17 = 不限步数轮：默认 max_steps=0（不限）时连给 14 轮工具调用（超过旧默认 12），
//       第 15 轮才给最终答案 —— agent 必须一路跑完并以 0 退出（默认回到 12 这轮就失败）
//  23 = 控制字节轮：跑一条 stdout 带 NUL 的命令，断言它转义成 \u0000 之后才上线
//       （chat 与 responses 各跑一遍，靠 mock_expect_resp 区分端点与响应形状）
//  27 = 「退不出」轮（P28）：第 1 轮让 agent 跑一条**长命令**（sleep 15，工具卡片上的
//       description 就是 mock_args_json 里那个 "selftest command"）；之后的请求按内容分叉 ——
//       带第二个任务文本（"task-two"）的回 SELFTEST-TUI-QUIT-OK，其余（被中断的那一轮）回
//       SELFTEST-TUI-QUIT-MID。用来钉「工具跑着的时候 ctrl+d / esc / /exit 都要立刻生效」
//       以及「中断过的会话下一个任务必须照常跑完」
var mock_mode: i32 = 0;
// 轮数覆盖（-1 = 用 mode 自己的默认）：不想让 mock 等满轮数时用，
// 例如「工具跑着就退出」的轮次只会服务 1 次请求
var mock_limit: i32 = -1;
// --compat-fold 轮：mock 期望看到「折叠成一条 user 消息」的旧协议
var mock_expect_fold: bool = false;
// steer 轮：mock 期望在下一轮请求里看到运行中输入的文本
var mock_expect_steer: bool = false;
// 控制字节轮：true = 这一轮跑 responses 协议（端点/响应形状都按 responses 来）
var mock_expect_resp: bool = false;
// P18：答案帧里是否带 usage。默认关闭 —— 打开会让 g_last_prompt_tokens 从「估算」变成
// 提供方读数，进而改变自动压缩的触发时机（compact-auto / responses-compact / workflow
// 那几轮都会跟着变）。所以只给 stats-usage 这一轮开。
var mock_usage_on: bool = false;
// P23：SSE 两段 chunk 之间的停顿（纳秒）。默认 0 = 一次写完；tui-cmd 那轮要一个
// 「回合还活着」的窗口，好让父进程在回合运行中往 PTY 里敲 /status。
var mock_sse_gap_ns: i64 = 0;
// P46：自动起标题落到 mock 上的观测。`mock_title_text` 是回给标题调用的**模型标题**，
// 上屏判据逐字节比对它（子进程在 fork 时继承这份值）。
// ⚠ 计数不放这里：mock 跑在 fork 出来的子进程里，父进程读不到它改过的全局量 ——
// 「收了几次、落第几轮」由 mock 自己断言（判定码回报），端到端时机由父进程按
// **屏幕上的字节顺序**判（模型标题的 OSC 2 必须出现在 mock 最终答案之前）。
var mock_title_text: [byte: 64] = "selftest-title";

// 供自测断言用的 lflag 位（与 tty.uya 内部常量一致）
const TTY_LFLAG_TEST_ISIG: u32 = 0x0001;
const TTY_LFLAG_TEST_ICANON: u32 = 0x0002;
const TTY_LFLAG_TEST_ECHO: u32 = 0x0008;
const TTY_LFLAG_TEST_IEXTEN: u32 = 0x8000;

// 自测用的协议钉桩：显式声明（等价于 --api=…），于是不会触发一次性协商。
// 只有刻意测协商的那一轮才留 src_api = API_SRC_DEFAULT（= 默认 responses + 协商）。
fn cfg_pin_api(c: &Config, style: u8) void {
    c.api_style = style;
    c.src_api = 3;
}

// P82：传输层重试轮的一行调用（三个 mode 只差 mode 号与工作区，其余参数恒定）。
// 为什么要有一个包装：`selftest_round` 的九个参数在调用点拼成一行会超 80 字符，
// 而这三轮把「非默认」的那几项都写死在这里更好读（interactive 必须 false ——
// 见 st_round_driver 里 mode 46 那段注释：按键要留到**退避**那一段才被读到）。
fn netretry_round(base: &const Config, tag: &const byte, mode: i32,
                  ws: &const byte) bool {
    return selftest_round(base, tag, mode, true, ws, true, false, false, false);
}

// P82：退避函数的**纯函数**轮（不起 mock、不发请求，几微秒跑完）。
// 为什么它必须独立成一轮，而不是塞进上面三轮的断言里：「随机数真的在动」这件事
// **不能**用「两次真跑的退避不相等」来判（两次独立取样有 1/2501 的概率撞上同一个值 ——
// 实测在整轮 selftest 里红过一次，那是一条天生会 flake 的判据），只能拿纯函数喂固定
// 输入序列来判（见 `rtx_backoff_pure_check`）。顺带让「区间端点算错一格」这类错误有
// 一条完全不依赖网络与运气的判据。
fn netretry_pure_round(tag: &const byte) bool {
    var ok: bool = true;
    const pass: bool = rtx_backoff_pure_check(tag, &ok);
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if pass {
        out_err("ok\n");
    } else {
        out_err("FAIL\n");
    }
    return pass;
}

// --selftest 的总入口（agent.uya 里一行调用）：先**关掉** worktree 模式（出厂已开，
// 这是自测自己的复位），再按 `UYA_SELFTEST_*_ONLY` 环境变量分流到单轮调试入口，
// 否则顺序跑全部轮次。
// 返回 AGENT_OK / AGENT_PROTO；任一硬轮失败即 FAIL（判定码只用低 8 位，见踩坑 89）。
export fn selftest_main(base: &const Config) i32 {
    _ = base;
    // P37/P111：下面这一行**现在是自测唯一的护栏，别删**。出厂默认已经翻了
    // （`g_wt_on = true`，见 worktreex —— 「跑在独立工作区里」是默认行为），所以
    // 不在这里显式复位的话，每个 fork 出去跑一轮的测试子进程都会去建 worktree /
    // 切工作区 —— mock 网关的路径与工作目录全被搬走，tui-pty / tui-diff 这类
    // **真 PTY** 轮整片红（P37 实测过）。worktree 那几轮自己开、结束时关。
    // （从前它挡的是「真机 DSH preset 把 wt_on 带进来」，现在挡的是出厂默认本身。）
    wt_set_on(false);
    wt_reset();
    // P82：**整轮自测默认关掉传输层重试**。出厂默认是「不限次数、退避 0.5–3 s」，
    // 而自测里 mock 服务完 `limit` 轮就退出 ⇒ 任何一条「客户端还会再发一次」的腿都会
    // 撞上 ECONNREFUSED，然后无限重试下去（整轮套件没有全局超时，一个轮次就能拖死它）。
    // 所以这里把闸门关掉 = 「逐字节回到 P82 之前的行为」，由 P82 那三轮自己开回来。
    // 与上面 `wt_set_on(false)` 同一条纪律：**会改变全局行为的东西，自测必须自己钉住初值**。
    rtx_set_max(0);
    // P94/P96：回合级的自动继续同理 —— 出厂是「交互式会话里不限次数地续」，而自测里
    // mock 服务完 `limit` 轮就退出 ⇒ 任何一条「回合还会再跑一次」的腿都会去撞一个已经
    // 关掉的端口（甚至无限续下去）。默认关掉 = 各轮逐字节回到 P94 之前的行为，
    // mode 50 / 51 自己把闸门开回来。
    // （与 `rtx_set_max(0)` 同一条纪律：会改变全局行为的东西，自测必须自己钉住初值。）
    turn_retry_set_max(0);
    // 调试入口：只跑 P46（/title）轮
    if env_present("UYA_SELFTEST_TITLE_ONLY" as &const byte) {
        const t0: bool = title_round("title-format" as &const byte);
        const t1: bool = title_cmd_round("title-cmd" as &const byte);
        if t0 && t1 {
            out_err("SELFTEST TITLE PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST TITLE FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P26（/diff）轮
    if env_present("UYA_SELFTEST_DIFF_ONLY" as &const byte) {
        const d0: bool = diff_parse_round("diff-parse" as &const byte);
        const d1: bool = diff_git_round("diff-git" as &const byte);
        if d0 && d1 {
            out_err("SELFTEST DIFF PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST DIFF FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P97（async 运行时）轮 —— 改 rt 层不必等整轮 selftest
    if env_present("UYA_SELFTEST_ASYNC_ONLY" as &const byte) {
        const a0: bool = async_rt_round("async-rt" as &const byte);
        const a1: bool = async_io_round("async-io" as &const byte);
        const a2: bool = async_keys_round("async-keys" as &const byte);
        const a3: bool = async_net_round("async-net" as &const byte);
        const a4: bool = async_turn_round("async-sse" as &const byte);
        const a5: bool = async_conc_round("async-conc" as &const byte);
        if a0 && a1 && a2 && a3 && a4 && a5 {
            out_err("SELFTEST ASYNC PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST ASYNC FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 TUI 轮（改动 TUI 时不必等整轮 selftest）
    // 调试入口：只跑 P21（访问模式/沙箱）轮
    if env_present("UYA_SELFTEST_PERM_ONLY" as &const byte) {
        const p0: bool = perm_modes_round("perm-modes" as &const byte);
        const p1: bool = san_profile_round("san-profile" as &const byte);
        const p2: bool = san_shell_round("san-shell" as &const byte);
        const p3: bool = perm_readonly_round(base, "perm-readonly" as &const byte, "build/selftest_ws_perm" as &const byte);
        const p4: bool = san_tool_round(base, "san-tool" as &const byte, "build/selftest_ws_san" as &const byte);
        const p5: bool = plan_gate_round(base, "plan-gate" as &const byte, "build/selftest_ws_plangate" as &const byte);
        if p0 && p1 && p2 && p3 && p4 && p5 {
            out_err("SELFTEST PERM PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST PERM FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P25（任务状态）轮
    if env_present("UYA_SELFTEST_TASKS_ONLY" as &const byte) {
        const q0: bool = tasks_render_round("tasks-render" as &const byte);
        const q2: bool = tasks_scroll_round("tasks-scroll" as &const byte);
        const q1: bool = tui_tasks_round("tui-tasks" as &const byte);
        if q0 && q1 && q2 {
            out_err("SELFTEST TASKS PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST TASKS FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P34（工作区）两轮
    if env_present("UYA_SELFTEST_WS_ONLY" as &const byte) {
        const pw0: bool = ws_resolve_round("ws-resolve" as &const byte);
        const pw1: bool = ws_tool_round("ws-tool" as &const byte, base);
        if pw0 && pw1 {
            out_err("SELFTEST WS PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST WS FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑「异常收尾形状」轮 —— P54（退化响应：证据 + 同一步重发一次）两轮
    // 加 P59（token 上限截断：正文进历史 + warning 收口）一轮：三轮回合的 mock 都是
    // 「不正常给答案的收尾」，一起跑最省事。
    if env_present("UYA_SELFTEST_EMPTY_ONLY" as &const byte) {
        const e0: bool = selftest_round(base, "empty-retry", 41, true, "build/selftest_ws_empty", true, false, false, false);
        const e1: bool = selftest_round(base, "empty-retry-giveup", 42, true, "build/selftest_ws_empty2", true, false, false, false);
        const e2: bool = selftest_round(base, "max-tokens-cut", 44, true, "build/selftest_ws_maxtok", true, false, false, false);
        if e0 && e1 && e2 {
            out_err("SELFTEST EMPTY PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST EMPTY FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P82（传输层重试：503/429 重发 + 退避里可中断 + 401 不重试）三轮
    if env_present("UYA_SELFTEST_RETRY_ONLY" as &const byte) {
        const n0: bool = netretry_round(base, "net-retry", 45,
            "build/selftest_ws_netretry");
        const n1: bool = netretry_round(base, "net-retry-intr", 46,
            "build/selftest_ws_netintr");
        const n2: bool = netretry_round(base, "net-retry-401", 47,
            "build/selftest_ws_net401");
        const n3: bool = netretry_pure_round(
            "net-retry-backoff" as &const byte);
        // P94：同一支调试入口里也带上回合级自动继续那一轮（同一族：都是「失败之后
        // 按同一套退避再来一次」）。P96 又加了「所有失败都续」那一腿。
        const n4: bool = netretry_round(base, "turn-retry", 50,
            "build/selftest_ws_turnretry");
        const n5: bool = netretry_round(base, "turn-retry-all", 51,
            "build/selftest_ws_turnretry2");
        if n0 && n1 && n2 && n3 && n4 && n5 {
            out_err("SELFTEST RETRY PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST RETRY FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P29（/goal 人类命令）+ P87（目标按会话隔离）+ 清单的落盘折回三轮
    if env_present("UYA_SELFTEST_GOAL_ONLY" as &const byte) {
        const g0: bool = goal_cmd_round("goal-cmd" as &const byte);
        const g1: bool = goal_sess_round("goal-sess" as &const byte);
        const g2: bool = todo_resume_round("todo-resume" as &const byte);
        if g0 && g1 && g2 {
            out_err("SELFTEST GOAL PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST GOAL FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P37（模型选择 / 推理强度 / worktree）轮
    if env_present("UYA_SELFTEST_MODEL_ONLY" as &const byte) {
        const q0: bool = model_catalog_round("model-catalog" as &const byte);
        const q1: bool = model_apply_round("model-apply" as &const byte);
        const q2: bool = effort_apply_round("effort-apply" as &const byte);
        const q3: bool = model_log_round("model-log" as &const byte);
        const q4: bool = worktree_round("worktree" as &const byte);
        const q5: bool = worktree_discard_round("worktree-discard" as &const byte);
        // P113：没配 git 身份时 finish 的失败必须说人话（本仓 CI 一直红在这上面）
        const q5b: bool = worktree_identity_round(
            "worktree-identity" as &const byte);
        // P49：残留 worktree 的回收判据
        const q6: bool = worktree_reclaim_round("worktree-reclaim" as &const byte);
        // P71：人切完模型/强度之后写回 DSH 设置（与模型那几轮同一个舞台）
        const q7: bool = dshw_save_round("dsh-writeback" as &const byte);
        // P81：上下文窗口的来源链（映射 / 目录条目 / 沿用 + 显式钉住）
        const q8: bool = ctxwin_round("ctxwin" as &const byte);
        // P84：收图能力位（默认支持 / 目录三态 / env·cli 钉住）
        const q9: bool = vs_round("vision" as &const byte);
        if q0 && q1 && q2 && q3 && q4 && q5 && q5b && q6 && q7 && q8 && q9 {
            out_err("SELFTEST MODEL PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST MODEL FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P33/P35（/sessions 列表）轮：纯函数 + TUI 浮层 + 大日志 meta
    if env_present("UYA_SELFTEST_SESS_ONLY" as &const byte) {
        const s0: bool = sess_list_round("sess-list" as &const byte);
        const s1: bool = tui_sessions_round("tui-sessions" as &const byte);
        const s2: bool = sess_meta_big_round("sess-meta-big" as &const byte);
        const s3: bool = sess_list_big_round("sess-list-big" as &const byte);
        // P71：写回轮（与模型轮同一份实现，这里也挂一条 —— 改 sess 那条线时不必等整轮）
        const s4: bool = dshw_save_round("dsh-writeback" as &const byte);
        if s0 && s1 && s2 && s3 && s4 {
            out_err("SELFTEST SESS PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST SESS FAIL\n");
        return AGENT_PROTO;
    }
    if env_present("UYA_SELFTEST_TUI_ONLY" as &const byte) {
        if tui_selftest_all() {
            out_err("SELFTEST TUI PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST TUI FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P38（bash 工具的进程侧：终端收口 / 停住即收口 / 整组收子孙）
    if env_present("UYA_SELFTEST_SHELL_ONLY" as &const byte) {
        if shellx_selftest_all() {
            out_err("SELFTEST SHELL PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST SHELL FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P104（后台任务/子代理的异步完成通知：端到端 + 队列 + 让路）
    if env_present("UYA_SELFTEST_NOTIFY_ONLY" as &const byte) {
        if bg_notify_rounds(base) {
            out_err("SELFTEST NOTIFY PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST NOTIFY FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P15/P40（子代理窗口面板：几何 + 等宽 + 消息预览贴尾）——
    // 改这一行排版时比整轮 selftest 快得多
    // P80：把形状适配层的译文原样打到 fd 2，交给**外部** oracle（`make wire-schema` 拿
    // DSH 自己的 zod schema 校验）。为什么必须有这条出口：`wire-adapt` 轮的断言都是
    // 子串判据，而「JSON 结构坏掉」能完全绕过它们（实测抓到两种：少个引号、多个花括号，
    // 子串全中而 schema 判红）。
    // P80：把**一份真日志**逐行翻译后打出去（宿主的 `/api` 事件源）。
    // 与夹具那条的区别：夹具验「每种形状都对」，这条验「一整份真日志能翻到底」
    // （含本仓那些 DSH 不认识的私有事件 —— 它们必须原样透传而不是把流弄断）。
    const wire_file: &byte = getenv("UYA_SELFTEST_WIRE_FILE" as &const byte);
    if (wire_file as usize) != 0 {
        var out: Buf = buf_new(1048576);
        defer { buf_free(&out); }
        const n: usize = wire_dump_file(wire_file, &out);
        if n > 0 {
            _ = sys_write(2, out.ptr as *const byte, out.len);
        }
        return AGENT_OK;
    }
    if env_present("UYA_SELFTEST_WIRE_DUMP" as &const byte) {
        var line: Buf = buf_new(8192);
        var out: Buf = buf_new(16384);
        defer { buf_free(&line); buf_free(&out); }
        const n: usize = wire_fixture_count();
        var i: usize = 0;
        while i < n {
            if wire_fixture(i, &line)
                && wire_dump_one(line.ptr as &const byte, &out) {
                _ = sys_write(2, out.ptr as *const byte, out.len);
            }
            i = i + 1;
        }
        return AGENT_OK;
    }
    // P90 调试入口：只跑 web 会话子进程配置那一轮（改 `web_child_env_cfg` 时不必等
    // 整轮 web 轮 —— WEB_ONLY 那一支前面几轮要真 PTY 与真子进程，重得多）
    if env_present("UYA_SELFTEST_WEBCHILD_ONLY" as &const byte) {
        if web_childcfg_round("web-childcfg" as &const byte) {
            out_err("SELFTEST WEB-CHILDCFG PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST WEB-CHILDCFG FAIL\n");
        return AGENT_PROTO;
    }
    // P60：只跑 web 轮（改 web 界面时比整轮快）
    if env_present("UYA_SELFTEST_WEB_ONLY" as &const byte) {
        const w0: bool = web_emu_round("web-emu" as &const byte);
        const w1: bool = web_http_round("web-http" as &const byte);
        const w2: bool = web_page_round("web-page" as &const byte);
        const w3: bool = web_dispatch_round("web-dispatch" as &const byte);
        const w4: bool = web_pty_round("web-pty" as &const byte);
        const w5: bool = web_frame_round("web-frame" as &const byte);
        const w6: bool = web_seg_round("web-seg" as &const byte);
        const w7: bool = web_size_round("web-size" as &const byte);
        const w8: bool = web_exit_round("web-exit" as &const byte);
        const w9: bool = web_listen_round("web-listen" as &const byte);
        const w10: bool = web_childcfg_round("web-childcfg" as &const byte);
        // P80：`session/follow` 首帧（快照）必须是**合法 JSON** —— 判据走本仓的
        // JSON 解析器（子串断言对「结构坏掉」是瞎的，实测漏过 `},,{`）。
        const w11: bool = web_snapshot_round("web-snapshot" as &const byte);
        // P80：设置面板那一簇（四个页签的元信息查询）—— 未实现时页面是「红字」，
        // 不是崩溃，所以每个方法都要有腿。
        const w12: bool = web_panel_round("web-panel" as &const byte);
        // P80 第二十三批：活会话那两轮（模型目录装配 + 输入帧/事件 tail 的位移）。
        const w13: bool = web_models_round("web-models" as &const byte);
        const w14: bool = web_chat_round("web-chat" as &const byte);
        // P80 第二十三批：业务错的信封（必须能拆成 ok:false —— 拆不出来时
        // 客户端把带标记的垃圾值当成功返回值，症状只是「点了没反应」）。
        const w15: bool = web_errenv_round("web-err-env" as &const byte);
        if w0 && w1 && w2 && w3 && w4 && w5 && w6 && w7 && w8 && w9 && w10
            && w11 && w12 && w13 && w14 && w15 {
            out_err("SELFTEST WEB PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST WEB FAIL\n");
        return AGENT_PROTO;
    }
    if env_present("UYA_SELFTEST_PANEL_ONLY" as &const byte) {
        if win_round("subagent-panel" as &const byte) {
            out_err("SELFTEST PANEL PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST PANEL FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P66/P67（项目记忆：身份 + 存储 + 摄取 + 开工包）—— 改 pm/ 时比整轮快得多
    if env_present("UYA_SELFTEST_PM_ONLY" as &const byte) {
        const q0: bool = pms_identity_round("pm-identity" as &const byte);
        const q1: bool = pms_roundtrip_round("pm-roundtrip" as &const byte);
        const q2: bool = pms_concurrent_round("pm-concurrent" as &const byte);
        // P67：摄取（确定性抽取）+ 开工包（失效校验 / 截断顺序 / 预算）
        const q3: bool = pms_ingest_round("pm-ingest" as &const byte);
        const q4: bool = pms_digest_round("pm-digest" as &const byte);
        // P68：端到端（摄取 → 落盘 → 下一个会话注入）+ --no-memory 的回归腿
        const q5: bool = pms_e2e_round("pm-e2e" as &const byte, base);
        // P107：状态与出处 token（六态 × 六源 + superseded 永不注入 + 一份实现）
        const q6: bool = pms_tokens_round("pm-tokens" as &const byte);
        if q0 && q1 && q2 && q3 && q4 && q5 && q6 {
            out_err("SELFTEST PM PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST PM FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P70（MCP 插件）四条腿 —— 改 plugin/ 时不必等整轮 selftest
    if env_present("UYA_SELFTEST_MCP_ONLY" as &const byte) {
        if mcp_selftest_rounds() {
            return AGENT_OK;
        }
        return AGENT_PROTO;
    }
    // P92：只跑出站代理两段（纯函数 + 现地假代理）—— 改 net/proxyx 或那条路由时
    // 比整轮快得多。判据全是线上字节与回环套接字，不联网。
    if env_present("UYA_SELFTEST_PROXY_ONLY" as &const byte) {
        if pxr_rounds("proxy" as &const byte) {
            out_err("SELFTEST PROXY PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST PROXY FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P80（DNS 解析器发现）四段 —— 改 httpc 的 DNS 那一节时比整轮快得多
    if env_present("UYA_SELFTEST_DNS_ONLY" as &const byte) {
        if dnr_rounds("dns-resolv" as &const byte) {
            out_err("SELFTEST DNS PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST DNS FAIL\n");
        return AGENT_PROTO;
    }
    // P83：只跑剪贴板三源（改这条线时比整轮 selftest 快得多）。
    // 顺序：先纯函数（毫秒级）→ 再 helper（起子进程）→ 最后真 PTY（最慢、最容易受环境干扰）。
    if env_present("UYA_SELFTEST_CLIP_ONLY" as &const byte) {
        const c0: bool = clip_term_round("clip-term" as &const byte);
        const c1: bool = clip_helper_round("clip-helper" as &const byte);
        const c2: bool = clip_pty_round("clip-pty" as &const byte);
        const c3: bool = clip_copy_round("clip-copy" as &const byte);
        // P86：慢终端（400ms 应答）—— 跨域 SSH 的 RTT 就是探测往返，预算必须容得下它。
        const c4: bool = clip_slow_round("clip-slow" as &const byte);
        if c0 && c1 && c2 && c3 && c4 {
            out_err("SELFTEST CLIP PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST CLIP FAIL\n");
        return AGENT_PROTO;
    }
    // P110：只跑 TLS 信任两轮（tls-pin / tls-ca）—— 改 x509min / cachain / TOFU
    // 时比整轮快得多；两轮都离线，不联网、不需要 API key。
    if env_present("UYA_SELFTEST_TLS_ONLY" as &const byte) {
        const t0: bool = tpf_rounds("tls-pin" as &const byte);
        const t1: bool = tca_rounds("tls-ca" as &const byte);
        if t0 && t1 {
            out_err("SELFTEST TLS PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST TLS FAIL\n");
        return AGENT_PROTO;
    }
    // P112：只跑版本唯一性那一轮（改版本号 / UA / DSH 宿主字段时用）。
    // 它纯字符串、几毫秒，且**不需要 mock 网关**，所以单跑入口也很有用。
    if env_present("UYA_SELFTEST_VERSION_ONLY" as &const byte) {
        if version_rounds("version" as &const byte) {
            out_err("SELFTEST VERSION PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST VERSION FAIL\n");
        return AGENT_PROTO;
    }
    out_err("selftest: offline end-to-end (mock LLM on 127.0.0.1, no network, no API key)\n");
    const r1: bool = selftest_round(base, "shell", 0, true,
        "build/selftest_ws_shell", true, false, false, false);
    // P16：就着刚跑完的这一轮，回读会话日志确认思考全文落盘（显示层只留一行，全文只在日志里）
    const r1r: bool = reasoning_log_round("reasoning-log", "build/selftest_agent_home", "build/selftest_ws_shell");
    const r2: bool = selftest_round(base, "no-shell", 1, false, "build/selftest_ws_noshell", true, false, false, false);
    const r3: bool = selftest_round(base, "tools", 2, true, "build/selftest_ws_tools", true, false, false, false);
    const r4: bool = selftest_round(base, "http401", 3, true, "build/selftest_ws_401", true, false, false, false);
    const r5: bool = selftest_round(base, "max-steps", 5, true, "build/selftest_ws_steps", true, false, false, false);
    // 默认不限步数：mock 连给 14 轮 tool_calls（超过旧默认 12）才给最终答案，
    // agent 必须一路跑到最终答案并以 0 退出（这轮不设 max_steps，吃的就是默认值）
    const r5b: bool = selftest_round(base, "unlimited-steps", 17, true, "build/selftest_ws_unlimited", true, false, false, false);
    // 非流式回归：--no-stream 走旧路径，同一份 mock 数据（JSON 回包）
    const r6: bool = selftest_round(base, "noshell-nostream", 1, false, "build/selftest_ws_nostream", false, false, false, false);
    // 折叠协议回归：--compat-fold
    const r7: bool = selftest_round(base, "shell-fold", 0, true, "build/selftest_ws_fold", true, true, false, false);
    // P3：运行中用户输入（steer）在下一个 step 被采纳
    const r8: bool = selftest_round(base, "steer", 0, true, "build/selftest_ws_steer", true, false, true, false);
    // P3：Ctrl-C 中断当前回合（不该派发工具、不该有下一轮请求）
    const r9: bool = selftest_round(base, "interrupt", 6, true, "build/selftest_ws_intr", true, false, false, true);
    const s0: bool = sse_round(SSE_CASE_BASIC, "stream-basic");
    const s1: bool = sse_round(SSE_CASE_TOOLS, "stream-tools");
    const s2: bool = sse_round(SSE_CASE_NODONE, "stream-nodone");
    const s3: bool = sse_round(SSE_CASE_BADJSON, "stream-badjson");
    const s4: bool = sse_round(SSE_CASE_REASONING_LENGTH, "stream-length");
    // P24：首 token 打点的三条边界（只有思考 / 只有工具参数 / 没有任何增量）
    const s5: bool = sse_round(SSE_CASE_REASONING_ONLY, "stream-firsttok-reasoning");
    const s6: bool = sse_round(SSE_CASE_CALLONLY, "stream-firsttok-call");
    const s7: bool = sse_round(SSE_CASE_NODELTA, "stream-firsttok-none");
    const t0: bool = tty_round("tty-editor");
    const t1: bool = sess_round("session-log");
    const t2: bool = dshcfg_round("dsh-config");
    const t3: bool = fs_round(base, "fs-tools", "build/selftest_ws_fs");
    // P19：read 的行窗口（真实 total / 后段窗口 / 真 EOF）—— 见踩坑 34
    const t3b: bool = read_window_round("read-window" as &const byte, "build/selftest_ws_read" as &const byte);
    const t4: bool = jobs_round(base, "bash-jobs", "build/selftest_ws_jobs");
    const t5: bool = prompt_round(base, "prompt-todo-plan", "build/selftest_ws_prompt");
    const t6: bool = round_run(base, "compact-prune", "build/selftest_ws_prune", 11, 0 as i64, "产生大输出");
    const t7: bool = round_run(base, "compact-auto", "build/selftest_ws_compact", 12, 200 as i64, "触发自动压缩");
    // 长历史回归：40 轮 × 2 个工具调用（≈124 条消息）必须全程不丢消息、配对完整
    const t10: bool = round_run_opts(
        base,
        "history-long",
        "build/selftest_ws_histcap",
        18,
        0 as i64,
        HISTCAP_ROUNDS + 5,
        "长历史：连跑 40 轮工具调用，一条消息都不许丢"
    );
    // 尾部修复语义：只丢不完整的一组，完整的一组必须保留
    const t11: bool = hist_round("hist-repair");
    // P89：**全段**配对修复 —— 悬空的组不在结尾时（后面还跟着 user）也要修好
    const t11b: bool = hist_pairing_round("hist-pairing");
    // P50：图片附件（纯函数层：嗅探/尺寸/预算/内容寻址/base64/JSON 往返）
    const t12: bool = img_round("img-sniff");
    // P51：剪贴板（X11 客户端的可测部分）
    const t13: bool = clip_round("clip-parse");
    // P83：剪贴板三源 —— 纯函数（终端协议的线格式/分片/逐块解码）+ 假 helper + 真 PTY。
    // 这三轮是本轮「没有 X11 的机器上也能用 / SSH 也能用」的唯一机器判据（见 st_clip.uya）。
    const c0: bool = clip_term_round("clip-term" as &const byte);
    const c1: bool = clip_helper_round("clip-helper" as &const byte);
    const c2: bool = clip_pty_round("clip-pty" as &const byte);
    // P84：写方向（拖选复制）—— X11 选区所有者，请求体逐字节 + 无 X11 明确报错
    const c3: bool = clip_copy_round("clip-copy" as &const byte);
    // P86：慢终端（400ms 应答）—— 跨域 SSH 的 RTT 就是探测往返，预算必须容得下它。
    const c4: bool = clip_slow_round("clip-slow" as &const byte);
    const t8: bool = skill_round(base, "skills-web-search", "build/selftest_ws_skill", "build/selftest_skills");
    const t9: bool = deleg_round(base, "subagent-goal", "build/selftest_ws_deleg");
    const u0: bool = wf_round(base, "workflow", "build/selftest_wf_ws");
    const u1: bool = knobs_round("preset-knobs-dshsess");
    const u2: bool = hist_keep_round("hist-keep");
    // 步数默认值：0 = 不限步数。这条断言是「默认值」这件事的唯一单点保证 ——
    // 谁把默认值改回 12，unlimited-steps 轮与这里会同时红。
    var cdef: Config = cfg_default();
    var u3: bool = true;
    if cdef.max_steps != 0 {
        out_err("selftest[default-max-steps] FAIL: cfg_default().max_steps != 0（默认必须是不限步数）\n");
        u3 = false;
    }
    // 默认协议：responses + 未声明（= 允许一次性协商回退 chat）。谁把它改回 chat，这条会红。
    if cdef.api_style != LLM_STYLE_RESPONSES || cdef.src_api != API_SRC_DEFAULT {
        out_err("selftest[default-api] FAIL: 默认必须是 responses + 可协商（src_api=0）\n");
        u3 = false;
    }
    if !cdef.api_store || !cdef.api_dev_role || !cdef.api_reasoning {
        out_err("selftest[default-api] FAIL: responses 的三个 compat 默认值应当是 true\n");
        u3 = false;
    }
    cfg_free(&cdef);
    const v0: bool = diffx_round("diff-render");
    const v1: bool = view_round("tool-view");
    const v7: bool = win_round("subagent-panel");
    // P42：/watch —— 事件渲染（纯函数）+ 增量读（分批写文件）
    const wch0: bool = watch_render_round("watch-render");
    const wch1: bool = watch_poll_round("watch-poll", "build/selftest_ws_watch");
    // P46：/watch 现役清单的「选中即跟随」——清单行 → 编号（纯函数）
    const wch2: bool = watch_pick_round("watch-pick-parse");
    const v5: bool = think_round("think-row");
    // P16：工具正文默认关闭（只留一行）—— 和 max_steps 那条一样，是「默认值」的单点保证：
    // 谁把默认值改回 6，view_round 的 A/D/E 与这里会同时红。
    var cdef2: Config = cfg_default();
    var v6: bool = true;
    if cdef2.tool_lines != 0 {
        out_err("selftest[default-tool-lines] FAIL: cfg_default().tool_lines != 0（默认必须只留一行）\n");
        v6 = false;
    }
    cfg_free(&cdef2);
    // P15：请求体转义（NUL 等控制字节）—— 纯函数轮 + 端到端轮（工具结果里真的带 NUL），
    // 端到端那条 chat 与 responses 各跑一遍（两条协议的请求体都必须合法）。
    const v2: bool = jsonesc_round("json-escape");
    // 踩坑 35：tool_calls 序列化容量（固定 8192 把「参数有点大」误报成 OOM 的那个坑）
    const v8: bool = toolcalls_cap_round("toolcalls-cap");
    // 踩坑 35 端到端：mock 给一个 arguments > 8 KiB 的 write 调用 —— 老代码在这一步
    // 直接以 "error: out of memory serializing tool_calls" 中止整轮（用户截图那一幕）
    const v9: bool = selftest_round(base, "toolcalls-big", 25, true, "build/selftest_ws_bigcall", true, false, false, false);
    mock_expect_resp = false;
    const v3: bool = round_run_api(base, "ctrl-bytes", "build/selftest_ws_ctrl", 23, 0 as i64, 4, LLM_STYLE_CHAT, false, "跑一条输出含 NUL 的命令");
    mock_expect_resp = true;
    const v4: bool = round_run_api(base, "ctrl-bytes-resp", "build/selftest_ws_ctrl_resp", 23, 0 as i64, 4, LLM_STYLE_RESPONSES, false, "跑一条输出含 NUL 的命令");
    mock_expect_resp = false;
    // Responses 接口：解析器轮（事件表逐项）+ 非流式 + 请求体 + 协商
    const x0: bool = resp_round(RESP_CASE_TEXT, "resp-text");
    const x1: bool = resp_round(RESP_CASE_TOOLS, "resp-tools");
