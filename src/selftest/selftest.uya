    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    // web_search 指向 mock（测试接缝）
    buf_free(&web_base_override);
    web_base_override = buf_new(64);
    _ = buf_append_cstr(&web_base_override, "http://127.0.0.1:");
    _ = buf_append_u64(&web_base_override, port as u64);
    buf_free(&web_key_override);
    web_key_override = buf_new(16);
    _ = buf_append_cstr(&web_key_override, "selftest-web-key");

    var c: Config = cfg_default();
    cfg_pin_api(&c, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append_cstr(&c.task, "用一下技能和联网搜索");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.max_steps = 4;
    c.timeout_ms = 20000;
    c.quiet = true;
    c.quiet = false;
    c.skill_dirs = buf_new(strlen(skillroot) + 8);
    _ = buf_append_cstr(&c.skill_dirs, skillroot);
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    g_skills.scanned = false;   // 让本轮重新扫描（带上 --skill-dir）
    const rc: i32 = agent_run(&c);
    cfg_free(&c);
    buf_free(&web_base_override);
    buf_free(&web_key_override);
    web_base_override = buf_empty();
    web_key_override = buf_empty();
    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if rc != AGENT_OK {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

