    // P49（另一条线）：残留 worktree 的回收（干净零提交才清；有改动·有提交·有人用一律留）
    const m7: bool = worktree_reclaim_round("worktree-reclaim" as &const byte);
    if r1 && r2 && r3 && r4 && r5 && r5b && r6 && r7 && r8 && r9 && s0 && s1 && s2 && s3 && s4 && s5 && s6 && s7 && t0 && t1 && t2 && t3 && t3b && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12 && t13 && u0 && u1 && u2 && u3 && v0 && v1 && v2 && v3 && v4 && v5 && v6 && v7 && v8 && v9 && r1r && r1t && r1s && y0 && y1 && y2
        && x0 && x1 && x2 && x3 && x4 && x5 && x6 && x7 && x8 && x9 && x9a && x9b && x10 && x11 && x12 && x13 && x14 && x15 && x16 && w0 && w1 && w2 && w3 && w3b && w3c && w4 && w5 && w5b && w6 && w7 && w7b && w8 && w9 && wA && wB && wC && wF && wG && wH && wI && wch0 && wch1 && wch2 && z0 && z1 && z2 && e0 && e1 && z3 && z4 && z5 && z6 && z7 && z8 && z9 && m0 && m1 && m2 && m3 && m4 && m5 && m6 && m7 {
        out_err("SELFTEST PASS\n");
        return AGENT_OK;
    }
    out_err("SELFTEST FAIL\n");
    return AGENT_PROTO;
}
