// src/selftest/selftest.uya — 离线自测（内置 mock LLM）+ 传输层探针
//
// 本文件：全部离线自测轮的宿主：mock LLM 服务端子进程（HTTP 解析 + 按 `mock_mode` 出响应体 +
//   请求体内的断言）、单轮驱动 `selftest_round`（fork → 假 DSH_HOME/工作区 → 跑完整 agent 循环
//   → 收退出码与写盘内容）、探针 `probe_main`，以及各域的自测轮：SSE 流式、终端层、会话日志与
//   恢复、DSH 设置、图片、剪贴板、/sessions 列表、read 行窗口、workflow、工具调用序列化上限、
//   diff、子代理窗口、/watch、Responses 接口、访问模式/沙箱、plan 闸门、统计与上下文占用、
//   进程采样、终端标题、任务状态、/goal、模型目录、Git worktree 与残留回收。
// 不变量：① mock 与断言必须**确定性** —— 同一夹具必须给出同一 verdict，不许依赖真实网络 / 时钟 /
//   环境（唯一允许的外来输入是显式设置的 `mock_*` 全局开关）；② 判定码只用**低 8 位**：子进程用
//   `sys_exit` 收尾，256 起会被截断（261 显示成 5，踩坑 89），所以外部命令/工具的返回码要先折进
//   0..255 再当 verdict；③ 每轮可单跑（`UYA_SELFTEST_*_ONLY` 环境变量）且幂等 —— 连跑两次必须
//   都 PASS，轮次之间不许残留全局状态（工作区 / DSH_HOME 每轮重建）；④ 轮次自己 fork 的子进程
//   必须由该轮收干净，不许留孤儿。
// 依赖：libc（syscall/unistd/heap/fcntl/signal）、std.json.encoder、foundation/bufx、net（LLM
//   协议与 SSE）、term 与 term/tui、tools（fs/shell）、session（日志/DSH 配置/统计/信号）、agent
//   （历史与主循环）、vcs/gitx、diff；另三个自测文件经合并命名空间提供 `sigx_*` / `shellx_*` /
//   `tui_*` 入口。
// 命名：对外只有 `probe_main`（--probe）、`selftest_main`（--selftest）与 diff fixture 的
//   `dg_fixture_make`/`dg_fixture_empty`；私有前缀 `mock_*`（mock LLM）、`sse_*`、`ty_*`（终端层）、
//   `resp_*`（Responses）、`stx_*`（统计）、`tsx_*`（任务）、`dp_/dg_/gcr_/mx_/wt_`，以及各轮的
//   `*_round`。
//
// --selftest 完全不联网、不需要 API key：
//   1) 父进程 bind 127.0.0.1:0 拿到端口，fork 出子进程跑 mock LLM；
//   2) 父进程用 http://127.0.0.1:<port>/v1 跑完整的 agent 循环（build_request →
//      http_request → std.json 解析 → 工具执行 → 结果回灌 → 第二轮）；
//   3) mock 端断言：第一轮请求的 tools 里 run_shell 的出现与否符合预期，
//      第二轮请求里必须带上工具执行结果；父进程断言写出的文件内容与退出码。
//   共跑两轮：allow_shell=true / false，覆盖 A3 与 A6。

use libc.syscall;
use libc.unistd;
use libc.heap;
use std.runtime.saved_envp;
use std.json.encoder.JsonWriter;

var mock_expect_shell: bool = true;

// 自测轮次模式（fork 前设置，子进程继承）：
//   0 = shell 轮（write_file，tools 里应有 run_shell）
//   1 = no-shell 轮（write_file，tools 里不应有 run_shell）
//   2 = tools 轮（read_file 成功 / read_file 越权被拒 / run_shell 超时被杀；末轮响应用 chunked）
//   3 = HTTP 401（非 200 必须报错退出，且把错误体打出来）
//   5 = max-steps 熔断（模型每轮都调工具，agent 必须在 N 步后停下）
//   6 = 中断轮：发若干帧后挂住不发 [DONE]，客户端应被 Ctrl-C 打断
//  17 = 不限步数轮：默认 max_steps=0（不限）时连给 14 轮工具调用（超过旧默认 12），
//       第 15 轮才给最终答案 —— agent 必须一路跑完并以 0 退出（默认回到 12 这轮就失败）
//  23 = 控制字节轮：跑一条 stdout 带 NUL 的命令，断言它转义成 \u0000 之后才上线
//       （chat 与 responses 各跑一遍，靠 mock_expect_resp 区分端点与响应形状）
//  27 = 「退不出」轮（P28）：第 1 轮让 agent 跑一条**长命令**（sleep 15，工具卡片上的
//       description 就是 mock_args_json 里那个 "selftest command"）；之后的请求按内容分叉 ——
//       带第二个任务文本（"task-two"）的回 SELFTEST-TUI-QUIT-OK，其余（被中断的那一轮）回
//       SELFTEST-TUI-QUIT-MID。用来钉「工具跑着的时候 ctrl+d / esc / /exit 都要立刻生效」
//       以及「中断过的会话下一个任务必须照常跑完」
var mock_mode: i32 = 0;
// 轮数覆盖（-1 = 用 mode 自己的默认）：不想让 mock 等满轮数时用，
// 例如「工具跑着就退出」的轮次只会服务 1 次请求
var mock_limit: i32 = -1;
// --compat-fold 轮：mock 期望看到「折叠成一条 user 消息」的旧协议
var mock_expect_fold: bool = false;
// steer 轮：mock 期望在下一轮请求里看到运行中输入的文本
var mock_expect_steer: bool = false;
// 控制字节轮：true = 这一轮跑 responses 协议（端点/响应形状都按 responses 来）
var mock_expect_resp: bool = false;
// P18：答案帧里是否带 usage。默认关闭 —— 打开会让 g_last_prompt_tokens 从「估算」变成
// 提供方读数，进而改变自动压缩的触发时机（compact-auto / responses-compact / workflow
// 那几轮都会跟着变）。所以只给 stats-usage 这一轮开。
var mock_usage_on: bool = false;
// P23：SSE 两段 chunk 之间的停顿（纳秒）。默认 0 = 一次写完；tui-cmd 那轮要一个
// 「回合还活着」的窗口，好让父进程在回合运行中往 PTY 里敲 /status。
var mock_sse_gap_ns: i64 = 0;

// 供自测断言用的 lflag 位（与 tty.uya 内部常量一致）
const TTY_LFLAG_TEST_ISIG: u32 = 0x0001;
const TTY_LFLAG_TEST_ICANON: u32 = 0x0002;
const TTY_LFLAG_TEST_ECHO: u32 = 0x0008;
const TTY_LFLAG_TEST_IEXTEN: u32 = 0x8000;

// 自测用的协议钉桩：显式声明（等价于 --api=…），于是不会触发一次性协商。
// 只有刻意测协商的那一轮才留 src_api = API_SRC_DEFAULT（= 默认 responses + 协商）。
fn cfg_pin_api(c: &Config, style: u8) void {
    c.api_style = style;
    c.src_api = 3;
}

// --selftest 的总入口（agent.uya 里一行调用）：先关 worktree 模式，再按 `UYA_SELFTEST_*_ONLY`
// 环境变量分流到单轮调试入口，否则顺序跑全部轮次。
// 返回 AGENT_OK / AGENT_PROTO；任一硬轮失败即 FAIL（判定码只用低 8 位，见踩坑 89）。
export fn selftest_main(base: &const Config) i32 {
    _ = base;
    // P37：worktree 模式在自测里必须**从关开始**。真机的 DSH 设置（agent-presets.default=
    // git-worktree）会让主进程带着 wt_on=true 进来，于是每个 fork 出去跑一轮的测试子进程
    // 都会去建 worktree / 切工作区 —— mock 网关的路径与工作目录全被搬走，tui-pty / tui-diff
    // 这类**真 PTY** 轮整片红（实测）。worktree 那两轮自己开、结束时关。
    wt_set_on(false);
    wt_reset();
    // 调试入口：只跑 P46（/title）轮
    if env_present("UYA_SELFTEST_TITLE_ONLY" as &const byte) {
        const t0: bool = title_round("title-format" as &const byte);
        const t1: bool = title_cmd_round("title-cmd" as &const byte);
        if t0 && t1 {
            out_err("SELFTEST TITLE PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST TITLE FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P26（/diff）轮
    if env_present("UYA_SELFTEST_DIFF_ONLY" as &const byte) {
        const d0: bool = diff_parse_round("diff-parse" as &const byte);
        const d1: bool = diff_git_round("diff-git" as &const byte);
        if d0 && d1 {
            out_err("SELFTEST DIFF PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST DIFF FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 TUI 轮（改动 TUI 时不必等整轮 selftest）
    // 调试入口：只跑 P21（访问模式/沙箱）轮
    if env_present("UYA_SELFTEST_PERM_ONLY" as &const byte) {
        const p0: bool = perm_modes_round("perm-modes" as &const byte);
        const p1: bool = san_profile_round("san-profile" as &const byte);
        const p2: bool = san_shell_round("san-shell" as &const byte);
        const p3: bool = perm_readonly_round(base, "perm-readonly" as &const byte, "build/selftest_ws_perm" as &const byte);
        const p4: bool = san_tool_round(base, "san-tool" as &const byte, "build/selftest_ws_san" as &const byte);
        const p5: bool = plan_gate_round(base, "plan-gate" as &const byte, "build/selftest_ws_plangate" as &const byte);
        if p0 && p1 && p2 && p3 && p4 && p5 {
            out_err("SELFTEST PERM PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST PERM FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P25（任务状态）轮
    if env_present("UYA_SELFTEST_TASKS_ONLY" as &const byte) {
        const q0: bool = tasks_render_round("tasks-render" as &const byte);
        const q2: bool = tasks_scroll_round("tasks-scroll" as &const byte);
        const q1: bool = tui_tasks_round("tui-tasks" as &const byte);
        if q0 && q1 && q2 {
            out_err("SELFTEST TASKS PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST TASKS FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P34（工作区）两轮
    if env_present("UYA_SELFTEST_WS_ONLY" as &const byte) {
        const pw0: bool = ws_resolve_round("ws-resolve" as &const byte);
        const pw1: bool = ws_tool_round("ws-tool" as &const byte, base);
        if pw0 && pw1 {
            out_err("SELFTEST WS PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST WS FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑「异常收尾形状」轮 —— P54（退化响应：证据 + 同一步重发一次）两轮
    // 加 P59（token 上限截断：正文进历史 + warning 收口）一轮：三轮回合的 mock 都是
    // 「不正常给答案的收尾」，一起跑最省事。
    if env_present("UYA_SELFTEST_EMPTY_ONLY" as &const byte) {
        const e0: bool = selftest_round(base, "empty-retry", 41, true, "build/selftest_ws_empty", true, false, false, false);
        const e1: bool = selftest_round(base, "empty-retry-giveup", 42, true, "build/selftest_ws_empty2", true, false, false, false);
        const e2: bool = selftest_round(base, "max-tokens-cut", 44, true, "build/selftest_ws_maxtok", true, false, false, false);
        if e0 && e1 && e2 {
            out_err("SELFTEST EMPTY PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST EMPTY FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P29（/goal 人类命令）轮
    if env_present("UYA_SELFTEST_GOAL_ONLY" as &const byte) {
        const g0: bool = goal_cmd_round("goal-cmd" as &const byte);
        if g0 {
            out_err("SELFTEST GOAL PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST GOAL FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P37（模型选择 / 推理强度 / worktree）轮
    if env_present("UYA_SELFTEST_MODEL_ONLY" as &const byte) {
        const q0: bool = model_catalog_round("model-catalog" as &const byte);
        const q1: bool = model_apply_round("model-apply" as &const byte);
        const q2: bool = effort_apply_round("effort-apply" as &const byte);
        const q3: bool = model_log_round("model-log" as &const byte);
        const q4: bool = worktree_round("worktree" as &const byte);
        const q5: bool = worktree_discard_round("worktree-discard" as &const byte);
        // P49：残留 worktree 的回收判据
        const q6: bool = worktree_reclaim_round("worktree-reclaim" as &const byte);
        if q0 && q1 && q2 && q3 && q4 && q5 && q6 {
            out_err("SELFTEST MODEL PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST MODEL FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P33/P35（/sessions 列表）轮：纯函数 + TUI 浮层 + 大日志 meta
    if env_present("UYA_SELFTEST_SESS_ONLY" as &const byte) {
        const s0: bool = sess_list_round("sess-list" as &const byte);
        const s1: bool = tui_sessions_round("tui-sessions" as &const byte);
        const s2: bool = sess_meta_big_round("sess-meta-big" as &const byte);
        const s3: bool = sess_list_big_round("sess-list-big" as &const byte);
        if s0 && s1 && s2 && s3 {
            out_err("SELFTEST SESS PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST SESS FAIL\n");
        return AGENT_PROTO;
    }
    if env_present("UYA_SELFTEST_TUI_ONLY" as &const byte) {
        if tui_selftest_all() {
            out_err("SELFTEST TUI PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST TUI FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P38（bash 工具的进程侧：终端收口 / 停住即收口 / 整组收子孙）
    if env_present("UYA_SELFTEST_SHELL_ONLY" as &const byte) {
        if shellx_selftest_all() {
            out_err("SELFTEST SHELL PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST SHELL FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P15/P40（子代理窗口面板：几何 + 等宽 + 消息预览贴尾）——
    // 改这一行排版时比整轮 selftest 快得多
    // P60：只跑 web 四轮（改 web 界面时比整轮快）
    if env_present("UYA_SELFTEST_WEB_ONLY" as &const byte) {
        const w0: bool = web_emu_round("web-emu" as &const byte);
        const w1: bool = web_http_round("web-http" as &const byte);
        const w2: bool = web_page_round("web-page" as &const byte);
        const w3: bool = web_dispatch_round("web-dispatch" as &const byte);
        const w4: bool = web_pty_round("web-pty" as &const byte);
        if w0 && w1 && w2 && w3 && w4 {
            out_err("SELFTEST WEB PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST WEB FAIL\n");
        return AGENT_PROTO;
    }
    if env_present("UYA_SELFTEST_PANEL_ONLY" as &const byte) {
        if win_round("subagent-panel" as &const byte) {
            out_err("SELFTEST PANEL PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST PANEL FAIL\n");
        return AGENT_PROTO;
    }
    // 调试入口：只跑 P66/P67（项目记忆：身份 + 存储 + 摄取 + 开工包）—— 改 pm/ 时比整轮快得多
    if env_present("UYA_SELFTEST_PM_ONLY" as &const byte) {
        const q0: bool = pms_identity_round("pm-identity" as &const byte);
        const q1: bool = pms_roundtrip_round("pm-roundtrip" as &const byte);
        const q2: bool = pms_concurrent_round("pm-concurrent" as &const byte);
        // P67：摄取（确定性抽取）+ 开工包（失效校验 / 截断顺序 / 预算）
        const q3: bool = pms_ingest_round("pm-ingest" as &const byte);
        const q4: bool = pms_digest_round("pm-digest" as &const byte);
        // P68：端到端（摄取 → 落盘 → 下一个会话注入）+ --no-memory 的回归腿
        const q5: bool = pms_e2e_round("pm-e2e" as &const byte, base);
        if q0 && q1 && q2 && q3 && q4 && q5 {
            out_err("SELFTEST PM PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST PM FAIL\n");
        return AGENT_PROTO;
    }
    out_err("selftest: offline end-to-end (mock LLM on 127.0.0.1, no network, no API key)\n");
    const r1: bool = selftest_round(base, "shell", 0, true, "build/selftest_ws_shell", true, false, false, false);
    // P16：就着刚跑完的这一轮，回读会话日志确认思考全文落盘（显示层只留一行，全文只在日志里）
    const r1r: bool = reasoning_log_round("reasoning-log", "build/selftest_agent_home", "build/selftest_ws_shell");
    const r2: bool = selftest_round(base, "no-shell", 1, false, "build/selftest_ws_noshell", true, false, false, false);
    const r3: bool = selftest_round(base, "tools", 2, true, "build/selftest_ws_tools", true, false, false, false);
    const r4: bool = selftest_round(base, "http401", 3, true, "build/selftest_ws_401", true, false, false, false);
    const r5: bool = selftest_round(base, "max-steps", 5, true, "build/selftest_ws_steps", true, false, false, false);
    // 默认不限步数：mock 连给 14 轮 tool_calls（超过旧默认 12）才给最终答案，
    // agent 必须一路跑到最终答案并以 0 退出（这轮不设 max_steps，吃的就是默认值）
    const r5b: bool = selftest_round(base, "unlimited-steps", 17, true, "build/selftest_ws_unlimited", true, false, false, false);
    // 非流式回归：--no-stream 走旧路径，同一份 mock 数据（JSON 回包）
    const r6: bool = selftest_round(base, "noshell-nostream", 1, false, "build/selftest_ws_nostream", false, false, false, false);
    // 折叠协议回归：--compat-fold
    const r7: bool = selftest_round(base, "shell-fold", 0, true, "build/selftest_ws_fold", true, true, false, false);
    // P3：运行中用户输入（steer）在下一个 step 被采纳
    const r8: bool = selftest_round(base, "steer", 0, true, "build/selftest_ws_steer", true, false, true, false);
    // P3：Ctrl-C 中断当前回合（不该派发工具、不该有下一轮请求）
    const r9: bool = selftest_round(base, "interrupt", 6, true, "build/selftest_ws_intr", true, false, false, true);
    const s0: bool = sse_round(SSE_CASE_BASIC, "stream-basic");
    const s1: bool = sse_round(SSE_CASE_TOOLS, "stream-tools");
    const s2: bool = sse_round(SSE_CASE_NODONE, "stream-nodone");
    const s3: bool = sse_round(SSE_CASE_BADJSON, "stream-badjson");
    const s4: bool = sse_round(SSE_CASE_REASONING_LENGTH, "stream-length");
    // P24：首 token 打点的三条边界（只有思考 / 只有工具参数 / 没有任何增量）
    const s5: bool = sse_round(SSE_CASE_REASONING_ONLY, "stream-firsttok-reasoning");
    const s6: bool = sse_round(SSE_CASE_CALLONLY, "stream-firsttok-call");
    const s7: bool = sse_round(SSE_CASE_NODELTA, "stream-firsttok-none");
    const t0: bool = tty_round("tty-editor");
    const t1: bool = sess_round("session-log");
    const t2: bool = dshcfg_round("dsh-config");
    const t3: bool = fs_round(base, "fs-tools", "build/selftest_ws_fs");
    // P19：read 的行窗口（真实 total / 后段窗口 / 真 EOF）—— 见踩坑 34
    const t3b: bool = read_window_round("read-window" as &const byte, "build/selftest_ws_read" as &const byte);
    const t4: bool = jobs_round(base, "bash-jobs", "build/selftest_ws_jobs");
    const t5: bool = prompt_round(base, "prompt-todo-plan", "build/selftest_ws_prompt");
    const t6: bool = round_run(base, "compact-prune", "build/selftest_ws_prune", 11, 0 as i64, "产生大输出");
    const t7: bool = round_run(base, "compact-auto", "build/selftest_ws_compact", 12, 200 as i64, "触发自动压缩");
    // 长历史回归：40 轮 × 2 个工具调用（≈124 条消息）必须全程不丢消息、配对完整
    const t10: bool = round_run_opts(
        base,
        "history-long",
        "build/selftest_ws_histcap",
        18,
        0 as i64,
        HISTCAP_ROUNDS + 5,
        "长历史：连跑 40 轮工具调用，一条消息都不许丢"
    );
