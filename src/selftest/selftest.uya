// Anthropic Messages 形状的响应（web_search 结果）
fn mock_send_messages(cfd: i32) bool {
    const body: &const byte = "{\"id\":\"msg_1\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"deepseek-v4-flash\",\"content\":[{\"type\":\"text\",\"text\":\"Uya is a small systems language.\",\"citations\":[{\"type\":\"web_search_result_location\",\"url\":\"https://example.org/uya\",\"title\":\"Uya language\",\"cited_text\":\"Uya is a systems language.\"}]},{\"type\":\"web_search_tool_result\",\"content\":[{\"type\":\"web_search_result\",\"url\":\"https://example.org/uya\",\"title\":\"Uya language\",\"page_age\":\"2025-01-02\"},{\"type\":\"web_search_result\",\"url\":\"https://example.org/uya2\",\"title\":\"Uya docs\",\"page_age\":\"\"}]}],\"stop_reason\":\"end_turn\"}";
    var head: Buf = buf_new(512);
    defer { buf_free(&head); }
    const blen: usize = bufx_cstr_len(body);
    _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: ");
    _ = buf_append_u64(&head, blen as u64);
    _ = buf_append_cstr(&head, "\r\n\r\n");
    https_write_all(cfd, &head.ptr[0] as &const byte, head.len) catch {
        return false;
    };
    const w: !void = https_write_all(cfd, body, blen);
    _ = w catch {
        return false;
    };
    return true;
}

