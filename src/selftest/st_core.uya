    jw_byte(&w, 44);
    jw_key(&w, "response");
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "resp_r2");
    jw_byte(&w, 44);
    jw_key(&w, "status");
    jw_str_cstr(&w, "completed");
    jw_byte(&w, 44);
    jw_key(&w, "output");
    jw_byte(&w, 91);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    return resp_emit(out, &w, &payload);
}

