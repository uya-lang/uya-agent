// src/selftest/tuis_title_ask.uya — tuiselftest.uya 的拆分片 5/7（纯搬移）
//
// 本文件：P46：/title 的会话标题输入框浮层（单行文本编辑）；对外入口：selftest_main 里一行调用；tui-plan（P26）：plan 模式写闸门 + exit_plan_mode 审阅；tui-tasks（P22）：常驻任务块的布局 / ctrl+t 开关 / 活体刷新 /；tui-ws（P34）：工作区切换在界面上、在给模型的快照里都跟上；tui-sessions（P33）：/sessions 浮层 —— 时间倒序 · 三列 
// 不变量：与原文件一致 —— 拆分只搬移，不改任何声明的代码；同族轮/段集中在一片里。
// 依赖：见锚点 tuiselftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：沿用原文件前缀（本片是同一历史模块的内部拆分）。

// ============================================================
// P46：/title 的会话标题输入框浮层（单行文本编辑）
//
// 五个部分：
//   A) headless 排版：预填内容可见、方框逐行闭合、每行 ≤ cols、无 ESC/NUL、提示行在；
//   B) headless 编辑与按键：打字 / backspace / delete / ←→ / home·end / ctrl+u /
//      enter 采纳（交回编辑后的文本）/ esc 取消（**不改标题**）；
//   C) 太矮回落：panel_top < 6 时 tui_title_input_wait 返回 0（调用方给 notice，绝不 fail closed
//      —— 与提问弹窗同一条立场：这是「换个地方说」，不是审批）；
//   D) 回合运行中：`/title 新名字` 当场生效（安全集）；裸 `/title` **不**当场派发；
//   E) 真 PTY：mock 回合结束后敲 /title，框里出现 AI 建议，回车之后 OSC 2 变成新标题、
//      日志里落一条 kind=user 的 session/title。
// ============================================================

// 窗口标题保持短：框宽是**按内容自适应**的（P45 那一套），标题太长会被裁掉。
// 按键说明走提示行那一份（它有 full/mid/min 三档退让，窄框也丢不了「esc 取消」）。
const TUIS_TI_TITLE: &const byte = "会话标题" as &const byte;
const TUIS_TI_SUGGEST: &const byte = "修好中文文件名" as &const byte;

// 标题输入框的浮层用例：预填 AI 建议可见、打字/backspace/←→/home·end/ctrl+u/中间插入、
// enter 采纳（交回编辑后的文本）、方框逐行闭合、窄框不越界。只更新 ok。
fn tuis_ti_overlay_case(tag: &const byte, ok: &bool) void {
    tuis_reset(100, 30);
    tui_overlay_input_open(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE),
        TUIS_TI_SUGGEST, bufx_cstr_len(TUIS_TI_SUGGEST));
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_TITLE {
        tuis_fail(tag, "标题输入框没有打开（或 kind 不是 TUI_OVK_TITLE）", ok);
        return;
    }
    if !tui_tin_active() {
        tuis_fail(tag, "tui_tin_active() 不是真（浮层形态没置上）", ok);
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_TI_TITLE) {
        tuis_fail(tag, "标题输入框没有标题行", ok);
    }
    // 预填的建议必须可见（AI 填草稿、人来改 —— 这是本功能的主交互）
    if !tuis_screen_has(TUIS_TI_SUGGEST) {
        tuis_fail(tag, "输入框里没有预填的 AI 建议", ok);
    }
    if !tuis_screen_has("enter 采纳") || !tuis_screen_has("esc 取消") {
        tuis_fail(tag, "提示行里没有按键说明（enter 采纳 / esc 取消）", ok);
    }
    // 单行输入框不该有选项表那套东西
    if tuis_screen_has("✎ ") {
        tuis_fail(tag, "输入框里混进了提问弹窗的自定义行", ok);
    }
    tuis_overlay_frame_check(100, ok, tag);

    // ---- B) 编辑与按键 ----
    // 光标默认在尾部：打字就是往后接
    if tui_tin_cursor() != tui_tin_draft_len() {
        tuis_fail(tag, "光标默认不在编辑缓冲尾部", ok);
    }
    tui_keys_inject("!" as &const byte, 1);
    tui_build();
    if tui_tin_draft_len() != bufx_cstr_len(TUIS_TI_SUGGEST) + 1 {
        tuis_fail(tag, "打字没有接在尾部", ok);
    }
    // backspace 退回原样
    tui_keys_inject("\x7f" as &const byte, 1);
    if tui_tin_draft_len() != bufx_cstr_len(TUIS_TI_SUGGEST) {
        tuis_fail(tag, "backspace 没有删掉刚打的字符", ok);
    }
    // ← 再 delete：回到原样（一个字符进出一个字符）
    tui_keys_inject("\x1b[D" as &const byte, 3);
    // 按**码点**左移一格。这里必须给准确的字节数，不能用 len-1：
    // 预填是「修好中文文件名」= 7 个汉字 = 21 字节，最后一个「名」从 18 开始。
    // 写成 len-1（20）就落在汉字中间 —— 那正是「按字节退格会劈开 UTF-8」那个坑。
    if tui_tin_draft_len() != 21 {
        tuis_fail(tag, "预填的建议不是 21 字节（测试基准变了）", ok);
    }
    if tui_tin_cursor() != 18 {
        tuis_fail(tag, "← 没有把光标左移一个**码点**（期望 18，按字节退会得到 20）", ok);
    }
    tui_keys_inject("\x1b[C" as &const byte, 3);
    if tui_tin_cursor() != tui_tin_draft_len() {
        tuis_fail(tag, "→ 没有把光标移回尾部", ok);
    }
    // home / end
    tui_keys_inject("\x01" as &const byte, 1);   // ctrl+a
    if tui_tin_cursor() != 0 {
        tuis_fail(tag, "ctrl+a 没有把光标移到行首", ok);
    }
    tui_keys_inject("\x05" as &const byte, 1);   // ctrl+e
    if tui_tin_cursor() != tui_tin_draft_len() {
        tuis_fail(tag, "ctrl+e 没有把光标移到行尾", ok);
    }
    // ctrl+u 清空，然后重新打字（走 insert 的中间位置那条路）
    tui_keys_inject("\x15" as &const byte, 1);
    if tui_tin_draft_len() != 0 {
        tuis_fail(tag, "ctrl+u 没有清空编辑缓冲", ok);
    }
    tui_keys_inject("ab" as &const byte, 2);
    tui_keys_inject("\x1b[D" as &const byte, 3);   // 光标在 ab 之间
    tui_keys_inject("X" as &const byte, 1);
    if tui_tin_draft_len() != 3 || tui_tin_draft_at(0) != 97 as byte
        || tui_tin_draft_at(1) != 88 as byte || tui_tin_draft_at(2) != 98 as byte {
        tuis_fail(tag, "在中间插入没有把后面那段接回去（期望 aXb）", ok);
    }
    // 光标可见性：编辑行里必须有一个反显位（光标格），且每行仍 ≤ cols
    tui_build();
    tuis_scan_rows(100, ok, tag);
    tuis_overlay_frame_check(100, ok, tag);

    // enter 采纳：交回的是**编辑后**的文本
    tui_keys_inject("\r" as &const byte, 1);
    var picked: Buf = buf_new(256);
    defer { buf_free(&picked); }
    if !tui_tin_answered() {
        tuis_fail(tag, "enter 之后 tui_tin_answered() 不是真", ok);
    }
    if tui_tin_text(&picked) != 3 {
        tuis_fail(tag, "采纳回来的文本不是编辑后的那 3 个字节", ok);
    } else if !bufx_eq_cstr(picked.ptr as &const byte, picked.len, "aXb" as &const byte) {
        tuis_fail(tag, "采纳回来的文本不是 aXb", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "采纳之后浮层没关", ok);
    }
    if tui_tin_active() {
        tuis_fail(tag, "采纳之后对话框状态没清（tui_tin_active 还是真）", ok);
    }
    // 答案在 close 之后仍读得到（one-shot 口径，与 ask 同一分工）
    if tui_tin_text(&picked) != 3 {
        tuis_fail(tag, "close 之后读不到已采纳的答案（one-shot 结果被清了）", ok);
    }
}

// 标题输入框的取消用例：esc 之后浮层关闭、不算改名（已采纳结果保留）。只更新 ok。
fn tuis_ti_cancel_case(tag: &const byte, ok: &bool) void {
    tuis_reset(100, 30);
    tui_overlay_input_open(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE),
        TUIS_TI_SUGGEST, bufx_cstr_len(TUIS_TI_SUGGEST));
    tui_keys_inject("改一改" as &const byte, 9);
    tui_keys_inject("\x1b" as &const byte, 1);   // esc
    if tui_overlay_open() {
        tuis_fail(tag, "esc 之后浮层没关", ok);
    }
    if tui_tin_answered() {
        tuis_fail(tag, "esc 取消不该算「已采纳」（否则会把取消当成改名）", ok);
    }
    var got: Buf = buf_new(64);
    defer { buf_free(&got); }
    if tui_tin_text(&got) != 0 {
        tuis_fail(tag, "esc 取消之后不该读得到答案", ok);
    }
    // 空预填也要能开（起标题失败时调用方预填当前标题或空串）
    tui_overlay_input_open(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE), "" as &const byte, 0);
    if !tui_overlay_open() || tui_tin_draft_len() != 0 {
        tuis_fail(tag, "空预填开不出来（或缓冲不是空的）", ok);
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    tuis_overlay_frame_check(100, ok, tag);
    tui_overlay_close();
}

// 标题输入框「终端太矮」的用例：必须返回 0 让调用方回落 notice，绝不能 fail closed。
// 同时断言没有开浮层、屏幕上不留残影。
fn tuis_ti_nofit_case(tag: &const byte, ok: &bool) void {
    // 终端太矮：返回 0（调用方回落 notice），绝不能 fail closed
    tuis_reset(100, 5);
    tui_headless_enable(true);
    var got: Buf = buf_new(64);
    defer { buf_free(&got); }
    const rc: i32 = tui_title_input_wait(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE),
        TUIS_TI_SUGGEST, bufx_cstr_len(TUIS_TI_SUGGEST), &got);
    if rc != 0 {
        tuis_fail(tag, "终端太矮时 tui_title_input_wait 应当返回 0（回落 notice）", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "太矮回落之后不该留着浮层（看不见却吞键）", ok);
    }
    // 窄终端不崩、每行 ≤ cols
    tuis_reset(40, 20);
    tui_overlay_input_open(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE),
        "一个很长的标题用来把窄框撑满看看会不会越界" as &const byte,
        bufx_cstr_len("一个很长的标题用来把窄框撑满看看会不会越界" as &const byte));
    tui_build();
    tuis_scan_rows(40, ok, tag);
    tuis_overlay_frame_check(40, ok, tag);
    tui_overlay_close();
    tuis_reset(100, 30);
}

// 标题框在**回合运行中**的分工用例：带参 `/title <t>` 只写内存 + 日志事件 + OSC 2，
// 进安全集可当场生效；裸 `/title` 要发侧路请求 + 开浮层，不进安全集。
fn tuis_ti_inturn_case(tag: &const byte, ok: &bool) void {
    // D) 回合运行中的分工：带参 `/title <t>` 只写内存 + 一条日志事件 + OSC 2（不动历史、
    //    不发请求）⇒ 进安全集，泵点当场生效；裸 `/title` 要发侧路请求 + 开浮层 ⇒
    //    **不进**安全集，只能等回合结束（与 /goal、/workspace 同一条分工）。
    //    这里直接问 agent_tui_cmd_safe_steer（steer 那一侧按**整行**判定，所以能分开两支）。
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "/title 把中文文件名修好");
    if !agent_tui_cmd_safe_steer(&line) {
        tuis_fail(tag, "运行中敲 `/title <新标题>` 应当进安全集（当场生效）", ok);
    }
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title clear");
    if !agent_tui_cmd_safe_steer(&line) {
        tuis_fail(tag, "运行中敲 `/title clear` 应当进安全集", ok);
    }
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title");
    if agent_tui_cmd_safe_steer(&line) {
        tuis_fail(tag, "运行中敲裸 /title 不该进安全集（它会发请求 + 开浮层，在泵点里重入流式请求是不允许的）", ok);
    }
    // `/title   `（只有空白）其实等于裸命令：也不该放行
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title   ");
    if agent_tui_cmd_safe_steer(&line) {
        tuis_fail(tag, "`/title` 后面只有空白时不该进安全集（那是裸命令）", ok);
    }
    // 命令表里真的有这一条（用户敲 `/` 打开面板要能过滤到它）
    var cmds: Buf = buf_new(2048);
    defer { buf_free(&cmds); }
    agent_tui_commands(&cmds);
    if !tuis_has(&cmds, "/title" as &const byte) {
        tuis_fail(tag, "命令面板的清单里没有 /title", ok);
    }
    // 帮助浮层里也要有它（用户最常从那儿查命令）
    if !tuis_has(&cmds, "会话标题" as &const byte) {
        tuis_fail(tag, "命令面板里 /title 那一行没写清楚用途", ok);
    }
}

// tui-title 轮：跑齐标题输入框的四条腿（浮层 / esc 取消 / 太矮回落 / 运行中分工）。
// 返回 false = 任一腿红。
fn tuis_ti_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_ti_overlay_case(tag, &ok);
    tuis_ti_cancel_case(tag, &ok);
    tuis_ti_nofit_case(tag, &ok);
    tuis_ti_inturn_case(tag, &ok);
    if ok {
        tuis_ok(tag, "标题输入框：预填 AI 建议可见 + 编辑（打字/backspace/←→/home·end/ctrl+u/中间插入）+ enter 采纳（交回编辑后的文本）/ esc 取消（不算改名）+ 太矮回落 0 + 方框逐行闭合 + 窄框不越界 + 运行中 /title <t> 当场生效、裸 /title 不当场派发");
    }
    return ok;
}

// ============================================================
// 对外入口：selftest_main 里一行调用
// ============================================================

// ============================================================
// tui-plan（P26）：plan 模式写闸门 + exit_plan_mode 审阅浮窗
//
// 为什么单独一轮：P8 的审阅是 CLI 的 y/N 问答（ask_write + ask_read_yes_no），TUI 下
// 既没有浮窗、按键还要跟 TUI 的键队列抢 —— 用户看到的就是「计划直接开始执行」
// （§16 踩坑 36）。这一轮把四件事钉死：
//   A) 浮层排版与按键（headless，直接开浮层）：正文可滚动、三动作、数字直选、
//      esc 取消、每行 ≤ cols、正文层无 ESC、窄终端不崩
//   B) headless + agent：注入的键到不了浮层 → 按「解决」处理（留在 plan 模式），**绝不批准**
//   C) 真 PTY：先滚动（尾巴标记出现）再选「确认执行」→ 模型拿到 Plan approved
//   D) 真 PTY：esc → 「解决」→ 模型被告知停下等用户说话，且 plan 模式仍在
// ============================================================

const TUIS_PL_TITLE: &const byte = "计划待审" as &const byte;
const TUIS_PL_KEEP: &const byte = "继续讨论" as &const byte;
const TUIS_PL_DISMISS: &const byte = "解决" as &const byte;
const TUIS_PL_APPROVE: &const byte = "确认执行" as &const byte;
const TUIS_PL_KEEP_RESULT: &const byte = "keep planning; revise the plan" as &const byte;
const TUIS_PL_DISMISS_RESULT: &const byte = "dismissed the plan review to speak instead" as &const byte;
const TUIS_PL_APPROVED: &const byte = "Plan approved" as &const byte;
const TUIS_PL_TAIL: &const byte = "PLAN-TAIL-MARK" as &const byte;
const TUIS_PL_TASK: &const byte = "plan the greeting change (TUIS-PLAN-TASK)" as &const byte;

// 审阅用的计划：短行（不折行）但够多行 —— 100x30 下正文可见 16 行，
// 尾巴必须靠滚动才看得见，这样 C 段的「滚动」断言才有意义。
const TUIS_PL_PLAN: &const byte = "# 计划标题\n\n## 第一步：读现状\n- 读 hello.uya\n- 看一眼 Makefile\n\n## 第二步：改一行\n- 只动那一行字面量\n- 用 edit 工具替换\n\n## 第三步：验证\n- 编译并运行\n- 跑一次 make check\n\n## 第四步：补文档\n- README 补一句\n\n## 第五步：收尾\n- 删掉临时文件\n\n## 风险与回滚\n- 只有一处字符串\n- 回滚就是把这一行改回去\n\n## 尾巴\nPLAN-TAIL-MARK\n" as &const byte;

// exit_plan_mode 的 arguments（用 JsonWriter 生成，免得手写两级转义）。
// 末尾要补 NUL：mock_call 走的是 jw_str_cstr（C 字符串口径），而 buf_new 是裸 malloc ——
// 不补的话 strlen 会一路读到未初始化的堆尾巴，arguments 变成非法 JSON（§16 踩坑 37 同款）。
fn tuis_pl_args(out: &Buf, plan: &const byte) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "plan");
    jw_str_cstr(&w, plan);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    const used: usize = jw_used(&w);
    out.len = used;
    if !buf_append_byte(out, 0) {
        return false;
    }
    out.len = used;   // NUL 只给 C 字符串口径用，不计入长度
    return true;
}

// 一封「交计划」的响应体
fn tuis_pl_toolcall_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-tui-plan");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    var args: Buf = buf_new(4096);
    defer { buf_free(&args); }
    if !tuis_pl_args(&args, TUIS_PL_PLAN) {
        return false;
    }
    mock_call(&w, "call_pl", "exit_plan_mode", args.ptr as &const byte);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// true = 预期「解决」（留在 plan 模式），false = 预期「确认执行」
var tuis_pl_dismiss: bool = false;

// 本轮专用 mock：第 0 轮发 exit_plan_mode，第 1 轮断言工具结果并给最终答案
fn tuis_pl_mock(lfd: i32) i32 {
    var round: i32 = 0;
    var verdict: i32 = 0;
    while round < 2 {
        var lpfds: [PollFd: 1] = [PollFd{ fd: lfd, events: POLLIN, revents: 0 }];
        const lpr: i32 = sys_poll(&lpfds[0], 1, 10000) catch { 0; };
        if lpr <= 0 || (lpfds[0].revents & POLLIN) == 0 {
            if verdict == 0 && round < 2 {
                return 60 + round;   // 请求数不够：也算失败
            }
            return verdict;
        }
        var peer: [byte: 16] = [0: 16];
        var alen: u32 = 16;
        const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch { return 10; };
        var rx: Buf = buf_new(16384);
        if !mock_read_request(cfd, &rx) {
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            return 11;
        }
        const is_stream: bool = contains(&rx, "\"stream\":true");
        var body: Buf = buf_new(8192);
        if round == 0 {
            if !contains(&rx, "\"name\":\"exit_plan_mode\"") {
                verdict = 71;   // 计划工具必须在 schema 里
            }
            if !contains(&rx, "Plan mode is active") {
                verdict = 72;   // 运行时上下文必须告诉模型「在 plan 模式里」
            }
            if !contains(&rx, "refused until the user approves a plan") {
                verdict = 73;   // 闸门那句话也得在（模型提前知道写不了文件）
            }
            if !contains(&rx, "TUIS-PLAN-TASK") {
                verdict = 74;   // 任务文本必须真的进了历史
            }
            if !tuis_pl_toolcall_body(&body) {
                verdict = 75;
            }
        } else {
            if !contains(&rx, "PLAN-TAIL-MARK") {
                verdict = 76;   // 计划全文必须留在历史里（转录/记录不丢）
            }
            if tuis_pl_dismiss {
                if !contains(&rx, TUIS_PL_DISMISS_RESULT) {
                    verdict = 77;   // 「解决」的语义必须回到模型面前
                }
                if contains(&rx, TUIS_PL_APPROVED) {
                    verdict = 78;   // 没批准就绝不能出现 approved
                }
            } else {
                if !contains(&rx, TUIS_PL_APPROVED) {
                    verdict = 79;   // 批准了必须告诉模型可以开工
                }
                if contains(&rx, TUIS_PL_DISMISS_RESULT) {
                    verdict = 80;   // 批准了就不该是「停下等用户」
                }
            }
            if !mock_final_body(&body, "TUIS-PLAN-DONE" as &const byte) {
                verdict = 81;
            }
        }
        var sent: bool = false;
        if is_stream {
            sent = mock_send_sse(cfd, &body);
        } else {
            sent = mock_send(cfd, &body);
        }
        if !sent {
            verdict = 82;
        }
        buf_free(&body);
        buf_free(&rx);
        _ = sys_close(cfd) catch {};
        round = round + 1;
    }
    return verdict;
}

// fork 出 mock（形状与 tuis_ap_start_mock 相同，只换子进程里跑的那个 server）
fn tuis_pl_start_mock(want_dismiss: bool, mpid: &i32) u16 {
    tuis_pl_dismiss = want_dismiss;
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch { return 0; };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    if (sys_bind(lfd, &addr[0] as &void, 16 as u32) catch { -1; }) != 0 {
        _ = sys_close(lfd) catch {};
        return 0;
    }
    _ = sys_listen(lfd, 4) catch {};
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {};
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return 0;
    };
    if pid64 == 0 {
        const rc0: i32 = tuis_pl_mock(lfd);
        sys_exit(rc0);
    }
    mpid[0] = tuis_i32(pid64);
    _ = sys_close(lfd) catch {};
    return port;
}

// 一份「指向本地 mock」的配置（headless 与 PTY 子进程共用）。
// plan 模式**不**写进 cfg.plan：那个旗标只在进程第一次装配提示词时读一次，而本进程早被
// 前面的轮次装配过了；进入 plan 模式统一走用户那条路（tab / agent_plan_apply）。
fn tuis_pl_cfg(c: &Config, port: u16, ws: &const byte, task: &const byte) void {
    c.sandbox = SAN_OFF;          // 自测不测沙箱：别让机器上有没有 bwrap 影响结果
    cfg_pin_api(c, LLM_STYLE_CHAT);
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append(&c.task, task, bufx_cstr_len(task));
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.quiet = false;
    c.tool_lines = 8;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
}

// ---- A) 浮层排版与按键（headless，直接开浮层）----
fn tuis_pl_overlay_case(tag: &const byte, ok: &bool) void {
    var sel: Buf = buf_new(256);
    defer { buf_free(&sel); }
    tuis_reset(100, 30);
    if !tui_reader_fits() {
        tuis_fail(tag, "100x30 下 reader 浮层必须放得下", ok);
    }
    tui_overlay_reader(TUI_OVK_PLAN, TUIS_PL_TITLE, bufx_cstr_len(TUIS_PL_TITLE),
        TUIS_PL_PLAN, bufx_cstr_len(TUIS_PL_PLAN), PLAN_ITEMS, bufx_cstr_len(PLAN_ITEMS), 0);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_PLAN {
        tuis_fail(tag, "审阅浮层没有打开（或 kind 不是 TUI_OVK_PLAN）", ok);
        return;
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_PL_TITLE) {
        tuis_fail(tag, "浮层标题不对（应当是「计划待审」）", ok);
    }
    if !tuis_screen_has("计划待审 · 1/") {
        tuis_fail(tag, "标题栏没有「第 a 行/共 b 行」的滚动指示", ok);
    }
    if !tuis_screen_has(TUIS_PL_KEEP) || !tuis_screen_has(TUIS_PL_DISMISS) || !tuis_screen_has(TUIS_PL_APPROVE) {
        tuis_fail(tag, "三个动作（继续讨论 / 解决 / 确认执行）没有都在浮层里", ok);
    }
    if !tuis_screen_has("▸ 继续讨论") {
        tuis_fail(tag, "默认光标不在「继续讨论」上（安全默认：回车 ≠ 批准）", ok);
    }
    if !tuis_screen_has("plan 模式") {
        tuis_fail(tag, "动作行上方没有选中项说明", ok);
    }
    if tuis_screen_has(TUIS_PL_TAIL) {
        tuis_fail(tag, "计划尾巴一开始就可见 —— 这一轮的滚动断言就没意义了", ok);
    }
    // P46：正文走 markdown 渲染 ⇒ 标题的 `#` 号被去掉、并按 H1 着色（不再是字面量 `# 计划标题`）
    if !tuis_screen_has("│ 计划标题" as &const byte) {
        tuis_fail(tag, "正文第一行没有画出来（markdown 标题）", ok);
    }
    if tuis_screen_has("│ # " as &const byte) {
        tuis_fail(tag, "浮层正文的标题还带着 `#` 号（P46 起按 markdown 渲染）", ok);
    }
    // 方框逐行对齐（复用 tui-frame 轮那套量法：左右边界列 + 首尾必须是边框字形）
    tuis_overlay_frame_check(100, ok, tag);

    // ↓ 滚一行：标题栏指示器必须跟着走
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("计划待审 · 2/") {
        tuis_fail(tag, "↓ 之后标题栏的行号没有 +1（正文没滚动）", ok);
    }
    // pgdn 翻页：行号必须整页跳（不是 +1），而且一开始看不到的尾巴仍然看不到
    tui_keys_inject("\x1b[6~" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if tuis_screen_has("计划待审 · 1/") || tuis_screen_has("计划待审 · 2/") {
        tuis_fail(tag, "pgdn 之后行号还停在第 1/2 行（没有整页滚动）", ok);
    }
    // end 到底：尾巴标记必须出现（窗口高度随终端变，所以用「到底」而不是「翻一页」）
    tui_keys_inject("\x1b[4~" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_PL_TAIL) {
        tuis_fail(tag, "pgdn 之后仍看不到计划尾巴（正文没有真的滚动）", ok);
    }
    // home 回顶
    tui_keys_inject("\x1b[H" as &const byte, 3);
    tui_build();
    if !tuis_screen_has("计划待审 · 1/") {
        tuis_fail(tag, "home 没有回到第一行", ok);
    }

    // 数字直选 + 回车：交回「确认执行」
    tui_keys_inject("3" as &const byte, 1);
    if tui_overlay_sel_index() != 2 {
        tuis_fail(tag, "按 3 没有把光标移到第三个动作上", ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "回车没有把选中项交出来", ok);
    } else if !bufx_eq_cstr(sel.ptr as &const byte, sel.len, TUIS_PL_APPROVE) {
        tuis_fail(tag, "数字直选 + 回车交回的不是「确认执行」", ok);
    }
    if tui_overlay_kind() != TUI_OVK_PLAN {
        tuis_fail(tag, "take 之后 kind 不是 TUI_OVK_PLAN（结果会被静默丢掉）", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "回车之后浮层还开着", ok);
    }

    // esc 取消（= 「解决」）
    tui_overlay_reader(TUI_OVK_PLAN, TUIS_PL_TITLE, bufx_cstr_len(TUIS_PL_TITLE),
        TUIS_PL_PLAN, bufx_cstr_len(TUIS_PL_PLAN), PLAN_ITEMS, bufx_cstr_len(PLAN_ITEMS), 0);
    tui_keys_inject("\x1b" as &const byte, 1);
    if !tui_overlay_cancelled() {
        tuis_fail(tag, "esc 没有走「取消」", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "esc 之后浮层还开着", ok);
    }

    // plan 状态 → 面板 chip 的同步（批准/退出都靠它，唯一的变更点）
    agent_plan_force(true);
    if !tui_plan_on() {
        tuis_fail(tag, "进 plan 模式时没有同步输入面板的 Plan chip", ok);
    }
    agent_plan_force(false);
    if tui_plan_on() {
        tuis_fail(tag, "退出 plan 模式时 chip 没有跟着收掉", ok);
    }

    // 窄终端：每行仍然 ≤ cols，边框与动作行还在（40 列下「确认执行」会被截断，只看第一项）
    tuis_reset(40, 14);
    tui_overlay_reader(TUI_OVK_PLAN, TUIS_PL_TITLE, bufx_cstr_len(TUIS_PL_TITLE),
        TUIS_PL_PLAN, bufx_cstr_len(TUIS_PL_PLAN), PLAN_ITEMS, bufx_cstr_len(PLAN_ITEMS), 0);
    tui_build();
    tuis_scan_rows(40, ok, tag);
    if !tuis_screen_has(TUIS_PL_TITLE) || !tuis_screen_has("▸ 继续讨论") {
        tuis_fail(tag, "窄终端下浮层没画出来（标题或动作行缺失）", ok);
    }
    // 窄终端一定会触发截断：这一条正是当初抓出「宽 1 列」（= 踩坑 42 那类）的地方
    tuis_overlay_frame_check(40, ok, tag);
    
    if !tuis_screen_has("╭" as &const byte) || !tuis_screen_has("╰" as &const byte) {
        tuis_fail(tag, "窄终端下浮层没有圆角边框", ok);
    }
    tui_overlay_close();
    tuis_reset(100, 30);
}

// ---- B) headless + agent：没人回答 → 「解决」（fail closed，绝不批准）----
fn tuis_pl_headless_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_plan" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return;
    }
    var mpid: i32 = -1;
    const port: u16 = tuis_pl_start_mock(true, &mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var c: Config = cfg_default();
    tuis_pl_cfg(&c, port, ws, TUIS_PL_TASK);
    c.tui = true;
    c.tui_headless = true;
    c.tui_cols = 100;
    c.tui_rows = 30;

    tui_reset_all();
    tui_set_headless(true);
    tui_set_size(100, 30);
    tui_set_color(false, false);
    tui_begin_session();
    tui_sink_flush_partial();
    // 进 plan 模式走**用户那条路**：tab → TUI_REQ_PLAN_ON → 主循环 plan_set()。
    // （进程级的 plan 镜像只有主循环那条路会同步：cfg.plan 只在 agent_texts_ensure()
    //   里读一次，而那个 one-shot 标记在本进程早被前面的轮次置位了。）
    // 所以这里只注入 tab、**不**把请求取走，留给主循环去消费。
    tui_keys_inject("\t" as &const byte, 1);
    if !tui_plan_on() {
        tuis_fail(tag, "tab 没有切进 plan 模式（chip 没变）", ok);
        return;
    }
    tui_keys_inject(TUIS_PL_TASK, bufx_cstr_len(TUIS_PL_TASK));
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_has_submit() {
        tuis_fail(tag, "注入回车之后没有待取走的提交", ok);
    }

    const rc: i32 = agent_run_tui(&c);
    const mock_rc: i32 = wait_child(mpid);
    if rc != AGENT_OK {
        tuis_fail(tag, "plan 模式的一轮却以非 0 退出", ok);
    }
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错（第二封请求里的工具结果不对？）", ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
    }
    // headless 下注入的键用完 = 没人回答：浮层必须收掉，否则它会一直盖着转录
    if tui_overlay_open() {
        tuis_fail(tag, "headless 下没人回答之后，审阅浮层还留在屏幕上", ok);
        tui_overlay_close();
    }
    if !plan_on() {
        tuis_fail(tag, "没人回答之后 plan 模式被退出了（那时不该退出）", ok);
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if tuis_screen_has(TUIS_PL_APPROVED) {
        tuis_fail(tag, "转录里出现了「Plan approved」（没人回答却批准了）", ok);
    }
    cfg_free(&c);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
}

// ---- 子进程侧：把 slave 挂到 0/1/2 后跑真 TUI（plan 模式 + 真终端）----
fn tuis_pl_child(slave_path: &const Buf, port: u16, ws: &const byte) void {
    const s: i32 = sys_open(slave_path.ptr as *const byte, TUIS_O_RDWR_NOCTTY, 0) catch { -1; };
    if s < 0 {
        sys_exit(9);
    }
    _ = sys_dup2(s, 0) catch {};
    _ = sys_dup2(s, 1) catch {};
    _ = sys_dup2(s, 2) catch {};
    if s > 2 {
        _ = sys_close(s) catch {};
    }
    var c: Config = cfg_default();
    tuis_pl_cfg(&c, port, ws, "" as &const byte);   // 任务由父进程从 PTY 打进来
    c.tui = true;
    c.tui_headless = false;
    const rc: i32 = agent_run_tui(&c);
    sys_exit(rc);
}

// ---- C/D) 真 PTY：approve（先滚动）与 esc → 解决 ----
fn tuis_pl_pty_case(tag: &const byte, ok: &bool, approve: bool) void {
    const ws: &const byte = "build/selftest_ws_tui_plan_pty" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return;
    }
    var mpid: i32 = -1;
    const port: u16 = tuis_pl_start_mock(!approve, &mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    }
    tui_reset_all();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        return;
    };
    if cpid64 == 0 {
        tuis_pl_child(&slave_path, port, ws);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);

    var cap: Buf = buf_new(4194304);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 40);      // 首帧（子进程进 raw 之后才会画）
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案", ok);
    }
    // 先进 plan 模式（tab = 切模式）：面板 chip 从 Build 变成 Plan 才算数。
    // 注意只能搜**裸词** Plan：PTY 里样式是 SGR 序列，`▌` 与 `Plan` 之间夹着 `ESC[0m`。
    // （帧里没有别的「Plan」：正文计划只有中文与小写 plan / 大写的 PLAN-TAIL-MARK。）
    tuis_write_master(m, "\t" as &const byte, 1);
    var plan_chip: bool = false;
    var kp: i32 = 0;
    while kp < 80 && !plan_chip {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, "Plan" as &const byte) {
            plan_chip = true;
        }
        kp = kp + 1;
    }
    if !plan_chip {
        tuis_fail(tag, "tab 之后面板 chip 没有变成 Plan（没进 plan 模式）", ok);
        tuis_dump_tail(&cap, 1200);
    }
    var task: [byte: 64] = "plan the greeting change (TUIS-PLAN-TASK)\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    var seen: bool = false;
    var k: i32 = 0;
    while k < 160 && !seen {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, TUIS_PL_TITLE) {
            seen = true;
        }
        k = k + 1;
    }
    if !seen {
        tuis_fail(tag, "exit_plan_mode 没有弹出审阅浮窗", ok);
        tuis_dump_tail(&cap, 1500);
    } else {
        if !tuis_has(&cap, TUIS_PL_KEEP) || !tuis_has(&cap, TUIS_PL_DISMISS) || !tuis_has(&cap, TUIS_PL_APPROVE) {
            tuis_fail(tag, "审阅浮层里没有三个动作", ok);
        }
        // 标题栏的「第 a 行/共 b 行」在这里不断言：PTY 里标题与数字之间夹着 SGR 序列，
        // 字节层面不相邻（精确断言在 A 段的 headless 用例里做）。
        if tuis_has(&cap, TUIS_PL_TAIL) {
            tuis_fail(tag, "计划尾巴一开始就可见（这一屏本来是放不下的）", ok);
        }
        if approve {
            // end 翻到底 → 尾巴必须出现（证明确实滚动了），再按 3 选中「确认执行」并回车
            buf_reset(&cap);
            tuis_write_master(m, "\x1b[4~" as &const byte, 4);
            var scrolled: bool = false;
            var k2: i32 = 0;
            while k2 < 120 && !scrolled {
                tuis_drain(m, &cap, 1);
                if tuis_has(&cap, TUIS_PL_TAIL) {
                    scrolled = true;
                }
                k2 = k2 + 1;
            }
            if !scrolled {
                tuis_fail(tag, "end 之后仍看不到计划尾巴（正文不可滚动？）", ok);
                tuis_dump_tail(&cap, 1200);
            }
            tuis_write_master(m, "3\r" as &const byte, 2);
        } else {
            // esc = 「解决」：关掉浮窗、留在 plan 模式等用户说话
            tuis_write_master(m, "\x1b" as &const byte, 1);
        }
        var k3: i32 = 0;
        while k3 < 200 && !tuis_has(&cap, "TUIS-PLAN-DONE" as &const byte) {
            tuis_drain(m, &cap, 1);
            k3 = k3 + 1;
        }
        if !tuis_has(&cap, "TUIS-PLAN-DONE" as &const byte) {
            tuis_fail(tag, "审阅之后没有收到 mock 的最终答案", ok);
            tuis_dump_tail(&cap, 1500);
        }
        // 决定之后的效果由 mock 侧断言（工具结果文案），界面 chip 的同步在 A 段用
        // 状态查询钉死（PTY 帧里 `▌` 与 `Plan` 之间夹着 SGR，字节层面搜不准，
        // 而转录里本来就有 ExitPlan 这种含 "Plan" 的卡片标题）。
        var k4: i32 = 0;
        while k4 < 8 {
            tuis_drain(m, &cap, 1);
            k4 = k4 + 1;
        }
    }
    // 退出：先清输入再 Ctrl-D
    var bs: [byte: 1] = [127];
    tuis_write_master(m, &bs[0], 1);
    tuis_drain(m, &cap, 6);
    var ctrl_d: [byte: 1] = [4];
    tuis_write_master(m, &ctrl_d[0], 1);
    tuis_drain(m, &cap, 30);
    var st: i32 = 0;
    if !tuis_wait_raw(cpid, &st, 20000) {
        tuis_fail(tag, "Ctrl-D 之后 TUI 子进程没有退出", ok);
        _ = sys_kill(cpid as i64, SIGKILL) catch {};
        _ = tuis_wait_raw(cpid, &st, 2000);
    } else {
        const code: i32 = (st >> (8 as i32)) & 255;
        if code != 0 {
            tuis_fail(tag, "TUI 退出码不是 0", ok);
        }
    }
    _ = sys_close(m) catch {};
    const mock_rc: i32 = wait_child(mpid);
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错（审阅结果不对？）", ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
    }
}

// tui-plan 轮（P26）：计划模式浮层（排版/滚动/直选/esc/窄终端）+ headless 下没人回答 =
// 「解决」（fail closed）+ tab 切换。返回 false = 本轮红；开头先 agent_plan_force(false) 清残留。
fn tui_plan_round(tag: &const byte) bool {
    var ok: bool = true;
    // 进程级的 plan 状态是继承的（PTY 子进程 fork 自本进程）：轮次开头先摆平，
    // 否则上一轮的残留会让子进程一进来就在 plan 模式里、tab 反倒把它关掉。
    agent_plan_force(false);
    // A) 浮层：排版 + 滚动 + 直选 + esc + 窄终端
    tuis_pl_overlay_case(tag, &ok);
    // B) headless：没人回答 = 「解决」（fail closed）
    tuis_pl_headless_case(tag, &ok);
    // 这一轮结束时 plan 模式仍开着（B 段的语义就是「留在 plan 模式」）：恢复成关，
    // 免得污染后面的轮次与 PTY 子进程。
    agent_plan_force(false);
    // C) 真 PTY：滚动 + 「确认执行」→ 模型拿到 Plan approved
    tuis_pl_pty_case(tag, &ok, true);
    // D) 真 PTY：esc → 「解决」→ 模型被告知停下等用户说话，plan 模式仍在
    tuis_pl_pty_case(tag, &ok, false);
    agent_plan_force(false);
    if ok {
        tuis_ok(tag, "plan 审阅：浮窗排版/滚动/三动作/数字直选/esc + headless fail closed + 真 PTY 批准与解决");
    }
    return ok;
}

// ============================================================
// tui-tasks（P22）：常驻任务块的布局 / ctrl+t 开关 / 活体刷新 / 降级
//
// 块的内容由 tasks.uya 生成（那一层有自己的纯函数轮 tasks-render），这一轮只守住
// 「TUI 侧的三件事」：摆在哪儿、什么时候换、地方不够时怎么退化。
// ============================================================
fn tui_tasks_round(tag: &const byte) bool {
    var ok: bool = true;
    var row: usize = 0;
    view_init(true, 0);          // 这一轮直接建帧，不跑 agent：显示层要自己打开

    // ---- A) 空态：一个字节都不画，状态行仍然钉在输入面板正上方（P18 的断言不许动）----
    tuis_reset(100, 28);
    tuis_fill_transcript();
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tui_tasks_rows_n() != 0 {
        tuis_fail(tag, "空态下任务块应当是 0 行", &ok);
    }
    if tuis_find_row("┌─ tasks " as &const byte, &row) {
        tuis_fail(tag, "空态下画出了任务箱体（布局应当与 P22 之前逐字节相同）", &ok);
    }
    if !tuis_find_row("Bash(make check)" as &const byte, &row) {
        tuis_fail(tag, "空态下状态行不见了", &ok);
    } else if row != tui_nrows() - 4 {
        tuis_fail(tag, "空态下状态行没有钉在输入面板正上方", &ok);
    }

    // ---- B) 装上 fixture（真实 globals）：折叠行出现在状态区之上 ----
    agent_tasks_fixture_demo();
    _ = tasks_panel_sync();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    var srow: usize = 0;         // 状态行
    var trow: usize = 0;         // 折叠行
    var arow: usize = 0;         // agents 箱体首行
    // 块 = 折叠行(1) + agents 箱体(1 个 agent = 4 行)：agents 箱体跟着块一起推
    if tui_tasks_rows_n() != 5 {
        tuis_fail(tag, "折叠态的块应当是「1 行折叠 + agents 箱体 4 行」", &ok);
    }
    if !tuis_find_row("▸ 任务 2/4 50%" as &const byte, &trow) {
        tuis_fail(tag, "折叠行没有出现", &ok);
    } else {
        if !tui_row_has(trow, "后台 1/2" as &const byte) {
            tuis_fail(tag, "折叠行少了后台任务段", &ok);
        }
        if !tui_row_has(trow, "子代理 1/1" as &const byte) {
            tuis_fail(tag, "折叠行少了子代理段", &ok);
        }
        if !tui_row_has(trow, "目标 3/20" as &const byte) {
            tuis_fail(tag, "折叠行少了目标段", &ok);
        }
    }
    if !tuis_find_row("┌─ agent " as &const byte, &arow) {
        tuis_fail(tag, "运行中的子代理窗口没画出来（P15 被任务块挤掉了？）", &ok);
    }
    if !tuis_find_row("Bash(make check)" as &const byte, &srow) {
        tuis_fail(tag, "有任务块时状态行丢了", &ok);
    } else if srow != tui_nrows() - 4 {
        tuis_fail(tag, "任务块把状态行挤离了输入面板上方", &ok);
    } else if !(trow < arow && arow < srow) {
        tuis_fail(tag, "层序不对（应当是 转录 → 任务块 → agents 箱体 → 状态区 → 面板）", &ok);
    }

    // ---- C) ctrl+t：键层只置请求；处理之后展开成箱体，再切回收起 ----
    tui_keys_inject("\x14" as &const byte, 1);
    const req: i32 = tui_take_request();
    if req != TUI_REQ_TASKS {
        tuis_fail(tag, "ctrl+t 没有置出「切换任务块」请求", &ok);
    }
    tasks_expand_set(!tasks_expanded());
    _ = tasks_panel_sync();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tasks_expanded() {
        tuis_fail(tag, "ctrl+t 之后展开态没打开", &ok);
    }
    if tui_tasks_rows_n() <= 1 {
        tuis_fail(tag, "展开之后还是 1 行（箱体没画出来）", &ok);
    }
    if !tuis_find_row("┌─ tasks " as &const byte, &row) {
        tuis_fail(tag, "展开之后没有任务箱体", &ok);
    } else if row >= tui_nrows() - 4 {
        tuis_fail(tag, "展开的任务箱体压在输入面板上", &ok);
    }
    var crow: usize = 0;
    if !tuis_find_row("清单" as &const byte, &crow) {
        tuis_fail(tag, "展开的箱体里没有清单段", &ok);
    } else if !tui_row_has(crow, "2/4" as &const byte) {
        tuis_fail(tag, "清单段没有带上计数", &ok);
    }
    var grow: usize = 0;
    if !tuis_find_row("└─ " as &const byte, &grow) {
        tuis_fail(tag, "展开的箱体没有底框", &ok);
    }
    var a2: usize = 0;
    if !tuis_find_row("┌─ agent " as &const byte, &a2) {
        tuis_fail(tag, "展开之后 agents 箱体不见了（行数够的时候不该丢）", &ok);
    } else if !(row < crow && crow < grow && grow < a2) {
        tuis_fail(tag, "层序不对（应当是 任务箱体（顶→清单→底）→ agents 箱体）", &ok);
    }
    // 再切一次回到折叠态
    tasks_expand_set(!tasks_expanded());
    _ = tasks_panel_sync();
    tui_build();
    if tui_tasks_rows_n() != 5 {
        tuis_fail(tag, "收起之后没有回到「1 行折叠 + agents 箱体」", &ok);
    }
    if tuis_find_row("┌─ tasks " as &const byte, &row) {
        tuis_fail(tag, "收起之后任务箱体还挂在屏幕上", &ok);
    }

    // ---- D) 活体刷新：job 状态变了，折叠行的「后台 r/n」跟着变 ----
    g_jobs.items[0].status = JOB_DONE;
    g_jobs.items[0].exit_code = 0;
    tasks_tick(ua_now_ms() + (5000 as u64));
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_find_row("▸ 任务 2/4 50%" as &const byte, &trow) {
        tuis_fail(tag, "活体刷新之后折叠行不见了", &ok);
    } else if !tui_row_has(trow, "后台 0/2" as &const byte) {
        tuis_fail(tag, "job 跑完了折叠行的后台计数没跟着变", &ok);
    }

    // ---- E) 矮终端降级：箱体裁到可用行数（含边框），转录仍留 ≥3 行 ----
    tuis_reset(80, 12);
    tuis_fill_transcript();
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    agent_tasks_fixture_demo();
    tasks_expand_set(true);
    _ = tasks_panel_sync();
    tui_build();
    tuis_scan_rows(80, &ok, tag);
    // 80×12：面板 2 行 + 脚注 1 → 面板顶在第 9 行；状态区 1 行 → 余 8 行，给转录留 3 行 = 块最多 5 行
    if tui_tasks_rows_n() > 5 {
        tuis_fail(tag, "矮终端下的块超过了可用行数（阶梯退化没生效）", &ok);
    }
    if !tuis_find_row("… 还有 " as &const byte, &row) {
        tuis_fail(tag, "裁掉的行数没有补 `… 还有 N 行`", &ok);
    }
    if !tuis_find_row("Bash(make check)" as &const byte, &srow) || srow != tui_nrows() - 4 {
        tuis_fail(tag, "矮终端下状态行没有钉在面板正上方", &ok);
    }
    // 地方不够时先丢的是 agents 箱体：紧贴状态行上方那一行必须是完整的箱体底框
    if !tui_row_has(srow - 1, "└─ " as &const byte) {
        tuis_fail(tag, "矮终端下箱体被硬裁掉了底框（应当整体退化成不带 agents 的箱体）", &ok);
    }
    if tuis_find_row("┌─ agent " as &const byte, &row) {
        tuis_fail(tag, "地方不够时应当先丢 agents 箱体", &ok);
    }
    var blank_top: bool = true;
    var r0: usize = 0;
    while r0 < tui_nrows() - 4 {
        if !tui_row_blank(r0) {
            blank_top = false;
        }
        r0 = r0 + 1;
    }
    if blank_top {
        tuis_fail(tag, "矮终端下转录一行都没留下", &ok);
    }

    // ---- F) 窄终端：每行不超列宽（tuis_scan_rows 覆盖），箱体照画 ----
    tuis_reset(40, 14);
    tuis_fill_transcript();
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    agent_tasks_fixture_demo();
    tasks_expand_set(true);
    _ = tasks_panel_sync();
    tui_build();
    tuis_scan_rows(40, &ok, tag);
    if !tuis_find_row("┌─ tasks " as &const byte, &row) {
        tuis_fail(tag, "40 列下没有画出任务箱体", &ok);
    }

    // ---- G) /tasks 命令在 TUI 里必须开出任务浮层（滚动模式那条打印路径由 e2e-tasks 守着）----
    tuis_reset(100, 28);
    agent_tasks_fixture_demo();
    var c: Config = cfg_default();
    defer { cfg_free(&c); }
    c.sandbox = SAN_OFF;
    var hs: History = hist_init();
    defer { hist_free(&hs); }
    var cmd: Buf = buf_new(32);
    defer { buf_free(&cmd); }
    _ = buf_append_cstr(&cmd, "/tasks");
    _ = agent_tui_command(&c, &hs, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_TASKS {
        tuis_fail(tag, "/tasks 没有开出任务浮层", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);        // 回车：关掉浮层并把选中行交出来
    var got: Buf = buf_new(512);
    defer { buf_free(&got); }
    if !tui_overlay_take(&got) {
        tuis_fail(tag, "任务浮层没有把内容交出来（结果被丢了？）", &ok);
    } else {
        var found: bool = false;
        var gi: usize = 0;
        while gi + 6 <= got.len {
            if bufx_mem_eq(&got.ptr[gi] as &const byte, "清单" as &const byte, 6) {
                found = true;
            }
            gi = gi + 1;
        }
        if !found {
            tuis_fail(tag, "任务浮层里不是任务报告（第一行没有「清单」）", &ok);
        }
    }

    // 收尾：fixture 装在真实 globals 上，必须清掉（后面的 TUI 轮靠空表做排版断言）
    tuis_tasks_clear();

    // ---- H) P29：/goal 在 TUI 里必须开出目标浮层；带参数的那条还要落盘 + 刷新目标投影 ----
    // （滚动模式那条「打进转录」的路由 e2e-goal 守着；这一轮守 TUI 这条腿：
    //   清单里有没有这条命令、浮层开不开、标题对不对、正文是不是 goal_cmd_run 的输出、
    //   goal.json 有没有落盘、常驻块的目标段有没有跟着新值重画）
    tuis_reset(100, 28);
    const ghome: &const byte = "build/selftest_goal_tui_home" as &const byte;
    _ = sess_mkdir_p(ghome);
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, ghome);
    _ = goal_clear(&c);                  // 上一轮留下的 goal.json 先清掉
    var gline: Buf = buf_new(256);
    defer { buf_free(&gline); }
    var gsel: Buf = buf_new(1024);
    defer { buf_free(&gsel); }
    var hg: History = hist_init();
    defer { hist_free(&hg); }
    // 命令面板的**真实**清单里必须有 /goal（面板只吃 agent_tui_commands 的产物）
    var plist: Buf = buf_new(2048);
    defer { buf_free(&plist); }
    agent_tui_commands(&plist);
    if !tuis_has(&plist, "/goal" as &const byte) {
        tuis_fail(tag, "命令面板的清单里没有 /goal", &ok);
    }
    // 无目标：浮层照开，正文是用法（不许静默无事发生）
    _ = buf_append_cstr(&gline, "/goal");
    _ = agent_tui_command(&c, &hg, &gline);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_GOAL {
        tuis_fail(tag, "/goal 没有开出目标浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("目标（esc 关闭）" as &const byte) {
        tuis_fail(tag, "目标浮层没有画到屏幕上（或标题不对）", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&gsel) || !tuis_has(&gsel, "No goal is currently set." as &const byte) {
        tuis_fail(tag, "无目标时的目标浮层里没有用法", &ok);
    }
    // 创建：浮层给回执、goal.json 落盘、常驻块的目标投影当场刷新
    tui_overlay_close();
    buf_reset(&gline);
    _ = buf_append_cstr(&gline, "/goal 把 TUI 这条腿也测了");
    _ = agent_tui_command(&c, &hg, &gline);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_GOAL {
        tuis_fail(tag, "/goal <objective> 没有开出目标浮层", &ok);
    }
    // 正文要真的画在屏幕上（list 型浮层 take 回来的只是**选中行**，所以正文得看帧）
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("Goal created" as &const byte) {
        tuis_fail(tag, "创建目标的浮层里没有回执", &ok);
    }
    if !tuis_screen_has("Objective: 把 TUI 这条腿也测了" as &const byte) {
        tuis_fail(tag, "创建目标的浮层里 objective 不对", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&gsel) || !tuis_has(&gsel, "Goal created" as &const byte) {
        tuis_fail(tag, "创建目标的浮层没把选中行交出来", &ok);
    }
    var tg: Goal = goal_empty();
    defer { goal_free(&tg); }
    if !goal_load(&c, &tg) {
        tuis_fail(tag, "/goal <objective> 之后盘上没有 goal.json", &ok);
    } else if tg.id != 1 || tg.revision != 1 || !tg.armed {
        tuis_fail(tag, "落盘的 id/revision/armed 不对", &ok);
    }
    if !tasks_goal_ref().active_state {
        tuis_fail(tag, "/goal 创建之后常驻块的目标投影没有跟着刷新", &ok);
    }
    // 清除：浮层回执 + 投影回到「无目标」
    tui_overlay_close();
    buf_reset(&gline);
    _ = buf_append_cstr(&gline, "/goal clear");
    _ = agent_tui_command(&c, &hg, &gline);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_GOAL {
        tuis_fail(tag, "/goal clear 没有开出目标浮层", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&gsel) || !tuis_has(&gsel, "Goal cleared." as &const byte) {
        tuis_fail(tag, "/goal clear 的浮层里没有回执", &ok);
    }
    if tasks_goal_ref().active_state {
        tuis_fail(tag, "clear 之后常驻块的目标投影还留着旧目标", &ok);
    }
    _ = goal_clear(&c);                  // 收尾：不留 goal.json 给别的轮

    if ok {
        tuis_ok(tag, "空态 0 行 + 折叠行钉在状态区之上 + ctrl+t 展开/收起 + 活体刷新 + 矮/窄终端降级 + /tasks 浮层 + /goal 浮层");
    }
    return ok;
}

// ============================================================
// tui-ws（P34）：工作区切换在界面上、在给模型的快照里都跟上
//
// 覆盖四件事：
//   1) 脚注 cwd 与转录通知跟着新工作区走（切换是真 chdir，测试收尾要站回仓库根）；
//   2) step 边界补推的运行时上下文里写着新工作区，而且是**注入消息**（不画成用户条目）；
//   3) /diff 浮窗标题里写的是工作区（假数据注入工作区，不必真跑 git）；
//   4) 切到已经在的工作区是幂等的（不推快照、不刷通知）。
// ====================================================
fn tui_ws_round(tag: &const byte) bool {
    var ok: bool = true;
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        tuis_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    defer { wst_back(&root); }
    _ = sess_mkdir_p(WST_A);
    _ = sess_mkdir_p(WST_A_SUB);
    var abs_a: Buf = buf_new(1024);
    defer { buf_free(&abs_a); }
    var abs_sub: Buf = buf_new(1024);
    defer { buf_free(&abs_sub); }
    if !wst_abs(&root, WST_A, &abs_a) || !wst_abs(&root, WST_A_SUB, &abs_sub) {
        tuis_fail(tag, "拿不到临时工作区的绝对路径", &ok);
        return ok;
    }

    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("selftest-model");
    cfg.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&cfg);
    var h: History = hist_init();
    defer { hist_free(&h); }
    // 清台面：TUI 状态复位之后再切（通知与脚注都画在复位之后的那一帧上）
    tuis_reset(120, 30);
    tui_build();
    const n_base: usize = h.len;

    // ---- 切到 A：通知 + 脚注 ----
    const rc: i32 = agent_workspace_apply(&cfg, abs_a.ptr as &const byte, abs_a.len, "tool" as &const byte, true);
    if rc != WS_OK {
        tuis_fail(tag, "切到临时工作区失败", &ok);
        return ok;
    }
    tui_build();
    // 脚注里的 cwd 是 $HOME → ~ 的短路径
    var short_a: Buf = buf_new(1024);
    defer { buf_free(&short_a); }
    const hm: &byte = getenv("HOME");
    var hn: usize = 0;
    if (hm as usize) != 0 {
        hn = bufx_cstr_len(hm);
    }
    if hn > 1 && abs_a.len > hn && abs_a.ptr[hn] == 47 as byte && bufx_mem_eq(abs_a.ptr as &const byte, hm, hn) {
        _ = buf_append_cstr(&short_a, "~");
        _ = buf_append(&short_a, abs_a.ptr + hn, abs_a.len - hn);
    } else {
        _ = buf_append(&short_a, abs_a.ptr as &const byte, abs_a.len);
    }
    // 脚注 cwd 会被列宽预算裁短，所以断言「末段目录名」+「通知里的完整路径」两处
    if !tuis_screen_has("selftest_ws_p31_a" as &const byte) {
        tuis_fail(tag, "界面上看不到新工作区（脚注 cwd 没跟上）", &ok);
    }
    if !tuis_screen_has("工作区 → " as &const byte) {
        tuis_fail(tag, "转录里没有工作区切换的通知", &ok);
    }
    // 通知里写的是**绝对**路径（转录没有列宽问题，可复制粘贴）
    var abs_az: Buf = buf_new(abs_a.len + 1);
    defer { buf_free(&abs_az); }
    _ = buf_append(&abs_az, abs_a.ptr as &const byte, abs_a.len);
    _ = buf_append_byte(&abs_az, 0);
    if !tuis_screen_has(abs_az.ptr as &const byte) {
        tuis_fail(tag, "通知里没有新工作区的完整路径", &ok);
    }
    if tuis_screen_has("Current runtime context" as &const byte) {
        tuis_fail(tag, "运行时上下文被画成用户条目了", &ok);
    }

    // ---- step 边界补推：运行时上下文里要有新工作区 ----
    // 进程级基线可能还是上一轮留下的：这一步本就该推；再调一次必须幂等。
    const n0: usize = h.len;
    agent_ws_snapshot_sync(&cfg, &h);
    const n_pushed: usize = h.len;
    agent_ws_snapshot_sync(&cfg, &h);
    if n_pushed <= n0 {
        tuis_fail(tag, "工作区变了却没有给模型补一份新快照", &ok);
    } else if h.len != n_pushed {
        tuis_fail(tag, "工作区没再变却又推了一份快照", &ok);
    } else {
        const m: &const Msg = msg_at(&h, n0);
        if m.text_len < 23 || !bufx_mem_eq(m.text as &const byte, "Current runtime context" as &const byte, 23) {
            tuis_fail(tag, "补推的消息不是以 Current runtime context 开头", &ok);
        }
        var mtxt: Buf = buf_new(4096);
        defer { buf_free(&mtxt); }
        _ = buf_append(&mtxt, m.text as &const byte, m.text_len);
        if !tuis_has(&mtxt, abs_az.ptr as &const byte) {
            tuis_fail(tag, "补推的快照里没有新工作区路径", &ok);
        }
        if !tuis_has(&mtxt, "Current workspace: " as &const byte) {
            tuis_fail(tag, "补推的快照里没有 Current workspace 那行", &ok);
        }
        if !agent_tui_is_injected(m) {
            tuis_fail(tag, "补推的运行时上下文会被当成用户消息回填", &ok);
        }
    }

    // ---- /diff 标题：工作区 + 仓库名（假数据注入工作区，不依赖 git）----
    tuis_reset(120, 30);
    tuis_fixture_open();
    gd_fixture_ws("/p31/ws" as &const byte, bufx_cstr_len("/p31/ws" as &const byte));
    tui_build();
    if !tuis_screen_has("/diff · /p31/ws" as &const byte) {
        tuis_fail(tag, "/diff 标题里没有工作区", &ok);
    }
    if !tuis_screen_has("uya-agent" as &const byte) {
        tuis_fail(tag, "/diff 标题里没有仓库名（工作区不是仓库根时要两个都写）", &ok);
    }
    tui_overlay_close();
    // 收尾：把假数据的工作区清掉（后面 tui-diff 轮还要按「没有工作区」的旧排版断言）
    gd_fixture_ws("" as &const byte, 0);

    // ---- 幂等：切到已经在的工作区不推快照、不刷通知 ----
    const n1: usize = h.len;
    const same: i32 = agent_workspace_apply(&cfg, abs_a.ptr as &const byte, abs_a.len, "tool" as &const byte, true);
    if same != WS_E_SAME {
        tuis_fail(tag, "切到已经在的工作区应当是幂等的", &ok);
    }
    agent_ws_snapshot_sync(&cfg, &h);
    if h.len != n1 {
        tuis_fail(tag, "幂等切换却又推了一份快照", &ok);
    }

    // ---- 相对路径也认（按当前工作区解析）----
    const rrel: i32 = agent_workspace_apply(&cfg, "sub" as &const byte, 3, "tool" as &const byte, true);
    if rrel != WS_OK {
        tuis_fail(tag, "相对路径切不过去", &ok);
    } else if cfg.workspace.len != abs_sub.len ||
        !bufx_mem_eq(cfg.workspace.ptr as &const byte, abs_sub.ptr as &const byte, abs_sub.len) {
        tuis_fail(tag, "相对路径没有落到子目录上", &ok);
    }
    return ok;
}

// ============================================================
// tui-sessions（P33）：/sessions 浮层 —— 时间倒序 · 三列 · 选中项恢复
// ============================================================
// 端到端一条链：真索引 fixture（三个会话，走真实的 sess_open/sess_close 落盘）
// → `/sessions` 开浮层 → 宽箱体（cols-6）+ 三列 + 逐行宽度不变量
// → **P35**：最新的那行在**最后一行**、默认游标就落在它上面
// → 回车 → agent_tui_sessions_head 取到**完整 id**（不是标题）→ 该 id 能被 sess_find 找到
//   （`/resume <id>` 走的就是 sess_find）。
// 窄终端那一档另跑一遍：工作区列掉了、id 列还在，条目文本里的 id 仍然完整。

// 造一个真会话（真落盘 + 真索引行；标题由调用方给）
fn tuis_sess_make(home: &const byte, ws: &const byte, title: &const byte, out_id: &Buf) bool {
    var log: SessionLog = sess_log_empty();
    defer { sess_log_free(&log); }
    if !sess_open(&log, home, ws, "selftest-model" as &const byte, "uya-agent" as &const byte, "" as &const byte, true, 0 as i64, true) {
        return false;
    }
    buf_reset(&log.title);
    _ = buf_append_cstr(&log.title, title);
    buf_reset(out_id);
    _ = buf_append(out_id, log.id.ptr, log.id.len);
    sess_close(&log, home);
    return out_id.len > 0;
}

// tui-sessions 轮（P33）：/sessions 与 /resume 在 TUI 里这条链 —— 列表渲染、选中即切换、
// 空列表、坏索引降级。返回 false = 本轮红；夹具 home 每轮重建。
fn tui_sessions_round(tag: &const byte) bool {
    var ok: bool = true;
    const home: &const byte = "build/selftest_tui_sessions" as &const byte;
    const ws: &const byte = "build/selftest_tui_sessions_ws" as &const byte;
    _ = sess_mkdir_p(home);
    // 同一个 home 可能被上一轮用过：索引先清掉，否则旧会话会混进列表
    var ipath: Buf = buf_new(160);
    defer { buf_free(&ipath); }
    _ = buf_append_cstr(&ipath, home);
    _ = buf_append_cstr_z(&ipath, "/index.jsonl");
    _ = sys_unlink(ipath.ptr as *const byte) catch {};
    var id_old: Buf = buf_new(64);
    var id_mid: Buf = buf_new(64);
    var id_new: Buf = buf_new(64);
    defer { buf_free(&id_old); buf_free(&id_mid); buf_free(&id_new); }
    // 时间戳来自 ua_now_ms（索引追加写）⇒ 写入顺序就是时间顺序，最后写的必须排最上
    if !tuis_sess_make(home, ws, "OLD-TITLE 最早的会话" as &const byte, &id_old) {
        tuis_fail(tag, "fixture 会话（最早的）没建成", &ok);
        return ok;
    }
    if !tuis_sess_make(home, ws, "MID-TITLE 中间的会话" as &const byte, &id_mid) {
        tuis_fail(tag, "fixture 会话（中间的）没建成", &ok);
        return ok;
    }
    if !tuis_sess_make(home, ws, "NEW-TITLE 最新的会话" as &const byte, &id_new) {
        tuis_fail(tag, "fixture 会话（最新的）没建成", &ok);
        return ok;
    }

    var c: Config = cfg_default();
    defer { cfg_free(&c); }
    c.sandbox = SAN_OFF;
    c.agent_home = buf_new(96);
    _ = buf_append_cstr(&c.agent_home, home);
    var hs: History = hist_init();
    defer { hist_free(&hs); }
    var cmd: Buf = buf_new(32);
    defer { buf_free(&cmd); }
    _ = buf_append_cstr(&cmd, "/sessions");

    // ---- A) 宽终端（100 列）：三列都看得见，箱体铺到 cols-6 ----
    tuis_reset(100, 30);
    _ = agent_tui_command(&c, &hs, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_SESSIONS {
        tuis_fail(tag, "/sessions 没有开出会话浮层", &ok);
        tui_overlay_close();
        return ok;
    }
    tuis_overlay_frame_check(100, &ok, tag);
    if !tuis_screen_has("会话（enter 恢复 · esc 取消）" as &const byte) {
        tuis_fail(tag, "会话浮层的标题不对", &ok);
    }
    if !tuis_screen_has("NEW-TITLE" as &const byte) || !tuis_screen_has("OLD-TITLE" as &const byte) {
        tuis_fail(tag, "浮层里看不到会话标题（第一列不是标题？）", &ok);
    }
    if !tuis_screen_has("sessions_ws" as &const byte) {
        tuis_fail(tag, "100 列下工作区列不可见（三列没排开？）", &ok);
    }
    var r_new: usize = 0;
    var r_old: usize = 0;
    if tuis_find_row("NEW-TITLE" as &const byte, &r_new) && tuis_find_row("OLD-TITLE" as &const byte, &r_old) {
        // P35：最新的排**最后一行**（紧挨输入面板），最旧的回到第一行
        if r_new <= r_old {
            tuis_fail(tag, "会话列表不是「最新的在最后一行」（P35 的展示序）", &ok);
        }
    } else {
        tuis_fail(tag, "浮层里没同时找到最新与最早的会话", &ok);
    }
    // P35：游标默认必须落在**最后一项**（最新的那个）—— 否则「打开就回车」恢复的是最旧的会话。
    // 游标位置用公开的 sel_index 读（不偷看全局）：条目是 3 条，最后一项下标 = 2。
    if tui_overlay_sel_index() != 2 {
        tuis_fail(tag, "会话浮层的默认游标不在最后一项（最新的那个）上", &ok);
    }
    // 箱体确实铺开了：100 列下箱宽 94（cols-6）、左边距 3 ⇒ 顶边右边界列 = 97
    var txt: Buf = buf_new(65536);
    defer { buf_free(&txt); }
    _ = tui_screen_text(&txt);
    const top: usize = tuis_find_lit_row(txt.ptr as &const byte, txt.len, 0, tui_nrows(), "╭" as &const byte);
    if top >= tui_nrows() {
        tuis_fail(tag, "会话浮层没画出来（找不到顶边）", &ok);
    } else {
        const right: usize = tuis_row_edge_end(txt.ptr as &const byte, txt.len, top);
        if right != 97 {
            tuis_fail(tag, "会话浮层的箱体没有按终端宽度铺开", &ok);
        }
    }
    // 回车：选中项必须是**最新的那个会话**，且取出来的是完整 id（不是标题）
    tui_keys_inject("\r" as &const byte, 1);
    var sel: Buf = buf_new(1024);
    defer { buf_free(&sel); }
    var sid: Buf = buf_new(128);
    defer { buf_free(&sid); }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "回车没有把选中项交出来", &ok);
    } else {
        agent_tui_sessions_head(&sel, &sid);
        // 按长度比较：id_new 是 Buf（不保证 NUL 结尾），bufx_eq_cstr 只收 C 字符串
        if sid.len != id_new.len || !bufx_mem_eq(sid.ptr as &const byte, id_new.ptr as &const byte, id_new.len) {
            tuis_fail(tag, "选中项里取到的不是最新的会话 id（拿标题当 id 了？）", &ok);
        }
        var hz: Buf = buf_new(160);
        defer { buf_free(&hz); }
        _ = buf_append_cstr(&hz, home);
        _ = buf_append_byte(&hz, 0);
        var wz: Buf = buf_new(160);
        defer { buf_free(&wz); }
        _ = buf_append_cstr(&wz, ws);
        _ = buf_append_byte(&wz, 0);
        var path: Buf = buf_new(1200);
        defer { buf_free(&path); }
        if sid.len == 0 || !sess_find(hz.ptr as &const byte, wz.ptr as &const byte, sid.ptr as &const byte, sid.len, &path) {
            tuis_fail(tag, "从浮层取到的 id 恢复不了（/resume <id> 会找不到会话）", &ok);
        }
    }
    tui_overlay_close();

    // ---- B) 窄终端（60 列）：工作区列掉，id 列还在；条目文本里的 id 仍然完整 ----
    tuis_reset(60, 20);
    _ = agent_tui_command(&c, &hs, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_SESSIONS {
        tuis_fail(tag, "60 列下 /sessions 没开出浮层", &ok);
        tui_overlay_close();
        return ok;
    }
    tuis_overlay_frame_check(60, &ok, tag);
    if !tuis_screen_has("session-" as &const byte) {
        tuis_fail(tag, "60 列下会话列表里连 id 列都没了", &ok);
    }
    if tuis_screen_has("sessions_ws" as &const byte) {
        tuis_fail(tag, "60 列下工作区列还在（退化阶梯没生效）", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "60 列下回车没有交回选中项", &ok);
    } else {
        agent_tui_sessions_head(&sel, &sid);
        if sid.len != id_new.len || !bufx_mem_eq(sid.ptr as &const byte, id_new.ptr as &const byte, id_new.len) {
            tuis_fail(tag, "60 列下取到的 id 不完整（条目文本里被裁了？）", &ok);
        }
    }
    tui_overlay_close();
    // 收尾：画布与浮层状态复原，后面的轮次不靠这次留下的东西
    tui_reset_all();
    if ok {
        tuis_ok(tag, "最新的在最后一行 + 默认游标落到最新那条 + 三列（标题/工作区/id）+ 箱体随终端铺开 + 选中项取完整 id + 窄终端退化 + 方框闭合");
    }
    return ok;
}
