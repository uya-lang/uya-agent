// src/selftest/st_mcp.uya — MCP 插件的离线自测（P70）
//
// 本文件：四条腿 —— 公开名规则（`mcp_name_round`）、真实子进程的握手与工具发现
//   （`mcp_handshake_round`）、派发与结果投影（`mcp_call_round`）、降级与不留孤儿
//   （`mcp_degrade_round`）；以及三条腿共用的现场 server 生成（`mcp_fixture_server`）
//   与判据小工具（`mcp_round_ok`）。
// 不变量：① **判据读事实**：server 自己把收到的请求落盘（`marker`），断言比对
//   「文件里到底有什么」——不看「屏幕上看起来对」；② 每条腿**自己收干净**：
//   结束时 `mcprun_stop_all`（不留孤儿子进程，这是本仓自测的硬纪律）；
//   ③ 现场写盘的 server 只用 `/bin/sh` + `sed`（不依赖 python/node —— 自测必须
//   在只有 POSIX shell 的机器上也能跑）；④ 每条腿可单跑（`UYA_SELFTEST_MCP_ONLY=1`）
//   且幂等：连跑两次都 PASS（工作区每轮重建）。
// 依赖：libc（syscall/unistd）；本仓 foundation/bufx、session/session（`jw_str_into`）、
//   tools/perm（切访问模式）、plugin（mcpcfg / mcprun / mcp / mcptool）；
//   selftest/selftest 的 `ty_fail` / `write_text_file` / `ws_prepare`（合并命名空间）。
// 命名：对外只有 `mcp_selftest_rounds`；私有前缀 `mcp_` / `MCP_`。
//
// 为什么这些腿值得写（都是真踩过的形状）：
//   * 公开名归一化错 ⇒ 模型调不到工具（名字对不上）；且 DSH 的 hash 后缀规则必须逐字一致，
//     否则同一台机器上 DSH 与本仓对同一个 server 会给出**两个不同的工具名**；
//   * 握手顺序错（`tools/list` 发在 `notifications/initialized` 之前）⇒ 严格 server 直接拒；
//   * 把**公开名**当 raw 名发上线 ⇒ server 报 unknown tool（公开名是有损的，反推不回来）；
//   * server 不回某个方法（标准 MCP server 不认我们的钩子）⇒ 必须**放行**，不能当故障。

use libc.syscall;
use libc.unistd;

// 现场生成的 MCP server 路径（自测专用工作区里）
// 夹具根：**绝对路径**（`/tmp/selftest_mcp_<pid>`）。
// ⚠ 不能用相对的 `build/...`：整轮 selftest 里前面好几轮会**真的 chdir**（工作区那几轮），
// 到这一轮时 cwd 已经不是仓库根了 —— 相对路径会在别处建目录、甚至建不出来
// （现场症状：单跑这一轮 PASS、整轮 selftest 里报「夹具 server 写不出来」）。
// 这条教训与 `pms_root` / `wt_ws_pid` 是同一个（st_pm.uya 顶部写着）。
fn mcp_fixture_dir(out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, "/tmp/selftest_mcp_" as &const byte);
    const pid: i64 = sys_getpid() catch { 0 as i64; };
    _ = buf_append_i64(out, pid);
}

// 夹具脚本路径 = <dir>/server.sh（marker 是 `<脚本>.marker`，由脚本自己按 `$0` 推）
fn mcp_fixture_srv(out: &Buf) void {
    mcp_fixture_dir(out);
    _ = buf_append_cstr(out, "/server.sh" as &const byte);
}
// 行宽豁免：错误文案/诊断行是**单条不可断的字面量**（Uya 没有相邻字面量拼接）
// marker 由夹具脚本按 `$0.marker` 写（脚本自己知道自己在哪），这里按同一规则算出来
fn mcp_fixture_mark(out: &Buf) void {
    mcp_fixture_srv(out);
    _ = buf_append_cstr(out, ".marker" as &const byte);
}

// 判据小工具：记一行 FAIL 并置 ok=false（与 `ty_fail` 同形，但带上「实际是什么」）
fn mcp_round_ok(tag: &const byte, ok: &bool) void {
    if ok[0] {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    } else {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL\n");
    }
}

// 一个最小但**完整**的 MCP stdio server（POSIX sh + sed，不依赖 python/node）。
//
// 它做四件事：
//   1. 把收到的每一行请求**原样落到 marker**（判据读它 —— 「server 到底收到了什么」）；
//   2. `initialize` 回一条规范响应（含 protocolVersion / capabilities / serverInfo）；
//   3. `tools/list` 报**两个**工具：一个名字合法（`echo`）、一个带非法字符（`echo.text`）
//      —— 后者用来钉「公开名归一化 + hash 后缀」那条规则；
//   4. `tools/call` 回 `echo: <text>`，并把**收到的 raw 名**写进 marker
//      （钉「上线发的是 raw 名，不是公开名」）。
//
// `MCP_CRASH=1` 时第 2 步直接退进程（不给任何响应）—— 用来跑「server 崩了」那条腿。
const MCP_FIXTURE: &const byte = "#!/bin/sh\n# selftest MCP server (generated by st_mcp.uya)\nwhile IFS= read -r line; do\n  printf '%s\\n' \"$line\" >> \"$0.marker\"\n  id=$(printf '%s' \"$line\" | sed -n 's/.*\"id\"[ ]*:[ ]*\\([0-9][0-9]*\\).*/\\1/p')\n  case \"$line\" in\n    *'\"method\":\"initialize\"'*)\n      if [ \"$CRASH\" = \"1\" ]; then exit 7; fi\n      printf '{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"fixture\",\"version\":\"1.0\"}}}\\n' \"$id\" ;;\n    *'\"method\":\"tools/list\"'*)\n      printf '{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":{\"tools\":[{\"name\":\"echo\",\"description\":\"Echo the text back\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}},{\"name\":\"echo.text\",\"description\":\"Dotted name\",\"inputSchema\":{\"type\":\"object\"}}]}}\\n' \"$id\" ;;\n    *'\"method\":\"tools/call\"'*)\n      raw=$(printf '%s' \"$line\" | sed -n 's/.*\"name\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p')\n      printf 'CALLED %s\\n' \"$raw\" >> \"$0.marker\"\n      text=$(printf '%s' \"$line\" | sed -n 's/.*\"text\"[ ]*:[ ]*\"\\([^\"]*\\)\".*/\\1/p')\n      printf '{\"jsonrpc\":\"2.0\",\"id\":%s,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"echo: %s\"}],\"isError\":false}}\\n' \"$id\" \"$text\" ;;\n    *'\"method\":\"notifications/initialized\"'*) : ;;\n    *)\n      # 不认的方法：规范要求的 -32601（钩子那条腿靠它判「放行」）\n      if [ -n \"$id\" ]; then printf '{\"jsonrpc\":\"2.0\",\"id\":%s,\"error\":{\"code\":-32601,\"message\":\"Method not found\"}}\\n' \"$id\"; fi ;;\n  esac\ndone\n";

// 现场铺一套自测夹具：目录 + server 脚本（可执行）+ serverName 配置行。
// 返回 false = 建不起来（调用方直接判失败，不静默跳过）。
fn mcp_fixture_server() bool {
    var dir: Buf = buf_new(256);
    defer { buf_free(&dir); }
    var srv: Buf = buf_new(256);
    defer { buf_free(&srv); }
    var mk: Buf = buf_new(256);
    defer { buf_free(&mk); }
    var dz: Buf = buf_new(256);
    defer { buf_free(&dz); }
    var sz: Buf = buf_new(256);
    defer { buf_free(&sz); }
    var mz: Buf = buf_new(256);
    defer { buf_free(&mz); }
    if !buf_valid(&dir) || !buf_valid(&srv) || !buf_valid(&mk)
        || !buf_valid(&dz) || !buf_valid(&sz) || !buf_valid(&mz) {
        return false;
    }
    mcp_fixture_dir(&dir);
    mcp_fixture_srv(&srv);
    mcp_fixture_mark(&mk);
    _ = buf_append(&dz, dir.ptr, dir.len);
    _ = buf_append_byte(&dz, 0);
    _ = buf_append(&sz, srv.ptr, srv.len);
    _ = buf_append_byte(&sz, 0);
    _ = buf_append(&mz, mk.ptr, mk.len);
    _ = buf_append_byte(&mz, 0);
    _ = sys_mkdir(dz.ptr as *const byte, 493 as u32) catch {};
    if !write_text_file(sz.ptr as &const byte, MCP_FIXTURE) {
        return false;
    }
    // marker 清空（幂等：连跑两次的判据不能带上一次的残留）
    if !write_text_file(mz.ptr as &const byte, "" as &const byte) {
        return false;
    }
    return true;
}

// 把 marker 读成一个 Buf（读不到返回空）
fn mcp_fixture_marker(out: &Buf) void {
    buf_reset(out);
    var mk: Buf = buf_new(256);
    defer { buf_free(&mk); }
    if !buf_valid(&mk) {
        return;
    }
    mcp_fixture_mark(&mk);
    _ = buf_append_byte(&mk, 0);
    const fd: i32 = sys_open(mk.ptr as *const byte, 0, 0) catch { -1; };
    if fd < 0 {
        return;
    }
    defer { _ = sys_close(fd) catch {}; }
    var chunk: [byte: 4096] = [0: 4096];
    while true {
        const n: isize = sys_read(fd, &chunk[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        _ = buf_append(out, &chunk[0], n as usize);
    }
}

// ============================================================
// 腿 1：公开名规则（纯函数，无子进程）
// ============================================================
//
// 逐条对齐 DSH 的 `publicToolName`（`dsh-mcp-client/lib/index.js:119`）：
//   * 干净名就是 `mcp__<server>__<raw>`；
//   * 非法字符换 `_`（`echo.text` → `echo_text`）；
//   * 超 64 字符**或**发生过替换时，截到 `64-12-1` 再拼 `_` + sha256 前 12 位。
// 第三条是本腿的重点：**只要发生过替换就加 hash**（即使结果很短）——
// 这是 DSH 的规则（避免 `a.b` 与 `a_b` 撞成同一个名字）。
fn mcp_public_name_round(tag: &const byte) bool {
    var ok: bool = true;
    var got: Buf = buf_new(128);
    defer { buf_free(&got); }
    if !buf_valid(&got) {
        ty_fail(tag, "out of memory", &ok);
        return ok;
    }
    // ① 干净名：原样
    mcp_tool_public_name("fs" as &const byte, 2, "read_file" as &const byte, 9, &got);
    if !bufx_eq_cstr(got.ptr as &const byte, got.len, "mcp__fs__read_file" as &const byte) {
        ty_fail(tag, "干净名没拼成 mcp__fs__read_file", &ok);
    }
    // ② 非法字符：换 `_`，且**因为发生过替换**所以带 hash 后缀。
    // 长度 = min(原名长, 51) + 1 + 12 —— 对齐 DSH 的 `String.slice(0, 51)`（短串原样）：
    // `mcp__fs__read_file` 是 18 字节，所以结果是 18 + 1 + 12 = 31，**不是** 64。
    mcp_tool_public_name("fs" as &const byte, 2, "read.file" as &const byte, 9, &got);
    var joined: Buf = buf_new(128);
    defer { buf_free(&joined); }
    _ = buf_append_cstr(&joined, "mcp__fs__read_file" as &const byte);
    const want_len: usize = joined.len + 1 + 12;
    if got.len != want_len {
        ty_fail(tag, "有损归一化的名字长度不是 min(原名,51)+13", &ok);
    }
    const hexat: usize = if joined.len < 51 { joined.len } else { 51 as usize };
    if got.len > hexat && got.ptr[hexat] != 95 as byte {
        ty_fail(tag, "hash 后缀前的分隔符不是 `_`", &ok);
    }
    // 后缀必须是 `_` + 12 位小写 hex
    if got.len == want_len {
        var hexok: bool = true;
        var i: usize = hexat + 1;
        while i < got.len {
            const c: byte = got.ptr[i];
            const digit: bool = c >= 48 as byte && c <= 57 as byte;
            const alpha: bool = c >= 97 as byte && c <= 102 as byte;
            if !digit && !alpha {
                hexok = false;
            }
            i = i + 1;
        }
        if !hexok {
            ty_fail(tag, "hash 后缀不是 `_` + 12 位小写 hex", &ok);
        }
    }
    // ③ 超长（无非法字符）：也要截断 + hash
    var longraw: Buf = buf_new(128);
    defer { buf_free(&longraw); }
    if buf_valid(&longraw) {
        var k: usize = 0;
        while k < 70 {
            _ = buf_append_byte(&longraw, 97);   // 'a'
            k = k + 1;
        }
        mcp_tool_public_name("fs" as &const byte, 2, longraw.ptr as &const byte, longraw.len, &got);
        if got.len != 64 {
            ty_fail(tag, "超长名字没有截到 64", &ok);
        }
    }
    mcp_name_rules_check(tag, &ok);
    mcp_round_ok(tag, &ok);
    return ok;
}

// 腿 1 的后半：serverName 校验 + `mcp__` 前缀快筛（抽出来让主函数留在 100 行内）
fn mcp_name_rules_check(tag: &const byte, ok: &bool) void {
    // serverName 校验（DSH 的 ^[A-Za-z0-9_-]{1,32}$）
    if !mcp_server_name_ok("fs-2_x" as &const byte, 6) {
        ty_fail(tag, "fs-2_x 应是合法 serverName", ok);
    }
    if mcp_server_name_ok("" as &const byte, 0) {
        ty_fail(tag, "空 serverName 应被拒", ok);
    }
    if mcp_server_name_ok("a b" as &const byte, 3) {
        ty_fail(tag, "含空格的 serverName 应被拒", ok);
    }
    if mcp_server_name_ok("a/b" as &const byte, 3) {
        ty_fail(tag, "含斜杠的 serverName 应被拒", ok);
    }
    var toolong: Buf = buf_new(48);
    defer { buf_free(&toolong); }
    if buf_valid(&toolong) {
        var k: usize = 0;
        while k < 33 {
            _ = buf_append_byte(&toolong, 97);
            k = k + 1;
        }
        if mcp_server_name_ok(toolong.ptr as &const byte, toolong.len) {
            ty_fail(tag, "33 字节的 serverName 应被拒（上限 32）", ok);
        }
    }
    // `mcp__` 前缀快筛
    var ours: Buf = buf_new(64);
    defer { buf_free(&ours); }
    if buf_valid(&ours) {
        _ = buf_append_cstr(&ours, "mcp__fs__read");
        if !mcp_name_is_ours(&ours) {
            ty_fail(tag, "mcp__ 前缀没被认出来", ok);
        }
        buf_reset(&ours);
        _ = buf_append_cstr(&ours, "read");
        if mcp_name_is_ours(&ours) {
            ty_fail(tag, "read 被误认成 MCP 工具", ok);
        }
    }
}

// ============================================================
// 腿 2：真实子进程的握手与工具发现
// ============================================================
//
// 装配走**与运行时同一条路**（mcpcfg 的 CLI 来源 + mcp_ensure 的握手/发现），
// 不另写一份「只给测试用」的捷径 —— 否则测的不是上线的那条路。
fn mcp_handshake_round(tag: &const byte) bool {
    var ok: bool = true;
    var wsbuf: Buf = buf_new(256);
    defer { buf_free(&wsbuf); }
    var srvbuf: Buf = buf_new(256);
    defer { buf_free(&srvbuf); }
    var empty: Buf = buf_empty();
    defer { buf_free(&empty); }
    mcp_fixture_dir(&wsbuf);
    mcp_fixture_srv(&srvbuf);
    if !mcp_fixture_server() {
        ty_fail(tag, "夹具 server 写不出来", &ok);
        return ok;
    }
    var cli: Buf = buf_new(256);
    defer { buf_free(&cli); }
    if !buf_valid(&cli) || !buf_append_cstr(&cli, "fixture=/bin/sh " as &const byte)
        || !buf_append(&cli, srvbuf.ptr, srvbuf.len) {
        ty_fail(tag, "out of memory", &ok);
        return ok;
    }
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, &cli);
    if mcp_server_count() != 1 {
        ty_fail(tag, "server 数不是 1", &ok);
    }
    if mcp_tool_count() != 2 {
        ty_fail(tag, "工具数不是 2（tools/list 没解析对）", &ok);
    }
    // marker 里必须看到 initialize 与 tools/list，且**顺序**是先 initialize 后 tools/list；
    // notifications/initialized 必须夹在两者之间（规范要求握手后才发 tools/list）
    var mk: Buf = buf_new(65536);
    defer { buf_free(&mk); }
    mcp_fixture_marker(&mk);
    const view: &[byte] = mk.ptr[0: mk.len];
    const at_init: isize = find_sub(view, &"initialize"[0: 10], 0);
    const at_note: isize = find_sub(view, &"notifications/initialized"[0: 25], 0);
    const at_list: isize = find_sub(view, &"tools/list"[0: 10], 0);
    if at_init < 0 {
        ty_fail(tag, "server 没收到 initialize", &ok);
    }
    if at_note < 0 {
        ty_fail(tag, "server 没收到 notifications/initialized", &ok);
    }
    if at_list < 0 {
        ty_fail(tag, "server 没收到 tools/list", &ok);
    }
    if at_init >= 0 && at_list >= 0 && at_init > at_list {
        ty_fail(tag, "tools/list 发在 initialize 之前", &ok);
    }
    if at_note >= 0 && at_list >= 0 && at_note > at_list {
        ty_fail(tag, "tools/list 发在 notifications/initialized 之前", &ok);
    }
    // clientInfo.name 必须是 uya-agent（服务端据此区分客户端）
    if find_sub(view, &"\"name\":\"uya-agent\""[0: 18], 0) < 0 {
        ty_fail(tag, "initialize 里没有 clientInfo.name=uya-agent", &ok);
    }
    // 两个工具的公开名：一个干净、一个带 hash
    var want_clean: Buf = buf_new(64);
    defer { buf_free(&want_clean); }
    var want_dotted: Buf = buf_new(128);
    defer { buf_free(&want_dotted); }
    mcp_tool_public_name("fixture" as &const byte, 7, "echo" as &const byte, 4, &want_clean);
    mcp_tool_public_name("fixture" as &const byte, 7, "echo.text" as &const byte, 9, &want_dotted);
    if !mcp_tool_registered(want_clean.ptr as &const byte, want_clean.len) {
        ty_fail(tag, "tools/list 里的 echo 没登记成 mcp__fixture__echo", &ok);
    }
    if !mcp_tool_registered(want_dotted.ptr as &const byte, want_dotted.len) {
        ty_fail(tag, "tools/list 里的 echo.text 没登记成归一化名", &ok);
    }
    // schema 必须带上 server 给的 inputSchema（不是空壳）
    if mcp_tool_schema_has("fixture" as &const byte, 7, "required" as &const byte) < 0 {
        ty_fail(tag, "echo 的 inputSchema 里没有 required 字段（schema 没透传）", &ok);
    }
    mcprun_stop_all();
    mcp_round_ok(tag, &ok);
    return ok;
}

// 公开名是否已登记（腿 2 用它；`mcp_tool_at` 是门面给渲染层用的那一个）
fn mcp_tool_registered(name: &const byte, n: usize) bool {
    var i: usize = 0;
    while i < mcp_tool_count() && i < MCP_TOOLS_MAX {
        const t: &const McpTool = mcp_tool_at(i);
        if t != null as &const McpTool && t.public.len == n
            && bufx_mem_eq(t.public.ptr as &const byte, name, n) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 某个 server 的工具 schema 片段里有没有 needle（返回下标；-1 = 没有）
fn mcp_tool_schema_has(server: &const byte, sn: usize, needle: &const byte) isize {
    var i: usize = 0;
    while i < mcp_tool_count() && i < MCP_TOOLS_MAX {
        const t: &const McpTool = mcp_tool_at(i);
        if t != null as &const McpTool && t.server.len == sn
            && bufx_mem_eq(t.server.ptr as &const byte, server, sn) {
            const hit: isize = find_sub(t.schema.ptr[0: t.schema.len], needle[0: bufx_cstr_len(needle)], 0);
            if hit >= 0 {
                return hit;
            }
        }
        i = i + 1;
    }
    return -1;
}

// ============================================================
// 腿 3：派发（`mcp__…` → tools/call）与结果投影
// ============================================================
//
// 三个判据都读 marker 与结果文本这两件**事实**：
//   ① 上线发的是 **raw** 名（`echo`），不是公开名（`mcp__fixture__echo`）；
//   ② 工具结果文本是 server 回的那段（`echo: hello`）；
//   ③ `arguments` 里的字符串**原样**到达 server（没有被双重转义）。
fn mcp_call_round(tag: &const byte) bool {
    var ok: bool = true;
    var wsbuf: Buf = buf_new(256);
    defer { buf_free(&wsbuf); }
    var srvbuf: Buf = buf_new(256);
    defer { buf_free(&srvbuf); }
    var empty: Buf = buf_empty();
    defer { buf_free(&empty); }
    mcp_fixture_dir(&wsbuf);
    mcp_fixture_srv(&srvbuf);
    if !mcp_fixture_server() {
        ty_fail(tag, "夹具 server 写不出来", &ok);
        return ok;
    }
    var cli: Buf = buf_new(256);
    defer { buf_free(&cli); }
    if !buf_valid(&cli) || !buf_append_cstr(&cli, "fixture=/bin/sh " as &const byte)
        || !buf_append(&cli, srvbuf.ptr, srvbuf.len) {
        ty_fail(tag, "out of memory", &ok);
        return ok;
    }
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, &cli);
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.workspace = buf_new(256);
    mcp_fixture_dir(&cfg.workspace);
    cfg.mcp_off = false;
    // 公开名（归一路径也要被走到：用带点的那个工具）
    var pub: Buf = buf_new(128);
    defer { buf_free(&pub); }
    mcp_tool_public_name("fixture" as &const byte, 7, "echo.text" as &const byte, 9, &pub);
    var args: Buf = buf_new(128);
    defer { buf_free(&args); }
    _ = buf_append_cstr(&args, "{\"text\":\"hello\"}" as &const byte);
    var out: Buf = buf_new(4096);
    defer { buf_free(&out); }
    if !mcp_tool_try(&cfg, &pub, &args, &out) {
        ty_fail(tag, "mcp_tool_try 没认领 mcp__ 工具", &ok);
    }
    // ② 结果文本
    if !bufx_contains(&out, "echo: hello" as &const byte) {
        ty_fail(tag, "工具结果里没有 echo: hello（结果投影不对）", &ok);
    }
    // ① marker 里必须有 `CALLED echo.text`（raw 名），且**不能**出现公开名
    var mk: Buf = buf_new(65536);
    defer { buf_free(&mk); }
    mcp_fixture_marker(&mk);
    if !bufx_contains(&mk, "CALLED echo.text" as &const byte) {
        ty_fail(tag, "server 没收到 raw 名 echo.text（公开名被当成 raw 发了？）", &ok);
    }
    // 公开名**不许**出现在上线内容里（raw 名才是线上标识）。
    // 用 find_sub 而不是 bufx_contains：后者收的是 C 串（内部量到 NUL），
    // 而 pub 这个 Buf 没有 NUL 结尾 —— 拿它当 C 串会读越界。
    if buf_valid(&pub) && find_sub(mk.ptr[0: mk.len], pub.ptr[0: pub.len], 0) >= 0 {
        ty_fail(tag, "上线出现了公开名（raw 名必须只在线上发）", &ok);
    }
    // ③ arguments 原样到达（marker 里能看到 `"text":"hello"` 这对键值）
    if !bufx_contains(&mk, "\"text\":\"hello\"" as &const byte) {
        ty_fail(tag, "arguments 没有原样到达 server（被双重转义了？）", &ok);
    }
    // 名字不属于我们时**不许**认领（调用方要继续走自己的 else 链）
    var other: Buf = buf_new(32);
    defer { buf_free(&other); }
    _ = buf_append_cstr(&other, "read" as &const byte);
    var out2: Buf = buf_new(64);
    defer { buf_free(&out2); }
    if mcp_tool_try(&cfg, &other, &args, &out2) {
        ty_fail(tag, "非 mcp__ 工具被 mcp_tool_try 认领了（会吞掉内置工具）", &ok);
    }
    mcprun_stop_all();
    mcp_round_ok(tag, &ok);
    return ok;
}

// ============================================================
// 腿 4：降级（不配 / server 崩 / 不认的方法 / 不留孤儿）
// ============================================================

// 现在还有几个活着的 MCP 子进程（「不留孤儿」的判据）
fn mcp_live_count() usize {
    var n: usize = 0;
    var i: usize = 0;
    while i < MCP_MAX_PROCS {
        if mcprun_alive(i) {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// 腿 4：降级路径 —— 不配 server / 命令不存在 / 不认的方法（钩子）放行 /
// read-only 不跑钩子且工具被拒 / 收口不留孤儿 / 崩掉的 server。
// 判据全是「事实」：计数、诊断文本、活着的子进程数。
fn mcp_degrade_round(tag: &const byte) bool {
    var ok: bool = true;
    var wsbuf: Buf = buf_new(256);
    defer { buf_free(&wsbuf); }
    var srvbuf: Buf = buf_new(256);
    defer { buf_free(&srvbuf); }
    var empty: Buf = buf_empty();
    defer { buf_free(&empty); }
    mcp_fixture_dir(&wsbuf);
    mcp_fixture_srv(&srvbuf);
    // ① 不配任何 server：server/tool 计数都是 0，且 meta 工具如实报「没配」
    var none: Buf = buf_empty();
    defer { buf_free(&none); }
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, &none);
    if mcp_server_count() != 0 || mcp_tool_count() != 0 {
        ty_fail(tag, "没配 server 时计数不为 0", &ok);
    }
    // ② 命令不存在：server 起不来，但**从工具侧看是错误文本，不是崩溃**
    var bad: Buf = buf_new(128);
    defer { buf_free(&bad); }
    _ = buf_append_cstr(&bad, "broken=/nonexistent/mcp-server-xyz" as &const byte);
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, &bad);
    if mcp_tool_count() != 0 {
        ty_fail(tag, "起不来的 server 却登记出了工具", &ok);
    }
    if !bufx_contains(mcp_diag_text(), "broken:" as &const byte) {
        ty_fail(tag, "诊断里没有 broken 那条（失败必须留话）", &ok);
    }
    // ③ 真实 server + 不认的方法（钩子）：必须**放行**（返回 0），不能当故障
    if !mcp_fixture_server() {
        ty_fail(tag, "夹具 server 写不出来", &ok);
        return ok;
    }
    var cli: Buf = buf_new(256);
    defer { buf_free(&cli); }
    if buf_valid(&cli) {
        _ = buf_append_cstr(&cli, "fixture=/bin/sh " as &const byte);
        _ = buf_append(&cli, srvbuf.ptr, srvbuf.len);
    }
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, &cli);
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.workspace = buf_new(256);
    mcp_fixture_dir(&cfg.workspace);
    var params: Buf = buf_new(128);
    defer { buf_free(&params); }
    // 行宽豁免：错误文案/诊断行是**单条不可断的字面量**（Uya 没有相邻字面量拼接）
    _ = buf_append_cstr(&params, "{\"name\":\"echo\",\"arguments\":{}}" as &const byte);
    var dec: Buf = buf_new(512);
    defer { buf_free(&dec); }
    const hr: i32 = mcp_hook_run(&cfg, "tools/pre-execute" as &const byte, &params, &dec);
    if hr != 0 {
        ty_fail(tag, "server 不认的钩子没有放行（-32601 必须当放行）", &ok);
    }
    // ④ read-only 下钩子**一律不跑**（fail closed：钩子能改参数，是权限模型的一部分）
    const keep: u8 = perm_get();
    perm_set(PERM_READ_ONLY);
    const hr2: i32 = mcp_hook_run(&cfg, "tools/pre-execute" as &const byte, &params, &dec);
    perm_set(keep);
    if hr2 != 0 {
        ty_fail(tag, "read-only 下钩子仍然跑了（没有 fail closed）", &ok);
    }
    // ⑤ read-only 下 MCP 工具被拒（结果文本，不是崩溃）
    var pub: Buf = buf_new(128);
    defer { buf_free(&pub); }
    mcp_tool_public_name("fixture" as &const byte, 7, "echo" as &const byte, 4, &pub);
    var out: Buf = buf_new(2048);
    defer { buf_free(&out); }
    perm_set(PERM_READ_ONLY);
    const claimed: bool = mcp_tool_try(&cfg, &pub, &params, &out);
    perm_set(keep);
    if !claimed {
        ty_fail(tag, "read-only 下 mcp__ 工具没被认领（应回错误文本）", &ok);
    }
    if !bufx_contains(&out, "disabled in read-only mode" as &const byte) {
        ty_fail(tag, "read-only 的拒绝文案不对", &ok);
    }
    // ⑥ 不留孤儿：收干净之后活着的子进程必须是 0
    mcprun_stop_all();
    if mcp_live_count() != 0 {
        ty_fail(tag, "收口之后还有活着的 MCP 子进程（留孤儿了）", &ok);
    }
    // ⑦ 崩溃的 server（initialize 阶段直接退 7）：工具数为 0、不留孤儿
    mcp_crash_check(tag, &wsbuf, &empty, &ok);
    // 恢复现场：把配置清空，免得后面的腿看到这个 server
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, &none);
    mcp_round_ok(tag, &ok);
    return ok;
}

// 腿 4 的后半：崩溃的 server（夹具读 `CRASH=1` 就在 initialize 时退出）——
// 工具数必须是 0，且收口之后不留孤儿。
//
// ⚠ `CRASH=1` 只能作为该 server 的 **env token** 传：mcprun 只把「安全白名单 +
// `Config.env`」交给子进程（MCP server 是第三方进程，不该看到我们的 DSH_*/凭据），
// 所以给父进程 `setenv` 设的变量传不到它。
fn mcp_crash_check(tag: &const byte, wsbuf: &const Buf, empty: &const Buf,
    ok: &bool) void {
    var crash: Buf = buf_new(256);
    defer { buf_free(&crash); }
    var srvbuf: Buf = buf_new(256);
    defer { buf_free(&srvbuf); }
    mcp_fixture_srv(&srvbuf);
    if !buf_valid(&crash) {
        ty_fail(tag, "out of memory", ok);
        return;
    }
    _ = buf_append_cstr(&crash, "fixture=/bin/sh " as &const byte);
    _ = buf_append(&crash, srvbuf.ptr, srvbuf.len);
    _ = buf_append_cstr(&crash, " CRASH=1" as &const byte);
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, &crash);
    if mcp_tool_count() != 0 {
        ty_fail(tag, "崩掉的 server 却登记出了工具", ok);
    }
    mcprun_stop_all();
    if mcp_live_count() != 0 {
        ty_fail(tag, "崩掉的 server 收口没干净", ok);
    }
}



// 腿 5 的一段：`mcp.json`（生态通用 `mcpServers` 形状）必须认那一层，
// 且 server 名是**里面的键**而不是 `mcpServers` 本身。
// 这条判据是补上的 —— 当初 `mcpServers` 的键搜索没带引号，把那一层当成了 server 名。
fn mcp_cfg_json_check(tag: &const byte, wsbuf: &const Buf, empty: &const Buf,
    serv: &const byte, slen: usize, ok: &bool) void {
    var jdir: Buf = buf_new(512);
    defer { buf_free(&jdir); }
    var jpath: Buf = buf_new(512);
    defer { buf_free(&jpath); }
    if !buf_valid(&jdir) || !buf_valid(&jpath) {
        ty_fail(tag, "out of memory", ok);
        return;
    }
    mcp_fixture_dir(&jdir);
    _ = buf_append_cstr(&jdir, "/.dsh" as &const byte);
    var jdz: Buf = buf_new(512);
    defer { buf_free(&jdz); }
    _ = buf_append(&jdz, jdir.ptr, jdir.len);
    _ = buf_append_byte(&jdz, 0);
    _ = sys_mkdir(jdz.ptr as *const byte, 493 as u32) catch {};
    _ = buf_append(&jpath, jdir.ptr, jdir.len);
    _ = buf_append_cstr(&jpath, "/mcp.json" as &const byte);
    var content: Buf = buf_new(1024);
    defer { buf_free(&content); }
    _ = buf_append_cstr(&content, "{\"mcpServers\":{\"fromjson\":{\"command\":\"/bin/sh\",\"args\":[\"" as &const byte);
    _ = buf_append(&content, serv, slen);
    _ = buf_append_cstr(&content, "\"]}}}" as &const byte);
    _ = buf_append_byte(&content, 0);
    // ⚠ write_text_file 收的是 **C 串**（内部 bufx_cstr_len 量长度）—— 传没 NUL 的 Buf
    // 会写到「路径 + 后面的垃圾」上，**返回值还是 true**（现场症状：写「成功」但读回来是空）。
    var jz3: Buf = buf_new(512);
    defer { buf_free(&jz3); }
    _ = buf_append(&jz3, jpath.ptr, jpath.len);
    _ = buf_append_byte(&jz3, 0);
    if !write_text_file(jz3.ptr as &const byte, content.ptr as &const byte) {
        ty_fail(tag, "mcp.json 写不出来", ok);
        return;
    }
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, empty);
    if mcp_server_count() != 1 {
        ty_fail(tag, "mcp.json 的 server 数不是 1", ok);
    }
    if mcp_set_find(&g_mcp.set, "fromjson" as &const byte, 8) < 0 {
        ty_fail(tag, "mcp.json 里的 server 名不是 fromjson（mcpServers 那层没认出来？）", ok);
    }
    if mcp_set_find(&g_mcp.set, "mcpServers" as &const byte, 10) >= 0 {
        ty_fail(tag, "把 mcpServers 这个名字当成 server 登记了", ok);
    }
}

// 腿 5 的一段：`cordis.yml` 里 `@deepseek-ai/dsh-mcp-client` 行 → 一条 server；
// 同文件的**进程内**插件行必须进 unsupported（如实报告「跑不了」，而不是假装能跑）。
fn mcp_cfg_cordis_check(tag: &const byte, wsbuf: &const Buf, empty: &const Buf,
    serv: &const byte, slen: usize, ok: &bool) void {
    var cdir: Buf = buf_new(512);
    defer { buf_free(&cdir); }
    var cpath: Buf = buf_new(512);
    defer { buf_free(&cpath); }
    if !buf_valid(&cdir) || !buf_valid(&cpath) {
        ty_fail(tag, "out of memory", ok);
        return;
    }
    mcp_fixture_dir(&cdir);
    _ = buf_append_cstr(&cdir, "/.dsh" as &const byte);
    _ = buf_append(&cpath, cdir.ptr, cdir.len);
    _ = buf_append_cstr(&cpath, "/cordis.yml" as &const byte);
    var cy: Buf = buf_new(2048);
    defer { buf_free(&cy); }
    _ = buf_append_cstr(&cy, "- id: mcpfs\n  name: '@deepseek-ai/dsh-mcp-client'\n  config:\n    transport: stdio\n    serverName: fromcordis\n    command: /bin/sh\n    args: [\"" as &const byte);
    _ = buf_append(&cy, serv, slen);
    _ = buf_append_cstr(&cy, "\"]\n- id: sometool\n  name: '@deepseek-ai/dsh-tool-todo'\n  config:\n    allowParallelInProgress: true\n" as &const byte);
    _ = buf_append_byte(&cy, 0);
    var cyz: Buf = buf_new(512);
    defer { buf_free(&cyz); }
    _ = buf_append(&cyz, cpath.ptr, cpath.len);
    _ = buf_append_byte(&cyz, 0);
    if !write_text_file(cyz.ptr as &const byte, cy.ptr as &const byte) {
        ty_fail(tag, "cordis.yml 写不出来", ok);
        return;
    }
    // 把 mcp.json 挪走，免得两个来源混在一起看不清哪条生效
    var jz: Buf = buf_new(512);
    defer { buf_free(&jz); }
    mcp_fixture_dir(&jz);
    _ = buf_append_cstr(&jz, "/.dsh/mcp.json" as &const byte);
    _ = buf_append_byte(&jz, 0);
    _ = sys_unlink(jz.ptr as &const byte) catch {};
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, empty);
    if mcp_set_find(&g_mcp.set, "fromcordis" as &const byte, 10) < 0 {
        ty_fail(tag, "cordis.yml 的 dsh-mcp-client 行没映射成 server", ok);
    }
    if !bufx_contains(mcp_unsupported_text(), "dsh-tool-todo" as &const byte) {
        ty_fail(tag, "进程内 cordis 插件行没进 unsupported", ok);
    }
}

// 腿 5 的一段：CLI 的 `K=V` 归 env、`--opt=value` 归 args
// （判据是**名字合法性**，不是「有没有 `=`」—— 后者会把 `--opt=value` 也当环境变量）。
fn mcp_cfg_cli_check(tag: &const byte, ok: &bool) void {
    mcp_set_init(&g_mcp.set);
    var cli: Buf = buf_new(512);
    defer { buf_free(&cli); }
    if !buf_valid(&cli) {
        ty_fail(tag, "out of memory", ok);
        return;
    }
    _ = buf_append_cstr(&cli, "envtest=/bin/sh --opt=value FOO=bar" as &const byte);
    mcp_cfg_load_cli(&g_mcp.set, &cli);
    const ei: isize = mcp_set_find(&g_mcp.set, "envtest" as &const byte, 7);
    if ei < 0 || ei >= (MCP_MAX_SERVERS as isize) {
        ty_fail(tag, "CLI 那条没登记", ok);
        return;
    }
    const eidx: usize = ei as usize;
    if eidx >= MCP_MAX_SERVERS {
        ty_fail(tag, "CLI server 下标越界", ok);
        return;
    }
    const it: &const McpServer = &g_mcp.set.items[eidx];
    if !bufx_contains(&it.env, "FOO=bar" as &const byte) {
        ty_fail(tag, "CLI 的 K=V 没归到 env", ok);
    }
    if !bufx_contains(&it.args, "--opt=value" as &const byte) {
        ty_fail(tag, "CLI 的 --opt=value 被误当成 env（应归 args）", ok);
    }
}

// ============================================================
// 腿 5：配置来源与解析（**纯函数 + 现场落盘**，不连 server）
// ============================================================
//
// 为什么单独一条腿：上面四条都走 CLI 的 `name=command` 这一种来源，
// 于是 `settings.yaml` / `mcp.json` / `cordis.yml` 三条路**一条都没被覆盖过** ——
// 实际就是这么漏掉一个 bug 的：`mcp.json` 的 `mcpServers` 键搜索**没带引号**，
// 命中了值位置上的同名串之后形状判不过、整段退化成「顶层 '{'」，
// 结果把 `mcpServers` 这个名字当成一个 server 登记了进去（`--list-plugins` 里
// 会看到一个叫 `mcpServers` 的 server）。这条腿钉住三种来源各自解析对。
fn mcp_cfg_round(tag: &const byte) bool {
    var ok: bool = true;
    var wsbuf: Buf = buf_new(256);
    defer { buf_free(&wsbuf); }
    var empty: Buf = buf_empty();
    defer { buf_free(&empty); }
    mcp_fixture_dir(&wsbuf);
    if !mcp_fixture_server() {
        ty_fail(tag, "夹具 server 写不出来", &ok);
        return ok;
    }
    var srvbuf: Buf = buf_new(256);
    defer { buf_free(&srvbuf); }
    mcp_fixture_srv(&srvbuf);
    const serv: &const byte = srvbuf.ptr as &const byte;
    const slen: usize = srvbuf.len;

    mcp_cfg_json_check(tag, &wsbuf, &empty, serv, slen, &ok);
    mcp_cfg_cordis_check(tag, &wsbuf, &empty, serv, slen, &ok);
    mcp_cfg_cli_check(tag, &ok);
    // 清掉现场（后面的腿/整轮 selftest 不该看到这些）
    mcp_reload(wsbuf.ptr[0: wsbuf.len], empty.ptr[0: empty.len], false, &empty);
    mcprun_stop_all();
    mcp_round_ok(tag, &ok);
    return ok;
}

// ============================================================
// 五条腿的入口（`--selftest` 里按 `UYA_SELFTEST_MCP_ONLY` 单跑）
// ============================================================
export fn mcp_selftest_rounds() bool {
    const a: bool = mcp_public_name_round("mcp-name" as &const byte);
    const b: bool = mcp_handshake_round("mcp-handshake" as &const byte);
    const c: bool = mcp_call_round("mcp-call" as &const byte);
    const d: bool = mcp_degrade_round("mcp-degrade" as &const byte);
    const e: bool = mcp_cfg_round("mcp-cfg" as &const byte);
    // 收尾兜底：任何一条腿中途返回都要把子进程收干净（本仓自测的硬纪律）
    mcprun_stop_all();
    // 夹具目录也清掉（与 st_pm 收它的 /tmp 根同一条口径：自测不许留垃圾）
    var dir: Buf = buf_new(256);
    defer { buf_free(&dir); }
    if buf_valid(&dir) {
        mcp_fixture_dir(&dir);
        _ = pm_rm_rf(dir.ptr as &const byte, dir.len);
    }
    if a && b && c && d && e {
        out_err("SELFTEST MCP PASS\n");
        return true;
    }
    out_err("SELFTEST MCP FAIL\n");
    return false;
}
