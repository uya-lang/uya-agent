// src/selftest/st_vision.uya — P84：收图能力位的来源链（默认支持 + 三档来源）自测
//
// 本文件：`vs_round`（一轮跑完下面全部腿）与它的夹具/小工具 ——
//   `vs_set_home` / `vs_fixture_write`（一份只含关心几节的 settings.yaml）、
//   `vs_case`（给 (provider, model) 跑一次 `agent_vision_settle` 再比期望）。
// 不变量：① 判据看**来源码 + 值**两个字段（`src_input_image` / `input_image`）——
//   只看值分不出「声明了支持」与「没声明所以默认支持」，而那正是本轮的核心；
//   ② 夹具与 `st_tasks_ws.uya` 的 `MX_HOME` / `CW_HOME` **分开**（往同一份里加模型会把
//   那两轮的断言语义搅在一起，红了也分不清是谁的）；③ 本轮**不联网、不起进程**（纯函数
//   + 假目录），所以整轮 `--selftest` 里也跑（代价几毫秒）。
// 依赖：见锚点 selftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：`vs_*`（vision settle）。
//
// 三条口径（实现见 ag_workspace_model.uya 的 `agent_vision_settle`，这里是它的判据）：
//   * **默认支持**：出厂 true，只有明确的「不支持」才关；
//   * **显式钉住**：env（2）/ cli（3）给过的值，切模型也不动；
//   * **信息不足一律当支持**：条目没写 `input:` / 目录里没这条 / 设置读不到 ——
//     一律沿用现状（`src_input_image` 退回 0），**不许**静默关掉。

// 这一轮的 DSH home（与 MX_HOME / CW_HOME 分开，见文件头不变量 ②）
const VS_HOME: &const byte = "build/selftest_p84_home" as &const byte;

// 把 DSH home 指到这一轮的 fixture（口径与 mx_set_home 同：可变 Buf 的切片）
fn vs_set_home() void {
    var hb: Buf = buf_new(128);
    defer { buf_free(&hb); }
    _ = buf_append_cstr(&hb, VS_HOME);
    _ = agent_set_dsh_home(hb.ptr[0: hb.len]);
}

// 造这一轮的 settings.yaml。三条腿各要一个模型，**顺序刻意排成「先写不支持、再写支持」**
// 之外的两种写法都在里面：
//   alpha/v-img    `input: [ text, image ]` ⇒ 明确声明**支持**（MX_IMG_YES）
//   alpha/v-txt    `input: [ text ]`        ⇒ 明确声明**不支持**（MX_IMG_NO）—— 关键腿
//   alpha/v-none   **没写** `input:`         ⇒ 没声明（MX_IMG_UNSET）—— 沿用腿
//   beta/v-img     同名跨提供方：beta 这份**没写** input（试「按同名别家回退」的错误实现）
fn vs_fixture_write() bool {
    _ = sess_mkdir_p(VS_HOME);
    var p: Buf = buf_new(256);
    defer { buf_free(&p); }
    _ = buf_append_cstr(&p, VS_HOME);
    _ = buf_append_cstr_z(&p, "/settings.yaml");
    var b: Buf = buf_new(2048);
    defer { buf_free(&b); }
    // 行宽豁免：夹具就是 settings.yaml 的**原文**（断行会把这几个条目切碎）
    _ = buf_append_cstr(&b, "llm-pi-ai:\n  providers:\n    {\n      alpha:\n        {\n");
    _ = buf_append_cstr(&b, "          api: openai-responses,\n");
    _ = buf_append_cstr(&b, "          baseURL: https://alpha.example/v1,\n");
    _ = buf_append_cstr(&b, "          models:\n            [\n");
    _ = buf_append_cstr(&b, "              { id: v-img, input: [ text, image ] },\n");
    _ = buf_append_cstr(&b, "              { id: v-txt, input: [ text ] },\n");
    _ = buf_append_cstr(&b, "              { id: v-none }\n");
    _ = buf_append_cstr(&b, "            ]\n        },\n");
    _ = buf_append_cstr(&b, "      beta:\n        {\n");
    _ = buf_append_cstr(&b, "          api: openai-completions,\n");
    _ = buf_append_cstr(&b, "          models:\n            [ { id: v-img } ]\n");
    _ = buf_append_cstr(&b, "        }\n    }\n");
    return write_text_file(p.ptr as &const byte, b.ptr as &const byte);
}

// 一轮：给 (provider, model) 跑一次定稿，再比「值 + 来源码」两个字段。
// 期望集写在一张小表里（每格一条判据，红了直接报出是哪一格）。
fn vs_case(tag: &const byte, cfg: &Config, prov: &const byte,
           model: &const byte, want_img: bool, want_src: u8, ok: &bool) void {
    buf_free(&cfg.provider);
    cfg.provider = buf_from_cstr(prov);
    cfg.provider_set = true;
    buf_free(&cfg.model);
    cfg.model = buf_from_cstr(model);
    agent_vision_settle(cfg);
    if cfg.input_image != want_img || cfg.src_input_image != want_src {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: ");
        out_err(prov);
        out_err("/");
        out_err(model);
        out_err(" 的收图位应当是 ");
        if want_img {
            out_err("on");
        } else {
            out_err("off");
        }
        out_err(" (src ");
        out_err_dec(want_src as usize);
        out_err(")，实际是 ");
        if cfg.input_image {
            out_err("on");
        } else {
            out_err("off");
        }
        out_err(" (src ");
        out_err_dec(cfg.src_input_image as usize);
        out_err(")\n");
        *ok = false;
    }
}

// 纯函数腿：`vision_flag_parse` 认得的八个词 + 非法值（先跑，红了就不用往下跑）
fn vs_parse(tag: &const byte, ok: &bool) void {
    if vision_flag_parse("1" as &const byte, 1) != 1
        || vision_flag_parse("on" as &const byte, 2) != 1
        || vision_flag_parse("true" as &const byte, 4) != 1
        || vision_flag_parse("yes" as &const byte, 3) != 1 {
        ty_fail(tag, "为真的四个词没认出来", ok);
    }
    if vision_flag_parse("0" as &const byte, 1) != 0
        || vision_flag_parse("off" as &const byte, 3) != 0
        || vision_flag_parse("false" as &const byte, 5) != 0
        || vision_flag_parse("no" as &const byte, 2) != 0 {
        ty_fail(tag, "为假的四个词没认出来", ok);
    }
    // 认不出的一律 -1（**绝不**当开 —— 这一位的默认已经是开，写错了再当开就看不出来）
    if vision_flag_parse("maybe" as &const byte, 5) != -1
        || vision_flag_parse("2" as &const byte, 1) != -1
        || vision_flag_parse("" as &const byte, 0) != -1
        || vision_flag_parse("TRUE" as &const byte, 4) != -1 {
        ty_fail(tag, "非法值该判 -1（不许静默当开）", ok);
    }
}

// 目录腿：三态解析 + 定稿的「默认支持 / 显式钉住 / 不确定性沿用」三条口径
fn vs_settle(tag: &const byte, ok: &bool) void {
    agent_models_reset();
    if !vs_fixture_write() {
        ty_fail(tag, "造 settings.yaml fixture 失败", ok);
        return;
    }
    vs_set_home();
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    // ① 出厂默认就是**开**（这一条是「默认支持」的直接判据：env 路线什么都不用配）
    if !cfg.input_image || cfg.src_input_image != 0 {
        ty_fail(tag, "出厂默认应当是「收图 + src 0」（默认支持）", ok);
    }
    agent_models_ensure(&cfg);
    // ② 明确声明支持 ⇒ on / src 1
    vs_case(tag, &cfg, "alpha" as &const byte, "v-img" as &const byte, true, 1, ok);
    // ③ **明确声明不支持** ⇒ off / src 1（本轮修掉的那个洞：以前只 OR 真、不清零）
    vs_case(tag, &cfg, "alpha" as &const byte, "v-txt" as &const byte, false, 1, ok);
    // ④ 没写 `input:` ⇒ **沿用**（信息不足当支持），src 不动 —— 不许静默关掉
    cfg.input_image = true;
    cfg.src_input_image = 0;
    vs_case(tag, &cfg, "alpha" as &const byte, "v-none" as &const byte, true, 0, ok);
    // ⑤ 同名跨提供方：beta/v-img **没写** input ⇒ 沿用，不许拿 alpha 那条来填
    vs_case(tag, &cfg, "beta" as &const byte, "v-img" as &const byte, true, 0, ok);
    // ⑥ 目录里根本没有这个名字 ⇒ 沿用
    vs_case(tag, &cfg, "alpha" as &const byte, "v-ghost" as &const byte, true, 0, ok);
    // ⑦ 切模型那条路：声明不支持的那个要**真的关掉**（③ 已经钉了值，这里钉「上一次是开」）
    cfg.input_image = true;
    cfg.src_input_image = 1;
    vs_case(tag, &cfg, "alpha" as &const byte, "v-txt" as &const byte, false, 1, ok);
    // ⑧ 显式钉住：src 2（env）值为假 + 目录说支持 ⇒ 仍假；src 3（cli）值为真 + 目录说不支持 ⇒ 仍真
    cfg.input_image = false;
    cfg.src_input_image = 2;
    vs_case(tag, &cfg, "alpha" as &const byte, "v-img" as &const byte, false, 2, ok);
    cfg.input_image = true;
    cfg.src_input_image = 3;
    vs_case(tag, &cfg, "alpha" as &const byte, "v-txt" as &const byte, true, 3, ok);
    // ⑨ `--no-dsh-config`：设置没读 ⇒ 一行都不许动（默认支持，src 留 0）
    var cfg2: Config = cfg_default();
    defer { cfg_free(&cfg2); }
    cfg2.no_dsh_config = true;
    cfg2.model = buf_from_cstr("v-txt");
    cfg2.provider = buf_from_cstr("alpha");
    agent_vision_settle(&cfg2);
    if !cfg2.input_image || cfg2.src_input_image != 0 {
        ty_fail(tag, "--no-dsh-config 时不该按目录关掉（设置根本没读）", ok);
    }
    // ⑩ **切模型那条路**（`agent_model_apply` —— 人敲 `/model` 与 `--model` 都走它）：
    //    从「声明支持」切到「声明不支持」必须真的关掉。⚠ 这一腿**必须走真入口**，
    //    不能只调 `agent_vision_settle` —— 实现里调用点漏了 settle 时，只调函数的那些腿
    //    照样全绿（实测：把 agent_model_apply 里那一次 settle 删掉，前面九条一条不红）。
    //    ⚠ 起点必须先落在 v-img 上：⑧ 那两条腿把 cfg 留在 v-txt 上，直接 apply v-txt
    //    会走「幂等」那一支（返回 1、什么都不做），这一腿就成了假绿。
    //    ⚠ 还要先把 ⑧ 留下的**显式钉子**清掉（src = 3）：带着钉子切模型本来就不该被动，
    //    那验的是另一条口径（显式优先），验不到「切模型会重新定稿」这一半。
    cfg.src_input_image = 0;
    cfg.input_image = true;
    const sw0: i32 = agent_model_apply(cfg, "alpha" as &const byte, 5,
        "v-img" as &const byte, 5, "human" as &const byte, false);
    if sw0 != 0 || !cfg.input_image {
        ty_fail(tag, "切到 alpha/v-img 应当返回 0 并把收图打开", ok);
    }
    const sw: i32 = agent_model_apply(cfg, "alpha" as &const byte, 5,
        "v-txt" as &const byte, 5, "human" as &const byte, false);
    if sw != 0 {
        ty_fail(tag, "切到 alpha/v-txt 应当返回 0", ok);
    }
    if cfg.input_image || cfg.src_input_image != 1 {
        ty_fail(tag, "切到「声明不支持」的模型之后收图位没关（调用点漏了 settle？）", ok);
    }
    // ⑪ 反向：从「声明不支持」切回「声明支持」要能打开
    const sw2: i32 = agent_model_apply(cfg, "alpha" as &const byte, 5,
        "v-img" as &const byte, 5, "human" as &const byte, false);
    if sw2 != 0 {
        ty_fail(tag, "切回 alpha/v-img 应当返回 0", ok);
    }
    if !cfg.input_image || cfg.src_input_image != 1 {
        ty_fail(tag, "切回「声明支持」的模型之后收图位没打开", ok);
    }
}

// P84：收图能力位（`vision_flag_parse` + `agent_vision_settle` 的全部腿）
fn vs_round(tag: &const byte) bool {
    var ok: bool = true;
    vs_parse(tag, &ok);
    vs_settle(tag, &ok);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（默认支持；目录声明支持/不支持；没声明与目录外一律沿用（含 agent_model_apply 真入口）；");
        out_err("env/cli 钉住；--no-dsh-config 不动）\n");
    }
    return ok;
}
