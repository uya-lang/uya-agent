// src/selftest/st_dns.uya — P80 自测轮：DNS 解析器发现（resolv.conf 与
//   $UYA_AGENT_DNS）
//
// 本文件：`hc_resolv_scan` 的**纯扫描轮**（注释/关键字/畸形行/IPv6/CRLF 各项判据）与
//   `hc_dns_resolve` 的**真文件轮**（写一份临时 resolv.conf、把路径钉进去、看产品给出的
//   解析器串与来源）。
// 不变量：① 全部离线（不联网、不查 DNS、不需要证书）—— 判据喂的是文本与临时文件；
//   ② 每条断言都能**单独**红：防假绿对照三处已实测（见 DESIGN §16 踩坑 133）；
//   ③ 临时文件只在 `build/selftest_dns/` 下，轮末把解析器路径与覆盖值都清掉，
//   绝不碰真的 /etc/resolv.conf（那是别人机器上的配置，不是本轮的判据）。
// 依赖：见锚点 selftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）；
//   产品侧是 net/httpc 的 DNS 那一节（`HcResolvHit` / `hc_resolv_scan` / `hc_dns_*`）。
// 命名：沿用 selftest 轮的前缀 `dnr_`（DNS resolv）。

// 字面量一律声明成**裸指针常量**（`"x" as &const byte`）：形参是 `&const byte` 时在调用点
// 写 `&"x"[0: n]` 传的是切片描述符的地址，被调方拿到的是描述符头 8 字节（见踩坑 22 与
// st_tls_pin.uya 里的同一段注释）。
const DN_PATH: &const byte = "build/selftest_dns/resolv.conf" as &const byte;
const DN_DIR: &const byte = "build/selftest_dns" as &const byte;
const DN_LOOPBACK: &const byte = "127.0.0.53" as &const byte;
const DN_OVERRIDE: &const byte = "10.1.2.3:5353" as &const byte;
const DN_BAD: &const byte = "not-an-ip" as &const byte;
const DN_BAD_PORT: &const byte = "1.1.1.1:65536" as &const byte;

// 断言失败：打一行带轮名的诊断并置 ok = false（与 tpf_fail 同形）。
fn dnr_fail(what: &const byte, ok: &bool) void {
    out_err("selftest[dns-resolv] FAIL: ");
    out_err(what);
    out_err("\n");
    ok[0] = false;
}

// 把 buf 清空后写上 lit —— 每个判据一处，省得每次三行样板。
fn dnr_set(b: &Buf, lit: &const byte) void {
    buf_reset(b);
    _ = buf_append_cstr(b, lit);
}

// buf 的内容是否**逐字节**等于字面量 lit（不比 NUL，也不做任何折叠）。
fn dnr_eq(b: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if b.len != n {
        return false;
    }
    var i: usize = 0;
    while i < n {
        if b.ptr[i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 裸指针 + 长度是否逐字节等于 lit（`hc_resolv_path_ptr` 那一对没有切片可用）。
fn dnr_eq_ptr(p: &const byte, n: usize, lit: &const byte) bool {
    if n != bufx_cstr_len(lit) {
        return false;
    }
    var i: usize = 0;
    while i < n {
        if p[i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 命中的地址是否恰好是 a.b.c.d（`found` 为假一律 false）。
fn dnr_is(hit: &const HcResolvHit, a: byte, b: byte, c: byte, d: byte) bool {
    if !hit.found {
        return false;
    }
    return hit.ip[0] == a && hit.ip[1] == b && hit.ip[2] == c && hit.ip[3] == d;
}

// 往 b 里追加 n 行注释（每行 100 字节上下）——用来造「>512 字节的注释头」那种现场形状。
fn dnr_comment_block(b: &Buf, n: usize) void {
    var i: usize = 0;
    while i < n {
        _ = buf_append_cstr(b, "# generated by resolvconf: uplink DNS serv");
        _ = buf_append_cstr(b, "ers are managed elsewhere; see resolvectl");
        _ = buf_append_cstr(b, " status. (line ");
        _ = buf_append_u64(b, i as u64);
        _ = buf_append_cstr(b, ")\n");
        i = i + 1;
    }
}

// 扫描轮第一段：**现场形状**（判据①，这次的那个回归）+ 注释 / 关键字空白 / 行尾几条。
fn dnr_scan_round(tag: &const byte) bool {
    var ok: bool = true;
    var t: Buf = buf_new(4096);
    defer { buf_free(&t); }

    // ① 现场形状：十几行注释之后**末尾**才是 nameserver，偏移远在 512 字节之外。
    //    老实现只读前 512 字节 ⇒ 判成「文件里没有 nameserver」（见踩坑 133）。
    dnr_set(&t, "");
    dnr_comment_block(&t, 12);
    const ns_off: usize = t.len;
    _ = buf_append_cstr(&t, "nameserver 127.0.0.53\n");
    if ns_off <= 512 {
        dnr_fail("夹具没造出 >512 字节的偏移（这条腿就证不了那个回归）", &ok);
    }
    var h1: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if !dnr_is(&h1, 127, 0, 0, 53) {
        dnr_fail(">512 字节注释头之后的 nameserver 没被读到", &ok);
    }

    // ② 注释行里的 nameserver 不算（systemd 的文件里就有这种行）
    dnr_set(&t, "# nameserver 9.9.9.9\nnameserver 10.0.0.1\n");
    var h2: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if !dnr_is(&h2, 10, 0, 0, 1) {
        dnr_fail("注释行里的 nameserver 被当真了（或好行没读出来）", &ok);
    }

    // ③ 关键字后面必须真有空白：`nameserverX 9.9.9.9` 不是配置项
    dnr_set(&t, "nameserverX 9.9.9.9\n");
    var h3: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if h3.found {
        dnr_fail("`nameserverX 9.9.9.9` 被当成了 nameserver 行", &ok);
    }

    // ④ `;` 注释行、行首空白、tab 分隔都要认
    dnr_set(&t, "; nameserver 9.9.9.9\n\t nameserver \t198.51.100.7\n");
    var h4: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if !dnr_is(&h4, 198, 51, 100, 7) {
        dnr_fail("`;` 注释 / 行首空白 / tab 分隔的 nameserver 没被认", &ok);
    }

    // ⑤ 行尾注释：`nameserver 203.0.113.9 # 备用` 要取到 IP 为止
    dnr_set(&t, "nameserver 203.0.113.9 # 备用\n");
    var h5: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if !dnr_is(&h5, 203, 0, 113, 9) {
        dnr_fail("行尾带注释时没取到 IP（或把注释一起当成了参数）", &ok);
    }

    // ⑥ 光一个 `nameserver` 关键字、没有参数：不崩、不算找到
    dnr_set(&t, "nameserver\n");
    var h6: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if h6.found {
        dnr_fail("没有参数的 `nameserver` 行被当成了配置", &ok);
    }

    // ⑦ CRLF 行尾与**末行无换行**都要认
    dnr_set(&t, "nameserver 192.0.2.5\r\n");
    var h7: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if !dnr_is(&h7, 192, 0, 2, 5) {
        dnr_fail("CRLF 行尾的 nameserver 没被认", &ok);
    }
    dnr_set(&t, "# head\nnameserver 192.0.2.6");
    var h8: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if !dnr_is(&h8, 192, 0, 2, 6) {
        dnr_fail("末行没有换行结尾时 nameserver 丢了", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（扫描：>512 偏移/注释/关键字空白/CRLF）\n");
    }
    return ok;
}

// 扫描轮第二段：IPv6 记账 / 畸形行不中止 / 空与纯注释。
fn dnr_scan_round_b(tag: &const byte) bool {
    var ok: bool = true;
    var t: Buf = buf_new(1024);
    defer { buf_free(&t); }

    // ⑧ 先 IPv6 后 IPv4：取 IPv4（本模块只做 v4 传输），但要把见过的 v6 记下来
    dnr_set(&t, "nameserver 2001:db8::1\nnameserver 198.51.100.3\n");
    var h1: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if !dnr_is(&h1, 198, 51, 100, 3) || !h1.saw_v6 {
        dnr_fail("v6 之后那条 v4 没被取到（或 saw_v6 没记）", &ok);
    }

    // ⑨ 只有 IPv6：found 为假、saw_v6 为真（v6-only 的机器要能明确报出来）
    dnr_set(&t, "nameserver ::1\n");
    var h2: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if h2.found || !h2.saw_v6 {
        dnr_fail("只有 IPv6 的 nameserver 时判据不对（应当 saw_v6 且不 found）", &ok);
    }

    // ⑩ 畸形 IPv4 行跳过而**不中止**：后面那行好行必须还能被找到
    dnr_set(&t, "nameserver 999.1.1.1\n");
    _ = buf_append_cstr(&t, "nameserver 1.2.3\n");
    _ = buf_append_cstr(&t, "nameserver 203.0.113.7\n");
    var h3: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if !dnr_is(&h3, 203, 0, 113, 7) {
        dnr_fail("畸形行之后的最后一个好行丢了（扫描提前中止）", &ok);
    }

    // ⑪ 空文本 / 纯注释：两项都假，且不崩
    dnr_set(&t, "");
    var h4: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if h4.found || h4.saw_v6 {
        dnr_fail("空文本不该给出任何结论", &ok);
    }
    dnr_set(&t, "# 只有注释\n; 另一行注释\n");
    var h5: HcResolvHit = hc_resolv_scan(t.ptr[0: t.len]);
    if h5.found || h5.saw_v6 {
        dnr_fail("纯注释的文本不该给出任何结论", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（扫描：IPv6 记账/畸形不中止/空与纯注释）\n");
    }
    return ok;
}

// 写一份 DN_PATH，内容是「>512 字节注释头 + 末尾 nameserver」的现场形状。
fn dnr_write_resolv() bool {
    var t: Buf = buf_new(4096);
    defer { buf_free(&t); }
    dnr_comment_block(&t, 12);
    _ = buf_append_cstr(&t, "nameserver ");
    _ = buf_append_cstr(&t, DN_LOOPBACK);
    _ = buf_append_byte(&t, 10);
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(DN_PATH as *const byte, flags, 420 as i32) catch {
        return false;
    };
    var off: usize = 0;
    var ok: bool = true;
    while off < t.len {
        const w: isize = sys_write(fd, &t.ptr[off], t.len - off) catch {
            ok = false;
            break;
        };
        if w <= 0 {
            ok = false;
            break;
        }
        off = off + (w as usize);
    }
    _ = sys_close(fd) catch {};
    return ok;
}

// 真文件轮：把解析器路径钉到临时文件，看产品给出的解析器串与来源（判据①的闭环）。
fn dnr_file_round(tag: &const byte) bool {
    var ok: bool = true;
    _ = sys_mkdir(DN_DIR as *const byte, 493 as i32) catch {};
    if !dnr_write_resolv() {
        dnr_fail("夹具：临时 resolv.conf 没写出来", &ok);
        return ok;
    }
    if !hc_resolv_set_path(DN_PATH) {
        dnr_fail("hc_resolv_set_path 对合法路径返回了 false", &ok);
    }
    if !dnr_eq_ptr(hc_resolv_path_ptr(), hc_resolv_path_len(), DN_PATH) {
        dnr_fail("hc_resolv_path_ptr/len 回读的路径不是钉进去那条", &ok);
    }
    var res: Buf = buf_new(HC_DNS_SERVER_MAX);
    defer { buf_free(&res); }
    if !hc_dns_resolve(&res) {
        dnr_fail("临时文件里有 nameserver，hc_dns_resolve 却说没有", &ok);
    }
    if !dnr_eq(&res, DN_LOOPBACK) {
        dnr_fail("解析器串不是逐字节的 127.0.0.53", &ok);
    }
    if hc_dns_src_now() != HC_DNS_FROM_FILE {
        dnr_fail("来源应当是「解析器文件」，不是 env 或标准库默认", &ok);
    }
    if hc_dns_server_len() != bufx_cstr_len(DN_LOOPBACK) {
        dnr_fail("hc_dns_server_len 与解析出来的解析器串对不上", &ok);
    }
    // 文件删掉之后：不该再声称来自文件（来源换成标准库默认，原因 = 打不开）
    _ = sys_unlink(DN_PATH as *const byte) catch {};
    _ = hc_dns_resolve(&res);
    if hc_dns_src_now() == HC_DNS_FROM_FILE {
        dnr_fail("文件都删了还说来源是「解析器文件」", &ok);
    }
    if hc_dns_err_now() != HC_DNS_ERR_OPEN {
        dnr_fail("文件不存在时原因应当是「打不开」", &ok);
    }
    _ = hc_resolv_set_path(null as &const byte);   // 别把临时路径留给后面的轮次
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（真文件：>512 偏移 → 127.0.0.53 / 来源 / 删掉后不再声称）\n");
    }
    return ok;
}

// 覆盖轮（`$UYA_AGENT_DNS` 那一侧）：合法值优先、非法值不采用且记账。
fn dnr_override_round(tag: &const byte) bool {
    var ok: bool = true;
    var res: Buf = buf_new(HC_DNS_SERVER_MAX);
    defer { buf_free(&res); }

    // ① 合法：用它，来源记 env，解析器串逐字节相同
    _ = hc_dns_set_override(DN_OVERRIDE);
    if !hc_dns_resolve(&res) {
        dnr_fail("显式指定的解析器没被采用", &ok);
    }
    if !dnr_eq(&res, DN_OVERRIDE) {
        dnr_fail("采用的解析器串与 `a.b.c.d:端口` 不逐字节相同", &ok);
    }
    if hc_dns_src_now() != HC_DNS_FROM_ENV {
        dnr_fail("来源应当是 env", &ok);
    }

    // ② 非法值：**不采用**（来源不许报 env）、原因记 ENV_BAD，且继续往下找
    _ = hc_dns_set_override(DN_BAD);
    _ = hc_dns_resolve(&res);
    if hc_dns_src_now() == HC_DNS_FROM_ENV {
        dnr_fail("非法值被当成解析器用了", &ok);
    }
    if hc_dns_err_now() != HC_DNS_ERR_ENV_BAD {
        dnr_fail("非法值的专用原因没记下来（用户就看不到「这个变量没被认」）", &ok);
    }

    // ③ 端口越界也算非法（65536 不是端口）
    _ = hc_dns_set_override(DN_BAD_PORT);
    _ = hc_dns_resolve(&res);
    if hc_dns_err_now() != HC_DNS_ERR_ENV_BAD {
        dnr_fail("端口越界的值没被判成非法", &ok);
    }

    // ④ 清掉覆盖之后不该再报 env
    _ = hc_dns_set_override(null as &const byte);
    _ = hc_dns_resolve(&res);
    if hc_dns_src_now() == HC_DNS_FROM_ENV {
        dnr_fail("清掉覆盖之后来源还报 env", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（覆盖：合法优先 / 非法不采用并记账 / 端口越界）\n");
    }
    return ok;
}

// 四段的合体入口（selftest.uya 里一行调用）。
fn dnr_rounds(tag: &const byte) bool {
    const a: bool = dnr_scan_round(tag);
    const b: bool = dnr_scan_round_b(tag);
    const c: bool = dnr_file_round(tag);
    const d: bool = dnr_override_round(tag);
    return a && b && c && d;
}
