// src/selftest/tuis_ui_port.uya — 界面后端接缝（P80）的离线自测轮
//
// 本文件：`tui_ui_port_round`（轮次名 `ui-port`）—— 端口层本身的行为断言：
//   注册表与选择、空后端的 fail closed、**通道映射**（端口 2/3 vs TUI 3/2）、
//   `ui_on` 的事实口径、`be_tui` 的 text/status 转发。内部拆成五段
//   （`uip_reg_*` / `uip_null_*` / `uip_chan_*` / `uip_status_*` / `uip_on_*`），
//   每段一个小函数、各自收 `&ok`。
// 不变量：① 断言只走**生产入口**（`ui_text` / `ui_status` / `ui_on` / `ui_use`），
//   不直呼后端私有方法 —— 直呼的话「端口接错了」这类缺陷整轮绿（与踩坑 143 同族：
//   腿只调函数、不碰调用点）；
//   ② **通道映射那条腿必须能分辨 2 与 3**：思考和通知各自断言**落到哪种条目**，
//   不是「有内容就行」—— 对调之后两者都有内容，只有按条目种类断言才抓得住；
//   ③ 每段开头 `tuis_reset` + `ui_use` 复位，段间不留后端选择（否则下一段在空
//   后端上跑，症状是「上一段好好的、这一段全丢」）；
//   ④ 载荷长度一律走 `bufx_cstr_len`（**手数错过一次**：`UI_ST_TEXT` 的 14 字节
//   被写成 13，截断后的载荷悄悄变成了另一种事实，而屏幕上只是少一个字符）。
// 依赖：libc（无直接调用）、foundation/bufx、term/tui（条目与尺寸）、ui/ui_port、
//   ui/ui_reg、ui/be_tui（经 `ui_use(UI_BE_TUI)` 间接）。
// 命名：对外 `tui_ui_port_round`；私有 `uip_*`（夹具与断言）；轮次名 `ui-port`。

// 数一数当前转录里有几条某种 kind 的条目（映射断言用它分辨「落哪去了」）。
fn uip_count_kind(kind: u8) usize {
    var n: usize = 0;
    var i: usize = 0;
    while i < tui_entries_count() {
        if tui_entry_kind(i) == kind {
            n = n + 1;
        }
        i = i + 1;
    }
    return n;
}

// 断言 `ui_kind_name()` 等于 want。
fn uip_kind_name_is(want: &const byte, tag: &const byte, ok: &bool) void {
    const got: &const byte = ui_kind_name();
    const gl: usize = bufx_cstr_len(got);
    const wl: usize = bufx_cstr_len(want);
    if gl != wl || !bufx_mem_eq(got, want, gl) {
        tuis_fail(tag, "ui_kind_name() 与期望的后端名不一致", ok);
    }
}

// 发一条 status（长度交给 bufx）。
fn uip_status(what: u8, p: &const byte) void {
    ui_status(what, p, bufx_cstr_len(p));
}

// 发一条 text（长度交给 bufx）。
fn uip_text(chan: u8, p: &const byte) void {
    ui_text(chan, p, bufx_cstr_len(p));
}

// ---- 1) 注册表：切换与后端名 ----
fn uip_reg_check(tag: &const byte, ok: &bool) void {
    ui_use(UI_BE_NULL);
    if ui_kind() != UI_BE_NULL {
        tuis_fail(tag, "ui_use(UI_BE_NULL) 之后 ui_kind() 不是 NULL", ok);
    }
    uip_kind_name_is("null" as &const byte, tag, ok);

    ui_use(UI_BE_TUI);
    if ui_kind() != UI_BE_TUI {
        tuis_fail(tag, "ui_use(UI_BE_TUI) 之后 ui_kind() 不是 TUI", ok);
    }
    uip_kind_name_is("tui" as &const byte, tag, ok);
}

// ---- 2) 空后端：输出零字节、提问 fail closed、`on` 一律假 ----
fn uip_null_check(tag: &const byte, ok: &bool) void {
    ui_use(UI_BE_NULL);
    const before_n: usize = tui_entries_count();
    uip_text(UI_CH_MAIN, "这条不该出现在任何地方" as &const byte);
    uip_status(UI_ST_TEXT, "也不该" as &const byte);
    if tui_entries_count() != before_n {
        tuis_fail(tag, "空后端往转录里写了内容（判据是「显示字节为零」）", ok);
    }
    if ui_on(UI_ON_ACTIVE) {
        tuis_fail(tag, "空后端的 UI_ON_ACTIVE 应当为假", ok);
    }
    if ui_on(UI_ON_OVERLAY_OK) {
        tuis_fail(tag, "空后端的 UI_ON_OVERLAY_OK 应当为假（fail closed）", ok);
    }

    // 提问：**必须回 error**（「没人能回答」），不许回 0（那是「用户明确拒绝」）。
    // 两者执行核的话术不同，所以这里钉的是「走到了 catch」。
    const req: UiReq = UiReq{
        kind: UI_ASK_APPROVE, id: 1,
        title: "t" as &const byte, tn: 1,
        body: "b" as &const byte, bn: 1,
        items: "" as &const byte, inlen: 0,
        sel: 0, timeout_ms: 0,
    };
    var ans: UiAns = UiAns{ status: 0, sel: 0, text: buf_empty() };
    const no_channel: i32 = -777;
    const rc: i32 = ui_ask(&req, &ans) catch { no_channel; };
    if rc != no_channel {
        tuis_fail(tag, "空后端的 ui_ask 没回 error.UiNoChannel（fail closed 破了）",
            ok);
    }
}

// ---- 3) **通道映射**（本域最重要的一条）----
// 端口：MAIN=1 / REASON=2 / NOTICE=3；TUI 内部：1=正文 / 2=通知 / 3=思考。
// 所以按**条目种类**断言，而不是「屏幕上有没有字」—— 把 `betui_chan_map` 改成
// 直通时，思考会落进通知条目、通知会落进思考条目，两者都「有内容」。
fn uip_chan_check(tag: &const byte, ok: &bool) void {
    tuis_reset(100, 28);
    tui_headless_enable(true);
    tty_sink_on = true;
    ui_use(UI_BE_TUI);

    uip_text(UI_CH_REASON, "端口思考" as &const byte);
    if uip_count_kind(TUI_E_REASON) != 1 {
        tuis_fail(tag, "UI_CH_REASON 没有落进「思考」条目（通道映射错了？）", ok);
    }
    if uip_count_kind(TUI_E_NOTICE) != 0 {
        tuis_fail(tag, "UI_CH_REASON 落进了「通知」条目 —— 思考与通知对调了", ok);
    }

    uip_text(UI_CH_NOTICE, "端口通知\n" as &const byte);
    if uip_count_kind(TUI_E_NOTICE) != 1 {
        tuis_fail(tag, "UI_CH_NOTICE 没有落进「通知」条目（通道映射错了？）", ok);
    }
    if uip_count_kind(TUI_E_REASON) != 1 {
        tuis_fail(tag, "UI_CH_NOTICE 又加了一条「思考」条目 —— 两个通道混了", ok);
    }

    uip_text(UI_CH_MAIN, "端口正文" as &const byte);
    if uip_count_kind(TUI_E_ASSIST) != 1 {
        tuis_fail(tag, "UI_CH_MAIN 没有落进「助手正文」条目", ok);
    }

    // 表外的通道号：丢弃，**不猜**（fail closed）
    const before: usize = tui_entries_count();
    uip_text(200, "野通道号" as &const byte);
    if tui_entries_count() != before {
        tuis_fail(tag, "野通道号（200）居然进了转录 —— 表外取值应当丢弃", ok);
    }
}

// ---- 4) status 转发：可直接验证的几条 + 非法载荷必须保持不动 ----
fn uip_status_check(tag: &const byte, ok: &bool) void {
    uip_status(UI_ST_PLAN, "1" as &const byte);
    if !tui_plan_on() {
        tuis_fail(tag, "UI_ST_PLAN 载荷 \"1\" 没有把 plan 打开", ok);
    }
    uip_status(UI_ST_PLAN, "0" as &const byte);
    if tui_plan_on() {
        tuis_fail(tag, "UI_ST_PLAN 载荷 \"0\" 没有把 plan 关掉", ok);
    }

    uip_status(UI_ST_ACCESS, "2" as &const byte);
    if tui_access() != PERM_FULL_ACCESS {
        tuis_fail(tag, "UI_ST_ACCESS 载荷 \"2\" 没有落到 FULL_ACCESS", ok);
    }
    // 非法载荷（非数字）⇒ **保持不动**：显示层是镜像不是真值源，看不懂的载荷不许
    // 把屏幕上的访问模式改掉（那会让屏幕显示成「用户降权了」，而策略没动）。
    uip_status(UI_ST_ACCESS, "x" as &const byte);
    if tui_access() != PERM_FULL_ACCESS {
        tuis_fail(tag, "UI_ST_ACCESS 非法载荷把访问模式改掉了（应当保持不动）", ok);
    }

    // UI_ST_TEXT 落在脚注统计行 —— 这条顺带钉住「状态事实也能过端口」。
    uip_status(UI_ST_TEXT, "UIP-STATS-MARK" as &const byte);
    tui_build();
    if !tuis_screen_has("UIP-STATS-MARK" as &const byte) {
        tuis_fail(tag, "UI_ST_TEXT 的文本没有出现在状态行上", ok);
    }
    uip_status(UI_ST_TEXT, "" as &const byte);

    // 运行态：UI_RUN_* → TUI_RUN_*
    uip_status(UI_ST_RUN, "3" as &const byte);
    if tui_run_kind() != TUI_RUN_TOOL {
        tuis_fail(tag, "UI_ST_RUN 载荷 \"3\" 没有落到 TOOL", ok);
    }
    uip_status(UI_ST_RUN, "0" as &const byte);
    if tui_run_kind() != TUI_RUN_IDLE {
        tuis_fail(tag, "UI_ST_RUN 载荷 \"0\" 没有回到 IDLE", ok);
    }
}

// ---- 5) `ui_on`：后端自己记 started（不拿 tui_active 冒充）----
// headless 下 `tui_active()` 为真（`tui_headless_enable` 顶起 g_tui_on），但本轮
// 没调 `ui_start` ⇒ `TuiBe.started` 为假。这条正是「后端自己记一个位」的理由：
// 拿 `tui_active()` 当 started 的话，headless 的假界面会被当成真界面。
fn uip_on_check(tag: &const byte, ok: &bool) void {
    ui_use(UI_BE_TUI);
    if ui_on(UI_ON_ACTIVE) {
        tuis_fail(tag, "没 ui_start 过，UI_ON_ACTIVE 却为真（started 位没生效）", ok);
    }
    if ui_on(UI_ON_OVERLAY_OK) {
        tuis_fail(tag, "没 ui_start 过，UI_ON_OVERLAY_OK 却为真", ok);
    }
}

// 整轮：五段各跑各的，**不早退**（一次看到所有红）。
export fn tui_ui_port_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_reset(100, 28);
    tui_headless_enable(true);
    tty_sink_on = true;

    uip_reg_check(tag, &ok);
    uip_null_check(tag, &ok);
    uip_chan_check(tag, &ok);
    uip_status_check(tag, &ok);
    uip_on_check(tag, &ok);

    // 收尾：切回空后端，别把 TUI 选择留给下一轮
    ui_use(UI_BE_NULL);
    tty_sink_on = false;
    tui_headless_enable(false);
    if ui_kind() != UI_BE_NULL {
        tuis_fail(tag, "收尾没有切回空后端（会污染下一轮）", &ok);
    }

    if ok {
        tuis_ok(tag, "注册表 / fail closed / 通道映射 / status 转发 / ui_on");
    }
    return ok;
}
