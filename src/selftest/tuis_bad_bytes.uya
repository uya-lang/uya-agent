// src/selftest/tuis_bad_bytes.uya — 坏字节不许上屏（P136）：清洗闸门 + 游程折叠
//
// 本文件：tui-bad-bytes 轮 —— 屏幕文本的三条硬口径各配一条断言：
//   ① **每一个**条目入口（用户 / steer / 工具块 / NOTICE）交进来的外来字节都必须
//      先清洗：一段**没有 NUL 结尾**的 `Buf` 走这四条路，屏幕上只许出现这段字节
//      本身，不许出现堆尾巴（NUL 是「长度/结尾算错了」的铁证，`tuis_scan_rows`
//      一直在查它）；
//   ② 一整块二进制（512 B）与一整串上游替身（170 个 U+FFFD = 510 B）都只许画
//      `TUI_BAD_MAX` 个 `�` + **一句计数**，行数有界（截图现场：一行 `�` 顶满，
//      后面紧跟「诊断已截断」，人一个字节的信息都读不到）；
//   ③ 偶发的一两个坏字节照旧一个 `�`（别为了折叠把「这里坏了一个字节」也吞掉），
//      合法中文与 emoji 一个字节都不许改。
//
// 不变量（本轮的判据）：条目 text 永远是**清洗之后**的屏幕文本 —— 谁绕过清洗闸门，
// 上面①就在那个入口红；谁把 `�` 一格一个地铺出去，②就红。
//
// 为什么单开一轮：`tui-diag`（tuis_title_pty）只查「NOTICE 里有 U+FFFD + 有截断提示」，
// 它**不查**个数与行数，也不查条目接口那四条路（那条断言走的是 fd 2 的 sink）。
// 用户在真机上看到的「还是乱码」恰恰是条目接口 + 一整块二进制：屏幕铺满 `�`。
//
// 依赖：见 tuiselftest.uya 的文件头（本文件与它同处合并命名空间，无本地 use）。
// 命名：轮次 `tui_bad_bytes_round`，夹具 `tuibb_*`。

// 造一段「没有 NUL 结尾」的字节（`buf_append_cstr` 不补 0，正是要测的形状）。
fn tuibb_plain(out: &Buf, s: &const byte) void {
    _ = buf_append_cstr(out, s);
}

// 当前帧的字节级屏幕文本（每次 freshly build，别复用旧快照）。
fn tuibb_screen(out: &Buf) void {
    buf_reset(out);
    tui_build();
    _ = tui_screen_text(out);
}

// 帧健康：没有 NUL / ESC、每行放得进终端、帧自检 0（真终端上不会花）。
fn tuibb_frame_ok(cols: usize, rows: usize, ok: &bool, tag: &const byte) void {
    tui_build();
    if tui_frame_audit() != 0 {
        tuis_fail(tag, "帧自检报违规（行超宽/帧超高/行区间坏）", ok);
    }
    if tui_nrows() > rows {
        tuis_fail(tag, "整帧行数超过终端行数（屏幕外的行号会被夹到最后一行）", ok);
    }
    tuis_scan_rows(cols, ok, tag);
}

// ① 没有 NUL 结尾的 Buf 走四个条目入口：屏幕上只有这段字节，没有堆尾巴。
// kind：0 用户 / 1 steer / 2 工具块 / 3 NOTICE（与 TUI_E_* 的顺序无关，本函数自用）。
fn tuibb_entry(kind: u8, tag: &const byte, ok: &bool) void {
    tuis_reset(80, 24);
    var b: Buf = buf_new(64);
    defer { buf_free(&b); }
    // 故意**不**补 NUL：长度由调用方给（四条入口都是 (ptr, n) 口径）。
    // 越界读的形状 = 正文后面跟一堆 NUL / 别的字面量 —— 由 NUL 闸门（tuis_scan_rows）
    // 与「正文只出现一次」两条一起兜。
    tuibb_plain(&b, "abcdefgh" as &const byte);
    if kind == 0 {
        betui_add_user(b.ptr as &const byte, b.len);
    } else if kind == 1 {
        betui_add_steer(b.ptr as &const byte, b.len);
    } else if kind == 2 {
        betui_add_tool_block(b.ptr as &const byte, b.len);
    } else {
        betui_add_notice(b.ptr as &const byte, b.len);
    }
    var scr: Buf = buf_new(8192);
    defer { buf_free(&scr); }
    tuibb_screen(&scr);
    if tui_rows_have_nul() {
        tuis_fail(tag, "正文层里出现了 NUL（入口把没有 NUL 的 Buf 当 C 串量了？）", ok);
    }
    if !tuis_has(&scr, "abcdefgh" as &const byte) {
        tuis_fail(tag, "条目正文没画出来（清洗把内容吃掉了）", ok);
    }
    // 一条正文只许画一次：画两遍 / 后面接上堆里读出来的残留都会让它 > 1
    if tuis_count(&scr, "abcdefgh" as &const byte) != 1 {
        tuis_fail(tag, "正文出现了不止一次（越界读或重复入条目）", ok);
    }
    tuibb_frame_ok(80, 24, ok, tag);
}

// ② 一整块二进制进 NOTICE：`�` 个数 ≤ TUI_BAD_MAX，且有一句计数、行数有界。
// src_n 字节的 0x80..0xC1 循环（全是「坏引导字节」，旧口径 = 一格一个 `�`）。
fn tuibb_binary(src: &const byte, src_n: usize,
                tag: &const byte, ok: &bool) void {
    tuis_reset(80, 24);
    betui_add_notice(src, src_n);
    var scr: Buf = buf_new(16384);
    defer { buf_free(&scr); }
    tuibb_screen(&scr);
    const marks: usize = tuis_count(&scr, "�" as &const byte);
    if marks > TUI_BAD_MAX {
        tuis_fail(tag, "坏字节一格一个 `�`：屏幕被铺满了（应当折成一个 + 一句计数）", ok);
        tuis_puts("  屏幕上 `�` 的个数：" as &const byte);
        tuis_num(marks);
        tuis_puts("（上限 " as &const byte);
        tuis_num(TUI_BAD_MAX);
        tuis_puts("）\n" as &const byte);
    }
    if marks == 0 {
        tuis_fail(tag, "坏字节一个标志都没留下（人不知道这里有字节丢了）", ok);
    }
    if !tuis_has(&scr, "字节非 UTF-8" as &const byte) {
        tuis_fail(tag, "折掉的字节没有一句计数（`�` 之外还欠一句人话）", ok);
    }
    // 数字必须是**真的**字节数：折成一句不等于把数量吞掉
    if !tuis_has(&scr, "512 字节非 UTF-8" as &const byte) {
        tuis_fail(tag, "计数句里的字节数不对（应当是 512）", ok);
    }
    if tui_rows_have_nul() {
        tuis_fail(tag, "正文层里出现了 NUL（长度算大了？）", ok);
    }
    tuibb_frame_ok(80, 24, ok, tag);
}

// ③ 偶发的坏字节：一个 `�`（不折叠、也不加计数句）。合法性由④另一半兜着。
fn tuibb_one_bad(tag: &const byte, ok: &bool) void {
    tuis_reset(80, 24);
    // 「中」的前两个字节（E5 8F）：半截汉字，正是工具输出按字节截断的现场。
    var half: [byte: 2] = [229, 143];
    betui_add_notice(&half[0], 2);
    var scr: Buf = buf_new(8192);
    defer { buf_free(&scr); }
    tuibb_screen(&scr);
    if tuis_count(&scr, "�" as &const byte) != 1 {
        tuis_fail(tag, "半截汉字没有正好换成一个 `�`", ok);
    }
    if tuis_has(&scr, "字节非 UTF-8" as &const byte) {
        tuis_fail(tag, "两个字节的坏游程不该触发计数句（噪声）", ok);
    }
    tuibb_frame_ok(80, 24, ok, tag);
}

// ④ 上游已经换好的替身（合法 U+FFFD）与坏字节走同一条折叠口径。
fn tuibb_repl_run(tag: &const byte, ok: &bool) void {
    tuis_reset(80, 24);
    var b: Buf = buf_new(2048);
    defer { buf_free(&b); }
    var k: usize = 0;
    while k < 170 {          // 510 B —— 正好是旧口径下「一整行 `�`」的量
        tuibb_plain(&b, "�" as &const byte);
        k = k + 1;
    }
    betui_add_notice(b.ptr as &const byte, b.len);
    var scr: Buf = buf_new(16384);
    defer { buf_free(&scr); }
    tuibb_screen(&scr);
    const marks: usize = tuis_count(&scr, "�" as &const byte);
    if marks > TUI_BAD_MAX {
        tuis_fail(tag, "上游换好的 U+FFFD 没跟着折叠（换一层就又铺满屏）", ok);
    }
    if !tuis_has(&scr, "字节非 UTF-8" as &const byte) {
        tuis_fail(tag, "U+FFFD 游程没有一句计数", ok);
    }
    if !tuis_has(&scr, "510 字节非 UTF-8" as &const byte) {
        tuis_fail(tag, "U+FFFD 游程的字节数不对（170 × 3 = 510）", ok);
    }
    tuibb_frame_ok(80, 24, ok, tag);
}

// ⑤ 合法中文与 emoji 一个字节都不许改（别为了消毒把正文改坏）。
fn tuibb_keep_good(tag: &const byte, ok: &bool) void {
    tuis_reset(80, 24);
    const good: &const byte = "中文 🙂 表格 | 甲 | 乙" as &const byte;
    betui_add_notice(good, bufx_cstr_len(good));
    var scr: Buf = buf_new(8192);
    defer { buf_free(&scr); }
    tuibb_screen(&scr);
    if !tuis_has(&scr, good) {
        tuis_fail(tag, "合法中文 / emoji 被清洗改坏了", ok);
    }
    if tuis_has(&scr, "�" as &const byte) {
        tuis_fail(tag, "合法正文里冒出了 `�`（清洗误伤）", ok);
    }
    tuibb_frame_ok(80, 24, ok, tag);
}

// tui-bad-bytes 轮：坏字节不许上屏。返回 false = 本轮有红。
export fn tui_bad_bytes_round(tag: &const byte) bool {
    var ok: bool = true;
    // ① 四条入口各来一遍（没有 NUL 结尾的 Buf）
    tuibb_entry(0, tag, &ok);
    tuibb_entry(1, tag, &ok);
    tuibb_entry(2, tag, &ok);
    tuibb_entry(3, tag, &ok);
    // ② 一整块二进制（512 B）：`�` 有界 + 一句计数
    var bin: Buf = buf_new(1024);
    defer { buf_free(&bin); }
    var i: usize = 0;
    while i < 512 {
        _ = buf_append_byte(&bin, (0x80 + (i % 0x42)) as byte);
        i = i + 1;
    }
    tuibb_binary(bin.ptr as &const byte, bin.len, tag, &ok);
    // 同样一块走 fd 2 的 sink（那条路本来就在清洗）—— 口径必须逐条相同
    tuis_reset(80, 24);
    tty_sink_on = true;
    tty_write(&tty_ui, 2, bin.ptr as &const byte, bin.len);
    tui_sink_flush_partial();
    tty_sink_on = false;
    var scr2: Buf = buf_new(16384);
    defer { buf_free(&scr2); }
    tuibb_screen(&scr2);
    if tuis_count(&scr2, "�" as &const byte) > TUI_BAD_MAX {
        tuis_fail(tag, "fd 2 通道的坏字节没跟着折叠（两条路口径不一致）", &ok);
    }
    // ③ 半截汉字 / ④ 上游替身 / ⑤ 合法正文
    tuibb_one_bad(tag, &ok);
    tuibb_repl_run(tag, &ok);
    tuibb_keep_good(tag, &ok);
    if ok {
        // 行宽豁免：这一轮全部断言的收尾小结，断行反而读不出「测了哪几条」
        tuis_ok(tag, "四个条目入口都过清洗闸门（无 NUL 结尾的 Buf 也不越界）+ 512 B 二进制与 170 个 U+FFFD 都折成 `�` + 一句计数 + 半截汉字仍是一个 `�` + 合法中文/emoji 一个字节都没改 + fd 2 通道同一口径");
    }
    return ok;
}
