// src/selftest/tuis_mem_menu.uya — `/memory` 动作选择框 + 后台活动指示（P107）
//
// 本文件：一轮 `tui-memory`（`tui_mem_menu_round`）。五段：
//   A) 裸 `/memory` 开的是 `TUI_OVK_MEMORY_MENU`，六行动作与标题真上屏；
//   B) 选 `show` 开的是 **`TUI_OVK_MEMORY`**（纯查看），且**与菜单 kind 不同** ——
//      共用一个 kind 时接收端只能挑一种语义，另一种被静默丢弃（本仓踩过两次）；
//   C) 选 `forget` 翻成第二道确认浮层，**游标默认停在「取消」**；esc 之后目录仍在；
//   D) 后台活动指示：空闲时状态区 0 行 → `tui_bg_begin` 后 1 行 → 空闲下转轮也标脏
//      → 回合运行中状态行同时含主状态与后台文案 → `tui_bg_end` 后回 0 行；
//   E) **P115**：开工包（`<pm-memory>…</pm-memory>`）不回放成用户条目，也不进标题派生
//      —— 判据与运行时上下文 / AGENTS.md 同一条（`agent_tui_is_injected`）。
// 不变量：① 每段都能**单独变红**（没有哪条断言依赖别段先跑过）；
//   ② 夹具装在真实 globals 上，收尾必须清干净（后面的 TUI 轮靠空表做排版断言）；
//   ③ 不联网、不调模型：`learn` 那条腿只测**指示收尾**，不真的蒸馏（那要读盘，
//      由 `pm-ws` 那几轮在 pm 侧覆盖）。
// 依赖：selftest/tuis_core（`tuis_reset` / `tuis_fail` / `tuis_ok` /
//   `tuis_screen_has` / `tuis_scan_rows` / `tuis_has`）、
//   term/tui（`tui_overlay_*`）、
//   agent/ag_memory_tui（`agent_tui_memory_open` / `agent_tui_memory_handle` /
//   `MEM_ACT_N` / `mem_act_name`）、agent/ag_plan_pump（`agent_tui_command` /
//   `agent_tui_is_injected` / `agent_tui_seed_history`）、
//   agent/ag_title_prompt（`agent_title_user_into`）。
// 命名：`tui_mem_menu_*` / `tmm_*`。

// 一轮：`/memory` 动作框 + 后台指示。返回 false = 夹具就绪失败（后面的段不必再跑）。
fn tui_mem_menu_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_reset(100, 28);
    // ⚠ `tuis_reset` 只调 `tui_set_headless`（**只置 headless 位**，不置 g_tui_on）。
    // 浮层的断言不需要 g_tui_on（浮层直接画），但**状态区**要（`tui_status_rows` →
    // `tui_draw_status_block` 走的是正常成帧路径）。D 段要断言后台行上屏，
    // 所以这里必须用 `tui_headless_enable(true)`（与 tuis_goal_menu_case 同款）。
    tui_headless_enable(true);
    ui_use(UI_BE_TUI);
    // 状态区只在**聊天屏**里画（`tui_build` 在 `g_tui_nent == 0` 时走 home 屏）。
    // D 段要断言后台行上屏，所以先塞一条转录条目（只用公开的显示层入口，不借别的轮的夹具）。
    tmm_fill_transcript();
    var c: Config = cfg_default();
    defer { cfg_free(&c); }
    c.sandbox = SAN_OFF;
    var hs: History = hist_init();
    defer { hist_free(&hs); }
    // A) 裸 /memory 开动作选择框
    if !tmm_menu_opens(tag, &ok, &c, &hs) {
        return false;
    }
    // B) show → 查看器（kind 必须与菜单不同）
    tmm_show_opens_viewer(tag, &ok, &c, &hs);
    // C) forget → 第二道确认 + 游标在取消
    tmm_forget_confirm(tag, &ok);
    // D) 后台活动指示
    tmm_bg_indicator(tag, &ok);
    // E) 开工包不回放（P115）
    tmm_pm_memory_not_replayed(tag, &ok, &hs);
    if ok {
        // 行宽豁免：轮次小结是单条不可断的字面量（本仓自测通篇如此）
        // 行宽豁免：轮次小结是单条不可断的字面量
        tuis_ok(tag, "裸 /memory 开动作框 + show 开纯查看器（kind 分开）+ forget 二次确认游标在取消 + 空闲/运行两态的状态区 + 后台文案共存 + 开工包不回放成用户条目");
    }
    return ok;
}

// A) 裸 `/memory` → `TUI_OVK_MEMORY_MENU`，标题与六动作都在屏上，游标默认在 show。
fn tmm_menu_opens(tag: &const byte, ok: &bool, c: &Config, hs: &History) bool {
    var cmd: Buf = buf_new(32);
    defer { buf_free(&cmd); }
    _ = buf_append_cstr(&cmd, "/memory");
    _ = agent_tui_command(c, hs, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_MEMORY_MENU {
        tuis_fail(tag, "裸 /memory 没有开出动作选择框（或 kind 不是 MEMORY_MENU）", ok);
        return false;
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("记忆（enter 执行 · esc 取消）" as &const byte) {
        tuis_fail(tag, "动作选择框的标题不对", ok);
    }
    var i: usize = 0;
    while i < MEM_ACT_N {
        if !tuis_screen_has(mem_act_name(i)) {
            tuis_fail(tag, "动作选择框里少了某个动作（动作表与排版对不上）", ok);
        }
        i = i + 1;
    }
    // 行格式：游标行在最左（打开就在 show 那一行）—— 判据是「✓ 或两空格 + 机器名」，
    // 这里只钉「第一行是 show」（不钉 ✓，因为 show 不是有状态的动作）。
    if !tuis_screen_has("  show " as &const byte) {
        tuis_fail(tag, "show 那一行没按「两空格 + 机器名 + 补齐」的格式排版", ok);
    }
    // esc 关掉，不影响后面的段
    tui_keys_inject("\x1b" as &const byte, 1);
    _ = tui_poll_keys(0);
    return true;
}

// B) 选 `show` → `TUI_OVK_MEMORY`（纯查看）；且 `tui_overlay_kind()` 必须**不是**菜单 kind。
fn tmm_show_opens_viewer(tag: &const byte, ok: &bool, c: &Config,
                         hs: &History) void {
    _ = hs;
    // 直接走 handle：模拟「菜单交出一行 show」
    const mt: &const byte = "记忆（enter 执行 · esc 取消）" as &const byte;
    tui_overlay_menu(TUI_OVK_MEMORY_MENU, mt,
        bufx_cstr_len("记忆（enter 执行 · esc 取消）" as &const byte),
        "  show    — 看概况\n  search  — 检索\n" as &const byte,
        bufx_cstr_len("  show    — 看概况\n  search  — 检索\n" as &const byte), 0);
    var sel: Buf = buf_new(128);
    defer { buf_free(&sel); }
    _ = buf_append_cstr(&sel, "  show    — 看概况");
    // handle 读的是 `tui_overlay_kind()`（= 结果 kind）。menu 打开时它是 MENU。
    const handled: bool = agent_tui_memory_handle(c, &sel);
    if !handled {
        tuis_fail(tag, "show 没有被收口（handle 返回 false）", ok);
        return;
    }
    if tui_overlay_kind() == TUI_OVK_MEMORY_MENU {
        tuis_fail(tag, "show 开出来的还是菜单 kind（菜单与查看器必须分开）", ok);
    }
    if !tui_overlay_open() {
        // 记忆为空时报告仍然非空（会有「目录 / 项目键 / 事实 0 条」几行），所以必须开
        tuis_fail(tag, "show 没有开出查看浮层（报告被丢了？）", ok);
        return;
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("记忆（esc 关闭）" as &const byte) {
        tuis_fail(tag, "查看浮层的标题不对", ok);
    }
    tui_overlay_close();
}

// C) 选 `forget` → 第二道确认浮层；游标默认停在「取消」；esc 不删任何东西。
fn tmm_forget_confirm(tag: &const byte, ok: &bool) void {
    const mt2: &const byte = "记忆（enter 执行 · esc 取消）" as &const byte;
    tui_overlay_menu(TUI_OVK_MEMORY_MENU, mt2,
        bufx_cstr_len("记忆（enter 执行 · esc 取消）" as &const byte),
        "  forget  — 清空\n" as &const byte,
        bufx_cstr_len("  forget  — 清空\n" as &const byte), 0);
    var sel: Buf = buf_new(128);
    defer { buf_free(&sel); }
    _ = buf_append_cstr(&sel, "  forget  — 清空");
    var cfg0: Config = cfg_default();
    defer { cfg_free(&cfg0); }
    const handled: bool = agent_tui_memory_handle(&cfg0, &sel);
    if !handled {
        tuis_fail(tag, "forget 没有被收口", ok);
        return;
    }
    if tui_overlay_kind() != TUI_OVK_MEMORY_CONFIRM {
        tuis_fail(tag, "forget 没有翻成第二道确认浮层", ok);
        return;
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("确认清空记忆？" as &const byte) {
        tuis_fail(tag, "确认浮层的标题不对", ok);
    }
    if !tuis_screen_has("取消" as &const byte) {
        tuis_fail(tag, "确认浮层里没有「取消」那一行", ok);
    }
    // 游标默认在「取消」：选中的那一行必须是第 2 行（不是「清空本项目记忆」）
    var picked: Buf = buf_new(128);
    defer { buf_free(&picked); }
    if tui_overlay_peek(&picked) && picked.len > 0 &&
       bufx_mem_eq(picked.ptr as &const byte, "清空本项目记忆", 21) {
        tuis_fail(tag, "确认浮层的游标默认停在「清空本项目记忆」上（不可逆动作必须默认取消）", ok);
    }
    tui_overlay_close();
}

// D) 后台活动指示：0 行 → 1 行 → 回 0 行；空闲时转轮也要标脏；运行中两个状态共存。
fn tmm_bg_indicator(tag: &const byte, ok: &bool) void {
    // 先确保空闲（前面几段可能动过运行态）
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    if tui_bg_active() {
        tuis_fail(tag, "夹具没清干净：后台活动还是 active", ok);
    }
    if tui_status_rows() != 0 {
        tuis_fail(tag, "空闲且后台不忙时状态区应当是 0 行", ok);
    }
    // 开始：空闲 + 后台忙 ⇒ 1 行
    const s1: &const byte = "蒸馏知识中 · 读取 3/8" as &const byte;
    tui_bg_begin(s1, bufx_cstr_len(s1));
    if !tui_bg_active() {
        tuis_fail(tag, "tui_bg_begin 之后 active 仍为 false", ok);
    }
    // ⚠ 这里**不**用 `tui_dirty_pending()` 钉「转轮标脏」：headless 的 `tui_flush` 因为
    // `out_fd < 0` 当场早退，脏位永远清不掉 ⇒ 那个判据在 headless 里恒为真（
    // `tui-marquee` 的 F 段三次假绿就栽在这上面）。可观测的等价判据是
    // 「空闲 + 后台忙时状态区占 1 行」—— 转轮之所以有意义，正因为那一行存在
    // （`tui_status_rows()` 就是渲染路径的入口判据）。
    if tui_status_rows() != 1 {
        tuis_fail(tag, "空闲 + 后台忙时状态区应当是 1 行（否则后台活动在屏幕上是隐形的）", ok);
    }
    // 转轮前进不影响渲染（glyph 换一格而已）
    tui_tick_spinner();
    if tui_status_rows() != 1 {
        tuis_fail(tag, "tui_tick_spinner 把状态区行数弄坏了", ok);
    }
    // 屏上要有那段文案（含耗时后缀）
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("蒸馏知识中 · 读取 3/8" as &const byte) {
        tuis_fail(tag, "后台活动文案没有上屏", ok);
    }
    // 回合运行中：主状态与后台文案必须**共存**（后缀不挤掉主状态）
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("思考中" as &const byte) {
        tuis_fail(tag, "后台忙把主状态「思考中」挤掉了", ok);
    }
    if !tuis_screen_has("读取 3/8" as &const byte) {
        tuis_fail(tag, "回合运行中时状态行没有后台后缀", ok);
    }
    // 结束：回 0 行（转轮不许留在屏幕上）
    tui_bg_end();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    if tui_bg_active() {
        tuis_fail(tag, "tui_bg_end 之后 active 仍为 true", ok);
    }
    if tui_status_rows() != 0 {
        tuis_fail(tag, "tui_bg_end 之后状态区没有回到 0 行（转轮会留在屏上）", ok);
    }
    // 幂等：重复 end 是安全的（失败路径里 defer 会重复调）
    tui_bg_end();
    if tui_bg_active() {
        tuis_fail(tag, "重复 tui_bg_end 把状态弄坏了", ok);
    }
    // 空文案时也要给耗时（「启动到第一个进度点」那几秒不许隐形）
    tui_bg_begin("" as &const byte, 0);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("后台运行中" as &const byte) {
        tuis_fail(tag, "空文案时状态行没有兜底文案（那几秒会隐形）", ok);
    }
    tui_bg_end();
}

// 塞一条足够长的转录条目，让 `tui_build` 走**聊天屏**（状态区只在聊天屏里画）。
// 用 `betui_add_user` + `tui_sink_bytes`（与 tuis_title_pty 的 tuis_fill_transcript 同源），
// 但不依赖那个文件里的夹具 —— 自测各轮之间不互相借函数，改一个轮不该弄红另一个轮。
fn tmm_fill_transcript() void {
    var many: Buf = buf_new(4096);
    defer { buf_free(&many); }
    var i: usize = 0;
    while i < 30 {
        _ = buf_append_cstr(&many,
            "铺满视口用的转录正文，这一行足够长，会把整个视口吃掉。\n" as &const byte);
        i = i + 1;
    }
    const head: &const byte = "P107 后台指示回归" as &const byte;
    betui_add_user(head, bufx_cstr_len(head));
    tui_sink_bytes(1, many.ptr as &const byte, many.len);
    tui_close_stream_entries();
}

// E) 开工包（`<pm-memory>…</pm-memory>`）**不回放**成用户条目（P115）。
//
// 判据分三步，缺一步都是假绿：
//   ① 正面腿：往历史里塞**一条真用户消息 + 一条开工包**，回放后屏幕上只有前者 ——
//      只看「开工包不在屏上」会漏掉「回放整个都没跑」；
//   ② 否定腿：开工包那几个字（`Learned from earlier sessions`）也不许出现在屏上 ——
//      条目正文与标题一起判；
//   ③ 同样的判据要对 `agent_tui_is_injected` 本身成立：自动起标题（`agent_title_user_into`）
//      与 TUI 回放共用它，漏判会让标题从记忆文本里长出来。
//
// ⚠ 这一段的**原因**值得记：本轮之前 `agent_tui_is_injected` 只认 `<system-reminder>` /
// `Current runtime context` / `# 项目约定` / `<goal_round>` 四种，而 `agent_pm_inject`
// 注入的开工包是该函数的**第五种**输入，从来没人加进去 —— 于是 `--resume` 之后屏幕上
// 多出一条 `▎ 你` 加一整段英文索引（真机可复现：`▎ 你` + `<pm-memory>Learned from …`）。
// 踩坑 133 在**自测夹具**里撞见过同一个形态，当时按「夹具残留」修掉了（清 home），
// 产品口径那条路一直开着 —— 所以夹具干净了之后它反而更不容易被发现。
fn tmm_pm_memory_not_replayed(tag: &const byte, ok: &bool, hs: &History) void {
    tuis_reset(100, 30);
    tui_headless_enable(true);
    tty_sink_on = true;
    // 一条真用户消息当正面腿（真人打的字必须照旧回放）
    const real: &const byte = "TMM-REAL-USER 真人说的话" as &const byte;
    _ = hist_push(hs, ROLE_USER, real, bufx_cstr_len(real));
    // 开工包：形状与 `pm_digest` 一致（`<pm-memory>` 打头，正文里带那句索引提示语）
    // 行宽豁免：注入文案的逐字节夹具（断了就改了被测的输入）
    const digest: &const byte = "<pm-memory>Learned from earlier sessions in this repo. This is an index, not file content: read a file before relying on its details; STALE/GONE means verify first.\n\nCommands that worked in this project:\n- make -n — exit 0 (3x)\n</pm-memory>" as &const byte;
    _ = hist_push(hs, ROLE_USER, digest, bufx_cstr_len(digest));
    // 判据③的前半：这两条都要被判成「注入类」，真人那条不能
    if agent_tui_is_injected(msg_at(hs, hs.len - 1)) == false {
        tuis_fail(tag, "开工包没被认成注入类（回放与起标题都会把它当人话）", ok);
    }
    if agent_tui_is_injected(msg_at(hs, hs.len - 2)) {
        tuis_fail(tag, "真人消息被判成了注入类（那是反方向的错误）", ok);
    }
    agent_tui_seed_history(hs);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(real) {
        tuis_fail(tag, "回放把真人消息也一起吞了（判据太宽，不是只挡注入类）", ok);
    }
    if tuis_screen_has("pm-memory" as &const byte) {
        tuis_fail(tag, "开工包被回放成用户条目（屏幕上多出一条 ▎ 你）", ok);
    }
    if tuis_screen_has("Learned from earlier sessions" as &const byte) {
        tuis_fail(tag, "开工包的正文上了屏（回放没拦住注入类消息）", ok);
    }
    // 判据③的后半：自动起标题的输入同样不许收开工包（它取的就是同一份判据）
    var tu: Buf = buf_new(4096);
    defer { buf_free(&tu); }
    if !agent_title_user_into(hs, &tu) {
        tuis_fail(tag, "起标题的 user 段一条都没收到（真人消息被挡掉了）", ok);
    }
    if tuis_has(&tu, "pm-memory" as &const byte) {
        tuis_fail(tag, "起标题的输入里混进了开工包（标题会从记忆文本里长出来）", ok);
    }
    if !tuis_has(&tu, real) {
        tuis_fail(tag, "起标题的输入里没有真人消息", ok);
    }
    tui_transcript_clear();
}
