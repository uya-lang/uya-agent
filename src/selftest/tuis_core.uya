    const rc: i32 = agent_run_interactive(&c);
    sys_exit(rc);
}

// tui-pty 轮：真 PTY（/dev/ptmx + fork + dup2）—— 进退备用屏幕、termios 逐位还原、
// SIGWINCH 触发重排。全程在子进程里跑；返回 false = 本轮红（子进程异常也算）。
fn tui_pty_round(tag: &const byte) bool {
    var ok: bool = true;
    mock_mode = 0;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    const wsdir: &const byte = "build/selftest_ws_tui_pty" as &const byte;
    if !ws_prepare(wsdir) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", &ok);
        return false;
    }

    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", &ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return false;
    }
    // 踩坑 57 的 C 串口径（钉一条，补错/漏补都当场红）：从设备路径要**直接喂子进程的
    // sys_open**，所以尾巴必须是 NUL。缺了它 `buf_new` 的 malloc 不清零 ⇒ 路径后面黏上
    // 堆里的脏字节 ⇒ 子进程 `sys_exit(9)`，症状是「真 PTY 回合首帧空、退出码 9」。
    if bufx_cstr_len(slave_path.ptr as &const byte) + 1 != slave_path.len {
        tuis_fail(tag, "PTY 从设备路径不是 C 串（尾巴没有 NUL）", &ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return false;
    }
    var before: [byte: 60] = [0: 60];
    const have_before: bool = tuis_get_termios(m, &before[0]);
    if !have_before {
        tuis_fail(tag, "读不到 pty 的 termios", &ok);
    }

    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", &ok);
        return false;
    };
    if cpid64 == 0 {
        tuis_child_run_tui(&slave_path, port, wsdir);
        sys_exit(3);
        return false;
    }
    const cpid: i32 = tuis_i32(cpid64);

    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    // 首帧（子进程进 raw 之后才会画）
    tuis_drain(m, &cap, 40);
    if !tuis_has(&cap, "\x1b[?1049h" as &const byte) {
        tuis_fail(tag, "没有进备用屏幕（ESC[?1049h）", &ok);
    }
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案", &ok);
    }
    if !tuis_has(&cap, "Build" as &const byte) {
        tuis_fail(tag, "首屏没有面板信息行", &ok);
        tuis_dump_cap(&cap, 1200);
    }
    if tuis_has(&cap, "Current runtime context" as &const byte) {
        tuis_fail(tag, "注入类消息（运行时上下文）被当成用户条目回了屏幕", &ok);
    }
    // P22：终端标题 —— 进界面时先压标题栈 + 上基标题（`uya-agent · <工作目录名>`）
    if !tuis_has(&cap, "\x1b[22t" as &const byte) {
        tuis_fail(tag, "没有压标题栈（ESC[22t）", &ok);
    }
    if !tuis_has(&cap, "\x1b]2;uya-agent · selftest_ws_tui_pty\x07" as &const byte) {
        tuis_fail(tag, "起始标题不是 `uya-agent · <工作目录名>`", &ok);
        tuis_dump_cap(&cap, 800);
    }
    // 首帧捕获里只该有一条 OSC 2：标题不是每帧重写的
    if tuis_count(&cap, "\x1b]2;" as &const byte) != 1 {
        tuis_fail(tag, "起始捕获里的 OSC 2 条数不为 1（标题被重复写了）", &ok);
        tuis_puts("  实际 = ");
        tuis_num(tuis_count(&cap, "\x1b]2;" as &const byte));
        tuis_puts("\n");
    }
    // 发任务（此时子进程已经在 raw 模式，不会被行规程回显污染）
    var task: [byte: 64] = "把 hello-selftest 写进 note.txt\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    tuis_drain(m, &cap, 60);
    if !tuis_has(&cap, "SELFTEST_OK" as &const byte) {
        tuis_fail(tag, "转录里没有出现 mock 的最终答案", &ok);
    }
    // P22：第一条用户消息派生出的标题（前 3 个词 / ≤30 B = 10 字以内）必须跟着上终端
    if !tuis_has(&cap, "\x1b]2;把 hello-selftest 写进\x07" as &const byte) {
        tuis_fail(tag, "用户消息之后终端标题没有跟到会话标题上", &ok);
        tuis_dump_tail(&cap, 800);
    }
    if tuis_count(&cap, "\x1b]2;" as &const byte) != 2 {
        tuis_fail(tag, "OSC 2 条数不为 2（基标题 + 会话标题各一次）", &ok);
        tuis_puts("  实际 = ");
        tuis_num(tuis_count(&cap, "\x1b]2;" as &const byte));
        tuis_puts("\n");
    }
    // SIGWINCH：缩放 + 信号，进程必须活着并且继续画
    const mark_len: usize = cap.len;
    tuis_set_winsize(m, 120, 40);
    _ = sys_kill(cpid as i64, SIGWINCH) catch {};
    var spin: i32 = 0;
    tuis_drain(m, &cap, 20);
    var after_resize: [byte: 1] = [32];      // 空格：任何一次重绘都会带出字节
    tuis_write_master(m, &after_resize[0], 1);
    tuis_drain(m, &cap, 20);
    _ = spin;
    if cap.len <= mark_len {
        tuis_fail(tag, "SIGWINCH 之后没有任何新帧（界面没重排或进程死了）", &ok);
        tuis_puts("  cap before=");
        tuis_num(mark_len);
        tuis_puts(" after=");
        tuis_num(cap.len);
        tuis_puts(" alive=");
        if tuis_child_alive(cpid) {
            tuis_puts("yes" as &const byte);
        } else {
            tuis_puts("no" as &const byte);
        }
        tuis_puts("\n");
        tuis_dump_tail(&cap, 1200);
    }
    if !tuis_child_alive(cpid) {
        tuis_fail(tag, "SIGWINCH 之后子进程不见了（提前退出或崩了）", &ok);
        tuis_dump_cap(&cap, 1500);
    }
    // 退出：先把输入清掉（空格），再敲 `/exit` + 回车。
    // 这里刻意**不用** Ctrl-D：Ctrl-D 走的是「空行退出」的键位路径，不经过命令分派，
    // 所以它测不出「命令返回值被丢掉」那个 bug。`/exit` 才是那条路径 —— 真终端里
    // 主循环不再 headless 自退，能不能退完全取决于 stop 有没有被尊重。
    var bs: [byte: 1] = [127];
    tuis_write_master(m, &bs[0], 1);
    tuis_drain(m, &cap, 6);
    var exit_cmd: [byte: 6] = "/exit";
    exit_cmd[5] = 13;
    tuis_write_master(m, &exit_cmd[0], 6);
    tuis_drain(m, &cap, 30);

    var st: i32 = 0;
    if !tuis_wait_raw(cpid, &st, 20000) {
        tuis_fail(tag, "/exit 之后子进程没有退出（命令的返回值被丢了？）", &ok);
        _ = sys_kill(cpid as i64, SIGKILL) catch {};
    } else {
        const code: i32 = (st >> (8 as i32)) & 255;
        if code != 0 {
            tuis_fail(tag, "TUI 退出码不是 0", &ok);
            tuis_puts("  code=");
            tuis_num(code as usize);
            tuis_puts("\n");
            tuis_dump_cap(&cap, 4000);
        }
    }
    if !tuis_has(&cap, "\x1b[?1049l" as &const byte) {
        tuis_fail(tag, "退出时没有离开备用屏幕（ESC[?1049l）", &ok);
    }
    // P22：退出时弹标题栈，而且必须在最后一条 OSC 2 之后
    if !tuis_has(&cap, "\x1b[23t" as &const byte) {
        tuis_fail(tag, "退出时没有弹标题栈（ESC[23t）", &ok);
    } else if tuis_last_at(&cap, "\x1b[23t" as &const byte) < tuis_last_at(&cap, "\x1b]2;" as &const byte) {
        tuis_fail(tag, "弹标题栈出现在标题之前（顺序反了）", &ok);
    }
    // termios 逐位还原
    if have_before {
        var after: [byte: 60] = [0: 60];
        if !tuis_get_termios(m, &after[0]) {
            tuis_fail(tag, "退出后读不到 pty termios", &ok);
        } else if !tuis_termios_equal(&before[0], &after[0]) {
            tuis_fail(tag, "退出后 termios 没有与 fork 前逐位相同（raw 模式没还原）", &ok);
        }
    }
    _ = sys_close(m) catch {};
    const mock_rc: i32 = wait_child(mpid);
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错", &ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
        tuis_dump_cap(&cap, 500);
        tuis_dump_tail(&cap, 800);
    }

    if ok {
        tuis_ok(tag, "真 PTY：备用屏幕进出 + 帧内容 + SIGWINCH 存活 + /exit 退出 + termios 逐位还原 + 终端标题（压栈/基标题/跟随会话标题/弹栈）");
    }
    return ok;
}
