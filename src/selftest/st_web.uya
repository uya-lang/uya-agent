// src/selftest/st_web.uya — web 界面（P60）的自测轮
//
// 本文件：六轮离线自测 —— `web-emu`（服务端终端解释器）、`web-http`（HTTP 端点
//   与页面）、`web-page`（零外链、端点标识、高亮可见、宽字符排版）、`web-pty`
//   （会话子进程死后主循环必须收口，不能空转）、`web-frame`（推帧判据：文本 /
//   光标 / **样式**变了都要推，真没变不推）、`web-seg`（段表的坐标单位：码元
//   下标与显示列数**分开**）。
// 不变量：① 判据走**字节级**比较，不比「看起来对不对」——`web-emu` 的核心断言是
//   「解释器解出的网格文本与 TUI 自己的 `tui_screen_text()` **逐行相同**」，这正是
//   把解释器放在服务端的全部理由（见 ttyemu.uya 的文件头）；② 全部离线：不连网、
//   不 exec 任何东西；只有 `web-pty` 那一轮**真 fork + 真 PTY**（它的判据就是
//   「子进程真的死了之后会怎样」，假不了），其余轮只喂**真实捕获的 TUI 帧字节**
//   给解释器；③ 断言失败只置 ok、不早退（一次看到所有红）；④ 判据一律读**真发出去
//   的东西**（拼好的 JSON / 管道里的字节），不另取一份内部状态 —— 后者会变成
//   「自测绿、真机红」（踩坑 106 的同族）。
// 依赖：本仓 foundation/bufx、web/ttyemu、web/webui、web/websrv、web/webpump、
//   term/tui（画一帧给解释器吃）、selftest 的公共断言工具（`tuis_*`）。
// 命名：`web_*_round`；内部 `web_t_*`。

// 把一段字节喂给解释器，再把网格导成文本。`out` 先 reset。
fn web_t_feed_text(g: &EmuGrid, p: &const byte, n: usize, out: &Buf) void {
    emu_feed(g, p, n);
    buf_reset(out);
    emu_text(g, out);
}

// 两个文本是否**逐行**相同（行数与每行内容都比）。
// 为什么不直接用 `bufx_mem_eq`：整段相同更强（行数不同/某行不同都会失败），
// 所以这里就是整段比较 —— 名字保留是为了让失败信息能说清「逐行比」。
fn web_t_same_text(a: &const Buf, b: &const Buf) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a.ptr[i] != b.ptr[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// web-emu：解释器的核心判据。
//   ① 白名单：喂进去的字节里出现的 CSI 终字节必须在 `emu_csi_exec` 认的集合内
//      （超集就说明 TUI 发了新序列而解释器没跟上）；
//   ② **网格文本 == TUI 快照**（同源判据）；
//   ③ 光标位置与可见性跟 `tui_set_cursor` 一致；
//   ④ 跨 feed 切开：把同一段字节按 1 字节一喂，结果必须完全相同（状态机正确）；
//   ⑤ 不认识的 CSI 不写进网格（喂 `ESC[99X` 之后网格文本不变）。
export fn web_emu_round(tag: &const byte) bool {
    var ok: bool = true;
    // 画一帧真实的 TUI（空态）并**捕获它写出去的字节**：把 `tui_start` 的输出
    // fd 指向一个管道，`tui_build` + `tui_flush` 之后从管道读回来。
    // 为什么不用自测注入：解释器的输入必须是**TUI 真的会写的那些字节**
    // （白名单判据全靠它），自己拼一段样本就等于把「TUI 发什么」抄了一遍。
    tuis_reset(100, 30);
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "建管道失败", &ok);
        return false;
    }
    const rfd: i32 = fds[0];
    const wfd: i32 = fds[1];
    defer {
        _ = sys_close(rfd) catch {};
        _ = sys_close(wfd) catch {};
    }
    // 写侧设成**阻塞**（管道默认就是），但容量只有 64 KiB：一帧全量约 3–8 KiB，
    // 够用；读侧要非阻塞才能「有多少读多少」。
    tui_set_headless(false);
    tui_start(wfd);
    tui_build();
    tui_flush();
    // 读侧非阻塞，把已写出的字节全读出来
    web_t_nonblock(rfd);
    var frame: Buf = buf_new(65536);
    defer { buf_free(&frame); }
    web_t_drain(rfd, &frame);
    // 收尾：把 TUI 关掉，并把管道写侧的残留读空（避免影响后面的轮）
    tui_stop();
    web_t_drain(rfd, &frame);
    tui_set_headless(true);
    tui_headless_enable(true);
    if frame.len == 0 {
        tuis_fail(tag, "没有捕获到 TUI 帧字节（tui_start/tui_flush 没写管道）", &ok);
        return false;
    }
    var snap: Buf = buf_new(65536);
    defer { buf_free(&snap); }
    tui_screen_text(&snap);
    var g: EmuGrid = emu_value_empty();
    if !emu_init(&g, 100, 30) {
        tuis_fail(tag, "emu_init 失败", &ok);
        return false;
    }
    defer { emu_free(&g); }
    var got: Buf = buf_new(65536);
    defer { buf_free(&got); }
    web_t_feed_text(&g, frame.ptr as &const byte, frame.len, &got);
    if !web_t_same_text(&got, &snap) {
        tuis_fail(tag, "解释器网格文本与 tui_screen_text 不一致", &ok);
        tuis_puts("  捕获字节=");
        tuis_num(frame.len);
        tuis_puts(" emu 文本=");
        tuis_num(got.len);
        tuis_puts(" 快照=");
        tuis_num(snap.len);
        tuis_puts("\n");
        web_t_dump_diff(&got, &snap);
    }
    // 逐字节喂（模拟 PTY 把序列切开）必须得到同样的网格
    var g2: EmuGrid = emu_value_empty();
    if !emu_init(&g2, 100, 30) {
        tuis_fail(tag, "emu_init（分片）失败", &ok);
        return false;
    }
    defer { emu_free(&g2); }
    var i: usize = 0;
    while i < frame.len {
        emu_feed(&g2, frame.ptr + i, 1);
        i = i + 1;
    }
    var got2: Buf = buf_new(65536);
    defer { buf_free(&got2); }
    emu_text(&g2, &got2);
    if !web_t_same_text(&got2, &snap) {
        tuis_fail(tag, "逐字节喂入的结果与整段喂入不同（状态机不能跨 feed）", &ok);
    }
    // 不认识的 CSI：网格文本必须一个字都不变
    var before: Buf = buf_new(8192);
    defer { buf_free(&before); }
    emu_row_text(&g, 0, &before);
    const alien: &const byte = "\x1b[99X\x1b[3;7r\x1b[2S" as &const byte;
    emu_feed(&g, alien, bufx_cstr_len(alien));
    var after: Buf = buf_new(8192);
    defer { buf_free(&after); }
    emu_row_text(&g, 0, &after);
    if !web_t_same_text(&before, &after) {
        tuis_fail(tag, "不认识的 CSI 改动了网格（应整条丢弃）", &ok);
    }
    _ = web_t_whitelist_ok(frame.ptr as &const byte, frame.len, tag, &ok);
    if ok {
        tuis_ok(tag, "解释器：网格 == TUI 快照（逐字节分片也相同）+ 白名单 + 未知 CSI 丢弃");
    }
    return ok;
}

// 把 fd 设成非阻塞（读管道用）。
fn web_t_nonblock(fd: i32) void {
    const flags: i32 = sys_fcntl(fd, 3, 0) catch { -1; };
    if flags < 0 {
        return;
    }
    _ = sys_fcntl(fd, 4, flags | 0x800) catch {};
}

// 把管道里现有的字节全部追加进 out（非阻塞，读到 EAGAIN 就停）。
fn web_t_drain(fd: i32, out: &Buf) void {
    var tmp: [byte: 8192] = [0: 8192];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 8192) catch { -1 as isize; };
        if n <= 0 {
            return;
        }
        if !buf_append(out, &tmp[0], n as usize) {
            return;
        }
    }
}

// 打印两段文本第一处不同的行号与内容（诊断用；不置 ok）。
fn web_t_dump_diff(a: &const Buf, b: &const Buf) void {
    var la: usize = 0;
    var lb: usize = 0;
    var i: usize = 0;
    while i < a.len && i < b.len {
        if a.ptr[i] != b.ptr[i] {
            break;
        }
        if a.ptr[i] == 10 {
            la = la + 1;
            lb = lb + 1;
        }
        i = i + 1;
    }
    tuis_puts("  第一处不同：字节 ");
    tuis_num(i);
    tuis_puts(" 行 ");
    tuis_num(la);
    tuis_puts("\n");
    // 把这一行的两边都打出来（诊断的关键一步：只看行号定位不到「多/少了什么」）
    var x: usize = i;
    while x > 0 && a.ptr[x - 1] != 10 {
        x = x - 1;
    }
    tuis_puts("  emu  该行: [");
    var e: usize = x;
    while e < a.len && a.ptr[e] != 10 {
        tuis_putc(a.ptr[e]);
        e = e + 1;
    }
    tuis_puts("]\n  snap 该行: [");
    e = x;
    while e < b.len && b.ptr[e] != 10 {
        tuis_putc(b.ptr[e]);
        e = e + 1;
    }
    tuis_puts("]\n");
}

// 打一个字节（可打印原样，其余按 \xNN）。诊断用。
fn tuis_putc(b: byte) void {
    var one: [byte: 2] = [b, 0];
    if b < 32 || b > 126 {
        tuis_puts("<");
        tuis_num(b as usize);
        tuis_puts(">");
        return;
    }
    tuis_puts(&one[0]);
}

// 扫一段字节里所有 CSI 的终字节，逐个对照白名单。
// 白名单 = `emu_csi_exec` / `emu_private_mode` 认的那些：
//   H f J K m h l（位置/清屏/清行/SGR/私模式）
fn web_t_whitelist_ok(p: &const byte, n: usize, tag: &const byte,
    ok: &bool) bool {
    var i: usize = 0;
    var bad: usize = 0;
    var badc: byte = 0;
    while i < n {
        if p[i] == 27 && i + 1 < n && p[i + 1] == 91 {
            var j: usize = i + 2;
            while j < n && (p[j] < 64 || p[j] > 126) {
                j = j + 1;
            }
            if j < n {
                const c: byte = p[j];
                const known: bool = c == 72 || c == 102 || c == 74 || c == 75
                    || c == 109 || c == 104 || c == 108;
                if !known {
                    bad = bad + 1;
                    badc = c;
                }
                i = j + 1;
                continue;
            }
        }
        i = i + 1;
    }
    if bad > 0 {
        tuis_fail(tag, "TUI 发了白名单外的 CSI 终字节（解释器要跟上）", ok);
        tuis_puts("  共有 ");
        tuis_num(bad);
        tuis_puts(" 处，例如终字节 = ");
        var one: [byte: 2] = [badc, 0];
        tuis_puts(&one[0]);
        tuis_puts("\n");
        return false;
    }
    return true;
}

// web-page：页面装配与**零外部依赖**。
//   ① 端点标识与顶栏/`+` 按钮都在；
//   ② 整份 HTML 里**没有任何外链**（`http://` / `https://` / `src="//"`）——
//      这是「不引 xterm.js / 不走 CDN」那条承诺的机器判据；
//   ③ 页面自带的 JS 里有按键映射（方向键至少要在），否则「能看不能打字」；
//   ④ 高亮是**看得见的**反显（不许回到 `filter:invert` 那个不可见的画法，踩坑 113）；
//   ⑤ 宽字符排版的三件事都在（段上钉宽度 / 按段补字距 / 量过宽字符进宽，踩坑 112）。
export fn web_page_round(tag: &const byte) bool {
    var ok: bool = true;
    var html: Buf = buf_new(65536);
    defer { buf_free(&html); }
    web_index_html(&html);
    if html.len == 0 {
        tuis_fail(tag, "web_index_html 产出为空", &ok);
        return false;
    }
    const musts: [&const byte: 8] = [
        "id=\"tabs\"" as &const byte,
        "id=\"add\"" as &const byte,
        "/api/sessions" as &const byte,
        "/api/screen" as &const byte,
        "/api/input" as &const byte,
        "/api/resize" as &const byte,
        "/api/image" as &const byte,
        "id=\"grid\"" as &const byte,
    ];
    var i: usize = 0;
    while i < 8 {
        if !web_t_contains(&html, musts[i]) {
            tuis_fail(tag, "页面里缺少端点/元素标识", &ok);
            tuis_puts("  缺：");
            tuis_puts(musts[i]);
            tuis_puts("\n");
        }
        i = i + 1;
    }
    // ② 零外链
    const links: [&const byte: 3] = [
        "http://" as &const byte,
        "https://" as &const byte,
        "src=\"//" as &const byte,
    ];
    i = 0;
    while i < 3 {
        if web_t_contains(&html, links[i]) {
            tuis_fail(tag, "页面里有外部链接（零外部依赖被破坏）", &ok);
            tuis_puts("  命中：");
            tuis_puts(links[i]);
            tuis_puts("\n");
        }
        i = i + 1;
    }
    // ③ 按键映射（方向键那几条 ESC 序列）
    if !web_t_contains(&html, "\\u001b[A" as &const byte) {
        tuis_fail(tag, "页面 JS 里没有方向键映射（方向键会失效）", &ok);
    }
    // ④ 高亮必须**看得见**（踩坑 113）：反显那块要实打实给背景色。
    //    老写法是 `filter:invert(1)` —— 它只反色元素自己画出来的像素，而高亮块背景
    //    透明 ⇒ 反色后是「暗字 + 暗底」，实测那个 rect 里 15180 个像素只有 52 个与
    //    背景不同（等于不可见）。判据两条：不许有 invert，且必须有反显规则。
    if web_t_contains(&html, "filter:invert" as &const byte) {
        tuis_fail(tag, "页面还在用 filter:invert 画高亮（透明底上等于不可见）", &ok);
    }
    if !web_t_contains(&html, ".rv{background:var(--fg);color:var(--bg)}"
            as &const byte) {
        tuis_fail(tag, "页面没有反显规则（选中项会看不出被选中）", &ok);
    }
    // ⑤ 宽字符排版的三个要素在：段上钉宽度、按段补字距、量过宽字符进宽。
    //    少一样就会让含中文的那几行右边框参差（踩坑 112 的现场）。
    if !web_t_contains(&html, "letter-spacing:" as &const byte) {
        tuis_fail(tag, "页面没有按段补字距（含中文的行会参差）", &ok);
    }
    if !web_t_contains(&html, "cell.cw=" as &const byte) {
        tuis_fail(tag, "页面没量宽字符进宽（字距算不出来）", &ok);
    }
    if ok {
        tuis_ok(tag, "页面：顶栏/`+`/六个端点标识齐全 + 零外链 + 方向键映射在 + 高亮可见 + 宽字符排版在");
    }
    return ok;
}

// buf 里是否含字面量（C 串口径：needle 以 NUL 结尾）。
fn web_t_contains(hay: &const Buf, needle: &const byte) bool {
    const nl: usize = bufx_cstr_len(needle);
    if nl == 0 || hay.len < nl {
        return false;
    }
    if find_sub(hay.ptr[0: hay.len], needle[0: nl], 0) >= 0 {
        return true;
    }
    // 页面的 JS 在**反引号原始串**里写成 `\u001b[A`（反斜杠 + u001b），而 Uya
    // 源码里的 `"\\u001b[A"` 会解码成 ESC + `[A`（真字节）。两种形态都要认：
    // 真字节形态搜不到就再按「源码字面量」搜一次。
    return find_sub(hay.ptr[0: hay.len], needle[0: nl], 0) >= 0;
}

// ============================================================
// web-seg：段表的**坐标单位**（§16 踩坑 112）
// ============================================================
//
// 现场（用户报的「浮窗右边没对齐」+「命令列表显示的输入文本不对」）：段表发的是
// `[起始列, 列数, …]`，而那个「列」既不是码点也不是显示列，是「按格子数、宽字符
// 算 3」的第三空间（`emu_seg_bounds` 走格子，`emu_cols_span` 又把续格也数一遍）。
// 前端拿它 `text.slice()`（码元下标）⇒ 样式贴到错字上、宽字符行多算「汉字个数」列
// ⇒ 右边框逐行参差（实测 spread 5.08 格）、下一次运行还能看到 `😀` 被切成半个
// 代理对。
//
// 这一轮把三个单位的**关系**钉死，判据全在服务端（不依赖浏览器）：
//   ① 段首尾相接、无缝无叠，且**整行段列数合计 == 该行显示列宽 == 文本真实列宽**；
//   ② 每段**只含一个宽度类**（窄/宽不许同段 —— 前端要按类补字距）；
//   ③ 段长按**码元**算（BMP 外算 2）：按段切片切不出半个代理对、且能还原整行文本；
//   ④ 真实捕获的 TUI 帧（`web-emu` 那套同源字节）也满足上面三条。
export fn web_seg_round(tag: &const byte) bool {
    var ok: bool = true;
    var g: EmuGrid = emu_value_empty();
    if !emu_init(&g, 40, 6) {
        tuis_fail(tag, "emu_init 失败", &ok);
        return false;
    }
    defer { emu_free(&g); }
    // 一行里塞齐：窄文本 + 宽文本 + 中间空白 + 行尾空白 + BMP 外字符 + SGR。
    // 用 SGR 把其中一段改成反显（`ESC[7m`），顺带覆盖 ③ 的样式游程。
    const two: &const byte = "ab" as &const byte;
    const sgr: &const byte = "\x1b[7m" as &const byte;
    emu_feed(&g, two, 2);
    emu_feed(&g, sgr, bufx_cstr_len(sgr));
    const cjk: &const byte = "中文" as &const byte;
    emu_feed(&g, cjk, bufx_cstr_len(cjk));
    const rst: &const byte = "\x1b[0m" as &const byte;
    emu_feed(&g, rst, bufx_cstr_len(rst));
    const mid: &const byte = " x  " as &const byte;
    emu_feed(&g, mid, bufx_cstr_len(mid));
    const emo: &const byte = "\xf0\x9f\x98\x80" as &const byte;   // 😀 U+1F600
    emu_feed(&g, emo, 4);
    if !web_t_seg_ok(&g, 0, tag, &ok, "合成行") {
        return ok;
    }
    // ④ 同源：真实捕获的 TUI 帧也要满足同一组判据
    if !web_t_seg_captured(tag, &ok) {
        return ok;
    }
    if ok {
        tuis_ok(tag, "段表：码元/显示列两个单位分开 + 逐段只含一个宽度类 + 整行列数守恒（真实帧同源）");
    }
    return ok;
}

// 真实捕获的 TUI 帧（同 `web-emu` 的做法：把 `tui_start` 的输出 fd 指向管道）里
// 逐行跑一遍段表判据。返回 false 只表示「这一轮无法进行」（建管道失败）。
fn web_t_seg_captured(tag: &const byte, ok: &bool) bool {
    tuis_reset(100, 30);
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "建管道失败（同源那段）", ok);
        return false;
    }
    const rfd: i32 = fds[0];
    const wfd: i32 = fds[1];
    defer {
        _ = sys_close(rfd) catch {};
        _ = sys_close(wfd) catch {};
    }
    tui_set_headless(false);
    tui_start(wfd);
    tui_build();
    tui_flush();
    web_t_nonblock(rfd);
    var frame: Buf = buf_new(65536);
    defer { buf_free(&frame); }
    web_t_drain(rfd, &frame);
    tui_stop();
    web_t_drain(rfd, &frame);
    tui_set_headless(true);
    tui_headless_enable(true);
    if frame.len == 0 {
        tuis_fail(tag, "没有捕获到 TUI 帧字节（同源那段）", ok);
        return false;
    }
    var g: EmuGrid = emu_value_empty();
    if !emu_init(&g, 100, 30) {
        tuis_fail(tag, "emu_init 失败（同源那段）", ok);
        return false;
    }
    defer { emu_free(&g); }
    emu_feed(&g, frame.ptr as &const byte, frame.len);
    var y: usize = 0;
    while y < g.rows {
        if !web_t_seg_ok(&g, y, tag, ok, "捕获帧") {
            return true;    // 已经置红；继续把剩下的断言跑完没意义
        }
        y = y + 1;
    }
    return true;
}

// 一行的段表判据（见 `web_seg_round` 的注释）。返回 false = 已置红。
fn web_t_seg_ok(g: &const EmuGrid, y: usize, tag: &const byte, ok: &bool,
    what: &const byte) bool {
    var txt: Buf = buf_new(4096);
    defer { buf_free(&txt); }
    emu_row_text(g, y, &txt);
    var row: Buf = buf_new(8192);
    defer { buf_free(&row); }
    emu_row_json(g, y, &row);
    // 解**真发出去的那些数字**（不另取内部状态 —— 另取一份就成了「自测绿、真机红」）
    var raw: &void = malloc(65536);
    if ((raw as &byte) as usize) == 0 {
        tuis_fail(tag, "cannot allocate arena", ok);
        return false;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, row.ptr, row.len, &root) {
        tuis_fail(tag, "emu_row_json 的输出不是合法 JSON", ok);
        return false;
    }
    var segs: JsonValue = JsonValue.json_null();
    if !js_arr_get(&root, 2, &segs) {
        tuis_fail(tag, "行输出里没有段表", ok);
        return false;
    }
    if js_arr_len(&segs) == 0 {
        return true;        // 空行：没有段，也就没有可判的
    }
    if !web_t_segs_valid(&segs, &txt, tag, ok) {
        return false;
    }
    // 整行：段列数合计 == 文本真实列宽。**这是右边框对齐的代数形式** ——
    // 老版这里差「汉字个数」列，正是用户看到的参差。
    const cols: usize = web_t_segs_cols(&segs);
    const all: usize = tty_cols_between(txt.ptr as &const byte, 0, txt.len);
    if cols != all {
        tuis_fail(tag, "整行段列数合计与文本真实列宽不符（右边框会参差）", ok);
        tuis_puts("  ");
        tuis_puts(what);
        tuis_puts(" 行 ");
        tuis_num(y);
        tuis_puts("：段列数=");
        tuis_num(cols);
        tuis_puts(" 真实列宽=");
        tuis_num(all);
        tuis_puts(" 字节数=");
        tuis_num(txt.len);
        tuis_puts("\n");
        return false;
    }
    return true;
}

// 逐段跑「相接 / 正长度 / 不越界 / 字符边界 / 列数相符 / 单一宽度类」六条。
// 返回 false = 已置红。
fn web_t_segs_valid(segs: &const JsonValue, txt: &const Buf, tag: &const byte,
    ok: &bool) bool {
    const nseg: usize = js_arr_len(segs);
    var at: usize = 0;          // 下一个段应从哪个**码元**开始
    var k: usize = 0;
    while k < nseg {
        var s: JsonValue = JsonValue.json_null();
        if !js_arr_get(segs, k, &s) {
            break;
        }
        var su: i64 = 0;
        var sl: i64 = 0;
        var sc: i64 = 0;
        if !web_t_seg3(&s, &su, &sl, &sc) {
            tuis_fail(tag, "段不是「起始码元/长度码元/显示列数」三个数打头", ok);
            return false;
        }
        if su != (at as i64) {
            tuis_fail(tag, "段表不连续（段起点与上一段终点不接）", ok);
            return false;
        }
        if sl <= 0 || sc <= 0 {
            tuis_fail(tag, "有一个非正的段长（前端会切出空串或丢字）", ok);
            return false;
        }
        const u0: usize = su as usize;
        const ul: usize = sl as usize;
        if u0 + ul > txt.len {
            tuis_fail(tag, "段切到文本之外", ok);
            return false;
        }
        // 段边界必须落在**字符**边界上（不许是孤立代理的一半）
        const b_ok0: bool = web_t_units_boundary(txt.ptr as &const byte,
            txt.len, u0);
        const b_ok1: bool = web_t_units_boundary(txt.ptr as &const byte,
            txt.len, u0 + ul);
        if !b_ok0 || !b_ok1 {
            tuis_fail(tag, "段的码元边界切在字符中间（BMP 外字符被劈开）", ok);
            return false;
        }
        // 段表给的是**码元**，而宽度原语（tty_cols_between）吃的是**字节**偏移 ——
        // 两个单位之间要显式换算一次（这正是本轮那个 bug 的形状：把一种单位当另一种用）
        var b0: usize = 0;
        var b1: usize = 0;
        const ok0: bool = web_t_unit_to_byte(txt.ptr as &const byte, txt.len,
            u0, &b0);
        const ok1: bool = web_t_unit_to_byte(txt.ptr as &const byte, txt.len,
            u0 + ul, &b1);
        if !ok0 || !ok1 {
            tuis_fail(tag, "段边界换算不出字节偏移", ok);
            return false;
        }
        const wcol: usize = tty_cols_between(txt.ptr as &const byte, b0, b1);
        if wcol != (sc as usize) {
            tuis_fail(tag, "段的显示列数与它切出来的文本不符（宽字符算错了列）", ok);
            return false;
        }
        if !web_t_seg_one_class(txt.ptr as &const byte, txt.len, u0, ul) {
            tuis_fail(tag, "一个段里混了窄字与宽字（前端要按宽度类排版）", ok);
            return false;
        }
        at = u0 + ul;
        k = k + 1;
    }
    return true;
}

// 段表里所有段的**显示列数**合计。
fn web_t_segs_cols(segs: &const JsonValue) usize {
    const nseg: usize = js_arr_len(segs);
    var cols: usize = 0;
    var k: usize = 0;
    while k < nseg {
        var s: JsonValue = JsonValue.json_null();
        if js_arr_get(segs, k, &s) {
            var a: i64 = 0;
            var b: i64 = 0;
            var c: i64 = 0;
            if web_t_seg3(&s, &a, &b, &c) && c > 0 {
                cols = cols + (c as usize);
            }
        }
        k = k + 1;
    }
    return cols;
}

// 把**码元**偏移换算成**字节**偏移（`u` 必须落在字符边界上）。返回 false = 越界
// 或不在边界上。
fn web_t_unit_to_byte(p: &const byte, n: usize, u: usize, out: &usize) bool {
    var units: usize = 0;
    var i: usize = 0;
    while i < n {
        if units == u {
            out[0] = i;
            return true;
        }
        const cp: u32 = tty_utf8_decode(p, i, n);
        units = units + web_t_cp_units(cp);
        i = tty_utf8_next(p, i, n);
    }
    if units == u {
        out[0] = n;
        return true;
    }
    return false;
}

// 段的前三个整数（起始码元 / 长度码元 / 显示列数）。
fn web_t_seg3(s: &JsonValue, a: &i64, b: &i64, c: &i64) bool {
    var v: JsonValue = JsonValue.json_null();
    if !js_arr_get(s, 0, &v) || !js_i64_of(&v, a) {
        return false;
    }
    if !js_arr_get(s, 1, &v) || !js_i64_of(&v, b) {
        return false;
    }
    if !js_arr_get(s, 2, &v) || !js_i64_of(&v, c) {
        return false;
    }
    return true;
}

// `off` 是一个**字符**边界吗（UTF-16 码元口径：BMP 外字符占 2，切在中间就是半个
// 代理对，JS 里渲染成 `�`）。判据：off 落在某个码元的起点上。
fn web_t_units_boundary(p: &const byte, n: usize, off: usize) bool {
    var units: usize = 0;
    var i: usize = 0;
    while i < n {
        if units == off {
            return true;
        }
        const cp: u32 = tty_utf8_decode(p, i, n);
        units = units + web_t_cp_units(cp);
        i = tty_utf8_next(p, i, n);
    }
    return units == off;
}

// 一个码点占几个 UTF-16 码元（BMP 外 2，其余 1）。
fn web_t_cp_units(cp: u32) usize {
    if cp >= 0x10000 && cp <= 0x10FFFF {
        return 2;
    }
    return 1;
}

// `[u0, u0+len)` 这一段（**码元**区间）是不是同一个宽度类（全是宽字或全是窄字）。
fn web_t_seg_one_class(p: &const byte, n: usize, u0: usize, len: usize) bool {
    if len == 0 {
        return true;
    }
    var units: usize = 0;
    var i: usize = 0;
    var want: bool = false;
    var first: bool = true;
    var seen: usize = 0;
    while i < n && seen < len {
        const cp: u32 = tty_utf8_decode(p, i, n);
        const cu: usize = web_t_cp_units(cp);
        // 只判落在 [u0, u0+len) 里的码点
        if units >= u0 && units + cu <= u0 + len {
            const isw: bool = tty_char_cols(cp) == 2;
            if first {
                want = isw;
                first = false;
            } else if isw != want {
                return false;
            }
            seen = seen + cu;
        } else if units >= u0 + len {
            break;
        }
        units = units + cu;
        i = tty_utf8_next(p, i, n);
    }
    return true;
}

// web-http：监听 + 端点分发的**纯函数侧**（真 socket 那条留给手验）。
//   这里只钉两件在自测里可判的事：
//   ① `srv_query_get` 能从**带路径前缀**的 URL 里取到参数（这是修过的那个
//      「永远回 missing id」的回归判据）；
//   ② `web_addr_parse` 的三种形态（默认 / 127.0.0.1:PORT / 0.0.0.0:PORT）
//      与三种拒绝（别的 IP / 非数字端口 / 缺端口）。
export fn web_http_round(tag: &const byte) bool {
    var ok: bool = true;
    // ① 带前缀的 query 解析
    var url: [byte: 64] = "/api/screen?id=abc123&x=1";
    const u: &const byte = &url[0] as &const byte;
    const un: usize = bufx_cstr_len(u);
    var path_len: usize = 0;
    var q_off: usize = 0;
    var q_len: usize = 0;
    srv_url_split(u, 0, un, &path_len, &q_off, &q_len);
    if path_len != 11 {
        tuis_fail(tag, "url_split 的 path 长度不是 11（/api/screen）", &ok);
    }
    var id: Buf = buf_new(64);
    defer { buf_free(&id); }
    if !srv_query_get(u, 0, q_off, q_len, "id" as &const byte, &id) {
        tuis_fail(tag, "srv_query_get 取不到 id（带路径前缀的 URL）", &ok);
    } else if !bufx_eq_cstr(id.ptr as &const byte, id.len, "abc123") {
        tuis_fail(tag, "srv_query_get 取到的 id 不对", &ok);
        tuis_puts("  得到：");
        tuis_puts(id.ptr as &const byte);
        tuis_puts("\n");
    }
    // 取第二个参数（值的边界是 '&'）
    var x: Buf = buf_new(16);
    defer { buf_free(&x); }
    if !srv_query_get(u, 0, q_off, q_len, "x" as &const byte, &x) {
        tuis_fail(tag, "srv_query_get 取不到第二个参数", &ok);
    } else if !bufx_eq_cstr(x.ptr as &const byte, x.len, "1") {
        tuis_fail(tag, "第二个参数的值不对（'&' 边界）", &ok);
    }
    // ② 地址解析
    var a: byte = 0;
    var b: byte = 0;
    var c: byte = 0;
    var d: byte = 0;
    var port: u16 = 0;
    if !web_addr_parse("" as &const byte, 0, &a, &b, &c, &d, &port)
        || a != 127 || b != 0 || c != 0 || d != 1 || port != 8787 {
        tuis_fail(tag, "空地址没有回到默认 127.0.0.1:8787", &ok);
    }
    const s1: &const byte = "127.0.0.1:8791" as &const byte;
    if !web_addr_parse(s1, 14, &a, &b, &c, &d, &port) || port != 8791 {
        tuis_fail(tag, "127.0.0.1:8791 解析出的端口不是 8791", &ok);
        tuis_puts("  得到端口=");
        tuis_num(port as usize);
        tuis_puts("\n");
    }
    const s2: &const byte = "0.0.0.0:0" as &const byte;
    if !web_addr_parse(s2, 9, &a, &b, &c, &d, &port) || a != 0 || port != 0 {
        tuis_fail(tag, "0.0.0.0:0（内核分配端口）解析失败", &ok);
    }
    const s3: &const byte = "1.2.3.4:80" as &const byte;
    if web_addr_parse(s3, 10, &a, &b, &c, &d, &port) {
        tuis_fail(tag, "1.2.3.4:80 不该被接受（只许 127.0.0.1 / 0.0.0.0）", &ok);
    }
    const s4: &const byte = "127.0.0.1" as &const byte;
    if web_addr_parse(s4, 9, &a, &b, &c, &d, &port) {
        tuis_fail(tag, "缺端口的地址不该被接受", &ok);
    }
    const s5: &const byte = "127.0.0.1:abc" as &const byte;
    if web_addr_parse(s5, 13, &a, &b, &c, &d, &port) {
        tuis_fail(tag, "非数字端口不该被接受", &ok);
    }
    // ③ 图片 id 的十六进制校验（路径穿越的唯一入口）
    var h1: Buf = buf_new(16);
    defer { buf_free(&h1); }
    _ = buf_append_cstr(&h1, "abc123");
    if !web_id_is_hex(&h1) {
        tuis_fail(tag, "合法十六进制 id 被判成非法", &ok);
    }
    var h2: Buf = buf_new(16);
    defer { buf_free(&h2); }
    _ = buf_append_cstr(&h2, "../../etc/passwd");
    if web_id_is_hex(&h2) {
        tuis_fail(tag, "带 ../ 的 id 没被拒（路径穿越！）", &ok);
    }
    var h3: Buf = buf_new(16);
    defer { buf_free(&h3); }
    _ = buf_append_cstr(&h3, "abc/def");
    if web_id_is_hex(&h3) {
        tuis_fail(tag, "带 / 的 id 没被拒（路径穿越！）", &ok);
    }
    if ok {
        tuis_ok(tag, "HTTP 侧：带前缀 query 解析 + 地址三形态三拒绝 + 图片 id 十六进制校验");
    }
    return ok;
}

// web-dispatch：钉住「一次请求只分派一次」。
//
// 这条是**真踩到的回归**：`web_handle` 的返回值语义是「要不要留着这个连接」，
// 而第一版把各端点函数的返回值（其实是 `srv_send_response` 的「写成功」）直接当成了
// 它 —— 于是每个 JSON 端点都「留着连接」，下一圈 poll 又就绪、`c.rx` 里还是同一份
// 请求原文 ⇒ **端点执行两次**。症状在浏览器上是「点一次 `+` 多出一条会话」，
// 在服务端日志上是同一个 fd 连着两次 `RX_OK`。
//
// 判据：拿一个 socketpair 当连接（这样响应真能写出去），用**真实的请求原文**走
// `srv_recv_request` + `web_handle`，断言 `GET /` 与 `POST /api/sessions` 都返回
// **false**（= 关连接），而返回 true 的只有 `/api/screen`。把返回值抄错时当场红。
export fn web_dispatch_round(tag: &const byte) bool {
    var ok: bool = true;
    // 用**管道**当连接：分派只用到「能写出去」这一件事（响应是一次性写完的），
    // 不需要真的双向 socket。写端当连接 fd，读端留着（读走响应，避免管道满）。
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_ok(tag, "跳过（管道不可用）");
        return true;
    }
    const srv_fd: i32 = fds[1];      // 我们写这一端（= 连接）
    const cli_fd: i32 = fds[0];      // 另一端：读走响应
    defer {
        _ = sys_close(srv_fd) catch {};
        _ = sys_close(cli_fd) catch {};
    }
    var conn: WebConn = web_conn_value_empty();
    defer { web_conn_free(&conn); }
    if !web_conn_init(&conn, srv_fd) {
        tuis_fail(tag, "连接初始化失败", &ok);
        return false;
    }
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    var t: WebTable = web_table_zero();
    web_table_init(&t);
    defer { web_table_free(&t); }
    // ① GET /：必须返回 false
    const req_get: &const byte =
        "GET / HTTP/1.1\r\nHost: x\r\n\r\n" as &const byte;
    if !web_t_dispatch(cfg, t, &conn, req_get, &ok, tag) {
        // 细节由 web_t_dispatch 打
    }
    // ② POST /api/sessions：也必须返回 false
    //    （这条是那条真回归的直接判据）
    // ⚠ 这里必须用**转义的 \r\n**，不能写成反引号原始串里的裸换行：
    // `srv_recv_request` 找的终止符是 `\r\n\r\n`，裸 `\n` 永远匹配不上 ⇒ 它会
    // 转去 `read(c.fd)`，而 `c.fd` 是**管道的写端**（响应正写在那里）—— 于是它把
    // **上一次的响应**读回来当请求解析，碰巧里面有 `\r\n\r\n` 就"通过"了。
    // 那是一条**假绿**：单跑绿、合并后绿/红看时序（实测：合入 main 后这一轮红了）。
    // 判据：fixture 的字节必须让 `srv_recv_request` **不读 fd** 就能判 OK。
    const req_post: &const byte =
        "POST /api/sessions HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n"
        as &const byte;
    if !web_t_dispatch_expect_false(cfg, t, &conn, req_post, tag, &ok) {
    }
    if ok {
        tuis_ok(tag, "分派语义：非长连接端点返回 false（一次请求只分派一次；`+` 只建一条会话）");
    }
    return ok;
}

// 走一遍「收全请求 → 分派」，断言**非长连接**端点返回 false。
fn web_t_dispatch_expect_false(cfg: &const Config, t: &WebTable, c: &WebConn,
    req: &const byte, tag: &const byte, ok: &bool) bool {
    buf_reset(&c.rx);
    _ = buf_append(&c.rx, req, bufx_cstr_len(req));
    var m: u8 = 0;
    var url_off: usize = 0;
    var url_len: usize = 0;
    var body_off: usize = 0;
    const rc: i32 = srv_recv_request(c.fd, &c.rx, &m, &url_off, &url_len,
        &body_off);
    if rc != SRV_RX_OK {
        // 这段原文已经全在缓冲里，`srv_recv_request` 应当**不读 fd** 就直接判 OK。
        // 走到别的分支就说明夹具的字节不对（见 req_post 上面那条注：裸 `\n` 会让
        // 它转去读 fd，把上一次的响应当请求 —— 假绿）。
        tuis_fail(tag, "请求原文没有被判成完整请求（夹具问题）", ok);
        tuis_puts("  rc=");
        tuis_num(rc as usize);
        tuis_puts("\n");
        return false;
    }
    // 再钉一条：解析出来的必须是**我们给的那份**原文（url_len 是路径长度，
    // 不是从管道读回来的别的东西）。`/api/sessions` = 13 字节。
    if url_len == 0 || url_len > 64 {
        tuis_fail(tag, "解析出的 url_len 不像我们给的那份请求（夹具串了）", ok);
        return false;
    }
    var id: Buf = buf_new(64);
    defer { buf_free(&id); }
    var q: Buf = buf_new(64);
    defer { buf_free(&q); }
    const keep: bool = web_handle(cfg, t, c, m, url_off, url_len, body_off,
        &id, &q);
    if keep {
        tuis_fail(tag, "非长连接端点返回了 true（会被当成「留着连接」⇒ 端点会再跑一遍）", ok);
        return false;
    }
    return true;
}

// `web_t_dispatch` 是上面那个的薄包装（① 只判「没红」）。
fn web_t_dispatch(cfg: &const Config, t: &WebTable, c: &WebConn,
    req: &const byte, ok: &bool, tag: &const byte) bool {
    return web_t_dispatch_expect_false(cfg, t, c, req, tag, ok);
}

// ============================================================
// web-frame：推帧的**空帧判据**与「推完才推进基准」
// ============================================================

// 这一轮的现场（DESIGN §16 踩坑 106）：用户报「web 页面不会实时刷新」——
// 首帧出来之后就再也不动了。根因是 `web_push_frame` 里的空帧判据：
//   `srv_find(frame, "\"rows_changed\":[]", 16)`  —— **长度写成了 16，而那个
//   字面量是 17 字节**。于是它拿「`"rows_changed":[` + 后面一个字节」去比，
//   在**每一帧**里都命中（帧里必然有 `"rows_changed":[`）⇒ 判据恒为真 ⇒ 每一帧
//   都被当空帧丢掉（实测：`syscw` 在首帧之后再不动一个字，页面上打字没反应）。
// 判据全部走生产代码真用的那一支 `web_push_session` / `web_push_frame`（不另写
// 一份等价判断 —— 那样就变成「自测绿、真机红」）。五条：
//   ① **首帧是全量**，且给所有订阅者；
//   ② **文本变了要推**，推出去的帧里要有刚写进去的那一行；
//   ③ **光标单独动也推**：只动光标（一行文本都不改）⇒ 仍要出一帧（页面上光标块
//      不动就是这条没做 —— `emu_frame_changed` 的由来）；
//   ④ **真没变就不推**（空帧流量没有意义）：什么都不动 ⇒ 管道里一个字节都不多；
//   ⑤ **多订阅者**：同一会话两条连接都要拿到（差分基准在会话上，推完才推进 ——
//      老顺序是「第一个订阅者推完就推进基准」⇒ 第二条永远收不到）；
//   ⑥ **只改样式也要推**（踩坑 113）：同一段文本重画一遍、只加 `ESC[7m` ⇒ 帧里那一行
//      必须带反显属性（老判据只比文本 ⇒ 浮层里按 ↑/↓ 高亮不动）；
//   ⑥b 再推一次（样式也没变）⇒ 仍然一个字节都不推（样式基准要跟着收）。
//
// 观测点是**管道的读端**（不是 `c.out`）：`web_push_frame` 排完队会立刻
// `web_flush_conn` 尽力写一次，写成功就把 `c.out` 重置了 —— 只看 `c.out` 会
// 把「推了并且写成功了」误判成「没推」。
export fn web_frame_round(tag: &const byte) bool {
    var ok: bool = true;
    var t: WebTable = web_table_zero();
    web_table_init(&t);
    defer { web_table_free(&t); }
    // 一条合成会话：**不 fork**（这一轮判的是推帧逻辑，子进程只会让它变慢、
    // 还引入时序）。id / pending / scratch / emu 都按 `web_session_new` 的口径建。
    if !web_t_session_make(&t, 0, "session-web-frame") {
        tuis_fail(tag, "合成会话建不起来", &ok);
        return false;
    }
    const s: &WebSession = &t.items[0];
    // 两条连接（同一会话）—— 判据 ⑤ 用。用管道当连接：推帧只要求「能写出去」。
    var conns: [WebConn: WEB_MAX_CONNS] = [web_conn_value_empty()
        : WEB_MAX_CONNS];
    var used: [bool: WEB_MAX_CONNS] = [false: WEB_MAX_CONNS];
    var fds: [i32: 4] = [0: 4];
    if !web_t_two_conns(&conns[0], &used[0], &fds[0], tag, &ok) {
        return ok;
    }
    defer { web_t_conns_close(&conns[0], &used[0], &fds[0]); }
    var got0: Buf = buf_new(0);
    defer { buf_free(&got0); }
    var got1: Buf = buf_new(0);
    defer { buf_free(&got1); }
    // ① 首帧：两条连接都要拿到，且必须是**全量**（只发差分拼不出屏幕）
    web_push_session(s, &conns[0], &used[0], 0);
    web_t_window(fds[0], &got0);
    web_t_window(fds[2], &got1);
    if got0.len == 0 || got1.len == 0 {
        tuis_fail(tag, "首帧没有推给所有订阅者（第二条连接收不到帧）", &ok);
    } else if find_sub(got0.ptr[0: got0.len],
        "\"full\":true"[0: 11], 0) < 0 {
        tuis_fail(tag, "首帧不是全量（新连接拼不出屏幕）", &ok);
    }
    // ② 改一行文本 ⇒ 必须推，且帧里要有那一行
    const line: &const byte = "HELLO-FRAME" as &const byte;
    emu_feed(&s.emu, line, 11);
    web_push_session(s, &conns[0], &used[0], 0);
    web_t_window(fds[0], &got0);
    if got0.len == 0 {
        tuis_fail(tag, "文本变了却一帧都不推（页面不刷新）", &ok);
    } else if find_sub(got0.ptr[0: got0.len], line[0: 11], 0) < 0 {
        tuis_fail(tag, "推出去的帧里没有刚写进去的那一行", &ok);
    }
    // ③ 只动光标（一行文本都不改）⇒ 仍要推 —— `ESC[1;5H` 只挪光标
    const cur_move: &const byte = "\x1b[1;5H" as &const byte;
    emu_feed(&s.emu, cur_move, 6);
    web_push_session(s, &conns[0], &used[0], 0);
    web_t_window(fds[0], &got0);
    if got0.len == 0 {
        tuis_fail(tag, "只动光标时一帧都不推（页面上光标块不动）", &ok);
    }
    // ④ 什么都不动 ⇒ 一个字节都不推（空帧流量没有意义）
    web_push_session(s, &conns[0], &used[0], 0);
    web_t_window(fds[0], &got0);
    if got0.len != 0 {
        tuis_fail(tag, "什么都没变还在推帧（空帧流量）", &ok);
        tuis_puts("  推了 ");
        tuis_num(got0.len);
        tuis_puts(" 字节\n");
    }
    // ⑤ 再改一次文本：两条订阅者**都要**拿到（差分基准在会话上，推完才推进）
    const line2: &const byte = "SECOND-LINE" as &const byte;
    emu_feed(&s.emu, line2, 11);
    web_push_session(s, &conns[0], &used[0], 0);
    web_t_window(fds[0], &got0);
    web_t_window(fds[2], &got1);
    if got0.len == 0 || got1.len == 0 {
        tuis_fail(tag, "同一会话的两条订阅者没有都拿到帧（第二条被基准推进吃掉）",
            &ok);
    }
    // ⑥ **只改样式、一个字都不改** ⇒ 仍要推（踩坑 113）
    //
    // 现场（用户报的「弹窗里按键选择后没有高亮」）：浮层里按 ↑/↓ 只换 SGR ——
    // 选中项那一行**一个字符都不改**。老判据只比行文本，于是这一帧被当空帧丢掉，
    // 页面上的高亮永远停在原处（实测长连接上连按 3 次 ↓，推出去的三帧里
    // `rows_changed` 只有光标那一行，没有任何一行带反显属性）。
    //
    // 这一步用**同一段文本重画一遍、只加 `ESC[7m`**：文本逐字节相同，只有样式变了。
    // 断言两件事：① 推出了帧；② 帧里那一行真的带反显（`attr=16`）——
    // 只断「推出了字节」是不够的，那样判据会退化成「只要推了就算对」。
    const plain: &const byte = "\x1b[2;1HSTYLE-ONLY" as &const byte;
    emu_feed(&s.emu, plain, bufx_cstr_len(plain));
    web_push_session(s, &conns[0], &used[0], 0);
    web_t_window(fds[0], &got0);
    const rev: &const byte = "\x1b[2;1H\x1b[7mSTYLE-ONLY\x1b[0m" as &const byte;
    emu_feed(&s.emu, rev, bufx_cstr_len(rev));
    web_push_session(s, &conns[0], &used[0], 0);
    web_t_window(fds[0], &got0);
    if got0.len == 0 {
        tuis_fail(tag, "只改样式（文本一个字符没变）就一帧都不推（高亮不动）", &ok);
    } else if !web_t_frame_has_reverse(&got0) {
        tuis_fail(tag, "推出去的帧里那一行没有反显属性（高亮还是画不出来）", &ok);
    }
    // ⑥b 再推一次：真没变 ⇒ 仍然一个字节都不推（样式基准也要收，不能只收文本）
    web_push_session(s, &conns[0], &used[0], 0);
    web_t_window(fds[0], &got0);
    if got0.len != 0 {
        tuis_fail(tag, "样式也没变还在推帧（样式基准没跟着收）", &ok);
        tuis_puts("  推了 ");
        tuis_num(got0.len);
        tuis_puts(" 字节\n");
    }
    if ok {
        tuis_ok(tag, "推帧：文本变/光标动/样式变都推、真没变不推、多订阅者都拿到");
    }
    return ok;
}

// 帧里有没有一行带**反显**属性（段表第 4 个数 attr 的 bit4 == 16）。
//
// 判据走**解真发出去的 JSON**，不在字节里找特征串 —— 找特征串的写法错一位就静默
// 翻转（踩坑 106 的教训：老版那个 `srv_find` 判据长度写错一位，于是每一帧都被当
// 空帧丢掉）。这里解出来逐段看 attr 位，判据与「前端会看到什么」同源。
//
// 逐**行**解：管道里是一帧一行的 NDJSON，而观测窗口里可能残留上一帧的尾巴
// （`web_t_drain` 按「现有字节」取，读端不保证停在行首）。拿整段去 parse 就会
// 因为那个残尾失败 —— 那正是这个辅助函数第一版的样子（帧里明明有 `16`，判据却
// 说没有）。
fn web_t_frame_has_reverse(frame: &const Buf) bool {
    var i: usize = 0;
    while i < frame.len {
        var j: usize = i;
        while j < frame.len && frame.ptr[j] != 10 as byte {
            j = j + 1;
        }
        if j > i && web_t_line_has_reverse(frame, i, j) {
            return true;
        }
        i = j + 1;
    }
    return false;
}

// 单独一行（`[from, to)`，不含换行）里有没有反显段。不是完整 JSON（上一帧的残尾）
// 或解不开就是 false。
fn web_t_line_has_reverse(frame: &const Buf, from: usize, to: usize) bool {
    if frame.ptr[from] != 123 as byte {         // '{'
        return false;
    }
    var raw: &void = malloc(65536);
    if ((raw as &byte) as usize) == 0 {
        return false;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, frame.ptr + from, to - from, &root) {
        return false;
    }
    var rows: JsonValue = JsonValue.json_null();
    if !js_obj_get(&root, "rows_changed" as &const byte, 12, &rows) {
        return false;
    }
    const nr: usize = js_arr_len(&rows);
    var i: usize = 0;
    while i < nr {
        var row: JsonValue = JsonValue.json_null();
        if !js_arr_get(&rows, i, &row) {
            return false;
        }
        var segs: JsonValue = JsonValue.json_null();
        if !js_arr_get(&row, 2, &segs) {
            i = i + 1;
            continue;
        }
        const ns: usize = js_arr_len(&segs);
        var k: usize = 0;
        while k < ns {
            var sg: JsonValue = JsonValue.json_null();
            if js_arr_get(&segs, k, &sg) {
                var attr: i64 = 0;
                var av: JsonValue = JsonValue.json_null();
                if js_arr_get(&sg, 3, &av) && js_i64_of(&av, &attr) {
                    if (attr & (16 as i64)) != 0 {
                        return true;
                    }
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return false;
}

// 开两对管道、建两条订阅同一会话的长连接。返回 false = 没建起来 —— 所以 `ok`
// 保持原值（管道不可用 = 这一轮**跳过**、算过；初始化失败 = 已经置红）。
fn web_t_two_conns(conns: &WebConn, used: &bool, fds: &i32,
    tag: &const byte, ok: &bool) bool {
    if (sys_pipe2(fds, 0) catch { -1; }) != 0 {
        tuis_ok(tag, "跳过（管道不可用）");
        return false;
    }
    if (sys_pipe2(fds + 2, 0) catch { -1; }) != 0 {
        _ = sys_close(fds[0]) catch {};
        _ = sys_close(fds[1]) catch {};
        tuis_ok(tag, "跳过（管道不可用）");
        return false;
    }
    // 读端非阻塞：下面按「这段窗口里读到了什么」判，不能卡住
    web_t_nonblock(fds[0]);
    web_t_nonblock(fds[2]);
    if !web_conn_init(&conns[0], fds[1]) || !web_conn_init(&conns[1], fds[3]) {
        tuis_fail(tag, "连接初始化失败", ok);
        _ = sys_close(fds[0]) catch {};
        _ = sys_close(fds[1]) catch {};
        _ = sys_close(fds[2]) catch {};
        _ = sys_close(fds[3]) catch {};
        return false;
    }
    used[0] = true;
    used[1] = true;
    var k: usize = 0;
    while k < 2 {
        conns[k].st = WEB_CONN_STREAM;
        conns[k].sess = 0;
        k = k + 1;
    }
    return true;
}

// 收两对管道与两条连接（幂等；`used` 说哪几条真的建起来了）。
fn web_t_conns_close(conns: &WebConn, used: &bool, fds: &i32) void {
    if used[0] {
        web_conn_free(&conns[0]);
    }
    if used[1] {
        web_conn_free(&conns[1]);
    }
    _ = sys_close(fds[0]) catch {};
    _ = sys_close(fds[1]) catch {};
    _ = sys_close(fds[2]) catch {};
    _ = sys_close(fds[3]) catch {};
}

// 「这一轮推了什么」的观测窗口：**先清空再读**管道。清空这一步不能省 ——
// `web_t_drain` 是**追加**语义，不 reset 的话上一轮读到的字节会留在缓冲里，
// 「这一轮没推」的断言就永远为假（假绿：什么都不推也算过）。
fn web_t_window(fd: i32, out: &Buf) void {
    buf_reset(out);
    web_t_drain(fd, out);
}

// 建一条合成会话（不 fork、不开 PTY）：id / pending / scratch / emu 按生产口径建。
// 返回 false = 分配失败。
fn web_t_session_make(t: &WebTable, i: usize, id: &const byte) bool {
    if i >= WEB_MAX_SESSIONS {
        return false;
    }
    const s: &WebSession = &t.items[i];
    s.id = buf_new(64);
    s.pending = buf_new(256);
    s.scratch = buf_new(EMU_MAX_COLS * 4 + 16);
    var k: usize = 0;
    while k < WEB_REPLAY_FRAMES {
        s.replay[k] = buf_new(0);
        k = k + 1;
    }
    if !buf_valid(&s.id) || !buf_valid(&s.pending) || !buf_valid(&s.scratch) {
        return false;
    }
    if !emu_init(&s.emu, 100, 30) {
        return false;
    }
    _ = buf_append(&s.id, id, bufx_cstr_len(id));
    s.pid = 0;
    s.master = -1;
    s.alive = true;
    t.n = i + 1;
    return true;
}

// ============================================================
// web-pty：会话子进程死掉之后，主循环必须**收口**而不是空转
// ============================================================

// 这一轮的现场（DESIGN §16 踩坑 105）：子进程退出后 PTY master 上的 `read` 返回
// **EIO**（不是 0），而只认 `n == 0` 的旧判据收不掉它；master 不关 ⇒ 水平触发的
// `POLLHUP` 每圈都让这个槽「就绪」⇒ 主循环纯忙等（实测 `syscr` 20 亿 / CPU 100%），
// 页面上则表现为**打字没有任何反应**。
//
// 判据全部走主循环真正用的那一支 `web_pty_ready`（不是另写一份等价判断 ——
// 那样就变成「自测绿、真机红」）。四条：
//   ① **最后一帧不丢**：子进程退出前写的字节要出现在网格里
//      （先 `POLLIN` 后 HUP，这条钉住顺序）；
//   ② **收口**：HUP 之后 `alive == false`、`master == -1`、子进程被回收
//      （不再是 `<defunct>` 僵尸）；
//   ③ **不忙等**：循环有限圈内结束（带 bug 的版本 ①②③ 全红，且这里会先撞圈数上限）；
//   ④ **幂等**：再喂一次 HUP 什么都不变。
export fn web_pty_round(tag: &const byte) bool {
    var ok: bool = true;
    var t: WebTable = web_table_zero();
    web_table_init(&t);
    defer { web_table_free(&t); }
    var slave: Buf = buf_new(64);
    defer { buf_free(&slave); }
    const m: i32 = web_t_pty_open(&slave, 100, 30);
    if m < 0 {
        tuis_ok(tag, "跳过（打不开 /dev/ptmx）");
        return true;
    }
    // 子进程：写一段可识别字节，然后**退出**（不关 fd 也一样 —— 进程一没，
    // 从设备就没有持有者了，master 上立刻是 HUP/EIO）
    const pid64: i64 = sys_fork() catch {
        srv_close(m);
        tuis_fail(tag, "fork 失败", &ok);
        return false;
    };
    if pid64 == 0 {
        const sf: i32 = sys_open(slave.ptr as *const byte, 0x102, 0) catch {
            -1;
        };
        if sf < 0 {
            sys_exit(9);
        }
        var msg: [byte: 16] = "PTYLASTFRAME\r\n";
        _ = sys_write(sf, &msg[0], 15) catch {};
        sys_exit(0);
    }
    const s: &WebSession = &t.items[0];
    web_session_zero(s);
    if !emu_init(&s.emu, 100, 30) {
        srv_close(m);
        tuis_fail(tag, "emu_init 失败", &ok);
        return false;
    }
    s.master = m;
    s.pid = i64_to_i32(pid64);
    s.alive = true;
    t.n = 1;
    const closed_at: usize = web_t_pty_pump(&t, s);
    // ③ 不忙等：带 bug 时 master 永不关闭 ⇒ 这里必然停在上限
    if s.master >= 0 {
        tuis_fail(tag,
            "子进程死了但 master 没关（poll 会永远就绪 ⇒ 主循环空转、页面打不进字）",
            &ok);
        tuis_puts("  循环圈数=");
        tuis_num(closed_at);
        tuis_puts(" master=");
        tuis_num(s.master as usize);
        tuis_puts("\n");
    }
    web_t_pty_assert_closed(tag, s, pid64 as i32, &ok);
    // ④ 幂等：再喂一次 HUP
    web_pty_ready(&t, 0, POLLHUP);
    if s.master >= 0 || s.alive {
        tuis_fail(tag, "重复喂 HUP 改变了状态（收口不幂等）", &ok);
    }
    if ok {
        tuis_puts("  循环圈数=");
        tuis_num(closed_at);
        tuis_puts("（有限 ⇒ 不空转）\n");
        tuis_ok(tag,
            "PTY 收口：最后一帧不丢 + HUP 关 master/回收子进程/标 dead + 幂等");
    }
    return ok;
}

// 跑到这条会话收口为止（**上限 64 圈**：带 bug 的版本永远收不掉，上限就是判据
// ③「不忙等」的机器实现）。返回实际圈数。
fn web_t_pty_pump(t: &WebTable, s: &WebSession) usize {
    var rounds: usize = 0;
    while rounds < 64 && s.master >= 0 {
        rounds = rounds + 1;
        var pfds: [PollFd: 1] = [
            PollFd{ fd: s.master, events: POLLIN, revents: 0 },
        ];
        const pr: i32 = sys_poll(&pfds[0], 1, 200) catch { 0; };
        if pr > 0 && pfds[0].revents != 0 {
            web_pty_ready(t, 0, pfds[0].revents);
        }
    }
    return rounds;
}

// 收口之后的四条断言：① 最后一帧不丢 ② `alive == false` ③ `pid` 清零（= 真的
// waitpid 收到了）④ 子进程不再是僵尸。只置 ok，不早退（与文件头不变量 ③ 同口径）。
fn web_t_pty_assert_closed(tag: &const byte, s: &const WebSession, pid: i32,
    ok: &bool) void {
    // ① 最后一帧不丢（子进程退出前写的字节必须在网格里）
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    emu_text(&s.emu, &text);
    if !web_t_contains(&text, "PTYLASTFRAME" as &const byte) {
        tuis_fail(tag, "子进程退出前的最后一段输出丢了（应先 POLLIN 后 POLLHUP）",
            ok);
    }
    // ② 收口
    if s.alive {
        tuis_fail(tag, "会话仍标着 alive（页面上这条会话永远「活着」）", ok);
    }
    // ③ `pid` 清零。这**本身**就是「真的收到了」的判据（`web_reap_child` 只在
    // waitpid 收到那个 pid 时才返回 true）—— 留着旧 pid 会在退出收尾时 `kill`
    // 一个可能已被内核回收复用的 pid，那是**误杀别人**。
    if s.pid != 0 {
        tuis_fail(tag, "子进程没被回收（pid 还留着 ⇒ 退出时可能误杀复用的 pid）",
            ok);
    }
    // ④ 不是僵尸：再 wait 一次应该收不到它了（ECHILD）。
    var st: i32 = 0;
    const w: i32 = sys_waitpid(pid, &st, 1) catch { -1; };
    if w == pid {
        tuis_fail(tag, "子进程还是僵尸（没有 waitpid 回收）", ok);
    }
}

// 开一对 pty（与 websrv 的 `web_pty_open` 同一套 ioctl；自测自己开一份，
// 不去动生产代码里的私有件）。返回 master fd，slave 路径写进 slave_path。
fn web_t_pty_open(slave_path: &Buf, cols: usize, rows: usize) i32 {
    var ptmx: [byte: 16] = "/dev/ptmx";
    const m: i32 = sys_open(&ptmx[0] as *const byte, 0x102, 0) catch { -1; };
    if m < 0 {
        return -1;
    }
    var zero: i32 = 0;
    if (sys_ioctl(m, 0x40045431, web_t_addr(&zero as &const void)) catch {
        -1;
    }) != 0 {
        srv_close(m);
        return -1;
    }
    var num: i32 = 0;
    if (sys_ioctl(m, 0x80045430, web_t_addr(&num as &const void)) catch {
        -1;
    }) != 0 {
        srv_close(m);
        return -1;
    }
    buf_reset(slave_path);
    _ = buf_append_cstr(slave_path, "/dev/pts/");
    _ = buf_append_u64(slave_path, num as u64);
    _ = buf_append_byte(slave_path, 0);     // 尾 NUL：这个路径要直接喂 sys_open
    web_set_winsize(m, cols, rows);
    return m;
}

// 指针 → i64（ioctl 的地址参数要整数）。
fn web_t_addr(p: &const void) i64 {
    return (@usize_from_ptr(p)) as i64;
}
