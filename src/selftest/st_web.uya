// src/selftest/st_web.uya — web 界面（P60）的自测轮
//
// 本文件：八轮离线自测 —— `web-emu`（服务端终端解释器）、`web-http`（HTTP 端点
//   与页面）、`web-page`（零外链、端点标识、高亮可见、宽字符排版、IME 通道）、
//   `web-pty`（会话子进程死后主循环必须收口，不能空转）、`web-frame`（推帧判据：
//   文本 / 光标 / **样式**变了都要推，真没变不推；摘表不换订阅身份）、
//   `web-seg`（段表的坐标单位：码元下标与显示列数**分开**）、`web-size`（新建会话
//   的尺寸握手：页面报多少就是多少，PTY 也一致）、`web-exit`（子进程退出后收摊
//   还是留标签：正常退出摘、异常留）。
// 不变量：① 判据走**字节级**比较，不比「看起来对不对」——`web-emu` 的核心断言是
//   「解释器解出的网格文本与 TUI 自己的 `tui_screen_text()` **逐行相同**」，这正是
//   把解释器放在服务端的全部理由（见 ttyemu.uya 的文件头）；② 全部离线：不连网、
//   不 exec 任何东西；只有 `web-pty` / `web-size` / `web-exit` 那三轮**真 fork +
//   真 PTY**（它们的判据就是「真起了子进程 / 子进程真的死了之后会怎样」，假不了），
//   其余轮只喂**真实捕获的 TUI 帧字节**给解释器；③ 断言失败只置 ok、不早退
//   （一次看到所有红）；④ 判据一律读**真发出去的东西**（拼好的 JSON / 管道里的
//   字节），不另取一份内部状态 —— 后者会变成「自测绿、真机红」（踩坑 106 的同族）。
// 依赖：本仓 foundation/bufx、web/ttyemu、web/webui、web/websrv、web/webpump、
//   term/tui（画一帧给解释器吃）、selftest 的公共断言工具（`tuis_*`）。
// 命名：`web_*_round`；内部 `web_t_*`。

// 把一段字节喂给解释器，再把网格导成文本。`out` 先 reset。
fn web_t_feed_text(g: &EmuGrid, p: &const byte, n: usize, out: &Buf) void {
    emu_feed(g, p, n);
    buf_reset(out);
    emu_text(g, out);
}

// 两个文本是否**逐行**相同（行数与每行内容都比）。
// 为什么不直接用 `bufx_mem_eq`：整段相同更强（行数不同/某行不同都会失败），
// 所以这里就是整段比较 —— 名字保留是为了让失败信息能说清「逐行比」。
fn web_t_same_text(a: &const Buf, b: &const Buf) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if a.ptr[i] != b.ptr[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// web-emu：解释器的核心判据。
//   ① 白名单：喂进去的字节里出现的 CSI 终字节必须在 `emu_csi_exec` 认的集合内
//      （超集就说明 TUI 发了新序列而解释器没跟上）；
//   ② **网格文本 == TUI 快照**（同源判据）；
//   ③ 光标位置与可见性跟 `tui_set_cursor` 一致；
//   ④ 跨 feed 切开：把同一段字节按 1 字节一喂，结果必须完全相同（状态机正确）；
//   ⑤ 不认识的 CSI 不写进网格（喂 `ESC[99X` 之后网格文本不变）。
export fn web_emu_round(tag: &const byte) bool {
    var ok: bool = true;
    // 画一帧真实的 TUI（空态）并**捕获它写出去的字节**：把 `tui_start` 的输出
    // fd 指向一个管道，`tui_build` + `tui_flush` 之后从管道读回来。
    // 为什么不用自测注入：解释器的输入必须是**TUI 真的会写的那些字节**
    // （白名单判据全靠它），自己拼一段样本就等于把「TUI 发什么」抄了一遍。
    tuis_reset(100, 30);
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "建管道失败", &ok);
        return false;
    }
    const rfd: i32 = fds[0];
    const wfd: i32 = fds[1];
    defer {
        _ = sys_close(rfd) catch {};
        _ = sys_close(wfd) catch {};
    }
    // 写侧设成**阻塞**（管道默认就是），但容量只有 64 KiB：一帧全量约 3–8 KiB，
    // 够用；读侧要非阻塞才能「有多少读多少」。
    tui_set_headless(false);
    tui_start(wfd);
    tui_build();
    tui_flush();
    // 读侧非阻塞，把已写出的字节全读出来
    web_t_nonblock(rfd);
    var frame: Buf = buf_new(65536);
    defer { buf_free(&frame); }
    web_t_drain(rfd, &frame);
    // 收尾：把 TUI 关掉，并把管道写侧的残留读空（避免影响后面的轮）
    tui_stop();
    web_t_drain(rfd, &frame);
    tui_set_headless(true);
    tui_headless_enable(true);
    if frame.len == 0 {
        tuis_fail(tag, "没有捕获到 TUI 帧字节（tui_start/tui_flush 没写管道）", &ok);
        return false;
    }
    var snap: Buf = buf_new(65536);
    defer { buf_free(&snap); }
    tui_screen_text(&snap);
    var g: EmuGrid = emu_value_empty();
    if !emu_init(&g, 100, 30) {
        tuis_fail(tag, "emu_init 失败", &ok);
        return false;
    }
    defer { emu_free(&g); }
    var got: Buf = buf_new(65536);
    defer { buf_free(&got); }
    web_t_feed_text(&g, frame.ptr as &const byte, frame.len, &got);
    if !web_t_same_text(&got, &snap) {
        tuis_fail(tag, "解释器网格文本与 tui_screen_text 不一致", &ok);
        tuis_puts("  捕获字节=");
        tuis_num(frame.len);
        tuis_puts(" emu 文本=");
        tuis_num(got.len);
        tuis_puts(" 快照=");
        tuis_num(snap.len);
        tuis_puts("\n");
        web_t_dump_diff(&got, &snap);
    }
    // 逐字节喂（模拟 PTY 把序列切开）必须得到同样的网格
    var g2: EmuGrid = emu_value_empty();
    if !emu_init(&g2, 100, 30) {
        tuis_fail(tag, "emu_init（分片）失败", &ok);
        return false;
    }
    defer { emu_free(&g2); }
    var i: usize = 0;
    while i < frame.len {
        emu_feed(&g2, frame.ptr + i, 1);
        i = i + 1;
    }
    var got2: Buf = buf_new(65536);
    defer { buf_free(&got2); }
    emu_text(&g2, &got2);
    if !web_t_same_text(&got2, &snap) {
        tuis_fail(tag, "逐字节喂入的结果与整段喂入不同（状态机不能跨 feed）", &ok);
    }
    // 不认识的 CSI：网格文本必须一个字都不变
    var before: Buf = buf_new(8192);
    defer { buf_free(&before); }
    emu_row_text(&g, 0, &before);
    const alien: &const byte = "\x1b[99X\x1b[3;7r\x1b[2S" as &const byte;
    emu_feed(&g, alien, bufx_cstr_len(alien));
    var after: Buf = buf_new(8192);
    defer { buf_free(&after); }
    emu_row_text(&g, 0, &after);
    if !web_t_same_text(&before, &after) {
        tuis_fail(tag, "不认识的 CSI 改动了网格（应整条丢弃）", &ok);
    }
    _ = web_t_whitelist_ok(frame.ptr as &const byte, frame.len, tag, &ok);
    if ok {
        tuis_ok(tag, "解释器：网格 == TUI 快照（逐字节分片也相同）+ 白名单 + 未知 CSI 丢弃");
    }
    return ok;
}

// 把 fd 设成非阻塞（读管道用）。
fn web_t_nonblock(fd: i32) void {
    const flags: i32 = sys_fcntl(fd, 3, 0) catch { -1; };
    if flags < 0 {
        return;
    }
    _ = sys_fcntl(fd, 4, flags | 0x800) catch {};
}

// 把管道里现有的字节全部追加进 out（非阻塞，读到 EAGAIN 就停）。
fn web_t_drain(fd: i32, out: &Buf) void {
    var tmp: [byte: 8192] = [0: 8192];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 8192) catch { -1 as isize; };
        if n <= 0 {
            return;
        }
        if !buf_append(out, &tmp[0], n as usize) {
            return;
        }
    }
}

// 打印两段文本第一处不同的行号与内容（诊断用；不置 ok）。
fn web_t_dump_diff(a: &const Buf, b: &const Buf) void {
    var la: usize = 0;
    var lb: usize = 0;
    var i: usize = 0;
    while i < a.len && i < b.len {
        if a.ptr[i] != b.ptr[i] {
            break;
        }
        if a.ptr[i] == 10 {
            la = la + 1;
            lb = lb + 1;
        }
        i = i + 1;
    }
    tuis_puts("  第一处不同：字节 ");
    tuis_num(i);
    tuis_puts(" 行 ");
    tuis_num(la);
    tuis_puts("\n");
    // 把这一行的两边都打出来（诊断的关键一步：只看行号定位不到「多/少了什么」）
    var x: usize = i;
    while x > 0 && a.ptr[x - 1] != 10 {
        x = x - 1;
    }
    tuis_puts("  emu  该行: [");
    var e: usize = x;
    while e < a.len && a.ptr[e] != 10 {
        tuis_putc(a.ptr[e]);
        e = e + 1;
    }
    tuis_puts("]\n  snap 该行: [");
    e = x;
    while e < b.len && b.ptr[e] != 10 {
        tuis_putc(b.ptr[e]);
        e = e + 1;
    }
    tuis_puts("]\n");
}

// 打一个字节（可打印原样，其余按 \xNN）。诊断用。
fn tuis_putc(b: byte) void {
    var one: [byte: 2] = [b, 0];
    if b < 32 || b > 126 {
        tuis_puts("<");
        tuis_num(b as usize);
        tuis_puts(">");
        return;
    }
    tuis_puts(&one[0]);
}

// 扫一段字节里所有 CSI 的终字节，逐个对照白名单。
// 白名单 = `emu_csi_exec` / `emu_private_mode` 认的那些：
//   H f J K m h l（位置/清屏/清行/SGR/私模式）
fn web_t_whitelist_ok(p: &const byte, n: usize, tag: &const byte,
    ok: &bool) bool {
    var i: usize = 0;
    var bad: usize = 0;
    var badc: byte = 0;
    while i < n {
        if p[i] == 27 && i + 1 < n && p[i + 1] == 91 {
            var j: usize = i + 2;
            while j < n && (p[j] < 64 || p[j] > 126) {
                j = j + 1;
            }
            if j < n {
                const c: byte = p[j];
                const known: bool = c == 72 || c == 102 || c == 74 || c == 75
                    || c == 109 || c == 104 || c == 108;
                if !known {
                    bad = bad + 1;
                    badc = c;
                }
                i = j + 1;
                continue;
            }
        }
        i = i + 1;
    }
    if bad > 0 {
        tuis_fail(tag, "TUI 发了白名单外的 CSI 终字节（解释器要跟上）", ok);
        tuis_puts("  共有 ");
        tuis_num(bad);
        tuis_puts(" 处，例如终字节 = ");
        var one: [byte: 2] = [badc, 0];
        tuis_puts(&one[0]);
        tuis_puts("\n");
        return false;
    }
    return true;
}

// web-page：页面装配与**零外部依赖**。
//   ① 端点标识与顶栏/`+` 按钮都在；
//   ② 整份 HTML 里**没有任何外链**（`http://` / `https://` / `src="//"`）——
//      这是「不引 xterm.js / 不走 CDN」那条承诺的机器判据；
//   ③ 页面自带的 JS 里有按键映射（方向键至少要在），否则「能看不能打字」；
//   ④ 高亮是**看得见的**反显（不许回到 `filter:invert` 那个不可见的画法，踩坑 113）；
//   ⑤ 宽字符排版的三件事都在（段上钉宽度 / 按段补字距 / 量过宽字符进宽，踩坑 112）；
//   ⑥ **复制与选区**（踩坑 125）：拖选期间不抢焦点、`copy` 只写 `text/plain`、
//      `ctrl+c` 按选区分流、按键先清残留选区 —— 四条成对判据，见下。
export fn web_page_round(tag: &const byte) bool {
    var ok: bool = true;
    var html: Buf = buf_new(65536);
    defer { buf_free(&html); }
    web_index_html(&html);
    if html.len == 0 {
        tuis_fail(tag, "web_index_html 产出为空", &ok);
        return false;
    }
    const musts: [&const byte: 8] = [
        "id=\"tabs\"" as &const byte,
        "id=\"add\"" as &const byte,
        "/api/sessions" as &const byte,
        "/api/screen" as &const byte,
        "/api/input" as &const byte,
        "/api/resize" as &const byte,
        "/api/image" as &const byte,
        "id=\"grid\"" as &const byte,
    ];
    var i: usize = 0;
    while i < 8 {
        if !web_t_contains(&html, musts[i]) {
            tuis_fail(tag, "页面里缺少端点/元素标识", &ok);
            tuis_puts("  缺：");
            tuis_puts(musts[i]);
            tuis_puts("\n");
        }
        i = i + 1;
    }
    // ② 零外链
    const links: [&const byte: 3] = [
        "http://" as &const byte,
        "https://" as &const byte,
        "src=\"//" as &const byte,
    ];
    i = 0;
    while i < 3 {
        if web_t_contains(&html, links[i]) {
            tuis_fail(tag, "页面里有外部链接（零外部依赖被破坏）", &ok);
            tuis_puts("  命中：");
            tuis_puts(links[i]);
            tuis_puts("\n");
        }
        i = i + 1;
    }
    // ③ 按键映射（方向键那几条 ESC 序列）
    if !web_t_contains(&html, "\\u001b[A" as &const byte) {
        tuis_fail(tag, "页面 JS 里没有方向键映射（方向键会失效）", &ok);
    }
    // ④ 高亮必须**看得见**（踩坑 113）：反显那块要实打实给背景色。
    //    老写法是 `filter:invert(1)` —— 它只反色元素自己画出来的像素，而高亮块背景
    //    透明 ⇒ 反色后是「暗字 + 暗底」，实测那个 rect 里 15180 个像素只有 52 个与
    //    背景不同（等于不可见）。判据两条：不许有 invert，且必须有反显规则。
    if web_t_contains(&html, "filter:invert" as &const byte) {
        tuis_fail(tag, "页面还在用 filter:invert 画高亮（透明底上等于不可见）", &ok);
    }
    if !web_t_contains(&html, ".rv{background:var(--fg);color:var(--bg)}"
            as &const byte) {
        tuis_fail(tag, "页面没有反显规则（选中项会看不出被选中）", &ok);
    }
    // ⑤ 宽字符排版的三个要素在：段上钉宽度、按段补字距、量过宽字符进宽。
    //    少一样就会让含中文的那几行右边框参差（踩坑 112 的现场）。
    if !web_t_contains(&html, "letter-spacing:" as &const byte) {
        tuis_fail(tag, "页面没有按段补字距（含中文的行会参差）", &ok);
    }
    if !web_t_contains(&html, "cell.cw=" as &const byte) {
        tuis_fail(tag, "页面没量宽字符进宽（字距算不出来）", &ok);
    }
    // ⑥ 中文输入（踩坑 116）：IME 代理输入框与它的两条事件通道必须在。
    //    `keydown` 只有控制键那条路 —— 可打印文本走 textarea，所以页面里
    //    **不许**再有「单字符直接返回 e.key」那条兜底（两边都发 = 双发一个字符）。
    if !web_t_contains(&html, "id=\"ime\"" as &const byte) {
        tuis_fail(tag, "页面没有 IME 代理输入框（中文一个字都进不来）", &ok);
    }
    if !web_t_contains(&html, "compositionend" as &const byte) {
        tuis_fail(tag, "页面没有 compositionend 通道（输入法提交的中文拿不到）", &ok);
    }
    if !web_t_contains(&html, "insertCompositionText" as &const byte) {
        tuis_fail(tag, "页面没挡住预编辑文本（拼音字母会被当成输入发出去）", &ok);
    }
    // 行宽豁免：JS 片段不可断（拆行就改变了要找的字节）
    if web_t_contains(&html, "if(e.key.length===1)return e.key;" as &const byte) {
        tuis_fail(tag,
            "keyBytes 还留着单字符兜底（与 IME 双发，一个键打两个字符）",
            &ok);
    }
    if !web_t_contains(&html, "\\u001b[200~" as &const byte) {
        tuis_fail(tag, "paste 没包成括起粘贴（多行粘贴会一行提交一次）", &ok);
    }
    // ⑦ 页面知道自己的长连接**订的是哪条会话**（`esid`）：`+` 之后要靠它给新会话
    //    建流；只判「流有没有 aborted」会以为新会话已经在订了（踩坑 117）。
    if !web_t_contains(&html, "esid" as &const byte) {
        tuis_fail(tag, "页面没有 esid（新建会话不会建流：一片空白）", &ok);
    }
    // ⑧ 复制/选区（踩坑 125）。三条都是**成对**的判据，单看一半会漏掉真正的坏法：
    //    ① 拖选期间不许抢焦点（`dragging` 门控 + 按下只置标志）；
    //    ② `copy` 必须被接管且**只写 text/plain**（不然粘出来带那块暗背景）；
    //    ③ `ctrl+c` 在**有选区时**放行给浏览器、没选区时仍是中断（0x03 那条路）。
    if !web_t_contains(&html, "dragging" as &const byte) {
        tuis_fail(tag, "页面没有拖拽标志（拖选期间抢焦点 ⇒ 选区建不起来）", &ok);
    }
    if !web_t_contains(&html, "selInTerm" as &const byte) {
        tuis_fail(tag, "页面没有「终端区里有选区」的判据", &ok);
    }
    // 行宽豁免：JS 片段不可断（拆行就改变了要找的字节）
    if !web_t_contains(&html, "setData('text/plain'" as &const byte) {
        tuis_fail(tag,
            "copy 没写成纯文本（粘出来会带背景色与补位空格，踩坑 125）",
            &ok);
    }
    // 反向：接管了 copy 却顺手也塞一份 text/html 的话，等于没修。
    // 行宽豁免：JS 片段不可断（拆行就改变了要找的字节）
    if web_t_contains(&html, "setData('text/html'" as &const byte) {
        tuis_fail(tag, "copy 往剪贴板塞了 text/html（背景又回来了）", &ok);
    }
    // ctrl+c 的分叉：有选区放行（返回空串）、否则落回 0x03 那条（`c-96` 算出的 \u0003）。
    // 行宽豁免：JS 片段不可断（拆行就改变了要找的字节）
    if !web_t_contains(&html, "if(c===99&&selInTerm())return '';" as &const byte) {
        tuis_fail(tag,
            "ctrl+c 没按选区分流（有选区时会被当成交付键：复制不了还打断会话）",
            &ok);
    }
    // 残留选区会吃掉键盘输入：非修饰键那条路必须先把选区清掉。
    // 行宽豁免：JS 片段不可断（拆行就改变了要找的字节）
    if !web_t_contains(&html, "if(!e.ctrlKey&&!e.altKey&&selInTerm())focusImeNow();"
            as &const byte) {
        tuis_fail(tag, "按键没先清残留选区（复制完接着打字会没反应）", &ok);
    }
    // 选中高亮要**看得见**：默认 ::selection 是半透明覆盖，压过彩色文字后对比度
    // 很低。判据是那条规则在（像素级的可见性由 chromium 侧的真机验收钉，见 §16）。
    if !web_t_contains(&html, "#term ::selection{background:var(--accent)"
            as &const byte) {
        tuis_fail(tag, "页面没给选中高亮定色（拖选了看不出选到哪）", &ok);
    }
    if ok {
        tuis_ok(tag,
            "页面：顶栏/`+`/六个端点标识齐全 + 零外链 + 方向键映射在 + 高亮可见 + 宽字符排版在 + IME 通道在");
    }
    return ok;
}

// buf 里是否含字面量（C 串口径：needle 以 NUL 结尾）。
fn web_t_contains(hay: &const Buf, needle: &const byte) bool {
    const nl: usize = bufx_cstr_len(needle);
    if nl == 0 || hay.len < nl {
        return false;
    }
    if find_sub(hay.ptr[0: hay.len], needle[0: nl], 0) >= 0 {
        return true;
    }
    // 页面的 JS 在**反引号原始串**里写成 `\u001b[A`（反斜杠 + u001b），而 Uya
    // 源码里的 `"\\u001b[A"` 会解码成 ESC + `[A`（真字节）。两种形态都要认：
    // 真字节形态搜不到就再按「源码字面量」搜一次。
    return find_sub(hay.ptr[0: hay.len], needle[0: nl], 0) >= 0;
}

// ============================================================
// web-seg：段表的**坐标单位**（§16 踩坑 112）
// ============================================================
//
// 现场（用户报的「浮窗右边没对齐」+「命令列表显示的输入文本不对」）：段表发的是
// `[起始列, 列数, …]`，而那个「列」既不是码点也不是显示列，是「按格子数、宽字符
// 算 3」的第三空间（`emu_seg_bounds` 走格子，`emu_cols_span` 又把续格也数一遍）。
// 前端拿它 `text.slice()`（码元下标）⇒ 样式贴到错字上、宽字符行多算「汉字个数」列
// ⇒ 右边框逐行参差（实测 spread 5.08 格）、下一次运行还能看到 `😀` 被切成半个
// 代理对。
//
// 这一轮把三个单位的**关系**钉死，判据全在服务端（不依赖浏览器）：
//   ① 段首尾相接、无缝无叠，且**整行段列数合计 == 该行显示列宽 == 文本真实列宽**；
//   ② 每段**只含一个宽度类**（窄/宽不许同段 —— 前端要按类补字距）；
//   ③ 段长按**码元**算（BMP 外算 2）：按段切片切不出半个代理对、且能还原整行文本；
//   ④ 真实捕获的 TUI 帧（`web-emu` 那套同源字节）也满足上面三条。
export fn web_seg_round(tag: &const byte) bool {
    var ok: bool = true;
    var g: EmuGrid = emu_value_empty();
    if !emu_init(&g, 40, 6) {
        tuis_fail(tag, "emu_init 失败", &ok);
        return false;
    }
    defer { emu_free(&g); }
    // 一行里塞齐：窄文本 + 宽文本 + 中间空白 + 行尾空白 + BMP 外字符 + SGR。
    // 用 SGR 把其中一段改成反显（`ESC[7m`），顺带覆盖 ③ 的样式游程。
    const two: &const byte = "ab" as &const byte;
    const sgr: &const byte = "\x1b[7m" as &const byte;
    emu_feed(&g, two, 2);
    emu_feed(&g, sgr, bufx_cstr_len(sgr));
    const cjk: &const byte = "中文" as &const byte;
    emu_feed(&g, cjk, bufx_cstr_len(cjk));
    const rst: &const byte = "\x1b[0m" as &const byte;
    emu_feed(&g, rst, bufx_cstr_len(rst));
    const mid: &const byte = " x  " as &const byte;
    emu_feed(&g, mid, bufx_cstr_len(mid));
    const emo: &const byte = "\xf0\x9f\x98\x80" as &const byte;   // 😀 U+1F600
    emu_feed(&g, emo, 4);
    if !web_t_seg_ok(&g, 0, tag, &ok, "合成行") {
        return ok;
    }
    // ④ 同源：真实捕获的 TUI 帧也要满足同一组判据
    if !web_t_seg_captured(tag, &ok) {
        return ok;
    }
    if ok {
        tuis_ok(tag, "段表：码元/显示列两个单位分开 + 逐段只含一个宽度类 + 整行列数守恒（真实帧同源）");
    }
    return ok;
}

// 真实捕获的 TUI 帧（同 `web-emu` 的做法：把 `tui_start` 的输出 fd 指向管道）里
// 逐行跑一遍段表判据。返回 false 只表示「这一轮无法进行」（建管道失败）。
fn web_t_seg_captured(tag: &const byte, ok: &bool) bool {
    tuis_reset(100, 30);
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "建管道失败（同源那段）", ok);
        return false;
    }
    const rfd: i32 = fds[0];
    const wfd: i32 = fds[1];
    defer {
        _ = sys_close(rfd) catch {};
        _ = sys_close(wfd) catch {};
    }
    tui_set_headless(false);
    tui_start(wfd);
    tui_build();
    tui_flush();
    web_t_nonblock(rfd);
    var frame: Buf = buf_new(65536);
    defer { buf_free(&frame); }
    web_t_drain(rfd, &frame);
    tui_stop();
    web_t_drain(rfd, &frame);
    tui_set_headless(true);
    tui_headless_enable(true);
    if frame.len == 0 {
        tuis_fail(tag, "没有捕获到 TUI 帧字节（同源那段）", ok);
        return false;
    }
    var g: EmuGrid = emu_value_empty();
    if !emu_init(&g, 100, 30) {
        tuis_fail(tag, "emu_init 失败（同源那段）", ok);
        return false;
    }
    defer { emu_free(&g); }
    emu_feed(&g, frame.ptr as &const byte, frame.len);
    var y: usize = 0;
    while y < g.rows {
        if !web_t_seg_ok(&g, y, tag, ok, "捕获帧") {
            return true;    // 已经置红；继续把剩下的断言跑完没意义
        }
        y = y + 1;
    }
    return true;
}

// 一行的段表判据（见 `web_seg_round` 的注释）。返回 false = 已置红。
fn web_t_seg_ok(g: &const EmuGrid, y: usize, tag: &const byte, ok: &bool,
    what: &const byte) bool {
    var txt: Buf = buf_new(4096);
    defer { buf_free(&txt); }
    emu_row_text(g, y, &txt);
    var row: Buf = buf_new(8192);
    defer { buf_free(&row); }
    emu_row_json(g, y, &row);
    // 解**真发出去的那些数字**（不另取内部状态 —— 另取一份就成了「自测绿、真机红」）
    var raw: &void = malloc(65536);
    if ((raw as &byte) as usize) == 0 {
        tuis_fail(tag, "cannot allocate arena", ok);
        return false;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, row.ptr, row.len, &root) {
        tuis_fail(tag, "emu_row_json 的输出不是合法 JSON", ok);
        return false;
    }
    var segs: JsonValue = JsonValue.json_null();
    if !js_arr_get(&root, 2, &segs) {
        tuis_fail(tag, "行输出里没有段表", ok);
        return false;
    }
    if js_arr_len(&segs) == 0 {
        return true;        // 空行：没有段，也就没有可判的
    }
    if !web_t_segs_valid(&segs, &txt, tag, ok) {
        return false;
    }
    // 整行：段列数合计 == 文本真实列宽。**这是右边框对齐的代数形式** ——
    // 老版这里差「汉字个数」列，正是用户看到的参差。
    const cols: usize = web_t_segs_cols(&segs);
    const all: usize = tty_cols_between(txt.ptr as &const byte, 0, txt.len);
    if cols != all {
        tuis_fail(tag, "整行段列数合计与文本真实列宽不符（右边框会参差）", ok);
        tuis_puts("  ");
        tuis_puts(what);
        tuis_puts(" 行 ");
        tuis_num(y);
        tuis_puts("：段列数=");
        tuis_num(cols);
        tuis_puts(" 真实列宽=");
        tuis_num(all);
        tuis_puts(" 字节数=");
        tuis_num(txt.len);
        tuis_puts("\n");
        return false;
    }
    return true;
}

// 逐段跑「相接 / 正长度 / 不越界 / 字符边界 / 列数相符 / 单一宽度类」六条。
// 返回 false = 已置红。
fn web_t_segs_valid(segs: &const JsonValue, txt: &const Buf, tag: &const byte,
    ok: &bool) bool {
    const nseg: usize = js_arr_len(segs);
    var at: usize = 0;          // 下一个段应从哪个**码元**开始
    var k: usize = 0;
    while k < nseg {
        var s: JsonValue = JsonValue.json_null();
        if !js_arr_get(segs, k, &s) {
            break;
        }
        var su: i64 = 0;
        var sl: i64 = 0;
        var sc: i64 = 0;
        if !web_t_seg3(&s, &su, &sl, &sc) {
            tuis_fail(tag, "段不是「起始码元/长度码元/显示列数」三个数打头", ok);
            return false;
        }
        if su != (at as i64) {
            tuis_fail(tag, "段表不连续（段起点与上一段终点不接）", ok);
            return false;
        }
        if sl <= 0 || sc <= 0 {
            tuis_fail(tag, "有一个非正的段长（前端会切出空串或丢字）", ok);
            return false;
        }
        const u0: usize = su as usize;
        const ul: usize = sl as usize;
        if u0 + ul > txt.len {
            tuis_fail(tag, "段切到文本之外", ok);
            return false;
        }
        // 段边界必须落在**字符**边界上（不许是孤立代理的一半）
        const b_ok0: bool = web_t_units_boundary(txt.ptr as &const byte,
            txt.len, u0);
        const b_ok1: bool = web_t_units_boundary(txt.ptr as &const byte,
            txt.len, u0 + ul);
        if !b_ok0 || !b_ok1 {
            tuis_fail(tag, "段的码元边界切在字符中间（BMP 外字符被劈开）", ok);
            return false;
        }
        // 段表给的是**码元**，而宽度原语（tty_cols_between）吃的是**字节**偏移 ——
        // 两个单位之间要显式换算一次（这正是本轮那个 bug 的形状：把一种单位当另一种用）
        var b0: usize = 0;
        var b1: usize = 0;
        const ok0: bool = web_t_unit_to_byte(txt.ptr as &const byte, txt.len,
            u0, &b0);
        const ok1: bool = web_t_unit_to_byte(txt.ptr as &const byte, txt.len,
            u0 + ul, &b1);
        if !ok0 || !ok1 {
            tuis_fail(tag, "段边界换算不出字节偏移", ok);
            return false;
        }
        const wcol: usize = tty_cols_between(txt.ptr as &const byte, b0, b1);
        if wcol != (sc as usize) {
            tuis_fail(tag, "段的显示列数与它切出来的文本不符（宽字符算错了列）", ok);
            return false;
        }
        if !web_t_seg_one_class(txt.ptr as &const byte, txt.len, u0, ul) {
            tuis_fail(tag, "一个段里混了窄字与宽字（前端要按宽度类排版）", ok);
            return false;
        }
        at = u0 + ul;
        k = k + 1;
    }
    return true;
}

// 段表里所有段的**显示列数**合计。
fn web_t_segs_cols(segs: &const JsonValue) usize {
    const nseg: usize = js_arr_len(segs);
    var cols: usize = 0;
    var k: usize = 0;
    while k < nseg {
        var s: JsonValue = JsonValue.json_null();
        if js_arr_get(segs, k, &s) {
            var a: i64 = 0;
            var b: i64 = 0;
            var c: i64 = 0;
            if web_t_seg3(&s, &a, &b, &c) && c > 0 {
                cols = cols + (c as usize);
            }
        }
        k = k + 1;
    }
    return cols;
}

// 把**码元**偏移换算成**字节**偏移（`u` 必须落在字符边界上）。返回 false = 越界
// 或不在边界上。
fn web_t_unit_to_byte(p: &const byte, n: usize, u: usize, out: &usize) bool {
    var units: usize = 0;
    var i: usize = 0;
    while i < n {
        if units == u {
            out[0] = i;
            return true;
        }
        const cp: u32 = tty_utf8_decode(p, i, n);
        units = units + web_t_cp_units(cp);
        i = tty_utf8_next(p, i, n);
    }
    if units == u {
        out[0] = n;
        return true;
    }
    return false;
}

// 段的前三个整数（起始码元 / 长度码元 / 显示列数）。
fn web_t_seg3(s: &JsonValue, a: &i64, b: &i64, c: &i64) bool {
    var v: JsonValue = JsonValue.json_null();
    if !js_arr_get(s, 0, &v) || !js_i64_of(&v, a) {
        return false;
    }
    if !js_arr_get(s, 1, &v) || !js_i64_of(&v, b) {
        return false;
    }
    if !js_arr_get(s, 2, &v) || !js_i64_of(&v, c) {
        return false;
    }
    return true;
}

// `off` 是一个**字符**边界吗（UTF-16 码元口径：BMP 外字符占 2，切在中间就是半个
// 代理对，JS 里渲染成 `�`）。判据：off 落在某个码元的起点上。
fn web_t_units_boundary(p: &const byte, n: usize, off: usize) bool {
    var units: usize = 0;
    var i: usize = 0;
    while i < n {
        if units == off {
            return true;
        }
        const cp: u32 = tty_utf8_decode(p, i, n);
        units = units + web_t_cp_units(cp);
        i = tty_utf8_next(p, i, n);
    }
    return units == off;
}

// 一个码点占几个 UTF-16 码元（BMP 外 2，其余 1）。
fn web_t_cp_units(cp: u32) usize {
    if cp >= 0x10000 && cp <= 0x10FFFF {
        return 2;
    }
    return 1;
}

// `[u0, u0+len)` 这一段（**码元**区间）是不是同一个宽度类（全是宽字或全是窄字）。
fn web_t_seg_one_class(p: &const byte, n: usize, u0: usize, len: usize) bool {
    if len == 0 {
        return true;
    }
    var units: usize = 0;
    var i: usize = 0;
    var want: bool = false;
    var first: bool = true;
    var seen: usize = 0;
    while i < n && seen < len {
        const cp: u32 = tty_utf8_decode(p, i, n);
        const cu: usize = web_t_cp_units(cp);
        // 只判落在 [u0, u0+len) 里的码点
        if units >= u0 && units + cu <= u0 + len {
            const isw: bool = tty_char_cols(cp) == 2;
            if first {
                want = isw;
                first = false;
            } else if isw != want {
                return false;
            }
            seen = seen + cu;
        } else if units >= u0 + len {
            break;
        }
        units = units + cu;
        i = tty_utf8_next(p, i, n);
    }
    return true;
}

// web-http：监听 + 端点分发的**纯函数侧**（真 socket 那条留给手验）。
//   这里只钉两件在自测里可判的事：
//   ① `srv_query_get` 能从**带路径前缀**的 URL 里取到参数（这是修过的那个
//      「永远回 missing id」的回归判据）；
//   ② `web_addr_parse` 的三种形态（默认 / 127.0.0.1:PORT / 0.0.0.0:PORT）
//      与三种拒绝（别的 IP / 非数字端口 / 缺端口）。
export fn web_http_round(tag: &const byte) bool {
    var ok: bool = true;
    // ① 带前缀的 query 解析
    var url: [byte: 64] = "/api/screen?id=abc123&x=1";
    const u: &const byte = &url[0] as &const byte;
    const un: usize = bufx_cstr_len(u);
    var path_len: usize = 0;
    var q_off: usize = 0;
    var q_len: usize = 0;
    srv_url_split(u, 0, un, &path_len, &q_off, &q_len);
    if path_len != 11 {
        tuis_fail(tag, "url_split 的 path 长度不是 11（/api/screen）", &ok);
    }
    var id: Buf = buf_new(64);
    defer { buf_free(&id); }
    if !srv_query_get(u, 0, q_off, q_len, "id" as &const byte, &id) {
        tuis_fail(tag, "srv_query_get 取不到 id（带路径前缀的 URL）", &ok);
    } else if !bufx_eq_cstr(id.ptr as &const byte, id.len, "abc123") {
        tuis_fail(tag, "srv_query_get 取到的 id 不对", &ok);
        tuis_puts("  得到：");
        tuis_puts(id.ptr as &const byte);
        tuis_puts("\n");
    }
    // 取第二个参数（值的边界是 '&'）
    var x: Buf = buf_new(16);
    defer { buf_free(&x); }
    if !srv_query_get(u, 0, q_off, q_len, "x" as &const byte, &x) {
        tuis_fail(tag, "srv_query_get 取不到第二个参数", &ok);
    } else if !bufx_eq_cstr(x.ptr as &const byte, x.len, "1") {
        tuis_fail(tag, "第二个参数的值不对（'&' 边界）", &ok);
    }
    // ② 地址解析
    var a: byte = 0;
    var b: byte = 0;
    var c: byte = 0;
    var d: byte = 0;
    var port: u16 = 0;
    if !web_addr_parse("" as &const byte, 0, &a, &b, &c, &d, &port)
        || a != 127 || b != 0 || c != 0 || d != 1 || port != 8787 {
        tuis_fail(tag, "空地址没有回到默认 127.0.0.1:8787", &ok);
    }
    const s1: &const byte = "127.0.0.1:8791" as &const byte;
    if !web_addr_parse(s1, 14, &a, &b, &c, &d, &port) || port != 8791 {
        tuis_fail(tag, "127.0.0.1:8791 解析出的端口不是 8791", &ok);
        tuis_puts("  得到端口=");
        tuis_num(port as usize);
        tuis_puts("\n");
    }
    const s2: &const byte = "0.0.0.0:0" as &const byte;
    if !web_addr_parse(s2, 9, &a, &b, &c, &d, &port) || a != 0 || port != 0 {
        tuis_fail(tag, "0.0.0.0:0（内核分配端口）解析失败", &ok);
    }
    const s3: &const byte = "1.2.3.4:80" as &const byte;
    if web_addr_parse(s3, 10, &a, &b, &c, &d, &port) {
        tuis_fail(tag, "1.2.3.4:80 不该被接受（只许 127.0.0.1 / 0.0.0.0）", &ok);
    }
    const s4: &const byte = "127.0.0.1" as &const byte;
    if web_addr_parse(s4, 9, &a, &b, &c, &d, &port) {
        tuis_fail(tag, "缺端口的地址不该被接受", &ok);
    }
    const s5: &const byte = "127.0.0.1:abc" as &const byte;
    if web_addr_parse(s5, 13, &a, &b, &c, &d, &port) {
        tuis_fail(tag, "非数字端口不该被接受", &ok);
    }
    // ③ 图片 id 的十六进制校验（路径穿越的唯一入口）
    var h1: Buf = buf_new(16);
    defer { buf_free(&h1); }
    _ = buf_append_cstr(&h1, "abc123");
    if !web_id_is_hex(&h1) {
        tuis_fail(tag, "合法十六进制 id 被判成非法", &ok);
    }
    var h2: Buf = buf_new(16);
    defer { buf_free(&h2); }
    _ = buf_append_cstr(&h2, "../../etc/passwd");
    if web_id_is_hex(&h2) {
        tuis_fail(tag, "带 ../ 的 id 没被拒（路径穿越！）", &ok);
    }
    var h3: Buf = buf_new(16);
    defer { buf_free(&h3); }
    _ = buf_append_cstr(&h3, "abc/def");
    if web_id_is_hex(&h3) {
        tuis_fail(tag, "带 / 的 id 没被拒（路径穿越！）", &ok);
    }
    if ok {
        tuis_ok(tag, "HTTP 侧：带前缀 query 解析 + 地址三形态三拒绝 + 图片 id 十六进制校验");
    }
    return ok;
}

// web-dispatch：钉住「一次请求只分派一次」。
//
// 这条是**真踩到的回归**：`web_handle` 的返回值语义是「要不要留着这个连接」，
// 而第一版把各端点函数的返回值（其实是 `srv_send_response` 的「写成功」）直接当成了
// 它 —— 于是每个 JSON 端点都「留着连接」，下一圈 poll 又就绪、`c.rx` 里还是同一份
// 请求原文 ⇒ **端点执行两次**。症状在浏览器上是「点一次 `+` 多出一条会话」，
// 在服务端日志上是同一个 fd 连着两次 `RX_OK`。
//
// 判据：拿一个 socketpair 当连接（这样响应真能写出去），用**真实的请求原文**走
// `srv_recv_request` + `web_handle`，断言 `GET /` 与 `POST /api/sessions` 都返回
// **false**（= 关连接），而返回 true 的只有 `/api/screen`。把返回值抄错时当场红。
export fn web_dispatch_round(tag: &const byte) bool {
    var ok: bool = true;
    // 用**管道**当连接：分派只用到「能写出去」这一件事（响应是一次性写完的），
    // 不需要真的双向 socket。写端当连接 fd，读端留着（读走响应，避免管道满）。
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_ok(tag, "跳过（管道不可用）");
        return true;
    }
    const srv_fd: i32 = fds[1];      // 我们写这一端（= 连接）
    const cli_fd: i32 = fds[0];      // 另一端：读走响应
    defer {
        _ = sys_close(srv_fd) catch {};
        _ = sys_close(cli_fd) catch {};
    }
    var conn: WebConn = web_conn_value_empty();
    defer { web_conn_free(&conn); }
    if !web_conn_init(&conn, srv_fd) {
        tuis_fail(tag, "连接初始化失败", &ok);
        return false;
    }
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    var t: WebTable = web_table_zero();
    web_table_init(&t);
    defer { web_table_free(&t); }
    // ① GET /：必须返回 false
    const req_get: &const byte =
        "GET / HTTP/1.1\r\nHost: x\r\n\r\n" as &const byte;
    if !web_t_dispatch(cfg, t, &conn, req_get, &ok, tag) {
        // 细节由 web_t_dispatch 打
    }
    // ② POST /api/sessions：也必须返回 false
    //    （这条是那条真回归的直接判据）
    // ⚠ 这里必须用**转义的 \r\n**，不能写成反引号原始串里的裸换行：
    // `srv_recv_request` 找的终止符是 `\r\n\r\n`，裸 `\n` 永远匹配不上 ⇒ 它会
    // 转去 `read(c.fd)`，而 `c.fd` 是**管道的写端**（响应正写在那里）—— 于是它把
    // **上一次的响应**读回来当请求解析，碰巧里面有 `\r\n\r\n` 就"通过"了。
    // 那是一条**假绿**：单跑绿、合并后绿/红看时序（实测：合入 main 后这一轮红了）。
    // 判据：fixture 的字节必须让 `srv_recv_request` **不读 fd** 就能判 OK。
    const req_post: &const byte =
        "POST /api/sessions HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n"
        as &const byte;
    if !web_t_dispatch_expect_false(cfg, t, &conn, req_post, tag, &ok) {
    }
    // ③ **带尺寸**的 POST /api/sessions?cols=&rows= —— 页面报来的尺寸要真的进
    //    这条链路（用户报的「新建会话宽度不对」）。判据是「分派完之后表里那条
    //    会话记的就是 150×40」：只看 URL 解析不够（解析对了、忘了往下传一样错）。
    if t.n > 0 {
        const s0: &const WebSession = &t.items[0];
        if s0.cols != EMU_DEF_COLS || s0.rows != EMU_DEF_ROWS {
            tuis_fail(tag, "不带尺寸的新建会话没有用默认画布", &ok);
        }
    }
    // 行宽豁免：HTTP 请求原文不可断（拆行就改变了字节）
    const req_sized: &const byte =
        "POST /api/sessions?cols=150&rows=40 HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n"
        as &const byte;
    const before: usize = t.n;
    if !web_t_dispatch_expect_false(cfg, t, &conn, req_sized, tag, &ok) {
    }
    if t.n == before {
        tuis_fail(tag, "带尺寸的 POST /api/sessions 没有建出会话", &ok);
    } else if t.n > 0 && t.n <= WEB_MAX_SESSIONS {
        // 显式夹取（数组边界证明器只认这种形状，见 §16 踩坑 6）
        const s1: &const WebSession = &t.items[t.n - 1];
        if s1.cols != 150 || s1.rows != 40 {
            tuis_fail(tag,
                "POST /api/sessions?cols=150&rows=40 建出来的会话不是 150×40（尺寸没传到）",
                &ok);
            tuis_puts("  得到：");
            tuis_num(s1.cols);
            tuis_puts("x");
            tuis_num(s1.rows);
            tuis_puts("\n");
        }
    }
    if ok {
        tuis_ok(tag, "分派语义：非长连接端点返回 false（一次请求只分派一次；`+` 只建一条会话）+ 尺寸从 URL 传到会话");
    }
    return ok;
}

// 走一遍「收全请求 → 分派」，断言**非长连接**端点返回 false。
fn web_t_dispatch_expect_false(cfg: &const Config, t: &WebTable, c: &WebConn,
    req: &const byte, tag: &const byte, ok: &bool) bool {
    buf_reset(&c.rx);
    _ = buf_append(&c.rx, req, bufx_cstr_len(req));
    var m: u8 = 0;
    var url_off: usize = 0;
    var url_len: usize = 0;
    var body_off: usize = 0;
    const rc: i32 = srv_recv_request(c.fd, &c.rx, &m, &url_off, &url_len,
        &body_off);
    if rc != SRV_RX_OK {
        // 这段原文已经全在缓冲里，`srv_recv_request` 应当**不读 fd** 就直接判 OK。
        // 走到别的分支就说明夹具的字节不对（见 req_post 上面那条注：裸 `\n` 会让
        // 它转去读 fd，把上一次的响应当请求 —— 假绿）。
        tuis_fail(tag, "请求原文没有被判成完整请求（夹具问题）", ok);
        tuis_puts("  rc=");
        tuis_num(rc as usize);
        tuis_puts("\n");
        return false;
    }
    // 再钉一条：解析出来的必须是**我们给的那份**原文（url_len 是路径长度，
    // 不是从管道读回来的别的东西）。`/api/sessions` = 13 字节。
    if url_len == 0 || url_len > 64 {
        tuis_fail(tag, "解析出的 url_len 不像我们给的那份请求（夹具串了）", ok);
        return false;
    }
    var id: Buf = buf_new(64);
    defer { buf_free(&id); }
    var q: Buf = buf_new(64);
    defer { buf_free(&q); }
    const keep: bool = web_handle(cfg, t, c, m, url_off, url_len, body_off,
        &id, &q);
    if keep {
        tuis_fail(tag, "非长连接端点返回了 true（会被当成「留着连接」⇒ 端点会再跑一遍）", ok);
        return false;
    }
    return true;
}

// `web_t_dispatch` 是上面那个的薄包装（① 只判「没红」）。
fn web_t_dispatch(cfg: &const Config, t: &WebTable, c: &WebConn,
    req: &const byte, ok: &bool, tag: &const byte) bool {
    return web_t_dispatch_expect_false(cfg, t, c, req, tag, ok);
}

// ============================================================
// web-frame：推帧的**空帧判据**与「推完才推进基准」
// ============================================================

// 这一轮的现场（DESIGN §16 踩坑 106）：用户报「web 页面不会实时刷新」——
// 首帧出来之后就再也不动了。根因是 `web_push_frame` 里的空帧判据：
//   `srv_find(frame, "\"rows_changed\":[]", 16)`  —— **长度写成了 16，而那个
//   字面量是 17 字节**。于是它拿「`"rows_changed":[` + 后面一个字节」去比，
//   在**每一帧**里都命中（帧里必然有 `"rows_changed":[`）⇒ 判据恒为真 ⇒ 每一帧
//   都被当空帧丢掉（实测：`syscw` 在首帧之后再不动一个字，页面上打字没反应）。
// 判据全部走生产代码真用的那一支 `web_push_session` / `web_push_frame`（不另写
// 一份等价判断 —— 那样就变成「自测绿、真机红」）。五条：
//   ① **首帧是全量**，且给所有订阅者；
//   ② **文本变了要推**，推出去的帧里要有刚写进去的那一行；
//   ③ **光标单独动也推**：只动光标（一行文本都不改）⇒ 仍要出一帧（页面上光标块
//      不动就是这条没做 —— `emu_frame_changed` 的由来）；
//   ④ **真没变就不推**（空帧流量没有意义）：什么都不动 ⇒ 管道里一个字节都不多；
//   ⑤ **多订阅者**：同一会话两条连接都要拿到（差分基准在会话上，推完才推进 ——
//      老顺序是「第一个订阅者推完就推进基准」⇒ 第二条永远收不到）；
//   ⑥ **只改样式也要推**（踩坑 113）：同一段文本重画一遍、只加 `ESC[7m` ⇒ 帧里那一行
//      必须带反显属性（老判据只比文本 ⇒ 浮层里按 ↑/↓ 高亮不动）；
//   ⑥b 再推一次（样式也没变）⇒ 仍然一个字节都不推（样式基准要跟着收）。
//   ⑦ **摘表不换身份**（踩坑 114）：订阅 B、`web_remove_at` 摘掉**前面**的 A（B 因此
//      前移到下标 0）⇒ 没变时仍不推、改了 B 的一行仍必须推到；「按表内下标认会话」
//      的老写法在这里推不出来。
//
// 观测点是**管道的读端**（不是 `c.out`）：`web_push_frame` 排完队会立刻
// `web_flush_conn` 尽力写一次，写成功就把 `c.out` 重置了 —— 只看 `c.out` 会
// 把「推了并且写成功了」误判成「没推」。
export fn web_frame_round(tag: &const byte) bool {
    var ok: bool = true;
    var t: WebTable = web_table_zero();
    web_table_init(&t);
    defer { web_table_free(&t); }
    // 一条合成会话：**不 fork**（这一轮判的是推帧逻辑，子进程只会让它变慢、
    // 还引入时序）。id / pending / scratch / emu 都按 `web_session_new` 的口径建。
    if !web_t_session_make(&t, 0, "session-web-frame") {
        tuis_fail(tag, "合成会话建不起来", &ok);
        return false;
    }
    const s: &WebSession = &t.items[0];
    // 两条连接（同一会话）—— 判据 ⑤ 用。用管道当连接：推帧只要求「能写出去」。
    var conns: [WebConn: WEB_MAX_CONNS] = [web_conn_value_empty()
        : WEB_MAX_CONNS];
    var used: [bool: WEB_MAX_CONNS] = [false: WEB_MAX_CONNS];
    var fds: [i32: 4] = [0: 4];
    if !web_t_two_conns(&conns[0], &used[0], &fds[0], s, tag, &ok) {
        return ok;
    }
    defer { web_t_conns_close(&conns[0], &used[0], &fds[0]); }
    var got0: Buf = buf_new(0);
    defer { buf_free(&got0); }
    var got1: Buf = buf_new(0);
    defer { buf_free(&got1); }
    // ① 首帧：两条连接都要拿到，且必须是**全量**（只发差分拼不出屏幕）
    web_push_session(s, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    web_t_window(fds[2], &got1);
    if got0.len == 0 || got1.len == 0 {
        tuis_fail(tag, "首帧没有推给所有订阅者（第二条连接收不到帧）", &ok);
    } else if find_sub(got0.ptr[0: got0.len],
        "\"full\":true"[0: 11], 0) < 0 {
        tuis_fail(tag, "首帧不是全量（新连接拼不出屏幕）", &ok);
    }
    // ② 改一行文本 ⇒ 必须推，且帧里要有那一行
    const line: &const byte = "HELLO-FRAME" as &const byte;
    emu_feed(&s.emu, line, 11);
    web_push_session(s, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    if got0.len == 0 {
        tuis_fail(tag, "文本变了却一帧都不推（页面不刷新）", &ok);
    } else if find_sub(got0.ptr[0: got0.len], line[0: 11], 0) < 0 {
        tuis_fail(tag, "推出去的帧里没有刚写进去的那一行", &ok);
    }
    // ③ 只动光标（一行文本都不改）⇒ 仍要推 —— `ESC[1;5H` 只挪光标
    const cur_move: &const byte = "\x1b[1;5H" as &const byte;
    emu_feed(&s.emu, cur_move, 6);
    web_push_session(s, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    if got0.len == 0 {
        tuis_fail(tag, "只动光标时一帧都不推（页面上光标块不动）", &ok);
    }
    // ④ 什么都不动 ⇒ 一个字节都不推（空帧流量没有意义）
    web_push_session(s, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    if got0.len != 0 {
        tuis_fail(tag, "什么都没变还在推帧（空帧流量）", &ok);
        tuis_puts("  推了 ");
        tuis_num(got0.len);
        tuis_puts(" 字节\n");
    }
    // ⑤ 再改一次文本：两条订阅者**都要**拿到（差分基准在会话上，推完才推进）
    const line2: &const byte = "SECOND-LINE" as &const byte;
    emu_feed(&s.emu, line2, 11);
    web_push_session(s, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    web_t_window(fds[2], &got1);
    if got0.len == 0 || got1.len == 0 {
        tuis_fail(tag, "同一会话的两条订阅者没有都拿到帧（第二条被基准推进吃掉）",
            &ok);
    }
    // ⑥ **只改样式、一个字都不改** ⇒ 仍要推（踩坑 113）
    //
    // 现场（用户报的「弹窗里按键选择后没有高亮」）：浮层里按 ↑/↓ 只换 SGR ——
    // 选中项那一行**一个字符都不改**。老判据只比行文本，于是这一帧被当空帧丢掉，
    // 页面上的高亮永远停在原处（实测长连接上连按 3 次 ↓，推出去的三帧里
    // `rows_changed` 只有光标那一行，没有任何一行带反显属性）。
    //
    // 这一步用**同一段文本重画一遍、只加 `ESC[7m`**：文本逐字节相同，只有样式变了。
    // 断言两件事：① 推出了帧；② 帧里那一行真的带反显（`attr=16`）——
    // 只断「推出了字节」是不够的，那样判据会退化成「只要推了就算对」。
    const plain: &const byte = "\x1b[2;1HSTYLE-ONLY" as &const byte;
    emu_feed(&s.emu, plain, bufx_cstr_len(plain));
    web_push_session(s, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    const rev: &const byte = "\x1b[2;1H\x1b[7mSTYLE-ONLY\x1b[0m" as &const byte;
    emu_feed(&s.emu, rev, bufx_cstr_len(rev));
    web_push_session(s, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    if got0.len == 0 {
        tuis_fail(tag, "只改样式（文本一个字符没变）就一帧都不推（高亮不动）", &ok);
    } else if !web_t_frame_has_reverse(&got0) {
        tuis_fail(tag, "推出去的帧里那一行没有反显属性（高亮还是画不出来）", &ok);
    }
    // ⑥b 再推一次：真没变 ⇒ 仍然一个字节都不推（样式基准也要收，不能只收文本）
    web_push_session(s, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    if got0.len != 0 {
        tuis_fail(tag, "样式也没变还在推帧（样式基准没跟着收）", &ok);
        tuis_puts("  推了 ");
        tuis_num(got0.len);
        tuis_puts(" 字节\n");
    }
    // ⑦ **摘表不能改变「谁在订哪条会话」**（踩坑 114）：再建一条会话 B 放在后面、
    //    把订阅切到 B，然后 `web_remove_at` 把**前面那条**（A）摘掉 —— B 会前移到
    //    下标 0（= A 原来的位置），而订阅者订的还是 B，必须继续收到 B 的帧。
    //
    //    为什么这条必须钉：老版拿**表内下标**当订阅身份，摘表会让后面的条目整体
    //    前移，于是「连接记的下标 1」在 A 被摘掉之后就落到了空处 ⇒ 推帧推不出去，
    //    真正在看的这条**再也不刷新**（实测：订阅最后一条会话时关掉第一条，长连接
    //    上一帧都不再出来，页面永久冻死）。
    //
    //    先推一次把 B 的基准建起来（`have_prev`）：不然这一步的「没变就不推」
    //    会被 B 的首帧全量顶掉。
    if !web_t_session_make(&t, 1, "session-web-frame-b") {
        tuis_fail(tag, "第二条合成会话建不起来", &ok);
        return ok;
    }
    if !web_t_conn_retarget(&conns[0], &t.items[1]) {
        tuis_fail(tag, "连接改订 B 失败", &ok);
    }
    const line4: &const byte = "B-FIRST" as &const byte;
    emu_feed(&t.items[1].emu, line4, 7);
    web_push_all(&t, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    if got0.len == 0 {
        tuis_fail(tag, "切到另一条会话之后收不到它的帧（订阅按 id 匹配就没这问题）",
            &ok);
    }
    web_remove_at(&t, 0);            // 摘掉**前面**那条（A）—— B 前移到下标 0
    if t.n != 1 {
        tuis_fail(tag, "web_remove_at 之后表里不止一条会话", &ok);
    }
    web_push_all(&t, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    if got0.len != 0 {
        tuis_fail(tag, "摘掉别的会话之后凭空推了一帧（基准被移动的表搅了）", &ok);
    }
    const line3: &const byte = "AFTER-REMOVE" as &const byte;
    emu_feed(&t.items[0].emu, line3, 12);
    web_push_all(&t, &conns[0], &used[0]);
    web_t_window(fds[0], &got0);
    if got0.len == 0 {
        tuis_fail(tag,
            "摘掉前面一条会话之后订阅者收不到帧了（订阅按表内下标认会话）", &ok);
    } else if find_sub(got0.ptr[0: got0.len], line3[0: 12], 0) < 0 {
        tuis_fail(tag, "推出去的帧不是订阅的那条会话的（身份漂到别处了）", &ok);
    }
    if ok {
        tuis_ok(tag, "推帧：文本变/光标动/样式变都推、真没变不推、多订阅者都拿到、摘表不换身份");
    }
    return ok;
}

// 把一条连接的订阅身份改成 `s`（本轮的 ⑦ 用：模拟用户在两条会话之间切来切去）。
fn web_t_conn_retarget(c: &WebConn, s: &const WebSession) bool {
    if s.id.len == 0 {
        return false;
    }
    buf_reset(&c.sid);
    return buf_append(&c.sid, s.id.ptr as &const byte, s.id.len);
}

// 帧里有没有一行带**反显**属性（段表第 4 个数 attr 的 bit4 == 16）。
//
// 判据走**解真发出去的 JSON**，不在字节里找特征串 —— 找特征串的写法错一位就静默
// 翻转（踩坑 106 的教训：老版那个 `srv_find` 判据长度写错一位，于是每一帧都被当
// 空帧丢掉）。这里解出来逐段看 attr 位，判据与「前端会看到什么」同源。
//
// 逐**行**解：管道里是一帧一行的 NDJSON，而观测窗口里可能残留上一帧的尾巴
// （`web_t_drain` 按「现有字节」取，读端不保证停在行首）。拿整段去 parse 就会
// 因为那个残尾失败 —— 那正是这个辅助函数第一版的样子（帧里明明有 `16`，判据却
// 说没有）。
fn web_t_frame_has_reverse(frame: &const Buf) bool {
    var i: usize = 0;
    while i < frame.len {
        var j: usize = i;
        while j < frame.len && frame.ptr[j] != 10 as byte {
            j = j + 1;
        }
        if j > i && web_t_line_has_reverse(frame, i, j) {
            return true;
        }
        i = j + 1;
    }
    return false;
}

// 单独一行（`[from, to)`，不含换行）里有没有反显段。不是完整 JSON（上一帧的残尾）
// 或解不开就是 false。
fn web_t_line_has_reverse(frame: &const Buf, from: usize, to: usize) bool {
    if frame.ptr[from] != 123 as byte {         // '{'
        return false;
    }
    var raw: &void = malloc(65536);
    if ((raw as &byte) as usize) == 0 {
        return false;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, frame.ptr + from, to - from, &root) {
        return false;
    }
    var rows: JsonValue = JsonValue.json_null();
    if !js_obj_get(&root, "rows_changed" as &const byte, 12, &rows) {
        return false;
    }
    const nr: usize = js_arr_len(&rows);
    var i: usize = 0;
    while i < nr {
        var row: JsonValue = JsonValue.json_null();
        if !js_arr_get(&rows, i, &row) {
            return false;
        }
        var segs: JsonValue = JsonValue.json_null();
        if !js_arr_get(&row, 2, &segs) {
            i = i + 1;
            continue;
        }
        const ns: usize = js_arr_len(&segs);
        var k: usize = 0;
        while k < ns {
            var sg: JsonValue = JsonValue.json_null();
            if js_arr_get(&segs, k, &sg) {
                var attr: i64 = 0;
                var av: JsonValue = JsonValue.json_null();
                if js_arr_get(&sg, 3, &av) && js_i64_of(&av, &attr) {
                    if (attr & (16 as i64)) != 0 {
                        return true;
                    }
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
    return false;
}

// 开两对管道、建两条**订阅同一会话**的长连接。返回 false = 没建起来 —— 所以
// `ok` 保持原值（管道不可用 = 这一轮**跳过**、算过；初始化失败 = 已经置红）。
//
// 订阅身份是**会话 id**（`sid`），不是表内下标（踩坑 114）—— 所以这里要拿真 id
// 填进去；`s` 为 null 时留空（= 谁都不订）。
fn web_t_two_conns(conns: &WebConn, used: &bool, fds: &i32,
    s: &const WebSession, tag: &const byte, ok: &bool) bool {
    if (sys_pipe2(fds, 0) catch { -1; }) != 0 {
        tuis_ok(tag, "跳过（管道不可用）");
        return false;
    }
    if (sys_pipe2(fds + 2, 0) catch { -1; }) != 0 {
        _ = sys_close(fds[0]) catch {};
        _ = sys_close(fds[1]) catch {};
        tuis_ok(tag, "跳过（管道不可用）");
        return false;
    }
    // 读端非阻塞：下面按「这段窗口里读到了什么」判，不能卡住
    web_t_nonblock(fds[0]);
    web_t_nonblock(fds[2]);
    if !web_conn_init(&conns[0], fds[1]) || !web_conn_init(&conns[1], fds[3]) {
        tuis_fail(tag, "连接初始化失败", ok);
        _ = sys_close(fds[0]) catch {};
        _ = sys_close(fds[1]) catch {};
        _ = sys_close(fds[2]) catch {};
        _ = sys_close(fds[3]) catch {};
        return false;
    }
    used[0] = true;
    used[1] = true;
    var k: usize = 0;
    while k < 2 {
        conns[k].st = WEB_CONN_STREAM;
        buf_reset(&conns[k].sid);
        if s != null && s.id.len > 0 {
            _ = buf_append(&conns[k].sid, s.id.ptr as &const byte, s.id.len);
        }
        k = k + 1;
    }
    return true;
}

// 收两对管道与两条连接（幂等；`used` 说哪几条真的建起来了）。
fn web_t_conns_close(conns: &WebConn, used: &bool, fds: &i32) void {
    if used[0] {
        web_conn_free(&conns[0]);
    }
    if used[1] {
        web_conn_free(&conns[1]);
    }
    _ = sys_close(fds[0]) catch {};
    _ = sys_close(fds[1]) catch {};
    _ = sys_close(fds[2]) catch {};
    _ = sys_close(fds[3]) catch {};
}

// 「这一轮推了什么」的观测窗口：**先清空再读**管道。清空这一步不能省 ——
// `web_t_drain` 是**追加**语义，不 reset 的话上一轮读到的字节会留在缓冲里，
// 「这一轮没推」的断言就永远为假（假绿：什么都不推也算过）。
fn web_t_window(fd: i32, out: &Buf) void {
    buf_reset(out);
    web_t_drain(fd, out);
}

// 建一条合成会话（不 fork、不开 PTY）：id / pending / scratch / emu 按生产口径建。
// 返回 false = 分配失败。
fn web_t_session_make(t: &WebTable, i: usize, id: &const byte) bool {
    if i >= WEB_MAX_SESSIONS {
        return false;
    }
    const s: &WebSession = &t.items[i];
    s.id = buf_new(64);
    s.pending = buf_new(256);
    s.scratch = buf_new(EMU_MAX_COLS * 4 + 16);
    var k: usize = 0;
    while k < WEB_REPLAY_FRAMES {
        s.replay[k] = buf_new(0);
        k = k + 1;
    }
    if !buf_valid(&s.id) || !buf_valid(&s.pending) || !buf_valid(&s.scratch) {
        return false;
    }
    if !emu_init(&s.emu, 100, 30) {
        return false;
    }
    _ = buf_append(&s.id, id, bufx_cstr_len(id));
    s.pid = 0;
    s.master = -1;
    s.alive = true;
    t.n = i + 1;
    return true;
}

// ============================================================
// web-pty：会话子进程死掉之后，主循环必须**收口**而不是空转
// ============================================================

// 这一轮的现场（DESIGN §16 踩坑 105）：子进程退出后 PTY master 上的 `read` 返回
// **EIO**（不是 0），而只认 `n == 0` 的旧判据收不掉它；master 不关 ⇒ 水平触发的
// `POLLHUP` 每圈都让这个槽「就绪」⇒ 主循环纯忙等（实测 `syscr` 20 亿 / CPU 100%），
// 页面上则表现为**打字没有任何反应**。
//
// 判据全部走主循环真正用的那一支 `web_pty_ready`（不是另写一份等价判断 ——
// 那样就变成「自测绿、真机红」）。四条：
//   ① **最后一帧不丢**：子进程退出前写的字节要出现在网格里
//      （先 `POLLIN` 后 HUP，这条钉住顺序）；
//   ② **收口**：HUP 之后 `alive == false`、`master == -1`、子进程被回收
//      （不再是 `<defunct>` 僵尸）；
//   ③ **不忙等**：循环有限圈内结束（带 bug 的版本 ①②③ 全红，且这里会先撞圈数上限）；
//   ④ **幂等**：再喂一次 HUP 什么都不变。
export fn web_pty_round(tag: &const byte) bool {
    var ok: bool = true;
    var t: WebTable = web_table_zero();
    web_table_init(&t);
    defer { web_table_free(&t); }
    var slave: Buf = buf_new(64);
    defer { buf_free(&slave); }
    const m: i32 = web_t_pty_open(&slave, 100, 30);
    if m < 0 {
        tuis_ok(tag, "跳过（打不开 /dev/ptmx）");
        return true;
    }
    // 子进程：写一段可识别字节，然后**退出**（不关 fd 也一样 —— 进程一没，
    // 从设备就没有持有者了，master 上立刻是 HUP/EIO）
    const pid64: i64 = sys_fork() catch {
        srv_close(m);
        tuis_fail(tag, "fork 失败", &ok);
        return false;
    };
    if pid64 == 0 {
        const sf: i32 = sys_open(slave.ptr as *const byte, 0x102, 0) catch {
            -1;
        };
        if sf < 0 {
            sys_exit(9);
        }
        var msg: [byte: 16] = "PTYLASTFRAME\r\n";
        _ = sys_write(sf, &msg[0], 15) catch {};
        sys_exit(0);
    }
    const s: &WebSession = &t.items[0];
    web_session_zero(s);
    if !emu_init(&s.emu, 100, 30) {
        srv_close(m);
        tuis_fail(tag, "emu_init 失败", &ok);
        return false;
    }
    s.master = m;
    s.pid = i64_to_i32(pid64);
    s.alive = true;
    t.n = 1;
    const closed_at: usize = web_t_pty_pump(&t, s);
    // ③ 不忙等：带 bug 时 master 永不关闭 ⇒ 这里必然停在上限
    if s.master >= 0 {
        tuis_fail(tag,
            "子进程死了但 master 没关（poll 会永远就绪 ⇒ 主循环空转、页面打不进字）",
            &ok);
        tuis_puts("  循环圈数=");
        tuis_num(closed_at);
        tuis_puts(" master=");
        tuis_num(s.master as usize);
        tuis_puts("\n");
    }
    web_t_pty_assert_closed(tag, s, pid64 as i32, &ok);
    // ④ 幂等：再喂一次 HUP
    web_pty_ready(&t, 0, POLLHUP);
    if s.master >= 0 || s.alive {
        tuis_fail(tag, "重复喂 HUP 改变了状态（收口不幂等）", &ok);
    }
    if ok {
        tuis_puts("  循环圈数=");
        tuis_num(closed_at);
        tuis_puts("（有限 ⇒ 不空转）\n");
        tuis_ok(tag,
            "PTY 收口：最后一帧不丢 + HUP 关 master/回收子进程/标 dead + 幂等");
    }
    return ok;
}

// 跑到这条会话收口为止（**上限 64 圈**：带 bug 的版本永远收不掉，上限就是判据
// ③「不忙等」的机器实现）。返回实际圈数。
fn web_t_pty_pump(t: &WebTable, s: &WebSession) usize {
    var rounds: usize = 0;
    while rounds < 64 && s.master >= 0 {
        rounds = rounds + 1;
        var pfds: [PollFd: 1] = [
            PollFd{ fd: s.master, events: POLLIN, revents: 0 },
        ];
        const pr: i32 = sys_poll(&pfds[0], 1, 200) catch { 0; };
        if pr > 0 && pfds[0].revents != 0 {
            web_pty_ready(t, 0, pfds[0].revents);
        }
    }
    return rounds;
}

// 收口之后的四条断言：① 最后一帧不丢 ② `alive == false` ③ `pid` 清零（= 真的
// waitpid 收到了）④ 子进程不再是僵尸。只置 ok，不早退（与文件头不变量 ③ 同口径）。
fn web_t_pty_assert_closed(tag: &const byte, s: &const WebSession, pid: i32,
    ok: &bool) void {
    // ① 最后一帧不丢（子进程退出前写的字节必须在网格里）
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    emu_text(&s.emu, &text);
    if !web_t_contains(&text, "PTYLASTFRAME" as &const byte) {
        tuis_fail(tag, "子进程退出前的最后一段输出丢了（应先 POLLIN 后 POLLHUP）",
            ok);
    }
    // ② 收口
    if s.alive {
        tuis_fail(tag, "会话仍标着 alive（页面上这条会话永远「活着」）", ok);
    }
    // ③ `pid` 清零。这**本身**就是「真的收到了」的判据（`web_reap_child` 只在
    // waitpid 收到那个 pid 时才返回 true）—— 留着旧 pid 会在退出收尾时 `kill`
    // 一个可能已被内核回收复用的 pid，那是**误杀别人**。
    if s.pid != 0 {
        tuis_fail(tag, "子进程没被回收（pid 还留着 ⇒ 退出时可能误杀复用的 pid）",
            ok);
    }
    // ④ 不是僵尸：再 wait 一次应该收不到它了（ECHILD）。
    var st: i32 = 0;
    const w: i32 = sys_waitpid(pid, &st, 1) catch { -1; };
    if w == pid {
        tuis_fail(tag, "子进程还是僵尸（没有 waitpid 回收）", ok);
    }
}

// 开一对 pty（与 websrv 的 `web_pty_open` 同一套 ioctl；自测自己开一份，
// 不去动生产代码里的私有件）。返回 master fd，slave 路径写进 slave_path。
fn web_t_pty_open(slave_path: &Buf, cols: usize, rows: usize) i32 {
    var ptmx: [byte: 16] = "/dev/ptmx";
    const m: i32 = sys_open(&ptmx[0] as *const byte, 0x102, 0) catch { -1; };
    if m < 0 {
        return -1;
    }
    var zero: i32 = 0;
    if (sys_ioctl(m, 0x40045431, web_t_addr(&zero as &const void)) catch {
        -1;
    }) != 0 {
        srv_close(m);
        return -1;
    }
    var num: i32 = 0;
    if (sys_ioctl(m, 0x80045430, web_t_addr(&num as &const void)) catch {
        -1;
    }) != 0 {
        srv_close(m);
        return -1;
    }
    buf_reset(slave_path);
    _ = buf_append_cstr(slave_path, "/dev/pts/");
    _ = buf_append_u64(slave_path, num as u64);
    _ = buf_append_byte(slave_path, 0);     // 尾 NUL：这个路径要直接喂 sys_open
    web_set_winsize(m, cols, rows);
    return m;
}

// 指针 → i64（ioctl 的地址参数要整数）。
fn web_t_addr(p: &const void) i64 {
    return (@usize_from_ptr(p)) as i64;
}

// ============================================================
// web-size：新建会话的尺寸**握手**（用户报的「新建会话宽度不对」）
// ============================================================

// 现场：页面上量到 176×48，点 `+` 建出来的新会话却是 **100×30** —— 服务端恒定用
// `EMU_DEF_COLS/ROWS` 起子进程，页面报来的尺寸根本没进这条链路。新标签因此先显示
// 一屏按 100 列排的 TUI（右边一片空白/挤在一起），要切一下标签才被 resize 追上。
//
// 判据三条（走生产代码真用的那一支 `web_session_new` + `web_get_winsize`）：
//   ① 报 150×40 ⇒ 会话记 150×40，**且 PTY 窗口也是 150×40**（钉「尺寸真的到了
//      子进程那一侧」—— 只改 `s.cols` 的话 TUI 还是按旧尺寸排版）；
//   ② 不报（0/0）⇒ 默认画布；
//   ③ 报超上限 ⇒ 夹到 `EMU_MAX_*`，**且与网格 `emu.cols/rows` 一致**（两边各说
//      一套的话服务端按一个宽度发帧、前端按另一个排版）。
export fn web_size_round(tag: &const byte) bool {
    var ok: bool = true;
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    var t: WebTable = web_table_zero();
    web_table_init(&t);
    defer { web_table_free(&t); }
    const empty: Buf = buf_empty();
    // ① 页面报来的尺寸
    const i0: isize = web_session_new(&cfg, &t, &empty, 150, 40);
    if i0 != 0 {
        // 起不了子进程（/dev/ptmx 用完了？）⇒ 跳过，不算红
        tuis_ok(tag, "跳过（起不了会话子进程）");
        return true;
    }
    const s0: &WebSession = &t.items[0];
    if s0.cols != 150 || s0.rows != 40 {
        tuis_fail(tag, "新建会话没有用页面报来的尺寸（用户看到的是错宽度的首屏）",
            &ok);
        tuis_puts("  得到：");
        tuis_num(s0.cols);
        tuis_puts("x");
        tuis_num(s0.rows);
        tuis_puts("\n");
    }
    if s0.emu.cols != s0.cols || s0.emu.rows != s0.rows {
        tuis_fail(tag, "会话记的尺寸与服务端网格不一致（发帧与排版各说一套）", &ok);
    }
    var wc: usize = 0;
    var wr: usize = 0;
    if s0.master >= 0 && web_get_winsize(s0.master, &wc, &wr) {
        if wc != 150 || wr != 40 {
            tuis_fail(tag, "PTY 窗口尺寸不是页面报的那个（子进程还按旧尺寸排版）",
                &ok);
            tuis_puts("  PTY：");
            tuis_num(wc);
            tuis_puts("x");
            tuis_num(wr);
            tuis_puts("\n");
        }
    }
    // ② 不报尺寸 ⇒ 默认画布
    // 索引一律走「显式夹取的正 if」：数组边界证明器只认那种形状（§16 踩坑 6），
    // 它推不出「web_session_new 成功 ⇒ 下标 < WEB_MAX_SESSIONS」。
    const i1: isize = web_session_new(&cfg, &t, &empty, 0, 0);
    if i1 < 0 {
        tuis_fail(tag, "第二条会话起不来", &ok);
    } else if (i1 as usize) < WEB_MAX_SESSIONS {
        const s1: &WebSession = &t.items[i1 as usize];
        if s1.cols != EMU_DEF_COLS || s1.rows != EMU_DEF_ROWS {
            tuis_fail(tag, "没报尺寸时没有退回默认画布", &ok);
        }
    }
    // ③ 超上限 ⇒ 夹取，且网格跟着一致
    const i2: isize = web_session_new(&cfg, &t, &empty, 9999, 9999);
    if i2 < 0 {
        tuis_fail(tag, "第三条会话起不来", &ok);
    } else if (i2 as usize) < WEB_MAX_SESSIONS {
        const s2: &WebSession = &t.items[i2 as usize];
        if s2.cols != EMU_MAX_COLS || s2.rows != EMU_MAX_ROWS {
            tuis_fail(tag, "超上限的尺寸没有被夹到网格上限", &ok);
        }
        if s2.emu.cols != s2.cols || s2.emu.rows != s2.rows {
            tuis_fail(tag, "夹取之后会话尺寸与网格仍不一致", &ok);
        }
    }
    if ok {
        tuis_ok(tag,
            "新建会话尺寸：页面报多少就是多少（PTY 也一致）+ 不报用默认 + 超上限夹取");
    }
    return ok;
}

// ============================================================
// web-exit：子进程退出之后**收摊还是留标签**（用户报的「exit 之后标签不关」）
// ============================================================

// 现场：TUI 里打 `/exit`（或 ctrl+d）之后，页面上那条标签**还在**，只是点它没反应 ——
// 用户明确说了「我不用它了」，标签就该自己消失。老实现只把 `alive` 标成 false、
// 一律留标签，因为它**丢掉了 wait status**：分不出「正常退出」与「崩了」。
//
// 判据两条（走生产代码真用的 `web_pty_ready` → `web_pty_eof` → `web_sweep_closed`）：
//   ① **正常退出**（子进程 exit 0）⇒ `close_wanted` 置位，sweep 之后表里没有它，
//      订着它的长连接也被关掉（且**先写了分块终止块** —— 前端要靠干净 EOF 才能
//      把「会话结束了」与「连接坏了」分开）；
//   ② **异常没了**（被子进程被信号杀）⇒ **留标签与最后一帧**（用户还能看见它说了
//      什么），sweep 之后表里仍在。
export fn web_exit_round(tag: &const byte) bool {
    var ok: bool = true;
    if !web_t_exit_case(tag, true, &ok) {
        return ok;
    }
    if !web_t_exit_case(tag, false, &ok) {
        return ok;
    }
    if ok {
        tuis_ok(tag,
            "退出收摊：正常退出（/exit）摘标签并关订阅 + 异常死掉留标签看最后一帧");
    }
    return ok;
}

// `web_exit_round` 的一条腿：起一条真会话、喂一个**真 PTY**（子进程按 `clean` 决定
// 是 exit 0 还是等信号），走主循环那一支，最后断言「摘了没有」。
//
// 为什么自己开 PTY 而不 fork 真 TUI：这一轮判的是**收摊策略**（wait status → 摘不摘），
// 真 TUI 只是让「退出码是 0」这件事更真实而已 —— 自测里直接 exit 0 就是同一个状态，
// 还省掉一次 execve（与 `web-pty` 轮的做法一致）。
fn web_t_exit_case(tag: &const byte, clean: bool, ok: &bool) bool {
    var t: WebTable = web_table_zero();
    web_table_init(&t);
    defer { web_table_free(&t); }
    var slave: Buf = buf_new(64);
    defer { buf_free(&slave); }
    const m: i32 = web_t_pty_open(&slave, 80, 24);
    if m < 0 {
        tuis_ok(tag, "跳过（打不开 /dev/ptmx）");
        return false;
    }
    const pid64: i64 = sys_fork() catch {
        srv_close(m);
        tuis_fail(tag, "fork 失败", ok);
        return false;
    };
    if pid64 == 0 {
        web_t_exit_child(&slave, clean);
    }
    const s: &WebSession = &t.items[0];
    web_session_zero(s);
    if !emu_init(&s.emu, 80, 24) {
        _ = sys_kill(pid64, 9) catch {};
        var st0: i32 = 0;
        _ = sys_waitpid(i64_to_i32(pid64), &st0, 0) catch {};
        srv_close(m);
        tuis_fail(tag, "emu_init 失败", ok);
        return false;
    }
    s.id = buf_new(64);
    s.pending = buf_new(64);
    s.scratch = buf_new(EMU_MAX_COLS * 4 + 16);
    _ = buf_append_cstr(&s.id, "session-web-exit");
    s.master = m;
    s.pid = i64_to_i32(pid64);
    s.alive = true;
    t.n = 1;
    // 一条订阅它的长连接（管道当连接）：摘表时必须把它收掉。
    var conns: [WebConn: WEB_MAX_CONNS] = [web_conn_value_empty()
        : WEB_MAX_CONNS];
    var used: [bool: WEB_MAX_CONNS] = [false: WEB_MAX_CONNS];
    var fds: [i32: 2] = [0: 2];
    defer {
        if used[0] {
            web_conn_free(&conns[0]);
        }
        _ = sys_close(fds[0]) catch {};
        _ = sys_close(fds[1]) catch {};
    }
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_ok(tag, "跳过（管道不可用）");
        return false;
    }
    web_t_nonblock(fds[0]);
    if !web_conn_init(&conns[0], fds[1]) {
        tuis_fail(tag, "连接初始化失败", ok);
        return false;
    }
    used[0] = true;
    conns[0].st = WEB_CONN_STREAM;
    _ = buf_append(&conns[0].sid, s.id.ptr as &const byte, s.id.len);
    if !clean {
        // 异常那条腿：**等子进程把最后一行写完**再杀（不然「最后一帧」会假红）
        web_t_sleep_ms(200);
        _ = sys_kill(i64_to_i32(pid64), 9) catch {};
    }
    // 走主循环那一支：poll 到 HUP ⇒ `web_pty_eof`（先读干净再判死）。
    const rounds: usize = web_t_exit_pump(&t, s);
    if s.master >= 0 {
        tuis_fail(tag, "子进程没了但 master 没关（主循环会空转）", ok);
        return true;
    }
    if clean {
        web_t_exit_assert_clean(tag, &t, &conns[0], &used[0], fds[0], s, rounds,
            ok);
    } else {
        web_t_exit_assert_crash(tag, &t, &conns[0], &used[0], s, ok);
    }
    return true;
}

// 子进程侧（`web_t_exit_case` fork 出来的那一支）：写一行可识别输出，然后按 `clean`
// 决定是正常退出（exit 0 = TUI 里的 `/exit` / ctrl+d）还是睡着等父进程 SIGKILL。
fn web_t_exit_child(slave: &const Buf, clean: bool) void {
    const sf: i32 = sys_open(slave.ptr as *const byte, 0x102, 0) catch { -1; };
    if sf < 0 {
        sys_exit(9);
    }
    var msg: [byte: 24] = "LASTFRAME-HERE\r\n";
    _ = sys_write(sf, &msg[0], 15) catch {};
    if clean {
        sys_exit(0);
    }
    // 异常：一直睡着，等父进程发 SIGKILL（睡姿用 nanosleep 循环，不用 pause ——
    // 工具链没导出那个符号）。
    while true {
        web_t_sleep_ms(50);
    }
    sys_exit(0);
}

// 正常退出那条腿的断言：`close_wanted` → 摘标签 → 关订阅连接（**先写终止块**）
// → 最后一帧不丢。
fn web_t_exit_assert_clean(tag: &const byte, t: &WebTable, conns: &WebConn,
    used: &bool, rfd: i32, s: &const WebSession, rounds: usize,
    ok: &bool) void {
    if !s.close_wanted {
        tuis_fail(tag, "正常退出（/exit）的会话没被标成「该摘了」—— 标签会一直留着",
            ok);
    }
    web_sweep_closed(t, conns, used);
    if t.n != 0 {
        tuis_fail(tag, "收摊之后表里还留着正常退出的会话（页面上标签不消失）", ok);
    }
    if used[0] {
        tuis_fail(tag, "摘表之后订阅它的长连接还开着（前端等不到结束信号）", ok);
    }
    // 终止块：`0\r\n\r\n`（前端靠它把「会话结束」与「连接坏了」分开）
    var got: Buf = buf_new(0);
    defer { buf_free(&got); }
    web_t_drain(rfd, &got);
    if !web_t_contains(&got, "0\r\n\r\n" as &const byte) {
        tuis_fail(tag, "收摊时没写分块终止块（浏览器只会看到截断的流）", ok);
    }
    // 最后一帧也不能丢（先 POLLIN 后 POLLHUP）
    var text: Buf = buf_new(4096);
    defer { buf_free(&text); }
    emu_text(&s.emu, &text);
    if !web_t_contains(&text, "LASTFRAME-HERE" as &const byte) {
        tuis_fail(tag, "正常退出前的最后一段输出丢了", ok);
    }
    if *ok {
        tuis_puts("  正常退出：");
        tuis_num(rounds);
        tuis_puts(" 圈收口并摘表\n");
    }
}

// 崩掉那条腿的断言：**不**置 `close_wanted`、收摊之后标签仍在（看最后一帧）。
fn web_t_exit_assert_crash(tag: &const byte, t: &WebTable, conns: &WebConn,
    used: &bool, s: &const WebSession, ok: &bool) void {
    if s.close_wanted {
        tuis_fail(tag, "被信号杀掉的会话被判成了「用户主动退出」（标签会消失）", ok);
    }
    web_sweep_closed(t, conns, used);
    if t.n != 1 {
        tuis_fail(tag, "异常死掉的会话被摘掉了（用户看不到它最后说了什么）", ok);
    }
}
// 跑到会话收口为止（与 `web-pty` 轮同一个口径：上限 64 圈，超出也算「没空转」）。
fn web_t_exit_pump(t: &WebTable, s: &WebSession) usize {
    var rounds: usize = 0;
    while rounds < 64 && s.master >= 0 {
        rounds = rounds + 1;
        var pfds: [PollFd: 1] = [
            PollFd{ fd: s.master, events: POLLIN, revents: 0 },
        ];
        const pr: i32 = sys_poll(&pfds[0], 1, 200) catch { 0; };
        if pr > 0 && pfds[0].revents != 0 {
            web_pty_ready(t, 0, pfds[0].revents);
        }
    }
    return rounds;
}

// 睡一会儿（毫秒）。给「异常那条腿」等子进程把最后一帧写出来用。
fn web_t_sleep_ms(ms: i32) void {
    if ms <= 0 {
        return;
    }
    var ts: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    ts.tv_sec = (ms / 1000) as i64;
    ts.tv_nsec = (((ms % 1000) as i64) * (1000000 as i64));
    var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_nanosleep(&ts, &rem) catch {};
}

// ============================================================
// web-listen：监听套接字的 SO_REUSEADDR（§16 踩坑 118）
// ============================================================

// 现场（用户报的「运行 web 后 ctrl+c 报监听失败」）：`--web` 用浏览器打开一次页面、
// ctrl+c 退出，**紧接着**再用同一个端口跑一次，就得到
//   error: web 监听失败（端口被占用？换个端口：--web 127.0.0.1:0）
// 根因不是「谁还占着端口」：`src/net/httpsrv.uya` 的两条常量抄的是 BSD/macOS 的值
// （`SOL_SOCKET = 0xFFFF`、`SO_REUSEADDR = 0x0004`），而 Linux 是 `1` / `2`。用错
// 值时 `setsockopt` 以 `ENOPROTOOPT` 失败、又被调用点的 `catch {}` 吞了 ⇒ 监听
// 套接字**一个选项都没设上**。浏览器每次加载页面都会留下 `TIME_WAIT`（本侧先关
// 连接，那一半套接字的本地端口正是监听端口），没有 `SO_REUSEADDR` 就绑不回去。
//
// 判据两条，都走**生产代码** `srv_listen`：
//   ① 监听套接字上 `SO_REUSEADDR` 真的读得回来（常量写错时这里当场 false）；
//   ② 真复现用户现场：起监听 → 连一条 → **服务端先关**（本侧留 TIME_WAIT）→ 关
//      监听 → **立刻**用同一端口重新 `srv_listen` ⇒ 必须成功。
// 防假绿对照：把两条常量改回 `0xFFFF` / `0x0004` 重编 ⇒ 两条腿都红。
export fn web_listen_round(tag: &const byte) bool {
    var ok: bool = true;
    web_t_listen_opt(tag, &ok);
    web_t_listen_rebind(tag, &ok);
    if ok {
        tuis_ok(tag, "监听套接字：SO_REUSEADDR 真设上了 + TIME_WAIT 不挡同端口重启");
    }
    return ok;
}

// 腿①：`srv_listen` 之后 `SO_REUSEADDR` 必须读得回来（== 1）。`port = 0` 让内核
// 分配端口，避开与机器上别的监听撞车（`web-http` 轮同一个口径）。
fn web_t_listen_opt(tag: &const byte, ok: &bool) void {
    const lfd: i32 = srv_listen(127, 0, 0, 1, 0, 16);
    if lfd < 0 {
        tuis_fail(tag, "srv_listen(127.0.0.1:0) 起不来", ok);
        return;
    }
    if !srv_reuseaddr_ok(lfd) {
        tuis_fail(tag, "监听套接字没设上 SO_REUSEADDR（常量抄成 BSD 值了？）", ok);
    }
    srv_close(lfd);
}

// 腿②：复现用户现场 —— 本侧先关连接留下 TIME_WAIT，立刻用同一端口重新监听。
fn web_t_listen_rebind(tag: &const byte, ok: &bool) void {
    const lfd: i32 = srv_listen(127, 0, 0, 1, 0, 16);
    if lfd < 0 {
        tuis_fail(tag, "srv_listen 起不来（重启那条腿的前半段）", ok);
        return;
    }
    const port: u16 = srv_local_port(lfd);
    if port == 0 {
        tuis_fail(tag, "取不到内核分配的端口", ok);
        srv_close(lfd);
        return;
    }
    var acc: i32 = -1;
    var cli: i32 = -1;
    if !web_t_listen_connect(lfd, port, &acc, &cli) {
        tuis_fail(tag, "连不上自己刚起的监听（自测环境有问题）", ok);
        srv_close(lfd);
        return;
    }
    // **服务端先关**：TIME_WAIT 才留在监听端口这一侧（用户现场就是这样）。
    // 顺序不能反 —— 先关客户端的话 TIME_WAIT 落在它的临时端口上，这条腿会假绿。
    srv_close(acc);
    srv_close(cli);
    srv_close(lfd);
    const again: i32 = srv_listen(127, 0, 0, 1, port, 16);
    if again < 0 {
        tuis_fail(tag, "TIME_WAIT 挡住了同端口重启（用户报的「web 监听失败」）",
            ok);
        return;
    }
    srv_close(again);
}

// 连一次自己刚起的监听，把**两侧**的 fd 都从 `srv_out` / `cli_out` 带回来。
// 客户端 fd 是**阻塞**的（本机 connect 立刻返回），服务端 accept 走非阻塞的
// `srv_accept_nb` + 小重试：连上了不等于这一瞬间已经可 accept。
//
// 为什么要把客户端 fd 也交出去：**先关哪一侧决定了 TIME_WAIT 落在谁头上**。
// TIME_WAIT 属于「先关」的那一半，而这条腿要的正是「监听端口这一侧留着 TIME_WAIT」
// （用户现场就是服务端先关）—— 客户端在助手里顺手关掉的话，TIME_WAIT 就跑到客户端
// 的临时端口上去了，这条腿会**假绿**（实测：正是这个把第一次写的对照放过去了）。
fn web_t_listen_connect(lfd: i32, port: u16, srv_out: &i32,
    cli_out: &i32) bool {
    const cfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return false;
    };
    var addr: [byte: 16] = [0: 16];
    srv_sockaddr(127, 0, 0, 1, port, &addr[0]);
    if (sys_connect(cfd, &addr[0] as &void, 16 as u32) catch { -1; }) != 0 {
        srv_close(cfd);
        return false;
    }
    var tries: usize = 0;
    while tries < 50 {
        const sfd: i32 = srv_accept_nb(lfd);
        if sfd >= 0 {
            srv_out[0] = sfd;
            cli_out[0] = cfd;
            return true;
        }
        web_t_sleep_ms(10);
        tries = tries + 1;
    }
    srv_close(cfd);
    return false;
}

// ============================================================
// 第九轮 `web-snapshot`：`session/follow` 首帧必须是**合法 JSON**
// ============================================================
//
// 为什么单开一轮：这一帧的缺陷形态是**静默的**（客户端拒帧后页面只是空着，
// 或红一行「加载会话历史失败」，控制台只有一串 `connection lost, retry`）。
// 实测抓到过两个方向，都在 `records[]` 的**逗号**上：
//   ① 多一个：零事件源时 seed 段自带收尾逗号 + end-seed 又补一个 ⇒ `},,{`
//   ② 少一个：seed 写逗号却没翻 `first` ⇒ `}}{` 两条 JSON 直接贴在一起
// 两个方向都让客户端 `parseRemoteStreamServerMessage` 抛错、`close(4002,
// 'invalid Remote stream frame')` —— 页面表现**一模一样**（同一个红字）。
//
// 判据只能是**外部 oracle**：子串断言对「结构坏掉」是瞎的（`},,{` 里的每个
// 片段都在）。这里用本仓自己的 JSON 解析器当 oracle —— 与 `make wire-schema`
// 拿 DSH 的 zod 判译文是同一个道理，只是这一轮要离线、不能依赖装了 DSH。
//
// 三条腿：① 零事件源（用户零参数跑 `--dsh-web` 的形态）② 有译文 ③ cursor 与
// 末条 record 的 seq 必须相等（客户端 `assertPageThrough` 的判据）。
// 防假绿对照：把 seed 的收尾逗号装回去 ⇒ ① 当场红。

// 一段文本是不是合法 JSON（拿本仓的解析器判，失败回 false）。
fn web_t_json_ok(text: &Buf) bool {
    const raw: &void = malloc(1 << 18);
    if ((raw as &byte) as usize) == 0 {
        return false;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 1 << 18);
    var root: JsonValue = JsonValue.json_null();
    return js_parse(&arena, text.ptr as &const byte, text.len, &root);
}

// 一条腿：造一帧快照，断言它是合法 JSON。
fn web_t_snap_json(tag: &const byte, events: &const Buf, what: &const byte,
    ok: &bool) void {
    var sid: Buf = buf_new(64);
    defer { buf_free(&sid); }
    _ = buf_append_cstr(&sid, "s-1");
    var proj: Buf = buf_new(512);
    defer { buf_free(&proj); }
    // 中性投影值：这一轮验的是**帧的 JSON 结构**（逗号 / cursor 自洽），
    // 不是模型选择器 —— 活的那份由 `web-models` 轮单独验。
    _ = buf_append_cstr(&proj, "{\"lastUsed\":null,\"next\":null}");
    var frame: Buf = buf_new(events.len + 8192);
    defer { buf_free(&frame); }
    if !dwh_snapshot_frame(&sid, events, &proj, &frame) {
        tuis_fail(tag, what, ok);
        return;
    }
    if !web_t_json_ok(&frame) {
        tuis_fail(tag, what, ok);
        tuis_puts("  前 240 字节：");
        // 不用 if 表达式选长度：codegen 为它生成 `const size_t __uya_ifexpr_N`
        // 再赋值，宿主 C 报「assignment of read-only variable」（whost.uya 记过）。
        var show: usize = 240;
        if frame.len < show {
            show = frame.len;
        }
        _ = sys_write(2, frame.ptr as *const byte, show);
        tuis_puts("\n");
    }
}

// 第九轮：会话快照（`session/follow` 首帧）必须是合法 JSON，且 cursor 自洽。
export fn web_snapshot_round(tag: &const byte) bool {
    var ok: bool = true;
    // 腿①：**零事件源** —— 用户零参数 `--dsh-web` 的形态。这一腿是用户报
    // 「一直加载会话历史失败」的现场：从前这里发出 `},,{`。
    var empty: Buf = buf_empty();
    defer { buf_free(&empty); }
    web_t_snap_json(tag, &empty, "零事件源的快照不是合法 JSON（多/少逗号）", &ok);
    // 腿②：有译文（本仓日志译出来的那两行，形状照 `dwire_*` 的产物）。
    var ev: Buf = buf_new(1024);
    defer { buf_free(&ev); }
    // 行宽豁免：不可断的 JSON 夹具字面量
    _ = buf_append_cstr(&ev, "{\"type\":\"user/message\",\"seq\":0,\"time\":1,\"data\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"hi\"}],\"source\":{\"kind\":\"user\"},\"id\":\"m-0\"},\"surfaceOp\":\"append\"}\n");
    // 行宽豁免：不可断的 JSON 夹具字面量
    _ = buf_append_cstr(&ev, "{\"type\":\"assistant/message\",\"seq\":1,\"time\":2,\"data\":{\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"yo\"}]}},\"surfaceOp\":\"append\"}\n");
    web_t_snap_json(tag, &ev, "有译文时快照不是合法 JSON（多/少逗号）", &ok);
    // 腿③：`cursor` == 末条 record 的 `seq`。客户端 `assertPageThrough` 拿
    // `tailCursor(page) === through` 判，不等就报 `page did not end at its
    // requested cursor`（显示在对话区正文位置，看着像消息加载失败）。
    web_t_snap_cursor(tag, &empty,
        "零事件源时 cursor 与末条 record 的 seq 不等", &ok);
    web_t_snap_cursor(tag, &ev,
        "有译文时 cursor 与末条 record 的 seq 不等", &ok);
    if ok {
        tuis_ok(tag, "会话快照：两种事件源下都是合法 JSON，且 cursor == 末条 seq");
    }
    return ok;
}

// 腿③：把快照里的 `records[]` 末条的 `seq` 与 `value.cursor` 取出来比。
// 两条都走**解析**而不是子串：`seq` 在 seed / 译文 / end-seed 里各有一份，
// 子串找法（从前 `dwh_seq_of` 就是这么找的）会在嵌套里误中。
fn web_t_snap_cursor(tag: &const byte, events: &const Buf,
    what: &const byte, ok: &bool) void {
    var sid: Buf = buf_new(64);
    defer { buf_free(&sid); }
    _ = buf_append_cstr(&sid, "s-1");
    var proj: Buf = buf_new(512);
    defer { buf_free(&proj); }
    // 中性投影值：这一轮验的是**帧的 JSON 结构**（逗号 / cursor 自洽），
    // 不是模型选择器 —— 活的那份由 `web-models` 轮单独验。
    _ = buf_append_cstr(&proj, "{\"lastUsed\":null,\"next\":null}");
    var frame: Buf = buf_new(events.len + 8192);
    defer { buf_free(&frame); }
    if !dwh_snapshot_frame(&sid, events, &proj, &frame) {
        tuis_fail(tag, what, ok);
        return;
    }
    // `cursor` 在 `value` 底下（与 `records` 同级）—— 不是顶层键。
    const cur: i64 = web_t_snap_cursor_of(&frame);
    const last: i64 = web_t_last_record_seq(&frame);
    if cur < 0 || last < 0 || cur != last {
        tuis_fail(tag, what, ok);
        tuis_puts("  cursor=");
        tuis_num(cur as usize);
        tuis_puts(" 末条 seq=");
        tuis_num(last as usize);
        tuis_puts("\n");
    }
}

// 快照 `value.cursor`（拿不到回 -1）。
fn web_t_snap_cursor_of(frame: &Buf) i64 {
    const raw: &void = malloc(1 << 18);
    if ((raw as &byte) as usize) == 0 {
        return -1;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 1 << 18);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, frame.ptr as &const byte, frame.len, &root) {
        return -1;
    }
    var nested: JsonValue = JsonValue.json_null();
    if !js_obj_get(&root, "value" as &const byte, 5, &nested) {
        return -1;
    }
    var cv: JsonValue = JsonValue.json_null();
    if !js_obj_get(&nested, "cursor" as &const byte, 6, &cv) {
        return -1;
    }
    var v: i64 = -1;
    if !js_i64_of(&cv, &v) {
        return -1;
    }
    return v;
}

// 快照 `records[]` 里**最后一条**的 `event.seq`（拿不到回 -1）。
fn web_t_last_record_seq(frame: &Buf) i64 {
    const raw: &void = malloc(1 << 18);
    if ((raw as &byte) as usize) == 0 {
        return -1;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 1 << 18);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, frame.ptr as &const byte, frame.len, &root) {
        return -1;
    }
    var nested: JsonValue = JsonValue.json_null();
    if !js_obj_get(&root, "value" as &const byte, 5, &nested) {
        return -1;
    }
    var recs: JsonValue = JsonValue.json_null();
    if !js_obj_get(&nested, "records" as &const byte, 7, &recs) {
        return -1;
    }
    const n: usize = js_arr_len(&recs);
    if n == 0 {
        return -1;
    }
    var last: JsonValue = JsonValue.json_null();
    if !js_arr_get(&recs, n - 1, &last) {
        return -1;
    }
    var ent: JsonValue = JsonValue.json_null();
    if !js_obj_get(&last, "event" as &const byte, 5, &ent) {
        return -1;
    }
    var seqv: JsonValue = JsonValue.json_null();
    if !js_obj_get(&ent, "seq" as &const byte, 3, &seqv) {
        return -1;
    }
    var v: i64 = -1;
    if !js_i64_of(&seqv, &v) {
        return -1;
    }
    return v;
}

// ============================================================
// 第十轮 `web-panel`：设置面板那一簇方法**必须都回得出东西**
// ============================================================
//
// 为什么单开一轮：这一簇的缺陷形态是「**四个页签各一条红字**」，而它不是崩溃 ——
// 未实现时客户端把整片渲染成一句 `not implemented: <方法名>`（实测）：
//   General  → `Permission` 一行 `internal: not implemented:
//              permissionPresets/catalog`
//   Models   → `Loading the provider directory failed: not implemented:
//              llm/listProviders`
//   Built-in plugins → `Plugins are temporarily unavailable.`
//   Agent presets → `not implemented: agentPresets/list`
// 用户看到的「设置界面/模型供应商加载失败」就是这一族。
//
// 判据两条：① 每个方法都**回 true**（未实现的方法让 `dwh_unary` 回 false ⇒
// 宿主包成 `internal` 业务错 ⇒ 页面红字）；② 回的是**合法 JSON 且形状是客户端要的
// 那个类型**（对象/数组 —— `settings.describe` 那次形状错（`namespaces` 给对象而不是
// 数组）让设置面板**整片塌掉**，症状与「没实现」完全不同，所以类型也要判）。
// 防假绿对照：把任一分支删掉 ⇒ ① 当场红。

// 设置面板那一簇的方法名（与页签一一对应，顺序按页签从左到右）。
fn web_t_panel_methods(i: usize) &const byte {
    if i == 0 {
        return "permissionPresets.catalog" as &const byte;
    }
    if i == 1 {
        return "llm.listProviders" as &const byte;
    }
    if i == 2 {
        return "llm.listConfigurableProviders" as &const byte;
    }
    if i == 3 {
        return "agentPresets.list" as &const byte;
    }
    if i == 4 {
        return "credentials.describe" as &const byte;
    }
    return "pluginInventory.list" as &const byte;
}

// 这段 JSON 的第一个非空白字符是 `c`（对象）还是 `[`（数组）。
// 用它判「形状是不是客户端要的那个类型」—— 见本轮的不变量②。
fn web_t_json_head(text: &const Buf, want_array: bool) bool {
    var i: usize = 0;
    while i < text.len {
        const c: byte = text.ptr[i];
        if c == 32 as byte || c == 10 as byte || c == 9 as byte {
            i = i + 1;
            continue;
        }
        if want_array {
            return c == 91 as byte;
        }
        return c == 123 as byte;
    }
    return false;
}

// 第十轮：设置面板那一簇方法都必须实现，且回值是合法 JSON、形状对。
export fn web_panel_round(tag: &const byte) bool {
    var ok: bool = true;
    var i: usize = 0;
    while i < 6 {
        const m: &const byte = web_t_panel_methods(i);
        const ml: usize = bufx_cstr_len(m);
        var value: Buf = buf_new(4096);
        defer { buf_free(&value); }
        // ① 必须实现（回 false ⇒ 宿主回 `internal` ⇒ 页面红字）
        if !dwh_unary_settings(m, ml, &value) {
            tuis_fail(tag, "设置面板的方法没实现（页面会显示 not implemented）", &ok);
            tuis_puts("  方法：");
            tuis_puts(m);
            tuis_puts("\n");
            i = i + 1;
            continue;
        }
        // ② 必须是合法 JSON
        if !web_t_json_ok(&value) {
            tuis_fail(tag, "设置面板的回值不是合法 JSON", &ok);
            tuis_puts("  方法：");
            tuis_puts(m);
            tuis_puts("\n");
            i = i + 1;
            continue;
        }
        // ③ 形状：`llm.listProviders` / `llm.listConfigurableProviders` 是**数组**
        // （客户端对它 `.map()` / `.length`），其余是对象。给错类型就是
        // `undefined` 崩（`settings.describe` 的 `namespaces` 踩过一次）。
        const want_arr: bool = i == 1 || i == 2;
        if !web_t_json_head(&value, want_arr) {
            tuis_fail(tag, "设置面板回值的形状不对（该是数组的给了对象，或反过来）", &ok);
            tuis_puts("  方法：");
            tuis_puts(m);
            tuis_puts("\n");
        }
        i = i + 1;
    }
    if ok {
        tuis_ok(tag, "设置面板：六个方法都实现了，且回值都是合法 JSON、形状对");
    }
    return ok;
}
