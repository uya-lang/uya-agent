// src/selftest/st_session.uya — 离线自测轮（selftest.uya 的拆分片 4/11）
//
// 本文件：P4 会话自测：写日志 → 逐行校验 → 崩溃尾部裁剪 → 恢复重建历史；P5 自测：DSH 设置解析（假 DSH_HOME）+ YAML 预处理；hist-repair 轮：尾部修复（hist_trim_incomplete_tail；img-sniff（P50）：图片识别与尺寸解析（纯函数）；clip-parse（P51）：X11 客户端的可测部分（纯函数 + 不依赖 X 会话的；P33：/sessions 列表（时间倒序 · 三列 · 宽度自适应）—— 纯函数轮
// 不变量：① mock 与断言必须**确定性**（同一夹具同一 verdict，不依赖真实网络/时钟/环境）；
//   ② 判定码只用**低 8 位**（子进程 `sys_exit` 会截断，261 显示成 5，见踩坑 89）；
//   ③ 每轮可单跑（`UYA_SELFTEST_*_ONLY`）且幂等，轮次之间不许残留全局状态；
//   ④ 轮次自己 fork 的子进程必须由该轮收干净，不许留孤儿。
// 依赖：libc（syscall/unistd/heap/fcntl/signal）、foundation/bufx、net（LLM 协议与 SSE）、
//   term 与 term/tui、tools、session、agent、vcs/gitx、diff；`mock_*` 全局与 `cfg_pin_api`
//   在锚点文件 selftest.uya 里（锚点只留文件头、mock 全局与入口 `selftest_main`）。
// 命名：对外 `probe_main`（--probe）/`selftest_main`（--selftest）在锚点；
//   本片私有前缀 `mock_*`、`sse_*`、`ty_*`、`resp_*`、`stx_*`、`tsx_*`、`dp_/dg_/gcr_/mx_/wt_`。

// ============================================================
// P4 会话自测：写日志 → 逐行校验 → 崩溃尾部裁剪 → 恢复重建历史
// ============================================================
fn sess_round(tag: &const byte) bool {
    var ok: bool = true;
    var home: Buf = buf_new(512);
    defer { buf_free(&home); }
    _ = buf_append_cstr(&home, "build/selftest_sess_home");
    _ = buf_append_byte(&home, 0);
    _ = sess_mkdir_p(home.ptr as &const byte);
    // 清掉旧文件，保证这一轮是干净的
    var idx: Buf = buf_new(600);
    defer { buf_free(&idx); }
    _ = buf_append_cstr(&idx, "build/selftest_sess_home/index.jsonl");
    _ = buf_append_byte(&idx, 0);
    _ = sys_unlink(idx.ptr as *const byte) catch {};

    // ---- 1) 写：header + 若干事件 ----
    var log: SessionLog = sess_log_empty();
    defer { sess_log_free(&log); }
    if !sess_open(&log, "build/selftest_sess_home", "build/selftest_sess_ws", "selftest-model", "uya-agent", "", true, 0 as i64, true) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: sess_open\\n");
        return false;
    }
    if log.id.len < 10 || log.path.len == 0 {
        ty_fail(tag, "会话 id/路径没生成", &ok);
    }
    var ev: Buf = buf_new(4096);
    defer { buf_free(&ev); }
    // user/message
    if !sess_begin(&log, "user/message", &ev) {
        ty_fail(tag, "sess_begin 失败", &ok);
    }
    _ = buf_append_cstr(&ev, "{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":");
    _ = jw_str_into(&ev, "写一个 hello\n带换行 \"引号\"", bufx_cstr_len("写一个 hello\n带换行 \"引号\""));
    _ = buf_append_cstr(&ev, "}],\"source\":{\"kind\":\"user\"}}");
    _ = sess_end(&log, &ev);
    // assistant/message（带 tool_calls，arguments 里有转义）
    if !sess_begin(&log, "assistant/message", &ev) {
        ty_fail(tag, "assistant 事件开始失败", &ok);
    }
    _ = buf_append_cstr(&ev, "{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":\"我来写\",\"tool_calls\":[{\"id\":\"call_s1\",\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"arguments\":");
    _ = jw_str_into(&ev, "{\"path\":\"note.txt\",\"content\":\"hello\"}", bufx_cstr_len("{\"path\":\"note.txt\",\"content\":\"hello\"}"));
    _ = buf_append_cstr(&ev, "}}]},\"usage\":{\"inputTokens\":7}}");
    _ = sess_end(&log, &ev);
    // tool/result
    if !sess_begin(&log, "tool/result", &ev) {
        ty_fail(tag, "tool/result 事件开始失败", &ok);
    }
    _ = buf_append_cstr(&ev, "{\"turn\":1,\"step\":1,\"callId\":\"call_s1\",\"content\":");
    // P15：控制字节（NUL、0x01）必须**按字节**往返 —— 写入端把它们转义成 \u00XX，
    // 读回时若只去一个反斜杠，NUL 就变成字面量 `u0000`（内容被悄悄改掉）。
    var ctrl: Buf = buf_new(16);
    defer { buf_free(&ctrl); }
    _ = buf_append_cstr(&ctrl, "A");
    _ = buf_append_byte(&ctrl, 0);
    _ = buf_append_cstr(&ctrl, "B");
    _ = buf_append_byte(&ctrl, 1);
    _ = buf_append_cstr(&ctrl, "C");
    _ = jw_str_into(&ev, ctrl.ptr as &const byte, ctrl.len);
    _ = buf_append_cstr(&ev, "}");
    _ = sess_end(&log, &ev);
    buf_reset(&log.title);
    _ = buf_append_cstr(&log.title, "写一个 hello");
    if log.events != 3 {
        ty_fail(tag, "事件计数不对", &ok);
    }
    var id_copy: Buf = buf_new(64);
    defer { buf_free(&id_copy); }
    _ = buf_append(&id_copy, log.id.ptr, log.id.len);
    var path_copy: Buf = buf_new(1200);
    defer { buf_free(&path_copy); }
    _ = buf_append(&path_copy, log.path.ptr, log.path.len);
    _ = buf_append_byte(&path_copy, 0);
    sess_close(&log, "build/selftest_sess_home");

    // ---- 2) 读回：header、逐行事件、字段还原 ----
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path_copy.ptr as &const byte, &r) {
        ty_fail(tag, "会话文件读不回来", &ok);
        return ok;
    }
    if !r.header_ok || r.id.len == 0 {
        ty_fail(tag, "header 没解析出来", &ok);
    }
    if !bufx_eq_cstr(r.id.ptr as &const byte, r.id.len, id_copy.ptr as &const byte) && r.id.len != id_copy.len {
        ty_fail(tag, "header id 与写入不一致", &ok);
    }
    var line: Buf = buf_new(8192);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    var args: Buf = buf_new(8192);
    defer { buf_free(&args); }
    var n_lines: i32 = 0;
    var expect_seq: i64 = 0;
    var saw_user: bool = false;
    var saw_calls: bool = false;
    var saw_result: bool = false;
    while sess_next(&r, &line) {
        n_lines = n_lines + 1;
        const seq: i64 = sess_line_seq(&line);
        if seq != expect_seq {
            ty_fail(tag, "seq 不连续", &ok);
        }
        expect_seq = seq + 1;
        if !sess_line_type(&line, &typ) {
            ty_fail(tag, "事件没有 type", &ok);
            continue;
        }
        const view: &[byte] = line.ptr[0: line.len];
        if sv_eq_cstr(&typ, "user/message") {
            saw_user = true;
            if !sess_json_str(view, "text", &text) || !sess_line_has(&text, "带换行") {
                ty_fail(tag, "用户文本没有正确落盘/反转义", &ok);
            }
        } else if sv_eq_cstr(&typ, "assistant/message") {
            if !sess_extract_array(view, "tool_calls", &args) {
                ty_fail(tag, "tool_calls 数组没提取出来", &ok);
            } else {
                saw_calls = true;
                if !sess_line_has(&args, "call_s1") {
                    ty_fail(tag, "tool_calls 里没有 call_s1", &ok);
                }
                if !sess_line_has(&args, "\\\"path\\\"") {
                    ty_fail(tag, "arguments 的转义层级不对", &ok);
                }
            }
        } else if sv_eq_cstr(&typ, "tool/result") {
            saw_result = true;
            if !sess_json_str(view, "callId", &text) || !sess_line_has(&text, "call_s1") {
                ty_fail(tag, "tool/result 的 callId 不对", &ok);
            }
            if !sess_json_str(view, "content", &text) || !sv_buf_eq(&text, &ctrl) {
                ty_fail(tag, "content 里的控制字节没有按字节往返（\\u00XX 被读成字面量？）", &ok);
                out_err("[sess content] 得到 ");
                out_err_bytes(text.ptr as &const byte, text.len);
                out_err("\n");
            }
        }
    }
    if n_lines != 3 || !saw_user || !saw_calls || !saw_result {
        ty_fail(tag, "读回的事件条数/种类不对", &ok);
    }
    if r.dropped_tail {
        ty_fail(tag, "正常文件不该被判为截断", &ok);
    }

    // ---- 3) 崩溃尾部：手动追加半条记录，读的时候必须丢掉它 ----
    var ap: Buf = buf_new(1300);
    defer { buf_free(&ap); }
    _ = buf_append_cstr(&ap, path_copy.ptr as &const byte);
    _ = buf_append_byte(&ap, 0);
    const flags: i32 = (O_WRONLY | O_APPEND) as i32;
    const fd: i32 = sys_open(ap.ptr as *const byte, flags, 420) catch {
        -1;
    };
    if fd >= 0 {
        const half: &const byte = "{\"type\":\"tool/result\",\"seq\":3,\"time\":1,\"data\":{\"callId\":\"call_x\"" as &const byte;
        _ = write_all_fd(fd, half, bufx_cstr_len(half));
        _ = sys_close(fd) catch {};
    }
    var r2: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r2); }
    if !sess_reader_load(ap.ptr as &const byte, &r2) {
        ty_fail(tag, "带残缺尾部的文件读不回来", &ok);
    }
    var n2: i32 = 0;
    while sess_next(&r2, &line) {
        n2 = n2 + 1;
    }
    if n2 != 3 {
        ty_fail(tag, "残缺尾部应被丢弃（应读到 3 条）", &ok);
    }
    if !r2.dropped_tail {
        ty_fail(tag, "没有标记 dropped_tail", &ok);
    }

    // ---- 4) 恢复：用日志重建消息历史 ----
    var h: History = hist_init();
    defer { hist_free(&h); }
    var next_seq0: i64 = 0;
    var c_hist: Config = cfg_default();
    cfg_pin_api(&c_hist, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    c_hist.model = buf_new(32);
    _ = buf_append_cstr(&c_hist.model, "selftest-model");
    c_hist.workspace = buf_new(64);
    _ = buf_append_cstr(&c_hist.workspace, "build/selftest_sess_ws");
    // P18：这个调用点不折叠统计（历史恢复而已）；resume 路径传 true
    const restored: i32 = agent_hist_from_log(&c_hist, &h, &path_copy, &next_seq0, false);
    cfg_free(&c_hist);
    if restored != 3 {
        ty_fail(tag, "恢复的消息条数不对", &ok);
    }
    // system +（运行上下文等注入）+ user + assistant(带 calls) + tool
    // 注入条数不固定（AGENTS.md 取决于工作区），所以从**尾部**校验恢复出来的三条
    const nmsg: usize = h.len;
    if nmsg < 4 {
        ty_fail(tag, "恢复后的历史长度不对", &ok);
    } else if msg_role_at(&h, nmsg - 2) != ROLE_ASSISTANT_CALLS || msg_role_at(&h, nmsg - 1) != ROLE_TOOL {
        ty_fail(tag, "恢复后的角色不对", &ok);
    } else if !msg_extra_is(&h, nmsg - 1, "call_s1") {
        ty_fail(tag, "恢复后的 tool_call_id 不对", &ok);
    } else {
        // 恢复出来的历史必须能原样再序列化成请求
        var req: Buf = buf_new(65536);
        defer { buf_free(&req); }
        var c2: Config = cfg_default();
        cfg_pin_api(&c2, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
        c2.model = buf_new(32);
        _ = buf_append_cstr(&c2.model, "selftest-model");
        if !build_model_request(&c2, &h, &req, LLM_STYLE_CHAT) {
            ty_fail(tag, "恢复的历史无法组装请求", &ok);
        } else if !contains(&req, "\"tool_call_id\":\"call_s1\"") || !contains(&req, "\"tool_calls\"") {
            ty_fail(tag, "恢复的历史里缺少严格协议字段", &ok);
        }
        cfg_free(&c2);
    }

    // ---- 5) 索引 + 最近会话查找 ----
    if !sess_find_last("build/selftest_sess_home", "", &line) {
        ty_fail(tag, "sess_find_last 找不到刚写的会话", &ok);
    }
    var fpath: Buf = buf_new(1200);
    defer { buf_free(&fpath); }
    if !sess_find("build/selftest_sess_home", "build/selftest_sess_ws", id_copy.ptr as &const byte, id_copy.len, &fpath) {
        ty_fail(tag, "sess_find 按 id 找不到会话", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\\n");
    }
    return ok;
}

// 会话日志缓冲 b 里是否含子串 lit（按 C 串取长度，内部 find_sub）。
fn sess_line_has(b: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if b.len < n {
        return false;
    }
    return find_sub(b.ptr[0: b.len], lit[0: n], 0) >= 0;
}

// 两个 Buf 是否逐字节相同（内容里有 NUL 时不能拿 C 字符串比）
fn sv_buf_eq(a: &const Buf, b: &const Buf) bool {
    if a.len != b.len {
        return false;
    }
    return bufx_mem_eq(a.ptr as &const byte, b.ptr as &const byte, a.len);
}


// ============================================================
// P5 自测：DSH 设置解析（假 DSH_HOME）+ YAML 预处理
// ============================================================
// 历史消息的安全访问（历史是堆数组，边界用 h.len 判）
fn msg_role_at(h: &const History, i: usize) u8 {
    if i >= h.len {
        return 255;
    }
    return msg_at(h, i).role;
}

// 历史第 i 条消息的 extra 字段（tool_call_id 之类）是否等于 lit；越界 / extra 为空即 false。
fn msg_extra_is(h: &const History, i: usize, lit: &const byte) bool {
    if i >= h.len {
        return false;
    }
    const m: &const Msg = msg_at(h, i);
    if m.extra_len == 0 {
        return false;
    }
    return bufx_eq_cstr(m.extra as &const byte, m.extra_len, lit);
}

// ============================================================
// hist-repair 轮：尾部修复（hist_trim_incomplete_tail）必须**只丢不完整的一组**
//
// 旧的实现无条件丢掉结尾的 tool / assistant(tool_calls)，于是「恢复会话」这种再正常
// 不过的操作都会把最后一步白丢掉；反过来，只丢一半的组又会留下悬空 tool_calls，
// 端点必然 400（本项目真实踩到过）。
// ============================================================
const HIST_CALLS_1: &const byte = "[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"bash\",\"arguments\":\"{}\"}}]";
const HIST_CALLS_2: &const byte = "[{\"id\":\"c1\",\"type\":\"function\",\"function\":{\"name\":\"bash\",\"arguments\":\"{}\"}},{\"id\":\"c2\",\"type\":\"function\",\"function\":{\"name\":\"bash\",\"arguments\":\"{}\"}}]";

// 往历史里追加一条文本消息（role + C 串正文）。返回 false = 追加失败或超出历史上限。
// 自测夹具专用，走的是 hist_push 的正式路径。
fn hist_push_text(h: &History, role: u8, lit: &const byte) bool {
    return hist_push(h, role, lit, bufx_cstr_len(lit));
}

// 往历史里追加一条 assistant 的 tool_calls 消息（正文为空，calls 为 JSON 串）。
// 返回 false = 追加失败；配套的 tool 结果必须紧跟（见 hist_push_tool）。
fn hist_push_calls(h: &History, calls: &const byte) bool {
    return hist_push_msg(h, ROLE_ASSISTANT_CALLS, null, 0, calls, bufx_cstr_len(calls));
}

// 往历史里追加一条 tool 结果（tool_call_id = id，正文 = lit）。
// 返回 false = 追加失败；必须与前面的 tool_calls 配对，否则端点 400。
fn hist_push_tool(h: &History, id: &const byte, lit: &const byte) bool {
    return hist_push_msg(h, ROLE_TOOL, lit, bufx_cstr_len(lit), id, bufx_cstr_len(id));
}

// 给历史铺底：一条 SYS + 一条 TASK（role 固定）。返回 false = 任一条追加失败。
fn hist_seed(h: &History) bool {
    return hist_push_text(h, ROLE_SYSTEM, "SYS") && hist_push_text(h, ROLE_USER, "TASK");
}

// h.bytes 必须等于各条 text_len+extra_len 之和（裁剪/回滚都要维护它）
fn hist_bytes_ok(h: &const History) bool {
    var sum: usize = 0;
    var i: usize = 0;
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        sum = sum + m.text_len + m.extra_len;
        i = i + 1;
    }
    return sum == h.bytes;
}


// ============================================================
// img-sniff（P50）：图片识别与尺寸解析（纯函数）
//
// 为什么要单独钉：尺寸是**从文件头算出来**的（不解码像素），四种格式的头布局各不相同
// （PNG 大端、GIF 小端、JPEG 要走段链、WebP 有三个变体）。算错的话预算判定会放行一张
// 其实超限的图，网关那边就是一个 400 —— 现场很难看出「是尺寸算错了」。
//
// 用的是**真字节**（下面这张 64×48 的 PNG 是 zlib 压出来再逐字节抄进来的），
// 不是手写的假头：假头只能测到「我们自己的假设」，测不到真实文件布局。
// ============================================================
const IMG_PNG_64x48: [byte: 124] = [
    137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 73, 72, 68, 82,
    0, 0, 0, 64, 0, 0, 0, 48, 8, 2, 0, 0, 0, 46, 41, 235,
    72, 0, 0, 0, 67, 73, 68, 65, 84, 120, 218, 237, 207, 65, 9, 0,
    0, 8, 4, 176, 75, 98, 48, 19, 27, 203, 10, 126, 133, 193, 10, 44,
    83, 253, 90, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4,
    4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4, 4,
    4, 4, 4, 4, 4, 174, 22, 52, 131, 0, 226, 233, 119, 149, 144, 0,
    0, 0, 0, 73, 69, 78, 68, 174, 66, 96, 130,
];



// img-sniff 轮（P50）：用内嵌的 PNG 字节测纯函数——嗅探类型、解析尺寸与字节大小。
// 夹具是常量数组，不读盘不联网；返回 false = 本轮红。
fn img_round(tag: &const byte) bool {
    var ok: bool = true;
    // 占位行断言的三个片段。函数内 const 才不会把数组推断成 int32
    // （模块级 const 会 —— 本轮实测的编译错误）。
    const img_lbl_dim: [byte: 6] = [54, 52, 195, 151, 52, 56];            // "64×48"
    const img_lbl_mime: [byte: 9] = [105, 109, 97, 103, 101, 47, 112, 110, 103];
    const img_lbl_size: [byte: 5] = [49, 50, 52, 32, 66];                  // "124 B"
    out_err("selftest[");
    out_err(tag);
    out_err("] ");

    // 1) PNG：尺寸从 IHDR 读出来（64×48）
    var info: ImgInfo = ImgInfo{ kind: IMGX_NONE, width: 0, height: 0, bytes: 0 };
    if !imgx_sniff(&IMG_PNG_64x48[0], 124, &info) {
        ty_fail(tag, "真 PNG 没被认出来", &ok);
    } else {
        if info.kind != IMGX_PNG {
            ty_fail(tag, "PNG 的类型不对", &ok);
        }
        if info.width != 64 || info.height != 48 {
            ty_fail(tag, "PNG 尺寸读错了（应当 64×48）", &ok);
        }
        if info.bytes != 124 {
            ty_fail(tag, "PNG 字节数不对", &ok);
        }
    }

    // 2) MIME / 扩展名 / 反查
    if !bufx_eq_cstr(imgx_mime(IMGX_PNG), 9, "image/png") {
        ty_fail(tag, "PNG 的 MIME 不对", &ok);
    }
    if !bufx_eq_cstr(imgx_mime(IMGX_JPEG), 10, "image/jpeg") {
        ty_fail(tag, "JPEG 的 MIME 不对", &ok);
    }
    if !bufx_eq_cstr(imgx_ext(IMGX_WEBP), 4, "webp") {
        ty_fail(tag, "WebP 的扩展名不对", &ok);
    }
    if imgx_kind_of_mime("image/gif" as &const byte, 9) != IMGX_GIF {
        ty_fail(tag, "MIME 反查 GIF 失败", &ok);
    }
    if imgx_kind_of_mime("text/plain" as &const byte, 10) != IMGX_NONE {
        ty_fail(tag, "非图片 MIME 被当成了图片", &ok);
    }

    // 3) GIF：小端 + 魔数两个版本（GIF87a / GIF89a）
    var gif: [byte: 14] = [71,73,70,56,57,97,20,0,10,0,0,0,0,0];
    if !imgx_sniff(&gif[0], 14, &info) || info.kind != IMGX_GIF {
        ty_fail(tag, "GIF89a 没被认出来", &ok);
    } else if info.width != 20 || info.height != 10 {
        ty_fail(tag, "GIF 尺寸读错了（小端 20×10）", &ok);
    }
    gif[3] = 56;   // '8'
    gif[4] = 55;   // '7'  → GIF87a
    if !imgx_sniff(&gif[0], 14, &info) || info.kind != IMGX_GIF {
        ty_fail(tag, "GIF87a 没被认出来", &ok);
    }

    // 4) JPEG：段链要走过去才能到 SOF（长度段在前，尺寸不在固定偏移）
    //    FFD8 + FFE0(APP0, 长度 16) + 14 字节负载 + FFC0(SOF0) + 长度 17 + 精度 + 高 7 + 宽 9
    var jpg: [byte: 34] = [0: 34];
    jpg[0] = 255;
    jpg[1] = 216;
    jpg[2] = 255;
    jpg[3] = 224;
    jpg[4] = 0;
    jpg[5] = 16;
    // APP0 段头在 i=2，长度字段 16 ⇒ 下一段从 2+2+16 = 20 开始
    jpg[20] = 255;
    jpg[21] = 192;
    jpg[22] = 0;
    jpg[23] = 17;
    jpg[24] = 8;
    jpg[25] = 0;
    jpg[26] = 7;    // 高 7
    jpg[27] = 0;
    jpg[28] = 9;    // 宽 9
    if !imgx_sniff(&jpg[0], 34, &info) || info.kind != IMGX_JPEG {
        ty_fail(tag, "JPEG 没被认出来（段链没走过去？）", &ok);
    } else if info.width != 9 || info.height != 7 {
        ty_fail(tag, "JPEG 尺寸读错了（应当 9×7）", &ok);
    }

    // 5) WebP 三变体：VP8X（24 位宽高）、VP8L（14 位打包）、VP8 （14 位）
    var w1: [byte: 30] = [0: 30];
    w1[0] = 82; w1[1] = 73; w1[2] = 70; w1[3] = 70;   // RIFF
    w1[8] = 87; w1[9] = 69; w1[10] = 66; w1[11] = 80; // WEBP
    w1[12] = 86; w1[13] = 80; w1[14] = 56; w1[15] = 88; // VP8X
    w1[24] = 99;  // 宽 = 100（存 99）
    w1[27] = 49;  // 高 = 50（存 49）
    if !imgx_sniff(&w1[0], 30, &info) || info.kind != IMGX_WEBP {
        ty_fail(tag, "WebP/VP8X 没被认出来", &ok);
    } else if info.width != 100 || info.height != 50 {
        ty_fail(tag, "WebP/VP8X 尺寸读错了（应当 100×50）", &ok);
    }
    // VP8L：bits = (宽-1) | (高-1)<<14 → 宽 5 高 3 = 4 | (2<<14) = 32772
    var w2: [byte: 30] = [0: 30];
    w2[0] = 82; w2[1] = 73; w2[2] = 70; w2[3] = 70;
    w2[8] = 87; w2[9] = 69; w2[10] = 66; w2[11] = 80;
    w2[12] = 86; w2[13] = 80; w2[14] = 56; w2[15] = 76; // VP8L
    w2[20] = 47;  // 0x2F 签名
    w2[21] = 4;
    w2[22] = 128; // (2<<14) 的低字节 = 0x80
    if !imgx_sniff(&w2[0], 30, &info) || info.kind != IMGX_WEBP {
        ty_fail(tag, "WebP/VP8L 没被认出来", &ok);
    } else if info.width != 5 || info.height != 3 {
        ty_fail(tag, "WebP/VP8L 尺寸读错了（应当 5×3）", &ok);
    }

    // 6) 不认识的东西一律拒绝（绝不猜一个尺寸往下走）
    const notimg: &const byte = "hello, this is not an image at all" as &const byte;
    if imgx_sniff(notimg, 33, &info) {
        ty_fail(tag, "纯文本被当成了图片", &ok);
    }
    if info.kind != IMGX_NONE {
        ty_fail(tag, "嗅探失败后 kind 没复位", &ok);
    }
    // 截断的 PNG（有签名没 IHDR）也必须拒
    if imgx_sniff(&IMG_PNG_64x48[0], 20, &info) {
        ty_fail(tag, "截断的 PNG 被当成了完整图片", &ok);
    }

    // 7) 预算判定：字节超限 / 像素超限 / 通过
    var why: Buf = buf_new(256);
    defer { buf_free(&why); }
    var small: ImgInfo = ImgInfo{ kind: IMGX_PNG, width: 64, height: 48, bytes: 124 };
    if imgx_check(&small, 0, 0, &why) != IMGX_OK {
        ty_fail(tag, "正常图片被拒了", &ok);
    }
    if why.len != 0 {
        ty_fail(tag, "通过时不该有拒绝理由", &ok);
    }
    if imgx_check(&small, 100, 0, &why) != IMGX_E_TOO_BIG {
        ty_fail(tag, "字节超限没被拒", &ok);
    }
    if why.len == 0 {
        ty_fail(tag, "字节超限没给理由", &ok);
    }
    if imgx_check(&small, 0, 100, &why) != IMGX_E_TOO_MANY_PIXELS {
        ty_fail(tag, "像素超限没被拒", &ok);
    }
    var nokind: ImgInfo = ImgInfo{ kind: IMGX_NONE, width: 0, height: 0, bytes: 0 };
    if imgx_check(&nokind, 0, 0, &why) != IMGX_E_UNKNOWN {
        ty_fail(tag, "不认识的格式没被拒", &ok);
    }

    // 8) 附件 id 是内容寻址（同内容同 id、不同内容不同 id）
    var id1: Buf = buf_new(80);
    defer { buf_free(&id1); }
    var id2: Buf = buf_new(80);
    defer { buf_free(&id2); }
    imgx_id_of(&IMG_PNG_64x48[0], 124, &id1);
    imgx_id_of(&IMG_PNG_64x48[0], 124, &id2);
    if id1.len != 64 || !bufx_mem_eq(id1.ptr as &const byte, id2.ptr as &const byte, 64) {
        ty_fail(tag, "同内容的附件 id 不稳定（应当同 id）", &ok);
    }
    var id3: Buf = buf_new(80);
    defer { buf_free(&id3); }
    imgx_id_of(&IMG_PNG_64x48[0], 123, &id3);
    if bufx_mem_eq(id1.ptr as &const byte, id3.ptr as &const byte, 64) {
        ty_fail(tag, "不同内容算出了同一个附件 id", &ok);
    }

    // 9) base64（与 Python 的 base64 对照：124 字节 → 168 字符含 padding）
    var b64: Buf = buf_new(256);
    defer { buf_free(&b64); }
    if !imgx_b64(&IMG_PNG_64x48[0], 124, &b64) {
        ty_fail(tag, "base64 编码失败", &ok);
    } else {
        if b64.len != 168 {
            ty_fail(tag, "base64 长度不对（124 字节应当是 168 字符）", &ok);
        }
        // PNG 签名 base64 之后固定是 iVBORw0KGgo
        if !bufx_mem_eq(b64.ptr as &const byte, "iVBORw0KGgo" as &const byte, 11) {
            ty_fail(tag, "base64 头部不对（PNG 签名应当是 iVBORw0KGgo）", &ok);
        }
        if b64.ptr[b64.len - 1] != 61 as byte {
            ty_fail(tag, "base64 结尾应当是 '='（padding）", &ok);
        }
    }

    // 10) 附件 JSON 往返（写出去再解析回来，字段逐项相同）
    var list: ImgList = imgx_list_new();
    defer { imgx_list_free(&list); }
    var r: ImgRef = ImgRef{
        kind: IMGX_PNG, width: 64, height: 48, bytes: 124,
        path: buf_empty(), name: buf_empty(),
    };
    var pbuf: Buf = buf_new(64);
    defer { buf_free(&pbuf); }
    _ = buf_append_cstr(&pbuf, "/tmp/x.png");
    var nbuf: Buf = buf_new(16);
    defer { buf_free(&nbuf); }
    _ = buf_append_cstr(&nbuf, "x.png");
    r.path = pbuf;
    r.name = nbuf;
    if !imgx_list_push(&list, &r) {
        ty_fail(tag, "附件入表失败", &ok);
    }
    var js: Buf = buf_new(512);
    defer { buf_free(&js); }
    if !imgx_list_json(&list, &js) {
        ty_fail(tag, "附件 JSON 序列化失败", &ok);
    }
    var back: ImgList = imgx_list_new();
    defer { imgx_list_free(&back); }
    if !imgx_list_parse(js.ptr as &const byte, js.len, &back) {
        ty_fail(tag, "附件 JSON 解析失败", &ok);
    } else {
        if back.len != 1 {
            ty_fail(tag, "往返之后条目数不对", &ok);
        } else {
            if back.items[0].kind != IMGX_PNG || back.items[0].width != 64 || back.items[0].height != 48 || back.items[0].bytes != 124 {
                ty_fail(tag, "往返之后元数据不对", &ok);
            }
            if back.items[0].path.len != 10 || !bufx_mem_eq(back.items[0].path.ptr as &const byte, "/tmp/x.png" as &const byte, 10) {
                ty_fail(tag, "往返之后路径不对", &ok);
            }
            if back.items[0].name.len != 5 || !bufx_mem_eq(back.items[0].name.ptr as &const byte, "x.png" as &const byte, 5) {
                ty_fail(tag, "往返之后展示名不对", &ok);
            }
        }
    }
    // 坏记录不许把整段废掉：一个坏项 + 一个好项 → 只留好的
    const mixed: &const byte = "[{\"mime\":\"image/png\",\"path\":\"\"},{\"mime\":\"image/png\",\"path\":\"/tmp/ok.png\",\"w\":1,\"h\":1,\"bytes\":2}]" as &const byte;
    var mb: ImgList = imgx_list_new();
    defer { imgx_list_free(&mb); }
    if !imgx_list_parse(mixed, bufx_cstr_len(mixed), &mb) {
        ty_fail(tag, "混合记录里好的那一项没留下", &ok);
    } else if mb.len != 1 || mb.items[0].path.len != 11 {
        // "/tmp/ok.png" 是 **11** 字节（不是 12）—— 手数长度又错了一次（踩坑 77 同族）
        ty_fail(tag, "坏记录没被跳过（或者好记录被误删）", &ok);
    }

    // 11) 占位文案（终端不渲染图片，这一行是全部证据 —— 数字必须是真的）
    var lbl: Buf = buf_new(256);
    defer { buf_free(&lbl); }
    imgx_label(&r, &lbl);
    if find_sub(lbl.ptr[0: lbl.len], &img_lbl_dim[0: 6], 0) < 0 {
        ty_fail(tag, "占位行里没有尺寸", &ok);
    }
    if find_sub(lbl.ptr[0: lbl.len], &img_lbl_mime[0: 9], 0) < 0 {
        ty_fail(tag, "占位行里没有 MIME", &ok);
    }
    if find_sub(lbl.ptr[0: lbl.len], &img_lbl_size[0: 5], 0) < 0 {
        ty_fail(tag, "占位行里没有大小", &ok);
    }
    // 大小格式化：B / KiB / MiB 三档
    var fb: Buf = buf_new(64);
    defer { buf_free(&fb); }
    imgx_fmt_bytes(512, &fb);
    if !bufx_eq_cstr(fb.ptr as &const byte, fb.len, "512 B") {
        ty_fail(tag, "512 字节的显示不对", &ok);
    }
    buf_reset(&fb);
    imgx_fmt_bytes(1536, &fb);
    if !bufx_eq_cstr(fb.ptr as &const byte, fb.len, "1.5 KiB") {
        ty_fail(tag, "1536 字节的显示不对（应当 1.5 KiB）", &ok);
    }
    buf_reset(&fb);
    imgx_fmt_bytes(3 * 1024 * 1024 + 512 * 1024, &fb);
    if !bufx_eq_cstr(fb.ptr as &const byte, fb.len, "3.5 MiB") {
        ty_fail(tag, "3.5 MiB 的显示不对", &ok);
    }

    if ok {
        out_err("ok（真 PNG 尺寸/四种格式嗅探/预算/内容寻址 id/base64/JSON 往返/占位文案）");
    }
    out_err("\n");
    return ok;
}


// ============================================================
// clip-parse（P51）：X11 客户端的可测部分（纯函数 + 不依赖 X 会话的行为）
//
// 为什么只测这些：真读剪贴板要一个 X 会话与一个 owner（GTK 才能当 owner），
// 那是 `make e2e-clip` 那条真机腿的事（没有 X 会话就 skip，与 san-shell 缺 bwrap 同口径）。
// 这里钉的是**最容易写错、又不需要环境**的部分：
//   * DISPLAY 解析（`:0` / `unix:0` / `host:0` / `:0.0` / 空 / 畸形）；
//   * ~/.Xauthority 的解析（真格式：family 256 + MIT-MAGIC-COOKIE-1 + display 号配对）；
//   * 请求长度字段（含 pad）—— 这条曾经真错过：长度少算一格会让服务端把请求体尾部
//     当成下一条请求的开头，随后是一连串看不懂的 X 错误；
//   * 结果码 → 人话（绝不留空白文案）。
// ============================================================
// 设一个环境变量（值按 C 串给；自测里改 DISPLAY/HOME 用）。
// 注意函数名是 libc 的 `setenv`（不是 sys_setenv —— 那个不存在，本轮编译错误）。
fn setenv_cstr(name: &const byte, value: &const byte) bool {
    return setenv(name, value, 1) == 0;
}

// 写**定长**字节到文件（write_text_file 按 C 串扫，遇到 0 字节就截断 ——
// Xauthority 这种二进制文件必须用这个）
fn write_raw_file(path_z: &const byte, p: &const byte, n: usize) bool {
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(path_z as *const byte, flags, 420) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    return write_all_fd(fd, p, n);
}

// clip-parse 轮（P51）：X11 客户端里不依赖真 X 会话的那部分——DISPLAY 解析、畸形拒绝、
// Xauthority 配对与失败文案。会让环境变量（DISPLAY/HOME）并在结束时还原；返回 false = 本轮红。
fn clip_round(tag: &const byte) bool {
    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");

    // 1) DISPLAY 解析：正常形态
    var sock: Buf = buf_new(64);
    defer { buf_free(&sock); }
    // 用 setenv 造各种 DISPLAY（自测进程自己的环境，跑完恢复原值）
    var saved: Buf = env_or("DISPLAY" as &const byte, "" as &const byte);
    defer {
        if saved.len > 0 {
            var z: Buf = buf_new(saved.len + 2);
            defer { buf_free(&z); }
            _ = buf_append(&z, saved.ptr as &const byte, saved.len);
            _ = buf_append_byte(&z, 0);
            _ = setenv("DISPLAY" as &const byte, z.ptr as &const byte, 1);
        }
    }
    if !setenv_cstr("DISPLAY" as &const byte, ":0" as &const byte) {
        ty_fail(tag, "设置 DISPLAY 失败", &ok);
    }
    if !clipx_display_socket(&sock) {
        ty_fail(tag, ":0 应当能解析成 socket 路径", &ok);
    } else if !bufx_eq_cstr(sock.ptr as &const byte, sock.len - 1, "/tmp/.X11-unix/X0") {
        ty_fail(tag, ":0 的 socket 路径不对", &ok);
    }
    _ = setenv_cstr("DISPLAY" as &const byte, "unix:7" as &const byte);
    if !clipx_display_socket(&sock) || !bufx_eq_cstr(sock.ptr as &const byte, sock.len - 1, "/tmp/.X11-unix/X7") {
        ty_fail(tag, "unix:7 没解析成 X7", &ok);
    }
    _ = setenv_cstr("DISPLAY" as &const byte, "somehost:1.0" as &const byte);
    if !clipx_display_socket(&sock) || !bufx_eq_cstr(sock.ptr as &const byte, sock.len - 1, "/tmp/.X11-unix/X1") {
        ty_fail(tag, "somehost:1.0 没解析成 X1（屏号要忽略）", &ok);
    }
    // 2) 畸形/空：必须拒绝，绝不猜一个路径去连
    _ = setenv_cstr("DISPLAY" as &const byte, "" as &const byte);
    if clipx_display_socket(&sock) {
        ty_fail(tag, "空 DISPLAY 被当成了可用", &ok);
    }
    _ = setenv_cstr("DISPLAY" as &const byte, "no-colon-here" as &const byte);
    if clipx_display_socket(&sock) {
        ty_fail(tag, "没有冒号的 DISPLAY 被当成了可用", &ok);
    }
    _ = setenv_cstr("DISPLAY" as &const byte, ":abc" as &const byte);
    if clipx_display_socket(&sock) {
        ty_fail(tag, "非数字 display 号被当成了可用", &ok);
    }

    // 3) ~/.Xauthority 解析：写一份真的进去（两个条目，第二个才是本 display）
    var home: Buf = env_or("HOME" as &const byte, "" as &const byte);
    defer { buf_free(&home); }
    if home.len == 0 {
        ty_fail(tag, "HOME 是空的，无法测 Xauthority", &ok);
    } else {
        var authdir: Buf = buf_new(home.len + 32);
        defer { buf_free(&authdir); }
        _ = buf_append(&authdir, home.ptr as &const byte, home.len);
        _ = buf_append_cstr(&authdir, "/.uya_clip_auth_test");
        // sess_mkdir_p 按 **C 串**扫（要 NUL），直接传 Buf 指针会读到缓冲区后面的垃圾
        var adz: Buf = buf_new(authdir.len + 2);
        defer { buf_free(&adz); }
        _ = buf_append(&adz, authdir.ptr as &const byte, authdir.len);
        _ = buf_append_byte(&adz, 0);
        _ = sess_mkdir_p(adz.ptr as &const byte);
        var authp: Buf = buf_new(authdir.len + 32);
        defer { buf_free(&authp); }
        _ = buf_append(&authp, authdir.ptr as &const byte, authdir.len);
        // 文件名必须是 **`.Xauthority`**（带点）—— clipx_auth_cookie 找的就是这个名字。
        // 我第一版写成 `Xauthority`，于是文件明明在磁盘上、解析却永远走「读不到」那条路。
        _ = buf_append_cstr(&authp, "/.Xauthority");
        // 条目：family(2,be) + addr + num + name + data（长度都是 be u16）
        var raw: Buf = buf_new(256);
        defer { buf_free(&raw); }
        // 条目一：display "9"（不该命中）
        _ = buf_append_byte(&raw, 1);
        _ = buf_append_byte(&raw, 0);         // family 256 = Local
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 0);         // addr 长度 0
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 1);
        _ = buf_append_byte(&raw, 57);        // num = "9"
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 18);
        _ = buf_append_cstr(&raw, "MIT-MAGIC-COOKIE-1");
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 2);
        _ = buf_append_byte(&raw, 170);
        _ = buf_append_byte(&raw, 187);
        // 条目二：display "0"，cookie = 4 字节 0xDE 0xAD 0xBE 0xEF
        _ = buf_append_byte(&raw, 1);
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 1);
        _ = buf_append_byte(&raw, 48);        // num = "0"
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 18);
        _ = buf_append_cstr(&raw, "MIT-MAGIC-COOKIE-1");
        _ = buf_append_byte(&raw, 0);
        _ = buf_append_byte(&raw, 4);
        _ = buf_append_byte(&raw, 222);
        _ = buf_append_byte(&raw, 173);
        _ = buf_append_byte(&raw, 190);
        _ = buf_append_byte(&raw, 239);
        // write_text_file 的第二个参数按 **C 串**读（bufx_cstr_len 扫到 NUL 为止），
        // 而 raw 里有 0 字节（family 的高位、长度字段……）—— 直接传会被截断成空文件。
        // 所以这里自己补 NUL 并走原始 write。
        var rawz: Buf = buf_new(raw.len + 2);
        defer { buf_free(&rawz); }
        _ = buf_append(&rawz, raw.ptr as &const byte, raw.len);
        _ = buf_append_byte(&rawz, 0);
        var authz: Buf = buf_new(authp.len + 2);
        defer { buf_free(&authz); }
        _ = buf_append(&authz, authp.ptr as &const byte, authp.len);
        _ = buf_append_byte(&authz, 0);
        if !write_raw_file(authz.ptr as &const byte, rawz.ptr as &const byte, raw.len) {
            ty_fail(tag, "写假 Xauthority 失败", &ok);
        } else {
            // 让 clipx_auth_cookie 去读它：临时把 HOME 指到 authdir
            var saved_home: Buf = env_or("HOME" as &const byte, "" as &const byte);
            defer { buf_free(&saved_home); }
            // setenv 要 C 串：authdir 是 Buf（没有 NUL），必须借上面那个已补 NUL 的副本
            _ = setenv_cstr("HOME" as &const byte, adz.ptr as &const byte);
            var cookie: Buf = buf_new(64);
            defer { buf_free(&cookie); }
            if !clipx_auth_cookie("0" as &const byte, 1, &cookie) {
                ty_fail(tag, "display 0 的 cookie 没读出来", &ok);
            } else if cookie.len != 4 || cookie.ptr[0] != 222 as byte || cookie.ptr[3] != 239 as byte {
                ty_fail(tag, "cookie 的内容不对（应当 DE AD BE EF）", &ok);
            }
            // display 9 命中第一条（2 字节）
            var c9: Buf = buf_new(64);
            defer { buf_free(&c9); }
            if !clipx_auth_cookie("9" as &const byte, 1, &c9) || c9.len != 2 {
                ty_fail(tag, "display 9 应当命中第一条（2 字节）", &ok);
            }
            // 不存在的 display：必须失败，不许回退到别的条目
            var c5: Buf = buf_new(64);
            defer { buf_free(&c5); }
            if clipx_auth_cookie("5" as &const byte, 1, &c5) {
                ty_fail(tag, "不存在的 display 号竟然读到了 cookie", &ok);
            }
            var zh: Buf = buf_new(saved_home.len + 2);
            defer { buf_free(&zh); }
            _ = buf_append(&zh, saved_home.ptr as &const byte, saved_home.len);
            _ = buf_append_byte(&zh, 0);
            _ = setenv("HOME" as &const byte, zh.ptr as &const byte, 1);
        }
    }

    // 4) 结果码 → 人话：每个码都要有非空说明（空白文案等于静默失败）
    if bufx_cstr_len(clipx_reason(CLIPX_NO_X11)) == 0 {
        ty_fail(tag, "CLIPX_NO_X11 没有文案", &ok);
    }
    if bufx_cstr_len(clipx_reason(CLIPX_ERR)) == 0 {
        ty_fail(tag, "CLIPX_ERR 没有文案", &ok);
    }
    if bufx_cstr_len(clipx_reason(CLIPX_NONE)) == 0 {
        ty_fail(tag, "CLIPX_NONE 没有文案", &ok);
    }
    if bufx_cstr_len(clipx_reason(CLIPX_OK_UNUSED)) != 0 {
        ty_fail(tag, "成功码不该有「失败理由」文案", &ok);
    }

    if ok {
        out_err("ok（DISPLAY 解析/畸形拒绝/Xauthority 配对/失败文案）");
    }
    out_err("\n");
    return ok;
}

// hist-repair 轮：尾部修复（hist_trim_incomplete_tail）必须**只丢不完整的一组** ——
// 完整的一组（tool_calls + 等量 tool 结果）一条都不许少，半组要整体丢掉。返回 false = 本轮红。
fn hist_round(tag: &const byte) bool {
    var ok: bool = true;
    // 1) 完整的一组（2 个调用 + 2 条应答）：一条都不许丢
    var h1: History = hist_init();
    defer { hist_free(&h1); }
    if !hist_seed(&h1) || !hist_push_calls(&h1, HIST_CALLS_2) || !hist_push_tool(&h1, "c1", "R1") || !hist_push_tool(&h1, "c2", "R2") {
        ty_fail(tag, "构造历史失败(1)", &ok);
        return ok;
    }
    if !hist_pairing_ok(&h1) {
        ty_fail(tag, "完整的一组被判成不完整(1)", &ok);
    }
    if hist_trim_incomplete_tail(&h1) != 0 || h1.len != 5 {
        ty_fail(tag, "完整的一组被裁掉了（旧实现对完整组也照丢）", &ok);
    }
    if !hist_bytes_ok(&h1) {
        ty_fail(tag, "h.bytes 记账不对(1)", &ok);
    }

    // 2) 2 个调用只回了 1 条：整组丢掉
    var h2: History = hist_init();
    defer { hist_free(&h2); }
    if !hist_seed(&h2) || !hist_push_calls(&h2, HIST_CALLS_2) || !hist_push_tool(&h2, "c1", "R1") {
        ty_fail(tag, "构造历史失败(2)", &ok);
        return ok;
    }
    if hist_pairing_ok(&h2) {
        ty_fail(tag, "缺应答的历史被判成配对完整(2)", &ok);
    }
    if hist_trim_incomplete_tail(&h2) != 2 || h2.len != 2 {
        ty_fail(tag, "缺应答的一组没有整组丢掉(2)", &ok);
    }
    if !hist_pairing_ok(&h2) || !hist_bytes_ok(&h2) {
        ty_fail(tag, "修复后的历史仍不合法(2)", &ok);
    }

    // 3) 一个应答都没有（真实故障留下的形状）：丢掉那条 assistant
    var h3: History = hist_init();
    defer { hist_free(&h3); }
    if !hist_seed(&h3) || !hist_push_calls(&h3, HIST_CALLS_1) {
        ty_fail(tag, "构造历史失败(3)", &ok);
        return ok;
    }
    if hist_trim_incomplete_tail(&h3) != 1 || h3.len != 2 {
        ty_fail(tag, "零应答的 assistant 没有丢掉(3)", &ok);
    }

    // 4) tool_call_id 对不上：整组丢掉
    var h4: History = hist_init();
    defer { hist_free(&h4); }
    if !hist_seed(&h4) || !hist_push_calls(&h4, HIST_CALLS_2) || !hist_push_tool(&h4, "c1", "R1") || !hist_push_tool(&h4, "cX", "R2") {
        ty_fail(tag, "构造历史失败(4)", &ok);
        return ok;
    }
    if hist_pairing_ok(&h4) {
        ty_fail(tag, "id 对不上的历史被判成配对完整(4)", &ok);
    }
    if hist_trim_incomplete_tail(&h4) != 3 || h4.len != 2 {
        ty_fail(tag, "id 对不上的一组没有整组丢掉(4)", &ok);
    }

    // 5) 完整的一组后面接了 user：尾部合法，什么都不该动
    var h5: History = hist_init();
    defer { hist_free(&h5); }
    if !hist_seed(&h5) || !hist_push_calls(&h5, HIST_CALLS_1) || !hist_push_tool(&h5, "c1", "R1") || !hist_push_text(&h5, ROLE_USER, "NEXT") {
        ty_fail(tag, "构造历史失败(5)", &ok);
        return ok;
    }
    if hist_trim_incomplete_tail(&h5) != 0 || h5.len != 5 {
        ty_fail(tag, "尾部是 user 时不该裁剪(5)", &ok);
    }
    if !hist_pairing_ok(&h5) {
        ty_fail(tag, "完整组 + user 被判成不合法(5)", &ok);
    }

    // 6) 孤儿 tool（assistant 已经不在）：丢掉
    var h6: History = hist_init();
    defer { hist_free(&h6); }
    if !hist_seed(&h6) || !hist_push_tool(&h6, "c1", "R1") {
        ty_fail(tag, "构造历史失败(6)", &ok);
        return ok;
    }
    if hist_pairing_ok(&h6) {
        ty_fail(tag, "孤儿 tool 被判成配对完整(6)", &ok);
    }
    if hist_trim_incomplete_tail(&h6) != 1 || h6.len != 2 {
        ty_fail(tag, "孤儿 tool 没有丢掉(6)", &ok);
    }

    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if ok {
        out_err("ok");
    } else {
        out_err("FAIL");
    }
    out_err("\n");
    return ok;
}

// 用 O_WRONLY|O_CREAT|O_TRUNC（mode 0644）把 text 写进 path，写完即关。
// text 按 C 串取长度；返回 false = 打不开或写不满（关了 fd 再返回，不泄漏）。
fn write_text_file(path: &const byte, text: &const byte) bool {
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(path as *const byte, flags, 420) catch {
        return false;
    };
    const n: usize = bufx_cstr_len(text);
    const ok: bool = write_all_fd(fd, text, n);
    _ = sys_close(fd) catch {};
    return ok;
}

// ============================================================
// P33：/sessions 列表（时间倒序 · 三列 · 宽度自适应）—— 纯函数轮
// ============================================================
// 这一轮盯的是数据侧与排版侧：索引去重（同 id 取最后一条）、lastActiveAt 倒序、
// 三列的退化阶梯、条目文本里 id 必须完整（选中项就是靠它 /resume 的）、
// 标题里的控制字节必须被清洗。TUI 浮层那条腿在 tuiselftest 的 tui-sessions 轮。

// 造一行索引记录（has_at = false 时整个 lastActiveAt 字段都不写 = 「缺字段」的样子）
fn sesslist_fixture_line(id: &const byte, cwd: &const byte, at: i64, has_at: bool, title: &const byte, out: &Buf) void {
    _ = buf_append_cstr(out, "{\"id\":\"");
    _ = buf_append_cstr(out, id);
    _ = buf_append_cstr(out, "\",\"cwd\":");
    _ = jw_str_into(out, cwd, bufx_cstr_len(cwd));
    if has_at {
        _ = buf_append_cstr(out, ",\"lastActiveAt\":");
        _ = buf_append_i64(out, at);
    }
    _ = buf_append_cstr(out, ",\"title\":");
    _ = jw_str_into(out, title, bufx_cstr_len(title));
    _ = buf_append_cstr(out, ",\"model\":\"m\",\"delegationDepth\":0,\"turns\":0,\"events\":0,\"path\":\"/x\"}\n");
}

// 数 b 里的换行符个数（= 行数，末尾无换行时最后一行也算）。
fn sesslist_count_lines(b: &Buf) usize {
    var n: usize = 0;
    var i: usize = 0;
    while i < b.len {
        if b.ptr[i] == 10 as byte {
            n = n + 1;
        }
        i = i + 1;
    }
    if b.len > 0 && b.ptr[b.len - 1] != 10 as byte {
        n = n + 1;
    }
    return n;
}

// 第 k 个非空行的字节区间
fn sesslist_span(b: &Buf, k: usize, off: &usize, len: &usize) bool {
    var line: usize = 0;
    var i: usize = 0;
    while i < b.len {
        var e: usize = i;
        while e < b.len && b.ptr[e] != 10 as byte {
            e = e + 1;
        }
        if e > i {
            if line == k {
                off[0] = i;
                len[0] = e - i;
                return true;
            }
            line = line + 1;
        }
        i = e + 1;
    }
    return false;
}

// 渲染出来的第 k 行 → 行尾那个 token（= 该行的完整 id）。
// 走的是**真实**的选中口径 agent_tui_sessions_head（不是另写一套取词规则）：
// 顺序翻转最容易踩的坑就是「行序对了、选中项取错了」。
fn sesslist_render_row_id(rendered: &Buf, k: usize, out: &Buf) bool {
    var o: usize = 0;
    var l: usize = 0;
    if !sesslist_span(rendered, k, &o, &l) {
        return false;
    }
    var line: Buf = buf_new(1024);
    defer { buf_free(&line); }
    if !buf_append(&line, rendered.ptr + o, l) {
        return false;
    }
    buf_reset(out);
    agent_tui_sessions_head(&line, out);
    return out.len > 0;
}

// 取 /sessions 列表里第 k 行的 id 写进 out（先按 sesslist_span 定位该行）。
// 返回 false = 行号越界 / 该行没有 id 字段 / out 容量不够。
fn sesslist_row_id(b: &Buf, k: usize, out: &Buf) bool {
    var o: usize = 0;
    var l: usize = 0;
    if !sesslist_span(b, k, &o, &l) {
        return false;
    }
    // 拷进 scratch 再按 [0: len] 解析：`p[o: o+l]` 在 uya 里是「偏移 + 长度」，会越读
    var scratch: Buf = buf_new(4096);
    defer { buf_free(&scratch); }
    _ = buf_append(&scratch, b.ptr + o, l);
    return sess_json_str(scratch.ptr[0: scratch.len], "id", out);
}

// 取 /sessions 列表里第 k 行的 lastActiveAt（毫秒时间戳）。
// 行号越界 / 该行没有该字段返回 -2（不是 0 —— 0 是合法时间戳）；负数即失败。
fn sesslist_row_at(b: &Buf, k: usize) i64 {
    var o: usize = 0;
    var l: usize = 0;
    if !sesslist_span(b, k, &o, &l) {
        return -2;
    }
    var scratch: Buf = buf_new(4096);
    defer { buf_free(&scratch); }
    _ = buf_append(&scratch, b.ptr + o, l);
    return sess_json_i64(scratch.ptr[0: scratch.len], "lastActiveAt");
}

// exp 第 k 行的裸 id（取出来单独比较，别拿它当 C 字符串用 —— Buf 不保证末尾有 NUL）
fn sesslist_exp_id(exp: &Buf, k: usize, out: &Buf) bool {
    var eo: usize = 0;
    var el: usize = 0;
    if !sesslist_span(exp, k, &eo, &el) {
        return false;
    }
    buf_reset(out);
    return buf_append(out, exp.ptr + eo, el);
}

// rows（每行一条索引记录原文）第 k 行的 id == exp（每行一个裸 id）第 k 行？
fn sesslist_id_eq(rows: &Buf, exp: &Buf, k: usize) bool {
    var got: Buf = buf_new(128);
    defer { buf_free(&got); }
    if !sesslist_row_id(rows, k, &got) {
        return false;
    }
    var eo: usize = 0;
    var el: usize = 0;
    if !sesslist_span(exp, k, &eo, &el) {
        return false;
    }
    if got.len != el {
        return false;
    }
    return bufx_mem_eq(got.ptr as &const byte, exp.ptr + eo, el);
}

// hay 里是否含字面量（测试断言用）
fn sesslist_has(hay: &Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if n == 0 || hay.len < n {
        return false;
    }
    var i: usize = 0;
    while i + n <= hay.len {
        if bufx_mem_eq(hay.ptr + i, lit, n) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 在给定可用列数下渲染一次并逐行检查：
//   * 行宽 <= body（除非窄到连 id 都放不下 —— 那一档 id 必须**完整**，裁剪交给显示层）；
//   * 行尾 token 能还出这一行完整的 id（agent_tui_sessions_head 的口径）；
//   * 正文里一个控制字节都没有（标题里的 \u0001 / TAB 必须被清洗掉）。
// exp = 期望的 id 列表（每行一个，'\n' 结尾）—— 按**数据层**口径给（第 0 行 = 最新）。
// P35：渲染是「最新在最后一行」，所以把渲染出来的第 k 行按镜像去比 exp 的第 n-1-k 行；
// 镜像本身也是断言的一部分（顺序错了这里必然红）。
fn sesslist_check_width(rows: &Buf, exp: &Buf, body: usize, want_title: bool, want_ws: bool, tag: &const byte, ok: &bool) bool {
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    sess_rows_render(rows, body, &out, true);
    const n: usize = sesslist_count_lines(&out);
    const en: usize = sesslist_count_lines(exp);
    if n != en {
        ty_fail(tag, "会话列表的行数与去重后的会话数不一致", ok);
        return false;
    }
    var k: usize = 0;
    while k < n {
        var o: usize = 0;
        var l: usize = 0;
        if !sesslist_span(&out, k, &o, &l) {
            break;
        }
        // 渲染序 ↔ 数据序的镜像（最新在最后一行）
        if !sesslist_id_eq(rows, exp, n - 1 - k) {
            ty_fail(tag, "渲染出来的第 k 行不是期望的会话（顺序或去重错了）", ok);
            break;
        }
        const cols: usize = tty_cols_between(out.ptr + o, 0, l);
        // 只剩 id 那一档（body < id 本身的 44 列）允许超宽：那份 id 必须完整，
        // 裁剪交给显示层（浮层画的时候裁 / 滚动模式打印前 sess_rows_clip_into 裁）。
        if cols > body && body >= 44 {
            ty_fail(tag, "会话列表某行超过可用列数", ok);
        }
        // 选中项取 id：必须是这一行完整的 id（拿标题当 id 是最典型的错法）
        var line: Buf = buf_new(1024);
        defer { buf_free(&line); }
        var sid: Buf = buf_new(128);
        defer { buf_free(&sid); }
        _ = buf_append(&line, out.ptr + o, l);
        agent_tui_sessions_head(&line, &sid);
        var want_id: Buf = buf_new(128);
        defer { buf_free(&want_id); }
        if !sesslist_exp_id(exp, n - 1 - k, &want_id) {
            ty_fail(tag, "期望列表里少了一行", ok);
            break;
        }
        // 按长度比较：两边都是 Buf（不保证 NUL 结尾），bufx_eq_cstr 只收 C 字符串
        if sid.len != want_id.len || !bufx_mem_eq(sid.ptr as &const byte, want_id.ptr as &const byte, want_id.len) {
            ty_fail(tag, "选中项里没取到完整的 session id（把标题当 id 了？）", ok);
        }
        // 控制字节：正文层不许有（TAB / 0x01 都在清洗这一步被换掉）
        var c: usize = 0;
        while c < l {
            const ch: byte = out.ptr[o + c];
            if ch < 0x20 as byte || ch == 0x7f as byte {
                ty_fail(tag, "会话列表里出现了控制字节（标题没清洗？）", ok);
                break;
            }
            c = c + 1;
        }
        k = k + 1;
    }
    // 列的存在性：能放下就该看得见，放不下就不该出现（退化阶梯）
    const has_title: bool = sesslist_has(&out, "TITLE" as &const byte);
    const has_ws: bool = sesslist_has(&out, "MARK" as &const byte);
    if has_title != want_title {
        ty_fail(tag, "标题列的可见性与预期不符（列宽分配 / 退化阶梯错了）", ok);
    }
    if has_ws != want_ws {
        ty_fail(tag, "工作区列的可见性与预期不符（列宽分配 / 退化阶梯错了）", ok);
    }
    return true;
}

// /sessions 列表轮（P33，纯函数）：造四份假日志，断言索引去重（同 id 取最后一条）、
// lastActiveAt 倒序、三列排版与宽度退阶梯（工作区列该藏就藏）。返回 false = 本轮红。
fn sess_list_round(tag: &const byte) bool {
    var ok: bool = true;
    const home: &const byte = "build/selftest_sess_list" as &const byte;
    _ = sess_mkdir_p(home);
    const ida: &const byte = "session-aaaa1111-1111-4111-8111-111111111111" as &const byte;
    const idb: &const byte = "session-bbbb2222-2222-4222-8222-222222222222" as &const byte;
    const idc: &const byte = "session-cccc3333-3333-4333-8333-333333333333" as &const byte;
    const idd: &const byte = "session-dddd4444-4444-4444-8444-444444444444" as &const byte;

    // ---- fixture：真实索引的形状（追加写 ⇒ 同 id 两条；时间戳乱序；缺字段；空标题；
    //      带控制字节的标题；超长 cwd）----
    var btitle: Buf = buf_new(128);
    defer { buf_free(&btitle); }
    _ = buf_append_cstr(&btitle, "TITLE B");     // 后面补控制字节与 TAB（必须被清洗）
    _ = buf_append_byte(&btitle, 9);
    _ = buf_append_cstr(&btitle, "tab");
    _ = buf_append_byte(&btitle, 1);
    _ = buf_append_cstr(&btitle, "ctrl 尾巴");
    _ = buf_append_byte(&btitle, 0);
    var idx: Buf = buf_new(8192);
    defer { buf_free(&idx); }
    sesslist_fixture_line(ida, "/w/old-a" as &const byte, 1000, true, "TITLE A 第一条（应当被取代）" as &const byte, &idx);
    sesslist_fixture_line(idb, "/w/x/MARK" as &const byte, 5000, true, btitle.ptr as &const byte, &idx);
    sesslist_fixture_line(idc, "/w/c" as &const byte, 7000, true, "" as &const byte, &idx);
    sesslist_fixture_line(idd, "/w/d" as &const byte, 0, false, "TITLE D 没有时间戳" as &const byte, &idx);
    sesslist_fixture_line(ida, "/w/new-a" as &const byte, 9000, true, "TITLE A 后一条（生效的那条）" as &const byte, &idx);
    _ = buf_append_byte(&idx, 10);   // 尾随空行：必须被忽略
    var ipath: Buf = buf_new(128);
    defer { buf_free(&ipath); }
    _ = buf_append_cstr(&ipath, home);
    _ = buf_append_cstr_z(&ipath, "/index.jsonl");
    _ = buf_append_byte(&idx, 0);    // write_text_file 收 C 字符串
    if !write_text_file(ipath.ptr as &const byte, idx.ptr as &const byte) {
        ty_fail(tag, "写 fixture 索引失败", &ok);
        return false;
    }

    // ---- 1) 索引 → 去重 + 倒序 ----
    var hz: Buf = buf_new(128);
    defer { buf_free(&hz); }
    _ = buf_append_cstr(&hz, home);
    _ = buf_append_byte(&hz, 0);
    var rows: Buf = buf_new(8192);
    defer { buf_free(&rows); }
    if !sess_index_rows_sorted(hz.ptr as &const byte, &rows) {
        ty_fail(tag, "索引里读不出会话记录", &ok);
        return false;
    }
    if sesslist_count_lines(&rows) != 4 {
        ty_fail(tag, "去重后不是 4 条（同 id 只该留最后一条）", &ok);
    }
    // 顺序：A 的后一条（9000）→ C（7000）→ B（5000）→ D（缺时间戳，最后）
    const exp_ids: &const byte = "session-aaaa1111-1111-4111-8111-111111111111\nsession-cccc3333-3333-4333-8333-333333333333\nsession-bbbb2222-2222-4222-8222-222222222222\nsession-dddd4444-4444-4444-8444-444444444444\n" as &const byte;
    var exp: Buf = buf_new(256);
    defer { buf_free(&exp); }
    _ = buf_append_cstr(&exp, exp_ids);
    const exp_at: [i64: 4] = [9000, 7000, 5000, -1];
    var k: usize = 0;
    while k < 4 {
        if !sesslist_id_eq(&rows, &exp, k) {
            ty_fail(tag, "倒序不对（最新的一条必须在最上面）", &ok);
        }
        if sesslist_row_at(&rows, k) != exp_at[k] {
            ty_fail(tag, "lastActiveAt 取值不对（去重应当保留最后一条记录）", &ok);
        }
        k = k + 1;
    }

    // ---- 2) 三列排版：去重取的是后一条、空标题落到占位串；P35 最新在最后一行 ----
    var wide: Buf = buf_new(65536);
    defer { buf_free(&wide); }
    sess_rows_render(&rows, 198, &wide, true);
    if sesslist_has(&wide, "后一条" as &const byte) == false {
        ty_fail(tag, "同 id 没取「最后一条」记录（去重取错了那条）", &ok);
    }
    if sesslist_has(&wide, "第一条" as &const byte) {
        ty_fail(tag, "被取代的那条记录还在列表里", &ok);
    }
    if !sesslist_has(&wide, "(无标题)" as &const byte) {
        ty_fail(tag, "空标题没有落到占位串上", &ok);
    }
    // P35：最新的那条（ida 的后一条，9000）必须在**最后一行**，最旧的（idd，缺时间戳）在第一行。
    // 只比「出现在最后一行」还不够 —— 得把那一行的 id 取出来比，免得把别的会话排到末尾也蒙混过关。
    const nwide: usize = sesslist_count_lines(&wide);
    var last_id: Buf = buf_new(128);
    defer { buf_free(&last_id); }
    if !sesslist_render_row_id(&wide, nwide - 1, &last_id) {
        ty_fail(tag, "渲染出来的最后一行取不到完整 id", &ok);
    } else if !bufx_mem_eq(last_id.ptr as &const byte, ida, bufx_cstr_len(ida)) {
        ty_fail(tag, "最新的会话没有排在最后一行", &ok);
    }
    var first_id: Buf = buf_new(128);
    defer { buf_free(&first_id); }
    if !sesslist_render_row_id(&wide, 0, &first_id) {
        ty_fail(tag, "渲染出来的第一行取不到完整 id", &ok);
    } else if !bufx_mem_eq(first_id.ptr as &const byte, idd, bufx_cstr_len(idd)) {
        ty_fail(tag, "最旧的会话（缺 lastActiveAt 那条）没有排在第一行", &ok);
    }

    // ---- 3) 宽度扫描：三列 → 两列（丢工作区）→ 只剩 id ----
    // 三列的门槛 = id(44) + 2 个间隔(4) + 两列各 6 列 = 60；两列 = 44 + 2 + 6 = 52
    _ = sesslist_check_width(&rows, &exp, 198, true, true, tag, &ok);
    _ = sesslist_check_width(&rows, &exp, 78, true, true, tag, &ok);     // 80 列终端
    _ = sesslist_check_width(&rows, &exp, 60, true, true, tag, &ok);     // 三列最小档
    _ = sesslist_check_width(&rows, &exp, 59, true, false, tag, &ok);    // 掉工作区列
    _ = sesslist_check_width(&rows, &exp, 52, true, false, tag, &ok);    // 两列最小档
    _ = sesslist_check_width(&rows, &exp, 51, false, false, tag, &ok);   // 只剩 id
    _ = sesslist_check_width(&rows, &exp, 44, false, false, tag, &ok);   // id 正好放得下
    _ = sesslist_check_width(&rows, &exp, 40, false, false, tag, &ok);   // 放不下（行宽 = id 的 44）

    // ---- 4) 滚动模式打印前的硬裁（窄终端上 44 列的 id 不能让行折行）----
    var clip: Buf = buf_new(65536);
    defer { buf_free(&clip); }
    sess_rows_clip_into(&wide, 21, &clip);
    const cn: usize = sesslist_count_lines(&clip);
    if cn == 0 {
        ty_fail(tag, "硬裁之后一行都不剩了", &ok);
    }
    k = 0;
    while k < cn {
        var o: usize = 0;
        var l: usize = 0;
        if !sesslist_span(&clip, k, &o, &l) {
            break;
        }
        if tty_cols_between(clip.ptr + o, 0, l) > 21 {
            ty_fail(tag, "硬裁之后仍有超过终端列数的行", &ok);
        }
        if !sesslist_has(&clip, "…" as &const byte) {
            ty_fail(tag, "被裁掉 id 的行没有补 '…'（半截 id 抄去 /resume 一定失败）", &ok);
        }
        k = k + 1;
    }
    // 放得下就不许裁：三列排版本来就正好 body 列，多留一列 '…' 会把好端端的 id 截掉
    var clip_fit: Buf = buf_new(65536);
    defer { buf_free(&clip_fit); }
    sess_rows_clip_into(&wide, 198, &clip_fit);
    if sesslist_has(&clip_fit, "…" as &const byte) {
        ty_fail(tag, "行本来放得下却被硬裁了（'…' 预算算错）", &ok);
    }

    // ---- 5) 没有索引：不能假装有会话 ----
    var norows: Buf = buf_new(256);
    defer { buf_free(&norows); }
    var nz: Buf = buf_new(64);
    defer { buf_free(&nz); }
    _ = buf_append_cstr(&nz, "build/selftest_sess_list_none");
    _ = buf_append_byte(&nz, 0);
    if sess_index_rows_sorted(nz.ptr as &const byte, &norows) {
        ty_fail(tag, "没有索引时不该返回记录", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（去重取最后一条 + 数据层倒序 / 展示层最新在最后一行 + 三列/两列/只剩 id 的退化 + id 完整 + 控制字节清洗）\n");
    }
    return ok;
}

// ============================================================
// sess-list-big（踩坑 68）：大索引上的排序 —— 与参考插入排序逐行等价 + 结果确定
// ============================================================
// 现场（用户报的「session 选择框显示后很卡」）：数据层两处 `sess_idx_sort_*` 是**插入排序**
// （O(n²)）。会话索引是追加写的，lastActiveAt 天然升序 ⇒ 插入排序每次都把新记录一路挪到
// 最前，正好是最坏情况（实测 12.8 K 行：升序 1.4 s、降序 0.19 s）。改成自底向上归并
// （O(n log n)）之后两种顺序都是 0.2 s 量级。
//
// 这一轮盯两件事：
//   1) **等价性**：归并的结果与「金标准（就用未修版本的插入排序）」逐行相同 —— 比较键
//      必须是严格全序，否则同键记录的顺序会漂（`line_off` 是次级键，在一份索引里唯一）；
//   2) **确定性**：同一份输入排两次，结果逐行相同。

// 金标准：按 (id 升序, 行号升序) 的插入排序（未修版本原文，只给自测当参照）
fn sessbig_ref_sort_by_id(idx: &const Buf, rows: &SessIdxRow, n: usize) void {
    const tmp: &SessIdxRow = sess_idx_at_mut(rows, n);
    var i: usize = 1;
    while i < n {
        sess_idx_copy(tmp, sess_idx_at(rows, i));
        var j: usize = i;
        while j > 0 {
            const prev: &const SessIdxRow = sess_idx_at(rows, j - 1);
            const c: i32 = sess_idx_id_cmp(idx, prev, tmp);
            var stop: bool = false;
            if c < 0 {
                stop = true;
            } else if c == 0 && prev.line_off < tmp.line_off {
                stop = true;
            }
            if stop {
                break;
            }
            sess_idx_copy(sess_idx_at_mut(rows, j), prev);
            j = j - 1;
        }
        sess_idx_copy(sess_idx_at_mut(rows, j), tmp);
        i = i + 1;
    }
}

// 金标准：按 (lastActiveAt 降序, 行号降序) 的插入排序
fn sessbig_ref_sort_by_at(rows: &SessIdxRow, n: usize) void {
    const tmp: &SessIdxRow = sess_idx_at_mut(rows, n);
    var i: usize = 1;
    while i < n {
        sess_idx_copy(tmp, sess_idx_at(rows, i));
        var j: usize = i;
        while j > 0 {
            const prev: &const SessIdxRow = sess_idx_at(rows, j - 1);
            var before: bool = false;
            if prev.at > tmp.at {
                before = true;
            } else if prev.at == tmp.at && prev.line_off > tmp.line_off {
                before = true;
            }
            if before {
                break;
            }
            sess_idx_copy(sess_idx_at_mut(rows, j), prev);
            j = j - 1;
        }
        sess_idx_copy(sess_idx_at_mut(rows, j), tmp);
        i = i + 1;
    }
}

const SESSBIG_N: usize = 6000;      // 索引记录数（去重后 2000 条会话）
const SESSBIG_ESZ_MUL: usize = 2;   // 每行记录占的格数（数据 n 格 + 归并目标区 n 格）

// 造一份大索引的**内存镜像**（不落盘）：形状对齐真索引 —— 追加写 ⇒ 时间戳升序；
// 每 3 条同 id（后一条生效）；每 7 条缺一条 lastActiveAt；每 11 条重复一次时间戳。
fn sessbig_build_fixture(rows: &Buf) bool {
    buf_reset(rows);
    var i: usize = 0;
    while i < SESSBIG_N {
        var line: Buf = buf_new(256);
        defer { buf_free(&line); }
        _ = buf_append_cstr(&line, "{\"id\":\"session-");
        const gid: usize = i / 3;
        var hex: Buf = buf_new(32);
        defer { buf_free(&hex); }
        _ = buf_append_u64(&hex, gid as u64);
        var pad: usize = hex.len;
        while pad < 8 {
            _ = buf_append_byte(&line, 48);   // '0'：id 补齐 8 位十六进制
            pad = pad + 1;
        }
        _ = buf_append(&line, hex.ptr, hex.len);
        _ = buf_append_cstr(&line, "-1111-4111-8111-111111111111\",\"cwd\":\"/w/");
        _ = buf_append_u64(&line, (i % 5) as u64);
        _ = buf_append_cstr(&line, "\",\"title\":\"T");
        _ = buf_append_u64(&line, i as u64);
        _ = buf_append_cstr(&line, "\"");
        if (i % (7 as usize)) != (3 as usize) {
            const at: i64 = (1700000000000 as i64) + ((i / 11) as i64);
            _ = buf_append_cstr(&line, ",\"lastActiveAt\":");
            var num: Buf = buf_new(32);
            defer { buf_free(&num); }
            _ = buf_append_i64(&num, at);
            _ = buf_append(&line, num.ptr, num.len);
        }
        _ = buf_append_cstr(&line, "}\n");
        if !buf_append(rows, line.ptr, line.len) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 把 rows（每行一条索引记录原文）填进紧凑记录表；返回填了几条。
// 表必须能放下 2n+2 格（归并排序的目标区），所有字段逐项写。
fn sessbig_fill_rows(rows: &Buf, tab: &SessIdxRow, cap: usize) usize {
    var m: usize = 0;
    var p: usize = 0;
    while p < rows.len && m < cap {
        var e: usize = p;
        while e < rows.len && rows.ptr[e] != 10 as byte {
            e = e + 1;
        }
        const lo: usize = p;
        const ll: usize = e - p;
        p = e + 1;
        if ll == 0 {
            continue;
        }
        var line: Buf = buf_new(4096);
        defer { buf_free(&line); }
        _ = buf_append(&line, rows.ptr + lo, ll);
        const view: &[byte] = line.ptr[0: line.len];
        var ido: usize = 0;
        var idl: usize = 0;
        if !sess_idx_find_id(view, &ido, &idl) {
            continue;
        }
        const r: &SessIdxRow = sess_idx_at_mut(tab, m);
        r.at = sess_json_i64(view, "lastActiveAt");
        r.line_off = lo;
        r.line_len = ll;
        r.id_off = lo + ido;
        r.id_len = idl;
        m = m + 1;
    }
    return m;
}

// 两张表逐行的 line_off 是否相同（不同就返回首个不同的行号，相同返回 -1）
fn sessbig_first_diff(a: &const SessIdxRow, b: &const SessIdxRow, n: usize) i64 {
    var i: usize = 0;
    while i < n {
        if sess_idx_at(a, i).line_off != sess_idx_at(b, i).line_off {
            return i as i64;
        }
        i = i + 1;
    }
    return -1 as i64;
}

// 表是否按 mode 排好（含次级键）
fn sessbig_sorted_ok(idx: &const Buf, tab: &const SessIdxRow, n: usize, mode: u8, why: &Buf) bool {
    var i: usize = 1;
    while i < n {
        const prev: &const SessIdxRow = sess_idx_at(tab, i - 1);
        const cur: &const SessIdxRow = sess_idx_at(tab, i);
        // 「cur 不该排在 prev 前面」——把 sess_idx_before 反过来问
        if sess_idx_before(mode, idx, cur, prev) {
            buf_reset(why);
            _ = buf_append_cstr(why, "第 ");
            _ = buf_append_u64(why, i as u64);
            _ = buf_append_cstr(why, " 行乱序");
            return false;
        }
        i = i + 1;
    }
    return true;
}

// sess-list-big 轮（踩坑 68）：6000 行大索引上，归并排序必须与参考插入排序**逐行等价**、
// 两把键各自有序、结果确定、去重 2000 条、行尾 id 完整。返回 false = 本轮红。
fn sess_list_big_round(tag: &const byte) bool {
    var ok: bool = true;
    var rows: Buf = buf_new(1 << 20);
    defer { buf_free(&rows); }
    if !sessbig_build_fixture(&rows) {
        ty_fail(tag, "大索引 fixture 造不出来", &ok);
        return ok;
    }
    // fixture 自检：非空行数 == SESSBIG_N
    var nl: usize = 0;
    var p: usize = 0;
    while p < rows.len {
        var e: usize = p;
        while e < rows.len && rows.ptr[e] != 10 as byte {
            e = e + 1;
        }
        if e > p {
            nl = nl + 1;
        }
        p = e + 1;
    }
    if nl != SESSBIG_N {
        ty_fail(tag, "fixture 的非空行数与预期不一致", &ok);
        return ok;
    }

    // 两张表：A 走生产实现（sess_idx_sort），B 走金标准插入排序。
    // 按 2n+2 格分配（生产实现要归并目标区；金标准只用末格暂存）。
    const esz: usize = @size_of(SessIdxRow) as usize;
    const nalloc: usize = (SESSBIG_N * SESSBIG_ESZ_MUL) + 2;
    const rawA: &void = malloc(nalloc * esz);
    const rawB: &void = malloc(nalloc * esz);
    if ((rawA as &byte) as usize) == 0 || ((rawB as &byte) as usize) == 0 {
        if ((rawA as &byte) as usize) != 0 {
            free(rawA);
        }
        if ((rawB as &byte) as usize) != 0 {
            free(rawB);
        }
        ty_fail(tag, "排序表分配失败", &ok);
        return ok;
    }
    defer {
        free(rawA);
        free(rawB);
    }
    const ta: &SessIdxRow = rawA as &SessIdxRow;
    const tb: &SessIdxRow = rawB as &SessIdxRow;
    const m: usize = sessbig_fill_rows(&rows, ta, SESSBIG_N);
    if m != SESSBIG_N {
        ty_fail(tag, "填表条数与 fixture 不符", &ok);
        return ok;
    }
    // B 表照抄 A（填两遍比 memcpy 一份结构体数组更省事，也不碰移动语义）
    var ci: usize = 0;
    while ci < m {
        sess_idx_copy(sess_idx_at_mut(tb, ci), sess_idx_at(ta, ci));
        ci = ci + 1;
    }

    // ---- 1) 第一把键（id 升序）：生产实现 vs 金标准，逐行 line_off 全等 ----
    sess_idx_sort(&rows, ta, m, SESS_IDX_BY_ID);
    sessbig_ref_sort_by_id(&rows, tb, m);
    const d1: i64 = sessbig_first_diff(ta, tb, m);
    if d1 >= 0 {
        ty_fail(tag, "按 id 排序的结果与金标准（插入排序）不一致", &ok);
        out_err("  首个不同的行号 = ");
        out_err_dec(d1 as usize);
        out_err("\n");
    }
    var why1: Buf = buf_new(96);
    defer { buf_free(&why1); }
    if ok && !sessbig_sorted_ok(&rows, ta, m, SESS_IDX_BY_ID, &why1) {
        ty_fail(tag, "按 id 排序之后不是「id 升序 / 同 id 行号升序」", &ok);
        out_err("  ");
        out_err_bytes(why1.ptr as &const byte, why1.len);
        out_err("\n");
    }

    // ---- 2) 第二把键（lastActiveAt 降序 / 同行号降序）：同样比对，再验有序 ----
    // B 表已经被步骤 1 排过；先把它还原成 A 的当前顺序再比第二把键
    ci = 0;
    while ci < m {
        sess_idx_copy(sess_idx_at_mut(tb, ci), sess_idx_at(ta, ci));
        ci = ci + 1;
    }
    sess_idx_sort(&rows, ta, m, SESS_IDX_BY_AT);
    sessbig_ref_sort_by_at(tb, m);
    const d2: i64 = sessbig_first_diff(ta, tb, m);
    if d2 >= 0 {
        ty_fail(tag, "按 lastActiveAt 排序的结果与金标准（插入排序）不一致", &ok);
        out_err("  首个不同的行号 = ");
        out_err_dec(d2 as usize);
        out_err("\n");
    }
    var why2: Buf = buf_new(96);
    defer { buf_free(&why2); }
    if ok && !sessbig_sorted_ok(&rows, ta, m, SESS_IDX_BY_AT, &why2) {
        ty_fail(tag, "按 lastActiveAt 排序之后不是「时间降序 / 同时间戳行号降序」", &ok);
        out_err("  ");
        out_err_bytes(why2.ptr as &const byte, why2.len);
        out_err("\n");
    }

    // ---- 3) 确定性：把同一份输入排两次，逐行相同 ----
    const rawC: &void = malloc(nalloc * esz);
    if ((rawC as &byte) as usize) == 0 {
        ty_fail(tag, "确定性用的第三张表分配失败", &ok);
        return ok;
    }
    defer { free(rawC); }
    const tc: &SessIdxRow = rawC as &SessIdxRow;
    ci = 0;
    while ci < m {
        sess_idx_copy(sess_idx_at_mut(tc, ci), sess_idx_at(ta, ci));
        ci = ci + 1;
    }
    sess_idx_sort(&rows, tc, m, SESS_IDX_BY_AT);
    const d3: i64 = sessbig_first_diff(ta, tc, m);
    if d3 >= 0 {
        ty_fail(tag, "同一份输入排两次结果不同（排序不确定）", &ok);
        out_err("  首个不同的行号 = ");
        out_err_dec(d3 as usize);
        out_err("\n");
    }

    // ---- 4) 端到端：去重 → 三列排版，行数 == 去重后的会话数，行尾 id 完整 ----
    // 去重口径照抄 sess_index_rows_sorted：先按 id 排，再每组只留最后一条
    sess_idx_sort(&rows, ta, m, SESS_IDX_BY_ID);
    var rows_only: Buf = buf_new(1 << 20);
    defer { buf_free(&rows_only); }
    var keep: usize = 0;
    var i: usize = 0;
    while i < m {
        var j: usize = i + 1;
        while j < m {
            if sess_idx_id_cmp(&rows, sess_idx_at(ta, i), sess_idx_at(ta, j)) != 0 {
                break;
            }
            j = j + 1;
        }
        const lastr: &const SessIdxRow = sess_idx_at(ta, j - 1);
        _ = buf_append(&rows_only, rows.ptr + lastr.line_off, lastr.line_len);
        _ = buf_append_byte(&rows_only, 10);
        keep = keep + 1;
        i = j;
    }
    const want_keep: usize = SESSBIG_N / 3;
    if keep != want_keep {
        ty_fail(tag, "去重之后的会话数不对", &ok);
        out_err("  实际 = ");
        out_err_dec(keep);
        out_err(" 期望 = ");
        out_err_dec(want_keep);
        out_err("\n");
    }
    var render: Buf = buf_new(1 << 20);
    defer { buf_free(&render); }
    sess_rows_render(&rows_only, 198, &render, true);
    var rl: usize = 0;
    p = 0;
    while p < render.len {
        if render.ptr[p] == 10 as byte {
            rl = rl + 1;
        }
        p = p + 1;
    }
    if rl != want_keep {
        ty_fail(tag, "大索引渲染出来的行数与会话数不一致", &ok);
        out_err("  实际 = ");
        out_err_dec(rl);
        out_err(" 期望 = ");
        out_err_dec(want_keep);
        out_err("\n");
    }
    // 抽查首 / 中 / 末三行的行尾 id：必须是完整的 44 字节、且以 session- 开头
    const probes: [usize: 3] = [0, want_keep / 2, want_keep - 1];
    var full_id: Buf = buf_new(128);
    defer { buf_free(&full_id); }
    var pk: usize = 0;
    while pk < 3 {
        const row: usize = probes[pk];
        if !sesslist_render_row_id(&render, row, &full_id) {
            ty_fail(tag, "大索引渲染出来的行取不到行尾 id", &ok);
        } else if full_id.len != 44 {
            ty_fail(tag, "大索引渲染出来的行尾 id 长度不对（半截 id 会让 /resume 失败）", &ok);
            out_err("  行 = ");
            out_err_dec(row);
            out_err("  len = ");
            out_err_dec(full_id.len);
            out_err("\n");
        } else if !bufx_mem_eq(full_id.ptr as &const byte, "session-" as &const byte, 8) {
            ty_fail(tag, "大索引渲染出来的行尾 id 不以 session- 开头", &ok);
        }
        pk = pk + 1;
    }
    // P35 展示序：最新的（时间戳最大）必须在最后一行，最旧的（缺时间戳那批）在第一行
    var first_id: Buf = buf_new(128);
    defer { buf_free(&first_id); }
    if sesslist_render_row_id(&render, 0, &first_id) {
        // 缺 lastActiveAt 的记录 at = -1，排最后 ⇒ 展示序（最新在最后）里它就该在最上
        var first_row: Buf = buf_new(1024);
        defer { buf_free(&first_row); }
        if sesslist_span(&render, 0, &p, &nl) {
            _ = buf_append(&first_row, render.ptr + p, nl);
            if sesslist_has(&first_row, "\"lastActiveAt\"" as &const byte) {
                ty_fail(tag, "缺 lastActiveAt 的记录没有垫到最上面（展示序反了？）", &ok);
            }
        }
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（6000 行大索引：归并与金标准逐行等价 + 两把键各自有序 + 排序确定 + 去重 2000 条 + 行尾 id 完整）\n");
    }
    return ok;
}

// DSH 设置解析轮（假 DSH_HOME）：settings.yaml 的预处理（顶层与行尾注释去掉、块标量里的
// 井号保留）与各段读取（provider / model / permission / tls / !!js 行被忽略）。返回 false = 本轮红。
fn dshcfg_round(tag: &const byte) bool {
    var ok: bool = true;
    const home: &const byte = "build/selftest_dsh_home";
    _ = sess_mkdir_p("build/selftest_dsh_home");
    var spath: Buf = buf_new(256);
    defer { buf_free(&spath); }
    _ = buf_append_cstr(&spath, home);
    _ = buf_append_cstr_z(&spath, "/settings.yaml");
    const settings: &const byte = "# 顶层注释：这一行必须被去掉\nllm-pi-ai:\n  providers:\n    {\n      fakeprov:\n        {\n          apiKeyEnv: FAKE_API_KEY,\n          api: openai-responses,\n          baseURL: https://fake.example/v1,   # 行尾注释\n          compat: { supportsDeveloperRole: false, supportsStore: false, supportsReasoningEffort: false },\n          models:\n            [\n              { id: fake-model, contextWindow: 65536, maxTokens: 4096, input: [ text, image ], compat: { supportsDeveloperRole: true } }\n            ]\n        }\n    }\nagent-presets:\n  default: standard\nagent-default-model:\n  provider: fakeprov\n  model: fake-model\n  reasoningEffort: high\npermission:\n  defaultPreset: workspace-write\nuya-agent:\n  tls: { verify: pin, pin: abc123 }\nplan: |\n  # 块标量里的井号必须保留\n  second line\ndisabled_row: !!js process.platform === 'win32'\n";
    if !write_text_file(&spath.ptr[0] as &const byte, settings) {
        ty_fail(tag, "写 settings.yaml 失败", &ok);
        return false;
    }
    var cpath: Buf = buf_new(256);
    defer { buf_free(&cpath); }
    _ = buf_append_cstr(&cpath, home);
    _ = buf_append_cstr_z(&cpath, "/.credentials.yaml");
    const creds: &const byte = "version: 1\nrefs:\n  FAKE_API_KEY: sk-fake-123456\n";
    if !write_text_file(&cpath.ptr[0] as &const byte, creds) {
        ty_fail(tag, "写 .credentials.yaml 失败", &ok);
    }
    // 确保环境变量不会抢先（否则测的是 env 而不是当前逻辑）

    var dsh: DshCfg = dsh_cfg_empty();
    defer { dsh_cfg_free(&dsh); }
    if !dsh_cfg_load(home, "build/selftest_dsh_ws", &dsh) {
        ty_fail(tag, "dsh_cfg_load 失败", &ok);
        return false;
    }
    if !ty_buf_is(&dsh.provider, "fakeprov") {
        ty_fail(tag, "provider 解析错", &ok);
    }
    if !ty_buf_is(&dsh.model, "fake-model") {
        ty_fail(tag, "model 解析错", &ok);
    }
    if !ty_buf_is(&dsh.base_url, "https://fake.example/v1") {
        ty_fail(tag, "baseURL 解析错（行尾注释没被去掉？）", &ok);
        out_err("[dbg] base_url=");
        out_err_bytes(dsh.base_url.ptr, dsh.base_url.len);
        out_err("\n");
    }
    if !ty_buf_is(&dsh.api_key_env, "FAKE_API_KEY") {
        ty_fail(tag, "apiKeyEnv 解析错", &ok);
    }
    if !ty_buf_is(&dsh.api_key, "sk-fake-123456") || dsh.key_src != DSHSRC_CREDS {
        ty_fail(tag, "凭据没有从 .credentials.yaml 取到", &ok);
    }
    if dsh.context_window != 65536 {
        ty_fail(tag, "contextWindow 解析错", &ok);
    }
    if dsh.max_tokens != 4096 {
        ty_fail(tag, "maxTokens 解析错", &ok);
    }
    if !dsh.input_image {
        ty_fail(tag, "input 里的 image 没识别出来", &ok);
    }
    if !ty_buf_is(&dsh.reasoning_effort, "high") {
        ty_fail(tag, "reasoningEffort 解析错", &ok);
    }
    // 线协议 + 三个 compat 开关：路由级读得到，模型级同名键覆盖路由级
    if !ty_buf_is(&dsh.api_style, "openai-responses") {
        ty_fail(tag, "api 解析错", &ok);
    }
    if dsh.compat_dev_role != 1 {
        ty_fail(tag, "模型级 compat.supportsDeveloperRole=true 应当覆盖路由级的 false", &ok);
    }
    if dsh.compat_store != 0 {
        ty_fail(tag, "路由级 compat.supportsStore=false 没读到", &ok);
    }
    if dsh.compat_reasoning != 0 {
        ty_fail(tag, "路由级 compat.supportsReasoningEffort=false 没读到", &ok);
    }
    if !dsh.access_set || dsh.access != PERM_WORKSPACE_WRITE {
        ty_fail(tag, "workspace-write 预设应当推出 PERM_WORKSPACE_WRITE", &ok);
    }
    if !ty_buf_is(&dsh.tls_verify, "pin") || !ty_buf_is(&dsh.tls_pin, "abc123") {
        ty_fail(tag, "uya-agent.tls 命名空间没读到", &ok);
    }
    if !ty_buf_is(&dsh.preset_default, "standard") {
        ty_fail(tag, "agent-presets.default 解析错", &ok);
    }

    // YAML 预处理：注释被去掉、块标量里的 # 保留、!!js 被中和成带引号标量
    var ytree: YTree = YTree{ nodes: [], n: 0, lines: [], nlines: 0, raw: buf_empty(), cur: 0, err_line: 0 };
    yt_init(&ytree);
    defer { yt_free(&ytree); }
    if !yt_load_file(&spath.ptr[0] as &const byte, &ytree) {
        ty_fail(tag, "yt_load_file 失败", &ok);
        return ok;
    }
    const r: i32 = yt_root(&ytree);
    const plan: i32 = yt_get(&ytree, r, "plan");
    const pv: &[byte] = yt_str(&ytree, plan);
    if pv.len == 0 || !sess_has_cstr(pv, "# 块标量里的井号必须保留") {
        ty_fail(tag, "块标量里的注释被误删了", &ok);
    }
    const dis: i32 = yt_get(&ytree, r, "disabled_row");
    const dv: &[byte] = yt_str(&ytree, dis);
    if dv.len == 0 || !sess_has_cstr(dv, "process.platform") {
        ty_fail(tag, "!!js 标签没有被中和成标量", &ok);
    }
    if pv.len > 0 && sess_has_cstr(pv, "# 顶层注释") {
        ty_fail(tag, "顶层注释没有被去掉", &ok);
    }

    // 真机 DSH：存在就顺带校验一次（不存在就跳过，保持自测离线）
    const realhome: &byte = getenv("HOME");
    if (realhome as usize) != 0 {
        var rh: Buf = buf_new(1024);
        defer { buf_free(&rh); }
        _ = buf_append_cstr(&rh, realhome);
        _ = buf_append_cstr(&rh, "/.dsh");
        _ = buf_append_byte(&rh, 0);
        var rsettings: Buf = buf_new(1200);
        defer { buf_free(&rsettings); }
        _ = buf_append_cstr(&rsettings, rh.ptr as &const byte);
        _ = buf_append_cstr_z(&rsettings, "/settings.yaml");
        if sess_file_exists(rsettings.ptr as &const byte) {
            var real: DshCfg = dsh_cfg_empty();
            defer { dsh_cfg_free(&real); }
            if dsh_cfg_load(&rh.ptr[0] as &const byte, ".", &real) {
                if real.provider.len == 0 || real.model.len == 0 {
                    ty_fail(tag, "真实 ~/.dsh 里没解析出 provider/model", &ok);
                }
            } else {
                ty_fail(tag, "真实 ~/.dsh/settings.yaml 解析失败", &ok);
            }
        }
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// Buf b 是否恰好等于 C 字面量 lit（长度先比，再逐字节）。
fn ty_buf_is(b: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if b.len != n {
        return false;
    }
    return bufx_mem_eq(b.ptr as &const byte, lit, n);
}

// 文件工具轮的 6 个调用（write 未读→拒 / read 窗口 / write 读后覆盖 / edit 多匹配→拒 /
// edit 成功 / edit 找不到）
fn mock_fs_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-fs");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    mock_call(&w, "fs_1", "write", "{\"file_path\":\"doc.txt\",\"content\":\"x\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_2", "read", "{\"file_path\":\"doc.txt\",\"offset\":2,\"limit\":2}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_3", "write", "{\"file_path\":\"doc.txt\",\"content\":\"alpha one\\nbeta two\\ngamma three\\nbeta four\\ndelta five\\n\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_4", "edit", "{\"file_path\":\"doc.txt\",\"old_string\":\"beta\",\"new_string\":\"BETA\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_5", "edit", "{\"file_path\":\"doc.txt\",\"old_string\":\"alpha\",\"new_string\":\"ALPHA\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_6", "edit", "{\"file_path\":\"doc.txt\",\"old_string\":\"zzz\",\"new_string\":\"y\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_7", "glob", "{\"pattern\":\"*.txt\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_8", "grep", "{\"pattern\":\"beta\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_9", "grep", "{\"pattern\":\"nosuchthingzzz\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_10", "glob", "{\"pattern\":\"*.nomatch\"}");
    jw_byte(&w, 93);       // ] tool_calls
    jw_byte(&w, 125);      // } message
    jw_byte(&w, 44);       // ,   ← finish_reason 属于 choice，不能写到 choices 外面
    jw_key(&w, "finish_reason");
    jw_str_cstr(&w, "tool_calls");
    jw_byte(&w, 125);      // } choice
    jw_byte(&w, 93);       // ] choices
    jw_byte(&w, 125);      // } root
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);   // 必须回填长度，否则发出去的是 0 字节（踩过）
    return true;
}

// 文件工具轮的 workspace 准备：先放一个 doc.txt（内容已知）
fn fs_ws_prepare(ws: &const byte) bool {
    if !ws_prepare(ws) {
        return false;
    }
    var p: Buf = buf_new(256);
    defer { buf_free(&p); }
    _ = buf_append_cstr(&p, ws);
    _ = buf_append_cstr_z(&p, "/doc.txt");
    if !write_text_file(&p.ptr[0] as &const byte, "alpha one\nbeta two\ngamma three\nbeta four\ndelta five\n") {
        return false;
    }
    buf_reset(&p);
    _ = buf_append_cstr(&p, ws);
    _ = buf_append_cstr_z(&p, "/note.txt");
    return write_text_file(&p.ptr[0] as &const byte, "hello-selftest");
}

// 文件工具轮：断言最终落盘内容（write 覆盖 + edit 替换各一次）
