// src/selftest/st_goal_idle.uya — P122：连续零产出轮次的刹车
//
// 本文件：`goal-idle` 轮 —— 判据（`goal_round_progressed`）与计数（`goal_idle_note`）。
// 不变量：只有 `goal_round_progressed` 说「这一轮没产出」才累加计数，
//   计数到达闸值就停自动续跑；判据起点永远是开轮前的 `h.len`（错一位就失效）。
//
// 为什么要独立一轮、且用**合成历史**：真跑一轮零产出需要 mock 服务器 + 一次
// `max-tokens` 截断，而这条判据的全部内容就是「看这一轮追加了哪几条消息」——
// 合成历史是它最直接的输入。反过来说，**必须**有一腿走真实的历史 API
// （`hist_push` / `msg_at`），否则「起点 `from` = 开轮前的 h.len」这条边界
// 会与真实用法分叉（真实现场：起点错一位，`<goal_round>` 那条注入消息就被
// 数成产出，刹车永远不响）。
//
// 现场（session-c7f98113）：30 来轮全是 `user(<goal_round>)` →
// `assistant(content="")` → `turn/end max-tokens`，一个字没写、一个工具没调，
// 而驱动器认为「截断不是异常」，于是一圈一圈地重发同一份 716K 提示词。
//
// 依赖：见锚点 selftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：本文件私有小工具统一 `gid_` 前缀，轮次入口 `goal_idle_round`。

// 往历史里压一条纯文本消息（长度用 strlen 量，cstr 字面量没有尾 NUL 语义）。
fn gid_push(h: &History, role: u8, text: &const byte) void {
    _ = hist_push(h, role, text, bufx_cstr_len(text));
}

// `goal-idle` 轮：用合成历史走一遍「连续零产出轮次刹车」的全部判据，
// 外带一条走真实 `hist_push` 的腿（起点 off-by-one 就只能靠它抓）。
fn goal_idle_round(tag: &const byte) bool {
    var ok: bool = true;
    // ---- A) 判据：这一轮追加的消息里有没有**实质产出** ----
    var h: History = hist_init();
    defer { hist_free(&h); }
    gid_push(&h, ROLE_SYSTEM, "sys" as &const byte);
    gid_push(&h, ROLE_USER, "<goal_round> Round: 1/256" as &const byte);
    const base: usize = h.len;              // 开轮前拍的起点（真实用法同此）
    if goal_round_progressed(&h, base) {
        ty_fail(tag, "只有 <goal_round> 一条 user 也算有产出", &ok);
    }
    // A2：现场那 30 轮的形状 —— 一条 content 为空的 assistant（**真的**压在历史里，
    // 不是「没压进去所以看起来为零产出」）。按「历史变长」算的话这里简直像干活了，
    // 判据必须按**正文长度**：`hist_push` 拒收空正文，所以这里走 `hist_push_msg`。
    _ = hist_push_msg(&h, ROLE_ASSISTANT, null, 0, null, 0);
    if goal_round_progressed(&h, base) {
        ty_fail(tag, "空的 assistant 消息被算成产出（现场那种截断）", &ok);
    }
    // A3：正文一个字节就算往前走。
    const ok_from: usize = h.len;
    gid_push(&h, ROLE_ASSISTANT, "改好了" as &const byte);
    if !goal_round_progressed(&h, ok_from) {
        ty_fail(tag, "有正文的 assistant 没被算成产出", &ok);
    }
    // 起点之后的窗口是**半开**的：正文之前的部分不算，之后的部分才算。
    if goal_round_progressed(&h, h.len) {
        ty_fail(tag, "窗口为空（from == len）却报了产出", &ok);
    }
    // A4：正文为空但有工具调用 / 工具结果 —— 仍然是在干活。
    const calls_from: usize = h.len;
    _ = hist_push_msg(&h, ROLE_ASSISTANT_CALLS, null, 0,
        "[]" as &const byte, 2);
    if !goal_round_progressed(&h, calls_from) {
        ty_fail(tag, "工具调用没被算成产出", &ok);
    }
    const tool_from: usize = h.len;
    _ = hist_push_msg(&h, ROLE_TOOL, "ok" as &const byte, 2,
        "call_1" as &const byte, 6);
    if !goal_round_progressed(&h, tool_from) {
        ty_fail(tag, "工具结果没被算成产出", &ok);
    }
    // A5：起点超过长度（一轮里被压缩过，历史变短）⇒ 不崩、不算产出。
    if goal_round_progressed(&h, h.len + 7) {
        ty_fail(tag, "起点越界时报了产出", &ok);
    }

    // ---- B) 计数：连续几轮才停 ----
    g_goal_idle_rounds = 0;
    if goal_idle_note(true) {
        ty_fail(tag, "有产出的一轮被刹停", &ok);
    }
    if goal_idle_note(false) {
        ty_fail(tag, "第一轮零产出就刹停（P59 允许一轮截断）", &ok);
    }
    if !goal_idle_note(false) {
        ty_fail(tag, "连续两轮零产出没有刹停", &ok);
    }
    if g_goal_idle_rounds != GOAL_IDLE_STOP {
        ty_fail(tag, "零产出轮数越过阈值后还在涨", &ok);
    }
    if !goal_idle_note(false) {
        ty_fail(tag, "已经该停之后又报「继续跑」", &ok);
    }
    // B2：中间夹一次有产出 ⇒ 重新开始数（不是「累计」）。
    if goal_idle_note(true) {
        ty_fail(tag, "清零那一轮被刹停", &ok);
    }
    if g_goal_idle_rounds != 0 {
        ty_fail(tag, "有产出之后零产出计数没清零", &ok);
    }
    _ = goal_idle_note(false);
    _ = goal_idle_note(true);
    if goal_idle_note(false) {
        ty_fail(tag, "中间有产出的两轮零产出被累计成刹停", &ok);
    }

    // ---- C) 真实收口：`goal_disarm` 要把这笔账清掉 ----
    // 不然「上回数到 1」会跟着下一次 resume 过继过来，一轮就刹停。
    // 这里没有目标文件（agent_home 是夹具目录）：`goal_disarm` 只做本地收口，
    // 正是要断言「本地那一位也清了」。
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.agent_home = buf_new(96);
    _ = buf_append_cstr(&cfg.agent_home,
        "build/selftest_goal_idle_home" as &const byte);
    _ = sess_mkdir_p(cfg.agent_home.ptr as &const byte);
    g_goal_idle_rounds = 1;
    goal_disarm(&cfg);
    if g_goal_idle_rounds != 0 {
        ty_fail(tag, "goal_disarm 之后零产出计数没清", &ok);
    }
    if g_goal_armed {
        ty_fail(tag, "goal_disarm 之后本地授权还开着", &ok);
    }
    if ok {
        out_err("selftest[goal-idle] ok（本轮窗口判据 + 连续 2 轮零产出刹车）\n");
    }
    return ok;
}
