// src/selftest/st_async_turn.uya — P99b/P100：流式 LLM 请求走事件循环（`src/net/allm.uya`）
//
// 本文件：`async-sse` 轮。它钉两件事：**同一条 SSE 流，同步与异步两条路给出同一个
// `ChatOut`**；以及**流式期间置取消意图能当场收口**（同步版靠泵点看 esc，异步版靠
// rt 的取消闸门 —— 判据必须落在同一个错误码 `error.LlmInterrupted` 上）。
//
// 判据（每条都配「拆掉什么会当场红」）：
//   A 同步 `llm_stream_chat` 与异步 `allm_stream_chat` 对同一份 SSE 文本：
//     `content` / `finish` / `saw_done` / `usage_in` / `usage_out` /
//     `usage_cache_read` / `usage_reasoning` / `ncalls` **全部逐项相同**
//     （把 async 路的解析换掉 ⇒ 任意一项红）；
//   B 非 2xx：mock 回 401 + JSON 体，两条路都拿到 401，且 `err_text` 前段相同
//     （丢掉 `err_text` 收集 ⇒ 红）；
//   C 慢流 + 取消：mock 每 80 ms 发一帧，第 3 帧时置取消意图 ⇒ `error.LlmInterrupted`
//     且 ≤800 ms 收口（去掉 rt 的取消闸门 ⇒ 会等满整条流）。
//
// 不变量：① mock 在子进程里跑（`sys_fork`），每个用例一条连接、一条新端口；
//   ② 比较的是 `ChatOut` 的**字段值**，不是「看起来对」；③ 取消用例之后必须
//   `rt_abort_reset()`（否则后面的轮全被意图打断）。
//
// 依赖：src/net/llm.uya（`llm_stream_chat` / `ChatOut`）、src/net/allm.uya
//   （`allm_stream_chat`）、src/rt/rtloop.uya、libc.syscall（socket / fork）。
// 命名：`aturn_*`（用例与 mock）、`g_aturn_*`（结果位）、`async_turn_round`。

// mock 回什么：0 = 正常 SSE，1 = 401 + JSON 体，2 = 慢流（每帧之间 80 ms）。
var g_aturn_mode: i32 = 0;

// 一份两帧的 chat SSE 文本（含 usage 与 [DONE]）。
// 行宽豁免：SSE 帧是**协议报文**，拆开就等于改协议（`data: ` 前缀与空行都是判据）。
fn aturn_sse_text(out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "data: {\"choices\":[{\"delta\":{\"role\":\"assistant\"}}]}\n\n") {
        return false;
    }
    if !buf_append_cstr(out,
        "data: {\"choices\":[{\"delta\":{\"content\":\"Hello\"},\"finish_reason\":null}]}\n\n") {
        return false;
    }
    if !buf_append_cstr(out,
        "data: {\"choices\":[{\"delta\":{\"content\":\", Uya!\"},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":60,\"completion_tokens\":7,\"prompt_tokens_details\":{\"cached_tokens\":40},\"completion_tokens_details\":{\"reasoning_tokens\":3}}}\n\n") {
        return false;
    }
    if !buf_append_cstr(out, "data: [DONE]\n\n") {
        return false;
    }
    return true;
}

// 401 体（排障线索：错误正文必须被收进 err_text）。
// 行宽豁免：HTTP 响应头是协议报文（同上）。
fn aturn_401_text(out: &Buf) bool {
    buf_reset(out);
    buf_append_cstr(out, "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\n")
        || true;
    if !buf_append_cstr(out, "Content-Length: 26\r\nConnection: close\r\n\r\n") {
        return false;
    }
    return buf_append_cstr(out, "{\"error\":\"invalid api key\"}");
}

// 写满一段（`https_write_all` 是 `!void`，这里折成 bool 便于早退）。
fn aturn_write(cfd: i32, p: &const byte, n: usize) bool {
    const w: !void = https_write_all(cfd, p, n);
    _ = w catch {
        return false;
    };
    return true;
}

// 读掉请求头（读到 \r\n\r\n），再回响应。
fn aturn_read_head(cfd: i32) bool {
    var tmp: [byte: 4096] = [0: 4096];
    var seen: usize = 0;
    while seen < 65536 {
        const n: isize = sys_read(cfd, &tmp[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            return false;
        }
        var i: usize = 0;
        while i + 3 < (n as usize) {
            if tmp[i] == 13 && tmp[i + 1] == 10 &&
                tmp[i + 2] == 13 && tmp[i + 3] == 10 {
                return true;
            }
            i = i + 1;
        }
        seen = seen + (n as usize);
    }
    return false;
}

// 毫秒睡眠（子进程用）。
fn aturn_msleep(ms: u32) void {
    var req: TimeSpec = TimeSpec{
        tv_sec: (ms as i64) / (1000 as i64),
        tv_nsec: (((ms as i64) % (1000 as i64)) * (1000000 as i64)),
    };
    var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_nanosleep(&req, &rem) catch {};
}

// 服务端一回合。mode 见 `g_aturn_mode`。
fn aturn_serve(cfd: i32, mode: i32) i32 {
    if !aturn_read_head(cfd) {
        return 51;
    }
    var head: Buf = buf_new(512);
    defer { buf_free(&head); }
    if mode == 1 {
        var body: Buf = buf_new(128);
        defer { buf_free(&body); }
        if !aturn_401_text(&body) {
            return 52;
        }
        if !aturn_write(cfd, body.ptr as &const byte, body.len) {
            return 53;
        }
        return 0;
    }
    var text: Buf = buf_new(4096);
    defer { buf_free(&text); }
    if !aturn_sse_text(&text) {
        return 54;
    }
    var wire: Buf = buf_new(8192);
    defer { buf_free(&wire); }
    if mode == 2 {
        // 慢流：一条一条发（每帧一帧 payload + 空行），帧间 80 ms
        // 行宽豁免：每一条都是一个完整的 SSE 帧（逐字节比对的对象）。
        const frames: [&const byte: 5] = [
            "data: {\"choices\":[{\"delta\":{\"content\":\"a\"}}]}\n\n",
            "data: {\"choices\":[{\"delta\":{\"content\":\"b\"}}]}\n\n",
            "data: {\"choices\":[{\"delta\":{\"content\":\"c\"}}]}\n\n",
            "data: {\"choices\":[{\"delta\":{\"content\":\"d\"}}]}\n\n",
            "data: [DONE]\n\n",
        ];
        _ = buf_append_cstr(&head,
            "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nConnection: close\r\n\r\n");
        if !aturn_write(cfd, head.ptr as &const byte, head.len) {
            return 55;
        }
        var i: usize = 0;
        while i < 5 {
            const s: &const byte = frames[i];
            const n: usize = bufx_cstr_len(s);
            if !aturn_write(cfd, s, n) {
                return 56;
            }
            aturn_msleep(80);
            i = i + 1;
        }
        return 0;
    }
    // 正常：整份 body 一次写完（Content-Length 定长，最简单的一条路径）
    _ = buf_append_cstr(&head,
        "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\n");
    _ = buf_append_cstr(&head, "Content-Length: ");
    _ = buf_append_u64(&head, text.len as u64);
    _ = buf_append_cstr(&head, "\r\nConnection: close\r\n\r\n");
    _ = buf_append(&wire, &head.ptr[0], head.len);
    _ = buf_append(&wire, &text.ptr[0], text.len);
    if !aturn_write(cfd, wire.ptr as &const byte, wire.len) {
        return 57;
    }
    return 0;
}

// 起服务端（一条连接），返回端口（0 = 失败）。
fn aturn_spawn(mode: i32) u16 {
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return 0 as u16;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR,
        &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    const br: !i32 = sys_bind(lfd, &addr[0] as &void, 16 as u32);
    _ = br catch {
        _ = sys_close(lfd) catch {};
        return 0 as u16;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return 0 as u16;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return 0 as u16;
    };
    const port: u16 = (((got[2] as u16) as u16) << (8 as i32)) |
        (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return 0 as u16;
    };
    if pid64 == 0 {
        var peer: [byte: 16] = [0: 16];
        var plen: u32 = 16;
        const c: i32 = sys_accept(lfd, &peer[0] as &void, &plen) catch {
            0 - 1;
        };
        var rc: i32 = 60;
        if c >= 0 {
            rc = aturn_serve(c, mode);
            _ = sys_close(c) catch {};
        }
        _ = sys_close(lfd) catch {};
        sys_exit(rc);
    }
    _ = sys_close(lfd) catch {};
    return port;
}

// 拼一个 chat/completions URL。
fn aturn_url(port: u16, out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, "http://127.0.0.1:");
    _ = buf_append_u64(out, port as u64);
    _ = buf_append_cstr(out, "/v1/chat/completions");
}

// 同步路调一次（与 `sse_call` 同参数，只为了在本文件里自足）。
fn aturn_sync_call(url: &[byte], hdrs: &[byte], body: &const Buf, o: &ChatOut) i32 {
    var empty_pin: [byte: 0] = [];
    const res: !i32 = llm_stream_chat(url, hdrs,
        body.ptr as &const byte, body.len, 15000 as u32, 262144 as usize,
        HC_VERIFY_NONE, &empty_pin[0: 0], o, false, false, false);
    const status: i32 = res catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        if eid == (@error_id(error.LlmInterrupted) as! i32).value {
            0 - 1;
        } else {
            0 - 2;
        }
    };
    return status;
}

// 异步路调一次。
@async_fn fn aturn_async_call_run(
    url: &[byte],
    hdrs: &[byte],
    body: &const Buf,
    o: &ChatOut,
    status_out: &i32,
    eid_out: &i32
) Future<!i32> {
    status_out[0] = 0;
    eid_out[0] = 0;
    var empty_pin: [byte: 0] = [];
    const res: !i32 = @await allm_stream_chat(url, hdrs,
        body.ptr as &const byte, body.len, 15000 as u32, 262144 as usize,
        HC_VERIFY_NONE, &empty_pin[0: 0], o, false, false, false,
        status_out);
    const got: i32 = res catch |err| {
        eid_out[0] = (@error_id(err) as! i32).value;
        0 - 1;
    };
    return got;
}

// 两条路的 ChatOut 是否逐项相同；不同就把差异打到 stderr（便于定位）。
fn aturn_same_out(a: &const ChatOut, b: &const ChatOut, ok: &bool, tag: &const byte) void {
    if a.content.len != b.content.len ||
        !bufx_mem_eq(a.content.ptr as &const byte, b.content.ptr as &const byte,
            a.content.len) {
        ty_fail(tag, "content 不是逐字节相同", ok);
    }
    if a.finish != b.finish {
        ty_fail(tag, "finish 不一致", ok);
    }
    if a.saw_done != b.saw_done {
        ty_fail(tag, "saw_done 不一致", ok);
    }
    if a.usage_in != b.usage_in || a.usage_out != b.usage_out {
        ty_fail(tag, "usage_in/out 不一致", ok);
    }
    if a.usage_cache_read != b.usage_cache_read ||
        a.usage_reasoning != b.usage_reasoning {
        ty_fail(tag, "usage_cache_read/reasoning 不一致", ok);
    }
    if a.ncalls != b.ncalls {
        ty_fail(tag, "ncalls 不一致", ok);
    }
}

// 取消探针：第 3 帧置取消意图（模拟流式中途按 esc）。
struct AturnAbortFrame : RtFrame {
    hits: i64,
    fn rt_frame(self: &Self, now_ms: u64) void {
        _ = now_ms;
        self.hits = self.hits + 1;
        if self.hits >= 3 {
            rt_abort(RT_ABORT_TURN);
        }
    }
}

var g_aturn_abort: AturnAbortFrame = AturnAbortFrame{ hits: 0 };
var g_aturn_abort_i: RtFrame = g_aturn_abort;

// 用例 A：同步与异步对同一份 SSE 给出同一个 ChatOut。
fn aturn_case_same(tag: &const byte, ok: &bool) void {
    var hdrs: Buf = buf_new(128);
    defer { buf_free(&hdrs); }
    _ = buf_append_cstr(&hdrs,
        "Content-Type: application/json\r\nAccept: text/event-stream\r\n" as &const byte);
    var body: Buf = buf_new(128);
    defer { buf_free(&body); }
    _ = buf_append_cstr(&body,
        "{\"model\":\"selftest-model\",\"stream\":true,\"messages\":[]}" as &const byte);
    var url: Buf = buf_new(128);
    defer { buf_free(&url); }

    // 同步那条：自己一个服务端（一条连接）
    const p1: u16 = aturn_spawn(0);
    if p1 == 0 {
        ty_fail(tag, "起服务端失败（同步）", ok);
        return;
    }
    aturn_url(p1, &url);
    var s_o: ChatOut = chat_out_new();
    defer { chat_out_free(&s_o); }
    const s_status: i32 = aturn_sync_call(url.ptr[0: url.len],
        hdrs.ptr[0: hdrs.len], &body, &s_o);

    // 异步那条：另一个服务端（一条连接）
    const p2: u16 = aturn_spawn(0);
    if p2 == 0 {
        ty_fail(tag, "起服务端失败（异步）", ok);
        return;
    }
    aturn_url(p2, &url);
    var a_o: ChatOut = chat_out_new();
    defer { chat_out_free(&a_o); }
    var a_status: i32 = 0;
    var a_eid: i32 = 0;
    rt_frame_clear();
    rt_abort_reset();
    const rc: i32 = rt_run(aturn_async_call_run(url.ptr[0: url.len],
        hdrs.ptr[0: hdrs.len], &body, &a_o, &a_status, &a_eid));
    _ = rc;
    if a_eid != 0 {
        ty_fail(tag, "异步路返回了错误（eid 非 0）", ok);
    }
    if s_status != 200 || a_status != 200 {
        ty_fail(tag, "两条路的状态码都不该不是 200", ok);
    }
    aturn_same_out(&s_o, &a_o, ok, tag);
    // 内容本身也要对（防「两条路一起错」）
    if !bufx_mem_eq(s_o.content.ptr as &const byte,
        "Hello, Uya!" as &const byte, 11) {
        ty_fail(tag, "同步路的 content 不对（判据自身先错了）", ok);
    }
    // `usage_in` 的口径是「**非缓存**的输入 token」（缓存命中单独记在
    // `usage_cache_read`）：mock 报 prompt_tokens=60、cached=40 ⇒ 这里应当是 20。
    // 这条断言的价值就在于把口径钉死：换成 60 就是「两条路一起错」也会绿。
    if s_o.usage_in != 20 || s_o.usage_out != 7 ||
        s_o.usage_cache_read != 40 || s_o.usage_reasoning != 3 {
        ty_fail(tag, "同步路的 usage 不对（判据自身先错了）", ok);
    }
    if !s_o.saw_done || s_o.finish != LLM_FINISH_STOP {
        ty_fail(tag, "同步路的 telltale（saw_done/finish）不对", ok);
    }
}

// 用例 B：401 的正文必须被收进 err_text（两条路都要）。
fn aturn_case_401(tag: &const byte, ok: &bool) void {
    var hdrs: Buf = buf_new(128);
    defer { buf_free(&hdrs); }
    _ = buf_append_cstr(&hdrs,
        "Content-Type: application/json\r\nAccept: text/event-stream\r\n" as &const byte);
    var body: Buf = buf_new(128);
    defer { buf_free(&body); }
    _ = buf_append_cstr(&body,
        "{\"model\":\"selftest-model\",\"stream\":true,\"messages\":[]}" as &const byte);
    var url: Buf = buf_new(128);
    defer { buf_free(&url); }

    const p1: u16 = aturn_spawn(1);
    if p1 == 0 {
        ty_fail(tag, "起服务端失败（401 同步）", ok);
        return;
    }
    aturn_url(p1, &url);
    var s_o: ChatOut = chat_out_new();
    defer { chat_out_free(&s_o); }
    const s_status: i32 = aturn_sync_call(url.ptr[0: url.len],
        hdrs.ptr[0: hdrs.len], &body, &s_o);

    const p2: u16 = aturn_spawn(1);
    if p2 == 0 {
        ty_fail(tag, "起服务端失败（401 异步）", ok);
        return;
    }
    aturn_url(p2, &url);
    var a_o: ChatOut = chat_out_new();
    defer { chat_out_free(&a_o); }
    var a_status: i32 = 0;
    var a_eid: i32 = 0;
    rt_frame_clear();
    rt_abort_reset();
    const rc: i32 = rt_run(aturn_async_call_run(url.ptr[0: url.len],
        hdrs.ptr[0: hdrs.len], &body, &a_o, &a_status, &a_eid));
    _ = rc;
    if s_status != 401 || a_status != 401 {
        ty_fail(tag, "401 时两条路的状态码应当都是 401", ok);
    }
    if s_o.err_text.len == 0 || a_o.err_text.len == 0 {
        ty_fail(tag, "401 的错误正文没有收进 err_text（排障线索丢了）", ok);
    }
    if s_o.err_text.len != a_o.err_text.len ||
        !bufx_mem_eq(s_o.err_text.ptr as &const byte,
            a_o.err_text.ptr as &const byte, s_o.err_text.len) {
        ty_fail(tag, "401 的 err_text 两条路不一致", ok);
    }
}

// 用例 C：慢流 + 取消 ⇒ error.LlmInterrupted 且很快收口。
fn aturn_case_cancel(tag: &const byte, ok: &bool) void {
    var hdrs: Buf = buf_new(128);
    defer { buf_free(&hdrs); }
    _ = buf_append_cstr(&hdrs,
        "Content-Type: application/json\r\nAccept: text/event-stream\r\n" as &const byte);
    var body: Buf = buf_new(128);
    defer { buf_free(&body); }
    _ = buf_append_cstr(&body,
        "{\"model\":\"selftest-model\",\"stream\":true,\"messages\":[]}" as &const byte);
    var url: Buf = buf_new(128);
    defer { buf_free(&url); }
    const p: u16 = aturn_spawn(2);
    if p == 0 {
        ty_fail(tag, "起服务端失败（慢流）", ok);
        return;
    }
    aturn_url(p, &url);
    var a_o: ChatOut = chat_out_new();
    defer { chat_out_free(&a_o); }
    var a_status: i32 = 0;
    var a_eid: i32 = 0;
    g_aturn_abort.hits = 0;
    rt_set_frame(g_aturn_abort_i);
    rt_abort_reset();
    const t0: u64 = ua_now_ms();
    const rc: i32 = rt_run(aturn_async_call_run(url.ptr[0: url.len],
        hdrs.ptr[0: hdrs.len], &body, &a_o, &a_status, &a_eid));
    const dt: u64 = ua_now_ms() - t0;
    rt_frame_clear();
    rt_abort_reset();
    _ = rc;
    const want: i32 = (@error_id(error.LlmInterrupted) as! i32).value;
    if a_eid != want {
        ty_fail(tag, "流式期间取消没有折成 error.LlmInterrupted", ok);
        out_err("  debug: eid=");
        out_err_dec(a_eid as usize);
        out_err(" want=");
        out_err_dec(want as usize);
        out_err("\n");
    }
    if dt > (900 as u64) {
        ty_fail(tag, "取消收口太慢（慢流共 400ms+，应当 ≤900ms 且明显提前）", ok);
    }
    if a_o.saw_done {
        ty_fail(tag, "取消之后不该看到 [DONE]", ok);
    }
}

// 轮入口：async-sse。
fn async_turn_round(tag: &const byte) bool {
    var ok: bool = true;
    rt_frame_clear();
    rt_abort_reset();
    aturn_case_same(tag, &ok);
    aturn_case_401(tag, &ok);
    aturn_case_cancel(tag, &ok);
    rt_frame_clear();
    rt_abort_reset();
    if !ok {
        return false;
    }
    out_err("selftest[");
    out_err(tag);
    out_err("] ok: 同步/异步同一 ChatOut + 401 正文 + 慢流可取消\n");
    return true;
}
