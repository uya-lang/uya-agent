// src/selftest/tuis_sessions_big.uya — tuiselftest.uya 的拆分片 6/7（纯搬移）
//
// 本文件：tui-sessions-big（踩坑 68）：大列表浮层的**取行**与**成帧预算*；tui-switch（P39）：**运行时换会话** —— 旧会话的正文必须从屏幕上消失；tui-caret（修复，踩坑 66）：运行中输入行的光标；tui-full（P53）：浮层全屏；tui-md（P47）：markdown 渲染
// 不变量：与原文件一致 —— 拆分只搬移，不改任何声明的代码；同族轮/段集中在一片里。
// 依赖：见锚点 tuiselftest.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：沿用原文件前缀（本片是同一历史模块的内部拆分）。

// ============================================================
// tui-sessions-big（踩坑 68）：大列表浮层的**取行**与**成帧预算**
// ============================================================
// 现场（用户报的「session 选择框显示后很卡」）：`tui_ov_line_at()` 为取第 i 行**从缓冲区
// 第 0 字节重新扫一遍**，而 tui_draw_overlay() 每画一行都要从第 0 项数到目标项 ——
// 画一屏于是是 O(可见行数 × n²) 字节步。真机 842 个会话、底部按一次 ↑ 实测 1.2–1.6 s
// （顶上只要 85 ms：要跨的项少 —— 这一对数字就是根因的判据）。
//
// 修法：条目缓冲区每次重写时**一次性**建出行偏移表（O(n)），取行变 O(1)；过滤器为空时
// 「第 fi 个通过过滤的项」直接就是第 fi 项，连数一遍都不用。
//
// 这一轮盯三件事（都绕开索引层，直接喂条目给浮层，单测浮层本身）：
//   1) 行偏移表正确：第 0 / 中间 / 末项的字节区间与预期的条目文本逐字节相同；
//   2) 浮层语义没变：g_tui_ov_n、默认游标、home/end、↑/↓ 之后选中项与窗口自洽；
//   3) 成帧预算：2000 项时「一帧 + 若干次方向键」必须在 1 s 内完成（未修版本这里 ~7 s）。

const TUIS_SESSBIG_N: usize = 2000;
const TUIS_SESSBIG_FRAME_MAX_MS: u64 = 1000;   // 2000 项一次成帧 + 按键的墙钟上限

// 造 n 条条目（每行「TITLE <k> | /w/<k> | session-<8 位十六进制>-...」），写进 out
fn tuis_sessbig_items(n: usize, out: &Buf) void {
    buf_reset(out);
    var i: usize = 0;
    while i < n {
        _ = buf_append_cstr(out, "TITLE ");
        _ = buf_append_u64(out, i as u64);
        _ = buf_append_cstr(out, "   /w/");
        _ = buf_append_u64(out, i as u64);
        _ = buf_append_cstr(out, "   session-");
        var hex: Buf = buf_new(32);
        defer { buf_free(&hex); }
        _ = buf_append_u64(&hex, i as u64);
        var pad: usize = hex.len;
        while pad < 8 {
            _ = buf_append_byte(out, 48);   // '0'
            pad = pad + 1;
        }
        _ = buf_append(out, hex.ptr, hex.len);
        _ = buf_append_cstr(out, "-1111-4111-8111-111111111111\n");
        i = i + 1;
    }
}

// 第 k 条条目的预期文本（与 tuis_sessbig_items 同一份拼法），用于比对区间
fn tuis_sessbig_expect(k: usize, out: &Buf) void {
    var hex: Buf = buf_new(32);
    defer { buf_free(&hex); }
    _ = buf_append_u64(&hex, k as u64);
    var pad: usize = hex.len;
    buf_reset(out);
    _ = buf_append_cstr(out, "TITLE ");
    _ = buf_append_u64(out, k as u64);
    _ = buf_append_cstr(out, "   /w/");
    _ = buf_append_u64(out, k as u64);
    _ = buf_append_cstr(out, "   session-");
    while pad < 8 {
        _ = buf_append_byte(out, 48);
        pad = pad + 1;
    }
    _ = buf_append(out, hex.ptr, hex.len);
    _ = buf_append_cstr(out, "-1111-4111-8111-111111111111");
}

// 取浮层第 i 项并与预期比对（返回 false = 不一致，why 里写明原因）
fn tuis_sessbig_check_item(i: usize, why: &Buf) bool {
    var o: usize = 0;
    var l: usize = 0;
    if !tui_overlay_item_span(i, &o, &l) {
        buf_reset(why);
        _ = buf_append_cstr(why, "取不到第 ");
        _ = buf_append_u64(why, i as u64);
        _ = buf_append_cstr(why, " 项");
        return false;
    }
    var want: Buf = buf_new(128);
    defer { buf_free(&want); }
    tuis_sessbig_expect(i, &want);
    var got: Buf = buf_new(128);
    defer { buf_free(&got); }
    _ = buf_append(&got, tui_overlay_item_ptr() + o, l);
    if got.len != want.len {
        buf_reset(why);
        _ = buf_append_cstr(why, "第 ");
        _ = buf_append_u64(why, i as u64);
        _ = buf_append_cstr(why, " 项长度不对");
        return false;
    }
    if !bufx_mem_eq(got.ptr as &const byte, want.ptr as &const byte, want.len) {
        buf_reset(why);
        _ = buf_append_cstr(why, "第 ");
        _ = buf_append_u64(why, i as u64);
        _ = buf_append_cstr(why, " 项文本不对（行偏移表算错了？）");
        return false;
    }
    return true;
}

// tui-sessions-big 轮（踩坑 68 的 TUI 侧）：大索引（TUIS_SESSBIG_N 条）下列表仍要跟手、
// 排序确定、选中切换正确。返回 false = 本轮红。
fn tui_sessions_big_round(tag: &const byte) bool {
    var ok: bool = true;
    var items: Buf = buf_new(1 << 20);
    defer { buf_free(&items); }
    tuis_sessbig_items(TUIS_SESSBIG_N, &items);

    tuis_reset(100, 30);
    tui_reset_all();
    tuis_reset(100, 30);      // tui_reset_all 会清浮层状态，尺寸再钉一次
    tui_overlay_list_wide(TUI_OVK_SESSIONS, "big" as &const byte, bufx_cstr_len("big" as &const byte),
        items.ptr as &const byte, items.len, 0);

    // ---- 1) 项数 + 默认游标（列表型默认停在 0；/sessions 那条腿才置到最后一项）----
    if tui_overlay_item_count() != TUIS_SESSBIG_N {
        tuis_fail(tag, "浮层条目数与喂进去的不一致", &ok);
        tuis_puts("  实际 = ");
        tuis_num(tui_overlay_item_count());
        tuis_puts("\n");
    }

    // ---- 2) 行区间：第 0 / 中间 / 末项逐字节比对 ----
    var why: Buf = buf_new(160);
    defer { buf_free(&why); }
    const probes: [usize: 3] = [0, TUIS_SESSBIG_N / 2, TUIS_SESSBIG_N - 1];
    var pi: usize = 0;
    while pi < 3 {
        if !tuis_sessbig_check_item(probes[pi], &why) {
            tuis_fail(tag, "大列表取行不对", &ok);
            tuis_puts("  ");
            tuis_puts(why.ptr as &const byte);
            tuis_puts("\n");
        }
        pi = pi + 1;
    }

    // ---- 3) 键盘语义：end 到末项、home 回 0、↑/↓ 各走一步，选中项文本跟着对 ----
    tui_keys_inject("\x1b[F" as &const byte, 3);    // end
    if tui_overlay_sel_index() != TUIS_SESSBIG_N - 1 {
        tuis_fail(tag, "end 之后游标不在末项", &ok);
    }
    tui_keys_inject("\x1b[H" as &const byte, 3);    // home
    if tui_overlay_sel_index() != 0 {
        tuis_fail(tag, "home 之后游标不在首项", &ok);
    }
    tui_keys_inject("\x1b[B" as &const byte, 3);    // ↓
    if tui_overlay_sel_index() != 1 {
        tuis_fail(tag, "↓ 之后游标不在第 2 项", &ok);
    }
    tui_keys_inject("\x1b[A" as &const byte, 3);    // ↑
    if tui_overlay_sel_index() != 0 {
        tuis_fail(tag, "↑ 之后游标没回到首项", &ok);
    }
    // 游标拨到中间：选中项取出来的文本必须是**中间那条**（守卫一并验过）
    tui_overlay_sel_set(TUIS_SESSBIG_N / 2);
    if tui_overlay_sel_index() != TUIS_SESSBIG_N / 2 {
        tuis_fail(tag, "sel_set 没有把游标放到中间项", &ok);
    }
    if !tuis_sessbig_check_item(TUIS_SESSBIG_N / 2, &why) {
        tuis_fail(tag, "中间项文本不对", &ok);
        tuis_puts("  ");
        tuis_puts(why.ptr as &const byte);
        tuis_puts("\n");
    }

    // ---- 4) 成帧预算：游标钉在末项（= 旧实现最坏情况，要跨 n 项），量一帧 + 若干按键 ----
    // 钉到末项：旧实现每画一行都要从第 0 项数到 fi。这里盯的是**画一屏不再随 n 变慢**。
    // ⚠ 这个预算单独看**抓不住**「取行退回线性扫描」：过滤器为空时序号就是项号，
    // 一屏只取十几行、每行扫一遍缓冲区，2000 项也就百来微秒。要钉「取行是不是 O(1)」
    // 得看下面第 5 条（reader）与第 6 条（行偏移表是否真的建起来了）。
    tui_overlay_sel_set(TUIS_SESSBIG_N - 1);
    const t0: u64 = ua_now_ms();
    tui_build();                                  // 一帧
    var f: i32 = 0;
    while f < 5 {
        tui_keys_inject("\x1b[A" as &const byte, 3);   // 上移 5 次，每次都重画一帧
        tui_build();
        f = f + 1;
    }
    const dt: u64 = ua_now_ms() - t0;
    if dt > TUIS_SESSBIG_FRAME_MAX_MS {
        tuis_fail(tag, "大列表成帧太慢", &ok);
        tuis_puts("  实测 ms = ");
        tuis_num(dt as usize);
        tuis_puts("  上限 = ");
        tuis_num(TUIS_SESSBIG_FRAME_MAX_MS as usize);
        tuis_puts("\n");
    }
    // 成帧本身的不变量：正文层不能出 ESC / NUL（偏移表算错最容易在这里翻车）
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("TITLE" as &const byte) {
        tuis_fail(tag, "大列表成帧之后屏幕上一条条目都看不到", &ok);
    }
    // ---- 4b) 行偏移表：差分对照 + 规模不变量 ----
    // (a) 表真的建起来了，且行数与条目数一致；
    // (b) **差分对照**：同一个 i，查表路径与老实现（线性扫描）给出的区间逐字节相同。
    //     只验结果的话，「表没被用上」（退回扫描）也会绿 —— 这一条把两条路径摆在一起比。
    if !tui_overlay_items_indexed() {
        tuis_fail(tag, "条目行偏移表没有建起来（取行会退回线性扫描）", &ok);
    }
    var ix_bad: bool = false;
    var ix_probe: [usize: 5] = [0, 1, TUIS_SESSBIG_N / 2, TUIS_SESSBIG_N - 2, TUIS_SESSBIG_N - 1];
    var ip: usize = 0;
    while ip < 5 {
        const k: usize = ix_probe[ip];
        var o1: usize = 0;
        var l1: usize = 0;
        var o2: usize = 0;
        var l2: usize = 0;
        const have1: bool = tui_overlay_item_span(k, &o1, &l1);
        const have2: bool = tui_overlay_lin_span(k, &o2, &l2);
        if have1 != have2 || o1 != o2 || l1 != l2 {
            ix_bad = true;
        }
        ip = ip + 1;
    }
    if ix_bad {
        tuis_fail(tag, "行偏移表与线性扫描给出的区间不一致（表算错了）", &ok);
    }
    // (c) 规模不变量：同一台机器上，取第 0 项与取第 n-1 项各 2000 次，两者的总耗时不
    //     该有数量级差别 —— 查表是 O(1)，线性扫描则是 O(n)（末项要扫完整份缓冲区）。
    // (c) 规模不变量：**自校准**对比「查表路径 vs 线性扫描路径」在**末项**上的耗时。
    //     末项是两者的分水岭：查表 O(1)（一次减法），线性扫描要把整份缓冲区扫一遍（O(n)）。
    //     同一台机器、同一份缓冲区、同一个 i，比值就是「取行是不是 O(1)」的直接证据，
    //     不依赖绝对时间（跨机器稳）。为了压过时钟粒度，两个循环各跑到 ≥40 ms 再比。
    //     前一条 (b) 已经证明两条路径**结果相同**，所以这里放心的只看时间。
    const rounds: usize = 20000;
    var sink: usize = 0;
    var rp: usize = 0;
    const t_idx0: u64 = ua_now_ms();
    while rp < rounds {
        var oo: usize = 0;
        var ll: usize = 0;
        if tui_overlay_item_span(TUIS_SESSBIG_N - 1, &oo, &ll) {
            sink = sink + oo + ll;
        }
        rp = rp + 1;
    }
    const dt_idx: u64 = ua_now_ms() - t_idx0;
    const t_scan0: u64 = ua_now_ms();
    rp = 0;
    while rp < rounds {
        var oo: usize = 0;
        var ll: usize = 0;
        if tui_overlay_lin_span(TUIS_SESSBIG_N - 1, &oo, &ll) {
            sink = sink + oo + ll;
        }
        rp = rp + 1;
    }
    const dt_scan: u64 = ua_now_ms() - t_scan0;
    if sink == 123456789 {
        tuis_puts("   ");   // 防优化：sink 参与判断
    }
    tuis_puts("selftest[");
    tuis_puts(tag);
    tuis_puts("] 取末项 ");
    tuis_num(rounds);
    tuis_puts(" 次：查表 ms = ");
    tuis_num(dt_idx as usize);
    tuis_puts(" / 线性扫描 ms = ");
    tuis_num(dt_scan as usize);
    tuis_puts("\n");
    // 修好的实现：查表那一路应该比线性扫描快一个数量级（n=2000）；留 4 倍余量。
    // 若「取行被退回线性扫描」，两条腿都会是线性扫描 ⇒ 比值 ≈ 1 ⇒ 当场红。
    if dt_scan >= 4 && dt_scan < dt_idx * 4 {
        tuis_fail(tag, "取末项时查表没有明显快过线性扫描（取行不是 O(1)？）", &ok);
        tuis_puts("  查表 ms = ");
        tuis_num(dt_idx as usize);
        tuis_puts("  扫描 ms = ");
        tuis_num(dt_scan as usize);
        tuis_puts("\n");
    }

    // ---- 5) reader 型浮层（计划审阅）的成帧预算 ----
    // 列表型有「过滤器为空 ⇒ 序号就是项号」这条快路径兜着，reader 型没有：它按行号逐行取
    // 折行后的正文（tui_ov_row_at），每一行都真的走一次取行。这里把正文拉到上限
    // （TUI_OV_BODY_MAX = 128 KiB），滚到底（End 会把 body_top 推到最大）再各画一帧。
    //
    // ⚠ 这条是**冒烟**，不是「取行 O(1)」的判据：reader 每帧开头还有一段
    // `while k < body_top` 复原代码围栏、折行结果又在上限内（几千行），所以把取行退回
    // 线性扫描在这条预算上**照样绿**（本轮实测）。真正钉住 O(1) 的是上面 4b。
    var body: Buf = buf_new(1 << 20);
    defer { buf_free(&body); }
    var li: usize = 0;
    while li < 12000 {
        _ = buf_append_cstr(&body, "折行后的正文行 ");
        _ = buf_append_u64(&body, li as u64);
        _ = buf_append_cstr(&body, "：这一行要够长才值得折一次，所以这里再补一些中文字符把整行宽度凑满。\n");
        li = li + 1;
    }
    tuis_reset(100, 30);
    tui_reset_all();
    tuis_reset(100, 30);
    var acts: Buf = buf_new(64);
    defer { buf_free(&acts); }
    _ = buf_append_cstr(&acts, "继续讨论\n解决\n确认执行\n");
    tui_overlay_reader(TUI_OVK_PLAN, "计划" as &const byte, bufx_cstr_len("计划" as &const byte),
        body.ptr as &const byte, body.len, acts.ptr as &const byte, acts.len, 0);
    const rt0: u64 = ua_now_ms();
    tui_build();                                    // 第一帧：折行 + 从头画
    tui_keys_inject("\x1b[F" as &const byte, 3);    // End：滚到底（body_top 顶到最大）
    tui_build();
    tui_keys_inject("\x1b[6~" as &const byte, 4);   // PgUp 翻一页
    tui_build();
    const rdt: u64 = ua_now_ms() - rt0;
    if rdt > TUIS_SESSBIG_FRAME_MAX_MS {
        tuis_fail(tag, "reader 浮层成帧太慢", &ok);
        tuis_puts("  实测 ms = ");
        tuis_num(rdt as usize);
        tuis_puts("  上限 = ");
        tuis_num(TUIS_SESSBIG_FRAME_MAX_MS as usize);
        tuis_puts("\n");
    }
    if !tuis_screen_has("折行后的正文行" as &const byte) {
        tuis_fail(tag, "reader 浮层成帧之后屏幕上看不到正文", &ok);
    }

    tui_overlay_close();
    tui_reset_all();
    if ok {
        tuis_ok(tag, "2000 项：取行 O(1) 且第 0/中/末项逐字节正确 + 键盘语义自洽 + 列表与 reader 成帧均 < 1 s + 正文层无 ESC/NUL");
    }
    return ok;
}

// ============================================================
// tui-switch（P39）：**运行时换会话** —— 旧会话的正文必须从屏幕上消失
// ============================================================
// 三条腿：
//   A) `/new`：屏幕上先有旧会话的正文 → 敲 /new → 旧正文一个字节不剩、只剩新会话的回执，
//      而**面板/脚注（模型、cwd、分支）还在** —— 这正是「清转录」与「自测复位」的分界：
//      拿 tui_reset_all() 顶替的话，会话还在跑、界面却先残了（脚注与状态区全空）。
//   B) `/resume`：真会话日志（走真实的 sess_open/sess_begin/sess_end/sess_close，带两条真事件）
//      → 敲 /resume <id> → 旧正文消失、**被恢复会话的正文回放出来**（user 与 assistant 都在）、
//      回执排在回放内容**之后**（顺序反了就是「先清后写」写成了「先写后清」）。
//   C) 滚动模式（`tui_active()` 为假）：同一套调用**一个字节都不清** —— 那边的正文是终端
//      自己滚出去的，抹掉等于把用户刚看过的内容删了。

// 造一份**带正文**的真会话（真落盘 + 真索引；标题由调用方给，这里只要正文）
fn tuis_switch_make_sess(home: &const byte, ws: &const byte, out_id: &Buf) bool {
    var log: SessionLog = sess_log_empty();
    defer { sess_log_free(&log); }
    if !sess_open(&log, home, ws, "selftest-model" as &const byte, "uya-agent" as &const byte, "" as &const byte, true, 0 as i64, true) {
        return false;
    }
    var ev: Buf = buf_new(1024);
    defer { buf_free(&ev); }
    if !sess_begin(&log, "user/message" as &const byte, &ev) {
        return false;
    }
    _ = buf_append_cstr(&ev, "{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"TUIS-RESUMED-USER 被恢复会话的用户话\"}],\"source\":{\"kind\":\"user\"}}");
    _ = sess_end(&log, &ev);
    if !sess_begin(&log, "assistant/message" as &const byte, &ev) {
        return false;
    }
    _ = buf_append_cstr(&ev, "{\"turn\":0,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":\"TUIS-RESUMED-BOT 被恢复会话的回答\"},\"usage\":{\"inputTokens\":0,\"outputTokens\":0}}");
    _ = sess_end(&log, &ev);
    buf_reset(out_id);
    _ = buf_append(out_id, log.id.ptr, log.id.len);
    sess_close(&log, home);
    return out_id.len > 0;
}

// 造一份夹具 home：目录建好 + 索引清掉（同一个 home 可能被上一轮用过）
fn tuis_switch_home_ready(home: &const byte) void {
    _ = sess_mkdir_p(home);
    var ipath: Buf = buf_new(160);
    defer { buf_free(&ipath); }
    _ = buf_append_cstr(&ipath, home);
    _ = buf_append_cstr_z(&ipath, "/index.jsonl");
    _ = sys_unlink(ipath.ptr as *const byte) catch {};
}

// tui-switch 轮：/resume 切换工作区 —— 夹具挂当前工作区（幂等那条分支），
// 断言切换后的路径、提示与不搬走本进程 cwd。返回 false = 本轮红。
fn tui_switch_round(tag: &const byte) bool {
    var ok: bool = true;
    // 夹具挂在**当前工作区**（绝对路径）：/resume 会按会话记录的工作区去 chdir，
    // 记成同一个目录就落在「幂等」那条分支上，本轮不会把进程 cwd 搬走。
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        tuis_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    defer { wst_back(&root); }
    const home: &const byte = "build/selftest_tui_switch" as &const byte;
    tuis_switch_home_ready(home);
    var id_res: Buf = buf_new(64);
    defer { buf_free(&id_res); }
    // `sess_open` 的 cwd 是 **C 字符串**（NUL 结尾）：Buf.ptr 没有尾 NUL，
    // 直接传会把堆里紧邻的字节也算进路径（§16 踩坑 57），这里补一个 NUL 再传。
    var rootz: Buf = buf_new(root.len + 1);
    defer { buf_free(&rootz); }
    _ = buf_append(&rootz, root.ptr as &const byte, root.len);
    _ = buf_append_byte(&rootz, 0);
    if !tuis_switch_make_sess(home, rootz.ptr as &const byte, &id_res) {
        tuis_fail(tag, "夹具会话（带正文）没建成", &ok);
        return ok;
    }

    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("selftest-model");
    cfg.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&cfg);
    cfg.agent_home = buf_new(96);
    _ = buf_append_cstr(&cfg.agent_home, home);
    var h: History = hist_init();
    defer { hist_free(&h); }
    var cmd: Buf = buf_new(96);
    defer { buf_free(&cmd); }
    // 脚注三件套（模型 / cwd / 分支）：换会话**不许**把它们端掉，A 段专门钉这条
    const footer_model: &const byte = "deepseek-chat" as &const byte;
    const footer_cwd: &const byte = "/home/tester/proj" as &const byte;
    const footer_home: &const byte = "/home/tester" as &const byte;
    const footer_branch: &const byte = "main" as &const byte;

    // ---- A) /new：旧正文消失，脚注与面板还在 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);   // 逻辑上「TUI 在跑」（tui_active() 为真），但不碰终端
    tty_sink_on = true;          // 显示字节进转录（真 TUI 里这一步由 agent_tui_start 打开）
    tui_state_init(footer_model, bufx_cstr_len(footer_model), "deepseek" as &const byte, 8,
        "test" as &const byte, 4);
    tui_set_cwd(footer_cwd, bufx_cstr_len(footer_cwd), footer_home, bufx_cstr_len(footer_home));
    tui_set_branch(footer_branch, 4);
    tui_add_user("TUIS-OLD-USER 旧会话的正文" as &const byte, bufx_cstr_len("TUIS-OLD-USER 旧会话的正文" as &const byte));
    tui_build();
    if !tuis_screen_has("TUIS-OLD-USER" as &const byte) {
        tuis_fail(tag, "铺进去的旧正文没出现在屏幕上（夹具本身不对）", &ok);
    }
    buf_reset(&cmd);
    _ = buf_append_cstr(&cmd, "/new");
    _ = agent_tui_command(&cfg, &h, &cmd);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tuis_screen_has("TUIS-OLD-USER" as &const byte) {
        tuis_fail(tag, "/new 之后旧会话的正文还挂在屏幕上", &ok);
    }
    if !tuis_screen_has("已开新会话" as &const byte) {
        tuis_fail(tag, "/new 的回执没出现在屏幕上", &ok);
    }
    if !tuis_screen_has(footer_model) || !tuis_screen_has("proj" as &const byte) || !tuis_screen_has(footer_branch) {
        tuis_fail(tag, "换会话把面板/脚注一起端了（那是自测复位的口径）", &ok);
    }

    // ---- B) /resume：旧正文消失 + 被恢复会话的正文回放 + 回执在最后 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);
    tty_sink_on = true;
    tui_state_init(footer_model, bufx_cstr_len(footer_model), "deepseek" as &const byte, 8,
        "test" as &const byte, 4);
    tui_set_cwd(footer_cwd, bufx_cstr_len(footer_cwd), footer_home, bufx_cstr_len(footer_home));
    tui_set_branch(footer_branch, 4);
    tui_add_user("TUIS-OLD-USER 旧会话的正文" as &const byte, bufx_cstr_len("TUIS-OLD-USER 旧会话的正文" as &const byte));
    tui_build();
    if !tuis_screen_has("TUIS-OLD-USER" as &const byte) {
        tuis_fail(tag, "B 段的旧正文没铺上（夹具本身不对）", &ok);
    }
    buf_reset(&cmd);
    _ = buf_append_cstr(&cmd, "/resume ");
    _ = buf_append(&cmd, id_res.ptr, id_res.len);
    _ = agent_tui_command(&cfg, &h, &cmd);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tuis_screen_has("TUIS-OLD-USER" as &const byte) {
        tuis_fail(tag, "/resume 之后旧会话的正文还挂在屏幕上", &ok);
    }
    if !tuis_screen_has("TUIS-RESUMED-USER" as &const byte) {
        tuis_fail(tag, "/resume 之后被恢复会话的用户话没回放出来", &ok);
    }
    if !tuis_screen_has("TUIS-RESUMED-BOT" as &const byte) {
        tuis_fail(tag, "/resume 之后被恢复会话的回答没回放出来", &ok);
    }
    if !tuis_screen_has("已恢复会话" as &const byte) {
        tuis_fail(tag, "/resume 的回执没出现在屏幕上", &ok);
    }
    var r_bot: usize = 0;
    var r_rec: usize = 0;
    if tuis_find_row("TUIS-RESUMED-BOT" as &const byte, &r_bot) && tuis_find_row("已恢复会话" as &const byte, &r_rec) {
        // 先清、再回放、最后打回执 —— 顺序反了这条就红（顺序 = 「谁把谁清掉」）
        if r_rec <= r_bot {
            tuis_fail(tag, "/resume 的回执不在回放内容之后（清/回放的顺序反了）", &ok);
        }
    } else {
        tuis_fail(tag, "屏幕上没同时找到回放内容与回执", &ok);
    }
    if !tuis_screen_has(footer_model) || !tuis_screen_has("proj" as &const byte) {
        tuis_fail(tag, "/resume 把面板/脚注一起端了", &ok);
    }

    // ---- C) 滚动模式（tui_active() 为假）：一个字节都不清 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);
    tty_sink_on = true;
    tui_add_user("TUIS-SCROLL-USER 滚动模式的正文" as &const byte, bufx_cstr_len("TUIS-SCROLL-USER 滚动模式的正文" as &const byte));
    tui_build();
    // 注意用 tui_headless_enable(false)（它同时把 g_tui_on 关掉 = tui_active() 为假）；
    // tui_set_headless(false) 只动「headless」这个标志，tui_active() 还是真。
    tui_headless_enable(false);
    var replay_h: History = hist_init();
    defer { hist_free(&replay_h); }
    _ = hist_push(&replay_h, ROLE_USER, "TUIS-SCROLL-REPLAY 不该被回放" as &const byte,
        bufx_cstr_len("TUIS-SCROLL-REPLAY 不该被回放" as &const byte));
    agent_tui_session_switched(&replay_h, true);
    tui_headless_enable(true);
    tui_set_size(100, 30);
    tui_build();
    if !tuis_screen_has("TUIS-SCROLL-USER" as &const byte) {
        tuis_fail(tag, "滚动模式下换会话把转录清了（那会把用户刚看过的内容删掉）", &ok);
    }
    if tuis_screen_has("TUIS-SCROLL-REPLAY" as &const byte) {
        tuis_fail(tag, "滚动模式下还回放了历史（滚动模式不该碰转录）", &ok);
    }

    // ---- D) 清单是**会话级**状态：/new 之后清单清空，会话目标不跟着清 ----
    // （用户报的：敲 /new 开了新会话，常驻任务块与 /tasks 里还挂着上一条会话的清单。
    //   判据必须**同时**钉住两件事 —— 清掉的（清单）与**不该**被清掉的（目标）：
    //   只钉前者的话，把「换会话」写成「整个任务状态复位」也照样绿。）
    tuis_reset(100, 30);
    view_init(true, 0);           // 这一轮直接建帧，不跑 agent：显示层要自己打开
    tui_headless_enable(true);
    tty_sink_on = true;
    tui_state_init(footer_model, bufx_cstr_len(footer_model), "deepseek" as &const byte, 8,
        "test" as &const byte, 4);
    // 任务块只画在 **chat 布局**里（home 布局没有它的位置）：先铺一条正文
    tui_add_user("TUIS-NEW-USER 换会话前的正文" as &const byte,
        bufx_cstr_len("TUIS-NEW-USER 换会话前的正文" as &const byte));
    agent_tasks_fixture_demo();   // 真实 globals：清单 2/4 + 后台 1/2 + 子代理 1/1 + 目标 3/20
    _ = tasks_panel_sync();
    tui_build();
    if !tuis_screen_has("任务 2/4" as &const byte) {
        tuis_fail(tag, "D 段的任务夹具没铺进常驻块（夹具本身不对）", &ok);
    }
    buf_reset(&cmd);
    _ = buf_append_cstr(&cmd, "/new");
    _ = agent_tui_command(&cfg, &h, &cmd);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if g_todos.n != 0 {
        tuis_fail(tag, "/new 之后 todo 清单没清空（还留着上一条会话的清单）", &ok);
    }
    if tuis_screen_has("任务 2/4" as &const byte) {
        tuis_fail(tag, "/new 之后任务块里还挂着上一条会话的清单", &ok);
    }
    if !tuis_screen_has("目标 3/20" as &const byte) {
        tuis_fail(tag, "/new 把会话目标也清了（目标在盘上，按设计跨会话）", &ok);
    }

    // 同一条口径也要罩住 /resume：清单是**当前会话**的，恢复出来的会话日志里没有清单，
    // 屏幕上就不该还挂着切换之前那一份。
    agent_tasks_fixture_demo();
    _ = tasks_panel_sync();
    tui_build();
    if !tuis_screen_has("任务 2/4" as &const byte) {
        tuis_fail(tag, "D 段第二次装夹具没铺进常驻块", &ok);
    }
    buf_reset(&cmd);
    _ = buf_append_cstr(&cmd, "/resume ");
    _ = buf_append(&cmd, id_res.ptr, id_res.len);
    _ = agent_tui_command(&cfg, &h, &cmd);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if g_todos.n != 0 {
        tuis_fail(tag, "/resume 之后 todo 清单没清空（那是上一条会话的清单）", &ok);
    }
    if tuis_screen_has("任务 2/4" as &const byte) {
        tuis_fail(tag, "/resume 之后任务块里还挂着切换之前的清单", &ok);
    }

    // 收尾：画布/显示收口复位，后面的轮次不靠这次留下的东西（夹具也是）
    tty_sink_on = false;
    tui_set_headless(true);
    tui_reset_all();
    tuis_tasks_clear();
    if ok {
        tuis_ok(tag, "/new 清掉旧正文且脚注还在 + /resume 清掉旧正文并回放被恢复会话（回执在最后）+ 滚动模式一个字节不动 + /new 与 /resume 清空清单但留住目标");
    }
    return ok;
}

// ============================================================
// tui-caret（修复，踩坑 66）：运行中输入行的光标
//
// 症状：回合运行中在输入行敲字（steer；`ask_user_question` 更是直接用输入行等回答）
// 时，屏幕上**没有光标** —— 明明能打字却看不到插入点。
// 根因：`tui_cursor_place()` 把可见性绑在运行状态上（`run == IDLE` 才显示），
// 而 `tui_flush()` 对不可见的帧每帧补一个 `ESC[?25l`。
// 口径：可见性**只跟浮层走** —— 空闲或没有浮层 = 显示；只有「运行中且浮层开着」才隐藏
// （浮层开着时键全被它吃掉，插入点不在输入行上）。
//
// 两条腿：① 标志位（`tui_caret_visible`）；② **字节级**（真刷一帧进 pipe，数
// `?25h` / `?25l`）—— 只信标志位的话，把 `tui_flush` 那段改坏了照样绿。
// ============================================================

// 把 pipe 里现有的字节全读出来（非阻塞：poll 说没数据就收工）
fn tuis_pipe_drain(rfd: i32, out: &Buf) void {
    var tmp: [byte: 4096] = [0: 4096];
    var guard: i32 = 0;
    while guard < 64 {
        guard = guard + 1;
        var pfds: [PollFd: 1] = [PollFd{ fd: rfd, events: POLLIN, revents: 0 }];
        const pr: i32 = sys_poll(&pfds[0], 1, 20) catch { 0; };
        if pr <= 0 {
            return;
        }
        const n: isize = sys_read(rfd, &tmp[0], 4096) catch { -1 as isize; };
        if n <= 0 {
            return;
        }
        _ = buf_append(out, &tmp[0], n as usize);
    }
}

// 真刷一帧到 pipe 并把字节收进 cap（调用方负责数 `?25h` / `?25l`）
fn tuis_caret_frame(rfd: i32, cap: &Buf) void {
    buf_reset(cap);
    tui_invalidate();
    tui_render();
    tuis_pipe_drain(rfd, cap);
}

// tui-caret 轮：运行中（思考/输出/工具三态）输入行**必须有**光标（字节级 ?25h），
// 空闲与浮层两格维持不变。返回 false = 本轮红。
fn tui_caret_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_reset(100, 30);
    tui_input_set("运行中也要有光标" as &const byte,
        bufx_cstr_len("运行中也要有光标" as &const byte));

    // ---- A) 标志位：运行中（无浮层）**必须有**光标 —— 这就是本次修的回归 ----
    tui_overlay_close();
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "运行中（思考中）输入行的光标被藏了（本次修的回归）", &ok);
    }
    tui_set_run(TUI_RUN_STREAM, "" as &const byte, 0);
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "运行中（输出中）输入行的光标被藏了", &ok);
    }
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "运行中（跑工具）输入行的光标被藏了（ask_user_question 就在这个状态下等回答）", &ok);
    }

    // ---- B) 空闲：照旧显示（这一格修前修后一致，钉住没被改坏）----
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "空闲时输入行反而没有光标", &ok);
    }

    // ---- C) 运行中 + 浮层：仍隐藏（不变式）----
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6,
        "一行\n" as &const byte, bufx_cstr_len("一行\n" as &const byte));
    tui_build();
    if tui_caret_visible() {
        tuis_fail(tag, "运行中浮层开着还露光标（键都被浮层吃了，插入点不在输入行上）", &ok);
    }

    // ---- D) 空闲 + 浮层：显示（这一格同样不许被顺手改掉）----
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "空闲且浮层开着时没有光标", &ok);
    }
    tui_overlay_close();
    tui_set_size(100, 30);

    // ---- E) 字节级：真刷一帧进 pipe，数 `?25h` / `?25l` ----
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "pipe2 失败（字节级那条腿没跑成）", &ok);
        tui_reset_all();
        return ok;
    }
    tui_term_enter(fds[1]);
    var cap: Buf = buf_new(65536);
    defer { buf_free(&cap); }

    // E1) 运行中（无浮层）：恰好一个 `?25h`、零个 `?25l`
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_overlay_close();
    tuis_caret_frame(fds[0], &cap);
    const e1_show: usize = tuis_count(&cap, "\x1b[?25h" as &const byte);
    const e1_hide: usize = tuis_count(&cap, "\x1b[?25l" as &const byte);
    if e1_hide != 0 || e1_show != 1 {
        tuis_fail(tag, "运行中那一帧没有显示光标（字节级：期望 1×?25h / 0×?25l）", &ok);
        tuis_puts("  e1 show=");
        tuis_num(e1_show);
        tuis_puts(" hide=");
        tuis_num(e1_hide);
        tuis_puts("\n");
    }

    // E2) 运行中 + 浮层：有 `?25l`、零个 `?25h`
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6,
        "一行\n" as &const byte, bufx_cstr_len("一行\n" as &const byte));
    tuis_caret_frame(fds[0], &cap);
    const e2_show: usize = tuis_count(&cap, "\x1b[?25h" as &const byte);
    const e2_hide: usize = tuis_count(&cap, "\x1b[?25l" as &const byte);
    if e2_hide != 1 || e2_show != 0 {
        tuis_fail(tag, "运行中开浮层那一帧没有藏光标（字节级：期望 1×?25l / 0×?25h）", &ok);
        tuis_puts("  e2 show=");
        tuis_num(e2_show);
        tuis_puts(" hide=");
        tuis_num(e2_hide);
        tuis_puts("\n");
    }

    // E3) 空闲（无浮层）：显示
    tui_overlay_close();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    tuis_caret_frame(fds[0], &cap);
    const e3_show: usize = tuis_count(&cap, "\x1b[?25h" as &const byte);
    const e3_hide: usize = tuis_count(&cap, "\x1b[?25l" as &const byte);
    if e3_hide != 0 || e3_show != 1 {
        tuis_fail(tag, "空闲那一帧没有显示光标（字节级）", &ok);
    }

    // 收尾：先把 TUI 收回 headless（out_fd 归位），再关 pipe 两端
    tui_overlay_close();
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    _ = sys_close(fds[1]) catch {};
    _ = sys_close(fds[0]) catch {};

    if ok {
        tuis_ok(tag, "运行中输入行有光标（思考/输出/工具三态 + 字节级 ?25h）+ 空闲与浮层两格不变 + 运行中开浮层仍隐藏");
    }
    return ok;
}

// ============================================================
// tui-full（P53）：浮层全屏
//
// 全屏在这里有确切含义：浮层把**转录区**用满（宽 = 终端列数、高 = panel_top、
// 左上角 = (0,0)），**不吃**面板 / 状态区 / 脚注。四条腿：
//   A) 几何：同一份内容，全屏的框 = 转录区（宽/高/左上角都真的到边），非全屏仍是居中框；
//   B) 按键：ctrl+f（0x06）与 F11（ESC[23~）都切换，且**四种浮层形态各认一次**
//      （全屏键必须路由在所有形态分派之前，否则 reader/ask/input 会把它静默吃掉）；
//   C) 不变量：每行 ≤ cols、正文层无 ESC / 无 NUL；面板与脚注仍在（全屏只吃转录区）；
//   D) 与 fail-closed 判据无关：终端太矮时该回落照旧回落；全屏态不跨浮层残留。
// ============================================================


// 断言浮层「占满转录区」：左右边界到 0 / cols-1，顶边在第 0 行，底边正好压在
// panel_top-1 那一行（面板之上最后一行）。用**屏幕文本**判，不看内部状态 ——
// 这样几何与绘制不一致时（右边界没到边、顶边没顶格）当场红。

// 满屏浮窗轮（P31 那一族）：geo=true 只做「浮层占满转录区」的几何断言并返回
// （六段共用，合进一个函数是为了省函数表名额，见踩坑 87）；geo=false 跑完整的浮层内容断言。
// 一律用屏幕文本判，不看内部状态。
fn tui_full_round(tag: &const byte, geo: bool) bool {
    // geo = true：只做「浮层占满转录区」的几何断言并返回（= 原来的 tuis_full_frame_ok，
    // A2/B2/C/D2/D3/E/F 六段共用）。合进同一个函数是为了省**函数表**名额（见踩坑 87）。
    if geo {
        const cols: usize = 100;
        var ok: bool = true;
        var txt: Buf = buf_new(262144);
        defer { buf_free(&txt); }
        _ = tui_screen_text(&txt);
        const p: &const byte = txt.ptr as &const byte;
        const n: usize = txt.len;
        const top: usize = tuis_find_lit_row(p, n, 0, tui_nrows(), "╭" as &const byte);
        if top >= tui_nrows() {
            tuis_fail(tag, "全屏浮层没有画出来（找不到 ╭）", &ok);
            return false;
        }
        if top != 0 {
            tuis_fail(tag, "全屏浮层的顶边没有顶格（第 0 行）", &ok);
            tuis_puts("  top=");
            tuis_num(top);
            tuis_puts("\n");
        }
        // 左右边界：顶边那一行必须从第 0 列开始、到 cols-1 列结束
        const l: usize = tuis_row_edge_start(p, n, top);
        const rr: usize = tuis_row_edge_end(p, n, top);
        if l != 0 {
            tuis_fail(tag, "全屏浮层的左边框没在第 0 列", &ok);
            tuis_puts("  left=");
            tuis_num(l);
            tuis_puts("\n");
        }
        if rr != cols {
            // 右边界列 = 边界字符的**右沿**；占满时应当正好等于 cols
            tuis_fail(tag, "全屏浮层的右边框没到终端最后一列", &ok);
            tuis_puts("  right=");
            tuis_num(rr);
            tuis_puts(" cols=");
            tuis_num(cols);
            tuis_puts("\n");
        }
        // 每一行（顶边到底边）左右边界同列 + 都闭合 —— 复用既有判据的口径
        // 底边行 = 最后一个含 ╰ 的行（就地扫，不另开函数 —— 见踩坑 87 的函数表容量）
        var bot: usize = tui_nrows();
        var s1r: usize = tui_nrows();
        while s1r > 0 {
            s1r = s1r - 1;
            var s1a: usize = 0;
            var s1b: usize = 0;
            if tuis_line_span(p, n, s1r, &s1a, &s1b) {
                var s1i: usize = s1a;
                while s1i + 3 <= s1b {
                    if bufx_mem_eq(p + s1i, "╰" as &const byte, 3) {
                        bot = s1r;
                        s1r = 0;
                        break;
                    }
                    s1i = s1i + 1;
                }
            }
        }

        if bot >= tui_nrows() {
            tuis_fail(tag, "全屏浮层没有底边（找不到 ╰）", &ok);
            return false;
        }
        var r: usize = top;
        var bad: bool = false;
        while r <= bot {
            if tuis_row_edge_start(p, n, r) != l || tuis_row_edge_end(p, n, r) != rr {
                bad = true;
                break;
            }
            r = r + 1;
        }
        if bad {
            tuis_fail(tag, "全屏浮层的方框没有闭合成矩形（右边框逐行没对齐）", &ok);
            tuis_puts("  行=");
            tuis_num(r);
            tuis_puts("\n");
        }
        // 底边必须**正好**压在面板之上：转录区的行数就是 panel_top，全屏把这块地用满 ⇒
        // 底边 = panel_top - 1。这一条是「全屏不吃面板」的**数值**判据 —— 光看「面板还在」
        // 是抓不住「框画过头、盖住面板之后又被后面补画的行盖回来」那类假绿的
        // （本轮对照实验 ③ 实测：把高度换成整个 rows 时，这条不加就是绿的）。
        // 面板首行的行号 == panel_top。占位文案在面板**第一行**，但它上面还钉着状态区
        // （运行中才有，P18），所以要从占位行往上退掉状态区那几行 —— 不能直接拿占位行当面板首行。
        // 浮层底边 = panel_top - 1 的判据因此对「运行中/空闲」两种情形都成立。
        const prow: usize = tuis_find_lit_row(p, n, 0, tui_nrows(), "Ask anything" as &const byte);
        var pt: usize = 0;
        if prow < tui_nrows() && prow >= tui_status_rows() {
            pt = prow - tui_status_rows();
        }
        if pt > 0 && bot + 1 != pt {
            tuis_fail(tag, "全屏浮层的底边没有正好压在面板之上（多吃了或少吃了行）", &ok);
            tuis_puts("  底边=");
            tuis_num(bot);
            tuis_puts(" panel_top=");
            tuis_num(pt);
            tuis_puts("\n");
        }
        return ok;
    }
    var ok: bool = true;
    const cols: usize = 100;
    const rows: usize = 30;

    // 一份够长的内容：非全屏的列表型上限 16 行，全屏才有地方把它画全 ——
    // 「全屏真的解除了上界」这条判据就靠它（末项只有全屏才看得见）。
    var items: Buf = buf_new(4096);
    defer { buf_free(&items); }
    var k: usize = 0;
    while k < 30 {
        _ = buf_append_cstr(&items, "/cmd");
        _ = buf_append_u64(&items, (k + 1) as u64);
        _ = buf_append_cstr(&items, "  第 ");
        _ = buf_append_u64(&items, (k + 1) as u64);
        _ = buf_append_cstr(&items, " 条命令（用来把框撑过 16 行上限）\n");
        k = k + 1;
    }

    // ---- A1) 非全屏：列表型仍是居中框（宽 60 / 不顶格 / 高 ≤ 16）----
    tuis_reset(cols, rows);
    tui_set_commands(items.ptr as &const byte, items.len);
    tui_overlay_list(TUI_OVK_PALETTE, "命令" as &const byte, 6, items.ptr as &const byte, items.len);
    if tui_overlay_full(-2) {
        tuis_fail(tag, "开浮层时全屏态应当是关的（一次性生效）", &ok);
    }
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    var txt: Buf = buf_new(262144);
    defer { buf_free(&txt); }
    _ = tui_screen_text(&txt);
    var p: &const byte = txt.ptr as &const byte;
    var tn: usize = txt.len;
    const top0: usize = tuis_find_lit_row(p, tn, 0, tui_nrows(), "╭" as &const byte);
    if top0 >= tui_nrows() {
        tuis_fail(tag, "A1 前置：非全屏的列表浮层没画出来", &ok);
        return ok;
    }
    const l0: usize = tuis_row_edge_start(p, tn, top0);
    if l0 == 0 {
        tuis_fail(tag, "非全屏的浮层不该顶格（左边框应当在留白之后）", &ok);
    }
    // 非全屏的框高上界 16 行：底边-顶边+1 ≤ 16
    // 底边行 = 最后一个含 ╰ 的行（就地扫，不另开函数 —— 见踩坑 87 的函数表容量）
    var bot0: usize = tui_nrows();
    var s2r: usize = tui_nrows();
    while s2r > 0 {
        s2r = s2r - 1;
        var s2a: usize = 0;
        var s2b: usize = 0;
        if tuis_line_span(p, tn, s2r, &s2a, &s2b) {
            var s2i: usize = s2a;
            while s2i + 3 <= s2b {
                if bufx_mem_eq(p + s2i, "╰" as &const byte, 3) {
                    bot0 = s2r;
                    s2r = 0;
                    break;
                }
                s2i = s2i + 1;
            }
        }
    }

    if bot0 >= tui_nrows() {
        tuis_fail(tag, "A1 前置：非全屏的列表浮层没有底边", &ok);
    } else if bot0 - top0 + 1 > 16 {
        tuis_fail(tag, "非全屏的列表浮层超过了 16 行上限", &ok);
    }
    // 30 项在 16 行框里放不下 ⇒ 末项看不见（这才是「需要全屏」的现场）
    if tuis_screen_has("第 30 条命令" as &const byte) {
        tuis_fail(tag, "非全屏居然把第 30 项也画出来了（框高上限没生效？这条腿就白测了）", &ok);
    }

    // ---- A2) 全屏：同一个浮层，框 = 转录区（顶格 / 左右到边 / 解除了 16 行上限）----
    // 走**快捷键**那条真路开全屏（顺带验一遍按键路由）
    tui_keys_inject("\x06" as &const byte, 1);
    tui_build();          // 快捷键只置脏；判据读的是**已画出来的那一帧**，这里必须真画
    if (!tui_full_round(tag, true)) {
        ok = false;
    }
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("· 全屏" as &const byte) {
        tuis_fail(tag, "全屏后标题栏没有 ` · 全屏` 标记", &ok);
    }
    // 上界解除：非全屏上限 16 行，全屏的高度是 panel_top（这里 27）⇒ 可见条目严格更多。
    //
    // 判据用**两个固定字面量**而不是「for 1..30 拼字符串再查」：拼出来的名字是 buf_new
    // 造的**裸 malloc** 缓冲区（不保证 NUL 结尾），而 tuis_screen_has 内部按 bufx_cstr_len
    // 量长度 —— 会读到堆尾巴上去（§16 踩坑 57/67/77 那一族，本轮又踩了一次：
    // 这条断言的第一版就是这么假红的，量出来「可见条目=9」）。
    // 第 20 条在所有可能的全屏高度下都该看得见（16 行上限只能画到前 13 项左右），
    // 而它在非全屏下**必然**看不见（前面已断言过第 30 条看不见，这里再钉一个更近的）。
    if !tuis_screen_has("第 20 条命令" as &const byte) {
        tuis_fail(tag, "全屏后第 20 项还看不见（16 行上限没解除？）", &ok);
        tuis_puts("  panel_top=");
        tuis_num(tuis_find_lit_row(p, tn, 0, tui_nrows(), "Ask anything" as &const byte) + 1);
        tuis_puts(" rows=");
        tuis_num(rows);
        tuis_puts("\n");
    }
    if tuis_screen_has("第 30 条命令" as &const byte) {
        tuis_fail(tag, "第 30 项不该在全屏下也看得见（全屏高 = panel_top 只到第 20 多项；这条是判据自检）", &ok);
    }

    // ---- B) 按键：ctrl+f 与 F11 都切换（列表型）----
    // 从全屏态出发：ctrl+f 关掉、F11 开回来（两种编码都真的到得了这个开关）
    if !tui_overlay_full(-2) {
        tuis_fail(tag, "A2 前置：全屏态应当是开的", &ok);
    }
    tui_keys_inject("\x06" as &const byte, 1);          // ctrl+f
    if tui_overlay_full(-2) {
        tuis_fail(tag, "ctrl+f（0x06）没有关掉全屏", &ok);
    }
    tui_keys_inject("\x1b[23~" as &const byte, 5);      // F11
    if !tui_overlay_full(-2) {
        tuis_fail(tag, "F11（ESC[23~）没有开回全屏", &ok);
    }
    tui_keys_inject("\x1b[23~" as &const byte, 5);      // 再按一次
    if tui_overlay_full(-2) {
        tuis_fail(tag, "F11 第二下没有关掉全屏", &ok);
    }
    // 全屏关掉后屏幕上必须回到居中框（画一帧再判）
    tui_build();
    _ = tui_screen_text(&txt);
    p = txt.ptr as &const byte;
    tn = txt.len;
    const top1: usize = tuis_find_lit_row(p, tn, 0, tui_nrows(), "╭" as &const byte);
    if top1 < tui_nrows() && top1 == 0 {
        tuis_fail(tag, "关掉全屏后框图没有回到居中（顶边还在第 0 行）", &ok);
    }
    tui_overlay_close();

    // ---- B2) 四种形态各认一次 ctrl+f（全屏键必须在所有形态分派之前）----
    // 顺序：列表（已测）/ reader / ask / input。每一种都：非全屏 → ctrl+f → 全屏 → 框占满。
    // reader
    tuis_reset(cols, rows);
    var body: Buf = buf_new(4096);
    defer { buf_free(&body); }
    var bi: usize = 0;
    while bi < 40 {
        _ = buf_append_cstr(&body, "计划正文第 ");
        _ = buf_append_u64(&body, (bi + 1) as u64);
        _ = buf_append_cstr(&body, " 行\n");
        bi = bi + 1;
    }
    tui_overlay_reader(TUI_OVK_PLAN, "计划" as &const byte, bufx_cstr_len("计划" as &const byte),
        body.ptr as &const byte, body.len, "确认执行" as &const byte, bufx_cstr_len("确认执行" as &const byte), 0);
    tui_keys_inject("\x06" as &const byte, 1);
    if !tui_overlay_full(-2) {
        tuis_fail(tag, "reader 型（plan 审阅）上 ctrl+f 没有全屏（全屏键被形态分派吃掉了？）", &ok);
    }
    tui_build();
    if (!tui_full_round(tag, true)) {
        ok = false;
    }
    tuis_scan_rows(cols, &ok, tag);
    tui_overlay_close();

    // ask
    tuis_reset(cols, rows);
    tui_overlay_ask_open("提问" as &const byte, bufx_cstr_len("提问" as &const byte),
        "选哪个？" as &const byte, bufx_cstr_len("选哪个？" as &const byte),
        "alpha\nbeta" as &const byte, bufx_cstr_len("alpha\nbeta" as &const byte), false, 0);
    tui_keys_inject("\x06" as &const byte, 1);
    if !tui_overlay_full(-2) {
        tuis_fail(tag, "ask 型（提问弹窗）上 ctrl+f 没有全屏", &ok);
    }
    tui_build();
    if (!tui_full_round(tag, true)) {
        ok = false;
    }
    tuis_scan_rows(cols, &ok, tag);
    // 全屏的 ask 仍是「问题 + 选项 + 自定义行 + 提示」那一套（不是被拉成一屏留白）
    if !tuis_screen_has("选哪个？" as &const byte) {
        tuis_fail(tag, "全屏的 ask 浮层里问题正文不见了", &ok);
    }
    if !tuis_screen_has("enter 提交" as &const byte) {
        tuis_fail(tag, "全屏的 ask 浮层里按键提示不见了（全屏把提示行挤掉了？）", &ok);
    }
    tui_overlay_close();

    // input（P48）
    tuis_reset(cols, rows);
    tui_overlay_input_open("标题" as &const byte, bufx_cstr_len("标题" as &const byte),
        "草稿" as &const byte, bufx_cstr_len("草稿" as &const byte));
    tui_keys_inject("\x06" as &const byte, 1);
    if !tui_overlay_full(-2) {
        tuis_fail(tag, "input 型（/title 输入框）上 ctrl+f 没有全屏", &ok);
    }
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("· 全屏" as &const byte) {
        tuis_fail(tag, "全屏的 input 浮层没有全屏标记", &ok);
    }
    // 单行输入框全屏后**仍是 4 行高**（语义是单行输入，拉成一屏只会是留白）
    _ = tui_screen_text(&txt);
    p = txt.ptr as &const byte;
    tn = txt.len;
    const ti: usize = tuis_find_lit_row(p, tn, 0, tui_nrows(), "╭" as &const byte);
    // 底边行 = 最后一个含 ╰ 的行（就地扫，不另开函数 —— 见踩坑 87 的函数表容量）
    var bi2: usize = tui_nrows();
    var s3r: usize = tui_nrows();
    while s3r > 0 {
        s3r = s3r - 1;
        var s3a: usize = 0;
        var s3b: usize = 0;
        if tuis_line_span(p, tn, s3r, &s3a, &s3b) {
            var s3i: usize = s3a;
            while s3i + 3 <= s3b {
                if bufx_mem_eq(p + s3i, "╰" as &const byte, 3) {
                    bi2 = s3r;
                    s3r = 0;
                    break;
                }
                s3i = s3i + 1;
            }
        }
    }

    if ti < tui_nrows() && bi2 < tui_nrows() && bi2 - ti + 1 != 4 {
        tuis_fail(tag, "input 型全屏后不是 4 行高（单行输入框的语义应当保持）", &ok);
        tuis_puts("  高=");
        tuis_num(bi2 - ti + 1);
        tuis_puts("\n");
    }
    tui_overlay_close();

    // ---- C) 不变量：全屏不吃面板 / 状态区 / 脚注 ----
    // 运行中（有状态区）开浮层全屏：面板的占位文案与脚注的 cwd 都必须在
    tuis_reset(cols, rows);
    tui_set_run(TUI_RUN_TOOL, "Bash(sleep 1)" as &const byte, bufx_cstr_len("Bash(sleep 1)" as &const byte));
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    // 走**快捷键**那条真路开全屏（顺带验一遍按键路由）
    tui_keys_inject("\x06" as &const byte, 1);
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if (!tui_full_round(tag, true)) {
        ok = false;
    }
    // 状态区（运行中才有的那一行）
    if !tuis_screen_has("运行中" as &const byte) {
        tuis_fail(tag, "全屏把常驻状态区吃掉了（P18 的承诺：转录再长也看得见状态）", &ok);
    }
    // 面板占位（输入行）
    if !tuis_screen_has("Ask anything" as &const byte) {
        tuis_fail(tag, "全屏把输入面板吃掉了（输入行是常驻的打字目标）", &ok);
    }
    // 脚注（cwd）
    if !tuis_screen_has("~/proj:main" as &const byte) {
        tuis_fail(tag, "全屏把脚注吃掉了", &ok);
    }
    // 「底边正好压在面板之上」那条数值判据在 tuis_full_frame_ok 里（上面已调过），
    // 这里不再重写一份 —— 两处判据分头写就是漂移的来源。
    tui_overlay_close();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);

    // ---- D1) 没浮层时按 ctrl+f：不改状态、落一条指路 notice ----
    tuis_reset(cols, rows);
    if tui_overlay_open() {
        tuis_fail(tag, "D1 前置：不该有浮层", &ok);
    }
    tui_keys_inject("\x06" as &const byte, 1);
    if tui_overlay_full(-2) || tui_overlay_open() {
        tuis_fail(tag, "没浮层时按 ctrl+f 竟然开了浮层 / 改了全屏态（应当是空操作 + notice）", &ok);
    }
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("现在没有浮层" as &const byte) {
        tuis_fail(tag, "没浮层时按 ctrl+f 没有指路 notice（静默 = 用户以为键坏了）", &ok);
    }

    // ---- D2) 全屏态不跨浮层：关掉再开一张，必须回到非全屏 ----
    tuis_reset(cols, rows);
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    // 走**快捷键**那条真路开全屏（顺带验一遍按键路由）
    tui_keys_inject("\x06" as &const byte, 1);
    if !tui_overlay_full(-2) {
        tuis_fail(tag, "D2 前置：全屏态没打开", &ok);
    }
    tui_overlay_close();
    if tui_overlay_full(-2) {
        tuis_fail(tag, "close 之后全屏态残留了", &ok);
    }
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    if tui_overlay_full(-2) {
        tuis_fail(tag, "新开的浮层继承了上一张的全屏态（一次性生效的纪律被破了）", &ok);
    }
    tui_overlay_close();

    // ---- D3) esc 关掉全屏浮层之后，转录回来（屏幕恢复）----
    tuis_reset(cols, rows);
    tui_add_user("把问候语改掉" as &const byte, bufx_cstr_len("把问候语改掉" as &const byte));
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    // 走**快捷键**那条真路开全屏（顺带验一遍按键路由）
    tui_keys_inject("\x06" as &const byte, 1);
    tui_build();
    if !tuis_screen_has("第 1 条命令" as &const byte) {
        tuis_fail(tag, "全屏浮层没画出来（D3 前置）", &ok);
    }
    tui_keys_inject("\x1b" as &const byte, 1);   // esc 关浮层
    if tui_overlay_open() {
        tuis_fail(tag, "esc 没有关掉全屏的浮层", &ok);
    }
    if tui_overlay_full(-2) {
        tuis_fail(tag, "esc 关掉浮层后全屏态残留", &ok);
    }
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("把问候语改掉" as &const byte) {
        tuis_fail(tag, "关掉全屏浮层之后转录没有回来", &ok);
    }

    // ---- E) fail-closed 判据与全屏无关（终端太矮时照旧画不出来）----
    // 先给一个够高的画布把浮层开起来 + 切全屏，**再**缩到 5 行看判据有没有被带偏：
    // 这样测的是「全屏态 + 太矮」的组合，而不是「太矮时开浮层」。
    tuis_reset(cols, rows);
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    // 走**快捷键**那条真路开全屏（顺带验一遍按键路由）
    tui_keys_inject("\x06" as &const byte, 1);
    if !tui_overlay_full(-2) {
        tuis_fail(tag, "E 前置：全屏态没打开", &ok);
    }
    if !tui_overlay_available() {
        tuis_fail(tag, "E 前置：30 行的画布上浮层应当画得出来", &ok);
    }
    tui_set_size(cols, 5);      // 缩到 5 行（panel_top 随之变小）
    tui_build();                // 不崩即可
    tuis_scan_rows(cols, &ok, tag);
    if tui_overlay_available() {
        tuis_fail(tag, "全屏不能把「浮层画得出来」这条判据变成 true（审批要 fail closed）", &ok);
    }
    if tui_reader_fits() {
        tuis_fail(tag, "全屏不能把 tui_reader_fits 变成 true（终端还是太矮）", &ok);
    }
    tui_overlay_close();

    // ---- F) /fullscreen 命令：报状态 / on / off / 非法值只报错 / 幂等 ----
    tuis_reset(cols, rows);
    tui_headless_enable(true);   // agent_cmd_fullscreen 先看 tui_active()
    var line: Buf = buf_new(64);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "/fullscreen");
    agent_cmd_display(&line, 1);
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("当前没有浮层" as &const byte) {
        tuis_fail(tag, "裸 /fullscreen（没浮层）没有报出「当前没有浮层」", &ok);
    }
    // 开一张浮层再报状态
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    _ = buf_append_cstr(&line, " on");
    agent_cmd_display(&line, 1);
    if !tui_overlay_full(-2) {
        tuis_fail(tag, "/fullscreen on 没有全屏", &ok);
    }
    tui_build();
    if (!tui_full_round(tag, true)) {
        ok = false;
    }
    // off
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/fullscreen off");
    agent_cmd_display(&line, 1);
    if tui_overlay_full(-2) {
        tuis_fail(tag, "/fullscreen off 没有关掉全屏", &ok);
    }
    // 非法取值：只报错、状态不动（与 /mouse 同一条纪律）
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/fullscreen bogus");
    agent_cmd_display(&line, 1);
    if tui_overlay_full(-2) {
        tuis_fail(tag, "/fullscreen bogus 把状态改掉了（非法取值应当只报错）", &ok);
    }
    // 判据要读 notice：先收掉浮层 —— 浮层盖着转录时那条 notice 在屏幕上根本看不见
    // （§16 踩坑 65 的现场：底对齐菜单正好压在转录最新那几行上）
    tui_overlay_close();
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("未知取值" as &const byte) {
        tuis_fail(tag, "/fullscreen 的非法取值没有报错", &ok);
    }
    // 幂等：已经是关，再 off 一次不该崩、也不该翻成开
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/fullscreen off");
    agent_cmd_display(&line, 1);
    if tui_overlay_full(-2) {
        tuis_fail(tag, "/fullscreen off 重复调用把状态翻成了开", &ok);
    }
    tui_overlay_close();

    // F 段把 TUI 打开了（agent_cmd_fullscreen 先看 tui_active()），收尾必须**关掉**
    // `g_tui_on`，而不只是复位画布 —— tuis_reset 是关不掉的（它只动尺寸与状态）。
    // 漏掉的后果很隐蔽：后一轮（perm-readonly）里 `ask_approve_action` 会走
    // `if tui_active() && tui_overlay_available()` 那一支（以为有浮层可弹），于是不再回
    // "no answer channel"，mock 第 1 轮的断言 110 当场红 —— 现场看着像权限轮的缺陷，
    // 其实是本轮的状态泄漏（与 tui-switch 的 C 段同一个坑，见那里的注释）。
    tui_headless_enable(false);
    tuis_reset(cols, rows);
    if ok {
        tuis_ok(tag, "浮层全屏（几何占满转录区、四种形态都认 ctrl+f / F11、解除 16 行上限、不吃面板与脚注、没浮层时只落 notice、不跨浮层残留、不改变 fail-closed 判据、/fullscreen 命令四态）");
    }
    return ok;
}

// ============================================================
// tui-md（P47）：markdown 渲染
//
// 旧实现的两处硬伤（本轮修掉，逐条在这里钉住）：
//   ① **长行静默丢字**：折行按 `cols - 6`、绘制按 `cols - 7`，列表/代码行绘制时再多扣
//      2 列 ⇒ 每行丢 1–3 个字符再补 '…'。实测（修前）：60/80/100 列下 100 字符的代码行
//      只显示 97 个、60 个汉字只显示 58–59 个。修后：逐字符可见、没有 '…'。
//   ② **围栏状态是帧级全局**（`g_tui_md_code` 每帧开头复位）⇒ 滚动窗口落在代码块中间时
//      整块掉样式、闭合围栏还被当成「开始」。修后样式逐字节落在文本上，窗口从哪儿开始都对。
//
// 另外三条不变量：每行显示列 ≤ cols、正文层无 ESC / 无 NUL（复用 tuis_scan_rows）。
// ============================================================

// 屏幕文本里某字节出现几次（「不丢字」那条腿的判据）
fn tuis_md_count_byte(c: byte) usize {
    var out: Buf = buf_new(262144);
    defer { buf_free(&out); }
    _ = tui_screen_text(&out);
    var k: usize = 0;
    var n: usize = 0;
    while k < out.len {
        if out.ptr[k] == c {
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

// 含 `lit` 的那些行里有没有 '…'（'…' = E2 80 A6）。
// 按**字面量**而不是单字节匹配：单个 0xE6 既是「汉」的首字节、也是任务块里一堆汉字与
// 它自己那条截断提示 `…` 的来源，按字节判会把任务块的 '…' 算进来（第一版就这么假红）。
fn tuis_md_row_has_ellipsis(lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    var r: usize = 0;
    while r < tui_nrows() {
        var out: Buf = buf_new(512);
        defer { buf_free(&out); }
        tui_row_text(r, &out);
        var has_c: bool = false;
        var k: usize = 0;
        while k + ln <= out.len {
            if bufx_mem_eq(out.ptr + k, lit, ln) {
                has_c = true;
            }
            k = k + 1;
        }
        if has_c {
            var j: usize = 0;
            while j + 3 <= out.len {
                if out.ptr[j] == 226 as byte && out.ptr[j + 1] == 128 as byte && out.ptr[j + 2] == 166 as byte {
                    return true;
                }
                j = j + 1;
            }
        }
        r = r + 1;
    }
    return false;
}

// 数当前屏幕文本里 C 字面量 lit 出现的次数（markdown 轮的断言辅助）。
// 每帧重新取屏幕；lit 为空返回 0。
fn tuis_md_count_lit(lit: &const byte) usize {
    var out: Buf = buf_new(262144);
    defer { buf_free(&out); }
    _ = tui_screen_text(&out);
    const ln: usize = bufx_cstr_len(lit);
    var k: usize = 0;
    var n: usize = 0;
    while k + ln <= out.len {
        if bufx_mem_eq(out.ptr + k, lit, ln) {
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

// 某一行里第一个非空格的显示列 + 该列的样式（断言「样式落在哪一段上」用）
fn tuis_md_first_styled(lit: &const byte, col: &usize, st: &u8) bool {
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, lit) {
            var out: Buf = buf_new(512);
            defer { buf_free(&out); }
            tui_row_text(r, &out);
            var i: usize = 0;
            while i < out.len && out.ptr[i] == 32 as byte {
                i = i + 1;
            }
            col[0] = tty_cols_between(out.ptr as &const byte, 0, i);
            st[0] = tui_row_style_at(r, col[0]);
            return true;
        }
        r = r + 1;
    }
    return false;
}

// 含 `row_lit` 的那一行里 `lit` 起始处的显示列（定位「某一小段」的样式）。
// 一并交回**行号** —— 拿 tui_nrows()-1 当「刚才那行」是错的（任务块/状态区都在下面）。
fn tuis_md_col_of(lit: &const byte, row_lit: &const byte, row: &usize, col: &usize) bool {
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, row_lit) {
            var out: Buf = buf_new(512);
            defer { buf_free(&out); }
            tui_row_text(r, &out);
            const ln: usize = bufx_cstr_len(lit);
            if out.len >= ln {
                var k: usize = 0;
                while k + ln <= out.len {
                    if bufx_mem_eq(out.ptr + k, lit, ln) {
                        row[0] = r;
                        col[0] = tty_cols_between(out.ptr as &const byte, 0, k);
                        return true;
                    }
                    k = k + 1;
                }
            }
        }
        r = r + 1;
    }
    return false;
}

// 把一段 markdown 装进转录并成帧（返回后屏幕上就是它）。
// 走 C 字符串口径：调用方给**字面量**；动态拼出来的 Buf 用 tuis_md_frame_n。
fn tuis_md_frame(cols: usize, rows: usize, md: &const byte) void {
    tuis_md_frame_n(cols, rows, md, bufx_cstr_len(md));
}

// ⚠ buf_new 是**裸 malloc**、缓冲区不保证有 NUL 结尾，拿 bufx_cstr_len 去量动态拼出来的
// 夹具会一路读到堆尾巴（§16 踩坑 57/67 同款）。动态夹具一律走这个带长度的入口。
fn tuis_md_frame_n(cols: usize, rows: usize, md: &const byte, n: usize) void {
    tuis_reset(cols, rows);
    tui_sink_bytes(1, md, n);
    tui_close_stream_entries();
    tui_build();
}

// ---- A) 行内强调 ----
fn tuis_md_inline_case(tag: &const byte, ok: &bool) void {
    const md: &const byte = "PTEXT **BOLD** 斜 *ALPHA* 删 ~~GONE~~ 码 `raw` 链 [LBL](https://ex.example/p)\n\nASCII **粗** 混排\n" as &const byte;
    tuis_md_frame(100, 30, md);
    tuis_scan_rows(100, ok, tag);
    var col: usize = 0;
    var st: u8 = 0;
    // 标记符号本身不许上屏（这是「渲染了」最直接的判据）
    if tuis_screen_has("**" as &const byte) || tuis_screen_has("~~" as &const byte) {
        tuis_fail(tag, "行内标记 `**` / `~~` 原样上屏了（没渲染）", ok);
    }
    if !tuis_screen_has("(https://ex.example/p)" as &const byte) {
        tuis_fail(tag, "链接地址没有画出来", ok);
    }
    if tuis_screen_has("[LBL]" as &const byte) {
        tuis_fail(tag, "链接的方括号原样上屏了（应当只剩文字 + 地址）", ok);
    }
    if !tuis_md_first_styled("PTEXT" as &const byte, &col, &st) {
        tuis_fail(tag, "正文行没上屏", ok);
    } else if st != TUI_ST_DEFAULT {
        tuis_fail(tag, "普通正文的样式不是默认（样式串味到行首了）", ok);
    }
    var row: usize = 0;
    if !tuis_md_col_of("BOLD" as &const byte, "PTEXT" as &const byte, &row, &col) {
        tuis_fail(tag, "粗体文字没上屏", ok);
    } else if tui_row_style_at(row, col) != TUI_ST_BOLD {
        tuis_fail(tag, "**粗体** 没有落到 BOLD 样式上", ok);
    }
    if !tuis_md_col_of("ALPHA" as &const byte, "PTEXT" as &const byte, &row, &col) {
        tuis_fail(tag, "斜体文字没上屏", ok);
    } else if tui_row_style_at(row, col) != TUI_ST_ITALIC {
        tuis_fail(tag, "**斜体** 没有落到 ITALIC 样式上", ok);
    }
    if !tuis_md_col_of("GONE" as &const byte, "PTEXT" as &const byte, &row, &col) {
        tuis_fail(tag, "删除线文字没上屏", ok);
    } else if tui_row_style_at(row, col) != TUI_ST_STRIKE {
        tuis_fail(tag, "~~删除线~~ 没有落到 STRIKE 样式上", ok);
    }
    if !tuis_md_col_of("raw" as &const byte, "PTEXT" as &const byte, &row, &col) {
        tuis_fail(tag, "行内 code 没上屏", ok);
    } else if tui_row_style_at(row, col) != TUI_ST_INLINE {
        tuis_fail(tag, "行内 `code` 没有落到 INLINE 样式上", ok);
    }
    if tuis_screen_has("`raw`" as &const byte) {
        tuis_fail(tag, "行内 code 的反引号原样上屏了", ok);
    }
    // 下划线不该吃掉 snake_case（行内扫描的经典误判）
    tuis_md_frame(100, 30, "调用 snake_case_name 与 __下划线粗__ 两种\n" as &const byte);
    if !tuis_screen_has("snake_case_name" as &const byte) {
        tuis_fail(tag, "snake_case 里的下划线被当成斜体标记吃掉了", ok);
    }
    if tuis_screen_has("__下划线粗__" as &const byte) {
        tuis_fail(tag, "__下划线粗__ 没有被认出是粗体", ok);
    }
}

// ---- B) 块级：标题 / 列表 / 任务清单 / 引用 / 分隔线 / 围栏 ----
fn tuis_md_block_case(tag: &const byte, ok: &bool) void {
    const md: &const byte = "# 一级标题\n\n## 二级标题\n\n正文\n\n- 无序一\n  - 嵌套二\n1. 有序一\n\n- [x] 做完的\n- [ ] 没做的\n\n> 引用一行\n\n---\n\n```uya\nCODEINSIDE\n```\n\n收尾\n" as &const byte;
    tuis_md_frame(100, 40, md);
    tuis_scan_rows(100, ok, tag);
    var col: usize = 0;
    var st: u8 = 0;
    // 标题：去 # 号 + 分级样式
    if tuis_screen_has("# " as &const byte) || tuis_screen_has("##" as &const byte) {
        tuis_fail(tag, "标题的 # 号原样上屏了（没去标记）", ok);
    }
    if !tuis_md_first_styled("一级标题" as &const byte, &col, &st) {
        tuis_fail(tag, "一级标题没上屏", ok);
    } else if st != TUI_ST_H1 {
        tuis_fail(tag, "一级标题的样式不是 H1", ok);
    }
    if !tuis_md_first_styled("二级标题" as &const byte, &col, &st) {
        tuis_fail(tag, "二级标题没上屏", ok);
    } else if st != TUI_ST_BOLD {
        tuis_fail(tag, "二级标题的样式不是 BOLD（H2 档）", ok);
    }
    // 列表：标记换成字形，序号保留
    if !tuis_screen_has("· 无序一" as &const byte) {
        tuis_fail(tag, "无序列表项的 `· ` 字形不对", ok);
    }
    if !tuis_screen_has("· 嵌套二" as &const byte) {
        tuis_fail(tag, "嵌套列表项没有缩进后画出", ok);
    }
    if !tuis_screen_has("1. 有序一" as &const byte) {
        tuis_fail(tag, "有序列表项的序号不对", ok);
    }
    if !tuis_screen_has("✓ 做完的" as &const byte) || !tuis_screen_has("· 没做的" as &const byte) {
        tuis_fail(tag, "任务清单的 `[x]` / `[ ]` 没有换成 ✓ / ·", ok);
    }
    if tuis_screen_has("[x]" as &const byte) || tuis_screen_has("[ ]" as &const byte) {
        tuis_fail(tag, "任务清单的方括号原样上屏了", ok);
    }
    if !tuis_screen_has("▏ 引用一行" as &const byte) {
        tuis_fail(tag, "引用的 `▏ ` 前缀不对", ok);
    }
    if tuis_screen_has("> 引用" as &const byte) {
        tuis_fail(tag, "引用的 `>` 原样上屏了", ok);
    }
    // 分隔线：整行 `─`（≥3 个就算分隔线）
    if !tuis_screen_has("─────" as &const byte) {
        tuis_fail(tag, "分隔线没画出来", ok);
    }
    // 围栏：开/闭标记不画、语言标签画、块内是代码样式
    if tuis_screen_has("```" as &const byte) {
        tuis_fail(tag, "代码围栏的 ``` 原样上屏了", ok);
    }
    if !tuis_screen_has("uya" as &const byte) {
        tuis_fail(tag, "围栏的语言标签没画出来", ok);
    }
    if !tuis_md_style_of_row("CODEINSIDE" as &const byte, TUI_ST_CODE) {
        tuis_fail(tag, "围栏里的代码没有落到 CODE 样式上", ok);
    }
    // 围栏之后的普通正文不许还带着代码样式
    if !tuis_md_style_of_row("收尾" as &const byte, TUI_ST_DEFAULT) {
        tuis_fail(tag, "围栏闭了之后的正文还带着代码样式（围栏状态没复位）", ok);
    }
}

// 某行里 `lit` 处的样式是不是 st
fn tuis_md_style_of_row(lit: &const byte, st: u8) bool {
    var row: usize = 0;
    var col: usize = 0;
    if !tuis_md_col_of(lit, lit, &row, &col) {
        return false;
    }
    return tui_row_style_at(row, col) == st;
}

// ---- C) 「不丢字」回归（旧实现的硬伤 ①）----
fn tuis_md_nowrap_case(tag: &const byte, ok: &bool) void {
    var w: usize = 60;
    while w <= 100 {
        // 代码块里 100 个连续 Q（没有任何空格可断）
        var md: Buf = buf_new(4096);
        defer { buf_free(&md); }
        _ = buf_append_cstr(&md, "```\n");
        var i: usize = 0;
        while i < 100 {
            _ = buf_append_cstr(&md, "Q");
            i = i + 1;
        }
        _ = buf_append_cstr(&md, "\n```\n");
        // 正文里 100 个连续 Z
        i = 0;
        while i < 100 {
            _ = buf_append_cstr(&md, "Z");
            i = i + 1;
        }
        _ = buf_append_cstr(&md, "\n");
        // 正文里 60 个连续汉字（宽字符，最容易在边界上被砍）
        i = 0;
        while i < 60 {
            _ = buf_append_cstr(&md, "汉");
            i = i + 1;
        }
        _ = buf_append_cstr(&md, "\n");
        tuis_md_frame_n(w, 40, md.ptr as &const byte, md.len);
        tuis_scan_rows(w, ok, tag);
        const q: usize = tuis_md_count_byte(81 as byte);
        const z: usize = tuis_md_count_byte(90 as byte);
        const h: usize = tuis_md_count_lit("汉" as &const byte);
        if q != 100 {
            tuis_fail(tag, "代码块里的 100 个字符没有全部上屏（丢了字）", ok);
            tuis_puts("  cols=" as &const byte);
            tuis_num(w);
            tuis_puts(" Q=" as &const byte);
            tuis_num(q);
            tuis_puts("\n" as &const byte);
        }
        if z != 100 {
            tuis_fail(tag, "正文里的 100 个字符没有全部上屏（丢了字）", ok);
        }
        if h != 60 {
            tuis_fail(tag, "正文里的 60 个汉字没有全部上屏（丢了字）", ok);
            tuis_puts("  cols=" as &const byte);
            tuis_num(w);
            tuis_puts(" 汉=" as &const byte);
            tuis_num(h);
            tuis_puts("\n" as &const byte);
        }
        // 没被裁就不该出现 '…'（旧实现在这里每行稳定补一个）。
        // 注意**只看那几行的文本**：整屏的 '…' 还会来自脚注缩略与任务块的「还有 N 行」，
        // 拿整屏做判据是假红（第一版就是这么红的）。
        if tuis_md_row_has_ellipsis("QQQQ" as &const byte) {
            tuis_fail(tag, "代码行没有被裁却补了 '…'（预算算小了）", ok);
        }
        if tuis_md_row_has_ellipsis("ZZZZ" as &const byte) {
            tuis_fail(tag, "正文行没有被裁却补了 '…'（预算算小了）", ok);
        }
        if tuis_md_row_has_ellipsis("汉汉汉" as &const byte) {
            tuis_fail(tag, "汉字行没有被裁却补了 '…'（预算算小了）", ok);
        }
        w = w + 20;
    }
}

// ---- D) 滚到代码块中间，样式不许串（旧实现的硬伤 ②）----
fn tuis_md_fence_state_case(tag: &const byte, ok: &bool) void {
    var md: Buf = buf_new(8192);
    defer { buf_free(&md); }
    var i: usize = 0;
    while i < 4 {
        _ = buf_append_cstr(&md, "前言 ");
        _ = buf_append_u64(&md, (i + 1) as u64);
        _ = buf_append_cstr(&md, "\n");
        i = i + 1;
    }
    _ = buf_append_cstr(&md, "```\n");
    i = 0;
    while i < 30 {
        _ = buf_append_cstr(&md, "CBLOCK");
        _ = buf_append_u64(&md, (i + 1) as u64);
        _ = buf_append_cstr(&md, "\n");
        i = i + 1;
    }
    _ = buf_append_cstr(&md, "```\n");
    i = 0;
    while i < 6 {
        _ = buf_append_cstr(&md, "后继正文 ");
        _ = buf_append_u64(&md, (i + 1) as u64);
        _ = buf_append_cstr(&md, "\n");
        i = i + 1;
    }
    tuis_md_frame_n(80, 60, md.ptr as &const byte, md.len);
    // 贴尾：代码行是代码样式、后继正文是默认样式
    if !tuis_md_style_of_row("CBLOCK30" as &const byte, TUI_ST_CODE) {
        tuis_fail(tag, "贴尾时代码行没有代码样式", ok);
    }
    if !tuis_md_style_of_row("后继正文 1" as &const byte, TUI_ST_DEFAULT) {
        tuis_fail(tag, "贴尾时围栏之后的正文不是默认样式", ok);
    }
    // 往上滚，让窗口落在代码块**中间**（开围栏与 `前言` 都已经在窗口之上、
    // 闭合围栏与后继正文还在窗口之内）
    tui_scroll_up(12);
    tui_build();
    tuis_scan_rows(80, ok, tag);
    if !tuis_screen_has("CBLOCK" as &const byte) {
        tuis_fail(tag, "往上滚之后代码块看不见了（这一段的断言就没意义了）", ok);
    }
    if !tuis_md_style_of_row("CBLOCK10" as &const byte, TUI_ST_CODE) {
        tuis_fail(tag, "窗口落在代码块中间时代码行掉了样式（旧的帧级围栏状态）", ok);
    }
    // 闭合围栏不许再被当成「开始」（旧实现会把之后的正文整段染成代码样式）
    if !tuis_screen_has("后继正文" as &const byte) {
        tuis_fail(tag, "往上滚之后后继正文看不见了", ok);
    }
    if !tuis_md_style_of_row("后继正文 6" as &const byte, TUI_ST_DEFAULT) {
        tuis_fail(tag, "闭合围栏被当成了开始（后继正文被染成代码样式）", ok);
    }
    tui_scroll_end();
    tui_build();
}

// ---- E) 表格 ----
fn tuis_md_table_case(tag: &const byte, ok: &bool) void {
    const md: &const byte = "| 名字 | 说明 | 数量 |\n| --- | :---: | ---: |\n| a | 短 | 1 |\n| 很长的名字啊 | 一段很长很长的说明文字 | 22 |\n" as &const byte;
    tuis_md_frame(100, 30, md);
    tuis_scan_rows(100, ok, tag);
    var col: usize = 0;
    var st: u8 = 0;
    if !tuis_screen_has("名字" as &const byte) {
        tuis_fail(tag, "表头没上屏", ok);
    }
    if !tuis_md_style_of_row("名字" as &const byte, TUI_ST_BOLD) {
        tuis_fail(tag, "表头单元格的样式不是 BOLD", ok);
    }
    if !tuis_md_style_of_row("│" as &const byte, TUI_ST_DIM) {
        tuis_fail(tag, "表格框线不是 DIM（框线与单元格内容要分得开）", ok);
    }
    if tuis_screen_has("| --- |" as &const byte) {
        tuis_fail(tag, "表格的分隔行原样上屏了（没画成框线）", ok);
    }
    if !tuis_screen_has("├" as &const byte) || !tuis_screen_has("┼" as &const byte) {
        tuis_fail(tag, "表格的框线字形没画出来", ok);
    }
    if !tuis_screen_has("很长的名字啊" as &const byte) {
        tuis_fail(tag, "表格单元格内容丢了", ok);
    }
    if !tuis_md_style_of_row("很长的名字啊" as &const byte, TUI_ST_TOOL) {
        tuis_fail(tag, "表格正文单元格的样式不对", ok);
    }
    // 表格每一行的显示列必须一致（列宽算错就会参差）
    var widths: [usize: 8] = [0: 8];
    var nw: usize = 0;
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, "│" as &const byte) && tui_row_has(r, "├" as &const byte) == false {
            if tui_row_has(r, "名字" as &const byte) || tui_row_has(r, "很长的名字啊" as &const byte) || tui_row_has(r, "a " as &const byte) {
                if nw < 8 {
                    widths[nw] = tui_row_cols_n(r) - tui_row_cols_n_lead(r);
                    nw = nw + 1;
                }
            }
        }
        r = r + 1;
    }
    if nw >= 2 {
        var k: usize = 1;
        while k < nw {
            if widths[k] != widths[0] {
                tuis_fail(tag, "表格各行的显示宽度不一致（列宽算错）", ok);
                break;
            }
            k = k + 1;
        }
    }
    // 窄终端：列宽收到下限（每列 3）还放不下 ⇒ **整块退回普通行**（内容一个字节都不丢）。
    // 3 列的最小需求是 3*3+3*3+1 = 19 列，终端最窄 32 列，所以 3 列的表格永远放得下 ——
    // 要逼出退化得用列数更多的表格（8 列最小需求 49 列）。
    const wide: &const byte = "| c1 | c2 | c3 | c4 | c5 | c6 | c7 | c8 |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| UNIQUECELL | b | c | d | e | f | g | h |\n" as &const byte;
    tuis_md_frame(40, 30, wide);
    tuis_scan_rows(40, ok, tag);
    if !tuis_screen_has("UNIQUECELL" as &const byte) {
        tuis_fail(tag, "放不下时退回普通行却丢了内容", ok);
    }
    if tuis_screen_has("├" as &const byte) {
        tuis_fail(tag, "40 列下 8 列表格本该退回普通行，却还是画了框线", ok);
    }
}

// 一行的显示列（从行首到最后一个非空格列）—— 表格对齐断言用
fn tui_row_cols_n_lead(r: usize) usize {
    var out: Buf = buf_new(512);
    defer { buf_free(&out); }
    tui_row_text(r, &out);
    const full: usize = tty_cols_between(out.ptr as &const byte, 0, out.len);
    var i: usize = out.len;
    while i > 0 && (out.ptr[i - 1] == 32 as byte) {
        i = i - 1;
    }
    const body: usize = tty_cols_between(out.ptr as &const byte, 0, i);
    if full >= body {
        return full - body;
    }
    return 0;
}

// ---- F) 浮层（reader）也走同一份 markdown ----
fn tuis_md_overlay_case(tag: &const byte, ok: &bool) void {
    const plan: &const byte = "# 计划标题\n\n- **要点一**\n- 要点二\n\n```uya\nPlanCodeLine\n```\n\n| 列 |\n| --- |\n| 值 |\n" as &const byte;
    tuis_reset(100, 30);
    tui_overlay_reader(TUI_OVK_PLAN, "计划" as &const byte, bufx_cstr_len("计划" as &const byte),
        plan, bufx_cstr_len(plan), "继续讨论\n解决\n确认执行\n" as &const byte,
        bufx_cstr_len("继续讨论\n解决\n确认执行\n" as &const byte), 0);
    if !tui_overlay_open() {
        tuis_fail(tag, "审阅浮层没有打开", ok);
        return;
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("│ 计划标题" as &const byte) {
        tuis_fail(tag, "浮层正文的标题没有按 markdown 渲染（还带着 #）", ok);
    }
    if tuis_screen_has("│ # " as &const byte) {
        tuis_fail(tag, "浮层正文里的 # 号没有被去掉", ok);
    }
    if tuis_screen_has("**要点一**" as &const byte) {
        tuis_fail(tag, "浮层正文里的 **粗体** 标记原样上屏了", ok);
    }
    if !tuis_screen_has("PlanCodeLine" as &const byte) {
        tuis_fail(tag, "浮层里的代码块正文没画出来", ok);
    }
    // 方框逐行闭合（既有不变量：右边框必须在同一列）
    tuis_overlay_frame_check(100, ok, tag);
    tui_overlay_close();
    tuis_reset(100, 30);
}

// ---- G) 长条目的取行必须是 O(1)（本轮修的「重绘卡死」）----
//
// 症状：一个几 MiB 的长助手条目进转录之后，**每一帧**都要几秒（贴尾也一样），
// 滚轮/思考行的重绘把界面拖死。根因：条目取行 `tui_entry_line(i, k)` 为取第 k 行
// 从 wrap 头部**重新扫一遍**，draw 循环对每个可见行都调一次 ⇒ O(条目 × 可见行)。
// 这与踩坑 68 的 `/sessions` 卡顿是同一族，条目这条路当时漏了。
//
// 判据三条，缺一不可：
//   ① **差分**：查表路径与线性扫描路径对同一 (i, k) 逐字节一致（表算对了吗）；
//   ② **预算**：大条目贴尾那一帧 + 上翻 20 屏的墙钟都远低于上限（真的 O(1) 吗）；
//   ③ 不变量：那些帧里正文层无 ESC / 无 NUL、每行 ≤ cols。
fn tuis_md_bigcase(tag: &const byte, ok: &bool) void {
    // 一份 ~194 KiB 的 markdown 正文（约 5400 折行行），灌 12 遍 ⇒ ~2.3 MiB / 12 个条目
    var md: Buf = buf_new(262144);
    defer { buf_free(&md); }
    var i: usize = 0;
    while i < 900 {
        _ = buf_append_cstr(&md, "### 小节 ");
        _ = buf_append_u64(&md, i as u64);
        _ = buf_append_cstr(&md, "\n\n这是第 ");
        _ = buf_append_u64(&md, i as u64);
        _ = buf_append_cstr(&md, " 段正文，带 **粗体** 与 `code` 与 [链接](https://example.com/path)。\n\n- 项目一\n- 项目二 `x`\n\n| 列A | 列B |\n| --- | ---: |\n| 值 | 1 |\n\n```uya\nconst X: usize = 1;\n```\n\n");
        i = i + 1;
    }
    tuis_reset(80, 40);
    var n: usize = 0;
    while n < 12 {
        tui_sink_bytes(1, md.ptr as &const byte, md.len);
        tui_close_stream_entries();
        n = n + 1;
    }
    // ① **首帧就是最贵的那一帧**（折行 + 建表都在这一帧里做）：先量它，别被后面的
    //    差分/滚动步骤先把缓存捂热了 —— 否则这条预算就成了摆设（第一版就是这么假绿的）。
    const t0: u64 = ua_now_ms();
    tui_build();
    const first: u64 = ua_now_ms() - t0;

    // ② 差分对照：查表 vs 线性扫描，逐行逐字节相同
    const li: usize = tui_entries_count() - 1;
    const rows: usize = tui_entry_wrap_lines(li);
    if rows < 100 {
        tuis_fail(tag, "长条目的折行行数太少（夹具不对，这一段的断言没意义）", ok);
        tuis_puts("  rows=" as &const byte);
        tuis_num(rows);
        tuis_puts(" entries=" as &const byte);
        tuis_num(tui_entries_count());
        tuis_puts("\n" as &const byte);
        return;
    }
    var k: usize = 0;
    while k < rows {
        var o1: usize = 0;
        var l1: usize = 0;
        var o2: usize = 0;
        var l2: usize = 0;
        const a: bool = tui_entry_line(li, k, &o1, &l1);
        const b: bool = tui_entry_line_lin(li, k, &o2, &l2);
        if a != b || l1 != l2 {
            tuis_fail(tag, "条目取行：查表与线性扫描给出的结果不一致", ok);
            tuis_puts("  k=" as &const byte);
            tuis_num(k);
            tuis_puts(" idx=" as &const byte);
            tuis_num(l1);
            tuis_puts(" lin=" as &const byte);
            tuis_num(l2);
            tuis_puts("\n" as &const byte);
            return;
        }
        k = k + 1;
    }
    // ③ 预算：缓存帧 + 上翻 20 屏
    const t1: u64 = ua_now_ms();
    tui_build();
    const cached: u64 = ua_now_ms() - t1;
    const t2: u64 = ua_now_ms();
    var sg: usize = 0;
    while sg < 20 {
        tui_scroll_up(40);
        tui_build();
        sg = sg + 1;
    }
    const scroll: u64 = ua_now_ms() - t2;
    tuis_scan_rows(80, ok, tag);
    // 上限刻意放得很松（修前实测：首帧 4774 ms、缓存帧 4425 ms、20 次上翻 86532 ms；
    // 修后：340 / 1 / 17 ms）。松上限是为了在慢机器上不假红，同时仍能把「线性扫描」
    // 那一档（几秒级）稳稳判死。
    if first > 4000 {
        tuis_fail(tag, "长条目首帧太慢（取行不是 O(1)？）", ok);
        tuis_puts("  实测 ms = " as &const byte);
        tuis_num(first as usize);
        tuis_puts("\n" as &const byte);
    }
    if cached > 1000 {
        tuis_fail(tag, "长条目缓存帧太慢（每帧都在重扫 wrap？）", ok);
        tuis_puts("  实测 ms = " as &const byte);
        tuis_num(cached as usize);
        tuis_puts("\n" as &const byte);
    }
    if scroll > 8000 {
        tuis_fail(tag, "长条目上翻 20 屏太慢（取行不是 O(1)）", ok);
        tuis_puts("  实测 ms = " as &const byte);
        tuis_num(scroll as usize);
        tuis_puts("\n" as &const byte);
    }
    if ok[0] {
        tuis_puts("selftest[tui-md] 长条目：首帧 " as &const byte);
        tuis_num(first as usize);
        tuis_puts(" ms / 缓存帧 " as &const byte);
        tuis_num(cached as usize);
        tuis_puts(" ms / 上翻 20 屏 " as &const byte);
        tuis_num(scroll as usize);
        tuis_puts(" ms（" as &const byte);
        tuis_num(rows);
        tuis_puts(" 折行行 × 12 条目）\n" as &const byte);
    }
}

// tui-markdown 轮：inline / block / 不折行 / fence 状态 / 表格五种形态的渲染与折行。
// 直接 view_init 建帧不跑 agent；返回 false = 本轮红。
fn tui_md_round(tag: &const byte) bool {
    var ok: bool = true;
    view_init(true, 0);       // 直接建帧，不跑 agent
    tuis_md_inline_case(tag, &ok);
    tuis_md_block_case(tag, &ok);
    tuis_md_nowrap_case(tag, &ok);
    tuis_md_fence_state_case(tag, &ok);
    tuis_md_table_case(tag, &ok);
    tuis_md_overlay_case(tag, &ok);
    tuis_md_bigcase(tag, &ok);
    if ok {
        tuis_ok(tag, "markdown：行内强调/标题分级/列表与任务清单/引用/分隔线/围栏（含语言标签）/表格（列宽与对齐/窄终端退回）+ 长行不丢字（60·80·100 列逐字符）+ 滚到代码块中间样式不串 + 浮层共用同一份 + 长条目取行 O(1)（查表 vs 扫描差分 + 成帧预算）");
    }
    return ok;
}

