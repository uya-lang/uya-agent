// src/selftest/st_wire.uya — 形状适配层（`web/wsess`）的离线自测轮
//
// 本文件：`wire_round`（轮次名 `wire-adapt`）—— 把**真的本仓日志行**喂给 `dwire_line`，
//   逐条检查译文：信封同形、`surfaceOp` 补齐、`id` 确定性派生、`content` 是块数组、
//   `tool/result` 包成 message、`turn/end` 的 reason 是对象、未知类型原样透传。
// 不变量：① 夹具用**日志写入端的真形状**（不是手抄的"理想形状"）—— 手抄会把
//   「读错字段」这类缺陷照抄成"正确"（本目录的踩坑 136 记过同族的教训：
//   纯函数轮自己抄一份正确的字节，被测的那份写错了照样绿）；
//   ② 断言按**逐字节包含**做（译文的键序由实现决定，不该被断言钉死）；
//   ③ 一个事件的译文必须是**一行**（以 `\n` 收尾，且中途没有裸换行）—— 这是消费者
//   按行解析的契约。
// 依赖：foundation/bufx、web/wsess（`dwire_line`）、session/session（`sess_*` 夹具用）。
// 命名：对外 `wire_round`；私有 `wr_*`；轮次名 `wire-adapt`。
//
// 行宽豁免：本轮的夹具行是**不可断的 JSON 字面量**（在中间换行会把被测的那行 JSON
// 拆坏，而「拆坏」正是这些断言要区分的东西）—— 与 `session.uya` 的日志夹具同一口径。

// 一条夹具行跑一遍适配，返回译文（失败时 out 为空）。
fn wr_adapt(line: &const byte, out: &Buf) bool {
    var l: Buf = buf_new(8192);
    defer { buf_free(&l); }
    if !buf_append_cstr(&l, line) {
        return false;
    }
    return dwire_line(&l, out);
}

// 译文里有没有 lit（逐字节）。
fn wr_has(out: &const Buf, lit: &const byte) bool {
    return bufx_contains(out, lit);
}

// 译文必须恰好一行（结尾 `\n` 且中间没有裸换行）。
fn wr_one_line(out: &const Buf, tag: &const byte, what: &const byte,
    ok: &bool) void {
    if out.len == 0 || out.ptr[out.len - 1] != 10 as byte {
        tuis_fail(tag, what, ok);
        return;
    }
    var i: usize = 0;
    while i + 1 < out.len {
        if out.ptr[i] == 10 as byte {
            tuis_fail(tag, what, ok);
            return;
        }
        i = i + 1;
    }
}

// 段 1：`user/message` —— 补 `surfaceOp` 与 `id`，`content` 保持块数组。
fn wr_check_user(tag: &const byte, ok: &bool) void {
    // 夹具逐字节抄自真实日志（见 build/ 下的 session.jsonl）
    const line: &const byte = "{\"type\":\"user/message\",\"seq\":0,\"time\":1791905924444,\"data\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"第一个长任务\"}],\"source\":{\"kind\":\"user\"}}}" as &const byte;
    var out: Buf = buf_new(8192);
    defer { buf_free(&out); }
    if !wr_adapt(line, &out) {
        tuis_fail(tag, "user/message 没翻译出来", ok);
        return;
    }
    wr_one_line(&out, tag, "user/message 的译文不是一行", ok);
    if !wr_has(&out, "\"type\":\"user/message\"" as &const byte) {
        tuis_fail(tag, "user/message 的类型名没保住", ok);
    }
    if !wr_has(&out, "\"seq\":0" as &const byte) {
        tuis_fail(tag, "user/message 的 seq 没搬过来", ok);
    }
    // DSH 的 fold 按 `surfaceOp` 判「进不进对话面」：缺了它这条**不渲染**。
    if !wr_has(&out, "\"surfaceOp\":\"append\"" as &const byte) {
        tuis_fail(tag, "user/message 没补 surfaceOp（DSH 那边这条不会渲染）", ok);
    }
    // 条目身份：缺了它 fold 没有去重键。
    if !wr_has(&out, "\"id\":\"m-0\"" as &const byte) {
        tuis_fail(tag, "user/message 没补确定性的 id", ok);
    }
    if !wr_has(&out, "\"content\":[{\"type\":\"text\"" as &const byte) {
        tuis_fail(tag, "user/message 的 content 不是块数组", ok);
    }
    if !wr_has(&out, "第一个长任务" as &const byte) {
        tuis_fail(tag, "user/message 的正文丢了", ok);
    }
    // 滚动/steer 那条（本仓会带 source.kind=steer）也要能过
    const st: &const byte = "{\"type\":\"user/message\",\"seq\":3,\"time\":9,\"data\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"插话\"}],\"source\":{\"kind\":\"steer\"}}}" as &const byte;
    buf_reset(&out);
    if !wr_adapt(st, &out) {
        tuis_fail(tag, "带 steer 来源的 user/message 没翻译出来", ok);
        return;
    }
    if !wr_has(&out, "\"kind\":\"steer\"" as &const byte) {
        tuis_fail(tag, "steer 的来源标记没搬过来", ok);
    }
    if !wr_has(&out, "\"id\":\"m-3\"" as &const byte) {
        tuis_fail(tag, "steer 那条的 id 不是按 seq 派生的", ok);
    }
}

// 段 2：`assistant/message` —— 字符串 content 要包成块数组，补 id/source/surfaceOp。
fn wr_check_assistant(tag: &const byte, ok: &bool) void {
    // 真形状：`message.content` 是**一整段字符串**（实测），不是我猜的块数组
    const line: &const byte = "{\"type\":\"assistant/message\",\"seq\":13,\"time\":1791905929075,\"data\":{\"turn\":2,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":\"SELFTEST_OK\"},\"usage\":{\"inputTokens\":11,\"outputTokens\":7}}}" as &const byte;
    var out: Buf = buf_new(8192);
    defer { buf_free(&out); }
    if !wr_adapt(line, &out) {
        tuis_fail(tag, "assistant/message 没翻译出来", ok);
        return;
    }
    wr_one_line(&out, tag, "assistant/message 的译文不是一行", ok);
    if !wr_has(&out, "\"type\":\"assistant/message\"" as &const byte) {
        tuis_fail(tag, "assistant/message 的类型名没保住", ok);
    }
    // DSH 要 `ContentBlock[]`：字符串必须包成 `[{type:"text",text:…}]`
    if !wr_has(&out, "\"content\":[{\"type\":\"text\",\"text\":\"SELFTEST_OK\"}]" as &const byte) {
        tuis_fail(tag, "assistant 的 content 没有包成块数组（DSH 那边渲染不出来）", ok);
    }
    if !wr_has(&out, "\"surfaceOp\":\"append\"" as &const byte) {
        tuis_fail(tag, "assistant/message 没补 surfaceOp", ok);
    }
    if !wr_has(&out, "\"id\":\"m-13\"" as &const byte) {
        tuis_fail(tag, "assistant/message 没补确定性的 id", ok);
    }
    // DSH 的 fold 必读 `message.source.kind`：缺了它当场抛错
    if !wr_has(&out, "\"source\":{\"kind\":\"model\"" as &const byte) {
        tuis_fail(tag, "assistant 的 message 没有 source（DSH 的 fold 会抛错）", ok);
    }
    if !wr_has(&out, "\"usage\":{\"inputTokens\":11" as &const byte) {
        tuis_fail(tag, "usage 没带上", ok);
    }
    // turn/step 也要在
    if !wr_has(&out, "\"turn\":2" as &const byte) || !wr_has(&out, "\"step\":1" as &const byte) {
        tuis_fail(tag, "assistant/message 的 turn/step 丢了", ok);
    }
}

// 段 3：`assistant/reasoning` —— 折进 assistant/message 的 reasoning 块。
// **读的是 `message.reasoning_content`**（不是 `data.text`）：读错字段会静默取到空串。
fn wr_check_reasoning(tag: &const byte, ok: &bool) void {
    const line: &const byte = "{\"type\":\"assistant/reasoning\",\"seq\":3,\"time\":1791905925496,\"data\":{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"reasoning_content\":\"先读再改\"}}}" as &const byte;
    var out: Buf = buf_new(8192);
    defer { buf_free(&out); }
    if !wr_adapt(line, &out) {
        tuis_fail(tag, "assistant/reasoning 没翻译出来", ok);
        return;
    }
    wr_one_line(&out, tag, "reasoning 的译文不是一行", ok);
    if !wr_has(&out, "\"type\":\"reasoning\",\"text\":\"先读再改\"" as &const byte) {
        tuis_fail(tag, "思考没有折成 reasoning 块（或读错了字段）", ok);
    }
    // DSH 的 fold 不认 `assistant/reasoning` 这个类型名 —— 必须换成它认识的
    if !wr_has(&out, "\"type\":\"assistant/message\"" as &const byte) {
        tuis_fail(tag, "思考那条没有折成 assistant/message（DSH 不认原类型）", ok);
    }
}

// 段 4：`tool/call`（字段同型，透传）与 `tool/result`（要包成 message）。
fn wr_check_tool(tag: &const byte, ok: &bool) void {
    const call: &const byte = "{\"type\":\"tool/call\",\"seq\":4,\"time\":1791934689920,\"data\":{\"turn\":1,\"step\":1,\"callId\":\"call_mem_0\",\"name\":\"read\",\"arguments\":\"{\\\"file_path\\\": \\\"README.md\\\"}\"}}" as &const byte;
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    if !wr_adapt(call, &out) {
        tuis_fail(tag, "tool/call 没翻译出来", ok);
        return;
    }
    wr_one_line(&out, tag, "tool/call 的译文不是一行", ok);
    if !wr_has(&out, "\"callId\":\"call_mem_0\"" as &const byte) {
        tuis_fail(tag, "tool/call 的 callId 丢了", ok);
    }
    if !wr_has(&out, "\"name\":\"read\"" as &const byte) {
        tuis_fail(tag, "tool/call 的工具名丢了", ok);
    }

    // tool/result：本仓是扁平的 content + callId；DSH 要 data.message.content[0] 是
    // tool-result 块、且 message.source.callId 有值。
    const res: &const byte = "{\"type\":\"tool/result\",\"seq\":5,\"time\":1791934689920,\"data\":{\"turn\":1,\"step\":1,\"callId\":\"call_mem_0\",\"content\":\"<path>README.md</path>\"}}" as &const byte;
    buf_reset(&out);
    if !wr_adapt(res, &out) {
        tuis_fail(tag, "tool/result 没翻译出来", ok);
        return;
    }
    wr_one_line(&out, tag, "tool/result 的译文不是一行", ok);
    if !wr_has(&out, "\"message\":{\"role\":\"user\",\"content\":[{\"type\":\"tool-result\"" as &const byte) {
        tuis_fail(tag, "tool/result 没有包成 message（DSH 读 data.message.content[0]）", ok);
    }
    if !wr_has(&out, "\"toolCallId\":\"call_mem_0\"" as &const byte) {
        tuis_fail(tag, "tool-result 块里没有 toolCallId", ok);
    }
    if !wr_has(&out, "\"source\":{\"kind\":\"tool\",\"callId\":\"call_mem_0\"}" as &const byte) {
        tuis_fail(tag, "tool/result 的 message.source.callId 没写上", ok);
    }
    if !wr_has(&out, "\"surfaceOp\":\"append\"" as &const byte) {
        tuis_fail(tag, "tool/result 没补 surfaceOp（它也在 DSH 的 surface 集合里）", ok);
    }
    if !wr_has(&out, "<path>README.md</path>" as &const byte) {
        tuis_fail(tag, "tool/result 的内容丢了", ok);
    }
}

// 段 5：`turn/end` 的 reason 要**从字符串变成对象**（DSH 读 reason.kind）。
fn wr_check_turn_end(tag: &const byte, ok: &bool) void {
    const ok_line: &const byte = "{\"type\":\"turn/end\",\"seq\":6,\"time\":1,\"data\":{\"turn\":1,\"reason\":\"completed\"}}" as &const byte;
    var out: Buf = buf_new(4096);
    defer { buf_free(&out); }
    if !wr_adapt(ok_line, &out) {
        tuis_fail(tag, "turn/end 没翻译出来", ok);
        return;
    }
    if !wr_has(&out, "\"reason\":{\"kind\":\"completed\"}" as &const byte) {
        tuis_fail(tag, "turn/end 的 reason 没有变成对象（DSH 读 reason.kind）", ok);
    }

    // aborted：DSH 的 TurnEndCancelCause 是必填的，所以要带内层 reason。
    const ab: &const byte = "{\"type\":\"turn/end\",\"seq\":7,\"time\":2,\"data\":{\"turn\":1,\"reason\":\"aborted\"}}" as &const byte;
    buf_reset(&out);
    if !wr_adapt(ab, &out) {
        tuis_fail(tag, "aborted 的 turn/end 没翻译出来", ok);
        return;
    }
    if !wr_has(&out, "\"kind\":\"aborted\"" as &const byte) {
        tuis_fail(tag, "aborted 没搬过来", ok);
    }
    if !wr_has(&out, "\"reason\":{\"kind\":\"user\"}" as &const byte) {
        tuis_fail(tag, "aborted 缺内层 reason（DSH 那边是必填字段）", ok);
    }

    // max-tokens / error 也要认（error 要带一个 LlmFailure）
    const mt: &const byte = "{\"type\":\"turn/end\",\"seq\":8,\"time\":3,\"data\":{\"turn\":1,\"reason\":\"max-tokens\"}}" as &const byte;
    buf_reset(&out);
    if !wr_adapt(mt, &out) || !wr_has(&out, "\"kind\":\"max-tokens\"" as &const byte) {
        tuis_fail(tag, "max-tokens 没搬过来", ok);
    }
    const er: &const byte = "{\"type\":\"turn/end\",\"seq\":9,\"time\":4,\"data\":{\"turn\":1,\"reason\":\"error\"}}" as &const byte;
    buf_reset(&out);
    if !wr_adapt(er, &out) {
        tuis_fail(tag, "error 的 turn/end 没翻译出来", ok);
    } else if !wr_has(&out, "\"error\":{\"message\"" as &const byte) {
        tuis_fail(tag, "error 分支缺 LlmFailure（DSH 那边必填）", ok);
    }
}

// 段 6：绑定与边界 —— header 不翻译、未知类型原样透传、不完整的尾行不产出。
fn wr_check_edges(tag: &const byte, ok: &bool) void {
    var out: Buf = buf_new(4096);
    defer { buf_free(&out); }
    // header 不是事件（会话元数据由 session.list 提供）
    const hdr: &const byte = "{\"type\":\"session\",\"version\":0,\"id\":\"session-x\",\"createdAt\":1,\"cwd\":\"/tmp\"}" as &const byte;
    if wr_adapt(hdr, &out) {
        tuis_fail(tag, "header 被当成事件翻译了", ok);
    }
    // 未知类型：原样透传（DSH 的 fold 对未知类型宽容，本仓的私有事件不该把流弄坏）
    const unk: &const byte = "{\"type\":\"session/worktree\",\"seq\":2,\"time\":5,\"data\":{\"path\":\"/w\"}}" as &const byte;
    if !wr_adapt(unk, &out) {
        tuis_fail(tag, "未知类型被丢掉了（应当原样透传）", ok);
    } else if !wr_has(&out, "session/worktree" as &const byte) {
        tuis_fail(tag, "未知类型透传时内容变了", ok);
    }
    // 本仓的 first-token / step 边界也要活着（它们是 DSH 认得的类型名，原样过）
    const fs: &const byte = "{\"type\":\"assistant/first-token\",\"seq\":4,\"time\":6,\"data\":{\"turn\":1,\"step\":1}}" as &const byte;
    buf_reset(&out);
    if !wr_adapt(fs, &out) {
        tuis_fail(tag, "assistant/first-token 没透传", ok);
    }
    // 空行 / 非 JSON：不该产出（返回 false 而不是写坏一行）
    var empty: Buf = buf_new(8);
    defer { buf_free(&empty); }
    if dwire_line(&empty, &out) {
        tuis_fail(tag, "空行居然翻译出了东西", ok);
    }
    const junk: &const byte = "not json at all" as &const byte;
    buf_reset(&out);
    if wr_adapt(junk, &out) {
        tuis_fail(tag, "非 JSON 行居然翻译出了东西", ok);
    }
}

// 段 7：**确定性** —— 同一行翻译两次必须逐字节相同（id 是按 seq 派生的，不用随机数）。
fn wr_check_determinism(tag: &const byte, ok: &bool) void {
    const line: &const byte = "{\"type\":\"user/message\",\"seq\":42,\"time\":7,\"data\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"再来一次\"}],\"source\":{\"kind\":\"user\"}}}" as &const byte;
    var a: Buf = buf_new(4096);
    defer { buf_free(&a); }
    var b: Buf = buf_new(4096);
    defer { buf_free(&b); }
    if !wr_adapt(line, &a) || !wr_adapt(line, &b) {
        tuis_fail(tag, "同一条日志翻译两次有一次失败", ok);
        return;
    }
    if a.len != b.len || !bufx_mem_eq(a.ptr as &const byte, b.ptr as &const byte, a.len) {
        tuis_fail(tag, "同一条日志翻译两次结果不同（id 用了随机数？）", ok);
    }
}

// 段 8：转义 —— 正文里的引号/换行不能让译文变成两行。
fn wr_check_escape(tag: &const byte, ok: &bool) void {
    // 夹具：正文含转义过的引号与换行（日志写入端就是这么写的）
    const line: &const byte = "{\"type\":\"user/message\",\"seq\":1,\"time\":8,\"data\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"引号\\\"与换行\\n都在\"}],\"source\":{\"kind\":\"user\"}}}" as &const byte;
    var out: Buf = buf_new(8192);
    defer { buf_free(&out); }
    if !wr_adapt(line, &out) {
        tuis_fail(tag, "带转义的 user/message 没翻译出来", ok);
        return;
    }
    // 必须仍然是一行（正文里的换行在 JSON 里必须是 `\n` 两个字符，不是裸换行）
    wr_one_line(&out, tag, "带换行的正文把译文拆成了多行", ok);
    if !wr_has(&out, "引号\\\"与换行\\n都在" as &const byte) {
        tuis_fail(tag, "转义没保住（引号/换行）", ok);
    }
}

// 把一条夹具的译文写进 `out`（给**外部**校验用：`make wire-schema` 拿它喂 DSH 的真
// zod schema）。返回 false = 这行没翻译出来。
// 为什么要有这个出口：本轮的断言都是**子串**判据，而「JSON 结构坏掉」可以完全绕过
// 它们（实测抓到过两种：`…"time":1{` 少个引号、`"data":{{` 多个花括号 —— 子串全中，
// 只有真 schema 校验才判红）。所以「形状对不对」这条判据**必须有外部 oracle**。
export fn wire_dump_one(line: &const byte, out: &Buf) bool {
    return wr_adapt(line, out);
}

// 夹具行（与各段用的同一份），供外部校验逐条取用。`i` 越界返回 false。
export fn wire_fixture(i: usize, out: &Buf) bool {
    buf_reset(out);
    if i == 0 {
        return buf_append_cstr(out, "{\"type\":\"user/message\",\"seq\":0,\"time\":1,\"data\":{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"第一个长任务\"}],\"source\":{\"kind\":\"user\"}}}");
    }
    if i == 1 {
        return buf_append_cstr(out, "{\"type\":\"assistant/message\",\"seq\":13,\"time\":2,\"data\":{\"turn\":2,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":\"SELFTEST_OK\"},\"usage\":{\"inputTokens\":11,\"outputTokens\":7}}}");
    }
    if i == 2 {
        return buf_append_cstr(out, "{\"type\":\"assistant/reasoning\",\"seq\":3,\"time\":3,\"data\":{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"reasoning_content\":\"先读再改\"}}}");
    }
    if i == 3 {
        return buf_append_cstr(out, "{\"type\":\"tool/result\",\"seq\":5,\"time\":4,\"data\":{\"turn\":1,\"step\":1,\"callId\":\"call_mem_0\",\"content\":\"<path>README.md</path>\"}}");
    }
    if i == 4 {
        return buf_append_cstr(out, "{\"type\":\"tool/call\",\"seq\":4,\"time\":5,\"data\":{\"turn\":1,\"step\":1,\"callId\":\"call_mem_0\",\"name\":\"read\",\"arguments\":\"{}\"}}");
    }
    if i == 5 {
        return buf_append_cstr(out, "{\"type\":\"turn/end\",\"seq\":6,\"time\":6,\"data\":{\"turn\":1,\"reason\":\"completed\"}}");
    }
    if i == 6 {
        return buf_append_cstr(out, "{\"type\":\"turn/end\",\"seq\":7,\"time\":7,\"data\":{\"turn\":1,\"reason\":\"aborted\"}}");
    }
    if i == 7 {
        return buf_append_cstr(out, "{\"type\":\"turn/end\",\"seq\":8,\"time\":8,\"data\":{\"turn\":1,\"reason\":\"error\"}}");
    }
    return false;
}

// 夹具条数。
export fn wire_fixture_count() usize {
    return 8;
}

// 整轮：八段各跑各的，**不早退**。
export fn wire_round(tag: &const byte) bool {
    var ok: bool = true;
    wr_check_user(tag, &ok);
    wr_check_assistant(tag, &ok);
    wr_check_reasoning(tag, &ok);
    wr_check_tool(tag, &ok);
    wr_check_turn_end(tag, &ok);
    wr_check_edges(tag, &ok);
    wr_check_determinism(tag, &ok);
    wr_check_escape(tag, &ok);
    if ok {
        tuis_ok(tag, "形状适配：surfaceOp/id/content 块数组/tool message/reason 对象/透传/确定性/转义");
    }
    return ok;
}
