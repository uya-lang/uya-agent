// src/gitdiff.uya — /diff 浮窗（P22）：git 修改的文件列表 + 旧/新两栏全文比对
//
// 分工：
//   * 数据来源是 `gitx`（只读 fork git）：status 出文件列表、diff 出统一差异；
//   * 本模块负责「git 的输出 → 可渲染的行表」：解析 unified diff，把删块/增块**配对**成
//     左右两栏的一行（MIX），上下文行两侧同文（CTX），落单的删/增各占一侧（DEL/ADD）；
//   * 渲染（列宽、边框、截断）在 tui.uya，本模块只提供指针 + 长度（不复制正文）。
//
// 为什么用 git 的 unified diff 而不是自己算：`-U100000` 让「整份文件」成为上下文，
// 于是两栏对齐只需要把删块与后续增块配对 —— 不必把 diffx 那套 60×60 的 LCS 上限
// 硬套到整文件上，二进制判定 / mode 变更 / 无换行结尾这些边界也都由 git 处理。
//
// 只读承诺：只用 status / diff / rev-parse，绝不 add / stash / commit；环境里带
// GIT_OPTIONAL_LOCKS=0（status 不写 index.lock），见 gitx.uya。
//
// 上限（都写进 README 的已知限制）：列表 400 文件、单文件 diff 抓取 512 KiB、
// 行表 8192 行、一次增/删块配对 4096 行（超过就放弃配对，但内容一行不丢）。
//
// 行表里的指针指向**最近一次解析的文本**，下一次 gd_open/gd_move/gd_refresh/
// gd_parse_into 之后失效（渲染层每帧现取，不缓存）。

use libc.syscall;

export const GD_MAX_FILES: usize = 400;
export const GD_MAX_ROWS: usize = 8192;
export const GD_MAX_DIFF: usize = 512 * 1024;
export const GD_FULL_CTX: usize = 100000;   // -U：事实上「整份文件」
export const GD_TXT_CTX: usize = 3;         // 截断回退 / 文本回退用的上下文
export const GD_RUN_MAX: usize = 4096;      // 一次增/删块的配对上限
export const GD_HSTEP: usize = 8;           // ←/→ 每次滚多少显示列
export const GD_TXT_MAX_LINES: usize = 400; // 文本回退的总行数上限
export const GD_TXT_FILE_LINES: usize = 120; // 文本回退里单个文件的行数上限
export const GD_TXT_FILES: usize = 20;      // 文本回退最多详列几个文件

export const GD_E_NOT_REPO: i32 = -1;
export const GD_E_NO_GIT: i32 = -2;
export const GD_E_SPAWN: i32 = -3;
export const GD_E_TIMEOUT: i32 = -4;

// 行类型：CTX = 两侧同文（上下文）；MIX = 左删右增（配对成功）；DEL/ADD = 只占一侧；HDR = 整行说明
export const GD_K_CTX: u8 = 0;
export const GD_K_MIX: u8 = 1;
export const GD_K_DEL: u8 = 2;
export const GD_K_ADD: u8 = 3;
export const GD_K_HDR: u8 = 4;

export struct GdRow {
    l_off: usize,
    l_len: usize,
    r_off: usize,
    r_len: usize,
    l_no: usize,
    r_no: usize,
    kind: u8,
}

struct GdRun {
    off: usize,
    len: usize,
    no: usize,
}

// ---- 状态（进程级：一个前台界面；幂等 ensure，自测用 gd_reset 隔离）----
var g_gd_ready: bool = false;
var g_gd_ws: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_gd_ws_z: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_gd_root: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_gd_root_z: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_gd_has_head: bool = false;
// 数据是真的是从 git 来的，还是 gd_load_fixture 注入的假数据（--tui-demo / 自测）。
// 假数据下不许去跑 git：没有仓库，`-C` 会指向未初始化的路径。
var g_gd_real: bool = false;
var g_gd_label: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_gd_files: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // 左列表显示行（"\n" 分隔）
var g_gd_paths: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // 路径原文（"\n" 分隔，与 files 行一一对应）
var g_gd_foff: [usize: GD_MAX_FILES] = [0: GD_MAX_FILES];
var g_gd_flen: [usize: GD_MAX_FILES] = [0: GD_MAX_FILES];
var g_gd_poff: [usize: GD_MAX_FILES] = [0: GD_MAX_FILES];
var g_gd_plen: [usize: GD_MAX_FILES] = [0: GD_MAX_FILES];
var g_gd_nfiles: usize = 0;
var g_gd_nstat: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // numstat 行（`<a>\t<d>\t<path>`）
var g_gd_sel: usize = 0;
var g_gd_scroll: usize = 0;
var g_gd_hscroll: usize = 0;
var g_gd_view: usize = 1;
var g_gd_rows: [GdRow: GD_MAX_ROWS] = [GdRow{
    l_off: 0, l_len: 0, r_off: 0, r_len: 0, l_no: 0, r_no: 0, kind: 0
}: GD_MAX_ROWS];
var g_gd_nrows: usize = 0;
var g_gd_rowcut: bool = false;
var g_gd_textp: &const byte = "" as &const byte;   // 最近一次解析的文本起点
var g_gd_added: usize = 0;
var g_gd_removed: usize = 0;
var g_gd_note: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_gd_err: Buf = Buf{ ptr: null, len: 0, cap: 0 };
// 草稿缓冲
var g_gd_out: Buf = Buf{ ptr: null, len: 0, cap: 0 };      // git stdout
var g_gd_status: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // status 的原始输出（-z）
var g_gd_errout: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // git stderr
var g_gd_pathz: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_gd_ctxz: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_gd_tmp: Buf = Buf{ ptr: null, len: 0, cap: 0 };
// 配对用的待结算块（描述符，不复制正文）
var g_gd_pd: [GdRun: GD_RUN_MAX] = [GdRun{ off: 0, len: 0, no: 0 }: GD_RUN_MAX];
var g_gd_pa: [GdRun: GD_RUN_MAX] = [GdRun{ off: 0, len: 0, no: 0 }: GD_RUN_MAX];
var g_gd_pdn: usize = 0;
var g_gd_pan: usize = 0;
var g_gd_pair_ok: bool = false;

fn gd_ensure() void {
    if g_gd_ready {
        return;
    }
    g_gd_ready = true;
    if !buf_valid(&g_gd_ws) { g_gd_ws = buf_new(4096); }
    if !buf_valid(&g_gd_ws_z) { g_gd_ws_z = buf_new(4104); }
    if !buf_valid(&g_gd_root) { g_gd_root = buf_new(4096); }
    if !buf_valid(&g_gd_root_z) { g_gd_root_z = buf_new(4104); }
    if !buf_valid(&g_gd_label) { g_gd_label = buf_new(256); }
    if !buf_valid(&g_gd_files) { g_gd_files = buf_new(32768); }
    if !buf_valid(&g_gd_paths) { g_gd_paths = buf_new(32768); }
    if !buf_valid(&g_gd_nstat) { g_gd_nstat = buf_new(32768); }
    if !buf_valid(&g_gd_note) { g_gd_note = buf_new(512); }
    if !buf_valid(&g_gd_err) { g_gd_err = buf_new(512); }
    if !buf_valid(&g_gd_out) { g_gd_out = buf_new(65536); }
    if !buf_valid(&g_gd_status) { g_gd_status = buf_new(65536); }
    if !buf_valid(&g_gd_errout) { g_gd_errout = buf_new(4096); }
    if !buf_valid(&g_gd_pathz) { g_gd_pathz = buf_new(4096); }
    if !buf_valid(&g_gd_ctxz) { g_gd_ctxz = buf_new(32); }
    if !buf_valid(&g_gd_tmp) { g_gd_tmp = buf_new(16384); }
}

// 自测隔离：清掉状态（缓冲留着复用，与 diffx_init 同口径）
export fn gd_reset() void {
    gd_ensure();
    g_gd_nfiles = 0;
    g_gd_nrows = 0;
    g_gd_sel = 0;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
    g_gd_view = 1;
    g_gd_added = 0;
    g_gd_removed = 0;
    g_gd_has_head = false;
    g_gd_real = false;
    g_gd_rowcut = false;
    g_gd_textp = "" as &const byte;
    buf_reset(&g_gd_files);
    buf_reset(&g_gd_paths);
    buf_reset(&g_gd_nstat);
    buf_reset(&g_gd_note);
    buf_reset(&g_gd_err);
    buf_reset(&g_gd_label);
    buf_reset(&g_gd_root);
}

// ============================================================
// 小工具
// ============================================================
fn gd_at(off: usize) &const byte {
    if (g_gd_textp as usize) == 0 {
        return "" as &const byte;
    }
    return @ptr_from_usize(@usize_from_ptr(g_gd_textp as &const void) + off) as &const byte;
}

fn gd_fat(off: usize) &const byte {
    return @ptr_from_usize(@usize_from_ptr(g_gd_files.ptr as &const void) + off) as &const byte;
}

fn gd_has(p: &const byte, n: usize, lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    if ln == 0 || n < ln {
        return false;
    }
    var i: usize = 0;
    while i + ln <= n {
        if bufx_mem_eq(p + i, lit, ln) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn gd_startswith(p: &const byte, n: usize, lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    if n < ln {
        return false;
    }
    if ln == 0 {
        return true;
    }
    return bufx_mem_eq(p, lit, ln);
}

// 一行：off/len 是去掉尾部 \r 的内容；next = 下一行的起点（>= n 表示到头）
fn gd_next_line(p: &const byte, n: usize, from: usize, off: &usize, len: &usize, next: &usize) bool {
    if from >= n {
        return false;
    }
    var i: usize = from;
    while i < n && p[i] != 10 as byte {
        i = i + 1;
    }
    off[0] = from;
    len[0] = i - from;
    next[0] = i + 1;
    if len[0] > 0 && p[from + len[0] - 1] == 13 as byte {
        len[0] = len[0] - 1;   // CRLF：别把 \r 显示成 '·'
    }
    return true;
}

// 一条以 NUL 结尾的记录（`--numstat -z` / `status -z` 的形状；末尾可能带一个 \n）
fn gd_next_z(p: &const byte, n: usize, from: usize, off: &usize, len: &usize, next: &usize) bool {
    if from >= n {
        return false;
    }
    var i: usize = from;
    while i < n && p[i] != 0 as byte {
        i = i + 1;
    }
    off[0] = from;
    len[0] = i - from;
    next[0] = i + 1;
    while len[0] > 0 {
        const c: byte = p[off[0] + len[0] - 1];
        if c == 10 as byte || c == 13 as byte {
            len[0] = len[0] - 1;
        } else {
            break;
        }
    }
    return true;
}

// 清洗 + 只留第一行 + 按显示列限长（给「人看的错误文案」用）
fn gd_set_err_text(p: &const byte, n: usize, fallback: &const byte) void {
    gd_ensure();
    buf_reset(&g_gd_tmp);
    var e: usize = 0;
    while e < n && p[e] != 10 as byte && p[e] != 13 as byte {
        e = e + 1;
    }
    tui_clean_into(&g_gd_tmp, p, e);
    buf_reset(&g_gd_err);
    const keep: usize = tty_clip_bytes(g_gd_tmp.ptr as &const byte, g_gd_tmp.len, 160);
    if keep > 0 {
        _ = buf_append(&g_gd_err, g_gd_tmp.ptr, keep);
    }
    if keep < g_gd_tmp.len {
        _ = buf_append_cstr(&g_gd_err, "…");
    }
    if g_gd_err.len == 0 {
        _ = buf_append_cstr(&g_gd_err, fallback);
    }
}

fn gd_set_err(fallback: &const byte) void {
    gd_ensure();
    buf_reset(&g_gd_err);
    _ = buf_append_cstr(&g_gd_err, fallback);
}

fn gd_err_fallback(rc: i32) &const byte {
    if rc == GITX_E_NO_GIT {
        return "找不到 git 可执行文件（/diff 需要 git 在 PATH 里）" as &const byte;
    }
    if rc == GITX_E_TIMEOUT {
        return "git 超时（已放弃这次查询）" as &const byte;
    }
    if rc == GITX_E_SPAWN {
        return "起不了 git 子进程" as &const byte;
    }
    return "git 命令失败" as &const byte;
}

fn gd_note_add(lit: &const byte) void {
    _ = buf_append_cstr(&g_gd_note, lit);
}

// ============================================================
// git 命令（argv 全是 C 字符串；cwd 交给 `git -C`，不 chdir）
// ============================================================
fn gd_arg_line(ctx_lines: usize) void {
    buf_reset(&g_gd_ctxz);
    _ = buf_append_cstr(&g_gd_ctxz, "-U");
    _ = buf_append_u64(&g_gd_ctxz, ctx_lines as u64);
    _ = buf_append_byte(&g_gd_ctxz, 0);
}

fn gd_run_toplevel() i32 {
    var av: [&const byte: 8] = [null as &const byte: 8];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = g_gd_ws_z.ptr as &const byte;
    av[3] = "rev-parse" as &const byte;
    av[4] = "--show-toplevel" as &const byte;
    av[5] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], &g_gd_out, &g_gd_errout, 8192);
}

fn gd_run_has_head() i32 {
    var av: [&const byte: 10] = [null as &const byte: 10];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = g_gd_root_z.ptr as &const byte;
    av[3] = "rev-parse" as &const byte;
    av[4] = "--verify" as &const byte;
    av[5] = "-q" as &const byte;
    av[6] = "HEAD" as &const byte;
    av[7] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], &g_gd_out, &g_gd_errout, 4096);
}

fn gd_run_status() i32 {
    var av: [&const byte: 14] = [null as &const byte: 14];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = g_gd_root_z.ptr as &const byte;
    av[3] = "--no-pager" as &const byte;
    av[4] = "status" as &const byte;
    av[5] = "--porcelain=v1" as &const byte;
    av[6] = "-z" as &const byte;
    av[7] = "--no-renames" as &const byte;   // 重命名拆成「删除 + 新增」，-z 的解析就不用管两段式
    av[8] = "-uall" as &const byte;
    av[9] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], &g_gd_status, &g_gd_errout, GD_MAX_DIFF);
}

fn gd_run_numstat() i32 {
    var av: [&const byte: 16] = [null as &const byte: 16];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = g_gd_root_z.ptr as &const byte;
    av[3] = "--no-pager" as &const byte;
    av[4] = "diff" as &const byte;
    av[5] = "--numstat" as &const byte;
    av[6] = "-z" as &const byte;
    av[7] = "--no-renames" as &const byte;
    av[8] = "HEAD" as &const byte;
    av[9] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], &g_gd_out, &g_gd_errout, GD_MAX_DIFF);
}

// 单个文件的 diff：已跟踪 = `diff HEAD -- <path>`；未跟踪 / 无 HEAD = `diff --no-index /dev/null <path>`
// 返回 git 退出码（--no-index 有差异时是 1，按成功处理）
fn gd_run_file_diff(untracked: bool, poff: usize, plen: usize, ctx_lines: usize, out: &Buf) i32 {
    gd_arg_line(ctx_lines);
    buf_reset(&g_gd_pathz);
    _ = buf_append(&g_gd_pathz, g_gd_paths.ptr + poff, plen);
    _ = buf_append_byte(&g_gd_pathz, 0);
    var av: [&const byte: 20] = [null as &const byte: 20];
    var i: usize = 0;
    av[i] = "git" as &const byte; i = i + 1;
    av[i] = "-C" as &const byte; i = i + 1;
    av[i] = g_gd_root_z.ptr as &const byte; i = i + 1;
    av[i] = "--no-pager" as &const byte; i = i + 1;
    av[i] = "diff" as &const byte; i = i + 1;
    av[i] = "--no-color" as &const byte; i = i + 1;
    av[i] = "--no-ext-diff" as &const byte; i = i + 1;
    av[i] = "--no-textconv" as &const byte; i = i + 1;
    av[i] = "--no-renames" as &const byte; i = i + 1;
    av[i] = g_gd_ctxz.ptr as &const byte; i = i + 1;
    if untracked || !g_gd_has_head {
        av[i] = "--no-index" as &const byte; i = i + 1;
        av[i] = "--" as &const byte; i = i + 1;
        av[i] = "/dev/null" as &const byte; i = i + 1;
        av[i] = g_gd_pathz.ptr as &const byte; i = i + 1;
    } else {
        av[i] = "HEAD" as &const byte; i = i + 1;
        av[i] = "--" as &const byte; i = i + 1;
        av[i] = g_gd_pathz.ptr as &const byte; i = i + 1;
    }
    av[i] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], out, &g_gd_errout, GD_MAX_DIFF);
}

// ============================================================
// 文件列表（status + numstat）
// ============================================================
// numstat 里查这个路径的 (增, 删)；返回 0 = 没查到，1 = 文本计数，2 = 二进制（`-`）
fn gd_numstat_lookup(path: &const byte, pn: usize, add: &usize, del: &usize) u8 {
    var cur: usize = 0;
    while true {
        var off: usize = 0;
        var len: usize = 0;
        var next: usize = 0;
        // numstat -z 是 NUL 分隔的记录（不是按行）
        if !gd_next_z(g_gd_nstat.ptr as &const byte, g_gd_nstat.len, cur, &off, &len, &next) {
            break;
        }
        cur = next;
        if len == 0 {
            continue;
        }
        const lp: &const byte = g_gd_nstat.ptr as &const byte;
        // `<a>\t<d>\t<path>`
        var t1: usize = 0;
        while t1 < len && lp[off + t1] != 9 as byte {
            t1 = t1 + 1;
        }
        if t1 >= len {
            continue;
        }
        var t2: usize = t1 + 1;
        while t2 < len && lp[off + t2] != 9 as byte {
            t2 = t2 + 1;
        }
        if t2 >= len {
            continue;
        }
        const rest: usize = off + t2 + 1;
        const rn: usize = len - (t2 + 1);
        if rn != pn {
            continue;
        }
        if rn > 0 && !bufx_mem_eq(lp + rest, path, rn) {
            continue;
        }
        // 计数：`-` 表示二进制
        if lp[off] == 45 as byte || lp[off + t1 + 1] == 45 as byte {
            return 2;
        }
        const av: i64 = parse_u64_at(g_gd_nstat.ptr[0: g_gd_nstat.len], off, t1);
        const dv: i64 = parse_u64_at(g_gd_nstat.ptr[0: g_gd_nstat.len], off + t1 + 1, t2 - (t1 + 1));
        if av < 0 || dv < 0 {
            return 0;
        }
        add[0] = av as usize;
        del[0] = dv as usize;
        return 1;
    }
    return 0;
}

// 扫描文件列表（填 files / paths / 偏移表 / nfiles）
// 输入：g_gd_status（status 的 -z 输出）+ g_gd_nstat（numstat）
fn gd_scan() i32 {
    buf_reset(&g_gd_files);
    buf_reset(&g_gd_paths);
    buf_reset(&g_gd_nstat);
    g_gd_nfiles = 0;
    if g_gd_has_head {
        const rc: i32 = gd_run_numstat();
        if rc == 0 {
            _ = buf_append(&g_gd_nstat, g_gd_out.ptr, g_gd_out.len);
        }
    }
    var cur: usize = 0;
    var capped: bool = false;
    while cur < g_gd_status.len {
        // -z：`<XY><空格><path>\0`
        var e: usize = cur;
        while e < g_gd_status.len && g_gd_status.ptr[e] != 0 as byte {
            e = e + 1;
        }
        if e <= cur + 3 {
            cur = e + 1;
            continue;
        }
        const xy0: byte = g_gd_status.ptr[cur];
        const xy1: byte = g_gd_status.ptr[cur + 1];
        if xy0 == 33 as byte && xy1 == 33 as byte {   // '!!' 忽略项：不列
            cur = e + 1;
            continue;
        }
        if g_gd_nfiles >= GD_MAX_FILES {
            capped = true;
            cur = e + 1;
            continue;
        }
        const path_off: usize = cur + 3;
        const path_len: usize = e - path_off;
        // 列表行：`<XY>  <path>  (+A -D)` / `(new)` / `(bin)`
        const fstart: usize = g_gd_files.len;
        _ = buf_append_byte(&g_gd_files, xy0);
        _ = buf_append_byte(&g_gd_files, xy1);
        _ = buf_append_cstr(&g_gd_files, "  ");
        _ = buf_append(&g_gd_files, g_gd_status.ptr + path_off, path_len);
        const untracked: bool = xy0 == 63 as byte && xy1 == 63 as byte;
        if untracked {
            _ = buf_append_cstr(&g_gd_files, "  (new)");
        } else {
            var a: usize = 0;
            var d: usize = 0;
            const k: u8 = gd_numstat_lookup(g_gd_status.ptr + path_off, path_len, &a, &d);
            if k == 2 {
                _ = buf_append_cstr(&g_gd_files, "  (bin)");
            } else if k == 1 {
                _ = buf_append_cstr(&g_gd_files, "  (+");
                _ = buf_append_u64(&g_gd_files, a as u64);
                _ = buf_append_cstr(&g_gd_files, " -");
                _ = buf_append_u64(&g_gd_files, d as u64);
                _ = buf_append_cstr(&g_gd_files, ")");
            }
        }
        const fend: usize = g_gd_files.len;
        g_gd_foff[g_gd_nfiles] = fstart;
        g_gd_flen[g_gd_nfiles] = fend - fstart;
        const pstart: usize = g_gd_paths.len;
        _ = buf_append(&g_gd_paths, g_gd_status.ptr + path_off, path_len);
        g_gd_poff[g_gd_nfiles] = pstart;
        g_gd_plen[g_gd_nfiles] = path_len;
        _ = buf_append_byte(&g_gd_files, 10);
        _ = buf_append_byte(&g_gd_paths, 10);
        g_gd_nfiles = g_gd_nfiles + 1;
        cur = e + 1;
    }
    if capped {
        _ = buf_append_cstr(&g_gd_files, "…（文件太多，只列了前 ");
        _ = buf_append_u64(&g_gd_files, GD_MAX_FILES as u64);
        _ = buf_append_cstr(&g_gd_files, " 个）");
        _ = buf_append_byte(&g_gd_files, 10);
    }
    return 0;
}

// 选中项是不是未跟踪（'??'）
fn gd_is_untracked(i: usize) bool {
    if i >= GD_MAX_FILES {
        return false;
    }
    if i >= g_gd_nfiles {
        return false;
    }
    if g_gd_flen[i] < 2 {
        return false;
    }
    const p: &const byte = gd_fat(g_gd_foff[i]);
    return p[0] == 63 as byte && p[1] == 63 as byte;
}

fn gd_label_of(root: &const Buf) void {
    buf_reset(&g_gd_label);
    if root.len == 0 {
        _ = buf_append_cstr(&g_gd_label, "git");
        return;
    }
    var s: usize = 0;
    var i: usize = 0;
    while i < root.len {
        if root.ptr[i] == 47 as byte {
            s = i + 1;
        }
        i = i + 1;
    }
    if s >= root.len {
        _ = buf_append_cstr(&g_gd_label, "git");
        return;
    }
    _ = buf_append(&g_gd_label, root.ptr + s, root.len - s);
}

// ============================================================
// unified diff → 行表
// ============================================================
fn gd_emit(kind: u8, lo: usize, ll: usize, ro: usize, rl: usize, lno: usize, rno: usize) void {
    if g_gd_nrows >= GD_MAX_ROWS {
        g_gd_rowcut = true;
        return;
    }
    g_gd_rows[g_gd_nrows] = GdRow{
        l_off: lo, l_len: ll, r_off: ro, r_len: rl, l_no: lno, r_no: rno, kind: kind
    };
    g_gd_nrows = g_gd_nrows + 1;
}

// 把攒着的删/增描述符落成**不配对**的行（顺序：先删后增，与 unified diff 一致）
fn gd_flush_unpaired(added: &usize, removed: &usize) void {
    var k: usize = 0;
    while k < g_gd_pdn && k < GD_RUN_MAX {
        gd_emit(GD_K_DEL, g_gd_pd[k].off, g_gd_pd[k].len, 0, 0, g_gd_pd[k].no, 0);
        removed[0] = removed[0] + 1;
        k = k + 1;
    }
    k = 0;
    while k < g_gd_pan && k < GD_RUN_MAX {
        gd_emit(GD_K_ADD, 0, 0, g_gd_pa[k].off, g_gd_pa[k].len, 0, g_gd_pa[k].no);
        added[0] = added[0] + 1;
        k = k + 1;
    }
    g_gd_pdn = 0;
    g_gd_pan = 0;
}

// 结算一个变更块：配对成功的部分出 MIX（左删右增），落单的出 DEL / ADD
fn gd_flush_block(added: &usize, removed: &usize) void {
    if g_gd_pdn == 0 && g_gd_pan == 0 {
        g_gd_pair_ok = true;
        return;
    }
    if !g_gd_pair_ok {
        gd_flush_unpaired(added, removed);
        g_gd_pair_ok = true;
        return;
    }
    var k: usize = 0;
    while k < g_gd_pdn && k < g_gd_pan && k < GD_RUN_MAX {
        gd_emit(GD_K_MIX, g_gd_pd[k].off, g_gd_pd[k].len, g_gd_pa[k].off, g_gd_pa[k].len,
            g_gd_pd[k].no, g_gd_pa[k].no);
        removed[0] = removed[0] + 1;
        added[0] = added[0] + 1;
        k = k + 1;
    }
    while k < g_gd_pdn && k < GD_RUN_MAX {
        gd_emit(GD_K_DEL, g_gd_pd[k].off, g_gd_pd[k].len, 0, 0, g_gd_pd[k].no, 0);
        removed[0] = removed[0] + 1;
        k = k + 1;
    }
    var m: usize = g_gd_pdn;
    if g_gd_pdn > g_gd_pan {
        m = g_gd_pan;
    }
    while m < g_gd_pan && m < GD_RUN_MAX {
        gd_emit(GD_K_ADD, 0, 0, g_gd_pa[m].off, g_gd_pa[m].len, 0, g_gd_pa[m].no);
        added[0] = added[0] + 1;
        m = m + 1;
    }
    g_gd_pdn = 0;
    g_gd_pan = 0;
    g_gd_pair_ok = true;
}

// `@@ -a[,b] +c[,d] @@` → 两侧起始行号
fn gd_parse_hunk_head(p: &const byte, n: usize, lno: &usize, rno: &usize) bool {
    var i: usize = 0;
    while i < n && p[i] != 45 as byte {   // '-'：@@ -1,5 +1,5 @@
        i = i + 1;
    }
    if i >= n {
        return false;
    }
    i = i + 1;
    var l: usize = 0;
    var have_l: bool = false;
    while i < n && p[i] >= 48 as byte && p[i] <= 57 as byte {
        l = l * (10 as usize) + ((p[i] - 48 as byte) as usize);
        have_l = true;
        i = i + 1;
    }
    while i < n && p[i] != 43 as byte {
        i = i + 1;
    }
    if i >= n {
        return false;
    }
    i = i + 1;
    var r: usize = 0;
    var have_r: bool = false;
    while i < n && p[i] >= 48 as byte && p[i] <= 57 as byte {
        r = r * (10 as usize) + ((p[i] - 48 as byte) as usize);
        have_r = true;
        i = i + 1;
    }
    if !have_l || !have_r {
        return false;
    }
    lno[0] = l;
    rno[0] = r;
    return true;
}

// 解析一段 unified diff（自测可直接喂文本）。added/removed 出增删行数。
export fn gd_parse_into(text: &const Buf, added: &usize, removed: &usize) void {
    gd_ensure();
    g_gd_nrows = 0;
    g_gd_rowcut = false;
    g_gd_pdn = 0;
    g_gd_pan = 0;
    g_gd_pair_ok = true;
    added[0] = 0;
    removed[0] = 0;
    g_gd_textp = text.ptr as &const byte;
    if text.len == 0 {
        return;
    }
    const p: &const byte = text.ptr as &const byte;
    const n: usize = text.len;
    // 有 hunk 头，或至少像 diff 的输出 → 走状态机；否则（例如 git 的报错）整段作为一行说明
    var has_hunk: bool = false;
    var cur0: usize = 0;
    while true {
        var o: usize = 0;
        var l: usize = 0;
        var nx: usize = 0;
        if !gd_next_line(p, n, cur0, &o, &l, &nx) {
            break;
        }
        cur0 = nx;
        if l >= 3 && gd_startswith(p + o, l, "@@ " as &const byte) {
            has_hunk = true;
            break;
        }
    }
    if !has_hunk && !gd_startswith(p, n, "diff --git" as &const byte) {
        gd_emit(GD_K_HDR, 0, n, 0, 0, 0, 0);
        return;
    }
    var lno: usize = 0;
    var rno: usize = 0;
    var in_hunk: bool = false;
    var cur: usize = 0;
    while true {
        var off: usize = 0;
        var len: usize = 0;
        var next: usize = 0;
        if !gd_next_line(p, n, cur, &off, &len, &next) {
            break;
        }
        cur = next;
        if len >= 3 && gd_startswith(p + off, len, "@@ " as &const byte) {
            gd_flush_block(added, removed);
            var a: usize = 0;
            var b: usize = 0;
            if gd_parse_hunk_head(p + off, len, &a, &b) {
                lno = a;
                rno = b;
                in_hunk = true;
            }
            gd_emit(GD_K_HDR, off, len, 0, 0, 0, 0);
            continue;
        }
        if !in_hunk {
            // 头区：`diff --git` / `index` / `---` / `+++` / mode / rename 之类一律不显示；
            // 「Binary files … differ」是有信息量的，留一行
            if gd_startswith(p + off, len, "Binary files" as &const byte) {
                gd_emit(GD_K_HDR, off, len, 0, 0, 0, 0);
            }
            continue;
        }
        var c: byte = 32 as byte;
        if len > 0 {
            c = p[off];
        }
        if c == 32 as byte || len == 0 {
            gd_flush_block(added, removed);
            // 空行 / 上下文：标记列（空格）不算内容
            var so: usize = off;
            var sl: usize = len;
            if len > 0 {
                so = off + 1;
                sl = len - 1;
            }
            gd_emit(GD_K_CTX, so, sl, so, sl, lno, rno);
            lno = lno + 1;
            rno = rno + 1;
            continue;
        }
        if c == 45 as byte {   // '-'
            if g_gd_pan > 0 {
                gd_flush_block(added, removed);   // 畸形顺序（删行跟在增行后面）：先把上一块结算掉
            }
            if !g_gd_pair_ok {
                gd_emit(GD_K_DEL, off + 1, len - 1, 0, 0, lno, 0);
                removed[0] = removed[0] + 1;
            } else if g_gd_pdn >= GD_RUN_MAX {
                gd_flush_unpaired(added, removed);   // 先把已攒的删行落地（顺序不乱），本块改成不配对
                g_gd_pair_ok = false;
                gd_emit(GD_K_DEL, off + 1, len - 1, 0, 0, lno, 0);
                removed[0] = removed[0] + 1;
            } else {
                g_gd_pd[g_gd_pdn] = GdRun{ off: off + 1, len: len - 1, no: lno };
                g_gd_pdn = g_gd_pdn + 1;
            }
            lno = lno + 1;
            continue;
        }
        if c == 43 as byte {   // '+'
            if !g_gd_pair_ok || g_gd_pdn == 0 {
                gd_emit(GD_K_ADD, 0, 0, off + 1, len - 1, 0, rno);
                added[0] = added[0] + 1;
            } else if g_gd_pan >= GD_RUN_MAX {
                gd_flush_unpaired(added, removed);
                g_gd_pair_ok = false;
                gd_emit(GD_K_ADD, 0, 0, off + 1, len - 1, 0, rno);
                added[0] = added[0] + 1;
            } else {
                g_gd_pa[g_gd_pan] = GdRun{ off: off + 1, len: len - 1, no: rno };
                g_gd_pan = g_gd_pan + 1;
            }
            rno = rno + 1;
            continue;
        }
        if c == 92 as byte {   // '\'：`\ No newline at end of file`
            gd_flush_block(added, removed);
            gd_emit(GD_K_HDR, off, len, 0, 0, 0, 0);
            continue;
        }
        // 不该出现：宁可见到内容（当上下文处理）
        gd_flush_block(added, removed);
        gd_emit(GD_K_CTX, off, len, off, len, lno, rno);
        lno = lno + 1;
        rno = rno + 1;
    }
    gd_flush_block(added, removed);
}

// ============================================================
// 载入选中文件
// ============================================================
fn gd_load_sel() bool {
    gd_ensure();
    if !g_gd_real {
        // 假数据（--tui-demo / 自测）：内容已经由 gd_load_fixture 解析好，
        // 这里既不能清行表（行表指向 g_gd_out），也不能去跑 git（没有仓库）
        return true;
    }
    g_gd_nrows = 0;
    g_gd_rowcut = false;
    g_gd_added = 0;
    g_gd_removed = 0;
    g_gd_textp = "" as &const byte;
    buf_reset(&g_gd_note);
    buf_reset(&g_gd_out);
    if g_gd_sel >= g_gd_nfiles {
        return false;
    }
    if g_gd_sel >= GD_MAX_FILES {
        return false;
    }
    const untracked: bool = gd_is_untracked(g_gd_sel);
    var rc: i32 = gd_run_file_diff(untracked, g_gd_poff[g_gd_sel], g_gd_plen[g_gd_sel], GD_FULL_CTX, &g_gd_out);
    if rc == GITX_E_NO_GIT || rc == GITX_E_SPAWN {
        gd_set_err(gd_err_fallback(rc));
        return false;
    }
    if rc == GITX_E_TIMEOUT {
        gd_note_add("（git 超时，已放弃这次查询）" as &const byte);
        return true;
    }
    if gitx_last_truncated() {
        // 文件太大：改抓「改动附近的上下文」，至少让改动本身看得见
        buf_reset(&g_gd_out);
        rc = gd_run_file_diff(untracked, g_gd_poff[g_gd_sel], g_gd_plen[g_gd_sel], GD_TXT_CTX, &g_gd_out);
        gd_note_add("（文件过大：只显示改动附近的 3 行上下文）" as &const byte);
    }
    if rc != 0 && rc != 1 && g_gd_out.len == 0 {
        // 真错误（例如未合并的路径）：把 git 的话放进制表
        gd_set_err_text(g_gd_errout.ptr as &const byte, g_gd_errout.len, "git diff 失败" as &const byte);
        gd_note_add("（" as &const byte);
        _ = buf_append(&g_gd_note, g_gd_err.ptr, g_gd_err.len);
        gd_note_add("）" as &const byte);
        gd_set_err(gd_err_fallback(rc));
        g_gd_textp = g_gd_out.ptr as &const byte;
        return true;
    }
    var a: usize = 0;
    var r: usize = 0;
    gd_parse_into(&g_gd_out, &a, &r);
    g_gd_added = a;
    g_gd_removed = r;
    if g_gd_rowcut {
        gd_note_add("（行数超过上限，已截断）" as &const byte);
    }
    if g_gd_nrows == 0 {
        const p: &const byte = g_gd_out.ptr as &const byte;
        const n: usize = g_gd_out.len;
        if gd_has(p, n, "old mode" as &const byte) {
            gd_note_add("（仅文件模式变更）" as &const byte);
        } else if n == 0 {
            gd_note_add("（没有可显示的差异）" as &const byte);
        } else {
            gd_note_add("（没有可显示的内容）" as &const byte);
        }
    }
    return true;
}

// ============================================================
// 对外：打开 / 刷新 / 选择 / 滚动
// ============================================================
export fn gd_open(ws: &const byte, n: usize) i32 {
    gd_ensure();
    buf_reset(&g_gd_err);
    buf_reset(&g_gd_note);
    if n == 0 || ws == null as &const byte {
        gd_set_err("工作区为空" as &const byte);
        return GD_E_NOT_REPO;
    }
    if !gitx_available() {
        gd_set_err("找不到 git 可执行文件（/diff 需要 git 在 PATH 里）" as &const byte);
        return GD_E_NO_GIT;
    }
    buf_reset(&g_gd_ws);
    _ = buf_append(&g_gd_ws, ws, n);
    gitx_cstr(&g_gd_ws_z, ws, n);
    const rc0: i32 = gd_run_toplevel();
    if rc0 != 0 {
        gd_set_err_text(g_gd_errout.ptr as &const byte, g_gd_errout.len, gd_err_fallback(rc0));
        return GD_E_NOT_REPO;
    }
    gitx_trim_nl(&g_gd_out);
    if g_gd_out.len == 0 {
        gd_set_err("工作区不在 git 仓库里" as &const byte);
        return GD_E_NOT_REPO;
    }
    buf_reset(&g_gd_root);
    _ = buf_append(&g_gd_root, g_gd_out.ptr, g_gd_out.len);
    gitx_cstr(&g_gd_root_z, g_gd_root.ptr, g_gd_root.len);
    gd_label_of(&g_gd_root);
    g_gd_has_head = gd_run_has_head() == 0;
    g_gd_real = true;
    const rc1: i32 = gd_run_status();
    if rc1 != 0 {
        gd_set_err_text(g_gd_errout.ptr as &const byte, g_gd_errout.len, gd_err_fallback(rc1));
        return GD_E_NOT_REPO;
    }
    const rc2: i32 = gd_scan();
    if rc2 != 0 {
        return rc2;
    }
    g_gd_sel = 0;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
    _ = gd_load_sel();
    return 0;
}

export fn gd_refresh() i32 {
    gd_ensure();
    if !g_gd_real {
        buf_reset(&g_gd_note);
        gd_note_add("（假数据：没有仓库可刷新）" as &const byte);
        return 0;
    }
    if g_gd_ws.len == 0 {
        gd_set_err("还没有打开过仓库" as &const byte);
        return GD_E_NOT_REPO;
    }
    // 失败时保留原来的列表与内容，只把原因写进 note（浮窗里看得见）
    var ws: Buf = buf_new(g_gd_ws.len + 1);
    defer { buf_free(&ws); }
    _ = buf_append(&ws, g_gd_ws.ptr, g_gd_ws.len);
    const keep: usize = g_gd_sel;
    const rc: i32 = gd_open(ws.ptr as &const byte, g_gd_ws.len);
    if rc < 0 {
        buf_reset(&g_gd_note);
        gd_note_add("（刷新失败：" as &const byte);
        _ = buf_append(&g_gd_note, g_gd_err.ptr, g_gd_err.len);
        gd_note_add("）" as &const byte);
        return rc;
    }
    if g_gd_nfiles > 0 {
        if keep < g_gd_nfiles {
            g_gd_sel = keep;
        } else {
            g_gd_sel = g_gd_nfiles - 1;
        }
        _ = gd_load_sel();
    }
    return 0;
}

export fn gd_error() &const Buf {
    gd_ensure();
    return &g_gd_err;
}

export fn gd_note() &const Buf {
    gd_ensure();
    return &g_gd_note;
}

export fn gd_repo_label() &const Buf {
    gd_ensure();
    return &g_gd_label;
}

export fn gd_file_count() usize {
    return g_gd_nfiles;
}

export fn gd_sel() usize {
    return g_gd_sel;
}

export fn gd_added() usize {
    return g_gd_added;
}

export fn gd_removed() usize {
    return g_gd_removed;
}

export fn gd_scroll() usize {
    return g_gd_scroll;
}

export fn gd_hscroll() usize {
    return g_gd_hscroll;
}

export fn gd_rows() usize {
    return g_gd_nrows;
}

export fn gd_rowcut() bool {
    return g_gd_rowcut;
}

// 左列表第 i 行的显示文本（末尾不带换行）
export fn gd_file_text(i: usize, out_len: &usize) &const byte {
    out_len[0] = 0;
    if i >= GD_MAX_FILES {
        return "" as &const byte;
    }
    if i >= g_gd_nfiles {
        return "" as &const byte;
    }
    out_len[0] = g_gd_flen[i];
    return gd_fat(g_gd_foff[i]);
}

// 第 i 行第 side 侧（0 = 旧 / 1 = 新）的单元格文本
export fn gd_cell(i: usize, side: u8, out_len: &usize) &const byte {
    out_len[0] = 0;
    if i >= GD_MAX_ROWS {
        return "" as &const byte;
    }
    if i >= g_gd_nrows {
        return "" as &const byte;
    }
    const r: GdRow = g_gd_rows[i];
    if side == 0 {
        out_len[0] = r.l_len;
        return gd_at(r.l_off);
    }
    out_len[0] = r.r_len;
    return gd_at(r.r_off);
}

export fn gd_row_meta(i: usize, out: &GdRow) bool {
    if i >= GD_MAX_ROWS {
        return false;
    }
    if i >= g_gd_nrows {
        return false;
    }
    out[0] = g_gd_rows[i];
    return true;
}

export fn gd_move(delta: i32) bool {
    if g_gd_nfiles == 0 {
        return false;
    }
    var s: i64 = (g_gd_sel as i64) + (delta as i64);
    if s < 0 {
        s = 0;
    }
    if s > (g_gd_nfiles - 1) as i64 {
        s = (g_gd_nfiles - 1) as i64;
    }
    const ns: usize = s as usize;
    if ns == g_gd_sel {
        return false;
    }
    g_gd_sel = ns;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
    _ = gd_load_sel();
    return true;
}

// 直接选第 i 个文件（自测按「这个文件在第几行」定位，不依赖 git 的排序：
// git status 先报已跟踪的改动，未跟踪的排在最后）
export fn gd_select(i: usize) bool {
    if i >= g_gd_nfiles {
        return false;
    }
    if i == g_gd_sel {
        return true;
    }
    g_gd_sel = i;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
    _ = gd_load_sel();
    return true;
}

export fn gd_set_view(rows: usize) void {
    if rows == 0 {
        g_gd_view = 1;
    } else {
        g_gd_view = rows;
    }
    const m: usize = gd_scroll_max();
    if g_gd_scroll > m {
        g_gd_scroll = m;
    }
}

fn gd_scroll_max() usize {
    if g_gd_nrows > g_gd_view {
        return g_gd_nrows - g_gd_view;
    }
    return 0;
}

export fn gd_scroll_by(pages: i32) void {
    var step: usize = 1;
    if g_gd_view > 1 {
        step = g_gd_view - 1;
    }
    var s: i64 = (g_gd_scroll as i64) + (pages as i64) * (step as i64);
    if s < 0 {
        s = 0;
    }
    const m: i64 = gd_scroll_max() as i64;
    if s > m {
        s = m;
    }
    g_gd_scroll = s as usize;
}

export fn gd_scroll_home() void {
    g_gd_scroll = 0;
}

export fn gd_scroll_end() void {
    g_gd_scroll = gd_scroll_max();
}

export fn gd_hscroll_by(steps: i32) void {
    var h: i64 = (g_gd_hscroll as i64) + (steps as i64) * (GD_HSTEP as i64);
    if h < 0 {
        h = 0;
    }
    if h > 100000 {
        h = 100000;
    }
    g_gd_hscroll = h as usize;
}

// ============================================================
// 非 TUI 的单列文本回退
// ============================================================
fn gd_txt_lines(dst: &Buf, src: &const Buf, max_lines: usize, budget: &usize, wrote: &usize) void {
    var cur: usize = 0;
    var emitted: usize = 0;
    while emitted < max_lines && budget[0] > 0 {
        var off: usize = 0;
        var len: usize = 0;
        var next: usize = 0;
        if !gd_next_line(src.ptr as &const byte, src.len, cur, &off, &len, &next) {
            break;
        }
        cur = next;
        _ = buf_append(dst, src.ptr + off, len);
        _ = buf_append_byte(dst, 10);
        emitted = emitted + 1;
        budget[0] = budget[0] - 1;
    }
    wrote[0] = emitted;
}

export fn gd_print_text(ws: &const byte, n: usize, out: &Buf) void {
    gd_ensure();
    buf_reset(out);
    const rc: i32 = gd_open(ws, n);
    _ = buf_append_cstr(out, "[diff] ");
    if rc < 0 {
        _ = buf_append(out, g_gd_err.ptr, g_gd_err.len);
        _ = buf_append_byte(out, 10);
        return;
    }
    _ = buf_append(out, g_gd_label.ptr, g_gd_label.len);
    _ = buf_append_cstr(out, " · ");
    _ = buf_append_u64(out, g_gd_nfiles as u64);
    _ = buf_append_cstr(out, " 个文件（HEAD ↔ 工作区）\n");
    if g_gd_nfiles == 0 {
        _ = buf_append_cstr(out, "（没有 git 修改）\n");
        return;
    }
    var i: usize = 0;
    while i < g_gd_nfiles {
        _ = buf_append_cstr(out, "  ");
        _ = buf_append(out, gd_fat(g_gd_foff[i]), g_gd_flen[i]);
        _ = buf_append_byte(out, 10);
        i = i + 1;
    }
    var budget: usize = GD_TXT_MAX_LINES;
    var shown: usize = 0;
    var clean: Buf = buf_new(65536);
    defer { buf_free(&clean); }
    i = 0;
    while i < g_gd_nfiles && i < GD_TXT_FILES && budget > 0 {
        const untracked: bool = gd_is_untracked(i);
        const rc2: i32 = gd_run_file_diff(untracked, g_gd_poff[i], g_gd_plen[i], GD_TXT_CTX, &g_gd_out);
        if rc2 < 0 {
            break;
        }
        _ = buf_append_cstr(out, "--- ");
        _ = buf_append(out, g_gd_paths.ptr + g_gd_poff[i], g_gd_plen[i]);
        _ = buf_append_byte(out, 10);
        // 外来字节只以「清洗后」的形态上屏（P19 的口径）：ESC/TAB/控制字节都换掉
        buf_reset(&clean);
        tui_clean_into(&clean, g_gd_out.ptr as &const byte, g_gd_out.len);
        var wrote: usize = 0;
        gd_txt_lines(out, &clean, GD_TXT_FILE_LINES, &budget, &wrote);
        shown = shown + wrote;
        i = i + 1;
    }
    if i < g_gd_nfiles {
        _ = buf_append_cstr(out, "…（还有 ");
        _ = buf_append_u64(out, (g_gd_nfiles - i) as u64);
        _ = buf_append_cstr(out, " 个文件没展开；TUI 里的 /diff 是双列全文比对）\n");
    } else if budget == 0 {
        _ = buf_append_cstr(out, "…（输出已达上限；TUI 里的 /diff 可看完整双列比对）\n");
    }
    _ = shown;
}

// ============================================================
// 自测 / --tui-demo 用的假数据（不碰 git）
// ============================================================
// label 收 C 字符串（长度自己数）：调用方少写一个 usize，就少一次「把 NUL 也当成内容」
// 的机会 —— README 坑 2 那一族（P22 第一版就把 NUL 画进了标题）。
export fn gd_load_fixture(label: &const byte, files: &const Buf, diff_text: &const Buf) void {
    gd_ensure();
    gd_reset();
    g_gd_real = false;
    buf_reset(&g_gd_label);
    _ = buf_append_cstr(&g_gd_label, label);
    // 假列表：每行 `<XY>  <path>  (+A -D)`，空行忽略
    var cur: usize = 0;
    while true {
        var off: usize = 0;
        var len: usize = 0;
        var next: usize = 0;
        if !gd_next_line(files.ptr as &const byte, files.len, cur, &off, &len, &next) {
            break;
        }
        cur = next;
        if len == 0 || g_gd_nfiles >= GD_MAX_FILES {
            continue;
        }
        const fstart: usize = g_gd_files.len;
        _ = buf_append(&g_gd_files, files.ptr + off, len);
        g_gd_foff[g_gd_nfiles] = fstart;
        g_gd_flen[g_gd_nfiles] = len;
        const pstart: usize = g_gd_paths.len;
        _ = buf_append(&g_gd_paths, files.ptr + off, len);
        g_gd_poff[g_gd_nfiles] = pstart;
        g_gd_plen[g_gd_nfiles] = len;
        _ = buf_append_byte(&g_gd_files, 10);
        _ = buf_append_byte(&g_gd_paths, 10);
        g_gd_nfiles = g_gd_nfiles + 1;
    }
    buf_reset(&g_gd_out);
    _ = buf_append(&g_gd_out, diff_text.ptr, diff_text.len);
    var a: usize = 0;
    var r: usize = 0;
    gd_parse_into(&g_gd_out, &a, &r);
    g_gd_added = a;
    g_gd_removed = r;
    g_gd_sel = 0;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
}

// 调试：把行表倒成一行摘要（自测失败时打出来看）
export fn gd_dump_rows(out: &Buf) void {
    gd_ensure();
    buf_reset(out);
    var i: usize = 0;
    while i < g_gd_nrows && i < GD_MAX_ROWS {
        const r: GdRow = g_gd_rows[i];
        _ = buf_append_u64(out, i as u64);
        _ = buf_append_cstr(out, ":k");
        _ = buf_append_u64(out, r.kind as u64);
        _ = buf_append_cstr(out, " L");
        _ = buf_append_u64(out, r.l_no as u64);
        _ = buf_append_cstr(out, "[");
        _ = buf_append(out, gd_at(r.l_off), r.l_len);
        _ = buf_append_cstr(out, "] R");
        _ = buf_append_u64(out, r.r_no as u64);
        _ = buf_append_cstr(out, "[");
        _ = buf_append(out, gd_at(r.r_off), r.r_len);
        _ = buf_append_cstr(out, "]\n");
        i = i + 1;
    }
}
