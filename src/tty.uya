// src/tty.uya — 终端交互层（P3）
//
// 提供：
//   * isatty 判定：libc 没导出 isatty，用 `ioctl(0, TCGETS, &termios)` 成功即 TTY；
//   * raw 模式进出：关 ICANON/ECHO/ISIG/IEXTEN（自己管 Ctrl-C），清 IXON/ICRNL，
//     VMIN=1/VTIME=0；**保留 OPOST** —— 否则项目里大量 `\n` 输出会变成阶梯状；
//   * 终端宽度（TIOCGWINSZ，每次重画前重读，窗口缩放后不用重启）；
//   * 行编辑器：把字节流喂进 tty_feed，事件从 tty_next_event 取；
//   * 渲染协议 ui_out_*：擦掉输入行 → 写输出 → 重画输入行；
//   * 动态提示符（状态显示走提示符，避免两行光标的复杂度）。
//
// 两条硬约束（都是踩出来的坑）：
//   1) **编辑按 UTF-8 字符、定位按显示列**。中文一个字符 3 字节、占 2 列，
//      按字节退格会把字符砍成半个（屏幕上就是乱码），按字节回退光标会越走越偏。
//   2) **写转义序列必须用数组字面量取址**，不能用 `&"..."[0: n]`（见下面的常量注释）。
//
// 设计约束：Uya **没有捕获闭包**，所以状态放在模块级全局 tty_ui 上，函数直接操作它；
// 单进程里只可能有一个前台界面，这与 DSH 的「一个 session 一个 driver」一致。

use libc.syscall;
use libc.unistd;
use libc.stdlib;

// ---- ioctl / termios 常量（Linux x86-64）----
const TTY_TCGETS: i64 = 0x5401;
const TTY_TCSETS: i64 = 0x5402;
const TTY_TIOCGWINSZ: i64 = 0x5413;

const TTY_IFLAG_ICRNL: u32 = 0x0100;
const TTY_IFLAG_IXON: u32 = 0x0400;
const TTY_LFLAG_ISIG: u32 = 0x0001;
const TTY_LFLAG_ICANON: u32 = 0x0002;
const TTY_LFLAG_ECHO: u32 = 0x0008;
const TTY_LFLAG_IEXTEN: u32 = 0x8000;
const TTY_U32_MAX: u32 = 0xFFFFFFFF;

const TTY_CC_VTIME: usize = 5;
const TTY_CC_VMIN: usize = 6;

const TTY_LINE_MAX: usize = 8192;
const TTY_HIST_MAX: usize = 32;
const TTY_EVQ_MAX: usize = 16;
const TTY_BLOCK_TEXT_MAX: usize = 8192;    // 面板块快照上限（子代理窗口等）

// 面板块（P15）：输入行块 = [窗口行…] + [提示符+输入行]。快照（窗口行文本）由上层用
// tty_block_begin 推到这里 —— tty 层不认识 deleg/view，只负责「多行块的擦除与重画」。
// 上层在**任何可能变化的地方**调它的刷新入口（agent_agents_tick），它会：
//   生成快照 → 内容变了就 tty_block_begin → tty_block_redraw（原地重画）。
//
// 为什么不在这里挂回调：uya 0.10 **没有函数指针**（`export type f = fn() bool` 直接语法报错，
// 标准库里 `libc/stdlib.uya` / `lib/tflm` 都留了「函数指针暂不支持」的注释），
// 所以只能「上层推、下层画」。


// ---- 转义序列：必须用数组字面量 ----
// uya 0.10 的坑：`&"\r\x1b[2K"[0: 5]` 求值出来是**切片描述符**（{ptr,len} 结构体）的地址，
// 而 `sys_write` 的形参是 `*const byte`，编译器只补一次 `(const char *)` 强转 —— 于是写进
// 终端的是描述符里那 8 字节指针的前 5 字节：屏幕上每次重画提示符都跟一串乱码，字节还随
// ASLR 变（实测 `\xb9x\xe0gi` 这种）。数组字面量取址才是真正的字节指针。
// `make codegen-audit` 会扫构建产物里的这种形状，防止再写回去。
const TTY_SEQ_CURSOR_SHOW: [byte: 6] = [27, 91, 63, 50, 53, 104];   // "\x1b[?25h"
const TTY_SEQ_CRLF: [byte: 2] = [13, 10];                            // "\r\n"（面板块每行收尾）

// ---- 事件 ----
export const TTY_EV_NONE: i32 = 0;
export const TTY_EV_SUBMIT: i32 = 1;      // 回车：整行在 tty_line()/tty_line_len() 里
export const TTY_EV_CTRL_C: i32 = 2;      // Ctrl-C（运行中=中断，空闲=清行/退出）
export const TTY_EV_ESC: i32 = 3;         // 裸 ESC（等同中断意图）
export const TTY_EV_EOF: i32 = 4;         // 空行上的 Ctrl-D
export const TTY_EV_CLEARED: i32 = 5;     // Ctrl-U 清空
export const TTY_EV_REDRAW: i32 = 6;      // Ctrl-L

export struct TtyTermios {
    c_iflag: u32,
    c_oflag: u32,
    c_cflag: u32,
    c_lflag: u32,
    c_line: u8,
    c_cc: [byte: 32],
    pad: [byte: 3],
    c_ispeed: u32,
    c_ospeed: u32,
}

export struct TtyWinsize {
    ws_row: u16,
    ws_col: u16,
    ws_x: u16,
    ws_y: u16,
}

export fn tty_termios_zero() TtyTermios {
    return TtyTermios{
        c_iflag: 0,
        c_oflag: 0,
        c_cflag: 0,
        c_lflag: 0,
        c_line: 0,
        c_cc: [0: 32],
        pad: [0: 3],
        c_ispeed: 0,
        c_ospeed: 0,
    };
}

export struct TtyUi {
    is_tty: bool,
    raw: bool,
    cols: usize,
    rows: usize,        // 终端高度（TUI 每帧重读；行编辑器不用）
    saved: TtyTermios,
    line: Buf,          // 正在编辑的行
    cursor: usize,
    prompt: Buf,        // 当前提示符（含状态）
    // 转义序列状态机：0=无 1=ESC 2=ESC[ 3=ESC[<num>
    esc: i32,
    esc_arg: i32,
    // 事件队列
    evq: [i32: TTY_EVQ_MAX],
    evn: usize,
    // 历史
    hist: [Buf: TTY_HIST_MAX],
    hist_len: usize,
    hist_pos: i32,
    stash: Buf,         // 上翻历史时暂存的当前行
    pend: Buf,          // 一次读取里「事件之后」剩下的字节（粘贴/多行输入）
    line_on_screen: bool,
    cur_row: usize,         // 光标在「输入行块」里的第几行（擦除时上移这么多行）
    start_col: usize,       // 输入行块的起始列（流式输出没换行时它不是 0）
    out_col: usize,         // 光标当前的物理列（追踪所有 tty_write 的输出）
    out_wrap: bool,         // 上一行正好写满：下一个字节会落到下一行第 0 列
    // ---- 面板块（P15，见文件头的说明）----
    block: Buf,             // 窗口行快照（上层用 tty_block_begin 推下来）
    block_enabled: bool,    // 上层有没有窗口要显示（tty_set_block_provider）
    block_on: bool,         // 屏幕上画出来的块里**是否含窗口行**（擦除按它选协议）
    input_on_screen: bool,  // 「提示符+输入」在屏幕上但输入为空（此时块要复用它当底行）
}

fn tty_ptr_i64(p: &void) i64 {
    return @usize_from_ptr(p) as i64;
}

// ============================================================
// 终端属性
// ============================================================
export fn tty_get_attrs(fd: i32, out: &TtyTermios) bool {
    const r: !i32 = sys_ioctl(fd, TTY_TCGETS, tty_ptr_i64(out as &void));
    const v: i32 = r catch { -1; };
    return v == 0;
}

export fn tty_set_attrs(fd: i32, t: &const TtyTermios) bool {
    const r: !i32 = sys_ioctl(fd, TTY_TCSETS, tty_ptr_i64(t as &void));
    const v: i32 = r catch { -1; };
    return v == 0;
}

// TCGETS 成功 = 这是一个终端
export fn tty_probe(fd: i32) bool {
    var tm: TtyTermios = tty_termios_zero();
    return tty_get_attrs(fd, &tm);
}

// raw 模式下应该清掉的 lflag / iflag 位（自测直接断言这两个函数）
export fn tty_raw_lflag_clear(base: u32) u32 {
    return base & (TTY_U32_MAX - (TTY_LFLAG_ISIG | TTY_LFLAG_ICANON | TTY_LFLAG_ECHO | TTY_LFLAG_IEXTEN));
}

export fn tty_raw_iflag_clear(base: u32) u32 {
    return base & (TTY_U32_MAX - (TTY_IFLAG_ICRNL | TTY_IFLAG_IXON));
}

export fn tty_init(ui: &TtyUi, fd: i32) void {
    ui.is_tty = tty_probe(fd);
    ui.raw = false;
    ui.cols = 80;
    ui.saved = tty_termios_zero();
    ui.line = buf_new(TTY_LINE_MAX);
    ui.prompt = buf_new(64);
    ui.block = buf_new(TTY_BLOCK_TEXT_MAX);
    ui.stash = buf_new(TTY_LINE_MAX);
    ui.pend = buf_new(TTY_LINE_MAX);
    ui.cursor = 0;
    ui.esc = 0;
    ui.esc_arg = 0;
    ui.evn = 0;
    ui.hist_len = 0;
    ui.hist_pos = -1;
    ui.line_on_screen = false;
    ui.cur_row = 0;
    ui.start_col = 0;
    ui.out_col = 0;
    ui.out_wrap = false;
    ui.block_enabled = false;
    ui.block_on = false;
    ui.input_on_screen = false;
    buf_reset(&ui.block);
    var i: usize = 0;
    while i < TTY_HIST_MAX {
        ui.hist[i] = buf_empty();
        i = i + 1;
    }
    _ = buf_append_cstr(&ui.prompt, "> ");
    if ui.is_tty {
        tty_refresh_cols(ui);
    }
}

// 重读窗口宽度。每次重画前调一次：窗口缩放后（没有 SIGWINCH 处理器）也能自动跟上，
// 否则折行行数会按旧宽度算，擦除就擦不干净。
export fn tty_refresh_cols(ui: &TtyUi) void {
    if !ui.is_tty {
        return;
    }
    var ws: TtyWinsize = TtyWinsize{ ws_row: 0, ws_col: 0, ws_x: 0, ws_y: 0 };
    const r: !i32 = sys_ioctl(0, TTY_TIOCGWINSZ, tty_ptr_i64(&ws as &void));
    const v: i32 = r catch { -1; };
    if v == 0 && ws.ws_col > 0 {
        ui.cols = ws.ws_col as usize;
    }
}

// 同时刷新宽高（TUI 每帧调用；窗口缩放靠这里兜底，SIGWINCH 只是加速）
export fn tty_refresh_size(ui: &TtyUi) void {
    if !ui.is_tty {
        return;
    }
    var ws: TtyWinsize = TtyWinsize{ ws_row: 0, ws_col: 0, ws_x: 0, ws_y: 0 };
    const r: !i32 = sys_ioctl(0, TTY_TIOCGWINSZ, tty_ptr_i64(&ws as &void));
    const v: i32 = r catch { -1; };
    if v == 0 && ws.ws_col > 0 {
        ui.cols = ws.ws_col as usize;
    }
    if v == 0 && ws.ws_row > 0 {
        ui.rows = ws.ws_row as usize;
    }
}

export fn tty_free(ui: &TtyUi) void {
    buf_free(&ui.line);
    buf_free(&ui.prompt);
    buf_free(&ui.block);
    buf_free(&ui.stash);
    buf_free(&ui.pend);
    var i: usize = 0;
    while i < TTY_HIST_MAX {
        buf_free(&ui.hist[i]);
        i = i + 1;
    }
    ui.hist_len = 0;
}

// 进 raw 模式；失败返回 false（调用方退回行式 REPL）
export fn tty_raw_on(ui: &TtyUi, fd: i32) bool {
    if ui.raw {
        return true;
    }
    if !ui.is_tty {
        return false;
    }
    if !tty_get_attrs(fd, &ui.saved) {
        return false;
    }
    var t: TtyTermios = ui.saved;
    t.c_lflag = tty_raw_lflag_clear(t.c_lflag);
    t.c_iflag = tty_raw_iflag_clear(t.c_iflag);
    t.c_cc[TTY_CC_VMIN] = 1;
    t.c_cc[TTY_CC_VTIME] = 0;
    if !tty_set_attrs(fd, &t) {
        return false;
    }
    ui.raw = true;
    return true;
}

// 恢复原始终端属性（正常/错误/信号三条路径都必须调用）
export fn tty_raw_off(ui: &TtyUi, fd: i32) void {
    if !ui.raw {
        return;
    }
    _ = tty_set_attrs(fd, &ui.saved);
    ui.raw = false;
    _ = sys_write(fd, &TTY_SEQ_CURSOR_SHOW[0], 6) catch {};
}

// 关于信号：**本模块不装处理器**，信号层在 `src/sigx.uya`（交互入口在进入 raw 模式之前调
// `sigx_install_terminal` / `sigx_install_winch`，退出时 `sigx_disarm`）。
// 不用 `libc.signal.signal` 的原因：uya 0.10 的实现走裸 rt_sigaction，`sa_flags = 0`、
// `sa_restorer = null`，x86-64 上缺 SA_RESTORER + rt_sigreturn 垫片 —— 处理器体一次都
// 不执行，进程直接 SIGSEGV(139)（本项目实测复现；uya 项目侧已修复，commit fad26acd）。
// `sigx` 直接绑宿主 glibc 的 `sigaction`，在没修过的工具链上也能工作。
// 被 SIGKILL 打断仍然无法恢复（不可捕获），用 `reset` / `stty sane` 兜底。

export fn tty_active(ui: &const TtyUi) bool {
    return ui.is_tty && ui.raw;
}

// 设置提示符（含状态显示）。传 C 字符串。
export fn tty_set_prompt(ui: &TtyUi, text: &const byte) void {
    buf_reset(&ui.prompt);
    const n: usize = bufx_cstr_len(text);
    if n > 0 {
        _ = buf_append(&ui.prompt, text, n);
    }
    // 注意：**不能**在这里清 line_on_screen —— 屏幕上那一行还在（只是提示符要改），
    // 清了就等于「没有东西要擦」，下次重画会把旧提示符/new prompt 叠在一起。
}

// ============================================================
// 面板块（P15）：输入行块上方的多行窗口（子代理面板等）
//
// 块形状（示例：1 行标题 + 2 行内容 + 1 行底框）：
//
//     ┌──────┐      ← 窗口行 0
//     │ ● …  │      ← 窗口行 1
//     └──────┘      ← 窗口行 2
//     [step 4] > 打字…   ← 输入行（块的最后一行，**恒在第 0 列**）
//
// 不变量（擦除算术全靠它）：
//   * 块底行 = 提示符+输入行，恒从第 0 列开始（窗口行写完之后才写它，前面有 "\r\n" 归零）；
//   * 块首行可能不在第 0 列（流式正文没换行时紧跟在正文后面），列号记在 start_col；
//   * 擦除 = 上移 (rows-1) 行回到块首行（**相对量**，不受终端滚动/绝对行号影响）→
//     右移到 start_col → 逐行 `ESC[2K` 清到块底行为止。
//     逐行清而**不用 `ESC[J`**：后者清到屏幕末尾，会连带清掉「紧跟正文的输入行」下面
//     那些仍然可见的正文文本（缓冲区里还有，屏幕上看不见 = 用户以为丢了输出）。
// ============================================================

// 注册/清除面板块（P15）。clear=true 时清空快照（上层没有任何窗口要显示）。
// 幂等：REPL 每轮都会调。
export fn tty_set_block_provider(ui: &TtyUi, on: bool) void {
    ui.block_enabled = on;
    if !on {
        ui.block_on = false;
    }
}

export fn tty_block_on() bool {
    return tty_ui.block_on;
}

// 提示符+输入行所在的块内相对行（= 全部窗口行占的行数）：写完全部窗口行之后光标已在
// 最后一行的第 0 列，所以提示符+输入就从那一行开始算。
// 不变量：tty_block_vis0(...) == tty_block_rows(...) - 1（自测里断言）。
//
// 实现刻意写成「行数 - 1」而不是再走一遍类似的循环：两个函数的列算术必须**逐字一致**，
// 各写一遍迟早会分叉（第一版就是这样：同样的循环，一个累加得到 2、另一个得到 0）。
export fn tty_block_vis0(b: &[byte], cols: usize, col0: usize) usize {
    const rows: usize = tty_block_rows(b, cols, col0);
    if rows == 0 {
        return 0;
    }
    return rows - 1;
}
// 块占几个物理行：逐行按显示列算（一行写满整行宽时占 1 行 —— DECAWM 挂起换行，
// 口径与 tty_end_row_col / tty_rows_of 一致，踩坑 23）。
export fn tty_block_rows(b: &[byte], cols: usize, col0: usize) usize {
    const n: usize = b.len;
    if n == 0 {
        return 0;
    }
    if cols == 0 {
        return 1;
    }
    var c: usize = col0;
    var rows: usize = 0;
    var i: usize = 0;
    while i < n {
        const nl: isize = bufx_find_byte(b, 10 as byte, i);
        var stop: usize = n;
        var last: bool = true;
        if nl >= 0 {
            stop = nl as usize;
            last = false;
        }
        var w: usize = tty_cols_between(b.ptr as &const byte, i, stop);
        if w == 0 {
            w = 1;          // 空行也占一行
        }
        const t: usize = c + w;
        var r: usize = t / cols;
        if r == 0 {
            r = 1;          // 挂起换行：正好写满整行仍停在**本行**最后一列
        }
        rows = rows + r;
        c = t % cols;
        if last {
            i = n;
        } else {
            i = stop + 1;
            c = 0;
        }
    }
    return rows;
}

// total 列文本在 cols 列终端里占几行（挂起换行口径：正好写满整行算 1 行）
fn tty_block_line_rows(total: usize, cols: usize) usize {
    if cols == 0 {
        return 1;
    }
    const r: usize = total / cols;
    if r == 0 {
        return 1;
    }
    return r;
}

// 从 (base_row, base_col) 起算 total 列之后，光标的绝对行列。
// 老函数 tty_end_row_col 就是 base 为 (0,0) 的特例 —— 面板块擦除之后必须从「已知的块首行」
// 这个基准点重新算，否则「光标已在目标位置就不发序列」那条捷径会在**块变矮**时提前返回，
// 把新块的尾巴留在屏幕上、并把 cur_row 记错（下一次擦除就错位）。
export fn tty_end_pos(total: usize, cols: usize, base_row: usize, base_col: usize, row: &usize, col: &usize) void {
    if cols == 0 {
        row[0] = base_row;
        col[0] = base_col;
        return;
    }
    const t: usize = base_col + total;
    const r: usize = t / cols;
    const c: usize = t % cols;
    if c == 0 && t > 0 {
        row[0] = base_row + r - 1;      // 挂起换行：仍停在本行最后一列
        col[0] = cols - 1;
        return;
    }
    row[0] = base_row + r;
    col[0] = c;
}

// 面板块的擦除序列：先回到块首行 → 右移到块首列 → 逐行清到底。
// 返回写入的字节数；out_col 回传擦除后的光标绝对列（块首行第 col0 列）。
// 自测逐字节断言这里 —— 错一个字节屏幕上就是残影或错位。
export fn tty_build_block_erase(dst: &byte, rows: usize, col0: usize, out_col: &usize) usize {
    var r: usize = rows;
    if r == 0 {
        r = 1;              // rows==0 不合法：退化成单行，绝不写 ESC[0A
    }
    var k: usize = 0;
    if r > 1 {
        dst[k] = 27; k = k + 1;          // ESC [ <r-1> A
        dst[k] = 91; k = k + 1;
        k = k + tty_put_dec(&dst[k], r - 1, 3);
        dst[k] = 65; k = k + 1;
    }
    dst[k] = 13; k = k + 1;              // '\r' 回第 0 列
    if col0 > 0 {
        dst[k] = 27; k = k + 1;          // ESC [ <col0> C（col0=0 时不能写，CSI 参数 0 是默认值）
        dst[k] = 91; k = k + 1;
        k = k + tty_put_dec(&dst[k], col0, 3);
        dst[k] = 67; k = k + 1;
    }
    var i: usize = 0;
    while i < r {
        dst[k] = 27; k = k + 1;          // ESC [ 2 K
        dst[k] = 91; k = k + 1;
        dst[k] = 50; k = k + 1;
        dst[k] = 75; k = k + 1;
        dst[k] = 13; k = k + 1;          // '\r'
        i = i + 1;
    }
    out_col[0] = col0;
    return k;
}

// 快照变了就立刻重画一次（面板原地更新）。屏幕上没有输入行时什么都不做 ——
// 下一次正常重画自然会带上新快照（tty_draw_line 直接读 ui.block）。
export fn tty_block_redraw(ui: &TtyUi, fd: i32) void {
    if !ui.block_on || !ui.line_on_screen {
        return;
    }
    tty_draw_line(ui, fd);
}

// 上层把新快照推下来（内容变了才调）。注意**不要**在这里动 block_on：
// 屏幕上那一块还是旧样子，擦除要按旧行数来，等 tty_draw_line 时再一起换。
export fn tty_block_set(ui: &TtyUi, text: &const byte, n: usize) void {
    buf_reset(&ui.block);
    if n > 0 && n <= TTY_BLOCK_TEXT_MAX {
        _ = buf_append(&ui.block, text, n);
    }
}

// 便利wrapper：正常路径只有 tty_ui 一个界面
export fn tty_block_begin(text: &const byte, n: usize) void {
    tty_block_set(&tty_ui, text, n);
}

export fn tty_block_clear() void {
    tty_block_set(&tty_ui, null as &const byte, 0);
}

export fn tty_block_len() usize {
    return tty_ui.block.len;
}

// ============================================================
// UTF-8 / 显示列宽
//
// 终端里「字节数 ≠ 字符数 ≠ 列数」：中文 1 字符 = 3 字节 = 2 列。
// 编辑操作按**字符**走（否则退格会砍出半个字符 → 屏幕乱码），
// 光标定位按**列**走（否则中文行的光标会越走越偏）。
// ============================================================

const TTY_U32_7F: u32 = 0x7F;
const TTY_U32_80: u32 = 0x80;
const TTY_U32_C0: u32 = 0xC0;
const TTY_U32_3F: u32 = 0x3F;

// 续字节（10xxxxxx）
export fn tty_is_cont(c: byte) bool {
    return ((c as u32) & TTY_U32_C0) == TTY_U32_80;
}

// 首字节引导的字符长度（1..4）。非法字节按 1 处理：保证编辑操作永远前进、不会卡死。
export fn tty_utf8_len(c: byte) usize {
    const v: u32 = c as u32;
    if v < 0x80 {
        return 1;
    }
    if v >= 0xC2 && v <= 0xDF {
        return 2;
    }
    if v >= 0xE0 && v <= 0xEF {
        return 3;
    }
    if v >= 0xF0 && v <= 0xF4 {
        return 4;
    }
    return 1;   // 0x80..0xC1 / 0xF5..0xFF：坏字节，当单字节走
}

// 字节下标 i 处**上一个字符**的起点（i 必须是字符边界；i=0 时返回 0）
export fn tty_utf8_prev(s: &const byte, i: usize) usize {
    if i == 0 {
        return 0;
    }
    var k: usize = 1;
    while k < 4 && k < i && tty_is_cont(s[i - k]) {
        k = k + 1;
    }
    return i - k;
}

// 字节下标 i 处字符**之后**的下标（截到 n）
export fn tty_utf8_next(s: &const byte, i: usize, n: usize) usize {
    if i >= n {
        return n;
    }
    const need: usize = tty_utf8_len(s[i]);
    var j: usize = i + 1;
    while j < i + need && j < n && tty_is_cont(s[j]) {
        j = j + 1;
    }
    return j;
}

// 解码 i 处的字符；坏序列返回 U+FFFD（不返回 0，避免和 NUL 混淆）
export fn tty_utf8_decode(s: &const byte, i: usize, n: usize) u32 {
    if i >= n {
        return 0xFFFD;
    }
    const c: u32 = s[i] as u32;
    const need: usize = tty_utf8_len(s[i]);
    if need == 1 {
        return c;
    }
    if i + need > n {
        return 0xFFFD;
    }
    var v: u32 = c & (TTY_U32_7F >> (need as i32));
    var k: usize = 1;
    while k < need {
        const b: u32 = s[i + k] as u32;
        if (b & TTY_U32_C0) != TTY_U32_80 {
            return 0xFFFD;
        }
        v = (v << 6) | (b & TTY_U32_3F);
        k = k + 1;
    }
    return v;
}

// 一个码点占几列：东亚宽字符 2 列，组合符/零宽 0 列，其余 1 列（终端里常见的范围够用）
export fn tty_char_cols(cp: u32) usize {
    if cp == 0 {
        return 0;
    }
    if cp < 0x20 || (cp >= 0x7F && cp < 0xA0) {
        return 0;
    }
    if (cp >= 0x0300 && cp <= 0x036F) || (cp >= 0x200B && cp <= 0x200F) || cp == 0xFEFF {
        return 0;
    }
    if cp >= 0x1100 && cp <= 0x115F { return 2; }        // 韩文字母
    if cp >= 0x2E80 && cp <= 0x303E { return 2; }        // 部首扩展 / 标点
    if cp >= 0x3041 && cp <= 0x33FF { return 2; }        // 假名 / 注音 / 兼容
    if cp >= 0x3400 && cp <= 0x4DBF { return 2; }        // CJK 扩展 A
    if cp >= 0x4E00 && cp <= 0x9FFF { return 2; }        // CJK 基本区
    if cp >= 0xA000 && cp <= 0xA4CF { return 2; }        // 彝文
    if cp >= 0xAC00 && cp <= 0xD7A3 { return 2; }        // 韩文音节
    if cp >= 0xF900 && cp <= 0xFAFF { return 2; }        // CJK 兼容
    if cp >= 0xFE30 && cp <= 0xFE6F { return 2; }        // CJK 兼容形式
    if cp >= 0xFF00 && cp <= 0xFF60 { return 2; }        // 全角
    if cp >= 0xFFE0 && cp <= 0xFFE6 { return 2; }        // 全角符号
    if cp >= 0x1F300 && cp <= 0x1F64F { return 2; }      // emoji
    if cp >= 0x1F900 && cp <= 0x1F9FF { return 2; }
    if cp >= 0x20000 && cp <= 0x3FFFD { return 2; }      // CJK 扩展 B 及以后
    return 1;
}

// s[a..b) 的显示列宽
export fn tty_cols_between(s: &const byte, a: usize, b: usize) usize {
    var cols: usize = 0;
    var i: usize = a;
    while i < b {
        cols = cols + tty_char_cols(tty_utf8_decode(s, i, b));
        i = tty_utf8_next(s, i, b);
    }
    return cols;
}

// ============================================================
// 诊断字节 → 终端安全预览（纯函数）
//
// 为什么需要它：诊断打的是**外来字节**（网关错误体 / 坏 payload 头部 / 网关错误消息）。
// 这些字节既可能夹带控制字节（含 ESC），也可能正好在多字节字符中间被截断
// （`llm_err_head` 按字节收 240B、`dump_*_error` 按字节收 4096B）。直接 out_err_bytes
// 打出去有三个后果：
//   1) 半个汉字上屏 —— 屏幕上那串乱码；
//   2) ESC 序列能改写终端状态（清屏 / 挪光标）；
//   3) 一屏 JSON 灌进转录，把真正的对话冲掉（TUI 把 fd 2 的每一行都渲染成带 `· `
//      前缀的 NOTICE 行，一条诊断就是一整块）。
// 规则（唯一来源：agent 的 out_diag 与 --dry-run 共用）：
//   * 可打印 ASCII（0x20..0x7E）原样；
//   * `\n` `\t` → 两字符转义（**整条预览只有一行**，换行不再灌屏）；
//   * 其余 < 0x20（含 ESC / NUL / CR）与 0x7F → `\xNN`；
//   * >= 0x80：完整 UTF-8 序列原样透传；非法 / 半截字节 → 逐字节 `\xNN`；
//   * 到达 cap 时**在输入字符边界上停**（绝不把多字节字符切一半）。
// 返回吃进去的**源字节数**：used < n 表示被截断，调用方自己补「… <n> bytes total」。
// ============================================================
const TTY_DIAG_ESC_MAX: usize = 4;     // 一个源字节最长的展开形式 "\xNN"

fn tty_diag_put_hex(dst: &Buf, c: byte) void {
    _ = buf_append_cstr(dst, "\\x");
    const v: usize = c as usize;
    const hi: usize = v >> 4;
    const lo: usize = v & (15 as usize);
    _ = buf_append_byte(dst, (if hi < 10 { 48 + hi } else { 87 + hi }) as byte);
    _ = buf_append_byte(dst, (if lo < 10 { 48 + lo } else { 87 + lo }) as byte);
}

export fn tty_diag_escape_into(dst: &Buf, p: &const byte, n: usize, cap: usize) usize {
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c >= 0x20 as byte && c <= 0x7e as byte {
            if dst.len + 1 > cap {
                return i;
            }
            _ = buf_append_byte(dst, c);
            i = i + 1;
            continue;
        }
        if c < 0x80 as byte {
            // 控制字节（含 ESC / NUL / CR）：短转义优先，其余走 \xNN
            var esc: [byte: 2] = [0: 2];
            var elen: usize = 0;
            if c == 10 as byte {
                esc[0] = 92;
                esc[1] = 110;
                elen = 2;
            } else if c == 9 as byte {
                esc[0] = 92;
                esc[1] = 116;
                elen = 2;
            }
            if elen > 0 {
                if dst.len + elen > cap {
                    return i;
                }
                _ = buf_append(dst, &esc[0], elen);
            } else {
                if dst.len + TTY_DIAG_ESC_MAX > cap {
                    return i;
                }
                tty_diag_put_hex(dst, c);
            }
            i = i + 1;
            continue;
        }
        // >= 0x80：完整序列原样透传；非法 / 半截逐字节转义
        //   注意 tty_utf8_decode 对「孤立的续字节」返回的是字节本身而不是 U+FFFD，
        //   所以这里必须先用 tty_utf8_len 判「是不是合法引导字节 + 长度对不对」。
        const need: usize = tty_utf8_len(c);
        const step: usize = tty_utf8_next(p, i, n) - i;
        var good: bool = need > 1 && step == need;
        if good {
            const cp: u32 = tty_utf8_decode(p, i, n);
            if cp == 0xFFFD {
                // 真的 U+FFFD（EF BF BD）要原样留着，别把它当坏字节再转义一次
                good = step == 3 && c == 239 as byte
                    && p[i + 1] == 191 as byte && p[i + 2] == 189 as byte;
            }
        }
        if good {
            if dst.len + step > cap {
                return i;
            }
            _ = buf_append(dst, p + i, step);
            i = i + step;
            continue;
        }
        if dst.len + TTY_DIAG_ESC_MAX > cap {
            return i;
        }
        tty_diag_put_hex(dst, c);
        i = i + 1;
    }
    return n;
}

// 正文/工具行的显示列预算（P14）：跟着终端宽度走，收在 [40, 200]，留 2 列余量；
// 非交互时 tty_ui.cols 就是初始的 80。
export fn tty_body_width() usize {
    var c: usize = tty_ui.cols;
    if c < 40 {
        c = 40;
    }
    if c > 200 {
        c = 200;
    }
    return c - 2;
}

// s[0..n) 按显示列截断：返回**保留的字节数**（不写任何东西）。
// 调用方按 keep < n 判断是否被截断，自己在末尾补 '…'。宽字符不会被砍成半个
// （只在 UTF-8 字符边界上回退），非法字节按 1 列宽，保证指针一定前进。
export fn tty_clip_bytes(s: &const byte, n: usize, max_cols: usize) usize {
    var cols: usize = 0;
    var i: usize = 0;
    while i < n {
        const step: usize = tty_utf8_next(s, i, n);
        const w: usize = tty_char_cols(tty_utf8_decode(s, i, n));
        if cols + w > max_cols {
            return i;
        }
        cols = cols + w;
        i = step;
    }
    return n;
}

// s[0..n) 从**尾部**按显示列保留：返回保留的字节数（保留的是 s[n-keep .. n)）。
// 与 tty_clip_bytes 对称（那边截尾、这边截头），调用方按 keep < n 判断是否被截断、
// 自己在前面补 '…'。P16 的思考行滚动显示用它：屏幕上只留最新的一段。
// 从尾部反向扫描：先退到非续字节（0x80..0xBF）确定字符起点，再解码取列宽。
// `end` 每轮严格变小（start ≤ end-1），非法字节按 1 列宽，所以指针一定前进、不会死循环。
export fn tty_clip_tail_bytes(s: &const byte, n: usize, max_cols: usize) usize {
    var cols: usize = 0;
    var end: usize = n;
    while end > 0 {
        var start: usize = end - 1;
        while start > 0 && tty_is_cont(s[start]) {
            start = start - 1;
        }
        const w: usize = tty_char_cols(tty_utf8_decode(s, start, end));
        if cols + w > max_cols {
            return n - end;
        }
        cols = cols + w;
        end = start;
    }
    return n;
}

// ============================================================
// 行编辑器
// ============================================================
fn tty_push_ev(ui: &TtyUi, ev: i32) void {
    const idx: usize = ui.evn;
    if idx < TTY_EVQ_MAX {
        ui.evq[idx] = ev;
        ui.evn = idx + 1;
    }
}

export fn tty_next_event(ui: &TtyUi) i32 {
    if ui.evn == 0 {
        return TTY_EV_NONE;
    }
    const ev: i32 = ui.evq[0];
    var i: usize = 0;
    while i + 1 < ui.evn {
        ui.evq[i] = ui.evq[i + 1];
        i = i + 1;
    }
    ui.evn = ui.evn - 1;
    return ev;
}

export fn tty_line(ui: &const TtyUi) &[byte] {
    return ui.line.ptr[0: ui.line.len];
}

export fn tty_line_len(ui: &const TtyUi) usize {
    return ui.line.len;
}

export fn tty_line_clear(ui: &TtyUi) void {
    ui.line.len = 0;
    ui.cursor = 0;
}

fn tty_line_insert(ui: &TtyUi, c: byte) void {
    if ui.line.len >= TTY_LINE_MAX {
        return;
    }
    if !buf_reserve(&ui.line, 1) {
        return;
    }
    var i: usize = ui.line.len;
    while i > ui.cursor {
        ui.line.ptr[i] = ui.line.ptr[i - 1];
        i = i - 1;
    }
    ui.line.ptr[ui.cursor] = c;
    ui.line.len = ui.line.len + 1;
    ui.cursor = ui.cursor + 1;
}

// 删掉 line[from..to) 并按删除量修正光标（from/to 都必须是字符边界）
fn tty_line_erase(ui: &TtyUi, from: usize, to: usize) void {
    if from >= to || to > ui.line.len {
        return;
    }
    const gap: usize = to - from;
    var i: usize = from;
    while i + gap < ui.line.len {
        ui.line.ptr[i] = ui.line.ptr[i + gap];
        i = i + 1;
    }
    ui.line.len = ui.line.len - gap;
    ui.cursor = from;
}

// 退格：删**一个字符**（中文 3 字节一起走，否则屏幕上留半个字符 = 乱码）
fn tty_line_backspace(ui: &TtyUi) void {
    if ui.cursor == 0 {
        return;
    }
    const from: usize = tty_utf8_prev(ui.line.ptr as &const byte, ui.cursor);
    tty_line_erase(ui, from, ui.cursor);
}

// Delete / 非空行 Ctrl-D：删光标处的**一个字符**
fn tty_line_delete(ui: &TtyUi) void {
    if ui.cursor >= ui.line.len {
        return;
    }
    const to: usize = tty_utf8_next(ui.line.ptr as &const byte, ui.cursor, ui.line.len);
    tty_line_erase(ui, ui.cursor, to);
}

fn tty_line_del_word(ui: &TtyUi) void {
    while ui.cursor > 0 && ui.line.ptr[ui.cursor - 1] == 32 as byte {
        tty_line_backspace(ui);
    }
    while ui.cursor > 0 && ui.line.ptr[ui.cursor - 1] != 32 as byte {
        tty_line_backspace(ui);
    }
}

// 历史：把当前行存进历史（非空且与最后一条不同）
fn tty_hist_push(ui: &TtyUi) void {
    const n: usize = ui.line.len;
    if n == 0 {
        return;
    }
    if ui.hist_len > 0 && ui.hist_len <= TTY_HIST_MAX {
        const last_idx: usize = ui.hist_len - 1;
        if last_idx >= TTY_HIST_MAX {
            return;
        }
        const last: &Buf = &ui.hist[last_idx];
        if last.len == n && bufx_mem_eq(last.ptr as &const byte, ui.line.ptr as &const byte, n) {
            return;
        }
    }
    if ui.hist_len >= TTY_HIST_MAX {
        // 丢最老
        buf_free(&ui.hist[0]);
        var i: usize = 0;
        while i + 1 < ui.hist_len {
            ui.hist[i] = ui.hist[i + 1];
            i = i + 1;
        }
        ui.hist_len = ui.hist_len - 1;
    }
    const slot: usize = ui.hist_len;
    if slot >= TTY_HIST_MAX {
        return;
    }
    ui.hist[slot] = buf_new(n + 8);
    if buf_valid(&ui.hist[slot]) {
        _ = buf_append(&ui.hist[slot], ui.line.ptr, n);
    }
    ui.hist_len = slot + 1;
}

fn tty_hist_move(ui: &TtyUi, up: bool) void {
    if ui.hist_len == 0 {
        return;
    }
    if up {
        if ui.hist_pos < 0 {
            // 首次上翻：暂存当前行
            buf_reset(&ui.stash);
            _ = buf_append(&ui.stash, ui.line.ptr, ui.line.len);
            ui.hist_pos = (ui.hist_len as i32) - 1;
        } else if ui.hist_pos > 0 {
            ui.hist_pos = ui.hist_pos - 1;
        } else {
            return;
        }
    } else {
        if ui.hist_pos < 0 {
            return;
        }
        if ui.hist_pos + 1 < (ui.hist_len as i32) {
            ui.hist_pos = ui.hist_pos + 1;
        } else {
            ui.hist_pos = -1;
            ui.line.len = 0;
            _ = buf_append(&ui.line, ui.stash.ptr, ui.stash.len);
            ui.cursor = ui.line.len;
            return;
        }
    }
    const idx: usize = ui.hist_pos as usize;
    if idx >= TTY_HIST_MAX {
        return;
    }
    ui.line.len = 0;
    _ = buf_append(&ui.line, ui.hist[idx].ptr, ui.hist[idx].len);
    ui.cursor = ui.line.len;
}

fn tty_esc_apply(ui: &TtyUi, final: byte) void {
    const f: i32 = final as i32;
    if f == 65 {
        tty_hist_move(ui, true);         // Up
    } else if f == 66 {
        tty_hist_move(ui, false);        // Down
    } else if f == 67 {
        if ui.cursor < ui.line.len {
            // 右移一个**字符**（中文 3 字节一起跳）
            ui.cursor = tty_utf8_next(ui.line.ptr as &const byte, ui.cursor, ui.line.len);
        }
    } else if f == 68 {
        if ui.cursor > 0 {
            ui.cursor = tty_utf8_prev(ui.line.ptr as &const byte, ui.cursor);
        }
    } else if f == 72 {
        ui.cursor = 0;                   // Home
    } else if f == 70 {
        ui.cursor = ui.line.len;         // End
    } else if f == 51 {
        tty_line_delete(ui);             // ESC[3~
    } else if f == 49 || f == 55 {
        ui.cursor = 0;                   // ESC[1~ / ESC[7~
    } else if f == 52 || f == 56 {
        ui.cursor = ui.line.len;         // ESC[4~ / ESC[8~
    }
}

// 喂入一个字节；事件进队列（调用方用 tty_next_event 取）
fn tty_feed_byte(ui: &TtyUi, c: byte) void {
    const v: i32 = c as i32;

    if ui.esc == 1 {
        if v == 91 || v == 79 {          // '[' / 'O'
            ui.esc = 2;
            ui.esc_arg = 0;
            return;
        }
        ui.esc = 0;
        tty_push_ev(ui, TTY_EV_ESC);
        return;
    }
    if ui.esc == 2 || ui.esc == 3 {
        if v >= 48 && v <= 57 {
            ui.esc = 3;
            ui.esc_arg = ui.esc_arg * 10 + (v - 48);
            return;
        }
        if v == 126 {                    // '~'
            ui.esc = 0;
            tty_esc_apply(ui, 51 as byte);
            return;
        }
        ui.esc = 0;
        tty_esc_apply(ui, c);
        return;
    }

    if v == 27 {                          // ESC
        ui.esc = 1;
        return;
    }
    if v == 13 || v == 10 {               // Enter（raw 模式下来的是 CR）
        if ui.line.len > 0 {
            tty_hist_push(ui);
            ui.hist_pos = -1;
            tty_push_ev(ui, TTY_EV_SUBMIT);
        }
        return;
    }
    if v == 3 {                           // Ctrl-C
        tty_push_ev(ui, TTY_EV_CTRL_C);
        return;
    }
    if v == 4 {                           // Ctrl-D
        if ui.line.len == 0 {
            tty_push_ev(ui, TTY_EV_EOF);
        } else {
            tty_line_delete(ui);
        }
        return;
    }
    if v == 21 {                          // Ctrl-U
        tty_line_clear(ui);
        tty_push_ev(ui, TTY_EV_CLEARED);
        return;
    }
    if v == 23 {                          // Ctrl-W
        tty_line_del_word(ui);
        return;
    }
    if v == 12 {                          // Ctrl-L
        tty_push_ev(ui, TTY_EV_REDRAW);
        return;
    }
    if v == 127 || v == 8 {               // Backspace
        tty_line_backspace(ui);
        return;
    }
    if v == 9 {                           // Tab：原样插入
        tty_line_insert(ui, 9 as byte);
        return;
    }
    if v < 32 {                           // 其它控制键：忽略
        return;
    }
    tty_line_insert(ui, c);
}

// 真正逐字节处理；一旦产生事件就把**剩余的字节**存进 pend。
// 不这样做的话，一次 read 拿到 "a\nb\n" 时两行会被拼成一行（粘贴/多行粘贴必踩）。
fn tty_feed_inner(ui: &TtyUi, p: &const byte, n: usize) void {
    var i: usize = 0;
    while i < n {
        const before: usize = ui.evn;
        tty_feed_byte(ui, p[i]);
        i = i + 1;
        if ui.evn > before && i < n {
            _ = buf_append(&ui.pend, &p[i], n - i);
            return;
        }
    }
}

export fn tty_feed(ui: &TtyUi, p: &const byte, n: usize) void {
    // 先把上次剩下的字节处理掉（再出事件就继续留着）
    if ui.pend.len > 0 {
        var tmp: Buf = buf_new(ui.pend.len + 8);
        if buf_valid(&tmp) {
            _ = buf_append(&tmp, ui.pend.ptr, ui.pend.len);
            ui.pend.len = 0;
            tty_feed_inner(ui, tmp.ptr as &const byte, tmp.len);
            buf_free(&tmp);
        }
        if ui.evn > 0 {
            // 本次调用带来的字节也留到下次，绝不能丢
            if n > 0 {
                _ = buf_append(&ui.pend, p, n);
            }
            return;
        }
    }
    tty_feed_inner(ui, p, n);
}

// 还有没喂完的字节？（调用方在等输入前应先把它吃完，否则粘贴的后续行会卡住）
export fn tty_has_pending(ui: &const TtyUi) bool {
    return ui.pend.len > 0;
}

export fn tty_pending_bytes(ui: &const TtyUi) usize {
    return ui.pend.len;
}

// 一批输入读完后的转义冲刷：
// 终端按下 Esc 只发一个 0x1b，而方向键发 0x1b '[' X —— 两者只在「后面还有没有字节」
// 上不同。所以 Esc 是否「裸按」只有在**一次读取结束**时才能判定；半截序列（esc>=2）
// 直接丢弃，避免把用户后续的普通按键当成序列参数吞掉。
export fn tty_flush_esc(ui: &TtyUi) void {
    if ui.esc == 1 {
        ui.esc = 0;
        tty_push_ev(ui, TTY_EV_ESC);
    } else if ui.esc >= 2 {
        ui.esc = 0;
    }
}

// 有可读输入才读（非阻塞），把字节喂给行编辑器。返回是否有新字节。
export fn tty_pump(ui: &TtyUi, fd: i32) bool {
    var pfds: [PollFd: 1] = [PollFd{ fd: fd, events: POLLIN, revents: 0 }];
    const pr: i32 = sys_poll(&pfds[0], 1, 0) catch { 0; };
    if pr <= 0 {
        return false;
    }
    if (pfds[0].revents & POLLIN) == 0 && (pfds[0].revents & POLLHUP) == 0 {
        return false;
    }
    var tmp: [byte: 256] = [0: 256];
    const n: isize = sys_read(fd, &tmp[0], 256) catch { -1 as isize; };
    if n <= 0 {
        return false;
    }
    tty_feed(ui, &tmp[0], n as usize);
    tty_flush_esc(ui);
    return true;
}

// ============================================================
// 渲染
//
// 模型：输入行永远是屏幕上**最后**的一块内容。画一次 = 从「块首行第 start_col 列」
// 写提示符 + 行内容，然后按显示列把光标挪到 cursor 处。擦一次 = 先上移回块首行、
// 右移到块首列、再用 `ESC[J` 清到屏幕末尾（块下面没有别的东西，所以 J 不会误伤输出）。
// 这样即使输入行因为太长折成多行（中文 1 字符 2 列，80 列终端 39 个字就折行），
// 或者它跟在没换行的流式正文后面（start_col > 0），擦除都只擦输入行自己。
// ============================================================

// total 列文本在 cols 列终端里占几行。
// 渲染不再需要它（擦除交给 cur_row + start_col），留着是因为自测要逐条断言这套「挂起换行」
// 口径 —— 口径错一行，屏幕上就是擦不干净或多擦一行。
export fn tty_rows_of(total: usize, cols: usize) usize {
    if cols == 0 || total == 0 {
        return 1;
    }
    if total % cols == 0 {
        return total / cols;
    }
    return (total / cols) + 1;
}

// 写满 total 列之后光标实际停在哪一行哪一列。
// DECAWM：字符正好落在最后一列时光标仍留在本行（挂着待换行），不会立刻跳下一行 ——
// 这个口径必须和 tty_rows_of 一致，否则上移量会差一行、擦除越擦越乱。
// 实现落在 tty_end_pos 上（基准点 = 块首）—— 面板块擦除之后要从块首这个已知点重算。
export fn tty_end_row_col(total: usize, cols: usize, row: &usize, col: &usize) void {
    tty_end_pos(total, cols, 0, 0, row, col);
}

// 把 n 的十进制写进 dst（最多 max_digits 位，max_digits <= 6）；返回写入字节数
export fn tty_put_dec(dst: &byte, n: usize, max_digits: usize) usize {
    var digits: [byte: 6] = [0: 6];
    var v: usize = n;
    var d: usize = 0;
    if v == 0 {
        digits[0] = 48;
        d = 1;
    }
    while v > 0 && d < max_digits {
        digits[d] = (((v % (10 as usize)) as i32) + 48) as byte;
        v = v / (10 as usize);
        d = d + 1;
    }
    var i: usize = 0;
    while i < d {
        dst[i] = digits[d - 1 - i];
        i = i + 1;
    }
    return d;
}

// "\x1b[<n>A"（n>0 才写；n=0 不能写 —— CSI 参数 0 是「默认值」= 上移 1 行）
fn tty_seq_up(dst: &byte, n: usize) usize {
    if n == 0 {
        return 0;
    }
    var k: usize = 0;
    dst[k] = 27; k = k + 1;
    dst[k] = 91; k = k + 1;
    k = k + tty_put_dec(&dst[k], n, 3);
    dst[k] = 65;   // 'A'
    k = k + 1;
    return k;
}

fn tty_erase_line(ui: &TtyUi, fd: i32) void {
    if tty_sink_on {
        return;
    }
    if !tty_active(ui) {
        return;
    }
    if !ui.line_on_screen {
        return;
    }
    var seq: [byte: 20] = [0: 20];
    const k: usize = tty_build_erase_seq(&seq[0], ui.cur_row, ui.start_col);
    _ = sys_write(fd, &seq[0], k) catch {};
    // 擦完光标停在「块首行第 start_col 列」——下一次重画就从这里开始
    ui.line_on_screen = false;
    ui.cur_row = 0;
    ui.out_col = ui.start_col;
    ui.out_wrap = false;
}

// 擦除序列：上移 cur_row 行 → `\r` → 右移到 start_col → `ESC[J`（清到屏幕末尾）。
//
// 为什么不是 `\r ESC[2K`：流式输出期间输入行是紧跟着正文画的，块首列往往不是 0；
// 先回第 0 列再整行擦会把**同一行前半段的正文**一起擦掉（模型刚吐出来的字就没了）。
// 从 start_col 清到屏幕末尾则只擦输入行自己（输入行永远是屏幕上最后的内容）。
//
// 单独抽成函数是为了自测能逐字节断言 —— 这套协议错一个字节，屏幕上就是乱码/残影。
export fn tty_build_erase_seq(dst: &byte, cur_row: usize, start_col: usize) usize {
    var k: usize = tty_seq_up(dst, cur_row);
    dst[k] = 13; k = k + 1;              // '\r' 回第 0 列
    if start_col > 0 {
        dst[k] = 27; k = k + 1;          // ESC [ <start_col> C
        dst[k] = 91; k = k + 1;
        k = k + tty_put_dec(&dst[k], start_col, 3);
        dst[k] = 67;   // 'C'
        k = k + 1;
    }
    dst[k] = 27; k = k + 1;              // ESC [ J
    dst[k] = 91; k = k + 1;
    dst[k] = 74; k = k + 1;
    return k;
}

// 追着 tty_write 写出去的字节推进「物理列」。
// 只关心列与「挂起换行」（一行正好写满时光标停在本行最后一列，下一个字节才换行）。
//
// 已知近似：控制字符（含 TAB）按 0 列算，而终端里 TAB 会跳到下一个制表位 —— 只有 TAB
// 恰好落在「与输入行同一行」的正文里才会把起始列算小几格（擦除时多擦几个字符）。
// 实测带 TAB 的正文（代码块）每行都换行收尾、列模型随即归零，所以没再维护制表位表。
export fn tty_advance_col(ui: &TtyUi, p: &const byte, n: usize) void {
    var cols: usize = ui.cols;
    if cols == 0 {
        cols = 80;
    }
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c == 13 as byte || c == 10 as byte {
            ui.out_col = 0;
            ui.out_wrap = false;
            i = i + 1;
            continue;
        }
        const w: usize = tty_char_cols(tty_utf8_decode(p, i, n));
        const step: usize = tty_utf8_next(p, i, n);
        if w > 0 {
            if ui.out_wrap {
                ui.out_col = 0;
                ui.out_wrap = false;
            }
            if ui.out_col + w > cols {
                ui.out_col = 0;          // 终端自动折行
            }
            ui.out_col = ui.out_col + w;
            if ui.out_col >= cols {
                ui.out_col = cols - 1;
                ui.out_wrap = true;
            }
        }
        i = step;
    }
}

export fn tty_draw_line(ui: &TtyUi, fd: i32) void {
    if tty_sink_on {
        return;
    }
    if !tty_active(ui) {
        return;
    }
    tty_refresh_cols(ui);
    var cols: usize = ui.cols;
    if cols == 0 {
        cols = 80;
    }

    // ---- 面板块：只在「干净行」上画 ----
    // 不干净（模型正文停在半行）时不画窗口行、只画提示符：擦除算术要按整块来算，
    // 半行状态下块首列/行数都不确定，硬画就会把正文擦掉或留下错位的竖线。
    // input_on_screen：屏幕上只留着「空提示符 + 空输入行」，此时复用它当块底行，
    // 不必先换行、也不会多出一行。
    const blk_len: usize = ui.block.len;
    const col0: usize = if ui.out_wrap { 0 as usize } else { ui.out_col };
    // 「干净行」：光标在第 0 列（或上一行正好写满、下一个字节落到第 0 列）。
    // 只有这时候才把窗口行画出来 —— 块首行不在第 0 列时，块的列算术与擦除都会变得
    // 难以自洽（首行会跟正文挤在同一行上，实测会把面板第一行截成半截）。
    const stable: bool = ui.out_col == 0 && !ui.out_wrap;
    const use_block: bool = ui.block_enabled
        && blk_len > 0
        && (ui.prompt.len + ui.line.len) > 0
        && (stable || ui.input_on_screen);

    // 块首物理列（擦除用旧值、重画用新值）：上一行正好写满时（out_wrap）下一字节落到下一行第 0 列
    const old_col0: usize = if ui.out_wrap { 0 as usize } else { ui.out_col };
    const new_col0: usize = if use_block { 0 as usize } else { old_col0 };

    // 先把上一次画的（可能折成好几行）擦干净。擦除只清输入行块自己占的格子。
    var cur_row: usize = ui.cur_row;
    if ui.block_on {
        // 多行面板块：上移 (rows-1) 行回块首行（相对量，扛滚动）→ 右移到块首列 → 逐行清到底。
        var eb: [byte: 512] = [0: 512];
        const ec: usize = tty_build_block_erase(&eb[0], ui.cur_row + 1, ui.start_col, &ui.out_col);
        if ec > 0 {
            _ = sys_write(fd, &eb[0], ec) catch {};
        }
        ui.line_on_screen = false;
        ui.cur_row = 0;
        ui.start_col = ui.out_col;
        ui.out_wrap = false;
        ui.input_on_screen = false;
        cur_row = 0;
    } else {
        tty_erase_line(ui, fd);
    }
    ui.start_col = new_col0;

    // ---- 写：窗口行（每行自带 "\r\n"，保证块底行从第 0 列开始）----
    if use_block {
        const blk: &[byte] = ui.block.ptr[0: blk_len];
        var i: usize = 0;
        while i < blk_len {
            const nl: isize = bufx_find_byte(blk, 10 as byte, i);
            var stop: usize = blk_len;
            var last: bool = true;
            if nl >= 0 {
                stop = nl as usize;
                last = false;
            }
            const ln: usize = stop - i;
            if ln > 0 {
                _ = sys_write(fd, ui.block.ptr + i, ln) catch {};
            }
            _ = sys_write(fd, &TTY_SEQ_CRLF[0], 2) catch {};
            if last {
                i = blk_len;
            } else {
                i = stop + 1;
            }
        }
        ui.out_col = 0;
        ui.out_wrap = false;
    }

    var total: usize = 0;    // 块首起算的总显示列数
    if ui.prompt.len > 0 {
        _ = sys_write(fd, ui.prompt.ptr as *const byte, ui.prompt.len) catch {};
        total = total + tty_cols_between(ui.prompt.ptr as &const byte, 0, ui.prompt.len);
    }
    const pcols: usize = total;
    if ui.line.len > 0 {
        _ = sys_write(fd, ui.line.ptr as *const byte, ui.line.len) catch {};
        total = total + tty_cols_between(ui.line.ptr as &const byte, 0, ui.line.len);
    }
    ui.line_on_screen = true;
    // 屏幕上现在只有「提示符 + 空输入行」（或整块都没有）：此时块可以复用它当底行
    const empty_ctx: bool = (ui.out_col == 0 && !ui.out_wrap) || !ui.input_on_screen;
    ui.input_on_screen = ui.line.len == 0 && empty_ctx;
    // 记下「屏幕上这一块里到底有没有窗口行」——下一次擦除按它选协议（漏掉这一句，
    // 面板就只擦掉输入行、窗口行留在屏幕上，下次重画再叠一层）。
    ui.block_on = use_block;

    // 画完后的物理位置（写满一行的挂起换行口径与 tty_end_row_col 一致）
    var erow: usize = 0;
    var ecol: usize = 0;
    tty_end_row_col(new_col0 + total, cols, &erow, &ecol);
    ui.out_col = ecol;
    const xcols: usize = new_col0 + total;
    ui.out_wrap = xcols > 0 && (xcols % cols) == 0;

    // 光标该在哪：块首列 + 提示符 + 光标前文本的列数。这里必须和 tty_end_row_col 用
    // **同一口径**算行列：写满整行时光标物理上停在最后一列（挂着待换行），不能算成
    // 「下一行第 0 列」，否则擦除时会多上移一行、把上一行输出（banner 之类）擦掉。
    //
    // 基准点（base_row/base_col）取「刚刚擦除后光标的位置」：
    //   * 走了面板块擦除 → 光标在屏幕上的块首行、第 ui.start_col 列（start_col 当绝对列用）；
    //   * 否则 → 光标就在块首位置，基准 (0, 0)。
    // 用基准点重算**绝对**行列（而不是沿用 erow/ecol），块变矮时才不会因为
    // 「光标看起来已经在目标位置」而提前返回、把新块的尾巴留在屏幕上（P15 修）。
    var base_row: usize = 0;
    var base_col: usize = 0;
    if tty_block_on() {
        base_row = cur_row;
        base_col = ui.start_col;
    }
    const ttotal: usize = new_col0 + pcols + tty_cols_between(ui.line.ptr as &const byte, 0, ui.cursor);
    var trow: usize = 0;
    var tcol: usize = 0;
    tty_end_pos(ttotal, cols, base_row, base_col, &trow, &tcol);
    if use_block {
        // 面板块路径：cur_row 是**块首起算**的行号（tty_build_block_erase 按 cur_row+1 上移）。
        // 这里不能用 tty_end_pos 出来的 trow —— 那是相对「擦除后光标位置」的，差一个
        // base_row，下一次擦除就会少上移 base_row 行（屏幕残影/错位就是这么来的）。
        const pend_cols: usize = if ui.out_wrap { 0 as usize } else { ui.out_col };
        ui.cur_row = tty_block_vis0(ui.block.ptr[0: blk_len], cols, new_col0) + ((pend_cols + pcols) / cols);
    } else {
        ui.cur_row = trow;
    }
    if erow == trow && ecol == tcol && !use_block && !tty_block_on() {
        // 光标已经在目标位置（最常见：光标就在行尾）—— 一个字节都不用发。
        // 面板块在场时**不走**这条捷径：块的擦除/重画是逐行做的，"位置相同"并不能保证
        // 屏幕上那一块就是这一帧要的形状（少发一次光标定位就可能在下一帧错位），
        // 而块本身最多几十行，这点开销换的是「每帧字节可预期」。
        return;
    }
    var seq: [byte: 16] = [0: 16];
    var k: usize = 0;
    if erow > trow {
        k = tty_seq_up(&seq[0], erow - trow);
    }
    seq[k] = 13; k = k + 1;              // '\r'
    if tcol > 0 {
        seq[k] = 27; k = k + 1;          // ESC [ <tcol> C（tcol=0 时不能写，同样是「默认值」坑）
        seq[k] = 91; k = k + 1;
        k = k + tty_put_dec(&seq[k], tcol, 3);
        seq[k] = 67;   // 'C'
        k = k + 1;
    }
    _ = sys_write(fd, &seq[0], k) catch {};
}

// 流式输出期间：擦掉输入行块 → 写内容 → 重画。
// 面板块在场时必须整块擦（多行）：只擦输入行会把上面的窗口行留在屏幕上，
// 后面每次重画都在这些残留行上叠一层（实测就是满屏重复的「┌─ agents ──」）。
export fn tty_out_begin(ui: &TtyUi, fd: i32) void {
    if !tty_active(ui) {
        return;
    }
    if ui.block_on && ui.line_on_screen {
        var eb: [byte: 512] = [0: 512];
        const ec: usize = tty_build_block_erase(&eb[0], ui.cur_row + 1, ui.start_col, &ui.out_col);
        if ec > 0 {
            _ = sys_write(fd, &eb[0], ec) catch {};
        }
        ui.line_on_screen = false;
        ui.block_on = false;
        ui.cur_row = 0;
        ui.start_col = ui.out_col;
        ui.out_wrap = false;
        ui.input_on_screen = false;
        return;
    }
    tty_erase_line(ui, fd);
}

export fn tty_out_end(ui: &TtyUi, fd: i32) void {
    if tty_active(ui) {
        tty_draw_line(ui, fd);
    }
}

// C 字符串版本的写（字面量直接可用；避免 &"x"[0:n] 的切片坑）
export fn tty_puts(ui: &TtyUi, fd: i32, s: &const byte) void {
    tty_write(ui, fd, s, bufx_cstr_len(s));
}

// P17：TUI 激活时，所有「显示」字节都不再打到终端，而是交给转录层
//   fd 1 → 助手正文（通道 1）；fd 2 → 工具块/诊断（通道 2）；思考走 tty_reason_write（通道 3）
export var tty_sink_on: bool = false;

// 所有输出（stdout/stderr）都应该走这里，否则会和输入行互相踩
export fn tty_write(ui: &TtyUi, fd: i32, p: &const byte, n: usize) void {
    if tty_sink_on {
        var chan: i32 = 2;
        if fd == 1 {
            chan = 1;
        }
        tui_sink_bytes(chan, p, n);
        return;
    }
    if !tty_active(ui) {
        _ = sys_write(fd, p as *const byte, n) catch {};
        return;
    }
    // 屏幕上没有输入行时不必擦/重画（否则 banner、工具输出都会带上无用的控制序列）
    const was_on: bool = ui.line_on_screen;
    tty_out_begin(ui, fd);
    // 开始写正文：屏幕上那块输入行已经被擦掉了（若本来就没画，则它压根不在屏幕上）
    ui.input_on_screen = false;
    _ = sys_write(fd, p as *const byte, n) catch {};
    tty_advance_col(ui, p, n);
    if was_on {
        tty_out_end(ui, fd);
    }
}

// ============================================================
// 模块级全局：单进程只有一个前台界面
// ============================================================
export var tty_ui: TtyUi = TtyUi{
    is_tty: false,
    raw: false,
    cols: 80,
    rows: 24,
    saved: TtyTermios{
        c_iflag: 0,
        c_oflag: 0,
        c_cflag: 0,
        c_lflag: 0,
        c_line: 0,
        c_cc: [0: 32],
        pad: [0: 3],
        c_ispeed: 0,
        c_ospeed: 0,
    },
    line: Buf{ ptr: null, len: 0, cap: 0 },
    cursor: 0,
    prompt: Buf{ ptr: null, len: 0, cap: 0 },
    esc: 0,
    esc_arg: 0,
    evq: [0: TTY_EVQ_MAX],
    evn: 0,
    hist: [],
    hist_len: 0,
    hist_pos: -1,
    stash: Buf{ ptr: null, len: 0, cap: 0 },
    pend: Buf{ ptr: null, len: 0, cap: 0 },
    line_on_screen: false,
    cur_row: 0,
    start_col: 0,
    out_col: 0,
    out_wrap: false,
    block: Buf{ ptr: null, len: 0, cap: 0 },
    block_enabled: false,
    block_on: false,
    input_on_screen: false,
};

// 给 llm/工具用的薄封装：流式增量也走输入行擦除/重画协议
export fn tty_stream_write(fd: i32, p: &const byte, n: usize) void {
    tty_write(&tty_ui, fd, p, n);
}

// 思考（reasoning）走单独通道：滚动模式仍然打到 fd 2（与 P14 的 ✻ 思考 块一致），
// TUI 模式下进「思考条目」（只留最新一段）
export fn tty_reason_write(p: &const byte, n: usize) void {
    if tty_sink_on {
        tui_sink_bytes(3, p, n);
        return;
    }
    tty_write(&tty_ui, 2, p, n);
}

export fn tty_is_interactive() bool {
    return tty_active(&tty_ui);
}

// ============================================================
// P22：终端标题（TTY title）
//
// 交互模式跑起来以后，把**终端窗口/标签页的标题**（xterm 的 OSC 2）写成
// 「当前会话的标题」。三件事：
//   1) 进界面时压标题栈（`ESC [ 2 2 t`）、退出或收到终止信号时弹栈（`ESC [ 2 3 t`）
//      —— 终端支持 xterm 标题栈时，退出后能回到 shell 原来的标题；不支持的终端会
//      忽略这两条（保留我们最后写的标题，不比「不弹栈」差）。**故意不写空标题**：
//      把标签页清成空串比留着一个会话标题更糟。
//   2) 标题串的清洗（`tty_title_clean_into`）—— 这是全仓**唯一**的标题规范化实现：
//      去 OSC/CSI/ESC 序列、去 C0/C1 控制字节、去零宽与方向控制符、空白折叠 + 去首尾、
//      按码点边界收字节上限。用户输入与外来会话日志都是不可信字节，一个没清掉的
//      `ESC` / `BEL` 就能把标题变成「注入面」（甚至吃掉后面屏幕上的字节）。
//      口径对齐 DSH 的 `@deepseek-ai/dsh-session-title`：cleanTitleText + truncateTitleUtf8，
//      上限取 DSH preset 的 `maxTitleBytes: 80` / `fallbackMaxWords: 5` / `fallbackMaxBytes: 40`。
//   3) 去重 + 编码上屏（`tty_title_set`）：同一个标题只写一次；整条序列**一次**
//      `sys_write` 写完（拆成多次写，进程正好死在中间就会留下一个没终结的 OSC，
//      终端会把它后面的输出一起吃掉）。
//
// 两条容易踩的线（都写进 README 踩坑 35）：
//   * 必须直接 `sys_write` 到界面自己的 fd，**不能走 `tty_write`** —— TUI 激活后
//     `tty_sink_on = true`，走 `tty_write` 会把控制序列当成显示字节吞进转录条目；
//   * 只有真 TTY 的交互界面才允许打开这个通道（`tty_title_begin` 的调用点全部在
//     「stdin 是 TTY 且拿到输出 fd」之后），管道/一次性运行里一个 OSC 字节都不许有。
// ============================================================

const TTY_TITLE_MAX_BYTES: usize = 80;        // DSH maxTitleBytes
const TTY_TITLE_FALLBACK_WORDS: usize = 5;    // DSH fallbackMaxWords
const TTY_TITLE_FALLBACK_BYTES: usize = 40;   // DSH fallbackMaxBytes
const TTY_TITLE_SEQ_MAX: usize = TTY_TITLE_MAX_BYTES + 8;   // OSC 2 前缀 + 标题 + BEL

var g_title_fd: i32 = -1;
var g_title_on: bool = false;
var g_title_buf: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_title_last: Buf = Buf{ ptr: null, len: 0, cap: 0 };

fn tty_title_ensure() void {
    if !buf_valid(&g_title_buf) {
        g_title_buf = buf_new(TTY_TITLE_MAX_BYTES + 16);
    }
    if !buf_valid(&g_title_last) {
        g_title_last = buf_new(TTY_TITLE_MAX_BYTES + 16);
    }
}

// ASCII 空白（TAB/LF/VT/FF/CR/空格）：清洗时折叠成一个空格
fn tty_title_ascii_space(c: byte) bool {
    return c == 32 as byte || (c >= 9 as byte && c <= 13 as byte);
}

// 码点层面的空白（对齐 JS 正则 `\s` 的常见范围，DSH 的 cleanTitleText 用的就是 `\s+`）
fn tty_title_cp_space(cp: u32) bool {
    if cp == 32 || (cp >= 9 && cp <= 13) {
        return true;
    }
    if cp == 0xA0 || cp == 0x1680 || cp == 0x2028 || cp == 0x2029
        || cp == 0x202F || cp == 0x205F || cp == 0x3000 {
        return true;
    }
    return cp >= 0x2000 && cp <= 0x200A;
}

// 不可见但会影响显示的控制符：零宽、方向控制、词连接符等（DSH 的 DIRECTIONAL_CONTROL）
fn tty_title_cp_invisible(cp: u32) bool {
    if cp == 0x200B || cp == 0x200E || cp == 0x200F || cp == 0xFEFF {
        return true;
    }
    if cp >= 0x202A && cp <= 0x202E {
        return true;
    }
    if cp >= 0x2060 && cp <= 0x2064 {
        return true;
    }
    return cp >= 0x2066 && cp <= 0x206F;
}

// i 处是 ESC：返回「整个控制序列之后」的下标。OSC 吃到 BEL / ST（未终结就吃到尾）、
// CSI 吃到终结字节、其余 ESC 序列吃两字节；末尾孤立的 ESC 也吃掉（否则它会留在标题里）。
fn tty_title_skip_esc(s: &const byte, i: usize, n: usize) usize {
    var k: usize = i + 1;
    if k >= n {
        return k;
    }
    const c: byte = s[k];
    if c == 93 as byte {
        // OSC：ESC ] … BEL 或 ESC \（ST）
        k = k + 1;
        while k < n {
            if s[k] == 7 as byte {
                return k + 1;
            }
            if s[k] == 27 as byte {
                if k + 1 < n && s[k + 1] == 92 as byte {
                    return k + 2;
                }
                return k;        // 又一个 ESC：交给下一轮当新序列处理
            }
            k = k + 1;
        }
        return n;                // 未终结的 OSC：整段吃掉
    }
    if c == 91 as byte {
        // CSI：ESC [ 参数/中间字节 终结字节（0x40..0x7E）
        k = k + 1;
        while k < n {
            const b: byte = s[k];
            if b >= 0x40 as byte && b <= 0x7e as byte {
                return k + 1;
            }
            k = k + 1;
        }
        return n;
    }
    if c >= 0x20 as byte && c <= 0x2f as byte {
        // 带中间字节的 ESC 序列（ESC ( B 之类）
        k = k + 1;
        while k < n {
            const b: byte = s[k];
            if b >= 0x30 as byte && b <= 0x7e as byte {
                return k + 1;
            }
            k = k + 1;
        }
        return n;
    }
    return k + 1;                // 两字节 ESC 序列
}

// 清洗一段不可信字节 → 一行标题。返回写入 dst 的字节数（可能是 0）。
//
// 规则（逐码点）：
//   * ESC 引导的 OSC/CSI/两字节 ESC 序列：整段丢弃；
//   * C0/C1 控制字节丢弃（TAB/LF/VT/FF/CR 当空白），DEL 丢弃；
//   * 空白折叠成一个空格、首尾不留空格（末尾那个「待定空格」只在后面真的还有字符时才写）；
//   * 零宽 / 方向控制符丢弃；
//   * 非法或半截 UTF-8 丢弃（**不留半个汉字**：多字节只在完整序列上通过）；
//   * 输出按 `max_bytes` 收口，切点一定落在码点边界上。
export fn tty_title_clean_into(dst: &Buf, src: &const byte, n: usize, max_bytes: usize) usize {
    buf_reset(dst);
    var pending_space: bool = false;
    var i: usize = 0;
    while i < n {
        const c: byte = src[i];
        if c == 27 as byte {
            i = tty_title_skip_esc(src, i, n);
            continue;
        }
        if tty_title_ascii_space(c) {
            // 空格以及 TAB/LF/VT/FF/CR：都只是一个「待定空格」（折叠 + 去首尾）
            if dst.len > 0 {
                pending_space = true;
            }
            i = i + 1;
            continue;
        }
        if c < 0x20 as byte || c == 0x7f as byte {
            // 其余 C0 与 DEL 直接丢（C1 的 0x80..0x9F 单字节形态不是合法 UTF-8 引导字节，
            // 在下面按「非法序列」丢掉）
            i = i + 1;
            continue;
        }
        if c < 0x80 as byte {
            if pending_space {
                if dst.len + 1 > max_bytes {
                    break;
                }
                _ = buf_append_byte(dst, 32);
                pending_space = false;
            }
            if dst.len + 1 > max_bytes {
                break;
            }
            _ = buf_append_byte(dst, c);
            i = i + 1;
            continue;
        }
        const need: usize = tty_utf8_len(c);
        const step: usize = tty_utf8_next(src, i, n) - i;
        if need <= 1 || step != need {
            // 坏引导字节 / 半截序列：丢一个字节继续（绝不把半个字符写进标题）
            i = i + 1;
            continue;
        }
        const cp: u32 = tty_utf8_decode(src, i, n);
        if tty_title_cp_invisible(cp) {
            i = i + step;
            continue;
        }
        if tty_title_cp_space(cp) {
            if dst.len > 0 {
                pending_space = true;
            }
            i = i + step;
            continue;
        }
        if pending_space {
            if dst.len + 1 > max_bytes {
                break;
            }
            _ = buf_append_byte(dst, 32);
            pending_space = false;
        }
        if dst.len + step > max_bytes {
            break;
        }
        _ = buf_append(dst, src + i, step);
        i = i + step;
    }
    return dst.len;
}

// 前 max_words 个空白分词之后的下标（清洗过的串上调用）
fn tty_title_words_end(s: &const byte, n: usize, max_words: usize) usize {
    if max_words == 0 {
        return 0;
    }
    var words: usize = 0;
    var i: usize = 0;
    while i < n {
        if s[i] == 32 as byte {
            i = i + 1;
            continue;
        }
        words = words + 1;
        while i < n && s[i] != 32 as byte {
            i = i + 1;
        }
        if words >= max_words {
            return i;
        }
    }
    return n;
}

// 首条用户消息 → 兜底标题。顺序与 DSH 的 `fallbackSessionTitle` 一致：
// 先清洗全文 → 取前 max_words 个词 → 再按 max_bytes（码点边界）截断。
// 第一遍的字节上限取 `max_bytes + 1` 就够：最终结果一定是这一遍输出的前缀，
// 而空白折叠让「待定空格」不占输出字节，所以 40 B 的结论不会被更长的输入改变。
export fn tty_title_fallback_into(
    dst: &Buf,
    src: &const byte,
    n: usize,
    max_words: usize,
    max_bytes: usize
) usize {
    buf_reset(dst);
    if max_bytes == 0 {
        return 0;
    }
    var tmp: Buf = buf_new(max_bytes + 2);
    defer { buf_free(&tmp); }
    _ = tty_title_clean_into(&tmp, src, n, max_bytes + 1);
    const we: usize = tty_title_words_end(tmp.ptr as &const byte, tmp.len, max_words);
    return tty_title_clean_into(dst, tmp.ptr as &const byte, we, max_bytes);
}

export fn tty_title_active() bool {
    return g_title_on && g_title_fd >= 0;
}

export fn tty_title_on() bool {
    return g_title_on;
}

// 打开标题通道：先压标题栈，再记 fd。重复调用是空操作（只压一次栈）。
export fn tty_title_begin(fd: i32) void {
    if fd < 0 || g_title_on {
        return;
    }
    tty_title_ensure();
    var push: [byte: 5] = [27, 91, 50, 50, 116];   // ESC[22t
    _ = sys_write(fd, &push[0] as *const byte, 5) catch {};
    g_title_fd = fd;
    g_title_on = true;
    buf_reset(&g_title_last);
}

// 关闭标题通道：弹标题栈（终端支持标题栈时这就是「恢复 shell 原来的标题」）
export fn tty_title_end() void {
    if !g_title_on {
        return;
    }
    tty_title_ensure();
    if g_title_fd >= 0 {
        var pop: [byte: 5] = [27, 91, 50, 51, 116];   // ESC[23t
        _ = sys_write(g_title_fd, &pop[0] as *const byte, 5) catch {};
    }
    g_title_on = false;
    g_title_fd = -1;
    buf_reset(&g_title_last);
}

// 上屏：清洗 → 与上次相同的直接跳过 → 一次写完 `ESC ] 2 ; <标题> BEL`。
// 清洗后为空（全控制字节 / 全空白）时**不写**：留着上一个标题，而不是把标签页清空。
export fn tty_title_set(text: &const byte, n: usize) void {
    if !tty_title_active() {
        return;
    }
    tty_title_ensure();
    _ = tty_title_clean_into(&g_title_buf, text, n, TTY_TITLE_MAX_BYTES);
    if g_title_buf.len == 0 {
        return;
    }
    if g_title_last.len == g_title_buf.len
        && bufx_mem_eq(g_title_last.ptr as &const byte, g_title_buf.ptr as &const byte, g_title_buf.len) {
        return;
    }
    var seq: [byte: TTY_TITLE_SEQ_MAX] = [0: TTY_TITLE_SEQ_MAX];
    seq[0] = 27; seq[1] = 93; seq[2] = 50; seq[3] = 59;   // ESC ] 2 ;
    var k: usize = 4;
    var i: usize = 0;
    while i < g_title_buf.len {
        seq[k] = g_title_buf.ptr[i];
        k = k + 1;
        i = i + 1;
    }
    seq[k] = 7;   // BEL
    k = k + 1;
    _ = sys_write(g_title_fd, &seq[0] as *const byte, k) catch {};
    buf_reset(&g_title_last);
    _ = buf_append(&g_title_last, g_title_buf.ptr as &const byte, g_title_buf.len);
}

// 观测（自测用）：最近一次真正写出去的标题
export fn tty_title_last_len() usize {
    tty_title_ensure();
    return g_title_last.len;
}

export fn tty_title_last_at(i: usize) byte {
    tty_title_ensure();
    if i >= g_title_last.len {
        return 0;
    }
    return g_title_last.ptr[i];
}
