// src/term/view.uya — 显示层（P14 起：把终端转录做成 DSH 那套内容模型；P16：压成单行）
//
// 本文件：工具调用 → 单行状态行、工具正文块（`--tool-lines N`）、子代理面板快照、
//   思考行的滚动与落行，以及这些文本经 tty 面板块协议写到 stderr 的收尾。
// 不变量：① 显示一律走 `err_fd()`（流式期间 fd 2 被 tls_noise_mute 指向 /dev/null，
//   写死 2 会被吞掉）；② 思考行重画节流 80 ms，且只有内容真变了才重画；③ 面板块文本
//   超 `TTY_BLOCK_TEXT_MAX` 会被 tty 层拒绝，草稿必须用**专用**的 `g_view_pnl`，
//   不许借 `g_view_tmp`（借了就会和摘要/正文互相踩）。
// 依赖：term/tty（面板块协议与显示列）、foundation/bufx、foundation/jsonx（工具参数解析）。
// 命名：`view_` / `VIEW_` 前缀；思考行那套是 `g_think_*` / `view_think_*`。
//
// 每次工具调用输出**一行**（P16 默认不再输出正文块）：
//
//     ✓ Bash · run tests · exit 1
//     ✓ Read · src/agent.uya · lines 100-149
//
//   * 行 = 状态字形 + 标题 + ` · ` + 摘要(关键参数) + 后缀
//     （DSH 工具视图的 title / summary / status 三层）；bash 的摘要优先取 `description`
//     （与 DSH 的 SUMMARY_KEYS.bash 同口径），缺了才退回命令行；
//   * 正文（write/edit 的 diff、todo 清单、结果首尾若干行）仍然在，但只在
//     `--tool-lines N`（N>0）时输出 —— 0 是默认值，含义就是「只留一行」；
//   * 思考也压成一行（DSH 的 Think 行）：运行中在提示符那一行里滚动，块结束时落一行
//     `✻ 思考 · <首行>…`（见文件末尾「思考行」小节）；
//   * 通道语义不变：显示一律走 stderr（`err_fd()`，流式期间也不会被静音吞掉），
//     正文/模型输出仍走 fd 1；
//   * `--quiet` 时整层关闭（view_init(false, …)），输出与旧版逐字节一致。
//
// 交互模式：工具运行期间把**提示符**换成运行中的那一行（本项目的提示符就是状态显示），
// 工具返回后再把成品行写进滚动区；思考行复用同一套机制滚动。这样不需要原地改写已输出的
// 一行，也不会和正在编辑的输入行打架。

const VIEW_LINE_FALLBACK: usize = 80;
const VIEW_AG_MAX: usize = 4;          // 只显示最后 4 个子代理窗口
const VIEW_AG_INNER_MIN: usize = 30;   // 窄终端下内容区的最小列数
// P40：状态行里消息预览的**字节**上限（超了就从头部丢、留最新的一段）。
// 它只管「别为一条几十 KB 的消息攒出个大缓冲」，不参与显示口径 —— 这个数是任何面板宽度
// 都吃得下的上界（最宽的面板 = 200 列终端：内容行 194 列；纯 ASCII 1 字节/列、
// CJK 3 字节/2 列 → 291 字节），所以屏幕上看得到多少，永远由 view_ag_msg 按**显示列**决定。
const VIEW_AG_MSG_MAX: usize = 320;

// ---- 状态 ----
var g_view_on: bool = false;
var g_view_lines: usize = 6;
var g_view_row: Buf = Buf{ ptr: null, len: 0, cap: 0 };     // 组「行」文本
var g_view_body: Buf = Buf{ ptr: null, len: 0, cap: 0 };    // diff 成品
var g_view_tmp: Buf = Buf{ ptr: null, len: 0, cap: 0 };     // 摘要/正文草稿
var g_view_block: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // 组好的整块（行+正文）
var g_view_prompt: Buf = Buf{ ptr: null, len: 0, cap: 0 };  // 被顶掉的提示符
var g_view_swapped: bool = false;
var g_view_ag: Buf = Buf{ ptr: null, len: 0, cap: 0 };      // 子代理面板快照（与屏幕上的比）
var g_view_pnl: Buf = Buf{ ptr: null, len: 0, cap: 0 };     // 面板文本草稿（**专用**：不能借 g_view_tmp）
var g_view_ag_have: bool = false;
var g_think_active: bool = false;                           // 正在显示思考行（见文件末尾）
var g_think_ms: u64 = 0;                                    // 上次重画时刻（0 = 还没画过）
var g_think_drawn: Buf = Buf{ ptr: null, len: 0, cap: 0 };  // 上次画出去的提示符文本

// 幂等：REPL 每轮都会调（不能每次 buf_new，否则漏内存）
export fn view_init(enabled: bool, tool_lines: usize) void {
    if !buf_valid(&g_view_row) {
        g_view_row = buf_new(4096);
    }
    if !buf_valid(&g_view_body) {
        g_view_body = buf_new(16384);
    }
    if !buf_valid(&g_view_tmp) {
        g_view_tmp = buf_new(16384);
    }
    if !buf_valid(&g_view_block) {
        g_view_block = buf_new(32768);
    }
    if !buf_valid(&g_view_prompt) {
        g_view_prompt = buf_new(1024);
    }
    if !buf_valid(&g_view_ag) {
        g_view_ag = buf_new(8192);
    }
    if !buf_valid(&g_view_pnl) {
        g_view_pnl = buf_new(16384);
    }
    if !buf_valid(&g_think_drawn) {
        g_think_drawn = buf_new(1024);
    }
    buf_reset(&g_view_row);
    buf_reset(&g_view_body);
    buf_reset(&g_view_tmp);
    buf_reset(&g_view_block);
    buf_reset(&g_view_prompt);
    buf_reset(&g_view_ag);
    buf_reset(&g_view_pnl);
    g_view_ag_have = false;
    buf_reset(&g_think_drawn);
    g_think_active = false;
    g_think_ms = 0;
    g_view_lines = tool_lines;
    g_view_on = enabled && buf_valid(&g_view_row) && buf_valid(&g_view_body) && buf_valid(&g_view_tmp) && buf_valid(&g_view_block) && buf_valid(&g_view_ag) && buf_valid(&g_view_pnl);
    g_view_swapped = false;
}

// 当前是否开着单行显示层（--quiet 时恒 false，输出退回旧版逐字节口径）。
export fn view_enabled() bool {
    return g_view_on;
}

// ============================================================
// 输出小工具（都走 tty 协议）
//
// fd 用 err_fd() 而不是字面量 2：LLM 流式期间 fd 2 被 tls_noise_mute 指向 /dev/null，
// 显示层（工具行 / 思考行）必须写到那个还看得见的 stderr
// （P16 修的坑：P14 的「✻ 思考」表头就是这么被静音掉的，--show-reasoning 等于没开）。
// ============================================================
// 写一段以 NUL 结尾的文本到显示用 stderr（长度现场量）。
fn view_out(p: &const byte) void {
    tty_stream_write(err_fd(), p, bufx_cstr_len(p));
}

// 写 n 个字节到显示用 stderr（n == 0 时一个字节都不写，省一次 syscall）。
fn view_out_n(p: &const byte, n: usize) void {
    if n > 0 {
        tty_stream_write(err_fd(), p, n);
    }
}

// 裸指针 + 字节偏移 → 指针。用于在不带 len 的常量上做 memcmp。
fn view_at(p: &const byte, off: usize) &const byte {
    return @ptr_from_usize(@usize_from_ptr(p as &const void) + off) as &const byte;
}

// 显示可用列宽；读不到（tty_body_width() == 0，例如被重定向）时退回 VIEW_LINE_FALLBACK。
fn view_width() usize {
    const w: usize = tty_body_width();
    if w == 0 {
        return VIEW_LINE_FALLBACK;
    }
    return w;
}

// ============================================================
// 小工具：行扫描 / 名称比较 / 参数取值
// ============================================================
fn view_next_line(p: &const byte, limit: usize, from: usize, off: &usize, len: &usize) bool {
    if from >= limit {
        return false;
    }
    var i: usize = from;
    while i < limit && p[i] != 10 as byte {
        i = i + 1;
    }
    off[0] = from;
    len[0] = i - from;
    return true;
}

// 数 p[0:n) 里有几行（每行以 '\n' 分隔、末行无 '\n' 也算一行）。O(n) 单遍扫描。
fn view_count_lines(p: &const byte, n: usize) usize {
    var k: usize = 0;
    var c: usize = 0;
    while true {
        var o: usize = 0;
        var l: usize = 0;
        if !view_next_line(p, n, c, &o, &l) {
            break;
        }
        k = k + 1;
        c = o + l + 1;
    }
    return k;
}

// 工具名精确等于字面量 lit（大小写敏感、按 NUL 结尾比较）。
fn view_name_is(name: &const Buf, lit: &const byte) bool {
    if !buf_valid(name) {
        return false;
    }
    return bufx_eq_cstr(name.ptr as &const byte, name.len, lit);
}

// 在 hay 里找 lit 的首次出现，返回字节下标；找不到（或 hay 无效 / lit 比 hay 长）返回 -1。
fn view_find(hay: &const Buf, lit: &const byte) isize {
    if !buf_valid(hay) {
        return -1;
    }
    const ln: usize = bufx_cstr_len(lit);
    if ln == 0 || hay.len < ln {
        return -1;
    }
    var i: usize = 0;
    while i + ln <= hay.len {
        if bufx_mem_eq(view_at(hay.ptr as &const byte, i), lit, ln) {
            return i as isize;
        }
        i = i + 1;
    }
    return -1;
}

// 解析工具调用的 arguments JSON 到 arena 上的 val；空 / 无效输入直接 false（调用方据此走降级路）。
fn view_args(arena: &Arena, args_json: &const Buf, val: &JsonValue) bool {
    if !buf_valid(args_json) || args_json.len == 0 {
        return false;
    }
    return js_parse(arena, args_json.ptr, args_json.len, val);
}

// 取字符串参数（反转义）到 out（out 会被 reset）；没有该键返回 false
fn view_arg_str(args: &const JsonValue, key: &const byte, key_len: usize, out: &Buf) bool {
    buf_reset(out);
    var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if !js_obj_get_str(args, key, key_len, &sv) {
        return false;
    }
    if !sv_unescape(&sv, out) {
        buf_reset(out);
        return false;
    }
    return out.len > 0;
}

// 取整数参数到 out（如行号 / 超时）；键不存在或不是整数返回 false，out 不动。
fn view_arg_i64(args: &const JsonValue, key: &const byte, key_len: usize, out: &i64) bool {
    var jv: JsonValue = JsonValue.json_null();
    if !js_obj_get(args, key, key_len, &jv) {
        return false;
    }
    return js_i64_of(&jv, out);
}

// ============================================================
// 工具 → 标题（对齐 DSH 工具视图的名字）
// ============================================================
fn view_title(out: &Buf, name: &const Buf) void {
    buf_reset(out);
    if view_name_is(name, "read") { _ = buf_append_cstr(out, "Read"); return; }
    if view_name_is(name, "write") { _ = buf_append_cstr(out, "Write"); return; }
    if view_name_is(name, "edit") { _ = buf_append_cstr(out, "Edit"); return; }
    if view_name_is(name, "glob") { _ = buf_append_cstr(out, "Glob"); return; }
    if view_name_is(name, "grep") { _ = buf_append_cstr(out, "Grep"); return; }
    if view_name_is(name, "bash") { _ = buf_append_cstr(out, "Bash"); return; }
    if view_name_is(name, "job_list") { _ = buf_append_cstr(out, "Jobs"); return; }
    if view_name_is(name, "job_output") { _ = buf_append_cstr(out, "JobOutput"); return; }
    if view_name_is(name, "job_kill") { _ = buf_append_cstr(out, "JobKill"); return; }
    if view_name_is(name, "todo_write") { _ = buf_append_cstr(out, "Todo"); return; }
    if view_name_is(name, "workspace") { _ = buf_append_cstr(out, "Workspace"); return; }
    if view_name_is(name, "exit_plan_mode") { _ = buf_append_cstr(out, "ExitPlan"); return; }
    if view_name_is(name, "ask_user_question") { _ = buf_append_cstr(out, "Ask"); return; }
    if view_name_is(name, "skill") { _ = buf_append_cstr(out, "Skill"); return; }
    if view_name_is(name, "uya_notes") { _ = buf_append_cstr(out, "UyaNotes"); return; }
    if view_name_is(name, "web_search") { _ = buf_append_cstr(out, "WebSearch"); return; }
    if view_name_is(name, "subagent") { _ = buf_append_cstr(out, "Subagent"); return; }
    if view_name_is(name, "subagent_fork") { _ = buf_append_cstr(out, "SubagentFork"); return; }
    if view_name_is(name, "list_agents") { _ = buf_append_cstr(out, "Agents"); return; }
    if view_name_is(name, "subagent_output") { _ = buf_append_cstr(out, "SubagentOutput"); return; }
    if view_name_is(name, "send_message") { _ = buf_append_cstr(out, "SendMessage"); return; }
    if view_name_is(name, "interrupt_agent") { _ = buf_append_cstr(out, "Interrupt"); return; }
    if view_name_is(name, "ralph") { _ = buf_append_cstr(out, "Ralph"); return; }
    if view_name_is(name, "create_goal") { _ = buf_append_cstr(out, "GoalCreate"); return; }
    if view_name_is(name, "get_goal") { _ = buf_append_cstr(out, "Goal"); return; }
    if view_name_is(name, "update_goal") { _ = buf_append_cstr(out, "GoalUpdate"); return; }
    if view_name_is(name, "workflow") { _ = buf_append_cstr(out, "Workflow"); return; }
    _ = buf_append_cstr(out, "Tool");
}

// 会不会自己提问（这两个工具的提问提示符不能被运行中提示符顶掉）
fn view_tool_prompts(name: &const Buf) bool {
    return view_name_is(name, "ask_user_question") || view_name_is(name, "exit_plan_mode");
}

// 会改文件的工具（正文用 diff）
fn view_tool_mutates(name: &const Buf) bool {
    return view_name_is(name, "write") || view_name_is(name, "edit");
}

// ============================================================
// 摘要（关键参数）
// ============================================================
fn view_summary(out: &Buf, name: &const Buf, args: &const JsonValue, parsed: bool) void {
    buf_reset(out);
    if !parsed {
        return;
    }
    if view_name_is(name, "read") || view_name_is(name, "write") || view_name_is(name, "edit") {
        _ = view_arg_str(args, "file_path", 9, out);
        return;
    }
    if view_name_is(name, "glob") || view_name_is(name, "grep") {
        if !view_arg_str(args, "pattern", 7, out) {
            return;
        }
        if view_name_is(name, "glob") {
            var p: Buf = buf_empty();
            defer { buf_free(&p); }
            if view_arg_str(args, "path", 4, &p) {
                _ = buf_append_cstr(out, " in ");
                _ = buf_append(out, p.ptr, p.len);
            }
        } else {
            var inc: Buf = buf_empty();
            defer { buf_free(&inc); }
            if view_arg_str(args, "include", 7, &inc) {
                _ = buf_append_cstr(out, " include:");
                _ = buf_append(out, inc.ptr, inc.len);
            }
        }
        return;
    }
    if view_name_is(name, "bash") {
        // P16：与 DSH 的 SUMMARY_KEYS.bash 同口径 —— 有 description 就用它（一行的人话），
        // 缺了才退回命令行本身（长命令按列截断，见 view_render_block）。
        if !view_arg_str(args, "description", 11, out) {
            _ = view_arg_str(args, "command", 7, out);
        }
        return;
    }
    if view_name_is(name, "job_output") || view_name_is(name, "job_kill") {
        _ = view_arg_str(args, "job_id", 6, out);
        return;
    }
    if view_name_is(name, "subagent_output") || view_name_is(name, "send_message") || view_name_is(name, "interrupt_agent") {
        _ = view_arg_str(args, "subagent_id", 11, out);
        return;
    }
    if view_name_is(name, "subagent") || view_name_is(name, "subagent_fork") {
        _ = view_arg_str(args, "description", 11, out);
        return;
    }
    if view_name_is(name, "skill") {
        _ = view_arg_str(args, "name", 4, out);
        return;
    }
    // P34：workspace 工具的关键参数就是目标目录（无参 = 只报告，什么也不带）
    if view_name_is(name, "workspace") {
        _ = view_arg_str(args, "path", 4, out);
        return;
    }
    if view_name_is(name, "ask_user_question") {
        var qs: JsonValue = JsonValue.json_null();
        if !js_obj_get(args, "questions", 9, &qs) {
            return;
        }
        var first: JsonValue = JsonValue.json_null();
        if !js_arr_get(&qs, 0, &first) {
            return;
        }
        if !view_arg_str(&first, "question", 8, out) {
            _ = view_arg_str(&first, "header", 6, out);
        }
        return;
    }
    if view_name_is(name, "web_search") {
        var qs: JsonValue = JsonValue.json_null();
        if !js_obj_get(args, "queries", 7, &qs) {
            return;
        }
        const n: usize = js_arr_len(&qs);
        var i: usize = 0;
        while i < n {
            var item: JsonValue = JsonValue.json_null();
            if !js_arr_get(&qs, i, &item) {
                break;
            }
            var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
            if js_str_of(&item, &sv) && sv.len > 0 {
                if i > 0 {
                    _ = buf_append_cstr(out, ", ");
                }
                _ = sv_unescape(&sv, out);
            }
            i = i + 1;
        }
        return;
    }
    if view_name_is(name, "workflow") {
        var meta: JsonValue = JsonValue.json_null();
        if js_obj_get(args, "meta", 4, &meta) {
            _ = view_arg_str(&meta, "name", 4, out);
        }
        return;
    }
}

// ============================================================
// 状态与后缀
// ============================================================
export fn view_tool_ok(name: &const Buf, result: &const Buf) bool {
    if !buf_valid(result) {
        return true;
    }
    if result.len >= 7 && bufx_mem_eq(result.ptr as &const byte, "Error: ", 7) {
        return false;
    }
    // 派发层的「参数不是合法 JSON」是小写前缀（工具模块统一用 "Error: "）；
    // bash 不按前缀判（它的 stdout 可能就以 error: 开头，状态由退出码标记决定）
    if !view_name_is(name, "bash") && result.len >= 7 && bufx_mem_eq(result.ptr as &const byte, "error: ", 7) {
        return false;
    }
    if view_name_is(name, "bash") {
        if view_find(result, "[timed out") >= 0 {
            return false;
        }
        if view_find(result, "[killed by signal: ") >= 0 {
            return false;
        }
        // P38：被 job control 停住过 = 没跑成（工具已把子树收掉），卡片按失败上色
        if view_find(result, "[stopped by signal: ") >= 0 {
            return false;
        }
        const at: isize = view_find(result, "[exit code: ");
        if at >= 0 {
            const start: usize = (at as usize) + 12;
            var e: usize = start;
            while e < result.len && result.ptr[e] != 93 as byte {
                e = e + 1;
            }
            const v: i64 = parse_u64_at(result.ptr[0: result.len], start, e - start);
            if v != 0 {
                return false;
            }
        }
    }
    return true;
}

// bash 的尾部标记 → 后缀（返回 true 表示已给出）
fn view_bash_suffix(out: &Buf, result: &const Buf) bool {
    if !buf_valid(result) || result.len == 0 {
        return false;
    }
    var at: isize = view_find(result, "started background job ");
    if at >= 0 {
        const start: usize = (at as usize) + 23;
        var e: usize = start;
        while e < result.len && result.ptr[e] != 10 as byte {
            e = e + 1;
        }
        _ = buf_append_cstr(out, " · background ");
        if e > start {
            _ = buf_append(out, view_at(result.ptr as &const byte, start), e - start);
        }
        return true;
    }
    if view_find(result, "[timed out") >= 0 {
        _ = buf_append_cstr(out, " · timed out");
        return true;
    }
    at = view_find(result, "[stopped by signal: ");
    if at >= 0 {
        // P38：命令树被 job control 停住（工具已经把它收掉了）——卡片上要和「被杀」区分开
        const start: usize = (at as usize) + 20;
        var e: usize = start;
        while e < result.len && result.ptr[e] != 93 as byte {
            e = e + 1;
        }
        const sv: i64 = parse_u64_at(result.ptr[0: result.len], start, e - start);
        _ = buf_append_cstr(out, " · stopped by signal");
        if sv > 0 {
            _ = buf_append_cstr(out, " ");
            _ = buf_append_u64(out, sv as u64);
        }
        return true;
    }
    at = view_find(result, "[killed by signal: ");
    if at >= 0 {
        const start: usize = (at as usize) + 19;
        var e: usize = start;
        while e < result.len && result.ptr[e] != 93 as byte {
            e = e + 1;
        }
        const sv: i64 = parse_u64_at(result.ptr[0: result.len], start, e - start);
        _ = buf_append_cstr(out, " · killed by signal");
        if sv > 0 {
            _ = buf_append_cstr(out, " ");
            _ = buf_append_u64(out, sv as u64);
        }
        return true;
    }
    at = view_find(result, "[exit code: ");
    if at >= 0 {
        const start: usize = (at as usize) + 12;
        var e: usize = start;
        while e < result.len && result.ptr[e] != 93 as byte {
            e = e + 1;
        }
        const v: i64 = parse_u64_at(result.ptr[0: result.len], start, e - start);
        if v >= 0 {
            _ = buf_append_cstr(out, " · exit ");
            _ = buf_append_u64(out, v as u64);
            return true;
        }
    }
    return false;
}

// 追加单行末尾的「后缀」：bash 优先用退出状态（其次兜底行数）、write 用 +add/-del、
// edit 用 replaced、read 用 lines 区间、todo_write 用 items(done)，其余按结果行数兜底。
// added / removed 是 write 的行数变化；parsed = args 是否解析成功（失败就跳过参数类后缀）。
fn view_suffix(out: &Buf, name: &const Buf, args: &const JsonValue, parsed: bool, result: &const Buf, added: usize, removed: usize) void {
    if view_name_is(name, "bash") {
        if view_bash_suffix(out, result) {
            return;
        }
    } else if view_name_is(name, "write") {
        if added > 0 || removed > 0 {
            _ = buf_append_cstr(out, " · +");
            _ = buf_append_u64(out, added as u64);
            _ = buf_append_cstr(out, " -");
            _ = buf_append_u64(out, removed as u64);
            return;
        }
    } else if view_name_is(name, "edit") {
        if added > 0 || removed > 0 {
            _ = buf_append_cstr(out, " · replaced");
            return;
        }
    } else if view_name_is(name, "read") {
        var off: i64 = 0;
        var lim: i64 = 0;
        const has_off: bool = view_arg_i64(args, "offset", 6, &off);
        const has_lim: bool = view_arg_i64(args, "limit", 5, &lim);
        if parsed && (has_off || has_lim) {
            if !has_off {
                off = 1;
            }
            if !has_lim {
                lim = 2000;
            }
            _ = buf_append_cstr(out, " · lines ");
            _ = buf_append_u64(out, off as u64);
            _ = buf_append_cstr(out, "-");
            _ = buf_append_u64(out, (off + lim - 1) as u64);
            return;
        }
    } else if view_name_is(name, "todo_write") {
        var items: usize = 0;
        var done: usize = 0;
        if parsed && view_todo_counts(args, &items, &done) {
            _ = buf_append_cstr(out, " · ");
            _ = buf_append_u64(out, items as u64);
            _ = buf_append_cstr(out, " items (");
            _ = buf_append_u64(out, done as u64);
            _ = buf_append_cstr(out, " done)");
            return;
        }
    }
    // 兜底：结果文本行数
    if buf_valid(result) && result.len > 0 {
        const total: usize = view_count_lines(result.ptr as &const byte, result.len);
        if total > 0 {
            _ = buf_append_cstr(out, " · ");
            _ = buf_append_u64(out, total as u64);
            _ = buf_append_cstr(out, " lines");
        }
    }
}

// ============================================================
// 正文
// ============================================================
// 一行正文：4 空格缩进 + 内容（按列截断）
fn view_body_line(out: &Buf, p: &const byte, off: usize, len: usize, w: usize) void {
    _ = buf_append_cstr(out, "    ");
    var cw: usize = w;
    if cw > 4 {
        cw = cw - 4;
    } else {
        cw = 8;
    }
    const ptr: &const byte = view_at(p, off);
    const keep: usize = tty_clip_bytes(ptr, len, cw);
    if keep > 0 {
        _ = buf_append(out, ptr, keep);
    }
    if keep < len {
        _ = buf_append_cstr(out, "…");
    }
    _ = buf_append_byte(out, 10);
}

// 结果首尾各 lines 行（中间省略），lines=0 时什么都不输出
export fn view_head_tail(out: &Buf, p: &const byte, n: usize, lines: usize, w: usize) void {
    buf_reset(out);
    if lines == 0 || n == 0 {
        return;
    }
    const total: usize = view_count_lines(p, n);
    if total == 0 {
        return;
    }
    if total <= lines * 2 + 1 {
        var c0: usize = 0;
        while true {
            var o: usize = 0;
            var l: usize = 0;
            if !view_next_line(p, n, c0, &o, &l) {
                break;
            }
            view_body_line(out, p, o, l, w);
            c0 = o + l + 1;
        }
        return;
    }
    var c: usize = 0;
    var k: usize = 0;
    while k < lines {
        var o: usize = 0;
        var l: usize = 0;
        if !view_next_line(p, n, c, &o, &l) {
            break;
        }
        view_body_line(out, p, o, l, w);
        c = o + l + 1;
        k = k + 1;
    }
    _ = buf_append_cstr(out, "    … (省略 ");
    _ = buf_append_u64(out, (total - lines * 2) as u64);
    _ = buf_append_cstr(out, " 行)\n");
    var skip: usize = 0;
    c = 0;
    while skip < total - lines {
        var o: usize = 0;
        var l: usize = 0;
        if !view_next_line(p, n, c, &o, &l) {
            break;
        }
        c = o + l + 1;
        skip = skip + 1;
    }
    while true {
        var o: usize = 0;
        var l: usize = 0;
        if !view_next_line(p, n, c, &o, &l) {
            break;
        }
        view_body_line(out, p, o, l, w);
        c = o + l + 1;
    }
}

// todo_write 的清单：✓ 已完成 / ▸ 进行中 / · 待办
fn view_todo_counts(args: &const JsonValue, items: &usize, done: &usize) bool {
    var todos: JsonValue = JsonValue.json_null();
    if !js_obj_get(args, "todos", 5, &todos) {
        return false;
    }
    const n: usize = js_arr_len(&todos);
    var i: usize = 0;
    var d: usize = 0;
    while i < n {
        var item: JsonValue = JsonValue.json_null();
        if !js_arr_get(&todos, i, &item) {
            break;
        }
        var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
        if js_obj_get_str(&item, "status", 6, &sv) && sv.len == 9 && bufx_mem_eq(sv.ptr as &const byte, "completed", 9) {
            d = d + 1;
        }
        i = i + 1;
    }
    items[0] = n;
    done[0] = d;
    return true;
}

// todo_write 的正文块：前 g_view_lines 条 todo 各一行（字形 + 内容，按显示列裁剪补 '…'），
// 超出部分折成「… (省略 N 条)」。parsed = args 是否解析成功。
fn view_todo_body(out: &Buf, args: &const JsonValue, parsed: bool, w: usize) void {
    buf_reset(out);
    if !parsed {
        return;
    }
    var todos: JsonValue = JsonValue.json_null();
    if !js_obj_get(args, "todos", 5, &todos) {
        return;
    }
    const n: usize = js_arr_len(&todos);
    var i: usize = 0;
    var shown: usize = 0;
    while i < n {
        var item: JsonValue = JsonValue.json_null();
        if !js_arr_get(&todos, i, &item) {
            break;
        }
        var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
        var st: u8 = 0;   // 0=待办 1=进行中 2=已完成
        if js_obj_get_str(&item, "status", 6, &sv) {
            if sv.len == 9 && bufx_mem_eq(sv.ptr as &const byte, "completed", 9) {
                st = 2;
            } else if sv.len == 11 && bufx_mem_eq(sv.ptr as &const byte, "in_progress", 11) {
                st = 1;
            }
        }
        buf_reset(&g_view_tmp);
        if !view_arg_str(&item, "content", 7, &g_view_tmp) {
            i = i + 1;
            continue;
        }
        if shown < g_view_lines {
            _ = buf_append_cstr(out, "    ");
            if st == 2 {
                _ = buf_append_cstr(out, "✓");
            } else if st == 1 {
                _ = buf_append_cstr(out, "▸");
            } else {
                _ = buf_append_cstr(out, "·");
            }
            _ = buf_append_byte(out, 32);
            var cw: usize = w;
            if cw > 6 {
                cw = cw - 6;
            } else {
                cw = 8;
            }
            const keep: usize = tty_clip_bytes(g_view_tmp.ptr as &const byte, g_view_tmp.len, cw);
            if keep > 0 {
                _ = buf_append(out, g_view_tmp.ptr, keep);
            }
            if keep < g_view_tmp.len {
                _ = buf_append_cstr(out, "…");
            }
            _ = buf_append_byte(out, 10);
        }
        shown = shown + 1;
        i = i + 1;
    }
    if shown > g_view_lines {
        _ = buf_append_cstr(out, "    … (省略 ");
        _ = buf_append_u64(out, (shown - g_view_lines) as u64);
        _ = buf_append_cstr(out, " 条)\n");
    }
}

// ============================================================
// 提示符：运行中的那一行（只有交互模式才有意义）
// ============================================================
fn view_set_prompt_from(b: &Buf) void {
    if !buf_append_byte(b, 0) {
        return;
    }
    tty_set_prompt(&tty_ui, b.ptr as &const byte);
    buf_truncate(b, b.len - 1);
}

// 拼「字形 + 空格 + 标题[ · 摘要]」这一行（P16 的 status/title/summary 三层）。
// 摘要为空就只留标题；`·`（U+00B7 两字节）必须整串字面量追加，拆开写会成乱码。
fn view_build_head(out: &Buf, glyph: &const byte, name: &const Buf, args: &const JsonValue, parsed: bool) void {
    buf_reset(out);
    _ = buf_append_cstr(out, glyph);
    _ = buf_append_byte(out, 32);
    buf_reset(&g_view_tmp);
    view_title(&g_view_tmp, name);
    _ = buf_append(out, g_view_tmp.ptr, g_view_tmp.len);
    buf_reset(&g_view_tmp);
    view_summary(&g_view_tmp, name, args, parsed);
    if g_view_tmp.len > 0 {
        // P16：DSH 的行是「标题 · 摘要」（分词器里两者本来就是两个 span），不再用括号。
        // 用字面量整串追加：'·' 是 U+00B7，占两个字节（0xC2 0xB7），拆成单字节写就是乱码。
        _ = buf_append_cstr(out, " · ");
        _ = buf_append(out, g_view_tmp.ptr, g_view_tmp.len);
    }
}

// 工具开始：交互模式下把**提示符**换成运行中那一行（先备份原提示符）；
// TUI 模式下不换提示符，改成给「运行中」状态行（tui_set_run）。--quiet / 非交互直接返回。
export fn view_begin_tool(arena: &Arena, name: &const Buf, args_json: &const Buf) void {
    if !g_view_on || g_view_swapped {
        return;
    }
    // P17：TUI 模式下不换提示符，改成「运行中」状态行（转录里那条 spinner 行）
    if tui_active() {
        var head: Buf = buf_new(512);
        defer { buf_free(&head); }
        var val: JsonValue = JsonValue.json_null();
        const parsed: bool = view_args(arena, args_json, &val);
        view_build_head(&head, "●", name, &val, parsed);
        tui_set_run(TUI_RUN_TOOL, head.ptr as &const byte, head.len);
        return;
    }
    if !tty_is_interactive() {
        return;
    }
    if view_tool_prompts(name) {
        return;
    }
    buf_reset(&g_view_prompt);
    if !buf_append(&g_view_prompt, tty_ui.prompt.ptr, tty_ui.prompt.len) {
        return;
    }
    var val: JsonValue = JsonValue.json_null();
    const parsed: bool = view_args(arena, args_json, &val);
    view_build_head(&g_view_row, "●", name, &val, parsed);
    const w: usize = view_width();
    if g_view_row.len > w {
        buf_truncate(&g_view_row, tty_clip_bytes(g_view_row.ptr as &const byte, g_view_row.len, w));
    }
    _ = buf_append_cstr(&g_view_row, " > ");
    view_set_prompt_from(&g_view_row);
    g_view_swapped = true;
    tty_draw_line(&tty_ui, err_fd());
}

// 「行（+ 可选的正文块）」整块渲染进 out（不写终端；自测逐字节断言的就是这个）。
// 结尾换行、按列截断都在这里做完，view_end_tool 只是把它写到 fd 2。
// P16：tool_lines = 0（默认）时**只出行**，diff / todo 清单 / 首尾行一个字节都不打。
export fn view_render_block(out: &Buf, arena: &Arena, name: &const Buf, args_json: &const Buf, result: &const Buf, tool_lines: usize, width: usize) void {
    buf_reset(out);
    const save_lines: usize = g_view_lines;
    g_view_lines = tool_lines;
    const bodies: bool = tool_lines > 0;
    var w: usize = width;
    if w < 16 {
        w = 16;
    }
    var val: JsonValue = JsonValue.json_null();
    const parsed: bool = view_args(arena, args_json, &val);
    var added: usize = 0;
    var removed: usize = 0;
    var have_diff: bool = false;
    buf_reset(&g_view_body);
    if view_tool_mutates(name) {
        // diff 仍要采（write/edit 的后缀 `· +A -D` / `· replaced` 靠它），只是正文关闭时不 append
        have_diff = diffx_take(&g_view_body, &added, &removed);
    } else {
        diffx_clear();
    }
    const ok: bool = view_tool_ok(name, result);
    if !ok {
        // 失败时不留「假 diff」（采集发生在写盘之前/之中），正文改用错误文本
        have_diff = false;
        buf_reset(&g_view_body);
        added = 0;
        removed = 0;
    }

    // 行
    if ok {
        view_build_head(&g_view_row, "✓", name, &val, parsed);
    } else {
        view_build_head(&g_view_row, "✗", name, &val, parsed);
    }
    view_suffix(&g_view_row, name, &val, parsed, result, added, removed);
    _ = buf_append_byte(out, 10);
    const keep: usize = tty_clip_bytes(g_view_row.ptr as &const byte, g_view_row.len, w);
    _ = buf_append(out, g_view_row.ptr, keep);
    if keep < g_view_row.len {
        _ = buf_append_cstr(out, "…");
    }
    _ = buf_append_byte(out, 10);

    // 正文（默认关闭）
    if bodies {
        if have_diff {
            _ = buf_append(out, g_view_body.ptr, g_view_body.len);
        } else if ok && view_name_is(name, "todo_write") {
            view_todo_body(&g_view_body, &val, parsed, w);
            _ = buf_append(out, g_view_body.ptr, g_view_body.len);
        } else {
            view_head_tail(&g_view_body, result.ptr as &const byte, result.len, tool_lines, w);
            _ = buf_append(out, g_view_body.ptr, g_view_body.len);
        }
    }
    g_view_lines = save_lines;
}

// 工具结束：先恢复提示符；TUI 模式下把整块渲染进条目（tui_add_tool_block），
// 否则整块写到 stderr。--quiet 时只清 diffx 暂存、不输出。
export fn view_end_tool(arena: &Arena, name: &const Buf, args_json: &const Buf, result: &const Buf) void {
    view_prompt_restore();
    if !g_view_on {
        diffx_clear();
        return;
    }
    // 整块文本先渲染进 g_view_block（纯函数），再决定是写终端还是交给 TUI 条目
    view_render_block(&g_view_block, arena, name, args_json, result, g_view_lines, view_width());
    if tui_active() {
        tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
        tui_add_tool_block(g_view_block.ptr as &const byte, g_view_block.len);
        return;
    }
    view_out_n(g_view_block.ptr as &const byte, g_view_block.len);
}

// 把提示符恢复成 begin 之前那一份（begin 没换过就什么都不做）
export fn view_prompt_restore() void {
    if !g_view_swapped {
        return;
    }
    g_view_swapped = false;
    view_set_prompt_from(&g_view_prompt);
    if tty_is_interactive() {
        tty_draw_line(&tty_ui, err_fd());
    }
}

// ============================================================
// P15：子代理窗口面板（带边框，画在输入行上方）
//
//     ┌─ agents ─────────────────────────────────────────────────────────┐
//     │ ● sub-1 [subagent] 审计 deleg 的等待循环与 fork/exec 差异        │
//     │ ● running       3s · 12 · 检查 1030-1120 行的 fork/exec 差异     │
//     ├─ ────────────────────────────────────────────────────────────────┤
//     │ ● sub-2 [ralph] ralph loop                                       │
//     │ ● running      12s · 1 · Round 2 of 4. Objective: 把骨架补齐     │
//     └─ ────────────────────────────────────────────────────────────────┘
//     [step 4] > 我在这儿接着打字…
//
// 规则（「边框不能错位」全靠它们，自测逐行断言列数）：
//   1) 面板宽 M = tty_body_width()（终端宽 - 2）；内容行两个竖线之间恒为 M-2 列；
//   2) 宽度**只按显示列**算（tty_cols_between）—— 中文 1 字 = 3 字节 = 2 列，
//      按字节数补空格右竖线就会歪；
//   3) `─` 的数量由「实测已用列数」推出来，不手写、不查表；
//   4) 状态名 10 列左对齐、秒数 5 列右对齐 —— 位数变化时 `·` 的列号不变；
//   5) 内容超宽收窄到内容区预算（`M - 4` 列 = inner - 2），截断先给 `…` 留 1 列再补满，
//      所以宽字符处最多留 1 列空隙，右竖线仍然对齐；
//   6) **P40：两行各有各的截断方向** —— 标签行（`● sub-N [subagent] <标签>`）贴左、丢尾巴；
//      状态行前半（字形 + 状态 + 秒数 + 已收行数）是**锚**、一个字节都不截，
//      后半的消息预览贴右、丢开头（`…` + 最新的一段）——
//      所以「它现在在按哪句话干活」永远看得见最新那半句，而锚的列号不受消息长短影响。
//
// 只显示**运行中**的窗口（跑完即隐，收尾信息由 view_agents_note 写进滚动区）。
// ============================================================

// 状态字形 / 状态名（结算通知与旧工具视图共用，单一来源）
export fn view_status_glyph(st: u8) &const byte {
    if st == DELEG_DONE {
        return "✓" as &const byte;
    }
    if st == DELEG_FAILED {
        return "✗" as &const byte;
    }
    if st == DELEG_KILLED {
        return "■" as &const byte;
    }
    return "●" as &const byte;
}

// 子代理种类码 → 面板标签（ralph / subagent）。
fn view_ag_kind(kind: u8) &const byte {
    if kind == DELEG_KIND_RALPH {
        return "ralph" as &const byte;
    }
    return "subagent" as &const byte;
}

// 按**列宽**左/右补空格到 n 列。长度**显式传入**（`&const byte` + n），
// 不要在这里用 `bufx_cstr_len`：传进来的多半是 Buf 的 ptr，没有 NUL 终止符 ——
// `buf_new` 之后的尾巴是**未初始化内存**，cstr_len 会一路读过界（面板行于是多出一串垃圾字节，
// 右竖线错位、底框被截断，实测就是这么来的）。
// 另一个坑：列数必须在**写之前**量好，写在后面会把刚补的空格也数进去。
fn view_ag_pad(out: &Buf, p: &const byte, n: usize, ln: usize, right: bool) void {
    var w: usize = 0;
    if ln > 0 {
        w = tty_cols_between(p, 0, ln);
    }
    if right && w < n {
        var i: usize = 0;
        while i < n - w {
            _ = buf_append_byte(out, 32);
            i = i + 1;
        }
    }
    if ln > 0 {
        _ = buf_append(out, p, ln);
    }
    if !right && w < n {
        var i: usize = 0;
        while i < n - w {
            _ = buf_append_byte(out, 32);
            i = i + 1;
        }
    }
}

// 到目前跑了多久：3s / 1m05s / 59m+（超过 1 小时就只报分钟级）
fn view_ag_secs(out: &Buf, started_ms: u64, now_ms: u64) void {
    buf_reset(out);
    if started_ms == 0 || now_ms <= started_ms {
        _ = buf_append_cstr(out, "0s");
        return;
    }
    var secs: u64 = (now_ms - started_ms) / (1000 as u64);
    if secs >= (3600 as u64) {
        const mins: u64 = secs / (60 as u64);
        if mins > 59 {
            _ = buf_append_cstr(out, "59m+");
        } else {
            _ = buf_append_u64(out, mins);
            _ = buf_append_cstr(out, "m");
        }
        return;
    }
    if secs >= (60 as u64) {
        _ = buf_append_u64(out, secs / (60 as u64));
        _ = buf_append_cstr(out, "m");
        const r: u64 = secs % (60 as u64);
        if r < 10 {
            _ = buf_append_cstr(out, "0");
        }
        _ = buf_append_u64(out, r);
        _ = buf_append_cstr(out, "s");
        return;
    }
    _ = buf_append_u64(out, secs);
    _ = buf_append_cstr(out, "s");
}

// prompt 的第一行、空白折叠成单空格（面板里只要一行预览）。
// P40：超长时**从头部丢**、把最新的一段留下，并在最前面补一个 `…` —— 也就是「贴尾」。
// 面板这一行回答的是「它现在在按哪句话干活」：开头早在上一行（`● sub-N [subagent] <标签>`）
// 里交代过了，被截掉的那半截反而是刚发出去的那句（`… Do a second pass and cut it to under 25 KB`）。
// 这里只按字节兜底（见 VIEW_AG_MSG_MAX），真正「屏幕上留多少列」由 view_ag_msg 按显示列定。
fn view_ag_preview(out: &Buf, src: &const byte, n: usize) void {
    buf_reset(out);
    if n == 0 {
        return;
    }
    var i: usize = 0;
    var sp: bool = false;
    var dropped: bool = false;
    while i < n {
        const c: byte = src[i];
        if c == 10 as byte || c == 13 as byte {
            break;                      // 只看第一行
        }
        if c == 32 as byte || c == 9 as byte {
            sp = out.len > 0;
            i = i + 1;
            continue;
        }
        if sp {
            _ = buf_append_byte(out, 32);
            sp = false;
        }
        _ = buf_append_byte(out, c);
        i = i + 1;
        // 一边攒一边把头部丢掉：几十 KB 一行的 prompt 也不会在这里攒出一个大缓冲
        if out.len > VIEW_AG_MSG_MAX {
            var drop: usize = out.len - VIEW_AG_MSG_MAX;
            // **不能**按字节硬砍：落在续字节上就会留下半个汉字。往后挪到字符起点。
            while drop < out.len && tty_is_cont(out.ptr[drop]) {
                drop = drop + 1;
            }
            buf_drop_prefix(out, drop);
            dropped = true;
        }
    }
    if !dropped {
        return;
    }
    // 丢过头可能停在空格上：贴尾预览不该以一个空格开头
    while out.len > 0 && out.ptr[0] == 32 as byte {
        buf_drop_prefix(out, 1);
    }
    // 头部被丢掉：最前面补 `…`（与 view_ag_msg 按列贴尾同一个记法）
    var t: Buf = buf_new(out.len + 8);
    defer { buf_free(&t); }
    _ = buf_append_cstr(&t, "…");
    _ = buf_append(&t, out.ptr, out.len);
    buf_reset(out);
    _ = buf_append(out, t.ptr, t.len);
}

// 边框行：`┌─ 标题 ─…─┐`。`─` 的数量按**实测列数**补齐到 M-1，再写右角。
// 关键：列数必须从**本行行首**量起（out 里可能已经有很多行了；从 0 量会得到几百，
// 于是补 '─' 的循环一次都不进，底框就退化成「└─ ┘」——实测踩过）。
fn view_ag_line_start(out: &const Buf) usize {
    if out.len == 0 {
        return 0;
    }
    const nl: isize = bufx_find_byte(out.ptr[0: out.len], 10 as byte, 0);
    if nl < 0 {
        return 0;
    }
    var from: usize = 0;
    var found: bool = false;
    while true {
        const n2: isize = bufx_find_byte(out.ptr[0: out.len], 10 as byte, from);
        if n2 < 0 {
            break;
        }
        from = (n2 as usize) + 1;
        found = true;
    }
    if !found {
        return 0;
    }
    return from;
}

// 画一条带标题的面板横线（`├─ 标题 ───…─┤`）：`─` 的数量由**实测已用列数**推出，
// 不手写不查表，保证右竖线落在第 m 列（m = 面板总宽）。
fn view_ag_rule(out: &Buf, left: &const byte, right: &const byte, title: &const byte, m: usize) void {
    const ls: usize = view_ag_line_start(out);
    _ = buf_append(out, left, bufx_cstr_len(left));
    _ = buf_append_cstr(out, "─ ");
    const tn: usize = bufx_cstr_len(title);
    if tn > 0 {
        _ = buf_append(out, title, tn);
        _ = buf_append_byte(out, 32);
    }
    const used: usize = tty_cols_between(out.ptr as &const byte, ls, out.len);
    if used < m - 1 {
        var k: usize = used;
        while k < m - 1 {
            _ = buf_append_cstr(out, "─");
            k = k + 1;
        }
    }
    _ = buf_append(out, right, bufx_cstr_len(right));
}

// 内容行：`│ ` + 文本（超宽先收窄）+ 按列补到 inner 列 + `│`
fn view_ag_row(out: &Buf, text: &const byte, n: usize, m: usize, inner: usize) void {
    _ = buf_append_cstr(out, "│ ");
    var t: Buf = buf_empty();
    defer { buf_free(&t); }
    if !view_ag_shrink(&t, text, n, inner - 2) {
        return;                          // 内存不足：宁可不画这一行
    }
    if t.len > 0 {
        _ = buf_append(out, t.ptr, t.len);
    }
    // 竖线之间恒为 inner 列：2（"│ "）+ 内容 + 补空格
    const used: usize = tty_cols_between(t.ptr as &const byte, 0, t.len) + 2;
    if used < inner + 1 {
        var k: usize = used;
        while k < inner + 1 {
            _ = buf_append_byte(out, 32);
            k = k + 1;
        }
    }
    _ = buf_append_cstr(out, "│");
}

// 画一条子代理窗口（两行：命令行 + 状态行）
fn view_ag_draw_window(out: &Buf, t: &const DelegTable, i: usize, m: usize, inner: usize, now_ms: u64) void {
    const si: usize = i;
    if si >= DELEG_MAX {
        return;
    }
    const id: i32 = t.items[si].id;
    const kind: u8 = t.items[si].kind;
    const started: u64 = t.items[si].started_ms;
    var sec: Buf = buf_empty();
    defer { buf_free(&sec); }
    view_ag_secs(&sec, started, now_ms);
    var pv: Buf = buf_empty();
    defer { buf_free(&pv); }
    view_ag_preview(&pv, t.items[si].prompt.ptr as &const byte, t.items[si].prompt.len);
    var head: Buf = buf_empty();
    defer { buf_free(&head); }
    var body: Buf = buf_empty();
    defer { buf_free(&body); }
    _ = buf_append_cstr(&head, view_status_glyph(DELEG_RUNNING));
    _ = buf_append_byte(&head, 32);
    _ = buf_append_cstr(&head, "sub-");
    _ = buf_append_u64(&head, id as u64);
    _ = buf_append_cstr(&head, " [");
    _ = buf_append_cstr(&head, view_ag_kind(kind));
    _ = buf_append_cstr(&head, "] ");
    _ = buf_append(&head, t.items[si].label.ptr, t.items[si].label.len);
    _ = buf_append_cstr(&body, view_status_glyph(DELEG_RUNNING));
    _ = buf_append_byte(&body, 32);
    view_ag_pad(&body, "running" as &const byte, 10, 7, false);
    _ = buf_append_byte(&body, 32);
    view_ag_pad(&body, sec.ptr as &const byte, 5, sec.len, true);
    _ = buf_append_cstr(&body, " · ");
    _ = buf_append_u64(&body, view_count_lines(t.items[si].buf.ptr as &const byte, t.items[si].buf.len) as u64);
    // P40：状态行分两段 —— 前半是**锚**（字形 + 状态 + 秒数 + 已收行数），它一个字都不许被挤掉；
    // 后半是消息预览，整行剩下的列全给它，而且**贴尾**（`…` + 最新的一段）。
    // 老口径是整行一起从右边截断：消息一长，屏幕上留下的全是它的开头（「Your output was still
    // far too verbose: 325 lines / 68 KB…」），最要紧的那半句正好被切掉 —— 而这一行要回答的
    // 恰恰是「它现在在按哪句话干活」。锚 + 贴尾预览，两件事各归各位。
    if pv.len > 0 {
        const used_cols: usize = tty_cols_between(body.ptr as &const byte, 0, body.len);
        const row_cols: usize = inner - 2;          // 内容区的列预算（与 view_ag_row 同一口径）
        // 剩下的列连「 · 」加两列正文都放不下 → 这一行干脆只留锚，别画个悬空的 ` · `
        if row_cols >= used_cols + 5 {
            _ = buf_append_cstr(&body, " · ");
            view_ag_msg(&body, pv.ptr as &const byte, pv.len, row_cols - used_cols - 3);
        }
    }
    view_ag_row(out, head.ptr as &const byte, head.len, m, inner);
    _ = buf_append_byte(out, 10);
    view_ag_row(out, body.ptr as &const byte, body.len, m, inner);
    _ = buf_append_byte(out, 10);
}

// 生成整块面板文本（不含输入行）。返回 false = 现在没有要显示的窗口（调用方清空块）。
// 只收**运行中**的子代理；最多显示最后 VIEW_AG_MAX 个。
export fn view_agents_text(t: &const DelegTable, out: &Buf) bool {
    buf_reset(out);
    var used: usize = 0;
    var running: usize = 0;
    var i: usize = 0;
    while i < DELEG_MAX {
        if t.items[i].used {
            used = used + 1;
            if t.items[i].status == DELEG_RUNNING {
                running = running + 1;
            }
        }
        i = i + 1;
    }
    if running == 0 {
        return false;
    }
    const body_w: usize = view_width();
    var m: usize = body_w;
    if m < VIEW_AG_INNER_MIN + 4 {
        m = VIEW_AG_INNER_MIN + 4;
    }
    // 内容行 = "│ " + 内容(截到 inner-2 列) + 补空格到 inner+1 列 + "│" —— 总列宽恒为 m，
    // 与边框行（也是 m 列）逐列对齐（右边竖线落在第 m 列）。
    const inner: usize = m - 2;
    // 标题**直接拼进 out**（不用中间 buf）：既少一次拷贝，也避免中间缓冲被后续写入踩到
    // （实测出现过标题里混进一个随机字节、右竖线因此错位一列的情况）。
    {
        _ = buf_append_cstr(out, "┌");
        _ = buf_append_cstr(out, "─ ");
        if running > 1 {
            _ = buf_append_cstr(out, "agents");
        } else {
            _ = buf_append_cstr(out, "agent");
        }
        if used > running {
            _ = buf_append_cstr(out, " ");
            _ = buf_append_u64(out, running as u64);
            _ = buf_append_cstr(out, "/");
            _ = buf_append_u64(out, used as u64);
        }
        _ = buf_append_byte(out, 32);
        const used_cols: usize = tty_cols_between(out.ptr as &const byte, 0, out.len);
        if used_cols < m - 1 {
            var k: usize = used_cols;
            while k < m - 1 {
                _ = buf_append_cstr(out, "─");
                k = k + 1;
            }
        }
        _ = buf_append_cstr(out, "┐");
        _ = buf_append_byte(out, 10);
    }

    // 只画最后 VIEW_AG_MAX 个运行中的窗口：先数出要跳过几个
    const now_ms: u64 = ua_now_ms();
    var skip: usize = 0;
    if running > VIEW_AG_MAX {
        skip = running - VIEW_AG_MAX;
    }
    var seen: usize = 0;
    i = 0;
    while i < DELEG_MAX {
        const si: usize = i;
        if si >= DELEG_MAX {
            break;
        }
        if t.items[si].used && t.items[si].status == DELEG_RUNNING {
            if seen >= skip {
                view_ag_draw_window(out, t, si, m, inner, now_ms);
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    view_ag_rule(out, "└" as &const byte, "┘" as &const byte, "" as &const byte, m);
    _ = buf_append_byte(out, 10);
    return true;
}

// 把一份**成品面板块文本**推到 tty 的输入行块：内容变了才推下去并原地重画。
// 返回是否有变化。P22 起这一层不只服务 agents 面板（还有任务块）—— 所以从
// view_agents_sync 里抽出来，成为「谁生成文本谁调用」的唯一推送原语。
export fn view_panel_push(text: &const byte, n: usize) bool {
    if !g_view_on || !buf_valid(&g_view_ag) {
        return false;
    }
    const same: bool = g_view_ag_have && g_view_ag.len == n
        && (n == 0 || bufx_mem_eq(g_view_ag.ptr as &const byte, text, n));
    if same {
        return false;
    }
    buf_reset(&g_view_ag);
    _ = buf_append(&g_view_ag, text, n);
    g_view_ag_have = true;
    if g_view_ag.len == 0 {
        tty_block_clear();
    } else {
        tty_block_begin(g_view_ag.ptr as &const byte, g_view_ag.len);
    }
    tty_block_redraw(&tty_ui, 2);
    return true;
}

// 同步子代理面板到 tty 的输入行块（P15 的老入口；生产路径已改走 tasks_panel_sync，
// 这里保留给自测的「活路径」断言，行为与签名一字未变）。
export fn view_agents_sync(t: &const DelegTable) bool {
    if !g_view_on || !buf_valid(&g_view_pnl) {
        return false;
    }
    _ = view_agents_text(t, &g_view_pnl);
    return view_panel_push(g_view_pnl.ptr as &const byte, g_view_pnl.len);
}

// 某个子代理跑完时的结算通知（窗口已经收掉了，这一行进滚动区）。
// 内容：[agents] sub-3 [subagent] ✓ idle 27s — 审计 tty 的擦除协议
export fn view_agents_note(id: i32, kind: u8, status: u8, secs_ms: u64, label: &const byte, label_len: usize) void {
    var line: Buf = buf_new(1024);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "[agents] sub-");
    _ = buf_append_u64(&line, id as u64);
    _ = buf_append_cstr(&line, " [");
    _ = buf_append_cstr(&line, view_ag_kind(kind));
    _ = buf_append_cstr(&line, "] ");
    _ = buf_append_cstr(&line, view_status_glyph(status));
    _ = buf_append_byte(&line, 32);
    _ = buf_append_cstr(&line, deleg_status_name(status));
    _ = buf_append_byte(&line, 32);
    var sec: Buf = buf_empty();
    defer { buf_free(&sec); }
    view_ag_secs(&sec, 1, secs_ms + 1);     // 只借用格式化：喂「已过毫秒 + 1」得到稳定文本
    _ = buf_append(&line, sec.ptr, sec.len);
    if label_len > 0 {
        _ = buf_append_cstr(&line, " — ");
        _ = buf_append(&line, label, label_len);
    }
    _ = buf_append_byte(&line, 10);
    tty_puts(&tty_ui, 2, line.ptr as &const byte);
}

// 文本超宽收窄（**贴左**：留开头、丢尾巴），返回是否放得下；放不下时以 `…` 收尾。
// 面板里走这条的是**标签行**；状态行里的消息预览走 view_ag_msg（贴尾），别搞混。
fn view_ag_shrink(out: &Buf, text: &const byte, n: usize, max_cols: usize) bool {
    buf_reset(out);
    if n == 0 || max_cols == 0 {
        return true;
    }
    const w: usize = tty_cols_between(text, 0, n);
    if w <= max_cols {
        return buf_append(out, text, n);
    }
    if max_cols < 2 {
        return buf_append(out, text, tty_clip_bytes(text, n, max_cols));
    }
    const keep: usize = tty_clip_bytes(text, n, max_cols - 1);
    if !buf_append(out, text, keep) {
        return false;
    }
    return buf_append_cstr(out, "…");
}

// P40：把消息预览按**显示列贴尾**追加到 out —— 放不下就从**头部**丢，前面补 `…`，
// 屏幕上留最新的一段（与 `view_think_line(running=true)` 的思考行同口径：
// 那边是 `tty_clip_tail_bytes` + 前置 `…`，这里逐字节都一样，只是宽度由调用方算好）。
// 与 view_ag_shrink 的分工：那个管**标签行**（贴左，丢尾巴 —— 标签的开头才是身份），
// 这个管**状态行里的消息**（贴右，丢开头 —— 消息的结尾才是「最新」）。
// max_cols == 1 时连 `…` 都放不下：宁可什么都不写，让调用方的补空格把这一列填满。
fn view_ag_msg(out: &Buf, text: &const byte, n: usize, max_cols: usize) void {
    if n == 0 || max_cols == 0 {
        return;
    }
    if tty_cols_between(text, 0, n) <= max_cols {
        _ = buf_append(out, text, n);
        return;
    }
    if max_cols < 2 {
        return;
    }
    const keep: usize = tty_clip_tail_bytes(text, n, max_cols - 1);   // 给前置 '…' 留一列
    _ = buf_append_cstr(out, "…");
    if keep > 0 {
        _ = buf_append(out, view_at(text, n - keep), keep);
    }
}

// 思考行（P16）：DSH 的 Think 行，压在一行里
//
//   running（交互模式）：`✻ 思考 · …<最后一行> > ` —— 在提示符那一行里滚动，显示最新内容；
//   settled：`✻ 思考 · <第一行>…` 落进滚动区（fd 2），**不带**前导换行（REPL 提交后已在行首，
//            加了就会多一个空行）。
//
// 取行口径对齐 DSH 的 ReasoningRow：running = latestLine（trimEnd 之后的最后一行、视口贴右端），
// settled = firstLine（这里多一条兜底：第一行全空白就顺延到第一非空行，免得落一行空的）。
// 全文不在这里留：调用方（llm.uya）每次把 o.reasoning 整段递进来，view 只取要显示的一段。
// ============================================================
const VIEW_THINK_PREFIX: &const byte = "✻ 思考 · ";
const VIEW_THINK_MS: u64 = 80;                        // 运行中的重画间隔（DSH 也对行更新节流）
const VIEW_THINK_PROMPT_TAIL: &const byte = " > ";    // 运行中提示符后缀（和工具行同一套协议）

// 是否空白字节（空格 / TAB / 换行 / 回车）；取「最后一行」前要先 trimEnd 掉这些。
fn view_is_blank(c: byte) bool {
    // 换行也算空白：DSH 的 latestLine 是 trimEnd() 之后再取最后一行，
    // 所以「abc\n   」应该显示成 abc 而不是空行。
    return c == 32 as byte || c == 9 as byte || c == 10 as byte || c == 13 as byte;
}

// 挑出要显示的那一行（off/len 指向 text 内的一段）；没有可显示的内容返回 false。
fn view_think_pick(p: &const byte, n: usize, running: bool, off: &usize, len: &usize) bool {
    if n == 0 {
        return false;
    }
    if running {
        // latestLine：先去尾部空白，再回到最后一个换行之后
        var end: usize = n;
        while end > 0 && view_is_blank(p[end - 1]) {
            end = end - 1;
        }
        if end == 0 {
            return false;
        }
        var i: usize = end;
        while i > 0 && p[i - 1] != 10 as byte {
            i = i - 1;
        }
        if i >= end {
            return false;
        }
        off[0] = i;
        len[0] = end - i;
        return true;
    }
    // firstLine：第一行（只去尾部空白）；全空白就顺延到下一行
    var c: usize = 0;
    while true {
        var o: usize = 0;
        var l: usize = 0;
        if !view_next_line(p, n, c, &o, &l) {
            return false;
        }
        var b: usize = o + l;
        while b > o && view_is_blank(p[b - 1]) {
            b = b - 1;
        }
        if b > o {
            off[0] = o;
            len[0] = b - o;
            return true;
        }
        c = o + l + 1;
    }
}

// 纯函数：把思考行渲染进 out（**不含**换行；文本全空白 → out 为空）。
// running=true 按显示列从**左**截断（前面补 '…'）：屏幕上留最新的一段；
// running=false 按显示列从**右**截断（后面补 '…'）：落进转录的那一行。
export fn view_think_line(out: &Buf, text: &const byte, n: usize, w: usize, running: bool) void {
    buf_reset(out);
    const pre_n: usize = bufx_cstr_len(VIEW_THINK_PREFIX);
    const pre_cols: usize = tty_cols_between(VIEW_THINK_PREFIX, 0, pre_n);
    if w <= pre_cols + 1 {
        return;                       // 窄到放不下「前缀 + 至少一列正文」：宁可不打
    }
    var budget: usize = w - pre_cols;
    var off: usize = 0;
    var len: usize = 0;
    if !view_think_pick(text, n, running, &off, &len) {
        return;
    }
    if budget > 1 {
        budget = budget - 1;          // 给截断省略号 '…' 留一列
    }
    _ = buf_append(out, VIEW_THINK_PREFIX, pre_n);
    const p: &const byte = view_at(text, off);
    if running {
        const keep: usize = tty_clip_tail_bytes(p, len, budget);
        if keep < len {
            _ = buf_append_cstr(out, "…");
        }
        if keep > 0 {
            _ = buf_append(out, view_at(text, off + len - keep), keep);
        }
        return;
    }
    const keep2: usize = tty_clip_bytes(p, len, budget);
    if keep2 > 0 {
        _ = buf_append(out, p, keep2);
    }
    if keep2 < len {
        _ = buf_append_cstr(out, "…");
    }
}

// P18：TUI 常驻状态区里的「思考实时行」——喂的是同一个「最新一行」。
// 与 `--show-reasoning` **无关**：它只管「转录里的思考条目」和滚动模式的提示符行；
// 实时行只跟「显示层开着没有」（`--quiet`）和「TUI 在不在跑」有关，默认就显示。
// 滚动模式不动：那边没有常驻状态区，实时文本仍然只在 `--show-reasoning` 时出现（P16 口径）。
export fn view_think_live(text: &const byte, n: usize) void {
    if !g_view_on || n == 0 || !tui_active() {
        return;
    }
    var off: usize = 0;
    var len: usize = 0;
    if !view_think_pick(text, n, true, &off, &len) {
        return;   // 最新一行全空白（流中间的空行）：保留上一段，别闪
    }
    tui_think_live(view_at(text, off), len);
}

// 运行中的思考增量：把「最新一行」滚进提示符（节流重画）。非交互只记状态，不写任何字节。
export fn view_think_delta(text: &const byte, n: usize) void {
    if !g_view_on || n == 0 {
        return;
    }
    var off: usize = 0;
    var len: usize = 0;
    if !view_think_pick(text, n, true, &off, &len) {
        return;                       // 全是空白：连「有思考」都不算
    }
    g_think_active = true;
    // P17：TUI 下思考进「思考条目」（只留最新一段），不再去改写提示符那一行
    if tui_active() {
        tty_reason_write(text + off, len);
        return;
    }
    if !tty_is_interactive() {
        return;                       // 管道里没有可改写的一行：只在结算时落一行
    }
    const now: u64 = ua_now_ms();
    if g_think_ms != 0 && now >= g_think_ms && (now - g_think_ms) < VIEW_THINK_MS {
        return;
    }
    g_think_ms = now;
    var w: usize = view_width();
    const tail_cols: usize = tty_cols_between(VIEW_THINK_PROMPT_TAIL, 0, bufx_cstr_len(VIEW_THINK_PROMPT_TAIL));
    if w > tail_cols {
        w = w - tail_cols;            // 提示符后缀 " > " 也占列
    }
    view_think_line(&g_view_row, text, n, w, true);
    if g_view_row.len == 0 {
        return;
    }
    _ = buf_append_cstr(&g_view_row, VIEW_THINK_PROMPT_TAIL);
    if buf_valid(&g_think_drawn) && g_think_drawn.len == g_view_row.len && bufx_mem_eq(g_think_drawn.ptr as &const byte, g_view_row.ptr as &const byte, g_view_row.len) {
        return;                       // 可见的一段没变：省一次擦/画
    }
    buf_reset(&g_think_drawn);
    _ = buf_append(&g_think_drawn, g_view_row.ptr, g_view_row.len);
    view_set_prompt_from(&g_view_row);
    g_view_swapped = true;
    tty_draw_line(&tty_ui, err_fd());
}

// 思考块结束：把被顶掉的提示符还回去，再把 settled 的那一行写进滚动区。
// 幂等 —— 没在显示思考时什么都不做（内容/工具调用/流结束/中断/报错路径都会调它兜底）。
export fn view_think_end(text: &const byte, n: usize) void {
    // P18：常驻状态区的实时行先收掉。**放在最前面**：它跟 g_think_active 无关
    // （TUI 里 `--show-reasoning` 关着时走的是 view_think_live 那条路，不置这个标志），
    // 所以不能等到后面才清 —— 否则思考行会一直挂在状态区里。
    tui_think_clear();
    if !g_think_active {
        return;
    }
    g_think_active = false;
    g_think_ms = 0;
    buf_reset(&g_think_drawn);
    view_prompt_restore();
    if tui_active() {
        return;   // P17：TUI 下思考已经是转录里的条目，不需要再补一行
    }
    if !g_view_on {
        return;
    }
    view_think_line(&g_view_row, text, n, view_width(), false);
    if g_view_row.len == 0 {
        return;
    }
    view_out_n(g_view_row.ptr as &const byte, g_view_row.len);
    view_out("\n");
}
