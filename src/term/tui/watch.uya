// src/term/tui/watch.uya — 全屏 TUI：/watch 跟随浮层（P42）
//
// 本文件：跟随子代理实时过程消息的浮层（贴尾跟随 / 上滚停跟随 / 终态补一行）。
// 不变量：开关浮层必须**回收**（关掉即取消注册），且关掉后不再有轮询回调。
// 依赖：overlay、entry。

use libc.syscall;
use libc.unistd;
use libc.heap;

// ============================================================
// P42：/watch 跟随浮层
//
// 与 reader 型共用正文/折行/滚动/按键（所以 pgup/pgdn、home/end、↑↓ 直接可用），
// 只多两条口径：
//   1) **可反复重推正文**：子代理每出新事件就重推一次，滚动位置必须保住 ——
//      所以重推时按 `tui_ov_body_top` 是「贴尾」还是「停在某处」来恢复；
//   2) **贴尾跟随开关**：默认跟随（新内容自动跟到底）；用户一旦上滚/翻页就停跟随，
//      `f` 或 End 恢复跟随。不这么做的话，用户正在往回看时每 1Hz 都会被拽到底。
// ============================================================
export fn tui_overlay_watch_wanted() bool {
    return g_tui_ov == TUI_OV_LIST && g_tui_ov_kind == TUI_OVK_WATCH;
}

export fn tui_overlay_watch_open(title: &const byte, tn: usize, body: &const byte, bn: usize) void {
    // 不传动作项：跟随浮层没有可提交的结果（enter 不派发，esc 关闭）
    tui_overlay_reader(TUI_OVK_WATCH, title, tn, body, bn, "" as &const byte, 0, 0);
    g_tui_ov_watch = true;
    g_tui_ov_watch_follow = true;
    tui_mark_dirty();
}

// 重推标题：跟随的子代理进终态时把 `· running` 换成 `· 已结束`（标题是打开时钉的）
export fn tui_overlay_watch_set_title(title: &const byte, tn: usize) void {
    if !tui_overlay_watch_wanted() {
        return;
    }
    buf_reset(&g_tui_ov_title);
    tui_clean_line_into(&g_tui_ov_title, title, tn);   // 踩坑 81：与 open 同一份单行清洗
    tui_mark_dirty();
}

// 重推正文（内容追加过）。保留滚动：跟随态钉在末尾，否则维持当前首行。
export fn tui_overlay_watch_update(body: &const byte, bn: usize) void {
    if !tui_overlay_watch_wanted() {
        return;
    }
    const was_follow: bool = g_tui_ov_watch_follow;
    const prev_top: usize = g_tui_ov_body_top;
    buf_reset(&g_tui_ov_body);
    tui_clean_into(&g_tui_ov_body, body, bn);
    if g_tui_ov_body.len > TUI_OV_BODY_MAX {
        // 与 reader 同一个口径：按行截断，别切出半个 UTF-8 字符
        var cut: usize = TUI_OV_BODY_MAX;
        var guard: usize = 0;
        while cut > 0 && g_tui_ov_body.ptr[cut] != 10 as byte && guard < TUI_OV_BODY_MAX {
            cut = cut - 1;
            guard = guard + 1;
        }
        if cut == 0 {
            cut = TUI_OV_BODY_MAX;
        }
        buf_truncate(&g_tui_ov_body, cut);
        _ = buf_append_cstr(&g_tui_ov_body, "…（更早的内容已省略）\n");
    }
    // 强制重折行（正文变了，宽度缓存不再代表内容）
    g_tui_ov_rows_w = 0;
    g_tui_ov_rows_n = 0;
    g_tui_ov_body_top = prev_top;
    if was_follow {
        g_tui_ov_body_top = (1 as usize) << 62;   // 先给个极大值，下一帧画的时候会被夹到 top_max
    }
    tui_mark_dirty();
}

// 折行缓存（宽度是键）：正文按显示列折行，一行一条记录。
//
// P46：reader 型浮层与转录里的助手正文**共用同一份 mdview 排版**（所以计划里的
// 标题/强调/表格与转录里长得一模一样，不会两套实现漂移）。`g_mdv` 与行文本逐字节等长。
// 例外：/watch 跟随浮层的正文是**事件行**（`▸ bash {...}`、`✕ 思考 · …`），那些不是
// markdown、`---` / `|` 还会被误判，所以按纯文本走（md 全填 TEXT）。
fn tui_ov_rows_ensure(w: usize) void {
    tui_ov_ensure();
    var ww: usize = w;
    if ww < 4 {
        ww = 4;
    }
    if g_tui_ov_rows_w == ww && g_tui_ov_rows_n > 0 {
        return;
    }
    if g_tui_ov_watch {
        g_tui_ov_rows_n = tui_wrap_into(&g_tui_ov_rows, g_tui_ov_body.ptr as &const byte, g_tui_ov_body.len, ww);
        buf_reset(&g_tui_ov_md);
        var q: usize = 0;
        while q < g_tui_ov_rows.len {
            _ = buf_append_byte(&g_tui_ov_md, MDV_ST_TEXT);
            q = q + 1;
        }
    } else {
        g_tui_ov_rows_n = mdv_layout_into(&g_tui_ov_rows, &g_tui_ov_md,
            g_tui_ov_body.ptr as &const byte, g_tui_ov_body.len, ww);
    }
    g_tui_ov_rows_w = ww;
    tui_lineidx_build(&g_tui_ov_rows_ix, &g_tui_ov_rows);   // 踩坑 68：折行结果重写 ⇒ 重建行偏移表
}

fn tui_ov_reader_page() usize {
    if g_tui_ov_body_h == 0 {
        return 1;
    }
    return g_tui_ov_body_h;
}

// 滚动的上界：末页也要看得见内容（rows_n <= body_h 时不许滚）
fn tui_ov_reader_top_max() usize {
    if g_tui_ov_rows_n <= g_tui_ov_body_h {
        return 0;
    }
    return g_tui_ov_rows_n - g_tui_ov_body_h;
}

fn tui_ov_reader_up(n: usize) void {
    if n >= g_tui_ov_body_top {
        g_tui_ov_body_top = 0;
    } else {
        g_tui_ov_body_top = g_tui_ov_body_top - n;
    }
    // P42：往回看 = 停跟随（否则下一次重推又把用户拽回底部）
    if g_tui_ov_watch {
        g_tui_ov_watch_follow = false;
    }
    tui_mark_dirty();
}

fn tui_ov_reader_down(n: usize) void {
    const hi: usize = tui_ov_reader_top_max();
    if g_tui_ov_body_top + n > hi {
        g_tui_ov_body_top = hi;
    } else {
        g_tui_ov_body_top = g_tui_ov_body_top + n;
    }
    // 已经翻到底 = 重新跟上（继续滚下去只能靠新内容）
    if g_tui_ov_watch && g_tui_ov_body_top >= hi {
        g_tui_ov_watch_follow = true;
    }
    tui_mark_dirty();
}

// reader 型浮层的按键：↑/↓ 滚正文、pgup/pgdn 翻页、home/end 顶尾、
// tab/shift+tab/←/→ 环选动作、1..9 直选、enter 确认、esc 取消（在 tui_ov_key 里先处理）。
fn tui_ov_key_reader(ev: i32) void {
    if ev == TUI_K_ENTER {
        tui_ov_accept();
        return;
    }
    if ev == TUI_K_UP {
        tui_ov_reader_up(1);
        return;
    }
    if ev == TUI_K_DOWN {
        tui_ov_reader_down(1);
        return;
    }
    if ev == TUI_K_PGUP {
        tui_ov_reader_up(tui_ov_reader_page());
        return;
    }
    if ev == TUI_K_PGDN {
        tui_ov_reader_down(tui_ov_reader_page());
        return;
    }
    if ev == TUI_K_HOME {
        g_tui_ov_body_top = 0;
        if g_tui_ov_watch {
            g_tui_ov_watch_follow = false;   // 回到顶部 = 停跟随
        }
        tui_mark_dirty();
        return;
    }
    if ev == TUI_K_END {
        g_tui_ov_body_top = tui_ov_reader_top_max();
        if g_tui_ov_watch {
            g_tui_ov_watch_follow = true;    // 到底 = 恢复跟随
        }
        tui_mark_dirty();
        return;
    }
    if ev == TUI_K_TAB || ev == TUI_K_STAB || ev == TUI_K_LEFT || ev == TUI_K_RIGHT {
        if g_tui_ov_n > 0 {
            if ev == TUI_K_LEFT || ev == TUI_K_STAB {
                if g_tui_ov_sel == 0 {
                    g_tui_ov_sel = g_tui_ov_n - 1;
                } else {
                    g_tui_ov_sel = g_tui_ov_sel - 1;
                }
            } else {
                g_tui_ov_sel = (g_tui_ov_sel + 1) % g_tui_ov_n;
            }
            tui_mark_dirty();
        }
        return;
    }
    if ev == TUI_K_CHAR {
        var tmp: Buf = buf_new(8);
        defer { buf_free(&tmp); }
        const n: usize = tui_key_take_char(&tmp);
        // P42：跟随浮层里 enter 没有可提交的项（tui_ov_accept 会是空操作），
        // 所以 `q` 关闭、`f` 重新贴尾跟随 —— 与 /diff 浮层同一套字母键手感。
        if g_tui_ov_watch && n == 1 {
            const c: byte = tmp.ptr[0];
            if c == 113 as byte {              // q：关闭
                g_tui_ov_cancel = true;
                tui_overlay_close();
                return;
            }
            if c == 102 as byte {              // f：恢复贴尾跟随
                g_tui_ov_watch_follow = true;
                g_tui_ov_body_top = tui_ov_reader_top_max();
                tui_mark_dirty();
                return;
            }
        }
        if n == 1 && tmp.ptr[0] >= 49 as byte && tmp.ptr[0] <= 57 as byte {
            const k: usize = (tmp.ptr[0] as usize) - 49;
            if k < g_tui_ov_n {
                g_tui_ov_sel = k;
                tui_mark_dirty();
            }
        }
        return;
    }
    // reader 模式不做过滤：其余按键一律忽略
}

// 选中项的一句话说明（画在动作行上方，随选中项变；终端里没有 tooltip）
fn tui_ov_reader_gloss() &const byte {
    // P42：跟随浮层没有「动作」，这一行改成跟随状态 + 按键提示
    if g_tui_ov_watch {
        if g_tui_ov_watch_follow {
            return "跟随中：新事件会自动跟到底 · f 重新贴尾 · esc/q 关闭" as &const byte;
        }
        return "已暂停跟随（你在往回看）· f 或 End 恢复贴尾 · esc/q 关闭" as &const byte;
    }
    if g_tui_ov_sel == 1 {
        return "关掉浮窗、留在 plan 模式，你现在直接在输入框里说（模型停下等你）" as &const byte;
    }
    if g_tui_ov_sel == 2 {
        return "退出 plan 模式，模型从下一步开始照着这份计划动手" as &const byte;
    }
    return "留在 plan 模式：模型按你的反馈改一版，再弹一次这个浮窗" as &const byte;
}

// 把正文画到 [top, top+h) 的方框里：标题带滚动指示、正文 markdown-lite、末两行是说明 + 动作
fn tui_draw_overlay_reader() void {
    tui_ov_ensure();
    const panel_top: usize = g_tui_panel_top;
    if panel_top < TUI_OV_READER_MIN_PANEL_TOP {
        return;
    }
    // 非全屏的观感：panel_top-2 起步、上限 20 行、下限 6 行。全屏时前两条上界解除
    // （几何收口那里直接给 panel_top），**下限保留** —— 太矮时那 6 行的下限正是
    // 「标题+正文+说明+动作+底边」的最小可读形态。
    var cap: usize = panel_top - 2;
    if cap > TUI_OV_READER_MAX_H {
        cap = TUI_OV_READER_MAX_H;
    }
    if cap < 6 {
        cap = 6;
    }
    // 宽度：期望 78 列，窄终端退到 cols-6，下限 24；全屏时用满终端。
    var base_w: usize = TUI_OV_READER_W;
    if g_tui_cols < base_w + 6 {
        base_w = g_tui_cols - 6;
    }
    if base_w < 24 {
        base_w = 24;
    }
    if base_w > g_tui_cols {
        base_w = g_tui_cols;
    }
    var w: usize = 0;
    var h: usize = 0;
    var left: usize = 0;
    var top: usize = 0;
    tui_ov_box_w(base_w, cap, &w, &h, &left, &top);
    const inner: usize = w - 2;          // 边框之内
    const body_w: usize = w - 4;         // 正文可用显示列（两侧各留「│ 」与「 │」）
    const body_h: usize = h - 4;         // 标题 + 说明 + 动作 + 底边
    g_tui_ov_body_h = body_h;
    tui_ov_rows_ensure(body_w);
    const hi: usize = tui_ov_reader_top_max();
    // P42：跟随态在**画之前**就钉到底部（这样刚打开、以及每次重推之后都自动贴尾，
    // 不用等用户翻页；重推时写进去的极大值也在这里被夹回真正的底部）。
    if g_tui_ov_watch && g_tui_ov_watch_follow {
        g_tui_ov_body_top = hi;
    }
    if g_tui_ov_body_top > hi {
        g_tui_ov_body_top = hi;
    }

    // P46：正文样式已经**落在字节上**（g_tui_ov_md 与 g_tui_ov_rows 逐字节等长），
    // 所以这里不再需要「从第 0 行扫到 top 复原围栏状态」——窗口从哪儿开始都正确，
    // 顺带省掉一次 O(body_top) 的逐行扫描（旧实现在长计划上每次成帧都要走一遍）。

    tui_row_rewind(top);
    var r: usize = 0;
    while r < h {
        tui_row_new();
        tui_pad_to(left);
        if r == 0 {
            // 顶边 + 标题 + 滚动指示（第 a 行 / 共 b 行）。P53：全屏时再留出 ` · 全屏` 的宽度。
            tui_puts("╭─ " as &const byte, TUI_ST_ACCENT);
            // 标题预算：inner 扣掉滚动指示 16 列与全屏标记；用饱和减法（inner 很小时别回绕）
            var tbud: usize = 0;
            const tneed: usize = 16 + (if g_tui_ov_full { TUI_OV_FULL_DECO_COLS } else { 0 as usize });
            if inner > tneed {
                tbud = inner - tneed;
            }
            tui_ov_put_clipped(g_tui_ov_title.ptr as &const byte, g_tui_ov_title.len, tbud, TUI_ST_BOLD);
            tui_puts(" · " as &const byte, TUI_ST_ACCENT);
            var num: Buf = buf_new(32);
            defer { buf_free(&num); }
            _ = buf_append_u64(&num, (g_tui_ov_body_top + 1) as u64);
            _ = buf_append_byte(&num, 47);   // '/'
            _ = buf_append_u64(&num, g_tui_ov_rows_n as u64);
            _ = buf_append_byte(&num, 32);   // 尾随空格：与右边框的填充线隔开
            tui_ov_put_clipped(num.ptr as &const byte, num.len, 14, TUI_ST_ACCENT);
            if g_tui_ov_full {
                tui_puts(TUI_OV_FULL_DECO, TUI_ST_DIM);
            }
            var used: usize = tui_row_cols() - left;
            while used + 1 < w {
                tui_puts("─" as &const byte, TUI_ST_ACCENT);
                used = used + 1;
            }
            tui_puts("╮" as &const byte, TUI_ST_ACCENT);
        } else if r == h - 1 {
            tui_puts("╰" as &const byte, TUI_ST_ACCENT);
            var used2: usize = 1;
            while used2 + 1 < w {
                tui_puts("─" as &const byte, TUI_ST_ACCENT);
                used2 = used2 + 1;
            }
            tui_puts("╯" as &const byte, TUI_ST_ACCENT);
        } else {
            tui_puts("│ " as &const byte, TUI_ST_ACCENT);
            if r == h - 3 {
                // 选中项说明（同样留一列给可能的 '…'）
                tui_ov_put_clipped(tui_ov_reader_gloss(), bufx_cstr_len(tui_ov_reader_gloss()), body_w, TUI_ST_HINT);
            } else if r == h - 2 {
                // 动作行：选中项前置 ▸（无色模式下 TUI_ST_SEL 不产生 SGR，前缀不能省）
                var i: usize = 0;
                var avail: usize = body_w;
                while i < g_tui_ov_n && avail > 2 {
                    var o: usize = 0;
                    var l: usize = 0;
                    if !tui_ov_item(i, &o, &l) {
                        i = i + 1;
                        continue;
                    }
                    if i > 0 {
                        tui_puts("   " as &const byte, TUI_ST_DEFAULT);
                        avail = avail - 3;
                    }
                    if i == g_tui_ov_sel {
                        tui_puts("▸ " as &const byte, TUI_ST_SEL);
                        avail = avail - 2;
                    } else {
                        tui_puts("  " as &const byte, TUI_ST_DEFAULT);
                        avail = avail - 2;
                    }
                    const before: usize = tui_row_cols();
                    const style: u8 = if i == g_tui_ov_sel { TUI_ST_SEL } else { TUI_ST_DEFAULT };
                    tui_ov_put_clipped(g_tui_ov_items.ptr + o, l, avail, style);
                    // 饱和减法：截断补的 '…' 可能让这一项比 avail 多占一列，别让 usize 回绕
                    const used_item: usize = tui_row_cols() - before;
                    if used_item >= avail {
                        avail = 0;
                    } else {
                        avail = avail - used_item;
                    }
                    i = i + 1;
                }
            } else {
                // 正文：第 (top + 可见序号) 行
                const idx: usize = g_tui_ov_body_top + (r - 1);
                var o: usize = 0;
                var l: usize = 0;
                if idx < g_tui_ov_rows_n && tui_ov_row_at(idx, &o, &l) {
                    // P46：正文走 mdview 排版（已按 body_w 折好、样式落在字节上），
                    // 这里**不再**预判截断、也不再让列给 '…'（踩坑 42 那类补丁）——
                    // 折行与绘制用同一个 body_w，画出来就正好。
                    var mdp: &const byte = g_tui_ov_rows.ptr + o;
                    if buf_valid(&g_tui_ov_md) && o < g_tui_ov_md.len {
                        mdp = g_tui_ov_md.ptr + o;
                    }
                    tui_draw_md_line(g_tui_ov_rows.ptr + o, mdp, l);
                }
            }
            // 内容侧已经保证不超过 inner（body_w = w-4，且都留了 '…' 的余量）：
            // 这里只管补齐到边框位置（补多了边框会右移，实测就是这样发现的）
            var used3: usize = tui_row_cols() - left;
            while used3 + 1 < w {
                tui_puts(" " as &const byte, TUI_ST_DEFAULT);
                used3 = used3 + 1;
            }
            tui_puts("│" as &const byte, TUI_ST_ACCENT);
        }
        tui_fill_row(g_tui_cols);
        r = r + 1;
    }
}
