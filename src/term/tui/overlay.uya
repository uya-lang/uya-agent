// src/term/tui/overlay.uya — 全屏 TUI：浮层几何 + 行偏移表 + 命令面板 + reader 浮层
//
// 本文件：所有浮层共用的几何（P53：宽/高/左上角的**唯一来源**）、长条目取第 i 行的
//   **行偏移表**（踩坑 68：/sessions 打开 1617 ms → 46 ms）、命令面板 / 会话选择 / 帮助
//   三类浮层，以及可滚动阅读长文本的 reader 型浮层（P26 计划审阅）。
// 不变量：行偏移表存的是「每行的**终点**」——存起点会在末行差 1 字节（踩坑 68）；
//   正文折行与屏幕绘制必须同源（同一份 markdown 渲染），不许各画各的。
// 依赖：entry（渲染）、style、screen。
// 命名：本目录统一 `tui_` / `TUI_` 前缀（uya 没有闭包，模块级名字全局合并）。

use libc.syscall;
use libc.unistd;
use libc.heap;

// ============================================================
// 浮层（命令面板 / 会话选择 / 帮助 / 审批问答）
// ============================================================

export const TUI_OV_NONE: u8 = 0;
export const TUI_OV_LIST: u8 = 1;      // 列表型：面板 / 会话 / 帮助
export const TUI_OV_CONFIRM: u8 = 2;   // 问答型：ask_user_question / plan 审批
export const TUI_OV_DIFF: u8 = 3;      // P27：/diff（左列表 + 右两栏，自带按键与几何）

var g_tui_ov: u8 = 0;
var g_tui_ov_title: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_ov_items: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_ov_n: usize = 0;
var g_tui_ov_sel: usize = 0;
var g_tui_ov_top: usize = 0;
var g_tui_ov_filter: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_ov_prompt: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_ov_result: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_ov_have: bool = false;       // 有结果可取
var g_tui_ov_cancel: bool = false;     // 被 Esc 取消

var g_tui_ov_items_ix: TuiLineIdx = TuiLineIdx{ offs: null as &usize, n: 0, cap: 0 };
var g_tui_ov_rows_ix: TuiLineIdx = TuiLineIdx{ offs: null as &usize, n: 0, cap: 0 };

export const TUI_OVK_PALETTE: u8 = 1;  // 命令面板（输入以 / 开头时也用它）
export const TUI_OVK_SESSIONS: u8 = 2;
export const TUI_OVK_HELP: u8 = 3;
export const TUI_OVK_ASK: u8 = 4;      // ask_user_question
export const TUI_OVK_PLAN: u8 = 5;     // exit_plan_mode 审批
export const TUI_OVK_ACCESS: u8 = 6;         // P21：访问模式选择（底对齐菜单）
export const TUI_OVK_ACCESS_CONFIRM: u8 = 7; // P21：Full access 风险确认
export const TUI_OVK_APPROVE: u8 = 8;        // P21：read-only 下 bash 逐条批准
export const TUI_OVK_TASKS: u8 = 9;          // P22：/tasks 任务状态（纯查看，enter 不派发）
export const TUI_OVK_DIFF: u8 = 10;          // P27：/diff 双列全文比对（浏览型浮层）
export const TUI_OVK_GOAL: u8 = 11;          // P29：/goal 会话目标状态（纯查看，enter 不派发）
export const TUI_OVK_MODEL: u8 = 12;         // P37：/model 模型选择（按提供方分组）
export const TUI_OVK_EFFORT: u8 = 13;        // P37：/effort 推理强度选择（只列模型公布的档位）
export const TUI_OVK_WORKTREE: u8 = 14;      // P41：/worktree 动作选择（底对齐菜单）
export const TUI_OVK_WORKTREE_CONFIRM: u8 = 15; // P42：finish/discard 的不可逆动作确认
export const TUI_OVK_WATCH: u8 = 16;         // P42：/watch 跟随子代理实时消息（正文浮层，可续推）
export const TUI_OVK_WATCH_LIST: u8 = 17;    // P46：/watch 现役子代理清单（回车 = 跟随那个）
                                             // 与 /tasks 共用过的 TUI_OVK_TASKS 必须分开：那个 kind
                                             // 在接收端是「纯查看」语义，回车会被静默丢弃
export const TUI_OVK_TITLE: u8 = 18;         // P48：/title 会话标题输入框（单行文本，可预填建议）

var g_tui_ov_kind: u8 = 0;
// 交回结果时的 kind：tui_ov_accept() 会先 close（把 g_tui_ov_kind 清 0），
// 而调用方是「take 之后才读 kind」——不留这一份，结果就会被静默丢掉（palette/sessions 也踩过；
// P22 又踩了一遍：`/exit` 从面板里选出来同样被丢掉，见 §3 踩坑 44）
var g_tui_ov_done: u8 = 0;
// P21：0 = 居中（今天的行为），1 = 贴着输入面板往上弹（菜单型，对齐 DSH 的 Menu side:"top"）
var g_tui_ov_anchor: u8 = 0;

// P33：列表型浮层的**期望宽度**（0 = 默认档 60）。会话列表要放「标题 / 工作区 / session id」
// 三列，写死的 60 列不够用 ⇒ 由调用方声明意图，几何仍只有 tui_ov_box_w() 一份。
// 生命周期：tui_overlay_list() 每次开浮层都把它清回 0（别的浮层不会继承宽度），
// tui_overlay_list_wide() 在开完之后设上。
var g_tui_ov_want_w: usize = 0;

// ------------------------------------------------------------
// P53：浮层**全屏**（ctrl+f / F11 / `/fullscreen`）
//
// 「全屏」在这里有确切含义：浮层把**转录区**用满 —— 宽 = 终端列数、高 = panel_top、
// 左上角 = (0, 0)。刻意**不去吃面板 / 状态区 / 脚注**：输入行是常驻的打字目标（踩坑 66
// 的承诺），状态区是「分不清在跑还是卡住」时唯一要看的那一眼（P18 的承诺）。全屏是
// 「把浮层这块地用到最大」，不是「抢掉别的常驻区」。
//
// 生命周期与 g_tui_ov_want_w 同一条纪律：**按浮层一次性生效** —— 开浮层时清回 false
// （tui_overlay_list / _reader / _ask_open / _diff_open / _input_open 都走这条），close
// 时也清（收掉浮层之后不该留着「下一张自动全屏」的隐形状态）。所以它只有一个开关语义，
// 不存在「这张全屏、那张不全屏」的记忆。
//
// ⚠ 与 fail-closed 判据的关系（一个字节都不许动）：tui_overlay_available() /
// tui_reader_fits() / tui_ask_wait 的「太矮就回落」/ tui_overlay_diff_fits() 都按
// panel_top 判「画不画得出来」。全屏只改**画出来多大**，不改「能不能画」——
// 画不出来的浮层，全屏也照样画不出来（审批必须「看不见就不许做」）。
// ------------------------------------------------------------
var g_tui_ov_full: bool = false;

// 全屏态：查询 + 设置 + 翻转，全部收在这一对函数里（`tui_overlay_full` 读、
// 设置进同一个函数）。**为什么不拆成三个 get/set/toggle**：uya 0.10 的函数表是
// **固定容量**（`FUNCTION_TABLE_SIZE`，写死在编译器里、没有开关），本仓合并到本轮之后
// 只剩 2 个名额 —— 拆开就超容，`make check` / `make build` 从干净缓存起当场红（踩坑 87）。
// 全屏态：一个函数管「查询 + 设置 + 翻转」，返回**设置之后的**状态。
//   want == -2 = 只查询（不改，永远返回当前态）；
//   want == -1 = 翻转；want == 0 = 关；want > 0 = 开。
// 调用的返回值为 false 且 want != -2 时 = 「没改到东西」（没浮层可全屏 / 已经是那个态），
// 调用方据此落一条 notice（不静默）。
//
// 为什么查询与设置合成一个函数（而不是 get/set/toggle 三个）：uya 0.10 的函数表是
// **固定容量**（FUNCTION_TABLE_SIZE，写死在编译器里、没有开关），本仓合并到本轮之后
// 只剩 2 个名额 —— 拆开就超容，`make check` / `make build` 从干净缓存起当场红（踩坑 87）。
// 为什么不在没浮层时「顺手开一张帮助浮层」：那是隐形副作用，而且滚动模式（--no-tui）
// 根本没有浮层可全屏 —— 两边都需要一致的「没东西可切」语义。
export fn tui_overlay_full(want: i32) bool {
    if want == -2 {
        return g_tui_ov_full;
    }
    if g_tui_ov == TUI_OV_NONE {
        return false;
    }
    var on: bool = !g_tui_ov_full;
    if want == 0 {
        on = false;
    } else if want > 0 {
        on = true;
    }
    if g_tui_ov_full == on {
        return false;
    }
    g_tui_ov_full = on;
    tui_mark_dirty();
    return true;
}

// ------------------------------------------------------------
// P26：reader 型浮层（计划审阅）—— 上半是可滚动正文，下半是「一行说明 + 一行动作」。
// 与列表型共用 items / 结果机制（tui_ov_accept 直接把选中项原文交回调用方），
// 区别只在排版与按键：↑/↓ 滚正文、tab/←/→ 切动作、数字直选。
// ------------------------------------------------------------
var g_tui_ov_reader: bool = false;   // 当前浮层是 reader 型
// P42：/watch 跟随浮层 —— 复用 reader 的正文/滚动/按键，只多两件东西：
//   * 内容会被**反复重推**（子代理每出新事件就重推一次），所以滚动位置必须保住；
//   * 「贴尾跟随」开关：默认跟随（新内容自动滚到底），用户一旦上滚就停跟随。
var g_tui_ov_watch: bool = false;
var g_tui_ov_watch_follow: bool = true;
var g_tui_ov_body: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // 清洗 + 限长后的正文
var g_tui_ov_rows: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // 折行结果（一行一条，'\n' 分隔）
var g_tui_ov_md: Buf = Buf{ ptr: null, len: 0, cap: 0 };     // P46：与 g_tui_ov_rows 逐字节等长的样式
var g_tui_ov_rows_w: usize = 0;      // 折行宽度（缓存键：尺寸变了就重折）
var g_tui_ov_rows_n: usize = 0;      // 折行后的总行数
var g_tui_ov_body_top: usize = 0;         // 正文首行（滚动位置）
var g_tui_ov_body_h: usize = 1;      // 最近一帧画出来的正文可见行数（翻页步长）

const TUI_OV_READER_MAX_H: usize = 20;         // reader 浮层最高多少行（列表型是 16）
const TUI_OV_READER_W: usize = 78;             // 期望宽度（窄终端再退）
const TUI_OV_READER_MIN_PANEL_TOP: usize = 6;  // 标题+1 行正文+说明+动作+底边 = 6；更矮就别开
const TUI_OV_BODY_MAX: usize = 131072;         // 正文上限（超出按行截断并在末尾指路）

// 列表型浮层的箱体宽度（默认 60 列；窄终端退到 cols-6，下限 24）——
// 绘制、窗口计算与「条目内容按多少列排版」都问这一份，别再各写一遍。
const TUI_OV_LIST_W: usize = 60;
const TUI_OV_BOX_W_MIN: usize = 24;

// 列表型浮层的箱体宽度算在 tui_ov_box_w 里（want_w <= 0 表示走默认档 60 列）——
// 不再单独开函数：uya 0.10 的函数表是**固定容量**，本仓只剩 2 个名额（见 tui_ov_box_w 的注释）。

// ============================================================
// P53：浮层几何的**唯一来源**（宽 / 高 / 左上角）
//
// 在这之前，几何在四份绘制里各写了一遍（列表型 / reader / ask / input），每份都硬编码了
// 「留白与上界」—— 全屏要动就得改四处，漏一处就是「方框右边参差」（踩坑 42 那一族）。
// 所以先把它们收成**一处**，四份绘制一律问它：
//
//   * 非全屏（默认）：**逐字节返回本线之前的结果** —— 这是 `--tui-demo` 快照仍然可比的
//     硬要求，也是「没有回归」的判据（纯新增，老路径一个字节不动）。
//   * 全屏：宽 = 终端列数、高 = 转录区高（panel_top）、左上角 = (0,0)。一条规则管所有
//     形态，不搞「这张全屏、那张半屏」。
//
// 高度为什么用 panel_top 而不是 rows：浮层画在**转录区**，panel_top 就是这块地的行数。
// 刻意不吃面板 / 状态区 / 脚注 —— 输入行是常驻的打字目标（踩坑 66 的承诺），状态区是
// 「分不清在跑还是卡住」时唯一要看的那一眼（P18 的承诺）。
//
// ⚠ 为什么是一个函数（输出参数带四个值）而不是四个「宽/高/左/上」的小函数：uya 0.10 的
// 函数表有**固定容量**（`FUNCTION_TABLE_SIZE`，写死在编译器里、没有开关）。实测本仓合并到
// 本轮之后只剩 **2 个函数**的余量（声明 6748 通过 / 6749 就报「函数表容量不足」），
// 拆成四个小函数直接超容 —— `make build` 从干净缓存起必红（踩坑 87）。
// 所以按「一次算全、输出参数带回来」收口，一个函数顶四个。
// ============================================================

// 浮层几何。base_w = 「该形态自己的宽度观感」（列表 60 / reader 78 / ask 与 input 内容自适应），
// cap_h = 「该形态自己的高度上界」（列表 16 / reader-ask 20 / input 固定 4）。
// 全屏时两者被覆盖成终端与转录区的尺寸；非全屏时按旧公式算，**与旧实现逐字节相同**。
fn tui_ov_box_w(base_w: usize, cap_h: usize, w: &usize, h: &usize, left: &usize, top: &usize) void {
    // base_w <= 0 = 「列表型的默认档」：60 列，窄终端退到 cols-6，下限 24
    // （want_w = 0 时与旧写法 `if g_tui_cols < 70 { w = g_tui_cols - 6 }` 完全等价，60 + 10）。
    // 各形态自己的宽度观感（reader 78 / ask 与 input 内容自适应）由调用方算好传进来。
    var bw: usize = base_w;
    if bw == 0 {
        bw = TUI_OV_LIST_W;
        if g_tui_cols > 6 && g_tui_cols < bw + 10 {
            bw = g_tui_cols - 6;
        }
        if bw < TUI_OV_BOX_W_MIN {
            bw = TUI_OV_BOX_W_MIN;
        }
    }
    if g_tui_ov_full {
        w[0] = g_tui_cols;
        h[0] = g_tui_panel_top;
        left[0] = 0;
        top[0] = 0;
        return;
    }
    w[0] = bw;
    h[0] = cap_h;
    // 左边界：终端比框宽就居中，否则退回 2
    if g_tui_cols > bw + 4 {
        left[0] = (g_tui_cols - bw) / 2;
    } else {
        left[0] = 2;
    }
    // 上边界：居中（菜单型的「贴面板」在 tui_draw_overlay 里另判）
    if g_tui_panel_top > cap_h + 2 {
        top[0] = (g_tui_panel_top - cap_h) / 2;
    } else {
        top[0] = 1;
    }
}

// P53：全屏时标题栏挂一个 ` · 全屏` 标记，让人一眼知道现在是哪个态（与 ask 的 ` · 多选`
// 同一套做法，同样占 7 列）。全屏的几何本身就是最明显的信号（方框顶到屏幕四边），
// 这个标记是给「窄终端下看不清边框在哪」与自测断言用的。
//
// 「要不要留这 7 列」直接写成 g_tui_ov_full 上的三元表达式（`if g_tui_ov_full { 7 } else { 0 }`），
// 不另开一个函数 —— 原因同上（函数表容量），这个只有 4 个调用点，就地展开更省。
const TUI_OV_FULL_DECO: &const byte = " · 全屏" as &const byte;
const TUI_OV_FULL_DECO_COLS: usize = 7;

// 已输入文本（过滤器）在标题栏上的那一小段 ` › stat▌` 的两个预算常量。
// 过滤段的固定开销 = ` › ` 3 列 + 光标格 `▌` 1 列；标题至少留 TUI_OV_TITLE_MIN 列。
// 两者都在**列**上算，口径与 tui_put_clipped / tui_put_clipped_tail 一致。
const TUI_OV_TITLE_MIN: usize = 4;
const TUI_OV_FILTER_CHROME: usize = 4;

// 浮层条目能用的显示列数 = 箱体宽度 - 3（左右边框各 1 列 + 左边框后那个空格）。
// 调用方按它排版条目内容，绘制侧再裁一层（tui_ov_put_clipped）——两层口径必须一致，
// 否则方框右边会参差（见踩坑 42）。
export fn tui_overlay_body_cols(want_w: usize) usize {
    // 只要宽度：宽/高/左/上四个出参里，其余三个丢给临时变量
    var w: usize = 0;
    var h: usize = 0;
    var l: usize = 0;
    var t: usize = 0;
    tui_ov_box_w(want_w, 0, &w, &h, &l, &t);
    var b: usize = 1;
    if w > 3 {
        b = w - 3;
    }
    return b;
}

// 惰性分配浮层用的 8 个 Buf（标题 / 条目 / 过滤词 / 提问 / 结果 / 正文 / 折行 / 样式），幂等。
fn tui_ov_ensure() void {
    if !buf_valid(&g_tui_ov_title) { g_tui_ov_title = buf_new(256); }
    if !buf_valid(&g_tui_ov_items) { g_tui_ov_items = buf_new(8192); }
    if !buf_valid(&g_tui_ov_filter) { g_tui_ov_filter = buf_new(256); }
    if !buf_valid(&g_tui_ov_prompt) { g_tui_ov_prompt = buf_new(8192); }
    if !buf_valid(&g_tui_ov_result) { g_tui_ov_result = buf_new(4096); }
    if !buf_valid(&g_tui_ov_body) { g_tui_ov_body = buf_new(8192); }
    if !buf_valid(&g_tui_ov_rows) { g_tui_ov_rows = buf_new(8192); }
    if !buf_valid(&g_tui_ov_md) { g_tui_ov_md = buf_new(8192); }
}

// 当前有没有浮层开着（任何形态）。
export fn tui_overlay_open() bool {
    return g_tui_ov != TUI_OV_NONE;
}

// 收下结果的人（TUI 主循环）拿它判断「选中的是哪张浮层」。
//
// 必须回**结果**的 kind，不能回「当前打开着的」那个：`tui_overlay_close()` 会把
// g_tui_ov_kind 清零，而它在 accept 里是**收尾**调用的 —— 于是主循环读到的永远是 0，
// 命令面板/会话列表选出来的东西被静默丢掉（`/exit` 从面板里选、`/sessions` 里挑会话
// 全都「按了没反应」，见 README 踩坑 44）。
export fn tui_overlay_kind() u8 {
    if g_tui_ov != TUI_OV_NONE {
        return g_tui_ov_kind;
    }
    return g_tui_ov_done;   // 已经 close 了：调用方仍在问「刚才是哪个浮层交回的结果」
}

// 条目缓冲里有几项：'\n' 个数 +1，末字节非 '\n' 时才 +1（与 TuiLineIdx 的计数口径逐字相同）。
// 空缓冲返回 0。O(n) 单遍。
fn tui_ov_count_items() usize {
    tui_ov_ensure();
    var n: usize = 0;
    if g_tui_ov_items.len == 0 {
        return 0;
    }
    var i: usize = 0;
    while i < g_tui_ov_items.len {
        if g_tui_ov_items.ptr[i] == 10 as byte {
            n = n + 1;
        }
        i = i + 1;
    }
    if g_tui_ov_items.ptr[g_tui_ov_items.len - 1] != 10 as byte {
        n = n + 1;
    }
    return n;
}

// ============================================================
// 行偏移表（踩坑 68）：见 TuiLineIdx 上面那段注释
// ============================================================

// 丢掉表（free 并把三格清零）。与缓冲区重写配套：重写之后必须重建。
fn tui_lineidx_reset(ix: &TuiLineIdx) void {
    if (ix.offs as usize) != 0 {
        free(ix.offs as &void);
    }
    ix.offs = null as &usize;
    ix.n = 0;
    ix.cap = 0;
}

// 表里第 i 行的字节区间（i 越界 = false）。表里存的是**每行的终点**（不含行尾 '\n'）：
//   * offs[i] = 本行的终点（最后一行没有 '\n' 时就是缓冲区尾）；
//   * 本行的起点 = i == 0 ? 0 : offs[i-1] + 1（跳过上一行那个 '\n'）。
//
// ⚠ 这里踩过一次（本轮被 `--tui-demo` 逐字节对照当场抓住）：起初存的是一行的**起点**、
// 拿「下一行的起点减一」当终点，结果末行长度的算法在「缓冲区以 '\n' 收尾」与
// 「不以 '\n' 收尾」两种情形下不一致（前者要把末尾那个 '\n' 排除掉，后者不排除），
// 末行长度算成 1 而不是 0 —— reader 浮层（计划审阅）画到末行就多占一列，右边框被顶出去。
// 存终点就没有这个歧义：终点就是那个 '\n' 的下标，一个减法完事，O(1)。
//
// 与老实现 `tui_ov_line_at()` 逐字节等价：每行不含行尾 '\n'；缓冲区以 '\n' 收尾时
// 末尾那个空段只落在下标 n 上，而调用方本来就带 `i < 行数` 守卫。
fn tui_lineidx_at(ix: &const TuiLineIdx, b: &const Buf, i: usize, off: &usize, len: &usize) bool {
    if (ix.offs as usize) == 0 || i >= ix.n {
        return false;
    }
    const start: usize = if i == 0 { 0 as usize } else { ix.offs[i - 1] + 1 };
    const end: usize = ix.offs[i];
    off[0] = start;
    len[0] = end - start;
    return true;
}

// 数出 b 的行数（与 tui_ov_count_items 同一口径）
fn tui_lineidx_count(b: &const Buf) usize {
    if b.len == 0 {
        return 0;
    }
    var n: usize = 0;
    var i: usize = 0;
    while i < b.len {
        if b.ptr[i] == 10 as byte {
            n = n + 1;
        }
        i = i + 1;
    }
    if b.ptr[b.len - 1] != 10 as byte {
        n = n + 1;
    }
    return n;
}

// 重建表：一趟数、一趟填（容量不够就 free + 重新 malloc）。
// 缓冲区重写之后**必须**调它，否则取行会读到上一份内容的偏移。
//
// 表里存的是**每行的终点**（不含行尾 '\n'）——终点就是那个 '\n' 的下标，
// 末行没有 '\n' 时就是缓冲区尾。取行时的起点由「上一行的终点 + 1」还原
// （见 tui_lineidx_at），于是每行不含行尾换行符，与老实现逐字节一致。
fn tui_lineidx_build(ix: &TuiLineIdx, b: &const Buf) void {
    const n: usize = tui_lineidx_count(b);
    if n > ix.cap {
        if (ix.offs as usize) != 0 {
            free(ix.offs as &void);
        }
        ix.offs = null as &usize;
        ix.cap = 0;
        const raw: &void = malloc((n + 1) * (@size_of(usize) as usize));
        if ((raw as &byte) as usize) == 0 {
            ix.n = 0;
            return;
        }
        ix.offs = raw as &usize;
        ix.cap = n + 1;
    }
    ix.n = n;
    if n == 0 {
        return;
    }
    var k: usize = 0;
    var i: usize = 0;
    while i < b.len {
        if b.ptr[i] == 10 as byte {
            ix.offs[k] = i;
            k = k + 1;
        }
        i = i + 1;
    }
    // 末行没有 '\n' 收尾时，它还没记上 —— 终点就是缓冲区尾
    if k < n {
        ix.offs[k] = b.len;
    }
}

// 一行一段文本里到底有几项（'\n' 分隔；末行没有换行也算一项）。
// P35：`/sessions` 要把游标放到最后一项，而它手里只有条目缓冲（不是浮层内部状态）——
// 于是把这条计数规则导出来，免得调用方自己再写一份、两边判据漂移。
export fn tui_ov_line_count(p: &const byte, n: usize) usize {
    if n == 0 {
        return 0;
    }
    var k: usize = 0;
    var i: usize = 0;
    while i < n {
        if p[i] == 10 as byte {
            k = k + 1;
        }
        i = i + 1;
    }
    if p[n - 1] != 10 as byte {
        k = k + 1;
    }
    return k;
}

// 取条目缓冲里第 i 项的字节区间（不含行尾 '\n'）。常规路径走行偏移表 O(1)；
// 表没建起来（malloc 失败）或防假绿开关打开时退回线性扫描 O(n) —— 结果**同一个**，只是慢。
fn tui_ov_item(i: usize, off: &usize, len: &usize) bool {
    // 表没建起来（malloc 失败这类极端情况）：退回线性扫描 —— 结果是**同一个**，
    // 只是慢。这样「取行」永远不会因为表缺失而静默给空。
    if g_tui_ov_force_scan || (g_tui_ov_items_ix.offs as usize) == 0 {
        return tui_ov_line_at(&g_tui_ov_items, i, off, len);
    }
    return tui_lineidx_at(&g_tui_ov_items_ix, &g_tui_ov_items, i, off, len);
}

// 自测用：把「取行」强制走线性扫描（= 老实现那条路）。
//
// 用途是**防假绿的对照实验**：把这一句打开重编，`tui-sessions-big` 里那条
// 「取末项 20000 次的自校准比值」必须当场红（查表腿与扫描腿都变成线性扫描 ⇒ ≈1:1）。
// 自测自己**不**翻这个开关 —— 翻了的话两条腿都是扫描，比值恒为 1，红的是自测而不是被测对象。
// 平时恒 false；要复验「取行真的 O(1)」时手工打开一次。
var g_tui_ov_force_scan: bool = false;
// 自测用：把取行强制走线性扫描（防假绿对照组，平时恒 false；自测自己不许翻）。
// 打开后 tui-sessions-big 的「查表 vs 扫描」比值断言必须当场红。
export fn tui_overlay_force_scan(on: bool) void {
    g_tui_ov_force_scan = on;
}

// 自测用：走线性扫描那条路取第 i 项（与查表路径做差分对照）
export fn tui_overlay_lin_span(i: usize, off: &usize, len: &usize) bool {
    return tui_ov_line_at(&g_tui_ov_items, i, off, len);
}

// 取 buf 里第 i 行（'\n' 分隔）的字节区间 —— 线性扫描版（O(n)）。
// 两处用途：① 偏移表缺失（malloc 失败这类极端情况）时的兜底；② 自测的差分对照腿
// （tui_overlay_lin_span），以及 ask_user 弹窗那点小条目（P43）直接用它。
// 常规路径一律走 tui_lineidx_at（O(1)）。
fn tui_ov_line_at(b: &const Buf, i: usize, off: &usize, len: &usize) bool {
    var line: usize = 0;
    var start: usize = 0;
    var p: usize = 0;
    while p <= b.len {
        if p == b.len || b.ptr[p] == 10 as byte {
            if line == i {
                off[0] = start;
                len[0] = p - start;
                return true;
            }
            line = line + 1;
            start = p + 1;
        }
        p = p + 1;
    }
    return false;
}

// reader 型浮层的正文行（折行结果那份缓冲）
fn tui_ov_row_at(i: usize, off: &usize, len: &usize) bool {
    if (g_tui_ov_rows_ix.offs as usize) == 0 {
        return tui_ov_line_at(&g_tui_ov_rows, i, off, len);
    }
    return tui_lineidx_at(&g_tui_ov_rows_ix, &g_tui_ov_rows, i, off, len);
}

// 这一项是否通过当前过滤器：过滤器为空时**每一项都通过**（直接返回 true 的 O(1) 快路径，
// 每次按键都要走）；否则做大小写不敏感（仅 ASCII）子串匹配，O(n·m)。
fn tui_ov_filter_match(p: &const byte, n: usize) bool {
    if g_tui_ov_filter.len == 0 {
        return true;
    }
    if n < g_tui_ov_filter.len {
        return false;
    }
    // 子串匹配（大小写不敏感 ASCII）
    var i: usize = 0;
    while i + g_tui_ov_filter.len <= n {
        var k: usize = 0;
        var ok: bool = true;
        while k < g_tui_ov_filter.len {
            var a: byte = p[i + k];
            var b: byte = g_tui_ov_filter.ptr[k];
            if a >= 65 as byte && a <= 90 as byte {
                a = (a + 32) as byte;
            }
            if b >= 65 as byte && b <= 90 as byte {
                b = (b + 32) as byte;
            }
            if a != b {
                ok = false;
                break;
            }
            k = k + 1;
        }
        if ok {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 打开列表型浮层（items 用 '\n' 分隔）
// 踩坑 81：标题是**帧里的一行**，一律单行清洗（'\n' → 空格、控制字节 → 可见替代）——
// 列表条目本身按 '\n' 分行（那是它的语义），标题不分行。
export fn tui_overlay_list(kind: u8, title: &const byte, tn: usize, items: &const byte, inlen: usize) void {
    tui_ov_ensure();
    g_tui_ov = TUI_OV_LIST;
    g_tui_ov_kind = kind;
    g_tui_ov_done = 0;
    buf_reset(&g_tui_ov_title);
    tui_clean_line_into(&g_tui_ov_title, title, tn);
    buf_reset(&g_tui_ov_items);
    _ = buf_append(&g_tui_ov_items, items, inlen);
    g_tui_ov_n = tui_ov_count_items();
    tui_lineidx_build(&g_tui_ov_items_ix, &g_tui_ov_items);   // 踩坑 68：条目缓冲区重写 ⇒ 重建行偏移表
    g_tui_ov_sel = 0;
    g_tui_ov_top = 0;
    buf_reset(&g_tui_ov_filter);
    g_tui_ov_have = false;
    g_tui_ov_cancel = false;
    g_tui_ov_anchor = 0;
    g_tui_ov_want_w = 0;   // 宽度意图按浮层一次性生效（要用宽箱体走 tui_overlay_list_wide）
    g_tui_ov_full = false; // P53：全屏意图同样按浮层一次性生效（开新浮层 = 回到居中框）
    tui_mark_dirty();
}

// P33：带宽度意图的列表浮层（会话列表用）。want_w = 0 等价于 tui_overlay_list()。
// 顺序不能反：tui_overlay_list() 会把 g_tui_ov_want_w 清 0，所以这一句必须排在它后面。
export fn tui_overlay_list_wide(kind: u8, title: &const byte, tn: usize, items: &const byte, inlen: usize, want_w: usize) void {
    tui_overlay_list(kind, title, tn, items, inlen);
    if want_w > 0 {
        g_tui_ov_want_w = want_w;
    }
    tui_mark_dirty();
}

// P21：菜单型浮层 —— 底对齐 + 指定初始选中（访问模式选择器用）
export fn tui_overlay_menu(kind: u8, title: &const byte, tn: usize, items: &const byte, inlen: usize, sel: usize) void {
    tui_overlay_list(kind, title, tn, items, inlen);
    if sel < g_tui_ov_n {
        g_tui_ov_sel = sel;
    }
    tui_ov_sel_into_window();
    g_tui_ov_anchor = 1;
    tui_mark_dirty();
}

// P21：菜单型 + 确认型（底对齐、带 prompt），两道浮层共用同一套排版
//
// 踩坑 81：**进帧的文本一律单行清洗**。这两处以前直接 append 原始字节，而 prompt 是
// 「要批准的东西」——read-only 下一条多行 bash 命令、或带 '\n' 的标题，画进「帧里的一行」
// 之后终端会把它拆成多行（后几行从第 0 列开始，方框右边框对不齐；ESC 还能改写终端状态）。
// 与 ask 型同一份口径（tui_clean_line_into），不再各写一套。
export fn tui_overlay_menu_confirm(kind: u8, title: &const byte, tn: usize, prompt: &const byte, pn: usize, items: &const byte, inlen: usize, sel: usize) void {
    tui_overlay_menu(kind, title, tn, items, inlen, sel);
    g_tui_ov = TUI_OV_CONFIRM;
    buf_reset(&g_tui_ov_prompt);
    tui_clean_line_into(&g_tui_ov_prompt, prompt, pn);
    tui_mark_dirty();
}

// 浮层画得出来吗？（终端太小 / 输入面板太高时 tui_draw_overlay 会直接 return，
// 那就会「看不见却仍吞键」—— 审批通道必须据此 fail closed）
export fn tui_overlay_available() bool {
    return g_tui_panel_top >= 5;
}

// 打开问答型（CONFIRM）浮层：底层仍是列表型（条目 + 键位），另把 prompt 单行清洗进
// g_tui_ov_prompt（踩坑 81：提问正文是帧里的一行，行内不许出现 '\n'）。
export fn tui_overlay_confirm(kind: u8, prompt: &const byte, pn: usize, items: &const byte, inlen: usize) void {
    // 长度必须量出来：「请确认」是 9 字节，写死 6 会把后面 3 字节 .rodata 也当标题复制进来
    tui_overlay_list(kind, "请确认" as &const byte, bufx_cstr_len("请确认" as &const byte), items, inlen);
    g_tui_ov = TUI_OV_CONFIRM;
    buf_reset(&g_tui_ov_prompt);
    tui_clean_line_into(&g_tui_ov_prompt, prompt, pn);   // 踩坑 81：单行清洗（同 menu_confirm）
    tui_mark_dirty();
}



// ============================================================
// P26：reader 型浮层（计划审阅）
// ============================================================

// reader 浮层画得出来吗？—— 至少要放得下「标题 + 1 行正文 + 说明 + 动作 + 底边」。
// 画不出来时审阅必须 fail closed（与 bash 逐条批准同态度），不能「看不见却仍吞键」。
export fn tui_reader_fits() bool {
    return tui_overlay_available() && g_tui_panel_top >= TUI_OV_READER_MIN_PANEL_TOP;
}

// 打开 reader 型浮层：body 是要给用户看的正文（计划原文，可以是任意长度）。
// 正文先过 tui_clean_into（控制字节清洗，保住「正文层无 ESC」的不变量），再按上限截断。
export fn tui_overlay_reader(kind: u8, title: &const byte, tn: usize, body: &const byte, bn: usize, items: &const byte, inlen: usize, sel: usize) void {
    tui_overlay_list(kind, title, tn, items, inlen);
    tui_ov_ensure();
    g_tui_ov_reader = true;
    g_tui_ov_body_top = 0;
    g_tui_ov_body_h = 1;
    g_tui_ov_rows_w = 0;
    g_tui_ov_rows_n = 0;
    if sel < g_tui_ov_n {
        g_tui_ov_sel = sel;
    }
    buf_reset(&g_tui_ov_body);
    tui_clean_into(&g_tui_ov_body, body, bn);
    if g_tui_ov_body.len > TUI_OV_BODY_MAX {
        // 按行截断（别切出半个 UTF-8 字符），末尾留一行指路：全文始终在转录里
        var cut: usize = TUI_OV_BODY_MAX;
        var guard: usize = 0;
        while cut > 0 && g_tui_ov_body.ptr[cut] != 10 as byte && guard < TUI_OV_BODY_MAX {
            cut = cut - 1;
            guard = guard + 1;
        }
        if cut == 0 {
            cut = TUI_OV_BODY_MAX;
        }
        buf_truncate(&g_tui_ov_body, cut);
        _ = buf_append_cstr(&g_tui_ov_body, "\n…（计划过长，剩余部分见转录）\n");
    }
    tui_mark_dirty();
}
