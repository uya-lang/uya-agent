// src/term/tui/style.uya — 全屏 TUI（P17）：样式 / 帧模型 / 拼帧基元
//
// 本文件：SGR 常量与样式表、帧模型（TuiSeg / TuiRow）、按**显示列**前进的拼帧基元，
//   以及 P75 的「放不下的文本滚动显示」（跑马灯槽位表 `tui_marquee_*`；P76 起
//   「一格一条」的簇里只有选中项滚，且命令名钉住、只滑后面的说明）。
// 不变量（三条硬约束，被这个项目的历史教育过）：
// 不变量：SGR 一律数组字面量 / 正文层无 ESC / 帧只写私有 fd —— 三条逐条展开见下。
//   ① 所有 SGR 序列都用 `[byte: N]` 数组字面量或逐字节拼，**绝不用 `&"字面量"[a:b]`**
//      —— 那会生成「切片描述符地址 → char*」强转，屏幕上是乱码（§16 踩坑 22）；
//   ② 正文层（g_tui_text / 行文本）里**不允许出现 ESC**，宽度/换行/擦除全按显示列算；
//   ③ 帧写到启动时 `sys_dup(1)` 的私有 fd（tls_noise_mute 会把 fd 2 重定向到 /dev/null）。
// 依赖：foundation/bufx、term/tty。
// 命名：本目录统一 `tui_` / `TUI_` 前缀（uya 没有闭包，且模块级名字全局合并）。

use libc.syscall;
use libc.unistd;
use libc.heap;

// ============================================================
// 样式
// ============================================================

export const TUI_ST_DEFAULT: u8 = 0;
export const TUI_ST_DIM: u8 = 1;
export const TUI_ST_BOLD: u8 = 2;
export const TUI_ST_ACCENT: u8 = 3;
export const TUI_ST_OK: u8 = 4;
export const TUI_ST_ERR: u8 = 5;
export const TUI_ST_WARN: u8 = 6;
export const TUI_ST_USER: u8 = 7;
export const TUI_ST_ASSIST: u8 = 8;
export const TUI_ST_TOOL: u8 = 9;
export const TUI_ST_ADD: u8 = 10;
export const TUI_ST_DEL: u8 = 11;
export const TUI_ST_CODE: u8 = 12;
export const TUI_ST_INLINE: u8 = 13;
export const TUI_ST_HINT: u8 = 14;
export const TUI_ST_FOOTER: u8 = 15;
export const TUI_ST_SEL: u8 = 16;
// P36：/diff 的改动底色。整行铺底（*_BG）用暗底，行内变化片段（*_HL）再亮一档 ——
// 「哪几行改了」与「这一行里哪几个字改了」是两件事，各给一档。
export const TUI_ST_ADD_BG: u8 = 17;     // 整行新增（深绿底）
export const TUI_ST_DEL_BG: u8 = 18;     // 整行删除（深红底）
export const TUI_ST_ADD_HL: u8 = 19;     // 行内新增片段（亮绿底）
export const TUI_ST_DEL_HL: u8 = 20;     // 行内删除片段（亮红底）
// P46：markdown 渲染多出来的三档。**排在表尾**，老样式的编码一个字节都不动
// （`--tui-demo` 的既有快照因此仍逐字节可比，只有正文那一屏按 P46 的新排版变）。
export const TUI_ST_H1: u8 = 21;         // 一级标题（粗 + 强调色）
export const TUI_ST_ITALIC: u8 = 22;     // *斜体* / _斜体_
export const TUI_ST_STRIKE: u8 = 23;     // ~~删除线~~（靠终端的 SGR 9）
export const TUI_ST_COUNT: usize = 24;

// 每个样式最多 8 个 SGR 参数（-1 = 跳过）；[style * 8 + slot]
// 16 色一套、256 色一套 —— 由 g_tui_color256 选。
//
// P36 把每样式的参数槽从 4 扩到 8：256 色的「亮前景 + 显式背景」是 `38;5;N;48;5;M`
// 六个参数，4 个槽位装不下（会被静默截断成只有前景 —— 背景色这一整条线就白做了）。
// 扩槽**不改变**任何既有样式的编码：每个老样式仍然用同样的前几个槽位、发同样的序列，
// 新增的样式排在表尾，见 tui_sgr_into。（P46 又添了 3 个 markdown 样式，槽数与排布不变。）
const TUI_SGR16_LEN: usize = 192;     // TUI_SGR16 / TUI_SGR256 的元素个数（= TUI_ST_COUNT * 8）
const TUI_SGR16: [i32: 192] = [
    -1, -1, -1, -1, -1, -1, -1, -1,   // DEFAULT
    2, -1, -1, -1, -1, -1, -1, -1,    // DIM
    1, -1, -1, -1, -1, -1, -1, -1,    // BOLD
    34, -1, -1, -1, -1, -1, -1, -1,   // ACCENT
    32, -1, -1, -1, -1, -1, -1, -1,   // OK
    31, -1, -1, -1, -1, -1, -1, -1,   // ERR
    33, -1, -1, -1, -1, -1, -1, -1,   // WARN
    1, 37, -1, -1, -1, -1, -1, -1,    // USER
    -1, -1, -1, -1, -1, -1, -1, -1,   // ASSIST
    37, -1, -1, -1, -1, -1, -1, -1,   // TOOL
    32, -1, -1, -1, -1, -1, -1, -1,   // ADD
    31, -1, -1, -1, -1, -1, -1, -1,   // DEL
    2, 37, -1, -1, -1, -1, -1, -1,    // CODE
    36, -1, -1, -1, -1, -1, -1, -1,   // INLINE
    2, -1, -1, -1, -1, -1, -1, -1,    // HINT
    2, -1, -1, -1, -1, -1, -1, -1,    // FOOTER
    7, 1, -1, -1, -1, -1, -1, -1,     // SEL（反显 + 粗）
    42, 30, -1, -1, -1, -1, -1, -1,   // ADD_BG（绿底黑字）
    41, 30, -1, -1, -1, -1, -1, -1,   // DEL_BG（红底黑字）
    42, 1, 97, -1, -1, -1, -1, -1,    // ADD_HL（亮绿底 + 粗 + 亮白字）
    41, 1, 97, -1, -1, -1, -1, -1,    // DEL_HL（亮红底 + 粗 + 亮白字）
    1, 34, -1, -1, -1, -1, -1, -1,    // H1（粗 + 蓝）
    3, -1, -1, -1, -1, -1, -1, -1,    // ITALIC（斜）
    9, -1, -1, -1, -1, -1, -1, -1,    // STRIKE（删除线）
];

const TUI_SGR256: [i32: 192] = [
    -1, -1, -1, -1, -1, -1, -1, -1,   // DEFAULT
    2, 38, 5, 245, -1, -1, -1, -1,    // DIM
    1, -1, -1, -1, -1, -1, -1, -1,    // BOLD
    38, 5, 33, -1, -1, -1, -1, -1,    // ACCENT
    38, 5, 42, -1, -1, -1, -1, -1,    // OK
    38, 5, 203, -1, -1, -1, -1, -1,   // ERR
    38, 5, 214, -1, -1, -1, -1, -1,   // WARN
    1, 38, 5, 255, -1, -1, -1, -1,    // USER
    -1, -1, -1, -1, -1, -1, -1, -1,   // ASSIST
    38, 5, 250, -1, -1, -1, -1, -1,   // TOOL
    38, 5, 42, -1, -1, -1, -1, -1,    // ADD
    38, 5, 203, -1, -1, -1, -1, -1,   // DEL
    2, 38, 5, 245, -1, -1, -1, -1,    // CODE
    38, 5, 180, -1, -1, -1, -1, -1,   // INLINE
    2, -1, -1, -1, -1, -1, -1, -1,    // HINT
    2, 38, 5, 240, -1, -1, -1, -1,    // FOOTER
    7, 1, -1, -1, -1, -1, -1, -1,     // SEL（反显 + 粗）
    // P36：底色用 22/52（深绿/深红）与 88/124（亮绿/亮红），8 位 256 色 xterm 立方体里
    // 这两档在明暗主题下都还能看清前景（前景一律给亮白 231 / 亮字 15，不靠终端默认前景）
    38, 5, 231, 48, 5, 22, -1, -1,    // ADD_BG（亮白字 + 深绿底）
    38, 5, 231, 48, 5, 52, -1, -1,    // DEL_BG（亮白字 + 深红底）
    38, 5, 231, 1, 48, 5, 88, -1,     // ADD_HL（亮白粗字 + 亮绿底）
    38, 5, 231, 1, 48, 5, 124, -1,    // DEL_HL（亮白粗字 + 亮红底）
    // P46：markdown 三档。H1 用 45（青蓝，比 ACCENT 的 33 更「标题」）；斜体/删除线
    // 只发属性，颜色交给所在行的 base 色，这样标题里的斜体不会丢掉标题色。
    1, 38, 5, 45, -1, -1, -1, -1,     // H1（粗 + 青蓝）
    3, -1, -1, -1, -1, -1, -1, -1,    // ITALIC（斜）
    9, -1, -1, -1, -1, -1, -1, -1,    // STRIKE（删除线）
];

// ESC 序列全部用数组字面量（踩坑 22：`&"字面量"[a:b]` 会生成切片描述符强转 → 乱码）
const TUI_SEQ_RESET: [byte: 4] = [27, 91, 48, 109];            // ESC[0m
const TUI_SEQ_EL: [byte: 4] = [27, 91, 50, 75];                // ESC[2K
const TUI_SEQ_CLEAR: [byte: 7] = [27, 91, 50, 74, 27, 91, 72]; // ESC[2J ESC[H
const TUI_SEQ_SHOW_CUR: [byte: 6] = [27, 91, 63, 50, 53, 104]; // ESC[?25h
const TUI_SEQ_HIDE_CUR: [byte: 6] = [27, 91, 63, 50, 53, 108]; // ESC[?25l

// ============================================================
// 帧模型
//
//   一行 = 若干段 (style, len)，段在同一行内首尾相接；
//   所有行的段按行序拼在 g_tui_segs 里，行表只记本行的段区间。
//   emit 时把每行编码成「带 SGR 的字节串」，与上一帧逐行比较，只重发变化的行。
// ============================================================

const TUI_MAX_ROWS: usize = 256;
const TUI_MAX_SEGS: usize = 8192;
const TUI_COLS_MIN: usize = 32;
const TUI_ROWS_MIN: usize = 8;
const TUI_LOGO_COLS: usize = 66;      // 低于这个宽度不画块字 logo

struct TuiSeg {
    style: u8,
    len: usize,
}

struct TuiRow {
    seg_start: usize,
    seg_n: usize,
    text_off: usize,
}

// 屏幕（当前帧）
var g_tui_text: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_segs: [TuiSeg: TUI_MAX_SEGS] = [TuiSeg{ style: 0, len: 0 }: TUI_MAX_SEGS];
var g_tui_nsegs: usize = 0;
var g_tui_rowtab: [TuiRow: TUI_MAX_ROWS] = [TuiRow{ seg_start: 0, seg_n: 0, text_off: 0 }: TUI_MAX_ROWS];
var g_tui_nrows: usize = 0;
var g_tui_cur_seg: usize = 0;         // 当前行的起始段号
var g_tui_cur_style: u8 = 255;        // 当前行最后一个段的样式（255 = 还没有段）

// emit（当前帧 / 上一帧的逐行字节串）
var g_tui_out: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_out_off: [usize: TUI_MAX_ROWS + 1] = [0: TUI_MAX_ROWS + 1];
var g_tui_prev: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_prev_off: [usize: TUI_MAX_ROWS + 1] = [0: TUI_MAX_ROWS + 1];
var g_tui_prev_nrows: usize = 0;
var g_tui_dirty: bool = true;

// 终端
var g_tui_on: bool = false;           // TUI 是否在跑（帧会打到 out_fd）
var g_tui_out_fd: i32 = -1;
var g_tui_cols: usize = 80;
var g_tui_rows: usize = 24;
var g_tui_color_on: bool = true;
var g_tui_color256: bool = true;
var g_tui_frames: usize = 0;
// 踩坑 72：鼠标上报开关。默认开 —— 滚轮要靠它（见下面 TUI_MOUSE_ON 的长注释）。
// 但它有个代价：终端只要把鼠标交给我们，**自己的拖选/复制就没了**（左键按下/拖动
// 全部变成 `ESC[<b;x;yM` 事件灌给我们），用户在 uya-agent 的 TUI 里就「不能复制文本」。
// 所以它必须是可关的：关掉之后终端重新接管拖选（滚轮随之不再翻转录，见 §16 踩坑 72）。
var g_tui_mouse: bool = true;
var g_tui_headless: bool = false;   // 自测：不碰终端、不读 fd 0，按键由 tui_keys_inject 注入
// 自测专用：headless 下「注入的键用完了」= 这一轮脚本演完了。它**不等于**用户按了 ctrl+d：
//   * 主循环 / 审批浮层的等待（tui_confirm_wait）拿它收工（「没人回答」→ 一律拒绝）；
//   * 但**不能**当成中断/退出意图（否则每个 headless 回合一开头就被自己的脚本掐死）。
// 这两个语义以前挤在同一个 g_tui_quit 里，P22 把 headless 的读流中断打开之后就炸了。
var g_tui_headless_done: bool = false;

// 开/关 headless（自测用：不碰终端、不读 fd 0）。只改这一位，不动 g_tui_on / out_fd，
// 要「逻辑上在跑但不碰终端」请用 tui_headless_enable。
export fn tui_set_headless(on: bool) void {
    g_tui_headless = on;
}

// 自测：让 TUI「逻辑上在跑」但不碰终端（tui_active() 为真 → 显示进转录；flush 因为
// out_fd < 0 而自动不写）
export fn tui_headless_enable(on: bool) void {
    g_tui_headless = on;
    g_tui_on = on;
    g_tui_out_fd = -1;
    tui_invalidate();
}

// 当前是否 headless（读 g_tui_headless 一位）。注意它**不代表**用户按了 ctrl+d，
// 见上面 g_tui_headless_done 的语义说明。
export fn tui_headless() bool {
    return g_tui_headless;
}

// 注入按键（自测用）：只喂字节，**不**冲刷悬着的 ESC（模拟被切开的转义序列）
export fn tui_keys_feed(p: &const byte, n: usize) void {
    tui_key_feed(p, n);
    tui_handle_keys();
}

// 注入按键 + 冲刷（一次完整的按键交互）
export fn tui_keys_inject(p: &const byte, n: usize) void {
    tui_key_feed(p, n);
    tui_key_flush_esc();
    tui_handle_keys();
}

// 已画出的帧数计数（tui_frame_count 只读它）。自测拿它当「画了几帧」的节流判据。
export fn tui_frame_count() usize {
    return g_tui_frames;
}

// 「有一帧等着被画」吗（只读）。自测用它钉「改动了显示状态的东西必须置脏」这条不变量。
// ⚠ 它**只在真终端下有意义**：headless 的 `tui_flush` 因为 `out_fd < 0` 当场早退，
// 脏位永远清不掉 ⇒ 这个判据在 headless 里恒为真（`tui-marquee` 的 F 段三次假绿都栽在
// 这一点上，最后靠 G 段的真 PTY 才钉住）。
export fn tui_dirty_pending() bool {
    return g_tui_dirty;
}

// TUI 是否在跑（g_tui_on）。显示层据此决定「进转录还是直接写终端」。
export fn tui_active() bool {
    return g_tui_on;
}

// 帧输出用的**私有** fd（启动时 sys_dup(1) 得到的副本；-1 = 不写）。
export fn tui_out_fd() i32 {
    return g_tui_out_fd;
}

// 画布列数（真实运行时由 TIOCGWINSZ 填；拼帧一律按这个宽度算显示列）。
export fn tui_cols() usize {
    return g_tui_cols;
}

// 画布行数（同上，真实运行时由 TIOCGWINSZ 填）。
export fn tui_rows() usize {
    return g_tui_rows;
}

// 自测 / --tui-demo 用：直接设定画布尺寸（真实运行时由 TIOCGWINSZ 填）
export fn tui_set_size(cols: usize, rows: usize) void {
    if cols > 0 {
        g_tui_cols = cols;
    }
    if rows > 0 {
        g_tui_rows = rows;
    }
    tui_invalidate();
}

// 置脏：下一帧必须重画（emit 侧据此决定要不要比对/输出）。
export fn tui_mark_dirty() void {
    g_tui_dirty = true;
}


// 选 SGR 表：on=是否上色，color256=16 色还是 256 色一套（TUI_SGR16 / TUI_SGR256）。
export fn tui_set_color(on: bool, color256: bool) void {
    g_tui_color_on = on;
    g_tui_color256 = color256;
}

// 毫秒时钟：走 libc.syscall 的 sys_gettimeofday（**不用 extern "libc" gettimeofday**，
// 那会把 libc.time 模块也拉进链接，而 0.10 的 libc.time 与 libc.stdlib 都定义了
// CLOCKS_PER_SEC，split-C 下会「multiple definition」直接链接失败）
//
// `tv` 必须声明成 **libc 的 `TimeVal`**，不能自造一个同布局的结构体：split-C 下
// 自造结构体是另一个 C 类型（`struct TuiTimeVal`），传给 `libc_sys_gettimeofday
// (struct TimeVal *)` 是 C 的 incompatible pointer type —— GCC 14 起这是**错误**
// 而非警告，直接编译失败（踩坑 131）。
export fn tui_now_ms() u64 {
    var tv: TimeVal = TimeVal{ tv_sec: 0, tv_usec: 0 };
    const r: !i32 = sys_gettimeofday(&tv, null as &void);
    const rc: i32 = r catch { -1; };
    if rc != 0 {
        return 0 as u64;
    }
    return ((tv.tv_sec as u64) * (1000 as u64)) + ((tv.tv_usec as u64) / (1000 as u64));
}

// 惰性分配三个帧缓冲（正文 64 KiB / 当前帧与上一帧各 128 KiB），已分配则不动。
// 幂等：可以在每帧开头无脑调用（tui_frame_begin 就是这么干的）。
fn tui_bufs_ensure() void {
    if !buf_valid(&g_tui_text) {
        g_tui_text = buf_new(65536);
    }
    if !buf_valid(&g_tui_out) {
        g_tui_out = buf_new(131072);
    }
    if !buf_valid(&g_tui_prev) {
        g_tui_prev = buf_new(131072);
    }
}


// ============================================================
// 拼帧基元（都按显示列前进）
// ============================================================

// 开一帧：保证缓冲已分配，把正文 / 段表 / 行表 / 当前行游标复位（不置脏、不碰终端）。
// cols / rows 传 0 表示沿用上一次的尺寸（真实运行的尺寸由 TIOCGWINSZ 填）。
export fn tui_frame_begin(cols: usize, rows: usize) void {
    tui_bufs_ensure();
    buf_reset(&g_tui_text);
    g_tui_nsegs = 0;
    g_tui_nrows = 0;
    g_tui_cur_seg = 0;
    g_tui_cur_style = 255;
    // P75：推一格帧序号 —— 跑马灯只推进「最近这一帧真画过」的槽位（见 tui_marquee_tick）
    g_tui_mq_serial = g_tui_mq_serial + 1;
    if cols > 0 {
        g_tui_cols = cols;
    }
    if rows > 0 {
        g_tui_rows = rows;
    }
}

// 开一行（行内容随后用 tui_put 追加）
export fn tui_row_new() void {
    if g_tui_nrows >= TUI_MAX_ROWS {
        return;
    }
    const r: usize = g_tui_nrows;
    var row: TuiRow = TuiRow{ seg_start: g_tui_nsegs, seg_n: 0, text_off: g_tui_text.len };
    g_tui_rowtab[r] = row;
    g_tui_nrows = r + 1;
    g_tui_cur_seg = g_tui_nsegs;
    g_tui_cur_style = 255;
}

// 往当前行追加 n 字节、挂上 style。**相邻同样式合并成一个 seg**（不新增段），
// 段表满（TUI_MAX_SEGS）则只丢段、正文照旧 —— 少一点颜色，不许丢字。
// 没开行（g_tui_nrows == 0）或 n == 0 直接返回。
export fn tui_put(p: &const byte, n: usize, style: u8) void {
    if n == 0 || g_tui_nrows == 0 {
        return;
    }
    if !buf_append(&g_tui_text, p, n) {
        return;
    }
    if g_tui_cur_style == style && g_tui_nsegs > g_tui_cur_seg {
        const last: usize = g_tui_nsegs - 1;
        if last < TUI_MAX_SEGS {
            g_tui_segs[last].len = g_tui_segs[last].len + n;
        }
    } else if g_tui_nsegs < TUI_MAX_SEGS {
        g_tui_segs[g_tui_nsegs] = TuiSeg{ style: style, len: n };
        g_tui_nsegs = g_tui_nsegs + 1;
        g_tui_cur_style = style;
    }
    const r: usize = g_tui_nrows - 1;
    if r < TUI_MAX_ROWS {
        g_tui_rowtab[r].seg_n = g_tui_nsegs - g_tui_rowtab[r].seg_start;
    }
}

// tui_put 的以 NUL 结尾版本（长度当场量）。字符串里**不许含 NUL**。
export fn tui_puts(s: &const byte, style: u8) void {
    tui_put(s, bufx_cstr_len(s), style);
}

// 当前行已占多少**显示列**
export fn tui_row_cols() usize {
    if g_tui_nrows == 0 {
        return 0;
    }
    const r: usize = g_tui_nrows - 1;
    if r >= TUI_MAX_ROWS {
        return 0;
    }
    const off: usize = g_tui_rowtab[r].text_off;
    return tty_cols_between(g_tui_text.ptr as &const byte, off, g_tui_text.len);
}

// 补空格到第 col 列（col <= 当前列时什么都不做）
export fn tui_pad_to(col: usize) void {
    var cur: usize = tui_row_cols();
    while cur < col {
        tui_put(" " as &const byte, 1, TUI_ST_DEFAULT);
        cur = cur + 1;
    }
}

// 同上，但补白用指定样式（P36：/diff 的整行底色要连留白一起铺，否则底色会断开）
export fn tui_pad_to_styled(col: usize, style: u8) void {
    var cur: usize = tui_row_cols();
    while cur < col {
        tui_put(" " as &const byte, 1, style);
        cur = cur + 1;
    }
}

// 把当前行补满到宽度 cols（用默认样式填空白）
export fn tui_fill_row(cols: usize) void {
    tui_pad_to(cols);
}


// ============================================================
// P75：放不下的文本 —— 跑马灯
//
// 纪律：一个格子里放不下的**单行文本**不就地截断，而是按时间闸门一列一列滚，
// 把整条露出来。装得下时与之前**逐字节相同**（一个 `…` 都不加），所以这条改动
// 在「没溢出」的屏上零影响。
//
// 为什么偏移要集中存：`tui_put_clipped` 有几十个调用点，各存一份就等于「谁忘了
// 存谁不滚」；而同一个格子在不同帧里可能走不同分支（浮层开着/关着、选中/未选中），
// 只有把身份放进**槽位**才能跨帧把一个格子和它的偏移对上。
//
// 槽位是**稳定身份**，不是行号：固定界面元素（脚注 cwd / 状态行 / 信息行 / 标题栏…）
// 各占一个常量；列表那种「同一个格子换内容」的用 `基址 + 行号` 派生。
// 槽位表满了就退化成「不滚」（照旧截断）—— 少滚一条，不丢字、不越界。
//
// **不是所有截断都该滚**（刻意排除，各有各的正确语义）：
//   * 转录正文与 reader 正文：已经按窗口宽度折好行了，这里的 `tui_put_clipped`
//     只是安全网，正常永远不触发；
//   * 思考实时行：它是**尾部锚定**的（只显示最新一段，DSH `latestLine` 同口径），
//     滚起来等于把「最新」这条语义弄丢；
//   * 输入行：里面是用户正在编辑的文本，光标在哪就得看到哪，滚它等于跟用户抢视口；
//   * `/diff` 的单元格：那有**自己的**横向滚动（←/→），两套机制会打架。
// ============================================================

// 一列/步的时间闸门与两端停留（≈2.5 列/秒，端点停 1.6 s）。
// 用**时间**而不是「每帧一列」：帧率跟着负载走，那样速度会飘。
const TUI_MQ_STEP_MS: u64 = 400;
const TUI_MQ_HOLD: usize = 4;

// P76：钉住段之后**至少**留给滑动段的窗口（显示列）。低于这个数就不钉、整行滑 ——
// 钉完只剩一个 `…` 的窗口，等于把这一行变成「命令名 + 省略号」的死行（永远读不到说明）。
const TUI_MQ_PIN_MIN: usize = 8;

// 槽位表容量与固定槽号（0..23 给固定元素，24..63 给列表/选项那种「按行派生」的）。
const TUI_MQ_SLOTS: usize = 64;
const TUI_MQ_LIST_BASE: usize = 24;

export const TUI_MQ_FOOT: usize = 0;       // 脚注 cwd 段
export const TUI_MQ_STATUS: usize = 1;     // 常驻状态区第 1 行
export const TUI_MQ_INFO: usize = 2;       // 面板信息行的「模型 + 提供方」
export const TUI_MQ_OV_TITLE: usize = 3;   // 浮层标题栏
export const TUI_MQ_OV_GLOSS: usize = 4;   // 浮层选中项说明
export const TUI_MQ_TASKS_BASE: usize = 8; // 常驻任务块（8..19，块最多 12 行）

struct TuiMarquee {
    key: u64,          // 头部指纹：变了 = 这个格子换了内容 → 偏移归零
    off: usize,        // 当前偏移（显示列）
    maxoff: usize,     // 最近一帧算出的偏移上限（0 = 装得下，不必滚）
    hold: usize,       // 端点停留计数
    ms: u64,           // 上次推进时刻
    serial: u64,       // 最近一次绘制的帧序号（没被画的槽位不许推着屏幕脏）
    used: bool,
}

var g_tui_mq: [TuiMarquee: TUI_MQ_SLOTS] = [TuiMarquee{
    key: 0, off: 0, maxoff: 0, hold: 0, ms: 0, serial: 0, used: false
}: TUI_MQ_SLOTS];
// 帧序号与「上一帧序号」：tui_frame_begin 推一格。tick 只推进 serial 落在最近一帧的
// 槽位 —— 否则一个已经被关掉的浮层标题会永远转下去，每 400 ms 白置一次脏。
var g_tui_mq_serial: u64 = 1;

// 头部指纹：长度 + 前 16 字节（FNV-1a）。只取头部是有意的 ——
// 状态行/任务块这类文本的**尾部**每秒都在变（已运行多久），把尾部算进去会让偏移
// 每秒归零一次、永远滚不过开头；而「头 16 字节 + 长度」相同就意味着窗口起点的内容
// 没变，此时保留偏移正是对的。
fn tui_mq_key(p: &const byte, n: usize) u64 {
    var h: u64 = (n as u64) + (14695981039346656037 as u64);
    var k: usize = 0;
    while k < n && k < 16 {
        h = (h ^ (p[k] as u64)) * (1099511628211 as u64);
        k = k + 1;
    }
    return h;
}

// 认领槽位：指纹与上次不同就归零重滚；顺带记下「这一帧画过它」。
//
// 槽位下标在这里夹进表内 —— 调用方给的都是常量槽或「基址 + 行号」（行号 < 12），
// 正常不会越界；夹一次是防呆。**索引安全证明只认紧邻的比较**（抽成返回下标的函数
// 就证不出来了），所以状态读写都收在这几个小函数里，调用方只传槽号。
//
// 指纹**只用头部**：状态行、任务块那类文本的尾部每秒都在变（已运行多久），
// 把尾部算进去等于每秒归零一次、永远滚不过开头；而头部相同就意味着「这一格还是
// 同一条东西」，保留偏移正是要的。文本变短时上限会跟着缩（见 tui_mq_set_max），
// 不会画出界。
fn tui_mq_touch(slot: usize, p: &const byte, n: usize) void {
    if slot >= TUI_MQ_SLOTS {
        return;
    }
    const key: u64 = tui_mq_key(p, n);
    if !g_tui_mq[slot].used || g_tui_mq[slot].key != key {
        g_tui_mq[slot] = TuiMarquee{
            key: key, off: 0, maxoff: 0, hold: 0, ms: 0,
            serial: g_tui_mq_serial, used: true
        };
    }
    g_tui_mq[slot].serial = g_tui_mq_serial;
}

// 记下这一格的偏移上限；maxoff == 0（装得下 / 整段让位）顺带把偏移清回起点。
fn tui_mq_set_max(slot: usize, maxoff: usize) void {
    if slot >= TUI_MQ_SLOTS {
        return;
    }
    g_tui_mq[slot].maxoff = maxoff;
    if maxoff == 0 || g_tui_mq[slot].off > maxoff {
        g_tui_mq[slot].off = maxoff;
    }
}

// 当前偏移（越界读作 0，即「从头开始」）。
fn tui_mq_off(slot: usize) usize {
    if slot >= TUI_MQ_SLOTS {
        return 0;
    }
    return g_tui_mq[slot].off;
}

// P76：算出这一行该**钉住**多少显示列（0 = 不钉，整行滑）。
//
// 为什么要有这一条：命令行那种「命令名 + 说明」的行，整行滑到后半段之后，屏幕上就
// 认不出这是哪条命令了（用户口径：「只滚动选中那一行的说明文本」）。钉住段 = 文本里
// 第一个「连续 ≥2 个空格」**连同这个空白段**之前的部分 —— 命令表（`/help  显示帮助`）、
// 会话表（标题 + 2 空格 + 工作区 + 2 空格 + id）、子代理清单都用这个分列口径；把空白段
// 留在钉住段里，滚出来的才是「名字 + 间隔 + `…` + 说明」，而不是名字贴着省略号。
//
// 返回的是钉住段的**显示列数**（不是字节数）：列数才是窗口预算的单位。没有这样的
// 分界（比如一条会话标题里就带两个空格，或整行是一句话）时返回 0 —— 那时钉不出
// 「名字」来，整行滑反而是对的。钉完留给滑动的窗口不足 TUI_MQ_PIN_MIN 列时也返回 0：
// 那种窗口里只剩 `…`，等于把这一行变成死行。
fn tui_mq_pin_cols(p: &const byte, n: usize, win: usize) usize {
    var i: usize = 0;
    var run: usize = 0;            // 当前这个空白段里已数的空格数
    while i < n {
        if p[i] == 32 as byte {
            run = run + 1;
            if run >= 2 {
                const c: usize = tty_cols_between(p, 0, i + 1);
                if c + TUI_MQ_PIN_MIN <= win {
                    return c;
                }
                return 0;
            }
        } else {
            run = 0;
        }
        i = i + 1;
    }
    return 0;
}

// 画一段单行文本：装得下照画，装不下按该槽位的偏移滚动。win 是可用显示列。
// 三条出口都**恰好**占满预算（多一列就会顶掉右边那一列间隔，踩过 `cpu 37%1 轮 · 12 步`）：
//   * 装得下：整段照画（与 P75 之前逐字节相同，一个 `…` 都不加）；
//   * off == 0：头部裁到 win-1 列 + 尾随 `…`（tui_put_clipped 自己补那个省略号）；
//   * off > 0：跳过 off 列 → 前导 `…` → 到尾了整画，否则再裁一列补尾随 `…`。
export fn tui_marquee_put(slot: usize, p: &const byte, n: usize, win: usize,
    style: u8) void {
    tui_mq_draw(slot, p, n, win, style, 0);
}

// 「不滚」的那一档：按预算静态截断（放不下时补尾随 `…`，且**不超**预算 —— 给省略号
// 留的那一列要算在预算里，否则右边框会被顶出去，踩坑 42 那一族）。
// 浮层正文（diff.uya 的 tui_ov_put_clipped）与簇里的非选中行共用这一份实现。
fn tui_mq_static(p: &const byte, n: usize, max_cols: usize, style: u8) void {
    if max_cols == 0 {
        return;
    }
    var budget: usize = max_cols;
    if max_cols > 1 && tty_clip_bytes(p, n, max_cols) < n {
        budget = max_cols - 1;
    }
    tui_put_clipped(p, n, budget, style);
}

// P76：**簇**（一格一条、有光标的一组行）里的第 i 行 —— 只有选中项滚，且钉住命令名列。
//
// 「簇」与单元素（脚注 cwd / 状态行 / 浮层标题…）的区别在这里收口：
//   * `sel == false`：**不滚**，静态截断 + 尾随 `…`（= P75 之前的形态），并把槽位停掉 ——
//     否则光标移走之后它还接着上一次的偏移，看起来像「位置错乱」；
//   * `sel == true`：滚，但先按 tui_mq_pin_cols 钉住第一列（命令名 / 会话标题），
//     只滑后面的说明；钉住段照画，滚动只发生在后半段。
//
// 为什么非要把「不一起滚」写进这一层：面板里 23 条命令有 11 条放不下，同一个 400 ms
// 时钟、同相位一起左移 ⇒ 整张面板集体抖，读不成（用户报的「命令窗口的命令不要一起滚动」）。
export fn tui_marquee_put_row(slot: usize, p: &const byte, n: usize, win: usize,
    style: u8, sel: bool) void {
    if !sel {
        tui_marquee_stop(slot);
        tui_mq_static(p, n, win, style);
        return;
    }
    const pin: usize = tui_mq_pin_cols(p, n, win);
    tui_mq_draw(slot, p, n, win, style, pin);
}

// 两个入口共用的核心。pin > 0 时：前 pin 列**照画不动**，只把剩下那段当成一条独立的
// 单行文本滚（窗口 = win - pin）。滚动上限因此与钉不钉无关（总列数与窗口同减 pin）——
// 「滚得到尾」这条老判据不受影响。
fn tui_mq_draw(slot: usize, p: &const byte, n: usize, win: usize, style: u8,
    pin: usize) void {
    if win == 0 {
        tui_marquee_stop(slot);
        return;
    }
    if pin > 0 && pin < win {
        const skip: usize = tty_clip_bytes(p, n, pin);   // 钉住段的字节数
        tui_put(p, skip, style);
        tui_mq_draw(slot, &p[skip], n - skip, win - pin, style, 0);
        return;
    }
    const cols: usize = tty_cols_between(p, 0, n);
    tui_mq_touch(slot, p, n);
    if cols <= win {
        // 装得下：与 P75 之前逐字节相同，且这一格不再参与滚动
        tui_mq_set_max(slot, 0);
        tui_put(p, n, style);
        return;
    }
    if win <= 1 {
        // 只有一列：滚不动（窗口里只放得下一个 `…`），照旧截断
        tui_mq_set_max(slot, 0);
        tui_put_clipped(p, n, win, style);
        return;
    }
    // 滚到「只剩 win-1 列 + 前导 `…`」为止：再往后滚窗口里就只剩省略号了
    tui_mq_set_max(slot, cols - win + 1);
    const off: usize = tui_mq_off(slot);
    if off == 0 {
        tui_put_clipped(p, n, win - 1, style);
        return;
    }
    const skip: usize = tty_clip_bytes(p, n, off);
    tui_puts("…" as &const byte, style);
    const rest: usize = n - skip;
    if rest == 0 {
        return;
    }
    if cols - off <= win - 1 {
        tui_put(&p[skip], rest, style);       // 已经滚到尾：不补尾随 `…`
        return;
    }
    tui_put_clipped(&p[skip], rest, win - 2, style);
}

// 滚动的时钟闸门（由 tui_tick 每帧调）。返回 true = 有槽位的偏移真动了。
//
// ⚠ **推进了就自己置脏**：`tui_render()` 有自己的 `g_tui_dirty` 闸门，光把返回值交给
// `tui_tick` 的 `need` 是不够的 —— 帧率节流那几关过了之后还会在 `!g_tui_dirty` 上
// 早退。漏掉这一句的现场是「路径确实夹到 30 列了，但一个字节都不滚」
// （自测当时直接调 `tui_build()`，绕过了脏闸门，所以没看见 —— 见 §19 P75 的补记）。
//
// 节奏：**中间每步走一列**（`TUI_MQ_STEP_MS` = 400ms ⇒ 2.5 列/秒），**只在两端停**
// `TUI_MQ_HOLD` 步。第一版把停留加在了**每一列**之后 ⇒ 实际 2 秒/列，一条 45 列的
// worktree 路径要走 90 秒，用户看到的还是「不滚」（本轮实测：真 PTY 25 秒只挪了 5 列）。
// 到达两端时置停留，停留数完再走：头部也停一次（刚显示出来先让人看清开头）。
//
// 只推进**最近一帧画过**的槽位：没画的槽位（浮层关了、块收起了）不该让屏幕一直脏。
export fn tui_marquee_tick(now_ms: u64) bool {
    var moved: bool = false;
    var i: usize = 0;
    while i < TUI_MQ_SLOTS {
        if g_tui_mq[i].used && g_tui_mq[i].maxoff > 0
            && g_tui_mq[i].serial == g_tui_mq_serial {
            if now_ms == 0 {
                i = i + 1;
                continue;
            }
            if g_tui_mq[i].ms == 0 {
                // 第一次看到这一格：记时刻 + 先在头部停一段（不当场推进）
                g_tui_mq[i].ms = now_ms;
                g_tui_mq[i].hold = TUI_MQ_HOLD;
            } else if now_ms >= g_tui_mq[i].ms + TUI_MQ_STEP_MS {
                g_tui_mq[i].ms = now_ms;
                if g_tui_mq[i].hold > 0 {
                    g_tui_mq[i].hold = g_tui_mq[i].hold - 1;   // 端点停留中
                } else if g_tui_mq[i].off >= g_tui_mq[i].maxoff {
                    g_tui_mq[i].off = 0;                      // 到尾了：回头部
                    g_tui_mq[i].hold = TUI_MQ_HOLD;
                    moved = true;
                } else {
                    g_tui_mq[i].off = g_tui_mq[i].off + 1;
                    if g_tui_mq[i].off >= g_tui_mq[i].maxoff {
                        g_tui_mq[i].hold = TUI_MQ_HOLD;       // 刚到尾部：停一段
                    }
                    moved = true;
                }
            }
        }
        i = i + 1;
    }
    if moved {
        tui_mark_dirty();
    }
    return moved;
}

// 停掉一个槽位的滚动（这一格这一帧没画 / 整段让位了）：偏移与上限一起清掉。
// 不清的话下一次它再上屏会从中间接着滚 —— 用户看到的是「刚显示出来就已经滚过头了」。
export fn tui_marquee_stop(slot: usize) void {
    if slot >= TUI_MQ_SLOTS {
        return;   // 防呆：越界槽位没有状态可清
    }
    g_tui_mq[slot].off = 0;
    g_tui_mq[slot].maxoff = 0;
    g_tui_mq[slot].hold = 0;
    g_tui_mq[slot].ms = 0;
    g_tui_mq[slot].serial = 0;
}

// 把所有滚动偏移清回起点（自测复位 / 换工作区这类「台面换了」的场合）。
export fn tui_marquee_reset() void {
    var i: usize = 0;
    while i < TUI_MQ_SLOTS {
        g_tui_mq[i].used = false;
        g_tui_mq[i].off = 0;
        g_tui_mq[i].maxoff = 0;
        g_tui_mq[i].hold = 0;
        g_tui_mq[i].ms = 0;
        g_tui_mq[i].serial = 0;
        i = i + 1;
    }
}

// 一段纯文本按显示列截断（超出补 '…'）
export fn tui_put_clipped(p: &const byte, n: usize, max_cols: usize, style: u8) void {
    if max_cols == 0 {
        return;
    }
    const keep: usize = tty_clip_bytes(p, n, max_cols);
    tui_put(p, keep, style);
    if keep < n {
        tui_puts("…" as &const byte, style);
    }
}

// 尾部对齐截断（P18）：保留**最后** max_cols 列，被截断时前面补 '…'。
// 与 DSH 的 ReasoningRow `latestLine` 同口径（视口贴右端 → 屏幕上是左边被吃掉）。
// 硬约束：输出**绝不超过** max_cols 列（帧里「每行显示列 ≤ cols」是自测逐行断言的不变量）。
export fn tui_put_clipped_tail(p: &const byte, n: usize, max_cols: usize, style: u8) void {
    if max_cols == 0 || n == 0 {
        return;
    }
    if max_cols == 1 {
        tui_puts("…" as &const byte, style);   // 只有一列：只能表示「这里被截断了」
        return;
    }
    const keep: usize = tty_clip_tail_bytes(p, n, max_cols - 1);   // 给前置 '…' 留一列
    if keep < n {
        tui_puts("…" as &const byte, style);
    }
    if keep > 0 {
        tui_put(&p[n - keep], keep, style);
    }
}

// 取一行文本（含该行起点的字节偏移）
fn tui_row_text_off(r: usize) usize {
    if r >= TUI_MAX_ROWS {
        return 0;
    }
    if r >= g_tui_nrows {
        return 0;
    }
    return g_tui_rowtab[r].text_off;
}

// 把**单字节**字形写到第 r 行的第 col 列（原字节必须已经是空格/超宽字符的尾字节）。
// 为什么是单字节：g_tui_text 是所有行共用的正文缓冲，多字节字形会改变后面行的
// 偏移（P25 的滚动指示只需要一个方向标记，用 `^` / `v` 即可原地覆盖）。
fn tui_row_put_col(r: usize, col: usize, ch: byte) void {
    if r >= g_tui_nrows || col == 0 {
        return;
    }
    const off: usize = tui_row_text_off(r);
    const end: usize = if r + 1 >= g_tui_nrows { g_tui_text.len } else { tui_row_text_off(r + 1) };
    if off >= end {
        return;
    }
    var j: usize = off;
    while j < end && g_tui_text.ptr[j] != 10 as byte {
        const nx: usize = tty_utf8_next(g_tui_text.ptr as &const byte, j, end);
        const c0: usize = tty_cols_between(g_tui_text.ptr as &const byte, off, j);
        const c1: usize = tty_cols_between(g_tui_text.ptr as &const byte, off, nx);
        if c1 <= col {
            j = nx;
            continue;
        }
        if c0 == col && c1 == col + 1 {
            g_tui_text.ptr[j] = ch;   // 正好一列宽，原地覆盖
        }
        return;   // 列落在宽字符中间/超出 → 放弃（少一个箭头，不是错误）
    }
}

// 往段表尾部追加一段（dst = 目标下标，返回新的 dst）。段表满就原样返回 ——
// 少一段颜色，不许丢字、不许越界（与 tui_put 的段表满了同一个口径）。
//
// 为什么单独抽一个函数：证明器只认「正的 if 里做索引」，而在 `tui_row_mark_span`
// 那个循环里 dst 每轮都在动、还挂在 if 链上，索引安全证不出来
// （实测报错「循环中的变量不能移动」）。抽出来之后这里的下标是一次性的形参。
fn tui_seg_append(dst: usize, style: u8, len: usize) usize {
    if len == 0 || dst >= TUI_MAX_SEGS {
        return dst;
    }
    g_tui_segs[dst] = TuiSeg{ style: style, len: len };
    return dst + 1;
}

// 把第 r 行 [col0, col1) 显示列的字节段**改挂**成 style（原地改段表，不动正文）。
// P85 的拖选高亮走它：选区是屏幕坐标，而段表是按字节切的 —— 所以要先把列区间
// 换算成「字节区间落在哪几段上」，再把这几个段切开重挂。
//
// 三条纪律：
//   ① **绝不改 g_tui_text** —— 只改段表的 (style, len)，正文层与 P85 之前逐字节相同
//      （行宽/折行/擦除全按显示列算，动正文会把这些一起弄坏）；
//   ② 区间端点落在宽字符中间时**向外取整**（整字高亮，不切半个汉字）；
//   ③ 段表满了（TUI_MAX_SEGS）就只改能改的段 —— 少一点高亮，不许丢字、不许越界。
export fn tui_row_mark_span(r: usize, col0: usize, col1: usize,
                            style: u8) void {
    if r >= g_tui_nrows || col1 <= col0 || r >= TUI_MAX_ROWS {
        return;
    }
    const off: usize = tui_row_text_off(r);
    const len: usize = tui_row_text_len(r);
    if len == 0 {
        return;
    }
    const b0: usize = tui_row_col_byte0(off, len, col0);
    const b1: usize = tui_row_col_byte1(off, len, col1);
    if b1 <= b0 {
        return;
    }
    const old_start: usize = g_tui_rowtab[r].seg_start;
    const old_n: usize = g_tui_rowtab[r].seg_n;
    // 重挂：本行的段重写一份到段表**尾部**（旧段留着不动 —— 原地切开要挪后面所有行，
    // 而段表是定长数组、行内首尾相接）。一次重挂最多把每段切成 3 段。
    var dst: usize = g_tui_nsegs;
    const head: usize = dst;
    var cur: usize = off;
    var n_new: usize = 0;
    var i: usize = 0;
    while i < old_n {
        const si: usize = old_start + i;
        i = i + 1;
        // 证明器只认「正的 if 里做索引」（§16 踩坑 6）：写成 `if si >= MAX { break; }`
        // 再取 `g_tui_segs[si]` 证不出安全性，必须把那次索引放进正向分支里。
        if si < TUI_MAX_SEGS {
            const seg: TuiSeg = g_tui_segs[si];
            const s0: usize = cur;
            const s1: usize = cur + seg.len;
            cur = s1;
            // 分三段算：与选区不相交的整段 / 相交段的前半+选中段+后半
            var w0: usize = 0;
            var w1: usize = 0;
            var w2: usize = 0;
            if s1 <= b0 || s0 >= b1 {
                w0 = seg.len;
            } else {
                // ⚠ 这两个 min/max 必须写成 var + if 语句，**不能**写成
                // `const cut0: usize = if a > b { a } else { b };` —— 在这种嵌套层级上
                // codegen 会产出 `const size_t x; if ... { x = a; }`，GCC 14 直接报
                // 「assignment of read-only variable」（实测踩坑：编译期才炸，check 是绿的）。
                var cut0: usize = s0;
                if b0 > s0 {
                    cut0 = b0;
                }
                var cut1: usize = s1;
                if b1 < s1 {
                    cut1 = b1;
                }
                w0 = cut0 - s0;
                w1 = cut1 - cut0;
                w2 = s1 - cut1;
            }
            dst = tui_seg_append(dst, seg.style, w0);
            dst = tui_seg_append(dst, style, w1);
            dst = tui_seg_append(dst, seg.style, w2);
        }
    }
    n_new = dst - head;
    if n_new == 0 {
        return;             // 段表满 / 本行没有段：一个字节都没落，保持原样
    }
    g_tui_rowtab[r].seg_start = head;
    g_tui_rowtab[r].seg_n = n_new;
    g_tui_nsegs = dst;
}

// 行内 [off, off+len) 里「第 col 显示列」对应的**左端点**字节偏移 —— **向外取整**：
// 落在宽字符中间时返回该字符的**起点**（宁可整字选中，也不切半个汉字）。
// col 超过行宽时返回行尾。
export fn tui_row_col_byte0(off: usize, len: usize, col: usize) usize {
    const end: usize = off + len;
    var j: usize = off;
    while j < end {
        const tp: &const byte = g_tui_text.ptr as &const byte;
        const nx: usize = tty_utf8_next(tp, j, end);
        const c1: usize = tty_cols_between(tp, off, nx);
        if c1 > col {
            return j;
        }
        j = nx;
    }
    return end;
}

// 同上的**右端点**：第 col 列之后那个字节偏移 —— 落在宽字符中间时返回该字符的**终点**。
// 与 `tui_row_col_byte0` 配对，两头都向外取整 ⇒ 区间端点永远不会落在一个宽字符中间
// （「只选一列却切出半个汉字」那个缺陷的修法）。
export fn tui_row_col_byte1(off: usize, len: usize, col: usize) usize {
    const end: usize = off + len;
    var j: usize = off;
    while j < end {
        const tp: &const byte = g_tui_text.ptr as &const byte;
        const nx: usize = tty_utf8_next(tp, j, end);
        const c0: usize = tty_cols_between(tp, off, j);
        if c0 >= col {
            return j;
        }
        j = nx;
    }
    return end;
}

// 当前行已写了多少**字节**（末行 = 正文尾 − 本行起点）。O(1)：只做减法，不扫行。
// 注意这是字节数，不是显示列 —— 要列数用 tui_row_cols / tui_row_cols_at。
fn tui_row_text_len(r: usize) usize {
    if r + 1 >= g_tui_nrows {
        return g_tui_text.len - tui_row_text_off(r);
    }
    return tui_row_text_off(r + 1) - tui_row_text_off(r);
}

// 第 r 行的**显示列**数：对 [行起点, 行尾) 逐字符求和 tty_char_cols。
// O(行长) —— 只在这一个行上扫（不是 O(全缓冲)），所以按行对齐/裁剪可以放心调用。
fn tui_row_cols_at(r: usize) usize {
    const off: usize = tui_row_text_off(r);
    const len: usize = tui_row_text_len(r);
    return tty_cols_between(g_tui_text.ptr as &const byte, off, off + len);
}
