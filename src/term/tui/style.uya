// src/term/tui/style.uya — 全屏 TUI（P17）：样式 / 帧模型 / 拼帧基元
//
// 本文件：SGR 常量与样式表、帧模型（TuiSeg / TuiRow）、按**显示列**前进的拼帧基元。
// 不变量（三条硬约束，被这个项目的历史教育过）：
//   ① 所有 SGR 序列都用 `[byte: N]` 数组字面量或逐字节拼，**绝不用 `&"字面量"[a:b]`**
//      —— 那会生成「切片描述符地址 → char*」强转，屏幕上是乱码（README 踩坑 22）；
//   ② 正文层（g_tui_text / 行文本）里**不允许出现 ESC**，宽度/换行/擦除全按显示列算；
//   ③ 帧写到启动时 `sys_dup(1)` 的私有 fd（tls_noise_mute 会把 fd 2 重定向到 /dev/null）。
// 依赖：foundation/bufx、term/tty。
// 命名：本目录统一 `tui_` / `TUI_` 前缀（uya 没有闭包，且模块级名字全局合并）。

use libc.syscall;
use libc.unistd;
use libc.heap;

// ============================================================
// 样式
// ============================================================

export const TUI_ST_DEFAULT: u8 = 0;
export const TUI_ST_DIM: u8 = 1;
export const TUI_ST_BOLD: u8 = 2;
export const TUI_ST_ACCENT: u8 = 3;
export const TUI_ST_OK: u8 = 4;
export const TUI_ST_ERR: u8 = 5;
export const TUI_ST_WARN: u8 = 6;
export const TUI_ST_USER: u8 = 7;
export const TUI_ST_ASSIST: u8 = 8;
export const TUI_ST_TOOL: u8 = 9;
export const TUI_ST_ADD: u8 = 10;
export const TUI_ST_DEL: u8 = 11;
export const TUI_ST_CODE: u8 = 12;
export const TUI_ST_INLINE: u8 = 13;
export const TUI_ST_HINT: u8 = 14;
export const TUI_ST_FOOTER: u8 = 15;
export const TUI_ST_SEL: u8 = 16;
// P36：/diff 的改动底色。整行铺底（*_BG）用暗底，行内变化片段（*_HL）再亮一档 ——
// 「哪几行改了」与「这一行里哪几个字改了」是两件事，各给一档。
export const TUI_ST_ADD_BG: u8 = 17;     // 整行新增（深绿底）
export const TUI_ST_DEL_BG: u8 = 18;     // 整行删除（深红底）
export const TUI_ST_ADD_HL: u8 = 19;     // 行内新增片段（亮绿底）
export const TUI_ST_DEL_HL: u8 = 20;     // 行内删除片段（亮红底）
// P46：markdown 渲染多出来的三档。**排在表尾**，老样式的编码一个字节都不动
// （`--tui-demo` 的既有快照因此仍逐字节可比，只有正文那一屏按 P46 的新排版变）。
export const TUI_ST_H1: u8 = 21;         // 一级标题（粗 + 强调色）
export const TUI_ST_ITALIC: u8 = 22;     // *斜体* / _斜体_
export const TUI_ST_STRIKE: u8 = 23;     // ~~删除线~~（靠终端的 SGR 9）
export const TUI_ST_COUNT: usize = 24;

// 每个样式最多 8 个 SGR 参数（-1 = 跳过）；[style * 8 + slot]
// 16 色一套、256 色一套 —— 由 g_tui_color256 选。
//
// P36 把每样式的参数槽从 4 扩到 8：256 色的「亮前景 + 显式背景」是 `38;5;N;48;5;M`
// 六个参数，4 个槽位装不下（会被静默截断成只有前景 —— 背景色这一整条线就白做了）。
// 扩槽**不改变**任何既有样式的编码：每个老样式仍然用同样的前几个槽位、发同样的序列，
// 新增的样式排在表尾，见 tui_sgr_into。（P46 又添了 3 个 markdown 样式，槽数与排布不变。）
const TUI_SGR16_LEN: usize = 192;     // TUI_SGR16 / TUI_SGR256 的元素个数（= TUI_ST_COUNT * 8）
const TUI_SGR16: [i32: 192] = [
    -1, -1, -1, -1, -1, -1, -1, -1,   // DEFAULT
    2, -1, -1, -1, -1, -1, -1, -1,    // DIM
    1, -1, -1, -1, -1, -1, -1, -1,    // BOLD
    34, -1, -1, -1, -1, -1, -1, -1,   // ACCENT
    32, -1, -1, -1, -1, -1, -1, -1,   // OK
    31, -1, -1, -1, -1, -1, -1, -1,   // ERR
    33, -1, -1, -1, -1, -1, -1, -1,   // WARN
    1, 37, -1, -1, -1, -1, -1, -1,    // USER
    -1, -1, -1, -1, -1, -1, -1, -1,   // ASSIST
    37, -1, -1, -1, -1, -1, -1, -1,   // TOOL
    32, -1, -1, -1, -1, -1, -1, -1,   // ADD
    31, -1, -1, -1, -1, -1, -1, -1,   // DEL
    2, 37, -1, -1, -1, -1, -1, -1,    // CODE
    36, -1, -1, -1, -1, -1, -1, -1,   // INLINE
    2, -1, -1, -1, -1, -1, -1, -1,    // HINT
    2, -1, -1, -1, -1, -1, -1, -1,    // FOOTER
    7, 1, -1, -1, -1, -1, -1, -1,     // SEL（反显 + 粗）
    42, 30, -1, -1, -1, -1, -1, -1,   // ADD_BG（绿底黑字）
    41, 30, -1, -1, -1, -1, -1, -1,   // DEL_BG（红底黑字）
    42, 1, 97, -1, -1, -1, -1, -1,    // ADD_HL（亮绿底 + 粗 + 亮白字）
    41, 1, 97, -1, -1, -1, -1, -1,    // DEL_HL（亮红底 + 粗 + 亮白字）
    1, 34, -1, -1, -1, -1, -1, -1,    // H1（粗 + 蓝）
    3, -1, -1, -1, -1, -1, -1, -1,    // ITALIC（斜）
    9, -1, -1, -1, -1, -1, -1, -1,    // STRIKE（删除线）
];

const TUI_SGR256: [i32: 192] = [
    -1, -1, -1, -1, -1, -1, -1, -1,   // DEFAULT
    2, 38, 5, 245, -1, -1, -1, -1,    // DIM
    1, -1, -1, -1, -1, -1, -1, -1,    // BOLD
    38, 5, 33, -1, -1, -1, -1, -1,    // ACCENT
    38, 5, 42, -1, -1, -1, -1, -1,    // OK
    38, 5, 203, -1, -1, -1, -1, -1,   // ERR
    38, 5, 214, -1, -1, -1, -1, -1,   // WARN
    1, 38, 5, 255, -1, -1, -1, -1,    // USER
    -1, -1, -1, -1, -1, -1, -1, -1,   // ASSIST
    38, 5, 250, -1, -1, -1, -1, -1,   // TOOL
    38, 5, 42, -1, -1, -1, -1, -1,    // ADD
    38, 5, 203, -1, -1, -1, -1, -1,   // DEL
    2, 38, 5, 245, -1, -1, -1, -1,    // CODE
    38, 5, 180, -1, -1, -1, -1, -1,   // INLINE
    2, -1, -1, -1, -1, -1, -1, -1,    // HINT
    2, 38, 5, 240, -1, -1, -1, -1,    // FOOTER
    7, 1, -1, -1, -1, -1, -1, -1,     // SEL（反显 + 粗）
    // P36：底色用 22/52（深绿/深红）与 88/124（亮绿/亮红），8 位 256 色 xterm 立方体里
    // 这两档在明暗主题下都还能看清前景（前景一律给亮白 231 / 亮字 15，不靠终端默认前景）
    38, 5, 231, 48, 5, 22, -1, -1,    // ADD_BG（亮白字 + 深绿底）
    38, 5, 231, 48, 5, 52, -1, -1,    // DEL_BG（亮白字 + 深红底）
    38, 5, 231, 1, 48, 5, 88, -1,     // ADD_HL（亮白粗字 + 亮绿底）
    38, 5, 231, 1, 48, 5, 124, -1,    // DEL_HL（亮白粗字 + 亮红底）
    // P46：markdown 三档。H1 用 45（青蓝，比 ACCENT 的 33 更「标题」）；斜体/删除线
    // 只发属性，颜色交给所在行的 base 色，这样标题里的斜体不会丢掉标题色。
    1, 38, 5, 45, -1, -1, -1, -1,     // H1（粗 + 青蓝）
    3, -1, -1, -1, -1, -1, -1, -1,    // ITALIC（斜）
    9, -1, -1, -1, -1, -1, -1, -1,    // STRIKE（删除线）
];

// ESC 序列全部用数组字面量（踩坑 22：`&"字面量"[a:b]` 会生成切片描述符强转 → 乱码）
const TUI_SEQ_RESET: [byte: 4] = [27, 91, 48, 109];            // ESC[0m
const TUI_SEQ_EL: [byte: 4] = [27, 91, 50, 75];                // ESC[2K
const TUI_SEQ_CLEAR: [byte: 7] = [27, 91, 50, 74, 27, 91, 72]; // ESC[2J ESC[H
const TUI_SEQ_SHOW_CUR: [byte: 6] = [27, 91, 63, 50, 53, 104]; // ESC[?25h
const TUI_SEQ_HIDE_CUR: [byte: 6] = [27, 91, 63, 50, 53, 108]; // ESC[?25l

// ============================================================
// 帧模型
//
//   一行 = 若干段 (style, len)，段在同一行内首尾相接；
//   所有行的段按行序拼在 g_tui_segs 里，行表只记本行的段区间。
//   emit 时把每行编码成「带 SGR 的字节串」，与上一帧逐行比较，只重发变化的行。
// ============================================================

const TUI_MAX_ROWS: usize = 256;
const TUI_MAX_SEGS: usize = 8192;
const TUI_COLS_MIN: usize = 32;
const TUI_ROWS_MIN: usize = 8;
const TUI_LOGO_COLS: usize = 66;      // 低于这个宽度不画块字 logo

struct TuiSeg {
    style: u8,
    len: usize,
}

struct TuiRow {
    seg_start: usize,
    seg_n: usize,
    text_off: usize,
}

// 屏幕（当前帧）
var g_tui_text: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_segs: [TuiSeg: TUI_MAX_SEGS] = [TuiSeg{ style: 0, len: 0 }: TUI_MAX_SEGS];
var g_tui_nsegs: usize = 0;
var g_tui_rowtab: [TuiRow: TUI_MAX_ROWS] = [TuiRow{ seg_start: 0, seg_n: 0, text_off: 0 }: TUI_MAX_ROWS];
var g_tui_nrows: usize = 0;
var g_tui_cur_seg: usize = 0;         // 当前行的起始段号
var g_tui_cur_style: u8 = 255;        // 当前行最后一个段的样式（255 = 还没有段）

// emit（当前帧 / 上一帧的逐行字节串）
var g_tui_out: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_out_off: [usize: TUI_MAX_ROWS + 1] = [0: TUI_MAX_ROWS + 1];
var g_tui_prev: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_prev_off: [usize: TUI_MAX_ROWS + 1] = [0: TUI_MAX_ROWS + 1];
var g_tui_prev_nrows: usize = 0;
var g_tui_dirty: bool = true;

// 终端
var g_tui_on: bool = false;           // TUI 是否在跑（帧会打到 out_fd）
var g_tui_out_fd: i32 = -1;
var g_tui_cols: usize = 80;
var g_tui_rows: usize = 24;
var g_tui_color_on: bool = true;
var g_tui_color256: bool = true;
var g_tui_frames: usize = 0;
// 踩坑 72：鼠标上报开关。默认开 —— 滚轮要靠它（见下面 TUI_MOUSE_ON 的长注释）。
// 但它有个代价：终端只要把鼠标交给我们，**自己的拖选/复制就没了**（左键按下/拖动
// 全部变成 `ESC[<b;x;yM` 事件灌给我们），用户在 uya-agent 的 TUI 里就「不能复制文本」。
// 所以它必须是可关的：关掉之后终端重新接管拖选（滚轮随之不再翻转录，见 README 踩坑 72）。
var g_tui_mouse: bool = true;
var g_tui_headless: bool = false;   // 自测：不碰终端、不读 fd 0，按键由 tui_keys_inject 注入
// 自测专用：headless 下「注入的键用完了」= 这一轮脚本演完了。它**不等于**用户按了 ctrl+d：
//   * 主循环 / 审批浮层的等待（tui_confirm_wait）拿它收工（「没人回答」→ 一律拒绝）；
//   * 但**不能**当成中断/退出意图（否则每个 headless 回合一开头就被自己的脚本掐死）。
// 这两个语义以前挤在同一个 g_tui_quit 里，P22 把 headless 的读流中断打开之后就炸了。
var g_tui_headless_done: bool = false;

export fn tui_set_headless(on: bool) void {
    g_tui_headless = on;
}

// 自测：让 TUI「逻辑上在跑」但不碰终端（tui_active() 为真 → 显示进转录；flush 因为
// out_fd < 0 而自动不写）
export fn tui_headless_enable(on: bool) void {
    g_tui_headless = on;
    g_tui_on = on;
    g_tui_out_fd = -1;
    tui_invalidate();
}

export fn tui_headless() bool {
    return g_tui_headless;
}

// 注入按键（自测用）：只喂字节，**不**冲刷悬着的 ESC（模拟被切开的转义序列）
export fn tui_keys_feed(p: &const byte, n: usize) void {
    tui_key_feed(p, n);
    tui_handle_keys();
}

// 注入按键 + 冲刷（一次完整的按键交互）
export fn tui_keys_inject(p: &const byte, n: usize) void {
    tui_key_feed(p, n);
    tui_key_flush_esc();
    tui_handle_keys();
}

export fn tui_frame_count() usize {
    return g_tui_frames;
}

export fn tui_active() bool {
    return g_tui_on;
}

export fn tui_out_fd() i32 {
    return g_tui_out_fd;
}

export fn tui_cols() usize {
    return g_tui_cols;
}

export fn tui_rows() usize {
    return g_tui_rows;
}

// 自测 / --tui-demo 用：直接设定画布尺寸（真实运行时由 TIOCGWINSZ 填）
export fn tui_set_size(cols: usize, rows: usize) void {
    if cols > 0 {
        g_tui_cols = cols;
    }
    if rows > 0 {
        g_tui_rows = rows;
    }
    tui_invalidate();
}

export fn tui_mark_dirty() void {
    g_tui_dirty = true;
}


export fn tui_set_color(on: bool, color256: bool) void {
    g_tui_color_on = on;
    g_tui_color256 = color256;
}

export struct TuiTimeVal {
    tv_sec: i64,
    tv_usec: i64,
}

// 毫秒时钟：走 libc.syscall 的 sys_gettimeofday（**不用 extern "libc" gettimeofday**，
// 那会把 libc.time 模块也拉进链接，而 0.10 的 libc.time 与 libc.stdlib 都定义了
// CLOCKS_PER_SEC，split-C 下会「multiple definition」直接链接失败）
export fn tui_now_ms() u64 {
    var tv: TuiTimeVal = TuiTimeVal{ tv_sec: 0, tv_usec: 0 };
    const r: !i32 = sys_gettimeofday(&tv, null as &void);
    const rc: i32 = r catch { -1; };
    if rc != 0 {
        return 0 as u64;
    }
    return ((tv.tv_sec as u64) * (1000 as u64)) + ((tv.tv_usec as u64) / (1000 as u64));
}

fn tui_bufs_ensure() void {
    if !buf_valid(&g_tui_text) {
        g_tui_text = buf_new(65536);
    }
    if !buf_valid(&g_tui_out) {
        g_tui_out = buf_new(131072);
    }
    if !buf_valid(&g_tui_prev) {
        g_tui_prev = buf_new(131072);
    }
}


// ============================================================
// 拼帧基元（都按显示列前进）
// ============================================================

export fn tui_frame_begin(cols: usize, rows: usize) void {
    tui_bufs_ensure();
    buf_reset(&g_tui_text);
    g_tui_nsegs = 0;
    g_tui_nrows = 0;
    g_tui_cur_seg = 0;
    g_tui_cur_style = 255;
    if cols > 0 {
        g_tui_cols = cols;
    }
    if rows > 0 {
        g_tui_rows = rows;
    }
}

// 开一行（行内容随后用 tui_put 追加）
export fn tui_row_new() void {
    if g_tui_nrows >= TUI_MAX_ROWS {
        return;
    }
    const r: usize = g_tui_nrows;
    var row: TuiRow = TuiRow{ seg_start: g_tui_nsegs, seg_n: 0, text_off: g_tui_text.len };
    g_tui_rowtab[r] = row;
    g_tui_nrows = r + 1;
    g_tui_cur_seg = g_tui_nsegs;
    g_tui_cur_style = 255;
}

export fn tui_put(p: &const byte, n: usize, style: u8) void {
    if n == 0 || g_tui_nrows == 0 {
        return;
    }
    if !buf_append(&g_tui_text, p, n) {
        return;
    }
    if g_tui_cur_style == style && g_tui_nsegs > g_tui_cur_seg {
        const last: usize = g_tui_nsegs - 1;
        if last < TUI_MAX_SEGS {
            g_tui_segs[last].len = g_tui_segs[last].len + n;
        }
    } else if g_tui_nsegs < TUI_MAX_SEGS {
        g_tui_segs[g_tui_nsegs] = TuiSeg{ style: style, len: n };
        g_tui_nsegs = g_tui_nsegs + 1;
        g_tui_cur_style = style;
    }
    const r: usize = g_tui_nrows - 1;
    if r < TUI_MAX_ROWS {
        g_tui_rowtab[r].seg_n = g_tui_nsegs - g_tui_rowtab[r].seg_start;
    }
}

export fn tui_puts(s: &const byte, style: u8) void {
    tui_put(s, bufx_cstr_len(s), style);
}

// 当前行已占多少**显示列**
export fn tui_row_cols() usize {
    if g_tui_nrows == 0 {
        return 0;
    }
    const r: usize = g_tui_nrows - 1;
    if r >= TUI_MAX_ROWS {
        return 0;
    }
    const off: usize = g_tui_rowtab[r].text_off;
    return tty_cols_between(g_tui_text.ptr as &const byte, off, g_tui_text.len);
}

// 补空格到第 col 列（col <= 当前列时什么都不做）
export fn tui_pad_to(col: usize) void {
    var cur: usize = tui_row_cols();
    while cur < col {
        tui_put(" " as &const byte, 1, TUI_ST_DEFAULT);
        cur = cur + 1;
    }
}

// 同上，但补白用指定样式（P36：/diff 的整行底色要连留白一起铺，否则底色会断开）
export fn tui_pad_to_styled(col: usize, style: u8) void {
    var cur: usize = tui_row_cols();
    while cur < col {
        tui_put(" " as &const byte, 1, style);
        cur = cur + 1;
    }
}

// 把当前行补满到宽度 cols（用默认样式填空白）
export fn tui_fill_row(cols: usize) void {
    tui_pad_to(cols);
}


// 一段纯文本按显示列截断（超出补 '…'）
export fn tui_put_clipped(p: &const byte, n: usize, max_cols: usize, style: u8) void {
    if max_cols == 0 {
        return;
    }
    const keep: usize = tty_clip_bytes(p, n, max_cols);
    tui_put(p, keep, style);
    if keep < n {
        tui_puts("…" as &const byte, style);
    }
}

// 尾部对齐截断（P18）：保留**最后** max_cols 列，被截断时前面补 '…'。
// 与 DSH 的 ReasoningRow `latestLine` 同口径（视口贴右端 → 屏幕上是左边被吃掉）。
// 硬约束：输出**绝不超过** max_cols 列（帧里「每行显示列 ≤ cols」是自测逐行断言的不变量）。
export fn tui_put_clipped_tail(p: &const byte, n: usize, max_cols: usize, style: u8) void {
    if max_cols == 0 || n == 0 {
        return;
    }
    if max_cols == 1 {
        tui_puts("…" as &const byte, style);   // 只有一列：只能表示「这里被截断了」
        return;
    }
    const keep: usize = tty_clip_tail_bytes(p, n, max_cols - 1);   // 给前置 '…' 留一列
    if keep < n {
        tui_puts("…" as &const byte, style);
    }
    if keep > 0 {
        tui_put(&p[n - keep], keep, style);
    }
}

// 取一行文本（含该行起点的字节偏移）
fn tui_row_text_off(r: usize) usize {
    if r >= TUI_MAX_ROWS {
        return 0;
    }
    if r >= g_tui_nrows {
        return 0;
    }
    return g_tui_rowtab[r].text_off;
}

// 把**单字节**字形写到第 r 行的第 col 列（原字节必须已经是空格/超宽字符的尾字节）。
// 为什么是单字节：g_tui_text 是所有行共用的正文缓冲，多字节字形会改变后面行的
// 偏移（P25 的滚动指示只需要一个方向标记，用 `^` / `v` 即可原地覆盖）。
fn tui_row_put_col(r: usize, col: usize, ch: byte) void {
    if r >= g_tui_nrows || col == 0 {
        return;
    }
    const off: usize = tui_row_text_off(r);
    const end: usize = if r + 1 >= g_tui_nrows { g_tui_text.len } else { tui_row_text_off(r + 1) };
    if off >= end {
        return;
    }
    var j: usize = off;
    while j < end && g_tui_text.ptr[j] != 10 as byte {
        const nx: usize = tty_utf8_next(g_tui_text.ptr as &const byte, j, end);
        const c0: usize = tty_cols_between(g_tui_text.ptr as &const byte, off, j);
        const c1: usize = tty_cols_between(g_tui_text.ptr as &const byte, off, nx);
        if c1 <= col {
            j = nx;
            continue;
        }
        if c0 == col && c1 == col + 1 {
            g_tui_text.ptr[j] = ch;   // 正好一列宽，原地覆盖
        }
        return;   // 列落在宽字符中间/超出 → 放弃（少一个箭头，不是错误）
    }
}

fn tui_row_text_len(r: usize) usize {
    if r + 1 >= g_tui_nrows {
        return g_tui_text.len - tui_row_text_off(r);
    }
    return tui_row_text_off(r + 1) - tui_row_text_off(r);
}

fn tui_row_cols_at(r: usize) usize {
    const off: usize = tui_row_text_off(r);
    const len: usize = tui_row_text_len(r);
    return tty_cols_between(g_tui_text.ptr as &const byte, off, off + len);
}
