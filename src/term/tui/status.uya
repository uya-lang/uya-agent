// src/term/tui/status.uya — 全屏 TUI：会话状态 / 常驻状态区 / 输入面板 / logo
//
// 本文件：输入面板正上方的**常驻状态区**（P18：运行中 1–2 行、空闲 0 行）、脚注
//   （左 `~/cwd:branch`、右 token 用量 + 版本）、面板要显示的状态字段，以及空态居中的
//   块字 logo 与输入面板（左边缘强调竖条、占位行、模式/模型行）。
// 不变量：状态区整块出现或整块消失，不留半行；logo 是**定宽块字**，宽度按 TUI_LOGO_* 算。
// 依赖：style、session/stats、vcs/gitx。
// 命名：本目录统一 `tui_` / `TUI_` 前缀（uya 没有闭包，模块级名字全局合并）。

use libc.syscall;
use libc.unistd;
use libc.heap;

// ============================================================
// 会话状态（面板信息行 / 脚注 / 状态）
// ============================================================

export const TUI_RUN_IDLE: u8 = 0;
export const TUI_RUN_THINK: u8 = 1;
export const TUI_RUN_STREAM: u8 = 2;
export const TUI_RUN_TOOL: u8 = 3;

var g_tui_model: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_provider: Buf = Buf{ ptr: null, len: 0, cap: 0 };
// P37：推理强度（脚注里挂一小段；空 = 这一小段不画）
var g_tui_effort: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_cwd: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_branch: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_home: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_version: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_run_label: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_plan: bool = false;
var g_tui_access: u8 = PERM_FULL_ACCESS;   // P21：当前访问模式（chip 显示用）

// 访问模式 chip 的样式：只读=安全色、工作区写=默认、全权=警示色（一眼能看出放宽了）
fn tui_access_style(m: u8) u8 {
    if m == PERM_READ_ONLY {
        return TUI_ST_OK;
    }
    if m == PERM_FULL_ACCESS {
        return TUI_ST_WARN;
    }
    return TUI_ST_DEFAULT;
}

// 信息行的键位提示：够宽才带访问模式那一段，退短版，再不够就不画（返回空串）。
// need = 模式之后还要塞下的东西：芯片 + 3 空格 + 至少 8 列模型名 + 提示 + 2 列间隔。
fn tui_info_row_hint(end: usize, after_mode: usize, alen: usize, model_w: usize) &const byte {
    const long_hint: &const byte = "tab plan   shift+tab access   ctrl+p commands" as &const byte;
    const short_hint: &const byte = "tab plan   ctrl+p commands" as &const byte;
    // 长版要求「模型名完整显示」；短版只要求给模型留 8 列（宁可裁模型名也要留下 tab 提示）
    const need_full: usize = after_mode + alen + 3 + model_w;
    const need_min: usize = after_mode + alen + 11;
    if end > need_full + bufx_cstr_len(long_hint) + 2 {
        return long_hint;
    }
    if end > need_min + bufx_cstr_len(short_hint) + 2 {
        return short_hint;
    }
    return "" as &const byte;
}
var g_tui_run: u8 = TUI_RUN_IDLE;
// P38：进入「跑工具」状态的时刻（墙上毫秒），状态行用它显示已运行时长（见 tui_set_run）
var g_tui_run_since_ms: u64 = 0;
var g_tui_step: i32 = 0;
// P18：脚注右半区是「整个会话的统计行」（由 agent 侧算好喂进来），左半区是
// 上下文占用、进程 CPU 与进程内存（-1 = 不可用，字段直接省略）
var g_tui_stats: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_ctx_pct: i32 = -1;
var g_tui_cpu_pct: i32 = -1;
var g_tui_mem_kb: i64 = -1;
var g_tui_spin: usize = 0;

// P22：常驻任务块（文本由 tasks.uya 生成；这里只拉取 + 画，重建在 tasks_tick/工具结果之后）
var g_tui_tasks: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_tasks_n: usize = 0;          // 行数（0 = 不画，布局与 P22 之前逐字节相同）

// 惰性分配状态区用到的各缓冲（任务块 / 模型 / 提供方 / 强度 / cwd / 分支 / home / 版本 / 运行标签 / 统计），幂等。
fn tui_state_ensure() void {
    if !buf_valid(&g_tui_tasks) { g_tui_tasks = buf_new(16384); }
    if !buf_valid(&g_tui_model) { g_tui_model = buf_empty(); }
    if !buf_valid(&g_tui_provider) { g_tui_provider = buf_empty(); }
    if !buf_valid(&g_tui_effort) { g_tui_effort = buf_empty(); }
    if !buf_valid(&g_tui_cwd) { g_tui_cwd = buf_empty(); }
    if !buf_valid(&g_tui_branch) { g_tui_branch = buf_empty(); }
    if !buf_valid(&g_tui_home) { g_tui_home = buf_empty(); }
    if !buf_valid(&g_tui_version) { g_tui_version = buf_empty(); }
    if !buf_valid(&g_tui_run_label) { g_tui_run_label = buf_empty(); }
    if !buf_valid(&g_tui_stats) { g_tui_stats = buf_empty(); }
}

var g_tui_state_ready: bool = false;

// 开机初始化：钉下模型名 / 提供方 / 版本号三段状态文本（长度显式传入，调用方不许少给）。
export fn tui_state_init(model: &const byte, ml: usize, provider: &const byte, pl: usize, version: &const byte, vl: usize) void {
    tui_state_ensure();
    buf_reset(&g_tui_model);
    _ = buf_append(&g_tui_model, model, ml);
    buf_reset(&g_tui_provider);
    _ = buf_append(&g_tui_provider, provider, pl);
    buf_reset(&g_tui_version);
    _ = buf_append(&g_tui_version, version, vl);
    g_tui_state_ready = true;
}

// 设置当前工作目录与 home（脚注左半区把 cwd 缩成 `~/…` 显示；只存不置脏，由调用方决定）。
export fn tui_set_cwd(cwd: &const byte, n: usize, home: &const byte, hn: usize) void {
    tui_state_ensure();
    buf_reset(&g_tui_cwd);
    _ = buf_append(&g_tui_cwd, cwd, n);
    buf_reset(&g_tui_home);
    _ = buf_append(&g_tui_home, home, hn);
}

// 设置脚注里的当前 git 分支名（空串 = 不显示那一段）。
export fn tui_set_branch(b: &const byte, n: usize) void {
    tui_state_ensure();
    buf_reset(&g_tui_branch);
    _ = buf_append(&g_tui_branch, b, n);
}

// P37：运行中切模型/强度时刷新信息行（模型 + 提供方）。开机那次仍走 tui_state_init。
export fn tui_set_model(model: &const byte, ml: usize, provider: &const byte, pl: usize) void {
    tui_state_ensure();
    var same: bool = g_tui_model.len == ml && g_tui_provider.len == pl;
    if same {
        same = bufx_mem_eq(g_tui_model.ptr as &const byte, model, ml)
            && bufx_mem_eq(g_tui_provider.ptr as &const byte, provider, pl);
    }
    if same {
        return;
    }
    buf_reset(&g_tui_model);
    _ = buf_append(&g_tui_model, model, ml);
    buf_reset(&g_tui_provider);
    _ = buf_append(&g_tui_provider, provider, pl);
    tui_mark_dirty();
}

// P37：推理强度（脚注里追加 `· <强度>`；空串 = 不显示这一小段 —— 没公布档位就不装出有）。
export fn tui_set_effort(p: &const byte, n: usize) void {
    tui_state_ensure();
    if g_tui_effort.len == n && bufx_mem_eq(g_tui_effort.ptr as &const byte, p, n) {
        return;
    }
    buf_reset(&g_tui_effort);
    _ = buf_append(&g_tui_effort, p, n);
    tui_mark_dirty();
}


// 设置访问模式（PERM_*）；值真变了才标脏，供模式 chip 显示（只读=安全色 / 全权=警示色）。
export fn tui_set_access(m: u8) void {
    if g_tui_access != m {
        g_tui_access = m;
        tui_mark_dirty();
    }
}

// 当前访问模式（PERM_*）。
export fn tui_access() u8 {
    return g_tui_access;
}

// 设置 plan 模式开关（无条件标脏，chip 要跟着变）。
export fn tui_set_plan(on: bool) void {
    g_tui_plan = on;
    tui_mark_dirty();
}

// 当前是否在 plan 模式。
export fn tui_plan_on() bool {
    return g_tui_plan;
}

// 统计行（DSH StatsLine 的成品文本）。空串 = 没有可显示的统计，脚注右半区退回版本号。
export fn tui_set_stats(p: &const byte, n: usize) void {
    tui_state_ensure();
    var same: bool = false;
    if g_tui_stats.len == n {
        same = bufx_mem_eq(g_tui_stats.ptr as &const byte, p, n);
    }
    if same {
        return;
    }
    buf_reset(&g_tui_stats);
    _ = buf_append(&g_tui_stats, p, n);
    tui_mark_dirty();
}

// 设置上下文占用百分比（-1 = 不可用）；值没变就直接返回、不白重绘一帧。
export fn tui_set_ctx(ctx_pct: i32) void {
    if g_tui_ctx_pct == ctx_pct {
        return;
    }
    g_tui_ctx_pct = ctx_pct;
    tui_mark_dirty();
}

// demo / 自测的注入口（真实运行里由 tui_tick 里的 procx 采样刷新）
export fn tui_set_cpu(cpu_pct: i32) void {
    if g_tui_cpu_pct == cpu_pct {
        return;
    }
    g_tui_cpu_pct = cpu_pct;
    tui_mark_dirty();
}

// P24：内存合计（kB）；-1 = 不可用 → 字段整段省略。demo / 自测的注入口。
export fn tui_set_mem(mem_kb: i64) void {
    if g_tui_mem_kb == mem_kb {
        return;
    }
    g_tui_mem_kb = mem_kb;
    tui_mark_dirty();
}

// 设置当前 step 序号（状态行显示用）；无条件标脏。
export fn tui_set_step(step: i32) void {
    g_tui_step = step;
    tui_mark_dirty();
}

// 运行状态：idle / 思考中 / 流式中 / 跑工具（带一行标题）
// P38：进入「跑工具」的那一刻记一次起点（墙上毫秒）—— 状态行显示已运行多久，长命令不再
// 「看起来像卡死」（配合 shellx 的「停住即收口」：真卡住的命令现在会自己报错收工）。
export fn tui_set_run(kind: u8, label: &const byte, n: usize) void {
    tui_state_ensure();
    if kind == TUI_RUN_TOOL && g_tui_run != TUI_RUN_TOOL {
        g_tui_run_since_ms = tui_now_ms();
    }
    g_tui_run = kind;
    buf_reset(&g_tui_run_label);
    _ = buf_append(&g_tui_run_label, label, n);
    if kind == TUI_RUN_IDLE {
        tui_think_clear();          // 回合收口：实时思考行不许留到下一轮
    }
    tui_mark_dirty();
}

// 当前运行态（TUI_RUN_IDLE / THINK / STREAM / TOOL）。
export fn tui_run_kind() u8 {
    return g_tui_run;
}

// 转轮进一格（0..9 循环）；非 IDLE 时标脏（空闲时转轮不可见，不白重绘）。
export fn tui_tick_spinner() void {
    g_tui_spin = (g_tui_spin + 1) % (10 as usize);
    if g_tui_run != TUI_RUN_IDLE {
        tui_mark_dirty();
    }
}

// 8 帧的 braille 转轮（比 |/-\ 顺眼，也和 opencode 的等着感一致）
fn tui_spinner_glyph() &const byte {
    if g_tui_spin < 2 { return "⠋" as &const byte; }
    if g_tui_spin < 4 { return "⠙" as &const byte; }
    if g_tui_spin < 6 { return "⠹" as &const byte; }
    if g_tui_spin < 8 { return "⠸" as &const byte; }
    return "⠴" as &const byte;
}

// ============================================================
// 状态区（P18）：输入面板正上方的常驻区
//
//   ⠹ 思考中 · esc 中断                                   ← 第 1 行：spinner + 状态
//   ✻ 思考 · …核对 tui_build_chat 的视口夹取              ← 第 2 行：思考实时文本（只有它存在时才有）
//
// 为什么钉在面板上方而不是留在转录里：转录铺满视口时，原来那条「转录最后一行」的
// 状态行会被挤掉（`r < panel_top` 的判定），长会话里跑起来屏幕上**一个动的字节都没有** ——
// 于是一行一个（见 §16 踩坑 32）。
//
// 实时文本由 `view_think_live()` 喂（TUI 里默认开，与 `--show-reasoning` 无关：
// 后者只管「转录里的思考条目」）。这里只存**尾部一段**，画的时候按显示列从左边截断补 `…`。
// ============================================================

const TUI_THINK_TAIL: usize = 1024;      // 只留最新一段（与 P16「思考行只显示最新一段」同口径）
const TUI_THINK_PREFIX: &const byte = "✻ 思考 · " as &const byte;

var g_tui_think: Buf = Buf{ ptr: null, len: 0, cap: 0 };

// 惰性分配思考实时行缓冲（TUI_THINK_TAIL + 64 字节），幂等。
fn tui_think_ensure() void {
    if !buf_valid(&g_tui_think) {
        g_tui_think = buf_new(TUI_THINK_TAIL + 64);
    }
}

// 收到「最新一行思考」：清洗 → 只留尾部一段（从 UTF-8 首字节起，不劈半个汉字）→ 置脏。
// 不写终端：帧由既有的逐行 diff 重绘消费。
export fn tui_think_live(p: &const byte, n: usize) void {
    if n == 0 {
        return;
    }
    tui_think_ensure();
    if !buf_valid(&g_tui_think) {
        return;
    }
    var clean: Buf = buf_new(n + n / 2 + 32);
    if !buf_valid(&clean) {
        return;
    }
    tui_clean_into(&clean, p, n);
    // 这一行必须是**单行**：喂养方（view_think_live）本来就只给「最新一行」，
    // 但这里是公开 API，多行/以换行结尾的输入也得挡住 —— 行文本里混进 \n
    // 会把帧的「一行一段」结构冲掉（光标乱跳）。取最后一个 \n 之后那一段。
    var start: usize = 0;
    var k: usize = 0;
    while k < clean.len {
        if clean.ptr[k] == 10 as byte {
            start = k + 1;
        }
        k = k + 1;
    }
    var off: usize = start;
    if clean.len - start > TUI_THINK_TAIL {
        off = clean.len - TUI_THINK_TAIL;
        // 回退到 UTF-8 首字节（续字节 10xxxxxx 是半个字符）
        while off < clean.len && tty_is_cont(clean.ptr[off]) {
            off = off + 1;
        }
    }
    buf_reset(&g_tui_think);
    _ = buf_append(&g_tui_think, &clean.ptr[off], clean.len - off);
    buf_free(&clean);
    tui_mark_dirty();
}

// 收掉实时行（幂等；本来就是空的时候不置脏，免得每个 step 边界都白重绘一帧）
export fn tui_think_clear() void {
    if !buf_valid(&g_tui_think) || g_tui_think.len == 0 {
        return;
    }
    buf_reset(&g_tui_think);
    tui_mark_dirty();
}

// 思考实时行当前存了多少字节（0 = 没有第二行）。
export fn tui_think_len() usize {
    if !buf_valid(&g_tui_think) {
        return 0;
    }
    return g_tui_think.len;
}

// 思考行还剩多少列可画（扣掉左留白 + 前缀 + 右边距）
fn tui_think_avail() usize {
    const pre_cols: usize = tty_cols_between(TUI_THINK_PREFIX, 0, bufx_cstr_len(TUI_THINK_PREFIX));
    const used: usize = TUI_PREFIX_COL + pre_cols;
    if g_tui_cols > used + 3 {
        return g_tui_cols - used - 3;
    }
    return 0;
}

// 这一帧该不该画思考行（放不下前缀 + 几列文本就宁可不画，与 view_think_line 同口径）
fn tui_think_row_wanted() bool {
    return tui_think_len() > 0 && tui_think_avail() >= 8;
}

// P22：从 tasks.uya 拉最新文本（只 memcpy —— 重建在 tasks_tick / 工具结果之后，最密 1Hz）
fn tui_tasks_refresh() void {
    tui_state_ensure();
    tasks_latest(&g_tui_tasks);
    g_tui_tasks_n = 0;
    if g_tui_tasks.len == 0 {
        return;
    }
    var c: usize = 0;
    var i: usize = 0;
    while i < g_tui_tasks.len {
        if g_tui_tasks.ptr[i] == 10 as byte {
            c = c + 1;
        }
        i = i + 1;
    }
    if g_tui_tasks.ptr[g_tui_tasks.len - 1] != 10 as byte {
        c = c + 1;
    }
    g_tui_tasks_n = c;
}

// 任务块要几行（0 = 不画）
export fn tui_tasks_rows_n() usize {
    return g_tui_tasks_n;
}

// 状态区要几行：0 = 空闲（布局与 P18 之前完全一致）/ 1 = 只有状态行 / 2 = 加思考实时行
export fn tui_status_rows() usize {
    if g_tui_run == TUI_RUN_IDLE {
        return 0;
    }
    if tui_think_row_wanted() {
        return 2;
    }
    return 1;
}



// ============================================================
// logo（5 行块字 + 右移一列的阴影）
// ============================================================

// 每个字形 5 行 × 5 列，bit4 = 最左列
const TUI_GLYPHS: [u8: 8 * 5] = [
    0x11, 0x11, 0x11, 0x11, 0x0E,   // u
    0x11, 0x11, 0x0F, 0x01, 0x0E,   // y
    0x0E, 0x11, 0x1F, 0x11, 0x11,   // a
    0x00, 0x00, 0x1F, 0x00, 0x00,   // -
    0x0F, 0x11, 0x0F, 0x01, 0x0E,   // g
    0x0E, 0x11, 0x1F, 0x10, 0x0E,   // e
    0x16, 0x19, 0x11, 0x11, 0x11,   // n
    0x08, 0x1F, 0x08, 0x09, 0x06,   // t
];

// "uya-agent" → 字形下标
const TUI_WORD: [u8: 9] = [0, 1, 2, 3, 2, 4, 5, 6, 7];

const TUI_LOGO_H: usize = 5;
const TUI_LOGO_W: usize = 61;        // 9 字形 × 7 列 - 2（字形 5 列 + 2 列留白）
const TUI_LOGO_PAD: usize = 1;       // 阴影多一列

// 块字 logo 的总列数（字形宽 + 阴影那 1 列），布局用它居中。
export fn tui_logo_width() usize {
    return TUI_LOGO_W + TUI_LOGO_PAD;
}

// 块字 logo 的总行数（TUI_LOGO_H）。
export fn tui_logo_height() usize {
    return TUI_LOGO_H;
}

// 取 (字形序号 gi, 行 ro, 列 co) 那一格是否是亮的
fn tui_logo_bit(gi: usize, ro: usize, co: usize) bool {
    if gi >= 9 || ro >= 5 || co >= 5 {
        return false;
    }
    var gidx: usize = 0;
    if gi < 9 {
        gidx = TUI_WORD[gi] as usize;
    }
    var bits: u8 = 0;
    const bidx: usize = gidx * 5 + ro;
    if gidx < 8 && ro < 5 && bidx < 40 {
        bits = TUI_GLYPHS[bidx];
    }
    const shift: i32 = 4 - (co as i32);
    const v: u8 = (bits >> shift) & 1 as u8;
    return v == 1 as u8;
}

// 画一行 logo（5 行里的第 ro 行），列起点由调用方用 tui_pad_to 摆好
fn tui_logo_row(ro: usize) void {
    var x: usize = 0;
    while x < TUI_LOGO_W + TUI_LOGO_PAD {
        const gi: usize = x / (7 as usize);
        const co: usize = x % (7 as usize);
        var bright: bool = false;
        if co < 5 {
            bright = tui_logo_bit(gi, ro, co);
        }
        var shade: bool = false;
        if x > 0 {
            const px: usize = x - 1;
            const pgi: usize = px / (7 as usize);
            const pco: usize = px % (7 as usize);
            if pco < 5 {
                shade = tui_logo_bit(pgi, ro, pco);
            }
        }
        if bright {
            if ro == 4 {
                tui_puts("▓" as &const byte, TUI_ST_DIM);
            } else {
                tui_puts("█" as &const byte, TUI_ST_USER);
            }
        } else if shade {
            tui_puts("▓" as &const byte, TUI_ST_DIM);
        } else {
            tui_puts(" " as &const byte, TUI_ST_DEFAULT);
        }
        x = x + 1;
    }
}

// ============================================================
// 输入面板 / 脚注
// ============================================================

// 输入面板（含信息行）占几行：输入行数 + 1，夹在 [2, 10] 且不超过 rows-6（给转录留行）。
export fn tui_panel_height(in_lines: usize) usize {
    var h: usize = in_lines + 1;      // 输入行 + 信息行
    if h < 2 {
        h = 2;
    }
    if h > 10 {
        h = 10;
    }
    var maxh: usize = 3;
    if g_tui_rows > 6 {
        maxh = g_tui_rows - 6;
    }
    if maxh < 2 {
        maxh = 2;
    }
    if h > maxh {
        h = maxh;
    }
    return h;
}





// 脚注：左 `~/cwd:branch` + 状态字段（`ctx N%` / `cpu N%` / `内存 312M`，有值就必留），
// 右对齐**整个会话的统计行**（DSH StatsLine 的成品文本，由 agent 侧喂进来）。
//
// 退化规则（终端没有 hover，明细在 /status）：
//   * 统计行按 " | " 拆组，从**尾部**丢组并补 `…`（DSH 整行省略号的等价做法）；
//   * cwd 是唯一的弹性字段：先满足状态字段与统计行，剩下的才给 cwd，少于 8 列就整段丢；
//   * 内存是状态字段里**唯一会先让位**的那个（P24）：加进来之后仍要放得下才带，
//     所以 32 列这种最小画布只剩 `ctx` / `cpu`；`ctx` / `cpu` 永远不丢；
//   * 没有统计（或一组都放不下）时右半区退回版本号，脚注不留空。
fn tui_draw_footer() void {
    tui_row_new();
    tui_pad_to(2);
    const w: usize = if g_tui_cols > 4 { g_tui_cols - 4 } else { 1 as usize };
    const min_left: usize = 8;
    var left: Buf = buf_new(512);
    defer { buf_free(&left); }
    // 把 $HOME 前缀缩成 ~
    var cwd: &const byte = g_tui_cwd.ptr as &const byte;
    var cwd_len: usize = g_tui_cwd.len;
    if g_tui_home.len > 0 && cwd_len >= g_tui_home.len
        && bufx_mem_eq(cwd, g_tui_home.ptr as &const byte, g_tui_home.len) {
        _ = buf_append_byte(&left, 126);   // '~'
        _ = buf_append(&left, g_tui_cwd.ptr + g_tui_home.len, g_tui_cwd.len - g_tui_home.len);
    } else {
        _ = buf_append(&left, cwd, cwd_len);
    }
    if g_tui_branch.len > 0 {
        _ = buf_append_byte(&left, 58);   // ':'
        _ = buf_append(&left, g_tui_branch.ptr, g_tui_branch.len);
    }

    // 状态字段（P18）：上下文占用 + 全部 uya-agent 进程的 CPU；P24 再加进程内存合计
    var stat: Buf = buf_new(96);
    defer { buf_free(&stat); }
    if g_tui_ctx_pct >= 0 {
        _ = buf_append_cstr(&stat, " · ctx ");
        _ = buf_append_u64(&stat, g_tui_ctx_pct as u64);
        _ = buf_append_byte(&stat, 37);   // '%'
    }
    if g_tui_cpu_pct >= 0 {
        _ = buf_append_cstr(&stat, " · cpu ");
        _ = buf_append_u64(&stat, g_tui_cpu_pct as u64);
        _ = buf_append_byte(&stat, 37);   // '%'
    }
    // P24：内存合计（所有同名进程的 PSS 合计，见 procx.uya）。它是状态字段里唯一
    // 会先让位的：加进来之后连「2 列缩进 + 状态字段」都放不下就整段省略（32 列最小画布），
    // 免得把行撑到换行 —— `ctx` / `cpu` 永远不丢。
    if g_tui_mem_kb >= 0 {
        var mem: Buf = buf_new(32);
        defer { buf_free(&mem); }
        _ = buf_append_cstr(&mem, " · 内存 ");
        if procx_fmt_mem_kb(&mem, g_tui_mem_kb) {
            const core: usize = tty_cols_between(stat.ptr as &const byte, 0, stat.len);
            const add: usize = tty_cols_between(mem.ptr as &const byte, 0, mem.len);
            if 2 + core + add <= w {
                _ = buf_append(&stat, mem.ptr, mem.len);
            }
        }
    }
    const stat_cols: usize = tty_cols_between(stat.ptr as &const byte, 0, stat.len);

    // 右半区：统计行（阶梯丢组）→ 放不下就退回版本号
    var right: Buf = buf_new(512);
    defer { buf_free(&right); }
    var have_right: bool = false;
    var avail_right: usize = 0;
    if w > stat_cols + min_left + 2 {
        avail_right = w - stat_cols - min_left - 2;
    }
    if g_tui_stats.len > 0 && avail_right >= 16 {
        have_right = tui_fit_stats(&right, g_tui_stats.ptr as &const byte, g_tui_stats.len, avail_right);
    }
    if !have_right && g_tui_version.len > 0 && g_tui_version.len <= avail_right {
        _ = buf_append(&right, g_tui_version.ptr, g_tui_version.len);
        have_right = true;
    }
    const right_cols: usize = if have_right {
        tty_cols_between(right.ptr as &const byte, 0, right.len)
    } else {
        0 as usize
    };

    // cwd 拿剩下的列（不够 8 列就整段丢：状态字段与统计行优先）
    var cwd_budget: usize = 0;
    if w > stat_cols + right_cols + 2 {
        cwd_budget = w - stat_cols - right_cols - 2;
    }
    if cwd_budget < min_left {
        cwd_budget = 0;
    }
    if cwd_budget > 0 && left.len > 0 {
        // tui_put_clipped 被裁时会补一个 `…`（多占 1 列）—— 预算里先扣掉，
        // 否则 cwd 会顶掉右半区前面那一列间隔（踩过：`cpu 37%1 轮 · 12 步`）
        var show_cwd: usize = cwd_budget;
        const left_cols: usize = tty_cols_between(left.ptr as &const byte, 0, left.len);
        if left_cols > cwd_budget && show_cwd > 1 {
            show_cwd = cwd_budget - 1;
        }
        tui_put_clipped(left.ptr as &const byte, left.len, show_cwd, TUI_ST_FOOTER);
    }
    // cwd 整段让位时，状态字段前面那个 ` · ` 也不画 —— 否则行首会挂一个孤立的点
    // （窄终端 40/32 列：cwd 先丢，剩下的就是从 ctx 开始的字段）
    var stat_off: usize = 0;
    if stat.len >= 4 && !(cwd_budget > 0 && left.len > 0) {
        stat_off = 4;   // " · " = 空格 + 中点(UTF-8 两字节) + 空格 = 4 个字节、3 个显示列
    }
    if stat.len > stat_off {
        tui_put((stat.ptr + stat_off) as &const byte, stat.len - stat_off, TUI_ST_FOOTER);
    }
    if have_right {
        const end: usize = if g_tui_cols > 3 { g_tui_cols - 3 } else { 0 as usize };
        const cur: usize = tui_row_cols();
        var x: usize = cur + 1;             // 至少留一列间隔
        if end > right_cols {
            const aligned: usize = end - right_cols;
            if aligned > x {
                x = aligned;                // 放得下就右对齐
            }
        }
        tui_pad_to(x);
        tui_put(right.ptr as &const byte, right.len, TUI_ST_FOOTER);
    }
    tui_fill_row(g_tui_cols);
}

// 统计行的组阶梯：能放几组就放几组，丢了尾部就补 `…`；
// 返回 false = 连第一组都放不下（调用方退回版本号）。
fn tui_fit_stats(out: &Buf, src: &const byte, n: usize, avail: usize) bool {
    buf_reset(out);
    if n == 0 || avail == 0 {
        return false;
    }
    var gstart: [usize: 5] = [0: 5];
    var gend: [usize: 5] = [0: 5];
    var ng: usize = 0;
    gstart[0] = 0;
    var i: usize = 0;
    while i + 3 <= n {
        if src[i] == 32 as byte && src[i + 1] == 124 as byte && src[i + 2] == 32 as byte {
            if ng >= 4 {
                break;   // 最多 5 组（DSH 的统计行就只有 5 组）
            }
            gend[ng] = i;
            ng = ng + 1;
            gstart[ng] = i + 3;
            i = i + 3;
            continue;
        }
        i = i + 1;
    }
    if ng > 4 {
        ng = 4;
    }
    gend[ng] = n;
    ng = ng + 1;

    var k: usize = ng;
    while k >= 1 {
        if k > 5 {
            break;
        }
        const take: usize = gend[k - 1];
        const cols: usize = tty_cols_between(src, 0, take);
        const extra: usize = if k < ng { 1 as usize } else { 0 as usize };   // "…" 占 1 显示列
        if cols + extra <= avail {
            _ = buf_append(out, src, take);
            if k < ng {
                _ = buf_append_cstr(out, "…");
            }
            return true;
        }
        k = k - 1;
    }
    // 一组都放不下：裁第一组 + `…`
    const keep: usize = tty_clip_bytes(src, gend[0], avail);
    if keep == 0 {
        return false;
    }
    _ = buf_append(out, src, keep);
    _ = buf_append_cstr(out, "…");
    return true;
}
