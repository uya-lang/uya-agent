// src/term/tui/hook.uya — 全屏 TUI：按键→行为 / 读键盘 / 清转录 / 复位 / 生命周期
//
// 本文件：按键事件派发到行为（提交 / 中断 / 退出 / 滚动 / 浮层）、阻塞型工作开始前的
//   「现在要不要停」判定（P28）、fd 0 非阻塞读取、清转录（P39，运行时换会话用）、自测用的
//   状态复位，以及启动 / 收尾 / 每帧 tick。
// 不变量：每帧 tick 只做「读键 → 派发 → 画脏帧」；自测复位必须把所有状态清回初值
//   （轮次之间不许互相污染）。
// 依赖：keys / screen / overlay / edit 全部。
// 命名：本目录统一 `tui_` / `TUI_` 前缀（uya 没有闭包，模块级名字全局合并）。

use libc.syscall;
use libc.unistd;
use libc.heap;

// ============================================================
// 按键 → 行为（提交 / 中断 / 退出 / 滚动 / 浮层）
// ============================================================

export const TUI_REQ_NONE: i32 = 0;
export const TUI_REQ_PLAN_ON: i32 = 1;
export const TUI_REQ_PLAN_OFF: i32 = 2;
export const TUI_REQ_ACCESS: i32 = 3;   // P21：打开访问模式选择器（shift+tab）
export const TUI_REQ_TASKS: i32 = 4;    // P22：展开/收起常驻任务块（ctrl+t）
export const TUI_REQ_PASTE: i32 = 5;    // P52：贴剪贴板（ctrl+v）

var g_tui_submit: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_have_submit: bool = false;
var g_tui_interrupt: bool = false;
var g_tui_quit: bool = false;
var g_tui_ctrl_c_armed: bool = false;
var g_tui_ctrl_c_at: u64 = 0;      // 上一次「待确认的 ctrl+c」的时刻（两秒内再按 = 退出）
var g_tui_req: i32 = TUI_REQ_NONE;
var g_tui_cmds: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_tui_panel_h: usize = 2;
var g_tui_in_lines: usize = 1;

// 惰性分配这一层自己的两个 Buf（待提交的输入行 / 命令表），幂等。
fn tui_glue_ensure() void {
    if !buf_valid(&g_tui_submit) { g_tui_submit = buf_new(65536); }
    if !buf_valid(&g_tui_cmds) { g_tui_cmds = buf_new(4096); }
}

// 推送命令表（面板过滤器与 tui_is_exit_command 都读它）；整体替换，不追加。
export fn tui_set_commands(p: &const byte, n: usize) void {
    tui_glue_ensure();
    buf_reset(&g_tui_cmds);
    _ = buf_append(&g_tui_cmds, p, n);
}

// 取走待提交的输入行（**消费**：取过之后 has_submit 变假）；没有就返回 false、out 不动。
export fn tui_take_submit(out: &Buf) bool {
    tui_glue_ensure();
    if !g_tui_have_submit {
        return false;
    }
    buf_reset(out);
    _ = buf_append(out, g_tui_submit.ptr, g_tui_submit.len);
    g_tui_have_submit = false;
    return true;
}

// 看一眼待提交的那一行，**不消费**（P46）。
// 用途与 tui_overlay_peek 同一条分工：泵点上要先判断「这一行是不是只读命令」——
// 是就当场派发，不是就一个字节都不动，原样留给 llm_pump_input（流式循环还要靠那个事件
// 把文本推进 steer 收件箱）。
export fn tui_peek_submit(out: &Buf) bool {
    tui_glue_ensure();
    if !g_tui_have_submit {
        return false;
    }
    buf_reset(out);
    _ = buf_append(out, g_tui_submit.ptr, g_tui_submit.len);
    return true;
}

// 有没有还没被取走的待提交输入行。
export fn tui_has_submit() bool {
    return g_tui_have_submit;
}

// 取走「中断本回合」的请求（**消费**：读一次即清零），返回取之前的值。
export fn tui_interrupt_take() bool {
    const v: bool = g_tui_interrupt;
    g_tui_interrupt = false;
    return v;
}

// P26：请求中断当前回合（面板里选中 /new、/resume 时用 —— 先中断，回合 unwind 之后
// 主循环再执行那条命令）。与用户按 esc 是同一条路：一次性的请求，消费即清零。
export fn tui_request_interrupt() void {
    g_tui_interrupt = true;
    tui_mark_dirty();
}

// 有没有中断意图挂着（**不消费**，供「已经知道要停」的分支反复查）。
export fn tui_interrupt_pending() bool {
    return g_tui_interrupt;
}

// 该收工了吗 = 用户要退出（ctrl+d / /exit / 二次 ctrl+c）**或** headless 的注入键用完了。
// 注意 g_tui_headless_done 只表示「没人再回答了」，与 g_tui_quit 是两种语义（见 style.uya 的说明）。
export fn tui_quit_wanted() bool {
    return g_tui_quit || g_tui_headless_done;
}


// 取走「模式/访问/任务/粘贴」这一类请求（**消费**：读一次即清零），返回 TUI_REQ_*；
// 没有请求时返回 TUI_REQ_NONE。
export fn tui_take_request() i32 {
    const r: i32 = g_tui_req;
    g_tui_req = TUI_REQ_NONE;
    return r;
}

// ============================================================
// P28：「现在要不要停」：给**阻塞型**工作（bash 前台 / 后台任务等待 / 子代理等待 /
// workflow 脚本 / rg）用的一问一答接口。
//
// 为什么必须有：这些循环以前只调 tui_poll_tick()（把界面刷活、把键收下来），
// 但**没有一个人看**收下来的键 —— 于是 `sleep 300` 跑着的时候 esc / ctrl+c /
// ctrl+d 全都石沉大海，用户只能等工具自己结束，看着就像「退不出」（踩坑 44）。
// 判定口径与主循环完全一致：QUIT 就是 QUIT，接到的人负责把子进程杀掉并收工。
// ============================================================

export const TUI_ABORT_NONE: i32 = 0;
export const TUI_ABORT_TURN: i32 = 1;   // esc / ctrl+c：停掉当前这一步，本回合到此为止
export const TUI_ABORT_QUIT: i32 = 2;   // ctrl+d / /exit / 运行中二次 ctrl+c：杀子进程并退出

// 滚动模式（--no-tui）下由 tui_abort_check 记下来的意图：那边没有 TUI 的全局标志
// （ctrl+c 只是 stdin 里的一个字节），但这个意图必须**粘住** —— 杀掉工具子进程之后，
// 回合还得在下一个 step 边界停下来，否则用户按了 ctrl+c，模型却接着跑下一步。
var g_block_abort: i32 = TUI_ABORT_NONE;

// 只读状态（不读键、不重绘）：给「已经知道要停」的分支用
export fn tui_abort_state() i32 {
    if g_tui_quit || g_block_abort == TUI_ABORT_QUIT {
        return TUI_ABORT_QUIT;
    }
    if g_tui_interrupt || g_block_abort == TUI_ABORT_TURN {
        return TUI_ABORT_TURN;
    }
    return TUI_ABORT_NONE;
}

// 阻塞循环里调这个：TUI 模式下顺带刷帧 + 读键；滚动模式下也服务一遍键盘
// （整行进 steer 收件箱、Ctrl-C = 中断），非交互（管道/CI/子代理）模式下是空调用。
//
// 自测（headless）下**不**刷帧：headless 的 poll 把「注入的键用完」当成 stdin EOF
// 并置 quit，刷一下就等于让每个工具循环立刻自杀。
export fn tui_abort_check() i32 {
    if tui_active() {
        if !g_tui_headless {
            _ = tui_tick(tui_now_ms());
        }
        return tui_abort_state();
    }
    if tty_is_interactive() {
        const ev: i32 = llm_pump_input();
        if ev == TTY_EV_EOF {
            tui_abort_note_scroll(TUI_ABORT_QUIT);
        } else if ev == TTY_EV_CTRL_C || ev == TTY_EV_ESC {
            tui_abort_note_scroll(TUI_ABORT_TURN);
        }
    }
    return tui_abort_state();
}

// 回合开始时清掉上一轮遗留的中断意图。
//
// 不清的后果很重：`g_tui_interrupt` 只有按键会置、**没人复位**，而流式循环一开头
// 就问「有没有中断意图」—— 于是中断过一次之后，**后面每一个新任务都在第一个字节
// 就被打断**（屏幕上只有一句「已中断本回合」，看起来像 agent 死了）。
export fn tui_interrupt_clear() void {
    g_tui_interrupt = false;
    g_block_abort = TUI_ABORT_NONE;
}

// 滚动模式下记下「用户要停」的意图（只升级不降级）。自测直接调它模拟 stdin 上的
// ctrl+c/ctrl+d —— 真机上这一步由 tui_abort_check 的 tty 分支完成。
export fn tui_abort_note_scroll(kind: i32) void {
    if kind == TUI_ABORT_QUIT {
        g_block_abort = TUI_ABORT_QUIT;
    } else if kind == TUI_ABORT_TURN && g_block_abort == TUI_ABORT_NONE {
        g_block_abort = TUI_ABORT_TURN;
    }
}

// fork 出来的子代理进程：终端、TUI 帧目标 fd、按键全都是从父进程继承来的，
// 子进程**一个字节都不许碰** —— 否则子代理（它的流式循环与工具循环都会 tick）
// 会被父进程的终端抢键：用户在子代理跑着的时候按 esc / ctrl+c / ctrl+d，
// 键被子进程吃掉，父进程永远收不到（踩坑 44）。
export fn tui_child_detach() void {
    g_tui_on = false;
    g_tui_out_fd = -1;
    g_tui_headless = false;
    g_tui_quit = false;
    g_tui_headless_done = false;
    g_tui_interrupt = false;
    tty_sink_on = false;
}

// 命令面板里那两条「退出」命令（`/exit`、`/quit`）。命令表只有一份，
// 判定口径也必须只有一份：**提交路径**（打字回车）与**主循环**（面板选中的命令）
// 都按这个函数认，别处不许再写第二份字面量比较。
export fn tui_is_exit_command(p: &const byte, n: usize) bool {
    if n == 5 && bufx_mem_eq(p, "/exit" as &const byte, 5) {
        return true;
    }
    if n == 5 && bufx_mem_eq(p, "/quit" as &const byte, 5) {
        return true;
    }
    return false;
}

// 提交当前输入（回车）：进历史 + 清空 + 置「有待取走的提交」
//
// `/exit` / `/quit` 在**这里**就拦下来（置退出标志、既不进历史也不提交）：
// 提交路径是「空闲」与「回合运行中」两条路的分叉点 —— 空闲时提交进主循环，
// 运行中提交进 steer 收件箱（当 user 消息发给模型）。两个地方各拦一次容易漏，
// 而且真的漏过：TUI 里打 `/exit` 回车以前什么都不发生（退出标志没置），
// 运行中打还会把 `/exit` 当成任务文本发给模型（见 §16 踩坑 44）。
fn tui_do_submit() void {
    tui_glue_ensure();
    tui_in_ensure();
    if g_tui_in.len == 0 {
        return;
    }
    if tui_is_exit_command(g_tui_in.ptr as &const byte, g_tui_in.len) {
        g_tui_quit = true;
        buf_reset(&g_tui_in);
        g_tui_in_cursor = 0;
        tui_mark_dirty();
        return;
    }
    buf_reset(&g_tui_submit);
    _ = buf_append(&g_tui_submit, g_tui_in.ptr, g_tui_in.len);
    g_tui_have_submit = true;
    tui_hist_push(g_tui_in.ptr as &const byte, g_tui_in.len);
    buf_reset(&g_tui_in);
    g_tui_in_cursor = 0;
    g_tui_in_over = false;
    tui_mark_dirty();
}

// 命令面板：把命令表按 '/' 过滤
fn tui_open_palette() void {
    tui_glue_ensure();
    tui_overlay_list(TUI_OVK_PALETTE, "命令" as &const byte, 6, g_tui_cmds.ptr as &const byte, g_tui_cmds.len);
}

// 打开帮助浮层（HELP kind）：键位说明整篇作为条目，回车不派发任何动作。
// 行宽豁免：help 是整段按键说明（一条不可断的长字符串字面量，见 AGENTS.md 例外条款）
fn tui_open_help() void {
    const help: &const byte = "enter 发送 · ctrl+j / alt+enter 换行 · esc 中断（运行中＝中断本回合，当场杀掉正在跑的工具）· ctrl+c 中断或退出\npgup/pgdn 滚动 · ctrl+home/end 顶/尾 · tab 计划模式 · shift+tab 访问模式 · ctrl+p 命令面板（敲字即过滤，过滤词画在标题栏；↑/↓ 循环选择，Home/End/pgup/pgdn 夹取）\nF2 切换鼠标上报（关掉就能拖选复制文本；开着滚轮能翻滚录，也可以按住 shift 拖选）· /mouse [on|off]\nctrl+f / F11 浮层全屏（占满转录区，看长 /status 与 /tasks 用；再按一次关掉）· /fullscreen [on|off]\nctrl+v 贴剪贴板（图片挂附件、文本插进输入行）· /paste\nctrl+u 清行 · ctrl+w 删词 · ctrl+k 删到行尾 · ctrl+a/e 行首/行尾 · ctrl+l 重绘\nctrl+t 任务状态块 展开/收起 · ctrl+d 空行退出（运行中也生效）· /exit 退出 · ctrl+c 运行中两秒内两次＝退出 · 运行中的输入会进 steer 收件箱（下一个 step 生效）\n/diff 看 git 修改（浮窗里：↑↓ 选文件 · n/N 跳改动 · pgup/pgdn 滚动 · ←→ 左右 · r 刷新 · esc 关闭）\n/title 改会话标题（裸命令让模型起个建议填进输入框：←→ 移动 · ctrl+u 清空 · enter 采纳 · esc 取消）" as &const byte;
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, help, bufx_cstr_len(help));
}

// 外部入口：打开帮助浮层（= tui_open_help）。
export fn tui_help_open() void {
    tui_open_help();
}

// 派发**一个**按键事件：有浮层就整交给浮层（浮层自己吃键，底下的输入行一个字节都不动）；
// 否则按输入行编辑 / 提交 / 中断 / 滚动 / 请求标志处理。改状态与置请求都在这里，
// 具体的执行（真正杀掉子进程、读剪贴板）不由本文件做。
fn tui_handle_one(ev: i32) void {
    if g_tui_ov != TUI_OV_NONE {
        tui_ov_key(ev);
        return;
    }
    if ev == TUI_K_CHAR {
        var tmp: Buf = buf_new(8);
        defer { buf_free(&tmp); }
        const n: usize = tui_key_take_char(&tmp);
        if n > 0 {
            const first_slash: bool = g_tui_in.len == 0 && tmp.ptr[0] == 47 as byte;
            tui_in_insert(tmp.ptr as &const byte, n);
            if first_slash {
                tui_open_palette();
            }
        }
        return;
    }
    if ev == TUI_K_ENTER || ev == TUI_K_NEWLINE {
        if ev == TUI_K_ENTER {
            tui_do_submit();
        } else {
            tui_in_insert("\n" as &const byte, 1);
        }
        return;
    }
    if ev == TUI_K_BACKSPACE {
        tui_in_backspace();
        return;
    }
    if ev == TUI_K_DELETE {
        tui_in_delete();
        return;
    }
    if ev == TUI_K_LEFT {
        tui_in_left();
        return;
    }
    if ev == TUI_K_RIGHT {
        tui_in_right();
        return;
    }
    if ev == TUI_K_UP {
        tui_in_up();
        return;
    }
    if ev == TUI_K_DOWN {
        tui_in_down();
        return;
    }
    if ev == TUI_K_HOME || ev == TUI_K_CTRL_A {
        tui_in_home();
        return;
    }
    if ev == TUI_K_END || ev == TUI_K_CTRL_E {
        tui_in_end();
        return;
    }
    if ev == TUI_K_PGUP {
        tui_scroll_up(tui_page_rows());
        return;
    }
    if ev == TUI_K_PGDN {
        tui_scroll_down(tui_page_rows());
        return;
    }
    // P25：滚轮 —— 每格 5 行（PgUp/PgDn 是一屏）。滚轮不碰输入行，
    // 也不进历史（xterm.js 在没有鼠标协议时把滚轮伪装成 ↑/↓，那一路就变成了历史）。
    if ev == TUI_K_WHEEL_UP {
        tui_scroll_up(TUI_WHEEL_STEP);
        return;
    }
    if ev == TUI_K_WHEEL_DOWN {
        tui_scroll_down(TUI_WHEEL_STEP);
        return;
    }
    // 踩坑 72：F2 —— 切换鼠标上报。关掉之后终端接管拖选（可复制文本），滚轮则回落到终端
    // 自己的行为；再按一下开回来。落一条 notice 让人知道现在是什么状态。
    // P53：ctrl+f / F11 —— 浮层全屏开关。没浮层时只落一条指路 notice（不改状态）：
    // 凭空开一张浮层是隐形副作用，滚动模式那边也没有浮层可切，两边要同一种「没东西可切」。
    if ev == TUI_K_FULLSCREEN {
        if !tui_overlay_full(-1) {
            tui_add_notice("(浮层全屏：现在没有浮层 —— 先开一个（/status、/help、ctrl+p…），再按 ctrl+f / F11)" as &const byte,
                bufx_cstr_len("(浮层全屏：现在没有浮层 —— 先开一个（/status、/help、ctrl+p…），再按 ctrl+f / F11)" as &const byte));
            tui_mark_dirty();
        }
        return;
    }
    if ev == TUI_K_MOUSE_TOGGLE {
        const on: bool = !g_tui_mouse;
        tui_set_mouse(on);
        if on {
            tui_add_notice("(鼠标上报：开 —— 滚轮翻转录；要选文本复制请按 F2 关掉、或按住 shift 拖选)" as &const byte,
                bufx_cstr_len("(鼠标上报：开 —— 滚轮翻转录；要选文本复制请按 F2 关掉、或按住 shift 拖选)" as &const byte));
        } else {
            tui_add_notice("(鼠标上报：关 —— 现在可以直接拖选复制文本；滚轮交给终端，翻滚录请用 ctrl+↑/↓ 或 pgup/pgdn)" as &const byte,
                bufx_cstr_len("(鼠标上报：关 —— 现在可以直接拖选复制文本；滚轮交给终端，翻滚录请用 ctrl+↑/↓ 或 pgup/pgdn)" as &const byte));
        }
        tui_mark_dirty();
        return;
    }
    if ev == TUI_K_CTRL_U {
        tui_input_clear();
        return;
    }
    if ev == TUI_K_CTRL_W {
        tui_in_del_word();
        return;
    }
    if ev == TUI_K_CTRL_K {
        tui_in_kill_to_end();
        return;
    }
    if ev == TUI_K_CTRL_L {
        tui_invalidate();
        return;
    }
    if ev == TUI_K_CTRL_P {
        tui_open_palette();
        return;
    }
    if ev == TUI_K_CTRL_T {
        // P22：只置请求，别在这里改状态（与 tab/shift+tab 同一套分工）
        g_tui_req = TUI_REQ_TASKS;
        tui_mark_dirty();
        return;
    }
    if ev == TUI_K_CTRL_V {
        // P52：只置请求 —— 读剪贴板要走 X11 协议与文件 IO，那是 agent 侧的事
        // （与 ctrl+t / shift+tab 同一套分工：TUI 只表达意图）
        g_tui_req = TUI_REQ_PASTE;
        tui_mark_dirty();
        return;
    }
    if ev == TUI_K_STAB {
        if g_tui_in.len == 0 {
            // P21：shift+tab 打开访问模式选择器（chip 的「可点」等价物；终端没有鼠标）
            g_tui_req = TUI_REQ_ACCESS;
            tui_mark_dirty();
        } else {
            tui_in_insert("  " as &const byte, 2);
        }
        return;
    }
    if ev == TUI_K_TAB {
        if g_tui_in.len == 0 {
            // 切计划模式（opencode 里 tab 也是切模式）
            g_tui_plan = !g_tui_plan;
            if g_tui_plan {
                g_tui_req = TUI_REQ_PLAN_ON;
            } else {
                g_tui_req = TUI_REQ_PLAN_OFF;
            }
            tui_mark_dirty();
        } else {
            tui_in_insert("  " as &const byte, 2);
        }
        return;
    }
    if ev == TUI_K_ESC || ev == TUI_K_CTRL_C {
        if g_tui_run != TUI_RUN_IDLE {
            // 运行中：esc / ctrl+c 都是「中断本回合」；ctrl+c **两秒内再按一次**就是退出。
            // 之所以给运行中也留一条退出键：中断意图是在**下一个 step 边界**生效的，
            // 如果当前这一步是个长命令，光靠 esc 只能等它跑完（踩坑 44）。
            if ev == TUI_K_CTRL_C {
                if g_tui_ctrl_c_armed && (tui_now_ms() - g_tui_ctrl_c_at) <= 2000 {
                    g_tui_quit = true;
                    return;
                }
                g_tui_ctrl_c_armed = true;
                g_tui_ctrl_c_at = tui_now_ms();
                tui_add_notice("(再按一次 ctrl+c 直接退出；esc 只中断本回合)" as &const byte, bufx_cstr_len("(再按一次 ctrl+c 直接退出；esc 只中断本回合)" as &const byte));
            }
            g_tui_interrupt = true;
            tui_mark_dirty();
            return;
        }
        if ev == TUI_K_ESC {
            tui_input_clear();
            return;
        }
        if g_tui_in.len > 0 {
            tui_input_clear();
            g_tui_ctrl_c_armed = false;
            return;
        }
        if g_tui_ctrl_c_armed && (tui_now_ms() - g_tui_ctrl_c_at) <= 2000 {
            g_tui_quit = true;
            return;
        }
        g_tui_ctrl_c_armed = true;
        g_tui_ctrl_c_at = tui_now_ms();
        tui_add_notice("(再按一次 ctrl+c 退出；或直接输入任务)" as &const byte,
            bufx_cstr_len("(再按一次 ctrl+c 退出；或直接输入任务)" as &const byte));
        return;
    }
    if ev == TUI_K_CTRL_D {
        if g_tui_in.len == 0 {
            g_tui_quit = true;
        } else {
            tui_in_delete();
        }
        return;
    }
}

// 把按键队列里的键**全部**取空并逐个派发（直到 tui_key_next 返回 TUI_K_NONE）。
// 每帧 tick 与读键盘之后都调它 —— 队列不空就一定会被处理掉，不留下一个键跨帧。
export fn tui_handle_keys() void {
    while true {
        const ev: i32 = tui_key_next();
        if ev == TUI_K_NONE {
            break;
        }
        tui_handle_one(ev);
    }
}

// ============================================================
// 读键盘（fd 0，非阻塞；返回读到的字节数）
// ============================================================

// 从 fd 0 非阻塞读一批字节喂给键状态机，返回读到的字节数（0 = 没有可读 / 被 EINTR 打断）。
// **EINTR（SIGWINCH 等）当作「没读到」，绝不当 EOF**；喂键后再 poll 一次，**只有后面没有
// 更多字节**才 tui_key_flush_esc()（终端/网络可能把 `ESC [ D` 切成几段，早一步落实就会把
// 方向键当成 Esc）。headless 下不读 fd 0，改为「注入的键用完就置 g_tui_headless_done」。
export fn tui_poll_keys(timeout_ms: i32) usize {
    if g_tui_headless {
        // 自测：按键靠注入；注入的键用完 = 这一轮脚本演完了（置 harness 标志，**不置**
        // g_tui_quit）：主循环与审批浮层的等待据此收工，而流式循环/工具循环的退出判定
        // 看不到它（自测里要结束一个跑着的回合请显式注入 esc/ctrl+c）。
        if g_tui_evn == 0 && !g_tui_have_submit {
            g_tui_headless_done = true;
        }
        return 0;
    }
    var pfds: [PollFd: 1] = [PollFd{ fd: 0, events: POLLIN, revents: 0 }];
    const pr: i32 = sys_poll(&pfds[0], 1, timeout_ms) catch { 0; };
    if pr <= 0 {
        return 0;
    }
    var tmp: [byte: 512] = [0: 512];
    const rr: !isize = sys_read(0, &tmp[0], 512);
    var eid: i32 = 0;
    const n: isize = rr catch |err| {
        eid = (@error_id(err) as! i32).value;
        -1 as isize;
    };
    if n <= 0 {
        // EINTR（SIGWINCH 等）当作「没读到」，绝不当 EOF
        return 0;
    }
    tui_key_feed(&tmp[0], n as usize);
    // 只有「后面没有更多字节」时才把悬着的裸 ESC 落实 —— 终端/网络可能把
    // `ESC [ D` 切成几段，早一步落实就会把方向键当成 Esc
    var more: [PollFd: 1] = [PollFd{ fd: 0, events: POLLIN, revents: 0 }];
    const pr2: i32 = sys_poll(&more[0], 1, 0) catch { 0; };
    if pr2 <= 0 {
        tui_key_flush_esc();
    }
    tui_handle_keys();
    return n as usize;
}

// 供 llm.uya 的流式循环使用：语义与 tty_next_event 对齐（只关心 Ctrl-C/Esc 中断）
export const TUI_EV_NONE: i32 = 0;
export const TUI_EV_SUBMIT: i32 = 1;
export const TUI_EV_CTRL_C: i32 = 2;
export const TUI_EV_ESC: i32 = 3;
export const TUI_EV_EOF: i32 = 4;

// 供流式循环用的泵点：读一次键再折算成 TUI_EV_*。优先级 submit > ctrl_c > eof > none。
export fn tui_pump_input() i32 {
    _ = tui_poll_keys(0);
    if tui_has_submit() {
        return TUI_EV_SUBMIT;
    }
    if g_tui_interrupt {
        return TUI_EV_CTRL_C;
    }
    if g_tui_quit {
        return TUI_EV_EOF;
    }
    return TUI_EV_NONE;
}

// ============================================================
// P39：清转录（**运行时**换会话用）
//
// 换会话（`/new` / `/resume` / `/sessions` 浮层选中）之后旧会话的正文还挂在屏幕上，
// 与新恢复出来的历史混在同一屏里 —— 用户看到的第一件事必须只是「这是新会话」。
//
// 这里**只**清转录条目与它的配套状态：
//   * 四条条目记账（nent / estart / text_total / dropped）必须一起清 —— 只把入口指针
//     归零会让 pooled 内存漏掉，还会在顶部留一行假的「已丢弃 N 条」；
//   * 半行（通道 2 的不完整尾巴）/ 粘贴待处理 / 思考实时行：都是「跟着转录走」的；
//   * 滚动状态：换会话后一律贴尾（`pin_end_req` 保证下一帧钉在真正的底）。
//
// ⚠ 不能拿 `tui_reset_all()` 来干这件事：那是**自测复位**，它会顺手端掉脚注统计
// （stats/ctx/cpu/内存）、cwd/分支/模型、plan 与访问模式的 chip、浮层与按键队列 ——
// 会话还在跑的时候调一次，界面就残了（状态区与脚注全空）。
// ============================================================

// P39 清转录（**运行时**换会话用）：释放条目池、清四条记账与半行/粘贴/思考实时行，
// 滚动状态复位到**贴尾**（pin_end_req 保证下一帧钉到真正的底）。**不是**自测复位 ——
// 不能拿 tui_reset_all() 顶替，那会顺手端掉脚注统计、cwd/分支/模型、plan 与访问模式。
export fn tui_transcript_clear() void {
    var i: usize = 0;
    while i < TUI_MAX_ENTRIES {
        if buf_valid(&g_tui_entries[i].text) {
            buf_free(&g_tui_entries[i].text);
        }
        if buf_valid(&g_tui_entries[i].wrap) {
            buf_free(&g_tui_entries[i].wrap);
        }
        if buf_valid(&g_tui_entries[i].md) {
            buf_free(&g_tui_entries[i].md);
            tui_lineidx_reset(&g_tui_entries[i].wrap_ix);
        }
        i = i + 1;
    }
    g_tui_nent = 0;
    g_tui_estart = 0;
    g_tui_text_total = 0;
    g_tui_dropped = 0;
    // 跟随转录的临时缓冲：不冲掉的话，紧接着铺回来的第一条工具行会与半行粘在一起
    if buf_valid(&g_tui_linebuf) {
        buf_reset(&g_tui_linebuf);
    }
    if buf_valid(&g_tui_pend) {
        buf_reset(&g_tui_pend);
    }
    if buf_valid(&g_tui_think) {
        buf_reset(&g_tui_think);
    }
    // 滚动状态复位到「贴尾」
    g_tui_scroll = 0;
    g_tui_total = 0;
    g_tui_more_above = false;
    g_tui_more_below = false;
    g_tui_follow_tail = true;
    g_tui_pin_end_req = true;      // 新铺出来的内容可能超过一屏：下一帧钉到真正的底
    g_tui_pin_top_req = false;
    g_tui_visible_rows = 0;
    g_tui_visible_row0 = 0;
    g_tui_visible_total = 0;
    tui_mark_dirty();
}

// ============================================================
// 自测：把所有 TUI 状态复位（轮次之间不互相污染）
// ============================================================

// 自测复位：把所有 TUI 状态清回初值（条目池 + 滚动 + 浮层 + 按键 + 模式 + 统计），
// 保证轮次之间**不许互相污染**。生产路径不许调它（会端掉运行时状态，见 tui_transcript_clear）。
export fn tui_reset_all() void {
    // P39：条目池 + 滚动状态这一半与「运行时清转录」逐字节相同，共用一份实现
    tui_transcript_clear();
    tui_in_ensure();
    buf_reset(&g_tui_in);
    g_tui_in_cursor = 0;
    g_tui_in_over = false;
    tui_glue_ensure();
    buf_reset(&g_tui_submit);
    buf_reset(&g_tui_cmds);
    g_tui_have_submit = false;
    g_tui_interrupt = false;
    g_tui_quit = false;
    g_tui_headless_done = false;
    g_tui_ctrl_c_armed = false;
    g_tui_ctrl_c_at = 0;
    g_tui_req = TUI_REQ_NONE;
    g_block_abort = TUI_ABORT_NONE;
    // 滚动相关的运行期状态已在 tui_transcript_clear() 里复位到「贴尾」；不复位的话
    // 自测轮次之间会串味（上一轮留下的 follow_tail=false 会让这一轮「往上翻」判成
    // 「正在看历史」）。这里只把自测要的 pin_end_req 收掉（P25 的口径）。
    g_tui_pin_end_req = false;
    g_tui_ov = TUI_OV_NONE;
    g_tui_ov_kind = 0;
    g_tui_ov_done = 0;
    g_tui_dg = TuiDiffGeo{
        w: 0, left: 0, list_w: 0, sep1: 0, cell1_x: 0, cell_w: 0,
        sep2: 0, cell2_x: 0, cell_w2: 0, rows: 0
    };
    g_tui_ov_have = false;
    g_tui_ov_cancel = false;
    g_tui_ov_n = 0;
    g_tui_ov_sel = 0;
    // 踩坑 68：行偏移表是堆上的，复位时连它一起放掉（表与它描述的 Buf 同寿命）
    tui_lineidx_reset(&g_tui_ov_items_ix);
    tui_lineidx_reset(&g_tui_ov_rows_ix);
    // P43：ask 型的对话框状态与**答案**一起清（自测轮次之间不许串味）
    tui_ask_states_clear();
    tui_ask_answer_clear();
    tui_key_reset();
    g_tui_prev_nrows = 0;
    g_tui_dirty = true;
    // 踩坑 72：鼠标上报开关复位到默认开（自测轮次之间不许串味）
    g_tui_mouse = true;
    // P53：浮层全屏态复位到默认关（同上 —— 上一轮留下的全屏会让这一轮的几何断言莫名其妙地红）
    g_tui_ov_full = false;
    g_tui_run = TUI_RUN_IDLE;
    g_tui_plan = false;
    g_tui_frames = 0;
    g_tui_step = 0;
    buf_reset(&g_tui_stats);
    if buf_valid(&g_tui_tasks) {
        buf_reset(&g_tui_tasks);
    }
    g_tui_tasks_n = 0;
    g_tui_ctx_pct = -1;
    g_tui_cpu_pct = procx_cpu_pct();
    g_tui_mem_kb = procx_mem_kb();
}

// ============================================================
// 启动 / 收尾 / 每帧 tick
// ============================================================

var g_tui_last_frame_ms: u64 = 0;
var g_tui_idle_frames: usize = 0;

// 起一个「新 UI 会话」：清掉一次性状态（quit/interrupt/submit/按键队列）。
// 这些是进程级全局，fork 或同进程复用时会带着上一轮的值 —— 踩过：headless 自测跑完
// 留下 quit=true，PTY 里的新 UI 一进来就自己退出了。
export fn tui_begin_session() void {
    g_tui_quit = false;
    g_tui_headless_done = false;
    g_tui_interrupt = false;
    g_tui_have_submit = false;
    g_tui_ctrl_c_armed = false;
    g_tui_ctrl_c_at = 0;
    g_tui_req = TUI_REQ_NONE;
    g_block_abort = TUI_ABORT_NONE;
    g_tui_run = TUI_RUN_IDLE;
    if buf_valid(&g_tui_think) {
        buf_reset(&g_tui_think);      // P18：新会话不许带着上一轮的思考实时行
    }
    tui_key_reset();
}

// 完整启动序列：复位一次性状态 → 备好四个缓冲家族 → 进备用屏幕（tui_term_enter）→
// 读一次终端尺寸。out_fd 是启动时 dup 出来的**私有**帧 fd，后续帧只写它。
export fn tui_start(out_fd: i32) void {
    tui_begin_session();
    tui_bufs_ensure();
    tui_state_ensure();
    tui_in_ensure();
    tui_glue_ensure();
    tui_term_enter(out_fd);
    _ = tui_size_refresh();
}

// 收尾：离开备用屏幕（还原备用屏幕/鼠标/光标）并把 g_tui_on 关掉；fd 无效时只关标志。
export fn tui_stop() void {
    if g_tui_out_fd >= 0 {
        tui_term_leave(g_tui_out_fd);
    }
    g_tui_on = false;
}

// 工具/后台任务的阻塞循环里调这个（非 TUI 模式是空调用）：界面不会卡住，键也照收
export fn tui_poll_tick() void {
    if tui_active() {
        _ = tui_tick(tui_now_ms());
    }
}

// 每帧 tick：尺寸（含 SIGWINCH）→ 键盘 → spinner → 节流重绘
export fn tui_tick(now_ms: u64) bool {
    if !g_tui_on {
        return false;
    }
    var need: bool = false;
    if sigx_winch_take() {
        tui_invalidate();
        need = true;
    }
    if !g_tui_headless && tui_size_refresh() {
        need = true;
    }
    if tui_poll_keys(0) > 0 {
        need = true;
    }
    // P18：进程 CPU 采样挂在同一个心跳上 —— 这个 tick 覆盖了 agent 主循环、llm 流式
    // 循环与各种阻塞 poll 循环（tui_poll_tick），所以跑工具/等网络时数字照样刷新。
    // P24：内存（PSS 合计）同一路，只是慢一档（procx 内部按 5s 决定要不要算）。
    procx_tick(now_ms);
    // P22：任务块的 1Hz 心跳（poll job/deleg + 重建文本；内容变了才 mark dirty）
    tasks_tick(now_ms);
    if g_tui_cpu_pct != procx_cpu_pct() {
        g_tui_cpu_pct = procx_cpu_pct();
        need = true;
    }
    if g_tui_mem_kb != procx_mem_kb() {
        g_tui_mem_kb = procx_mem_kb();
        need = true;
    }
    if g_tui_run != TUI_RUN_IDLE {
        tui_tick_spinner();
        need = true;
    }
    if !need && !g_tui_dirty {
        return false;
    }
    // 帧率上限：距上一帧 < 33ms 且不是「空闲转圈」就攒到下一 tick
    if now_ms > g_tui_last_frame_ms && now_ms - g_tui_last_frame_ms < 33 && g_tui_run != TUI_RUN_IDLE {
        return false;
    }
    if g_tui_run == TUI_RUN_IDLE && g_tui_idle_frames > 6 && now_ms > g_tui_last_frame_ms && now_ms - g_tui_last_frame_ms < 120 {
        return false;
    }
    tui_render();
    g_tui_last_frame_ms = now_ms;
    if g_tui_run == TUI_RUN_IDLE {
        g_tui_idle_frames = g_tui_idle_frames + 1;
    } else {
        g_tui_idle_frames = 0;
    }
    return true;
}
