// src/term/wincon.uya — Windows 平台接缝（控制台输入 / 尺寸 / 环境块）
//
// 本文件：Agent 在 **Windows 目标**上唯一碰 Win32 的地方。给上层四件东西：
//   `wincon_startup`（进 TUI 前的准备：控制台模式、代码页、环境块修正）、
//   `wincon_is_console`（stdin 是不是真控制台）、`wincon_read`（**永不阻塞**的
//   读 stdin）、`wincon_size`（窗口列/行）、`wincon_restore`（退出还原）。
//
// 不变量：
//   ① **`wincon_read` 永不阻塞** —— 返回 `-1` 表示「本轮没有数据」（与 POSIX 的
//      EAGAIN 同义），`0` 只表示真 EOF（重定向的管道读完）。上层所有的读循环都靠
//      这条语义，谁把它改成阻塞，TUI 就会在等键时冻住整条事件循环；
//   ② **非 Windows 目标下这里的每个函数都不改变行为** —— `wincon_read` 一律
//      返回 -1（「没有数据」），于是调用方退回它自己的 POSIX 路径。这样共享源码
//      只需要一处 `wincon_read` 调用，不需要到处写 `std.cfg`；
//   ③ 环境块修正**必须在读任何配置之前**做（见 `wincon_startup` 的注释）。
//
// 依赖：libc（无）；平台垫片 src/cshim/win32_agent.h（`std.cfg` 里声明，只在
//   Windows 目标下存在）；std.runtime.saved_envp（环境块修正的落点）。
// 命名：`wincon_*` / `WINCON_*`。
//
// 为什么单开一个文件：本仓的分层里 term/ 是「终端交互层」，而上层（tty / hook /
// clipt / inp）不该知道 Win32 长什么样。把 `std.cfg(std.target_os == .tos_windows, …)`
// 集中到这里一处，其它文件只看见「读一批字节」这个形状（与 uya-term 的
// `pty/winpty.uya` 同一手法 —— 那一套已经在真机上验过）。

use std;
use std.runtime.saved_envp;

// Windows 目标的平台垫片。非 Windows 目标下这些声明整块不存在（编译期丢弃），
// 函数体里的调用点随之变成死代码 —— 这是 `std.cfg` 的既定用法。
std.cfg(std.target_os == .tos_windows, {
    extern "libc" fn uya_win_prepare() i32;
    extern "libc" fn uya_win_restore() void;
    extern "libc" fn uya_win_envp() &&byte;
    extern "libc" fn uya_win_is_console() i32;
    extern "libc" fn uya_win_timer_period() i32;
    extern "libc" fn uya_win_read(buf: &byte, cap: i32, timeout_ms: i32) i32;
    extern "libc" fn uya_win_size(out: &i32) i32;
    extern "libc" fn uya_win_clip_kind() i32;
    extern "libc" fn uya_win_clip_text(buf: &byte, cap: i32) i32;
    extern "libc" fn uya_win_clip_dib(buf: &byte, cap: i32) i32;
})

// 本二进制是不是 Windows 目标。**编译期常量**（`std.cfg` 在解析期就把另一支丢掉），
// 所以 `if wincon_target() { … }` 里那一段在 Linux 构建里是死代码。
export fn wincon_target() bool {
    std.cfg(std.target_os == .tos_windows, {
        return true;
    }, {
        return false;
    })
}

// 启动准备：环境块 + 控制台模式 + 代码页。返回 true = 输出侧可用（Windows 上
// 恒 true：没有控制台也会申请一个）。
//
// **环境块为什么必须先修**：Uya 运行时按 POSIX 的「argv + argc + 1」取 envp，
// Windows 的 CRT 不保证这个邻接布局 —— 实测取到空指针，于是 `getenv` 对**任何**
// 变量都返回 null：`HOME` / `USERPROFILE`（会话落盘目录）、`PATH`（工具查找）、
// `DEEPSEEK_API_KEY`（凭据）全都取不到。修正之后一切照旧。
export fn wincon_startup() bool {
    std.cfg(std.target_os == .tos_windows, {
        const rebuilt: &(&byte) = uya_win_envp();
        if rebuilt != null {
            saved_envp = rebuilt;
        }
        return uya_win_prepare() != 0;
    }, {
        return false;
    })
}

// 退出还原（正常 / 错误两条路径都要调）。
export fn wincon_restore() void {
    std.cfg(std.target_os == .tos_windows, {
        uya_win_restore();
    }, {})
}

// stdin 是不是真控制台（管道 / 文件 / 计划任务重定向都是假）。
export fn wincon_is_console() bool {
    std.cfg(std.target_os == .tos_windows, {
        return uya_win_is_console() != 0;
    }, {
        return false;
    })
}

// 读 stdin（**永不阻塞**）。
// 参数：buf/cap 为缓冲区；timeout_ms 为最多等多久（0 = 纯探测）。
// 返回：>0 字节数；0 = EOF（仅重定向场景）；-1 = 本轮没有数据（= EAGAIN）。
export fn wincon_read(buf: &byte, cap: usize, timeout_ms: i32) isize {
    std.cfg(std.target_os == .tos_windows, {
        const n: i32 = uya_win_read(buf, cap as i32, timeout_ms);
        return n as isize;
    }, {
        return 0 - 1 as isize;
    })
}

// 窗口尺寸（列 / 行）。成功返回 true。
export fn wincon_size(cols: &usize, rows: &usize) bool {
    std.cfg(std.target_os == .tos_windows, {
        var out: [i32: 2] = [0: 2];
        if uya_win_size(&out[0]) == 0 {
            // 没有真控制台（重定向 / 服务）：调用方按缺省 80x24 兜底。
            return false;
        }
        cols[0] = out[0] as usize;
        rows[0] = out[1] as usize;
        return true;
    }, {
        return false;
    })
}

// 时钟粒度是否拿到了 1ms（0 = 没拿到）。Windows 的默认定时器粒度是 15.6ms，
// 事件循环的 tick 会被放大一倍；`wincon_startup` 会 `timeBeginPeriod(1)`。
// 非 Windows 目标恒 1（POSIX 的 sleep 本来就是毫秒级）。
export fn wincon_timer_period() i32 {
    std.cfg(std.target_os == .tos_windows, {
        return uya_win_timer_period();
    }, {
        return 1;
    })
}

// 空设备名的**字节数与内容**写进 `out`，返回长度；`out` 不够返回 0。
//
// 为什么要这一条：POSIX 的空设备是 `/dev/null`，Windows 是 `NUL`（**没有** `/dev/null`，
// `fopen("/dev/null")` 在那里直接失败）。进程里凡是要「把噪声丢掉」的地方（TLS 握手
// 静音、子进程的 stdin）都得用平台自己的名字，否则那段逻辑在 Windows 上会**静默不生效**
// —— 实测现象：静音窗口进不去，`tls` 的 `[HS] ...` 直接刷屏，而自测里
// 「`err_fd()` 不该还是 2」那条红。
export fn wincon_null_device(out: &byte, cap: usize) usize {
    var n: usize = 9;
    if wincon_target() {
        n = 3;
    }
    if cap < n + 1 {
        return 0;
    }
    if wincon_target() {
        out[0] = 78 as byte;      // 'N'
        out[1] = 85 as byte;      // 'U'
        out[2] = 76 as byte;      // 'L'
    } else {
        out[0] = 47 as byte;      // '/'
        out[1] = 100 as byte;     // 'd'
        out[2] = 101 as byte;     // 'e'
        out[3] = 118 as byte;     // 'v'
        out[4] = 47 as byte;      // '/'
        out[5] = 110 as byte;     // 'n'
        out[6] = 117 as byte;     // 'u'
        out[7] = 108 as byte;     // 'l'
        out[8] = 108 as byte;     // 'l'
    }
    out[n] = 0;                   // `sys_open` 吃 C 串语义
    return n;
}

// 剪贴板里有什么：0 = 空 / 不认识，1 = 只有文本，2 = 有图。
// 非 Windows 目标恒 0（那两条来源在 media/clipx 与 media/cliphelp 里）。
export fn wincon_clip_kind() i32 {
    std.cfg(std.target_os == .tos_windows, {
        return uya_win_clip_kind();
    }, {
        return 0;
    })
}

// 读剪贴板文本（UTF-8）。返回字节数；-1 = 打开剪贴板失败。
export fn wincon_clip_text(buf: &byte, cap: usize) isize {
    std.cfg(std.target_os == .tos_windows, {
        return uya_win_clip_text(buf, cap as i32) as isize;
    }, {
        return 0 - 1 as isize;
    })
}

// 读剪贴板位图的**原始 CF_DIB 字节**。返回字节数；0 = 没有位图；
// -1 = 打开失败；-2 = 缓冲不够（调用方按「太大」明确拒绝，绝不截断）。
export fn wincon_clip_dib(buf: &byte, cap: usize) isize {
    std.cfg(std.target_os == .tos_windows, {
        return uya_win_clip_dib(buf, cap as i32) as isize;
    }, {
        return 0 - 1 as isize;
    })
}
