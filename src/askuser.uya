// src/askuser.uya — ask_user_question / 终端问答（P8）
//
// 交互模式下复用 tty 的行编辑器；非交互（stdin 是管道）就读一行；
// 读到 EOF 时返回「无回答」而不是挂死（DSH 的 dismissed 语义）。

use libc.syscall;
use libc.unistd;

export fn ask_write(p: &const byte) bool {
    tty_stream_write(2, p as &const byte, bufx_cstr_len(p));
    return true;
}

// 读一行（回车结束）。返回 1=拿到一行 0=EOF
fn ask_read_line(out: &Buf) i32 {
    buf_reset(out);
    if tty_is_interactive() {
        tty_line_clear(&tty_ui);
        tty_set_prompt(&tty_ui, "");
        tty_draw_line(&tty_ui, 2);
        while true {
            const ev: i32 = tty_next_event(&tty_ui);
            if ev == TTY_EV_SUBMIT {
                _ = buf_append(out, tty_ui.line.ptr, tty_ui.line.len);
                tty_line_clear(&tty_ui);
                tty_puts(&tty_ui, 2, "\n");
                return 1;
            }
            if ev == TTY_EV_EOF {
                tty_line_clear(&tty_ui);
                return 0;
            }
            if tty_has_pending(&tty_ui) {
                tty_feed(&tty_ui, null as &const byte, 0);
                tty_flush_esc(&tty_ui);
                continue;
            }
            var tmp: [byte: 128] = [0: 128];
            const n: isize = sys_read(0, &tmp[0], 128) catch { -1 as isize; };
            if n <= 0 {
                return 0;
            }
            tty_feed(&tty_ui, &tmp[0], n as usize);
            tty_flush_esc(&tty_ui);
            tty_draw_line(&tty_ui, 2);
        }
    }
    var tmp2: [byte: 256] = [0: 256];
    while true {
        const n: isize = sys_read(0, &tmp2[0], 256) catch { -1 as isize; };
        if n <= 0 {
            return 0;
        }
        const un: usize = n as usize;
        var i: usize = 0;
        while i < un {
            if tmp2[i] == 10 as byte {
                tty_stream_write(2, "\n" as &const byte, 1);
                return 1;
            }
            _ = buf_append_byte(out, tmp2[i]);
            i = i + 1;
        }
    }
}

// y/N；返回 1=是 0=否 2=无输入渠道
export fn ask_read_yes_no() i32 {
    var line: Buf = buf_new(64);
    defer { buf_free(&line); }
    const got: i32 = ask_read_line(&line);
    if got == 0 {
        return 2;
    }
    if line.len == 0 {
        return 0;
    }
    const c: byte = line.ptr[0];
    if c == 121 as byte || c == 89 as byte {
        return 1;
    }
    if line.len >= 3 && bufx_mem_eq(line.ptr as &const byte, "yes", 3) {
        return 1;
    }
    return 0;
}

// ask_user_question 工具
export fn ask_tool_question(args: &const JsonValue, out: &Buf) void {
    var qs: JsonValue = JsonValue.json_null();
    if !js_obj_get(args, "questions", 9, &qs) || js_arr_len(&qs) == 0 {
        _ = buf_append_cstr(out, "Error: questions must be a non-empty array");
        return;
    }
    _ = buf_append_cstr(out, "{\"answers\":[");
    const n: usize = js_arr_len(&qs);
    var i: usize = 0;
    while i < n {
        var q: JsonValue = JsonValue.json_null();
        if !js_arr_get(&qs, i, &q) {
            i = i + 1;
            continue;
        }
        var id: Buf = buf_empty();
        defer { buf_free(&id); }
        var qtext: Buf = buf_empty();
        defer { buf_free(&qtext); }
        _ = js_obj_get_str_unescaped(&q, "id", 2, &id);
        _ = js_obj_get_str_unescaped(&q, "question", 8, &qtext);
        // 渲染
        _ = ask_write("\n");
        if qtext.len > 0 {
            tty_stream_write(2, qtext.ptr as &const byte, qtext.len);
            _ = ask_write("\n");
        }
        var opts: JsonValue = JsonValue.json_null();
        var nopt: usize = 0;
        if js_obj_get(&q, "options", 7, &opts) {
            nopt = js_arr_len(&opts);
            var k: usize = 0;
            while k < nopt {
                var o: JsonValue = JsonValue.json_null();
                if js_arr_get(&opts, k, &o) {
                    var label: Buf = buf_empty();
                    defer { buf_free(&label); }
                    var desc: Buf = buf_empty();
                    defer { buf_free(&desc); }
                    _ = js_obj_get_str_unescaped(&o, "label", 5, &label);
                    _ = js_obj_get_str_unescaped(&o, "description", 11, &desc);
                    _ = ask_write("  ");
                    var numbuf: Buf = buf_new(16);
                    defer { buf_free(&numbuf); }
                    _ = buf_append_u64(&numbuf, (k + 1) as u64);
                    tty_stream_write(2, numbuf.ptr as &const byte, numbuf.len);
                    _ = ask_write(") ");
                    tty_stream_write(2, label.ptr as &const byte, label.len);
                    if desc.len > 0 {
                        _ = ask_write(" — ");
                        tty_stream_write(2, desc.ptr as &const byte, desc.len);
                    }
                    _ = ask_write("\n");
                }
                k = k + 1;
            }
        }
        _ = ask_write("> ");
        var line: Buf = buf_new(1024);
        defer { buf_free(&line); }
        const got: i32 = ask_read_line(&line);
        if i > 0 {
            _ = buf_append_cstr(out, ",");
        }
        _ = buf_append_cstr(out, "{\"id\":");
        _ = jw_str_into(out, id.ptr as &const byte, id.len);
        _ = buf_append_cstr(out, ",\"selected\":[");
        if got == 0 {
            // 没有输入渠道：明确告诉模型「没有回答」
            _ = buf_append_cstr(out, "],\"custom\":\"(no answer channel: the user could not be asked)\"}");
            i = i + 1;
            continue;
        }
        if nopt > 0 && line.len == 1 && is_digit(line.ptr[0]) {
            const pick: usize = (line.ptr[0] as usize) - 48;
            if pick >= 1 && pick <= nopt {
                var o2: JsonValue = JsonValue.json_null();
                if js_arr_get(&opts, pick - 1, &o2) {
                    var label2: Buf = buf_empty();
                    defer { buf_free(&label2); }
                    _ = js_obj_get_str_unescaped(&o2, "label", 5, &label2);
                    _ = jw_str_into(out, label2.ptr as &const byte, label2.len);
                }
            }
            _ = buf_append_cstr(out, "]}");
        } else if line.len > 0 {
            _ = buf_append_cstr(out, "],\"custom\":");
            _ = jw_str_into(out, line.ptr as &const byte, line.len);
            _ = buf_append_cstr(out, "}");
        } else {
            _ = buf_append_cstr(out, "]}");
        }
        i = i + 1;
    }
    _ = buf_append_cstr(out, "]}");
}
