// src/web/dshget.uya — 把 DSH 的资源**取到本地**（P80，工作项⑧）
//
// 本文件：`dshget_*` —— 按 `--dsh-assets-install` 的意图，用**系统工具**把
//   `@deepseek-ai/dsh` 装到 `--dsh-assets-dir`，产出 `dwh_find_root` 认的那种布局
//   （`<dir>/node_modules/@deepseek-ai/dsh-web-frontend/dist` 等），于是**本机没装
//   DSH 也能用** `--dsh-web`。
// 不变量：① **解压一律交给系统工具**（`npm` 取件、`tar -zxf` 解包）：gzip/zstd/xz
//   这些格式里没有一个该由本仓实现（写 inflate 是几百行且是**纯负债**）——
//   用户的发行版一定有 `tar`，而取件本身（网络、缓存、校验、镜像）也早被 `npm`
//   做透了。本仓只做**编排**：把命令拼对、把结果摊到该在的位置、把失败如实报出来。
//   ② **不静默降级**：任何一步失败都要把**那一步**的 stderr 原样带出来（取件失败最
//   常见的原因是网络与权限，而它们的线索只在 stderr 里）；宁可整条失败，也不要
//   留下半份资源让 `--dsh-assets` 指向它。
//   ③ **不碰已装的那份**：一切写入只在 `--dsh-assets-dir` 底下（`--dsh-web` 那条
//   「只读 DSH」的纪律在安装这条路上同样适用，只是允许写**我们自己的**目录）。
//
// 依赖：libc.syscall/unistd（fork/exec/pipe/wait/access）、std.runtime.saved_envp、
//   session/sigx（子进程信号复位）、tools/shellx（sh_child_detach_stdio）、
//   foundation/bufx；本文件不依赖 web/whost（安装与「怎么服务」是两件事）。
// 命名：`dshget_*`（对外）+ `DSHGET_*`（常量与步骤码）；内部件一律 `dshget_` 前缀。

use libc.syscall;
use libc.unistd;
use std.runtime.saved_envp;

// 取件的默认包（DSH 的入口包；它的依赖里带前端与全部 client 包）。
const DSHGET_PKG: &const byte = "@deepseek-ai/dsh" as &const byte;

// 一条命令的超时（毫秒）。npm 装 540 个包实测约 60 秒，给足余量。
const DSHGET_TIMEOUT_MS: u64 = 600000;
// 收集输出的上限（够放下 npm 的错误信息；超了截断并置标志）。
const DSHGET_OUT_CAP: usize = 65536;
// 轮询间隔（与全仓其它阻塞循环的 ≤50ms 泵点纪律同口径）。
const DSHGET_POLL_MS: i32 = 50;

// 取件的结果（**结构化**：调用方据此拼文案，不解析字符串）。
export struct DshGet {
    ok: bool,
    code: i32,          // 系统工具/子进程的退出码（0 = 成功）
    stage: u8,          // 失败发生在哪一步（见 DSHGET_ST_*）
    out: Buf,           // 那一步的 stdout（成功时是 npm 的摘要）
    err: Buf,           // 那一步的 stderr（**失败时是最该看的东西**）
}

// 失败发生在哪一步。分档是为了让文案指向**那一步**，而不是笼统的「安装失败」。
export const DSHGET_ST_OK: u8 = 0;
export const DSHGET_ST_NO_TOOL: u8 = 1;      // PATH 里找不到 npm/tar
export const DSHGET_ST_FETCH: u8 = 2;        // npm 取件失败（网络/权限/包名）
export const DSHGET_ST_UNPACK: u8 = 3;       // tar 解包失败
export const DSHGET_ST_LAYOUT: u8 = 4;       // 解出来的东西不是我们认的布局

// 扫 PATH 找可执行文件的完整路径（`execve` 只吃路径，stdlib 里没有 execvp）。
// 找不到时返回 false，`out` 保持空。**幂等**（每次调用都重扫；安装是个一次性动作，
// 不值得为它加一份 memo）。
export fn dshget_which(exe: &const byte, out: &Buf) bool {
    buf_reset(out);
    const path: &byte = getenv("PATH" as &const byte);
    if (path as usize) == 0 || bufx_cstr_len(path) == 0 {
        return false;
    }
    const el: usize = bufx_cstr_len(exe);
    var seg: usize = 0;
    while true {
        // 一段 PATH：从 seg 起到下一个 `:`（或结尾）
        var e: usize = seg;
        while path[e] != 58 as byte && path[e] != 0 as byte {
            e = e + 1;
        }
        const seglen: usize = e - seg;
        if seglen > 0 {
            buf_reset(out);
            if !buf_append(out, &path[seg], seglen) {
                return false;
            }
            if !buf_append_byte(out, 47) {
                return false;
            }
            if !buf_append(out, exe, el) {
                return false;
            }
            if !buf_append_byte(out, 0) {
                return false;
            }
            // 可执行吗（X_OK 只问执行位，不要求是普通文件）
            if (sys_access(out.ptr as &const byte, 1) catch { -1; }) == 0 {
                return true;
            }
        }
        if path[e] == 0 as byte {
            break;
        }
        seg = e + 1;
    }
    buf_reset(out);
    return false;
}

// 跑一条命令、收 stdout/stderr、等它结束，返回退出码（负数 = 起不来）。
//
// 与 `gitx_run` 同形（同样的 fork/exec/detach_stdio/waitpid），差别只在
// **可执行文件由调用方给**（那个是 git 专用）。不抽公共件是因为两边的
// 「输出怎么收、超时怎么算、子进程怎么收尾」各有各的取舍，硬合并会把两边都变糊。
fn dshget_run(exe_z: &const byte, cwd_z: &const byte, argv: &(&const byte),
              out: &Buf, err: &Buf) i32 {
    buf_reset(out);
    buf_reset(err);
    var op: [i32: 2] = [0: 2];
    var ep: [i32: 2] = [0: 2];
    if (sys_pipe2(&op[0], 0) catch { -1; }) != 0 {
        return -1;
    }
    if (sys_pipe2(&ep[0], 0) catch { -1; }) != 0 {
        _ = sys_close(op[0]) catch {};
        _ = sys_close(op[1]) catch {};
        return -1;
    }
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(op[0]) catch {};
        _ = sys_close(op[1]) catch {};
        _ = sys_close(ep[0]) catch {};
        _ = sys_close(ep[1]) catch {};
        return -1;
    };
    if pid64 == 0 {
        // 子进程：只做系统调用。信号处置是**继承**的 —— 必须先复位，否则它收到
        // TERM 会去写父进程的终端（与 shellx / gitx 同一条纪律）。
        _ = sys_close(op[0]) catch {};
        sigx_reset_for_child();
        // 不给终端（stdin=/dev/null + 自成会话）：npm 会问凭据、tar 会问覆盖，
        // 而它们问的对象是该由我们决定的东西（见两条命令各自的 flag）。
        sh_child_detach_stdio();
        _ = sys_close(ep[0]) catch {};
        _ = sys_dup2(op[1], 1) catch {};
        _ = sys_dup2(ep[1], 2) catch {};
        _ = sys_close(op[1]) catch {};
        _ = sys_close(ep[1]) catch {};
        if cwd_z != null && cwd_z[0] != 0 as byte {
            _ = sys_chdir(cwd_z as *const byte) catch {};
        }
        _ = sys_execve(exe_z, argv, &saved_envp[0]) catch {};
        sys_exit(127);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(op[1]) catch {};
    _ = sys_close(ep[1]) catch {};
    return dshget_drain(pid, op[0], ep[0], out, err);
}

// 读两根管子直到子进程结束（带超时）。返回退出码。
//
// **顺序有讲究**：先把 stdout 读到 EOF 再读 stderr —— 两条都不读会死锁（子进程写满
// 管道就停住），而 npm 的输出量不小。这里的取舍是「先把主的读完」，因为 npm/tar 的
// 诊断几乎都走 stderr 且量不大（<= 64KB 的管道缓冲足够它写完再退出）。
fn dshget_drain(pid: i32, ofd: i32, efd: i32, out: &Buf, err: &Buf) i32 {
    var pfds: [PollFd: 2] = [
        PollFd{ fd: ofd, events: POLLIN, revents: 0 },
        PollFd{ fd: efd, events: POLLIN, revents: 0 },
    ];
    var chunk: [byte: 8192] = [0: 8192];
    const t0: u64 = dshget_now_ms();
    var timed: bool = false;
    var open_o: bool = true;
    var open_e: bool = true;
    while open_o || open_e {
        if dshget_now_ms() - t0 > DSHGET_TIMEOUT_MS {
            timed = true;
            break;
        }
        pfds[0].revents = 0;
        pfds[1].revents = 0;
        const pr: i32 = sys_poll(&pfds[0], 2, DSHGET_POLL_MS) catch { 0; };
        if pr <= 0 {
            continue;
        }
        var which: usize = 0;
        while which < 2 {
            const rev: i16 = pfds[which].revents;
            const fd: i32 = pfds[which].fd;
            const hot: bool = (rev & POLLIN) != 0 || (rev & POLLHUP) != 0
                || (rev & POLLERR) != 0;
            if hot {
                // 行宽豁免：catch 的兜底值不能断行
                const n: isize = sys_read(fd, &chunk[0], 8192) catch { 0 as isize; };
                if n > 0 {
                    if which == 0 {
                        dshget_append_capped(out, &chunk[0], n as usize);
                    } else {
                        dshget_append_capped(err, &chunk[0], n as usize);
                    }
                } else if which == 0 {
                    open_o = false;
                } else {
                    open_e = false;
                }
            }
            which = which + 1;
        }
    }
    _ = sys_close(ofd) catch {};
    _ = sys_close(efd) catch {};
    var st: i32 = 0;
    _ = sys_waitpid(pid, &st, 0) catch {};
    if timed {
        return -2;      // 超时：调用方报「卡住了」而不是「失败了」
    }
    // 退出码：`st >> 8` 是 exit(n)，低 7 位是信号
    if (st & 127) != 0 {
        return -3;      // 被信号打死
    }
    return (st >> 8) & 255;
}

// 往 `dst` 追加但不超过 `DSHGET_OUT_CAP`（超了丢弃尾部；错误信息总在开头）。
fn dshget_append_capped(dst: &Buf, p: &const byte, n: usize) void {
    if dst.len >= DSHGET_OUT_CAP {
        return;
    }
    var take: usize = n;
    if dst.len + take > DSHGET_OUT_CAP {
        take = DSHGET_OUT_CAP - dst.len;
    }
    _ = buf_append(dst, p, take);
}

// 毫秒时钟（`gitx`/`shellx` 同款：本仓的公共时钟入口）。
fn dshget_now_ms() u64 {
    var tv: TimeVal = TimeVal{ tv_sec: 0, tv_usec: 0 };
    const r: !i32 = sys_gettimeofday(&tv, null as &void);
    const rc: i32 = r catch { -1; };
    if rc != 0 {
        return 0 as u64;
    }
    return (tv.tv_sec as u64) * 1000 + ((tv.tv_usec as u64) / 1000);
}

// ============================================================
// 安装编排（工作项⑧）
// ============================================================

// 把 DSH 的资源装到 `dir`。步骤（**全用系统工具**，见文件头不变量①）：
//   ① `npm install --prefix <dir> --no-audit --no-fund @deepseek-ai/dsh`
//      —— 取件 + 解包 + 摊平布局，一步到位（npm 自己会解 tgz，所以本仓
//      **不需要 tar/gzip 的任何代码**；这是这条路最关键的一处省法）。
//   ② 校验产出的布局（`<dir>/node_modules/@deepseek-ai/dsh-web-frontend/dist`）。
//
// 只有 `--dsh-assets-dir` 底下会被写；`dir` 必须是**绝对路径**（相对路径在
// chdir 之后含义会变，而这里要 fork 子进程）。
export fn dshget_install(g: &DshGet, dir: &const byte, dl: usize) void {
    buf_reset(&g.out);
    buf_reset(&g.err);
    g.ok = false;
    g.code = 0;
    g.stage = DSHGET_ST_OK;
    if dir == null || dl == 0 || dl > 3500 {
        g.stage = DSHGET_ST_LAYOUT;
        return;
    }
    var npm: Buf = buf_new(1024);
    defer { buf_free(&npm); }
    if !dshget_which("npm" as &const byte, &npm) {
        g.stage = DSHGET_ST_NO_TOOL;
        _ = buf_append_cstr(&g.err, "PATH 里找不到 npm（取件要靠它；装一个 Node.js 再来）");
        return;
    }
    // 目录要 NUL 结尾（`sys_execve` 与 `--prefix` 都吃 C 串语义）
    var dirz: Buf = buf_new(dl + 1);
    defer { buf_free(&dirz); }
    if !buf_append(&dirz, dir, dl) {
        return;
    }
    if !buf_append_byte(&dirz, 0) {
        return;
    }
    g.code = dshget_npm(g, &npm, dirz.ptr as &const byte);
    if g.code != 0 {
        g.stage = DSHGET_ST_FETCH;
        return;
    }
    if !dshget_layout_ok(dir, dl) {
        g.stage = DSHGET_ST_LAYOUT;
        return;
    }
    g.ok = true;
}

// 跑 npm 取件。**argv 逐项要为 NUL 结尾的 C 串**（execve 的硬要求）。
fn dshget_npm(g: &DshGet, npm: &const Buf, dirz: &const byte) i32 {
    const a0: &const byte = "npm" as &const byte;
    const a1: &const byte = "install" as &const byte;
    const a2: &const byte = "--prefix" as &const byte;
    const a3: &const byte = dirz;
    const a4: &const byte = "--no-audit" as &const byte;
    const a5: &const byte = "--no-fund" as &const byte;
    const a6: &const byte = "--no-save" as &const byte;
    const a7: &const byte = "--loglevel=error" as &const byte;
    const a8: &const byte = DSHGET_PKG;
    var argv: [&const byte: 10] = [
        &a0[0], &a1[0], &a2[0], &a3[0], &a4[0], &a5[0], &a6[0], &a7[0], &a8[0],
        null as &const byte,
    ];
    return dshget_run(npm.ptr as &const byte, null as &const byte, &argv[0],
        &g.out, &g.err);
}

// 产出布局校验：`<dir>/node_modules/@deepseek-ai/dsh-web-frontend/dist/index.html`
// 存在才算成功（与 `dwh_find_root` 的判据同源）。
fn dshget_layout_ok(dir: &const byte, dl: usize) bool {
    var p: Buf = buf_new(dl + 128);
    defer { buf_free(&p); }
    if !buf_append(&p, dir, dl) {
        return false;
    }
    // 行宽豁免：不可断的路径
    if !buf_append_cstr(&p, "/node_modules/@deepseek-ai/dsh-web-frontend/dist/index.html") {
        return false;
    }
    if !buf_append_byte(&p, 0) {
        return false;
    }
    return (sys_access(p.ptr as &const byte, 0) catch { -1; }) == 0;
}
