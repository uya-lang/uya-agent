// 把信封原文写进 out（调用方自己拼 `namespaces[].schema` 那个字段）。
export fn dwh_schema_json(out: &Buf) bool {
    if (!buf_append_cstr(out, DWH_SCHEMA_1)) {
        return false;
    }
    if (!buf_append_cstr(out, DWH_SCHEMA_2)) {
        return false;
    }
    if (!buf_append_cstr(out, DWH_SCHEMA_3)) {
        return false;
    }
    if (!buf_append_cstr(out, DWH_SCHEMA_4)) {
        return false;
    }
    if (!buf_append_cstr(out, DWH_SCHEMA_5)) {
        return false;
    }
    return true;
}
