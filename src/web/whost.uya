// src/web/whost.uya — DSH 前端的**产品侧宿主**：静态资源 + 启动注入 + 最小 `/api`
//
// 本文件：把「阶段 0 探针证成的那套东西」从 Python 搬进产品 —— 只读服务 DSH 自己那份
//   `dsh-web-frontend/dist`、复刻它的 `bootInjections()`（内联 queue 脚本 + 一个
//   parser-blocking bootstrap script + `window.__DSH_BOOT__`）、按**扫描出的 roster**
//   服务 `/plugins/<id>/client.js`、并把 `/api/*` 接到 `web/wsess.uya` 的译文上。
//   roster 与 boot 图的契约见 DESIGN §11.9.7（0.2.0 的 `batches`）。
// 不变量：① **一个字节都不改 DSH 的 dist**（`make link-audit` 那套纪律的延伸：我们
//   只读它、只服务它）；② **`/api` 的载体错与业务错分开**：HTTP 状态只表示载体
//   （404 未知路径 / 415 非 JSON / 400 非 JSON 体），未实现的方法回 **200 +
//   `RpcResult.error`** —— 客户端据此把那个面当「不支持」而不是「连接坏了」；
//   ③ **两条下行是真 WebSocket 且只发不收**（普通 GET 要回 426）：握手要 SHA-1 +
//   base64，帧编码只要「服务端→客户端、不掩码、text」这一种；
//   ④ **`session.create` 不能少**：实测 shell 的流程是「先 create 再画」，少了它页面
//   只剩 hero 空态、而**代码零报错**（唯一线索在浏览器控制台）；
//   ⑤ 本文件不许认识 `Config` / `g_sess`（它只做 HTTP 与 JSON，不碰执行核）。
// 依赖：libc（syscall/unistd/fcntl：socket/poll/read/write/close）、std.crypto.sha1、
//   std.encoding.base64、foundation/bufx、foundation/jsonx、net/httpsrv（`srv_*`）、
//   web/wsess（`dwire_*` 的译文）。
// 命名：对外 `dwh_*`（start / step / stop）+ 常量 `DWH_*`；类型 `DwhHost` / `DwhConn`。
//
// 行宽豁免：本文件里成片的**不可断 JSON 骨架字面量**与**DSH 的注入脚本**（内联 queue
// 脚本那一句 600+ 字符）—— 在中间换行会把 JSON/JS 拆坏，而它们要逐字节正确
// （`bootInjections` 的产物是协议的一部分，不是排版）。其余行一律 ≤80。
//
// 为什么它不直接用 net/httpsrv 的 `srv_recv_request`：那一条**只认 `Content-Length`**、
// 且整份请求（头+体）不得超过 `SRV_REQ_MAX`（8192）—— 对 `/api` 的 JSON 体够用，
// 但**Upgrade 请求不能用它**（那是一个没有 body、之后连接要改成帧流的请求）。
// 所以本文件自己收头（`dwh_read_head`），把「普通请求」与「升级请求」在收到头之后分开。
//
// **已实现的最小面**（够让 DSH 的 shell 起来、把一份会话画出来）：
//   GET  /                        index.html（注入后）
//   GET  /assets/* /favicon.svg … 真 dist 里的静态文件
//   GET  /plugins/<id>/client.js  该 client 包的 bundle（+ `.map`）
//   POST /api/<method>            host.describe / session.create / session.list /
//                                 session.history / session.models / workspace.list
//   GET  /api/events.mux          下行：会话事件（WebSocket）
//   GET  /api/events.host         下行：宿主帧（WebSocket）
// 其余方法一律回 200 + `internal` 业务错（如实说「没实现」，而不是假装成功）。

use libc.syscall;
use libc.unistd;
use libc.fcntl;
use std.crypto.sha1.sha1_digest;
use std.encoding.base64.encode_base64;
use std.encoding.base64.decode_base64;
use std.json.parser.parse;
use std.json.value.JsonValue;
use std.json.value.JsonStrView;
use std.json.encoder.JsonWriter;
use std.mem.arena.Arena;
use std.mem.arena.arena_init;
use std.mem.arena.arena_reset;
use std.mem.arena.arena_alloc;

// 连接上限（一个页面要 1 个长连接 + 若干短连接；32 够用且是显式边界）。
export const DWH_MAX_CONNS: usize = 32;
// 一次 poll 的等待上限（与全仓其它阻塞循环的 ≤50ms 泵点纪律同口径）。
const DWH_POLL_MS: i32 = 50;
// 请求头上限（`/api` 的体单独按 Content-Length 收，不受这个数限制）。
const DWH_HEAD_MAX: usize = 16384;

// 一条连接的阶段。
const DWH_C_HEAD: u8 = 0;      // 正在收请求头
const DWH_C_WS: u8 = 1;        // 已升级成 WebSocket 下行（只发不收）
const DWH_C_DONE: u8 = 2;      // 已响应，等收尾

export struct DwhConn {
    fd: i32,
    st: u8,
    // 这条连接开过的**所有**逻辑流的 streamId（`remote.mux` 的 `open` 里给的），
    // 每行一个（含 `\n`）。空 = 还没开过流。
    //
    // ⚠ 必须是**一份清单**而不是一个值：0.2.0 把**所有**流多路复用在同一
    // 条 WebSocket 上（实测：`session/follow`、`$events`、`session/control`
    // 三条 `open` 写在同一个 socket 上）。只记住「最后一条」时，宿主按
    // `session/follow` 找连接会找到一条**它的 sid 已经是 session/control** 的连接
    // ⇒ 找不到 ⇒ 活事件一帧都不推；而页面上的表现是「消息发出去了、答复不出来」
    // （实测：日志里答复在、单开 socket 的探针也能收到 —— 只有真浏览器那条路静默）。
    sids: Buf,
    rx: Buf,            // 已收到的字节（收头用）
    is_mux: bool,       // WS：是 mux 还是 host 下行
    is_remote: bool,    // WS：是 0.2.0 的 `remote.mux`（要**收发**，不是只发）
    remote_ready: bool, // 已回过 `$events` 那条 `ready`（幂等）
    sent: bool,         // WS：基线帧发过没有
}

// 宿主状态：监听 fd、dist 根、最小 roster 的包名（逗号分隔的成品串）。
export struct DwhHost {
    lfd: i32,
    dist: Buf,          // `<dsh 根>/node_modules/@deepseek-ai/dsh-web-frontend/dist`
    root: Buf,          // DSH 根（`node_modules` 的父目录）
    entries: Buf,       // 已解析好的 `{"rev":…,"entries":[…],"batches":[…]}`（boot 图）
    preloads: Buf,      // bootstrap 的 `<script src="…">` 片段（启动时算一次）
    events: Buf,        // 会话事件的译文（每行一条，喂 mux 下行用）
    token: Buf,         // 访问令牌（空 = 不校验；见 `dshauth.uya` 不变量①）
    // DSH 的设置根（`--dsh-home` / `$DSH_HOME` / `~/.dsh`）：模型目录从它读。
    dsh_home: Buf,
    conns: [DwhConn: DWH_MAX_CONNS],
    n: usize,
    // 一次泵里「已经干了活、该回 poll 了」的标记（见 `dwh_poll_once`）。
    stop_round: bool,
    // P80 第二十三批：**活会话**（没给事件源时起）。见 `dwhchild.uya`。
    //   live：开着没有（给了 `--dsh-web-events` / `UYA_AGENT_DSH_WEB_EVENTS` 就
    //     是**只读演示**模式 —— 那条路一个字节都不改）
    live: bool,
    child: DwhChild,
    // 模型目录与当前选择（`dwhmodel.uya`）。宿主是它的唯一持有者。
    model: DwhModel,
    // 某条 endpoint 上开过的**全部** streamId（每行一个，含 `\n`）。
    //   f_sid：`session/follow`（活事件走这条）
    //   e_sid：`$events`（`api-session/status` 这类宿主事件走这条）
    // 空 = 那条流还没开（此时不推，等它开了再说）。
    //
    // ⚠ 是**清单**而不是一个值：真实客户端会在同一条 WebSocket 上把
    // `session/follow` 开**好几次**（实测：一次加载里开了 3 条 —— 会话切换、
    // 重连、以及 shell 自己那次），而它只认最后那条。宿主只记「最新的一条」时，
    // 推出去的事件带着**旧 streamId**，客户端算到一条已经废弃的流上 ⇒ 页面上
    // 什么也不显示（实测：日志里答复在、单开 socket 的探针也能收到 —— 只有真
    // 浏览器那条路静默）。所以**按 endpoint 推给所有开过的流**。
    f_sid: Buf,
    e_sid: Buf,
    // 上一圈推给浏览器的事件水位（`h.events` 里已推到的字节偏移）。
    // **只增不减**：它同时是「哪些行已经发过」的唯一记账（重发会让客户端
    // 判重复、漏发会让它断流）。
    pushed: usize,
}

// ============================================================
// 小工具
// ============================================================

// 路径存在吗（`stat` 到就真）。
fn dwh_exists(p: &const byte) bool {
    const fd: i32 = sys_open(p as *const byte, 0, 0) catch { -1; };
    if fd < 0 {
        return false;
    }
    _ = sys_close(fd) catch {};
    return true;
}

// 读一整个文件进 out（上限 `limit`）。失败返回 false（out 内容无意义）。
fn dwh_read_file(path: &const byte, out: &Buf, limit: usize) bool {
    const fd: i32 = sys_open(path as *const byte, 0, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    buf_reset(out);
    var tmp: [byte: 32768] = [0: 32768];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 32768) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        if out.len + (n as usize) > limit {
            return false;      // 超限：宁可失败也不截断（截断的 JS/CSS 会更难查）
        }
        if !buf_append(out, &tmp[0], n as usize) {
            return false;
        }
    }
    return out.len > 0;
}

// 找 DSH 的安装根（与 `prompt.uya` 的 `preset_path` 同一套「常见位置」口径）。
// 判据是「那份 dist 在不在」—— 在就说明这个根能用。
fn dwh_find_root(out: &Buf, assets: &const byte, al: usize) bool {
    buf_reset(out);
    // ① `--dsh-assets DIR`（最高优先级）：直接摊平的资源目录。
    //    **它必须真的可用**（dist 在）—— 不满足就返回 false 让调用方报错，
    //    不静默往下走（理由见 agent.uya 里那个 flag 的注释）。
    //
    // ⚠ `assets` 是 `Buf` 的内容（**没有 NUL 结尾**）：这里必须按 `al` 用，
    // 不能当 C 串 —— 当 C 串会一路读到相邻内存（实测：`--dsh-assets /a/b/dsh`
    // 拼成了 `/a/b/dsh-74a3-4f76-b28e-0e657fda`，把工作区名接了上去）。
    // `dwh_dist_ok` 只吃 `Buf`，所以这里先把 `al` 个字节装进 out。
    if (assets as usize) != 0 && al > 0 {
        if !buf_append(out, assets, al) {
            return false;
        }
        if dwh_dist_ok(out) {
            return true;
        }
        out_err("error: --dsh-assets 指的目录里没有 DSH 的 dist：");
        _ = srv_write_all(2, assets, al);
        out_err("\n");
        return false;
    }
    const env: &byte = getenv("UYA_AGENT_DSH_ROOT" as &const byte);
    if (env as usize) != 0 && bufx_cstr_len(env) > 0 {
        if !buf_append_cstr(out, env) {
            return false;
        }
        return dwh_dist_ok(out);
    }
    const home: &byte = getenv("HOME" as &const byte);
    if (home as usize) == 0 {
        return false;
    }
    var cand: Buf = buf_new(1024);
    defer { buf_free(&cand); }
    _ = buf_append_cstr(&cand, home);
    _ = buf_append_cstr(&cand, "/.npm-global/lib/node_modules/@deepseek-ai/dsh");
    if dwh_dist_ok(&cand) {
        return buf_append(out, cand.ptr as &const byte, cand.len);
    }
    buf_reset(&cand);
    _ = buf_append_cstr(&cand, home);
    _ = buf_append_cstr(&cand, "/.local/lib/node_modules/@deepseek-ai/dsh");
    if dwh_dist_ok(&cand) {
        return buf_append(out, cand.ptr as &const byte, cand.len);
    }
    return false;
}

// 这个根里的 dist 在不在（拼出 index.html 判存在）。
fn dwh_dist_ok(root: &const Buf) bool {
    var p: Buf = buf_new(1200);
    defer { buf_free(&p); }
    if !buf_append(&p, root.ptr as &const byte, root.len) {
        return false;
    }
    _ = buf_append_cstr(&p, "/node_modules/@deepseek-ai/dsh-web-frontend/dist/index.html");
    _ = buf_append_byte(&p, 0);
    return dwh_exists(p.ptr as &const byte);
}

// 一个 client 包的 `lib/client.js` 路径（`exports["./client"]` 在 DSH 里恒为这个位置）。
fn dwh_client_path(root: &const Buf, pkg: &const byte, n: usize, out: &Buf) bool {
    buf_reset(out);
    if !buf_append(&out[0], root.ptr as &const byte, root.len) {
        return false;
    }
    if !buf_append_cstr(&out[0], "/node_modules/") {
        return false;
    }
    if !buf_append(&out[0], pkg, n) {
        return false;
    }
    if !buf_append_cstr(&out[0], "/lib/client.js") {
        return false;
    }
    // ⚠ **NUL 结尾**：这个路径每个调用方都直接喂给 `sys_open`（C 串语义），而
    // `buf_append_cstr` 只按长度追加、不补 NUL。漏了它，`sys_open` 会读到缓冲区
    // 后面的字节 —— 症状极其难查：**头几个包成功、后面全失败**（新建的缓冲恰好是
    // 零页就成功，复用/扩容过的就不是了；实测 roster 里前 3 个 ok、其余 11 个 FAIL）。
    return buf_append_byte(&out[0], 0);
}

// 12 位十六进制的小哈希（DSH 用 sha1 前 12 位做 bundle rev 与 cache-busting）。
// 这里只要求「内容变了 rev 就变」，所以用 sha1 的前 6 字节转 hex。
fn dwh_rev_of(p: &const byte, n: usize, out: &Buf) bool {
    var d: [byte: 20] = [0: 20];
    sha1_digest(p[0: n], d[0: 20]);
    buf_reset(out);
    const hex: &[byte] = &"0123456789abcdef"[0: 16];
    var i: usize = 0;
    while i < 6 {
        const b: byte = d[i];
        if !buf_append_byte(out, hex[((b as i32) >> 4) as usize]) {
            return false;
        }
        if !buf_append_byte(out, hex[((b as i32) & 15) as usize]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ============================================================
// boot 图（roster 由**扫描**得出，不写死）
// ============================================================

// roster 上限（0.2.0 实测 71 个带 `lib/client.js` 的包；留一倍余量防未来增长）。
const DWH_ROSTER_MAX: usize = 160;
// 一个包名的上限（DSH 的实测最长约 50 字符；留余量）。
const DWH_PKG_MAX: usize = 128;
// `@deepseek-ai` 作用域目录名（roster 的扫描根，见 `dwh_scan_roster`）。
const DWH_SCOPE: &const byte = "@deepseek-ai" as &const byte;

// 一条 roster 记录：包名 + 它的 `lib/client.js` 内容哈希（rev）。
// **一条记录一个缓冲**（包名 `\0` rev `\0` inject `\0` 交错），不是平行数组：
// 平行数组要求「每个数组的格位」与「名字数组的字节偏移」对齐，而 rev 恒为
// 12 字符、包名却长短不一 —— 用同一个 `off` 去索引两边**必然错位**（实测症状：
// bootstrap 那段 `<script src=…?rev=>` 里 **rev 是空的**，而 entries 里是对的）。
// 交错之后「读一条 = 走三个 `\0`」，不变量只剩一条。
//
// 第三段 `inject` 是 `package.json` 的 `dsh.client.inject` 原文（一个 JSON 数组）。
// **为什么必须有它**：客户端的激活判据是「声明的服务都在了才 apply」，而「声明」
// 就从这一行读（它不认识包装了什么服务）。不发这个字段 ⇒ 每个依赖服务的插件都
// 停在 `pending (waiting for services: …)`，实测 35 个 entries 不激活、页面半死
// （`data-slot` 一个都没有，而**控制台只有一个 "did not activate" 的汇总错**）。
export struct DwhRoster {
    recs: Buf,        // 每条：包名 `\0` rev `\0` inject `\0`
    n: usize,
}

// 扫描出 roster：`<root>/node_modules/@deepseek-ai/<pkg>/lib/client.js` 存在即入选。
//
// **为什么扫目录而不是读 `package.json` 的 `dsh.client`**：实测两者**完全等价** ——
// 0.2.0 里「有 `lib/client.js`」的 71 个包 == 「声明了 `dsh.client`」的 71 个包，
// 两个方向的差集都是空。扫目录省掉一个 JSON 解析器与一份冗余判据（`exports["./client"]`
// 在 DSH 里恒为 `lib/client.js`，见 `dwh_client_path`）。
//
// **顺序**：getdents64 的顺序由文件系统定，而 boot 图的顺序**不承载语义**
// （客户端按 `inject` 依赖图自己拓扑排序，见它的 `orderEntries`）。所以这里不排序，
// 只要求「同一次运行内稳定」。rev 也在这里顺手算掉（反正要读文件校验）。
fn dwh_scan_roster(h: &DwhHost, r: &DwhRoster) bool {
    buf_reset(&r.recs);
    r.n = 0;
    var dir: Buf = buf_new(1200);
    defer { buf_free(&dir); }
    if !dwh_scope_dir(&h.root, &dir) {
        return false;
    }
    const fd: i32 = sys_open(dir.ptr as &const byte, (O_RDONLY | O_DIRECTORY) as i32, 0) catch {
        return false;      // 没有作用域目录 ⇒ 没装 DSH 的 client 包
    };
    defer { _ = sys_close(fd) catch {}; }
    var ents: [byte: 32768] = [0: 32768];
    var bundle: Buf = buf_new(4194304);
    defer { buf_free(&bundle); }
    var path: Buf = buf_new(1200);
    defer { buf_free(&path); }
    var rev: Buf = buf_new(32);
    defer { buf_free(&rev); }
    while r.n < DWH_ROSTER_MAX {
        const rc: isize = sys_getdents64(fd, &ents[0], 32768) catch {
            break;
        };
        if rc <= 0 {
            break;
        }
        if !dwh_scan_chunk(h, &ents[0], rc as usize, r, &bundle, &path, &rev) {
            return false;
        }
    }
    return r.n > 0;
}

// 扫一块 getdents64 输出：记录格式是
// `{u64 d_ino, i64 d_off, u16 d_reclen, u8 d_type, char d_name[]}`（`d_name` 在 +19）。
fn dwh_scan_chunk(h: &DwhHost, buf: &byte, total: usize, r: &DwhRoster,
                  bundle: &Buf, path: &Buf, rev: &Buf) bool {
    var off: usize = 0;
    while off + 19 <= total {
        const reclen: usize =
            (buf[off + 16] as usize) | ((buf[off + 17] as usize) << 8);
        if reclen == 0 || off + reclen > total {
            return true;      // 残记录：留给下一次 getdents（或就此结束）
        }
        const cname: &byte = &buf[off + 19];
        const cl: usize = bufx_cstr_len(cname);
        if cl > 0 && cl <= DWH_PKG_MAX && cname[0] != 46 as byte {
            if !dwh_try_pkg(h, cname, cl, r, bundle, path, rev) {
                return false;
            }
            if r.n >= DWH_ROSTER_MAX {
                return true;
            }
        }
        off = off + reclen;
    }
    return true;
}

// 一个候选目录名：`lib/client.js` 读得到就收进 roster（含 rev）。
// 读不到**不是错误**（作用域下 288 个目录里只有 71 个是 client 包）。
fn dwh_try_pkg(h: &DwhHost, cname: &const byte, cl: usize, r: &DwhRoster,
               bundle: &Buf, path: &Buf, rev: &Buf) bool {
    var pkg: Buf = buf_new(bufx_cstr_len(DWH_SCOPE) + cl + 2);
    defer { buf_free(&pkg); }
    if !buf_append(&pkg, DWH_SCOPE, bufx_cstr_len(DWH_SCOPE)) {
        return false;
    }
    if !buf_append_byte(&pkg, 47) {
        return false;
    }
    if !buf_append(&pkg, cname, cl) {
        return false;
    }
    const pl: usize = pkg.len;
    if !dwh_client_path(&h.root, pkg.ptr as &const byte, pl, path) {
        return false;
    }
    if !dwh_read_file(path.ptr as &const byte, bundle, 4194304) {
        return true;      // 不是 client 包（或读不动）：跳过
    }
    if !dwh_rev_of(bundle.ptr as &const byte, bundle.len, rev) {
        return false;
    }
    var inj: Buf = buf_new(2048);
    defer { buf_free(&inj); }
    if dwh_is_excluded(pkg.ptr as &const byte, pl) {
        return true;      // 明确排除的（见 dwh_is_excluded）
    }
    if !dwh_read_inject(h, cname, cl, &inj) {
        return true;      // 读不到 dsh.client：不是 client 包，跳过
    }
    if !buf_append(&r.recs, pkg.ptr as &const byte, pl) ||
        !buf_append_byte(&r.recs, 0) {
        return false;
    }
    if !buf_append(&r.recs, rev.ptr as &const byte, rev.len) ||
        !buf_append_byte(&r.recs, 0) {
        return false;
    }
    if !buf_append(&r.recs, inj.ptr as &const byte, inj.len) ||
        !buf_append_byte(&r.recs, 0) {
        return false;
    }
    r.n = r.n + 1;
    return true;
}

// 读一个包的 `package.json` → `dsh.client.inject` 的**原文**（JSON 数组）。
// 拿不到（没有 `dsh.client`、坏了、或是别的形状）返回 false —— 调用方据此把
// 这个目录当「不是 client 包」。这与「有 `lib/client.js`」是同一个判据的两半：
// 实测 71 个有 bundle 的包里 67 个带 `inject`（4 个没有 = 谁都不依赖），
// 而**没有一个包是「有 inject 没 bundle」** —— 所以两半都查，谁缺都跳过。
fn dwh_read_inject(h: &DwhHost, cname: &const byte, cl: usize, out: &Buf) bool {
    var path: Buf = buf_new(1200);
    defer { buf_free(&path); }
    if !dwh_pkg_json_path(h, cname, cl, &path) {
        return false;
    }
    var doc: Buf = buf_new(262144);
    defer { buf_free(&doc); }
    if !dwh_read_file(path.ptr as &const byte, &doc, 262144) {
        return false;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    var abuf: [byte: 262144] = [0: 262144];
    arena_init(&arena, &abuf[0], 262144);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, doc.ptr as &const byte, doc.len, &root) {
        return false;
    }
    var dsh: JsonValue = JsonValue.json_null();
    if !js_obj_get(&root, "dsh" as &const byte, 3, &dsh) {
        return false;
    }
    var cli: JsonValue = JsonValue.json_null();
    if !js_obj_get(&dsh, "client" as &const byte, 6, &cli) {
        return false;
    }
    var inn: JsonValue = JsonValue.json_null();
    if !js_obj_get(&cli, "inject" as &const byte, 6, &inn) {
        // 没有 inject：合法（谁都不依赖）—— 发一个空数组。
        buf_reset(out);
        return buf_append_cstr(out, "[]");
    }
    // 转成 `["a","b"]`（只取字符串元素；DSH 那边也只认这些）
    buf_reset(out);
    if !buf_append_byte(out, 91) {
        return false;
    }
    var i: usize = 0;
    const n: usize = js_arr_len(&inn);
    var first: bool = true;
    while i < n {
        var el: JsonValue = JsonValue.json_null();
        if js_arr_get(&inn, i, &el) {
            var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
            if js_str_of(&el, &sv) && sv.len > 0 {
                if !first && !buf_append_byte(out, 44) {
                    return false;
                }
                first = false;
                if !buf_append_byte(out, 34) {
                    return false;
                }
                // ⚠ 反转义要写进**另一个**缓冲：`sv_unescape_to_buf` 是
                // `out[0] = buf_new(…)`（它**替换**目标缓冲，不是追加），
                // 直接喂 `out` 会把上面那个 `["` 丢掉 —— 实测症状：`inject`
                // 发出的是 `@deepseek-ai/…"]`（少了开头的 `["`），而外层 JSON
                // 就此坏掉、浏览器报的却是别处。
                var un: Buf = buf_new(sv.len + 8);
                defer { buf_free(&un); }
                if !sv_unescape(&sv, &un) {
                    return false;
                }
                if !buf_append(out, un.ptr as &const byte, un.len) {
                    return false;
                }
                if !buf_append_byte(out, 34) {
                    return false;
                }
            }
        }
        i = i + 1;
    }
    return buf_append_byte(out, 93);
}

// `<root>/node_modules/@deepseek-ai/<pkg>/package.json`（NUL 结尾）。
fn dwh_pkg_json_path(h: &DwhHost, cname: &const byte, cl: usize,
                     out: &Buf) bool {
    buf_reset(out);
    if !buf_append(out, h.root.ptr as &const byte, h.root.len) {
        return false;
    }
    if !buf_append_cstr(out, "/node_modules/") {
        return false;
    }
    if !buf_append(out, DWH_SCOPE, bufx_cstr_len(DWH_SCOPE)) {
        return false;
    }
    if !buf_append_byte(out, 47) {
        return false;
    }
    if !buf_append(out, cname, cl) {
        return false;
    }
    if !buf_append_cstr(out, "/package.json") {
        return false;
    }
    return buf_append_byte(out, 0);
}

// 作用域目录：`<dsh 根>/node_modules/@deepseek-ai`（NUL 结尾，喂 sys_open）。
fn dwh_scope_dir(root: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if !buf_append(out, root.ptr as &const byte, root.len) {
        return false;
    }
    if !buf_append_cstr(out, "/node_modules/") {
        return false;
    }
    if !buf_append(out, DWH_SCOPE, bufx_cstr_len(DWH_SCOPE)) {
        return false;
    }
    return buf_append_byte(out, 0);
}

// 装出 boot 图：`{"rev":"…","entries":[…],"batches":[…]}`。
// 读不到的包**跳过**（装机不全时给出一个能起来的子集，而不是整页白屏）；
// 一个都没有则返回 false（调用方据此报错退出）。
//
// **`batches` 是 0.2.0 新增的**（0.1.1 只有 `rev`+`entries`）。客户端的
// `parseBootManifest` 逐字段校验，缺 `batches` 直接抛
// `boot manifest batches must be an array`（实测）。规则（读它的源码得出）：
// ① `phase` 只能是 `bootstrap` / `application`；② 每批 `url`/`rev` 是字符串、
// `entries` 是**非空**字符串数组；③ 每个 entry **必须**属于某一批、且**只能属于一批**。
//
// 这里**每个包一批**、`url` 用本仓现有的**单包**形态（`/plugins/<id>/client.js?rev=`）。
// 为什么不用 DSH 原生的 combo（`/plugins/??a/client.js,b/client.js&rev=`）：combo 是为
// 「一个 `<script src>` 里塞多个包」省请求数，代价是 **URL 有 3072 字节上限**（超了它自己
// 按包边界分片，实测 65 个包被切成 58+6 两批）＋服务端要解 `??` 逗号表 + 合并 sourcemap。
// 而校验器**只要求 `url` 是字符串**，不看它长什么样 ⇒ 单包 URL 合法，
// 本仓因此不需要实现 combo 解析。`entry.url` 与 `batch.url` 同值：客户端优先用
// `initialUrl`（即 batch 的），`entry.url` 是它换实现时的回落（读 `arrive()` 得出）。
//
// `bootstrap` 只放 `dsh-client-modules`（0.2.0 的 `PARSER_PRELOAD_IDS` 就它一个）：
// 它必须在 shell 之前 parser-blocking 执行，其余全走 `application`。
fn dwh_build_entries(h: &DwhHost, out: &Buf) bool {
    buf_reset(out);
    var r: DwhRoster = DwhRoster{ recs: buf_empty(), n: 0 };
    defer { buf_free(&r.recs); }
    r.recs = buf_new(24576);
    if !dwh_scan_roster(h, &r) {
        return false;
    }
    if !buf_append_cstr(out, "{\"rev\":\"min\",\"entries\":[") {
        return false;
    }
    if !dwh_emit_entries(&r.recs, out) {
        return false;
    }
    if !buf_append_cstr(out, "],\"batches\":[") {
        return false;
    }
    if !dwh_append_batches(&r.recs, out) {
        return false;
    }
    // 收尾：`]`（batches 数组）＋ `}`（对象）。0.2.0 那份是两层 ——
    // 少写外层 `}` 的话 JSON **是坏的**而外层看不出（浏览器里报的是
    // `batches must be an array`，指向的却是下一个字段）。
    return buf_append_cstr(out, "]}");
}

// `entries` 数组：每包一行 `{id,url,rev}`（`url` 与下面的 batch 同值）。
fn dwh_emit_entries(recs: &const Buf, out: &Buf) bool {
    var off: usize = 0;
    var first: bool = true;
    while off < recs.len {
        const pkg: &const byte = &recs.ptr[off];
        const pl: usize = bufx_cstr_len(pkg);
        const rev: &const byte = &recs.ptr[off + pl + 1];
        const rl: usize = bufx_cstr_len(rev);
        const inj: &const byte = &recs.ptr[off + pl + 1 + rl + 1];
        if !first && !buf_append_byte(out, 44) {
            return false;
        }
        first = false;
        if !buf_append_cstr(out, "{\"id\":\"") {
            return false;
        }
        if !buf_append(out, pkg, pl) {
            return false;
        }
        if !buf_append_cstr(out, "\",\"url\":\"/plugins/") {
            return false;
        }
        if !buf_append(out, pkg, pl) {
            return false;
        }
        if !buf_append_cstr(out, "/client.js?rev=") {
            return false;
        }
        if !buf_append_cstr(out, rev) {
            return false;
        }
        if !buf_append_cstr(out, "\",\"rev\":\"") {
            return false;
        }
        if !buf_append_cstr(out, rev) {
            return false;
        }
        // `inject` **必须发**：客户端拿它判「这个插件声明的服务到齐了没」，
        // 少了它每个依赖服务的插件都停在 pending（理由见 DwhRoster 的注释）。
        if !buf_append_cstr(out, "\",\"inject\":") {
            return false;
        }
        if !buf_append_cstr(out, inj) {
            return false;
        }
        // 收尾只有对象自己的 `}` —— 这里曾经多写了一个 `"`（`\"}`），
        // 于是 inject 数组被当成字符串的尾巴、整个图**坏在别处**才报出来。
        if !buf_append_byte(out, 125) {
            return false;
        }
        const il: usize = bufx_cstr_len(inj);
        off = off + pl + 1 + rl + 1 + il + 1;
    }
    return true;
}

// 产出 `batches` 数组：`dsh-client-modules` 一批 `bootstrap`，其余各自一批
// `application`（每包一批 ⇒ 单包 URL，见 `dwh_build_entries` 的说明）。
fn dwh_append_batches(recs: &const Buf, out: &Buf) bool {
    // `first` 是「还没写过任何一批」的标志，**按指针传**（跨两次调用累计）。
    var first: bool = true;
    if !dwh_one_batch(recs, out, &first, true) {
        return false;
    }
    return dwh_one_batch(recs, out, &first, false);
}

// 一遍 batch：`boot` 为真只挑 `dsh-client-modules`，为假挑其余每一个包。
fn dwh_one_batch(recs: &const Buf, out: &Buf, first: &bool, boot: bool) bool {
    var off: usize = 0;
    while off < recs.len {
        const pkg: &const byte = &recs.ptr[off];
        const pl: usize = bufx_cstr_len(pkg);
        const rev: &const byte = &recs.ptr[off + pl + 1];
        const rl: usize = bufx_cstr_len(rev);
        const il: usize = bufx_cstr_len(&recs.ptr[off + pl + 1 + rl + 1]);
        if dwh_is_boot_pkg(pkg, pl) == boot {
            if !dwh_put_batch(out, first, pkg, pl, rev, boot) {
                return false;
            }
        }
        off = off + pl + 1 + rl + 1 + il + 1;
    }
    return true;
}

// 该包是不是 bootstrap 包（0.2.0 的 `PARSER_PRELOAD_IDS` 只有它一个）。
// 明确**不**进图的包：DSH 自己的 roster 里没有它们（它们由 host 侧的
// `dsh-host-directory-picker-auto` 在运行期按平台动态启用，静态名单里看不到）。
// 扫目录会把它们扫进来，而它们进图后**激活失败**（`failed`）⇒ 整页 boot 报
// `1 entry did not activate`、`data-slot` 一个都不挂。所以这里显式排除。
fn dwh_is_excluded(pkg: &const byte, pl: usize) bool {
    // 「有 bundle」**不等于**「该进图」：`dsh.client` 只是声明，要不要装由
    // **profile 的 roster** 决定。实测差集 5 个（真 DSH 的 65 entries 里没有它们）：
    //   `dsh-experimental-client-ui-{agent-team,voice-input}`（实验插件）
    //   `dsh-client-ui-schedule`
    //   `dsh-client-ui-directory-picker-{browse,native}`
    // 前三者不在任何 bundle 的 insert 里；后两个由 host 侧的
    // `dsh-host-directory-picker-auto` **运行期按平台**动态启用。
    //
    // 不排除的代价是**真错**：`voice-input` 进图后会因拿不到 `speech` 的 catalog
    // 抛 `Cannot read properties of undefined (reading 'find')`，并让
    // `conversation.input.activity` 这个 slot **整块崩掉**（实测）。
    // 行宽豁免：不可断的包名
    if dwh_eq(pkg, pl, "@deepseek-ai/dsh-client-ui-directory-picker-browse" as &const byte) {
        return true;
    }
    // 行宽豁免：不可断的包名
    if dwh_eq(pkg, pl, "@deepseek-ai/dsh-client-ui-directory-picker-native" as &const byte) {
        return true;
    }
    // 行宽豁免：不可断的包名
    if dwh_eq(pkg, pl, "@deepseek-ai/dsh-experimental-client-ui-agent-team" as &const byte) {
        return true;
    }
    if dwh_eq(pkg, pl, "@deepseek-ai/dsh-client-ui-schedule" as &const byte) {
        return true;
    }
    // 行宽豁免：不可断的包名
    const vi: &const byte = "@deepseek-ai/dsh-experimental-client-ui-voice-input" as &const byte;
    return dwh_eq(pkg, pl, vi);
}

// 包名相等（长度与字节都比）。
fn dwh_eq(pkg: &const byte, pl: usize, want: &const byte) bool {
    return bufx_eq_cstr(pkg, pl, want);
}

// 该包是不是 bootstrap 包（0.2.0 的 `PARSER_PRELOAD_IDS` 只有它一个）。
// 它必须在 shell 之前 parser-blocking 执行，所以单独成批。
fn dwh_is_boot_pkg(pkg: &const byte, pl: usize) bool {
    const want: &const byte = "@deepseek-ai/dsh-client-modules" as &const byte;
    return bufx_eq_cstr(pkg, pl, want);
}

// 写一批。`first` 是「见过了吗」的标记（跨调用累计，所以走 `&Buf` 传地址）。
fn dwh_put_batch(out: &Buf, first: &bool, pkg: &const byte, pl: usize,
                 rev: &const byte, boot: bool) bool {
    if !(*first) {
        if !buf_append_byte(out, 44) {
            return false;
        }
    }
    if !buf_append_cstr(out, "{\"phase\":\"") {
        return false;
    }
    if boot {
        if !buf_append_cstr(out, "bootstrap") {
            return false;
        }
    } else {
        if !buf_append_cstr(out, "application") {
            return false;
        }
    }
    if !buf_append_cstr(out, "\",\"url\":\"/plugins/") {
        return false;
    }
    if !buf_append(out, pkg, pl) {
        return false;
    }
    if !buf_append_cstr(out, "/client.js?rev=") {
        return false;
    }
    if !buf_append_cstr(out, rev) {
        return false;
    }
    if !buf_append_cstr(out, "\",\"rev\":\"") {
        return false;
    }
    if !buf_append_cstr(out, rev) {
        return false;
    }
    if !buf_append_cstr(out, "\",\"entries\":[\"") {
        return false;
    }
    if !buf_append(out, pkg, pl) {
        return false;
    }
    if !buf_append_cstr(out, "\"]}") {
        return false;
    }
    *first = false;
    return true;
}

// 装出 **bootstrap** 包的 `<script src="…">` 片段（parser-blocking）。
//
// **0.2.0 的 preload 只有一个**：`dsh-client-modules`。0.1.1 是两个（它还带
// `dsh-client-runtime`），而那个包在 0.2.0 里**已经不存在**了 —— 照旧发两个的话，
// 第二个会 404 而**不会**报错（`<script src>` 404 是静默的），正好把「升级之后起不来」
// 伪装成别的问题。所以这里不再写死包名表，而是**按 `dwh_is_boot_pkg` 判定**，
// 与 `batches` 里挑 bootstrap 那批用的是同一个判据（两处必须一致，见 `dwh_one_batch`）。
//
// 顺序即语义：这一段必须是 `script-src`（不是 `preload`），它要在 shell 之前执行。
fn dwh_build_preloads(h: &const DwhHost, out: &Buf) bool {
    buf_reset(out);
    var r: DwhRoster = DwhRoster{ recs: buf_empty(), n: 0 };
    defer { buf_free(&r.recs); }
    r.recs = buf_new(24576);
    if !dwh_scan_roster(h, &r) {
        return false;
    }
    var off: usize = 0;
    while off < r.recs.len {
        const pkg: &const byte = &r.recs.ptr[off];
        const pl: usize = bufx_cstr_len(pkg);
        // `rl` 要在 if 之外也可见（下面的三段步进用它）—— 作用域别缩在分支里
        const rl: usize = bufx_cstr_len(&r.recs.ptr[off + pl + 1]);
        if dwh_is_boot_pkg(pkg, pl) {
            const rev: &const byte = &r.recs.ptr[off + pl + 1];
            if !buf_append_cstr(out, "<script src=\"/plugins/") {
                return false;
            }
            if !buf_append(out, pkg, pl) {
                return false;
            }
            if !buf_append_cstr(out, "/client.js?rev=") {
                return false;
            }
            if !buf_append_cstr(out, rev) {
                return false;
            }
            if !buf_append_cstr(out, "\"></script>") {
                return false;
            }
        }
        // 统一按三段步进（名字 / rev / inject 各跟一个 `\0`）
        const il: usize = bufx_cstr_len(&r.recs.ptr[off + pl + 1 + rl + 1]);
        off = off + pl + 1 + rl + 1 + il + 1;
    }
    return true;
}

// ============================================================
// 启动注入（复刻 DSH 的 bootInjections）
// ============================================================

// 把注入片段插在 `<head>` 开标签之后（与 DSH 的 `renderIndexInjections` 同口径）。
fn dwh_render_index(h: &const DwhHost, html: &const Buf, out: &Buf) bool {
    buf_reset(out);
    const preloads: &const Buf = &h.preloads;
    const entries: &const Buf = &h.entries;
    const at: isize = srv_find(html.ptr as &const byte, 0, html.len,
        "<head>" as &const byte, 6);
    if at < 0 {
        // 没有 `<head>`：把注入放最前面（HTML 仍能解析，只是少一层保险）
        if !dwh_boot_into(entries, preloads, out) {
            return false;
        }
        return buf_append(out, html.ptr as &const byte, html.len);
    }
    const cut: usize = (at as usize) + 6;
    if !buf_append(out, &html.ptr[0], cut) {
        return false;
    }
    if !dwh_boot_into(entries, preloads, out) {
        return false;
    }
    return buf_append(out, &html.ptr[cut], html.len - cut);
}

// 三样东西，按执行顺序：内联 queue 脚本 → bootstrap script → `__DSH_BOOT__`。
fn dwh_boot_into(entries: &const Buf, preloads: &const Buf, out: &Buf) bool {
    if !buf_append_cstr(out, "<script>(()=>{const pendingQueue=[];window.__ModuleLoader__={mode:\"queue\",pendingQueue,load(r){pendingQueue.push(r)},create(o){if(this.mode!==\"queue\")throw new Error(\"client-modules: create after boot\");const i=pendingQueue.findIndex(r=>r.id===\"@deepseek-ai/dsh-client-modules\");const reg=pendingQueue[i];if(reg===undefined)throw new Error(\"client-modules: HTML did not preload modules\");pendingQueue.splice(i,1);const x=reg.factory(s=>{throw new Error(\"client-modules: modules requested external \"+s)});return x.createClientModuleSystem(this,{id:reg.id,exports:x},o)}}})()</script>") {
        return false;
    }
    // bootstrap script（顺序即语义：parser-blocking，必须在 shell 之前执行）
    if !buf_append(out, preloads.ptr as &const byte, preloads.len) {
        return false;
    }
    if !buf_append_cstr(out, "<script>globalThis[\"__DSH_BOOT__\"]=") {
        return false;
    }
    if !buf_append(out, entries.ptr as &const byte, entries.len) {
        return false;
    }
    return buf_append_cstr(out, "</script>");
}


// ============================================================
// /api 的 unary 应答
// ============================================================

// 把一次 unary 调用包成 DSH 的 `ServerResponse`（业务错走 ok:false）。
fn dwh_rpc_ok(rpc: &const byte, rl: usize, value: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "{\"type\":\"server-response\",\"rpcId\":") {
        return false;
    }
    // ⚠ `rpcId` 是**带长度**的（调用方给的是 `rpc.ptr`，那个 Buf 没有 NUL）：
    // 用 `buf_append_cstr` 会一路读到相邻内存 —— 实测症状是长 uuid 的响应体里
    // 混进几个垃圾字节（`pu@,`），于是客户端 `JSON.parse` 报
    // `Expected ',' or '}' … at position 72`，而它说的是**我拼坏的那段**。
    if !buf_append(out, rpc, rl) {
        return false;
    }
    if !buf_append_cstr(out, ",\"result\":{\"ok\":true,\"value\":") {
        return false;
    }
    if !buf_append(out, value.ptr as &const byte, value.len) {
        return false;
    }
    return buf_append_cstr(out, "}}");
}

// 业务错：**200 + ok:false**（HTTP 状态只表示载体）。
fn dwh_rpc_err(rpc: &const byte, rl: usize, code: &const byte, msg: &const byte,
    mn: usize, out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "{\"type\":\"server-response\",\"rpcId\":") {
        return false;
    }
    // 同 `dwh_rpc_ok`：`rpcId` 按长度写，别当 C 串
    if !buf_append(out, rpc, rl) {
        return false;
    }
        // 行宽豁免：不可断的 JSON 字面量
    if !buf_append_cstr(out, ",\"result\":{\"ok\":false,\"error\":{\"code\":\"") {
        return false;
    }
    if !buf_append_cstr(out, code) {
        return false;
    }
    if !buf_append_cstr(out, "\",\"message\":") {
        return false;
    }
    // ⚠ 用**显式长度**：`msg` 常常是一个没 NUL 结尾的 `Buf` 内容，用
    // `bufx_cstr_len` 会一路读到相邻内存（实测：错误消息里出现了 HTTP 响应头，
    // 因为那段内存紧挨着 —— 这类「读越界」的症状是消息内容莫名其妙）。
    if !jw_str_into(out, msg, mn) {
        return false;
    }
    return buf_append_cstr(out, ",\"details\":{}}}}");
}

// 解一条客户端 close 帧（opcode 8）的 code 与 reason 并打到 stderr。
//
// 为什么值得为它写一个函数：客户端**主动**关连接时会把原因写在帧里
// （`4002 invalid Remote stream frame` / `1000` 等），而它自己**不打印**任何
// 东西 —— 这是「帧为什么不合法」的唯一线索（本仓在 P80 上两次靠它定位）。
// 帧格式与其它客户端帧一样：`b0` = FIN|opcode、`b1` = MASK|len（可能 126/127）、
// 掩码键、payload。**必须按长度形态取掩码偏移**（写死 `2+(k&3)` 会把 126 形态
// 解成乱码 —— 第十批踩过同一个坑）。
fn dwh_log_close(frame: &const byte, n: usize) void {
    if n < 2 {
        return;
    }
    var plen: usize = (frame[1] & 127 as byte) as usize;
    var poff: usize = 2;
    if plen == 126 {
        if n < 4 {
            return;
        }
        plen = ((frame[2] as usize) << 8) | (frame[3] as usize);
        poff = 4;
    } else if plen == 127 {
        if n < 10 {
            return;
        }
        poff = 10;
    }
    const masked: bool = (frame[1] & 128 as byte) != 0;
    const moff: usize = poff;
    if masked {
        if n < poff + 4 {
            return;
        }
        poff = poff + 4;
    }
    if poff >= n {
        return;
    }
    var code: u32 = 0;
    if n >= poff + 2 {
        code = ((frame[poff] as u32) << 8) | (frame[poff + 1] as u32);
    }
    // 掩码是**按 payload 的下标**循环用的（`(i - payload起点) & 3`）——
    // 用一个自增计数器会在跳过 code 那两字节之后**错位 2**（实测：解出来是
    // 一串乱码，而乱码会让人以为是帧坏了，其实只是掩码偏移算错）。
    const pstart: usize = poff;
    var msg: Buf = buf_new(256);
    defer { buf_free(&msg); }
    var i: usize = pstart + 2;
    while i < n {
        var b: byte = frame[i];
        if masked {
            b = (b ^ frame[moff + ((i - pstart) & 3)]) as byte;
        }
        _ = buf_append_byte(&msg, b);
        i = i + 1;
    }
    out_err("[dsh-web] 客户端关了这条连接：code=");
    out_err_dec(code as usize);
    out_err(" reason=");
    if msg.len > 0 {
        _ = sys_write(2, msg.ptr as *const byte, msg.len);
    }
    out_err("\n");
}

// `a/b` → `a.b`（0.2.0 的斜杠名字规范成本宿主内部的点号名字）。
// 只换**第一个** `/`：`dynamicCordisRunner/inventory` 这类名字里也只有一段斜杠。
fn dwh_slash_to_dot(method: &const byte, ml: usize, out: &Buf) bool {
    buf_reset(out);
    var i: usize = 0;
    var done: bool = false;
    while i < ml {
        const c: byte = method[i];
        if c == 47 as byte && !done {
            if !buf_append_byte(out, 46) {
                return false;
            }
            done = true;
        } else {
            if !buf_append_byte(out, c) {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

// 一次 unary：按方法名产出 value（写进 `value` 的 JSON 文本）。
// 返回 false = 这个方法没实现（调用方回 `internal` 业务错）。
// `h` 是可变的：`session/prompt` / `session/selectModel` 要**真的动手**
// （往子进程 stdin 排帧、改宿主的选择、推宿主事件）—— 只读的那几条用不到，
// 但签名只有一份（两套签名会让「哪条能改状态」变成要读实现才知道的事）。
fn dwh_unary(h: &DwhHost, method: &const byte, ml: usize,
    body: &const Buf, value: &Buf) bool {
    buf_reset(value);
    // 0.2.0 的方法名是**斜杠**形状（`session/list`、`session/modelCatalog`），
    // 而本宿主的实现是按 0.1.1 的**点号**名字写的（`session.list`）。这里把斜杠
    // 换成点号做一次规范化，下面所有分支照旧 —— 两代名字于是都认。
    //
    // 为什么不是「加一遍别名分支」：那要在每个分支上抄第二遍名字，两边日后必然漂
    // （而这正是 0.2.0 升级踩到的形态：名字变了、分支没变，症状是**静默不响应**）。
    var norm: Buf = buf_new(ml + 1);
    defer { buf_free(&norm); }
    if !dwh_slash_to_dot(method, ml, &norm) {
        return false;
    }
    const mn: &const byte = norm.ptr as &const byte;
    const mnl: usize = norm.len;
    if bufx_eq_cstr(mn, mnl, "host.describe" as &const byte) {
        // 行宽豁免：不可断的 JSON 字面量
        // cwd/home 用**真值**：DSH 拿它们做目录选择与显示缩写，而 `/` 不是一个
        // 像样的工作区（实测：python 探针用 getcwd() 能跑通，这里给 `/` 时
        // shell 只发了 2 个 /api 就停了 —— 后面几步根本没发生）。
        // 行宽豁免：不可断的 JSON 骨架。
        if !buf_append_cstr(value, "{\"version\":\"0.0.1\",\"cwd\":") {
            return false;
        }
        if !dwh_cwd_json(value) {
            return false;
        }
        if !buf_append_cstr(value, ",\"provider\":\"uya-agent\",\"model\":\"uya-agent\",\"attachedSessions\":1,\"home\":") {
            return false;
        }
        if !dwh_home_json(value) {
            return false;
        }
        return buf_append_cstr(value, ",\"canOpenPath\":false}");
    }
    // ⚠ `session.create` 不能少（实测：少了它页面只剩 hero 空态、代码零报错）。
    if bufx_eq_cstr(mn, mnl, "session.create" as &const byte) {
        if !buf_append_cstr(value, "{\"sessionId\":\"") {
            return false;
        }
        if !buf_append_cstr(value, DWH_SESSION_ID) {
            return false;
        }
        return buf_append_cstr(value, "\",\"agentPreset\":\"standard\"}");
    }
    // P80 第二十三批：**聊天**与**模型选择**两条新面。
    // ⚠ 它们要**读请求体的 `payload.args`**（`dwh_unary_session` 那一簇是纯查询，
    // 拿不到 body）—— 所以分派点在**这一层**，不是在那簇里面。
    if dwh_unary_chat(h, mn, mnl, body, value) {
        return true;
    }
    if dwh_unary_session(h, mn, mnl, value) {
        return true;
    }
    // 会话/工作区那一簇之外的、host 自身的元信息。
    // `session.models` 与 `session/modelCatalog` **同源**（见 `dwhm_models_json`）：
    // 0.1.1 与 0.2.0 两个面板读的是同一个目录，有效模型列表不该有两份答案。
    if bufx_eq_cstr(mn, mnl, "session.models" as &const byte) {
        return dwhm_models_json(&h.model, value);
    }
    return false;
}

// 会话/工作区那一簇查询（都围着「那一条会话」）。
fn dwh_unary_session(h: &const DwhHost, method: &const byte, ml: usize,
    value: &Buf) bool {
    if bufx_eq_cstr(method, ml, "session.list" as &const byte) {
        if !buf_append_cstr(value, "{\"items\":[{\"sessionId\":\"") {
            return false;
        }
        if !buf_append_cstr(value, DWH_SESSION_ID) {
            return false;
        }
        // ⚠ `blank` 必须为 **true**：0.2.0 的「自动选一个会话」只在
        // `summary.blank === true && summary.cwd === workspace.path &&
        // workspace.sessionIds.includes(id)` 全成立时才**复用**它
        // （读 `dsh-client-ui-workspace` 的 `reuseOrCreateBlank`）；
        // 否则它转去 `sessions.create`，而那条路在本仓没有会话可建 ⇒
        // 页面停在「Choose workspace」空态、**永远不开 `session/follow`**
        // ⇒ 消息一条都渲染不出来（实测：那一屏只有工作区选择器）。
        // 本仓这条会话是「一份真日志的投影」，语义上确实是空会话，给 true 是对的。
        // 行宽豁免：不可断的 JSON 字面量
        // `agentAvailable` 是**必需的**（真 DSH 的每个 item 都有它）：
        // 客户端 `agentAvailable(sessionId)` 在 `listPhase === "ready"` 之后
        // 拿不到它就回 `false`，而会话选中链路（`sessions.retain` →
        // `resolveTarget`）会因此判「这个会话没有 agent」⇒ 对话区不建节点。
        // 行宽豁免：不可断的 JSON 字面量
        if !buf_append_cstr(value, "\",\"updatedAt\":2,\"agentAvailable\":true,") {
            return false;
        }
        // 行宽豁免：不可断的 JSON 字面量
        if !buf_append_cstr(value, "\"running\":false,\"blank\":false,") {
            return false;
        }
        // `cwd` 不能省：`ui-workspace` 用它把会话归到工作区分组里 —— 缺了它
        // 会话在 `session.list` 里有、侧栏却显示「No sessions yet」（实测）。
        if !buf_append_cstr(value, "\"cwd\":") {
            return false;
        }
        if !dwh_cwd_json(value) {
            return false;
        }
        if !buf_append_byte(value, 44) {
            return false;
        }
        // `title` 投影是**纯字符串**（`SessionProjectionMap.title: string|null`）——
        // 发成 `{title:…}` 侧栏一行都不显示（实测）。
        // 行宽豁免：不可断的 JSON 字面量
        // 行宽豁免：不可断的 JSON 字面量
        return buf_append_cstr(value, "\"projections\":{\"kind\":\"sequenced\",\"asOfSeq\":2,\"values\":{\"title\":\"本仓会话\"}}}]}");
    }
    if bufx_eq_cstr(method, ml, "session.history" as &const byte) {
        // 事件源就是适配层的译文（`h.events` 每行一条）。
        if !buf_append_cstr(value, "{\"events\":[") {
            return false;
        }
        if !dwh_events_as_history(&h.events, value) {
            return false;
        }
        // 行宽豁免：不可断的 JSON 字面量
        // 行宽豁免：不可断的 JSON 字面量
        return buf_append_cstr(value, "],\"hasMore\":false,\"projections\":{\"kind\":\"sequenced\",\"asOfSeq\":2,\"values\":{\"title\":\"本仓会话\"}}}");
    }
    // 这几个是 shell 起来时会问的「周边」查询：回**空列表**而不是「没实现」——
    // 「没实现」会让它把那块功能标成不可用（甚至影响它启动流程的判断），而
    // 空列表是「现在确实没有」，语义正确且不挡路（与 python 探针同口径）。
    if bufx_eq_cstr(method, ml, "subagent.list" as &const byte) {
        return buf_append_cstr(value, "{\"items\":[]}");
    }
    // ── 0.2.0 新增的三个面 ──────────────────────────────────────────
    // 形状全部**从真 DSH 抄**（`curl` 它自己的 `/api/<m>`），不是猜的。
    // `dynamicCordisRunner/inventory`：真 DSH 在「没有动态插件」时回**空数组**。
    if bufx_eq_cstr(method, ml, "dynamicCordisRunner.inventory" as &const byte) {
        return buf_append_cstr(value, "[]");
    }
    // `dynamicCordisRunner/syncInspectManifest`：真 DSH 要 `payload.providers`，
    // 缺了回 `gateway/arguments-invalid`。本仓没有可同步的 provider ⇒ 回一个
    // **空的同步结果**（客户端据此认为「没有需要同步的」而不是报错）。
    if bufx_eq_cstr(method, ml,
        "dynamicCordisRunner.syncInspectManifest" as &const byte) {
        return buf_append_cstr(value, "{\"accepted\":0,\"rejected\":[]}");
    }
    // `session/modelCatalog`：客户端用它画模型选择器。形状取自真 DSH 的 zod
    // （`ModelCatalog`），**内容**来自本机的 `settings.yaml`（`dwhmodel.uya`）。
    // 从前这里回的是写死的 `groups:[]` ⇒ 选择器永远是空的（用户报的那一条）。
    if bufx_eq_cstr(method, ml, "session.modelCatalog" as &const byte) {
        return dwhm_catalog_json(&h.model, value);
    }
    if bufx_eq_cstr(method, ml, "settings.describe" as &const byte) {
        // 形状是**从真 DSH 0.2.0 抄的**（0.1.1 那份 `{values,schema}` 在 0.2.0 下
        // 会让设置面板整片塌掉：客户端 `mirrored.view.namespaces.find(…)` 撞
        // `undefined` ⇒ `Cannot read properties of undefined (reading 'find')`，
        // 而它表现为「Failed to load plugins」+ 4 个设置插件列名，看不出是设置的事）。
        // 本仓没有可写的设置文档 ⇒ `namespaces` 是**空数组**（不是 `{}`：
        // 客户端对它 `.find()`，形状必须是数组）、`hasDocument` 如实给 false。
        return buf_append_cstr(value,
            "{\"writable\":false,\"hasDocument\":false,\"namespaces\":[]}");
    }
    if bufx_eq_cstr(method, ml, "session.models" as &const byte) {
        // 0.1.1 的那条门面（`{current,routable,groups,failures}`）：内容与
        // `modelCatalog` **同源**（同一个目录、同一个当前值，组装函数也共用）——
        // 两处各写一份就是「新旧两个面板显示不同的模型」。
        return dwhm_models_json(&h.model, value);
    }
    // ⚠ `workspace.list` 返回空 ⇒ 会话在 session.list 里有、侧栏却一行不显示（实测）。
    // 形状要按真 schema：`items[]`，每项是 WorkspaceView（两个时间是 ISO-8601 字符串）。
    if bufx_eq_cstr(method, ml, "workspace.list" as &const byte) {
        if !buf_append_cstr(value, "{\"items\":[") {
            return false;
        }
        if !dwh_workspace_item(value) {
            return false;
        }
        return buf_append_cstr(value, "],\"archivedSessionIds\":[],\"pinnedSessionIds\":[]}");
    }
    return dwh_unary_settings(method, ml, value);
}

// ============================================================
// P80 第二十三批：聊天与模型选择（两条认识请求体的 unary）
// ============================================================
//
// 与 `dwh_unary_settings` 的**分工**：那一簇是**只读元信息**（形状对就行），
// 这两条要**读请求体里的 `payload.args`** —— 所以它们多一个 `body` 形参。
// 形状逐字段照 DSH 的 zod（`session/prompt` / `session/selectModel`），
// 入参与出参都要对：入参多了/少了客户端不报错（它是它自己发的），
// 出参形状错了才是「发了消息没反应」。

// 两句业务错的措辞（拆两条常量拼：一条整行写会超 80 字符的行宽指标）。
const DWH_RO_NOTE: &const byte = "只读模式（起了 --dsh-web-events / UYA_AGENT_DSH_WEB_EVENTS）：这条会话没有活的 agent，消息不会被处理" as &const byte;
const DWH_SELMODEL_NOTE: &const byte = "session/selectModel 的参数不对（要 sessionId / provider / model，reasoningEffort 可选）" as &const byte;

// 聊天那一簇。返回 true = 这个方法归它管（**无论成败**：认领了但业务失败也要
// 回一条说清楚的业务错，而不是让调用方回「not implemented」——
// 后者让客户端把整个面当「不支持」）。
fn dwh_unary_chat(h: &DwhHost, method: &const byte, ml: usize,
    body: &const Buf, value: &Buf) bool {
    if bufx_eq_cstr(method, ml, "session.prompt" as &const byte) {
        return dwh_prompt(h, body, value);
    }
    if bufx_eq_cstr(method, ml, "session.selectModel" as &const byte) {
        return dwh_select_model(h, body, value);
    }
    return false;
}

// `session/prompt`：把浏览器发来的正文变成子进程 stdin 上的一帧。
//
// 入参（DSH 的 `SessionPromptRequest`）：`{requestId,sessionId,mode:"queue"|"steer",
// content:[{type:"text",text}|{type:"image",…}|…],clientTimeZone?}`。
// 出参：`{accepted:true}`。
//
// 三条纪律：
//   ① **只认 text**：图片/文件附件要原样的 base64 走一条本仓还没接的路（体上限是
//      另一条独立线，见 DESIGN §11.9.6）。遇到非 text 的块**如实回业务错**，
//      绝不静默丢掉用户贴的内容（「发送成功了但图片没上去」比报错坏得多）。
//   ② **只读模式明确拒绝**：给了事件源（译文）时没有子进程可送 —— 回一条
//      「这是只读演示」的错，别让用户对着一个吞消息的输入框。
//   ③ 会话 id 必须是我们那条：客户端可能开着别的会话的标签（多标签页），
//      回错会话的消息会让用户以为「发给 A 的结果出现在 B 里」。
fn dwh_prompt(h: &DwhHost, body: &const Buf, value: &Buf) bool {
    var text: Buf = buf_new(4096);
    defer { buf_free(&text); }
    const rc: i32 = dwh_prompt_text(body, &text);
    if rc != 0 {
        return dwh_ok_or_err(value, rc);
    }
    if !h.live {
        return dwh_rpc_owned_err(value, "internal",
            DWH_RO_NOTE);
    }
    const s: i32 = dwhc_send_prompt(&h.child, text.ptr as &const byte,
        text.len);
    if s == 1 {
        return dwh_rpc_owned_err(value, "gateway/bad-request",
            "这一条太长（或上一条还没送完）：请缩短后重发");
    }
    if s == 2 {
        return dwh_rpc_owned_err(value, "internal",
            "对话子进程已经退出，消息送不进去（看启动日志与会话日志末尾）");
    }
    // 收到就算「接受」：真正的回合在子进程里跑（与 DSH 的语义一致 ——
    // `accepted` 只表示「入队了」）。`running` 那一拍由 `turn/start` 推给客户端。
    _ = dwh_host_event(h, "api-session/status" as &const byte, true);
    return buf_append_cstr(value, "{\"accepted\":true}");
}

// 从请求体走到**真正的入参对象**。
//
// ⚠ 真实的 0.2.0 客户端多包一层：`payload.args.request.{requestId,sessionId,
// mode,content}`（实测抓到的 body）。裸探针（我自己拼的）是
// `payload.args.{…}` 直接摊平 —— **两种都要认**：只认一种时另一种就是
// 「发了消息没反应」，而两种的差别在 body 里只差一个键名。
// 判据是「`args` 里有 `content` 就用它，否则看 `args.request`」（`content` 是
// 那条消息的正文数组，两种形状里都只出现在最内层）。
fn dwh_req_args(root: &const JsonValue, out: &JsonValue) bool {
    var payload: JsonValue = JsonValue.json_null();
    var args: JsonValue = JsonValue.json_null();
    if !js_obj_get(root, "payload" as &const byte, 7, &payload) ||
        !js_obj_get(&payload, "args" as &const byte, 4, &args) {
        return false;
    }
    var content: JsonValue = JsonValue.json_null();
    if js_obj_get(&args, "content" as &const byte, 7, &content) {
        *out = args;
        return true;
    }
    var req: JsonValue = JsonValue.json_null();
    if js_obj_get(&args, "request" as &const byte, 7, &req) {
        *out = req;
        return true;
    }
    // 第三种形态：**入参直接摊在 `args` 里**（`session/selectModel` 那种
    // 「只有几个平字段」的方法；客户端对这种没有 `content`/`request` 可包）。
    // 少了这一支，那种请求会被当成「参数不对」—— 实测：模型驱动器发的
    // `{"args":{"sessionId":…,"provider":…,"model":…}}` 被判参数错，
    // 而它自己的字段一个不缺。
    *out = args;
    return true;
}

// 取 `payload.args` 里的正文。返回 0 = 取到了；1 = 参数不对；2 = 有非 text 的块。
//
// 逐个块走（`content` 是数组）：多条 text 块按顺序拼起来（DSH 的语义就是
// 「一条消息里的几个块」），遇到 image/file 立刻返回 2（纪律①）。
fn dwh_prompt_text(body: &const Buf, out: &Buf) i32 {
    buf_reset(out);
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    var abuf: [byte: 65536] = [0: 65536];
    arena_init(&arena, &abuf[0], 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, body.ptr as &const byte, body.len, &root) {
        return 1;
    }
    var args: JsonValue = JsonValue.json_null();
    if !dwh_req_args(&root, &args) {
        return 1;
    }
    var sess: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if !js_obj_get_str(&args, "sessionId" as &const byte, 9, &sess) {
        return 1;
    }
    if !sv_eq_cstr_view(&sess, DWH_SESSION_ID) {
        return 1;
    }
    var content: JsonValue = JsonValue.json_null();
    if !js_obj_get(&args, "content" as &const byte, 7, &content) {
        return 1;
    }
    const n: usize = js_arr_len(&content);
    if n == 0 {
        return 1;
    }
    var i: usize = 0;
    while i < n {
        var blk: JsonValue = JsonValue.json_null();
        if !js_arr_get(&content, i, &blk) {
            return 1;
        }
        var kind: JsonStrView = JsonStrView{ ptr: null, len: 0 };
        if !js_obj_get_str(&blk, "type" as &const byte, 4, &kind) {
            return 1;
        }
        if !sv_eq_cstr_view(&kind, "text" as &const byte) {
            return 2;
        }
        var t: JsonStrView = JsonStrView{ ptr: null, len: 0 };
        if !js_obj_get_str(&blk, "text" as &const byte, 4, &t) {
            return 1;
        }
        if !sv_unescape(&t, out) {
            return 1;
        }
        i = i + 1;
    }
    return 0;
}

// 一个 `JsonStrView` 与一个 C 串字面量逐字节比（`sv_unescape` 之前用）。
fn sv_eq_cstr_view(s: &const JsonStrView, lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    if s.len != ln {
        return false;
    }
    if ln == 0 {
        return true;
    }
    return bufx_mem_eq(s.ptr as &const byte, lit, ln);
}

// 把 `dwh_prompt_text` 的返回码变成一条**说清楚**的业务错。
// 用 `dwh_rpc_owned_err` 的形态（下面那个）—— 这条只是把三个码映射成人话。
fn dwh_ok_or_err(value: &Buf, rc: i32) bool {
    if rc == 2 {
        return dwh_rpc_owned_err(value, "gateway/bad-request",
            "这一条里带了图片/文件附件：本仓的 --dsh-web 还没接附件那条路（正文可以照发）");
    }
    return dwh_rpc_owned_err(value, "gateway/bad-request",
        "session/prompt 的参数不对（要 requestId/sessionId/mode/content）");
}

// 一条**业务错**：`{"__err":true,"code":…,"message":…}` —— 让 `dwh_unary` 的调用方
// （`dwh_send_api`）能把它包成 `ok:false` 的响应（而不是把这串当成了成功的 value）。
//
// 为什么用这个内部标记而不是直接在这里写响应：`dwh_unary` 的契约是「写 value」，
// 响应信封（rpcId / ok / error）只有 `dwh_send_api` 知道。多一条返回路径就会有两处
// 拼信封的地方 —— 而拼错信封的症状（`invalid server-response`）离原因很远。
fn dwh_rpc_owned_err(value: &Buf, code: &const byte, msg: &const byte) bool {
    buf_reset(value);
    if !buf_append_cstr(value, "{\"__err\":true,\"code\":") {
        return false;
    }
    if !jw_str_into(value, code, bufx_cstr_len(code)) {
        return false;
    }
    if !buf_append_cstr(value, ",\"message\":") {
        return false;
    }
    if !jw_str_into(value, msg, bufx_cstr_len(msg)) {
        return false;
    }
    // ⚠ **收尾那个 `}` 不能少**：少了它这段不是合法 JSON，`dwh_take_owned_err`
    // 解不开 ⇒ 走 `dwh_rpc_ok` ⇒ 客户端收到 `ok:true` + 一段带标记的垃圾值，
    // 于是把它当成功的返回值继续走（症状是「点了没反应」，离根因极远 —— 实测，
    // 而且是被 `web-err-env` 那一轮当场抓住的：它对正常值也判「业务错」）。
    return buf_append_byte(value, 125);
}

// 拆 `dwh_rpc_owned_err` 写下的内部标记。返回 false = 这不是错误（是正常的 value）。
// `code` / `msg` 拿到之后发给 `dwh_rpc_err`（拼信封只有那一处）。
fn dwh_take_owned_err(value: &const Buf, code: &Buf, msg: &Buf) bool {
    buf_reset(code);
    buf_reset(msg);
    if !dwh_has_frag(value, "\"__err\":true" as &const byte) {
        return false;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    var abuf: [byte: 65536] = [0: 65536];
    arena_init(&arena, &abuf[0], 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, value.ptr as &const byte, value.len, &root) {
        return false;
    }
    return dwh_take_str(&root, "code" as &const byte, 4, code)
        && dwh_take_str(&root, "message" as &const byte, 7, msg);
}

// `session/selectModel`：切模型。入参 `{sessionId,provider,model,reasoningEffort?}`，
// 出参 `{selected:{provider,model,reasoningEffort?}}`。
//
// **两处都要落**（`dwhmodel.uya` 不变量③）：
//   ① 执行核：往子进程 stdin 写 `/model <provider>/<model>` 与（给了档位时）
//      `/effort <level>` 两行 —— 那是真正生效的地方，会话日志里会落一条
//      `session/model`（`--resume` 跟着它走）；
//   ② 投影：宿主自己的当前值（浏览器里的选择器读它）。
// 只落一处 = 「界面变了、请求没变」或反过来 —— 两种都骗人。
fn dwh_select_model(h: &DwhHost, body: &const Buf, value: &Buf) bool {
    var prov: Buf = buf_new(128);
    defer { buf_free(&prov); }
    var model: Buf = buf_new(128);
    defer { buf_free(&model); }
    var eff: Buf = buf_new(64);
    defer { buf_free(&eff); }
    if !dwh_select_args(body, &prov, &model, &eff) {
        return dwh_rpc_owned_err(value, "gateway/bad-request",
            DWH_SELMODEL_NOTE);
    }
    // 目录里没有这一对：**如实拒绝**（DSH 的 `session/model-unavailable`）。
    // 静默接受会让选择器显示一个永远不会生效的模型。
    if !dwhm_has(&h.model, prov.ptr as &const byte, prov.len,
        model.ptr as &const byte, model.len) {
        return dwh_rpc_owned_err(value, "session/model-unavailable",
            "这个模型不在本机的模型目录里（看 DSH 的 settings.yaml）");
    }
    const rc: i32 = dwhm_select(&h.model, prov.ptr as &const byte, prov.len,
        model.ptr as &const byte, model.len, eff.ptr as &const byte, eff.len);
    if rc == 2 {
        return dwh_rpc_owned_err(value, "gateway/bad-request",
            "这个模型没有公布那个推理档位");
    }
    // ① 执行核（活会话才有；只读模式下只更新宿主的选择，让界面保持一致）
    if h.live {
        if !dwh_push_model_cmd(h, &prov, &model, &eff) {
            return dwh_rpc_owned_err(value, "internal",
                "切模型的命令送不进对话子进程（它可能已经退出）");
        }
    }
    // ② 出参 + 投影帧（两处都用同一个 `dwhm_selected_json`，见上面那条注）
    if !dwhm_selected_json(&h.model, value) {
        return false;
    }
    return true;
}

// 取 `session/selectModel` 的三个字段（`sessionId` 必须是我们那条；`reasoningEffort` 可选）。
fn dwh_select_args(body: &const Buf, prov: &Buf, model: &Buf,
    eff: &Buf) bool {
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    var abuf: [byte: 65536] = [0: 65536];
    arena_init(&arena, &abuf[0], 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, body.ptr as &const byte, body.len, &root) {
        return false;
    }
    // 与 `dwh_prompt_text` 同一个形状问题：真实客户端把入参包在
    // `payload.args.request` 里（见 `dwh_req_args`）。
    var args: JsonValue = JsonValue.json_null();
    if !dwh_req_args(&root, &args) {
        return false;
    }
    var sess: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if !js_obj_get_str(&args, "sessionId" as &const byte, 9, &sess) {
        return false;
    }
    if !sv_eq_cstr_view(&sess, DWH_SESSION_ID) {
        return false;
    }
    if !dwh_take_str(&args, "provider" as &const byte, 8, prov) {
        return false;
    }
    if !dwh_take_str(&args, "model" as &const byte, 5, model) {
        return false;
    }
    // `reasoningEffort` 是**可选**的：没给就留空（= 不动现有档位，与
    // `agent_model_apply` 的 `effort_set` 口径一致）。
    _ = dwh_take_str(&args, "reasoningEffort" as &const byte, 15, eff);
    return prov.len > 0 && model.len > 0;
}

// 取一个**可选的**字符串字段（反转义后写进 out）。返回 false = 没有这个键 / 类型不对。
fn dwh_take_str(obj: &const JsonValue, key: &const byte, kl: usize,
    out: &Buf) bool {
    var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if !js_obj_get_str(obj, key, kl, &sv) {
        return false;
    }
    buf_reset(out);
    return sv_unescape(&sv, out);
}

// 往子进程 stdin 排 `/model` 与 `/effort` 两行（P62 的 `provider/model` 写法）。
fn dwh_push_model_cmd(h: &DwhHost, prov: &const Buf, model: &const Buf,
    eff: &const Buf) bool {
    var line: Buf = buf_new(prov.len + model.len + 32);
    defer { buf_free(&line); }
    if !buf_append_cstr(&line, "/model ") {
        return false;
    }
    if !buf_append(&line, prov.ptr as &const byte, prov.len) {
        return false;
    }
    if !buf_append_byte(&line, 47) {
        return false;
    }
    if !buf_append(&line, model.ptr as &const byte, model.len) {
        return false;
    }
    if dwhc_send_line(&h.child, line.ptr as &const byte, line.len) != 0 {
        return false;
    }
    if eff.len == 0 {
        return true;
    }
    var l2: Buf = buf_new(eff.len + 16);
    defer { buf_free(&l2); }
    if !buf_append_cstr(&l2, "/effort ") {
        return false;
    }
    if !buf_append(&l2, eff.ptr as &const byte, eff.len) {
        return false;
    }
    return dwhc_send_line(&h.child, l2.ptr as &const byte, l2.len) == 0;
}

// 设置面板那一簇（General / Models / Built-in plugins / Agent presets 四个页签）。
//
// **为什么这一簇非有不可**：它们是「页面看起来坏了」而不是「报错」的形态 ——
// 未实现时客户端把整片面成一条红字（实测四页签各自的症状）：
//   * General        → `Permission` 那一行写 `internal: not implemented:
//                      permissionPresets/catalog`，选择器整块 `Unavailable`
//   * Models         → `Loading the provider directory failed: not implemented:
//                      llm/listProviders` + 一个 `Retry` 按钮
//   * Built-in plugins → `Plugins are temporarily unavailable.`
//   * Agent presets  → `not implemented: agentPresets/list`
// 而它们是**只读的元信息**（本仓没有可写的设置文档），给中性值语义正确。
//
// 形状全部**从真 DSH 的 typert host 逐个抄**（`z.object` 的键名与可选性），
// 不按印象写 —— 形状猜错时客户端是 `undefined` 崩，比「未实现」更难查。
// 导出（`export`）：`st_web` 的 `web-panel` 轮按方法名逐个调它 —— 这一簇的缺陷
// 形态是「四个页签各一条红字」，只有把每个方法都调一遍（或把页签都点一遍）才看得见。
export fn dwh_unary_settings(method: &const byte, ml: usize, value: &Buf) bool {
    // `permissionPresets/catalog`：三个档位 + 默认档（值与本仓的访问模式同名）。
    if bufx_eq_cstr(method, ml, "permissionPresets.catalog" as &const byte) {
        // 行宽豁免：不可断的 JSON 字面量
        return buf_append_cstr(value, "{\"options\":[{\"value\":\"read-only\",\"name\":\"read-only\",\"description\":\"只读：写工具被拒，bash 逐条批准\"},{\"value\":\"workspace-write\",\"name\":\"workspace-write\",\"description\":\"工作区写：bash 关在内核沙箱里，只能写工作区\"},{\"value\":\"danger-full-access\",\"name\":\"danger-full-access\",\"description\":\"全权：不限制（默认）\"}],\"defaultOptions\":[{\"value\":\"danger-full-access\",\"name\":\"danger-full-access\"}],\"defaultPreset\":\"danger-full-access\"}");
    }
    // `llm/listProviders` / `llm/listConfigurableProviders`：本仓只有一条路线
    // （模型来自 DSH 设置），所以是**一个** provider；可配置的那条是空数组
    // （本仓的设置文档不可写 ⇒ 「没有可配置项」比「列一堆改不动的」诚实）。
    if bufx_eq_cstr(method, ml, "llm.listProviders" as &const byte) {
        return buf_append_cstr(value,
            "[{\"id\":\"uya-agent\",\"name\":\"uya-agent\"}]");
    }
    if bufx_eq_cstr(method, ml, "llm.listConfigurableProviders" as &const byte) {
        return buf_append_cstr(value, "[]");
    }
    // `agentPresets/list`：一条标准档（会话就是按它建的，见 `session.create`）。
    if bufx_eq_cstr(method, ml, "agentPresets.list" as &const byte) {
        // 行宽豁免：不可断的 JSON 字面量
        return buf_append_cstr(value, "{\"presets\":[{\"id\":\"standard\",\"isDefault\":true,\"name\":\"standard\"}]}");
    }
    // `credentials/describe`：形状是 `Record<string, {configured,writable}>`。
    // 本仓不读凭据（DSH 设置那条路走的是 `.credentials.yaml`，回给页面没有意义）
    // ⇒ **空映射**：客户端据此画「没有需要配置的凭据」，而不是报错。
    if bufx_eq_cstr(method, ml, "credentials.describe" as &const byte) {
        return buf_append_cstr(value, "{}");
    }
    // `pluginInventory/list`：本仓的插件是编译期注册的，没有可检视的动态清单
    // ⇒ 回**空列表**（页签显示「没有插件」，而不是「暂时不可用」）。
    if bufx_eq_cstr(method, ml, "pluginInventory.list" as &const byte) {
        return buf_append_cstr(value, "{\"items\":[]}");
    }
    return false;
}

// 一个 WorkspaceView（`workspace.list` 与 `workspace/follow` 的 baseline **必须同一份**）。
//
// ⚠ 这两处**不一致**过一次，代价是一整轮排查：unary 那条回了一个工作区，而
// follow 的 baseline 回了 `items: []` ⇒ 客户端「从流里」看到的是**零个工作区** ⇒
// 它停在 `Choose workspace` 空态、**永远不开 `session/follow`** ⇒ 消息一条都不渲染。
// 而单看任一条（curl unary、裸 socket 开 follow）都是对的 —— 只有它们**不一致**
// 才出问题。所以现在共用这一个函数。
fn dwh_workspace_item(out: &Buf) bool {
    if !buf_append_cstr(out, "{\"workspaceId\":\"ws-uya\",\"path\":") {
        return false;
    }
    if !dwh_cwd_json(out) {
        return false;
    }
    if !buf_append_cstr(out, ",\"title\":\"本仓工作区\",\"sessionIds\":[\"") {
        return false;
    }
    if !buf_append_cstr(out, DWH_SESSION_ID) {
        return false;
    }
    // 行宽豁免：不可断的 JSON 字面量
    return buf_append_cstr(out, "\"],\"createdAt\":\"2026-01-01T00:00:00.000Z\",\"updatedAt\":\"2026-01-01T00:00:00.000Z\"}");
}

// 把工作区写成 JSON 字符串。取 `cfg.workspace`（启动时定稿的那份），
// 不另起 getcwd：本仓的 `--web`/TUI 都用它，口径统一（也是「一个真值源」那条纪律）。
fn dwh_cwd_json(out: &Buf) bool {
    return dwh_workspace_json(out);
}

// 把当前工作区（`cfg.workspace`）写成 JSON 字符串（空则退化成 "/"）。
fn dwh_workspace_json(out: &Buf) bool {
    const ws: &byte = getenv("PWD" as &const byte);
    if (ws as usize) == 0 || bufx_cstr_len(ws) == 0 {
        return buf_append_cstr(out, "\"/\"");
    }
    return jw_str_into(out, ws, bufx_cstr_len(ws));
}

// 把 `$HOME` 写成 JSON 字符串（失败退化成 "/"）。
fn dwh_home_json(out: &Buf) bool {
    const home: &byte = getenv("HOME" as &const byte);
    if (home as usize) == 0 || bufx_cstr_len(home) == 0 {
        return buf_append_cstr(out, "\"/\"");
    }
    return jw_str_into(out, home, bufx_cstr_len(home));
}

// `getcwd(2)` 的结果写进 out（带 NUL，因为系统调用是 C 串语义）。
fn dwh_getcwd_into(out: &Buf) bool {
    buf_reset(out);
    const p: &byte = sys_getcwd_buf();
    if (p as usize) == 0 || bufx_cstr_len(p) == 0 {
        return false;
    }
    return buf_append_cstr(out, p);
}

// 权限档位写成 JSON 字符串（快照的 `permissions.currentValue` 与
// `permissionPresets/catalog` 的档位必须是**同一个值** —— 客户端拿
// `currentValue` 去 `catalog.options` 里找，找不到就回落成
// 「把 undefined 当成名字」，那是崩溃而不是降级：见 `dwh_projection_values`）。
fn dwh_permission_json(out: &Buf, preset: &const byte) bool {
    return jw_str_into(out, preset, bufx_cstr_len(preset));
}


// 会话 id（session.list / workspace.list / mux 三处必须是同一个值）。
        // 行宽豁免：不可断的 JSON 字面量
// **开头**的 seed 事件条数（`dwh_seed_records` 写 3 条）。译文的 seq 从这里接着排。
// ⚠ `session/end-seed` **不在这里** —— 实测真 DSH 的那份带消息的 snapshot 里，
// 它在**最后一条**（seq 21/22），因为它的语义是「历史到此为止」的收口标记。
// 我此前把它和第 4 条开头 seed 放在一起，位置错了（症状：我方夹具不渲染，
// 而真夹具渲染得出来 —— 两者数据形状几乎一样，只有 end-seed 的位置不同）。
// `pub`：`dwhchild.uya` 的 `DWH_LIVE_SHIFT` 从它算（活事件的位移是它 +1）。
// 两处都写死数字就会各自漂移，而漂移的症状是客户端断流（见 `dwh_shift_seq`）。
export const DWH_SEED_SEQS: u64 = 3;

// 会话 id（session.list / workspace.list / mux 三处必须是同一个值；`--dsh-web` 今天
// 只有这一条会话）。**导出**：`dwhchild.uya` 拿它当子进程的
// `UYA_AGENT_FORCE_SESSION_ID`，并据此算出会话日志路径 —— 两处各写一个常量就会变成
// 「父进程读的文件不是子进程写的那个」，而症状只是「发了消息没反应」。
export const DWH_SESSION_ID: &const byte = "session-uya-0000-0000-0000-000000000001" as &const byte;

// 把译文的每一行包成 `{"event":…}`（DSH 的 HistoryEntry），逗号分隔。
fn dwh_events_as_history(events: &const Buf, out: &Buf) bool {
    var start: usize = 0;
    var i: usize = 0;
    var first: bool = true;
    while i <= events.len {
        const at_end: bool = i == events.len;
        if at_end || events.ptr[i] == 10 as byte {
            const seg: usize = i - start;
            if seg > 0 {
                if !first && !buf_append_byte(out, 44) {
                    return false;
                }
                first = false;
                if !buf_append_cstr(out, "{\"event\":") {
                    return false;
                }
                if !buf_append(out, &events.ptr[start], seg) {
                    return false;
                }
                if !buf_append_byte(out, 125) {
                    return false;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return true;
}

// ============================================================
// WebSocket（只发不收）
// ============================================================

// 一帧 text（服务端→客户端，**不掩码**：RFC 6455 规定服务端不许掩码）。
fn dwh_ws_send_text(fd: i32, payload: &const byte, n: usize) bool {
    var head: [byte: 10] = [0: 10];
    head[0] = 129;      // FIN + text
    var hn: usize = 2;
    if n < 126 {
        head[1] = n as byte;
    } else if n < 65536 {
        head[1] = 126;
        head[2] = ((n >> 8) & 255 as usize) as byte;
        head[3] = (n & 255 as usize) as byte;
        hn = 4;
    } else {
        head[1] = 127;
        var k: usize = 0;
        while k < 8 {
            head[2 + k] = ((n >> ((7 - k) * 8)) & 255 as usize) as byte;
            k = k + 1;
        }
        hn = 10;
    }
    if !srv_write_all(fd, &head[0], hn) {
        return false;
    }
    if n == 0 {
        return true;
    }
    return srv_write_all(fd, payload, n);
}

// 把一条 DSH 的 `ServerRequest` 包好发出去（rpcId 每帧新铸 —— 纯推送帧）。
fn dwh_ws_push_frame(fd: i32, rpc_seq: usize, method: &const byte,
    payload: &const Buf) bool {
    var buf: Buf = buf_new(payload.len + 512);
    defer { buf_free(&buf); }
    if !buf_append_cstr(&buf, "{\"type\":\"server-request\",\"rpcId\":\"r-") {
        return false;
    }
    if !buf_append_u64(&buf, rpc_seq as u64) {
        return false;
    }
    if !buf_append_cstr(&buf, "\",\"method\":\"") {
        return false;
    }
    if !buf_append_cstr(&buf, method) {
        return false;
    }
    if !buf_append_cstr(&buf, "\",\"payload\":") {
        return false;
    }
    if !buf_append(&buf, payload.ptr as &const byte, payload.len) {
        return false;
    }
    if !buf_append_byte(&buf, 125) {
        return false;
    }
    return dwh_ws_send_text(fd, buf.ptr as &const byte, buf.len);
}

// 一条基线段：mux 下行要把「已订阅 + 每条会话事件 + 标题投影」发一遍
// （重连基线，见 DSH 的 events 契约）。这里只有一条会话，所以直接全发。
fn dwh_ws_send_baseline(h: &const DwhHost, c: &DwhConn) bool {
    var p: Buf = buf_new(1024);
    var seq: usize = 1;
    defer { buf_free(&p); }
    if c.is_remote {
        // 0.2.0：**没有基线**。实测真 DSH 在这条连接上只等客户端的 `open` 帧，
        // 服务端唯一主动发的是某条流的 `item`（如 `$events` 的 `ready`）。
        // 所以这里什么都不发 —— 发一个「像 0.1.1 那样的 subscribed」反而会让
        // 客户端把未知帧当错误。
        return true;
    }
    if c.is_mux {
        // 行宽豁免：不可断的 JSON 字面量
        if !buf_append_cstr(&p, "{\"type\":\"session/subscribed\",\"sessionId\":\"") {
            return false;
        }
        if !buf_append_cstr(&p, DWH_SESSION_ID) {
            return false;
        }
        if !buf_append_cstr(&p, "\",\"lastSeq\":2}") {
            return false;
        }
        // 行宽豁免：不可断的 JSON 字面量
        if !dwh_ws_push_frame(c.fd, seq, "session/subscribed" as &const byte, &p) {
            return false;
        }
        seq = seq + 1;
        // 每条会话事件（译文那一行原样塞进 `event`）
        var start: usize = 0;
        var i: usize = 0;
        while i <= h.events.len {
            const at_end: bool = i == h.events.len;
            if at_end || h.events.ptr[i] == 10 as byte {
                const seg: usize = i - start;
                if seg > 0 {
                    buf_reset(&p);
        // 行宽豁免：不可断的 JSON 字面量
                    if !buf_append_cstr(&p, "{\"type\":\"session/event\",\"sessionId\":\"") {
                        return false;
                    }
                    if !buf_append_cstr(&p, DWH_SESSION_ID) {
                        return false;
                    }
                    if !buf_append_cstr(&p, "\",\"event\":") {
                        return false;
                    }
                    if !buf_append(&p, &h.events.ptr[start], seg) {
                        return false;
                    }
                    if !buf_append_byte(&p, 125) {
                        return false;
                    }
        // 行宽豁免：不可断的 JSON 字面量
                    if !dwh_ws_push_frame(c.fd, seq, "session/event" as &const byte, &p) {
                        return false;
                    }
                    seq = seq + 1;
                }
                start = i + 1;
            }
            i = i + 1;
        }
        // 标题投影（**纯字符串**）
        buf_reset(&p);
        // 行宽豁免：不可断的 JSON 字面量
        if !buf_append_cstr(&p, "{\"type\":\"session/projection\",\"sessionId\":\"") {
            return false;
        }
        if !buf_append_cstr(&p, DWH_SESSION_ID) {
            return false;
        }
        // 行宽豁免：不可断的 JSON 字面量
        if !buf_append_cstr(&p, "\",\"key\":\"title\",\"value\":\"本仓会话\",\"seq\":2}") {
            return false;
        }
        // 行宽豁免：不可断的 JSON 字面量
        return dwh_ws_push_frame(c.fd, seq, "session/projection" as &const byte, &p);
    }
    // host 下行：一条 `host/session-added`（列表增量）
        // 行宽豁免：不可断的 JSON 字面量
    if !buf_append_cstr(&p, "{\"type\":\"host/session-added\",\"sessionId\":\"") {
        return false;
    }
    if !buf_append_cstr(&p, DWH_SESSION_ID) {
        return false;
    }
    if !buf_append_cstr(&p, "\",\"blank\":false,\"cwd\":\"/\"}") {
        return false;
    }
        // 行宽豁免：不可断的 JSON 字面量
    return dwh_ws_push_frame(c.fd, seq, "host/session-added" as &const byte, &p);
}

// ============================================================
// HTTP 收头 / 应答
// ============================================================

// 收到完整请求头（`\r\n\r\n`）为止。成功返回头长度，失败返回 -1。
// 头之后可能已有 body 字节（还在 `c.rx` 里，起点就是返回值）。
fn dwh_read_head(c: &DwhConn) isize {
    var tmp: [byte: 4096] = [0: 4096];
    while true {
        const he: isize = srv_find(c.rx.ptr as &const byte, 0, c.rx.len,
            "\r\n\r\n" as &const byte, 4);
        if he >= 0 {
            return (he as isize) + 4;
        }
        if c.rx.len >= DWH_HEAD_MAX {
            return -1;
        }
        // ⚠ fd 是**非阻塞**的（`srv_accept_nb` 设了 O_NONBLOCK），所以：
        //   n == 0 → 对端关了（真错）；n < 0 → **可能只是还没数据**（EAGAIN），
        //   要回一个「再等等」而不是把连接掐了。原实现把两者混为一谈，于是
        //   浏览器刚建好连接、头还没发完就被我们关掉 —— 症状是
        //   `[web-runtime] connection lost` 反复重连、shell 卡在最早两步。
        const n: isize = sys_read(c.fd, &tmp[0], 4096) catch { -1 as isize; };
        if n == 0 {
            return -1;      // 对端真的关了
        }
        if n < 0 {
            return -2;      // 还没数据：调用方留着连接、等下一圈 poll
        }
        if !buf_append(&c.rx, &tmp[0], n as usize) {
            return -1;
        }
    }
}

// 按 Content-Length 把 body 收全（`head_end` 之后的部分）。
fn dwh_read_body(c: &DwhConn, head_end: usize, body: &Buf) bool {
    buf_reset(body);
    var co: usize = 0;
    var cl: usize = 0;
    var want: usize = 0;
    if srv_head_value(c.rx.ptr as &const byte, c.rx.len, head_end,
        "content-length" as &const byte, &co, &cl) && cl > 0 {
        const v: i64 = parse_u64_at(c.rx.ptr[0: c.rx.len], co, cl);
        if v < 0 {
            return false;
        }
        want = v as usize;
    }
    if want > (16 * 1024 * 1024) {
        return false;      // 显式上限：`/api` 的体不该有几 MB（图片那条路是另一件事）
    }
    const have: usize = c.rx.len - head_end;
    if have > 0 {
        // 不用 if 表达式赋 const：codegen 为它生成 `const size_t __uya_ifexpr_N` 再赋值，
        // 宿主 C 报「assignment of read-only variable」（实测）。用可变变量表达同一件事。
        var take: usize = want;
        if have < want {
            take = have;
        }
        if !buf_append(body, &c.rx.ptr[head_end], take) {
            return false;
        }
    }
    var tmp: [byte: 8192] = [0: 8192];
    var spins: usize = 0;
    while body.len < want {
        const n: isize = sys_read(c.fd, &tmp[0], 8192) catch { -1 as isize; };
        if n < 0 {
            // EAGAIN：非阻塞 fd。等一小会儿重试，但不能死等（对端可能挂了）。
            spins = spins + 1;
            if spins > 2000 {
                return false;
            }
            continue;
        }
        if n == 0 {
            return false;
        }
        spins = 0;
        if !buf_append(body, &tmp[0], n as usize) {
            return false;
        }
    }
    return true;
}

// 从一个 JSON 体里取 `"rpcId":"…"` 的**含引号原文**（DSH 的应答必须回显它）。
fn dwh_pick_rpc(body: &const Buf, out: &Buf) bool {
    return dwh_pick_json_str(body, "rpcId" as &const byte, out);
}

// 从请求体里取一个**顶层字符串字段**，带引号写进 `out`（喂 `dwh_rpc_ok` 的 rpcId 位置）。
//
// ⚠ 用 JSON 解析器而不是「找 `"key":"` 这段连写文本」：客户端（以及任何
// 标准序列化器）会在冒号后留空格 —— `"rpcId": "…"`，而连写判据在那种 body 上
// **恒不成立**。实测症状：真客户端打 `syncInspectManifest` 时宿主回
// **HTTP 400 `no rpcId`**，而裸 curl（我自己拼的紧凑 JSON）永远复现不出——
// 因为那不是同一个 body 形状。这也违反本仓不变量②（业务错该回 200，不是 400）。
fn dwh_pick_json_str(body: &const Buf, key: &const byte, out: &Buf) bool {
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    var abuf: [byte: 65536] = [0: 65536];
    arena_init(&arena, &abuf[0], 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, body.ptr as &const byte, body.len, &root) {
        return false;
    }
    var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if !js_obj_get_str(&root, key, bufx_cstr_len(key), &sv) {
        return false;
    }
    buf_reset(out);
    if !buf_append_byte(out, 34) {
        return false;
    }
    // 反转义（parse 是零拷贝的）：写进一个临时缓冲再搬，理由同 `dwh_read_inject`
    var un: Buf = buf_new(sv.len + 8);
    defer { buf_free(&un); }
    if !sv_unescape(&sv, &un) {
        return false;
    }
    if !buf_append(out, un.ptr as &const byte, un.len) {
        return false;
    }
    return buf_append_byte(out, 34);
}

// 从一个 JSON 体里取 `"method":"…"` 的值（不含引号）。DSH 要求它与路径一致。
fn dwh_pick_method(body: &const Buf, out: &Buf) bool {
    var quoted: Buf = buf_new(128);
    defer { buf_free(&quoted); }
    if !dwh_pick_json_str(body, "method" as &const byte, &quoted) {
        return false;
    }
    // `dwh_pick_json_str` 给的是**带引号**的形态（rpcId 那边要引号）；
    // 方法名这边用不带引号的，所以剥掉首尾两个引号。
    if quoted.len < 2 {
        return false;
    }
    buf_reset(out);
    return buf_append(out, &quoted.ptr[1], quoted.len - 2);
}

// ============================================================
// 生命周期
// ============================================================

// 起宿主：找 dist、装 boot 图、读事件源、监听。
// `addr` 形如 "127.0.0.1:PORT"（`PORT` 为 0 = 让内核给一个）。
export fn dwh_start(h: &DwhHost, cfg: &const Config, addr: &const byte,
    an: usize, events_path: &const byte, assets: &const byte, al: usize,
    token: &const byte, tl: usize) bool {
    h.lfd = -1;
    h.dist = buf_empty();
    h.root = buf_empty();
    h.entries = buf_empty();
    h.preloads = buf_empty();
    h.events = buf_empty();
    h.token = buf_empty();
    h.dsh_home = buf_empty();
    h.n = 0;
    h.live = false;
    h.child = dwhc_zero();
    h.model = dwhm_zero();
    h.f_sid = buf_new(512);
    h.e_sid = buf_new(512);
    h.pushed = 0;
    var i: usize = 0;
    while i < DWH_MAX_CONNS {
        h.conns[i].fd = -1;
        h.conns[i].st = DWH_C_DONE;
        h.conns[i].rx = buf_empty();
        h.conns[i].sids = buf_empty();
        h.conns[i].is_mux = false;
        h.conns[i].is_remote = false;
        h.conns[i].remote_ready = false;
        h.conns[i].sent = false;
        i = i + 1;
    }
    if !dwh_find_root(&h.root, assets, al) {
        return false;
    }
    h.dist = buf_new(1200);
    if !buf_append(&h.dist, h.root.ptr as &const byte, h.root.len) {
        return false;
    }
        // 行宽豁免：不可断的 JSON 字面量
    if !buf_append_cstr(&h.dist, "/node_modules/@deepseek-ai/dsh-web-frontend/dist") {
        return false;
    }
    h.entries = buf_new(65536);
    if !dwh_build_entries(h, &h.entries) {
        return false;
    }
    // bootstrap script 片段**在这里算一次**（渲染 index 时直接用）。
    // 为什么不放在渲染里重算：算它要**重扫 roster 并把 71 个 bundle 全读一遍**
    // （0.2.0 实测约 11 MiB）；而每个页面的 index 请求都会走那条路 ——
    // 单线程宿主里那是白白阻塞下行。契约不变（同一次运行内 bundle 不会变）。
    h.preloads = buf_new(1024);
    if !dwh_build_preloads(h, &h.preloads) {
        return false;
    }
    // 事件源：一份翻好的译文（`web/wsess.uya` 的输出）。读不到就空着
    // （页面仍能起来，只是没有消息 —— 这比整个宿主起不来好）。
    h.events = buf_new(4194304);
    if bufx_cstr_len(events_path) > 0 {
        // ⚠ 路径要 **NUL 结尾**才喂 `sys_open`（`dwh_read_file` 同 `dwh_client_path`
        // 那条纪律：C 串语义）。env 给的那份没有 NUL，这里显式补一个。
        var ep: Buf = buf_new(bufx_cstr_len(events_path) + 1);
        defer { buf_free(&ep); }
        _ = buf_append_cstr(&ep, events_path);
        _ = buf_append_byte(&ep, 0);
        _ = dwh_read_file(ep.ptr as &const byte, &h.events, 4194304);
    }
    // P80 第二十三批：**没给事件源就是活会话**（用户零参数跑 `--dsh-web` 的形态）。
    // 给了译文那条路（只读演示）一个字节都不改：不 fork、`session/prompt` 回
    // 业务错 —— 那正是「快照逗号」与「零事件源」两条判据各自覆盖的形态。
    if h.events.len == 0 {
        if !dwh_live_start(h, cfg) {
            return false;
        }
    }
    // 模型目录：**两种模式都装**（只读演示也要能看见本机有哪些模型 ——
    // 「页面里能选」与「选了能生效」是两件事，前者不依赖活会话）。
    //
    // ⚠ 设置根在**这里**也要保证解出来：只读演示模式根本不走 `dwh_live_start`
    // （那条路里才有解它的代码），而目录**两种模式都要**。少了这一步时只读演示
    // 恒报「读不到 settings.yaml」（实测：`dwhm_load` 拿一个空 home 去拼路径）。
    if h.dsh_home.len == 0 && !dwh_dsh_home(h, cfg) {
        out_err("[dsh-web] 定不出 DSH 设置根（$HOME 没设？）\n");
    }
    if !dwhm_load(&h.model, &h.dsh_home) {
        out_err("[dsh-web] 提示：读不到 DSH 的 settings.yaml，模型选择器会是空的\n");
    }
    // 监听
    var a: byte = 127;
    var b: byte = 0;
    var cc: byte = 0;
    var d: byte = 1;
    var port: u16 = 0;
    if !dwh_parse_addr(addr, an, &a, &b, &cc, &d, &port) {
        return false;
    }
    h.lfd = srv_listen(a, b, cc, d, port, 16);
    if h.lfd < 0 {
        return false;
    }
    // 访问令牌（见 `dshauth.uya` 不变量①）：
    //   * 显式给了 `--dsh-token` ⇒ 用它；
    //   * 绑**非回环**（别人能连上）而没给 ⇒ **自动生成一个并打出来** ——
    //     把服务暴露到局域网却毫无门槛是明确的安全缺陷，而「打出来」让正常的
    //     用法（把 URL 发给同事）仍然一步到位；
    //   * 绑回环 ⇒ 不校验（本机看页面是最常见的用法，要令牌只会碍事）。
    if tl > 0 {
        if !buf_append(&h.token, token, tl) {
            return false;
        }
    } else if a != 127 || b != 0 || cc != 0 || d != 1 {
        h.token = buf_new(DSHAUTH_TOKEN_LEN + 1);
        if !dshauth_make(&h.token) {
            return false;
        }
        out_err("[dsh-web] 绑在非回环地址 —— 已生成本次访问令牌：\n");
        out_err("[dsh-web]   ");
        _ = srv_write_all(2, h.token.ptr as &const byte, h.token.len);
        out_err("\n");
        out_err("[dsh-web] 首次访问带 `?token=`（之后靠 cookie）；换令牌重启即可。\n");
    }
    return true;
}

// ============================================================
// P80 第二十三批：活会话（子进程 + 日志 tail + 输入帧）
// ============================================================

// 起活会话：定 agent home / DSH home → fork 对话子进程 → 打开会话日志。
// 失败**不静默**：每一条都在 stderr 上说了原因（用户零参数跑时这是唯一的线索）。
fn dwh_live_start(h: &DwhHost, cfg: &const Config) bool {
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        out_err("[dsh-web] 定不出 agent home（$HOME 没设？）\n");
        return false;
    }
    // DSH 的设置根：模型目录与子进程的 persona 都从它来（`--dsh-home` 优先）。
    if !dwh_dsh_home(h, cfg) {
        out_err("[dsh-web] 定不出 DSH 设置根（$HOME 没设？）\n");
        return false;
    }
    if !dwhc_start(&h.child, cfg, &home, DWH_SESSION_ID,
        bufx_cstr_len(DWH_SESSION_ID)) {
        out_err("[dsh-web] 对话子进程起不来；页面能开但发消息不会有回应\n");
        return false;
    }
    h.live = true;
    // 没有凭据是最常见的「起得来但不回话」：**在启动时就说清楚**，别让用户对着
    // 一个不回话的输入框猜（子进程自己也会在它的日志里报同一件事）。
    if cfg.api_key.len == 0 {
        out_err("[dsh-web] 警告：没有 API 凭据（UYA_AGENT_API_KEY / --api-key）——");
        out_err("消息会进会话，但请求发不出去\n");
    }
    out_err("[dsh-web] 活会话已就绪：浏览器里的消息会送到这条会话（id=");
    _ = srv_write_all(2, DWH_SESSION_ID, bufx_cstr_len(DWH_SESSION_ID));
    out_err("）\n");
    // 子进程的诊断落在**另一个文件**（不是会话日志 —— 那份必须是干净的 JSONL，
    // 见 `dwhc_child_exec`）。把路径打出来：出问题时人直接去看它。
    const ep: &const Buf = dwhc_err_path_of(&h.child);
    if ep.len > 0 {
        out_err("[dsh-web] 子进程诊断：");
        _ = srv_write_all(2, ep.ptr as &const byte, ep.len);
        out_err("\n");
    }
    return true;
}

// 解 DSH 的设置根（`--dsh-home` > `$DSH_HOME` > `~/.dsh`）并记进宿主。
// 幂等：已经有值时直接返回 true（两种模式都会调到它）。
fn dwh_dsh_home(h: &DwhHost, cfg: &const Config) bool {
    if h.dsh_home.len > 0 {
        return true;
    }
    // ⚠ `dsh_home_resolve` 的入参是 **C 串**（它 `bufx_cstr_len` 量长度），而
    // `cfg.dsh_home` 是个 `Buf`（没有 NUL 结尾）：直接传它的指针会一路读到相邻
    // 内存 —— 实测拼出来的路径是 `/tmp/lp2/dsh4`（多带一个字节），`mx_load`
    // 打开它当然失败，而症状只是「读不到 settings.yaml、模型选择器会是空的」。
    // 所以**先补一个 NUL 再传**。
    var ex: Buf = buf_empty();
    defer { buf_free(&ex); }
    if cfg.dsh_home.len > 0 {
        ex = buf_new(cfg.dsh_home.len + 1);
        if !buf_append(&ex, cfg.dsh_home.ptr as &const byte, cfg.dsh_home.len) {
            return false;
        }
        if !buf_append_byte(&ex, 0) {
            return false;
        }
    }
    const expl: &const byte = if ex.len > 0 {
        ex.ptr as &const byte
    } else {
        "" as &const byte
    };
    if !dsh_home_resolve(expl, &h.dsh_home) {
        return false;
    }
    return h.dsh_home.len > 0;
}

// 一圈的活会话维护：收子进程的新行、翻成事件、攒进 `h.events`（**只追加**），
// 再把「还没推过的」那一段逐个推给订阅者。
//
// 为什么事件也进 `h.events` 而不是另开一份：`session/follow` 的**快照**与
// `/api/session/history` 都从 `h.events` 读（那两处一行都不改），活事件只是
// 「这份译文又长了一截」—— 一个真值源，两个消费口。
fn dwh_live_tick(h: &DwhHost) void {
    if !h.live {
        return;
    }
    // ① 子进程死了吗（收尸 + 一条可见的说明，然后就不再装活着）
    if !dwhc_poll_alive(&h.child) {
        var msg: Buf = buf_new(256);
        defer { buf_free(&msg); }
        if dwhc_err(&h.child).len > 0 {
            if !buf_append(&msg, dwhc_err(&h.child).ptr as &const byte,
                dwhc_err(&h.child).len) {
                return;
            }
        }
        dwh_live_error(h, &msg);
        dwhc_stop(&h.child, false);
        h.live = false;
        return;
    }
    // ② 待发输入尽量写出去（非阻塞；写不完留到下一圈）
    _ = dwhc_flush(&h.child);
    // ③ 新行 → 译文：追加进 `h.events`（快照 / history 与下行共用这一份）
    const n: usize = dwhc_tick(&h.child);
    if n > 0 {
        _ = buf_append(&h.events, dwhc_raw(&h.child).ptr as &const byte,
            dwhc_raw(&h.child).len);
        dwh_live_push_events(h);
        // ④ `turn/end` 到了 ⇒ 这一回合结束：推 `api-session/status(sid,false)`。
        // 客户端的 `running` 只从这条宿主事件来（`dsh-client-ui-session` 的
        // `ctx.remote.$on("api-session/status", …)`），消息流里**没有**它 ——
        // 不推的话「停止」按钮永远转着（而 agent 早就答完了）。
        if dwh_new_has_turn_end(&h.child) {
            dwh_host_event(h, "api-session/status" as &const byte, false);
        }
    }
}

// 这一批新行里有没有 `turn/end`（按字节找 `"type":"turn/end"`，容忍冒号后的空白）。
// 为什么按字节找而不是解析：`dwhc_one_line` 刚写出来的就是 `dwire_*` 的产物，
// 形状是本仓自己定的；这里只是「这一批要不要多推一帧」的判据。
fn dwh_new_has_turn_end(c: &const DwhChild) bool {
    const raw: &const Buf = dwhc_raw(c);
    return srv_find(raw.ptr as &const byte, 0, raw.len,
        "\"turn/end\"" as &const byte,
        bufx_cstr_len("\"turn/end\"" as &const byte)) >= 0;
}

// 把 `h.events` 里**还没推过**的行逐个推给 `session/follow`。
//
// seq 位移在 `dwhc_one_line` 里已经做过（`DWH_LIVE_SHIFT`），所以这里原样发 ——
// 同一行的位移**只能有一处**：这里再过一遍就是双重位移，客户端判不连续并断流。
fn dwh_live_push_events(h: &const DwhHost) void {
    if h.f_sid.len == 0 {
        return;      // 那条流还没开：先攒着（快照会给全量）
    }
    // **按每一条开过的流各推一份**（每条帧带**它自己**的 streamId）。
    // 见 `f_sid` 的注：真实客户端在同一条连接上把 `session/follow` 开好几次，
    // 只认最后那条 —— 只推给「最新的一条」时，推出去的事件带着旧 id 就被丢弃。
    var s0: usize = 0;
    var k: usize = 0;
    while k <= h.f_sid.len {
        const at_end: bool = k == h.f_sid.len;
        if at_end || h.f_sid.ptr[k] == 10 as byte {
            const sl: usize = k - s0;
            if sl > 0 {
                dwh_push_one_stream(h, &h.f_sid.ptr[s0], sl);
            }
            s0 = k + 1;
        }
        k = k + 1;
    }
}

// 把 `h.pushed` 之后的新事件推给**一条**流（`sid` 是它的 streamId）。
// 一条日志译文（含尾 `\n`）→ 它**不含换行**的那一段。
//
// ⚠ 必须去掉尾 `\n`：`dwhc_raw` 里的每一行是「含换行的完整行」（那是
// `dwire_line` 的产物），而它要被**嵌进一条 JSON 帧**里 ——
// 那个换行会让帧变成两行：`{"type":"item",…,"event":{…}}\n}`，
// 客户端的 `parseRemoteStreamServerMessage` 当场判**不是合法 JSON**
// ⇒ `invalid Remote stream frame` ⇒ `close(4002)` 并每 3 秒重连
// （实测：一次加载 84 次重连、页面停在初始态，而宿主这边每一帧都「发成功了」——
// 字号对不上时症状离原因极远）。
fn dwh_trim_nl(line: &const byte, n: usize) usize {
    if n > 0 && line[n - 1] == 10 as byte {
        return n - 1;
    }
    return n;
}

// 把「还没推过的」译文逐行推给**一条** `session/follow` 流（见 `dwh_live_frame`）。
fn dwh_push_one_stream(h: &const DwhHost, sid: &const byte, sl: usize) void {
    var sidb: Buf = Buf{ ptr: sid as *byte, len: sl, cap: sl };
    const fd: i32 = dwh_fd_of_stream(h, &sidb);
    if fd < 0 {
        return;
    }
    var start: usize = h.pushed;
    var i: usize = h.pushed;
    while i <= h.events.len {
        const at_end: bool = i == h.events.len;
        if at_end || h.events.ptr[i] == 10 as byte {
            const seg: usize = dwh_trim_nl(&h.events.ptr[start], i - start);
            if seg > 0 {
                dwh_live_frame(h, fd, sid, sl, &h.events.ptr[start], seg);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    // 水位推进：`pushed` 是 `usize` 而 `h` 是 const —— 由调用方（`dwh_live_tick`）
    // 在推完之后用同一个值回写（见 `dwh_live_mark`）。
}

// 记下「已经推到哪里」（与 `dwh_live_push_events` 配对；分开是为了让推那一半
// 不碰宿主状态 —— 它要能被自测当纯函数验）。
fn dwh_live_mark(h: &DwhHost) void {
    h.pushed = h.events.len;
}

// 一条事件帧：`{"type":"item","streamId":…,"value":{"type":"event","event":{…}}}`。
// 与快照里的 `records[]` 是**同一条事件的两种载体**（快照是批量、这是增量），
// 所以 `event` 的字节完全一样 —— 客户端 fold 的是同一个对象。
fn dwh_live_frame(h: &const DwhHost, fd: i32, sid: &const byte, sl: usize,
    ev: &const byte, n: usize) void {
    if fd < 0 {
        return;
    }
    _ = h;
    var p: Buf = buf_new(n + sl + 128);
    defer { buf_free(&p); }
    if !buf_append_cstr(&p, "{\"type\":\"item\",\"streamId\":\"") {
        return;
    }
    if !buf_append(&p, sid, sl) {
        return;
    }
    if !buf_append_cstr(&p, "\",\"value\":{\"type\":\"event\",\"event\":") {
        return;
    }
    if !buf_append(&p, ev, n) {
        return;
    }
    if !buf_append_cstr(&p, "}}") {
        return;
    }
    _ = dwh_ws_send_text(fd, p.ptr as &const byte, p.len);
}

// 开着 `sid` 这条流的那条连接的 **fd**（没有回 -1）。
//
// 返回 fd 而不是下标：Uya 的数组边界证明器只认「正的 if 里做索引」，拿一个
// `isize` 回调用点再 `as usize` 索引是过不了证明的（实测报「数组索引安全证明
// 失败」）。循环变量 `i` 是能证明的，所以在这里取完就返回。
fn dwh_fd_of_stream(h: &const DwhHost, sid: &const Buf) i32 {
    var i: usize = 0;
    while i < DWH_MAX_CONNS {
        if h.conns[i].fd >= 0 && dwh_sids_has(&h.conns[i].sids, sid) {
            return h.conns[i].fd;
        }
        i = i + 1;
    }
    return -1;
}

// 往一份 streamId 清单里追加一条（每行一个，含 `\n`）。已经有的不重复加
// （同名流重开时 `sid` 不同，所以去重的判据是整行相等）。
fn dwh_sid_add(list: &Buf, sid: &const Buf) bool {
    if dwh_sids_has(list, sid) {
        return true;
    }
    if !buf_append(list, sid.ptr as &const byte, sid.len) {
        return false;
    }
    return buf_append_byte(list, 10);
}

// 这份清单（每行一个 streamId）里有 `sid` 吗（整行逐字节比，不做前缀匹配 ——
// 前缀匹配会让 `sf` 命中 `sf2`，于是帧被推到**另一条流**上）。
fn dwh_sids_has(list: &const Buf, sid: &const Buf) bool {
    var start: usize = 0;
    var i: usize = 0;
    while i <= list.len {
        const at_end: bool = i == list.len;
        if at_end || list.ptr[i] == 10 as byte {
            const seg: usize = i - start;
            if seg == sid.len && seg > 0
                && bufx_mem_eq(&list.ptr[start], sid.ptr as &const byte, seg) {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// 把一条**宿主事件**推给 `$events`（`api-session/status` 走这条）。
//
// 形状取自 DSH 的 `parseRemoteEventFrame`：`{type:"emit",event:"<名>",args:[…]}`，
// 三条键**一个都不能多**（`hasExactRemoteEventKeys`）。
fn dwh_host_event(h: &const DwhHost, name: &const byte, running: bool) void {
    if h.e_sid.len == 0 {
        return;
    }
    // 同 `dwh_live_push_events`：**每一条开过的 `$events` 流各推一份**
    // （`$events` 也会被开好几次 —— 实测一次加载里有两三条）。
    var s0: usize = 0;
    var k: usize = 0;
    while k <= h.e_sid.len {
        const at_end: bool = k == h.e_sid.len;
        if at_end || h.e_sid.ptr[k] == 10 as byte {
            const sl: usize = k - s0;
            if sl > 0 {
                dwh_host_event_one(h, &h.e_sid.ptr[s0], sl, name, running);
            }
            s0 = k + 1;
        }
        k = k + 1;
    }
}

// 把一条宿主事件推给**一条** `$events` 流。
fn dwh_host_event_one(h: &const DwhHost, sid: &const byte, sl: usize,
    name: &const byte, running: bool) void {
    var sidb: Buf = Buf{ ptr: sid as *byte, len: sl, cap: sl };
    const fd: i32 = dwh_fd_of_stream(h, &sidb);
    if fd < 0 {
        return;
    }
    var p: Buf = buf_new(256);
    defer { buf_free(&p); }
    if !buf_append_cstr(&p, "{\"type\":\"item\",\"streamId\":\"") {
        return;
    }
    if !buf_append(&p, sid, sl) {
        return;
    }
    if !buf_append_cstr(&p, "\",\"value\":{\"type\":\"emit\",\"event\":") {
        return;
    }
    if !jw_str_into(&p, name, bufx_cstr_len(name)) {
        return;
    }
    if !buf_append_cstr(&p, ",\"args\":[") {
        return;
    }
    if !jw_str_into(&p, DWH_SESSION_ID, bufx_cstr_len(DWH_SESSION_ID)) {
        return;
    }
    if !buf_append_cstr(&p, ",") {
        return;
    }
    // 不用 `if` 表达式挑字面量：codegen 为它生成一个 `int32_t __uya_ifexpr_N`
    // 临时量（**指针塞进 int**），宿主 C 直接报 `makes integer from pointer`
    // 而在 cc 段失败 —— 编译期检查看不见这个（同 `if` 表达式选长度那条）。
    const rv: &const byte = if running {
        "true" as &const byte
    } else {
        "false" as &const byte
    };
    if !buf_append_cstr(&p, rv) {
        return;
    }
    if !buf_append_cstr(&p, "]}}") {
        return;
    }
    _ = dwh_ws_send_text(fd, p.ptr as &const byte, p.len);
}

// 活会话出事了（子进程没了 / 没 key / 请求失败）：推一条 `error` 帧 + 拼一句人话。
//
// 为什么要有 `error` 帧：客户端的流校验认 `{type:"error",streamId,error:{code,
// message,details}}`（`parseRemoteStreamServerMessage`），收到之后它会把这条流
// **收干净**而不是每 3 秒重连 —— 后者是「页面看起来还在转」的最坏形态。
fn dwh_live_error(h: &const DwhHost, msg: &const Buf) void {
    if msg.len > 0 {
        out_err("[dsh-web] ");
        _ = srv_write_all(2, msg.ptr as &const byte, msg.len);
        out_err("\n");
    }
    if h.f_sid.len == 0 {
        return;
    }
    var s0: usize = 0;
    var k: usize = 0;
    while k <= h.f_sid.len {
        const at_end: bool = k == h.f_sid.len;
        if at_end || h.f_sid.ptr[k] == 10 as byte {
            const sl: usize = k - s0;
            if sl > 0 {
                dwh_live_error_one(h, &h.f_sid.ptr[s0], sl, msg);
            }
            s0 = k + 1;
        }
        k = k + 1;
    }
}

// 把一条 `error` 帧推给**一条** `session/follow` 流（见 `dwh_live_error`）。
fn dwh_live_error_one(h: &const DwhHost, sid: &const byte, sl: usize,
    msg: &const Buf) void {
    var sidb: Buf = Buf{ ptr: sid as *byte, len: sl, cap: sl };
    const fd: i32 = dwh_fd_of_stream(h, &sidb);
    if fd < 0 {
        return;
    }
    var p: Buf = buf_new(msg.len + 256);
    defer { buf_free(&p); }
    if !buf_append_cstr(&p, "{\"type\":\"error\",\"streamId\":\"") {
        return;
    }
    if !buf_append(&p, sid, sl) {
        return;
    }
    // 行宽豁免：不可断的 JSON 骨架
    if !buf_append_cstr(&p, "\",\"error\":{\"code\":\"session/host-unavailable\",\"message\":") {
        return;
    }
    if !jw_str_into(&p, msg.ptr as &const byte, msg.len) {
        return;
    }
    if !buf_append_cstr(&p, ",\"details\":{}}}") {
        return;
    }
    _ = dwh_ws_send_text(fd, p.ptr as &const byte, p.len);
}

// 解析 "A.B.C.D:PORT"（只支持 IPv4 字面量，与 `--web` 同一口径）。
fn dwh_parse_addr(s: &const byte, n: usize, a: &byte, b: &byte, c: &byte,
    d: &byte, port: &u16) bool {
    var part: [u8: 4] = [0: 4];
    var pi: usize = 0;
    var i: usize = 0;
    var cur: i64 = 0;
    var seen: usize = 0;
    while i < n {
        const ch: byte = s[i];
        if ch == 46 as byte || ch == 58 as byte {
            if pi >= 4 || seen == 0 {
                return false;
            }
            part[pi] = cur as u8;
            pi = pi + 1;
            cur = 0;
            seen = 0;
            i = i + 1;
            if ch == 58 as byte {
                // 端口
                var p: i64 = 0;
                var k: usize = 0;
                while i < n {
                    const pc: byte = s[i];
                    if pc < 48 as byte || pc > 57 as byte {
                        return false;
                    }
                    p = p * 10 + ((pc as i64) - 48);
                    k = k + 1;
                    i = i + 1;
                }
                if k == 0 || p > 65535 {
                    return false;
                }
                if pi != 4 {
                    return false;
                }
                a[0] = part[0];
                b[0] = part[1];
                c[0] = part[2];
                d[0] = part[3];
                port[0] = p as u16;
                return true;
            }
            continue;
        }
        if ch < 48 as byte || ch > 57 as byte {
            return false;
        }
        cur = cur * 10 + ((ch as i64) - 48);
        seen = seen + 1;
        if cur > 255 {
            return false;
        }
        i = i + 1;
    }
    return false;
}

// 实际监听端口（`PORT` 给 0 时用它报出真实端口）。
export fn dwh_port(h: &const DwhHost) u16 {
    return srv_local_port(h.lfd);
}

// 收尾：关监听与所有连接。
export fn dwh_stop(h: &DwhHost) void {
    var i: usize = 0;
    while i < DWH_MAX_CONNS {
        if h.conns[i].fd >= 0 {
            srv_close(h.conns[i].fd);
            h.conns[i].fd = -1;
        }
        if buf_valid(&h.conns[i].rx) {
            buf_free(&h.conns[i].rx);
        }
        if buf_valid(&h.conns[i].sids) {
            buf_free(&h.conns[i].sids);
        }
        i = i + 1;
    }
    if h.lfd >= 0 {
        srv_close(h.lfd);
        h.lfd = -1;
    }
    if buf_valid(&h.dist) {
        buf_free(&h.dist);
    }
    if buf_valid(&h.root) {
        buf_free(&h.root);
    }
    if buf_valid(&h.entries) {
        buf_free(&h.entries);
    }
    if buf_valid(&h.preloads) {
        buf_free(&h.preloads);
    }
    if buf_valid(&h.events) {
        buf_free(&h.events);
    }
    // 活会话：先收子进程（**hard**：宿主要退出了，别让一条还在读 LLM 的子进程
    // 拖着整个进程组），再释放两条流的 streamId 与模型目录。
    if h.live {
        dwhc_stop(&h.child, true);
        h.live = false;
    }
    dwhm_free(&h.model);
    if buf_valid(&h.f_sid) {
        buf_free(&h.f_sid);
    }
    if buf_valid(&h.e_sid) {
        buf_free(&h.e_sid);
    }
    if buf_valid(&h.dsh_home) {
        buf_free(&h.dsh_home);
    }
}

// ============================================================
// 主循环（一次 poll 管住监听 + 所有连接）
// ============================================================

// `--dsh-web` 的入口：起宿主 → 打 URL → 进主循环。
// 返回 0 = 正常收尾（ctrl+c / 收尾信号）。
export fn dwh_run(cfg: &const Config) i32 {
    // 取件（`--dsh-assets-install`）：**排在解析 root 之前** —— 装完那份就是
    // 我们要用的资源。装到 `--dsh-assets-dir`（没给就用 `<agent_home>/dsh-assets`）。
    var assets: Buf = buf_empty();
    defer { buf_free(&assets); }
    if cfg.dsh_assets_install {
        if !dwh_install_assets(cfg, &assets) {
            return AGENT_PROTO;
        }
    }
    var addr: Buf = buf_empty();
    defer { buf_free(&addr); }
    if cfg.dsh_web_addr.len > 0 {
        addr = buf_new(cfg.dsh_web_addr.len + 1);
        _ = buf_append(&addr, cfg.dsh_web_addr.ptr as &const byte,
            cfg.dsh_web_addr.len);
    } else {
        addr = buf_new(32);
        _ = buf_append_cstr(&addr, "127.0.0.1:8790");
    }
    var events: Buf = buf_empty();
    defer { buf_free(&events); }
    if cfg.dsh_web_events.len > 0 {
        events = buf_new(cfg.dsh_web_events.len + 1);
        _ = buf_append(&events, cfg.dsh_web_events.ptr as &const byte,
            cfg.dsh_web_events.len);
    } else {
        // 环境变量 `UYA_AGENT_DSH_WEB_EVENTS` 指一份译文的路径。
        // 优先 CLI（`cfg.dsh_web_events`），没给才看 env。
        const ev_env: &byte = getenv("UYA_AGENT_DSH_WEB_EVENTS" as &const byte);
        if (ev_env as usize) != 0 && bufx_cstr_len(ev_env) > 0 {
            events = buf_new(bufx_cstr_len(ev_env) + 1);
            _ = buf_append_cstr(&events, ev_env);
        } else {
            events = buf_new(1);
        }
    }
    var h: DwhHost = dwh_host_zero();
    var use_assets: &const byte = cfg.dsh_assets.ptr as &const byte;
    var use_al: usize = cfg.dsh_assets.len;
    if assets.len > 0 {
        use_assets = assets.ptr as &const byte;
        use_al = assets.len;
    }
    if !dwh_start(&h, cfg, addr.ptr as &const byte, addr.len,
        events.ptr as &const byte, use_assets, use_al,
        cfg.dsh_token.ptr as &const byte, cfg.dsh_token.len) {
        out_err("error: --dsh-web 起不来（没找到 DSH 的 webui？试 --dsh-root DIR，");
        out_err("或确认装了 @deepseek-ai/dsh-web-frontend）\n");
        return AGENT_PROTO;
    }
    defer { dwh_stop(&h); }
    out_err("[dsh-web] DSH 前端（只读它的 dist，不改一个字节）：http://127.0.0.1:");
    out_err_dec(dwh_port(&h) as usize);
    out_err("/ （ctrl+c 退出）\n");
    // 只读演示模式下才提这句：活会话**开始时** `events` 当然是空的（它会长出来），
    // 在那种模式下打「没有事件源」是**假话**，而假提示会让用户以为功能坏了。
    if !h.live {
        out_err("[dsh-web] 提示：没有事件源（UYA_AGENT_DSH_WEB_EVENTS 指一份译文），");
        out_err("页面能起来但没有消息\n");
    }
    if !sigx_install_web() {
        out_err("[dsh-web] 警告：终止信号处理器安装失败\n");
    }
    dwh_loop(&h);
    return AGENT_OK;
}

// 零值宿主（`dwh_start` 会把它填好）。
fn dwh_host_zero() DwhHost {
    var h: DwhHost = DwhHost{
        lfd: -1,
        dist: buf_empty(),
        root: buf_empty(),
        entries: buf_empty(),
        preloads: buf_empty(),
        events: buf_empty(),
        conns: [dwh_conn_zero(): DWH_MAX_CONNS],
        n: 0,
        stop_round: false,
        live: false,
        child: dwhc_zero(),
        model: dwhm_zero(),
        f_sid: buf_empty(),
        e_sid: buf_empty(),
        pushed: 0,
    };
    return h;
}

// 零值连接。
fn dwh_conn_zero() DwhConn {
    return DwhConn{ fd: -1, st: DWH_C_DONE, sids: buf_empty(), rx: buf_empty(),
        is_mux: false, is_remote: false, remote_ready: false, sent: false };
}

// 主循环：一次 poll，谁就绪处理谁。
fn dwh_loop(h: &DwhHost) void {
    while !sigx_web_quit_wanted() {
        dwh_poll_once(h);
    }
}

// 一次泵。
fn dwh_poll_once(h: &DwhHost) void {
    var pfds: [PollFd: DWH_MAX_CONNS + 1] = [PollFd{ fd: -1, events: 0,
        revents: 0 }: DWH_MAX_CONNS + 1];
    var idx: [usize: DWH_MAX_CONNS + 1] = [0: DWH_MAX_CONNS + 1];
    var np: usize = 0;
    if h.lfd >= 0 {
        pfds[0].fd = h.lfd;
        pfds[0].events = POLLIN;
        idx[0] = 0;
        np = 1;
    }
    // 活会话的**写端**（管道）进 poll 集合：有待发输入时等它可写，写出去就回。
    //
    // ⚠ **会话日志的 fd 不进 poll 集合**：普通文件在 `poll` 里**恒为就绪**
    // （内核不把「文件末尾」当未就绪），于是 `poll` 立刻返回、每圈都空转 ——
    // 实测形态是宿主 100% CPU 占着一个核、HTTP 请求一个都不回（curl 超时）。
    // 日志的新行靠 `DWH_POLL_MS`（50ms）的超时兜住，与全仓其它泵点同一条纪律。
    if h.live && dwhc_wants_write(&h.child) && np < DWH_MAX_CONNS + 1 {
        pfds[np].fd = dwhc_wfd(&h.child);
        pfds[np].events = POLLOUT;
        idx[np] = DWH_MAX_CONNS + 1;
        np = np + 1;
    }
    var i: usize = 0;
    while i < DWH_MAX_CONNS && np < DWH_MAX_CONNS + 1 {
        if h.conns[i].fd >= 0 && h.conns[i].st != DWH_C_DONE {
            // WS 连接：已发完基线就只等关闭（只发不收）；否则等可写。
            pfds[np].fd = h.conns[i].fd;
            if h.conns[i].st == DWH_C_WS && h.conns[i].sent {
                pfds[np].events = POLLIN;
            } else {
                pfds[np].events = POLLIN;
            }
            idx[np] = i + 1;
            np = np + 1;
        }
        i = i + 1;
    }
    _ = sys_poll(&pfds[0], np, DWH_POLL_MS) catch {};
    // **一次只处理一个就绪者**：处理完立刻回 poll。
    // 单线程里把「写一个 450KB 的 bundle」整段做完，会让循环几百毫秒回不到 poll，
    // 两条下行的心跳就断在那个窗口里（实测症状：`[web-runtime] connection lost`
    // 反复重连、shell 卡在最早两步）。分片后 poll 间隔固定在毫秒级。
    var k: usize = 0;
    while k < np {
        const rv: i16 = pfds[k].revents;
        if rv != 0 {
            if k == 0 {
                if (rv & POLLIN) != 0 {
                    dwh_accept(h);
                    // ⚠ 走之前**必须**收摊：`dwh_accept` 每圈都可能被调到
                    // （页面的静态资源是一个请求一条连接），而 `return` 会跳过
                    // 本圈末尾的 `dwh_sweep` ⇒ 完成态的连接永远不回收 ⇒ 32 个槽
                    // 满了之后新连接被直接关掉，客户端表现是「连上就断、每 3 秒
                    // 重连」（实测：一次加载 87 次重连、页面停在初始态）。
                    dwh_sweep(h);
                    return;
                }
            } else if idx[k] > DWH_MAX_CONNS {
                // 活会话的写端（管道）就绪：读/写统一在 `dwh_live_tick` 里做
                // （那里是**一处**口径：收尸、写 stdin、读日志、推帧四件事的顺序
                // 不能乱）。
                //
                // ⚠ **不能直接 `return`**：那会跳过本圈末尾的 `dwh_sweep` ——
                // 而 `DWH_C_DONE` 的连接（对端关了、或响应写完了）**只有它收**。
                // 不收的后果不是报错，而是连接槽被占满：`DWH_MAX_CONNS` = 32，
                // 浏览器一轮开 4~5 条，几轮之后 `dwh_accept` 开始直接关新连接
                // ⇒ 客户端看到的是「连上就断」并**每 3 秒重连一次**，而页面永远
                // 停在初始态（实测：一次加载里 87 次 `ready`、382 次 `open`，
                // 而宿主这边一切「正常」）。
                break;
            } else {
                const ci: usize = idx[k] - 1;
                // 掩码先落成一个 i16：三个常量的 `|` 会被推断成别的整型，
                // 直接写在 `&` 里就报「两个操作数类型必须一致」（实测）。
                const mask: i16 = POLLIN | POLLHUP | POLLERR;
                if (rv & mask) != 0 {
                    dwh_on_conn(h, ci);
                    if h.stop_round {
                        h.stop_round = false;
                        dwh_sweep(h);
                        return;
                    }
                }
            }
        }
        k = k + 1;
    }
    dwh_sweep(h);
    // 没有 fd 就绪的那一圈也要维护活会话（子进程可能刚刚退出 —— 那是**没有**
    // 任何 fd 事件可等的形态，只靠 poll 永远发现不了）。
    dwh_live_tick(h);
    dwh_live_mark(h);
}

// 收一个新连接（非阻塞 listen fd；连接本身阻塞也是错的 —— 设为非阻塞）。
fn dwh_accept(h: &DwhHost) void {
    const fd: i32 = srv_accept_nb(h.lfd);
    if fd < 0 {
        return;
    }
    var i: usize = 0;
    var slot: usize = DWH_MAX_CONNS;
    while i < DWH_MAX_CONNS {
        if h.conns[i].fd < 0 {
            slot = i;
            break;
        }
        i = i + 1;
    }
    if slot >= DWH_MAX_CONNS {
        srv_close(fd);      // 满了：直接关（显式边界，不排队）
        return;
    }
    h.conns[slot].fd = fd;
    h.conns[slot].st = DWH_C_HEAD;
    h.conns[slot].is_mux = false;
    h.conns[slot].is_remote = false;
    h.conns[slot].remote_ready = false;
    h.conns[slot].sent = false;
    if !buf_valid(&h.conns[slot].rx) {
        h.conns[slot].rx = buf_new(16384);
    }
    buf_reset(&h.conns[slot].rx);
    if !buf_valid(&h.conns[slot].sids) {
        h.conns[slot].sids = buf_new(256);
    }
    buf_reset(&h.conns[slot].sids);
}

// 一个连接可读了：按它的阶段分派。
// 收头 → 是升级请求就握手成 WS 并发基线；否则按 URL 分派成一次响应。
fn dwh_on_conn(h: &DwhHost, ci: usize) void {
    // 显式夹取：Uya 的边界证明器只认「正的 if 里做索引」（与 httpsrv 同款纪律）。
    if ci >= DWH_MAX_CONNS {
        return;
    }
    const c: &DwhConn = &h.conns[ci];
    if c.fd < 0 {
        return;
    }
    if c.st == DWH_C_WS {
        // WS 下行**只发不收**，但对端会发 **ping**（浏览器/中间层都会）与 close。
        // 这里必须把读到的字节**读懂**再决定：
        //   * 读到 0 = 对端真关了 → 断开；
        //   * 读到 ping（opcode 9）→ 回 pong（不回的话对端按超时判死，症状是
        //     `[web-runtime] connection lost` 反复重连、shell 卡在最早那两步 ——
        //     实测就是这么卡住的）；
        //   * 读到 close（opcode 8）→ 断开；其余（对端不该发数据）忽略。
        var tmp: [byte: 512] = [0: 512];
        const n: isize = sys_read(c.fd, &tmp[0], 512) catch { -1 as isize; };
        if n < 0 {
            return;         // EAGAIN：非阻塞 fd 上的常态，不是断开
        }
        if n == 0 {
            // 对端真关了（读到 0，不是 EAGAIN）

            dwh_drop(h, ci);
            return;
        }
        const b0: byte = tmp[0];
        const op: u8 = (b0 & 15 as byte) as u8;
        if op == 8 {
            // 对端发来 close：断开。
            // ⚠ 想查「客户端为什么关」时，**要解掩码读 code/reason** ——
            // 客户端主动关会带自解释的原因（如 `4002 invalid Remote stream frame`），
            // 而它是「我发的帧不合法」的唯一线索（实测靠它定位到两处）。
            // 这里把它解出来打一行（**唯一的现场线索**：客户端关连接时用它说话，
            // 而它不写自己的控制台）。
            dwh_log_close(&tmp[0], n as usize);
            dwh_drop(h, ci);
            return;
        }
        if op == 1 && c.is_remote {
            // 文本帧 = 客户端的一条 `open`（或 `item`/`end`）。0.2.0 的下行是**双向**的，
            // 这条分支就是与 0.1.1 最本质的差别（那时只有 ping/close 两种输入）。
            //
            // ⚠ **一次 read 里可能有多条帧**：客户端启动时把 `workspace/follow`、
            // `speech/follow`、`$events` 三条 `open` 连着写（实测一个 TCP 段里就有），
            // 而这里早先只解**第一条**、其余整段丢掉 —— 于是 `$events` 那条永远收不到
            // `ready`，客户端判「连接没就绪」并每 3 秒重连一次
            // （症状：`connection lost, retry #N`，而单发一条帧的裸 socket 测试**正常**）。
            // 所以必须把这一段里的帧**全解完**。
            var off: usize = 0;
            while off < (n as usize) {
                const used: usize = dwh_remote_frame(h, ci, &tmp[off], (n as usize) - off);
                if used == 0 {
                    break;      // 残帧：等下一圈（帧不会跨 read 拆得这么碎，保守处理）
                }
                off = off + used;
            }
            return;
        }
        if op == 9 {
            // 回 pong：**payload 原样搬回去**。
            // ⚠ 客户端发的帧是**掩码**的：`tmp[2..6]` 是掩码键、payload 从第 6 字节起
            // （控制帧载荷 ≤125，所以不会走 2 字节长度那种形态）。早先的实现从
            // `tmp[2]` 起搬 —— 搬的是掩码键，pong 的内容是错的，客户端据此判协议错
            // 并把连接关掉（症状与「收不到 pong」一样：`connection lost` 反复重连）。
            const masked: bool = (tmp[1] & 128 as byte) != 0;
            var plen: usize = (tmp[1] & 127 as byte) as usize;
            if plen > 125 {
                plen = 125;
            }
            var poff: usize = 2;
            if masked {
                poff = 6;      // 跳过 4 字节掩码键
            }
            var out: [byte: 130] = [0: 130];
            out[0] = 138;      // FIN + pong（**不掩码**：服务端不许掩码）
            out[1] = plen as byte;
            var k: usize = 0;
            while k < plen && poff + k < 512 {
                var pb: byte = tmp[poff + k];
                if masked {
                    pb = (pb ^ tmp[2 + (k & 3)]) as byte;   // 去掩码
                }
                out[2 + k] = pb;
                k = k + 1;
            }
            _ = srv_write_all(c.fd, &out[0], 2 + plen);
            return;
        }
        // 对端发来的 close / 数据帧之后可能还有字节：这一圈只处理第一帧
        // （浏览器→服务端只有 ping 与 close，够用，不必做流式解帧）
        return;
    }
    if c.st != DWH_C_HEAD {
        return;
    }
    const he: isize = dwh_read_head(c);
    if he == -2 {
        return;             // 还没收全：等下一圈
    }
    if he < 0 {
        dwh_drop(h, ci);
        return;
    }
    const head_end: usize = he as usize;
    var m: u8 = SRV_M_OTHER;
    var uo: usize = 0;
    var ul: usize = 0;
    if !srv_parse_url(c, head_end, &m, &uo, &ul) {
        dwh_drop(h, ci);
        return;
    }
    // 升级请求（WebSocket）：普通 GET 要回 426（DSH 同口径：没有 SSE 回落）
        // 行宽豁免：不可断的 JSON 字面量
    if dwh_head_has(c, head_end, "upgrade" as &const byte, "websocket" as &const byte) {
        dwh_do_upgrade(h, ci, uo, ul);
        return;
    }
    dwh_do_http(h, ci, m, uo, ul, head_end);
}

// 解析请求行（拿到方法码与 URL 区间）。`srv_parse_request_line` 是 httpsrv 的私有的，
// 所以这里用 httpsrv 导出的 `srv_recv_request` 之外的口径：直接扫第一行。
fn srv_parse_url(c: &const DwhConn, head_end: usize, m_out: &u8,
    url_off: &usize, url_len: &usize) bool {
    _ = head_end;
    // 第一行：`METHOD SP URL SP VERSION`
    var i: usize = 0;
    var sp1: isize = -1;
    var sp2: isize = -1;
    while i < c.rx.len && c.rx.ptr[i] != 13 as byte {
        if c.rx.ptr[i] == 32 as byte {
            if sp1 < 0 {
                sp1 = i as isize;
            } else if sp2 < 0 {
                sp2 = i as isize;
            }
        }
        i = i + 1;
    }
    if sp1 <= 0 || sp2 <= sp1 {
        return false;
    }
    const ml: usize = sp1 as usize;
    if bufx_eq_cstr(c.rx.ptr as &const byte, ml, "GET" as &const byte) {
        m_out[0] = SRV_M_GET;
    } else if bufx_eq_cstr(c.rx.ptr as &const byte, ml, "POST" as &const byte) {
        m_out[0] = SRV_M_POST;
    } else {
        m_out[0] = SRV_M_OTHER;
    }
    url_off[0] = (sp1 as usize) + 1;
    url_len[0] = (sp2 as usize) - ((sp1 as usize) + 1);
    return url_len[0] > 0;
}

// 请求头 `name` 的值里是否含 `val`（大小写不敏感只做小写化比较——DSH 发的都是小写）。
fn dwh_head_has(c: &const DwhConn, head_end: usize, name: &const byte,
    val: &const byte) bool {
    var co: usize = 0;
    var cl: usize = 0;
        // 行宽豁免：不可断的 JSON 字面量
    if !srv_head_value(c.rx.ptr as &const byte, head_end, head_end, name, &co, &cl) {
        return false;
    }
    if cl == 0 {
        return false;
    }
    // 值里找子串（`Upgrade: websocket`）
    const vl: usize = bufx_cstr_len(val);
    var i: usize = co;
    while i + vl <= co + cl {
        var same: bool = true;
        var k: usize = 0;
        while k < vl {
            var ch: byte = c.rx.ptr[i + k];
            if ch >= 65 as byte && ch <= 90 as byte {
                ch = (ch as i32 + 32) as byte;
            }
            if ch != val[k] {
                same = false;
                break;
            }
            k = k + 1;
        }
        if same {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 断开一个连接（幂等）。
fn dwh_drop(h: &DwhHost, ci: usize) void {
    if ci >= DWH_MAX_CONNS {
        return;
    }
    if h.conns[ci].fd >= 0 {
        srv_close(h.conns[ci].fd);
        h.conns[ci].fd = -1;
    }
    h.conns[ci].st = DWH_C_DONE;
    h.conns[ci].sent = false;
    h.conns[ci].is_mux = false;
    h.conns[ci].is_remote = false;
    h.conns[ci].remote_ready = false;
    buf_reset(&h.conns[ci].rx);
    dwh_forget_streams(h, ci);
    buf_reset(&h.conns[ci].sids);
}

// 一条连接没了 ⇒ 把它开过的流从 `f_sid` / `e_sid` 里**摘掉**。
//
// 为什么必须摘：那两份清单是「往哪儿推」的唯一判据，而 `dwh_fd_of_stream`
// 找不到连接时**只是不推**（静默）。不摘的后果不是报错，而是清单里躺着一条
// 已经死掉的 streamId —— 下次有事件时推给一条**没人听的**流，而真正活着的那条
// 一个字节都收不到（实测：浏览器只收到 baseline/snapshot，一条 event 帧都没
// 收到，而宿主这边 15 帧全「发出去了」）。
fn dwh_forget_streams(h: &DwhHost, ci: usize) void {
    // 显式夹取：数组边界证明器只认「正的 if 里做索引」（与 `dwh_on_conn` 同款）。
    if ci >= DWH_MAX_CONNS || h.conns[ci].sids.len == 0 {
        return;
    }
    dwh_sids_prune(&h.f_sid, &h.conns[ci].sids);
    dwh_sids_prune(&h.e_sid, &h.conns[ci].sids);
}

// 从 `list` 里删掉 `drop`（另一份清单）里出现的每一条（整行逐字节比）。
fn dwh_sids_prune(list: &Buf, drop: &const Buf) void {
    var keep: Buf = buf_new(list.len + 1);
    defer { buf_free(&keep); }
    var start: usize = 0;
    var i: usize = 0;
    while i <= list.len {
        const at_end: bool = i == list.len;
        if at_end || list.ptr[i] == 10 as byte {
            const seg: usize = i - start;
            if seg > 0 {
                var one: Buf = Buf{ ptr: &list.ptr[start], len: seg,
                    cap: seg };
                if !dwh_sids_has(drop, &one) {
                    _ = buf_append(&keep, &list.ptr[start], seg);
                    _ = buf_append_byte(&keep, 10);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    buf_reset(list);
    _ = buf_append(list, keep.ptr as &const byte, keep.len);
}

// 清掉已完成的连接（每圈末尾一次：主循环手上可能有移动前的下标）。
fn dwh_sweep(h: &DwhHost) void {
    var i: usize = 0;
    while i < DWH_MAX_CONNS {
        if h.conns[i].st == DWH_C_DONE && h.conns[i].fd >= 0 {
            srv_close(h.conns[i].fd);
            h.conns[i].fd = -1;
            // ⚠ **必须**同时把它开过的流从推送清单里摘掉。
            // 这里从前只关 fd（`dwh_drop` 那一套清理一个都不做），于是
            // `f_sid` / `e_sid` 里永远留着已经死掉的 streamId：下一次有事件时
            // `dwh_fd_of_stream` 找不到那条连接（它 `fd < 0` 了）⇒ **一条都不推**，
            // 而**真正活着**的那条流一个字节都收不到（实测：浏览器 374 帧里
            // 一条 event 都没有，而宿主这边 15 帧全「发出去了」——帧推给了一条
            // 早就关了的流，`dwh_fd_of_stream` 按 streamId 找连接、找到的是死的那条，
            // 于是活的那条被跳过）。
            dwh_forget_streams(h, i);
        }
        i = i + 1;
    }
}

// WebSocket 升级：校 key → 回 101 → 发基线段 → 转成「只发不收」阶段。
fn dwh_do_upgrade(h: &DwhHost, ci: usize, uo: usize, ul: usize) void {
    if ci >= DWH_MAX_CONNS {
        return;
    }
    const c: &DwhConn = &h.conns[ci];
    // 三条都收：`remote.mux` 是 **0.2.0 唯一的**下行（实测真 DSH 只开这一个
    // WebSocket）；`events.mux` / `events.host` 是 0.1.1 的两条，留着不碍事
    // （旧版装了也能用，而它俩现在是死路径）。
    const is_remote: bool = dwh_path_is(c, uo, ul, "/api/remote.mux" as &const byte);
    const is_emux: bool = dwh_path_is(c, uo, ul, "/api/events.mux" as &const byte);
    const is_ehost: bool = dwh_path_is(c, uo, ul, "/api/events.host" as &const byte);
    if !is_remote && !is_emux && !is_ehost {
        // 其它路径的升级：没有 SSE 回落，如实回 426。
        _ = srv_send_response(c.fd, SRV_ST_404, SRV_CT_TEXT,
            "no such websocket" as &const byte, 17);
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    h.conns[ci].is_remote = is_remote;
        // 行宽豁免：不可断的 JSON 字面量
    h.conns[ci].is_mux = is_emux;
    var co: usize = 0;
    var cl: usize = 0;
    if !srv_head_value(c.rx.ptr as &const byte, c.rx.len, c.rx.len,
        "sec-websocket-key" as &const byte, &co, &cl) || cl == 0 {
        _ = srv_send_response(c.fd, SRV_ST_400, SRV_CT_TEXT,
            "missing key" as &const byte, 11);
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    // accept = base64(sha1(key + GUID))
    var joined: Buf = buf_new(cl + 64);
    defer { buf_free(&joined); }
    if !buf_append(&joined, &c.rx.ptr[co], cl) {
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    if !buf_append_cstr(&joined, "258EAFA5-E914-47DA-95CA-C5AB0DC85B11") {
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    var dig: [byte: 20] = [0: 20];
    sha1_digest(joined.ptr[0: joined.len], dig[0: 20]);
    var b64: [byte: 64] = [0: 64];
    // `encode_base64` 回 `!usize`：本仓处理 `!T` 的写法是 `catch`（不能直接 `if !r`）。
    const n: usize = encode_base64(dig[0: 20], b64[0: 64]) catch {
        h.conns[ci].st = DWH_C_DONE;
        return;
    };
    var head: Buf = buf_new(256);
    defer { buf_free(&head); }
        // 行宽豁免：不可断的 JSON 字面量
    if !buf_append_cstr(&head, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: ") {
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    if !buf_append(&head, &b64[0], n) {
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    if !buf_append_cstr(&head, "\r\n\r\n") {
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    if !srv_write_all(c.fd, head.ptr as &const byte, head.len) {
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    h.conns[ci].st = DWH_C_WS;
    // ⚠ **0.2.0 的 `remote.mux` 一条基线都不许发**：它的下行只有
    // `item` / `end` / `error` 三种帧，且客户端对**每一条**收到的帧做
    // `exactKeys` 校验 —— 收到 `{"type":"server-request",…}`（0.1.1 的
    // 「订阅 + 事件 + 投影」基线段）当场抛 `invalid Remote stream frame` 并
    // `close(4002)`，然后每 3 秒重连一次（实测：一次加载 84 次重连、页面永远
    // 停在初始态，而宿主这边一切「正常」—— 帧确实发出去了，只是**不该发**）。
    // 0.2.0 的「基线」是**客户端自己 `open` 之后**由我们按流回的那一条
    // （`ready` / `baseline` / `snapshot`，见 `dwh_remote_open`）。
    if h.conns[ci].is_remote {
        h.conns[ci].sent = true;
        return;
    }
    // 0.1.1 的两条老下行（`events.mux` / `events.host`）仍走基线段 ——
    // 留着它们只为「旧版装了也能用」，那条路没有被 0.2.0 的校验管着。
    if dwh_ws_send_baseline(h, &h.conns[ci]) {
        h.conns[ci].sent = true;
    } else {
        dwh_drop(h, ci);
    }
}

// 路径等于 lit 吗（只比路径段，不含 query）。
fn dwh_path_is(c: &const DwhConn, uo: usize, ul: usize, lit: &const byte) bool {
    // `srv_url_split` 用**下标出参**给出「路径长度 / query 起点与长度」（切片是值语义，
    // 所以 httpsrv 一律用下标 —— 见它文件头不变量⑤）。
    var path_len: usize = 0;
    var qo: usize = 0;
    var ql: usize = 0;
    srv_url_split(c.rx.ptr as &const byte, uo, ul, &path_len, &qo, &ql);
    return bufx_eq_cstr(&c.rx.ptr[uo], path_len, lit);
}

// 一次普通 HTTP：静态 / 插件 bundle / `/api` 三选一。
fn dwh_do_http(h: &DwhHost, ci: usize, m: u8, uo: usize, ul: usize,
    head_end: usize) void {
    if ci >= DWH_MAX_CONNS {
        return;
    }
    const fd: i32 = h.conns[ci].fd;
    if fd < 0 {
        return;
    }
    var path: Buf = buf_new(ul + 1);
    defer { buf_free(&path); }
    var pl: usize = 0;
    var qo: usize = 0;
    var ql: usize = 0;
    srv_url_split(h.conns[ci].rx.ptr as &const byte, uo, ul, &pl, &qo, &ql);
    if !buf_append(&path, &h.conns[ci].rx.ptr[uo], pl) {
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    // 访问令牌（`--dsh-token` / 绑非回环时的自动生成）。**排在一切服务之前** ——
    // 未通过时连 index 与静态资源都不给（真 DSH 同口径：不带令牌 401）。
    if h.token.len > 0 {
        if !dwh_auth_gate(h, ci, uo + qo, ql, head_end) {
            return;
        }
    }
    // 根路径：index.html + 我们的注入
    if pl == 1 && path.ptr[0] == 47 as byte {
        dwh_send_index(h, ci);
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    // `/plugins/<id>/client.js[.map]`
        // 行宽豁免：不可断的 JSON 字面量
    if pl > 9 && bufx_eq_cstr(path.ptr as &const byte, 9, "/plugins/" as &const byte) {
        dwh_send_plugin(h, ci, &path);
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    // `/api/<method>`
        // 行宽豁免：不可断的 JSON 字面量
    if pl > 5 && bufx_eq_cstr(path.ptr as &const byte, 5, "/api/" as &const byte) {
        dwh_send_api(h, ci, m, &path, head_end);
        h.conns[ci].st = DWH_C_DONE;
        return;
    }
    // 其余：真 dist 里的静态文件（`/assets/*`、`/favicon.svg` …）
    dwh_send_static(h, ci, &path);
    h.conns[ci].st = DWH_C_DONE;
}

// 根路径：读 dist 的 index.html，注入后发出去。
fn dwh_send_index(h: &const DwhHost, ci: usize) void {
    if ci >= DWH_MAX_CONNS {
        return;
    }
    const fd: i32 = h.conns[ci].fd;
    var idx: Buf = buf_new(1200);
    defer { buf_free(&idx); }
    if !dwh_dist_file(h, "index.html" as &const byte, &idx) {
        _ = srv_send_response(fd, SRV_ST_404, SRV_CT_TEXT,
            "no dist" as &const byte, 7);
        return;
    }
    // ⚠ 系统调用要 **NUL 结尾的 C 串**： 只按长度追加，不补 NUL
    // （本仓另有 `buf_append_cstr_z` 专管这件事）。漏了它，`sys_open` 会一路读到
    // 缓冲区后面的脏字节 —— 症状是「路径明明对，却打不开」。
    if !buf_append_byte(&idx, 0) {
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT,
            "oom" as &const byte, 3);
        return;
    }
    var html: Buf = buf_new(262144);
    defer { buf_free(&html); }
    if !dwh_read_file(idx.ptr as &const byte, &html, 262144) {
        _ = srv_send_response(fd, SRV_ST_404, SRV_CT_TEXT,
            "no index" as &const byte, 8);
        return;
    }
    var out: Buf = buf_new(html.len + h.entries.len + 4096);
    defer { buf_free(&out); }
    if !dwh_render_index(h, &html, &out) {
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT,
            "render failed" as &const byte, 13);
        return;
    }
    _ = srv_send_response(fd, SRV_ST_200, SRV_CT_HTML,
        out.ptr as &const byte, out.len);
}

// 拼 `<dist>/<path[1:]>`（去掉开头的 `/`；**按长度搬**，不收 C 串）。
fn dwh_dist_rel(h: &const DwhHost, path: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if !buf_append(&out[0], h.dist.ptr as &const byte, h.dist.len) {
        return false;
    }
    if path.len <= 1 {
        return false;
    }
    // ⚠ 这个 `/` 不能少：少了它拼出的是 `distfavicon.svg`（实测），而症状是
    // 「文件明明在、却全 404」。
    if !buf_append_byte(&out[0], 47) {
        return false;
    }
    return buf_append(&out[0], &path.ptr[1], path.len - 1);
}

// 拼 `dist/<rel>` 到 out（调用方负责 NUL 终止——系统调用要 C 串）。
fn dwh_dist_file(h: &const DwhHost, rel: &const byte, out: &Buf) bool {
    buf_reset(out);
    if !buf_append(&out[0], h.dist.ptr as &const byte, h.dist.len) {
        return false;
    }
    if !buf_append_byte(&out[0], 47) {
        return false;
    }
    if !buf_append_cstr(&out[0], rel) {
        return false;
    }
    return true;
}

// 发一个大响应（bundle 有 450KB 量级）。分块写，块间**回一次 poll**：
// 单线程宿主里，一口气写几百 KB 会让两条下行在那个窗口里收不到心跳
//（实测症状：`[web-runtime] connection lost` 反复重连、shell 卡在最早两步）。
// 分块后每块之间都还给事件循环，下行的延迟就稳定在毫秒级。
fn dwh_send_large(h: &DwhHost, fd: i32, ctype: &const byte, body: &const byte,
    n: usize) bool {
    _ = h;
    const CHUNK: usize = 65536;
    // 头也要自己拼（`srv_send_response` 是一次性写完的，这里要分块）
    var head: Buf = buf_new(512);
    defer { buf_free(&head); }
    if !buf_append_cstr(&head, "HTTP/1.1 ") {
        return false;
    }
    if !buf_append_cstr(&head, SRV_ST_200) {
        return false;
    }
    if !buf_append_cstr(&head, "\r\nContent-Type: ") {
        return false;
    }
    if !buf_append_cstr(&head, ctype) {
        return false;
    }
    if !buf_append_cstr(&head, "\r\nContent-Length: ") {
        return false;
    }
    if !buf_append_u64(&head, n as u64) {
        return false;
    }
    if !buf_append_cstr(&head, "\r\nConnection: close\r\n\r\n") {
        return false;
    }
    if !srv_write_all(fd, head.ptr as &const byte, head.len) {
        return false;
    }
    var off: usize = 0;
    while off < n {
        var take: usize = n - off;
        if take > CHUNK {
            take = CHUNK;
        }
        const at: *const byte = @ptr_from_usize(
            @usize_from_ptr(body as &const void) + off) as *const byte;
        if !srv_write_all(fd, at as &const byte, take) {
            return false;
        }
        off = off + take;
        if off < n {
            // 块间让出：0 超时的 poll 不阻塞，但足以让内核把已写的数据推出去
            var pfds: [PollFd: 1] = [PollFd{ fd: -1, events: 0, revents: 0 }];
            _ = sys_poll(&pfds[0], 0, 0) catch {};
        }
    }
    return true;
}

// `/plugins/<pkg>/client.js[.map]` → 该包的 `lib/client.js`（真包，不是 dist 里的）。
fn dwh_send_plugin(h: &const DwhHost, ci: usize, path: &const Buf) void {
    if ci >= DWH_MAX_CONNS {
        return;
    }
    const fd: i32 = h.conns[ci].fd;
    // 去掉末尾的 `/client.js` 或 `/client.js.map`
    var pn: usize = path.len;
    var want_map: bool = false;
    const map_suf: &const byte = "/client.js.map" as &const byte;
    const js_suf: &const byte = "/client.js" as &const byte;
    if pn > 14 && bufx_eq_cstr(&path.ptr[pn - 14], 14, map_suf) {
        want_map = true;
        pn = pn - 14;
    } else if pn > 10 && bufx_eq_cstr(&path.ptr[pn - 10], 10, js_suf) {
        pn = pn - 10;
    } else {
        _ = srv_send_response(fd, SRV_ST_404, SRV_CT_TEXT,
            "not a bundle" as &const byte, 12);
        return;
    }
    // `<root>/node_modules/<pkg>/lib/client.js`
    var full: Buf = buf_new(1400);
    defer { buf_free(&full); }
    if !buf_append(&full, h.root.ptr as &const byte, h.root.len) {
        // 行宽豁免：不可断的 JSON 字面量
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT, "oom" as &const byte, 3);
        return;
    }
    if !buf_append_cstr(&full, "/node_modules/") {
        // 行宽豁免：不可断的 JSON 字面量
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT, "oom" as &const byte, 3);
        return;
    }
    if !buf_append(&full, &path.ptr[9], pn - 9) {
        // 行宽豁免：不可断的 JSON 字面量
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT, "oom" as &const byte, 3);
        return;
    }
    if !buf_append_cstr(&full, "/lib/client.js") {
        // 行宽豁免：不可断的 JSON 字面量
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT, "oom" as &const byte, 3);
        return;
    }
    if want_map {
        if !buf_append_cstr(&full, ".map") {
        // 行宽豁免：不可断的 JSON 字面量
            _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT, "oom" as &const byte, 3);
            return;
        }
    }
    if !buf_append_byte(&full, 0) {
        // 行宽豁免：不可断的 JSON 字面量
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT, "oom" as &const byte, 3);
        return;
    }
    var body: Buf = buf_new(4194304);
    defer { buf_free(&body); }
    if !dwh_read_file(full.ptr as &const byte, &body, 4194304) {
        _ = srv_send_response(fd, SRV_ST_404, SRV_CT_TEXT,
            "no bundle" as &const byte, 9);
        return;
    }
    // 不用 if 表达式赋 const：codegen 会把它落成一个只读临时量再赋值（实测
    // `assignment of read-only variable __uya_ifexpr_*`）。用可变变量表达同一件事。
        // 行宽豁免：不可断的 JSON 字面量
    var ct: &const byte = "application/javascript; charset=utf-8" as &const byte;
    if want_map {
        ct = SRV_CT_JSON;
    }
        // 行宽豁免：不可断的 JSON 字面量
    _ = dwh_send_large(h, fd, ct, body.ptr as &const byte, body.len);
}

// dist 里的静态文件（拒绝路径穿越）。
fn dwh_send_static(h: &const DwhHost, ci: usize, path: &const Buf) void {
    if ci >= DWH_MAX_CONNS {
        return;
    }
    const fd: i32 = h.conns[ci].fd;
    // 路径穿越：`..` 一律拒（`/assets/*` 这类正常路径不会有它）
    if dwh_has_dotdot(path) {
        _ = srv_send_response(fd, SRV_ST_404, SRV_CT_TEXT,
            "forbidden" as &const byte, 9);
        return;
    }
    // 去掉开头的 `/` 再拼 dist：**不能用 `&path.ptr[1]`** —— 那是「从下标 1 起的指针」，
    // 没有长度，`buf_append_cstr` 会一路读到缓冲区后面的字节（拼出来的路径根本不对，
    // 症状是 `/assets/*` 全 404 而文件其实都在）。所以这里显式搬一段。
    var full: Buf = buf_new(1400);
    defer { buf_free(&full); }
    if !dwh_dist_rel(h, path, &full) {
        // 行宽豁免：不可断的 JSON 字面量
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT, "oom" as &const byte, 3);
        return;
    }
    if !buf_append_byte(&full, 0) {
        // 行宽豁免：不可断的 JSON 字面量
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT, "oom" as &const byte, 3);
        return;
    }
    var body: Buf = buf_new(8388608);
    defer { buf_free(&body); }
    if !dwh_read_file(full.ptr as &const byte, &body, 8388608) {
        _ = srv_send_response(fd, SRV_ST_404, SRV_CT_TEXT,
            "not found" as &const byte, 9);
        return;
    }
    _ = srv_send_response(fd, SRV_ST_200, dwh_mime_of(path),
        body.ptr as &const byte, body.len);
}

// 路径里有 `..` 吗。
fn dwh_has_dotdot(path: &const Buf) bool {
    var i: usize = 0;
    while i + 2 < path.len {
        if path.ptr[i] == 46 as byte && path.ptr[i + 1] == 46 as byte {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 按后缀给 Content-Type（够 DSH 的 dist 用：html/js/css/svg/json/字体）。
fn dwh_mime_of(path: &const Buf) &const byte {
    const p: &const byte = path.ptr as &const byte;
    const n: usize = path.len;
    if n >= 4 && dwh_suffix_is(p, n, ".css" as &const byte) {
        return "text/css; charset=utf-8" as &const byte;
    }
    if n >= 3 && dwh_suffix_is(p, n, ".js" as &const byte) {
        return "application/javascript; charset=utf-8" as &const byte;
    }
    if n >= 4 && dwh_suffix_is(p, n, ".svg" as &const byte) {
        return "image/svg+xml" as &const byte;
    }
    if n >= 5 && dwh_suffix_is(p, n, ".json" as &const byte) {
        return SRV_CT_JSON;
    }
    if n >= 5 && dwh_suffix_is(p, n, ".woff2" as &const byte) {
        return "font/woff2" as &const byte;
    }
    if n >= 4 && dwh_suffix_is(p, n, ".woff" as &const byte) {
        return "font/woff" as &const byte;
    }
    if n >= 3 && dwh_suffix_is(p, n, ".ttf" as &const byte) {
        return "font/ttf" as &const byte;
    }
    if n >= 13 && dwh_suffix_is(p, n, ".webmanifest" as &const byte) {
        return "application/manifest+json" as &const byte;
    }
    return SRV_CT_BIN;
}

// p 的后缀是 suf 吗。
fn dwh_suffix_is(p: &const byte, n: usize, suf: &const byte) bool {
    const sl: usize = bufx_cstr_len(suf);
    if sl == 0 || n < sl {
        return false;
    }
    return bufx_eq_cstr(&p[n - sl], sl, suf);
}

// `/api/<method>`：收 body → 取 rpcId → 产 value → 包成 ServerResponse。
// **未实现的方法回 200 + `internal` 业务错**（HTTP 状态只表示载体）。
fn dwh_send_api(h: &DwhHost, ci: usize, m: u8, path: &const Buf,
    head_end: usize) void {
    if ci >= DWH_MAX_CONNS {
        return;
    }
    const fd: i32 = h.conns[ci].fd;
    if m != SRV_M_POST {
        _ = srv_send_response(fd, SRV_ST_404, SRV_CT_TEXT,
            "post only" as &const byte, 9);
        return;
    }
    var body: Buf = buf_new(65536);
    defer { buf_free(&body); }
    if !dwh_read_body(&h.conns[ci], head_end, &body) {
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT,
            "bad body" as &const byte, 8);
        return;
    }
    var rpc: Buf = buf_new(128);
    defer { buf_free(&rpc); }
    if !dwh_pick_rpc(&body, &rpc) {
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT,
            "no rpcId" as &const byte, 8);
        return;
    }
    var method: Buf = buf_new(64);
    defer { buf_free(&method); }
    if !dwh_pick_method(&body, &method) {
        _ = srv_send_response(fd, SRV_ST_400, SRV_CT_TEXT,
            "no method" as &const byte, 9);
        return;
    }
    // 路径里的方法名（`/api/<method>`）：与 body 里的 `method` 必须一致（DSH 要求）
    const path_method: &const byte = &path.ptr[5];
    const pml: usize = path.len - 5;
    var resp: Buf = buf_new(65536);
    defer { buf_free(&resp); }
    // ⚠ 两边都是**带长度**的字节，不能拿 `bufx_eq_cstr` 比：它的第三个参数是
    // 「NUL 结尾的字面量」，而 `method` 是个 Buf（没有 NUL）—— 那样它会一路读到
    // 缓冲区后面的字节算长度，长度对不上就恒判「不匹配」（实测症状：所有 `/api`
    // 调用都回 `bad-request`，而页面只是「某些面板读不出来」）。
    if pml != method.len || !bufx_mem_eq(path_method, method.ptr as &const byte, pml) {
        if !dwh_rpc_err(rpc.ptr as &const byte, rpc.len,
            "bad-request" as &const byte,
            "method does not match path" as &const byte, 26, &resp) {
            h.conns[ci].st = DWH_C_DONE;
            return;
        }
    } else {
        var value: Buf = buf_new(65536);
        defer { buf_free(&value); }
        if dwh_unary(h, method.ptr as &const byte, method.len, &body, &value) {
            // 业务错走**同一条出口**：`dwh_unary` 的契约是「写 value」，而它偶尔要
            // 回答「这个请求不合法」—— 那也写进 value，但带一个内部标记
            // （`dwh_rpc_owned_err`）。在这里一次性拆成 `ok:false` 的信封 ——
            // 两处各拼一次信封就会有两份「怎么拼错误响应」的知识。
            var code: Buf = buf_new(64);
            defer { buf_free(&code); }
            var msg: Buf = buf_new(512);
            defer { buf_free(&msg); }
            if dwh_take_owned_err(&value, &code, &msg) {
                if !dwh_rpc_err(rpc.ptr as &const byte, rpc.len,
                    code.ptr as &const byte, msg.ptr as &const byte, msg.len,
                    &resp) {
                    h.conns[ci].st = DWH_C_DONE;
                    return;
                }
            } else if !dwh_rpc_ok(rpc.ptr as &const byte, rpc.len, &value, &resp) {
                h.conns[ci].st = DWH_C_DONE;
                return;
            }
        } else {
            // 没实现：**如实说**（客户端据此把那个面当「不支持」，而不是「连接坏了」）
            var msg: Buf = buf_new(128);
            defer { buf_free(&msg); }
            _ = buf_append_cstr(&msg, "not implemented: ");
            _ = buf_append(&msg, method.ptr as &const byte, method.len);
            if !dwh_rpc_err(rpc.ptr as &const byte, rpc.len,
                "internal" as &const byte,
                msg.ptr as &const byte, msg.len, &resp) {
                h.conns[ci].st = DWH_C_DONE;
                return;
            }
        }
    }
    _ = srv_send_response(fd, SRV_ST_200, SRV_CT_JSON,
        resp.ptr as &const byte, resp.len);
}

// ============================================================
// 0.2.0 的 `remote.mux`（双向流多路复用）
// ============================================================

// 一条客户端文本帧 → 解码去掩码 → 按 `type` 分派。
//
// 帧格式（客户端→服务端**必须掩码**）：`b0` = FIN|opcode、`b1` = MASK|len、
// 然后 4 字节掩码键、再 payload。长度有 7 位 / 16 位 / 64 位三种形态，`open` 帧
// 里带 payload（实测 130~250 字节），所以 16 位那种必须支持（126 分支）。
// 解一条帧，返回它占用的字节数（0 = 残帧，等更多数据）。
fn dwh_remote_frame(h: &DwhHost, ci: usize, frame: &const byte,
                    n: usize) usize {
    if ci >= DWH_MAX_CONNS || n < 6 {
        return 0;
    }
    const masked: bool = (frame[1] & 128 as byte) != 0;
    var plen: usize = (frame[1] & 127 as byte) as usize;
    var poff: usize = 2;
    if plen == 126 {
        if n < 8 {
            return 0;
        }
        plen = ((frame[2] as usize) << 8) | (frame[3] as usize);
        poff = 4;
    } else if plen == 127 {
        return 0;    // 64 位长度：`open` 帧不会这么大，不实现（也不假装支持）
    }
    // ⚠ 掩码键的位置**跟着长度形态走**：7 位长度时在 2，16 位时在 4。
    // 早先这里写死 `frame[2 + (k & 3)]` —— 于是 16 位长度的帧（`session/follow`
    // 那种 300 字节的 `open`）解出来是**乱码**，`endpoint` 认不出、整条流不回。
    // 实测症状：客户端每次只收到零个响应，把连接判成「没就绪」并重连。
    const moff: usize = poff;
    if masked {
        if n < poff + 4 {
            return 0;
        }
        poff = poff + 4;
    }
    if poff + plen > n {
        plen = n - poff;      // 收不齐就按收到的部分处理（`open` 很小，一帧就到）
    }
    // 这一帧占用的字节数 = 帧头 + 4 字节掩码键（若掩码）+ payload
    const consumed: usize = poff + plen;
    var text: Buf = buf_new(plen + 8);
    defer { buf_free(&text); }
    var k: usize = 0;
    while k < plen {
        var b: byte = frame[poff + k];
        if masked {
            b = (b ^ frame[moff + (k & 3)]) as byte;
        }
        if !buf_append_byte(&text, b) {
            return 0;
        }
        k = k + 1;
    }
    dwh_remote_dispatch(h, ci, &text);
    // **返回这一帧占用的字节数** —— 上面那个循环靠它往前走。
    // 这里曾经漏写（函数末尾是隐式返回 0），于是循环第一圈就 `break`，
    // 一段里的**后续帧全丢**（症状与「只解第一条」一模一样）。
    return consumed;
}

// 按 `type` 分派一条已解码的文本。现在只认 `open`（客户端开的流）；`item`/`end`
// 是客户端往**上行**流塞数据用的，本仓的上行面还没接，忽略即可（不能报错：
// 报错会让客户端把整条连接判死）。
fn dwh_remote_dispatch(h: &DwhHost, ci: usize, text: &const Buf) void {
    // ⚠ 判据是 `"type":"open"` 这个**键值对**，不是 `"open"` 这个键 ——
    // 帧的形状是 `{"type":"open","streamId":…}`，`open` 是**值**。
    // 早先按「键」判恒不成立 ⇒ 所有 `open` 都被丢掉（实测：探针显示
    // `remote_text` 进来了，而 `open` 处理一次都没执行）。
    // ⚠ 找的是 `"type"` 与 `"open"` **两个片段**，不是一个连写的
    // `"type":"open"`：JSON 的冒号后**允许空白**（实测 python 的默认
    // `json.dumps` 就发 `{"type": "open", …}`，中间有空格）——
    // 连写判据在这种帧上恒不成立，而它不报错、只是什么都处理不了。
    if !dwh_has_frag(text, "\"type\"" as &const byte) {
        return;
    }
    if !dwh_has_frag(text, "\"open\"" as &const byte) {
        return;
    }
    var sid: Buf = buf_new(64);
    defer { buf_free(&sid); }
    var ep: Buf = buf_new(64);
    defer { buf_free(&ep); }
    if !dwh_pick_str(text, "streamId" as &const byte, &sid) {
        return;
    }
    if !dwh_pick_str(text, "endpoint" as &const byte, &ep) {
        return;
    }
    dwh_remote_open(h, ci, &sid, &ep);
}

// 某个 `endpoint` 的 `open` → 回一条 `item`。
//
// 实测真 DSH 在启动时开这三条（10 秒内共 8 帧）：
//   `workspace/follow` → baseline（工作区清单）
//   `$events`          → **ready**（这条是连接「就绪」的判据，不回它客户端会
//                        报 `generation is still not ready` 并**反复重连** ——
//                        这正是本宿主此前「connection lost, retry #1..3」的根因）
//   `session/control`  → baseline（投影）
// 其余（`session/follow` 等）暂时回一条空的 baseline，让客户端不吊死。
fn dwh_remote_open(h: &DwhHost, ci: usize, sid: &const Buf,
                   ep: &const Buf) void {
    if ci >= DWH_MAX_CONNS {
        return;
    }
    const fd: i32 = h.conns[ci].fd;
    // 记下这条流的 streamId（**追加**，见 `sids` 的注）：宿主主动推帧时要按它找连接。
    if !buf_append(&h.conns[ci].sids, sid.ptr as &const byte, sid.len) {
        return;
    }
    _ = buf_append_byte(&h.conns[ci].sids, 10);
    if bufx_eq_cstr(ep.ptr as &const byte, ep.len, "$events" as &const byte) {
        if !dwh_sid_add(&h.e_sid, sid) {
            return;
        }
        const rdy: &const byte = "\"clientId\":\"uya-host\"," as &const byte;
        dwh_remote_item(fd, sid, "ready" as &const byte, rdy,
            bufx_cstr_len(rdy), &h.events);
        return;
    }
    if bufx_eq_cstr(ep.ptr as &const byte, ep.len, "workspace/follow" as &const byte) {
        // `workspace/follow` 的 baseline 要**三个**键（读客户端的 `replaceBaseline`）：
        // `items` / `archivedSessionIds` / `pinnedSessionIds`。只给 `items` 时
        // `installArchived(undefined)` 会抛 `Cannot read properties of undefined
        // (reading 'length')` —— 而症状是页面上的工作区列表整片空着。
        // ⚠ `items` 里必须有**与 `workspace.list` 同一份**的工作区（见
        // `dwh_workspace_item` 的注释：回空数组会让页面停在选工作区那一屏）
        var wsb: Buf = buf_new(1024);
        defer { buf_free(&wsb); }
        if !buf_append_cstr(&wsb, "\"value\":{\"items\":[") {
            return;
        }
        if !dwh_workspace_item(&wsb) {
            return;
        }
        // 行宽豁免：不可断的 JSON 骨架
        if !buf_append_cstr(&wsb, "],\"archivedSessionIds\":[],") {
            return;
        }
        if !buf_append_cstr(&wsb, "\"pinnedSessionIds\":[]}") {
            return;
        }
        dwh_remote_item(fd, sid, "baseline" as &const byte,
            wsb.ptr as &const byte, wsb.len, &h.events);
        return;
    }
    // `session/control` 的 baseline 是 `{"projections":{…}}` ——
    // 客户端对它做 `Object.entries(baseline.projections)`，给 `{}` 会抛
    // `Cannot convert undefined or null to object`（实测）。给空对象即可。
    if bufx_eq_cstr(ep.ptr as &const byte, ep.len,
        "session/control" as &const byte) {
        // `session/control` 的 baseline：`{value:{projections:<key>:{asOfSeq,values}}}`。
        // 从前给 `{}` 是「先把连接喂活」的最小形状，而**模型选择器读的是这里的
        // `modelSelection`**（客户端的 `ModelDirectory.syncInputs`：
        // `projected.next ?? catalog.default`）—— 空对象时它停在 `catalog.default`，
        // 于是「选了模型但触发器不更新」。键的真值源只有一处（`dwhm_projection_json`）。
        // ⚠ `dwhm_projection_json` / `dwhm_current_json` 都是**先 reset 出参**的
        // （它们是「产出一个值」的函数）—— 直接把前缀写进同一个缓冲的话，那一下
        // reset 就把前缀抹掉了。实测症状：帧变成 `"type":"baseline",{…`（非法 JSON，
        // 客户端拒帧、整条控制流不折）。所以**先渲染成独立的一份再拼**。
        var pv: Buf = buf_new(512);
        defer { buf_free(&pv); }
        if !dwhm_projection_json(&h.model, &pv) {
            return;
        }
        var ctl: Buf = buf_new(pv.len + 128);
        defer { buf_free(&ctl); }
        // 行宽豁免：不可断的 JSON 骨架
        if !buf_append_cstr(&ctl, "\"value\":{\"projections\":{\"modelSelection\":{\"asOfSeq\":0,\"values\":") {
            return;
        }
        if !buf_append(&ctl, pv.ptr as &const byte, pv.len) {
            return;
        }
        if !buf_append_cstr(&ctl, "}}}") {
            return;
        }
        dwh_remote_item(fd, sid, "baseline" as &const byte,
            ctl.ptr as &const byte, ctl.len, &h.events);
        return;
    }
    // `session/follow`：**这是消息能渲染出来的那条流**。
    // 它的首帧不是 baseline 而是 `snapshot`，形状取自真 DSH（实测捕获 1780 字节）：
    //   {"type":"snapshot","header":{…},"cursor":N,
    //    "records":[{"type":"event","event":{…本仓译文那一条…}}, …],
    //    "hasMore":false,"projections":{…}}
    // 关键是 `records[]`：每条包一个本仓译文事件（`{"type":"event","event":{…}}`），
    // 与 `/api/session/history` 用的是同一份译文 —— 所以这里**不需要新的翻译**。
    if bufx_eq_cstr(ep.ptr as &const byte, ep.len,
        "session/follow" as &const byte) {
        if !dwh_sid_add(&h.f_sid, sid) {
            return;
        }
        // 快照就是「到此刻为止的全部译文」⇒ 水位直接推到末尾：下面再推增量时
        // 不会把快照里已经给过的行重发（重发会被 fold 当成同一个 id 的重复事件）。
        dwh_send_snapshot(fd, sid, h, &h.events);
        h.pushed = h.events.len;
        return;
    }
    // 其余流：一条退化的 baseline（客户端据此认为「这条流没有数据」而不是挂住）
    const dbl: &const byte = "\"value\":{}" as &const byte;
    dwh_remote_item(fd, sid, "baseline" as &const byte, dbl,
        bufx_cstr_len(dbl), &h.events);
}

// 一条 `{"type":"item","streamId":…,"value":{…}}` 帧。
// `extra` 是 value 里的**固定片段**（含尾逗号），尾部补本仓的会话 id。
fn dwh_remote_item(fd: i32, sid: &const Buf, kind: &const byte,
                   extra: &const byte, xl: usize, events: &const Buf) void {
    // 缓冲按 `extra` 的**实际长度**算：写死 2048 时，几百字节的 baseline 够用，
    // 而 `session/follow` 那种**几千字节**的快照会被截断 —— 截断的 JSON 让客户端
    // `close(4002)`，而症状只是「消息不显示」（实测：浏览器里只收到 462 字节，
    // 而同一份数据在裸 socket 上是 3141 字节）。
    var p: Buf = buf_new(xl + sid.len + 256);
    defer { buf_free(&p); }
    if !buf_append_cstr(&p, "{\"type\":\"item\",\"streamId\":\"") {
        return;
    }
    if !buf_append(&p, sid.ptr as &const byte, sid.len) {
        return;
    }
    if !buf_append_cstr(&p, "\",\"value\":{\"type\":\"") {
        return;
    }
    if !buf_append_cstr(&p, kind) {
        return;
    }
    // `extra` 已经是**完整的后续字段**（含 `"` 与逗号由调用方负责），
    // 所以这里只在它非空时补一个分隔逗号。
    //
    // ⚠ 用**显式长度**而不是 `bufx_cstr_len(extra)`：`extra` 常常是另一个
    // `Buf` 的内容（没有 NUL 结尾），当 C 串量长度会一路读进相邻内存 ——
    // 实测症状是帧里混进**上一次用过的缓冲残留**（`…"]ace","@deepseek-ai/…`），
    // JSON 因此坏掉、客户端 `close(4002, "invalid Remote stream frame")`。
    if xl > 0 {
        if !buf_append_cstr(&p, "\",") {
            return;
        }
        if !buf_append(&p, extra, xl) {
            return;
        }
    }
    // `$events` 要 host（客户端读 `host.home`）。
    //
    // ⚠ **`value` 的**字段数必须精确**：客户端用 `exactKeys(value, ["type"])`
    // 或 `["type","streamId","value"]` 校验每一条帧 —— 多一个字段就整条判非法，
    // 而它的表现是把**整条连接**判死并重连（`connection lost, retry #N`），
    // 不是「这条流没数据」。实测：我早先给非 `ready` 的流多塞了一个
    // `sessionId`，于是每帧都被拒、页面每 3 秒重连一次。
    // 所以这里只发真 DSH 发过的那两个字段，一个都不多加。
    if bufx_eq_cstr(kind, 5, "ready" as &const byte) {
        if !buf_append_cstr(&p, "\"host\":{\"home\":") {
            return;
        }
        if !dwh_home_json(&p) {
            return;
        }
        if !buf_append_byte(&p, 125) {
            return;      // 闭合 `host`
        }
    }
    // ⚠ **两个**收尾：闭合 `value`，再闭合**顶层对象**。
    // 少一个的话 JSON 是坏的，而客户端的 react 是
    // `socket.close(4002, "invalid Remote stream frame")` ——
    // 表现为「每 3 秒 connection lost 重连」，与「帧内容不对」毫无字面关系。
    // 实测：这一条（少一个 `}`）就是第十批之后仍然重连的**根因**。
    if !buf_append_cstr(&p, "}}") {
        return;
    }
    // `events` 目前不参与这条帧的正文（会话事件那几条流还没接），
    // 显式用掉参数以免「未使用」告警。
    if events.len > 0 {
        // 有意为空：见上
    }
    _ = dwh_ws_send_text(fd, p.ptr as &const byte, p.len);
}

// 文本里有没有这个片段（**按字节找**，不做 JSON 解析：帧的判别只需要两个片段）。
fn dwh_has_frag(text: &const Buf, frag: &const byte) bool {
    return srv_find(text.ptr as &const byte, 0, text.len,
        frag, bufx_cstr_len(frag)) >= 0;
}

// 文本里有没有 `"<key>"` 这个键（粗判：够用来分辨帧的 `type`）。
fn dwh_has_key(text: &const Buf, key: &const byte) bool {
    var pat: Buf = buf_new(32);
    defer { buf_free(&pat); }
    if !buf_append_byte(&pat, 34) {
        return false;
    }
    if !buf_append_cstr(&pat, key) {
        return false;
    }
    if !buf_append_byte(&pat, 34) {
        return false;
    }
    return srv_find(text.ptr as &const byte, 0, text.len,
        pat.ptr as &const byte, pat.len) >= 0;
}

// 取 `"<key>":"<value>"` 里的 value（写进 `out`）。找不到返回 false。
fn dwh_pick_str(text: &const Buf, key: &const byte, out: &Buf) bool {
    var pat: Buf = buf_new(32);
    defer { buf_free(&pat); }
    // 判据是 `"key"` 后跟**一个冒号**（不假定冒号紧贴引号）：JSON 允许冒号前后
    // 有空白，实测 python 的 `json.dumps` 默认就发 `"streamId": "s1"`。
    // 先找 `"key"`，再从它后面找冒号与开引号。
    if !buf_append_byte(&pat, 34) {
        return false;
    }
    if !buf_append_cstr(&pat, key) {
        return false;
    }
    if !buf_append_byte(&pat, 34) {
        return false;
    }
    const at: isize = srv_find(text.ptr as &const byte, 0, text.len,
        pat.ptr as &const byte, pat.len);
    if at < 0 {
        return false;
    }
    var i: usize = (at as usize) + pat.len;
    while i < text.len && (text.ptr[i] == 32 as byte || text.ptr[i] == 9 as byte) {
        i = i + 1;
    }
    if i >= text.len || text.ptr[i] != 58 as byte {
        return false;         // 不是「键：值」形态（可能是键名的一部分）
    }
    i = i + 1;
    while i < text.len && (text.ptr[i] == 32 as byte || text.ptr[i] == 9 as byte) {
        i = i + 1;
    }
    if i >= text.len || text.ptr[i] != 34 as byte {
        return false;         // 值不是字符串（本函数只取字符串）
    }
    i = i + 1;
    buf_reset(out);
    while i < text.len && text.ptr[i] != 34 as byte {
        if !buf_append_byte(out, text.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    return out.len > 0;
}


// `session/follow` 的首帧。
// 形状：`{"type":"item","streamId":…,"value":{"type":"snapshot",…}}`。
//
// `records[]` 把 `h.events` 里每一行译文包成 `{"type":"event","event":<那条>}`；
// `cursor` 取**末条的 seq + 1**（真 DSH 那边 cursor 是「已经发到哪」的水位）。
// `header` / `projections` 里本仓没有真值，给**能过校验的最小形状**
// （字段名照抄真 DSH，值给中性值）—— 少字段会让客户端在 fold 里抛异常，
// 而症状是「页面空着 + 一条看不懂的 TypeError」。
fn dwh_send_snapshot(fd: i32, sid: &const Buf, h: &const DwhHost,
                     events: &const Buf) void {
    var proj: Buf = buf_new(512);
    defer { buf_free(&proj); }
    if !dwhm_projection_json(&h.model, &proj) {
        return;
    }
    var p: Buf = buf_new(events.len + 4096);
    defer { buf_free(&p); }
    if !dwh_snapshot_frame(sid, events, &proj, h.live, &p) {
        return;
    }
    _ = dwh_ws_send_text(fd, p.ptr as &const byte, p.len);
}

// 快照那一帧的**正文**（纯函数：`Buf` 进 `Buf` 出，不认识连接与宿主）。
//
// 为什么单独抽出来：这一帧是「页面能不能显示」的全部 —— 而它的缺陷形态是
// **静默的**（客户端拒帧后页面只是空着或红一行「加载会话历史失败」）。所以它
// 必须能被自测**当数据**验（`st_web` 的 `snapshot` 段拿本仓的 JSON 解析器解它，
// 见那一轮的不变量③：结构坏掉要由**外部 oracle** 判，子串断言抓不住）。
// `model` = 已经渲染好的 `modelSelection` 投影值（`{lastUsed,next}`）。
// **做成形参而不是在这里现算**：这一帧要能被自测当纯函数验（`web-snapshot` 轮），
// 而现算就要把宿主（目录、当前选择）拖进来 —— 那一轮只需验 JSON 结构。
// 调用方用 `dwhm_projection_json`（活会话）或一个中性值（自测）。
// `live` = 这批译文是**活会话**的（`dwhc_one_line` 已经把它们整体后移过
// `DWH_LIVE_SHIFT`，而且日志还在长）。两种模式在**seq 口径**上根本不同：
//
//   * 静态（`--dsh-web-events` 那份译文）：译文的 seq 从 0 起，快照要**自己**
//     补 3 条 seed 并把译文后移 `DWH_SEED_SEQS`，末尾再压一条 `session/end-seed`
//     收口 —— 那是「一份有头有尾的历史」；
//   * 活会话：译文已经后移过（`DWH_LIVE_SHIFT` = seed 3 条 + 收口 1 条），
//     **不能再移一次**，也**不能**在末尾补 end-seed（会话还在长，收口标记会把
//     后面的活事件挡在「已收口」之外）。
//
// ⚠ 从前两种模式共用一条路，于是活会话的快照把已经位移过的译文**又移了 3**：
// 快照里最后一条是 `N+3`，而紧接着推上来的活事件是 `N+1` —— 客户端读到的
// seq **往回跳**，`page contains discontinuous entries` ⇒ `close(4002)` 并
// 每 3 秒重连一次；每重连一次都重新快照、再跳一次，**永远转圈**（实测：
// 一次加载里 85 次 `ready`、页面停在「Loading history…」）。
export fn dwh_snapshot_frame(sid: &const Buf, events: &const Buf,
    model: &const Buf, live: bool, p: &Buf) bool {
    buf_reset(p);
    if !buf_append_cstr(p, "{\"type\":\"item\",\"streamId\":\"") {
        return false;
    }
    if !buf_append(p, sid.ptr as &const byte, sid.len) {
        return false;
    }
    // 行宽豁免：不可断的 JSON 骨架
    if !buf_append_cstr(p, "\",\"value\":{\"type\":\"snapshot\",\"header\":{") {
        return false;
    }
    if !buf_append_cstr(p, "\"version\":4,\"id\":\"") {
        return false;
    }
    if !buf_append_cstr(p, DWH_SESSION_ID) {
        return false;
    }
    if !buf_append_cstr(p, "\",\"createdAt\":0,\"cwd\":") {
        return false;
    }
    if !dwh_cwd_json(p) {
        return false;
    }
    // 行宽豁免：不可断的 JSON 骨架
    // `isSeeded`：与真 DSH 同口径给 `false` —— 收口靠下面 records 里那几条
    // **seed 事件**（`session/end-seed` 是最后一条）。这条是实测补出来的：
    // 少了 seed 事件时客户端把整段历史当「还没播种完」，对话区一个节点都不建
    // （`conversation.session` 的 innerHTML 长度 = 0，而控制台**一句抱怨都没有**）。
    if !buf_append_cstr(p, ",\"isSeeded\":false,\"delegationDepth\":0,") {
        return false;
    }
    if !buf_append_cstr(p, "\"agentPreset\":\"standard\"},") {
        return false;
    }
    if !buf_append_cstr(p, "\"cursor\":") {
        return false;
    }
    // `cursor` = **末条记录的 seq**（record 的 `seq` 是从 0 连续排的）。
    //
    // ⚠ 这里与下面写 `session/end-seed` 用的是**同一个变量**（`last`）——
    // 从前两处各算一次，零事件源时 cursor 算成 0 而 end-seed 写 3，客户端
    // `assertPageThrough` 拿 `tailCursor(page) === through` 判，恒不等 ⇒
    // 报 `page did not end at its requested cursor`。**一个真值源**：先算出
    // 「末条是几号」，cursor 与 end-seed 都用它。
    const has_seed: bool = dwh_has_frag(events, "session/end-seed" as &const byte);
    var last: u64 = dwh_events_last_seq(events);
    // 活会话：译文已经后移过、也不补 seed/收口 ⇒ 末条就是末条（见 `live` 的注）。
    // 只有「一份静止的历史」那条路才需要下面这套重排。
    var write_seed: bool = !has_seed;
    if live {
        write_seed = dwh_live_needs_seed(events);
        if !write_seed {
            last = dwh_events_last_seq(events);
        }
    }
    if !has_seed && (!live || write_seed) {
        if last > 0 {
            // 译文整体后移 `DWH_SEED_SEQS`，再让 end-seed 接在末条译文**之后**
            // （少这个 +1 就与末条译文撞号 ⇒ `page contains discontinuous
            // entries` —— 实测：撞号与「不连续」在客户端是同一个判据）。
            last = last + DWH_SEED_SEQS + 1;
        } else {
            // 译文为空：末条就是 end-seed，它接在开头三条 seed 之后。
            last = DWH_SEED_SEQS;
        }
    }
    if !buf_append_u64(p, last) {
        return false;
    }
    if !buf_append_cstr(p, ",\"records\":[") {
        return false;
    }
    if !dwh_records_all(events, has_seed, live, last, p) {
        return false;
    }
    // `hasMore` + `projections`：真 DSH 的 projections 很大，这里给**同名的空值**
    // （客户端读的是里面具体的键，缺键会在 fold 里 undefined）
    // 行宽豁免：不可断的 JSON 骨架
    if !buf_append_cstr(p, "],\"hasMore\":false,") {
        return false;
    }
    // `projections`：**snapshot 与 session/list 的形状不同**（实测对照真 DSH 的
    // 一份**带消息**的 snapshot 得出）：
    //   * `session/list` 的 item：`{kind:"sequenced", asOfSeq, values}`
    //   * snapshot 的：`{asOfSeq, values}` —— **没有 `kind`**
    // 而 `values` 里真 DSH 有 **19 个键**（title/goal/tokenUsage/sessionStats/
    // turnOutline/inbox/…）。给 `{}` 时对话区不建消息节点（而控制台零报错）。
    // 这里给**同样的 19 个键**、值取中性（本仓没有真值的那几项给 null/0/[]）。
    if !buf_append_cstr(p, "\"projections\":{\"asOfSeq\":0,\"values\":") {
        return false;
    }
    if !dwh_projection_values(model, p) {
        return false;
    }
    if !buf_append_byte(p, 125) {
        return false;
    }
    // ⚠ `assistantStream` **不能省**：客户端在拿到 snapshot 时第一句就是
    //   `if (frame.assistantStream === void 0) throw new RemoteError(… "session
    //    assistant stream omitted its opted-in opening baseline")`
    // —— 少了它整条流当场抛错、消息一条都不折。形状取自真 DSH：`{revision:0}`。
    if !buf_append_cstr(p, ",\"assistantStream\":{\"revision\":0}") {
        return false;
    }
    return buf_append_cstr(p, "}}");
}

// 活会话的这批译文要不要补那三条 seed？判据是**它自己有没有内容**：
//   * 空（刚连上、还没人说话）：补 seed 0..2 + 收口 3，第一条活事件正好接 `4`；
//   * 非空：译文已经带着 `DWH_LIVE_SHIFT` 的位移，**什么都不补** —— 补了会与
//     译文撞号，而不补则第一条活事件接得上（见 `dwh_snapshot_frame` 的注）。
fn dwh_live_needs_seed(events: &const Buf) bool {
    return dwh_events_last_seq(events) == 0;
}

// `records[]` 的段间逗号：**只在不是第一条时**写，并翻掉 `first`。
// seed / 译文 / end-seed 三段共用它（从前各写各的，零事件源时就多出一个逗号
// ⇒ 非法 JSON，见 `dwh_seed_records` 的注释）。
fn dwh_record_sep(out: &Buf, first: &bool) bool {
    if *first {
        *first = false;
        return true;
    }
    return buf_append_byte(out, 44);
}

// `records[]` 里的三段（seed / 译文 / end-seed）**按顺序拼起来**。
//
// 单独抽出来的理由：这三段的**逗号纪律必须在一处**（`first` 是它们共用的状态）。
// 分成两处写就同时买下两个方向的缺陷，而两个方向的症状**一模一样**（页面
// 「加载会话历史失败」+ 每 3 秒重连）：
//   * 多一个：seed 段自带收尾逗号 + end-seed 又补一个 ⇒ `},,{`
//   * 少一个：seed 写了逗号却没翻 `first` ⇒ 后一段以为自己是第一条、不写 ⇒ `}}{`
// `tail` 是收口那条 `session/end-seed` 的 seq（`has_seed` 时它已经在译文里，
// 这里不再补）。
fn dwh_records_all(events: &const Buf, has_seed: bool, live: bool,
    tail: u64, p: &Buf) bool {
    var first: bool = true;
    // **译文里已经有 seed 段时不再插**（真 DSH 的日志本来就带
    // `permission/preset`…`session/end-seed`）：无条件插会让 seq 撞车。
    // 活会话：译文已经后移过 ⇒ **只有译文为空时**才补那三条 seed
    // （补了才能让第一条活事件接在 `3+1` 上；见 `dwh_live_needs_seed`）。
    var write: bool = !has_seed;
    if live {
        write = dwh_live_needs_seed(events);
    }
    if write {
        if !dwh_seed_records(p, &first) {
            return false;
        }
    }
    // 传「**没插** seed」：插了 seed 才占用 0..3，那时才需要把译文后移。
    // （此前传的是 `has_seed`，正好反了 —— 实测症状：喂真夹具时 cursor=21
    //   而末条 seq=25，客户端报 `did not end at its requested cursor`。）
    var sh: u64 = DWH_SEED_SEQS;
    var close_mark: bool = !has_seed;
    if live {
        // 活会话的译文**已经**位移过（`DWH_LIVE_SHIFT`）：这里一个字节都不移。
        sh = 0;
        close_mark = dwh_live_needs_seed(events);
    } else if has_seed {
        sh = 0;
    }
    if !dwh_records(events, p, sh, &first) {
        return false;
    }
    // 收口标记：`session/end-seed` 放在**译文之后**（理由见 `DWH_SEED_SEQS`）。
    // 活会话**不补**它：会话还在长，收口标记会把后面的活事件挡在「已收口」之外
    // （客户端按它判「继承的前缀到此为止」）。
    if !close_mark {
        return true;
    }
    if !dwh_record_sep(p, &first) {
        return false;
    }
    // 行宽豁免：不可断的 JSON 骨架
    if !buf_append_cstr(p, "{\"type\":\"event\",\"event\":{\"type\":\"session/end-seed\",") {
        return false;
    }
    if !buf_append_cstr(p, "\"seq\":") {
        return false;
    }
    if !buf_append_u64(p, tail) {
        return false;
    }
    return buf_append_cstr(p, ",\"time\":0,\"data\":{}}}");
}

// `records[]`：把译文每一行包成 `{"type":"event","event":<那条>}`（逗号分隔）。
// `first` 由调用方带进来（上面那段 seed 可能已经写过东西了）。
// `sh` = seq 位移量（0 = 不位移，见 `dwh_shift_seq`）。
fn dwh_records(events: &const Buf, out: &Buf, sh: u64,
    first: &bool) bool {
    var start: usize = 0;
    var i: usize = 0;
    while i <= events.len {
        const at_end: bool = i == events.len;
        if at_end || events.ptr[i] == 10 as byte {
            const seg: usize = i - start;
            if seg > 0 {
                if !dwh_record_sep(out, first) {
                    return false;
                }
                if !buf_append_cstr(out, "{\"type\":\"event\",\"event\":") {
                    return false;
                }
                // ⚠ 译文的 `seq` 要**整体后移**（seed 占了 0..2）：
                // 两段都用 0 起头时客户端的连续性检查当场判
                // `page contains discontinuous entries`（实测）。
                // `assistant/message` 要**补一个 `data.stream`**（chunk 级回放）——
                // 这是最后一块拼图，靠「把真 DSH 的一份带消息的 snapshot 当夹具」
                // 二分出来的：两者的 `message.content` 同形、`surfaceOp` 同形、
                // seq/cursor 都对，**唯一差别**就是真那份的 `data` 里多
                // `stream`（7 条 chunk）与 `usage`。补上就渲染出来了（实测）。
                // 这一段（含 `assistant/message` 的 `stream` 补全）与活事件帧
                // **同一处**实现，见 `dwh_event_bytes`。
                // 行宽豁免：不可断的调用
                if !dwh_event_bytes(&events.ptr[start], seg, sh, out) {
                    return false;
                }
                if !buf_append_byte(out, 125) {
                    return false;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return true;
}

// **一行日志译文 → 一条 DSH 事件的字节**（快照 `records[]` 与活事件帧共用这一个）。
//
// 为什么必须共用：`assistant/message` 要补一个 `data.stream`（chunk 级回放），
// 而这件事**只有一处**知道 —— 从前快照那条路补了、活事件那条路没补，于是
// 「历史里的助手消息能渲染、刚聊出来的那一条渲染不出来」（实测：同一个会话里
// 用户那条渲染了、答复那条没有，而日志里两条都在）。
// `sh` = seq 位移量（两处口径不同，见 `dwh_shift_seq`）。
export fn dwh_event_bytes(line: &const byte, n: usize, sh: u64,
    out: &Buf) bool {
    if dwh_is_assistant_msg(line, n) {
        return dwh_assistant_with_stream(line, n, sh, out);
    }
    if sh > 0 {
        return dwh_shift_seq(line, n, sh, out);
    }
    return buf_append(out, line, n);
}

// 译文里最后一条的 `seq`（游标水位）。取不到就回 0。
fn dwh_events_last_seq(events: &const Buf) u64 {
    var start: usize = 0;
    var i: usize = 0;
    var last: u64 = 0;
    while i <= events.len {
        const at_end: bool = i == events.len;
        if at_end || events.ptr[i] == 10 as byte {
            const seg: usize = i - start;
            if seg > 0 {
                const s: u64 = dwh_seq_of(&events.ptr[start], seg);
                if s > last {
                    last = s;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return last;
}

// 一行译文里的 `"seq":<n>`（找不到回 0）。
fn dwh_seq_of(line: &const byte, n: usize) u64 {
    const pat: &const byte = "\"seq\":" as &const byte;
    const at: isize = srv_find(line, 0, n, pat, bufx_cstr_len(pat));
    if at < 0 {
        return 0;
    }
    var i: usize = (at as usize) + bufx_cstr_len(pat);
    // ⚠ 冒号后**可能有空白**（真 DSH 的日志就是 `"seq": 8`）——
    // 不跳空白会把 `seq` 读成 0，而 `cursor` 因此恒为 0 ⇒ 客户端报
    // `page did not end at its requested cursor`（实测：喂真夹具时 cursor=0
    // 而末条 seq=21）。
    while i < n && (line[i] == 32 as byte || line[i] == 9 as byte) {
        i = i + 1;
    }
    var v: u64 = 0;
    var got: bool = false;
    while i < n && line[i] >= 48 as byte && line[i] <= 57 as byte {
        v = v * 10 + ((line[i] as u64) - 48);
        got = true;
        i = i + 1;
    }
    if !got {
        return 0;
    }
    // ⚠ **不加一**：客户端拿 `cursor` 去比**最后一条记录的 seq**
    //   （`assertPageThrough`: `tailCursor(page) === through`），
    //   加一就恒判不等 ⇒ `session event stream page did not end at its
    //   requested cursor`，而对话区显示的是这条错、不是消息
    //   （实测：截图里 header 对了、正文位置是红字错误）。
    return v;
}


// snapshot 开头的**四条 seed 事件**（照真 DSH 逐条抄）。
//
// 为什么必须有：客户端把 snapshot 折进对话区时，先按 seed 序列建立会话的
// 「初始事实」（权限/沙箱/审批策略），`session/end-seed` 是**收口**标记。
// 缺这一段时对话区**一个节点都不建**（`conversation.session` 的 innerHTML
// 为空），而控制台零报错 —— 这是最难查的一类（没有任何线索指向 seed）。
fn dwh_seed_records(out: &Buf, first: &bool) bool {
    // ⚠ 三条之间的逗号走**共用的** `dwh_record_sep`（它同时翻 `first`）——
    // 自己写逗号而不翻 `first` 时，后面接的 `session/end-seed` 会以为自己是
    // 第一条、于是**不写逗号**，两条 JSON 直接贴在一起
    // （实测：`…\"never\"}}{\"type\":\"event\",…end-seed…` = 非法 JSON）。
    // 更早那版把逗号焊在字面量尾部，则买下另一个方向的多余逗号（`},,{`）——
    // 两个方向都是**非法 JSON**，客户端一律 `close(4002, 'invalid Remote
    // stream frame')`，症状是「加载会话历史失败」+ 每 3 秒重连一次。
    // 所以这里的纪律是：**任何一条 record 之前都调 `dwh_record_sep`**。
    // 行宽豁免：不可断的 JSON 字面量
    const seed: &const byte = "{\"type\":\"event\",\"event\":{\"type\":\"permission/preset\",\"seq\":0,\"time\":0,\"data\":{\"preset\":\"danger-full-access\"}}}" as &const byte;
    // 行宽豁免：不可断的 JSON 字面量
    const s2: &const byte = "{\"type\":\"event\",\"event\":{\"type\":\"sandbox/mode\",\"seq\":1,\"time\":0,\"data\":{\"mode\":\"danger-full-access\"}}}" as &const byte;
    // 行宽豁免：不可断的 JSON 字面量
    const s3: &const byte = "{\"type\":\"event\",\"event\":{\"type\":\"approval/policy\",\"seq\":2,\"time\":0,\"data\":{\"policy\":\"never\"}}}" as &const byte;
    if !dwh_record_sep(out, first) || !buf_append_cstr(out, seed) {
        return false;
    }
    if !dwh_record_sep(out, first) || !buf_append_cstr(out, s2) {
        return false;
    }
    return dwh_record_sep(out, first) && buf_append_cstr(out, s3);
}


// 把一条译文的 `"seq":N` 改写成 `"seq":N+sh` 后写进 `out`（其余字节原样）。
// 找不到 `"seq":` 就原样拷过去（不认识的形状不要拦）。
//
// `sh`（位移量）是**形参**而不是常量：快照里译文的位移是 `DWH_SEED_SEQS`（开头三条
// seed 占 0..2），而 `/api` 活事件流的位移是 `DWH_SEED_SEQS + 1`（快照末尾还压着一条
// `session/end-seed`）—— 两处口径不同，写死一个常量就等于让另一处错位，而错位的症状
// 是客户端判 `discontinuous entries` 并**整条断流**（见 `DWH_LIVE_SHIFT`）。
fn dwh_shift_seq(line: &const byte, n: usize, sh: u64, out: &Buf) bool {
    const pat: &const byte = "\"seq\":" as &const byte;
    const pl: usize = bufx_cstr_len(pat);
    const at: isize = srv_find(line, 0, n, pat, pl);
    if at < 0 {
        return buf_append(out, line, n);
    }
    var head: usize = (at as usize) + pl;
    // 同 `dwh_seq_of`：跳过冒号后的空白
    while head < n && (line[head] == 32 as byte || line[head] == 9 as byte) {
        head = head + 1;
    }
    var e: usize = head;
    while e < n && line[e] >= 48 as byte && line[e] <= 57 as byte {
        e = e + 1;
    }
    if e == head {
        return buf_append(out, line, n);
    }
    // 前半（含 `"seq":`）+ 新数字 + 后半
    if !buf_append(out, line, head) {
        return false;
    }
    var v: u64 = 0;
    var i: usize = head;
    while i < e {
        v = v * 10 + ((line[i] as u64) - 48);
        i = i + 1;
    }
    if !buf_append_u64(out, v + sh) {
        return false;
    }
    return buf_append(out, &line[e], n - e);
}


// snapshot 的 `projections.values`：**照真 DSH 的 19 个键**（实测对照一份带消息的
// snapshot 得出）。值用中性值 —— 本仓没有真值的那些给 null / 0 / [] / {}，
// 但**键必须齐**：客户端在 fold 里按名字读它们，缺键会让某个 slot 抛
// `Cannot read properties of undefined`（那类症状离原因很远）。
// `model` = 已经渲染好的 `modelSelection` 值（见 `dwh_snapshot_frame`）。
fn dwh_projection_values(model: &const Buf, out: &Buf) bool {
    if !buf_append_cstr(out, "{\"title\":\"本仓会话\",\"goal\":null,") {
        return false;
    }
    // 行宽豁免：不可断的 JSON 字面量
    if !buf_append_cstr(out, "\"tokenUsage\":{\"uncachedInputTokens\":0,\"outputTokens\":0,") {
        return false;
    }
    if !buf_append_cstr(out, "\"cacheReadTokens\":0,\"cacheWriteTokens\":0},") {
        return false;
    }
    if !buf_append_cstr(out, "\"contextPressure\":{},\"contextBreakdown\":{},") {
        return false;
    }
    if !buf_append_cstr(out, "\"inbox\":{\"next-turn\":[],\"next-step\":[]},") {
        return false;
    }
    // 行宽豁免：不可断的 JSON 字面量
    if !buf_append_cstr(out, "\"sessionStats\":{\"turns\":0,\"steps\":0,\"llmMs\":0,\"toolMs\":0,") {
        return false;
    }
    if !buf_append_cstr(out, "\"ttftMs\":0,\"ttftSteps\":0,\"decodeMs\":0,\"decodeTokens\":0},") {
        return false;
    }
    if !buf_append_cstr(out, "\"turnOutline\":[],\"agentPreset\":\"standard\",") {
        return false;
    }
    if !buf_append_cstr(out, "\"userQuestions\":{\"active\":[],\"settled\":[]},") {
        return false;
    }
    if !buf_append_cstr(out, "\"subagentCatalog\":[],\"subagentTiming\":{\"settledMs\":0},") {
        return false;
    }
    if !buf_append_cstr(out, "\"subagent\":null,") {
        return false;
    }
    // ⚠ `permissions` 的**视图**是 `{currentValue}`（`stateSchema` 那侧的
    // `wire.viewSchema`，见 dsh-permission-presets），**不是**空对象：
    // 给 `{}` 时客户端 `catalog.options.find(o => o.value === currentValue)`
    // 找不到、回落 `permissionLabel(currentValue, currentValue, t)`，
    // 而 `currentValue` 是 `undefined` ⇒ `displayPresetName` 里
    // `name.split`（正则 `.test(undefined)` 会先把 undefined 转成字符串，
    // 于是**过不了** kebab 判据却已经走了 `split`）当场抛
    // `TypeError: Cannot read properties of undefined (reading 'split')`
    // ⇒ slot `conversation.input.permission` **整块崩掉**（实测）。
    // 值取本仓的访问模式（与 `permissionPresets/catalog` 的档位同名）。
    if !buf_append_cstr(out, "\"permissions\":{\"currentValue\":") {
        return false;
    }
    if !dwh_permission_json(out, "danger-full-access" as &const byte) {
        return false;
    }
    if !buf_append_cstr(out, "},\"todos\":null,") {
        return false;
    }
    if !buf_append_cstr(out, "\"plan\":{\"active\":false,\"pending\":false},") {
        return false;
    }
    // 行宽豁免：不可断的 JSON 字面量
    // `modelSelection` 与 `session/control` 的 baseline **同源**（同一个组装函数）——
    // 两处不一致时选择器会在「打开会话」与「切会话」之间跳回默认值。
    if !buf_append_cstr(out, "\"modelSelection\":") {
        return false;
    }
    if !buf_append(out, model.ptr as &const byte, model.len) {
        return false;
    }
    if !buf_append_byte(out, 44) {
        return false;
    }
    if !buf_append_cstr(out, "\"sessionListMetadata\":{},\"imageLimits\":{}}") {
        return false;
    }
    return true;
}


// 这一行译文是不是 `assistant/message`（按字节找 `"type":"assistant/message"`，
// 容忍冒号后的空白）。
fn dwh_is_assistant_msg(line: &const byte, n: usize) bool {
    const pat: &const byte = "\"type\"" as &const byte;
    const v: &const byte = "\"assistant/message\"" as &const byte;
    if !dwh_has_frag_b(line, n, pat) {
        return false;
    }
    return dwh_has_frag_b(line, n, v);
}

// 在**任意字节区间**里找片段（`dwh_has_frag` 只吃 `Buf`）。
fn dwh_has_frag_b(p: &const byte, n: usize, frag: &const byte) bool {
    return srv_find(p, 0, n, frag, bufx_cstr_len(frag)) >= 0;
}

// 给一条 `assistant/message` 补 `data.stream`（chunk 级回放）后写出。
//
// 形状照真 DSH（实测 7 条 chunk）：
//   `{"type":"chunk","time":T,"chunk":{"type":"block-start","index":i,"blockType":B}}`
//   → `block-end`（带整块）→ … → 最后一条 `finish`。
// 我们从译文自己的 `data.message.content`（块数组）造 —— **不需要新信息**，
// 只是把已经有的块表达成客户端折消息时要的 chunk 序列。
// `sh` = seq 位移量（0 = 不位移）：这条消息的 `"seq":N` 要写成 `N+sh`。
// 与 `dwh_records` 的 `sh` 是**同一个值**（快照 / 活事件流两处口径不同，见 `dwh_shift_seq`）。
fn dwh_assistant_with_stream(line: &const byte, n: usize, sh: u64,
                            out: &Buf) bool {
    // 先取出 `message.content`（用 jsonx 解析：这里要按块数组逐块走）
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    var abuf: [byte: 65536] = [0: 65536];
    arena_init(&arena, &abuf[0], 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, line, n, &root) {
        return false;      // 解不动就原样写（不拦路）
    }
    var d: JsonValue = JsonValue.json_null();
    var msg: JsonValue = JsonValue.json_null();
    var cont: JsonValue = JsonValue.json_null();
    if !js_obj_get(&root, "data" as &const byte, 4, &d) ||
        !js_obj_get(&d, "message" as &const byte, 7, &msg) ||
        !js_obj_get(&msg, "content" as &const byte, 7, &cont) {
        // 没有块数组：原样写
        if sh > 0 {
            return dwh_shift_seq(line, n, sh, out);
        }
        return buf_append(out, line, n);
    }
    // 走到 `"data":` 之后、`"message"` 之前原样拷；然后在 data 里插 `"stream":[…]`
    // 简法：整行重写 = 前半（到 `"data":{` 为止）+ `"stream":[…],` + 后半去掉首 `{`
    const at: isize = srv_find(line, 0, n, "\"data\"" as &const byte, 6);
    if at < 0 {
        if sh > 0 {
            return dwh_shift_seq(line, n, sh, out);
        }
        return buf_append(out, line, n);
    }
    // 找 data 的 `{`
    var i: usize = (at as usize) + 6;
    while i < n && line[i] != 123 as byte {
        i = i + 1;
    }
    if i >= n {
        if sh > 0 {
            return dwh_shift_seq(line, n, sh, out);
        }
        return buf_append(out, line, n);
    }
    // 前半 = `{` 之前的全部 + `{`（**整段**都要写，不能只写到位移点**）：
    // 首个 `{` 之前含 `"type"` 与 `"seq"`，所以那段要过一遍位移；`"data":{`
    // 本身是纯文本，直接补。
    const cut: usize = i + 1;                      // `{` 之后
    if sh > 0 {
        // `"seq":N` 在 `{` 之前 ⇒ 把前缀（含 `{`）过位移
        if !dwh_shift_seq(&line[0], cut, sh, out) {
            return false;
        }
    } else {
        if !buf_append(out, &line[0], cut) {
            return false;
        }
    }
    // 现在是「…「{」」的状态：先塞 `"stream":[…]`，再补 rest 去掉它自己的 `{`
    if !buf_append_cstr(out, "\"stream\":[") {
        return false;
    }
    if !dwh_stream_of(line, n, out) {
        return false;
    }
    if !buf_append_cstr(out, "],") {
        return false;
    }
    // `line[cut..]` 是 data 的正文，**不含**它的 `{`（cut 已经越过它）
    return buf_append(out, &line[cut], n - cut);
}

// 由译文的 `"content":[ … ]` **原文**造 chunk 序列。
//
// 为什么抠原文而不是「解析成 JsonValue 再重新序列化」：`std.json` 的视图指向
// 原缓冲、转义没解码，重新序列化要自己处理转义与数字格式（多一处出错的地方）。
// 而块数组的**原文已经是合法 JSON**，直接按顶层逗号切开逐块搬即可。
fn dwh_stream_of(line: &const byte, n: usize, out: &Buf) bool {
    // 找 `"content":[`
    const pat: &const byte = "\"content\"" as &const byte;
    const at: isize = srv_find(line, 0, n, pat, bufx_cstr_len(pat));
    if at < 0 {
        return true;      // 没有块数组：只留 finish
    }
    var i: usize = (at as usize) + bufx_cstr_len(pat);
    while i < n && line[i] != 91 as byte {
        i = i + 1;
    }
    if i >= n {
        return true;
    }
    i = i + 1;                       // `[` 之后
    var idx: usize = 0;
    var first: bool = true;
    var start: usize = i;
    var depth: i32 = 0;
    var instr: bool = false;
    var esc: bool = false;
    while i <= n {
        const at_end: bool = i == n;
        var c: byte = 0;
        if !at_end {
            c = line[i];
        }
        if !at_end && esc {
            esc = false;
        } else if !at_end && c == 92 as byte && instr {
            esc = true;
        } else if !at_end && c == 34 as byte {
            instr = !instr;
        } else if !at_end && !instr {
            if c == 123 as byte || c == 91 as byte {
                depth = depth + 1;
            } else if c == 125 as byte || c == 93 as byte {
                if depth == 0 {
                    // 块数组结束
                    if i > start {
                        if !dwh_one_block(&line[start], i - start, idx, first, out) {
                            return false;
                        }
                        first = false;
                    }
                    break;
                }
                depth = depth - 1;
            } else if c == 44 as byte && depth == 0 {
                if i > start {
                    if !dwh_one_block(&line[start], i - start, idx, first, out) {
                        return false;
                    }
                    first = false;
                    idx = idx + 1;
                }
                start = i + 1;
            }
        }
        i = i + 1;
    }
    // finish（reason=stop）
    if !first && !buf_append_byte(out, 44) {
        return false;
    }
    // 行宽豁免：不可断的 JSON 字面量
    return buf_append_cstr(out, "{\"type\":\"chunk\",\"time\":0,\"chunk\":{\"type\":\"finish\",\"reason\":{\"kind\":\"stop\"}}}");
}

// 一个块 → 两条 chunk（block-start + block-end），`blk` 是块的**原文**。
fn dwh_one_block(blk: &const byte, bn: usize, idx: usize, first: bool,
                 out: &Buf) bool {
    // 块类型：找 `"type":"<x>"`
    const pat: &const byte = "\"type\"" as &const byte;
    var bt: &const byte = "text" as &const byte;
    var btl: usize = 4;
    const at: isize = srv_find(blk, 0, bn, pat, bufx_cstr_len(pat));
    if at >= 0 {
        var k: usize = (at as usize) + bufx_cstr_len(pat);
        while k < bn && blk[k] != 34 as byte {
            k = k + 1;
        }
        if k < bn {
            k = k + 1;
            const s0: usize = k;
            while k < bn && blk[k] != 34 as byte {
                k = k + 1;
            }
            if k > s0 {
                bt = &blk[s0];
                btl = k - s0;
            }
        }
    }
    if !first && !buf_append_byte(out, 44) {
        return false;
    }
    if !buf_append_cstr(out, "{\"type\":\"chunk\",\"time\":0,\"chunk\":") {
        return false;
    }
    if !buf_append_cstr(out, "{\"type\":\"block-start\",\"index\":") {
        return false;
    }
    if !buf_append_u64(out, idx as u64) {
        return false;
    }
    if !buf_append_cstr(out, ",\"blockType\":\"") {
        return false;
    }
    if !buf_append(out, bt, btl) {
        return false;
    }
    if !buf_append_cstr(out, "\"}}") {
        return false;
    }
    // block-end（带整块原样）
    if !buf_append_cstr(out, ",{\"type\":\"chunk\",\"time\":0,\"chunk\":") {
        return false;
    }
    if !buf_append_cstr(out, "{\"type\":\"block-end\",\"index\":") {
        return false;
    }
    if !buf_append_u64(out, idx as u64) {
        return false;
    }
    if !buf_append_cstr(out, ",\"block\":") {
        return false;
    }
    if !buf_append(out, blk, bn) {
        return false;
    }
    return buf_append_cstr(out, "}}");
}


// `--dsh-assets-install` 的实现：装到 `--dsh-assets-dir`（默认
// `<agent_home>/dsh-assets`），成功时把**那个目录**写进 `out`（调用方据此用它当
// 资源根）。失败时把失败那一步的 stderr 原样打出来，然后返回 false。
//
// 三条纪律：① 只写我们自己的目录（不碰已装的 DSH）；② 不静默降级 —— 失败就让
// `--dsh-web` 起不来，而不是留半份资源；③ 文案要指向**那一步**（取件失败最常见
// 的原因是网络与权限，笼统的「安装失败」等于没说）。
fn dwh_install_assets(cfg: &const Config, out: &Buf) bool {
    var dir: Buf = buf_empty();
    defer { buf_free(&dir); }
    if cfg.dsh_assets_dir.len > 0 {
        dir = buf_new(cfg.dsh_assets_dir.len + 8);
        if !buf_append(&dir, cfg.dsh_assets_dir.ptr as &const byte,
            cfg.dsh_assets_dir.len) {
            return false;
        }
    } else {
        // 默认落点：`<agent_home>/dsh-assets`（与 sessions/goal 同级的「本仓自己的东西」）
        var home: Buf = buf_empty();
        defer { buf_free(&home); }
        dwh_assets_home(cfg, &home);
        if home.len == 0 {
            out_err("error: --dsh-assets-install 不知道装到哪：给 --dsh-assets-dir\n");
            return false;
        }
        dir = buf_new(home.len + 16);
        if !buf_append(&dir, home.ptr as &const byte, home.len) {
            return false;
        }
        if !buf_append_cstr(&dir, "/dsh-assets") {
            return false;
        }
    }
    out_err("[dsh-assets] 取件中（npm install ");
    _ = srv_write_all(2, dir.ptr as &const byte, dir.len);
    out_err("）…\n");
    var g: DshGet = DshGet{ ok: false, code: 0, stage: DSHGET_ST_OK,
        out: buf_empty(), err: buf_empty() };
    defer { buf_free(&g.out); buf_free(&g.err); }
    g.out = buf_new(4096);
    g.err = buf_new(4096);
    dshget_install(&g, dir.ptr as &const byte, dir.len);
    if !g.ok {
        dwh_install_report(&g, &dir);
        return false;
    }
    if !buf_append(out, dir.ptr as &const byte, dir.len) {
        return false;
    }
    out_err("[dsh-assets] 装好了：");
    _ = srv_write_all(2, dir.ptr as &const byte, dir.len);
    out_err("\n");
    return true;
}

// 安装失败时的文案：**指向那一步** + 原样带出它的 stderr。
fn dwh_install_report(g: &const DshGet, dir: &const Buf) void {
    out_err("error: 取件失败（");
    if g.stage == DSHGET_ST_NO_TOOL {
        out_err("缺工具");
    } else if g.stage == DSHGET_ST_FETCH {
        out_err("npm 取件：网络 / 权限 / 包名");
    } else if g.stage == DSHGET_ST_LAYOUT {
        out_err("产出布局不对：装是装完了，但没看到 dsh-web-frontend/dist");
    } else {
        out_err("未知");
    }
    out_err("）→ ");
    _ = srv_write_all(2, dir.ptr as &const byte, dir.len);
    out_err("\n");
    if g.err.len > 0 {
        out_err("--- 工具输出 ---\n");
        _ = srv_write_all(2, g.err.ptr as &const byte, g.err.len);
        out_err("\n");
    }
    out_err("（换源用 --dsh-assets-repo，换落点用 --dsh-assets-dir）\n");
}

// 本仓自己的目录（`<agent_home>`）。与 sessions/goal 同源：`cfg.agent_home`
// 非空就用它，否则退回环境变量。
fn dwh_assets_home(cfg: &const Config, out: &Buf) void {
    buf_reset(out);
    if cfg.agent_home.len > 0 {
        _ = buf_append(out, cfg.agent_home.ptr as &const byte, cfg.agent_home.len);
        return;
    }
    const h: &byte = getenv("UYA_AGENT_HOME" as &const byte);
    if (h as usize) != 0 && bufx_cstr_len(h) > 0 {
        _ = buf_append_cstr(out, h);
    }
}


// 一道鉴权闸。返回 false = 已经回过响应（调用方直接收尾）。
//
// ⚠ `qo` 必须是**绝对**下标：`srv_url_split` 给的 `q_off` 是**相对 url 起点**的
// （它的实现里 `i` 从 0 数到 `url_len`），调用方要自己加 `url_off`。这里踩过一次 ——
// 症状是「带对令牌也被判 401」（因为读的是路径那段字节）。
//
// 三态（`dshauth_check`）：URL 带令牌 ⇒ 303 + `Set-Cookie`（浏览器之后靠 cookie）；
// cookie 带令牌 ⇒ 放行；都没有 ⇒ 401。
fn dwh_auth_gate(h: &DwhHost, ci: usize, qo: usize, ql: usize,
                 head_end: usize) bool {
    // 显式夹取：Uya 的边界证明器只认「正的 if 里做索引」（与全仓同款纪律），
    // 调用方已经查过一次，但**证明不透传**，所以这里自己再证一遍。
    if ci >= DWH_MAX_CONNS {
        return false;
    }
    const fd: i32 = h.conns[ci].fd;
    // Cookie 头（可缺）
    var co: usize = 0;
    var cl: usize = 0;
    const has: bool = srv_head_value(h.conns[ci].rx.ptr as &const byte, head_end,
        head_end, "cookie" as &const byte, &co, &cl) && cl > 0;
    var cookie: &const byte = null as &const byte;
    if has {
        cookie = &h.conns[ci].rx.ptr[co];
    }
    // 查询串拷进一个真 `Buf`：直接造 `Buf{ptr: &rx[qo]}` 过不了边界证明
    // （Uya 只认「正的 if 里做索引」那一套），拷一份最省事且没有歧义。
    var q: Buf = buf_new(ql + 1);
    defer { buf_free(&q); }
    if ql > 0 && !buf_append(&q, &h.conns[ci].rx.ptr[qo], ql) {
        return false;
    }
    const verdict: u8 = dshauth_check(&q, cookie, cl,
        h.token.ptr as &const byte, h.token.len);
    if verdict == DSHAUTH_OK {
        return true;
    }
    if verdict == DSHAUTH_NEED {
        // 401：不给任何内容（也不给 `WWW-Authenticate` —— 我们没有 realm 概念）
        _ = srv_send_response(fd, SRV_ST_401, SRV_CT_TEXT,
            "unauthorized\n" as &const byte, 13);
        h.conns[ci].st = DWH_C_DONE;
        return false;
    }
    // GRANT：种 cookie 后回首页（带令牌的 URL 不该留在地址栏里）
    var head: Buf = buf_new(512 + h.token.len);
    defer { buf_free(&head); }
    _ = buf_append_cstr(&head, "HTTP/1.1 303 See Other\r\n");
    _ = buf_append_cstr(&head, "Location: ./\r\n");
    _ = buf_append_cstr(&head, "Cache-Control: no-store\r\n");
    _ = buf_append_cstr(&head, "Set-Cookie: ");
    _ = buf_append_cstr(&head, DSHAUTH_COOKIE_PREFIX);
    _ = buf_append(&head, h.token.ptr as &const byte, h.token.len);
    _ = buf_append_cstr(&head, "=1; Path=/; Max-Age=2592000; HttpOnly; SameSite=Strict\r\n");
    _ = buf_append_cstr(&head, "Content-Length: 0\r\nConnection: close\r\n\r\n");
    _ = srv_write_all(fd, head.ptr as &const byte, head.len);
    h.conns[ci].st = DWH_C_DONE;
    return false;
}
