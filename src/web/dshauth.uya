// src/web/dshauth.uya — `--dsh-web` 的**访问令牌**（P80，工作项⑨）
//
// 本文件：`dshauth_*` —— 令牌的生成（`/dev/urandom` → hex）、请求的判定
//   （URL 里的 `?token=` 或 `Cookie: dsh-auth-<tok>`）、以及两条响应
//   （未带令牌 → 401；带了 URL 令牌 → 303 + `Set-Cookie`）。
// 不变量：① **默认不启用**：只有显式给了 `--dsh-token`（或 `--dsh-web` 绑到
//   非回环地址）才校验 —— 本机 127.0.0.1 跑着看页面是**最常见**的用法，
//   那时候要令牌只会碍事（真 DSH 也是「给别人看才要令牌」这个口径）。
//   ② **令牌只从两处来**（URL 查询串 / Cookie），不从 `Referer`、不从自定义头 ——
//   面越小越好审。
//   ③ **比较是定长的常数时间**：令牌不该因为「第几位不匹配」而泄露前缀信息
//   （定时侧信道在本地服务里不算高危，但这条是**便宜**的 —— 逐字节 XOR 累加，
//   比提前返回还简单）。
// 依赖：libc.syscall/unistd（open/read/close、getpid）、std.crypto.sha1（混熵）、
//   foundation/bufx；本文件不依赖 web/whost（「谁能进」与「进来看什么」是两件事）。
// 命名：`dshauth_*`（对外）+ `DSHAUTH_*`（常量）。

use libc.syscall;
use libc.unistd;
use std.crypto.sha1.sha1_digest;

// Cookie 名（与真 DSH 同形：`dsh-auth-<令牌>`；这样两边的浏览器行为一致，
// 切来切去时不会互相清掉对方的 cookie）。
const DSHAUTH_COOKIE_PREFIX: &const byte = "dsh-auth-" as &const byte;

// 令牌长度（hex 字符数）。24 与真 DSH 的随机段同长。
export const DSHAUTH_TOKEN_LEN: usize = 24;

// 一条请求的鉴权结论。
export const DSHAUTH_OK: u8 = 0;         // 放行（带了正确令牌，或没启用校验）
export const DSHAUTH_NEED: u8 = 1;       // 没带令牌 → 401
export const DSHAUTH_GRANT: u8 = 2;      // URL 里带了令牌 → 303 + Set-Cookie

// 生成令牌：`/dev/urandom` 取 16 字节，混 pid 与时钟再过一遍 sha1，取前 12 字节
// 转 hex（24 字符）。**为什么还要混 pid/时钟**：`/dev/urandom` 读失败时要有个
// 兜底（本仓在容器里跑过读不到的情况），而 pid+时钟虽然弱、也好过「空令牌」——
// 但**只在读失败时**用它，成功的路径仍然是内核熵。
export fn dshauth_make(out: &Buf) bool {
    buf_reset(out);
    var raw: [byte: 16] = [0: 16];
    var got: bool = false;
    var dev: [byte: 13] = "/dev/urandom";
    const fd: i32 = sys_open(&dev[0] as *const byte, 0, 0) catch { -1; };
    if fd >= 0 {
        var off: usize = 0;
        while off < 16 {
            // 行宽豁免：catch 的兜底值不能断行
            const n: isize = sys_read(fd, &raw[off], 16 - off) catch { 0 as isize; };
            if n <= 0 {
                break;
            }
            off = off + (n as usize);
        }
        _ = sys_close(fd) catch {};
        if off == 16 {
            got = true;
        }
    }
    if !got {
        // 兜底：pid + 墙钟（弱，但至少每次不同；读不到 urandom 的环境本来就可疑）
        var seed: [byte: 24] = [0: 24];
        const pid64: i64 = sys_getpid() catch { 0 as i64; };
        const pid: i32 = i64_to_i32(pid64);
        var i: usize = 0;
        while i < 4 {
            const sh: i32 = (i as i32) * 8;
            seed[i] = (((pid >> sh) & 255) as byte);
            i = i + 1;
        }
        var tv: TimeVal = TimeVal{ tv_sec: 0, tv_usec: 0 };
        _ = sys_gettimeofday(&tv, null as &void) catch {};
        var j: usize = 0;
        while j < 8 {
            const sh2: i32 = (j as i32) * 8;
            seed[4 + j] = ((((tv.tv_usec as i64) >> sh2) & 255 as i64) as byte);
            j = j + 1;
        }
        // 剩下的用 pid 轮转填满（只是为了让输入不是全零）
        var k: usize = 12;
        while k < 24 {
            seed[k] = (((pid +% (k as i32)) & 255) as byte);
            k = k + 1;
        }
        var d24: [byte: 20] = [0: 20];
        sha1_digest(seed[0: 24], d24[0: 20]);
        return dshauth_hex(&d24[0], 12, out);
    }
    var d: [byte: 20] = [0: 20];
    sha1_digest(raw[0: 16], d[0: 20]);
    return dshauth_hex(&d[0], 12, out);
}

// 前 n 字节转小写 hex（n<=16 ⇒ 输出 <= 32 字符）。
fn dshauth_hex(p: &const byte, n: usize, out: &Buf) bool {
    const hex: &[byte] = &"0123456789abcdef"[0: 16];
    var i: usize = 0;
    while i < n {
        const b: byte = p[i];
        if !buf_append_byte(out, hex[((b as i32) >> 4) as usize]) {
            return false;
        }
        if !buf_append_byte(out, hex[((b as i32) & 15) as usize]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 定长常数时间比较（长度不同直接 false —— 长度本身不是秘密）。
export fn dshauth_eq(a: &const byte, an: usize, b: &const byte,
                     bn: usize) bool {
    if an != bn || an == 0 {
        return false;
    }
    var diff: byte = 0;
    var i: usize = 0;
    while i < an {
        diff = (diff | (a[i] ^ b[i])) as byte;
        i = i + 1;
    }
    return diff == 0 as byte;
}

// 判定一条请求。`q` 是**查询串**（不含 `?`）、`cookie` 是 `Cookie:` 头的值
// （可为 null）；`tok` 是期望的令牌。
//
// 三态（见 `DSHAUTH_*`）：URL 里带了正确令牌 ⇒ `GRANT`（回 303 + Set-Cookie，
// 让浏览器之后靠 cookie）；只带了正确 cookie ⇒ `OK`；都没有 ⇒ `NEED`。
export fn dshauth_check(q: &const Buf, cookie: &const byte, cn: usize,
    tok: &const byte, tn: usize) u8 {
    if tn == 0 {
        return DSHAUTH_OK;      // 没配令牌 = 不校验（见文件头不变量①）
    }
    // ① URL 查询串里的 `token=<期待值>`（就这一种参数名，与真 DSH 同）
    if dshauth_q_has(q, tok, tn) {
        return DSHAUTH_GRANT;
    }
    // ② `Cookie: dsh-auth-<期待值>`（可能夹在多个 cookie 之间）
    if cn > 0 && cookie != null {
        if dshauth_cookie_has(cookie, cn, tok, tn) {
            return DSHAUTH_OK;
        }
    }
    return DSHAUTH_NEED;
}

// 查询串里有 `token=<tok>` 吗（按 `&` 分段，逐段比 `token=` 前缀）。
fn dshauth_q_has(q: &const Buf, tok: &const byte, tn: usize) bool {
    const key: &const byte = "token=" as &const byte;
    const kl: usize = 6;
    var seg: usize = 0;
    while seg <= q.len {
        var e: usize = seg;
        while e < q.len && q.ptr[e] != 38 as byte {
            e = e + 1;
        }
        const sl: usize = e - seg;
        if sl == kl + tn && bufx_mem_eq(&q.ptr[seg], key, kl) {
            if dshauth_eq(&q.ptr[seg + kl], tn, tok, tn) {
                return true;
            }
        }
        if e >= q.len {
            break;
        }
        seg = e + 1;
    }
    return false;
}

// Cookie 头里有 `dsh-auth-<tok>` 吗（按 `; ` 分段，容忍多余空白）。
fn dshauth_cookie_has(c: &const byte, cn: usize, tok: &const byte,
    tn: usize) bool {
    const pl: usize = 9;        // "dsh-auth-" 的长度
    var seg: usize = 0;
    while seg <= cn {
        // 跳过段首空白
        var s: usize = seg;
        while s < cn && (c[s] == 32 as byte || c[s] == 9 as byte) {
            s = s + 1;
        }
        var e: usize = s;
        while e < cn && c[e] != 59 as byte {
            e = e + 1;
        }
        // 一段 cookie 是 `name=value`（真 DSH 是 `dsh-auth-<tok>=v1.<base64>`），
        // 所以判据是「**以** `dsh-auth-<tok>` 开头且紧跟 `=`」—— 不是「整段等于它」。
        // 少了这个 `=` 的判断会把 `dsh-auth-<tok>EXTRA` 也放进来（那是错的：
        // 令牌不同的 cookie 不该被当成同一个）。
        const sl: usize = e - s;
        if sl >= pl + tn + 1 {
            if bufx_mem_eq(&c[s], DSHAUTH_COOKIE_PREFIX, pl) {
                if dshauth_eq(&c[s + pl], tn, tok, tn) {
                    if c[s + pl + tn] == 61 as byte {
                        return true;
                    }
                }
            }
        }
        if e >= cn {
            break;
        }
        seg = e + 1;
    }
    return false;
}
