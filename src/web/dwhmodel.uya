// src/web/dwhmodel.uya — `--dsh-web` 的模型目录：DSH 的 `settings.yaml` → 选择器
//
// 本文件：把 `session/modelx.uya` 摊平好的模型目录（`McTable`）装成 DSH 的
//   `session/modelCatalog` 形状（`dwhm_catalog_json`）、当前选择的读写
//   （`dwhm_select` / `dwhm_current_json` / `dwhm_projection_json`）。
// 不变量：① **不发明模型、不发明档位** —— 目录里的每一条都来自本机的
//   `settings.yaml`（`mx_load` 的解析规则与 `/model` 浮层、`--print-config`
//   **同源**）；档位只列该模型自己公布的（`mx_has_level`），非推理模型整行不画
//   （与 `mx_levels_into` 同一条口径）。
//   ② **`default` 必须出现在 `groups` 里**：客户端的 `routable` 判据是
//   `groups.some(g => g.id === provider && g.models.some(m => m.id === model))`
//   （读 `dsh-client-ui-model-selection` 的 `syncInputs`）—— 给一个目录里没有的
//   default，选择器就是「当前模型不在列表里」的灰态，而**没有任何报错**。
//   ③ **选择要落两处**：执行核（子进程的 `/model` `/effort`，那是真正生效的地方，
//   也会在会话日志里落一条 `session/model`）+ 投影 `modelSelection`（浏览器里的
//   当前值）。只落一处就是「界面变了、请求没变」或反过来的假象。
//   ④ 本文件不许认识 `Config` / `g_sess`（与 `whost.uya` 同一条纪律：宿主侧只做
//   JSON 与形状）。目录装好后按值返回，调用方（宿主）自己留着。
// 依赖：无 `use` 行（合并命名空间）；本仓 foundation/bufx、foundation/jsonx
//   （`jw_str_into`）、session/modelx（`mx_*`）、session/session（`jw_str_into`）。
// 命名：`dwhm_*`（目录与选择）、`DWHM_*`（常量）；类型 `DwhModel`。

// 目录一条 provider 最多几张表（一张表 = 一个 provider 的模型清单）：
// 真机 `settings.yaml` 的 provider 数是十几个量级，与 `MX_MAX`（256 条模型）同量级。
const DWHM_MAX_PROV: usize = 64;

// 一次选择的三个字段（provider / model / effort）的上限：DSH 的 id 长度没有上限，
// 这里给一个显式边界（与 `MX_PKG_MAX` 那类同口径），超了就**拒绝选择**而不是截断。
const DWHM_FIELD_MAX: usize = 256;

// 模型目录表（按值持有，宿主放进自己的状态里）。
export struct DwhModel {
    table: McTable,         // `mx_load` 装出来的目录（本文件拥有它，`dwhm_free` 释放）
    loaded: bool,           // 装过没有（幂等：`dwhm_load` 只真读一次盘）
    ok: bool,               // 装成功了吗（false = 读不到 settings.yaml）
    prov: Buf,              // 当前 provider
    model: Buf,             // 当前 model
    effort: Buf,            // 当前推理档位（空 = 没声明）
    // 用户显式选过没有。没选过时 `default` 取目录里第一条（与 DSH 的
    // 「部署默认模型」同一个位置），选过之后就以用户那条为准（一次会话内）。
    picked: bool,
}

// 零值。
export fn dwhm_zero() DwhModel {
    return DwhModel{
        table: McTable{ items: [], n: 0, loaded: false, wins: [], nwin: 0,
            nwin_bad: 0 },
        loaded: false,
        ok: false,
        prov: buf_empty(),
        model: buf_empty(),
        effort: buf_empty(),
        picked: false,
    };
}

// 装目录（幂等）。`dsh_home` 是 DSH 的设置根（`--dsh-home` / `$DSH_HOME` / `~/.dsh`）。
//
// 为什么用 `--dsh-web` 的**宿主**去读它而不是问子进程：选择器是宿主侧画的（`/api`
// 的 unary），而子进程那边只有「当前用的那一个」。目录是**只读元信息**，两边各读
// 一份会漂移（子进程读到的 provider 列表可能因为环境不同而不同）。
export fn dwhm_load(m: &DwhModel, dsh_home: &const Buf) bool {
    if m.loaded {
        return m.ok;
    }
    m.loaded = true;
    mx_init(&m.table);
    var hz: Buf = buf_new(dsh_home.len + 1);
    defer { buf_free(&hz); }
    if !buf_append(&hz, dsh_home.ptr as &const byte, dsh_home.len) {
        return false;
    }
    // `mx_load` 的路径参数是 C 串（它自己接 "/settings.yaml"）：尾 NUL 不能省，
    // 否则拼出来的路径带着一截旧字节（`agent_models_ensure` 记过同一条）。
    if !buf_append_byte(&hz, 0) {
        return false;
    }
    m.ok = mx_load(hz.ptr as &const byte, &m.table);
    dwhm_default_pick(m);
    return m.ok;
}

// 没被显式选过时，把「当前」定成目录里的第一条（= DSH 的部署默认模型的位置；
// 目录空时留空，`dwhm_catalog_json` 会如实说「一个都没有」）。
fn dwhm_default_pick(m: &DwhModel) void {
    if m.picked || mx_count(&m.table) == 0 {
        return;
    }
    const e: &const McEntry = mx_entry_at(&m.table, 0);
    buf_reset(&m.prov);
    buf_reset(&m.model);
    buf_reset(&m.effort);
    _ = buf_append(&m.prov, e.provider.ptr as &const byte, e.provider.len);
    _ = buf_append(&m.model, e.model.ptr as &const byte, e.model.len);
    const lv: i32 = mx_default_level(e);
    if lv >= 0 {
        _ = buf_append_cstr(&m.effort, mx_level_name(lv as usize));
    }
}

// 目录里有没有这个 (provider, model)。`mx_find` 的命中口径与 `/model` 同源。
export fn dwhm_has(m: &const DwhModel, provider: &const byte, pn: usize,
    model: &const byte, mn: usize) bool {
    return mx_find(&m.table, provider, pn, model, mn) >= 0;
}

// 一次选择（宿主已经从 `session/selectModel` 的入参里取好了三个字段）。
// 返回：0 = 换了；1 = 本来就是它（幂等）；2 = 参数不对（空 / 太长 / 目录里没有）。
//
// 只改本结构（**不动子进程**）：真让执行核切模型是宿主的事（它要往子进程 stdin
// 写 `/model` 与 `/effort` 两行，见不变量③）—— 这样本文件是纯数据，
// 自测不必 fork 任何东西。
export fn dwhm_select(m: &DwhModel, provider: &const byte, pn: usize,
    model: &const byte, mn: usize, effort: &const byte, en: usize) i32 {
    if pn == 0 || mn == 0 || pn > DWHM_FIELD_MAX || mn > DWHM_FIELD_MAX ||
        en > DWHM_FIELD_MAX {
        return 2;
    }
    if !dwhm_has(m, provider, pn, model, mn) {
        return 2;
    }
    // 档位要给就 givens 得是**这个模型公布的**：DSH 的 resolveReasoningLevel 宁可报错
    // 也不 clamp（`agent_model_apply` 记过同一条），所以这里先判再用。
    if en > 0 && !dwhm_level_ok(m, provider, pn, model, mn, effort, en) {
        return 2;
    }
    const same: bool = m.prov.len == pn && m.model.len == mn
        && m.effort.len == en
        && bufx_mem_eq(m.prov.ptr as &const byte, provider, pn)
        && bufx_mem_eq(m.model.ptr as &const byte, model, mn)
        && (en == 0 || bufx_mem_eq(m.effort.ptr as &const byte, effort, en));
    if same {
        m.picked = true;
        return 1;
    }
    buf_reset(&m.prov);
    buf_reset(&m.model);
    buf_reset(&m.effort);
    _ = buf_append(&m.prov, provider, pn);
    _ = buf_append(&m.model, model, mn);
    if en > 0 {
        _ = buf_append(&m.effort, effort, en);
    }
    m.picked = true;
    return 0;
}

// `effort` 是这个模型公布的档位吗（`mx_level_index` 认 `none` == `off`，同 `/effort`）。
fn dwhm_level_ok(m: &const DwhModel, provider: &const byte, pn: usize,
    model: &const byte, mn: usize, effort: &const byte, en: usize) bool {
    const i: i32 = mx_find(&m.table, provider, pn, model, mn);
    if i < 0 {
        return false;
    }
    const e: &const McEntry = mx_entry_at(&m.table, i as usize);
    const lv: i32 = mx_level_index(effort, en);
    if lv < 0 {
        return false;
    }
    return mx_has_level(e, lv as usize);
}

// `session/modelCatalog` 的值。形状逐字段照 DSH 的 zod（`ModelCatalog`）：
//   {default:{provider,model,reasoningEffort?}, routableProviders:[…],
//    groups:[{id,name,models:[{id,name,reasoning?:{efforts:[{id,name}],
//    defaultEffort?}}]}], failures:[]}
//
// `groups` 的**每一条**都来自目录；同名模型跨 provider 时是**两条**（分组不同，
// 客户端的 `routable` 判据是 (provider,model) 二元组，见不变量②）。
export fn dwhm_catalog_json(m: &const DwhModel, out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "{\"default\":") {
        return false;
    }
    if !dwhm_current_json(m, out) {
        return false;
    }
    if !buf_append_cstr(out, ",\"routableProviders\":[") {
        return false;
    }
    if !dwhm_providers_json(m, out) {
        return false;
    }
    if !buf_append_cstr(out, "],\"groups\":[") {
        return false;
    }
    if !dwhm_groups_json(m, out) {
        return false;
    }
    // `failures`：目录读不到时说清楚（客户端会把它渲染成一条可见的失败原因，
    // 而不是让选择器空着 —— 「空着」是「这个部署没有模型」，与「读不到设置」不同）。
    if !buf_append_cstr(out, "],\"failures\":[") {
        return false;
    }
    if !m.ok {
        if !dwhm_failure_json(out) {
            return false;
        }
    }
    return buf_append_cstr(out, "]}");
}

// 读不到设置时说给用户听的那一句（客户端会照原样显示在模型菜单里）。
// 拆成两段：一整条中文常量写一行会超 80 字符（AGENTS.md 的行宽指标）。
const DWHM_NS_A: &const byte = "读不到 DSH 的 settings.yaml" as &const byte;
// 第二段单独一条：拼起来是完整的一句话（拆两条只为守住 80 字符的行宽指标）。
const DWHM_NS_A2: &const byte = "（--dsh-home / $DSH_HOME）" as &const byte;
const DWHM_NS_B: &const byte = "：本部署没有可选的模型" as &const byte;

// 一条 `failures[]` 项（`{id,name,message}`）—— `session/modelCatalog` 与
// `session/models` 两处的失败原因**共用这一份**（两处口径分叉过一次：
// 同一个「读不到设置」在两代面板里说成两句不同的话）。
fn dwhm_failure_json(out: &Buf) bool {
    // 行宽豁免：不可断的 JSON 字面量
    if !buf_append_cstr(out, "{\"id\":\"uya-agent\",\"name\":\"uya-agent\",\"message\":") {
        return false;
    }
    if !jw_str_into(out, DWHM_NS_A, bufx_cstr_len(DWHM_NS_A)) {
        return false;
    }
    if !buf_append_cstr(out, DWHM_NS_A2) {
        return false;
    }
    if !buf_append_cstr(out, DWHM_NS_B) {
        return false;
    }
    return buf_append_byte(out, 125);
}

// 当前选择：`{provider,model,reasoningEffort?}`（空目录时给空串字段 —— 形状不能少，
// 客户端对 `default` 是 `.provider` / `.model` 直取）。
export fn dwhm_current_json(m: &const DwhModel, out: &Buf) bool {
    if !buf_append_cstr(out, "{\"provider\":") {
        return false;
    }
    if !jw_str_into(out, m.prov.ptr as &const byte, m.prov.len) {
        return false;
    }
    if !buf_append_cstr(out, ",\"model\":") {
        return false;
    }
    if !jw_str_into(out, m.model.ptr as &const byte, m.model.len) {
        return false;
    }
    if m.effort.len > 0 {
        if !buf_append_cstr(out, ",\"reasoningEffort\":") {
            return false;
        }
        if !jw_str_into(out, m.effort.ptr as &const byte, m.effort.len) {
            return false;
        }
    }
    return buf_append_byte(out, 125);
}

// `routableProviders`：目录里出现过的 provider（**去重**，首次出现的顺序）。
// 客户端用它画「哪些提供方可路由」，重复项会让同一个 provider 出现两次。
fn dwhm_providers_json(m: &const DwhModel, out: &Buf) bool {
    var first: bool = true;
    var i: usize = 0;
    const n: usize = mx_count(&m.table);
    while i < n {
        const e: &const McEntry = mx_entry_at(&m.table, i);
        if !dwhm_prov_seen(m, e, i) {
            if !first {
                if !buf_append_cstr(out, ",") {
                    return false;
                }
            }
            if !jw_str_into(out, e.provider.ptr as &const byte, e.provider.len) {
                return false;
            }
            first = false;
        }
        i = i + 1;
    }
    return true;
}

// `e` 的 provider 在**第 `i` 条之前**出现过吗（= 这一条不是该 provider 的第一条）。
//
// ⚠ 判据必须是「**往前**扫有没有同名 provider」，**不能**拿 `mx_find(provider,model)`
// 的首次位置比 —— 那问的是「这个**模型**的首次位置」，而同一个 provider 的
// 第 2、3 个模型各自有自己的首次位置（就是它们自己）⇒ 每个模型都被当成「新
// provider」。实测症状：`routableProviders` 变成 `["alpha","alpha","beta","beta"]`、
// `groups` 变成 4 组（同一个 provider 画两遍，选择器里一堆重复项）。
fn dwhm_prov_seen(m: &const DwhModel, e: &const McEntry, i: usize) bool {
    var k: usize = 0;
    while k < i {
        const pe: &const McEntry = mx_entry_at(&m.table, k);
        if pe.provider.len == e.provider.len
            && bufx_mem_eq(pe.provider.ptr as &const byte,
                e.provider.ptr as &const byte, e.provider.len) {
            return true;
        }
        k = k + 1;
    }
    return false;
}

// `groups`：一个 provider 一组（组内是该 provider 的模型清单，按目录序）。
// **一行一条** `{id,name,models:[…]}`，provider 之间用逗号分隔。
fn dwhm_groups_json(m: &const DwhModel, out: &Buf) bool {
    var first: bool = true;
    var i: usize = 0;
    const n: usize = mx_count(&m.table);
    while i < n {
        const e: &const McEntry = mx_entry_at(&m.table, i);
        if dwhm_prov_seen(m, e, i) {
            i = i + 1;
            continue;
        }
        if !first {
            if !buf_append_cstr(out, ",") {
                return false;
            }
        }
        first = false;
        if !buf_append_cstr(out, "{\"id\":") {
            return false;
        }
        if !jw_str_into(out, e.provider.ptr as &const byte, e.provider.len) {
            return false;
        }
        if !buf_append_cstr(out, ",\"name\":") {
            return false;
        }
        if !jw_str_into(out, e.provider.ptr as &const byte, e.provider.len) {
            return false;
        }
        if !buf_append_cstr(out, ",\"models\":[") {
            return false;
        }
        if !dwhm_group_models(m, e.provider.ptr as &const byte, e.provider.len,
            out) {
            return false;
        }
        if !buf_append_cstr(out, "]}") {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 一个 provider 的模型清单（同 provider 的条目按目录序连排；跨 provider 时
// 由 `dwhm_groups_json` 分开成两组 —— 所以这里的判据是「provider 相等」而不是下标区间）。
fn dwhm_group_models(m: &const DwhModel, prov: &const byte, pn: usize,
    out: &Buf) bool {
    var first: bool = true;
    var i: usize = 0;
    const n: usize = mx_count(&m.table);
    while i < n {
        const e: &const McEntry = mx_entry_at(&m.table, i);
        if e.provider.len == pn && bufx_mem_eq(e.provider.ptr as &const byte,
            prov, pn) {
            if !first {
                if !buf_append_cstr(out, ",") {
                    return false;
                }
            }
            first = false;
            if !dwhm_one_model(e, out) {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

// 一个模型：`{id,name,reasoning?:{efforts:[{id,name}],defaultEffort?}}`。
//
// `reasoning` **只在模型公布了档位时才写**（非推理模型整块省掉 —— 与
// `mx_levels_into` 同一条口径：显示一个做不到事的控件比不显示更坏）。
fn dwhm_one_model(e: &const McEntry, out: &Buf) bool {
    if !buf_append_cstr(out, "{\"id\":") {
        return false;
    }
    if !jw_str_into(out, e.model.ptr as &const byte, e.model.len) {
        return false;
    }
    if !buf_append_cstr(out, ",\"name\":") {
        return false;
    }
    // 展示名：目录里给了 `name` 就用它，没给就用 id（DSH 的缺省口径）。
    if e.name.len > 0 {
        if !jw_str_into(out, e.name.ptr as &const byte, e.name.len) {
            return false;
        }
    } else {
        if !jw_str_into(out, e.model.ptr as &const byte, e.model.len) {
            return false;
        }
    }
    if !e.reasoning {
        return buf_append_byte(out, 125);
    }
    if !buf_append_cstr(out, ",\"reasoning\":{\"efforts\":[") {
        return false;
    }
    if !dwhm_efforts_json(e, out) {
        return false;
    }
    if !buf_append_cstr(out, "]") {
        return false;
    }
    const lv: i32 = mx_default_level(e);
    if lv >= 0 {
        if !buf_append_cstr(out, ",\"defaultEffort\":") {
            return false;
        }
        const nm: &const byte = mx_level_name(lv as usize);
        if !jw_str_into(out, nm, bufx_cstr_len(nm)) {
            return false;
        }
    }
    return buf_append_cstr(out, "}}");
}

// 档位清单：**只有该模型公布的**（`mx_has_level`），顺序取全仓那套展示序
// （`mx_level_name` 的 0..6 = off/minimal/low/medium/high/xhigh/max）。
fn dwhm_efforts_json(e: &const McEntry, out: &Buf) bool {
    var first: bool = true;
    var i: usize = 0;
    while i < MX_LEVELS {
        if mx_has_level(e, i) {
            if !first {
                if !buf_append_cstr(out, ",") {
                    return false;
                }
            }
            first = false;
            const nm: &const byte = mx_level_name(i);
            if !buf_append_cstr(out, "{\"id\":") {
                return false;
            }
            if !jw_str_into(out, nm, bufx_cstr_len(nm)) {
                return false;
            }
            if !buf_append_cstr(out, ",\"name\":") {
                return false;
            }
            if !jw_str_into(out, nm, bufx_cstr_len(nm)) {
                return false;
            }
            if !buf_append_byte(out, 125) {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

// `session/selectModel` 的**结果**：`{selected:{provider,model,reasoningEffort?}}`
// —— 与读回当前值同形（客户端把 `value.selected` 直接当成新的 current）。
export fn dwhm_selected_json(m: &const DwhModel, out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "{\"selected\":") {
        return false;
    }
    return dwhm_current_json(m, out) && buf_append_byte(out, 125);
}

// 投影 `modelSelection` 的值：`{lastUsed:{…},next:null}`。
//
// 客户端 `syncInputs` 读 `projected.next ?? catalog.default`（读
// `dsh-client-ui-model-selection`）—— `next` 是「下一次要用的」，本仓的选择**当场
// 生效**，所以恒给 `null`，把当前值放在 `lastUsed`（投影的语义就是「最近用过的」）。
export fn dwhm_projection_json(m: &const DwhModel, out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "{\"lastUsed\":") {
        return false;
    }
    if !dwhm_current_json(m, out) {
        return false;
    }
    return buf_append_cstr(out, ",\"next\":null}");
}

// `session/models`（0.1.1 的门面）：`{current,routable,groups,failures}`。
// `current` 与 `groups` / `failures` 全部复用 catalog 那一套组装函数 ——
// 两个面板读同一个目录，答案必须**逐字节同源**（否则「新旧界面显示的模型不同」）。
// `routable` 是「当前这一对在 groups 里吗」，与客户端的判据同一条
// （`dsh-client-ui-model-selection` 的 `syncInputs`）。
export fn dwhm_models_json(m: &const DwhModel, out: &Buf) bool {
    buf_reset(out);
    // ⚠ `dwhm_current_json` **先 reset 出参**（它产出的是「一个值」）—— 把前缀写进
    // 同一个缓冲会被那一下 reset 抹掉（实测：`session/control` 的 baseline 变成
    // `…"type":"baseline",{…`，非法 JSON ⇒ 客户端整条控制流不折）。
    // 所以先渲染成独立一份再拼。
    var cur: Buf = buf_new(256);
    defer { buf_free(&cur); }
    if !dwhm_current_json(m, &cur) {
        return false;
    }
    if !buf_append_cstr(out, "{\"current\":") {
        return false;
    }
    if !buf_append(out, cur.ptr as &const byte, cur.len) {
        return false;
    }
    if !buf_append_cstr(out, ",\"routable\":") {
        return false;
    }
    const rt: bool = dwhm_has(m, m.prov.ptr as &const byte, m.prov.len,
        m.model.ptr as &const byte, m.model.len);
    // 不用 `if` 表达式挑字面量：codegen 会生成一个 `int32_t __uya_ifexpr_N`
    // 把**指针塞进 int**（宿主 C 报 `makes integer from pointer`）—— 同 `whost.uya`
    // 的 `dwh_host_event` 记过的那条。
    const rtj: &const byte = if rt {
        "true" as &const byte
    } else {
        "false" as &const byte
    };
    if !buf_append_cstr(out, rtj) {
        return false;
    }
    if !buf_append_cstr(out, ",\"groups\":[") {
        return false;
    }
    if !dwhm_groups_json(m, out) {
        return false;
    }
    if !buf_append_cstr(out, "],\"failures\":[") {
        return false;
    }
    if !m.ok {
        if !dwhm_failure_json(out) {
            return false;
        }
    }
    return buf_append_cstr(out, "]}");
}

// 释放目录（宿主收尾时调）。
export fn dwhm_free(m: &DwhModel) void {
    if m.loaded {
        mx_free(&m.table);
    }
    m.loaded = false;
    buf_free(&m.prov);
    buf_free(&m.model);
    buf_free(&m.effort);
}
