// src/web/webui.uya — web 页面的 HTML/CSS/JS（全内嵌，**零外部依赖**）
//
// 本文件：`web_index_html`（单页装配）、以及它的三段：样式（`web_css_into`）、
//   结构（`web_body_into`）、脚本（`web_js_into`）。
// 不变量：① **整份 HTML 里没有任何外链** —— 没有 `<script src="http…">`、
//   没有 `//cdn`、没有外部字体/图标/CSS。判据是自测 `web-page` 轮直接扫
//   `http://` / `https://` / `//` 三种形态（零外部依赖那条承诺的机器实现）；
//   ② 页面只做三件事：**画网格、发按键、报尺寸** —— 终端解释在服务端
//   （见 ttyemu.uya 的文件头：同源判据 + 零外部依赖两条理由），所以这里没有
//   一行 ANSI 解析；③ 网格用**等宽字体 + 定宽格子**画：每个格子一个 `<span>`
//   会让 100×30 的屏产生 3000 个节点/帧（每帧重建就是灾难），所以按「**样式相同
//   的连续区段**」合并成一个 `<span>`（服务端已经算好段表，段落数通常 < 10）；
//   ④ 光标是一个绝对定位的方块，**不**占字符位（否则整行会错位一格）。
// 依赖：无 `use` 行（合并命名空间）；本仓 foundation/bufx（Buf / buf_append*）。
// 命名：`web_*_into`（把各段追加进 Buf）。
//
// 为什么服务端只发「变化的行 + 段表」而不是整屏文本：一帧整屏（100×30）约 3 KB，
// 而 `poll(≤50ms)` 下大多数帧只变十几行；段表还让前端不必自己 diff 样式。

// ============================================================
// 单页装配
// ============================================================

// 把整份页面追加进 out。**顺序**：`<!doctype>` → head（含内嵌 CSS）→
// body（顶栏 + 终端区）→ 内嵌 JS。任何一段都不引用外部资源。
// 把整份页面追加进 out。**顺序**：`<!doctype>` → head（含内嵌 CSS）→
// body（顶栏 + 终端区）→ 内嵌 JS。任何一段都不引用外部资源。
export fn web_index_html(out: &Buf) void {
    _ = buf_append_cstr(out, `<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>uya-agent</title>
<style>
`);
    web_css_into(out);
    _ = buf_append_cstr(out, `</style>
</head>
<body>
`);
    web_body_into(out);
    _ = buf_append_cstr(out, `<script>
`);
    web_js_into(out);
    _ = buf_append_cstr(out, `</script>
</body>
</html>
`);
}

// ============================================================
// 样式
// ============================================================

// 内嵌 CSS。配色跟 TUI 的 16 色表对齐（`TUI_SGR16`）：0–7 标准八色、8–15 亮色。
// **不引外部字体**：用通用等宽名让浏览器在本地挑（零外部依赖的要求之一）。
// 用反引号原始串写：CSS 里的 `\n`、引号、`//` 都不必再逐处转义。
// 行宽豁免：CSS 是**压成一行一条规则**的（不换行才不会引入意外的空白语义），
// 拆行反而会让「这条规则到哪儿结束」变得难以核对。JS 段同理（见下面的注）。
//
// ⚠ **`.rv` 必须排在 `.c0–.c15` / `.b0–.b15` 之后**：反显要盖掉那些颜色类，而它们
// 与 `.rv` 同权重（都只一个类）—— 同权重下**后写的赢**。挪到前面去，选中行就会
// 带着前景色，看着还是没高亮（这条依赖没法用自测钉，只能在这里写明）。
// 为什么不用 `filter:invert(1)`（老写法）：`filter` 只反色**元素自己画出来的像素**，
// 而高亮块的背景是透明的 —— 暗底没被画上去，反色后就是「暗字 + 暗底」，等于不可见
// （实测：`.rv` 的 rect 里 15180 个像素只有 52 个与背景不同，0 个接近反色后的底色）。
// 反显（SGR 7）在终端里就是「亮底暗字」，这里照那个语义写。
fn web_css_into(out: &Buf) void {
    _ = buf_append_cstr(out, `:root{--bg:#1b1b1f;--fg:#e6e6e6;--dim:#8a8a8a;--bar:#26262c;--line:#3a3a42;--accent:#5f9ee6}
*{box-sizing:border-box}
html,body{margin:0;padding:0;height:100%;background:var(--bg);color:var(--fg)}
body{display:flex;flex-direction:column;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,"DejaVu Sans Mono",monospace;font-size:13px;line-height:1.35}
#bar{display:flex;align-items:stretch;background:var(--bar);border-bottom:1px solid var(--line);min-height:34px;flex:0 0 auto}
#tabs{display:flex;overflow-x:auto;flex:1 1 auto}
.tab{display:flex;align-items:center;gap:6px;padding:0 10px;max-width:240px;border-right:1px solid var(--line);cursor:pointer;white-space:nowrap;color:var(--dim)}
.tab:hover{background:#2e2e35}
.tab.on{background:var(--bg);color:var(--fg);box-shadow:inset 0 -2px 0 var(--accent)}
.tab.dead{opacity:.55;text-decoration:line-through}
.tab .t{overflow:hidden;text-overflow:ellipsis}
.tab .x{color:var(--dim);padding:0 3px;border-radius:3px}
.tab .x:hover{background:#4a4a55;color:#fff}
#add{flex:0 0 auto;width:40px;border:none;background:transparent;color:var(--fg);font-size:18px;cursor:pointer;border-left:1px solid var(--line)}
#add:hover{background:#2e2e35}
#add:disabled{opacity:.4;cursor:default}
#term{flex:1 1 auto;position:relative;overflow:hidden;padding:6px 8px}
#grid{position:absolute;left:8px;top:6px}
.row{white-space:pre;height:1.35em}
#cur{position:absolute;background:#cfcfd6;opacity:.75;pointer-events:none}
#empty{position:absolute;left:12px;top:10px;color:var(--dim)}
#imgs{position:absolute;left:0;top:0;pointer-events:none}
#imgs img{position:absolute;box-shadow:0 0 0 1px var(--line)}
.c0{color:#5c5c66}.c1{color:#e06c75}.c2{color:#98c379}.c3{color:#e5c07b}
.c4{color:#61afef}.c5{color:#c678dd}.c6{color:#56b6c2}.c7{color:#d7dae0}
.c8{color:#7f848e}.c9{color:#ff7b86}.c10{color:#b5e08c}.c11{color:#ffd68a}
.c12{color:#8cc8ff}.c13{color:#e0a0f0}.c14{color:#7fd6e0}.c15{color:#ffffff}
.b0{background-color:#5c5c66}.b1{background-color:#8b3a40}
.b2{background-color:#4d6b3c}.b3{background-color:#7a6540}
.b4{background-color:#33608c}.b5{background-color:#6b4278}
.b6{background-color:#2f646c}.b7{background-color:#7a7d85}
.b8{background-color:#3f4249}.b9{background-color:#a3454c}
.b10{background-color:#5f8a49}.b11{background-color:#9a7f4c}
.b12{background-color:#3f77ad}.b13{background-color:#855295}
.b14{background-color:#3b7d86}.b15{background-color:#9a9da6}
.bo{font-weight:700}.di{opacity:.75}.it{font-style:italic}
.un{text-decoration:underline}.st{text-decoration:line-through}
.seg{display:inline-block;overflow:visible;text-align:left}
.rv{background:var(--fg);color:var(--bg)}
`);
}

// ============================================================
// 结构
// ============================================================

// 顶栏（标签 + 右端 `+`）与终端区（网格 + 光标 + 图片层）。
// 行宽豁免：标签结构照 HTML 的**语义行**写（一个元素一行），拆得更碎反而不好核对。
fn web_body_into(out: &Buf) void {
    _ = buf_append_cstr(out, `<div id="bar"><div id="tabs"></div><button id="add" title="新建会话">+</button></div>
<div id="term"><div id="grid"></div><div id="imgs"></div><div id="cur"></div><div id="empty">连接中…</div></div>
`);
}

// ============================================================
// 脚本
// ============================================================
//
// 用**反引号原始串**写 JS：反引号里的 `\` 与换行都按原样保留（实测 `"\n"`
// 两个字节就是反斜杠 + n，正合 JS 源码要的形态）—— 用普通字符串字面量的话，
// 每一个 `\n` 都要写成 `\\n`，而 JS 里到处是转义（`'\r'`、`'\u001b[Z'`），
// 抄错一个就是「按了键没反应」这种最难查的静默错。
// 每个函数把**一段** JS 追加进 out，切点按「职责」而不是按行数。

// 全局元素引用与状态。放在最前面，后面的段都用它们。
fn js_globals(out: &Buf) void {
    _ = buf_append_cstr(out, `var TABS=document.getElementById('tabs');
var ADD=document.getElementById('add');
var GRID=document.getElementById('grid');
var IMGS=document.getElementById('imgs');
var CUR=document.getElementById('cur');
var EMPTY=document.getElementById('empty');
var TERM=document.getElementById('term');
var sessions=[],cur=null,es=null,cols=100,rows=30;
// cell.w / cell.h = 一个格子的宽高；cell.cw = **一个宽字符（CJK）的进宽**（量出来的，
// 见 measure()）—— drawRow 靠它给宽字符段补 letter-spacing。
var cell={w:7.8,h:17.5,cw:15.6};
`);
}

// 按键 → 终端字节。**这是与 `src/term/tui/keys.uya` 的反向表**：xterm 协议里
// 方向键/功能键都是 ESC 序列，服务端那侧的 TUI 只认那些序列（发 `keydown.key`
// 的 `"ArrowUp"` 它一个字都不认识）。
fn js_keys(out: &Buf) void {
    _ = buf_append_cstr(out, `function keyBytes(e){
 if(e.ctrlKey&&!e.altKey&&e.key.length===1){
  var c=e.key.toLowerCase().charCodeAt(0);
  if(c>=97&&c<=122)return String.fromCharCode(c-96);
  if(e.key===' ')return '\u0000';
  if(e.key==='[')return '\u001b';
  if(e.key==='\\')return '\u001c';
  if(e.key===']')return '\u001d';
  if(e.key==='^')return '\u001e';
  if(e.key==='_')return '\u001f';
  return '';
 }
 if(e.altKey&&e.key.length===1)return '\u001b'+e.key;
 switch(e.key){
  case 'Enter':return '\r';
  case 'Backspace':return '\u007f';
  case 'Tab':return e.shiftKey?'\u001b[Z':'\t';
  case 'Escape':return '\u001b';
  case 'Delete':return '\u001b[3~';
  case 'ArrowUp':return '\u001b[A';
  case 'ArrowDown':return '\u001b[B';
  case 'ArrowRight':return '\u001b[C';
  case 'ArrowLeft':return '\u001b[D';
  case 'Home':return '\u001b[H';
  case 'End':return '\u001b[F';
  case 'PageUp':return '\u001b[5~';
  case 'PageDown':return '\u001b[6~';
  case 'Insert':return '\u001b[2~';
  case 'F1':return '\u001bOP';
  case 'F2':return '\u001bOQ';
  case 'F3':return '\u001bOR';
  case 'F4':return '\u001bOS';
  case 'F5':return '\u001b[15~';
  case 'F6':return '\u001b[17~';
  case 'F7':return '\u001b[18~';
  case 'F8':return '\u001b[19~';
  case 'F9':return '\u001b[20~';
  case 'F10':return '\u001b[21~';
  case 'F11':return '\u001b[23~';
  case 'F12':return '\u001b[24~';
 }
 if(e.key.length===1)return e.key;
 return '';
}
`);
}

// 顶栏：把 `sessions` 画成标签，右端 `+` 由 HTML 里那个按钮负责。
// `runtime` 是 data 属性里带的自定义 class（这里不用，留个口子给主题）。
fn js_tabs(out: &Buf) void {
    _ = buf_append_cstr(out, `function drawTabs(){
 var html='';
 for(var i=0;i<sessions.length;i++){
  var s=sessions[i];
  var t=s.title&&s.title.length?s.title:('会话 '+(i+1));
  var cls='tab'+(s.id===cur?' on':'')+(s.alive?'':' dead');
  html+='<div class="'+cls+'" data-id="'+esc(s.id)+'">'
      +'<span class="t">'+esc(t)+'</span>'
      +'<span class="x" data-close="'+esc(s.id)+'">x</span></div>';
 }
 TABS.innerHTML=html;
 var on=TABS.querySelector('.tab.on');
 if(on&&on.scrollIntoView)on.scrollIntoView({block:'nearest',inline:'nearest'});
}
function esc(s){
 return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;')
  .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
TABS.addEventListener('click',function(e){
 var x=e.target.getAttribute&&e.target.getAttribute('data-close');
 if(x){e.stopPropagation();
  fetch('/api/close?id='+encodeURIComponent(x),{method:'POST'})
   .then(function(){if(cur===x)cur=null;refresh();});
  return;}
 var el=e.target;
 while(el&&el!==TABS&&!el.getAttribute('data-id'))el=el.parentNode;
 if(!el||el===TABS)return;
 var id=el.getAttribute('data-id');
 if(id&&id!==cur){cur=id;drawTabs();subscribe();}
});
`);
}

// 尺寸：量一个真实格子的宽高（等宽字体下所有格子一样宽），再折算成格子数。
// 顺手量一次**宽字符**（CJK）的进宽存进 `cell.cw` —— `drawRow` 要靠它算宽字符段的
// `letter-spacing`（本地字体给 CJK 的字宽与 ASCII 格宽不一定是严格的 2:1）。
// 量法与被量字符都是现成的：那个隐藏节点在白底黑字下不可见，量完就摘掉。
fn js_measure(out: &Buf) void {
    _ = buf_append_cstr(out, `function measure(){
 var p=document.createElement('span');
 p.className='row';p.textContent='MMMMMMMMMM';
 p.style.position='absolute';p.style.visibility='hidden';
 GRID.appendChild(p);
 var r=p.getBoundingClientRect();
 p.textContent='中中中中中';
 var r2=p.getBoundingClientRect();
 GRID.removeChild(p);
 if(r.width>0)cell.w=r.width/10;
 if(r.height>0)cell.h=r.height;
 if(r2.width>0)cell.cw=r2.width/5;
 var w=TERM.clientWidth-16,h=TERM.clientHeight-12;
 if(cell.w>0)cols=Math.max(20,Math.floor(w/cell.w));
 if(cell.h>0)rows=Math.max(5,Math.floor(h/cell.h));
 return {cols:cols,rows:rows};
}
`);
}

// 画一行：服务端给的是「样式相同的连续区段」表，一段一个 span（而不是一格一个
// span —— 100 列的屏每帧 3000 个节点会让滚动卡死）。
fn js_render(out: &Buf) void {
    _ = buf_append_cstr(out, `function cls(fg,fgv,bg,bgv,attr){
 var c='';
 if(fg>=0){var f=(fg===1)?rgbClass(fgv):'c'+(fgv&15);c+=' '+f;}
 if(bg>=0){var b=(bg===1)?rgbBg(bgv):'b'+(bgv&15);c+=' '+b;}
 if(attr&1)c+=' bo';
 if(attr&2)c+=' di';
 if(attr&4)c+=' it';
 if(attr&8)c+=' un';
 if(attr&16)c+=' rv';
 if(attr&32)c+=' st';
 return c;
}
function rgbClass(v){
 var r=(v>>16)&255,g=(v>>8)&255,b=v&255;
 var key=r+','+g+','+b;
 if(!rgbClass.cache)rgbClass.cache={};
 if(!rgbClass.cache[key]){
  var n='rgb'+(Object.keys(rgbClass.cache).length%64);
  rgbClass.cache[key]=n;
  if(!document.getElementById('sty-'+n)){
   var st=document.createElement('style');
   st.id='sty-'+n;
   st.textContent='.'+n+'{color:rgb('+key+')}';
   document.head.appendChild(st);
  }
 }
 return rgbClass.cache[key];
}
function rgbBg(v){
 var r=(v>>16)&255,g=(v>>8)&255,b=v&255;
 var key=r+','+g+','+b;
 if(!rgbBg.cache)rgbBg.cache={};
 if(!rgbBg.cache[key]){
  var n='rbg'+(Object.keys(rgbBg.cache).length%64);
  rgbBg.cache[key]=n;
  if(!document.getElementById('sty-'+n)){
   var st=document.createElement('style');
   st.id='sty-'+n;
   st.textContent='.'+n+'{background-color:rgb('+key+')}';
   document.head.appendChild(st);
  }
 }
 return rgbBg.cache[key];
}
// 画一行。段表是 8 元组 [起始码元, 长度码元, 显示列数, attr, fgMode, fgVal,
// bgMode, bgVal]（见 ttyemu.uya 的「JSON 输出」一节）。
//
// ⚠ 前两个数是**码元**下标（String.prototype.slice 的单位，也就是 UTF-16：
// 一个 emoji 算 2），第三个是**显示列数** —— 只用来排版，**绝不拿去切片**。
// 老版把「显示列」当切片下标用：宽字符那几行于是样式贴到错字上、右边框逐行参差
// （§16 踩坑 112）。
//
// 段上钉**显式宽度**（列数 × 格宽）：这样每个段自己就占满它该占的列，右边框必然
// 逐行对齐（含宽字符的行也一样 —— 浏览器给 CJK 的字宽与 ASCII 格宽不等宽，不钉
// 就是每行差几像素）。只给**含宽字符的段**补字距（判据是「列数 ≠ 码元数」）：
// CJK 进宽与格宽之比在本地字体上不一定是 2:1，补上差额让一个汉字正好占 2 列。
// 窄段不能补 —— 补了会把窄字撑开。
function drawRow(y,text,segs){
 var row=GRID.children[y];
 if(!row){
  row=document.createElement('div');
  row.className='row';GRID.appendChild(row);
 }
 var html='',at=0,i;
 for(i=0;i<segs.length;i++){
  var s=segs[i];
  if(s[0]>at)html+=esc(text.slice(at,s[0]));
  var st='width:'+(s[2]*cell.w)+'px';
  if(s[2]!==s[1])st+=';letter-spacing:'+(2*cell.w-cell.cw)+'px';
  html+='<span class="seg'+cls(s[4],s[5],s[6],s[7],s[3])+'" style="'+st+'">'
      +esc(text.slice(s[0],s[0]+s[1]))+'</span>';
  at=s[0]+s[1];
 }
 if(at<text.length)html+=esc(text.slice(at));
 row.innerHTML=html;
}
`);
}

// 帧处理：服务端一帧一行 NDJSON，这里按行切、逐行解（`\n` 在 JSON 字符串里
// 是转义过的，所以「按行切」是安全的）。
fn js_frames(out: &Buf) void {
    _ = buf_append_cstr(out, `function applyFrame(f){
 if(f.session!==cur)return;
 if(f.full){GRID.innerHTML='';IMGS.innerHTML='';}
 for(var i=0;i<f.rows_changed.length;i++){
  var r=f.rows_changed[i];
  drawRow(r[0],r[1],r[2]);
 }
 drawImages(f.images);
 var c=f.cursor;
 if(c){
  CUR.style.display=c[2]?'block':'none';
  CUR.style.left=(8+c[1]*cell.w)+'px';
  CUR.style.top=(6+c[0]*cell.h)+'px';
  CUR.style.width=cell.w+'px';
  CUR.style.height=cell.h+'px';
 }
 EMPTY.style.display='none';
}
function drawImages(list){
 IMGS.innerHTML='';
 if(!list)return;
 for(var i=0;i<list.length;i++){
  var a=list[i];
  var im=document.createElement('img');
  im.src='/api/image?id='+encodeURIComponent(a[2]);
  im.style.left=(8+a[1]*cell.w)+'px';
  im.style.top=(6+a[0]*cell.h)+'px';
  IMGS.appendChild(im);
 }
}
`);
}

// 订阅 `/api/screen`：手写 NDJSON 流读取（**不用 EventSource** —— 它只支持
// `text/event-stream` 且不能 POST）。
// 行宽豁免：JS 里的 URL 拼接与正则不可断（拆行会改变字符串内容）。
fn js_subscribe(out: &Buf) void {
    _ = buf_append_cstr(out, `function subscribe(){
 if(es&&es.abort)try{es.abort();}catch(e){}
 GRID.innerHTML='';IMGS.innerHTML='';
 if(!cur){EMPTY.style.display='block';EMPTY.textContent='没有会话（点右上角的 + 新建）';return;}
 EMPTY.style.display='block';EMPTY.textContent='连接中…';
 var ac=new AbortController();es=ac;
 var m=measure();
 fetch('/api/resize?id='+encodeURIComponent(cur)+'&cols='+m.cols+'&rows='+m.rows,
  {method:'POST'}).catch(function(){});
 fetch('/api/screen?id='+encodeURIComponent(cur),{signal:ac.signal})
  .then(function(res){
   if(!res.ok)throw new Error('http '+res.status);
   var rd=res.body.getReader(),dec=new TextDecoder(),buf='';
   function pump(){
    return rd.read().then(function(r){
     if(r.done)return;
     buf+=dec.decode(r.value,{stream:true});
     var at;
     while((at=buf.indexOf('\n'))>=0){
      var line=buf.slice(0,at);buf=buf.slice(at+1);
      if(!line)continue;
      try{applyFrame(JSON.parse(line));}catch(e){}
     }
     return pump();
    });
   }
   return pump();
  })
  .catch(function(e){
   if(ac.signal.aborted)return;
   EMPTY.style.display='block';
   EMPTY.textContent='连接断开（'+(e&&e.message?e.message:'')+'）—— 点标签重连';
  });
}
`);
}

// 会话列表 + 启动 + 自适应尺寸。
fn js_boot(out: &Buf) void {
    _ = buf_append_cstr(out, `function refresh(){
 fetch('/api/sessions').then(function(r){return r.json();})
  .then(function(j){
   sessions=(j&&j.sessions)||[];
   var has=false;
   for(var i=0;i<sessions.length;i++)if(sessions[i].id===cur)has=true;
   if(!has)cur=sessions.length?sessions[sessions.length-1].id:null;
   drawTabs();
   if(cur&&(!es||es.signal.aborted))subscribe();
  }).catch(function(){});
}
document.addEventListener('keydown',function(e){
 if(e.metaKey)return;
 var b=keyBytes(e);
 if(!b)return;
 e.preventDefault();
 if(!cur)return;
 fetch('/api/input?id='+encodeURIComponent(cur),
  {method:'POST',body:b}).catch(function(){});
});
ADD.addEventListener('click',function(){
 ADD.disabled=true;
 fetch('/api/sessions',{method:'POST'})
  .then(function(r){return r.json();})
  .then(function(j){ADD.disabled=false;
   if(j&&j.id){cur=j.id;refresh();}})
  .catch(function(){ADD.disabled=false;});
});
var rt=null;
window.addEventListener('resize',function(){
 if(rt)clearTimeout(rt);
 rt=setTimeout(function(){
  if(!cur)return;
  var m=measure();
  fetch('/api/resize?id='+encodeURIComponent(cur)
   +'&cols='+m.cols+'&rows='+m.rows,{method:'POST'}).catch(function(){});
 },150);
});
refresh();
setInterval(function(){
 var m=measure();
 if(m.cols!==cols||m.rows!==rows){cols=m.cols;rows=m.rows;}
},1000);
`);
}

// 把上述所有段拼起来（`web_index_html` 调它）。
fn web_js_into(out: &Buf) void {
    js_globals(out);
    js_keys(out);
    js_tabs(out);
    js_measure(out);
    js_render(out);
    js_frames(out);
    js_subscribe(out);
    js_boot(out);
}
