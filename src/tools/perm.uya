// src/tools/perm.uya — 访问模式（P21，对齐 DSH permission-presets）
//
// 本文件：三级模式的常量（`PERM_READ_ONLY`/`PERM_WORKSPACE_WRITE`/`PERM_FULL_ACCESS`）与
//   进程级状态 `g_perm`，加上取名的 `perm_name`/`perm_label`/`perm_gloss`/`perm_notice`、
//   解析与读写的 `perm_from_name`/`perm_set`/`perm_get`/`perm_sync_from_cfg`，
//   以及三个判定 `perm_confine`/`perm_allows_write`/`perm_requires_approval`。
// 不变量：① 三级**机器名与 DSH 逐字一致**（`read-only` / `workspace-write` /
//   `danger-full-access`），这样 DSH 设置文件里的 `permission.defaultPreset` 能直接喂进来；
//   ② 模式是**进程级运行期状态**，**不进**会话日志的恢复语义（`--resume` 按当前进程重新
//   求值运行时上下文）；切换只记一条审计事件 `permission/mode`（写点在 agent.uya）；
//   ③ 内置默认是 `PERM_FULL_ACCESS`（= 全权、不沙箱）；④ 认不出的输入一律走
//   `perm_from_name` 返回 -1 / `perm_known` 返回 false，由调用方**保持内置默认、不猜**
//   （`perm_set` 不做校验，`perm_sync_from_cfg` 才校验）。
// 依赖：foundation/bufx（`bufx_eq_cstr` 做机器名比较）；本仓 session/dshcfg 会调
//   `perm_from_name` 解析 `permission.defaultPreset`。
// 命名：对外 `perm_*`（判定 + 取名 + 读写）+ `PERM_*` 常量；本文件没有私有辅助。
//
// 三级（机器名与 DSH 逐字一致，这样 DSH 设置文件里的 permission.defaultPreset
// 可以直接喂进来）：
//   read-only          Read Only        写工具被拒；bash 逐条要用户批准，并套只读沙箱
//   workspace-write    Workspace Write  只写工作区内（工具层守卫 + bwrap 沙箱）
//   danger-full-access Full access      不限制、不沙箱（DSH 的产品名就是 "Full access"）
//
// 语义来自 DSH 的实测表（dsh-base/cordis.patch.yml:193-205）：
//   read-only=(sandbox read-only, approval ask) / workspace-write=(workspace-write, ask)
//   / danger-full-access=(danger-full-access, never)
// 本项目没有内核沙箱之外的审批升级链，所以「approval ask」落地成 read-only 下
// bash 的逐条人工批准（见 askuser.uya 的 ask_approve_command）。
//
// 模式是**进程级**的运行期状态：不进会话日志的恢复语义（--resume 按当前进程的模式
// 重新求值运行时上下文），切一次记一条 permission/mode 审计事件。

export const PERM_READ_ONLY: u8 = 0;
export const PERM_WORKSPACE_WRITE: u8 = 1;
export const PERM_FULL_ACCESS: u8 = 2;

// 内置默认：全权（= 今天 confine=false 的行为，§7.1 的「默认对齐 danger-full-access」）
var g_perm: u8 = PERM_FULL_ACCESS;

// m 是不是三个已知模式之一（认不得就 false，调用方据此保持内置默认、不猜）
export fn perm_known(m: u8) bool {
    return m == PERM_READ_ONLY || m == PERM_WORKSPACE_WRITE || m == PERM_FULL_ACCESS;
}

// 机器名（与 DSH 的 preset key 一致，命令行/设置文件用这个）
export fn perm_name(m: u8) &const byte {
    if m == PERM_READ_ONLY {
        return "read-only" as &const byte;
    }
    if m == PERM_WORKSPACE_WRITE {
        return "workspace-write" as &const byte;
    }
    return "danger-full-access" as &const byte;
}

// 显示名（DSH 的 client 侧变换：kebab → Title Case，danger-full-access 特判成产品名）
export fn perm_label(m: u8) &const byte {
    if m == PERM_READ_ONLY {
        return "Read Only" as &const byte;
    }
    if m == PERM_WORKSPACE_WRITE {
        return "Workspace Write" as &const byte;
    }
    return "Full access" as &const byte;
}

// 浮层条目里的一行短说明（终端没有 tooltip，只能写在行里）
export fn perm_gloss(m: u8) &const byte {
    if m == PERM_READ_ONLY {
        return "写工具被拒；bash 逐条向你确认（内核只读沙箱）" as &const byte;
    }
    if m == PERM_WORKSPACE_WRITE {
        return "只写工作区内（沙箱 + 工具层守卫）" as &const byte;
    }
    return "不限制、不沙箱（对齐 DSH danger-full-access）" as &const byte;
}

// 切换后落进转录的那一行
export fn perm_notice(m: u8) &const byte {
    if m == PERM_READ_ONLY {
        return "访问模式 → Read Only：write/edit 被拒，bash 逐条批准且只读沙箱" as &const byte;
    }
    if m == PERM_WORKSPACE_WRITE {
        return "访问模式 → Workspace Write：只写工作区内（沙箱 + 工具层守卫）" as &const byte;
    }
    return "访问模式 → Full access：不限制、不沙箱" as &const byte;
}

// 机器名 → 模式；-1 = 不认识
export fn perm_from_name(p: &const byte, n: usize) i32 {
    if n == 0 {
        return -1;
    }
    if bufx_eq_cstr(p, n, "read-only" as &const byte) {
        return PERM_READ_ONLY as i32;
    }
    if bufx_eq_cstr(p, n, "workspace-write" as &const byte) {
        return PERM_WORKSPACE_WRITE as i32;
    }
    if bufx_eq_cstr(p, n, "danger-full-access" as &const byte) {
        return PERM_FULL_ACCESS as i32;
    }
    return -1;
}

// 直接写进程级模式（**不做校验**；带校验的场景用 perm_sync_from_cfg）
export fn perm_set(m: u8) void {
    g_perm = m;
}

// 读进程级模式（唯一真相源就是 g_perm）
export fn perm_get() u8 {
    return g_perm;
}

// 从配置同步进程级模式（启动、会话切换、子代理各调一次；无副作用）
export fn perm_sync_from_cfg(a: u8) void {
    if perm_known(a) {
        g_perm = a;
    }
}

// 工作区路径守卫是否生效：非全权即守卫（保持 P6 的既有口径）
export fn perm_confine() bool {
    return g_perm != PERM_FULL_ACCESS;
}

// 写工具（write / edit）是否被允许 —— read-only 下硬拒
export fn perm_allows_write() bool {
    return g_perm != PERM_READ_ONLY;
}

// bash 是否要逐条人工批准 —— 对齐 DSH 里 read-only 的 approval=ask
export fn perm_requires_approval() bool {
    return g_perm == PERM_READ_ONLY;
}
