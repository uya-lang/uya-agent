// src/tools/askuser.uya — ask_user_question / 终端问答（P8，P43 加弹窗）
//
// 本文件：四通道问答（`ask_tool_question` + 通道回落 `ask_tui_line`/`ask_read_line`）与
//   通用「批准动作」浮层（`ask_approve_action`/`ask_approve_command`）、底层的
//   `ask_write`/`ask_read_yes_no`，以及每题答案的**唯一一份**拼装（四个通道共用）。
// 不变量：① 提问**故意不 fail closed**（与 bash 批准 / plan 审阅相反）：审批是「看不见就
//   不许做」，提问只是「换个地方问」，浮窗放不下时回落到输入行永远比丢掉渠道好；真正的
//   「没人能答」（管道 / CI / 子代理读不到）才回 `no answer channel`；②「人不答」
//   （esc/取消）与「没人能答」文案**必须分开**，模型才能决定自己拿主意还是请用户换模式；
//   ③ 批准三通道：TUI 浮层 → 滚动模式真 TTY → fail closed（返回 2）；**子代理一律 2**
//   （`ask_approve_action` 的返回码：1=批准 / 0=拒绝 / 2=没有渠道）；④ 批准浮层的光标默认落
//   「拒绝」，且开浮层前**清掉排队按键** —— 运行期间敲进来的按键绝不会把命令「答应」掉；
//   ⑤ 一题的答案拼装四个通道**共用一份**，措辞/转义不许写两遍；单选若写了自定义回答则
//   **覆盖** selected，多选则两者都带；⑥ 非 TUI 通道只有一行文本，按编号反解
//   （`1`-`9` 选中该下标，其余当自定义回答）；TUI 按下标回查 label，不反解文本；
//   ⑦ stdin 的 EINTR（被 SIGWINCH 之类打断）**不是 EOF**，必须重来一次。
// 依赖：libc.syscall/unistd、foundation/bufx、foundation/jsonx（`jw_str_into` 拼答案 JSON）；
//   本仓 term/tui（浮层 `tui_ask_wait`）与 term/tty（滚动模式的读写行）。
// 命名：对外 `ask_*`（`ask_write`/`ask_read_yes_no`/`ask_approve_action`/`ask_approve_command`/
//   `ask_tool_question`）；私有同样 `ask_*` 前缀（非 export）。
//
// 四条通道，按优先级（P43 起 TUI 里是**弹窗**，不再把问题当 notice 落转录、让用户去输入行盲打）：
//   1) TUI 且浮层放得下 → 提问弹窗（tui_ask_wait：↑/↓ 选、1-9 直选、space 多选、
//      直接打字 = 自己回答、enter 提交、esc 取消）；
//   2) TUI 但终端太矮（画不出浮层）→ 回落输入行（ask_tui_line）；
//   3) 滚动模式真 TTY → ask_write + ask_read_line（P8 的老路）；
//   4) 管道 / CI / 子代理 → 读一行，读不到就回「没有回答渠道」（DSH 的 dismissed 语义）。
//
// 提问**故意不 fail closed**（与 bash 批准 / plan 审阅相反）：审批是「看不见就不许做」，
// 提问只是「换个地方问」，浮窗放不下时回落到输入行永远比丢掉渠道好。真正的「没人能答」
// （管道 / 子代理）才回 no answer channel；「人不答」回的是另一句 dismissed 文案 ——
// 模型要能分开这两件事，才能决定是自己拿主意还是请用户换模式。

use libc.syscall;
use libc.unistd;

// 往 stderr 写一段 C 字符串（“问一个问题”最底层的一步，永远返回 true —— 提问没有失败语义）
export fn ask_write(p: &const byte) bool {
    tty_stream_write(2, p as &const byte, bufx_cstr_len(p));
    return true;
}

// 读一行（回车结束）。返回 1=拿到一行 0=EOF
fn ask_read_line(out: &Buf) i32 {
    buf_reset(out);
    if tty_is_interactive() {
        tty_line_clear(&tty_ui);
        tty_set_prompt(&tty_ui, "");
        tty_draw_line(&tty_ui, 2);
        while true {
            const ev: i32 = tty_next_event(&tty_ui);
            if ev == TTY_EV_SUBMIT {
                _ = buf_append(out, tty_ui.line.ptr, tty_ui.line.len);
                tty_line_clear(&tty_ui);
                tty_puts(&tty_ui, 2, "\n");
                return 1;
            }
            if ev == TTY_EV_EOF {
                tty_line_clear(&tty_ui);
                return 0;
            }
            if tty_has_pending(&tty_ui) {
                tty_feed(&tty_ui, null as &const byte, 0);
                tty_flush_esc(&tty_ui);
                continue;
            }
            var tmp: [byte: 128] = [0: 128];
            // P1：EINTR（被 SIGWINCH 之类的处理器打断）不是 EOF，重来一次
            const rr: !isize = sys_read(0, &tmp[0], 128);
            var eid: i32 = 0;
            const n: isize = rr catch |err| {
                eid = (@error_id(err) as! i32).value;
                -1 as isize;
            };
            if n < 0 && eid == 4 {
                continue;
            }
            if n <= 0 {
                return 0;
            }
            tty_feed(&tty_ui, &tmp[0], n as usize);
            tty_flush_esc(&tty_ui);
            tty_draw_line(&tty_ui, 2);
        }
    }
    var tmp2: [byte: 256] = [0: 256];
    while true {
        const n: isize = sys_read(0, &tmp2[0], 256) catch { -1 as isize; };
        if n <= 0 {
            return 0;
        }
        const un: usize = n as usize;
        var i: usize = 0;
        while i < un {
            if tmp2[i] == 10 as byte {
                tty_stream_write(2, "\n" as &const byte, 1);
                return 1;
            }
            _ = buf_append_byte(out, tmp2[i]);
            i = i + 1;
        }
    }
}

// ============================================================
// P30：TUI 模式下的问答 —— 提问落进转录，答案用输入行
//
// 以前这条路走 `ask_read_line`（terminal 行编辑器直接读 fd 0）：在 TUI 里那等于和界面
// **抢键盘** —— 提示写在 fd 2 上被 sink 吞进转录条目、光标被界面每帧搬走、用户看不到
// 「> 」也看不到自己敲的字，只能干等（现场：模型一问 ask_user_question 就像卡死）。
// 现在改成：把提问与选项当 notice 落进转录，答案用输入行的下一次回车。
// esc = 不回答（沿用 DSH 的 dismissed 语义），不会顺带把回合打断。
// 返回 1 = 拿到一行；0 = 没回答（esc / 退出 / 超时）
fn ask_tui_line(prompt: &const byte, pn: usize, out: &Buf) i32 {
    var i: usize = 0;
    var start: usize = 0;
    while i <= pn {
        if i == pn || prompt[i] == 10 as byte {
            if i > start {
                tui_add_notice(prompt + start, i - start);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    const hint: &const byte = "（在输入行回答后回车；esc 表示不回答）" as &const byte;
    tui_add_notice(hint, bufx_cstr_len(hint));
    tui_mark_dirty();
    var line: Buf = buf_new(4096);
    defer { buf_free(&line); }
    var guard: i32 = 0;
    while guard < 6000 {          // 最多约 5 分钟
        _ = tui_poll_keys(50);
        _ = tui_tick(tui_now_ms());
        if tui_take_submit(&line) {
            buf_reset(out);
            _ = buf_append(out, line.ptr, line.len);
            return 1;
        }
        if tui_interrupt_take() {
            return 0;             // esc：不回答（回合继续，模型自己决定怎么办）
        }
        if tui_quit_wanted() {
            return 0;
        }
        guard = guard + 1;
    }
    return 0;
}

// y/N；返回 1=是 0=否 2=无输入渠道
export fn ask_read_yes_no() i32 {
    var line: Buf = buf_new(64);
    defer { buf_free(&line); }
    const got: i32 = ask_read_line(&line);
    if got == 0 {
        return 2;
    }
    if line.len == 0 {
        return 0;
    }
    const c: byte = line.ptr[0];
    if c == 121 as byte || c == 89 as byte {
        return 1;
    }
    if line.len >= 3 && bufx_mem_eq(line.ptr as &const byte, "yes", 3) {
        return 1;
    }
    return 0;
}

// ============================================================
// P21：bash 逐条批准（read-only 模式的 approval=ask 落点）
//
// 返回 1 = 批准执行，0 = 拒绝（含 esc / 中断），2 = 没有回答渠道（fail closed）。
// 三条通道：
//   1) TUI 浮层：光标默认落在「拒绝」上，且开浮层前清掉排队按键 —— 运行期间敲进来的
//      按键绝不会把一条命令「答应」掉（最坏情况是拒绝）；
//   2) 滚动模式的真 TTY（且不是子代理）：走既有的 ask_read_yes_no()；
//   3) 其余（管道/CI、子代理、浮层画不出来）：返回 2，由 bash 工具回 fail-closed 文案。
// ============================================================
// P34：把这条通道泛化成「批准某个动作」——bash 命令（read-only）与切换工作区
// （非全权）共用同一套浮层 / 真 TTY 问答 / fail-closed 口径，只有标题与措辞不同。
export fn ask_approve_action(cfg: &const Config, kind: &const byte, body: &const byte, bn: usize) i32 {
    var clean: Buf = buf_new(bn + 16);
    defer { buf_free(&clean); }
    tui_clean_into(&clean, body, bn);
    if !buf_append_byte(&clean, 0) {
        return 2;
    }
    const is_ws: bool = bufx_eq_cstr(kind, bufx_cstr_len(kind), "workspace" as &const byte);
    var title: &const byte = "Read Only：批准这条 bash 命令？" as &const byte;
    var items: &const byte = "批准并执行\n拒绝\n" as &const byte;
    var lead: &const byte = "\n[read-only] bash 需要你逐条批准：\n  " as &const byte;
    var ask: &const byte = "\n执行？（y = 批准 / n = 拒绝）[y/N] " as &const byte;
    var yes: &const byte = "批准并执行" as &const byte;
    if is_ws {
        title = "非全权：批准切换工作区？" as &const byte;
        items = "批准并切换\n拒绝\n" as &const byte;
        lead = "\n[非全权] 切换工作区会把路径守卫与沙箱的可写根一起搬过去，需要你逐次批准：\n  " as &const byte;
        ask = "\n切过去？（y = 批准 / n = 拒绝）[y/N] " as &const byte;
        yes = "批准并切换" as &const byte;
    }
    if tui_active() && tui_overlay_available() {
        var pick: Buf = buf_new(64);
        defer { buf_free(&pick); }
        const rc: i32 = tui_confirm_wait(TUI_OVK_APPROVE, title, bufx_cstr_len(title),
            clean.ptr as &const byte, clean.len - 1, items, bufx_cstr_len(items), 1, &pick);
        if rc == 1 && bufx_eq_cstr(pick.ptr as &const byte, pick.len, yes) {
            return 1;
        }
        return 0;
    }
    if cfg.is_subagent || !tty_is_interactive() {
        return 2;
    }
    _ = ask_write(lead);
    _ = ask_write(clean.ptr as &const byte);
    _ = ask_write(ask);
    const ans: i32 = ask_read_yes_no();
    if ans == 2 {
        return 2;
    }
    if ans == 1 {
        return 1;
    }
    return 0;
}

// P21：bash 逐条批准（read-only 模式的 approval=ask 落点）
//
// 返回 1 = 批准执行，0 = 拒绝（含 esc / 中断），2 = 没有回答渠道（fail closed）。
// 三条通道：
//   1) TUI 浮层：光标默认落在「拒绝」上，且开浮层前清掉排队按键 —— 运行期间敲进来的
//      按键绝不会把一条命令「答应」掉（最坏情况是拒绝）；
//   2) 滚动模式的真 TTY（且不是子代理）：走既有的 ask_read_yes_no()；
//   3) 其余（管道/CI、子代理、浮层画不出来）：返回 2，由 bash 工具回 fail-closed 文案。
// ============================================================
export fn ask_approve_command(cfg: &const Config, cmd: &const byte, cn: usize) i32 {
    return ask_approve_action(cfg, "bash" as &const byte, cmd, cn);
}

// 一题的答案 → 一段 answers JSON 项（**四条通道共用这一份拼装**，措辞/转义不许写两遍）。
// labels 是选中的选项 label（'\n' 分隔，可为空）；custom 是自由回答（可为空）。
fn ask_emit_answer(out: &Buf, id: &const Buf, labels: &const Buf, custom: &const Buf) void {
    _ = buf_append_cstr(out, "{\"id\":");
    _ = jw_str_into(out, id.ptr as &const byte, id.len);
    _ = buf_append_cstr(out, ",\"selected\":[");
    var start: usize = 0;
    var i: usize = 0;
    var first: bool = true;
    while i <= labels.len {
        if i == labels.len || labels.ptr[i] == 10 as byte {
            if i > start {
                if !first {
                    _ = buf_append_cstr(out, ",");
                }
                _ = jw_str_into(out, labels.ptr + start, i - start);
                first = false;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if custom.len > 0 {
        _ = buf_append_cstr(out, "],\"custom\":");
        _ = jw_str_into(out, custom.ptr as &const byte, custom.len);
        _ = buf_append_cstr(out, "}");
    } else {
        _ = buf_append_cstr(out, "]}");
    }
}

// 选项下标 → label 文本（追加进 labels；带 '\n'）
fn ask_label_into(labels: &Buf, opts: &const JsonValue, idx: usize) void {
    var o: JsonValue = JsonValue.json_null();
    if !js_arr_get(opts, idx, &o) {
        return;
    }
    var label: Buf = buf_empty();
    defer { buf_free(&label); }
    if !js_obj_get_str_unescaped(&o, "label", 5, &label) {
        return;
    }
    if label.len == 0 {
        return;
    }
    _ = buf_append(labels, label.ptr, label.len);
    _ = buf_append_byte(labels, 10);
}

// 某个 JsonValue 是不是 true（`multi_select`；fsx 的 json_bool_of 是私有的，这份是本模块口径）
fn ask_json_bool(v: &const JsonValue) bool {
    const val: JsonValue = v[0];
    match val {
        .bool_val(x) => {
            return x;
        },
        else => {
            return false;
        },
    }
}

// ask_user_question 工具
export fn ask_tool_question(args: &const JsonValue, out: &Buf) void {
    var qs: JsonValue = JsonValue.json_null();
    if !js_obj_get(args, "questions", 9, &qs) || js_arr_len(&qs) == 0 {
        _ = buf_append_cstr(out, "Error: questions must be a non-empty array");
        return;
    }
    _ = buf_append_cstr(out, "{\"answers\":[");
    const n: usize = js_arr_len(&qs);
    var i: usize = 0;
    while i < n {
        var q: JsonValue = JsonValue.json_null();
        if !js_arr_get(&qs, i, &q) {
            i = i + 1;
            continue;
        }
        var id: Buf = buf_empty();
        defer { buf_free(&id); }
        var qtext: Buf = buf_empty();
        defer { buf_free(&qtext); }
        _ = js_obj_get_str_unescaped(&q, "id", 2, &id);
        _ = js_obj_get_str_unescaped(&q, "question", 8, &qtext);
        var header: Buf = buf_empty();
        defer { buf_free(&header); }
        _ = js_obj_get_str_unescaped(&q, "header", 6, &header);
        var multi: bool = false;
        var mb: JsonValue = JsonValue.json_null();
        if js_obj_get(&q, "multi_select", 12, &mb) {
            multi = ask_json_bool(&mb);
        }
        if i > 0 {
            _ = buf_append_cstr(out, ",");
        }
        // ---- 选项：items（弹窗用）+ prompt（旧两条通道用；两者同一份编号口径）----
        var opts: JsonValue = JsonValue.json_null();
        var nopt: usize = 0;
        if js_obj_get(&q, "options", 7, &opts) {
            nopt = js_arr_len(&opts);
        }
        var items: Buf = buf_new(4096);
        defer { buf_free(&items); }
        var prompt: Buf = buf_new(4096);
        defer { buf_free(&prompt); }
        if qtext.len > 0 {
            _ = buf_append(&prompt, qtext.ptr, qtext.len);
            _ = buf_append_byte(&prompt, 10);
        }
        var k: usize = 0;
        while k < nopt {
            var o: JsonValue = JsonValue.json_null();
            if js_arr_get(&opts, k, &o) {
                var label: Buf = buf_empty();
                defer { buf_free(&label); }
                var desc: Buf = buf_empty();
                defer { buf_free(&desc); }
                _ = js_obj_get_str_unescaped(&o, "label", 5, &label);
                _ = js_obj_get_str_unescaped(&o, "description", 11, &desc);
                if label.len > 0 {
                    _ = buf_append(&items, label.ptr, label.len);
                    if desc.len > 0 {
                        _ = buf_append_cstr(&items, " — ");
                        _ = buf_append(&items, desc.ptr, desc.len);
                    }
                    _ = buf_append_byte(&items, 10);
                }
                _ = buf_append_cstr(&prompt, "  ");
                var numbuf: Buf = buf_new(16);
                defer { buf_free(&numbuf); }
                _ = buf_append_u64(&numbuf, (k + 1) as u64);
                _ = buf_append(&prompt, numbuf.ptr, numbuf.len);
                _ = buf_append_cstr(&prompt, ") ");
                _ = buf_append(&prompt, label.ptr, label.len);
                if desc.len > 0 {
                    _ = buf_append_cstr(&prompt, " — ");
                    _ = buf_append(&prompt, desc.ptr, desc.len);
                }
                _ = buf_append_byte(&prompt, 10);
            }
            k = k + 1;
        }

        // ---- 通道 1：TUI 提问弹窗 ----
        // 只有它会给「选中的下标」；旧的两条通道只有一行文本，按编号反解。
        if tui_active() {
            var hdr: Buf = buf_new(128);
            defer { buf_free(&hdr); }
            if header.len > 0 {
                _ = buf_append(&hdr, header.ptr, header.len);
            } else {
                _ = buf_append_cstr(&hdr, "提问");
            }
            if n > 1 {
                _ = buf_append_cstr(&hdr, " · 第 ");
                var nb: Buf = buf_new(16);
                defer { buf_free(&nb); }
                _ = buf_append_u64(&nb, (i + 1) as u64);
                _ = buf_append(&hdr, nb.ptr, nb.len);
                _ = buf_append_cstr(&hdr, "/共 ");
                _ = buf_append_u64(&nb, n as u64);
                _ = buf_append(&hdr, nb.ptr, nb.len);
                _ = buf_append_cstr(&hdr, " 问");
            }
            const rc: i32 = tui_ask_wait(hdr.ptr as &const byte, hdr.len,
                qtext.ptr as &const byte, qtext.len,
                items.ptr as &const byte, items.len, multi, 0);
            if rc == 1 {
                // 选中的下标 → label（**按下标回查**，不反解文本）
                var labels: Buf = buf_new(1024);
                defer { buf_free(&labels); }
                const npick: usize = tui_ask_pick_count();
                var p: usize = 0;
                while p < npick {
                    var idx: usize = 0;
                    if tui_ask_pick_at(p, &idx) {
                        if idx < nopt {
                            ask_label_into(&labels, &opts, idx);
                        }
                    }
                    p = p + 1;
                }
                var custom: Buf = buf_new(4096);
                defer { buf_free(&custom); }
                const cn: usize = tui_ask_custom_text(&custom);
                // 单选：写了自定义回答就**覆盖** selected（DSH 的单选 custom 是排他的）；
                // 多选：两者都带（多选草稿的语义）。
                if cn > 0 && !multi {
                    buf_reset(&labels);
                }
                ask_emit_answer(out, &id, &labels, &custom);
                i = i + 1;
                continue;
            }
            if rc == 2 {
                // 取消了这次问答（esc / ctrl+c / 没人回答）：不是「渠道不通」，是「人不答」。
                // 文案要与 no answer channel 分开，模型才知道该自己拿主意。
                _ = buf_append_cstr(out, "{\"id\":");
                _ = jw_str_into(out, id.ptr as &const byte, id.len);
                _ = buf_append_cstr(out, ",\"selected\":[],\"custom\":\"(the user dismissed the question without answering; decide yourself or proceed)\"}");
                i = i + 1;
                continue;
            }
            // rc == 0：浮窗画不出来（终端太矮）→ 回落到输入行那条路，不 fail closed
        }

        var line: Buf = buf_new(4096);
        defer { buf_free(&line); }
        var got: i32 = 0;
        if tui_active() {
            got = ask_tui_line(prompt.ptr as &const byte, prompt.len, &line);
        } else {
            _ = ask_write("\n");
            tty_stream_write(2, prompt.ptr as &const byte, prompt.len);
            _ = ask_write("> ");
            got = ask_read_line(&line);
        }
        if got == 0 {
            // 没有输入渠道：明确告诉模型「没有回答」
            _ = buf_append_cstr(out, "{\"id\":");
            _ = jw_str_into(out, id.ptr as &const byte, id.len);
            _ = buf_append_cstr(out, ",\"selected\":[],\"custom\":\"(no answer channel: the user could not be asked)\"}");
            i = i + 1;
            continue;
        }
        var labels2: Buf = buf_new(1024);
        defer { buf_free(&labels2); }
        var custom2: Buf = buf_empty();
        defer { buf_free(&custom2); }
        if nopt > 0 && line.len == 1 && is_digit(line.ptr[0]) {
            const pick: usize = (line.ptr[0] as usize) - 48;
            if pick >= 1 && pick <= nopt {
                ask_label_into(&labels2, &opts, pick - 1);
            }
        } else if line.len > 0 {
            _ = buf_append(&custom2, line.ptr, line.len);
        }
        ask_emit_answer(out, &id, &labels2, &custom2);
        i = i + 1;
    }
    _ = buf_append_cstr(out, "]}");
}
