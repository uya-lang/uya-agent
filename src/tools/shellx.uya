// src/shellx.uya — bash 工具（P7，对齐 DSH tool-bash）
//
// 参数：command(必)、description(必)、timeoutMs、workdir、run_in_background。
// 行为：
//   * `bash -c <command>`，workdir 默认工作区（相对路径按工作区解析）；
//   * 前景：stdout 与 stderr **分开**收（DSH 的结果里有独立的 [stderr] 段），
//     墙钟超时 → SIGKILL；结果尾部的标记：`[exit code: N]`、`[timed out after Nms]`、
//     `[killed by signal: N]`、`[output truncated]`；空输出 → `(no output)`；
//   * 后台：注册成任务并立刻返回 `started background job <id>`；
//   * 命令**没有终端**（P38）：stdin 指向 /dev/null、子进程 setsid 自成会话 —— 命令拿不走用户的
//     按键，也不会被终端的 job control 信号（SIGTTIN/SIGTTOU/SIGTSTP）停住；万一还是被停住了，
//     当场把整棵子树收掉并给出 `[stopped by signal: N]`（见 README 踩坑 60）；
//   * 命令退出就立刻返回：收尾那次读管道是非阻塞的 —— 子孙还替我们开着管道（`sleep 300 &` 之类）
//     也不会把工具挂住（P38，同一条「别一直显示运行中」的承诺）；
//   * 给子进程注入 DSH_* 环境（DSH_HOME / DSH_SHELL=1 / DSH_SESSION_ID / DSH_SESSION_JSONL）。

use libc.syscall;
use libc.unistd;
use libc.fcntl;
use libc.signal;
use std.runtime.saved_envp;

// P38：glibc 的 setsid()（工具链没有 sys_setsid 包装；与 sigx 绑 glibc sigaction 同一个写法/理由）
extern "libc" fn setsid() i32;

const SH_ENV_MAX: usize = 256;
const SH_POLL_MS: i32 = 50;

// P18：沙箱。0 = 直接 execve /bin/bash（今天的行为）
//       1 = execve bwrap 的 profile（argv 由 sandboxx 备好）
// 每次 sh_tool_bash 在 fork 之前决定一次，子进程只照抄。
var g_sh_exec: u8 = 0;
const SH_EXEC_PLAIN: u8 = 0;
const SH_EXEC_SANDBOX: u8 = 1;
const SH_EXEC_REFUSED: u8 = 2;   // confined + 沙箱不可用 → 调用方必须拒绝

// 内核沙箱的拒绝签名（DSH 对 bwrap 档也是 signature-only：读 stderr 的文本特征）
fn sh_err_is_sandbox_denied(e: &const Buf) bool {
    if e.len == 0 {
        return false;
    }
    return sh_has_cstr(e, "Permission denied" as &const byte) || sh_has_cstr(e, "Read-only file system" as &const byte);
}

fn sh_has_cstr(h: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if n == 0 || h.len < n {
        return false;
    }
    var i: usize = 0;
    while i + n <= h.len {
        if bufx_mem_eq(h.ptr + i, lit, n) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// read-only 下 bash 的失败文案（测试逐字断言）
const SH_DENIED: &const byte = "Error: the user denied this bash command in read-only mode. Do not retry it or an equivalent; use read/glob/grep, or ask the user to switch with /permission workspace-write.";
const SH_NO_CHANNEL: &const byte = "Error: bash needs per-command approval in read-only mode, but this session has no answer channel (non-interactive or subagent). Fail closed: ask the user to run it, or switch with /permission workspace-write.";

var g_sh_ws_z: Buf = Buf{ ptr: null, len: 0, cap: 0 };

// 按访问模式与沙箱开关，决定这次 exec 怎么起。返回 false = 必须拒绝执行（错误已写进 out）
fn sh_prepare_exec(cfg: &const Config, cmd_z: &const byte, out: &Buf) bool {
    g_sh_exec = SH_EXEC_PLAIN;
    if !buf_valid(&g_sh_ws_z) {
        g_sh_ws_z = buf_new(FS_PATH_MAX + 8);
    }
    var ws_len: usize = 0;
    if san_bind_root(cfg.workspace.ptr as &const byte, cfg.workspace.len, &g_sh_ws_z) {
        ws_len = g_sh_ws_z.len - 1;   // 去掉 NUL
    } else {
        _ = buf_reset(&g_sh_ws_z);
        _ = buf_append_byte(&g_sh_ws_z, 0);
    }
    const kind: i32 = san_build_exec(cfg.access, cfg.sandbox, g_sh_ws_z.ptr as &const byte, ws_len, cmd_z);
    if kind == 1 {
        g_sh_exec = SH_EXEC_SANDBOX;
        return true;
    }
    if kind == 0 {
        g_sh_exec = SH_EXEC_PLAIN;
        return true;
    }
    // 2：confined 模式但沙箱起不来 —— fail closed，绝不悄悄不沙箱（对齐 DSH SANDBOX_UNAVAILABLE）
    _ = buf_append_cstr(out, "Error: the file sandbox is unavailable on this host (bwrap: ");
    _ = buf_append_cstr(out, san_reason());
    _ = buf_append_cstr(out, "); bash is refused in ");
    _ = buf_append_cstr(out, perm_name(cfg.access));
    _ = buf_append_cstr(out, " mode. Install bubblewrap, or use --no-sandbox / --permission danger-full-access.");
    g_sh_exec = SH_EXEC_REFUSED;
    return false;
}

// 组装子进程环境：继承现有变量（清掉旧的 DSH_*），再补上我们的 DSH_*
var g_env_ptrs: [&const byte: SH_ENV_MAX] = [null as &const byte: SH_ENV_MAX];
var g_env_store: Buf = Buf{ ptr: null, len: 0, cap: 0 };

fn env_is_dsh(name: &const byte, n: usize) bool {
    if n < 4 {
        return false;
    }
    return name[0] == 68 as byte && name[1] == 83 as byte && name[2] == 72 as byte && name[3] == 95 as byte;
}

fn env_add_kv(name: &const byte, value: &const byte, value_len: usize) void {
    var slot: usize = 0;
    while slot < SH_ENV_MAX && (g_env_ptrs[slot] as usize) != 0 {
        slot = slot + 1;
    }
    if slot + 1 >= SH_ENV_MAX {
        return;
    }
    const start: usize = g_env_store.len;
    _ = buf_append_cstr(&g_env_store, name);
    _ = buf_append_byte(&g_env_store, 61);   // '='
    if value_len > 0 {
        _ = buf_append(&g_env_store, value, value_len);
    }
    _ = buf_append_byte(&g_env_store, 0);
    if !buf_valid(&g_env_store) {
        return;
    }
    g_env_ptrs[slot] = &g_env_store.ptr[start] as &const byte;
    g_env_ptrs[slot + 1] = null as &const byte;
}

// 组装一次环境（在 fork 之前调用；子进程 execve 前一直有效）
fn sh_env_prepare(dsh_home: &[byte], session_id: &[byte], session_jsonl: &[byte]) void {
    if !buf_valid(&g_env_store) {
        g_env_store = buf_new(8192);
    }
    buf_reset(&g_env_store);
    var i: usize = 0;
    while i < SH_ENV_MAX {
        g_env_ptrs[i] = null as &const byte;
        i = i + 1;
    }
    // 继承：saved_envp 是 &(&const byte)，逐条拷指针（跳过 DSH_*）
    var k: usize = 0;
    var slot: usize = 0;
    while slot + 2 < SH_ENV_MAX {
        const p: &const byte = saved_envp[k];
        if (p as usize) == 0 {
            break;
        }
        // 找 '='
        var eq: usize = 0;
        while p[eq] != 61 as byte && p[eq] != 0 as byte {
            eq = eq + 1;
        }
        if !env_is_dsh(p, eq) {
            g_env_ptrs[slot] = p;
            slot = slot + 1;
        }
        k = k + 1;
    }
    g_env_ptrs[slot] = null as &const byte;
    env_add_kv("DSH_SHELL", "1", 1);
    if dsh_home.len > 0 {
        env_add_kv("DSH_HOME", dsh_home.ptr, dsh_home.len);
    }
    if session_id.len > 0 {
        env_add_kv("DSH_SESSION_ID", session_id.ptr, session_id.len);
    }
    if session_jsonl.len > 0 {
        env_add_kv("DSH_SESSION_JSONL", session_jsonl.ptr, session_jsonl.len);
    }
}

// 在继承环境的基础上追加若干 KEY=VALUE（libc 没有 setenv，只能自己拼 envp）
export fn sh_env_prepare_kv(k1: &const byte, v1: &const byte, k2: &const byte, v2: &const byte) void {
    sh_env_prepare(&"x"[0: 0], &"x"[0: 0], &"x"[0: 0]);
    env_add_kv(k1, v1, bufx_cstr_len(v1));
    if bufx_cstr_len(k2) > 0 {
        env_add_kv(k2, v2, bufx_cstr_len(v2));
    }
}

export fn sh_env_array() &(&const byte) {
    return &g_env_ptrs[0];
}

// workdir：默认工作区；给了就按工作区解析（可含子目录）
fn sh_resolve_workdir(cfg: &const Config, args: &const JsonValue, out: &Buf) bool {
    buf_reset(out);
    var wd: Buf = buf_empty();
    defer { buf_free(&wd); }
    var have: bool = false;
    if js_obj_get_str_unescaped(args, "workdir", 7, &wd) && wd.len > 0 {
        have = true;
    }
    if !have {
        _ = buf_append(out, cfg.workspace.ptr, cfg.workspace.len);
        return buf_append_byte(out, 0);
    }
    const rc: i32 = fs_resolve(&g_fsctx, wd.ptr as &const byte, wd.len, out);
    return rc == 0;
}

// ============================================================
// P38：工具子进程的终端收口 / 进程组收口
// ============================================================

// 子进程的「没有终端」收口（fork 之后、exec 之前调用一次）。
//
// 为什么必须做（README 踩坑 60）：以前只重定向 fd 1/2，fd 0 原样继承 —— 工具命令拿到的
// stdin 就是 TUI 的终端。命令里的 shell 会把流水线放进自己的进程组，相对 TUI 的前台组就是
// **后台组**；这时命令树里只要有一个进程碰一下这个终端（读 → SIGTTIN；`tcsetattr` → SIGTTOU），
// 内核就会把**整个进程组**停住：make / sh / 命令自带的 `timeout` 一起停在 do_signal_stop，
// 而工具侧 `waitpid(WNOHANG)` 对「被停住」和「还在跑」完全同形 —— 状态行就一直「运行中」，
// 只能靠用户 esc 或工具超时收口（线上实测 6 分钟；同一命令加 `nohup` 就正常，因为 nohup 在
// stdin 是终端时会把它改成 /dev/null —— 这就是根因的对照实验）。
//
// 两件事，各自独立有用：
//   1) stdin = /dev/null：命令不可能再读走用户的按键，也不会因为 `isatty(0)` 为真走进交互分支
//      （对齐 DSH 的 `stdio.stdin = "ignore"`）；
//   2) setsid()：命令离开父进程的会话，**没有控制终端** → 终端信号（SIGTTIN/SIGTTOU/SIGTSTP，
//      以及终端挂断时的 SIGHUP）一个都到不了它；顺带 pgid == pid，收尾时 `kill(-pid)` 能连
//      子孙一起收掉（见 sh_kill_tree）。
// 任一步失败都不阻断执行：最坏退化成「只重定向了 stdout/stderr」的旧行为。
export fn sh_child_detach_stdio() void {
    var nullpath: [byte: 12] = "/dev/null";
    const nfd: i32 = sys_open(&nullpath[0], O_RDONLY as i32, 0) catch { -1; };
    if nfd >= 0 {
        _ = sys_dup2(nfd, 0) catch {};
        _ = sys_close(nfd) catch {};
    }
    _ = setsid();
}

// 按**进程组**收口（工具子进程 setsid 之后 pgid == pid，`kill(-pid)` 连子孙一起收）。
// 先 SIGCONT：被停住的组要先续上（否则收不干净）；组杀之后再补一发单 pid —— setsid 没成功时
// 组号不存在，那一发是兜底，也是老行为（只杀直接子进程）的保底。
export fn sh_kill_tree(pid: i32) void {
    if pid <= 0 {
        return;
    }
    const neg: i64 = 0 - (pid as i64);
    _ = sys_kill(neg, SIGCONT) catch {};
    _ = sys_kill(neg, SIGKILL) catch {};
    _ = sys_kill(pid as i64, SIGKILL) catch {};
}

// 前台执行；把 stdout/stderr 收进两个缓冲
//
// aborted：用户在这条命令跑着的时候按了 esc / ctrl+c / ctrl+d —— 我们**当场**把子进程
// 杀掉（跟超时同一条路），而不是「等它自己结束再说」。以前这里只调 tui_poll_tick()
// 把键收下来却没人看，`sleep 300` 一跑起来就真的退不出（见 README 踩坑 44）。
//
// P38：`waitpid` 带 WUNTRACED —— 子进程被 job control 停住（WIFSTOPPED）时当场收口，
// 按 128+停止信号 返回并填 stopped_by（见 README 踩坑 60）。
fn sh_run_foreground(cfg: &const Config, cmd_z: &const byte, workdir_z: &const byte, timeout_ms: u32, out_s: &Buf, err_s: &Buf, timed_out: &bool, killed_by: &i32, aborted: &bool, stopped_by: &i32) i32 {
    timed_out[0] = false;
    killed_by[0] = 0;
    aborted[0] = false;
    stopped_by[0] = 0;
    var op: [i32: 2] = [0: 2];
    var ep: [i32: 2] = [0: 2];
    if (sys_pipe2(&op[0], 0) catch { -1; }) != 0 {
        return -1;
    }
    if (sys_pipe2(&ep[0], 0) catch { -1; }) != 0 {
        _ = sys_close(op[0]) catch {};
        _ = sys_close(op[1]) catch {};
        return -1;
    }
    const pid64: i64 = sys_fork() catch {
        return -1;
    };
    if pid64 == 0 {
        _ = sys_close(op[0]) catch {};
        // P1：信号处置是继承的 —— 子进程必须先恢复默认，否则它收到 TERM 会去写父进程的终端
        sigx_reset_for_child();
        // P38：命令没有终端（stdin=/dev/null + 自成会话）—— 见 sh_child_detach_stdio 的文件注释
        sh_child_detach_stdio();
        _ = sys_close(ep[0]) catch {};
        _ = sys_dup2(op[1], 1) catch {};
        _ = sys_dup2(ep[1], 2) catch {};
        _ = sys_close(op[1]) catch {};
        _ = sys_close(ep[1]) catch {};
        _ = sys_chdir(workdir_z as *const byte) catch {};
        if g_sh_exec == SH_EXEC_SANDBOX {
            const bpath: &const byte = san_exec_path();
            _ = sys_execve(bpath, san_exec_argv(), &g_env_ptrs[0]) catch {};
        } else {
            var shpath: [byte: 16] = "/bin/bash";
            var shname: [byte: 5] = "bash";
            var dashc: [byte: 4] = "-c";
            var argv: [&const byte: 4] = [&shname[0], &dashc[0], cmd_z, null as &const byte];
            _ = sys_execve(&shpath[0], &argv[0], &g_env_ptrs[0]) catch {};
        }
        sys_exit(127);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(op[1]) catch {};
    _ = sys_close(ep[1]) catch {};
    var pfds: [PollFd: 2] = [
        PollFd{ fd: op[0], events: POLLIN, revents: 0 },
        PollFd{ fd: ep[0], events: POLLIN, revents: 0 },
    ];
    const started: u64 = ua_now_ms();
    var chunk: [byte: 8192] = [0: 8192];
    var done: bool = false;
    var out_len: usize = 0;
    var err_len: usize = 0;
    const cap: usize = cfg.max_tool_out;
    while !done {
        pfds[0].revents = 0;
        pfds[1].revents = 0;
        // P30：泵点 —— 先查「用户意图优先」（中止就当场杀子进程），再派发运行中敲进来的命令
        const ab: i32 = agent_pump_block();
        if ab != TUI_ABORT_NONE {
            // P38：收整棵子树（只杀直接子进程会把子孙留在进程表里）
            sh_kill_tree(pid);
            killed_by[0] = SIGKILL;
            aborted[0] = true;
            done = true;
        }
        const pr: i32 = sys_poll(&pfds[0], 2, SH_POLL_MS) catch { 0; };
        if pr > 0 {
            var which: usize = 0;
            while which < 2 {
                const rev: i16 = pfds[which].revents;
                if (rev & POLLIN) != 0 || (rev & POLLHUP) != 0 || (rev & POLLERR) != 0 {
                    const fd: i32 = pfds[which].fd;
                    const n: isize = sys_read(fd, &chunk[0], 8192) catch { 0 as isize; };
                    if n > 0 {
                        const un: usize = n as usize;
                        var i: usize = 0;
                        while i < un {
                            if which == 0 {
                                if out_len < cap {
                                    _ = buf_append_byte(out_s, chunk[i]);
                                    out_len = out_len + 1;
                                }
                            } else {
                                if err_len < cap {
                                    _ = buf_append_byte(err_s, chunk[i]);
                                    err_len = err_len + 1;
                                }
                            }
                            i = i + 1;
                        }
                    }
                }
                which = which + 1;
            }
        }
        // 超时（墙钟）
        if timeout_ms > 0 && (ua_now_ms() - started) >= (timeout_ms as u64) {
            timed_out[0] = true;
            // P38：收整棵子树
            sh_kill_tree(pid);
            killed_by[0] = SIGKILL;
            done = true;
        }
        var st: i32 = 0;
        const r: i32 = sys_waitpid(pid, &st, 3) catch { 0; };   // WNOHANG|WUNTRACED
        if r > 0 {
            // P38：被停住（WIFSTOPPED）。job control（SIGTTIN/SIGTTOU/SIGTSTP/SIGSTOP）会把
            // **整个进程组**停住 —— 连命令自带的 `timeout` 也一起停，谁都醒不过来。这种子进程
            // 不能就这么丢下（否则工具一直「运行中」，只有 esc/超时才收口）：当场收整棵子树，
            // 按 128+停止信号 收口。
            // 已经决定收工（中止/超时）的那一轮不再看停止态：那种情况下的收尾口径是「被我们杀的」
            if !done && (st & 127) == 127 {
                stopped_by[0] = (st >> 8) & 255;
                sh_kill_tree(pid);
                break;
            }
            done = true;
            // 收尾再读一次。
            // P38：**必须非阻塞**。命令自己已经退出了，但它的子孙可能还开着这两个管道
            // （`sleep 300 &`、后台 daemon、`nohup … &`）：阻塞读会一直等管道 EOF，
            // 于是「bash 已经退出、工具却还在运行中」—— 和「被停住」是同一类症状的另一个来源。
            _ = sys_fcntl(op[0], F_SETFL, O_NONBLOCK) catch {};
            _ = sys_fcntl(ep[0], F_SETFL, O_NONBLOCK) catch {};
            var guard: usize = 0;
            while guard < 8 {
                guard = guard + 1;
                const n2: isize = sys_read(op[0], &chunk[0], 8192) catch { 0 as isize; };
                if n2 <= 0 {
                    break;
                }
                if out_len < cap {
                    _ = buf_append(out_s, &chunk[0], n2 as usize);
                    out_len = out_len + n2 as usize;
                }
            }
            guard = 0;
            while guard < 8 {
                guard = guard + 1;
                const n3: isize = sys_read(ep[0], &chunk[0], 8192) catch { 0 as isize; };
                if n3 <= 0 {
                    break;
                }
                if err_len < cap {
                    _ = buf_append(err_s, &chunk[0], n3 as usize);
                    err_len = err_len + n3 as usize;
                }
            }
            const code: i32 = (st >> (8 as i32)) & 255;
            const sig: i32 = st & 127;
            _ = sys_close(op[0]) catch {};
            _ = sys_close(ep[0]) catch {};
            if sig != 0 {
                if killed_by[0] == 0 {
                    killed_by[0] = sig;
                }
                return 128 + sig;
            }
            return code;
        }
    }
    _ = sys_close(op[0]) catch {};
    _ = sys_close(ep[0]) catch {};
    var st2: i32 = 0;
    _ = sys_waitpid(pid, &st2, 0) catch {};
    // P38：被停住过 —— 停止信号优先于「被我们 SIGKILL 掉」这条（sh_kill_tree 的 SIGKILL 是我们
    // 自己发的，不该盖掉真正的原因；要让模型看到的是「谁把它停住了」）
    if stopped_by[0] != 0 {
        return 128 + stopped_by[0];
    }
    if killed_by[0] != 0 {
        return 128 + killed_by[0];
    }
    return (st2 >> (8 as i32)) & 255;
}

// 后台执行：注册成任务，返回 job id（-1 = 失败）
fn sh_run_background(cfg: &const Config, cmd_z: &const byte, workdir_z: &const byte, label: &const byte, label_len: usize) i32 {
    var op: [i32: 2] = [0: 2];
    if (sys_pipe2(&op[0], 0) catch { -1; }) != 0 {
        return -1;
    }
    const pid64: i64 = sys_fork() catch {
        return -1;
    };
    if pid64 == 0 {
        _ = sys_close(op[0]) catch {};
        // P1：信号处置是继承的 —— 子进程必须先恢复默认，否则它收到 TERM 会去写父进程的终端
        sigx_reset_for_child();
        // P38：后台任务同样不给终端（后台任务更容易被忘在那儿读 stdin / 被终端信号停住）
        sh_child_detach_stdio();
        _ = sys_dup2(op[1], 1) catch {};
        _ = sys_dup2(op[1], 2) catch {};
        _ = sys_close(op[1]) catch {};
        _ = sys_chdir(workdir_z as *const byte) catch {};
        if g_sh_exec == SH_EXEC_SANDBOX {
            const bpath2: &const byte = san_exec_path();
            _ = sys_execve(bpath2, san_exec_argv(), &g_env_ptrs[0]) catch {};
        } else {
            var shpath: [byte: 16] = "/bin/bash";
            var shname: [byte: 5] = "bash";
            var dashc: [byte: 4] = "-c";
            var argv: [&const byte: 4] = [&shname[0], &dashc[0], cmd_z, null as &const byte];
            _ = sys_execve(&shpath[0], &argv[0], &g_env_ptrs[0]) catch {};
        }
        sys_exit(127);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(op[1]) catch {};
    // 读端设成非阻塞，避免 drain 时卡住
    _ = sys_fcntl(op[0], F_SETFL, O_NONBLOCK) catch {};
    const id: i32 = job_register(&g_jobs, pid, op[0], label, label_len);
    if id < 0 {
        // P38：整棵子树
        sh_kill_tree(pid);
        _ = sys_close(op[0]) catch {};
    }
    _ = cfg;
    return id;
}

// ============================================================
// bash 工具
// ============================================================
export fn sh_tool_bash(cfg: &const Config, args: &const JsonValue, out: &Buf) void {
    if !cfg.allow_shell {
        _ = buf_append_cstr(out, "Error: background execution is disabled for this bash tool");
        return;
    }
    var cmd: Buf = buf_empty();
    defer { buf_free(&cmd); }
    if !js_obj_get_str_unescaped(args, "command", 7, &cmd) || cmd.len == 0 {
        _ = buf_append_cstr(out, "Error: invalid command: expected a non-empty string");
        return;
    }
    var desc: Buf = buf_empty();
    defer { buf_free(&desc); }
    if !js_obj_get_str_unescaped(args, "description", 11, &desc) || desc.len == 0 {
        _ = buf_append_cstr(out, "Error: invalid description: expected a non-empty string");
        return;
    }
    var timeout_ms: u32 = cfg.shell_timeout_ms;
    // preset 的 tool-bash.timeoutMs（只在用户没显式改过 cfg 时生效）
    const knob: u32 = agent_bash_timeout_knob();
    if knob > 0 && cfg.shell_timeout_ms == 120000 {
        timeout_ms = knob;
    }
    var tv: JsonValue = JsonValue.json_null();
    var n: i64 = 0;
    if js_obj_get(args, "timeoutMs", 9, &tv) && js_i64_of(&tv, &n) && n > 0 {
        if n > 3600000 {
            n = 3600000;
        }
        timeout_ms = n as u32;
    }
    var bg: bool = false;
    var bv: JsonValue = JsonValue.json_null();
    if js_obj_get(args, "run_in_background", 17, &bv) {
        bg = json_bool_of(&bv);
    }
    var wd_z: Buf = buf_new(FS_PATH_MAX);
    defer { buf_free(&wd_z); }
    if !sh_resolve_workdir(cfg, args, &wd_z) {
        _ = buf_append_cstr(out, "Error: invalid workdir");
        return;
    }
    // P37：git-worktree 模式的 bash 闸门 —— 命令会在**共享 checkout** 里改仓库状态
    // （workdir 在仓库内、不在 worktree 内，且命令里有 git 的变更子命令）就拒绝，
    // 并指路 `workdir: <worktree>`。只读命令一律放行（对齐 DSH preset 的 GIT_MUTATION）。
    if wt_guard_bash_crosses(wd_z.ptr as &const byte, wd_z.len - 1, cmd.ptr as &const byte, cmd.len) {
        const st: &const WtState = wt_state();
        _ = buf_append_cstr(out, "Error: that command would change the shared checkout (");
        _ = buf_append(out, st.repo_root.ptr as &const byte, st.repo_root.len);
        _ = buf_append_cstr(out, "), which this Git-worktree session keeps untouched until the merge. Re-run it with workdir: \"");
        _ = buf_append(out, st.worktree_path.ptr as &const byte, st.worktree_path.len);
        _ = buf_append_cstr(out, "\" (your worktree, branch ");
        _ = buf_append(out, st.branch.ptr as &const byte, st.branch.len);
        _ = buf_append_cstr(out, "), or name the worktree in the command. Read-only commands against the shared checkout need no workdir and are not blocked.");
        return;
    }
    if !buf_append_byte(&cmd, 0) {
        _ = buf_append_cstr(out, "Error: out of memory");
        return;
    }
    // P18 闸门 1：read-only 模式下每条命令都要用户批准（对齐 DSH 的 approval=ask）
    if perm_requires_approval() {
        const verdict: i32 = ask_approve_command(cfg, cmd.ptr as &const byte, cmd.len);
        if verdict == 0 {
            buf_reset(out);
            _ = buf_append_cstr(out, SH_DENIED);
            return;
        }
        if verdict == 2 {
            buf_reset(out);
            _ = buf_append_cstr(out, SH_NO_CHANNEL);
            return;
        }
        buf_reset(out);
    }
    // 注入 DSH_* 环境
    var sess_id: Buf = buf_empty();
    if g_sess.id.len > 0 {
        sess_id = g_sess.id;
    }
    var sess_path: Buf = buf_empty();
    if g_sess.path.len > 0 {
        sess_path = g_sess.path;
    }
    sh_env_prepare(agent_dsh_home(), sess_id.ptr[0: sess_id.len], sess_path.ptr[0: sess_path.len]);

    // P18 闸门 2：confined 模式必须真的套上沙箱（起不来就拒绝，不静默降级）
    if !sh_prepare_exec(cfg, &cmd.ptr[0] as &const byte, out) {
        return;
    }

    if bg {
        const id: i32 = sh_run_background(cfg, &cmd.ptr[0] as &const byte, &wd_z.ptr[0] as &const byte, desc.ptr as &const byte, desc.len);
        if id < 0 {
            _ = buf_append_cstr(out, "Error: cannot start background job");
            return;
        }
        _ = buf_append_cstr(out, "started background job job-");
        _ = buf_append_u64(out, id as u64);
        return;
    }

    var out_s: Buf = buf_new(8192);
    defer { buf_free(&out_s); }
    var err_s: Buf = buf_new(4096);
    defer { buf_free(&err_s); }
    var timed_out: bool = false;
    var killed_by: i32 = 0;
    var aborted: bool = false;
    var stopped_by: i32 = 0;
    const code: i32 = sh_run_foreground(cfg, &cmd.ptr[0] as &const byte, &wd_z.ptr[0] as &const byte, timeout_ms, &out_s, &err_s, &timed_out, &killed_by, &aborted, &stopped_by);
    if code < 0 {
        _ = buf_append_cstr(out, "Error: cannot spawn bash");
        return;
    }
    var wrote: bool = false;
    if out_s.len > 0 {
        _ = buf_append(out, out_s.ptr, out_s.len);
        wrote = true;
    }
    if err_s.len > 0 {
        if wrote && out_s.ptr[out_s.len - 1] != 10 as byte {
            _ = buf_append_byte(out, 10);
        }
        _ = buf_append_cstr(out, "[stderr]\n");
        _ = buf_append(out, err_s.ptr, err_s.len);
        wrote = true;
    }
    if !wrote {
        _ = buf_append_cstr(out, "(no output)");
    }
    if out.len > 0 && out.ptr[out.len - 1] != 10 as byte {
        _ = buf_append_byte(out, 10);
    }
    if timed_out {
        _ = buf_append_cstr(out, "[timed out after ");
        _ = buf_append_u64(out, timeout_ms as u64);
        _ = buf_append_cstr(out, "ms]\n");
    }
    if aborted {
        // 给模型的措辞要明确：这不是命令失败，是用户把它叫停了
        _ = buf_append_cstr(out, "[aborted by user]\n");
    }
    if stopped_by != 0 {
        // P38：命令树被 job control 停住了。措辞要让模型知道「这不是命令自己失败，也不是用户叫停」，
        // 而是「命令碰了它没有的终端」——照原样重试只会再停一次。
        _ = buf_append_cstr(out, "[stopped by signal: ");
        _ = buf_append_u64(out, stopped_by as u64);
        _ = buf_append_cstr(out, "]\n(the command's process tree was stopped by a job-control signal: it tried to use the terminal, which bash commands do not get — stdin is /dev/null and the command runs in its own session. The tree has been killed; do not retry it as-is.)\n");
    } else if killed_by != 0 {
        _ = buf_append_cstr(out, "[killed by signal: ");
        _ = buf_append_u64(out, killed_by as u64);
        _ = buf_append_cstr(out, "]\n");
    }
    if out_s.len >= cfg.max_tool_out || err_s.len >= cfg.max_tool_out {
        _ = buf_append_cstr(out, "[output truncated]\n");
    }
    // P18：沙箱拒绝的文件效果 —— confined + 真的套了壳 + 非零退出 + stderr 命中内核签名时补一行提示。
    // 只是提示（不改强制），措辞也说明了这是内核拒的。
    if g_sh_exec == SH_EXEC_SANDBOX && code != 0 && sh_err_is_sandbox_denied(&err_s) {
        _ = buf_append_cstr(out, "[sandbox] the ");
        _ = buf_append_cstr(out, perm_name(cfg.access));
        _ = buf_append_cstr(out, " file sandbox denied a file effect of this command (writes outside the allowed roots are rejected by the kernel).\n");
    }
    _ = buf_append_cstr(out, "[exit code: ");
    _ = buf_append_u64(out, code as u64);
    _ = buf_append_cstr(out, "]");
}
