// src/foundation/dirent.uya — 目录项内部字段偏移（跨平台）
//
// 本文件：`sys_getdents64` / `sys_getdirentries64` 输出记录里 `d_type` 与 `d_name`
//   的字节偏移。手写遍历目录的四处在（`pm_rm_rf`、`pm_store` 分片装载、`pm_seed`
//   扫描、`web/whost` 包清单）都按 Linux `getdents64` 的布局解析，而 Darwin 的
//   `getdirentries64` 填的是**宿主** struct dirent：
//     Linux : {u64 d_ino, i64 d_off, u16 d_reclen, u8 d_type, char d_name[]}
//     Darwin: {u64 d_ino, u64 d_seekoff, u16 d_reclen, u16 d_namlen,
//              u8 d_type, char d_name[]}
//   `d_reclen` 两边都在记录内偏移 16，`d_type`/`d_name` 差 2 字节。偏移写死一套的话，
//   另一平台读到的是**垃圾名字**（实测 macOS：`pm_rm_rf` 变成静默空操作，自测夹具
//   的会话目录清不掉）。
// 不变量：两个常量都是**记录内**偏移；调用方仍需自己跳过 `.`/`..` 与跨读残记录。
// 依赖：无（只用编译期分支）。
// 命名：`DIRENT_*`。

use std;

std.cfg(std.target_os == .tos_macos, {
    export const DIRENT_TYPE_OFF: usize = 20;
    export const DIRENT_NAME_OFF: usize = 21;
}, {
    export const DIRENT_TYPE_OFF: usize = 18;
    export const DIRENT_NAME_OFF: usize = 19;
})
