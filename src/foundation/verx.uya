// src/foundation/verx.uya — 全仓**唯一**的版本定义（发布版本 + 开发阶段串 + 程序名）
//
// 本文件：`VER_NAME`（程序名）/ `VER_SEMVER`（发布版本，与 git tag 同口径）/
//   `AGENT_VERSION`（开发阶段串，老名字，P114 起为空）以及把它们拼成**一条**人读文本的
//   `ver_line_into`（P114 之前是 `uya-agent 0.1.0 (p83-clip-any)`，现在是
//   `uya-agent 0.1.0`）与 `ver_ident_into`（`uya-agent/0.1.0`，User-Agent 用）。
// 不变量：① **版本号只在这里写一次** —— `--version` / `/status` / TUI 脚注 /
//   `User-Agent` / `host.describe.version` 全从这里取；任何一处另起一份字面量就是回归
//   （本轮之前就是这样：UA 写 `uya-agent/0.1`、DSH 适配层写 `"version":"0.0.1"`、
//   脚注与 `/status` 写 `p83-clip-any`，三份互不相干，谁也说不出「这个二进制是哪个版本」）；
//   ② 两个串都是 `&const byte`、以 `\0` 结尾 —— 调用方要长度一律用 `bufx_cstr_len(…)`，
//   **不要手写长度常量**（P30 与 P35 两次因为手写长度没跟着改，把结尾的 NUL 带进了
//   `/status` 浮层，自测的「正文层不许出现 NUL」不变量当场抓住）；③ `VER_SEMVER` 是
//   **发布**身份（打 tag 时对着它核对），`AGENT_VERSION` 是**开发阶段**身份（README §0.1
//   的 `P0`–`P114` 记法 + `--tui-demo` 脚注排版基准）—— 两件事，谁都不许当另一个用；
//   ④ `AGENT_VERSION` 只在**选定要改它**的那条线上改（见 DESIGN §19、README §0.1），
//   P114 起它是空串：对外只有 `VER_SEMVER` 一个版本。
// 依赖：本仓 foundation/bufx（`Buf` 拼接 / `bufx_cstr_len`）。不依赖任何上层文件 ——
//   放在 foundation 是因为 net（UA）与 web（DSH 适配）和 agent 一样都要读它。
// 命名：`ver_*`（函数）、`VER_*`（常量）；`AGENT_VERSION` 是历史老名字（四个调用点 +
//   自测都在用它），保留原名以免满仓改名 —— 它是**同一份定义**，不是第二份副本。
//
// 为什么单开一个文件：版本号本来是散在各处的字面量，而「散着」的代价不是好看与否，是
// 用户问「你装的是哪个版本」时，三个地方给出三个答案。把定义收在一处之后，加一个新的
// 输出口只要调 `ver_line_into`，不需要再想「这次该写哪个数」。

// 程序名（`--version` 与 UA 的第一段）。改名只在这里改。
export const VER_NAME: &const byte = "uya-agent" as &const byte;

// 发布版本：与 GitHub release 的 tag 同口径（`v0.1.0` 对应这里的 `0.1.0`）。
// 发版清单（RELEASE.md §0）要求 `./build/uya-agent --version` 印出的就是这个串。
export const VER_SEMVER: &const byte = "0.1.0" as &const byte;

// 开发阶段串：本项目内部的阶段记法（`P0`–`P114` 那一套，见 README §0.1 与 DESIGN §19）。
// 它同时是 `--tui-demo` 脚注的排版基准 —— 改它会让七屏快照都差这一行（这是**预期**的：
// 只有选定要动版本串的那条线才改，理由记在 DESIGN 的对应小节）。
// ⚠ 它是**短的构建串**，不是语义版本：TUI 脚注右半区只有十几列的预算（统计行放不下时
// 才退回它），所以串必须短 —— 别把 `VER_SEMVER` 拆进来。
// P114：**置空**。阶段串是本仓内部的开发线记法，对拿到二进制的用户没有意义：他问
// 「这是哪个版本」，答案是 `0.1.0`，而不是某条开发线最后一次动了用户可见行为时留下的
// 标签（`p83-clip-any` 那串是 P83 剪贴板那条线的，之后 P84–P113 全都没改它）。
// `ver_line_into` 对空串**不画括号**（它一直是这么写的），所以清掉这里就得到干净的一行
// `uya-agent 0.1.0`；TUI 脚注右半区退回版本号时也就印这个语义版本（预算够，见
// `term/tui/status.uya` 的 `g_tui_version` 分支）。要恢复阶段串：把串填回来即可，
// 拼装函数、自测与文档都不必再改。
export const AGENT_VERSION: &const byte = "" as &const byte;

// 拼一版**人读**的版本行（不带换行）：`uya-agent 0.1.0`（阶段串非空时才补
// ` (阶段串)`，见下）。`--version` 与 `/status` 的 version 字段共用它 —— 两处逐字节
// 相同，靠的是同一个函数，不是靠两条 printf 抄得一样。
export fn ver_line_into(out: &Buf) bool {
    if !buf_append_cstr(out, VER_NAME) {
        return false;
    }
    if !buf_append_byte(out, 32) {
        return false;
    }
    if !buf_append_cstr(out, VER_SEMVER) {
        return false;
    }
    // 阶段串为空时不画那对括号（fork 出去把阶段串清掉的构建仍然印得出干净的一行）
    if bufx_cstr_len(AGENT_VERSION) == 0 {
        return true;
    }
    if !buf_append_cstr(out, " (") {
        return false;
    }
    if !buf_append_cstr(out, AGENT_VERSION) {
        return false;
    }
    return buf_append_byte(out, 41);   // ')'
}

// 拼**机器读**的身份串（不带换行）：`uya-agent/0.1.0`。
// 用在 `User-Agent: <ident> (deepseek-harness-compatible)` 的版本段上 —— 括号里那截是
// 网关的**客户端词表契约**（见 net/httpc.uya 的 HC_USER_AGENT 注释），不是版本，留原处。
export fn ver_ident_into(out: &Buf) bool {
    if !buf_append_cstr(out, VER_NAME) {
        return false;
    }
    if !buf_append_byte(out, 47) {   // '/'
        return false;
    }
    return buf_append_cstr(out, VER_SEMVER);
}
