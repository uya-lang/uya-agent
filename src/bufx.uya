// src/bufx.uya — 通用字节缓冲与字节工具（从 httpc.uya 抽出）
//
// 这里只放与传输协议无关的东西：Buf 生命周期、拼接、十进制/十六进制格式化、
// 大小写无关比较、子串查找、UTF-8 码点计数与切片。httpc / llm / 工具 / 会话日志
// 都依赖它。
//
// 命名纪律（Uya 多文件是**合并命名空间**，见 README 第 3 节第 7 条）：
//   * 从 httpc 搬过来的老名字保持不变（buf_* / find_sub / hex_of / parse_*_at）；
//   * **新增**符号一律带模块前缀 bufx_，避免与 stdlib 或后续模块撞名。

use libc.heap;
use libc.stdlib;

// ============================================================
// Buf — 堆缓冲
// ============================================================
export struct Buf {
    ptr: &byte,
    len: usize,
    cap: usize,
}

export fn buf_empty() Buf {
    return Buf{ ptr: null, len: 0, cap: 0 };
}

export fn buf_new(cap: usize) Buf {
    var b: Buf = Buf{ ptr: null, len: 0, cap: 0 };
    if cap == 0 {
        return b;
    }
    const raw: &void = malloc(cap);
    if ((raw as &byte) as usize) == 0 {
        return b;
    }
    b.ptr = raw as &byte;
    b.cap = cap;
    return b;
}

export fn buf_valid(b: &const Buf) bool {
    return ((b.ptr as usize) != 0) && b.cap > 0;
}

export fn buf_free(b: &Buf) void {
    if (b.ptr as usize) != 0 {
        free(b.ptr as &void);
    }
    b.ptr = null;
    b.len = 0;
    b.cap = 0;
}

export fn buf_reset(b: &Buf) void {
    b.len = 0;
}

export fn buf_reserve(b: &Buf, extra: usize) bool {
    if b.cap >= b.len + extra {
        return true;
    }
    var ncap: usize = b.cap * 2;
    if ncap < b.len + extra {
        ncap = b.len + extra;
    }
    if ncap < 512 {
        ncap = 512;
    }
    const raw: &void = realloc(b.ptr as &void, ncap);
    if ((raw as &byte) as usize) == 0 {
        return false;
    }
    b.ptr = raw as &byte;
    b.cap = ncap;
    return true;
}

export fn buf_append(b: &Buf, p: &const byte, n: usize) bool {
    if n == 0 {
        return true;
    }
    if !buf_reserve(b, n) {
        return false;
    }
    var i: usize = 0;
    while i < n {
        b.ptr[b.len + i] = p[i];
        i = i + 1;
    }
    b.len = b.len + n;
    return true;
}

export fn buf_append_byte(b: &Buf, v: byte) bool {
    if !buf_reserve(b, 1) {
        return false;
    }
    b.ptr[b.len] = v;
    b.len = b.len + 1;
    return true;
}

export fn buf_append_slice(b: &Buf, s: &[byte]) bool {
    return buf_append(b, s.ptr, s.len);
}

// 追加 C 字符串字面量（长度用 strlen 求，避免手写字面量长度出错）
export fn buf_append_cstr(b: &Buf, p: &const byte) bool {
    const n: usize = bufx_cstr_len(p);
    return buf_append(b, p, n);
}

// 追加 C 字符串并**补 NUL**：凡是要把 buf.ptr 直接当 C 字符串
// （sys_open / execve / getenv 之类 FFI）传给系统调用的，必须用这个，
// 否则 sys_open 会把缓冲区后面的残留字节当成路径的一部分（踩过这个坑）。
export fn buf_append_cstr_z(b: &Buf, p: &const byte) bool {
    if !buf_append_cstr(b, p) {
        return false;
    }
    return buf_append_byte(b, 0);
}

// 数字 → 十进制
export fn buf_append_u64(b: &Buf, v: u64) bool {
    // tmp 必须给足：u64 最多 20 位十进制，这里留 64 字节 —— 早期写 24 时，
    // 编译器生成的栈布局让相邻局部缓冲区（比如上层正在拼的标题）被踩掉尾巴，
    // 表现为「标题里多出一个随机字节、面板右竖线错位一列」（P15 实测踩到）。
    var tmp: [byte: 64] = [0: 64];
    var n: u64 = v;
    var i: usize = 0;
    if n == 0 {
        return buf_append_byte(b, 48);
    }
    while n > 0 && i < 20 {
        const d: u64 = n % (10 as u64);
        const dv: i32 = (d as i32) + 48;
        tmp[i] = dv as byte;
        n = n / (10 as u64);
        i = i + 1;
    }
    while i > 0 {
        i = i - 1;
        if !buf_append_byte(b, tmp[i]) {
            return false;
        }
    }
    return true;
}

// 数字 → i64 十进制（会话日志/工具结果里到处要用）
export fn buf_append_i64(b: &Buf, v: i64) bool {
    if v < 0 {
        if !buf_append_byte(b, 45) {
            return false;
        }
        const mag: u64 = (0 as u64) - (v as u64);
        return buf_append_u64(b, mag);
    }
    return buf_append_u64(b, v as u64);
}

// 追加一个 NUL 之外的定长字节
export fn buf_append_span(b: &Buf, p: &const byte, from: usize, n: usize) bool {
    if n == 0 {
        return true;
    }
    const q: &const byte = @ptr_from_usize(@usize_from_ptr(p as &const void) + from) as &const byte;
    return buf_append(b, q, n);
}

// 把 b 截断到 n 字节
export fn buf_truncate(b: &Buf, n: usize) void {
    if n < b.len {
        b.len = n;
    }
}

// b[from..] 拷贝到自身开头，得到「丢弃前缀」语义（会话日志/流式缓冲要用）
export fn buf_drop_prefix(b: &Buf, from: usize) void {
    if from == 0 {
        return;
    }
    if from >= b.len {
        b.len = 0;
        return;
    }
    var i: usize = 0;
    var j: usize = from;
    while j < b.len {
        b.ptr[i] = b.ptr[j];
        i = i + 1;
        j = j + 1;
    }
    b.len = i;
}

// ============================================================
// 字节工具
// ============================================================
export fn bufx_cstr_len(p: &const byte) usize {
    if p == null {
        return 0;
    }
    var n: usize = 0;
    while p[n] != 0 as byte {
        n = n + 1;
    }
    return n;
}

export fn byte_lower(c: byte) byte {
    if c >= 65 && c <= 90 {
        return (c + 32) as byte;
    }
    return c;
}

export fn eq_ignore_case(a: &[byte], b: &[byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0;
    while i < a.len {
        if byte_lower(a.ptr[i]) != byte_lower(b.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

export fn is_digit(c: byte) bool {
    return c >= 48 && c <= 57;
}

export fn bufx_mem_eq(p: &const byte, q: &const byte, n: usize) bool {
    var i: usize = 0;
    while i < n {
        if p[i] != q[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

export fn bufx_eq_cstr(p: &const byte, n: usize, lit: &const byte) bool {
    const m: usize = bufx_cstr_len(lit);
    if n != m {
        return false;
    }
    return bufx_mem_eq(p, lit, n);
}

// 缓冲区里**逐字节**找一段字面量（不是 C 串语义：字面量里的 0x1b 照算）
export fn bufx_contains(buf: &const Buf, lit: &const byte) bool {
    const m: usize = bufx_cstr_len(lit);
    if m == 0 || buf.len < m {
        return false;
    }
    var i: usize = 0;
    while i + m <= buf.len {
        if bufx_mem_eq(buf.ptr + i, lit, m) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

export fn find_sub(hay: &[byte], needle: &[byte], from: usize) isize {
    if needle.len == 0 || hay.len < needle.len {
        return -1;
    }
    var i: usize = from;
    while i + needle.len <= hay.len {
        var j: usize = 0;
        var ok: bool = true;
        while j < needle.len {
            if hay.ptr[i + j] != needle.ptr[j] {
                ok = false;
                break;
            }
            j = j + 1;
        }
        if ok {
            return i as isize;
        }
        i = i + 1;
    }
    return -1;
}

export fn bufx_find_byte(hay: &[byte], c: byte, from: usize) isize {
    var i: usize = from;
    while i < hay.len {
        if hay.ptr[i] == c {
            return i as isize;
        }
        i = i + 1;
    }
    return -1;
}

// ============================================================
// 数字解析 / 十六进制
// ============================================================
export fn parse_u64_at(s: &[byte], off: usize, n: usize) i64 {
    var v: i64 = 0;
    var i: usize = off;
    const end: usize = off + n;
    while i < end {
        const c: byte = s.ptr[i];
        if !is_digit(c) {
            return -1;
        }
        v = v * 10 + ((c as i64) - 48);
        i = i + 1;
    }
    return v;
}

export fn parse_hex_at(s: &[byte], off: usize, n: usize) i64 {
    var v: i64 = 0;
    var i: usize = off;
    const end: usize = off + n;
    while i < end {
        const c: byte = s.ptr[i];
        var d: i32 = -1;
        if c >= 48 && c <= 57 {
            d = (c as i32) - 48;
        } else if c >= 97 && c <= 102 {
            d = (c as i32) - 87;
        } else if c >= 65 && c <= 70 {
            d = (c as i32) - 55;
        }
        if d < 0 {
            return -1;
        }
        v = v * 16 + (d as i64);
        i = i + 1;
    }
    return v;
}

// 任意字节串 → 小写 hex，返回写入长度
export fn hex_of(digest: &const byte, n: usize, out: &byte) usize {
    const hexd: &[byte] = &"0123456789abcdef"[0: 16];
    var i: usize = 0;
    while i < n {
        const b: byte = digest[i];
        out[i * 2] = hexd[((b as i32) >> 4) as usize];
        out[i * 2 + 1] = hexd[((b as i32) & 15) as usize];
        i = i + 1;
    }
    return n * 2;
}

export fn hex_val_of(c: byte) i32 {
    if c >= 48 && c <= 57 {
        return (c as i32) - 48;
    }
    if c >= 97 && c <= 102 {
        return (c as i32) - 87;
    }
    if c >= 65 && c <= 70 {
        return (c as i32) - 55;
    }
    return -1;
}

// ============================================================
// UTF-8 码点工具
//
// 用途：tool-result 剪枝按**码点**计数（对齐 DSH 的 Array.from(text).length 语义）、
// read 的行长上限按字符数、grep 预览截断不能切坏 UTF-8。
// 无效/截断字节一律按 1 个码点 1 个字节处理，保证有界且不会越界。
// ============================================================
export fn bufx_utf8_step(p: &const byte, n: usize, i: usize) usize {
    if i >= n {
        return 0;
    }
    const v: i32 = p[i] as i32;
    var step: usize = 1;
    if v >= 0 && v < 128 {
        step = 1;
    } else if (v & 224) == 192 {
        step = 2;
    } else if (v & 240) == 224 {
        step = 3;
    } else if (v & 248) == 240 {
        step = 4;
    } else {
        step = 1;
    }
    if i + step > n {
        return 1;
    }
    return step;
}

export fn bufx_utf8_count(p: &const byte, n: usize) usize {
    var i: usize = 0;
    var c: usize = 0;
    while i < n {
        const step: usize = bufx_utf8_step(p, n, i);
        if step == 0 {
            break;
        }
        i = i + step;
        c = c + 1;
    }
    return c;
}

// 前 cps 个码点占用的字节数；cps >= 总码点时返回 n
export fn bufx_utf8_prefix_bytes(p: &const byte, n: usize, cps: usize) usize {
    var i: usize = 0;
    var c: usize = 0;
    while i < n && c < cps {
        const step: usize = bufx_utf8_step(p, n, i);
        if step == 0 {
            break;
        }
        i = i + step;
        c = c + 1;
    }
    return i;
}

// 从尾部保留 cps 个码点时的起始字节偏移；cps >= 总码点时返回 0
export fn bufx_utf8_suffix_offset(p: &const byte, n: usize, cps: usize) usize {
    const total: usize = bufx_utf8_count(p, n);
    if cps >= total {
        return 0;
    }
    return bufx_utf8_prefix_bytes(p, n, total - cps);
}

// 判断 [0, n) 是否合法 UTF-8（工具结果/文件内容校验用；非法时返回首个坏字节下标）
export fn bufx_utf8_valid(p: &const byte, n: usize) bool {
    var i: usize = 0;
    while i < n {
        const v: i32 = p[i] as i32;
        if v >= 0 && v < 128 {
            i = i + 1;
            continue;
        }
        var step: usize = 0;
        if (v & 224) == 192 {
            step = 2;
        } else if (v & 240) == 224 {
            step = 3;
        } else if (v & 248) == 240 {
            step = 4;
        } else {
            return false;
        }
        if i + step > n {
            return false;
        }
        var k: usize = 1;
        while k < step {
            const cont: i32 = p[i + k] as i32;
            if (cont & 192) != 128 {
                return false;
            }
            k = k + 1;
        }
        i = i + step;
    }
    return true;
}
