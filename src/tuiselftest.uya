    c.tui = false;
    c.tui_headless = false;
    const rc: i32 = agent_run_interactive(&c);
    sys_exit(rc);
}

fn tui_pty_round(tag: &const byte) bool {
    var ok: bool = true;
    mock_mode = 0;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    const wsdir: &const byte = "build/selftest_ws_tui_pty" as &const byte;
    if !ws_prepare(wsdir) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", &ok);
        return false;
    }

    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", &ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return false;
    }
    var before: [byte: 60] = [0: 60];
    const have_before: bool = tuis_get_termios(m, &before[0]);
    if !have_before {
        tuis_fail(tag, "读不到 pty 的 termios", &ok);
    }

    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", &ok);
        return false;
    };
    if cpid64 == 0 {
        tuis_child_run_tui(&slave_path, port, wsdir);
        sys_exit(3);
        return false;
    }
    const cpid: i32 = tuis_i32(cpid64);

    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    // 首帧（子进程进 raw 之后才会画）
    tuis_drain(m, &cap, 40);
    if !tuis_has(&cap, "\x1b[?1049h" as &const byte) {
        tuis_fail(tag, "没有进备用屏幕（ESC[?1049h）", &ok);
    }
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案", &ok);
    }
    if !tuis_has(&cap, "Build" as &const byte) {
        tuis_fail(tag, "首屏没有面板信息行", &ok);
        tuis_dump_cap(&cap, 1200);
    }
    if tuis_has(&cap, "Current runtime context" as &const byte) {
        tuis_fail(tag, "注入类消息（运行时上下文）被当成用户条目回了屏幕", &ok);
    }
    // P22：终端标题 —— 进界面时先压标题栈 + 上基标题（`uya-agent · <工作目录名>`）
    if !tuis_has(&cap, "\x1b[22t" as &const byte) {
        tuis_fail(tag, "没有压标题栈（ESC[22t）", &ok);
    }
    if !tuis_has(&cap, "\x1b]2;uya-agent · selftest_ws_tui_pty\x07" as &const byte) {
        tuis_fail(tag, "起始标题不是 `uya-agent · <工作目录名>`", &ok);
        tuis_dump_cap(&cap, 800);
    }
    // 首帧捕获里只该有一条 OSC 2：标题不是每帧重写的
    if tuis_count(&cap, "\x1b]2;" as &const byte) != 1 {
        tuis_fail(tag, "起始捕获里的 OSC 2 条数不为 1（标题被重复写了）", &ok);
        tuis_puts("  实际 = ");
        tuis_num(tuis_count(&cap, "\x1b]2;" as &const byte));
        tuis_puts("\n");
    }
    // 发任务（此时子进程已经在 raw 模式，不会被行规程回显污染）
    var task: [byte: 64] = "把 hello-selftest 写进 note.txt\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    tuis_drain(m, &cap, 60);
    if !tuis_has(&cap, "SELFTEST_OK" as &const byte) {
        tuis_fail(tag, "转录里没有出现 mock 的最终答案", &ok);
    }
    // P22：第一条用户消息派生出的标题（前 5 个词 / ≤40 B）必须跟着上终端
    if !tuis_has(&cap, "\x1b]2;把 hello-selftest 写进 note.txt\x07" as &const byte) {
        tuis_fail(tag, "用户消息之后终端标题没有跟到会话标题上", &ok);
        tuis_dump_tail(&cap, 800);
    }
    if tuis_count(&cap, "\x1b]2;" as &const byte) != 2 {
        tuis_fail(tag, "OSC 2 条数不为 2（基标题 + 会话标题各一次）", &ok);
        tuis_puts("  实际 = ");
        tuis_num(tuis_count(&cap, "\x1b]2;" as &const byte));
        tuis_puts("\n");
    }
    // SIGWINCH：缩放 + 信号，进程必须活着并且继续画
    const mark_len: usize = cap.len;
    tuis_set_winsize(m, 120, 40);
    _ = sys_kill(cpid as i64, SIGWINCH) catch {};
    var spin: i32 = 0;
    tuis_drain(m, &cap, 20);
    var after_resize: [byte: 1] = [32];      // 空格：任何一次重绘都会带出字节
    tuis_write_master(m, &after_resize[0], 1);
    tuis_drain(m, &cap, 20);
    _ = spin;
    if cap.len <= mark_len {
        tuis_fail(tag, "SIGWINCH 之后没有任何新帧（界面没重排或进程死了）", &ok);
        tuis_puts("  cap before=");
        tuis_num(mark_len);
        tuis_puts(" after=");
        tuis_num(cap.len);
        tuis_puts(" alive=");
        if tuis_child_alive(cpid) {
            tuis_puts("yes" as &const byte);
        } else {
            tuis_puts("no" as &const byte);
        }
        tuis_puts("\n");
        tuis_dump_tail(&cap, 1200);
    }
    if !tuis_child_alive(cpid) {
        tuis_fail(tag, "SIGWINCH 之后子进程不见了（提前退出或崩了）", &ok);
        tuis_dump_cap(&cap, 1500);
    }
    // 退出：先把输入清掉（空格），再敲 `/exit` + 回车。
    // 这里刻意**不用** Ctrl-D：Ctrl-D 走的是「空行退出」的键位路径，不经过命令分派，
    // 所以它测不出「命令返回值被丢掉」那个 bug。`/exit` 才是那条路径 —— 真终端里
    // 主循环不再 headless 自退，能不能退完全取决于 stop 有没有被尊重。
    var bs: [byte: 1] = [127];
    tuis_write_master(m, &bs[0], 1);
    tuis_drain(m, &cap, 6);
    var exit_cmd: [byte: 6] = "/exit";
    exit_cmd[5] = 13;
    tuis_write_master(m, &exit_cmd[0], 6);
    tuis_drain(m, &cap, 30);

    var st: i32 = 0;
    if !tuis_wait_raw(cpid, &st, 20000) {
        tuis_fail(tag, "/exit 之后子进程没有退出（命令的返回值被丢了？）", &ok);
        _ = sys_kill(cpid as i64, SIGKILL) catch {};
    } else {
        const code: i32 = (st >> (8 as i32)) & 255;
        if code != 0 {
            tuis_fail(tag, "TUI 退出码不是 0", &ok);
            tuis_puts("  code=");
            tuis_num(code as usize);
            tuis_puts("\n");
            tuis_dump_cap(&cap, 4000);
        }
    }
    if !tuis_has(&cap, "\x1b[?1049l" as &const byte) {
        tuis_fail(tag, "退出时没有离开备用屏幕（ESC[?1049l）", &ok);
    }
    // P22：退出时弹标题栈，而且必须在最后一条 OSC 2 之后
    if !tuis_has(&cap, "\x1b[23t" as &const byte) {
        tuis_fail(tag, "退出时没有弹标题栈（ESC[23t）", &ok);
    } else if tuis_last_at(&cap, "\x1b[23t" as &const byte) < tuis_last_at(&cap, "\x1b]2;" as &const byte) {
        tuis_fail(tag, "弹标题栈出现在标题之前（顺序反了）", &ok);
    }
    // termios 逐位还原
    if have_before {
        var after: [byte: 60] = [0: 60];
        if !tuis_get_termios(m, &after[0]) {
            tuis_fail(tag, "退出后读不到 pty termios", &ok);
        } else if !tuis_termios_equal(&before[0], &after[0]) {
            tuis_fail(tag, "退出后 termios 没有与 fork 前逐位相同（raw 模式没还原）", &ok);
        }
    }
    _ = sys_close(m) catch {};
    const mock_rc: i32 = wait_child(mpid);
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错", &ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
        tuis_dump_cap(&cap, 500);
        tuis_dump_tail(&cap, 800);
    }

    if ok {
        tuis_ok(tag, "真 PTY：备用屏幕进出 + 帧内容 + SIGWINCH 存活 + /exit 退出 + termios 逐位还原 + 终端标题（压栈/基标题/跟随会话标题/弹栈）");
    }
    return ok;
}

// ============================================================
// tty-title-pty（P22）：滚动模式的终端标题（真 PTY）
//
// 为什么单独一轮：tui-pty 那轮覆盖的是「备用屏幕 + 私有 dup fd」那条路；
// 滚动模式是另一条完全独立的接线（显示通道 fd 2、没有备用屏幕、`sigx_arm(2,false,true)`），
// 而且是 `--no-tui` 用户的唯一模式 —— 标题必须同样跟着会话标题走。
// ============================================================
fn tty_title_pty_round(tag: &const byte) bool {
    var ok: bool = true;
    mock_mode = 0;              // shell 轮：write → bash → 最终答案
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    const wsdir: &const byte = "build/selftest_ws_tty_title" as &const byte;
    if !ws_prepare(wsdir) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", &ok);
        return false;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", &ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return false;
    }
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork 滚动模式失败", &ok);
        return false;
    };
    if cpid64 == 0 {
        tuis_child_run_scroll(&slave_path, port, wsdir);
        sys_exit(3);
        return false;
    }
    const cpid: i32 = tuis_i32(cpid64);

    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 40);
    if !tuis_has(&cap, "\x1b[22t" as &const byte) {
        tuis_fail(tag, "滚动模式没有压标题栈（ESC[22t）", &ok);
    }
    if !tuis_has(&cap, "\x1b]2;uya-agent · selftest_ws_tty_title\x07" as &const byte) {
        tuis_fail(tag, "滚动模式的起始标题不是 `uya-agent · <工作目录名>`", &ok);
        tuis_dump_cap(&cap, 800);
    }
    if tuis_count(&cap, "\x1b]2;" as &const byte) != 1 {
        tuis_fail(tag, "起始捕获里的 OSC 2 条数不为 1", &ok);
    }
    var task: [byte: 64] = "把 tty-title 写进 note.txt\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    tuis_drain(m, &cap, 60);
    if !tuis_has(&cap, "\x1b]2;把 tty-title 写进 note.txt\x07" as &const byte) {
        tuis_fail(tag, "滚动模式下终端标题没有跟到会话标题上", &ok);
        tuis_dump_tail(&cap, 800);
    }
    if !tuis_has(&cap, "SELFTEST_OK" as &const byte) {
        tuis_fail(tag, "滚动模式里没有跑完这一轮（mock 的最终答案没出现）", &ok);
    }
    // 退出：空行上 Ctrl-D
    var ctrl_d: [byte: 1] = [4];
    tuis_write_master(m, &ctrl_d[0], 1);
    tuis_drain(m, &cap, 40);

    var st: i32 = 0;
    if !tuis_wait_raw(cpid, &st, 20000) {
        tuis_fail(tag, "Ctrl-D 之后子进程没有退出", &ok);
        _ = sys_kill(cpid as i64, SIGKILL) catch {};
    } else {
        const code: i32 = (st >> (8 as i32)) & 255;
        if code != 0 {
            tuis_fail(tag, "滚动模式退出码不是 0", &ok);
            tuis_puts("  code=");
            tuis_num(code as usize);
            tuis_puts("\n");
            tuis_dump_cap(&cap, 2000);
        }
    }
    if !tuis_has(&cap, "\x1b[23t" as &const byte) {
        tuis_fail(tag, "滚动模式退出时没有弹标题栈（ESC[23t）", &ok);
    } else if tuis_last_at(&cap, "\x1b[23t" as &const byte) < tuis_last_at(&cap, "\x1b]2;" as &const byte) {
        tuis_fail(tag, "弹标题栈出现在标题之前（顺序反了）", &ok);
    }
    if tuis_has(&cap, "\x1b[?1049h" as &const byte) {
        tuis_fail(tag, "滚动模式不该进备用屏幕", &ok);
    }
    _ = sys_close(m) catch {};
    const mock_rc: i32 = wait_child(mpid);
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错", &ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
        tuis_dump_cap(&cap, 500);
    }
    if ok {
        tuis_ok(tag, "真 PTY：滚动模式（--no-tui）的压栈 / 基标题 / 跟随会话标题 / 弹栈");
    }
    return ok;
}

// ============================================================
// tui-access：访问模式（P21）—— chip / shift+tab 选择器 / Full access 风险确认
//
// 纯排版 + 键控，不碰 LLM。每走一步都过一遍 tuis_scan_rows（宽度 + 正文层无 ESC）。
// 选择器走的是主循环那条路：shift+tab 只置请求 → agent_tui_access_open() 开浮层 →
// 键选 → tui_overlay_take() 取走条目原文 → agent_tui_access_handle() 落到策略上。
// ============================================================

// 第 6 步（palette 派发回归）用的命令表：/status 必须真有一行
const TUIS_ACC_CMDS: &const byte = "/status    当前配置与会话信息\n/help      显示帮助浮层\n" as &const byte;

fn tui_access_round(tag: &const byte) bool {
    var ok: bool = true;
    var sel: Buf = buf_new(4096);
    defer { buf_free(&sel); }
    var mtxt: Buf = buf_new(4096);
    defer { buf_free(&mtxt); }

    // ---- 1) chip：三级模式都要画在面板信息行上 ----
    tuis_reset(100, 28);
    perm_set(PERM_READ_ONLY);
    tui_set_access(PERM_READ_ONLY);
    var m: u8 = 0;
    while true {
        tui_set_access(m);
        tui_build();
        tuis_scan_rows(100, &ok, tag);
        if tui_access() != m {
            tuis_fail(tag, "chip 跟不上 tui_set_access（tui_access() 与设置的不一致）", &ok);
        }
        var shown: bool = false;
        var on_info: bool = false;
        var r: usize = 0;
        while r < tui_nrows() {
            if tui_row_has(r, perm_label(m)) {
                shown = true;
                // chip 与 Build/Plan、模型名共用同一行信息行
                if tui_row_has(r, "Build" as &const byte) {
                    on_info = true;
                }
            }
            r = r + 1;
        }
        if !shown {
            tuis_fail(tag, "屏幕上没有该模式的显示名（chip 没有画出来）", &ok);
        }
        if !on_info {
            tuis_fail(tag, "面板信息行（Build / Plan 那一行）上没有 chip", &ok);
        }
        if m == PERM_FULL_ACCESS {
            break;
        }
        m = m + 1;
    }
    tui_set_access(PERM_READ_ONLY);

    // ---- 2) 空输入 shift+tab → 打开选择器 ----
    tui_input_clear();
    tui_keys_inject("\x1b[Z" as &const byte, 3);
    // 键层只置「请求」；浮层是主循环拿到请求之后才开的（agent.uya:5870-5871 的那一步）
    if tui_take_request() != TUI_REQ_ACCESS {
        tuis_fail(tag, "空输入下 shift+tab 没有给出「打开访问模式选择器」的请求", &ok);
    }
    agent_tui_access_open();
    if !tui_overlay_open() {
        tuis_fail(tag, "选择器没有打开", &ok);
    } else if tui_overlay_kind() != TUI_OVK_ACCESS {
        tuis_fail(tag, "选择器的 kind 不是 TUI_OVK_ACCESS", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has(perm_label(PERM_READ_ONLY)) || !tuis_screen_has(perm_label(PERM_WORKSPACE_WRITE)) || !tuis_screen_has(perm_label(PERM_FULL_ACCESS)) {
        tuis_fail(tag, "选择器里没有列全三级模式", &ok);
    }
    if !tuis_screen_has("╭" as &const byte) || !tuis_screen_has("╰" as &const byte) {
        tuis_fail(tag, "选择器没有画圆角边框", &ok);
    }
    var cur_marked: bool = false;
    var other_marked: bool = false;
    var r2: usize = 0;
    while r2 < tui_nrows() {
        if tui_row_has(r2, "✓" as &const byte) {
            if tui_row_has(r2, perm_label(PERM_READ_ONLY)) {
                cur_marked = true;
            } else {
                other_marked = true;
            }
        }
        r2 = r2 + 1;
    }
    if !cur_marked {
        tuis_fail(tag, "当前模式（Read Only）那一行没有 ✓ 标记", &ok);
    }
    if other_marked {
        tuis_fail(tag, "非当前模式的行也带了 ✓", &ok);
    }

    // ---- 3) Esc 取消：什么都不改 ----
    tui_keys_inject("\x1b" as &const byte, 1);
    if !tui_overlay_cancelled() {
        tuis_fail(tag, "选择器里按 Esc 没有走「取消」", &ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "Esc 之后选择器还开着", &ok);
    }
    if perm_get() != PERM_READ_ONLY {
        tuis_fail(tag, "取消之后访问模式被改了", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);

    // ---- 4) 选中 Workspace Write → 交给 agent 的处理函数 ----
    perm_set(PERM_READ_ONLY);
    tui_set_access(PERM_READ_ONLY);
    agent_tui_access_open();
    tui_keys_inject("\x1b[B" as &const byte, 3);   // ↓ → 第 2 项
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "选择器没有把选中项交出来", &ok);
    } else if !tuis_has(&sel, perm_label(PERM_WORKSPACE_WRITE)) {
        tuis_fail(tag, "↓ + 回车没有选中 Workspace Write 那一行", &ok);
    }
    if sel.len == 0 {
        tuis_fail(tag, "选择器交回的选中项是空的", &ok);
    }
    var c: Config = cfg_default();
    c.sandbox = SAN_OFF;              // 自测不测沙箱：别让机器上有没有 bwrap 影响结果
    c.access = PERM_FULL_ACCESS;      // 故意给个「启动值是旧的」的配置：切换必须把 cfg.access 一起同步
    var h: History = hist_init();
    if !agent_tui_access_handle(&c, &h, &sel) {
        tuis_fail(tag, "选择器交回的结果没有被处理器接住", &ok);
    }
    if perm_get() != PERM_WORKSPACE_WRITE {
        tuis_fail(tag, "选中 Workspace Write 之后进程级访问模式没有变", &ok);
    }
    if tui_access() != PERM_WORKSPACE_WRITE {
        tuis_fail(tag, "选中之后 chip 没有跟上", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has(perm_label(PERM_WORKSPACE_WRITE)) {
        tuis_fail(tag, "屏幕上的 chip 不是 Workspace Write", &ok);
    }
    if !tuis_screen_has(perm_notice(PERM_WORKSPACE_WRITE)) {
        tuis_fail(tag, "切换之后转录里没有访问模式通知", &ok);
    }
    if h.len != 1 {
        tuis_fail(tag, "切换之后应当往历史里推「恰好一条」运行时上下文消息", &ok);
    } else {
        const m4: &const Msg = msg_at(&h, 0);
        if m4.text_len < 23 || !bufx_mem_eq(m4.text as &const byte, "Current runtime context" as &const byte, 23) {
            tuis_fail(tag, "推给模型的消息不是以 Current runtime context 开头", &ok);
        }
        buf_reset(&mtxt);
        _ = buf_append(&mtxt, m4.text as &const byte, m4.text_len);
        if !tuis_has(&mtxt, perm_name(PERM_WORKSPACE_WRITE)) {
            tuis_fail(tag, "推给模型的快照里没有新模式（workspace-write）", &ok);
        }
        if !tuis_has(&mtxt, "Current uya-agent file policy: workspace-write" as &const byte) {
            tuis_fail(tag, "推给模型的快照里没有新模式那条策略句", &ok);
        }
        if tuis_has(&mtxt, "Current uya-agent file policy: full access" as &const byte) {
            tuis_fail(tag, "推给模型的快照还是启动时那条旧策略（cfg.access 没跟上）", &ok);
        }
    }
    if tuis_screen_has("Current runtime context" as &const byte) {
        tuis_fail(tag, "注入的运行时上下文被当成用户条目打到屏幕上了", &ok);
    }
    hist_free(&h);

    // 运行中切换的第二条线：cfg.access 是启动时那一份，快照必须跟着新模式走
    // （agent_set_access 会把 cfg.access 一起同步，否则模型看到的还是旧策略）
    perm_set(PERM_READ_ONLY);
    tui_set_access(PERM_READ_ONLY);
    c.access = PERM_READ_ONLY;
    h = hist_init();
    agent_set_access(&c, &h, PERM_WORKSPACE_WRITE, true);
    if h.len != 1 {
        tuis_fail(tag, "改模式应当往历史里推「恰好一条」运行时上下文消息", &ok);
    } else {
        const m4b: &const Msg = msg_at(&h, 0);
        buf_reset(&mtxt);
        _ = buf_append(&mtxt, m4b.text as &const byte, m4b.text_len);
        if !tuis_has(&mtxt, perm_name(PERM_WORKSPACE_WRITE)) {
            tuis_fail(tag, "运行中切换之后模型看到的还是旧策略（cfg.access 没跟上）", &ok);
        }
    }
    hist_free(&h);

    // ---- 5) Full access：先过一道风险确认（游标默认停在「取消」上）----
    perm_set(PERM_WORKSPACE_WRITE);
    tui_set_access(PERM_WORKSPACE_WRITE);
    h = hist_init();
    agent_tui_access_open();
    tui_keys_inject("\x1b[B" as &const byte, 3);   // ↓
    tui_keys_inject("\x1b[B" as &const byte, 3);   // ↓ → 第 3 项（Full access）
    tui_keys_inject("\r" as &const byte, 1);
    var took5: bool = false;
    if tui_overlay_take(&sel) {
        took5 = true;
    }
    if !took5 {
        tuis_fail(tag, "↓↓ + 回车没有从选择器交回结果", &ok);
    } else if !tuis_has(&sel, perm_label(PERM_FULL_ACCESS)) {
        tuis_fail(tag, "↓↓ + 回车没有选中 Full access 那一行", &ok);
    }
    if !agent_tui_access_handle(&c, &h, &sel) {
        tuis_fail(tag, "Full access 这一项没有被处理器接住", &ok);
    }
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_ACCESS_CONFIRM {
        tuis_fail(tag, "选 Full access 没有翻出「确认启用」那一层（风险闸门没了）", &ok);
    }
    if perm_get() != PERM_WORKSPACE_WRITE {
        tuis_fail(tag, "风险确认还没过，模式就被改掉了", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("确认启用 Full access？" as &const byte) {
        tuis_fail(tag, "确认浮层里没有「确认启用 Full access？」", &ok);
    }
    if !tuis_screen_has("启用 Full access" as &const byte) || !tuis_screen_has("取消" as &const byte) {
        tuis_fail(tag, "确认浮层里没有两个选项", &ok);
    }
    if tui_overlay_sel_index() != 1 {
        tuis_fail(tag, "确认浮层的游标没有默认停在「取消」上（危险默认值）", &ok);
    }
    // 直接回车 = 选「取消」→ 什么都不能变
    tui_keys_inject("\r" as &const byte, 1);
    var took5b: bool = false;
    if tui_overlay_take(&sel) {
        took5b = true;
    }
    if !took5b {
        tuis_fail(tag, "确认浮层没有交回结果", &ok);
    } else if !bufx_eq_cstr(sel.ptr as &const byte, sel.len, "取消" as &const byte) {
        tuis_fail(tag, "确认浮层里直接回车选中的不是「取消」", &ok);
    }
    if !agent_tui_access_handle(&c, &h, &sel) {
        tuis_fail(tag, "确认浮层的「取消」没有被处理器接住", &ok);
    }
    if perm_get() != PERM_WORKSPACE_WRITE || tui_access() != PERM_WORKSPACE_WRITE {
        tuis_fail(tag, "在确认浮层里按「取消」，模式却被改了", &ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "确认浮层取消之后还开着", &ok);
    }
    // 再来一次：↑ 到「启用 Full access」→ 这时才允许切
    agent_tui_access_open();
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\r" as &const byte, 1);
    var took5d: bool = false;
    if tui_overlay_take(&sel) {
        took5d = true;
    }
    if !took5d {
        tuis_fail(tag, "第二次 ↓↓ + 回车没有交回结果", &ok);
    } else if !tuis_has(&sel, perm_label(PERM_FULL_ACCESS)) {
        tuis_fail(tag, "第二次没有选中 Full access 那一行", &ok);
    }
    _ = agent_tui_access_handle(&c, &h, &sel);
    if tui_overlay_kind() != TUI_OVK_ACCESS_CONFIRM {
        tuis_fail(tag, "第二次选 Full access 没有翻出确认层", &ok);
    }
    tui_keys_inject("\x1b[A" as &const byte, 3);   // ↑ 到「启用 Full access」
    tui_keys_inject("\r" as &const byte, 1);
    var took5c: bool = false;
    if tui_overlay_take(&sel) {
        took5c = true;
    }
    if !took5c {
        tuis_fail(tag, "确认浮层（↑ + 回车）没有交回结果", &ok);
    } else if !bufx_eq_cstr(sel.ptr as &const byte, sel.len, "启用 Full access" as &const byte) {
        tuis_fail(tag, "↑ + 回车没有选中「启用 Full access」", &ok);
    }
    if !agent_tui_access_handle(&c, &h, &sel) {
        tuis_fail(tag, "确认浮层的「启用 Full access」没有被处理器接住", &ok);
    }
    if perm_get() != PERM_FULL_ACCESS {
        tuis_fail(tag, "批准之后进程级访问模式不是 Full access", &ok);
    }
    if tui_access() != PERM_FULL_ACCESS {
        tuis_fail(tag, "批准之后 chip 没有切到 Full access", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has(perm_label(PERM_FULL_ACCESS)) {
        tuis_fail(tag, "批准之后面板上没有 Full access 的 chip", &ok);
    }
    hist_free(&h);
    cfg_free(&c);

    // ---- 6) 回归：浮层结果不许被静默丢掉（palette 里选 /status 必须真的派发）----
    // 这一类缺陷最初的样子是「take 之后 tui_overlay_kind() 读到 0」——palette /
    // /sessions / 访问模式的结果全被吞掉。这里跑**真实主循环**（agent_run_tui）：
    //   6a) shift+tab：键层只置请求，浮层必须由主循环开出来；
    //   6b) 打 "/" 开命令面板 → 用 "status" 过滤到那一行 → 回车 → 主循环把选中项
    //       当命令派发 → /status 把状态浮层开出来，并把选中行回显进转录。
    const wsa: &const byte = "build/selftest_ws_tui_access" as &const byte;
    if !ws_prepare(wsa) {
        tuis_fail(tag, "工作目录准备失败（palette 回归）", &ok);
    } else {
        var c6: Config = cfg_default();
        c6.sandbox = SAN_OFF;
        c6.access = PERM_WORKSPACE_WRITE;
        perm_set(PERM_WORKSPACE_WRITE);
        cfg_pin_api(&c6, LLM_STYLE_CHAT);
        c6.base_url = buf_new(64);
        _ = buf_append_cstr(&c6.base_url, "http://127.0.0.1:1/v1");   // 这一轮不发请求
        c6.model = buf_new(32);
        _ = buf_append_cstr(&c6.model, "selftest-model");
        c6.api_key = buf_new(32);
        _ = buf_append_cstr(&c6.api_key, "selftest-key");
        c6.workspace = buf_new(strlen(wsa) + 8);
        _ = buf_append_cstr(&c6.workspace, wsa);
        c6.task = buf_empty();
        c6.verify = HC_VERIFY_NONE;
        c6.allow_shell = true;
        c6.stream = true;
        c6.quiet = false;
        c6.max_steps = 4;
        c6.timeout_ms = 15000;
        c6.agent_home = buf_new(64);
        _ = buf_append_cstr(&c6.agent_home, "build/selftest_agent_home");
        c6.tui = true;
        c6.tui_headless = true;
        c6.tui_cols = 100;
        c6.tui_rows = 30;
        // 6a) shift+tab 走真实主循环：键层只置请求，浮层由主循环开
        tui_reset_all();
        tui_set_headless(true);
        tui_set_size(100, 30);
        tui_set_color(false, false);
        tui_begin_session();
        tui_sink_flush_partial();
        tui_keys_inject("\x1b[Z" as &const byte, 3);
        const rc6a: i32 = agent_run_tui(&c6);
        if rc6a != AGENT_OK {
            tuis_fail(tag, "shift+tab 那一轮以非 0 退出", &ok);
        }
        tui_build();
        tuis_scan_rows(100, &ok, tag);
        if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_ACCESS {
            tuis_fail(tag, "shift+tab 之后主循环没有把访问模式选择器打开", &ok);
        }
        if !tuis_screen_has(perm_label(perm_get())) {
            tuis_fail(tag, "shift+tab 开出来的选择器里没有当前模式那一行", &ok);
        }
        tui_overlay_close();
        // 6b) palette → /status：主循环必须真的派发（结果是 take 之后才读 kind 的）
        tui_reset_all();
        tui_set_headless(true);
        tui_set_size(100, 30);
        tui_set_color(false, false);
        tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
        tui_begin_session();
        tui_sink_flush_partial();
        tui_keys_inject("/" as &const byte, 1);
        if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_PALETTE {
            tuis_fail(tag, "输入 / 没有打开命令面板", &ok);
        }
        tui_keys_inject("status" as &const byte, 6);   // 过滤到 /status 那一行
        tui_keys_inject("\r" as &const byte, 1);       // 取走它 → 主循环派发
        const rc6: i32 = agent_run_tui(&c6);
        if rc6 != AGENT_OK {
            tuis_fail(tag, "palette 回归那一轮以非 0 退出", &ok);
        }
        tui_build();
        tuis_scan_rows(100, &ok, tag);
        if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
            tuis_fail(tag, "命令面板选 /status 之后没有开出状态浮层（结果被丢了？）", &ok);
        }
        if !tuis_screen_has("状态（esc 关闭）" as &const byte) {
            tuis_fail(tag, "状态浮层的标题没出现", &ok);
        }
        if !tuis_screen_has("permission" as &const byte) {
            tuis_fail(tag, "状态浮层里没有 permission 那一行（内容没渲染？）", &ok);
        }
        // 状态浮层盖住转录中段：收掉它，再看「主循环把命令面板选中项回显进转录」那一行
        tui_overlay_close();
        tui_build();
        tuis_scan_rows(100, &ok, tag);
        if !tuis_screen_has("/status" as &const byte) {
            tuis_fail(tag, "转录里没有命令面板选中的那一行回显", &ok);
        }
        // 6c) /help 必须开**帮助浮层**（不是滚动模式的纯文本帮助）：
        //     README 的「浮层」清单与命令表注释一直这么写，但这条分支曾经缺失
        tui_reset_all();
        tui_set_headless(true);
        tui_set_size(100, 30);
        tui_set_color(false, false);
        tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
        tui_begin_session();
        tui_sink_flush_partial();
        tui_input_set("/help" as &const byte, 5);
        tui_keys_inject("\r" as &const byte, 1);
        const rc6c: i32 = agent_run_tui(&c6);
        if rc6c != AGENT_OK {
            tuis_fail(tag, "/help 那一轮以非 0 退出", &ok);
        }
        tui_build();
        if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
            tuis_fail(tag, "/help 没有开出帮助浮层（掉回滚动模式的纯文本帮助了？）", &ok);
        }
        // 浮层顶边是 "╭─ 帮助…"；正文在窄画布下会被裁剪，所以只钉标题
        if !tuis_screen_has("╭─ 帮助" as &const byte) {
            tuis_fail(tag, "帮助浮层没有画到屏幕上", &ok);
        }
        tui_overlay_close();

        cfg_free(&c6);
        tui_set_headless(false);
        tui_headless_enable(false);
        tty_sink_on = false;
    }

    if ok {
        tuis_ok(tag, "chip 三级 + shift+tab 选择器（条目/✓/边框/取消）+ 选中即生效 + Full access 两道闸门 + palette 派发回归 + /help 浮层");
    }
    return ok;
}

// ============================================================
// tui-approve：read-only 下 bash 的逐条批准（P21）
//
// 分两段：
//   A) headless 回合 + mock LLM（与 tui-turn 同一条注入路径）。headless 下注入的键
//      到不了审批浮层：tui_confirm_wait 开浮层前会 tui_key_reset() 把排队键丢掉，
//      注入队列一空就等于「没人回答」→ 一律拒绝。这一段把这条 fail-closed 语义钉死：
//      拒绝文案进转录、命令一个字节都没跑、而且**不是**「没有回答渠道」。
//   B) 真 PTY：批准路径只有在「浮层等待期间还能送键」的真终端上才走得通 —— 父进程
//      等浮层画出来之后敲 ↑ + 回车，命令真的跑起来（stdout 标记进转录），
//      mock 在第二封请求里核对带回的工具结果。
// ============================================================

const TUIS_AP_MARK: &const byte = "TUI-APPROVE-OK" as &const byte;
const TUIS_AP_DONE: &const byte = "TUI-APPROVE-DONE" as &const byte;
const TUIS_AP_TASK: &const byte = "run the bash marker (TUI-APPROVE)" as &const byte;
const TUIS_AP_DENY: &const byte = "the user denied this bash command in read-only mode" as &const byte;
// 这条必须够**具体**：mock 拿它断言「第二封请求里不许出现 fail-closed 文案」，
// 而请求体里带着全部工具的**描述** —— 短到 "no answer channel" 这种通用短语，
// 别的工具描述（P34 的 workspace）一撞上就成了假阳性（实测踩过）。
const TUIS_AP_NOCHAN: &const byte = "bash needs per-command approval in read-only mode" as &const byte;
const TUIS_AP_TITLE: &const byte = "Read Only：批准这条 bash 命令？" as &const byte;
const TUIS_AP_CONFIRM_ROW: &const byte = "批准并执行" as &const byte;

var tuis_ap_deny: bool = false;

// 一封「跑一条 bash」的响应体。命令里的标记用 $(printf OK) 拼出来：这样工具调用的
// **arguments** 里没有字面量 TUI-APPROVE-OK，第二封请求里出现它就只能是「命令真跑了」。
fn tuis_ap_toolcall_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-tui-approve");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    mock_call(&w, "call_ap", "bash", "{\"command\":\"echo TUI-APPROVE-$(printf OK)\",\"description\":\"echo the approval marker\"}");
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// 本轮专用 mock（形状抄 selftest.uya 的 mock_server，只服务一封固定的工具调用 + 一封断言）
fn tuis_ap_mock(lfd: i32) i32 {
    var round: i32 = 0;
    var verdict: i32 = 0;
    while round < 2 {
        var lpfds: [PollFd: 1] = [PollFd{ fd: lfd, events: POLLIN, revents: 0 }];
        const lpr: i32 = sys_poll(&lpfds[0], 1, 10000) catch { 0; };
        if lpr <= 0 || (lpfds[0].revents & POLLIN) == 0 {
            if verdict == 0 && round < 2 {
                return 62 + round;   // 请求数不够：也算失败，别把「断言没跑」当通过
            }
            return verdict;
        }
        var peer: [byte: 16] = [0: 16];
        var alen: u32 = 16;
        const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch { return 10; };
        var rx: Buf = buf_new(8192);
        if !mock_read_request(cfd, &rx) {
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            return 11;
        }
        const is_stream: bool = contains(&rx, "\"stream\":true");
        var body: Buf = buf_new(4096);
        if round == 0 {
            if !contains(&rx, "\"name\":\"bash\"") {
                verdict = 71;   // bash 工具必须在 schema 里（read-only 下也要能请求）
            }
            if !contains(&rx, "TUI-APPROVE") {
                verdict = 72;   // 任务文本必须真的进了历史
            }
            if !tuis_ap_toolcall_body(&body) {
                verdict = 73;
            }
        } else {
            if contains(&rx, TUIS_AP_NOCHAN) {
                verdict = 74;   // 审批浮层开着 = 有回答渠道
            }
            if tuis_ap_deny {
                if !contains(&rx, TUIS_AP_DENY) {
                    verdict = 75;   // 拒绝文案必须回到模型面前
                }
                if contains(&rx, TUIS_AP_MARK) {
                    verdict = 76;   // 拒绝了就不许有 stdout 标记
                }
                if contains(&rx, "[exit code: 0]") {
                    verdict = 77;   // 拒绝了就不该有退出码信封
                }
            } else {
                if !contains(&rx, TUIS_AP_MARK) {
                    verdict = 78;   // 批准之后命令必须真的跑过
                }
                if !contains(&rx, "[exit code: 0]") {
                    verdict = 79;
                }
            }
            if !mock_final_body(&body, TUIS_AP_DONE) {
                verdict = 80;
            }
        }
        var sent: bool = false;
        if is_stream {
            sent = mock_send_sse(cfd, &body);
        } else {
            sent = mock_send(cfd, &body);
        }
        if !sent {
            verdict = 81;
        }
        buf_free(&body);
        buf_free(&rx);
        _ = sys_close(cfd) catch {};
        round = round + 1;
    }
    return verdict;
}

// fork 出 mock（形状与 tuis_start_mock 相同，只换子进程里跑的那个 server）
fn tuis_ap_start_mock(deny: bool, mpid: &i32) u16 {
    tuis_ap_deny = deny;
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch { return 0; };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    if (sys_bind(lfd, &addr[0] as &void, 16 as u32) catch { -1; }) != 0 {
        _ = sys_close(lfd) catch {};
        return 0;
    }
    _ = sys_listen(lfd, 4) catch {};
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {};
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return 0;
    };
    if pid64 == 0 {
        const rc0: i32 = tuis_ap_mock(lfd);
        sys_exit(rc0);
    }
    mpid[0] = tuis_i32(pid64);
    _ = sys_close(lfd) catch {};
    return port;
}

// read-only + headless：注入任务 → mock 要 bash → 审批浮层等不到键 → 拒绝
fn tuis_ap_headless_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_ap" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return;
    }
    var mpid: i32 = -1;
    const port: u16 = tuis_ap_start_mock(true, &mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var c: Config = cfg_default();
    c.sandbox = SAN_OFF;          // 自测不测沙箱：别让机器上有没有 bwrap 影响结果
    c.access = PERM_READ_ONLY;    // 最严的一级：bash 必须逐条批准
    perm_set(PERM_READ_ONLY);     // 模式是进程级状态，显式同步一次
    cfg_pin_api(&c, LLM_STYLE_CHAT);
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append_cstr(&c.task, TUIS_AP_TASK);
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.quiet = false;
    c.tool_lines = 8;             // 工具正文要看得见（拒绝文案在结果里）
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    c.tui = true;
    c.tui_headless = true;
    c.tui_cols = 100;
    c.tui_rows = 30;

    // 注入「任务 + 回车」：与用户在 TUI 里手打完全同一条路径
    tui_reset_all();
    tui_set_headless(true);
    tui_set_size(100, 30);
    tui_set_color(false, false);
    tui_begin_session();
    tui_sink_flush_partial();
    tui_keys_inject(c.task.ptr as &const byte, c.task.len);
    tui_keys_inject("\r" as &const byte, 1);
    // 规格要的是「审批浮层起来时只按了回车」。headless 下这条键到不了浮层：
    // tui_confirm_wait 开浮层前先 tui_key_reset() 把排队键丢掉，注入队列一空就
    // 等于「没人回答」→ 拒绝。这里额外注的 \r 只是空输入上的无效提交；
    // 真正的语义由下面的断言钉死：没有键 = 拒绝（fail closed）。
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_has_submit() {
        tuis_fail(tag, "注入回车之后没有待取走的提交", ok);
    }

    const rc: i32 = agent_run_tui(&c);
    const mock_rc: i32 = wait_child(mpid);

    // headless 下「没人回答」是 tui_confirm_wait 的提前收工路径（tui.uya:3546-3549）：
    // 它必须把审批浮层收掉，否则浮层会一直盖在转录上、把最后几条条目挡掉。
    if tui_overlay_open() {
        tuis_fail(tag, "headless 下没人回答之后，审批浮层还留在屏幕上（转录被挡住）", ok);
        tui_overlay_close();
    }

    if rc != AGENT_OK {
        tuis_fail(tag, "read-only 的一轮却以非 0 退出", ok);
    }
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错（第二封请求里的工具结果不对？）", ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_AP_DENY) {
        tuis_fail(tag, "转录里没有「用户在 read-only 下拒绝了这条 bash」的文案", ok);
    }
    if tuis_screen_has(TUIS_AP_MARK) {
        tuis_fail(tag, "拒绝了，命令的 stdout 标记却出现在转录里（命令跑了？）", ok);
    }
    if tuis_screen_has(TUIS_AP_NOCHAN) {
        tuis_fail(tag, "审批浮层明明开着，却报了「没有回答渠道」（渠道判定不对）", ok);
    }
    if !tuis_screen_has(TUIS_AP_DONE) {
        tuis_fail(tag, "转录里没有 mock 的最终答案", ok);
    }
    if tui_run_kind() != TUI_RUN_IDLE {
        tuis_fail(tag, "回合结束后状态没有回到 idle", ok);
    }
    cfg_free(&c);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
}

// 子进程侧：把 slave 挂到 0/1/2 后跑真 TUI（read-only + 真终端）
fn tuis_ap_child(slave_path: &const Buf, port: u16, ws: &const byte) void {
    const s: i32 = sys_open(slave_path.ptr as *const byte, TUIS_O_RDWR_NOCTTY, 0) catch { -1; };
    if s < 0 {
        sys_exit(9);
    }
    _ = sys_dup2(s, 0) catch {};
    _ = sys_dup2(s, 1) catch {};
    _ = sys_dup2(s, 2) catch {};
    if s > 2 {
        _ = sys_close(s) catch {};
    }
    var c: Config = cfg_default();
    c.sandbox = SAN_OFF;
    c.access = PERM_READ_ONLY;
    perm_set(PERM_READ_ONLY);
    cfg_pin_api(&c, LLM_STYLE_CHAT);
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_empty();
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.quiet = false;
    c.tool_lines = 8;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    c.tui = true;
    c.tui_headless = false;
    const rc: i32 = agent_run_tui(&c);
    sys_exit(rc);
}

// 真 PTY：父进程在审批浮层画出来之后敲 ↑ + 回车 —— 批准路径唯一走得通的形态
fn tuis_ap_pty_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_ap_pty" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return;
    }
    var mpid: i32 = -1;
    const port: u16 = tuis_ap_start_mock(false, &mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    }
    tui_reset_all();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        return;
    };
    if cpid64 == 0 {
        tuis_ap_child(&slave_path, port, ws);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);

    var cap: Buf = buf_new(4194304);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 40);      // 首帧（子进程进 raw 之后才会画）
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案", ok);
    }
    var task: [byte: 64] = "run the bash marker (TUI-APPROVE)\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    // 等审批浮层画出来（标题在正文层里是一段连续字节）
    var seen: bool = false;
    var k: i32 = 0;
    while k < 120 && !seen {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, TUIS_AP_TITLE) {
            seen = true;
        }
        k = k + 1;
    }
    if !seen {
        tuis_fail(tag, "read-only 下 bash 没有弹出逐条批准的浮层", ok);
        tuis_dump_tail(&cap, 1200);
    } else {
        if !tuis_has(&cap, TUIS_AP_CONFIRM_ROW) || !tuis_has(&cap, "拒绝" as &const byte) {
            tuis_fail(tag, "审批浮层里没有「批准并执行 / 拒绝」两行", ok);
        }
        // ↑ 到「批准并执行」再回车（游标默认在「拒绝」上）
        tuis_write_master(m, "\x1b[A\r" as &const byte, 4);
        var got: bool = false;
        var k2: i32 = 0;
        while k2 < 200 && !got {
            tuis_drain(m, &cap, 1);
            if tuis_has(&cap, TUIS_AP_MARK) {
                got = true;
            }
            k2 = k2 + 1;
        }
        if !got {
            tuis_fail(tag, "批准之后转录里没有命令的 stdout 标记（命令没跑？）", ok);
            tuis_dump_tail(&cap, 1500);
        }
        var k3: i32 = 0;
        while k3 < 80 && !tuis_has(&cap, TUIS_AP_DONE) {
            tuis_drain(m, &cap, 1);
            k3 = k3 + 1;
        }
        if !tuis_has(&cap, TUIS_AP_DONE) {
            tuis_fail(tag, "批准之后没有收到 mock 的最终答案", ok);
        }
        if tuis_has(&cap, TUIS_AP_DENY) {
            tuis_fail(tag, "批准了却还是被当成拒绝（浮层里的键没生效）", ok);
        }
    }
    // 退出：先清输入再 Ctrl-D
    var bs: [byte: 1] = [127];
    tuis_write_master(m, &bs[0], 1);
    tuis_drain(m, &cap, 6);
    var ctrl_d: [byte: 1] = [4];
    tuis_write_master(m, &ctrl_d[0], 1);
    tuis_drain(m, &cap, 30);
    var st: i32 = 0;
    if !tuis_wait_raw(cpid, &st, 20000) {
        tuis_fail(tag, "Ctrl-D 之后 TUI 子进程没有退出", ok);
        _ = sys_kill(cpid as i64, SIGKILL) catch {};
        _ = tuis_wait_raw(cpid, &st, 2000);
    } else {
        const code: i32 = (st >> (8 as i32)) & 255;
        if code != 0 {
            tuis_fail(tag, "TUI 退出码不是 0", ok);
        }
    }
    _ = sys_close(m) catch {};
    const mock_rc: i32 = wait_child(mpid);
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错（批准之后的工具结果不对？）", ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
    }
}

fn tui_approve_round(tag: &const byte) bool {
    var ok: bool = true;
    // A) headless：注入的键到不了审批浮层 → 一律拒绝（fail closed）
    tuis_ap_headless_case(tag, &ok);
    // B) 真 PTY：浮层画出来之后送键 → 批准，命令真的跑
    tuis_ap_pty_case(tag, &ok);
    if ok {
        tuis_ok(tag, "read-only 下 bash 逐条批准：headless 一律 fail closed + 真 PTY 里 ↑回车才放行");
    }
    return ok;
}

// ============================================================
// tui-status（P18）：常驻状态区 + 思考实时行
//
// 为什么单独一轮：P17 的运行状态行是「转录的最后一行」，转录一铺满视口
// 就被 `r < panel_top` 挤掉 —— 长会话里跑起来屏幕上**一个动的字节都没有**
// （README 踩坑 32）。这一轮把 A「铺满也要看得见」和 B「思考实时行」都钉死。
// ============================================================

// 铺满转录：加够行数，保证「转录比视口长」（每行很长，会各占满一行）
fn tuis_fill_transcript() void {
    var many: Buf = buf_new(4096);
    defer { buf_free(&many); }
    var i: usize = 0;
    while i < 40 {
        _ = buf_append_cstr(&many, "铺满视口用的转录正文，这一行足够长，会把整个视口吃掉。\n");
        i = i + 1;
    }
    tui_add_user("P18 状态区回归" as &const byte, bufx_cstr_len("P18 状态区回归" as &const byte));
    tui_sink_bytes(1, many.ptr as &const byte, many.len);
    tui_close_stream_entries();
}

// 找一行：含 lit 时返回 true（找不到返回 false）
fn tuis_find_row(lit: &const byte, row: &usize) bool {
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, lit) {
            row[0] = r;
            return true;
        }
        r = r + 1;
    }
    return false;
}

fn tui_status_round(tag: &const byte) bool {
    var ok: bool = true;
    var row: usize = 0;

    // ---- A) 回归主断言：转录铺满视口，状态行必须照样看得见 ----
    tuis_reset(80, 20);
    tuis_fill_transcript();
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_build();
    tuis_scan_rows(80, &ok, tag);
    if !tuis_find_row("Bash(make check)" as &const byte, &row) {
        tuis_fail(tag, "转录铺满视口后状态行被挤掉了（P17 的 r < panel_top 老毛病）", &ok);
    } else {
        if !tui_row_has(row, "esc 中断" as &const byte) {
            tuis_fail(tag, "状态行没有带上「esc 中断」", &ok);
        }
        // 状态行必须紧贴输入面板上方（面板 = 输入行 + 信息行，下面还有一行脚注）
        if row != tui_nrows() - 4 {
            tuis_fail(tag, "状态行没有钉在输入面板正上方", &ok);
        }
    }

    // ---- B) 思考实时行：第 2 行，文本来自 tui_think_live ----
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    if tui_status_rows() != 1 {
        tuis_fail(tag, "还没有实时文本时状态区应当只有 1 行", &ok);
    }
    tui_think_live("先读 note.txt 再决定要不要覆盖" as &const byte,
        bufx_cstr_len("先读 note.txt 再决定要不要覆盖" as &const byte));
    if tui_status_rows() != 2 {
        tuis_fail(tag, "有实时文本之后状态区应当是 2 行", &ok);
    }
    tui_build();
    tuis_scan_rows(80, &ok, tag);
    var srow: usize = 0;
    var trow: usize = 0;
    if !tuis_find_row("思考中" as &const byte, &srow) {
        tuis_fail(tag, "状态行没有显示「思考中」", &ok);
    }
    if !tuis_find_row("✻ 思考 · " as &const byte, &trow) {
        tuis_fail(tag, "思考实时行没有出现", &ok);
    } else if !tui_row_has(trow, "先读 note.txt 再决定要不要覆盖" as &const byte) {
        tuis_fail(tag, "思考实时行的文本不对", &ok);
    } else if srow + 1 != trow {
        tuis_fail(tag, "思考实时行没有紧跟在状态行下面", &ok);
    } else if trow != tui_nrows() - 4 {
        tuis_fail(tag, "思考实时行没有紧贴输入面板上方", &ok);
    }

    // ---- C) 尾部对齐截断：超宽 → 前面补 '…'，只留最新的那一段 ----
    var long: Buf = buf_new(2048);
    defer { buf_free(&long); }
    var i: usize = 0;
    while i < 40 {
        _ = buf_append_cstr(&long, "很长的思考片段");
        i = i + 1;
    }
    _ = buf_append_cstr(&long, "尾巴标记");
    tui_think_live(long.ptr as &const byte, long.len);
    tui_build();
    tuis_scan_rows(80, &ok, tag);
    if !tuis_find_row("尾巴标记" as &const byte, &trow) {
        tuis_fail(tag, "尾部截断没有保住最新的那一端", &ok);
    } else if !tui_row_has(trow, "…" as &const byte) {
        tuis_fail(tag, "被截断的实时行前面应当补 '…'", &ok);
    }

    // ---- D) 清洗：控制字节 / ESC 序列 / TAB 不进正文层；换行不许混进这一行 ----
    var dirty: [byte: 16] = [27, 91, 50, 74, 65, 0, 66, 9, 67, 10, 68, 0, 0, 0, 0, 0];
    tui_think_live(&dirty[0], 11);       // ESC[2J A NUL B TAB C \n D
    tui_build();
    if tui_rows_have_esc() {
        tuis_fail(tag, "清洗之后思考实时行里还有 ESC", &ok);
    }
    tuis_scan_rows(80, &ok, tag);
    if !tuis_find_row("D" as &const byte, &trow) {
        tuis_fail(tag, "换行之后的最后一段没有留下来（应当只留最新一行）", &ok);
    }

    // ---- E) 生命周期：清空 → 状态区只剩 1 行；idle → 整块收掉 ----
    tui_think_clear();
    if tui_status_rows() != 1 {
        tuis_fail(tag, "清掉实时文本之后状态区应当回到 1 行", &ok);
    }
    tui_build();
    if tuis_find_row("✻ 思考 · " as &const byte, &row) {
        tuis_fail(tag, "清掉之后思考实时行还在屏幕上", &ok);
    }
    tuis_scan_rows(80, &ok, tag);
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    if tui_status_rows() != 0 {
        tuis_fail(tag, "空闲态状态区必须是 0 行（布局与 P18 之前一致）", &ok);
    }
    tui_think_live("空闲态不该出现的思考" as &const byte, bufx_cstr_len("空闲态不该出现的思考" as &const byte));
    tui_build();
    if tuis_find_row("思考中" as &const byte, &row) || tuis_find_row("✻ 思考 · " as &const byte, &row) {
        tuis_fail(tag, "空闲态不该画状态区（哪怕实时文本还在）", &ok);
    }
    tui_think_clear();

    // ---- F) 滚动：状态区钉住不动，转录窗口少 status_h 行 ----
    tuis_reset(80, 20);
    tuis_fill_transcript();
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    tui_think_live("滚动时的实时行" as &const byte, bufx_cstr_len("滚动时的实时行" as &const byte));
    tui_scroll_up(5);
    tui_build();
    tuis_scan_rows(80, &ok, tag);
    if !tuis_find_row("滚动时的实时行" as &const byte, &trow) {
        tuis_fail(tag, "往上滚之后状态区被滚掉了（它应当钉在面板上方）", &ok);
    }
    tui_scroll_end();

    // ---- G) 小/窄终端：不崩、不超宽、放不下前缀时退化成 1 行 ----
    tuis_reset(30, 8);
    tui_add_user("窄终端" as &const byte, bufx_cstr_len("窄终端" as &const byte));
    tui_sink_bytes(1, "窄终端里也要稳。\n" as &const byte, bufx_cstr_len("窄终端里也要稳。\n" as &const byte));
    tui_close_stream_entries();
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    tui_think_live("窄终端里的实时文本要按列截断" as &const byte,
        bufx_cstr_len("窄终端里的实时文本要按列截断" as &const byte));
    tui_build();
    tuis_scan_rows(30, &ok, tag);
    if tui_status_rows() == 2 && !tuis_find_row("✻ 思考 · " as &const byte, &trow) {
        tuis_fail(tag, "状态区算了两行却没画思考行（预留与实际不一致）", &ok);
    }
    if tui_status_rows() == 1 && tuis_find_row("✻ 思考 · " as &const byte, &trow) {
        tuis_fail(tag, "状态区只算一行却画了思考行", &ok);
    }
    // 窄到连「前缀 + 几列文本」都放不下（30 列以下）→ 宁可不画，只留状态行
    tuis_reset(20, 8);
    tui_add_user("极窄" as &const byte, bufx_cstr_len("极窄" as &const byte));
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    tui_think_live("放不下的实时文本" as &const byte, bufx_cstr_len("放不下的实时文本" as &const byte));
    tui_build();
    tuis_scan_rows(20, &ok, tag);
    if tui_status_rows() != 1 {
        tuis_fail(tag, "窄到放不下前缀时状态区应当退化成 1 行", &ok);
    }
    if tuis_find_row("✻ 思考 · " as &const byte, &trow) {
        tuis_fail(tag, "窄到放不下前缀时不该硬画思考行", &ok);
    }
    tuis_reset(40, 10);
    tuis_fill_transcript();
    tui_set_run(TUI_RUN_STREAM, "" as &const byte, 0);
    tui_build();
    tuis_scan_rows(40, &ok, tag);

    // ---- H) 喂入路径：view_think_live 默认开；--quiet 与滚动模式都不写 ----
    tuis_reset(100, 28);
    tui_headless_enable(true);           // tui_active() 为真（逻辑上在跑，不碰终端）
    tui_think_clear();
    view_init(true, 0);
    tui_add_user("喂入路径" as &const byte, bufx_cstr_len("喂入路径" as &const byte));
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    var two: Buf = buf_new(64);
    defer { buf_free(&two); }
    _ = buf_append_cstr(&two, "第一行思考\n最新一行思考");
    view_think_live(two.ptr as &const byte, two.len);
    tui_build();
    if !tuis_find_row("最新一行思考" as &const byte, &row) {
        tuis_fail(tag, "view_think_live 没有把「最新一行」喂到实时行（默认开这条路断了）", &ok);
    }
    if tuis_find_row("第一行思考" as &const byte, &row) {
        tuis_fail(tag, "实时行应当只显示最新一行", &ok);
    }
    // 块结束 → 收掉；且因为走的是 view_think_live，g_think_active 不该被点亮
    view_think_end(two.ptr as &const byte, two.len);
    tui_build();
    if tuis_find_row("✻ 思考 · " as &const byte, &row) {
        tuis_fail(tag, "view_think_end 没有把思考实时行收掉", &ok);
    }
    // --quiet：显示层整层关掉，喂进来也不许出现
    view_init(false, 0);
    view_think_live(two.ptr as &const byte, two.len);
    tui_build();
    if tuis_find_row("✻ 思考 · " as &const byte, &row) {
        tuis_fail(tag, "--quiet 下思考实时行不该出现", &ok);
    }
    view_init(true, 0);

    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    tui_headless_enable(false);
    tui_think_clear();

    if ok {
        tuis_ok(tag, "转录铺满也看得见 + 思考实时行（尾部截断/清洗/生命周期/滚动/窄终端/默认开）");
    }
    return ok;
}

// ============================================================
// tui-diag：诊断（fd 2）不许把外来字节原样铺满转录（P18）
//
// 现场：网关的 400 错误体回显了整个请求（含 tools 数组与 `\n` 转义），原样写 fd 2 时
// TUI 把它当 NOTICE 一块块画出来 —— 屏幕上就是「半个汉字 + 一屏 JSON」。
// 这一轮钉住：NOTICE 文本有上限（超了只留一行截断提示）、非法/半截 UTF-8 换成
// U+FFFD（屏幕文本永远是合法 UTF-8）、思考条目的尾部截断不会切出半个汉字。
// ============================================================
fn tui_diag_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_reset(100, 28);
    tui_headless_enable(true);
    tty_sink_on = true;

    // 4 KiB 的「回显请求体」：工具 schema + 真实换行；开头先放一个半截汉字
    // （必须放在前面：NOTICE 会被限长，放尾巴上会被截掉，断言就看不见了）
    var blob: Buf = buf_new(16384);
    defer { buf_free(&blob); }
    var half: [byte: 2] = [229, 143];              // 「中」的前两字节
    _ = buf_append(&blob, &half[0], 2);
    _ = buf_append_cstr(&blob, " tail\n");
    var i: usize = 0;
    while i < 40 {
        _ = buf_append_cstr(&blob, "{\"type\":\"function\",\"function\":{\"name\":\"write\",\"parameters\":{\"type\":\"object\"}}}\n");
        i = i + 1;
    }
    tty_write(&tty_ui, 2, blob.ptr as &const byte, blob.len);
    tui_sink_flush_partial();

    if tui_rows_have_esc() {
        tuis_fail(tag, "清洗之后正文层里还有 ESC", &ok);
    }
    tui_build();
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    _ = tui_screen_text(&out);
    if !bufx_utf8_valid(out.ptr as &const byte, out.len) {
        tuis_fail(tag, "屏幕上出现了非法 UTF-8（半截汉字直接上屏 = 乱码）", &ok);
    }
    const repl: [byte: 3] = [239, 191, 189];       // U+FFFD
    const view: &[byte] = out.ptr[0: out.len];
    if find_sub(view, &repl[0: 3], 0) < 0 {
        tuis_fail(tag, "半截汉字没有换成 U+FFFD", &ok);
    }
    if !tuis_has(&out, "诊断已截断") {
        tuis_fail(tag, "超长诊断没有截断提示（NOTICE 还会铺满屏幕）", &ok);
    }
    // 4 KiB 的块只许留下 512 B（约 6 行）；修之前这里会把 40 份重复铺满整屏
    var hits: usize = 0;
    var at: usize = 0;
    const kind_lit: [byte: 17] = [34, 116, 121, 112, 101, 34, 58, 34, 102, 117, 110, 99, 116, 105, 111, 110, 34];
    while at < view.len {
        const hit: isize = find_sub(view, &kind_lit[0: 17], at);
        if hit < 0 {
            break;
        }
        hits = hits + 1;
        at = (hit as usize) + 17;
    }
    if hits > 8 {
        tuis_fail(tag, "诊断块没有被限长（屏幕里还留着整块回显）", &ok);
    }

    // 思考条目：尾部截断（TUI_REASON_TAIL=4096，中文 3 字节/字）必须落在字符边界上
    tui_reset_all();
    tuis_reset(100, 28);
    tui_set_headless(true);
    tty_sink_on = true;
    var think: Buf = buf_new(8192);
    defer { buf_free(&think); }
    const cjk: [byte: 3] = [228, 184, 173];        // 「中」
    var j: usize = 0;
    while j < 2000 {                               // 6000 字节 > 4096
        _ = buf_append(&think, &cjk[0], 3);
        j = j + 1;
    }
    tty_reason_write(think.ptr as &const byte, think.len);
    var out2: Buf = buf_new(65536);
    defer { buf_free(&out2); }
    tui_build();
    _ = tui_screen_text(&out2);
    if !bufx_utf8_valid(out2.ptr as &const byte, out2.len) {
        tuis_fail(tag, "思考条目的尾部截断切出了半个汉字", &ok);
    }

    tui_headless_enable(false);
    // 这一轮把 sink 打开了，必须关回去：否则后面所有轮次的输出（连最终的
    // SELFTEST PASS/FAIL）都会被吞进转录缓冲区，终端上看就是「跑完没有下文」。
    tty_sink_on = false;
    if ok {
        tuis_ok(tag, "诊断限长 + 非法 UTF-8 换 U+FFFD + 思考尾部按字符切");    }
    return ok;
}

// tui-quit（P28）：真 PTY 里的「退不出」回归
//
// 为什么必须真 PTY：这三条路都要**边跑边发键**（工具正在跑的时候按键才有效），
// headless 自测是同进程同步跑的，注入的键没法插到「回合运行中」这个窗口里。
//
//   A) 长命令（sleep 15）跑着的时候按 ctrl+d → 立刻退出（退出码 0 / 离开备用屏幕 /
//      termios 逐位还原）。老代码里工具循环只收键不看键，这一按要等到 sleep 自己结束
//      才有反应 —— 用户看到的就是「退不出」。
//   B) 同一个窗口里按 esc → **当场**杀掉工具进程，回合在当前 step 边界收口
//      （屏幕上出现「已中断本回合」），且进程还活着（esc 只中断，不退出）。
//   C) 中断过的会话再提交一个任务 → 必须照常跑完（中断意图随回合收口作废，不能残留）。
//   D) 打 `/exit` 回车 → 退出（面板/输入两条路都算）。
// ============================================================

// 断言屏幕内容之前先**强制组装一帧**。
//
// 踩过的坑：headless 自测跑得太快（一屏之内全在同一毫秒里完成），P18 的空闲节流
// （`g_tui_run == IDLE && 距上一帧 < 120ms` → 攒到下一 tick）会把**最后一帧**攒住不画，
// 于是 `tui_screen_text()` / `tuis_screen_has()` 读到的是上一帧 —— 屏幕上是「空态 logo」，
// 转录里刚写的东西一个都看不见（tui-turn / tui-exit 各踩过一次）。
fn tuis_screen_refresh() void {
    tui_invalidate();
    // 直接组装：`tui_tick()` 在 TUI 关掉之后（headless 收尾会关）什么都不做，
    // 而这一轮要看的正是**收尾之后**的最后一屏状态。
    tui_build();
}

// 边收边等：lit 出现就返回 true（每轮 4×50ms = 200ms，最多等 max_ms）
fn tuis_wait_for(m: i32, cap: &Buf, lit: &const byte, max_ms: i32) bool {
    var waited: i32 = 0;
    while waited < max_ms {
        if tuis_has(cap, lit) {
            return true;
        }
        tuis_drain(m, cap, 4);
        waited = waited + 200;
    }
    return tuis_has(cap, lit);
}

fn tui_quit_round(tag: &const byte) bool {
    var ok: bool = true;
    const wsdir: &const byte = "build/selftest_ws_tui_quit" as &const byte;
    if !ws_prepare(wsdir) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }

    // ---------- A：工具跑着的时候 ctrl+d ----------
    mock_mode = 27;             // P28「退不出」轮（main 的 24/25/26 分别是诊断/大参数/plan 轮）
    mock_limit = 1;             // 只服务「长命令」那一轮：客户端马上就退出了
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    mock_expect_resp = false;
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    var mpid_a: i32 = -1;
    const port_a: u16 = tuis_start_mock(&mpid_a);
    if port_a == 0 {
        tuis_fail(tag, "mock LLM 起不来", &ok);
        return false;
    }

    var slave_a: Buf = buf_new(64);
    defer { buf_free(&slave_a); }
    const ma: i32 = tuis_open_pty(&slave_a, 100, 30);
    if ma < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", &ok);
        _ = sys_kill(mpid_a as i64, SIGKILL) catch {};
        return false;
    }
    var before_a: [byte: 60] = [0: 60];
    const have_before_a: bool = tuis_get_termios(ma, &before_a[0]);
    const cpid_a64: i64 = sys_fork() catch {
        _ = sys_close(ma) catch {};
        _ = sys_kill(mpid_a as i64, SIGKILL) catch {};
        tuis_fail(tag, "fork TUI 失败", &ok);
        return false;
    };
    if cpid_a64 == 0 {
        tuis_child_run_tui(&slave_a, port_a, wsdir);
        sys_exit(3);
        return false;
    }
    const cpid_a: i32 = tuis_i32(cpid_a64);
    var cap_a: Buf = buf_new(262144);
    defer { buf_free(&cap_a); }
    tuis_drain(ma, &cap_a, 40);
    if !tuis_has(&cap_a, "\x1b[?1049h" as &const byte) {
        tuis_fail(tag, "A：没有进备用屏幕", &ok);
    }
    // 发任务 → 等「工具正在跑」的状态行出现（mock 的 description 是 selftest command）
    var task_a: [byte: 64] = "跑一个长命令\r";
    tuis_write_master(ma, &task_a[0], bufx_cstr_len(&task_a[0] as &const byte));
    if !tuis_wait_for(ma, &cap_a, "selftest command" as &const byte, 8000) {
        tuis_fail(tag, "A：工具没有跑起来（状态区没出现 Bash 卡片）", &ok);
        tuis_dump_tail(&cap_a, 800);
    }
    var ctrl_d: [byte: 1] = [4];
    tuis_write_master(ma, &ctrl_d[0], 1);
    var st_a: i32 = 0;
    if !tuis_wait_raw(cpid_a, &st_a, 5000) {
        tuis_fail(tag, "A：工具跑着的时候 ctrl+d 没有退出（退不出）", &ok);
        tuis_dump_tail(&cap_a, 800);
        _ = sys_kill(cpid_a as i64, SIGKILL) catch {};
    } else if ((st_a >> (8 as i32)) & 255) != 0 {
        tuis_fail(tag, "A：退出码不是 0", &ok);
    }
    tuis_drain(ma, &cap_a, 20);
    if !tuis_has(&cap_a, "\x1b[?1049l" as &const byte) {
        tuis_fail(tag, "A：退出时没有离开备用屏幕", &ok);
    }
    if have_before_a {
        var after_a: [byte: 60] = [0: 60];
        if !tuis_get_termios(ma, &after_a[0]) {
            tuis_fail(tag, "A：退出后读不到 pty termios", &ok);
        } else if !tuis_termios_equal(&before_a[0], &after_a[0]) {
            tuis_fail(tag, "A：退出后 termios 没有逐位还原", &ok);
        }
    }
    _ = sys_close(ma) catch {};
    const mock_rc_a: i32 = wait_child(mpid_a);
    if mock_rc_a != 0 {
        tuis_fail(tag, "A：mock LLM 侧报错", &ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc_a as usize);
        tuis_puts("\n");
    }

    // ---------- B/C/D：esc 杀工具 → 中断后仍可用 → /exit 退出 ----------
    mock_mode = 27;
    mock_limit = -1;            // 用 mode 的默认轮数（长命令 → 被中断 → 第二个任务的答案）
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    var mpid_b: i32 = -1;
    const port_b: u16 = tuis_start_mock(&mpid_b);
    if port_b == 0 {
        tuis_fail(tag, "mock LLM 起不来（B）", &ok);
        return ok;
    }
    var slave_b: Buf = buf_new(64);
    defer { buf_free(&slave_b); }
    const mb: i32 = tuis_open_pty(&slave_b, 100, 30);
    if mb < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx（B）", &ok);
        _ = sys_kill(mpid_b as i64, SIGKILL) catch {};
        return ok;
    }
    const cpid_b64: i64 = sys_fork() catch {
        _ = sys_close(mb) catch {};
        _ = sys_kill(mpid_b as i64, SIGKILL) catch {};
        tuis_fail(tag, "fork TUI 失败（B）", &ok);
        return ok;
    };
    if cpid_b64 == 0 {
        tuis_child_run_tui(&slave_b, port_b, wsdir);
        sys_exit(3);
        return false;
    }
    const cpid_b: i32 = tuis_i32(cpid_b64);
    var cap_b: Buf = buf_new(262144);
    defer { buf_free(&cap_b); }
    tuis_drain(mb, &cap_b, 40);
    var task_b: [byte: 64] = "跑一个长命令\r";
    tuis_write_master(mb, &task_b[0], bufx_cstr_len(&task_b[0] as &const byte));
    if !tuis_wait_for(mb, &cap_b, "selftest command" as &const byte, 8000) {
        tuis_fail(tag, "B：工具没有跑起来", &ok);
        tuis_dump_tail(&cap_b, 800);
    }
    // esc：必须**很快**收口（sleep 15 还早着呢）
    const t_esc: u64 = ua_now_ms();
    var esc: [byte: 1] = [27];
    tuis_write_master(mb, &esc[0], 1);
    if !tuis_wait_for(mb, &cap_b, "已中断本回合" as &const byte, 6000) {
        tuis_fail(tag, "B：esc 之后回合没有收口（工具没被杀掉？）", &ok);
        tuis_dump_tail(&cap_b, 1200);
    } else {
        const dt: u64 = ua_now_ms() - t_esc;
        if dt > 5000 {
            tuis_fail(tag, "B：esc 之后收口太慢（等工具自己结束了）", &ok);
            tuis_puts("  dt_ms=");
            tuis_num(dt as usize);
            tuis_puts("\n");
        }
    }
    if !tuis_child_alive(cpid_b) {
        tuis_fail(tag, "B：esc 把进程也退了（应当只中断本回合）", &ok);
    }
    // C：第二个任务必须跑完（中断意图残留的话它会在第一个字节就被打断）。
    //    任务文本用 ASCII 的 "task-two"：mock 就是靠它认出「这是中断之后那个任务」的请求。
    var task_c: [byte: 16] = "task-two\r";
    tuis_write_master(mb, &task_c[0], bufx_cstr_len(&task_c[0] as &const byte));
    if !tuis_wait_for(mb, &cap_b, "SELFTEST-TUI-QUIT-OK" as &const byte, 12000) {
        tuis_fail(tag, "C：中断之后新任务没有跑完（中断意图残留？）", &ok);
        tuis_dump_tail(&cap_b, 1500);
    }
    // D：/exit 退出
    var quit_line: [byte: 16] = "/exit\r";
    tuis_write_master(mb, &quit_line[0], 6);
    var st_b: i32 = 0;
    if !tuis_wait_raw(cpid_b, &st_b, 5000) {
        tuis_fail(tag, "D：输入 /exit 之后没有退出", &ok);
        tuis_dump_tail(&cap_b, 800);
        _ = sys_kill(cpid_b as i64, SIGKILL) catch {};
    } else if ((st_b >> (8 as i32)) & 255) != 0 {
        tuis_fail(tag, "D：/exit 的退出码不是 0", &ok);
    }
    tuis_drain(mb, &cap_b, 20);
    if !tuis_has(&cap_b, "\x1b[?1049l" as &const byte) {
        tuis_fail(tag, "D：/exit 退出时没有离开备用屏幕", &ok);
    }
    _ = sys_close(mb) catch {};
    const mock_rc_b: i32 = wait_child(mpid_b);
    if mock_rc_b != 0 {
        tuis_fail(tag, "mock LLM 侧报错（B/C/D）", &ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc_b as usize);
        tuis_puts("\n");
        tuis_dump_tail(&cap_b, 800);
    }
    mock_mode = 0;
    mock_limit = -1;

    if ok {
        tuis_ok(tag, "真 PTY：运行中 ctrl+d 立刻退 / esc 杀工具并收口 / 中断后新任务照常跑 / /exit 退出");
    }
    return ok;
}

// ============================================================
// tui-exit（P28）：命令面板的选择**真的会执行**（headless，走完整主循环）
//
// 为什么单独一轮：浮层 accept 是「先 close 再交结果」，而 close 会把 kind 清零 ——
// 主循环读到的永远是 0，于是面板里选出来的东西（包括 /exit）被**静默丢掉**：
// 「按了没反应」。这一轮用 /help 做钉子（它会把帮助正文写进转录），
// 面板选择一旦没被执行，屏幕上就找不到帮助正文。
// ============================================================

fn tui_exit_round(tag: &const byte) bool {
    var ok: bool = true;
    const wsdir: &const byte = "build/selftest_ws_tui_exit" as &const byte;
    if !ws_prepare(wsdir) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    mock_mode = 0;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;

    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", &ok);
        return false;
    }

    var c: Config = cfg_default();
    cfg_pin_api(&c, LLM_STYLE_CHAT);
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(64);
    _ = buf_append_cstr(&c.workspace, wsdir);
    c.task = buf_empty();
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.quiet = false;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    c.tui = true;
    c.tui_headless = true;
    c.tui_cols = 100;
    c.tui_rows = 30;

    tui_reset_all();
    tui_set_headless(true);
    tui_set_size(100, 30);
    tui_set_color(false, false);
    tui_begin_session();
    tui_sink_flush_partial();
    // 命令表：sel 默认在第 0 项 —— 也就是 /help
    tui_set_commands("/help      帮助\n/status    状态\n" as &const byte, 34);
    tui_keys_inject("/" as &const byte, 1);
    if !tui_overlay_open() {
        tuis_fail(tag, "输入 / 没有打开命令面板", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if tui_quit_wanted() {
        tuis_fail(tag, "选了 /help 却置了退出标志", &ok);
    }
    const rc: i32 = agent_run_tui(&c);
    if rc != AGENT_OK {
        tuis_fail(tag, "选完命令之后主循环没有正常收工", &ok);
        tuis_puts("  rc=");
        tuis_num(rc as usize);
        tuis_puts("\n");
    }
    // 面板选择真的被执行了吗？判据是**派发的后果**：`/help` 在 TUI 里是浮层
    // （P23 起），它开出来才说明面板那一下真的走到了 agent_tui_command。
    // 不看转录里的「命令回显」notice：浮层正好盖在转录区上，那一行在屏幕上看不见
    // （notice 本身是加了的 —— 本轮调试时用 g_tui_nent 确认过）。
    // 老代码里 kind 在 close 时被清零，主循环两个分支都不成立 → 这里什么都开不出来。
    tuis_screen_refresh();
    if !tui_overlay_open() {
        tuis_fail(tag, "命令面板的选择没有派发（/help 浮层没开）", &ok);
    } else if tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "派发的不是选中的那条命令（浮层 kind 不对）", &ok);
    }
    _ = wait_child(mpid);
    cfg_free(&c);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;

    if ok {
        tuis_ok(tag, "命令面板的选择被执行（kind 跨 close 存活）+ 主循环收工");
    }
    return ok;
}

// ============================================================
// tui-cmd：命令面板 ↔ /status 浮层这一条链（P23）
//
// 用户报的「/status 没反应」其实是四件事叠在一起，这一轮逐个钉住：
//   A) 面板是由输入行里那个 `/` 触发的，派发后必须把它收走 —— 否则第二次敲
//      `/status` 会拼成 `//status`，被当成未知命令丢掉（屏幕上就是「没反应」）；
//   B) 回车但一条都没匹配上时不许静默：文字还回输入行 + 一条 notice；
//   C) 回合运行中接受的面板项要在**下一个 step 边界**就派发（只读命令），
//      不安全的命令必须留在待取队列里给主循环（回合还攥着 History）；
//   D) 浮层内容比框高时要能滚（老实现 24 行只画 14 行，`上下文占用` 永远看不到）。
// A/B/C/D 的纯逻辑在 headless 下断言；C 的真终端形态（回合还在跑时浮层就出来了）
// 走真 PTY，见 tuis_cmd_pty_case。
// ============================================================

const TUIS_CMD_TITLE: &const byte = "状态（esc 关闭）" as &const byte;
const TUIS_CMD_LEAK: &const byte = "<system-remind" as &const byte;
const TUIS_CMD_NOMATCH: &const byte = "没有匹配的命令" as &const byte;

// 浮层标题行（找带 ╭ 的那一行）
fn tuis_cmd_title_row(row: &usize) bool {
    return tuis_find_row("╭─ " as &const byte, row);
}

// 造一个「headless 但真跑主循环」的配置（与 tui-access 第 6 步同一套）
fn tuis_cmd_cfg(c: &Config, ws: &const byte) void {
    c[0] = cfg_default();
    c.sandbox = SAN_OFF;
    c.access = PERM_WORKSPACE_WRITE;
    perm_set(PERM_WORKSPACE_WRITE);
    cfg_pin_api(c, LLM_STYLE_CHAT);
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:1/v1");   // 这一轮不发请求
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_empty();
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.quiet = false;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    c.tui = true;
    c.tui_headless = true;
    c.tui_cols = 100;
    c.tui_rows = 30;
}

fn tui_cmd_round(tag: &const byte) bool {
    var ok: bool = true;
    const wsa: &const byte = "build/selftest_ws_tui_cmd" as &const byte;
    if !ws_prepare(wsa) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    var c: Config = cfg_default();
    tuis_cmd_cfg(&c, wsa);

    // ---- A1) 面板派发 /status：浮层要看得到，标题要逐字节干净，输入行不许留下 "/" ----
    tuis_reset(100, 30);
    tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
    tui_begin_session();
    tui_sink_flush_partial();
    tui_keys_inject("/" as &const byte, 1);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "输入 / 没有打开命令面板", &ok);
    }
    tui_keys_inject("status" as &const byte, 6);
    tui_keys_inject("\r" as &const byte, 1);
    if agent_run_tui(&c) != AGENT_OK {
        tuis_fail(tag, "面板派发那一轮以非 0 退出", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "命令面板选 /status 没有开出状态浮层", &ok);
    }
    var trow: usize = 0;
    if !tuis_cmd_title_row(&trow) {
        tuis_fail(tag, "状态浮层没有标题栏", &ok);
    } else {
        if !tui_row_has(trow, TUIS_CMD_TITLE) {
            tuis_fail(tag, "状态浮层标题不是「状态（esc 关闭）」", &ok);
        }
        // 手写字面量长度越界：标题栏会挂上相邻只读常量里的 `<system-reminder>`
        if tui_row_has(trow, TUIS_CMD_LEAK) {
            tuis_fail(tag, "标题栏里有越界读出来的 <system-reminder>（字面量长度写大了）", &ok);
        }
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "派发之后输入行里还留着触发面板的那个 /", &ok);
    }

    // ---- A2) 连敲第二次：老实现在这里退化成 //status → 「未知命令」----
    tui_begin_session();   // 只清一次性状态（quit/submit/按键队列），转录与浮层都留着
    tui_overlay_close();
    tui_keys_inject("/status\r" as &const byte, 8);
    if agent_run_tui(&c) != AGENT_OK {
        tuis_fail(tag, "第二次派发那一轮以非 0 退出", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "第二次敲 /status 没有开出状态浮层（输入行残留 / → //status？）", &ok);
    }
    if !tui_row_has(trow, TUIS_CMD_TITLE) && !tuis_screen_has(TUIS_CMD_TITLE) {
        tuis_fail(tag, "第二次的状态浮层里没有标题", &ok);
    }
    tui_overlay_close();

    // ---- B) 回车但没有匹配：不许静默（文字还回输入行 + 一条 notice）----
    tui_begin_session();
    tui_input_clear();
    tui_keys_inject("/zzz\r" as &const byte, 5);
    if agent_run_tui(&c) != AGENT_OK {
        tuis_fail(tag, "无匹配那一轮以非 0 退出", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tui_overlay_open() {
        tuis_fail(tag, "无匹配时浮层应当关掉", &ok);
    }
    const inp: &Buf = tui_input_text();
    if inp.len != 4 || !bufx_mem_eq(inp.ptr as &const byte, "/zzz" as &const byte, 4) {
        tuis_fail(tag, "无匹配时敲进去的文字没有还回输入行", &ok);
    }
    if !tuis_screen_has(TUIS_CMD_NOMATCH) {
        tuis_fail(tag, "无匹配时连一条 notice 都没有（静默丢弃）", &ok);
    }

    // ---- C) 运行中的只读命令：step 边界派发；不安全的留在队列里 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);   // 真跑 agent_run_tui 时它自己会开；这里直接调轮询函数，得自己开
    tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
    tui_begin_session();
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    var h: History = hist_init();
    tui_keys_inject("/status\r" as &const byte, 8);
    if tui_overlay_open() {
        tuis_fail(tag, "运行中接受面板项时不该当场开出浮层（应当挂到 step 边界）", &ok);
    }
    if tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "运行中接受的面板结果没有留在待取队列里", &ok);
    }
    agent_tui_poll_pending_cmd(&c, &h);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "step 边界没有派发 /status（回合运行中看不到状态浮层）", &ok);
    }
    if !tuis_screen_has(TUIS_CMD_TITLE) {
        tuis_fail(tag, "step 边界派发出来的浮层没有标题", &ok);
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "step 边界派发之后输入行里还留着 /", &ok);
    }
    tui_overlay_close();
    // 不安全命令（/permission 会改访问模式，/new 会 hist_free）：必须原样留着
    var unsafe_cmds: Buf = buf_new(128);
    defer { buf_free(&unsafe_cmds); }
    _ = buf_append_cstr(&unsafe_cmds, "/permission 切换访问模式\n");
    tui_set_commands(unsafe_cmds.ptr as &const byte, unsafe_cmds.len);
    tui_begin_session();
    tui_input_clear();
    tui_keys_inject("/permission\r" as &const byte, 12);
    agent_tui_poll_pending_cmd(&c, &h);
    if tui_overlay_open() {
        tuis_fail(tag, "不安全的命令（/permission）在回合里被当场派发了", &ok);
    }
    var pend: Buf = buf_new(256);
    defer { buf_free(&pend); }
    if !tui_overlay_peek(&pend) || tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "不安全的命令应当原样留在待取队列里给主循环", &ok);
    }
    _ = tui_overlay_take(&pend);
    hist_free(&h);

    // ---- D) 滚动：24 行内容要能翻到末尾 ----
    tuis_reset(100, 30);
    tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
    tui_begin_session();
    var h2: History = hist_init();
    var st: Buf = buf_new(4096);
    defer { buf_free(&st); }
    _ = buf_append_cstr(&st, "/status");
    _ = agent_tui_command(&c, &h2, &st);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tui_overlay_open() {
        tuis_fail(tag, "/status 没有开出浮层", &ok);
    }
    if tuis_screen_has("上下文已用" as &const byte) {
        tuis_fail(tag, "24 行的状态块一开始就全画出来了？（窗口实现变了，这条断言要跟着改）", &ok);
    }
    if !tuis_screen_has("↓" as &const byte) {
        tuis_fail(tag, "内容没画完却没有滚动指示（↓）", &ok);
    }
    tui_keys_inject("\x1b[6~" as &const byte, 4);   // PgDn
    tui_keys_inject("\x1b[6~" as &const byte, 4);
    tui_keys_inject("\x1b[6~" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("上下文已用" as &const byte) {
        tuis_fail(tag, "PgDn 之后仍然看不到「上下文已用」（滚不动？）", &ok);
    }
    if !tuis_screen_has("version" as &const byte) {
        tuis_fail(tag, "PgDn 到底之后看不到最后一行（version）", &ok);
    }
    if !tuis_screen_has("↑" as &const byte) {
        tuis_fail(tag, "滚下去之后没有「上面还有」的指示（↑）", &ok);
    }
    if tuis_screen_has("base_url" as &const byte) {
        tuis_fail(tag, "滚到底之后窗口顶端还停在最前面（窗口没跟着选中项走）", &ok);
    }
    tui_overlay_close();
    hist_free(&h2);

    // ---- E) 真 PTY：回合还在跑的时候浮层就该出来 ----
    tuis_cmd_pty_case(tag, &ok);

    cfg_free(&c);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    if ok {
        tuis_ok(tag, "面板派发收走触发用的 /（连敲两次都开）+ 无匹配不静默 + 运行中 step 边界派发只读命令 + 浮层滚动/溢出指示 + 真 PTY 回合中可见");
    }
    return ok;
}


// 真 PTY：回合还在跑的时候，运行中接受的面板项必须在下一个 step 边界就把状态浮层
// 开出来 —— 判据是「标题先出现、最终答案标记还没出现」。mock 的两段 SSE 之间插了
// 一个停顿（mock_sse_gap_ns），父进程就靠这个窗口把 /status 敲进去。
fn tuis_cmd_pty_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_cmd_pty" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败（PTY 回合）", ok);
        return;
    }
    mock_mode = 0;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    mock_expect_resp = false;
    mock_usage_on = false;
    mock_sse_gap_ns = 1200000000;   // 1.2s：两个 step 都在这里停一下
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        mock_sse_gap_ns = 0;
        tuis_fail(tag, "mock LLM 起不来（PTY 回合）", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        mock_sse_gap_ns = 0;
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        return;
    }
    tui_reset_all();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        mock_sse_gap_ns = 0;
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        return;
    };
    if cpid64 == 0 {
        tuis_child_run_tui(&slave_path, port, ws);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 40);      // 首帧
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案（PTY 回合）", ok);
    }
    var task: [byte: 64] = "do the slow task\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    // 回合已经卡在 SSE 的停顿里；这时候敲 /status（面板 → 过滤 → 回车）
    var nap: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 300000000 };
    var nrem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_nanosleep(&nap, &nrem) catch {};
    tuis_write_master(m, "/status\r" as &const byte, 8);
    var title_seen: bool = false;
    var ended_too_early: bool = false;
    var k: i32 = 0;
    while k < 200 && !title_seen {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, TUIS_CMD_TITLE) {
            title_seen = true;
            // 这一刻回合必须还没跑完。浮层盖住转录，最终答案的字看不见，所以判据用
            // 脚注：两步的回合跑完时统计行会出现「1 轮 · 2 步」（step 1 结束时是「1 步」）。
            if tuis_has(&cap, "1 轮 · 2 步" as &const byte) {
                ended_too_early = true;
            }
        }
        k = k + 1;
    }
    if !title_seen {
        tuis_fail(tag, "回合运行中敲 /status：浮层一直没有出现", ok);
        tuis_dump_tail(&cap, 1500);
    } else if ended_too_early {
        tuis_fail(tag, "浮层是在回合结束之后才出来的（运行中没有 step 边界派发）", ok);
        tuis_puts("  title at iter=");
        tuis_num(k as usize);
        tuis_puts(" cap=");
        tuis_num(cap.len);
        tuis_puts("\n");
        tuis_dump_tail(&cap, 2500);
    }
    // 浮层开着的时候回合照常跑完：esc 关掉浮层，最终答案就回到转录里
    var esc1: [byte: 1] = [27];
    tuis_write_master(m, &esc1[0], 1);
    var done: bool = false;
    var k2: i32 = 0;
    while k2 < 300 && !done {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, "SELFTEST_OK" as &const byte) {
            done = true;
        }
        k2 = k2 + 1;
    }
    if !done {
        tuis_fail(tag, "浮层打开之后回合没有正常跑完", ok);
        tuis_dump_tail(&cap, 1200);
    }
    if !tuis_child_alive(cpid) {
        tuis_fail(tag, "回合跑完之后子进程不见了", ok);
    }
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 20000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
    mock_sse_gap_ns = 0;
}

// ============================================================
// tui-scroll：长内容翻看这条链（P32）
//
// 用户报的「工作区里文本不能滚动、翻不了旧日志」有三种形态，这一轮逐个钉住：
//   ① 滚轮：DSH 的 web 终端是 xterm.js，没有鼠标协议时它把滚轮伪装成 ↑/↓ ——
//      所以「滚轮向上」变成了输入历史。修法是开 `ESC[?1000h/1006h` 并把
//      `ESC[<64;x;yM` / `ESC[<65;x;yM` 折成滚轮事件（其它按下/移动丢弃）。
//   ② ctrl+home / ctrl+end 解析错：老实现把 `ESC[1;5H` 在第一个 ';' 就收尾，
//      剩下的 `5H` 当普通字符进了输入行（屏幕上明晃晃的 5H），而且没跳到顶。
//   ③ **一个条目上万行**：窗口从尾部收行，`total >= need` 就停 —— 一个长条目被
//      整个装进来时 max_scroll = total - 视口 会夹成 0，于是「往上翻/跳顶」都
//      翻不到这一条的前面部分。修法是按真总量走查（tui_auto_end_scroll）。
// 外加：PgUp/PgDn 按整屏走（不再是写死的 5 行）、两端的 `^`/`v` 溢出指示。
// ============================================================

// 一条 n 行的助手正文（单独一个条目 —— 这是「长条目」那种形状）
fn tuis_long_entry(n: usize) void {
    var many: Buf = buf_new(65536);
    defer { buf_free(&many); }
    var i: usize = 0;
    while i < n {
        _ = buf_append_cstr(&many, "LONG-ROW-");
        _ = buf_append_u64(&many, (i + 1) as u64);
        _ = buf_append_cstr(&many, " 这一行很长，足够把视口吃满，用来验证长条目能不能翻到前面。\n");
        i = i + 1;
    }
    tui_sink_bytes(1, many.ptr as &const byte, many.len);
    tui_close_stream_entries();
}

// 屏幕文本里有没有 "LONG-ROW-<n> "（带后随空格，免得 LONG-ROW-4 命中 LONG-ROW-40）
fn tuis_long_visible(n: usize) bool {
    var pat: Buf = buf_new(32);
    defer { buf_free(&pat); }
    _ = buf_append_cstr(&pat, "LONG-ROW-");
    _ = buf_append_u64(&pat, n as u64);
    _ = buf_append_byte(&pat, 32);
    return tuis_screen_has(pat.ptr as &const byte);
}

fn tui_scroll_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- A) 长条目（2400 行）也能翻到前面 + ctrl+home 到顶 + ctrl+end 回底 ----
    tuis_reset(100, 30);
    tuis_long_entry(2400);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tui_scroll_pos() != 0 {
        tuis_fail(tag, "新内容进来后应当贴尾（scroll == 0）", &ok);
    }
    if !tuis_long_visible(2400) {
        tuis_fail(tag, "贴尾时看不到最后一行 LONG-ROW-2400", &ok);
    }
    // 长条目不许把「往上翻」夹死：一直 PgUp，必须能走到这一条的最前面
    var guard: usize = 0;
    while guard < 400 && !tuis_long_visible(1) {
        tui_scroll_up(10);
        tui_build();
        guard = guard + 1;
    }
    if !tuis_long_visible(1) {
        tuis_fail(tag, "长条目里往上翻不到第一行（max_scroll 被夹死？）", &ok);
        tuis_puts("  scroll=" as &const byte);
        tuis_num(tui_scroll_pos());
        tuis_puts("\n" as &const byte);
    }
    tuis_scan_rows(100, &ok, tag);
    // 再往上：LONG-ROW-1 可见时条目标题（`◆ 助手`）可能还在窗口上面，所以继续滚到
    // 标题也进来 —— 那才是真的到顶，此时 `^` 指示必须消失。
    var guard2: usize = 0;
    var head_row: usize = 0;
    while guard2 < 60 && !tuis_find_row("◆ 助手" as &const byte, &head_row) {
        tui_scroll_up(4);
        tui_build();
        guard2 = guard2 + 1;
    }
    if !tuis_find_row("◆ 助手" as &const byte, &head_row) {
        tuis_fail(tag, "长条目一直往上滚也看不到条目标题（真到不了顶）", &ok);
    }
    if tui_start_line() != 0 {
        tuis_puts("  scroll=" as &const byte); tuis_num(tui_scroll_pos());
        tuis_puts(" start=" as &const byte); tuis_num(tui_start_line());
        tuis_puts("\n" as &const byte);
        tuis_fail(tag, "一直往上滚也没到最顶（start_line 不为 0）", &ok);
    }
    if tui_more_above() {
        tuis_fail(tag, "已经到顶（标题都进来了），转录区第一行还挂着 `^` 溢出指示", &ok);
    }
    tuis_scan_rows(100, &ok, tag);
    // ctrl+end 回底
    tui_scroll_end();
    tui_build();
    if tui_scroll_pos() != 0 {
        tuis_fail(tag, "ctrl+end 之后没有回到底", &ok);
    }
    if !tuis_long_visible(2400) {
        tuis_fail(tag, "回底之后看不到最后一行", &ok);
    }

    // ---- B) ctrl+home / ctrl+end 的字节解析（带修饰键的 CSI 不能把尾巴漏进输入行）----
    tuis_reset(100, 30);
    tuis_long_entry(600);
    tui_build();
    tui_keys_inject("\x1b[1;5H" as &const byte, 6);   // ctrl+home
    tui_build();
    if !tuis_long_visible(1) {
        tuis_fail(tag, "ctrl+home 没有跳到最顶（看不到第一行）", &ok);
        tuis_puts("  scroll=" as &const byte);
        tuis_num(tui_scroll_pos());
        tuis_puts("\n" as &const byte);
    }
    if tui_more_above() || tui_start_line() != 0 {
        tuis_fail(tag, "跳到最顶之后不该再有 `^` 指示（start_line 应为 0）", &ok);
    }
    tui_keys_inject("\x1b[1;5F" as &const byte, 6);   // ctrl+end
    tui_build();
    if tui_input_len() != 0 {
        tuis_fail(tag, "ctrl+end 的尾巴漏进了输入行", &ok);
    }
    if tui_scroll_pos() != 0 {
        tuis_fail(tag, "ctrl+end 没有回到底", &ok);
    }
    // 不带修饰键的 Home/End 依旧只是行内编辑（不许被 ctrl 分支抢走）
    tui_keys_inject("ab" as &const byte, 2);
    tui_keys_inject("\x1b[H" as &const byte, 3);
    tui_keys_inject("Q" as &const byte, 1);
    if !tuis_in_is("Qab" as &const byte) {
        tuis_fail(tag, "裸 Home 没有走行内编辑（被 ctrl+home 分支抢走了？）", &ok);
    }
    tui_input_clear();

    // ---- C) 滚轮：SGR 事件折成滚动，别的鼠标事件一律不落进输入行 ----
    tuis_reset(100, 30);
    tuis_long_entry(600);
    tui_build();
    const before: usize = tui_scroll_pos();
    tui_keys_inject("\x1b[<64;10;10M" as &const byte, 12);   // 滚轮上
    tui_build();
    if tui_scroll_pos() <= before {
        tuis_fail(tag, "SGR 滚轮上（64）没有往上滚", &ok);
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "滚轮事件漏进了输入行", &ok);
    }
    var up: usize = tui_scroll_pos();
    tui_keys_inject("\x1b[<65;10;10M" as &const byte, 12);   // 滚轮下
    tui_build();
    if tui_scroll_pos() >= up {
        tuis_fail(tag, "SGR 滚轮下（65）没有往下滚", &ok);
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "滚轮下的事件漏进了输入行", &ok);
    }
    // 按下/抬起/移动（b < 64）一律丢弃：不许滚动、不许进输入行
    const pos0: usize = tui_scroll_pos();
    tui_keys_inject("\x1b[<0;10;10M" as &const byte, 11);   // 左键按下（11 字节）
    tui_keys_inject("\x1b[<0;10;10m" as &const byte, 11);   // 左键抬起
    tui_keys_inject("\x1b[<35;11;11M" as &const byte, 13);   // 移动
    tui_build();
    if tui_scroll_pos() != pos0 {
        tuis_fail(tag, "非滚轮的鼠标事件（按下/移动）不该滚动", &ok);
    }
    if tui_input_len() != 0 {
        tuis_fail(tag, "非滚轮的鼠标事件漏进了输入行", &ok);
    }
    // 录入端真的开了鼠标上报（否则 xterm.js 永远把滚轮伪装成 ↑/↓）
    var cap: Buf = buf_new(1024);
    defer { buf_free(&cap); }
    tui_term_text(&cap);
    if !bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "TUI 进入时没有开鼠标上报（ESC[?1000h）—— 滚轮会被终端转成 ↑/↓", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "没有开 SGR 鼠标编码（ESC[?1006h）", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1006l" as &const byte) {
        tuis_fail(tag, "离开 TUI 时没有关鼠标编码（拖累后面的 shell）", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?2004l" as &const byte) {
        tuis_fail(tag, "离开 TUI 时没有关括起粘贴", &ok);
    }

    // ---- D) PgUp/PgDn 走整屏（老实现写死 5 行）+ 顶部 `^` 溢出指示 ----
    tuis_reset(100, 30);
    tuis_long_entry(600);
    tui_build();
    var row: usize = 0;
    if !tuis_find_row("LONG-ROW-600 " as &const byte, &row) {
        tuis_fail(tag, "贴尾时看不到最后一行", &ok);
    }
    tui_keys_inject("\x1b[5~" as &const byte, 4);   // PgUp
    tui_build();
    const after_pgup: usize = tui_scroll_pos();
    if after_pgup < 20 {
        tuis_fail(tag, "PgUp 只滚了几行（写死 5 行的老毛病）", &ok);
        tuis_puts("  scroll=" as &const byte);
        tuis_num(after_pgup);
        tuis_puts("\n" as &const byte);
    }
    // 顶部（转录区第 0 行）要有 `^` 溢出指示：上面还有内容（P32）
    if !tui_row_has(0, "^" as &const byte) {
        tuis_fail(tag, "往上翻之后转录区第一行没有 `^` 溢出指示", &ok);
    }
    // 指示必须落在**最后一个显示列**（原地覆盖一个空格，不许把行撑宽）
    if tui_row_cols_n(0) != 100 {
        tuis_fail(tag, "带 `^` 指示的那一行列数不是 100（指示把行撑宽/缩窄了）", &ok);
    }
    // 贴尾时指示必须消失（布局与 P32 之前逐字节一致）
    tui_scroll_end();
    tui_build();
    if tui_row_has(0, "^" as &const byte) {
        tuis_fail(tag, "贴尾时第一行不该有 `^` 指示", &ok);
    }
    tuis_scan_rows(100, &ok, tag);

    // ---- E) 贴尾时新内容照旧自动跟随（不被 P32 的指示行改动破坏）----
    tuis_reset(100, 30);
    tuis_long_entry(120);
    tui_build();
    tui_sink_bytes(1, "TAIL-FOLLOW-MARK 新来的一行\n" as &const byte,
        bufx_cstr_len("TAIL-FOLLOW-MARK 新来的一行\n" as &const byte));
    tui_build();
    if !tuis_screen_has("TAIL-FOLLOW-MARK" as &const byte) {
        tuis_fail(tag, "贴尾时新内容没有自动跟随（还在看旧位置？）", &ok);
    }
    if tui_scroll_pos() != 0 {
        tuis_fail(tag, "贴尾状态下新内容进来后 scroll 不是 0", &ok);
    }

    if ok {
        tuis_ok(tag, "长条目翻看（真总量走查）+ ctrl+home/end 参数解析 + SGR 滚轮 + 整屏 PgUp/PgDn + `^` 溢出指示 + 贴尾跟随");
    }
    return ok;
}

// ============================================================
// tui-p30（P30）：运行中的命令不再等 step 边界
//
// 现场（用户报的）：回合只有一个长 step（长流式 / 长 bash）时，敲 `/` 命令十几秒到几分钟
// 没反应 —— 看着就是卡死。根因是派发点只有 step 边界一处。
//
// A) headless：泵点就能派发只读命令；不安全的命令给回执 + 请求中断（结果仍留给主循环）
// B) 真 PTY：单步长流式（mock 先停 2.5s）中敲 /status —— 浮层必须在 800ms 内出现，
//    而旧实现要等这一步走完（≥2.2s）
// ============================================================

const TUIS_P30_LAT_MAX_MS: u64 = 800;     // 派发延迟上限（旧实现 ≥2.2s）

fn tuis_p30_headless_case(tag: &const byte, ok: &bool, ws: &const byte) void {
    var c: Config = cfg_default();
    tuis_cmd_cfg(&c, ws);                 // 与 tui-cmd 同一套配置（不发请求）
    tuis_reset(100, 30);
    tui_headless_enable(true);            // tui_active() 要为真（tuis_reset 只设了 headless 标志）
    var cmds: Buf = buf_new(1024);
    defer { buf_free(&cmds); }
    agent_tui_commands(&cmds);            // 真实命令表（/status、/new 都在里面）
    tui_set_commands(cmds.ptr as &const byte, cmds.len);
    tui_begin_session();
    var h: History = hist_init();
    defer { hist_free(&h); }

    // ---- A1) 只读命令：泵点当场派发（不再等 step 边界）----
    tui_set_run(TUI_RUN_THINK, "跑着呢" as &const byte, bufx_cstr_len("跑着呢" as &const byte));
    tui_input_clear();
    tui_keys_inject("/status\r" as &const byte, 8);   // 注入即处理：面板开→过滤→选中
    agent_tui_poll_pending_cmd(&c, &h);   // 「泵点」的核心：流式每 ≤50ms 就走一次这里
    if !tui_overlay_open() {
        tuis_fail(tag, "运行中敲 /status：泵点没有当场开出浮层", ok);
    } else {
        tui_build();                     // 浮层标题要看屏幕：重画一帧（与 A2 同一套）
        tuis_scan_rows(100, ok, tag);
        if !tuis_screen_has(TUIS_CMD_TITLE) {
            tuis_fail(tag, "泵点派发的 /status 浮层没有标题", ok);
        }
    }
    tui_overlay_close();
    tui_input_clear();

    // ---- A2) 不安全命令：回执 + 请求中断，结果留给主循环 ----
    tui_keys_inject("/new\r" as &const byte, 5);
    agent_tui_poll_pending_cmd(&c, &h);
    tui_build();                          // 回执是转录里的一行：要重画一帧才看得到
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("已收到 /new" as &const byte) {
        tuis_fail(tag, "运行中敲 /new：没有立刻给出回执（用户看到的还是「没反应」）", ok);
    }
    if !tui_interrupt_pending() {
        tuis_fail(tag, "运行中敲 /new：没有请求中断当前回合（口径是「先中断再执行」）", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "/new 不该在泵点里当场执行（它会 hist_free 掉回合正在用的历史）", ok);
    }
    var pend: Buf = buf_new(256);
    defer { buf_free(&pend); }
    if !tui_overlay_peek(&pend) || tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "/new 的结果应当原样留在队列里给主循环", ok);
    }
    _ = tui_overlay_take(&pend);
    _ = tui_interrupt_take();
    tui_input_clear();

    // ---- A3) /compact：泵点不落、step 边界落（它会改写历史，只能在那儿办）----
    tui_keys_inject("/compact\r" as &const byte, 9);
    agent_tui_poll_pending_cmd(&c, &h);
    if tui_interrupt_pending() {
        tuis_fail(tag, "/compact 不该请求中断（它排在 step 边界，不是「先中断再执行」）", ok);
    }
    if !tui_overlay_peek(&pend) {
        tuis_fail(tag, "/compact 的结果应当留在队列里等 step 边界", ok);
    }
    agent_tui_step_boundary_cmd(&c, &h);      // step 边界到了
    if tui_overlay_peek(&pend) {
        tuis_fail(tag, "step 边界没有把 /compact 落地", ok);
    }
    tui_input_clear();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    cfg_free(&c);
}

fn tuis_p30_pty_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_p30" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败（PTY 回合）", ok);
        return;
    }
    mock_mode = 40;                 // 单步长流式：响应头+第一帧立刻发，正文停 2.5s
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    mock_expect_resp = false;
    mock_usage_on = false;
    mock_sse_gap_ns = 2500000000;
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        mock_sse_gap_ns = 0;
        tuis_fail(tag, "mock LLM 起不来（P30 的 PTY 回合）", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        mock_sse_gap_ns = 0;
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        return;
    }
    tui_reset_all();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        mock_sse_gap_ns = 0;
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        return;
    };
    if cpid64 == 0 {
        tuis_child_run_tui(&slave_path, port, ws);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(262144);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 40);      // 首帧
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案（P30 的 PTY 回合）", ok);
    }
    var task: [byte: 64] = "do the slow task\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    tuis_drain(m, &cap, 6);       // ≈300ms：响应头与第一帧已到，正文还停在停顿里
    const t0: u64 = ua_now_ms();
    tuis_write_master(m, "/status\r" as &const byte, 8);
    var title_seen: bool = false;
    var elapsed: u64 = 0;
    var ended_too_early: bool = false;
    var k: i32 = 0;
    while k < 200 && !title_seen {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, TUIS_CMD_TITLE) {
            title_seen = true;
            elapsed = ua_now_ms() - t0;
            // 这一刻正文还没发出来（mock 还在停）：说明浮层是在**这一步的流式过程中**
            // 出来的，而不是等这一步结束。
            if tuis_has(&cap, "SELFTEST_OK" as &const byte) {
                ended_too_early = true;
            }
        }
        k = k + 1;
    }
    if !title_seen {
        tuis_fail(tag, "P30：单步长流式里敲 /status，浮层一直没有出现", ok);
        tuis_dump_tail(&cap, 1500);
    } else if ended_too_early {
        tuis_fail(tag, "P30：浮层是在回合结束之后才出来的（派发点没铺到泵点）", ok);
    } else if elapsed > TUIS_P30_LAT_MAX_MS {
        tuis_fail(tag, "P30：浮层出现得太慢（派发还在等 step 边界？）", ok);
        tuis_puts("  实测延迟 ms = " as &const byte);
        tuis_num(elapsed as usize);
        tuis_puts("  上限 = " as &const byte);
        tuis_num(TUIS_P30_LAT_MAX_MS as usize);
        tuis_puts("\n" as &const byte);
    }
    // 关掉浮层，回合照常跑完
    var esc1: [byte: 1] = [27];
    tuis_write_master(m, &esc1[0], 1);
    var done: bool = false;
    var k2: i32 = 0;
    while k2 < 400 && !done {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, "SELFTEST_OK" as &const byte) {
            done = true;
        }
        k2 = k2 + 1;
    }
    if !done {
        tuis_fail(tag, "P30：浮层关掉之后回合没有正常跑完", ok);
        tuis_dump_tail(&cap, 1200);
    }
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 20000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
    mock_sse_gap_ns = 0;
}

fn tui_p30_round(tag: &const byte) bool {
    var ok: bool = true;
    const ws: &const byte = "build/selftest_ws_tui_p30_headless" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    tuis_p30_headless_case(tag, &ok, ws);
    tuis_p30_pty_case(tag, &ok);
    if ok {
        tuis_ok(tag, "运行中敲 /status 当场出浮层（≤800ms，旧实现要等整个 step）+ /new 立刻回执并请求中断 + 真 PTY 单步长流式复验");
    }
    return ok;
}

// ============================================================
// tui-p31（P31）：请求在飞的那段也插泵点 + 命令派发**当场出帧**
//
//   * A) 只读命令：泵点派发之后**同一次调用里**就画出一帧。旧实现只把浮层标脏，
//     要等下一个泵点（回合内 ≤50ms）或下一次 200ms 轮询才上屏 —— 用户看到的那一下
//     就是「敲完没反应」（真终端实测：空闲 243ms、等响应头那段 4879ms）；
//   * B) 不安全命令的回执（「已收到 /new…」）同样当场出帧，结果仍旧留给主循环；
//   * C) 泵点上下文的口径：登记期间才派发，`agent_pump_ctx_end` 之后必须**不**吞掉
//     面板结果 —— 主循环跑命令时登记/跑完清掉，靠的就是这条不变量。
//
// 帧数用 tui_frame_count()：headless 的 flush fd 是 -1，所以「脏没脏」不成立，
// 能断言的判据是「tui_render 真的被调用过一帧」（build + flush 都走过了）。
// ============================================================

fn tuis_p31_headless_case(tag: &const byte, ok: &bool, ws: &const byte) void {
    var c: Config = cfg_default();
    tuis_cmd_cfg(&c, ws);                 // 与 tui-cmd / tui-p30 同一套配置（不发请求）
    tuis_reset(100, 30);
    tui_headless_enable(true);            // tui_active() 要为真
    var cmds: Buf = buf_new(1024);
    defer { buf_free(&cmds); }
    agent_tui_commands(&cmds);            // 真实命令表（/status、/new 都在里面）
    tui_set_commands(cmds.ptr as &const byte, cmds.len);
    tui_begin_session();
    var h: History = hist_init();
    defer { hist_free(&h); }

    // ---- A) 只读命令：派发之后同一次调用里就出帧 ----
    tui_set_run(TUI_RUN_THINK, "跑着呢" as &const byte, bufx_cstr_len("跑着呢" as &const byte));
    tui_input_clear();
    tui_keys_inject("/status\r" as &const byte, 8);
    const f0: usize = tui_frame_count();
    agent_tui_poll_pending_cmd(&c, &h);
    if !tui_overlay_open() {
        tuis_fail(tag, "P31：泵点没有当场开出浮层", ok);
    }
    if tui_frame_count() != f0 + 1 {
        tuis_fail(tag, "P31：派发之后没有当场出帧（还是等下一个泵点/轮询？）", ok);
        tuis_puts("  帧数 before=" as &const byte);
        tuis_num(f0);
        tuis_puts(" after=" as &const byte);
        tuis_num(tui_frame_count());
        tuis_puts("\n" as &const byte);
    }
    tui_build();                          // 屏幕文本要看：重画一帧（与既有轮同一套）
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_CMD_TITLE) {
        tuis_fail(tag, "P31：派发出来的浮层没有标题", ok);
    }
    tui_overlay_close();
    tui_input_clear();

    // ---- B) 不安全命令：回执也必须当场出帧，结果留给主循环 ----
    tui_keys_inject("/new\r" as &const byte, 5);
    const f1: usize = tui_frame_count();
    agent_tui_poll_pending_cmd(&c, &h);
    if tui_frame_count() != f1 + 1 {
        tuis_fail(tag, "P31：不安全命令的回执没有当场出帧", ok);
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("已收到 /new" as &const byte) {
        tuis_fail(tag, "P31：/new 的回执没有上屏", ok);
    }
    var pend: Buf = buf_new(256);
    defer { buf_free(&pend); }
    if !tui_overlay_peek(&pend) || tui_overlay_kind() != TUI_OVK_PALETTE {
        tuis_fail(tag, "P31：/new 的结果应当原样留给主循环", ok);
    }
    _ = tui_overlay_take(&pend);
    _ = tui_interrupt_take();
    tui_input_clear();

    // ---- C) 泵点上下文：登记期间派发；清掉之后不许再吞结果 ----
    agent_pump_ctx_begin(&c, &h);
    tui_keys_inject("/status\r" as &const byte, 8);
    agent_pump_light();
    if !tui_overlay_open() {
        tuis_fail(tag, "P31：登记了泵点上下文却不派发命令", ok);
    }
    tui_overlay_close();
    tui_input_clear();
    agent_pump_ctx_end(&c);
    tui_keys_inject("/status\r" as &const byte, 8);
    agent_pump_light();
    if tui_overlay_open() {
        tuis_fail(tag, "P31：清掉泵点上下文之后仍然派发了命令（上下文泄漏）", ok);
    }
    if !tui_overlay_peek(&pend) {
        tuis_fail(tag, "P31：面板结果没有留给主循环（被泵点吞了）", ok);
    }
    _ = tui_overlay_take(&pend);
    tui_input_clear();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    cfg_free(&c);
}

fn tui_p31_round(tag: &const byte) bool {
    var ok: bool = true;
    const ws: &const byte = "build/selftest_ws_tui_p31" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    tuis_p31_headless_case(tag, &ok, ws);
    if ok {
        tuis_ok(tag, "派发即出帧（只读命令 / 不安全命令的回执各一帧）+ 泵点上下文登记与清掉的口径");
    }
    return ok;
}

// ============================================================
// 浮层方框：右边框必须逐行对齐（tui-frame 轮的一个小节）
//
// 缺陷的样子（真机截图）：命令面板里 /permission 那一行又长又带全角括号，
// 它把右边框顶了出去 —— 方框右边参差，那一行的 │ 落在别的列上。
// 口径：顶边 / 每一行正文 / 底边的「左边界列」「右边界列」必须逐行相同，
//       而且每行的首尾字符必须真的是边框字形（方框闭合成矩形）。
// ============================================================

// 把 [a, b) 的行文本原样打到 stderr（失败现场用）
fn tuis_dump_span(txt: &const byte, a: usize, b: usize) void {
    _ = sys_write(2, txt + a, b - a) catch {};
    tuis_puts("\n" as &const byte);
}

// 快照里第 row 行的字节区间
fn tuis_line_span(txt: &const byte, n: usize, row: usize, a: &usize, b: &usize) bool {
    var line: usize = 0;
    var start: usize = 0;
    var i: usize = 0;
    while i <= n {
        if i == n || txt[i] == 10 as byte {
            if line == row {
                a[0] = start;
                b[0] = i;
                return true;
            }
            line = line + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

// 一行的左边界列（第一个非空白字符所在列）
fn tuis_row_edge_start(txt: &const byte, n: usize, row: usize) usize {
    var a: usize = 0;
    var b: usize = 0;
    if !tuis_line_span(txt, n, row, &a, &b) {
        return 0;
    }
    var i: usize = a;
    while i < b && txt[i] == 32 as byte {
        i = i + 1;
    }
    if i >= b {
        return 0;
    }
    return tty_cols_between(txt, a, i);
}

// 一行的右边界列（最后一个非空白字符的右边界）
fn tuis_row_edge_end(txt: &const byte, n: usize, row: usize) usize {
    var a: usize = 0;
    var b: usize = 0;
    if !tuis_line_span(txt, n, row, &a, &b) {
        return 0;
    }
    var e: usize = b;
    while e > a && txt[e - 1] == 32 as byte {
        e = e - 1;
    }
    return tty_cols_between(txt, a, e);
}

// 一行首 / 尾**非空白字符**的起始字节偏移（空行给 n）
fn tuis_row_edge_offsets(txt: &const byte, n: usize, row: usize, first: &usize, last: &usize) void {
    first[0] = n;
    last[0] = n;
    var a: usize = 0;
    var b: usize = 0;
    if !tuis_line_span(txt, n, row, &a, &b) {
        return;
    }
    var i: usize = a;
    while i < b && txt[i] == 32 as byte {
        i = i + 1;
    }
    if i >= b {
        return;
    }
    first[0] = i;
    var e: usize = b;
    while e > a && txt[e - 1] == 32 as byte {
        e = e - 1;
    }
    var s: usize = e - 1;                       // 回退到该字符的起始字节
    while s > a && tty_is_cont(txt[s]) {
        s = s - 1;
    }
    last[0] = s;
}

// 找出含 lit 的行号（从 from 起）；没有则返回 rows
fn tuis_find_lit_row(txt: &const byte, n: usize, from: usize, rows: usize, lit: &const byte) usize {
    const ln: usize = bufx_cstr_len(lit);
    var r: usize = from;
    while r < rows {
        var a: usize = 0;
        var b: usize = 0;
        if !tuis_line_span(txt, n, r, &a, &b) {
            return rows;
        }
        var i: usize = a;
        while i + ln <= b {
            if bufx_mem_eq(txt + i, lit, ln) {
                return r;
            }
            i = i + 1;
        }
        r = r + 1;
    }
    return rows;
}

// 行首 / 行尾那个字符必须是方框的边（竖边或圆角）
fn tuis_border_left_ok(p: &const byte) bool {
    return bufx_mem_eq(p, "│" as &const byte, 3)
        || bufx_mem_eq(p, "╭" as &const byte, 3)
        || bufx_mem_eq(p, "╰" as &const byte, 3);
}

fn tuis_border_right_ok(p: &const byte) bool {
    return bufx_mem_eq(p, "│" as &const byte, 3)
        || bufx_mem_eq(p, "╮" as &const byte, 3)
        || bufx_mem_eq(p, "╯" as &const byte, 3);
}

// 一屏浮层：渲染 → 断言方框右边逐行对齐（+ 左右两边都在同一列）
fn tuis_overlay_frame_check(cols: usize, ok: &bool, tag: &const byte) void {
    tui_build();
    tuis_scan_rows(cols, ok, tag);
    var txt: Buf = buf_new(65536);
    defer { buf_free(&txt); }
    _ = tui_screen_text(&txt);
    const p: &const byte = txt.ptr as &const byte;
    const n: usize = txt.len;
    const top: usize = tuis_find_lit_row(p, n, 0, tui_nrows(), "╭" as &const byte);
    const bot: usize = tuis_find_lit_row(p, n, top + 1, tui_nrows(), "╰" as &const byte);
    if top >= tui_nrows() || bot >= tui_nrows() {
        tuis_fail(tag, "浮层没有画出来（找不到 ╭ / ╰）", ok);
        return;
    }
    const want_l: usize = tuis_row_edge_start(p, n, top);
    const want_r: usize = tuis_row_edge_end(p, n, top);
    var bad: bool = false;
    var bad_row: usize = 0;
    var got_l: usize = 0;
    var got_r: usize = 0;
    var r: usize = top;
    while r <= bot {
        got_l = tuis_row_edge_start(p, n, r);
        got_r = tuis_row_edge_end(p, n, r);
        var fo: usize = n;
        var lo: usize = n;
        tuis_row_edge_offsets(p, n, r, &fo, &lo);
        const closed: bool = fo < n && lo < n && tuis_border_left_ok(p + fo) && tuis_border_right_ok(p + lo);
        if got_l != want_l || got_r != want_r || !closed {
            bad = true;
            bad_row = r;
            break;
        }
        r = r + 1;
    }
    if bad {
        tuis_fail(tag, "浮层方框没有闭合成矩形（右边框逐行没对齐）", ok);
        tuis_puts("  cols=");
        tuis_num(cols);
        tuis_puts(" row=");
        tuis_num(bad_row);
        tuis_puts(" 该行左/右边界=");
        tuis_num(got_l);
        tuis_puts("/");
        tuis_num(got_r);
        tuis_puts(" 顶边左/右边界=");
        tuis_num(want_l);
        tuis_puts("/");
        tuis_num(want_r);
        tuis_puts("\n");
        var a: usize = 0;
        var b: usize = 0;
        var k: usize = top;
        while k <= bot && k < top + 16 {
            if tuis_line_span(p, n, k, &a, &b) {
                tuis_dump_span(p, a, b);
            }
            k = k + 1;
        }
    }
}

// 一组画布宽度 × 真实浮层内容：命令面板（真实命令表）/ 帮助 / 确认（prompt + 条目）
fn tuis_overlay_frames(ok: &bool, tag: &const byte) void {
    var cmds: Buf = buf_new(4096);
    defer { buf_free(&cmds); }
    agent_tui_commands(&cmds);            // 真机那张截图里的命令表（/permission 是最长的一行）
    const help: &const byte = "enter 发送 · ctrl+j / alt+enter 换行 · esc 中断 · ctrl+c 中断或退出\npgup/pgdn 滚动 · ctrl+home/end 顶/尾 · tab 计划模式 · shift+tab 访问模式 · ctrl+p 命令面板" as &const byte;
    const prompt: &const byte = "启用后不再询问：agent 可以直接改文件、跑任意命令（含关闭文件沙箱）。仅建议在你信任当前任务时使用。" as &const byte;
    const cjk: &const byte = "✓ Read Only（只读）\n✓ Workspace Write（工作区写）\n  Full access（全权）" as &const byte;
    const sizes: [usize: 5] = [120, 100, 80, 70, 60];
    var si: usize = 0;
    while si < 5 {
        const cols: usize = sizes[si];
        const rows: usize = 30;
        // 命令面板：**真实命令表** —— /permission 那一行 69 列，在 60 列的方框里必然要
        // 截断补 '…'，正是踩坑 40 的现场（其余几行都是短的，截断那条路只有它会走到）
        tuis_reset(cols, rows);
        tui_set_commands(cmds.ptr as &const byte, cmds.len);
        tui_overlay_list(TUI_OVK_PALETTE, "命令" as &const byte, 6, cmds.ptr as &const byte, cmds.len);
        tuis_overlay_frame_check(cols, ok, tag);
        tui_overlay_close();
        // 帮助浮层：整行全中文（宽字符 + 折行都走同一条排版）
        tuis_reset(cols, rows);
        tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, help, bufx_cstr_len(help));
        tuis_overlay_frame_check(cols, ok, tag);
        tui_overlay_close();
        // 确认浮层：多一行 prompt（正文预算与条目行同一条路）
        tuis_reset(cols, rows);
        tui_overlay_confirm(TUI_OVK_PLAN, prompt, bufx_cstr_len(prompt), cjk, bufx_cstr_len(cjk));
        tuis_overlay_frame_check(cols, ok, tag);
        tui_overlay_close();
        si = si + 1;
    }
}

// ============================================================
// tui-diff（P28）：/diff 浮窗的排版与按键
//   * 数据由 gd_load_fixture 注入（不碰 git）：3 个文件、2 个 hunk、5 个上下文行
//   * 断言：几何/标题/列头、左列表选中标记、右两栏同行的旧新文本、
//     竖线**逐行同列**（对齐）、滚动/切换/左右滚、脏字节清洗、esc 关闭、
//     终端太小时不开浮窗（tui_overlay_diff_fits）
// ============================================================

const TUIS_DIFF_FILES: &const byte = "M  src/tui.uya  (+3 -1)\n??  src/gitdiff.uya  (new)\nM  README.md  (+1 -0)\n" as &const byte;
const TUIS_DIFF_TEXT: &const byte = "diff --git a/src/tui.uya b/src/tui.uya\nindex 1111111..2222222 100644\n--- a/src/tui.uya\n+++ b/src/tui.uya\n@@ -1,5 +1,5 @@\n fn tui_overlay() {\n-    @println(\"Hello, Uya!\");\n+    @println(\"Hello, DSH!\");\n     tui_draw();\n }\n@@ -20,2 +20,3 @@\n ctx20\n+line add\n" as &const byte;

fn tuis_fixture_open() void {
    var files: Buf = buf_new(256);
    defer { buf_free(&files); }
    var diff: Buf = buf_new(1024);
    defer { buf_free(&diff); }
    _ = buf_append_cstr(&files, TUIS_DIFF_FILES);
    _ = buf_append_cstr(&diff, TUIS_DIFF_TEXT);
    gd_load_fixture("uya-agent" as &const byte, &files, &diff);
    tui_overlay_diff_open();
}

// P36：第 i 行是不是「改动行」（MIX/DEL/ADD）—— 跳转断言不写死行号，用这条判据
fn tuis_row_is_change(i: usize) bool {
    var meta: GdRow = GdRow{
        l_off: 0, l_len: 0, r_off: 0, r_len: 0, l_no: 0, r_no: 0, kind: 255
    };
    if !gd_row_meta(i, &meta) {
        return false;
    }
    return meta.kind == GD_K_MIX || meta.kind == GD_K_DEL || meta.kind == GD_K_ADD;
}

// 屏幕文本里第 row 行的字节区间
fn tuis_line_range(out: &const Buf, row: usize, off: &usize, len: &usize) bool {
    var line: usize = 0;
    var start: usize = 0;
    var p: usize = 0;
    while p <= out.len {
        if p == out.len || out.ptr[p] == 10 as byte {
            if line == row {
                off[0] = start;
                len[0] = p - start;
                return true;
            }
            line = line + 1;
            start = p + 1;
        }
        p = p + 1;
    }
    return false;
}

// 第 row 行里 '│'（U+2502）出现的**显示列**（前 max 个），返回个数
fn tuis_pipe_cols(out: &const Buf, row: usize, cols: &usize, max: usize) usize {
    var off: usize = 0;
    var len: usize = 0;
    if !tuis_line_range(out, row, &off, &len) {
        return 0;
    }
    var n: usize = 0;
    var col: usize = 0;
    var i: usize = 0;
    while i < len {
        const c: byte = out.ptr[off + i];
        if c == 0xE2 as byte && i + 2 < len && out.ptr[off + i + 1] == 0x94 as byte && out.ptr[off + i + 2] == 0x82 as byte {
            if n < max {
                cols[n] = col;
            }
            n = n + 1;
            col = col + 1;
            i = i + 3;
            continue;
        }
        const step: usize = tty_utf8_next(out.ptr as &const byte, off + i, off + len) - (off + i);
        const cp: u32 = tty_utf8_decode(out.ptr as &const byte, off + i, off + len);
        col = col + tty_char_cols(cp);
        if step == 0 {
            i = i + 1;
        } else {
            i = i + step;
        }
    }
    return n;
}

// 失败时把整屏按行打出来（行号 + 该行竖线所在的显示列）
fn tuis_dump_screen(tag: &const byte) void {
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    _ = tui_screen_text(&out);
    out_err("selftest[");
    out_err(tag);
    out_err("] 屏幕（cols=");
    out_err_dec(tui_cols());
    out_err(" rows=");
    out_err_dec(tui_rows());
    out_err("）：\n");
    var r: usize = 0;
    while r < tui_nrows() {
        var off: usize = 0;
        var len: usize = 0;
        if tuis_line_range(&out, r, &off, &len) {
            out_err("  [");
            out_err_dec(r);
            out_err("] ");
            out_err_bytes(out.ptr + off, len);
            out_err("\n");
        }
        r = r + 1;
    }
    out_err("  hscroll=");
    out_err_dec(gd_hscroll());
    out_err(" scroll=");
    out_err_dec(gd_scroll());
    out_err(" sel=");
    out_err_dec(gd_sel());
    out_err(" rows=");
    out_err_dec(gd_rows());
    out_err("\n");
}

fn tuis_row_has_pipe_at(out: &const Buf, row: usize, want: usize) bool {
    var cols: [usize: 8] = [0: 8];
    const n: usize = tuis_pipe_cols(out, row, &cols[0], 8);
    var i: usize = 0;
    while i < n && i < 8 {
        if cols[i] == want {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 抓到 lit 为止（或超时）：跑真 git 要等一下
fn tuis_drain_until(m: i32, out: &Buf, lit: &const byte, budget_ms: i32) bool {
    var waited: i32 = 0;
    while waited < budget_ms {
        if tuis_has(out, lit) {
            return true;
        }
        tuis_drain(m, out, 2);
        waited = waited + 100;
    }
    return tuis_has(out, lit);
}

// 真 PTY 里的 /diff（P28）：走完全真实的那条路 ——
// 键盘字节 → TUI 主循环 → agent_tui_command → gd_open（在本进程 fork git）
// → 浮窗 → esc → ctrl-d 退出。
fn tui_diff_pty_case(tag: &const byte, ok: &bool) void {
    if !gitx_available() {
        tuis_puts("selftest[");
        tuis_puts(tag);
        tuis_puts("] skip（本机 PATH 里没有 git）\n");
        return;
    }
    if !dg_fixture_make() {
        tuis_fail(tag, "造 git fixture 仓失败", ok);
        return;
    }
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    }
    // 父进程这边先把 TUI 全局复位（子进程是 fork 出去的，互不影响）
    tuis_reset(100, 30);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork 失败", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    };
    if cpid64 == 0 {
        tuis_child_run_tui(&slave_path, port, DG_WS);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(131072);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 6);
    // 敲 /diff + 回车
    tuis_write_master(m, "/diff\r" as &const byte, 6);
    if !tuis_drain_until(m, &cap, "/diff · " as &const byte, 4000) {
        tuis_fail(tag, "真 PTY 里敲 /diff 没有画出浮窗", ok);
        tuis_dump_cap(&cap, 600);
    } else {
        if !tuis_has(&cap, "旧 · HEAD" as &const byte) || !tuis_has(&cap, "新 · 工作区" as &const byte) {
            tuis_fail(tag, "浮窗没有两栏列头", ok);
        }
        if !tuis_has(&cap, "src/tui.uya  (+3 -1)" as &const byte) && !tuis_has(&cap, "a.uya" as &const byte) {
            tuis_fail(tag, "左列表里没有 fixture 的文件（真 git 的 status 没走到列表里）", ok);
        }
        if !tuis_has(&cap, "CHANGED" as &const byte) {
            tuis_fail(tag, "右栏没有 fixture 的新内容（没真的跑 git diff）", ok);
            tuis_dump_cap(&cap, 600);
        }
        // ↓ 换到下一个文件（git 先报已跟踪的改动：a.uya → c.uya → 未跟踪的 b.uya）
        var down: [byte: 3] = [27, 91, 66];
        tuis_write_master(m, &down[0], 3);
        tuis_drain(m, &cap, 12);
        if !tuis_has(&cap, "gone1" as &const byte) {
            tuis_fail(tag, "↓ 之后没有换成下一个文件的 diff（真 PTY 里没重载）", ok);
            tuis_dump_tail(&cap, 900);
        }
        // esc 关浮窗：单独发一帧 —— 和别的字节粘在一起会被当成转义序列吃掉
        var esc1: [byte: 1] = [27];
        tuis_write_master(m, &esc1[0], 1);
        tuis_drain(m, &cap, 12);
        // P34：真 PTY 里敲 `/workspace <绝对路径>` —— 切到另一个目录，脚注 cwd 当场跟着变。
        // 路径必须给绝对的：相对路径按**当前工作区**（fixture 仓）解析。
        _ = sess_mkdir_p("build/selftest_ws_p31_b");
        var root: Buf = buf_new(1024);
        defer { buf_free(&root); }
        var got_root: bool = agent_getcwd_into(&root);
        var cmd: Buf = buf_new(2048);
        defer { buf_free(&cmd); }
        if got_root {
            _ = buf_append_cstr(&cmd, "/workspace ");
            _ = buf_append(&cmd, root.ptr as &const byte, root.len);
            _ = buf_append_cstr(&cmd, "/build/selftest_ws_p31_b\r");
            tuis_write_master(m, cmd.ptr as &const byte, cmd.len);
            // 带参数的命令与 `/goal pause` 同一条路（P23 的既有行为）：第一个 `/` 开命令面板，
            // 面板里匹配不上 → 回车把整行文字还回输入行（并留一条 notice），**再**回车才派发。
            tuis_drain(m, &cap, 10);
            var cr: [byte: 1] = [13];
            tuis_write_master(m, &cr[0], 1);
            if !tuis_drain_until(m, &cap, "selftest_ws_p31_b" as &const byte, 4000) {
                tuis_fail(tag, "真 PTY 里敲 /workspace 之后屏幕上没有新工作区", ok);
                tuis_dump_tail(&cap, 900);
            } else {
                // 命中「selftest_ws_p31_b」可能只是脚注先画出来：再多收一会儿，
                // 转录里那条通知（`工作区 → …`）随后就到
                tuis_drain(m, &cap, 12);
                if !tuis_has(&cap, "工作区 → " as &const byte) {
                    tuis_fail(tag, "真 PTY 里切换工作区没有留通知", ok);
                    tuis_dump_tail(&cap, 1200);
                }
            }
        }
    }
    // 退出：esc（关浮层）→ ctrl-d（空行退出）。不用 `/exit`：输入以 `/` 开头会先开
    // 命令面板，退出路径就绕到面板派发那一条上去了 —— 这一轮要钉的是 /diff 浮层。
    // 注意 wait_raw 只能成功一次（收掉之后 waitpid 就是 ECHILD），所以用一个 bool 串起来。
    var esc1b: [byte: 1] = [27];
    var ctrl_d: [byte: 1] = [4];
    var st: i32 = 0;
    var exited: bool = false;
    var attempt: usize = 0;
    while attempt < 3 && !exited {
        tuis_write_master(m, &esc1b[0], 1);   // esc：关浮层 / 空闲态清输入行
        tuis_drain(m, &cap, 8);
        tuis_write_master(m, &ctrl_d[0], 1);  // ctrl-d：空输入行 → 退出
        tuis_drain(m, &cap, 12);
        exited = tuis_wait_raw(cpid, &st, 4000);
        attempt = attempt + 1;
    }
    if !exited {
        tuis_fail(tag, "敲 /diff 之后子进程没有正常退出", ok);
        tuis_dump_tail(&cap, 900);
        _ = sys_kill(cpid as i64, SIGKILL) catch {};
    } else {
        const code: i32 = (st >> (8 as i32)) & 255;
        if code != 0 {
            tuis_fail(tag, "/diff 之后退出的码不是 0", ok);
            tuis_dump_cap(&cap, 600);
        }
    }
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
}

fn tui_diff_round(tag: &const byte) bool {
    var ok: bool = true;
    // ---- 1) 100×28：几何、标题、列头、列表选中标记 ----
    tuis_reset(100, 28);
    tuis_fixture_open();
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_DIFF {
        tuis_fail(tag, "浮窗没有打开（或 kind 不是 TUI_OVK_DIFF）", &ok);
        return ok;
    }
    if !tui_overlay_diff_fits() {
        tuis_fail(tag, "100×28 应当能画下 /diff 浮窗", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tui_overlay_diff_rows() < 8 {
        tuis_fail(tag, "内容行数太少（几何算错了）", &ok);
    }
    if !tuis_screen_has("╭" as &const byte) || !tuis_screen_has("╰" as &const byte) {
        tuis_fail(tag, "浮窗没有圆角边框", &ok);
    }
    if !tuis_screen_has("/diff · uya-agent" as &const byte) {
        tuis_fail(tag, "标题里没有 /diff 与仓库名", &ok);
    }
    if !tuis_screen_has("文件 (3)" as &const byte) {
        tuis_fail(tag, "左列表没有「文件 (N)」列头", &ok);
    }
    if !tuis_screen_has("旧 · HEAD" as &const byte) || !tuis_screen_has("新 · 工作区" as &const byte) {
        tuis_fail(tag, "右工作区没有两栏列头", &ok);
    }
    if !tuis_screen_has("▸ M  src/tui.uya" as &const byte) {
        tuis_fail(tag, "选中行没有 ▸ 标记（或不是第一个文件）", &ok);
    }
    if !tuis_screen_has("??  src/gitdiff.uya" as &const byte) || !tuis_screen_has("README.md" as &const byte) {
        tuis_fail(tag, "左列表没有列全三个文件", &ok);
    }
    if !tuis_screen_has("+3 -1" as &const byte) {
        tuis_fail(tag, "标题/提示行里没有增删计数", &ok);
    }
    // 同一行里同时出现旧文本与新文本 ⇒ 确实是「两栏比对」
    var dual: bool = false;
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, "Hello, Uya!" as &const byte) && tui_row_has(r, "Hello, DSH!" as &const byte) {
            dual = true;
        }
        r = r + 1;
    }
    if !dual {
        tuis_fail(tag, "没有任何一行同时显示旧文本与新文本（不是并排比对）", &ok);
    }
    if !tuis_screen_has("@@ -1,5 +1,5 @@" as &const byte) {
        tuis_fail(tag, "hunk 说明行没有画出来", &ok);
    }
    if !tuis_screen_has("pgup/pgdn 滚动" as &const byte) {
        tuis_fail(tag, "提示行没有键位说明", &ok);
    }

    // ---- 1b) P36：改动部分的背景色（整行铺底）+ 配对行的行内高亮 ----
    // 找出「同一行里既有旧文本又有新文本」的那一行（= 配对的 MIX 行）
    var mix_row: usize = 0;
    var have_mix: bool = false;
    var fr: usize = 0;
    while fr < tui_nrows() {
        if tui_row_has(fr, "Hello, Uya!" as &const byte) && tui_row_has(fr, "Hello, DSH!" as &const byte) {
            mix_row = fr;
            have_mix = true;
            break;
        }
        fr = fr + 1;
    }
    // 同一帧里再找一个上下文行（只有 Hello, Uya! 没有 DSH，且不是说明行）
    var ctx_row: usize = 0;
    var have_ctx: bool = false;
    var cr2: usize = 0;
    while cr2 < tui_nrows() {
        if tui_row_has(cr2, "Hello, Uya!" as &const byte) && !tui_row_has(cr2, "Hello, DSH!" as &const byte) {
            ctx_row = cr2;
            have_ctx = true;
            break;
        }
        cr2 = cr2 + 1;
    }
    if !have_mix {
        tuis_fail(tag, "找不到配对行（MIX）来验证背景色", &ok);
    } else {
        const wcols: usize = tui_row_cols_n(mix_row);
        var saw_del_bg: bool = false;
        var saw_add_bg: bool = false;
        var saw_del_hl: bool = false;
        var saw_add_hl: bool = false;
        var cpos: usize = 0;
        while cpos < wcols {
            const st: u8 = tui_row_style_at(mix_row, cpos);
            if st == TUI_ST_DEL_BG {
                saw_del_bg = true;
            }
            if st == TUI_ST_ADD_BG {
                saw_add_bg = true;
            }
            if st == TUI_ST_DEL_HL {
                saw_del_hl = true;
            }
            if st == TUI_ST_ADD_HL {
                saw_add_hl = true;
            }
            cpos = cpos + 1;
        }
        if !saw_del_bg || !saw_add_bg {
            tuis_fail(tag, "配对行没有整行铺底（左删红底 / 右增绿底）", &ok);
            tuis_dump_screen(tag);
        }
        if !saw_del_hl || !saw_add_hl {
            tuis_fail(tag, "配对行没有行内高亮（真正变了的片段）", &ok);
            tuis_dump_screen(tag);
        }
    }
    if have_ctx {
        // 上下文行不铺底：内容列不该出现任何底色/高亮
        const ccols: usize = tui_row_cols_n(ctx_row);
        var k2: usize = 0;
        while k2 < ccols {
            const st: u8 = tui_row_style_at(ctx_row, k2);
            if st == TUI_ST_DEL_BG || st == TUI_ST_ADD_BG || st == TUI_ST_DEL_HL || st == TUI_ST_ADD_HL {
                tuis_fail(tag, "上下文行不该有改动底色", &ok);
                tuis_dump_screen(tag);
                break;
            }
            k2 = k2 + 1;
        }
    }
    // 样式的 SGR 编码里必须真的带背景（48;5;）：整行底色与行内高亮各一档
    var sgr: Buf = buf_new(64);
    defer { buf_free(&sgr); }
    tui_set_color(true, true);
    tui_style_sgr(TUI_ST_ADD_BG, &sgr);
    if !tuis_has(&sgr, "48;5;22" as &const byte) {
        tuis_fail(tag, "ADD_BG 的 SGR 里没有深绿背景（48;5;22）", &ok);
    }
    tui_style_sgr(TUI_ST_DEL_HL, &sgr);
    if !tuis_has(&sgr, "48;5;124" as &const byte) {
        tuis_fail(tag, "DEL_HL 的 SGR 里没有亮红背景（48;5;124）", &ok);
    }
    // 既有的样式编码不许被「4 槽扩 8 槽」改掉
    tui_style_sgr(TUI_ST_ADD, &sgr);
    if !tuis_has(&sgr, "38;5;42" as &const byte) || tuis_has(&sgr, "48;5;" as &const byte) {
        tuis_fail(tag, "扩槽把既有 ADD 样式的编码改了（应当仍是纯前景 38;5;42）", &ok);
    }
    tui_set_color(false, false);

    // ---- 1c) P36：行内高亮的切分（纯函数，直接问渲染用的那份状态）----
    // ASCII：Hello, Uya! → Hello, DSH!，公共前缀 "Hello, "（7 字节）、后缀 "!"（1 字节）
    var hp: usize = 0;
    var lm: usize = 0;
    var rm: usize = 0;
    tui_diff_hl_split("Hello, Uya!" as &const byte, 11, "Hello, DSH!" as &const byte, 11,
        &hp, &lm, &rm);
    if hp != 7 || lm != 3 || rm != 3 {
        tuis_fail(tag, "ASCII 配对行的切分不对（应当是 pre=7 / 两侧 mid=3）", &ok);
    }
    // 全是汉字（3 字节/字）：旧 = 「改这一行」，新 = 「改那行」→ 前缀「改」(3)，后缀「行」(3)
    const cjk_a: &const byte = "改这一行" as &const byte;
    const cjk_b: &const byte = "改那行" as &const byte;
    tui_diff_hl_split(cjk_a, 12, cjk_b, 9, &hp, &lm, &rm);
    if hp != 3 || lm != 6 || rm != 3 {
        tuis_fail(tag, "汉字配对行的切分不对（应当切在字符边界：pre=3 / mid=6,3）", &ok);
    }
    // 切点落在汉字中间时不许把汉字切开。旧 = 「甲」(e7 94 b2)，新 = 「乙」(e7 94 b3)：
    // 逐字节比的公共前缀是 2（两个字的头两个字节 e7 94 相同），**落在「甲」中间** ——
    // 必须让到字符起点 0，两侧变化段各 3 字节（整字换掉），绝不能各 1 字节。
    const cjk_c: &const byte = "\xe7\x94\xb2" as &const byte;
    const cjk_d: &const byte = "\xe7\x94\xb3" as &const byte;
    tui_diff_hl_split(cjk_c, 3, cjk_d, 3, &hp, &lm, &rm);
    if hp != 0 || lm != 3 || rm != 3 {
        tuis_fail(tag, "切点落在汉字中间时没有让到字符起点（pre/mid 应当是 0/3,3）", &ok);
    }
    // 同族：旧 = 「ab改动」新 = 「ab改了」—— 公共前缀是「ab改」(5 字节)，变化段各 1 个字
    const cjk_e: &const byte = "ab\xe6\x94\xb9\xe5\x8a\xa8" as &const byte;
    const cjk_f: &const byte = "ab\xe6\x94\xb9\xe4\xba\x86" as &const byte;
    tui_diff_hl_split(cjk_e, 8, cjk_f, 8, &hp, &lm, &rm);
    if hp != 5 || lm != 3 || rm != 3 {
        tuis_fail(tag, "汉字配对行的切分不对（应当是 pre=5 / 两侧 mid=3）", &ok);
    }
    if (lm % (3 as usize)) != 0 || (rm % (3 as usize)) != 0 {
        tuis_fail(tag, "变化段的长度不是 3 的倍数（汉字被切开了）", &ok);
    }
    // 完全相同的两行：没有变化段 → 不做行内高亮
    tui_diff_hl_split("same" as &const byte, 4, "same" as &const byte, 4, &hp, &lm, &rm);
    if lm != 0 || rm != 0 {
        tuis_fail(tag, "完全相同的两行不该有变化段", &ok);
    }
    // 单侧为空（落单的增/删）→ 不做行内高亮
    tui_diff_hl_split("" as &const byte, 0, "new" as &const byte, 3, &hp, &lm, &rm);
    if lm != 0 || rm != 0 {
        tuis_fail(tag, "单侧为空时不该有变化段", &ok);
    }

    // ---- 2) 竖线逐行同列（列对齐）----
    var screen: Buf = buf_new(65536);
    defer { buf_free(&screen); }
    _ = tui_screen_text(&screen);
    var l0: usize = 0;
    var l0len: usize = 0;
    if !tuis_line_range(&screen, 0, &l0, &l0len) {
        tuis_fail(tag, "取不到屏幕第 0 行", &ok);
    }
    // 边框列：列头行（第 1 行）的左竖线在第 2 列
    if !tuis_row_has_pipe_at(&screen, 1, 2) {
        tuis_fail(tag, "列头行的左竖线不在第 2 列", &ok);
        tuis_dump_screen(tag);
    }
    var row: usize = 0;
    var bad: bool = false;
    while row < tui_nrows() {
        var cols: [usize: 8] = [0: 8];
        const n: usize = tuis_pipe_cols(&screen, row, &cols[0], 8);
        // 每一行只要有竖线，第一根必须在第 2 列（所有行共用同一个边框）
        if n > 0 && cols[0] != 2 {
            bad = true;
        }
        row = row + 1;
    }
    if bad {
        tuis_fail(tag, "有行的左竖线不在第 2 列（边框没对齐）", &ok);
    }
    // 内容行：两栏行的竖线（左边框/列表缝/中缝/右框）必须逐行同列；
    // 跨栏的说明行（@@ / 无换行结尾）故意没有中缝，所以只要求是两栏行的子集。
    var cols4: [usize: 8] = [0: 8];
    const n4: usize = tuis_pipe_cols(&screen, 3, &cols4[0], 8);   // 第 3 行 = 第一个上下文行
    if n4 != 4 {
        tuis_fail(tag, "两栏内容行应当有 4 根竖线（左右边框 + 列表缝 + 中缝）", &ok);
        tuis_dump_screen(tag);
    }
    var rr: usize = 3;
    while rr < 12 {
        var colsx: [usize: 8] = [0: 8];
        const nx: usize = tuis_pipe_cols(&screen, rr, &colsx[0], 8);
        if nx == 4 {
            var q: usize = 0;
            while q < 4 {
                if colsx[q] != cols4[q] {
                    tuis_fail(tag, "两栏内容行的竖线不在同一列（中缝/两栏没对齐）", &ok);
                    tuis_dump_screen(tag);
                    break;
                }
                q = q + 1;
            }
        } else if nx == 3 {
            // 跨栏说明行：左/列表缝/右框三根必须还在原来的列上
            if colsx[0] != cols4[0] || colsx[1] != cols4[1] || colsx[2] != cols4[3] {
                tuis_fail(tag, "跨栏说明行的竖线没有落在两栏行的列上", &ok);
                tuis_dump_screen(tag);
            }
        } else {
            tuis_fail(tag, "内容行的竖线根数既不是 4 也不是 3（列宽算错了）", &ok);
            tuis_dump_screen(tag);
        }
        rr = rr + 1;
    }

    // ---- 2b) 运行中开浮窗：状态区（P18）必须照样看得见（浮层重画转录区之后要补回来）----
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("Bash(make check)" as &const byte) {
        tuis_fail(tag, "运行中开 /diff 之后状态行不见了（浮层重画没把状态区补回来）", &ok);
        tuis_dump_screen(tag);
    }
    if !tuis_screen_has("/diff · uya-agent" as &const byte) {
        tuis_fail(tag, "补状态区时把浮窗本身弄丢了", &ok);
    }
    if tui_nrows() != 28 {
        tuis_fail(tag, "开了浮窗之后整帧行数变了（终端上会留下上一帧的残影）", &ok);
        tuis_dump_screen(tag);
    }
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    tui_build();

    // ---- 3) 键：↓ 换文件、← 横向滚、pgdn 翻页、r 刷新、esc 关闭 ----
    var before: Buf = buf_new(65536);
    defer { buf_free(&before); }
    _ = buf_append(&before, screen.ptr, screen.len);
    tui_keys_inject("\x1b[B" as &const byte, 3);   // ↓
    if gd_sel() != 1 {
        tuis_fail(tag, "↓ 没有把选择移到第二个文件", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("▸ ??  src/gitdiff.uya" as &const byte) {
        tuis_fail(tag, "↓ 之后 ▸ 没有落在第二个文件上", &ok);
    }
    if !tuis_screen_has("Hello, DSH!" as &const byte) {
        tuis_fail(tag, "↓ 之后右工作区的内容没了（假数据不分文件，但内容必须还在）", &ok);
        tuis_dump_screen(tag);
    }
    tui_keys_inject("\x1b[A" as &const byte, 3);   // ↑
    if gd_sel() != 0 {
        tuis_fail(tag, "↑ 没有回到第一个文件", &ok);
    }
    tui_keys_inject("\x1b[C" as &const byte, 3);   // →
    if gd_hscroll() == 0 {
        tuis_fail(tag, "→ 没有横向滚动", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("‹" as &const byte) {
        tuis_fail(tag, "横向滚动之后没有 ‹ 标记（看不见「左边还有内容」）", &ok);
        tuis_dump_screen(tag);
    }
    tui_keys_inject("\x1b[D" as &const byte, 3);   // ←
    if gd_hscroll() != 0 {
        tuis_fail(tag, "← 没有把横向滚动退回 0", &ok);
    }
    tui_keys_inject("r" as &const byte, 1);        // r：假数据没有仓库，刷新会失败但内容必须留着
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tui_overlay_open() {
        tuis_fail(tag, "按 r 之后浮窗被关掉了", &ok);
    }
    if !tuis_screen_has("Hello, DSH!" as &const byte) {
        tuis_fail(tag, "刷新失败时不该把已有内容丢掉", &ok);
    }
    // P36：n/N 改动间跳转。假数据的行表是「1 HDR + 上下文 + MIX + 上下文 + HDR + 上下文 + ADD」，
    // 改动行 = 那一处 MIX 与末尾的 ADD；断言落点就是改动行（不写死行号，免得绑死假数据排版）。
    gd_scroll_home();
    tui_keys_inject("n" as &const byte, 1);
    if !tuis_row_is_change(gd_scroll()) {
        tuis_fail(tag, "n 没有跳到改动行", &ok);
        tuis_dump_screen(tag);
    }
    // 再按一次 n：本文件（假数据只有一个文件）环绕 —— 仍落在改动行上
    tui_keys_inject("n" as &const byte, 1);
    if !tuis_row_is_change(gd_scroll()) {
        tuis_fail(tag, "连按 n 之后落点不是改动行（环绕不对）", &ok);
    }
    tui_keys_inject("N" as &const byte, 1);
    if !tuis_row_is_change(gd_scroll()) {
        tuis_fail(tag, "N 往回没有跳到改动行", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("n/N 改动" as &const byte) {
        tuis_fail(tag, "提示行里没有 n/N 键位说明", &ok);
    }
    tui_keys_inject("q" as &const byte, 1);
    if tui_overlay_open() {
        tuis_fail(tag, "q 没有关掉浮窗", &ok);
    }
    if !tui_overlay_cancelled() {
        tuis_fail(tag, "q 关闭没有走「取消」语义（主循环会当成一次提交）", &ok);
    }

    // ---- 4) 80×14：内容装不下时的翻页 ----
    tuis_reset(80, 14);
    tuis_fixture_open();
    if !tui_overlay_diff_fits() {
        tuis_fail(tag, "80×14 应当还能画下（刚好到下限）", &ok);
    }
    tui_build();
    tuis_scan_rows(80, &ok, tag);
    const rows_small: usize = tui_overlay_diff_rows();
    if gd_rows() <= rows_small {
        tuis_fail(tag, "这组数据本该放不下（测试用例选得太小）", &ok);
    }
    if gd_scroll() != 0 {
        tuis_fail(tag, "刚打开时应当停在顶部", &ok);
    }
    tui_keys_inject("\x1b[6~" as &const byte, 4);   // pgdn
    if gd_scroll() == 0 {
        tuis_fail(tag, "pgdn 没有翻页", &ok);
    }
    tui_build();
    tuis_scan_rows(80, &ok, tag);
    var screen2: Buf = buf_new(65536);
    defer { buf_free(&screen2); }
    _ = tui_screen_text(&screen2);
    if screen2.len == 0 {
        tuis_fail(tag, "翻页之后屏幕文本是空的", &ok);
    }
    tui_keys_inject("\x1b[5~" as &const byte, 4);   // pgup
    if gd_scroll() != 0 {
        tuis_fail(tag, "pgup 没有回到顶部（夹取不对）", &ok);
    }
    tui_keys_inject("\x1b" as &const byte, 1);      // esc
    if tui_overlay_open() {
        tuis_fail(tag, "esc 没有关掉浮窗", &ok);
    }
    _ = tui_overlay_cancelled();

    // ---- 5) 终端太小：不许开浮窗（画不出来却吞键是老坑）----
    tuis_reset(40, 10);
    if tui_overlay_diff_fits() {
        tuis_fail(tag, "40×10 不该判定为「画得下」", &ok);
    }
    tuis_fixture_open();
    tui_build();
    tuis_scan_rows(40, &ok, tag);
    if tuis_screen_has("/diff · uya-agent" as &const byte) {
        tuis_fail(tag, "放不下的时候仍然把浮窗画出来了", &ok);
    }
    tui_overlay_close();
    _ = tui_overlay_cancelled();

    // ---- 6) 脏字节：TAB / ESC 序列 / 汉字都不许破版 ----
    tuis_reset(100, 28);
    var files2: Buf = buf_new(256);
    defer { buf_free(&files2); }
    var diff2: Buf = buf_new(1024);
    defer { buf_free(&diff2); }
    // 路径里塞 ESC 与 NUL：git 用 -z 时不做引号转义，这些字节会原样到我们手里，
    // 列表行/标题必须把它们清洗掉（清洗后是 ␛ 与 ·），一个都不许进帧
    _ = buf_append_cstr(&files2, " M  dir\x1b[31mdirty\x00name.uya  (+1 -1)\n" as &const byte);
    _ = buf_append_cstr(&diff2, "@@ -1,2 +1,2 @@\n" as &const byte);
    _ = buf_append_cstr(&diff2, "-\tprintln(\"\x1b[31m旧\x1b[0m\");\n" as &const byte);
    _ = buf_append_cstr(&diff2, "+\tprintln(\"新\");\n" as &const byte);
    _ = buf_append_cstr(&diff2, " 结尾无换行标记下面那行很长很长很长很长很长很长很长很长很长很长很长很长\n" as &const byte);
    gd_load_fixture("dirty" as &const byte, &files2, &diff2);
    tui_overlay_diff_open();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("␛" as &const byte) {
        tuis_fail(tag, "文件内容里的 ESC 没有被清洗成 ␛", &ok);
    }
    if !tuis_screen_has("新" as &const byte) || !tuis_screen_has("旧" as &const byte) {
        tuis_fail(tag, "汉字内容没有被画出来", &ok);
    }
    var screen3: Buf = buf_new(65536);
    defer { buf_free(&screen3); }
    _ = tui_screen_text(&screen3);
    if !bufx_utf8_valid(screen3.ptr as &const byte, screen3.len) {
        tuis_fail(tag, "屏幕上出现了非法 UTF-8（按字节截断切出了半个汉字）", &ok);
    }
    // 帧里不许有 NUL / ESC（P27 第一版把 fixture 标签的 NUL 画进了标题）
    var k3: usize = 0;
    var bad3: bool = false;
    while k3 < screen3.len {
        const c3: byte = screen3.ptr[k3];
        if c3 == 0 as byte || c3 == 27 as byte {
            bad3 = true;
        }
        k3 = k3 + 1;
    }
    if bad3 {
        tuis_fail(tag, "帧里出现了 NUL 或 ESC（外来字节没有清洗干净）", &ok);
        tuis_dump_screen(tag);
    }
    if !tuis_screen_has("dirty" as &const byte) {
        tuis_fail(tag, "清洗之后路径的可读部分应当还在", &ok);
    }
    tui_overlay_close();
    _ = tui_overlay_cancelled();
    gd_reset();

    // ---- 6b) agent 层：三条「开不了」都要留下可见的话（通知长度写错就会露馅）----
    if gitx_available() {
        var c: Config = cfg_default();
        c.sandbox = SAN_OFF;
        c.workspace = buf_new(64);
        // ① 不是 git 仓库
        _ = buf_append_cstr(&c.workspace, "/tmp" as &const byte);
        tuis_reset(100, 28);
        agent_diff_open(&c);
        tui_build();
        tuis_scan_rows(100, &ok, tag);
        if !tuis_screen_has("not a git repository" as &const byte) {
            tuis_fail(tag, "非仓库目录没有把 git 的话补进转录", &ok);
            tuis_dump_screen(tag);
        }
        if tui_overlay_open() {
            tuis_fail(tag, "非仓库目录竟然开了浮窗", &ok);
        }
        // ② 仓库干干净净（空仓库）
        if dg_fixture_empty() {
            buf_reset(&c.workspace);
            _ = buf_append_cstr(&c.workspace, "build/selftest_diff_empty" as &const byte);
            tuis_reset(100, 28);
            agent_diff_open(&c);
            tui_build();
            tuis_scan_rows(100, &ok, tag);
            if !tuis_screen_has("(没有 git 修改)" as &const byte) {
                tuis_fail(tag, "没有改动时应当补「(没有 git 修改)」（通知长度写错也会在这里露馅）", &ok);
                tuis_dump_screen(tag);
            }
            if tui_overlay_open() {
                tuis_fail(tag, "没有改动时不该开浮窗", &ok);
            }
        }
        // ③ 终端太小
        if dg_fixture_make() {
            buf_reset(&c.workspace);
            _ = buf_append_cstr(&c.workspace, "build/selftest_diff_ws" as &const byte);
            tuis_reset(40, 10);
            agent_diff_open(&c);
            tui_build();
            tuis_scan_rows(40, &ok, tag);
            // 40 列装不下整句，通知会折行 —— 断言前半句与后半句都在（长度写错这里也会露馅）
            if !tuis_screen_has("终端太小：/diff 需要" as &const byte) || !tuis_screen_has("看单列文本" as &const byte) {
                tuis_fail(tag, "终端太小时没有给提示（或提示长度写错）", &ok);
                tuis_dump_screen(tag);
            }
            if tui_overlay_open() {
                tuis_fail(tag, "放不下的时候不该开浮窗", &ok);
            }
        }
    }

    // ---- 6c) 收尾：把画布与「任务面板的行预算」还原成普通一帧的样子 ----
    // tui_build_chat 每帧都会 tasks_set_row_budget(room)（room 随终端高度走），而 6b 的
    // 第三段故意用了 40×10 的小终端 —— 不还原的话，那个 1~2 行的预算会漏给后面
    // tasks-scroll 那一轮（滚动模式），它就会因为放不下 agents 箱体而掉进降级分支。
    // 这类「测试之间靠全局状态串味」的坑，修法就是把状态摆回普通一轮结束时的样子。
    tuis_reset(100, 28);
    // 转录里要有东西才会走 tui_build_chat —— 而调 tasks_set_row_budget 的正是那一条路
    // （tui_build_home 不碰它）。所以这里先落一条 notice 再 build。
    const tail: &const byte = "(/diff 自测收尾：把画布与任务面板行预算还原)" as &const byte;
    tui_add_notice(tail, bufx_cstr_len(tail));
    tui_build();
    tui_overlay_close();
    _ = tui_overlay_cancelled();

    // ---- 7) 真 PTY：/diff 走完整条真实路径（键盘 → 主循环 → git → 浮窗）----
    gd_reset();
    tui_diff_pty_case(tag, &ok);

    if ok {
        tuis_ok(tag, "边框/列头/选中标记/两栏并排/竖线同列/翻页/横向滚/清洗/太小不开/运行中保住状态区/esc + 真 PTY 里 /diff 跑真 git");
    }
    return ok;
}

// ============================================================
// tui-ask（P43）：ask_user_question 的提问弹窗
//
// 为什么单独一轮：P30 起这条工具在 TUI 里是「把提问落进转录、答案用输入行回车」——
// 问题是长句、选项要编号读、多选没法表达，用户还得在输入行里手打编号。P43 换成弹窗。
// 四条腿（少一条就不算验收）：
//   A) headless 排版与按键：标题/问题/编号选项/自定义行/提示都在、方框闭合、每行 ≤ cols、
//      正文层无 ESC/NUL；↓ 移光标、数字直选、打字进自定义、backspace 退、enter 交答案、
//      多选 space 勾选、0 选项只画自定义、窄终端不越界
//   B) 浮窗画不出来（终端太矮）→ tui_ask_wait 返回 0，由调用方**回落输入行**（不丢渠道）
//   C) headless + agent 端到端：模型真的调 ask_user_question（不是我们自己造浮层），
//      没人回答时结果是 dismissed 文案 + 空 selected（绝不假装有人答），浮层收干净
//   D) 真 PTY：真终端里弹窗把**问题原文**画上屏（证明不是输入行那条路），
//      按 2 + 回车 → 模型收到的是第二个选项的 label
// ============================================================

const TUIS_ASK_Q: &const byte = "要用哪个名字？（TUIS-ASK-QUESTION）" as &const byte;
const TUIS_ASK_HEADER: &const byte = "选名字" as &const byte;
const TUIS_ASK_OPT1: &const byte = "alpha" as &const byte;
const TUIS_ASK_OPT2: &const byte = "beta" as &const byte;
const TUIS_ASK_ITEMS: &const byte = "alpha — 先到先得\nbeta — 更稳\n" as &const byte;
const TUIS_ASK_ITEMS_MULTI: &const byte = "读文件\n跑测试\n" as &const byte;
const TUIS_ASK_DISMISS: &const byte = "the user dismissed the question without answering" as &const byte;
const TUIS_ASK_NOCHAN: &const byte = "no answer channel" as &const byte;
// 输入行回落那条提示（P30 的口径，P43 起只在「浮窗画不出来」时出现）
const TUIS_ASK_INPUT_HINT: &const byte = "（在输入行回答后回车；esc 表示不回答）" as &const byte;
const TUIS_ASK_TASK: &const byte = "pick a name (TUIS-ASK-TASK)" as &const byte;
const TUIS_ASK_DONE: &const byte = "TUIS-ASK-DONE" as &const byte;

// 一题的 options JSON（给 mock 用；末尾补 NUL 走 jw_str_cstr 口径，见踩坑 37）
fn tuis_ask_opts(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "label");
    jw_str_cstr(&w, TUIS_ASK_OPT1);
    jw_byte(&w, 44);
    jw_key(&w, "description");
    jw_str_cstr(&w, "先到先得" as &const byte);
    jw_byte(&w, 125);
    jw_byte(&w, 44);
    jw_byte(&w, 123);
    jw_key(&w, "label");
    jw_str_cstr(&w, TUIS_ASK_OPT2);
    jw_byte(&w, 44);
    jw_key(&w, "description");
    jw_str_cstr(&w, "更稳" as &const byte);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    if jw_overflow(&w) {
        return false;
    }
    const used: usize = jw_used(&w);
    out.len = used;
    if !buf_append_byte(out, 0) {
        return false;
    }
    out.len = used;
    return true;
}

// ask_user_question 的 arguments（用 JsonWriter 生成，免手写两级转义）
fn tuis_ask_args(out: &Buf) bool {
    var opts: Buf = buf_new(2048);
    defer { buf_free(&opts); }
    if !tuis_ask_opts(&opts) {
        return false;
    }
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "questions");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "q1" as &const byte);
    jw_byte(&w, 44);
    jw_key(&w, "question");
    jw_str_cstr(&w, TUIS_ASK_Q);
    jw_byte(&w, 44);
    jw_key(&w, "header");
    jw_str_cstr(&w, TUIS_ASK_HEADER);
    jw_byte(&w, 44);
    jw_key(&w, "options");
    jw_raw(&w, opts.ptr as &const byte, opts.len);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    const used: usize = jw_used(&w);
    out.len = used;
    if !buf_append_byte(out, 0) {
        return false;
    }
    out.len = used;
    return true;
}

// 一封「问一个问题」的响应体（chat 形状；与 tuis_pl_toolcall_body 同构）
fn tuis_ask_toolcall_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-tui-ask");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    var args: Buf = buf_new(4096);
    defer { buf_free(&args); }
    if !tuis_ask_args(&args) {
        return false;
    }
    mock_call(&w, "call_ask", "ask_user_question", args.ptr as &const byte);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    const used: usize = jw_used(&w);
    out.len = used;
    return true;
}

// ---- A) headless：排版与按键 ----
fn tuis_ask_overlay_case(tag: &const byte, ok: &bool) void {
    tuis_reset(100, 30);
    tui_overlay_ask_open(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        TUIS_ASK_Q, bufx_cstr_len(TUIS_ASK_Q),
        TUIS_ASK_ITEMS, bufx_cstr_len(TUIS_ASK_ITEMS), false, 0);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_ASK {
        tuis_fail(tag, "提问弹窗没有打开（或 kind 不是 TUI_OVK_ASK）", ok);
        return;
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_ASK_HEADER) {
        tuis_fail(tag, "弹窗标题不是 header（「选名字」）", ok);
    }
    if !tuis_screen_has(TUIS_ASK_Q) {
        tuis_fail(tag, "弹窗里没有问题的原文", ok);
    }
    if !tuis_screen_has("1) alpha") || !tuis_screen_has("2) beta") {
        tuis_fail(tag, "弹窗里没有编号选项（1) alpha / 2) beta）", ok);
    }
    if !tuis_screen_has("▸ 1) alpha") {
        tuis_fail(tag, "默认光标不在第 1 项上（没有 ▸ 标记）", ok);
    }
    if !tuis_screen_has("✎ ") {
        tuis_fail(tag, "弹窗里没有自定义回答行", ok);
    }
    if !tuis_screen_has("enter 提交") || !tuis_screen_has("esc 取消") {
        tuis_fail(tag, "弹窗里没有按键提示（enter 提交 / esc 取消）", ok);
    }
    // 方框逐行闭合（复用 tui-frame 那套量法）
    tuis_overlay_frame_check(100, ok, tag);

    // ↓ 移光标
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("▸ 2) beta") {
        tuis_fail(tag, "↓ 之后光标没有移到第 2 项", ok);
    }
    // 数字直选回第 1 项
    tui_keys_inject("1" as &const byte, 1);
    tui_build();
    if !tuis_screen_has("▸ 1) alpha") {
        tuis_fail(tag, "按 1 没有把光标移回第 1 项", ok);
    }
    // 直接打字 = 自定义回答（并覆盖选项）
    tui_keys_inject("ab" as &const byte, 2);
    tui_keys_inject("\x7f" as &const byte, 1);      // backspace 删掉 b
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("✎ a") {
        tuis_fail(tag, "打字之后自定义回答行没有显示正在输入的文本", ok);
    }
    tui_keys_inject("c" as &const byte, 1);
    tui_keys_inject("\r" as &const byte, 1);
    if tui_overlay_open() {
        tuis_fail(tag, "回车之后弹窗还开着", ok);
    }
    if !tui_ask_answered() {
        tuis_fail(tag, "回车之后没有「已提交」的答案", ok);
    }
    var cb: Buf = buf_new(256);
    defer { buf_free(&cb); }
    const cn: usize = tui_ask_custom_text(&cb);
    if cn != 2 || !bufx_eq_cstr(cb.ptr as &const byte, cb.len, "ac" as &const byte) {
        tuis_fail(tag, "自定义回答不对（应当是 backspace 之后的 ac）", ok);
    }
    if tui_ask_pick_count() != 0 {
        tuis_fail(tag, "单选自定义了回答，却还交回了选中的选项（custom 应当排他）", ok);
    }
    if tui_overlay_kind() != TUI_OVK_ASK {
        tuis_fail(tag, "提交之后 kind 不是 TUI_OVK_ASK（结果会被静默丢掉）", ok);
    }

    // 纯选项作答（单选）：光标那一项就是答案，且没有 custom
    tui_overlay_ask_open(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        TUIS_ASK_Q, bufx_cstr_len(TUIS_ASK_Q),
        TUIS_ASK_ITEMS, bufx_cstr_len(TUIS_ASK_ITEMS), false, 0);
    tui_keys_inject("2" as &const byte, 1);
    tui_keys_inject("\r" as &const byte, 1);
    if tui_ask_pick_count() != 1 {
        tuis_fail(tag, "纯选项作答没有交回选中的下标", ok);
    } else {
        var idx: usize = 99;
        if !tui_ask_pick_at(0, &idx) || idx != 1 {
            tuis_fail(tag, "交回的下标不是第 2 项（应当按下标回查 label）", ok);
        }
    }
    if tui_ask_custom_text(&cb) != 0 {
        tuis_fail(tag, "纯选项作答却带上了自定义回答", ok);
    }

    // 多选：space 勾选 —— 显示 [x]、提交交回两个下标
    tui_overlay_ask_open("多选" as &const byte, bufx_cstr_len("多选" as &const byte),
        "要做哪些？" as &const byte, bufx_cstr_len("要做哪些？" as &const byte),
        TUIS_ASK_ITEMS_MULTI, bufx_cstr_len(TUIS_ASK_ITEMS_MULTI), true, 0);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("[ ] 1) 读文件") {
        tuis_fail(tag, "多选弹窗里没有 [ ] 勾选位", ok);
    }
    if !tuis_screen_has("多选") {
        tuis_fail(tag, "多选弹窗标题栏没有标出「多选」", ok);
    }
    tui_keys_inject(" " as &const byte, 1);
    tui_build();
    if !tuis_screen_has("[x] 1) 读文件") {
        tuis_fail(tag, "space 没有勾上第 1 项（[x] 没出现）", ok);
    }
    tui_keys_inject("2" as &const byte, 1);
    tui_build();
    if !tuis_screen_has("[x] 2) 跑测试") {
        tuis_fail(tag, "多选下按 2 没有勾上第 2 项", ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if tui_ask_pick_count() != 2 {
        tuis_fail(tag, "多选提交没有交回两个下标", ok);
    } else {
        var a: usize = 99;
        var b: usize = 99;
        if !tui_ask_pick_at(0, &a) || !tui_ask_pick_at(1, &b) || a != 0 || b != 1 {
            tuis_fail(tag, "多选交回的下标不对（应当按选项顺序 {0,1}）", ok);
        }
    }

    // 0 选项：只画问题与自定义行，不崩
    tui_overlay_ask_open("空" as &const byte, bufx_cstr_len("空" as &const byte),
        "没有选项的问题" as &const byte, bufx_cstr_len("没有选项的问题" as &const byte),
        "" as &const byte, 0, false, 0);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("没有选项的问题") || !tuis_screen_has("✎ ") {
        tuis_fail(tag, "0 选项时弹窗没有画出问题/自定义行", ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if tui_ask_pick_count() != 0 {
        tuis_fail(tag, "0 选项时空答却交回了下标", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "0 选项的空答之后弹窗还开着", ok);
    }

    // esc 取消：不是「渠道不通」，浮层收掉、答复走 dismissed
    tui_overlay_ask_open(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        TUIS_ASK_Q, bufx_cstr_len(TUIS_ASK_Q),
        TUIS_ASK_ITEMS, bufx_cstr_len(TUIS_ASK_ITEMS), false, 0);
    tui_keys_inject("\x1b" as &const byte, 1);
    if !tui_overlay_cancelled() {
        tuis_fail(tag, "esc 没有走「取消」", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "esc 之后弹窗还开着", ok);
    }

    // 窄终端：每行仍 ≤ cols、边框还在（复用 P26 那套 40 列检查）
    tuis_reset(40, 16);
    tui_overlay_ask_open(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        TUIS_ASK_Q, bufx_cstr_len(TUIS_ASK_Q),
        TUIS_ASK_ITEMS, bufx_cstr_len(TUIS_ASK_ITEMS), false, 0);
    tui_build();
    tuis_scan_rows(40, ok, tag);
    if !tuis_screen_has("╭" as &const byte) || !tuis_screen_has("╰" as &const byte) {
        tuis_fail(tag, "窄终端下弹窗没有圆角边框", ok);
    }
    tuis_overlay_frame_check(40, ok, tag);
    tui_overlay_close();
    tuis_reset(100, 30);
}

// ---- A2) P45：框宽**自适应内容**（短内容紧凑、长内容仍 ≤ 78，退让改文案不改框宽）----
// 真画出来那一帧的框宽（列）= 顶边行的「右边界列 − 左边界列」
fn tuis_ask_frame_w(out: &usize) bool {
    var txt: Buf = buf_new(65536);
    defer { buf_free(&txt); }
    _ = tui_screen_text(&txt);
    const p: &const byte = txt.ptr as &const byte;
    const n: usize = txt.len;
    const top: usize = tuis_find_lit_row(p, n, 0, tui_nrows(), "╭" as &const byte);
    if top >= tui_nrows() {
        return false;
    }
    out[0] = tuis_row_edge_end(p, n, top) - tuis_row_edge_start(p, n, top);
    return true;
}

fn tuis_ask_adaptive_case(tag: &const byte, ok: &bool) void {
    const short_q: &const byte = "选哪个？" as &const byte;
    const short_items: &const byte = "alpha\nbeta\n" as &const byte;
    var got: usize = 0;

    // 1) 短内容（问题 4 字、选项 5 列）：框缩到下限 34 —— 以前无论多短都撑满 78
    tuis_reset(100, 30);
    tui_overlay_ask_open(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        short_q, bufx_cstr_len(short_q),
        short_items, bufx_cstr_len(short_items), false, 0);
    if tui_ask_adaptive_width() != 34 {
        tuis_fail(tag, "短内容的自适应框宽不是下限 34", ok);
    }
    tui_build();
    if !tuis_ask_frame_w(&got) || got != 34 {
        tuis_fail(tag, "短内容真画出来的框宽不是 34（自适应没生效）", ok);
    }
    // 框窄 ⇒ 提示行退到最简档，且**不能**把 esc 取消截掉
    if !tuis_screen_has("enter 提交 · esc 取消" as &const byte) {
        tuis_fail(tag, "窄框的提示行没有退到最简档（或 esc 取消 被截掉了）", ok);
    }
    if tuis_screen_has("1-9 直选" as &const byte) {
        tuis_fail(tag, "窄框里还画着放不下的满档提示", ok);
    }
    if !tuis_screen_has("打字 = 自己回答" as &const byte) {
        tuis_fail(tag, "窄框的自定义占位没有退到中档", ok);
    }
    if tuis_screen_has("覆盖选项" as &const byte) {
        tuis_fail(tag, "窄框里还画着放不下的满档占位", ok);
    }
    tuis_overlay_frame_check(100, ok, tag);
    // 光标移动不该让框宽抖一列（计数按最大情形量）
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_build();
    var got2: usize = 0;
    if !tuis_ask_frame_w(&got2) || got2 != got {
        tuis_fail(tag, "光标从 1/2 移到 2/2 之后框宽变了（计数没按最大情形量）", ok);
    }
    tui_overlay_close();

    // 2) 长问题（60 个汉字 = 120 列）：框长到上限 78，仍 ≤ 78 且不越界
    var longq: Buf = buf_new(512);
    defer { buf_free(&longq); }
    var li: usize = 0;
    while li < 60 {
        _ = buf_append_cstr(&longq, "长" as &const byte);
        li = li + 1;
    }
    tuis_reset(100, 30);
    tui_overlay_ask_open(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        longq.ptr as &const byte, longq.len,
        short_items, bufx_cstr_len(short_items), false, 0);
    if tui_ask_adaptive_width() != 78 {
        tuis_fail(tag, "长问题的框宽没有长到上限 78", ok);
    }
    tui_build();
    if !tuis_ask_frame_w(&got) || got != 78 {
        tuis_fail(tag, "长问题真画出来的框宽不是 78", ok);
    }
    // 78 列下单选满档提示 63 列放得下 ⇒ 该档恢复（退让是双向的）
    if !tuis_screen_has("1-9 直选" as &const byte) {
        tuis_fail(tag, "78 列宽框里没有恢复满档提示", ok);
    }
    tuis_overlay_frame_check(100, ok, tag);
    tui_overlay_close();

    // 3) 框宽随终端退化：40 列终端，内容再短也不越界、边框仍闭合成矩形
    tuis_reset(40, 20);
    tui_overlay_ask_open(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        short_q, bufx_cstr_len(short_q),
        short_items, bufx_cstr_len(short_items), false, 0);
    const w40: usize = tui_ask_adaptive_width();
    if w40 > 34 {
        tuis_fail(tag, "40 列终端下框宽没有跟着退（> 34）", ok);
    }
    tui_build();
    if !tuis_ask_frame_w(&got) || got != w40 {
        tuis_fail(tag, "40 列终端下真画出来的框宽与自适应值不一致", ok);
    }
    tuis_scan_rows(40, ok, tag);
    tuis_overlay_frame_check(40, ok, tag);
    tui_overlay_close();

    // 4) 极窄：30 列仍闭合、不越界（框宽退到 cols-2 之内）
    tuis_reset(30, 20);
    tui_overlay_ask_open(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        short_q, bufx_cstr_len(short_q),
        short_items, bufx_cstr_len(short_items), false, 0);
    tui_build();
    tuis_scan_rows(30, ok, tag);
    tuis_overlay_frame_check(30, ok, tag);
    tui_overlay_close();

    // 5) 多选：勾选位占 4 列，紧随内容；短内容仍是下限框，且 [ ] 与提示都在
    tuis_reset(100, 30);
    tui_overlay_ask_open("多选" as &const byte, bufx_cstr_len("多选" as &const byte),
        short_q, bufx_cstr_len(short_q),
        short_items, bufx_cstr_len(short_items), true, 0);
    tui_build();
    if !tuis_screen_has("[ ] 1) alpha" as &const byte) {
        tuis_fail(tag, "多选短内容下没有画出勾选位", ok);
    }
    // 多选最高档 mid（57 列）在 34 列框里放不下 ⇒ 退到 min，space 勾选 与 esc 取消 都在
    if !tuis_screen_has("space 勾选 · enter/esc" as &const byte) {
        tuis_fail(tag, "多选窄框的提示没有退到最简档", ok);
    }
    tuis_overlay_frame_check(100, ok, tag);
    tui_overlay_close();
    tuis_reset(100, 30);
}

// ---- B) 浮窗画不出来 → 返回 0（调用方回落输入行），而不是 fail closed ----
fn tuis_ask_nofit_case(tag: &const byte, ok: &bool) void {
    // 终端太矮：panel_top < TUI_OV_READER_MIN_PANEL_TOP
    tuis_reset(100, 5);
    tui_build();
    const rc: i32 = tui_ask_wait(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        TUIS_ASK_Q, bufx_cstr_len(TUIS_ASK_Q),
        TUIS_ASK_ITEMS, bufx_cstr_len(TUIS_ASK_ITEMS), false, 0);
    if rc != 0 {
        tuis_fail(tag, "终端太矮时 tui_ask_wait 没有返回 0（回落输入行的那条路）", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "画不出来的浮层却还开着（看不见却仍吞键）", ok);
        tui_overlay_close();
    }
    // TUI 没在跑：同样返回 0（滚动模式 / 管道走原先那两条通道）
    tui_headless_enable(false);
    const rc2: i32 = tui_ask_wait(TUIS_ASK_HEADER, bufx_cstr_len(TUIS_ASK_HEADER),
        TUIS_ASK_Q, bufx_cstr_len(TUIS_ASK_Q),
        TUIS_ASK_ITEMS, bufx_cstr_len(TUIS_ASK_ITEMS), false, 0);
    if rc2 != 0 {
        tuis_fail(tag, "TUI 没在跑时 tui_ask_wait 没有返回 0", ok);
    }
    tui_headless_enable(true);
    tuis_reset(100, 30);
}

// ---- C) headless + agent：模型真调 ask_user_question ----
fn tuis_ask_headless_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_ask" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return;
    }
    var mpid: i32 = -1;
    const port: u16 = tuis_ask_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var c: Config = cfg_default();
    tuis_pl_cfg(&c, port, ws, TUIS_ASK_TASK);
    c.tui = true;
    c.tui_headless = true;
    c.tui_cols = 100;
    c.tui_rows = 30;

    tui_reset_all();
    tui_set_headless(true);
    tui_set_size(100, 30);
    tui_set_color(false, false);
    tui_begin_session();
    tui_sink_flush_partial();
    tui_keys_inject(TUIS_ASK_TASK, bufx_cstr_len(TUIS_ASK_TASK));
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_has_submit() {
        tuis_fail(tag, "注入回车之后没有待取走的提交", ok);
    }

    const rc: i32 = agent_run_tui(&c);
    const mock_rc: i32 = wait_child(mpid);
    if rc != AGENT_OK {
        tuis_fail(tag, "提问轮却以非 0 退出", ok);
    }
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错（工具结果不对？）", ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
    }
    // headless 下注入的键用完 = 没人回答：弹窗必须收掉（否则一直盖着转录）
    if tui_overlay_open() {
        tuis_fail(tag, "headless 下没人回答之后，提问弹窗还留在屏幕上", ok);
        tui_overlay_close();
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_ASK_DONE) {
        tuis_fail(tag, "转录里没有 mock 的最终答案", ok);
    }
    if tui_run_kind() != TUI_RUN_IDLE {
        tuis_fail(tag, "回合结束后状态没有回到 idle", ok);
    }
    cfg_free(&c);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
}

// ask 轮的 mock：第 1 封回一个 ask_user_question 工具调用，第 2 封断言工具结果。
// headless 分支（want 为空）：断言「没人回答」= dismissed + 空 selected；
// PTY 分支（want 非空）：断言工具结果里就是那个 label。
//
// ⚠ 判据要按**转义后**的字节写：工具结果作为 `messages[].content` 字符串嵌在请求体里，
// 引号在请求体里是 `\"` —— 直接搜 `"selected":["beta"]` 永远搜不到（第一版就是这么假红的）。
// ⚠ want 必须 NUL 结尾：contains 走的是 C 字符串口径（buf_new 的缓冲没有 NUL，见踩坑 57）。
var tuis_ask_want: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var tuis_ask_want_set: bool = false;

fn tuis_ask_set_want(p: &const byte, n: usize) void {
    if !buf_valid(&tuis_ask_want) {
        tuis_ask_want = buf_new(256);
    }
    buf_reset(&tuis_ask_want);
    _ = buf_append(&tuis_ask_want, p, n);
    _ = buf_append_byte(&tuis_ask_want, 0);   // C 字符串口径（contains 用 strlen）
    buf_truncate(&tuis_ask_want, n);
    tuis_ask_want_set = n > 0;
}

fn tuis_ask_mock(lfd: i32) i32 {
    var round: i32 = 0;
    var verdict: i32 = 0;
    while round < 2 {
        var lpfds: [PollFd: 1] = [PollFd{ fd: lfd, events: POLLIN, revents: 0 }];
        const lpr: i32 = sys_poll(&lpfds[0], 1, 10000) catch { 0; };
        if lpr <= 0 || (lpfds[0].revents & POLLIN) == 0 {
            if round < 2 {
                return 90 + round;   // 请求数不够：算失败
            }
            return verdict;
        }
        var peer: [byte: 16] = [0: 16];
        var alen: u32 = 16;
        const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch { return 10; };
        var rx: Buf = buf_new(16384);
        if !mock_read_request(cfd, &rx) {
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            return 11;
        }
        const is_stream: bool = contains(&rx, "\"stream\":true");
        var body: Buf = buf_new(8192);
        if round == 0 {
            if !contains(&rx, "\"name\":\"ask_user_question\"") {
                verdict = 91;   // 这个工具必须在 schema 里（跨模式恒可见）
            }
            if !contains(&rx, TUIS_ASK_TASK) {
                verdict = 92;   // 任务文本必须真的进了历史
            }
            if !tuis_ask_toolcall_body(&body) {
                verdict = 93;
            }
        } else {
            // id 必须原样回灌（工具结果 JSON 里的 `"id":"q1"` 在请求体里被转义成 \"id\":\"q1\")
            if !contains(&rx, "\\\"id\\\":\\\"q1\\\"" as &const byte) {
                verdict = 94;
            }
            if tuis_ask_want_set {
                // 工具结果里的选中项：{\"id\":\"q1\",\"selected\":[\"<label>\"]}
                if !contains(&rx, tuis_ask_want.ptr as &const byte) {
                    verdict = 95;   // 选中的 label 必须回到模型面前
                }
                if !contains(&rx, "\\\"selected\\\":[\\\"" as &const byte) {
                    verdict = 96;   // 选中项是用 selected 数组表达的
                }
                if contains(&rx, TUIS_ASK_DISMISS) {
                    verdict = 97;   // 有答案就不该同时是 dismissed
                }
            } else {
                if !contains(&rx, TUIS_ASK_DISMISS) {
                    verdict = 98;   // 没人回答：必须是 dismissed，不能假装有人答
                }
                if !contains(&rx, "\\\"selected\\\":[]" as &const byte) {
                    verdict = 99;   // 没人回答却交了一个选中项
                }
            }
            if contains(&rx, TUIS_ASK_NOCHAN) {
                verdict = 102;   // 弹窗明明起着，却报了「渠道不通」（渠道判定不对）
            }
            if !mock_final_body(&body, "TUIS-ASK-DONE" as &const byte) {
                verdict = 103;
            }
        }
        var sent: bool = false;
        if is_stream {
            sent = mock_send_sse(cfd, &body);
        } else {
            sent = mock_send(cfd, &body);
        }
        if !sent {
            verdict = 104;
        }
        buf_free(&body);
        buf_free(&rx);
        _ = sys_close(cfd) catch {};
        round = round + 1;
    }
    return verdict;
}

fn tuis_ask_start_mock(mpid: &i32) u16 {
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch { return 0; };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    if (sys_bind(lfd, &addr[0] as &void, 16 as u32) catch { -1; }) != 0 {
        _ = sys_close(lfd) catch {};
        return 0;
    }
    _ = sys_listen(lfd, 4) catch {};
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {};
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return 0;
    };
    if pid64 == 0 {
        const rc0: i32 = tuis_ask_mock(lfd);
        sys_exit(rc0);
    }
    mpid[0] = tuis_i32(pid64);
    _ = sys_close(lfd) catch {};
    return port;
}

// ---- D) 真 PTY：弹窗在真终端里出现，且答案回到模型 ----
fn tuis_ask_child(slave_path: &const Buf, port: u16, ws: &const byte) void {
    const s: i32 = sys_open(slave_path.ptr as *const byte, TUIS_O_RDWR_NOCTTY, 0) catch { -1; };
    if s < 0 {
        sys_exit(9);
    }
    _ = sys_dup2(s, 0) catch {};
    _ = sys_dup2(s, 1) catch {};
    _ = sys_dup2(s, 2) catch {};
    if s > 2 {
        _ = sys_close(s) catch {};
    }
    var c: Config = cfg_default();
    tuis_pl_cfg(&c, port, ws, "" as &const byte);   // 任务由父进程从 PTY 打进来
    c.tui = true;
    c.tui_headless = false;
    const rc: i32 = agent_run_tui(&c);
    sys_exit(rc);
}

fn tuis_ask_pty_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_ask_pty" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return;
    }
    // 期望回到模型面前的是第 2 个选项的 label
    tuis_ask_set_want(TUIS_ASK_OPT2, bufx_cstr_len(TUIS_ASK_OPT2));
    var mpid: i32 = -1;
    const port: u16 = tuis_ask_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        tuis_ask_set_want("" as &const byte, 0);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        tuis_ask_set_want("" as &const byte, 0);
        return;
    }
    tui_reset_all();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        tuis_ask_set_want("" as &const byte, 0);
        return;
    };
    if cpid64 == 0 {
        tuis_ask_child(&slave_path, port, ws);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);

    var cap: Buf = buf_new(4194304);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 40);
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案", ok);
    }
    // 任务文本与 mock 侧的断言共用同一个常量（两处写两份字面量必然漂移 —— 第一版就是
    // 父进程打 "ask me something …"、mock 断言 "pick a name …"，round 0 直接假红）
    var task: Buf = buf_new(64);
    defer { buf_free(&task); }
    _ = buf_append(&task, TUIS_ASK_TASK, bufx_cstr_len(TUIS_ASK_TASK));
    _ = buf_append_byte(&task, 13);
    tuis_write_master(m, task.ptr as &const byte, task.len);
    // 等弹窗把**问题原文**画上屏 —— 这是「不是输入行那条路」的判据
    var seen: bool = false;
    var k: i32 = 0;
    while k < 160 && !seen {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, TUIS_ASK_HEADER) {
            seen = true;
        }
        k = k + 1;
    }
    if !seen {
        tuis_fail(tag, "ask_user_question 没有弹出提问弹窗", ok);
        tuis_dump_tail(&cap, 1500);
    } else {
        if !tuis_has(&cap, TUIS_ASK_Q) {
            tuis_fail(tag, "弹窗里没有问题原文", ok);
        }
        if !tuis_has(&cap, "1) alpha") || !tuis_has(&cap, "2) beta") {
            tuis_fail(tag, "弹窗里没有编号选项", ok);
        }
        if tuis_has(&cap, TUIS_ASK_INPUT_HINT) {
            tuis_fail(tag, "弹窗起来了，却还走了输入行那条提示（回落不该发生）", ok);
        }
        // 先清掉输入行里没提交的残留，再 2 + 回车 = 选第 2 项
        var bs: [byte: 1] = [127];
        tuis_write_master(m, &bs[0], 1);
        var k2: i32 = 0;
        while k2 < 6 {
            tuis_drain(m, &cap, 1);
            k2 = k2 + 1;
        }
        tuis_write_master(m, "2\r" as &const byte, 2);
        var got: bool = false;
        var k3: i32 = 0;
        while k3 < 240 && !got {
            tuis_drain(m, &cap, 1);
            if tuis_has(&cap, "TUIS-ASK-DONE" as &const byte) {
                got = true;
            }
            k3 = k3 + 1;
        }
        if !got {
            tuis_fail(tag, "回答之后没有收到 mock 的最终答案", ok);
            tuis_dump_tail(&cap, 1500);
        }
    }
    // 退出：先清输入再 Ctrl-D
    var bs2: [byte: 1] = [127];
    tuis_write_master(m, &bs2[0], 1);
    tuis_drain(m, &cap, 6);
    var ctrl_d: [byte: 1] = [4];
    tuis_write_master(m, &ctrl_d[0], 1);
    tuis_drain(m, &cap, 30);
    var st: i32 = 0;
    if !tuis_wait_raw(cpid, &st, 20000) {
        tuis_fail(tag, "Ctrl-D 之后 TUI 子进程没有退出", ok);
        _ = sys_kill(cpid as i64, SIGKILL) catch {};
        _ = tuis_wait_raw(cpid, &st, 2000);
    } else {
        const code: i32 = (st >> (8 as i32)) & 255;
        if code != 0 {
            tuis_fail(tag, "TUI 退出码不是 0", ok);
        }
    }
    _ = sys_close(m) catch {};
    const mock_rc: i32 = wait_child(mpid);
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错（回答没有回到模型面前？）", ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
    }
    tuis_ask_set_want("" as &const byte, 0);
}

fn tui_ask_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_ask_overlay_case(tag, &ok);
    tuis_ask_adaptive_case(tag, &ok);
    tuis_ask_nofit_case(tag, &ok);
    tuis_ask_headless_case(tag, &ok);
    tuis_ask_pty_case(tag, &ok);
    if ok {
        tuis_ok(tag, "提问弹窗：排版与按键（↓/数字/打字/多选 [x]/0 选项/窄终端/esc）+ 框宽自适应内容（34↔78、退让改文案）+ 太矮回落输入行 + headless 没人答=dismissed + 真 PTY 里 2+回车 的 label 回到模型");
    }
    return ok;
}

// ============================================================
// P46：/title 的会话标题输入框浮层（单行文本编辑）
//
// 五个部分：
//   A) headless 排版：预填内容可见、方框逐行闭合、每行 ≤ cols、无 ESC/NUL、提示行在；
//   B) headless 编辑与按键：打字 / backspace / delete / ←→ / home·end / ctrl+u /
//      enter 采纳（交回编辑后的文本）/ esc 取消（**不改标题**）；
//   C) 太矮回落：panel_top < 6 时 tui_title_input_wait 返回 0（调用方给 notice，绝不 fail closed
//      —— 与提问弹窗同一条立场：这是「换个地方说」，不是审批）；
//   D) 回合运行中：`/title 新名字` 当场生效（安全集）；裸 `/title` **不**当场派发；
//   E) 真 PTY：mock 回合结束后敲 /title，框里出现 AI 建议，回车之后 OSC 2 变成新标题、
//      日志里落一条 kind=user 的 session/title。
// ============================================================

// 窗口标题保持短：框宽是**按内容自适应**的（P45 那一套），标题太长会被裁掉。
// 按键说明走提示行那一份（它有 full/mid/min 三档退让，窄框也丢不了「esc 取消」）。
const TUIS_TI_TITLE: &const byte = "会话标题" as &const byte;
const TUIS_TI_SUGGEST: &const byte = "修好中文文件名" as &const byte;

fn tuis_ti_overlay_case(tag: &const byte, ok: &bool) void {
    tuis_reset(100, 30);
    tui_overlay_input_open(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE),
        TUIS_TI_SUGGEST, bufx_cstr_len(TUIS_TI_SUGGEST));
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_TITLE {
        tuis_fail(tag, "标题输入框没有打开（或 kind 不是 TUI_OVK_TITLE）", ok);
        return;
    }
    if !tui_tin_active() {
        tuis_fail(tag, "tui_tin_active() 不是真（浮层形态没置上）", ok);
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_TI_TITLE) {
        tuis_fail(tag, "标题输入框没有标题行", ok);
    }
    // 预填的建议必须可见（AI 填草稿、人来改 —— 这是本功能的主交互）
    if !tuis_screen_has(TUIS_TI_SUGGEST) {
        tuis_fail(tag, "输入框里没有预填的 AI 建议", ok);
    }
    if !tuis_screen_has("enter 采纳") || !tuis_screen_has("esc 取消") {
        tuis_fail(tag, "提示行里没有按键说明（enter 采纳 / esc 取消）", ok);
    }
    // 单行输入框不该有选项表那套东西
    if tuis_screen_has("✎ ") {
        tuis_fail(tag, "输入框里混进了提问弹窗的自定义行", ok);
    }
    tuis_overlay_frame_check(100, ok, tag);

    // ---- B) 编辑与按键 ----
    // 光标默认在尾部：打字就是往后接
    if tui_tin_cursor() != tui_tin_draft_len() {
        tuis_fail(tag, "光标默认不在编辑缓冲尾部", ok);
    }
    tui_keys_inject("!" as &const byte, 1);
    tui_build();
    if tui_tin_draft_len() != bufx_cstr_len(TUIS_TI_SUGGEST) + 1 {
        tuis_fail(tag, "打字没有接在尾部", ok);
    }
    // backspace 退回原样
    tui_keys_inject("\x7f" as &const byte, 1);
    if tui_tin_draft_len() != bufx_cstr_len(TUIS_TI_SUGGEST) {
        tuis_fail(tag, "backspace 没有删掉刚打的字符", ok);
    }
    // ← 再 delete：回到原样（一个字符进出一个字符）
    tui_keys_inject("\x1b[D" as &const byte, 3);
    // 按**码点**左移一格。这里必须给准确的字节数，不能用 len-1：
    // 预填是「修好中文文件名」= 7 个汉字 = 21 字节，最后一个「名」从 18 开始。
    // 写成 len-1（20）就落在汉字中间 —— 那正是「按字节退格会劈开 UTF-8」那个坑。
    if tui_tin_draft_len() != 21 {
        tuis_fail(tag, "预填的建议不是 21 字节（测试基准变了）", ok);
    }
    if tui_tin_cursor() != 18 {
        tuis_fail(tag, "← 没有把光标左移一个**码点**（期望 18，按字节退会得到 20）", ok);
    }
    tui_keys_inject("\x1b[C" as &const byte, 3);
    if tui_tin_cursor() != tui_tin_draft_len() {
        tuis_fail(tag, "→ 没有把光标移回尾部", ok);
    }
    // home / end
    tui_keys_inject("\x01" as &const byte, 1);   // ctrl+a
    if tui_tin_cursor() != 0 {
        tuis_fail(tag, "ctrl+a 没有把光标移到行首", ok);
    }
    tui_keys_inject("\x05" as &const byte, 1);   // ctrl+e
    if tui_tin_cursor() != tui_tin_draft_len() {
        tuis_fail(tag, "ctrl+e 没有把光标移到行尾", ok);
    }
    // ctrl+u 清空，然后重新打字（走 insert 的中间位置那条路）
    tui_keys_inject("\x15" as &const byte, 1);
    if tui_tin_draft_len() != 0 {
        tuis_fail(tag, "ctrl+u 没有清空编辑缓冲", ok);
    }
    tui_keys_inject("ab" as &const byte, 2);
    tui_keys_inject("\x1b[D" as &const byte, 3);   // 光标在 ab 之间
    tui_keys_inject("X" as &const byte, 1);
    if tui_tin_draft_len() != 3 || tui_tin_draft_at(0) != 97 as byte
        || tui_tin_draft_at(1) != 88 as byte || tui_tin_draft_at(2) != 98 as byte {
        tuis_fail(tag, "在中间插入没有把后面那段接回去（期望 aXb）", ok);
    }
    // 光标可见性：编辑行里必须有一个反显位（光标格），且每行仍 ≤ cols
    tui_build();
    tuis_scan_rows(100, ok, tag);
    tuis_overlay_frame_check(100, ok, tag);

    // enter 采纳：交回的是**编辑后**的文本
    tui_keys_inject("\r" as &const byte, 1);
    var picked: Buf = buf_new(256);
    defer { buf_free(&picked); }
    if !tui_tin_answered() {
        tuis_fail(tag, "enter 之后 tui_tin_answered() 不是真", ok);
    }
    if tui_tin_text(&picked) != 3 {
        tuis_fail(tag, "采纳回来的文本不是编辑后的那 3 个字节", ok);
    } else if !bufx_eq_cstr(picked.ptr as &const byte, picked.len, "aXb" as &const byte) {
        tuis_fail(tag, "采纳回来的文本不是 aXb", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "采纳之后浮层没关", ok);
    }
    if tui_tin_active() {
        tuis_fail(tag, "采纳之后对话框状态没清（tui_tin_active 还是真）", ok);
    }
    // 答案在 close 之后仍读得到（one-shot 口径，与 ask 同一分工）
    if tui_tin_text(&picked) != 3 {
        tuis_fail(tag, "close 之后读不到已采纳的答案（one-shot 结果被清了）", ok);
    }
}

fn tuis_ti_cancel_case(tag: &const byte, ok: &bool) void {
    tuis_reset(100, 30);
    tui_overlay_input_open(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE),
        TUIS_TI_SUGGEST, bufx_cstr_len(TUIS_TI_SUGGEST));
    tui_keys_inject("改一改" as &const byte, 9);
    tui_keys_inject("\x1b" as &const byte, 1);   // esc
    if tui_overlay_open() {
        tuis_fail(tag, "esc 之后浮层没关", ok);
    }
    if tui_tin_answered() {
        tuis_fail(tag, "esc 取消不该算「已采纳」（否则会把取消当成改名）", ok);
    }
    var got: Buf = buf_new(64);
    defer { buf_free(&got); }
    if tui_tin_text(&got) != 0 {
        tuis_fail(tag, "esc 取消之后不该读得到答案", ok);
    }
    // 空预填也要能开（起标题失败时调用方预填当前标题或空串）
    tui_overlay_input_open(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE), "" as &const byte, 0);
    if !tui_overlay_open() || tui_tin_draft_len() != 0 {
        tuis_fail(tag, "空预填开不出来（或缓冲不是空的）", ok);
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    tuis_overlay_frame_check(100, ok, tag);
    tui_overlay_close();
}

fn tuis_ti_nofit_case(tag: &const byte, ok: &bool) void {
    // 终端太矮：返回 0（调用方回落 notice），绝不能 fail closed
    tuis_reset(100, 5);
    tui_headless_enable(true);
    var got: Buf = buf_new(64);
    defer { buf_free(&got); }
    const rc: i32 = tui_title_input_wait(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE),
        TUIS_TI_SUGGEST, bufx_cstr_len(TUIS_TI_SUGGEST), &got);
    if rc != 0 {
        tuis_fail(tag, "终端太矮时 tui_title_input_wait 应当返回 0（回落 notice）", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "太矮回落之后不该留着浮层（看不见却吞键）", ok);
    }
    // 窄终端不崩、每行 ≤ cols
    tuis_reset(40, 20);
    tui_overlay_input_open(TUIS_TI_TITLE, bufx_cstr_len(TUIS_TI_TITLE),
        "一个很长的标题用来把窄框撑满看看会不会越界" as &const byte,
        bufx_cstr_len("一个很长的标题用来把窄框撑满看看会不会越界" as &const byte));
    tui_build();
    tuis_scan_rows(40, ok, tag);
    tuis_overlay_frame_check(40, ok, tag);
    tui_overlay_close();
    tuis_reset(100, 30);
}

fn tuis_ti_inturn_case(tag: &const byte, ok: &bool) void {
    // D) 回合运行中的分工：带参 `/title <t>` 只写内存 + 一条日志事件 + OSC 2（不动历史、
    //    不发请求）⇒ 进安全集，泵点当场生效；裸 `/title` 要发侧路请求 + 开浮层 ⇒
    //    **不进**安全集，只能等回合结束（与 /goal、/workspace 同一条分工）。
    //    这里直接问 agent_tui_cmd_safe_steer（steer 那一侧按**整行**判定，所以能分开两支）。
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "/title 把中文文件名修好");
    if !agent_tui_cmd_safe_steer(&line) {
        tuis_fail(tag, "运行中敲 `/title <新标题>` 应当进安全集（当场生效）", ok);
    }
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title clear");
    if !agent_tui_cmd_safe_steer(&line) {
        tuis_fail(tag, "运行中敲 `/title clear` 应当进安全集", ok);
    }
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title");
    if agent_tui_cmd_safe_steer(&line) {
        tuis_fail(tag, "运行中敲裸 /title 不该进安全集（它会发请求 + 开浮层，在泵点里重入流式请求是不允许的）", ok);
    }
    // `/title   `（只有空白）其实等于裸命令：也不该放行
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/title   ");
    if agent_tui_cmd_safe_steer(&line) {
        tuis_fail(tag, "`/title` 后面只有空白时不该进安全集（那是裸命令）", ok);
    }
    // 命令表里真的有这一条（用户敲 `/` 打开面板要能过滤到它）
    var cmds: Buf = buf_new(2048);
    defer { buf_free(&cmds); }
    agent_tui_commands(&cmds);
    if !tuis_has(&cmds, "/title" as &const byte) {
        tuis_fail(tag, "命令面板的清单里没有 /title", ok);
    }
    // 帮助浮层里也要有它（用户最常从那儿查命令）
    if !tuis_has(&cmds, "会话标题" as &const byte) {
        tuis_fail(tag, "命令面板里 /title 那一行没写清楚用途", ok);
    }
}

fn tuis_ti_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_ti_overlay_case(tag, &ok);
    tuis_ti_cancel_case(tag, &ok);
    tuis_ti_nofit_case(tag, &ok);
    tuis_ti_inturn_case(tag, &ok);
    if ok {
        tuis_ok(tag, "标题输入框：预填 AI 建议可见 + 编辑（打字/backspace/←→/home·end/ctrl+u/中间插入）+ enter 采纳（交回编辑后的文本）/ esc 取消（不算改名）+ 太矮回落 0 + 方框逐行闭合 + 窄框不越界 + 运行中 /title <t> 当场生效、裸 /title 不当场派发");
    }
    return ok;
}

// ============================================================
// 对外入口：selftest_main 里一行调用
// ============================================================

// ============================================================
// tui-plan（P26）：plan 模式写闸门 + exit_plan_mode 审阅浮窗
//
// 为什么单独一轮：P8 的审阅是 CLI 的 y/N 问答（ask_write + ask_read_yes_no），TUI 下
// 既没有浮窗、按键还要跟 TUI 的键队列抢 —— 用户看到的就是「计划直接开始执行」
// （README 踩坑 36）。这一轮把四件事钉死：
//   A) 浮层排版与按键（headless，直接开浮层）：正文可滚动、三动作、数字直选、
//      esc 取消、每行 ≤ cols、正文层无 ESC、窄终端不崩
//   B) headless + agent：注入的键到不了浮层 → 按「解决」处理（留在 plan 模式），**绝不批准**
//   C) 真 PTY：先滚动（尾巴标记出现）再选「确认执行」→ 模型拿到 Plan approved
//   D) 真 PTY：esc → 「解决」→ 模型被告知停下等用户说话，且 plan 模式仍在
// ============================================================

const TUIS_PL_TITLE: &const byte = "计划待审" as &const byte;
const TUIS_PL_KEEP: &const byte = "继续讨论" as &const byte;
const TUIS_PL_DISMISS: &const byte = "解决" as &const byte;
const TUIS_PL_APPROVE: &const byte = "确认执行" as &const byte;
const TUIS_PL_KEEP_RESULT: &const byte = "keep planning; revise the plan" as &const byte;
const TUIS_PL_DISMISS_RESULT: &const byte = "dismissed the plan review to speak instead" as &const byte;
const TUIS_PL_APPROVED: &const byte = "Plan approved" as &const byte;
const TUIS_PL_TAIL: &const byte = "PLAN-TAIL-MARK" as &const byte;
const TUIS_PL_TASK: &const byte = "plan the greeting change (TUIS-PLAN-TASK)" as &const byte;

// 审阅用的计划：短行（不折行）但够多行 —— 100x30 下正文可见 16 行，
// 尾巴必须靠滚动才看得见，这样 C 段的「滚动」断言才有意义。
const TUIS_PL_PLAN: &const byte = "# 计划标题\n\n## 第一步：读现状\n- 读 hello.uya\n- 看一眼 Makefile\n\n## 第二步：改一行\n- 只动那一行字面量\n- 用 edit 工具替换\n\n## 第三步：验证\n- 编译并运行\n- 跑一次 make check\n\n## 第四步：补文档\n- README 补一句\n\n## 第五步：收尾\n- 删掉临时文件\n\n## 风险与回滚\n- 只有一处字符串\n- 回滚就是把这一行改回去\n\n## 尾巴\nPLAN-TAIL-MARK\n" as &const byte;

// exit_plan_mode 的 arguments（用 JsonWriter 生成，免得手写两级转义）。
// 末尾要补 NUL：mock_call 走的是 jw_str_cstr（C 字符串口径），而 buf_new 是裸 malloc ——
// 不补的话 strlen 会一路读到未初始化的堆尾巴，arguments 变成非法 JSON（README 踩坑 37 同款）。
fn tuis_pl_args(out: &Buf, plan: &const byte) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "plan");
    jw_str_cstr(&w, plan);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    const used: usize = jw_used(&w);
    out.len = used;
    if !buf_append_byte(out, 0) {
        return false;
    }
    out.len = used;   // NUL 只给 C 字符串口径用，不计入长度
    return true;
}

// 一封「交计划」的响应体
fn tuis_pl_toolcall_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-tui-plan");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    var args: Buf = buf_new(4096);
    defer { buf_free(&args); }
    if !tuis_pl_args(&args, TUIS_PL_PLAN) {
        return false;
    }
    mock_call(&w, "call_pl", "exit_plan_mode", args.ptr as &const byte);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// true = 预期「解决」（留在 plan 模式），false = 预期「确认执行」
var tuis_pl_dismiss: bool = false;

// 本轮专用 mock：第 0 轮发 exit_plan_mode，第 1 轮断言工具结果并给最终答案
fn tuis_pl_mock(lfd: i32) i32 {
    var round: i32 = 0;
    var verdict: i32 = 0;
    while round < 2 {
        var lpfds: [PollFd: 1] = [PollFd{ fd: lfd, events: POLLIN, revents: 0 }];
        const lpr: i32 = sys_poll(&lpfds[0], 1, 10000) catch { 0; };
        if lpr <= 0 || (lpfds[0].revents & POLLIN) == 0 {
            if verdict == 0 && round < 2 {
                return 60 + round;   // 请求数不够：也算失败
            }
            return verdict;
        }
        var peer: [byte: 16] = [0: 16];
        var alen: u32 = 16;
        const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch { return 10; };
        var rx: Buf = buf_new(16384);
        if !mock_read_request(cfd, &rx) {
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            return 11;
        }
        const is_stream: bool = contains(&rx, "\"stream\":true");
        var body: Buf = buf_new(8192);
        if round == 0 {
            if !contains(&rx, "\"name\":\"exit_plan_mode\"") {
                verdict = 71;   // 计划工具必须在 schema 里
            }
            if !contains(&rx, "Plan mode is active") {
                verdict = 72;   // 运行时上下文必须告诉模型「在 plan 模式里」
            }
            if !contains(&rx, "refused until the user approves a plan") {
                verdict = 73;   // 闸门那句话也得在（模型提前知道写不了文件）
            }
            if !contains(&rx, "TUIS-PLAN-TASK") {
                verdict = 74;   // 任务文本必须真的进了历史
            }
            if !tuis_pl_toolcall_body(&body) {
                verdict = 75;
            }
        } else {
            if !contains(&rx, "PLAN-TAIL-MARK") {
                verdict = 76;   // 计划全文必须留在历史里（转录/记录不丢）
            }
            if tuis_pl_dismiss {
                if !contains(&rx, TUIS_PL_DISMISS_RESULT) {
                    verdict = 77;   // 「解决」的语义必须回到模型面前
                }
                if contains(&rx, TUIS_PL_APPROVED) {
                    verdict = 78;   // 没批准就绝不能出现 approved
                }
            } else {
                if !contains(&rx, TUIS_PL_APPROVED) {
                    verdict = 79;   // 批准了必须告诉模型可以开工
                }
                if contains(&rx, TUIS_PL_DISMISS_RESULT) {
                    verdict = 80;   // 批准了就不该是「停下等用户」
                }
            }
            if !mock_final_body(&body, "TUIS-PLAN-DONE" as &const byte) {
                verdict = 81;
            }
        }
        var sent: bool = false;
        if is_stream {
            sent = mock_send_sse(cfd, &body);
        } else {
            sent = mock_send(cfd, &body);
        }
        if !sent {
            verdict = 82;
        }
        buf_free(&body);
        buf_free(&rx);
        _ = sys_close(cfd) catch {};
        round = round + 1;
    }
    return verdict;
}

// fork 出 mock（形状与 tuis_ap_start_mock 相同，只换子进程里跑的那个 server）
fn tuis_pl_start_mock(want_dismiss: bool, mpid: &i32) u16 {
    tuis_pl_dismiss = want_dismiss;
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch { return 0; };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    if (sys_bind(lfd, &addr[0] as &void, 16 as u32) catch { -1; }) != 0 {
        _ = sys_close(lfd) catch {};
        return 0;
    }
    _ = sys_listen(lfd, 4) catch {};
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {};
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return 0;
    };
    if pid64 == 0 {
        const rc0: i32 = tuis_pl_mock(lfd);
        sys_exit(rc0);
    }
    mpid[0] = tuis_i32(pid64);
    _ = sys_close(lfd) catch {};
    return port;
}

// 一份「指向本地 mock」的配置（headless 与 PTY 子进程共用）。
// plan 模式**不**写进 cfg.plan：那个旗标只在进程第一次装配提示词时读一次，而本进程早被
// 前面的轮次装配过了；进入 plan 模式统一走用户那条路（tab / agent_plan_apply）。
fn tuis_pl_cfg(c: &Config, port: u16, ws: &const byte, task: &const byte) void {
    c.sandbox = SAN_OFF;          // 自测不测沙箱：别让机器上有没有 bwrap 影响结果
    cfg_pin_api(c, LLM_STYLE_CHAT);
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append(&c.task, task, bufx_cstr_len(task));
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.quiet = false;
    c.tool_lines = 8;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
}

// ---- A) 浮层排版与按键（headless，直接开浮层）----
fn tuis_pl_overlay_case(tag: &const byte, ok: &bool) void {
    var sel: Buf = buf_new(256);
    defer { buf_free(&sel); }
    tuis_reset(100, 30);
    if !tui_reader_fits() {
        tuis_fail(tag, "100x30 下 reader 浮层必须放得下", ok);
    }
    tui_overlay_reader(TUI_OVK_PLAN, TUIS_PL_TITLE, bufx_cstr_len(TUIS_PL_TITLE),
        TUIS_PL_PLAN, bufx_cstr_len(TUIS_PL_PLAN), PLAN_ITEMS, bufx_cstr_len(PLAN_ITEMS), 0);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_PLAN {
        tuis_fail(tag, "审阅浮层没有打开（或 kind 不是 TUI_OVK_PLAN）", ok);
        return;
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_PL_TITLE) {
        tuis_fail(tag, "浮层标题不对（应当是「计划待审」）", ok);
    }
    if !tuis_screen_has("计划待审 · 1/") {
        tuis_fail(tag, "标题栏没有「第 a 行/共 b 行」的滚动指示", ok);
    }
    if !tuis_screen_has(TUIS_PL_KEEP) || !tuis_screen_has(TUIS_PL_DISMISS) || !tuis_screen_has(TUIS_PL_APPROVE) {
        tuis_fail(tag, "三个动作（继续讨论 / 解决 / 确认执行）没有都在浮层里", ok);
    }
    if !tuis_screen_has("▸ 继续讨论") {
        tuis_fail(tag, "默认光标不在「继续讨论」上（安全默认：回车 ≠ 批准）", ok);
    }
    if !tuis_screen_has("plan 模式") {
        tuis_fail(tag, "动作行上方没有选中项说明", ok);
    }
    if tuis_screen_has(TUIS_PL_TAIL) {
        tuis_fail(tag, "计划尾巴一开始就可见 —— 这一轮的滚动断言就没意义了", ok);
    }
    // P46：正文走 markdown 渲染 ⇒ 标题的 `#` 号被去掉、并按 H1 着色（不再是字面量 `# 计划标题`）
    if !tuis_screen_has("│ 计划标题" as &const byte) {
        tuis_fail(tag, "正文第一行没有画出来（markdown 标题）", ok);
    }
    if tuis_screen_has("│ # " as &const byte) {
        tuis_fail(tag, "浮层正文的标题还带着 `#` 号（P46 起按 markdown 渲染）", ok);
    }
    // 方框逐行对齐（复用 tui-frame 轮那套量法：左右边界列 + 首尾必须是边框字形）
    tuis_overlay_frame_check(100, ok, tag);

    // ↓ 滚一行：标题栏指示器必须跟着走
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("计划待审 · 2/") {
        tuis_fail(tag, "↓ 之后标题栏的行号没有 +1（正文没滚动）", ok);
    }
    // pgdn 翻页：行号必须整页跳（不是 +1），而且一开始看不到的尾巴仍然看不到
    tui_keys_inject("\x1b[6~" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if tuis_screen_has("计划待审 · 1/") || tuis_screen_has("计划待审 · 2/") {
        tuis_fail(tag, "pgdn 之后行号还停在第 1/2 行（没有整页滚动）", ok);
    }
    // end 到底：尾巴标记必须出现（窗口高度随终端变，所以用「到底」而不是「翻一页」）
    tui_keys_inject("\x1b[4~" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has(TUIS_PL_TAIL) {
        tuis_fail(tag, "pgdn 之后仍看不到计划尾巴（正文没有真的滚动）", ok);
    }
    // home 回顶
    tui_keys_inject("\x1b[H" as &const byte, 3);
    tui_build();
    if !tuis_screen_has("计划待审 · 1/") {
        tuis_fail(tag, "home 没有回到第一行", ok);
    }

    // 数字直选 + 回车：交回「确认执行」
    tui_keys_inject("3" as &const byte, 1);
    if tui_overlay_sel_index() != 2 {
        tuis_fail(tag, "按 3 没有把光标移到第三个动作上", ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "回车没有把选中项交出来", ok);
    } else if !bufx_eq_cstr(sel.ptr as &const byte, sel.len, TUIS_PL_APPROVE) {
        tuis_fail(tag, "数字直选 + 回车交回的不是「确认执行」", ok);
    }
    if tui_overlay_kind() != TUI_OVK_PLAN {
        tuis_fail(tag, "take 之后 kind 不是 TUI_OVK_PLAN（结果会被静默丢掉）", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "回车之后浮层还开着", ok);
    }

    // esc 取消（= 「解决」）
    tui_overlay_reader(TUI_OVK_PLAN, TUIS_PL_TITLE, bufx_cstr_len(TUIS_PL_TITLE),
        TUIS_PL_PLAN, bufx_cstr_len(TUIS_PL_PLAN), PLAN_ITEMS, bufx_cstr_len(PLAN_ITEMS), 0);
    tui_keys_inject("\x1b" as &const byte, 1);
    if !tui_overlay_cancelled() {
        tuis_fail(tag, "esc 没有走「取消」", ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "esc 之后浮层还开着", ok);
    }

    // plan 状态 → 面板 chip 的同步（批准/退出都靠它，唯一的变更点）
    agent_plan_force(true);
    if !tui_plan_on() {
        tuis_fail(tag, "进 plan 模式时没有同步输入面板的 Plan chip", ok);
    }
    agent_plan_force(false);
    if tui_plan_on() {
        tuis_fail(tag, "退出 plan 模式时 chip 没有跟着收掉", ok);
    }

    // 窄终端：每行仍然 ≤ cols，边框与动作行还在（40 列下「确认执行」会被截断，只看第一项）
    tuis_reset(40, 14);
    tui_overlay_reader(TUI_OVK_PLAN, TUIS_PL_TITLE, bufx_cstr_len(TUIS_PL_TITLE),
        TUIS_PL_PLAN, bufx_cstr_len(TUIS_PL_PLAN), PLAN_ITEMS, bufx_cstr_len(PLAN_ITEMS), 0);
    tui_build();
    tuis_scan_rows(40, ok, tag);
    if !tuis_screen_has(TUIS_PL_TITLE) || !tuis_screen_has("▸ 继续讨论") {
        tuis_fail(tag, "窄终端下浮层没画出来（标题或动作行缺失）", ok);
    }
    // 窄终端一定会触发截断：这一条正是当初抓出「宽 1 列」（= 踩坑 42 那类）的地方
    tuis_overlay_frame_check(40, ok, tag);
    
    if !tuis_screen_has("╭" as &const byte) || !tuis_screen_has("╰" as &const byte) {
        tuis_fail(tag, "窄终端下浮层没有圆角边框", ok);
    }
    tui_overlay_close();
    tuis_reset(100, 30);
}

// ---- B) headless + agent：没人回答 → 「解决」（fail closed，绝不批准）----
fn tuis_pl_headless_case(tag: &const byte, ok: &bool) void {
    const ws: &const byte = "build/selftest_ws_tui_plan" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return;
    }
    var mpid: i32 = -1;
    const port: u16 = tuis_pl_start_mock(true, &mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var c: Config = cfg_default();
    tuis_pl_cfg(&c, port, ws, TUIS_PL_TASK);
    c.tui = true;
    c.tui_headless = true;
    c.tui_cols = 100;
    c.tui_rows = 30;

    tui_reset_all();
    tui_set_headless(true);
    tui_set_size(100, 30);
    tui_set_color(false, false);
    tui_begin_session();
    tui_sink_flush_partial();
    // 进 plan 模式走**用户那条路**：tab → TUI_REQ_PLAN_ON → 主循环 plan_set()。
    // （进程级的 plan 镜像只有主循环那条路会同步：cfg.plan 只在 agent_texts_ensure()
    //   里读一次，而那个 one-shot 标记在本进程早被前面的轮次置位了。）
    // 所以这里只注入 tab、**不**把请求取走，留给主循环去消费。
    tui_keys_inject("\t" as &const byte, 1);
    if !tui_plan_on() {
        tuis_fail(tag, "tab 没有切进 plan 模式（chip 没变）", ok);
        return;
    }
    tui_keys_inject(TUIS_PL_TASK, bufx_cstr_len(TUIS_PL_TASK));
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_has_submit() {
        tuis_fail(tag, "注入回车之后没有待取走的提交", ok);
    }

    const rc: i32 = agent_run_tui(&c);
    const mock_rc: i32 = wait_child(mpid);
    if rc != AGENT_OK {
        tuis_fail(tag, "plan 模式的一轮却以非 0 退出", ok);
    }
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错（第二封请求里的工具结果不对？）", ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
    }
    // headless 下注入的键用完 = 没人回答：浮层必须收掉，否则它会一直盖着转录
    if tui_overlay_open() {
        tuis_fail(tag, "headless 下没人回答之后，审阅浮层还留在屏幕上", ok);
        tui_overlay_close();
    }
    if !plan_on() {
        tuis_fail(tag, "没人回答之后 plan 模式被退出了（那时不该退出）", ok);
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if tuis_screen_has(TUIS_PL_APPROVED) {
        tuis_fail(tag, "转录里出现了「Plan approved」（没人回答却批准了）", ok);
    }
    cfg_free(&c);
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
}

// ---- 子进程侧：把 slave 挂到 0/1/2 后跑真 TUI（plan 模式 + 真终端）----
fn tuis_pl_child(slave_path: &const Buf, port: u16, ws: &const byte) void {
    const s: i32 = sys_open(slave_path.ptr as *const byte, TUIS_O_RDWR_NOCTTY, 0) catch { -1; };
    if s < 0 {
        sys_exit(9);
    }
    _ = sys_dup2(s, 0) catch {};
    _ = sys_dup2(s, 1) catch {};
    _ = sys_dup2(s, 2) catch {};
    if s > 2 {
        _ = sys_close(s) catch {};
    }
    var c: Config = cfg_default();
    tuis_pl_cfg(&c, port, ws, "" as &const byte);   // 任务由父进程从 PTY 打进来
    c.tui = true;
    c.tui_headless = false;
    const rc: i32 = agent_run_tui(&c);
    sys_exit(rc);
}

// ---- C/D) 真 PTY：approve（先滚动）与 esc → 解决 ----
fn tuis_pl_pty_case(tag: &const byte, ok: &bool, approve: bool) void {
    const ws: &const byte = "build/selftest_ws_tui_plan_pty" as &const byte;
    if !ws_prepare(ws) {
        tuis_fail(tag, "工作目录准备失败", ok);
        return;
    }
    var mpid: i32 = -1;
    const port: u16 = tuis_pl_start_mock(!approve, &mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    }
    tui_reset_all();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        return;
    };
    if cpid64 == 0 {
        tuis_pl_child(&slave_path, port, ws);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);

    var cap: Buf = buf_new(4194304);
    defer { buf_free(&cap); }
    tuis_drain(m, &cap, 40);      // 首帧（子进程进 raw 之后才会画）
    if !tuis_has(&cap, "Ask anything" as &const byte) {
        tuis_fail(tag, "首屏没有输入面板占位文案", ok);
    }
    // 先进 plan 模式（tab = 切模式）：面板 chip 从 Build 变成 Plan 才算数。
    // 注意只能搜**裸词** Plan：PTY 里样式是 SGR 序列，`▌` 与 `Plan` 之间夹着 `ESC[0m`。
    // （帧里没有别的「Plan」：正文计划只有中文与小写 plan / 大写的 PLAN-TAIL-MARK。）
    tuis_write_master(m, "\t" as &const byte, 1);
    var plan_chip: bool = false;
    var kp: i32 = 0;
    while kp < 80 && !plan_chip {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, "Plan" as &const byte) {
            plan_chip = true;
        }
        kp = kp + 1;
    }
    if !plan_chip {
        tuis_fail(tag, "tab 之后面板 chip 没有变成 Plan（没进 plan 模式）", ok);
        tuis_dump_tail(&cap, 1200);
    }
    var task: [byte: 64] = "plan the greeting change (TUIS-PLAN-TASK)\r";
    tuis_write_master(m, &task[0], bufx_cstr_len(&task[0] as &const byte));
    var seen: bool = false;
    var k: i32 = 0;
    while k < 160 && !seen {
        tuis_drain(m, &cap, 1);
        if tuis_has(&cap, TUIS_PL_TITLE) {
            seen = true;
        }
        k = k + 1;
    }
    if !seen {
        tuis_fail(tag, "exit_plan_mode 没有弹出审阅浮窗", ok);
        tuis_dump_tail(&cap, 1500);
    } else {
        if !tuis_has(&cap, TUIS_PL_KEEP) || !tuis_has(&cap, TUIS_PL_DISMISS) || !tuis_has(&cap, TUIS_PL_APPROVE) {
            tuis_fail(tag, "审阅浮层里没有三个动作", ok);
        }
        // 标题栏的「第 a 行/共 b 行」在这里不断言：PTY 里标题与数字之间夹着 SGR 序列，
        // 字节层面不相邻（精确断言在 A 段的 headless 用例里做）。
        if tuis_has(&cap, TUIS_PL_TAIL) {
            tuis_fail(tag, "计划尾巴一开始就可见（这一屏本来是放不下的）", ok);
        }
        if approve {
            // end 翻到底 → 尾巴必须出现（证明确实滚动了），再按 3 选中「确认执行」并回车
            buf_reset(&cap);
            tuis_write_master(m, "\x1b[4~" as &const byte, 4);
            var scrolled: bool = false;
            var k2: i32 = 0;
            while k2 < 120 && !scrolled {
                tuis_drain(m, &cap, 1);
                if tuis_has(&cap, TUIS_PL_TAIL) {
                    scrolled = true;
                }
                k2 = k2 + 1;
            }
            if !scrolled {
                tuis_fail(tag, "end 之后仍看不到计划尾巴（正文不可滚动？）", ok);
                tuis_dump_tail(&cap, 1200);
            }
            tuis_write_master(m, "3\r" as &const byte, 2);
        } else {
            // esc = 「解决」：关掉浮窗、留在 plan 模式等用户说话
            tuis_write_master(m, "\x1b" as &const byte, 1);
        }
        var k3: i32 = 0;
        while k3 < 200 && !tuis_has(&cap, "TUIS-PLAN-DONE" as &const byte) {
            tuis_drain(m, &cap, 1);
            k3 = k3 + 1;
        }
        if !tuis_has(&cap, "TUIS-PLAN-DONE" as &const byte) {
            tuis_fail(tag, "审阅之后没有收到 mock 的最终答案", ok);
            tuis_dump_tail(&cap, 1500);
        }
        // 决定之后的效果由 mock 侧断言（工具结果文案），界面 chip 的同步在 A 段用
        // 状态查询钉死（PTY 帧里 `▌` 与 `Plan` 之间夹着 SGR，字节层面搜不准，
        // 而转录里本来就有 ExitPlan 这种含 "Plan" 的卡片标题）。
        var k4: i32 = 0;
        while k4 < 8 {
            tuis_drain(m, &cap, 1);
            k4 = k4 + 1;
        }
    }
    // 退出：先清输入再 Ctrl-D
    var bs: [byte: 1] = [127];
    tuis_write_master(m, &bs[0], 1);
    tuis_drain(m, &cap, 6);
    var ctrl_d: [byte: 1] = [4];
    tuis_write_master(m, &ctrl_d[0], 1);
    tuis_drain(m, &cap, 30);
    var st: i32 = 0;
    if !tuis_wait_raw(cpid, &st, 20000) {
        tuis_fail(tag, "Ctrl-D 之后 TUI 子进程没有退出", ok);
        _ = sys_kill(cpid as i64, SIGKILL) catch {};
        _ = tuis_wait_raw(cpid, &st, 2000);
    } else {
        const code: i32 = (st >> (8 as i32)) & 255;
        if code != 0 {
            tuis_fail(tag, "TUI 退出码不是 0", ok);
        }
    }
    _ = sys_close(m) catch {};
    const mock_rc: i32 = wait_child(mpid);
    if mock_rc != 0 {
        tuis_fail(tag, "mock LLM 侧报错（审阅结果不对？）", ok);
        tuis_puts("  mock_rc=");
        tuis_num(mock_rc as usize);
        tuis_puts("\n");
    }
}

fn tui_plan_round(tag: &const byte) bool {
    var ok: bool = true;
    // 进程级的 plan 状态是继承的（PTY 子进程 fork 自本进程）：轮次开头先摆平，
    // 否则上一轮的残留会让子进程一进来就在 plan 模式里、tab 反倒把它关掉。
    agent_plan_force(false);
    // A) 浮层：排版 + 滚动 + 直选 + esc + 窄终端
    tuis_pl_overlay_case(tag, &ok);
    // B) headless：没人回答 = 「解决」（fail closed）
    tuis_pl_headless_case(tag, &ok);
    // 这一轮结束时 plan 模式仍开着（B 段的语义就是「留在 plan 模式」）：恢复成关，
    // 免得污染后面的轮次与 PTY 子进程。
    agent_plan_force(false);
    // C) 真 PTY：滚动 + 「确认执行」→ 模型拿到 Plan approved
    tuis_pl_pty_case(tag, &ok, true);
    // D) 真 PTY：esc → 「解决」→ 模型被告知停下等用户说话，plan 模式仍在
    tuis_pl_pty_case(tag, &ok, false);
    agent_plan_force(false);
    if ok {
        tuis_ok(tag, "plan 审阅：浮窗排版/滚动/三动作/数字直选/esc + headless fail closed + 真 PTY 批准与解决");
    }
    return ok;
}

// ============================================================
// tui-tasks（P22）：常驻任务块的布局 / ctrl+t 开关 / 活体刷新 / 降级
//
// 块的内容由 tasks.uya 生成（那一层有自己的纯函数轮 tasks-render），这一轮只守住
// 「TUI 侧的三件事」：摆在哪儿、什么时候换、地方不够时怎么退化。
// ============================================================
fn tui_tasks_round(tag: &const byte) bool {
    var ok: bool = true;
    var row: usize = 0;
    view_init(true, 0);          // 这一轮直接建帧，不跑 agent：显示层要自己打开

    // ---- A) 空态：一个字节都不画，状态行仍然钉在输入面板正上方（P18 的断言不许动）----
    tuis_reset(100, 28);
    tuis_fill_transcript();
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tui_tasks_rows_n() != 0 {
        tuis_fail(tag, "空态下任务块应当是 0 行", &ok);
    }
    if tuis_find_row("┌─ tasks " as &const byte, &row) {
        tuis_fail(tag, "空态下画出了任务箱体（布局应当与 P22 之前逐字节相同）", &ok);
    }
    if !tuis_find_row("Bash(make check)" as &const byte, &row) {
        tuis_fail(tag, "空态下状态行不见了", &ok);
    } else if row != tui_nrows() - 4 {
        tuis_fail(tag, "空态下状态行没有钉在输入面板正上方", &ok);
    }

    // ---- B) 装上 fixture（真实 globals）：折叠行出现在状态区之上 ----
    agent_tasks_fixture_demo();
    _ = tasks_panel_sync();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    var srow: usize = 0;         // 状态行
    var trow: usize = 0;         // 折叠行
    var arow: usize = 0;         // agents 箱体首行
    // 块 = 折叠行(1) + agents 箱体(1 个 agent = 4 行)：agents 箱体跟着块一起推
    if tui_tasks_rows_n() != 5 {
        tuis_fail(tag, "折叠态的块应当是「1 行折叠 + agents 箱体 4 行」", &ok);
    }
    if !tuis_find_row("▸ 任务 2/4 50%" as &const byte, &trow) {
        tuis_fail(tag, "折叠行没有出现", &ok);
    } else {
        if !tui_row_has(trow, "后台 1/2" as &const byte) {
            tuis_fail(tag, "折叠行少了后台任务段", &ok);
        }
        if !tui_row_has(trow, "子代理 1/1" as &const byte) {
            tuis_fail(tag, "折叠行少了子代理段", &ok);
        }
        if !tui_row_has(trow, "目标 3/20" as &const byte) {
            tuis_fail(tag, "折叠行少了目标段", &ok);
        }
    }
    if !tuis_find_row("┌─ agent " as &const byte, &arow) {
        tuis_fail(tag, "运行中的子代理窗口没画出来（P15 被任务块挤掉了？）", &ok);
    }
    if !tuis_find_row("Bash(make check)" as &const byte, &srow) {
        tuis_fail(tag, "有任务块时状态行丢了", &ok);
    } else if srow != tui_nrows() - 4 {
        tuis_fail(tag, "任务块把状态行挤离了输入面板上方", &ok);
    } else if !(trow < arow && arow < srow) {
        tuis_fail(tag, "层序不对（应当是 转录 → 任务块 → agents 箱体 → 状态区 → 面板）", &ok);
    }

    // ---- C) ctrl+t：键层只置请求；处理之后展开成箱体，再切回收起 ----
    tui_keys_inject("\x14" as &const byte, 1);
    const req: i32 = tui_take_request();
    if req != TUI_REQ_TASKS {
        tuis_fail(tag, "ctrl+t 没有置出「切换任务块」请求", &ok);
    }
    tasks_expand_set(!tasks_expanded());
    _ = tasks_panel_sync();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tasks_expanded() {
        tuis_fail(tag, "ctrl+t 之后展开态没打开", &ok);
    }
    if tui_tasks_rows_n() <= 1 {
        tuis_fail(tag, "展开之后还是 1 行（箱体没画出来）", &ok);
    }
    if !tuis_find_row("┌─ tasks " as &const byte, &row) {
        tuis_fail(tag, "展开之后没有任务箱体", &ok);
    } else if row >= tui_nrows() - 4 {
        tuis_fail(tag, "展开的任务箱体压在输入面板上", &ok);
    }
    var crow: usize = 0;
    if !tuis_find_row("清单" as &const byte, &crow) {
        tuis_fail(tag, "展开的箱体里没有清单段", &ok);
    } else if !tui_row_has(crow, "2/4" as &const byte) {
        tuis_fail(tag, "清单段没有带上计数", &ok);
    }
    var grow: usize = 0;
    if !tuis_find_row("└─ " as &const byte, &grow) {
        tuis_fail(tag, "展开的箱体没有底框", &ok);
    }
    var a2: usize = 0;
    if !tuis_find_row("┌─ agent " as &const byte, &a2) {
        tuis_fail(tag, "展开之后 agents 箱体不见了（行数够的时候不该丢）", &ok);
    } else if !(row < crow && crow < grow && grow < a2) {
        tuis_fail(tag, "层序不对（应当是 任务箱体（顶→清单→底）→ agents 箱体）", &ok);
    }
    // 再切一次回到折叠态
    tasks_expand_set(!tasks_expanded());
    _ = tasks_panel_sync();
    tui_build();
    if tui_tasks_rows_n() != 5 {
        tuis_fail(tag, "收起之后没有回到「1 行折叠 + agents 箱体」", &ok);
    }
    if tuis_find_row("┌─ tasks " as &const byte, &row) {
        tuis_fail(tag, "收起之后任务箱体还挂在屏幕上", &ok);
    }

    // ---- D) 活体刷新：job 状态变了，折叠行的「后台 r/n」跟着变 ----
    g_jobs.items[0].status = JOB_DONE;
    g_jobs.items[0].exit_code = 0;
    tasks_tick(ua_now_ms() + (5000 as u64));
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_find_row("▸ 任务 2/4 50%" as &const byte, &trow) {
        tuis_fail(tag, "活体刷新之后折叠行不见了", &ok);
    } else if !tui_row_has(trow, "后台 0/2" as &const byte) {
        tuis_fail(tag, "job 跑完了折叠行的后台计数没跟着变", &ok);
    }

    // ---- E) 矮终端降级：箱体裁到可用行数（含边框），转录仍留 ≥3 行 ----
    tuis_reset(80, 12);
    tuis_fill_transcript();
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    agent_tasks_fixture_demo();
    tasks_expand_set(true);
    _ = tasks_panel_sync();
    tui_build();
    tuis_scan_rows(80, &ok, tag);
    // 80×12：面板 2 行 + 脚注 1 → 面板顶在第 9 行；状态区 1 行 → 余 8 行，给转录留 3 行 = 块最多 5 行
    if tui_tasks_rows_n() > 5 {
        tuis_fail(tag, "矮终端下的块超过了可用行数（阶梯退化没生效）", &ok);
    }
    if !tuis_find_row("… 还有 " as &const byte, &row) {
        tuis_fail(tag, "裁掉的行数没有补 `… 还有 N 行`", &ok);
    }
    if !tuis_find_row("Bash(make check)" as &const byte, &srow) || srow != tui_nrows() - 4 {
        tuis_fail(tag, "矮终端下状态行没有钉在面板正上方", &ok);
    }
    // 地方不够时先丢的是 agents 箱体：紧贴状态行上方那一行必须是完整的箱体底框
    if !tui_row_has(srow - 1, "└─ " as &const byte) {
        tuis_fail(tag, "矮终端下箱体被硬裁掉了底框（应当整体退化成不带 agents 的箱体）", &ok);
    }
    if tuis_find_row("┌─ agent " as &const byte, &row) {
        tuis_fail(tag, "地方不够时应当先丢 agents 箱体", &ok);
    }
    var blank_top: bool = true;
    var r0: usize = 0;
    while r0 < tui_nrows() - 4 {
        if !tui_row_blank(r0) {
            blank_top = false;
        }
        r0 = r0 + 1;
    }
    if blank_top {
        tuis_fail(tag, "矮终端下转录一行都没留下", &ok);
    }

    // ---- F) 窄终端：每行不超列宽（tuis_scan_rows 覆盖），箱体照画 ----
    tuis_reset(40, 14);
    tuis_fill_transcript();
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    agent_tasks_fixture_demo();
    tasks_expand_set(true);
    _ = tasks_panel_sync();
    tui_build();
    tuis_scan_rows(40, &ok, tag);
    if !tuis_find_row("┌─ tasks " as &const byte, &row) {
        tuis_fail(tag, "40 列下没有画出任务箱体", &ok);
    }

    // ---- G) /tasks 命令在 TUI 里必须开出任务浮层（滚动模式那条打印路径由 e2e-tasks 守着）----
    tuis_reset(100, 28);
    agent_tasks_fixture_demo();
    var c: Config = cfg_default();
    defer { cfg_free(&c); }
    c.sandbox = SAN_OFF;
    var hs: History = hist_init();
    defer { hist_free(&hs); }
    var cmd: Buf = buf_new(32);
    defer { buf_free(&cmd); }
    _ = buf_append_cstr(&cmd, "/tasks");
    _ = agent_tui_command(&c, &hs, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_TASKS {
        tuis_fail(tag, "/tasks 没有开出任务浮层", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);        // 回车：关掉浮层并把选中行交出来
    var got: Buf = buf_new(512);
    defer { buf_free(&got); }
    if !tui_overlay_take(&got) {
        tuis_fail(tag, "任务浮层没有把内容交出来（结果被丢了？）", &ok);
    } else {
        var found: bool = false;
        var gi: usize = 0;
        while gi + 6 <= got.len {
            if bufx_mem_eq(&got.ptr[gi] as &const byte, "清单" as &const byte, 6) {
                found = true;
            }
            gi = gi + 1;
        }
        if !found {
            tuis_fail(tag, "任务浮层里不是任务报告（第一行没有「清单」）", &ok);
        }
    }

    // 收尾：fixture 装在真实 globals 上，必须清掉（后面的 TUI 轮靠空表做排版断言）
    tuis_tasks_clear();

    // ---- H) P29：/goal 在 TUI 里必须开出目标浮层；带参数的那条还要落盘 + 刷新目标投影 ----
    // （滚动模式那条「打进转录」的路由 e2e-goal 守着；这一轮守 TUI 这条腿：
    //   清单里有没有这条命令、浮层开不开、标题对不对、正文是不是 goal_cmd_run 的输出、
    //   goal.json 有没有落盘、常驻块的目标段有没有跟着新值重画）
    tuis_reset(100, 28);
    const ghome: &const byte = "build/selftest_goal_tui_home" as &const byte;
    _ = sess_mkdir_p(ghome);
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, ghome);
    _ = goal_clear(&c);                  // 上一轮留下的 goal.json 先清掉
    var gline: Buf = buf_new(256);
    defer { buf_free(&gline); }
    var gsel: Buf = buf_new(1024);
    defer { buf_free(&gsel); }
    var hg: History = hist_init();
    defer { hist_free(&hg); }
    // 命令面板的**真实**清单里必须有 /goal（面板只吃 agent_tui_commands 的产物）
    var plist: Buf = buf_new(2048);
    defer { buf_free(&plist); }
    agent_tui_commands(&plist);
    if !tuis_has(&plist, "/goal" as &const byte) {
        tuis_fail(tag, "命令面板的清单里没有 /goal", &ok);
    }
    // 无目标：浮层照开，正文是用法（不许静默无事发生）
    _ = buf_append_cstr(&gline, "/goal");
    _ = agent_tui_command(&c, &hg, &gline);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_GOAL {
        tuis_fail(tag, "/goal 没有开出目标浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("目标（esc 关闭）" as &const byte) {
        tuis_fail(tag, "目标浮层没有画到屏幕上（或标题不对）", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&gsel) || !tuis_has(&gsel, "No goal is currently set." as &const byte) {
        tuis_fail(tag, "无目标时的目标浮层里没有用法", &ok);
    }
    // 创建：浮层给回执、goal.json 落盘、常驻块的目标投影当场刷新
    tui_overlay_close();
    buf_reset(&gline);
    _ = buf_append_cstr(&gline, "/goal 把 TUI 这条腿也测了");
    _ = agent_tui_command(&c, &hg, &gline);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_GOAL {
        tuis_fail(tag, "/goal <objective> 没有开出目标浮层", &ok);
    }
    // 正文要真的画在屏幕上（list 型浮层 take 回来的只是**选中行**，所以正文得看帧）
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("Goal created" as &const byte) {
        tuis_fail(tag, "创建目标的浮层里没有回执", &ok);
    }
    if !tuis_screen_has("Objective: 把 TUI 这条腿也测了" as &const byte) {
        tuis_fail(tag, "创建目标的浮层里 objective 不对", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&gsel) || !tuis_has(&gsel, "Goal created" as &const byte) {
        tuis_fail(tag, "创建目标的浮层没把选中行交出来", &ok);
    }
    var tg: Goal = goal_empty();
    defer { goal_free(&tg); }
    if !goal_load(&c, &tg) {
        tuis_fail(tag, "/goal <objective> 之后盘上没有 goal.json", &ok);
    } else if tg.id != 1 || tg.revision != 1 || !tg.armed {
        tuis_fail(tag, "落盘的 id/revision/armed 不对", &ok);
    }
    if !tasks_goal_ref().active_state {
        tuis_fail(tag, "/goal 创建之后常驻块的目标投影没有跟着刷新", &ok);
    }
    // 清除：浮层回执 + 投影回到「无目标」
    tui_overlay_close();
    buf_reset(&gline);
    _ = buf_append_cstr(&gline, "/goal clear");
    _ = agent_tui_command(&c, &hg, &gline);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_GOAL {
        tuis_fail(tag, "/goal clear 没有开出目标浮层", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&gsel) || !tuis_has(&gsel, "Goal cleared." as &const byte) {
        tuis_fail(tag, "/goal clear 的浮层里没有回执", &ok);
    }
    if tasks_goal_ref().active_state {
        tuis_fail(tag, "clear 之后常驻块的目标投影还留着旧目标", &ok);
    }
    _ = goal_clear(&c);                  // 收尾：不留 goal.json 给别的轮

    if ok {
        tuis_ok(tag, "空态 0 行 + 折叠行钉在状态区之上 + ctrl+t 展开/收起 + 活体刷新 + 矮/窄终端降级 + /tasks 浮层 + /goal 浮层");
    }
    return ok;
}

// ============================================================
// tui-ws（P34）：工作区切换在界面上、在给模型的快照里都跟上
//
// 覆盖四件事：
//   1) 脚注 cwd 与转录通知跟着新工作区走（切换是真 chdir，测试收尾要站回仓库根）；
//   2) step 边界补推的运行时上下文里写着新工作区，而且是**注入消息**（不画成用户条目）；
//   3) /diff 浮窗标题里写的是工作区（假数据注入工作区，不必真跑 git）；
//   4) 切到已经在的工作区是幂等的（不推快照、不刷通知）。
// ====================================================
fn tui_ws_round(tag: &const byte) bool {
    var ok: bool = true;
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        tuis_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    defer { wst_back(&root); }
    _ = sess_mkdir_p(WST_A);
    _ = sess_mkdir_p(WST_A_SUB);
    var abs_a: Buf = buf_new(1024);
    defer { buf_free(&abs_a); }
    var abs_sub: Buf = buf_new(1024);
    defer { buf_free(&abs_sub); }
    if !wst_abs(&root, WST_A, &abs_a) || !wst_abs(&root, WST_A_SUB, &abs_sub) {
        tuis_fail(tag, "拿不到临时工作区的绝对路径", &ok);
        return ok;
    }

    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("selftest-model");
    cfg.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&cfg);
    var h: History = hist_init();
    defer { hist_free(&h); }
    // 清台面：TUI 状态复位之后再切（通知与脚注都画在复位之后的那一帧上）
    tuis_reset(120, 30);
    tui_build();
    const n_base: usize = h.len;

    // ---- 切到 A：通知 + 脚注 ----
    const rc: i32 = agent_workspace_apply(&cfg, abs_a.ptr as &const byte, abs_a.len, "tool" as &const byte, true);
    if rc != WS_OK {
        tuis_fail(tag, "切到临时工作区失败", &ok);
        return ok;
    }
    tui_build();
    // 脚注里的 cwd 是 $HOME → ~ 的短路径
    var short_a: Buf = buf_new(1024);
    defer { buf_free(&short_a); }
    const hm: &byte = getenv("HOME");
    var hn: usize = 0;
    if (hm as usize) != 0 {
        hn = bufx_cstr_len(hm);
    }
    if hn > 1 && abs_a.len > hn && abs_a.ptr[hn] == 47 as byte && bufx_mem_eq(abs_a.ptr as &const byte, hm, hn) {
        _ = buf_append_cstr(&short_a, "~");
        _ = buf_append(&short_a, abs_a.ptr + hn, abs_a.len - hn);
    } else {
        _ = buf_append(&short_a, abs_a.ptr as &const byte, abs_a.len);
    }
    // 脚注 cwd 会被列宽预算裁短，所以断言「末段目录名」+「通知里的完整路径」两处
    if !tuis_screen_has("selftest_ws_p31_a" as &const byte) {
        tuis_fail(tag, "界面上看不到新工作区（脚注 cwd 没跟上）", &ok);
    }
    if !tuis_screen_has("工作区 → " as &const byte) {
        tuis_fail(tag, "转录里没有工作区切换的通知", &ok);
    }
    // 通知里写的是**绝对**路径（转录没有列宽问题，可复制粘贴）
    var abs_az: Buf = buf_new(abs_a.len + 1);
    defer { buf_free(&abs_az); }
    _ = buf_append(&abs_az, abs_a.ptr as &const byte, abs_a.len);
    _ = buf_append_byte(&abs_az, 0);
    if !tuis_screen_has(abs_az.ptr as &const byte) {
        tuis_fail(tag, "通知里没有新工作区的完整路径", &ok);
    }
    if tuis_screen_has("Current runtime context" as &const byte) {
        tuis_fail(tag, "运行时上下文被画成用户条目了", &ok);
    }

    // ---- step 边界补推：运行时上下文里要有新工作区 ----
    // 进程级基线可能还是上一轮留下的：这一步本就该推；再调一次必须幂等。
    const n0: usize = h.len;
    agent_ws_snapshot_sync(&cfg, &h);
    const n_pushed: usize = h.len;
    agent_ws_snapshot_sync(&cfg, &h);
    if n_pushed <= n0 {
        tuis_fail(tag, "工作区变了却没有给模型补一份新快照", &ok);
    } else if h.len != n_pushed {
        tuis_fail(tag, "工作区没再变却又推了一份快照", &ok);
    } else {
        const m: &const Msg = msg_at(&h, n0);
        if m.text_len < 23 || !bufx_mem_eq(m.text as &const byte, "Current runtime context" as &const byte, 23) {
            tuis_fail(tag, "补推的消息不是以 Current runtime context 开头", &ok);
        }
        var mtxt: Buf = buf_new(4096);
        defer { buf_free(&mtxt); }
        _ = buf_append(&mtxt, m.text as &const byte, m.text_len);
        if !tuis_has(&mtxt, abs_az.ptr as &const byte) {
            tuis_fail(tag, "补推的快照里没有新工作区路径", &ok);
        }
        if !tuis_has(&mtxt, "Current workspace: " as &const byte) {
            tuis_fail(tag, "补推的快照里没有 Current workspace 那行", &ok);
        }
        if !agent_tui_is_injected(m) {
            tuis_fail(tag, "补推的运行时上下文会被当成用户消息回填", &ok);
        }
    }

    // ---- /diff 标题：工作区 + 仓库名（假数据注入工作区，不依赖 git）----
    tuis_reset(120, 30);
    tuis_fixture_open();
    gd_fixture_ws("/p31/ws" as &const byte, bufx_cstr_len("/p31/ws" as &const byte));
    tui_build();
    if !tuis_screen_has("/diff · /p31/ws" as &const byte) {
        tuis_fail(tag, "/diff 标题里没有工作区", &ok);
    }
    if !tuis_screen_has("uya-agent" as &const byte) {
        tuis_fail(tag, "/diff 标题里没有仓库名（工作区不是仓库根时要两个都写）", &ok);
    }
    tui_overlay_close();
    // 收尾：把假数据的工作区清掉（后面 tui-diff 轮还要按「没有工作区」的旧排版断言）
    gd_fixture_ws("" as &const byte, 0);

    // ---- 幂等：切到已经在的工作区不推快照、不刷通知 ----
    const n1: usize = h.len;
    const same: i32 = agent_workspace_apply(&cfg, abs_a.ptr as &const byte, abs_a.len, "tool" as &const byte, true);
    if same != WS_E_SAME {
        tuis_fail(tag, "切到已经在的工作区应当是幂等的", &ok);
    }
    agent_ws_snapshot_sync(&cfg, &h);
    if h.len != n1 {
        tuis_fail(tag, "幂等切换却又推了一份快照", &ok);
    }

    // ---- 相对路径也认（按当前工作区解析）----
    const rrel: i32 = agent_workspace_apply(&cfg, "sub" as &const byte, 3, "tool" as &const byte, true);
    if rrel != WS_OK {
        tuis_fail(tag, "相对路径切不过去", &ok);
    } else if cfg.workspace.len != abs_sub.len ||
        !bufx_mem_eq(cfg.workspace.ptr as &const byte, abs_sub.ptr as &const byte, abs_sub.len) {
        tuis_fail(tag, "相对路径没有落到子目录上", &ok);
    }
    return ok;
}

// ============================================================
// tui-sessions（P33）：/sessions 浮层 —— 时间倒序 · 三列 · 选中项恢复
// ============================================================
// 端到端一条链：真索引 fixture（三个会话，走真实的 sess_open/sess_close 落盘）
// → `/sessions` 开浮层 → 宽箱体（cols-6）+ 三列 + 逐行宽度不变量
// → **P35**：最新的那行在**最后一行**、默认游标就落在它上面
// → 回车 → agent_tui_sessions_head 取到**完整 id**（不是标题）→ 该 id 能被 sess_find 找到
//   （`/resume <id>` 走的就是 sess_find）。
// 窄终端那一档另跑一遍：工作区列掉了、id 列还在，条目文本里的 id 仍然完整。

// 造一个真会话（真落盘 + 真索引行；标题由调用方给）
fn tuis_sess_make(home: &const byte, ws: &const byte, title: &const byte, out_id: &Buf) bool {
    var log: SessionLog = sess_log_empty();
    defer { sess_log_free(&log); }
    if !sess_open(&log, home, ws, "selftest-model" as &const byte, "uya-agent" as &const byte, "" as &const byte, true, 0 as i64, true) {
        return false;
    }
    buf_reset(&log.title);
    _ = buf_append_cstr(&log.title, title);
    buf_reset(out_id);
    _ = buf_append(out_id, log.id.ptr, log.id.len);
    sess_close(&log, home);
    return out_id.len > 0;
}

fn tui_sessions_round(tag: &const byte) bool {
    var ok: bool = true;
    const home: &const byte = "build/selftest_tui_sessions" as &const byte;
    const ws: &const byte = "build/selftest_tui_sessions_ws" as &const byte;
    _ = sess_mkdir_p(home);
    // 同一个 home 可能被上一轮用过：索引先清掉，否则旧会话会混进列表
    var ipath: Buf = buf_new(160);
    defer { buf_free(&ipath); }
    _ = buf_append_cstr(&ipath, home);
    _ = buf_append_cstr_z(&ipath, "/index.jsonl");
    _ = sys_unlink(ipath.ptr as *const byte) catch {};
    var id_old: Buf = buf_new(64);
    var id_mid: Buf = buf_new(64);
    var id_new: Buf = buf_new(64);
    defer { buf_free(&id_old); buf_free(&id_mid); buf_free(&id_new); }
    // 时间戳来自 ua_now_ms（索引追加写）⇒ 写入顺序就是时间顺序，最后写的必须排最上
    if !tuis_sess_make(home, ws, "OLD-TITLE 最早的会话" as &const byte, &id_old) {
        tuis_fail(tag, "fixture 会话（最早的）没建成", &ok);
        return ok;
    }
    if !tuis_sess_make(home, ws, "MID-TITLE 中间的会话" as &const byte, &id_mid) {
        tuis_fail(tag, "fixture 会话（中间的）没建成", &ok);
        return ok;
    }
    if !tuis_sess_make(home, ws, "NEW-TITLE 最新的会话" as &const byte, &id_new) {
        tuis_fail(tag, "fixture 会话（最新的）没建成", &ok);
        return ok;
    }

    var c: Config = cfg_default();
    defer { cfg_free(&c); }
    c.sandbox = SAN_OFF;
    c.agent_home = buf_new(96);
    _ = buf_append_cstr(&c.agent_home, home);
    var hs: History = hist_init();
    defer { hist_free(&hs); }
    var cmd: Buf = buf_new(32);
    defer { buf_free(&cmd); }
    _ = buf_append_cstr(&cmd, "/sessions");

    // ---- A) 宽终端（100 列）：三列都看得见，箱体铺到 cols-6 ----
    tuis_reset(100, 30);
    _ = agent_tui_command(&c, &hs, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_SESSIONS {
        tuis_fail(tag, "/sessions 没有开出会话浮层", &ok);
        tui_overlay_close();
        return ok;
    }
    tuis_overlay_frame_check(100, &ok, tag);
    if !tuis_screen_has("会话（enter 恢复 · esc 取消）" as &const byte) {
        tuis_fail(tag, "会话浮层的标题不对", &ok);
    }
    if !tuis_screen_has("NEW-TITLE" as &const byte) || !tuis_screen_has("OLD-TITLE" as &const byte) {
        tuis_fail(tag, "浮层里看不到会话标题（第一列不是标题？）", &ok);
    }
    if !tuis_screen_has("sessions_ws" as &const byte) {
        tuis_fail(tag, "100 列下工作区列不可见（三列没排开？）", &ok);
    }
    var r_new: usize = 0;
    var r_old: usize = 0;
    if tuis_find_row("NEW-TITLE" as &const byte, &r_new) && tuis_find_row("OLD-TITLE" as &const byte, &r_old) {
        // P35：最新的排**最后一行**（紧挨输入面板），最旧的回到第一行
        if r_new <= r_old {
            tuis_fail(tag, "会话列表不是「最新的在最后一行」（P35 的展示序）", &ok);
        }
    } else {
        tuis_fail(tag, "浮层里没同时找到最新与最早的会话", &ok);
    }
    // P35：游标默认必须落在**最后一项**（最新的那个）—— 否则「打开就回车」恢复的是最旧的会话。
    // 游标位置用公开的 sel_index 读（不偷看全局）：条目是 3 条，最后一项下标 = 2。
    if tui_overlay_sel_index() != 2 {
        tuis_fail(tag, "会话浮层的默认游标不在最后一项（最新的那个）上", &ok);
    }
    // 箱体确实铺开了：100 列下箱宽 94（cols-6）、左边距 3 ⇒ 顶边右边界列 = 97
    var txt: Buf = buf_new(65536);
    defer { buf_free(&txt); }
    _ = tui_screen_text(&txt);
    const top: usize = tuis_find_lit_row(txt.ptr as &const byte, txt.len, 0, tui_nrows(), "╭" as &const byte);
    if top >= tui_nrows() {
        tuis_fail(tag, "会话浮层没画出来（找不到顶边）", &ok);
    } else {
        const right: usize = tuis_row_edge_end(txt.ptr as &const byte, txt.len, top);
        if right != 97 {
            tuis_fail(tag, "会话浮层的箱体没有按终端宽度铺开", &ok);
        }
    }
    // 回车：选中项必须是**最新的那个会话**，且取出来的是完整 id（不是标题）
    tui_keys_inject("\r" as &const byte, 1);
    var sel: Buf = buf_new(1024);
    defer { buf_free(&sel); }
    var sid: Buf = buf_new(128);
    defer { buf_free(&sid); }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "回车没有把选中项交出来", &ok);
    } else {
        agent_tui_sessions_head(&sel, &sid);
        // 按长度比较：id_new 是 Buf（不保证 NUL 结尾），bufx_eq_cstr 只收 C 字符串
        if sid.len != id_new.len || !bufx_mem_eq(sid.ptr as &const byte, id_new.ptr as &const byte, id_new.len) {
            tuis_fail(tag, "选中项里取到的不是最新的会话 id（拿标题当 id 了？）", &ok);
        }
        var hz: Buf = buf_new(160);
        defer { buf_free(&hz); }
        _ = buf_append_cstr(&hz, home);
        _ = buf_append_byte(&hz, 0);
        var wz: Buf = buf_new(160);
        defer { buf_free(&wz); }
        _ = buf_append_cstr(&wz, ws);
        _ = buf_append_byte(&wz, 0);
        var path: Buf = buf_new(1200);
        defer { buf_free(&path); }
        if sid.len == 0 || !sess_find(hz.ptr as &const byte, wz.ptr as &const byte, sid.ptr as &const byte, sid.len, &path) {
            tuis_fail(tag, "从浮层取到的 id 恢复不了（/resume <id> 会找不到会话）", &ok);
        }
    }
    tui_overlay_close();

    // ---- B) 窄终端（60 列）：工作区列掉，id 列还在；条目文本里的 id 仍然完整 ----
    tuis_reset(60, 20);
    _ = agent_tui_command(&c, &hs, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_SESSIONS {
        tuis_fail(tag, "60 列下 /sessions 没开出浮层", &ok);
        tui_overlay_close();
        return ok;
    }
    tuis_overlay_frame_check(60, &ok, tag);
    if !tuis_screen_has("session-" as &const byte) {
        tuis_fail(tag, "60 列下会话列表里连 id 列都没了", &ok);
    }
    if tuis_screen_has("sessions_ws" as &const byte) {
        tuis_fail(tag, "60 列下工作区列还在（退化阶梯没生效）", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "60 列下回车没有交回选中项", &ok);
    } else {
        agent_tui_sessions_head(&sel, &sid);
        if sid.len != id_new.len || !bufx_mem_eq(sid.ptr as &const byte, id_new.ptr as &const byte, id_new.len) {
            tuis_fail(tag, "60 列下取到的 id 不完整（条目文本里被裁了？）", &ok);
        }
    }
    tui_overlay_close();
    // 收尾：画布与浮层状态复原，后面的轮次不靠这次留下的东西
    tui_reset_all();
    if ok {
        tuis_ok(tag, "最新的在最后一行 + 默认游标落到最新那条 + 三列（标题/工作区/id）+ 箱体随终端铺开 + 选中项取完整 id + 窄终端退化 + 方框闭合");
    }
    return ok;
}

// ============================================================
// tui-sessions-big（踩坑 68）：大列表浮层的**取行**与**成帧预算**
// ============================================================
// 现场（用户报的「session 选择框显示后很卡」）：`tui_ov_line_at()` 为取第 i 行**从缓冲区
// 第 0 字节重新扫一遍**，而 tui_draw_overlay() 每画一行都要从第 0 项数到目标项 ——
// 画一屏于是是 O(可见行数 × n²) 字节步。真机 842 个会话、底部按一次 ↑ 实测 1.2–1.6 s
// （顶上只要 85 ms：要跨的项少 —— 这一对数字就是根因的判据）。
//
// 修法：条目缓冲区每次重写时**一次性**建出行偏移表（O(n)），取行变 O(1)；过滤器为空时
// 「第 fi 个通过过滤的项」直接就是第 fi 项，连数一遍都不用。
//
// 这一轮盯三件事（都绕开索引层，直接喂条目给浮层，单测浮层本身）：
//   1) 行偏移表正确：第 0 / 中间 / 末项的字节区间与预期的条目文本逐字节相同；
//   2) 浮层语义没变：g_tui_ov_n、默认游标、home/end、↑/↓ 之后选中项与窗口自洽；
//   3) 成帧预算：2000 项时「一帧 + 若干次方向键」必须在 1 s 内完成（未修版本这里 ~7 s）。

const TUIS_SESSBIG_N: usize = 2000;
const TUIS_SESSBIG_FRAME_MAX_MS: u64 = 1000;   // 2000 项一次成帧 + 按键的墙钟上限

// 造 n 条条目（每行「TITLE <k> | /w/<k> | session-<8 位十六进制>-...」），写进 out
fn tuis_sessbig_items(n: usize, out: &Buf) void {
    buf_reset(out);
    var i: usize = 0;
    while i < n {
        _ = buf_append_cstr(out, "TITLE ");
        _ = buf_append_u64(out, i as u64);
        _ = buf_append_cstr(out, "   /w/");
        _ = buf_append_u64(out, i as u64);
        _ = buf_append_cstr(out, "   session-");
        var hex: Buf = buf_new(32);
        defer { buf_free(&hex); }
        _ = buf_append_u64(&hex, i as u64);
        var pad: usize = hex.len;
        while pad < 8 {
            _ = buf_append_byte(out, 48);   // '0'
            pad = pad + 1;
        }
        _ = buf_append(out, hex.ptr, hex.len);
        _ = buf_append_cstr(out, "-1111-4111-8111-111111111111\n");
        i = i + 1;
    }
}

// 第 k 条条目的预期文本（与 tuis_sessbig_items 同一份拼法），用于比对区间
fn tuis_sessbig_expect(k: usize, out: &Buf) void {
    var hex: Buf = buf_new(32);
    defer { buf_free(&hex); }
    _ = buf_append_u64(&hex, k as u64);
    var pad: usize = hex.len;
    buf_reset(out);
    _ = buf_append_cstr(out, "TITLE ");
    _ = buf_append_u64(out, k as u64);
    _ = buf_append_cstr(out, "   /w/");
    _ = buf_append_u64(out, k as u64);
    _ = buf_append_cstr(out, "   session-");
    while pad < 8 {
        _ = buf_append_byte(out, 48);
        pad = pad + 1;
    }
    _ = buf_append(out, hex.ptr, hex.len);
    _ = buf_append_cstr(out, "-1111-4111-8111-111111111111");
}

// 取浮层第 i 项并与预期比对（返回 false = 不一致，why 里写明原因）
fn tuis_sessbig_check_item(i: usize, why: &Buf) bool {
    var o: usize = 0;
    var l: usize = 0;
    if !tui_overlay_item_span(i, &o, &l) {
        buf_reset(why);
        _ = buf_append_cstr(why, "取不到第 ");
        _ = buf_append_u64(why, i as u64);
        _ = buf_append_cstr(why, " 项");
        return false;
    }
    var want: Buf = buf_new(128);
    defer { buf_free(&want); }
    tuis_sessbig_expect(i, &want);
    var got: Buf = buf_new(128);
    defer { buf_free(&got); }
    _ = buf_append(&got, tui_overlay_item_ptr() + o, l);
    if got.len != want.len {
        buf_reset(why);
        _ = buf_append_cstr(why, "第 ");
        _ = buf_append_u64(why, i as u64);
        _ = buf_append_cstr(why, " 项长度不对");
        return false;
    }
    if !bufx_mem_eq(got.ptr as &const byte, want.ptr as &const byte, want.len) {
        buf_reset(why);
        _ = buf_append_cstr(why, "第 ");
        _ = buf_append_u64(why, i as u64);
        _ = buf_append_cstr(why, " 项文本不对（行偏移表算错了？）");
        return false;
    }
    return true;
}

fn tui_sessions_big_round(tag: &const byte) bool {
    var ok: bool = true;
    var items: Buf = buf_new(1 << 20);
    defer { buf_free(&items); }
    tuis_sessbig_items(TUIS_SESSBIG_N, &items);

    tuis_reset(100, 30);
    tui_reset_all();
    tuis_reset(100, 30);      // tui_reset_all 会清浮层状态，尺寸再钉一次
    tui_overlay_list_wide(TUI_OVK_SESSIONS, "big" as &const byte, bufx_cstr_len("big" as &const byte),
        items.ptr as &const byte, items.len, 0);

    // ---- 1) 项数 + 默认游标（列表型默认停在 0；/sessions 那条腿才置到最后一项）----
    if tui_overlay_item_count() != TUIS_SESSBIG_N {
        tuis_fail(tag, "浮层条目数与喂进去的不一致", &ok);
        tuis_puts("  实际 = ");
        tuis_num(tui_overlay_item_count());
        tuis_puts("\n");
    }

    // ---- 2) 行区间：第 0 / 中间 / 末项逐字节比对 ----
    var why: Buf = buf_new(160);
    defer { buf_free(&why); }
    const probes: [usize: 3] = [0, TUIS_SESSBIG_N / 2, TUIS_SESSBIG_N - 1];
    var pi: usize = 0;
    while pi < 3 {
        if !tuis_sessbig_check_item(probes[pi], &why) {
            tuis_fail(tag, "大列表取行不对", &ok);
            tuis_puts("  ");
            tuis_puts(why.ptr as &const byte);
            tuis_puts("\n");
        }
        pi = pi + 1;
    }

    // ---- 3) 键盘语义：end 到末项、home 回 0、↑/↓ 各走一步，选中项文本跟着对 ----
    tui_keys_inject("\x1b[F" as &const byte, 3);    // end
    if tui_overlay_sel_index() != TUIS_SESSBIG_N - 1 {
        tuis_fail(tag, "end 之后游标不在末项", &ok);
    }
    tui_keys_inject("\x1b[H" as &const byte, 3);    // home
    if tui_overlay_sel_index() != 0 {
        tuis_fail(tag, "home 之后游标不在首项", &ok);
    }
    tui_keys_inject("\x1b[B" as &const byte, 3);    // ↓
    if tui_overlay_sel_index() != 1 {
        tuis_fail(tag, "↓ 之后游标不在第 2 项", &ok);
    }
    tui_keys_inject("\x1b[A" as &const byte, 3);    // ↑
    if tui_overlay_sel_index() != 0 {
        tuis_fail(tag, "↑ 之后游标没回到首项", &ok);
    }
    // 游标拨到中间：选中项取出来的文本必须是**中间那条**（守卫一并验过）
    tui_overlay_sel_set(TUIS_SESSBIG_N / 2);
    if tui_overlay_sel_index() != TUIS_SESSBIG_N / 2 {
        tuis_fail(tag, "sel_set 没有把游标放到中间项", &ok);
    }
    if !tuis_sessbig_check_item(TUIS_SESSBIG_N / 2, &why) {
        tuis_fail(tag, "中间项文本不对", &ok);
        tuis_puts("  ");
        tuis_puts(why.ptr as &const byte);
        tuis_puts("\n");
    }

    // ---- 4) 成帧预算：游标钉在末项（= 旧实现最坏情况，要跨 n 项），量一帧 + 若干按键 ----
    // 钉到末项：旧实现每画一行都要从第 0 项数到 fi。这里盯的是**画一屏不再随 n 变慢**。
    // ⚠ 这个预算单独看**抓不住**「取行退回线性扫描」：过滤器为空时序号就是项号，
    // 一屏只取十几行、每行扫一遍缓冲区，2000 项也就百来微秒。要钉「取行是不是 O(1)」
    // 得看下面第 5 条（reader）与第 6 条（行偏移表是否真的建起来了）。
    tui_overlay_sel_set(TUIS_SESSBIG_N - 1);
    const t0: u64 = ua_now_ms();
    tui_build();                                  // 一帧
    var f: i32 = 0;
    while f < 5 {
        tui_keys_inject("\x1b[A" as &const byte, 3);   // 上移 5 次，每次都重画一帧
        tui_build();
        f = f + 1;
    }
    const dt: u64 = ua_now_ms() - t0;
    if dt > TUIS_SESSBIG_FRAME_MAX_MS {
        tuis_fail(tag, "大列表成帧太慢", &ok);
        tuis_puts("  实测 ms = ");
        tuis_num(dt as usize);
        tuis_puts("  上限 = ");
        tuis_num(TUIS_SESSBIG_FRAME_MAX_MS as usize);
        tuis_puts("\n");
    }
    // 成帧本身的不变量：正文层不能出 ESC / NUL（偏移表算错最容易在这里翻车）
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("TITLE" as &const byte) {
        tuis_fail(tag, "大列表成帧之后屏幕上一条条目都看不到", &ok);
    }
    // ---- 4b) 行偏移表：差分对照 + 规模不变量 ----
    // (a) 表真的建起来了，且行数与条目数一致；
    // (b) **差分对照**：同一个 i，查表路径与老实现（线性扫描）给出的区间逐字节相同。
    //     只验结果的话，「表没被用上」（退回扫描）也会绿 —— 这一条把两条路径摆在一起比。
    if !tui_overlay_items_indexed() {
        tuis_fail(tag, "条目行偏移表没有建起来（取行会退回线性扫描）", &ok);
    }
    var ix_bad: bool = false;
    var ix_probe: [usize: 5] = [0, 1, TUIS_SESSBIG_N / 2, TUIS_SESSBIG_N - 2, TUIS_SESSBIG_N - 1];
    var ip: usize = 0;
    while ip < 5 {
        const k: usize = ix_probe[ip];
        var o1: usize = 0;
        var l1: usize = 0;
        var o2: usize = 0;
        var l2: usize = 0;
        const have1: bool = tui_overlay_item_span(k, &o1, &l1);
        const have2: bool = tui_overlay_lin_span(k, &o2, &l2);
        if have1 != have2 || o1 != o2 || l1 != l2 {
            ix_bad = true;
        }
        ip = ip + 1;
    }
    if ix_bad {
        tuis_fail(tag, "行偏移表与线性扫描给出的区间不一致（表算错了）", &ok);
    }
    // (c) 规模不变量：同一台机器上，取第 0 项与取第 n-1 项各 2000 次，两者的总耗时不
    //     该有数量级差别 —— 查表是 O(1)，线性扫描则是 O(n)（末项要扫完整份缓冲区）。
    // (c) 规模不变量：**自校准**对比「查表路径 vs 线性扫描路径」在**末项**上的耗时。
    //     末项是两者的分水岭：查表 O(1)（一次减法），线性扫描要把整份缓冲区扫一遍（O(n)）。
    //     同一台机器、同一份缓冲区、同一个 i，比值就是「取行是不是 O(1)」的直接证据，
    //     不依赖绝对时间（跨机器稳）。为了压过时钟粒度，两个循环各跑到 ≥40 ms 再比。
    //     前一条 (b) 已经证明两条路径**结果相同**，所以这里放心的只看时间。
    const rounds: usize = 20000;
    var sink: usize = 0;
    var rp: usize = 0;
    const t_idx0: u64 = ua_now_ms();
    while rp < rounds {
        var oo: usize = 0;
        var ll: usize = 0;
        if tui_overlay_item_span(TUIS_SESSBIG_N - 1, &oo, &ll) {
            sink = sink + oo + ll;
        }
        rp = rp + 1;
    }
    const dt_idx: u64 = ua_now_ms() - t_idx0;
    const t_scan0: u64 = ua_now_ms();
    rp = 0;
    while rp < rounds {
        var oo: usize = 0;
        var ll: usize = 0;
        if tui_overlay_lin_span(TUIS_SESSBIG_N - 1, &oo, &ll) {
            sink = sink + oo + ll;
        }
        rp = rp + 1;
    }
    const dt_scan: u64 = ua_now_ms() - t_scan0;
    if sink == 123456789 {
        tuis_puts("   ");   // 防优化：sink 参与判断
    }
    tuis_puts("selftest[");
    tuis_puts(tag);
    tuis_puts("] 取末项 ");
    tuis_num(rounds);
    tuis_puts(" 次：查表 ms = ");
    tuis_num(dt_idx as usize);
    tuis_puts(" / 线性扫描 ms = ");
    tuis_num(dt_scan as usize);
    tuis_puts("\n");
    // 修好的实现：查表那一路应该比线性扫描快一个数量级（n=2000）；留 4 倍余量。
    // 若「取行被退回线性扫描」，两条腿都会是线性扫描 ⇒ 比值 ≈ 1 ⇒ 当场红。
    if dt_scan >= 4 && dt_scan < dt_idx * 4 {
        tuis_fail(tag, "取末项时查表没有明显快过线性扫描（取行不是 O(1)？）", &ok);
        tuis_puts("  查表 ms = ");
        tuis_num(dt_idx as usize);
        tuis_puts("  扫描 ms = ");
        tuis_num(dt_scan as usize);
        tuis_puts("\n");
    }

    // ---- 5) reader 型浮层（计划审阅）的成帧预算 ----
    // 列表型有「过滤器为空 ⇒ 序号就是项号」这条快路径兜着，reader 型没有：它按行号逐行取
    // 折行后的正文（tui_ov_row_at），每一行都真的走一次取行。这里把正文拉到上限
    // （TUI_OV_BODY_MAX = 128 KiB），滚到底（End 会把 body_top 推到最大）再各画一帧。
    //
    // ⚠ 这条是**冒烟**，不是「取行 O(1)」的判据：reader 每帧开头还有一段
    // `while k < body_top` 复原代码围栏、折行结果又在上限内（几千行），所以把取行退回
    // 线性扫描在这条预算上**照样绿**（本轮实测）。真正钉住 O(1) 的是上面 4b。
    var body: Buf = buf_new(1 << 20);
    defer { buf_free(&body); }
    var li: usize = 0;
    while li < 12000 {
        _ = buf_append_cstr(&body, "折行后的正文行 ");
        _ = buf_append_u64(&body, li as u64);
        _ = buf_append_cstr(&body, "：这一行要够长才值得折一次，所以这里再补一些中文字符把整行宽度凑满。\n");
        li = li + 1;
    }
    tuis_reset(100, 30);
    tui_reset_all();
    tuis_reset(100, 30);
    var acts: Buf = buf_new(64);
    defer { buf_free(&acts); }
    _ = buf_append_cstr(&acts, "继续讨论\n解决\n确认执行\n");
    tui_overlay_reader(TUI_OVK_PLAN, "计划" as &const byte, bufx_cstr_len("计划" as &const byte),
        body.ptr as &const byte, body.len, acts.ptr as &const byte, acts.len, 0);
    const rt0: u64 = ua_now_ms();
    tui_build();                                    // 第一帧：折行 + 从头画
    tui_keys_inject("\x1b[F" as &const byte, 3);    // End：滚到底（body_top 顶到最大）
    tui_build();
    tui_keys_inject("\x1b[6~" as &const byte, 4);   // PgUp 翻一页
    tui_build();
    const rdt: u64 = ua_now_ms() - rt0;
    if rdt > TUIS_SESSBIG_FRAME_MAX_MS {
        tuis_fail(tag, "reader 浮层成帧太慢", &ok);
        tuis_puts("  实测 ms = ");
        tuis_num(rdt as usize);
        tuis_puts("  上限 = ");
        tuis_num(TUIS_SESSBIG_FRAME_MAX_MS as usize);
        tuis_puts("\n");
    }
    if !tuis_screen_has("折行后的正文行" as &const byte) {
        tuis_fail(tag, "reader 浮层成帧之后屏幕上看不到正文", &ok);
    }

    tui_overlay_close();
    tui_reset_all();
    if ok {
        tuis_ok(tag, "2000 项：取行 O(1) 且第 0/中/末项逐字节正确 + 键盘语义自洽 + 列表与 reader 成帧均 < 1 s + 正文层无 ESC/NUL");
    }
    return ok;
}

// ============================================================
// tui-switch（P39）：**运行时换会话** —— 旧会话的正文必须从屏幕上消失
// ============================================================
// 三条腿：
//   A) `/new`：屏幕上先有旧会话的正文 → 敲 /new → 旧正文一个字节不剩、只剩新会话的回执，
//      而**面板/脚注（模型、cwd、分支）还在** —— 这正是「清转录」与「自测复位」的分界：
//      拿 tui_reset_all() 顶替的话，会话还在跑、界面却先残了（脚注与状态区全空）。
//   B) `/resume`：真会话日志（走真实的 sess_open/sess_begin/sess_end/sess_close，带两条真事件）
//      → 敲 /resume <id> → 旧正文消失、**被恢复会话的正文回放出来**（user 与 assistant 都在）、
//      回执排在回放内容**之后**（顺序反了就是「先清后写」写成了「先写后清」）。
//   C) 滚动模式（`tui_active()` 为假）：同一套调用**一个字节都不清** —— 那边的正文是终端
//      自己滚出去的，抹掉等于把用户刚看过的内容删了。

// 造一份**带正文**的真会话（真落盘 + 真索引；标题由调用方给，这里只要正文）
fn tuis_switch_make_sess(home: &const byte, ws: &const byte, out_id: &Buf) bool {
    var log: SessionLog = sess_log_empty();
    defer { sess_log_free(&log); }
    if !sess_open(&log, home, ws, "selftest-model" as &const byte, "uya-agent" as &const byte, "" as &const byte, true, 0 as i64, true) {
        return false;
    }
    var ev: Buf = buf_new(1024);
    defer { buf_free(&ev); }
    if !sess_begin(&log, "user/message" as &const byte, &ev) {
        return false;
    }
    _ = buf_append_cstr(&ev, "{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":\"TUIS-RESUMED-USER 被恢复会话的用户话\"}],\"source\":{\"kind\":\"user\"}}");
    _ = sess_end(&log, &ev);
    if !sess_begin(&log, "assistant/message" as &const byte, &ev) {
        return false;
    }
    _ = buf_append_cstr(&ev, "{\"turn\":0,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":\"TUIS-RESUMED-BOT 被恢复会话的回答\"},\"usage\":{\"inputTokens\":0,\"outputTokens\":0}}");
    _ = sess_end(&log, &ev);
    buf_reset(out_id);
    _ = buf_append(out_id, log.id.ptr, log.id.len);
    sess_close(&log, home);
    return out_id.len > 0;
}

// 造一份夹具 home：目录建好 + 索引清掉（同一个 home 可能被上一轮用过）
fn tuis_switch_home_ready(home: &const byte) void {
    _ = sess_mkdir_p(home);
    var ipath: Buf = buf_new(160);
    defer { buf_free(&ipath); }
    _ = buf_append_cstr(&ipath, home);
    _ = buf_append_cstr_z(&ipath, "/index.jsonl");
    _ = sys_unlink(ipath.ptr as *const byte) catch {};
}

fn tui_switch_round(tag: &const byte) bool {
    var ok: bool = true;
    // 夹具挂在**当前工作区**（绝对路径）：/resume 会按会话记录的工作区去 chdir，
    // 记成同一个目录就落在「幂等」那条分支上，本轮不会把进程 cwd 搬走。
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        tuis_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    defer { wst_back(&root); }
    const home: &const byte = "build/selftest_tui_switch" as &const byte;
    tuis_switch_home_ready(home);
    var id_res: Buf = buf_new(64);
    defer { buf_free(&id_res); }
    // `sess_open` 的 cwd 是 **C 字符串**（NUL 结尾）：Buf.ptr 没有尾 NUL，
    // 直接传会把堆里紧邻的字节也算进路径（README 踩坑 57），这里补一个 NUL 再传。
    var rootz: Buf = buf_new(root.len + 1);
    defer { buf_free(&rootz); }
    _ = buf_append(&rootz, root.ptr as &const byte, root.len);
    _ = buf_append_byte(&rootz, 0);
    if !tuis_switch_make_sess(home, rootz.ptr as &const byte, &id_res) {
        tuis_fail(tag, "夹具会话（带正文）没建成", &ok);
        return ok;
    }

    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("selftest-model");
    cfg.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&cfg);
    cfg.agent_home = buf_new(96);
    _ = buf_append_cstr(&cfg.agent_home, home);
    var h: History = hist_init();
    defer { hist_free(&h); }
    var cmd: Buf = buf_new(96);
    defer { buf_free(&cmd); }
    // 脚注三件套（模型 / cwd / 分支）：换会话**不许**把它们端掉，A 段专门钉这条
    const footer_model: &const byte = "deepseek-chat" as &const byte;
    const footer_cwd: &const byte = "/home/tester/proj" as &const byte;
    const footer_home: &const byte = "/home/tester" as &const byte;
    const footer_branch: &const byte = "main" as &const byte;

    // ---- A) /new：旧正文消失，脚注与面板还在 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);   // 逻辑上「TUI 在跑」（tui_active() 为真），但不碰终端
    tty_sink_on = true;          // 显示字节进转录（真 TUI 里这一步由 agent_tui_start 打开）
    tui_state_init(footer_model, bufx_cstr_len(footer_model), "deepseek" as &const byte, 8,
        "test" as &const byte, 4);
    tui_set_cwd(footer_cwd, bufx_cstr_len(footer_cwd), footer_home, bufx_cstr_len(footer_home));
    tui_set_branch(footer_branch, 4);
    tui_add_user("TUIS-OLD-USER 旧会话的正文" as &const byte, bufx_cstr_len("TUIS-OLD-USER 旧会话的正文" as &const byte));
    tui_build();
    if !tuis_screen_has("TUIS-OLD-USER" as &const byte) {
        tuis_fail(tag, "铺进去的旧正文没出现在屏幕上（夹具本身不对）", &ok);
    }
    buf_reset(&cmd);
    _ = buf_append_cstr(&cmd, "/new");
    _ = agent_tui_command(&cfg, &h, &cmd);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tuis_screen_has("TUIS-OLD-USER" as &const byte) {
        tuis_fail(tag, "/new 之后旧会话的正文还挂在屏幕上", &ok);
    }
    if !tuis_screen_has("已开新会话" as &const byte) {
        tuis_fail(tag, "/new 的回执没出现在屏幕上", &ok);
    }
    if !tuis_screen_has(footer_model) || !tuis_screen_has("proj" as &const byte) || !tuis_screen_has(footer_branch) {
        tuis_fail(tag, "换会话把面板/脚注一起端了（那是自测复位的口径）", &ok);
    }

    // ---- B) /resume：旧正文消失 + 被恢复会话的正文回放 + 回执在最后 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);
    tty_sink_on = true;
    tui_state_init(footer_model, bufx_cstr_len(footer_model), "deepseek" as &const byte, 8,
        "test" as &const byte, 4);
    tui_set_cwd(footer_cwd, bufx_cstr_len(footer_cwd), footer_home, bufx_cstr_len(footer_home));
    tui_set_branch(footer_branch, 4);
    tui_add_user("TUIS-OLD-USER 旧会话的正文" as &const byte, bufx_cstr_len("TUIS-OLD-USER 旧会话的正文" as &const byte));
    tui_build();
    if !tuis_screen_has("TUIS-OLD-USER" as &const byte) {
        tuis_fail(tag, "B 段的旧正文没铺上（夹具本身不对）", &ok);
    }
    buf_reset(&cmd);
    _ = buf_append_cstr(&cmd, "/resume ");
    _ = buf_append(&cmd, id_res.ptr, id_res.len);
    _ = agent_tui_command(&cfg, &h, &cmd);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tuis_screen_has("TUIS-OLD-USER" as &const byte) {
        tuis_fail(tag, "/resume 之后旧会话的正文还挂在屏幕上", &ok);
    }
    if !tuis_screen_has("TUIS-RESUMED-USER" as &const byte) {
        tuis_fail(tag, "/resume 之后被恢复会话的用户话没回放出来", &ok);
    }
    if !tuis_screen_has("TUIS-RESUMED-BOT" as &const byte) {
        tuis_fail(tag, "/resume 之后被恢复会话的回答没回放出来", &ok);
    }
    if !tuis_screen_has("已恢复会话" as &const byte) {
        tuis_fail(tag, "/resume 的回执没出现在屏幕上", &ok);
    }
    var r_bot: usize = 0;
    var r_rec: usize = 0;
    if tuis_find_row("TUIS-RESUMED-BOT" as &const byte, &r_bot) && tuis_find_row("已恢复会话" as &const byte, &r_rec) {
        // 先清、再回放、最后打回执 —— 顺序反了这条就红（顺序 = 「谁把谁清掉」）
        if r_rec <= r_bot {
            tuis_fail(tag, "/resume 的回执不在回放内容之后（清/回放的顺序反了）", &ok);
        }
    } else {
        tuis_fail(tag, "屏幕上没同时找到回放内容与回执", &ok);
    }
    if !tuis_screen_has(footer_model) || !tuis_screen_has("proj" as &const byte) {
        tuis_fail(tag, "/resume 把面板/脚注一起端了", &ok);
    }

    // ---- C) 滚动模式（tui_active() 为假）：一个字节都不清 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);
    tty_sink_on = true;
    tui_add_user("TUIS-SCROLL-USER 滚动模式的正文" as &const byte, bufx_cstr_len("TUIS-SCROLL-USER 滚动模式的正文" as &const byte));
    tui_build();
    // 注意用 tui_headless_enable(false)（它同时把 g_tui_on 关掉 = tui_active() 为假）；
    // tui_set_headless(false) 只动「headless」这个标志，tui_active() 还是真。
    tui_headless_enable(false);
    var replay_h: History = hist_init();
    defer { hist_free(&replay_h); }
    _ = hist_push(&replay_h, ROLE_USER, "TUIS-SCROLL-REPLAY 不该被回放" as &const byte,
        bufx_cstr_len("TUIS-SCROLL-REPLAY 不该被回放" as &const byte));
    agent_tui_session_switched(&replay_h, true);
    tui_headless_enable(true);
    tui_set_size(100, 30);
    tui_build();
    if !tuis_screen_has("TUIS-SCROLL-USER" as &const byte) {
        tuis_fail(tag, "滚动模式下换会话把转录清了（那会把用户刚看过的内容删掉）", &ok);
    }
    if tuis_screen_has("TUIS-SCROLL-REPLAY" as &const byte) {
        tuis_fail(tag, "滚动模式下还回放了历史（滚动模式不该碰转录）", &ok);
    }

    // ---- D) 清单是**会话级**状态：/new 之后清单清空，会话目标不跟着清 ----
    // （用户报的：敲 /new 开了新会话，常驻任务块与 /tasks 里还挂着上一条会话的清单。
    //   判据必须**同时**钉住两件事 —— 清掉的（清单）与**不该**被清掉的（目标）：
    //   只钉前者的话，把「换会话」写成「整个任务状态复位」也照样绿。）
    tuis_reset(100, 30);
    view_init(true, 0);           // 这一轮直接建帧，不跑 agent：显示层要自己打开
    tui_headless_enable(true);
    tty_sink_on = true;
    tui_state_init(footer_model, bufx_cstr_len(footer_model), "deepseek" as &const byte, 8,
        "test" as &const byte, 4);
    // 任务块只画在 **chat 布局**里（home 布局没有它的位置）：先铺一条正文
    tui_add_user("TUIS-NEW-USER 换会话前的正文" as &const byte,
        bufx_cstr_len("TUIS-NEW-USER 换会话前的正文" as &const byte));
    agent_tasks_fixture_demo();   // 真实 globals：清单 2/4 + 后台 1/2 + 子代理 1/1 + 目标 3/20
    _ = tasks_panel_sync();
    tui_build();
    if !tuis_screen_has("任务 2/4" as &const byte) {
        tuis_fail(tag, "D 段的任务夹具没铺进常驻块（夹具本身不对）", &ok);
    }
    buf_reset(&cmd);
    _ = buf_append_cstr(&cmd, "/new");
    _ = agent_tui_command(&cfg, &h, &cmd);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if g_todos.n != 0 {
        tuis_fail(tag, "/new 之后 todo 清单没清空（还留着上一条会话的清单）", &ok);
    }
    if tuis_screen_has("任务 2/4" as &const byte) {
        tuis_fail(tag, "/new 之后任务块里还挂着上一条会话的清单", &ok);
    }
    if !tuis_screen_has("目标 3/20" as &const byte) {
        tuis_fail(tag, "/new 把会话目标也清了（目标在盘上，按设计跨会话）", &ok);
    }

    // 同一条口径也要罩住 /resume：清单是**当前会话**的，恢复出来的会话日志里没有清单，
    // 屏幕上就不该还挂着切换之前那一份。
    agent_tasks_fixture_demo();
    _ = tasks_panel_sync();
    tui_build();
    if !tuis_screen_has("任务 2/4" as &const byte) {
        tuis_fail(tag, "D 段第二次装夹具没铺进常驻块", &ok);
    }
    buf_reset(&cmd);
    _ = buf_append_cstr(&cmd, "/resume ");
    _ = buf_append(&cmd, id_res.ptr, id_res.len);
    _ = agent_tui_command(&cfg, &h, &cmd);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if g_todos.n != 0 {
        tuis_fail(tag, "/resume 之后 todo 清单没清空（那是上一条会话的清单）", &ok);
    }
    if tuis_screen_has("任务 2/4" as &const byte) {
        tuis_fail(tag, "/resume 之后任务块里还挂着切换之前的清单", &ok);
    }

    // 收尾：画布/显示收口复位，后面的轮次不靠这次留下的东西（夹具也是）
    tty_sink_on = false;
    tui_set_headless(true);
    tui_reset_all();
    tuis_tasks_clear();
    if ok {
        tuis_ok(tag, "/new 清掉旧正文且脚注还在 + /resume 清掉旧正文并回放被恢复会话（回执在最后）+ 滚动模式一个字节不动 + /new 与 /resume 清空清单但留住目标");
    }
    return ok;
}

// ============================================================
// tui-caret（修复，踩坑 66）：运行中输入行的光标
//
// 症状：回合运行中在输入行敲字（steer；`ask_user_question` 更是直接用输入行等回答）
// 时，屏幕上**没有光标** —— 明明能打字却看不到插入点。
// 根因：`tui_cursor_place()` 把可见性绑在运行状态上（`run == IDLE` 才显示），
// 而 `tui_flush()` 对不可见的帧每帧补一个 `ESC[?25l`。
// 口径：可见性**只跟浮层走** —— 空闲或没有浮层 = 显示；只有「运行中且浮层开着」才隐藏
// （浮层开着时键全被它吃掉，插入点不在输入行上）。
//
// 两条腿：① 标志位（`tui_caret_visible`）；② **字节级**（真刷一帧进 pipe，数
// `?25h` / `?25l`）—— 只信标志位的话，把 `tui_flush` 那段改坏了照样绿。
// ============================================================

// 把 pipe 里现有的字节全读出来（非阻塞：poll 说没数据就收工）
fn tuis_pipe_drain(rfd: i32, out: &Buf) void {
    var tmp: [byte: 4096] = [0: 4096];
    var guard: i32 = 0;
    while guard < 64 {
        guard = guard + 1;
        var pfds: [PollFd: 1] = [PollFd{ fd: rfd, events: POLLIN, revents: 0 }];
        const pr: i32 = sys_poll(&pfds[0], 1, 20) catch { 0; };
        if pr <= 0 {
            return;
        }
        const n: isize = sys_read(rfd, &tmp[0], 4096) catch { -1 as isize; };
        if n <= 0 {
            return;
        }
        _ = buf_append(out, &tmp[0], n as usize);
    }
}

// 真刷一帧到 pipe 并把字节收进 cap（调用方负责数 `?25h` / `?25l`）
fn tuis_caret_frame(rfd: i32, cap: &Buf) void {
    buf_reset(cap);
    tui_invalidate();
    tui_render();
    tuis_pipe_drain(rfd, cap);
}

fn tui_caret_round(tag: &const byte) bool {
    var ok: bool = true;
    tuis_reset(100, 30);
    tui_input_set("运行中也要有光标" as &const byte,
        bufx_cstr_len("运行中也要有光标" as &const byte));

    // ---- A) 标志位：运行中（无浮层）**必须有**光标 —— 这就是本次修的回归 ----
    tui_overlay_close();
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "运行中（思考中）输入行的光标被藏了（本次修的回归）", &ok);
    }
    tui_set_run(TUI_RUN_STREAM, "" as &const byte, 0);
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "运行中（输出中）输入行的光标被藏了", &ok);
    }
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "运行中（跑工具）输入行的光标被藏了（ask_user_question 就在这个状态下等回答）", &ok);
    }

    // ---- B) 空闲：照旧显示（这一格修前修后一致，钉住没被改坏）----
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "空闲时输入行反而没有光标", &ok);
    }

    // ---- C) 运行中 + 浮层：仍隐藏（不变式）----
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6,
        "一行\n" as &const byte, bufx_cstr_len("一行\n" as &const byte));
    tui_build();
    if tui_caret_visible() {
        tuis_fail(tag, "运行中浮层开着还露光标（键都被浮层吃了，插入点不在输入行上）", &ok);
    }

    // ---- D) 空闲 + 浮层：显示（这一格同样不许被顺手改掉）----
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    tui_build();
    if !tui_caret_visible() {
        tuis_fail(tag, "空闲且浮层开着时没有光标", &ok);
    }
    tui_overlay_close();
    tui_set_size(100, 30);

    // ---- E) 字节级：真刷一帧进 pipe，数 `?25h` / `?25l` ----
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "pipe2 失败（字节级那条腿没跑成）", &ok);
        tui_reset_all();
        return ok;
    }
    tui_term_enter(fds[1]);
    var cap: Buf = buf_new(65536);
    defer { buf_free(&cap); }

    // E1) 运行中（无浮层）：恰好一个 `?25h`、零个 `?25l`
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    tui_overlay_close();
    tuis_caret_frame(fds[0], &cap);
    const e1_show: usize = tuis_count(&cap, "\x1b[?25h" as &const byte);
    const e1_hide: usize = tuis_count(&cap, "\x1b[?25l" as &const byte);
    if e1_hide != 0 || e1_show != 1 {
        tuis_fail(tag, "运行中那一帧没有显示光标（字节级：期望 1×?25h / 0×?25l）", &ok);
        tuis_puts("  e1 show=");
        tuis_num(e1_show);
        tuis_puts(" hide=");
        tuis_num(e1_hide);
        tuis_puts("\n");
    }

    // E2) 运行中 + 浮层：有 `?25l`、零个 `?25h`
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6,
        "一行\n" as &const byte, bufx_cstr_len("一行\n" as &const byte));
    tuis_caret_frame(fds[0], &cap);
    const e2_show: usize = tuis_count(&cap, "\x1b[?25h" as &const byte);
    const e2_hide: usize = tuis_count(&cap, "\x1b[?25l" as &const byte);
    if e2_hide != 1 || e2_show != 0 {
        tuis_fail(tag, "运行中开浮层那一帧没有藏光标（字节级：期望 1×?25l / 0×?25h）", &ok);
        tuis_puts("  e2 show=");
        tuis_num(e2_show);
        tuis_puts(" hide=");
        tuis_num(e2_hide);
        tuis_puts("\n");
    }

    // E3) 空闲（无浮层）：显示
    tui_overlay_close();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    tuis_caret_frame(fds[0], &cap);
    const e3_show: usize = tuis_count(&cap, "\x1b[?25h" as &const byte);
    const e3_hide: usize = tuis_count(&cap, "\x1b[?25l" as &const byte);
    if e3_hide != 0 || e3_show != 1 {
        tuis_fail(tag, "空闲那一帧没有显示光标（字节级）", &ok);
    }

    // 收尾：先把 TUI 收回 headless（out_fd 归位），再关 pipe 两端
    tui_overlay_close();
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    _ = sys_close(fds[1]) catch {};
    _ = sys_close(fds[0]) catch {};

    if ok {
        tuis_ok(tag, "运行中输入行有光标（思考/输出/工具三态 + 字节级 ?25h）+ 空闲与浮层两格不变 + 运行中开浮层仍隐藏");
    }
    return ok;
}

export fn tui_selftest_all() bool {
    var ok: bool = true;
    if !tui_frame_round("tui-frame" as &const byte) {
        ok = false;
    }
    if !tui_access_round("tui-access" as &const byte) {
        ok = false;
    }
    if !tui_approve_round("tui-approve" as &const byte) {
        ok = false;
    }
    if !tui_plan_round("tui-plan" as &const byte) {
        ok = false;
    }
    if !tui_ask_round("tui-ask" as &const byte) {
        ok = false;
    }
    if !tuis_ti_round("tui-title-input" as &const byte) {
        ok = false;
    }
    if !tui_keys_round("tui-keys" as &const byte) {
        ok = false;
    }
    if !tui_sink_round("tui-sink" as &const byte) {
        ok = false;
    }
    if !tui_turn_round("tui-turn" as &const byte) {
        ok = false;
    }
    if !tui_status_round("tui-status" as &const byte) {
        ok = false;
    }
    if !tui_caret_round("tui-caret" as &const byte) {
        ok = false;
    }
    if !tui_cmd_round("tui-cmd" as &const byte) {
        ok = false;
    }
    if !tui_scroll_round("tui-scroll" as &const byte) {
        ok = false;
    }
    if !tui_exit_round("tui-exit" as &const byte) {
        ok = false;
    }
    if !tui_quit_round("tui-quit" as &const byte) {
        ok = false;
    }
    if !tui_p30_round("tui-p30" as &const byte) {
        ok = false;
    }
    if !tui_p31_round("tui-p31" as &const byte) {
        ok = false;
    }
    if !tui_sessions_round("tui-sessions" as &const byte) {
        ok = false;
    }
    if !tui_sessions_big_round("tui-sessions-big" as &const byte) {
        ok = false;
    }
    if !tui_switch_round("tui-switch" as &const byte) {
        ok = false;
    }
    if !tui_ws_round("tui-ws" as &const byte) {
        ok = false;
    }
    if !tui_pty_round("tui-pty" as &const byte) {
        ok = false;
    }
    if !tty_title_pty_round("tty-title-pty" as &const byte) {
        ok = false;
    }
    if !tui_diag_round("tui-diag" as &const byte) {
        ok = false;
    }
    if !tui_tasks_round("tui-tasks" as &const byte) {
        ok = false;
    }
    if !tui_diff_round("tui-diff" as &const byte) {
        ok = false;
    }
    if !tui_model_round("tui-model" as &const byte) {
        ok = false;
    }
    if !tui_worktree_round("tui-worktree" as &const byte) {
        ok = false;
    }
    if !tui_mouse_round("tui-mouse" as &const byte) {
        ok = false;
    }
    if !tui_md_round("tui-md" as &const byte) {
        ok = false;
    }
    if !tui_watch_pick_round("tui-watch-pick" as &const byte) {
        ok = false;
    }
    if !tui_full_round("tui-full" as &const byte) {
        ok = false;
    }
    return ok;
}

// ============================================================
// tui-full（P49）：浮层全屏
//
// 全屏在这里有确切含义：浮层把**转录区**用满（宽 = 终端列数、高 = panel_top、
// 左上角 = (0,0)），**不吃**面板 / 状态区 / 脚注。四条腿：
//   A) 几何：同一份内容，全屏的框 = 转录区（宽/高/左上角都真的到边），非全屏仍是居中框；
//   B) 按键：ctrl+f（0x06）与 F11（ESC[23~）都切换，且**四种浮层形态各认一次**
//      （全屏键必须路由在所有形态分派之前，否则 reader/ask/input 会把它静默吃掉）；
//   C) 不变量：每行 ≤ cols、正文层无 ESC / 无 NUL；面板与脚注仍在（全屏只吃转录区）；
//   D) 与 fail-closed 判据无关：终端太矮时该回落照旧回落；全屏态不跨浮层残留。
// ============================================================

// 屏幕里第一个浮层顶边所在行（找不到给 nrows）
fn tuis_full_top_row(txt: &const byte, n: usize) usize {
    return tuis_find_lit_row(txt, n, 0, tui_nrows(), "╭" as &const byte);
}

// 屏幕里最后一个浮层底边所在行（找不到给 nrows）
fn tuis_full_bot_row(txt: &const byte, n: usize) usize {
    var r: usize = tui_nrows();
    while r > 0 {
        r = r - 1;
        var a: usize = 0;
        var b: usize = 0;
        if tuis_line_span(txt, n, r, &a, &b) {
            var i: usize = a;
            while i + 3 <= b {
                if bufx_mem_eq(txt + i, "╰" as &const byte, 3) {
                    return r;
                }
                i = i + 1;
            }
        }
    }
    return tui_nrows();
}

// 断言浮层「占满转录区」：左右边界到 0 / cols-1，顶边在第 0 行，底边正好压在
// panel_top-1 那一行（面板之上最后一行）。用**屏幕文本**判，不看内部状态 ——
// 这样几何与绘制不一致时（右边界没到边、顶边没顶格）当场红。
fn tuis_full_frame_ok(cols: usize, tag: &const byte, ok: &bool) void {
    var txt: Buf = buf_new(262144);
    defer { buf_free(&txt); }
    _ = tui_screen_text(&txt);
    const p: &const byte = txt.ptr as &const byte;
    const n: usize = txt.len;
    const top: usize = tuis_full_top_row(p, n);
    if top >= tui_nrows() {
        tuis_fail(tag, "全屏浮层没有画出来（找不到 ╭）", ok);
        return;
    }
    if top != 0 {
        tuis_fail(tag, "全屏浮层的顶边没有顶格（第 0 行）", ok);
        tuis_puts("  top=");
        tuis_num(top);
        tuis_puts("\n");
    }
    // 左右边界：顶边那一行必须从第 0 列开始、到 cols-1 列结束
    const l: usize = tuis_row_edge_start(p, n, top);
    const rr: usize = tuis_row_edge_end(p, n, top);
    if l != 0 {
        tuis_fail(tag, "全屏浮层的左边框没在第 0 列", ok);
        tuis_puts("  left=");
        tuis_num(l);
        tuis_puts("\n");
    }
    if rr != cols {
        // 右边界列 = 边界字符的**右沿**；占满时应当正好等于 cols
        tuis_fail(tag, "全屏浮层的右边框没到终端最后一列", ok);
        tuis_puts("  right=");
        tuis_num(rr);
        tuis_puts(" cols=");
        tuis_num(cols);
        tuis_puts("\n");
    }
    // 每一行（顶边到底边）左右边界同列 + 都闭合 —— 复用既有判据的口径
    const bot: usize = tuis_full_bot_row(p, n);
    if bot >= tui_nrows() {
        tuis_fail(tag, "全屏浮层没有底边（找不到 ╰）", ok);
        return;
    }
    var r: usize = top;
    var bad: bool = false;
    while r <= bot {
        if tuis_row_edge_start(p, n, r) != l || tuis_row_edge_end(p, n, r) != rr {
            bad = true;
            break;
        }
        r = r + 1;
    }
    if bad {
        tuis_fail(tag, "全屏浮层的方框没有闭合成矩形（右边框逐行没对齐）", ok);
        tuis_puts("  行=");
        tuis_num(r);
        tuis_puts("\n");
    }
    // 底边必须**正好**压在面板之上：转录区的行数就是 panel_top，全屏把这块地用满 ⇒
    // 底边 = panel_top - 1。这一条是「全屏不吃面板」的**数值**判据 —— 光看「面板还在」
    // 是抓不住「框画过头、盖住面板之后又被后面补画的行盖回来」那类假绿的
    // （本轮对照实验 ③ 实测：把高度换成整个 rows 时，这条不加就是绿的）。
    const pt: usize = tui_panel_top_row();
    if pt > 0 && bot + 1 != pt {
        tuis_fail(tag, "全屏浮层的底边没有正好压在面板之上（多吃了或少吃了行）", ok);
        tuis_puts("  底边=");
        tuis_num(bot);
        tuis_puts(" panel_top=");
        tuis_num(pt);
        tuis_puts("\n");
    }
}

// A2/C/D2/D3/E 段共用的「切到全屏并画一帧」：全屏开关走**快捷键**那条真路
// （不经 tui_overlay_full_set），这样每一段都顺带验一遍按键路由。
fn tb_full_stub() void {
    tui_keys_inject("\x06" as &const byte, 1);
}

fn tui_full_round(tag: &const byte) bool {
    var ok: bool = true;
    const cols: usize = 100;
    const rows: usize = 30;

    // 一份够长的内容：非全屏的列表型上限 16 行，全屏才有地方把它画全 ——
    // 「全屏真的解除了上界」这条判据就靠它（末项只有全屏才看得见）。
    var items: Buf = buf_new(4096);
    defer { buf_free(&items); }
    var k: usize = 0;
    while k < 30 {
        _ = buf_append_cstr(&items, "/cmd");
        _ = buf_append_u64(&items, (k + 1) as u64);
        _ = buf_append_cstr(&items, "  第 ");
        _ = buf_append_u64(&items, (k + 1) as u64);
        _ = buf_append_cstr(&items, " 条命令（用来把框撑过 16 行上限）\n");
        k = k + 1;
    }

    // ---- A1) 非全屏：列表型仍是居中框（宽 60 / 不顶格 / 高 ≤ 16）----
    tuis_reset(cols, rows);
    tui_set_commands(items.ptr as &const byte, items.len);
    tui_overlay_list(TUI_OVK_PALETTE, "命令" as &const byte, 6, items.ptr as &const byte, items.len);
    if tui_overlay_full() {
        tuis_fail(tag, "开浮层时全屏态应当是关的（一次性生效）", &ok);
    }
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    var txt: Buf = buf_new(262144);
    defer { buf_free(&txt); }
    _ = tui_screen_text(&txt);
    var p: &const byte = txt.ptr as &const byte;
    var tn: usize = txt.len;
    const top0: usize = tuis_full_top_row(p, tn);
    if top0 >= tui_nrows() {
        tuis_fail(tag, "A1 前置：非全屏的列表浮层没画出来", &ok);
        return ok;
    }
    const l0: usize = tuis_row_edge_start(p, tn, top0);
    if l0 == 0 {
        tuis_fail(tag, "非全屏的浮层不该顶格（左边框应当在留白之后）", &ok);
    }
    // 非全屏的框高上界 16 行：底边-顶边+1 ≤ 16
    const bot0: usize = tuis_full_bot_row(p, tn);
    if bot0 >= tui_nrows() {
        tuis_fail(tag, "A1 前置：非全屏的列表浮层没有底边", &ok);
    } else if bot0 - top0 + 1 > 16 {
        tuis_fail(tag, "非全屏的列表浮层超过了 16 行上限", &ok);
    }
    // 30 项在 16 行框里放不下 ⇒ 末项看不见（这才是「需要全屏」的现场）
    if tuis_screen_has("第 30 条命令" as &const byte) {
        tuis_fail(tag, "非全屏居然把第 30 项也画出来了（框高上限没生效？这条腿就白测了）", &ok);
    }

    // ---- A2) 全屏：同一个浮层，框 = 转录区（顶格 / 左右到边 / 解除了 16 行上限）----
    tb_full_stub();
    tui_build();          // 快捷键只置脏；判据读的是**已画出来的那一帧**，这里必须真画
    tuis_full_frame_ok(cols, tag, &ok);
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("· 全屏" as &const byte) {
        tuis_fail(tag, "全屏后标题栏没有 ` · 全屏` 标记", &ok);
    }
    // 上界解除：非全屏上限 16 行，全屏的高度是 panel_top（这里 27）⇒ 可见条目严格更多。
    //
    // 判据用**两个固定字面量**而不是「for 1..30 拼字符串再查」：拼出来的名字是 buf_new
    // 造的**裸 malloc** 缓冲区（不保证 NUL 结尾），而 tuis_screen_has 内部按 bufx_cstr_len
    // 量长度 —— 会读到堆尾巴上去（README 踩坑 57/67/77 那一族，本轮又踩了一次：
    // 这条断言的第一版就是这么假红的，量出来「可见条目=9」）。
    // 第 20 条在所有可能的全屏高度下都该看得见（16 行上限只能画到前 13 项左右），
    // 而它在非全屏下**必然**看不见（前面已断言过第 30 条看不见，这里再钉一个更近的）。
    if !tuis_screen_has("第 20 条命令" as &const byte) {
        tuis_fail(tag, "全屏后第 20 项还看不见（16 行上限没解除？）", &ok);
        tuis_puts("  panel_top=");
        tuis_num(tui_panel_top_row());
        tuis_puts(" rows=");
        tuis_num(rows);
        tuis_puts("\n");
    }
    if tuis_screen_has("第 30 条命令" as &const byte) {
        tuis_fail(tag, "第 30 项不该在全屏下也看得见（全屏高 = panel_top 只到第 20 多项；这条是判据自检）", &ok);
    }

    // ---- B) 按键：ctrl+f 与 F11 都切换（列表型）----
    // 从全屏态出发：ctrl+f 关掉、F11 开回来（两种编码都真的到得了这个开关）
    if !tui_overlay_full() {
        tuis_fail(tag, "A2 前置：全屏态应当是开的", &ok);
    }
    tui_keys_inject("\x06" as &const byte, 1);          // ctrl+f
    if tui_overlay_full() {
        tuis_fail(tag, "ctrl+f（0x06）没有关掉全屏", &ok);
    }
    tui_keys_inject("\x1b[23~" as &const byte, 5);      // F11
    if !tui_overlay_full() {
        tuis_fail(tag, "F11（ESC[23~）没有开回全屏", &ok);
    }
    tui_keys_inject("\x1b[23~" as &const byte, 5);      // 再按一次
    if tui_overlay_full() {
        tuis_fail(tag, "F11 第二下没有关掉全屏", &ok);
    }
    // 全屏关掉后屏幕上必须回到居中框（画一帧再判）
    tui_build();
    _ = tui_screen_text(&txt);
    p = txt.ptr as &const byte;
    tn = txt.len;
    const top1: usize = tuis_full_top_row(p, tn);
    if top1 < tui_nrows() && top1 == 0 {
        tuis_fail(tag, "关掉全屏后框图没有回到居中（顶边还在第 0 行）", &ok);
    }
    tui_overlay_close();

    // ---- B2) 四种形态各认一次 ctrl+f（全屏键必须在所有形态分派之前）----
    // 顺序：列表（已测）/ reader / ask / input。每一种都：非全屏 → ctrl+f → 全屏 → 框占满。
    // reader
    tuis_reset(cols, rows);
    var body: Buf = buf_new(4096);
    defer { buf_free(&body); }
    var bi: usize = 0;
    while bi < 40 {
        _ = buf_append_cstr(&body, "计划正文第 ");
        _ = buf_append_u64(&body, (bi + 1) as u64);
        _ = buf_append_cstr(&body, " 行\n");
        bi = bi + 1;
    }
    tui_overlay_reader(TUI_OVK_PLAN, "计划" as &const byte, bufx_cstr_len("计划" as &const byte),
        body.ptr as &const byte, body.len, "确认执行" as &const byte, bufx_cstr_len("确认执行" as &const byte), 0);
    tui_keys_inject("\x06" as &const byte, 1);
    if !tui_overlay_full() {
        tuis_fail(tag, "reader 型（plan 审阅）上 ctrl+f 没有全屏（全屏键被形态分派吃掉了？）", &ok);
    }
    tui_build();
    tuis_full_frame_ok(cols, tag, &ok);
    tuis_scan_rows(cols, &ok, tag);
    tui_overlay_close();

    // ask
    tuis_reset(cols, rows);
    tui_overlay_ask_open("提问" as &const byte, bufx_cstr_len("提问" as &const byte),
        "选哪个？" as &const byte, bufx_cstr_len("选哪个？" as &const byte),
        "alpha\nbeta" as &const byte, bufx_cstr_len("alpha\nbeta" as &const byte), false, 0);
    tui_keys_inject("\x06" as &const byte, 1);
    if !tui_overlay_full() {
        tuis_fail(tag, "ask 型（提问弹窗）上 ctrl+f 没有全屏", &ok);
    }
    tui_build();
    tuis_full_frame_ok(cols, tag, &ok);
    tuis_scan_rows(cols, &ok, tag);
    // 全屏的 ask 仍是「问题 + 选项 + 自定义行 + 提示」那一套（不是被拉成一屏留白）
    if !tuis_screen_has("选哪个？" as &const byte) {
        tuis_fail(tag, "全屏的 ask 浮层里问题正文不见了", &ok);
    }
    if !tuis_screen_has("enter 提交" as &const byte) {
        tuis_fail(tag, "全屏的 ask 浮层里按键提示不见了（全屏把提示行挤掉了？）", &ok);
    }
    tui_overlay_close();

    // input（P48）
    tuis_reset(cols, rows);
    tui_overlay_input_open("标题" as &const byte, bufx_cstr_len("标题" as &const byte),
        "草稿" as &const byte, bufx_cstr_len("草稿" as &const byte));
    tui_keys_inject("\x06" as &const byte, 1);
    if !tui_overlay_full() {
        tuis_fail(tag, "input 型（/title 输入框）上 ctrl+f 没有全屏", &ok);
    }
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("· 全屏" as &const byte) {
        tuis_fail(tag, "全屏的 input 浮层没有全屏标记", &ok);
    }
    // 单行输入框全屏后**仍是 4 行高**（语义是单行输入，拉成一屏只会是留白）
    _ = tui_screen_text(&txt);
    p = txt.ptr as &const byte;
    tn = txt.len;
    const ti: usize = tuis_full_top_row(p, tn);
    const bi2: usize = tuis_full_bot_row(p, tn);
    if ti < tui_nrows() && bi2 < tui_nrows() && bi2 - ti + 1 != 4 {
        tuis_fail(tag, "input 型全屏后不是 4 行高（单行输入框的语义应当保持）", &ok);
        tuis_puts("  高=");
        tuis_num(bi2 - ti + 1);
        tuis_puts("\n");
    }
    tui_overlay_close();

    // ---- C) 不变量：全屏不吃面板 / 状态区 / 脚注 ----
    // 运行中（有状态区）开浮层全屏：面板的占位文案与脚注的 cwd 都必须在
    tuis_reset(cols, rows);
    tui_set_run(TUI_RUN_TOOL, "Bash(sleep 1)" as &const byte, bufx_cstr_len("Bash(sleep 1)" as &const byte));
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    tb_full_stub();
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    tuis_full_frame_ok(cols, tag, &ok);
    // 状态区（运行中才有的那一行）
    if !tuis_screen_has("运行中" as &const byte) {
        tuis_fail(tag, "全屏把常驻状态区吃掉了（P18 的承诺：转录再长也看得见状态）", &ok);
    }
    // 面板占位（输入行）
    if !tuis_screen_has("Ask anything" as &const byte) {
        tuis_fail(tag, "全屏把输入面板吃掉了（输入行是常驻的打字目标）", &ok);
    }
    // 脚注（cwd）
    if !tuis_screen_has("~/proj:main" as &const byte) {
        tuis_fail(tag, "全屏把脚注吃掉了", &ok);
    }
    // 「底边正好压在面板之上」那条数值判据在 tuis_full_frame_ok 里（上面已调过），
    // 这里不再重写一份 —— 两处判据分头写就是漂移的来源。
    tui_overlay_close();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);

    // ---- D1) 没浮层时按 ctrl+f：不改状态、落一条指路 notice ----
    tuis_reset(cols, rows);
    if tui_overlay_open() {
        tuis_fail(tag, "D1 前置：不该有浮层", &ok);
    }
    tui_keys_inject("\x06" as &const byte, 1);
    if tui_overlay_full() || tui_overlay_open() {
        tuis_fail(tag, "没浮层时按 ctrl+f 竟然开了浮层 / 改了全屏态（应当是空操作 + notice）", &ok);
    }
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("现在没有浮层" as &const byte) {
        tuis_fail(tag, "没浮层时按 ctrl+f 没有指路 notice（静默 = 用户以为键坏了）", &ok);
    }

    // ---- D2) 全屏态不跨浮层：关掉再开一张，必须回到非全屏 ----
    tuis_reset(cols, rows);
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    tb_full_stub();
    if !tui_overlay_full() {
        tuis_fail(tag, "D2 前置：全屏态没打开", &ok);
    }
    tui_overlay_close();
    if tui_overlay_full() {
        tuis_fail(tag, "close 之后全屏态残留了", &ok);
    }
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    if tui_overlay_full() {
        tuis_fail(tag, "新开的浮层继承了上一张的全屏态（一次性生效的纪律被破了）", &ok);
    }
    tui_overlay_close();

    // ---- D3) esc 关掉全屏浮层之后，转录回来（屏幕恢复）----
    tuis_reset(cols, rows);
    tui_add_user("把问候语改掉" as &const byte, bufx_cstr_len("把问候语改掉" as &const byte));
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    tb_full_stub();
    tui_build();
    if !tuis_screen_has("第 1 条命令" as &const byte) {
        tuis_fail(tag, "全屏浮层没画出来（D3 前置）", &ok);
    }
    tui_keys_inject("\x1b" as &const byte, 1);   // esc 关浮层
    if tui_overlay_open() {
        tuis_fail(tag, "esc 没有关掉全屏的浮层", &ok);
    }
    if tui_overlay_full() {
        tuis_fail(tag, "esc 关掉浮层后全屏态残留", &ok);
    }
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("把问候语改掉" as &const byte) {
        tuis_fail(tag, "关掉全屏浮层之后转录没有回来", &ok);
    }

    // ---- E) fail-closed 判据与全屏无关（终端太矮时照旧画不出来）----
    // 先给一个够高的画布把浮层开起来 + 切全屏，**再**缩到 5 行看判据有没有被带偏：
    // 这样测的是「全屏态 + 太矮」的组合，而不是「太矮时开浮层」。
    tuis_reset(cols, rows);
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    tb_full_stub();
    if !tui_overlay_full() {
        tuis_fail(tag, "E 前置：全屏态没打开", &ok);
    }
    if !tui_overlay_available() {
        tuis_fail(tag, "E 前置：30 行的画布上浮层应当画得出来", &ok);
    }
    tui_set_size(cols, 5);      // 缩到 5 行（panel_top 随之变小）
    tui_build();                // 不崩即可
    tuis_scan_rows(cols, &ok, tag);
    if tui_overlay_available() {
        tuis_fail(tag, "全屏不能把「浮层画得出来」这条判据变成 true（审批要 fail closed）", &ok);
    }
    if tui_reader_fits() {
        tuis_fail(tag, "全屏不能把 tui_reader_fits 变成 true（终端还是太矮）", &ok);
    }
    tui_overlay_close();

    // ---- F) /fullscreen 命令：报状态 / on / off / 非法值只报错 / 幂等 ----
    tuis_reset(cols, rows);
    tui_headless_enable(true);   // agent_cmd_fullscreen 先看 tui_active()
    var line: Buf = buf_new(64);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "/fullscreen");
    agent_cmd_fullscreen(&line);
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("当前没有浮层" as &const byte) {
        tuis_fail(tag, "裸 /fullscreen（没浮层）没有报出「当前没有浮层」", &ok);
    }
    // 开一张浮层再报状态
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    _ = buf_append_cstr(&line, " on");
    agent_cmd_fullscreen(&line);
    if !tui_overlay_full() {
        tuis_fail(tag, "/fullscreen on 没有全屏", &ok);
    }
    tui_build();
    tuis_full_frame_ok(cols, tag, &ok);
    // off
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/fullscreen off");
    agent_cmd_fullscreen(&line);
    if tui_overlay_full() {
        tuis_fail(tag, "/fullscreen off 没有关掉全屏", &ok);
    }
    // 非法取值：只报错、状态不动（与 /mouse 同一条纪律）
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/fullscreen bogus");
    agent_cmd_fullscreen(&line);
    if tui_overlay_full() {
        tuis_fail(tag, "/fullscreen bogus 把状态改掉了（非法取值应当只报错）", &ok);
    }
    // 判据要读 notice：先收掉浮层 —— 浮层盖着转录时那条 notice 在屏幕上根本看不见
    // （README 踩坑 65 的现场：底对齐菜单正好压在转录最新那几行上）
    tui_overlay_close();
    tui_build();
    tuis_scan_rows(cols, &ok, tag);
    if !tuis_screen_has("未知取值" as &const byte) {
        tuis_fail(tag, "/fullscreen 的非法取值没有报错", &ok);
    }
    // 幂等：已经是关，再 off 一次不该崩、也不该翻成开
    tui_overlay_list(TUI_OVK_HELP, "帮助" as &const byte, 6, items.ptr as &const byte, items.len);
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/fullscreen off");
    agent_cmd_fullscreen(&line);
    if tui_overlay_full() {
        tuis_fail(tag, "/fullscreen off 重复调用把状态翻成了开", &ok);
    }
    tui_overlay_close();

    // F 段把 TUI 打开了（agent_cmd_fullscreen 先看 tui_active()），收尾必须**关掉**
    // `g_tui_on`，而不只是复位画布 —— tuis_reset 是关不掉的（它只动尺寸与状态）。
    // 漏掉的后果很隐蔽：后一轮（perm-readonly）里 `ask_approve_action` 会走
    // `if tui_active() && tui_overlay_available()` 那一支（以为有浮层可弹），于是不再回
    // "no answer channel"，mock 第 1 轮的断言 110 当场红 —— 现场看着像权限轮的缺陷，
    // 其实是本轮的状态泄漏（与 tui-switch 的 C 段同一个坑，见那里的注释）。
    tui_headless_enable(false);
    tuis_reset(cols, rows);
    if ok {
        tuis_ok(tag, "浮层全屏（几何占满转录区、四种形态都认 ctrl+f / F11、解除 16 行上限、不吃面板与脚注、没浮层时只落 notice、不跨浮层残留、不改变 fail-closed 判据、/fullscreen 命令四态）");
    }
    return ok;
}

// ============================================================
// tui-md（P47）：markdown 渲染
//
// 旧实现的两处硬伤（本轮修掉，逐条在这里钉住）：
//   ① **长行静默丢字**：折行按 `cols - 6`、绘制按 `cols - 7`，列表/代码行绘制时再多扣
//      2 列 ⇒ 每行丢 1–3 个字符再补 '…'。实测（修前）：60/80/100 列下 100 字符的代码行
//      只显示 97 个、60 个汉字只显示 58–59 个。修后：逐字符可见、没有 '…'。
//   ② **围栏状态是帧级全局**（`g_tui_md_code` 每帧开头复位）⇒ 滚动窗口落在代码块中间时
//      整块掉样式、闭合围栏还被当成「开始」。修后样式逐字节落在文本上，窗口从哪儿开始都对。
//
// 另外三条不变量：每行显示列 ≤ cols、正文层无 ESC / 无 NUL（复用 tuis_scan_rows）。
// ============================================================

// 屏幕文本里某字节出现几次（「不丢字」那条腿的判据）
fn tuis_md_count_byte(c: byte) usize {
    var out: Buf = buf_new(262144);
    defer { buf_free(&out); }
    _ = tui_screen_text(&out);
    var k: usize = 0;
    var n: usize = 0;
    while k < out.len {
        if out.ptr[k] == c {
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

// 含 `lit` 的那些行里有没有 '…'（'…' = E2 80 A6）。
// 按**字面量**而不是单字节匹配：单个 0xE6 既是「汉」的首字节、也是任务块里一堆汉字与
// 它自己那条截断提示 `…` 的来源，按字节判会把任务块的 '…' 算进来（第一版就这么假红）。
fn tuis_md_row_has_ellipsis(lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    var r: usize = 0;
    while r < tui_nrows() {
        var out: Buf = buf_new(512);
        defer { buf_free(&out); }
        tui_row_text(r, &out);
        var has_c: bool = false;
        var k: usize = 0;
        while k + ln <= out.len {
            if bufx_mem_eq(out.ptr + k, lit, ln) {
                has_c = true;
            }
            k = k + 1;
        }
        if has_c {
            var j: usize = 0;
            while j + 3 <= out.len {
                if out.ptr[j] == 226 as byte && out.ptr[j + 1] == 128 as byte && out.ptr[j + 2] == 166 as byte {
                    return true;
                }
                j = j + 1;
            }
        }
        r = r + 1;
    }
    return false;
}

fn tuis_md_count_lit(lit: &const byte) usize {
    var out: Buf = buf_new(262144);
    defer { buf_free(&out); }
    _ = tui_screen_text(&out);
    const ln: usize = bufx_cstr_len(lit);
    var k: usize = 0;
    var n: usize = 0;
    while k + ln <= out.len {
        if bufx_mem_eq(out.ptr + k, lit, ln) {
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

// 某一行里第一个非空格的显示列 + 该列的样式（断言「样式落在哪一段上」用）
fn tuis_md_first_styled(lit: &const byte, col: &usize, st: &u8) bool {
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, lit) {
            var out: Buf = buf_new(512);
            defer { buf_free(&out); }
            tui_row_text(r, &out);
            var i: usize = 0;
            while i < out.len && out.ptr[i] == 32 as byte {
                i = i + 1;
            }
            col[0] = tty_cols_between(out.ptr as &const byte, 0, i);
            st[0] = tui_row_style_at(r, col[0]);
            return true;
        }
        r = r + 1;
    }
    return false;
}

// 含 `row_lit` 的那一行里 `lit` 起始处的显示列（定位「某一小段」的样式）。
// 一并交回**行号** —— 拿 tui_nrows()-1 当「刚才那行」是错的（任务块/状态区都在下面）。
fn tuis_md_col_of(lit: &const byte, row_lit: &const byte, row: &usize, col: &usize) bool {
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, row_lit) {
            var out: Buf = buf_new(512);
            defer { buf_free(&out); }
            tui_row_text(r, &out);
            const ln: usize = bufx_cstr_len(lit);
            if out.len >= ln {
                var k: usize = 0;
                while k + ln <= out.len {
                    if bufx_mem_eq(out.ptr + k, lit, ln) {
                        row[0] = r;
                        col[0] = tty_cols_between(out.ptr as &const byte, 0, k);
                        return true;
                    }
                    k = k + 1;
                }
            }
        }
        r = r + 1;
    }
    return false;
}

// 把一段 markdown 装进转录并成帧（返回后屏幕上就是它）。
// 走 C 字符串口径：调用方给**字面量**；动态拼出来的 Buf 用 tuis_md_frame_n。
fn tuis_md_frame(cols: usize, rows: usize, md: &const byte) void {
    tuis_md_frame_n(cols, rows, md, bufx_cstr_len(md));
}

// ⚠ buf_new 是**裸 malloc**、缓冲区不保证有 NUL 结尾，拿 bufx_cstr_len 去量动态拼出来的
// 夹具会一路读到堆尾巴（README 踩坑 57/67 同款）。动态夹具一律走这个带长度的入口。
fn tuis_md_frame_n(cols: usize, rows: usize, md: &const byte, n: usize) void {
    tuis_reset(cols, rows);
    tui_sink_bytes(1, md, n);
    tui_close_stream_entries();
    tui_build();
}

// ---- A) 行内强调 ----
fn tuis_md_inline_case(tag: &const byte, ok: &bool) void {
    const md: &const byte = "PTEXT **BOLD** 斜 *ALPHA* 删 ~~GONE~~ 码 `raw` 链 [LBL](https://ex.example/p)\n\nASCII **粗** 混排\n" as &const byte;
    tuis_md_frame(100, 30, md);
    tuis_scan_rows(100, ok, tag);
    var col: usize = 0;
    var st: u8 = 0;
    // 标记符号本身不许上屏（这是「渲染了」最直接的判据）
    if tuis_screen_has("**" as &const byte) || tuis_screen_has("~~" as &const byte) {
        tuis_fail(tag, "行内标记 `**` / `~~` 原样上屏了（没渲染）", ok);
    }
    if !tuis_screen_has("(https://ex.example/p)" as &const byte) {
        tuis_fail(tag, "链接地址没有画出来", ok);
    }
    if tuis_screen_has("[LBL]" as &const byte) {
        tuis_fail(tag, "链接的方括号原样上屏了（应当只剩文字 + 地址）", ok);
    }
    if !tuis_md_first_styled("PTEXT" as &const byte, &col, &st) {
        tuis_fail(tag, "正文行没上屏", ok);
    } else if st != TUI_ST_DEFAULT {
        tuis_fail(tag, "普通正文的样式不是默认（样式串味到行首了）", ok);
    }
    var row: usize = 0;
    if !tuis_md_col_of("BOLD" as &const byte, "PTEXT" as &const byte, &row, &col) {
        tuis_fail(tag, "粗体文字没上屏", ok);
    } else if tui_row_style_at(row, col) != TUI_ST_BOLD {
        tuis_fail(tag, "**粗体** 没有落到 BOLD 样式上", ok);
    }
    if !tuis_md_col_of("ALPHA" as &const byte, "PTEXT" as &const byte, &row, &col) {
        tuis_fail(tag, "斜体文字没上屏", ok);
    } else if tui_row_style_at(row, col) != TUI_ST_ITALIC {
        tuis_fail(tag, "**斜体** 没有落到 ITALIC 样式上", ok);
    }
    if !tuis_md_col_of("GONE" as &const byte, "PTEXT" as &const byte, &row, &col) {
        tuis_fail(tag, "删除线文字没上屏", ok);
    } else if tui_row_style_at(row, col) != TUI_ST_STRIKE {
        tuis_fail(tag, "~~删除线~~ 没有落到 STRIKE 样式上", ok);
    }
    if !tuis_md_col_of("raw" as &const byte, "PTEXT" as &const byte, &row, &col) {
        tuis_fail(tag, "行内 code 没上屏", ok);
    } else if tui_row_style_at(row, col) != TUI_ST_INLINE {
        tuis_fail(tag, "行内 `code` 没有落到 INLINE 样式上", ok);
    }
    if tuis_screen_has("`raw`" as &const byte) {
        tuis_fail(tag, "行内 code 的反引号原样上屏了", ok);
    }
    // 下划线不该吃掉 snake_case（行内扫描的经典误判）
    tuis_md_frame(100, 30, "调用 snake_case_name 与 __下划线粗__ 两种\n" as &const byte);
    if !tuis_screen_has("snake_case_name" as &const byte) {
        tuis_fail(tag, "snake_case 里的下划线被当成斜体标记吃掉了", ok);
    }
    if tuis_screen_has("__下划线粗__" as &const byte) {
        tuis_fail(tag, "__下划线粗__ 没有被认出是粗体", ok);
    }
}

// ---- B) 块级：标题 / 列表 / 任务清单 / 引用 / 分隔线 / 围栏 ----
fn tuis_md_block_case(tag: &const byte, ok: &bool) void {
    const md: &const byte = "# 一级标题\n\n## 二级标题\n\n正文\n\n- 无序一\n  - 嵌套二\n1. 有序一\n\n- [x] 做完的\n- [ ] 没做的\n\n> 引用一行\n\n---\n\n```uya\nCODEINSIDE\n```\n\n收尾\n" as &const byte;
    tuis_md_frame(100, 40, md);
    tuis_scan_rows(100, ok, tag);
    var col: usize = 0;
    var st: u8 = 0;
    // 标题：去 # 号 + 分级样式
    if tuis_screen_has("# " as &const byte) || tuis_screen_has("##" as &const byte) {
        tuis_fail(tag, "标题的 # 号原样上屏了（没去标记）", ok);
    }
    if !tuis_md_first_styled("一级标题" as &const byte, &col, &st) {
        tuis_fail(tag, "一级标题没上屏", ok);
    } else if st != TUI_ST_H1 {
        tuis_fail(tag, "一级标题的样式不是 H1", ok);
    }
    if !tuis_md_first_styled("二级标题" as &const byte, &col, &st) {
        tuis_fail(tag, "二级标题没上屏", ok);
    } else if st != TUI_ST_BOLD {
        tuis_fail(tag, "二级标题的样式不是 BOLD（H2 档）", ok);
    }
    // 列表：标记换成字形，序号保留
    if !tuis_screen_has("· 无序一" as &const byte) {
        tuis_fail(tag, "无序列表项的 `· ` 字形不对", ok);
    }
    if !tuis_screen_has("· 嵌套二" as &const byte) {
        tuis_fail(tag, "嵌套列表项没有缩进后画出", ok);
    }
    if !tuis_screen_has("1. 有序一" as &const byte) {
        tuis_fail(tag, "有序列表项的序号不对", ok);
    }
    if !tuis_screen_has("✓ 做完的" as &const byte) || !tuis_screen_has("· 没做的" as &const byte) {
        tuis_fail(tag, "任务清单的 `[x]` / `[ ]` 没有换成 ✓ / ·", ok);
    }
    if tuis_screen_has("[x]" as &const byte) || tuis_screen_has("[ ]" as &const byte) {
        tuis_fail(tag, "任务清单的方括号原样上屏了", ok);
    }
    if !tuis_screen_has("▏ 引用一行" as &const byte) {
        tuis_fail(tag, "引用的 `▏ ` 前缀不对", ok);
    }
    if tuis_screen_has("> 引用" as &const byte) {
        tuis_fail(tag, "引用的 `>` 原样上屏了", ok);
    }
    // 分隔线：整行 `─`（≥3 个就算分隔线）
    if !tuis_screen_has("─────" as &const byte) {
        tuis_fail(tag, "分隔线没画出来", ok);
    }
    // 围栏：开/闭标记不画、语言标签画、块内是代码样式
    if tuis_screen_has("```" as &const byte) {
        tuis_fail(tag, "代码围栏的 ``` 原样上屏了", ok);
    }
    if !tuis_screen_has("uya" as &const byte) {
        tuis_fail(tag, "围栏的语言标签没画出来", ok);
    }
    if !tuis_md_style_of_row("CODEINSIDE" as &const byte, TUI_ST_CODE) {
        tuis_fail(tag, "围栏里的代码没有落到 CODE 样式上", ok);
    }
    // 围栏之后的普通正文不许还带着代码样式
    if !tuis_md_style_of_row("收尾" as &const byte, TUI_ST_DEFAULT) {
        tuis_fail(tag, "围栏闭了之后的正文还带着代码样式（围栏状态没复位）", ok);
    }
}

// 某行里 `lit` 处的样式是不是 st
fn tuis_md_style_of_row(lit: &const byte, st: u8) bool {
    var row: usize = 0;
    var col: usize = 0;
    if !tuis_md_col_of(lit, lit, &row, &col) {
        return false;
    }
    return tui_row_style_at(row, col) == st;
}

// ---- C) 「不丢字」回归（旧实现的硬伤 ①）----
fn tuis_md_nowrap_case(tag: &const byte, ok: &bool) void {
    var w: usize = 60;
    while w <= 100 {
        // 代码块里 100 个连续 Q（没有任何空格可断）
        var md: Buf = buf_new(4096);
        defer { buf_free(&md); }
        _ = buf_append_cstr(&md, "```\n");
        var i: usize = 0;
        while i < 100 {
            _ = buf_append_cstr(&md, "Q");
            i = i + 1;
        }
        _ = buf_append_cstr(&md, "\n```\n");
        // 正文里 100 个连续 Z
        i = 0;
        while i < 100 {
            _ = buf_append_cstr(&md, "Z");
            i = i + 1;
        }
        _ = buf_append_cstr(&md, "\n");
        // 正文里 60 个连续汉字（宽字符，最容易在边界上被砍）
        i = 0;
        while i < 60 {
            _ = buf_append_cstr(&md, "汉");
            i = i + 1;
        }
        _ = buf_append_cstr(&md, "\n");
        tuis_md_frame_n(w, 40, md.ptr as &const byte, md.len);
        tuis_scan_rows(w, ok, tag);
        const q: usize = tuis_md_count_byte(81 as byte);
        const z: usize = tuis_md_count_byte(90 as byte);
        const h: usize = tuis_md_count_lit("汉" as &const byte);
        if q != 100 {
            tuis_fail(tag, "代码块里的 100 个字符没有全部上屏（丢了字）", ok);
            tuis_puts("  cols=" as &const byte);
            tuis_num(w);
            tuis_puts(" Q=" as &const byte);
            tuis_num(q);
            tuis_puts("\n" as &const byte);
        }
        if z != 100 {
            tuis_fail(tag, "正文里的 100 个字符没有全部上屏（丢了字）", ok);
        }
        if h != 60 {
            tuis_fail(tag, "正文里的 60 个汉字没有全部上屏（丢了字）", ok);
            tuis_puts("  cols=" as &const byte);
            tuis_num(w);
            tuis_puts(" 汉=" as &const byte);
            tuis_num(h);
            tuis_puts("\n" as &const byte);
        }
        // 没被裁就不该出现 '…'（旧实现在这里每行稳定补一个）。
        // 注意**只看那几行的文本**：整屏的 '…' 还会来自脚注缩略与任务块的「还有 N 行」，
        // 拿整屏做判据是假红（第一版就是这么红的）。
        if tuis_md_row_has_ellipsis("QQQQ" as &const byte) {
            tuis_fail(tag, "代码行没有被裁却补了 '…'（预算算小了）", ok);
        }
        if tuis_md_row_has_ellipsis("ZZZZ" as &const byte) {
            tuis_fail(tag, "正文行没有被裁却补了 '…'（预算算小了）", ok);
        }
        if tuis_md_row_has_ellipsis("汉汉汉" as &const byte) {
            tuis_fail(tag, "汉字行没有被裁却补了 '…'（预算算小了）", ok);
        }
        w = w + 20;
    }
}

// ---- D) 滚到代码块中间，样式不许串（旧实现的硬伤 ②）----
fn tuis_md_fence_state_case(tag: &const byte, ok: &bool) void {
    var md: Buf = buf_new(8192);
    defer { buf_free(&md); }
    var i: usize = 0;
    while i < 4 {
        _ = buf_append_cstr(&md, "前言 ");
        _ = buf_append_u64(&md, (i + 1) as u64);
        _ = buf_append_cstr(&md, "\n");
        i = i + 1;
    }
    _ = buf_append_cstr(&md, "```\n");
    i = 0;
    while i < 30 {
        _ = buf_append_cstr(&md, "CBLOCK");
        _ = buf_append_u64(&md, (i + 1) as u64);
        _ = buf_append_cstr(&md, "\n");
        i = i + 1;
    }
    _ = buf_append_cstr(&md, "```\n");
    i = 0;
    while i < 6 {
        _ = buf_append_cstr(&md, "后继正文 ");
        _ = buf_append_u64(&md, (i + 1) as u64);
        _ = buf_append_cstr(&md, "\n");
        i = i + 1;
    }
    tuis_md_frame_n(80, 60, md.ptr as &const byte, md.len);
    // 贴尾：代码行是代码样式、后继正文是默认样式
    if !tuis_md_style_of_row("CBLOCK30" as &const byte, TUI_ST_CODE) {
        tuis_fail(tag, "贴尾时代码行没有代码样式", ok);
    }
    if !tuis_md_style_of_row("后继正文 1" as &const byte, TUI_ST_DEFAULT) {
        tuis_fail(tag, "贴尾时围栏之后的正文不是默认样式", ok);
    }
    // 往上滚，让窗口落在代码块**中间**（开围栏与 `前言` 都已经在窗口之上、
    // 闭合围栏与后继正文还在窗口之内）
    tui_scroll_up(12);
    tui_build();
    tuis_scan_rows(80, ok, tag);
    if !tuis_screen_has("CBLOCK" as &const byte) {
        tuis_fail(tag, "往上滚之后代码块看不见了（这一段的断言就没意义了）", ok);
    }
    if !tuis_md_style_of_row("CBLOCK10" as &const byte, TUI_ST_CODE) {
        tuis_fail(tag, "窗口落在代码块中间时代码行掉了样式（旧的帧级围栏状态）", ok);
    }
    // 闭合围栏不许再被当成「开始」（旧实现会把之后的正文整段染成代码样式）
    if !tuis_screen_has("后继正文" as &const byte) {
        tuis_fail(tag, "往上滚之后后继正文看不见了", ok);
    }
    if !tuis_md_style_of_row("后继正文 6" as &const byte, TUI_ST_DEFAULT) {
        tuis_fail(tag, "闭合围栏被当成了开始（后继正文被染成代码样式）", ok);
    }
    tui_scroll_end();
    tui_build();
}

// ---- E) 表格 ----
fn tuis_md_table_case(tag: &const byte, ok: &bool) void {
    const md: &const byte = "| 名字 | 说明 | 数量 |\n| --- | :---: | ---: |\n| a | 短 | 1 |\n| 很长的名字啊 | 一段很长很长的说明文字 | 22 |\n" as &const byte;
    tuis_md_frame(100, 30, md);
    tuis_scan_rows(100, ok, tag);
    var col: usize = 0;
    var st: u8 = 0;
    if !tuis_screen_has("名字" as &const byte) {
        tuis_fail(tag, "表头没上屏", ok);
    }
    if !tuis_md_style_of_row("名字" as &const byte, TUI_ST_BOLD) {
        tuis_fail(tag, "表头单元格的样式不是 BOLD", ok);
    }
    if !tuis_md_style_of_row("│" as &const byte, TUI_ST_DIM) {
        tuis_fail(tag, "表格框线不是 DIM（框线与单元格内容要分得开）", ok);
    }
    if tuis_screen_has("| --- |" as &const byte) {
        tuis_fail(tag, "表格的分隔行原样上屏了（没画成框线）", ok);
    }
    if !tuis_screen_has("├" as &const byte) || !tuis_screen_has("┼" as &const byte) {
        tuis_fail(tag, "表格的框线字形没画出来", ok);
    }
    if !tuis_screen_has("很长的名字啊" as &const byte) {
        tuis_fail(tag, "表格单元格内容丢了", ok);
    }
    if !tuis_md_style_of_row("很长的名字啊" as &const byte, TUI_ST_TOOL) {
        tuis_fail(tag, "表格正文单元格的样式不对", ok);
    }
    // 表格每一行的显示列必须一致（列宽算错就会参差）
    var widths: [usize: 8] = [0: 8];
    var nw: usize = 0;
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, "│" as &const byte) && tui_row_has(r, "├" as &const byte) == false {
            if tui_row_has(r, "名字" as &const byte) || tui_row_has(r, "很长的名字啊" as &const byte) || tui_row_has(r, "a " as &const byte) {
                if nw < 8 {
                    widths[nw] = tui_row_cols_n(r) - tui_row_cols_n_lead(r);
                    nw = nw + 1;
                }
            }
        }
        r = r + 1;
    }
    if nw >= 2 {
        var k: usize = 1;
        while k < nw {
            if widths[k] != widths[0] {
                tuis_fail(tag, "表格各行的显示宽度不一致（列宽算错）", ok);
                break;
            }
            k = k + 1;
        }
    }
    // 窄终端：列宽收到下限（每列 3）还放不下 ⇒ **整块退回普通行**（内容一个字节都不丢）。
    // 3 列的最小需求是 3*3+3*3+1 = 19 列，终端最窄 32 列，所以 3 列的表格永远放得下 ——
    // 要逼出退化得用列数更多的表格（8 列最小需求 49 列）。
    const wide: &const byte = "| c1 | c2 | c3 | c4 | c5 | c6 | c7 | c8 |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| UNIQUECELL | b | c | d | e | f | g | h |\n" as &const byte;
    tuis_md_frame(40, 30, wide);
    tuis_scan_rows(40, ok, tag);
    if !tuis_screen_has("UNIQUECELL" as &const byte) {
        tuis_fail(tag, "放不下时退回普通行却丢了内容", ok);
    }
    if tuis_screen_has("├" as &const byte) {
        tuis_fail(tag, "40 列下 8 列表格本该退回普通行，却还是画了框线", ok);
    }
}

// 一行的显示列（从行首到最后一个非空格列）—— 表格对齐断言用
fn tui_row_cols_n_lead(r: usize) usize {
    var out: Buf = buf_new(512);
    defer { buf_free(&out); }
    tui_row_text(r, &out);
    const full: usize = tty_cols_between(out.ptr as &const byte, 0, out.len);
    var i: usize = out.len;
    while i > 0 && (out.ptr[i - 1] == 32 as byte) {
        i = i - 1;
    }
    const body: usize = tty_cols_between(out.ptr as &const byte, 0, i);
    if full >= body {
        return full - body;
    }
    return 0;
}

// ---- F) 浮层（reader）也走同一份 markdown ----
fn tuis_md_overlay_case(tag: &const byte, ok: &bool) void {
    const plan: &const byte = "# 计划标题\n\n- **要点一**\n- 要点二\n\n```uya\nPlanCodeLine\n```\n\n| 列 |\n| --- |\n| 值 |\n" as &const byte;
    tuis_reset(100, 30);
    tui_overlay_reader(TUI_OVK_PLAN, "计划" as &const byte, bufx_cstr_len("计划" as &const byte),
        plan, bufx_cstr_len(plan), "继续讨论\n解决\n确认执行\n" as &const byte,
        bufx_cstr_len("继续讨论\n解决\n确认执行\n" as &const byte), 0);
    if !tui_overlay_open() {
        tuis_fail(tag, "审阅浮层没有打开", ok);
        return;
    }
    tui_build();
    tuis_scan_rows(100, ok, tag);
    if !tuis_screen_has("│ 计划标题" as &const byte) {
        tuis_fail(tag, "浮层正文的标题没有按 markdown 渲染（还带着 #）", ok);
    }
    if tuis_screen_has("│ # " as &const byte) {
        tuis_fail(tag, "浮层正文里的 # 号没有被去掉", ok);
    }
    if tuis_screen_has("**要点一**" as &const byte) {
        tuis_fail(tag, "浮层正文里的 **粗体** 标记原样上屏了", ok);
    }
    if !tuis_screen_has("PlanCodeLine" as &const byte) {
        tuis_fail(tag, "浮层里的代码块正文没画出来", ok);
    }
    // 方框逐行闭合（既有不变量：右边框必须在同一列）
    tuis_overlay_frame_check(100, ok, tag);
    tui_overlay_close();
    tuis_reset(100, 30);
}

// ---- G) 长条目的取行必须是 O(1)（本轮修的「重绘卡死」）----
//
// 症状：一个几 MiB 的长助手条目进转录之后，**每一帧**都要几秒（贴尾也一样），
// 滚轮/思考行的重绘把界面拖死。根因：条目取行 `tui_entry_line(i, k)` 为取第 k 行
// 从 wrap 头部**重新扫一遍**，draw 循环对每个可见行都调一次 ⇒ O(条目 × 可见行)。
// 这与踩坑 68 的 `/sessions` 卡顿是同一族，条目这条路当时漏了。
//
// 判据三条，缺一不可：
//   ① **差分**：查表路径与线性扫描路径对同一 (i, k) 逐字节一致（表算对了吗）；
//   ② **预算**：大条目贴尾那一帧 + 上翻 20 屏的墙钟都远低于上限（真的 O(1) 吗）；
//   ③ 不变量：那些帧里正文层无 ESC / 无 NUL、每行 ≤ cols。
fn tuis_md_bigcase(tag: &const byte, ok: &bool) void {
    // 一份 ~194 KiB 的 markdown 正文（约 5400 折行行），灌 12 遍 ⇒ ~2.3 MiB / 12 个条目
    var md: Buf = buf_new(262144);
    defer { buf_free(&md); }
    var i: usize = 0;
    while i < 900 {
        _ = buf_append_cstr(&md, "### 小节 ");
        _ = buf_append_u64(&md, i as u64);
        _ = buf_append_cstr(&md, "\n\n这是第 ");
        _ = buf_append_u64(&md, i as u64);
        _ = buf_append_cstr(&md, " 段正文，带 **粗体** 与 `code` 与 [链接](https://example.com/path)。\n\n- 项目一\n- 项目二 `x`\n\n| 列A | 列B |\n| --- | ---: |\n| 值 | 1 |\n\n```uya\nconst X: usize = 1;\n```\n\n");
        i = i + 1;
    }
    tuis_reset(80, 40);
    var n: usize = 0;
    while n < 12 {
        tui_sink_bytes(1, md.ptr as &const byte, md.len);
        tui_close_stream_entries();
        n = n + 1;
    }
    // ① **首帧就是最贵的那一帧**（折行 + 建表都在这一帧里做）：先量它，别被后面的
    //    差分/滚动步骤先把缓存捂热了 —— 否则这条预算就成了摆设（第一版就是这么假绿的）。
    const t0: u64 = ua_now_ms();
    tui_build();
    const first: u64 = ua_now_ms() - t0;

    // ② 差分对照：查表 vs 线性扫描，逐行逐字节相同
    const li: usize = tui_entries_count() - 1;
    const rows: usize = tui_entry_wrap_lines(li);
    if rows < 100 {
        tuis_fail(tag, "长条目的折行行数太少（夹具不对，这一段的断言没意义）", ok);
        tuis_puts("  rows=" as &const byte);
        tuis_num(rows);
        tuis_puts(" entries=" as &const byte);
        tuis_num(tui_entries_count());
        tuis_puts("\n" as &const byte);
        return;
    }
    var k: usize = 0;
    while k < rows {
        var o1: usize = 0;
        var l1: usize = 0;
        var o2: usize = 0;
        var l2: usize = 0;
        const a: bool = tui_entry_line(li, k, &o1, &l1);
        const b: bool = tui_entry_line_lin(li, k, &o2, &l2);
        if a != b || l1 != l2 {
            tuis_fail(tag, "条目取行：查表与线性扫描给出的结果不一致", ok);
            tuis_puts("  k=" as &const byte);
            tuis_num(k);
            tuis_puts(" idx=" as &const byte);
            tuis_num(l1);
            tuis_puts(" lin=" as &const byte);
            tuis_num(l2);
            tuis_puts("\n" as &const byte);
            return;
        }
        k = k + 1;
    }
    // ③ 预算：缓存帧 + 上翻 20 屏
    const t1: u64 = ua_now_ms();
    tui_build();
    const cached: u64 = ua_now_ms() - t1;
    const t2: u64 = ua_now_ms();
    var sg: usize = 0;
    while sg < 20 {
        tui_scroll_up(40);
        tui_build();
        sg = sg + 1;
    }
    const scroll: u64 = ua_now_ms() - t2;
    tuis_scan_rows(80, ok, tag);
    // 上限刻意放得很松（修前实测：首帧 4774 ms、缓存帧 4425 ms、20 次上翻 86532 ms；
    // 修后：340 / 1 / 17 ms）。松上限是为了在慢机器上不假红，同时仍能把「线性扫描」
    // 那一档（几秒级）稳稳判死。
    if first > 4000 {
        tuis_fail(tag, "长条目首帧太慢（取行不是 O(1)？）", ok);
        tuis_puts("  实测 ms = " as &const byte);
        tuis_num(first as usize);
        tuis_puts("\n" as &const byte);
    }
    if cached > 1000 {
        tuis_fail(tag, "长条目缓存帧太慢（每帧都在重扫 wrap？）", ok);
        tuis_puts("  实测 ms = " as &const byte);
        tuis_num(cached as usize);
        tuis_puts("\n" as &const byte);
    }
    if scroll > 8000 {
        tuis_fail(tag, "长条目上翻 20 屏太慢（取行不是 O(1)）", ok);
        tuis_puts("  实测 ms = " as &const byte);
        tuis_num(scroll as usize);
        tuis_puts("\n" as &const byte);
    }
    if ok[0] {
        tuis_puts("selftest[tui-md] 长条目：首帧 " as &const byte);
        tuis_num(first as usize);
        tuis_puts(" ms / 缓存帧 " as &const byte);
        tuis_num(cached as usize);
        tuis_puts(" ms / 上翻 20 屏 " as &const byte);
        tuis_num(scroll as usize);
        tuis_puts(" ms（" as &const byte);
        tuis_num(rows);
        tuis_puts(" 折行行 × 12 条目）\n" as &const byte);
    }
}

fn tui_md_round(tag: &const byte) bool {
    var ok: bool = true;
    view_init(true, 0);       // 直接建帧，不跑 agent
    tuis_md_inline_case(tag, &ok);
    tuis_md_block_case(tag, &ok);
    tuis_md_nowrap_case(tag, &ok);
    tuis_md_fence_state_case(tag, &ok);
    tuis_md_table_case(tag, &ok);
    tuis_md_overlay_case(tag, &ok);
    tuis_md_bigcase(tag, &ok);
    if ok {
        tuis_ok(tag, "markdown：行内强调/标题分级/列表与任务清单/引用/分隔线/围栏（含语言标签）/表格（列宽与对齐/窄终端退回）+ 长行不丢字（60·80·100 列逐字符）+ 滚到代码块中间样式不串 + 浮层共用同一份 + 长条目取行 O(1)（查表 vs 扫描差分 + 成帧预算）");
    }
    return ok;
}

// ============================================================
// tui-mouse：鼠标上报开关（踩坑 72，「不能复制文本」）
//
// 症状（用户报告）：uya-agent 的 TUI 里**拖选不了文本、复制不了**。
// 根因（真机复现 + 逐字节）：P25 为了滚轮无条件开了 `ESC[?1000h`+`ESC[?1006h`，
// 而终端只要把鼠标交给我们，**自己的拖选复制就没了** —— 左键按下/拖动全变成
// `ESC[<b;x;yM` 事件灌过来（TUI 只吃滚轮、其余丢弃），于是拖选什么都没有。
// 实测：同一块屏幕，鼠标上报开着时普通拖选 PRIMARY 一个字节都不变；关掉之后
// 选中 TUI 正文立刻拿到文本（拖选得到的正是屏幕上的文字）。
//
// 这一轮钉住三件事：
//   ① 开关本身（tui_set_mouse / tui_mouse_enabled 幂等）；
//   ② **字节级**：开→`1000h`+`1006h`、关→`1006l`+`1000l`，且 `tui_term_enter`
//      发的序列**跟着开关走**（只信标志位的话，把 tui_term_enter 那行改坏了照样绿）；
//   ③ F2（`ESC O Q` 与 CSI 形态 `ESC [ 12 ~`）与 `/mouse [on|off]` 命令都真的翻转。
// ============================================================

// 从 pipe 收一帧（tui_term_enter / set_mouse 刚写下的那些字节）
fn tuis_mouse_enter(rfd: i32, cap: &Buf) void {
    buf_reset(cap);
    tuis_pipe_drain(rfd, cap);
}

// 踩坑 72：跑一个**真的**带 uya-agent TUI 的子进程，把「鼠标上报有没有开」这件事在
// 真终端上量出来 —— 上面 C/D 两段是 headless 的标志位与字节级，这一段补的是
// 「配置 → agent_tui_start → tui_set_mouse → 真终端序列」这条端到端链。
// 判据：mouse=false 时整段 PTY 捕获里**一个** `?1000h`/`?1006h` 都没有；
//       mouse=true（默认）时至少各一个。
fn tuis_mouse_spawn(mouse: bool, want_on: bool, tag: &const byte, ok: &bool) void {
    tui_reset_all();
    tui_begin_session();
    tui_set_headless(false);
    tui_headless_enable(false);
    tty_sink_on = false;
    var mpid: i32 = -1;
    const port: u16 = tuis_start_mock(&mpid);
    if port == 0 {
        tuis_fail(tag, "mock LLM 起不来", ok);
        return;
    }
    var slave_path: Buf = buf_new(64);
    defer { buf_free(&slave_path); }
    const m: i32 = tuis_open_pty(&slave_path, 100, 30);
    if m < 0 {
        tuis_fail(tag, "打不开 /dev/ptmx", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    }
    const cpid64: i64 = sys_fork() catch {
        _ = sys_close(m) catch {};
        tuis_fail(tag, "fork TUI 失败", ok);
        _ = sys_kill(mpid as i64, SIGKILL) catch {};
        return;
    };
    if cpid64 == 0 {
        tuis_child_run_tui_mouse(&slave_path, port, "build/selftest_ws_tui_pty" as &const byte, mouse);
        sys_exit(3);
        return;
    }
    const cpid: i32 = tuis_i32(cpid64);
    var cap: Buf = buf_new(131072);
    defer { buf_free(&cap); }
    // 首帧（进备用屏幕那一段就把鼠标序列写出来了）
    tuis_drain(m, &cap, 40);
    const has_on: bool = tuis_has(&cap, "\x1b[?1000h" as &const byte);
    if want_on && !has_on {
        tuis_fail(tag, "默认（mouse=true）的真 PTY 里没有开鼠标上报（1000h）", ok);
    }
    if !want_on && has_on {
        tuis_fail(tag, "mouse=false 的真 PTY 里仍然开了鼠标上报（1000h）—— 拖选复制会失效", ok);
    }
    if !want_on && tuis_has(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "mouse=false 的真 PTY 里仍然开了 SGR 鼠标（1006h）", ok);
    }
    _ = sys_kill(cpid as i64, SIGKILL) catch {};
    var stt: i32 = 0;
    _ = tuis_wait_raw(cpid, &stt, 20000);
    _ = sys_kill(mpid as i64, SIGKILL) catch {};
    _ = sys_close(m) catch {};
}

fn tui_mouse_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- A) 标志位：默认开；set_mouse 翻转；同值幂等 ----
    tuis_reset(100, 30);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "默认应当是开（滚轮依赖它）", &ok);
    }
    tui_set_mouse(false);
    if tui_mouse_enabled() {
        tuis_fail(tag, "tui_set_mouse(false) 没把状态翻过去", &ok);
    }
    tui_set_mouse(false);   // 幂等：不应崩、也不应再写序列
    if tui_mouse_enabled() {
        tuis_fail(tag, "tui_set_mouse(false) 重复调用把状态翻成了开", &ok);
    }
    tui_set_mouse(true);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "tui_set_mouse(true) 没把状态翻回来", &ok);
    }

    // ---- B) F2（两种编码）都翻转状态 ----
    tuis_reset(100, 30);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "F2 用例前置：默认应是开", &ok);
    }
    tui_keys_inject("\x1bOQ" as &const byte, 3);        // F2（SS3 形态）
    if tui_mouse_enabled() {
        tuis_fail(tag, "F2（ESC O Q）没有关掉鼠标上报", &ok);
    }
    tui_keys_inject("\x1bOQ" as &const byte, 3);        // 再按一次开回来
    if !tui_mouse_enabled() {
        tuis_fail(tag, "F2 第二下没有开回来", &ok);
    }
    tui_keys_inject("\x1b[12~" as &const byte, 5);      // F2（CSI 形态）
    if tui_mouse_enabled() {
        tuis_fail(tag, "F2 的 CSI 形态（ESC[12~）没有关掉鼠标上报", &ok);
    }
    // 翻回来后别让这一轮的状态漏给下一段
    tui_set_mouse(true);

    // ---- C) 命令：/mouse off / on / 裸 / 非法取值 ----
    tuis_reset(100, 30);
    tui_headless_enable(true);   // agent_cmd_mouse 先看 tui_active()（滚动模式只回一行说明）
    var line: Buf = buf_new(64);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "/mouse off");
    agent_cmd_mouse(&line);
    if tui_mouse_enabled() {
        tuis_fail(tag, "/mouse off 没有关掉鼠标上报", &ok);
    }
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/mouse on");
    agent_cmd_mouse(&line);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "/mouse on 没有开回来", &ok);
    }
    // 非法取值：状态不许被改（默认还是开）
    buf_reset(&line);
    _ = buf_append_cstr(&line, "/mouse bogus");
    agent_cmd_mouse(&line);
    if !tui_mouse_enabled() {
        tuis_fail(tag, "/mouse bogus 把状态改掉了（非法取值应当只报错）", &ok);
    }

    // ---- D) 字节级：真写进 pipe，开/关的序列逐字节 ----
    var fds: [i32: 2] = [0: 2];
    if (sys_pipe2(&fds[0], 0) catch { -1; }) != 0 {
        tuis_fail(tag, "pipe2 失败（字节级那条腿没跑成）", &ok);
        tui_reset_all();
        tui_headless_enable(true);
        tui_set_size(100, 30);
        return ok;
    }
    var cap: Buf = buf_new(4096);
    defer { buf_free(&cap); }

    // D1) 默认开：tui_term_enter 必须发 1000h + 1006h
    tuis_reset(100, 30);
    tui_set_mouse(true);
    tui_term_enter(fds[1]);
    tuis_mouse_enter(fds[0], &cap);
    if !bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "开鼠标时 tui_term_enter 没发 1000h", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "开鼠标时 tui_term_enter 没发 1006h", &ok);
    }

    // D2) 运行中关：立刻写 1006l + 1000l
    tui_set_mouse(false);
    tuis_mouse_enter(fds[0], &cap);
    if !bufx_contains(&cap, "\x1b[?1006l" as &const byte) {
        tuis_fail(tag, "运行中关鼠标没有写 1006l", &ok);
    }
    if !bufx_contains(&cap, "\x1b[?1000l" as &const byte) {
        tuis_fail(tag, "运行中关鼠标没有写 1000l", &ok);
    }
    if bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "运行中关鼠标却又写了 1000h", &ok);
    }

    // D3) 运行中再开：写 1000h + 1006h
    tui_set_mouse(true);
    tuis_mouse_enter(fds[0], &cap);
    if !bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "运行中再开鼠标没有写 1000h", &ok);
    }

    // D3b) 帮助浮层里必须写清这个出口（改了 help 文案就要钉住，否则以后又悄悄丢）
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    tui_help_open();
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_HELP {
        tuis_fail(tag, "/help 没有开出帮助浮层", &ok);
    } else {
        tui_build();
        if !tuis_screen_has("F2 切换鼠标上报" as &const byte) {
            tuis_fail(tag, "帮助浮层里没有 F2 切换鼠标上报那一条（用户找不到出口）", &ok);
        }
    }
    tui_overlay_close();
    tuis_reset(100, 30);
    tui_set_mouse(true);
    tui_term_enter(fds[1]);
    tuis_mouse_enter(fds[0], &cap);

    // D4) **关着进 TUI**：tui_term_enter 一个鼠标字节都不许发（这是「启动就能拖选」
    //     的关键 —— 若这里仍按默认开，`--no-mouse` 与 UYA_AGENT_MOUSE=0 就白给了）
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    tui_set_mouse(false);
    tui_term_enter(fds[1]);
    tuis_mouse_enter(fds[0], &cap);
    if bufx_contains(&cap, "\x1b[?1000h" as &const byte) {
        tuis_fail(tag, "关着进 TUI 时 tui_term_enter 仍发了 1000h（--no-mouse 会失效）", &ok);
    }
    if bufx_contains(&cap, "\x1b[?1006h" as &const byte) {
        tuis_fail(tag, "关着进 TUI 时 tui_term_enter 仍发了 1006h（--no-mouse 会失效）", &ok);
    }
    // 离开 TUI 仍要关鼠标（此刻其实是关着的，但 teardown 必须写 —— 免得上一轮开着时漏关）
    var leave_cap: Buf = buf_new(1024);
    defer { buf_free(&leave_cap); }
    tui_term_leave(fds[1]);
    tuis_mouse_enter(fds[0], &leave_cap);
    if !bufx_contains(&leave_cap, "\x1b[?1000l" as &const byte) {
        tuis_fail(tag, "离开 TUI 没有关鼠标上报（会拖累后面的 shell）", &ok);
    }

    // 收尾：收回 headless，关 pipe
    tui_reset_all();
    tui_headless_enable(true);
    tui_set_size(100, 30);
    _ = sys_close(fds[1]) catch {};
    _ = sys_close(fds[0]) catch {};

    // ---- E) 真 PTY：配置 → 终端序列这条端到端链（两个方向都量）----
    if !ws_prepare("build/selftest_ws_tui_pty" as &const byte) {
        tuis_fail(tag, "PTY 腿的工作目录准备失败", &ok);
    } else {
        tuis_mouse_spawn(true, true, tag, &ok);      // 默认开：PTY 里必须有 1000h
        tuis_mouse_spawn(false, false, tag, &ok);    // 关：PTY 里一个 1000h 都不许有
    }

    if ok {
        tuis_ok(tag, "鼠标上报开关（默认开 + 幂等 + F2 两种编码 + /mouse on·off·非法 + 字节级：进/关/再开/关着进都与开关一致 + 真 PTY 两个方向）");
    }
    return ok;
}


// ============================================================
// P37：/model 与 /effort 浮层（模型选择 / 推理强度选择）
// ============================================================
// fixture 用一份手写的 settings.yaml（真机那份一直在长，不能当断言基准）。
// 断言四件事：清单按提供方分组且当前项带 ✓；回车交回的行能反解出**模型名**；
// 强度浮层只列模型**公布**的档位；不公布档位的模型上 /effort 不开浮层、只给一行说明。
const TUIM_HOME: &const byte = "build/selftest_p37_tuim_home" as &const byte;

fn tuim_home_set() void {
    var hb: Buf = buf_new(128);
    defer { buf_free(&hb); }
    _ = buf_append_cstr(&hb, TUIM_HOME);
    _ = agent_set_dsh_home(hb.ptr[0: hb.len]);
}

fn tuim_fixture_write() bool {
    _ = sess_mkdir_p(TUIM_HOME);
    var p: Buf = buf_new(256);
    defer { buf_free(&p); }
    _ = buf_append_cstr(&p, TUIM_HOME);
    _ = buf_append_cstr_z(&p, "/settings.yaml");
    const body: &const byte = "llm-pi-ai:\n  providers:\n    {\n      alpha:\n        {\n          api: openai-responses,\n          baseURL: https://alpha.example/v1,\n          models:\n            [\n              { id: a-one },\n              { id: a-two, contextWindow: 333000, reasoningEfforts: { off: none, low: low, high: high } }\n            ]\n        },\n      beta:\n        {\n          api: openai-completions,\n          baseURL: https://beta.example/v1,\n          models: [ { id: b-plain, reasoningEfforts: false } ]\n        }\n    }\n" as &const byte;
    return write_text_file(p.ptr as &const byte, body);
}

fn tui_model_round(tag: &const byte) bool {
    var ok: bool = true;
    if !tuim_fixture_write() {
        tuis_fail(tag, "造 settings.yaml fixture 失败", &ok);
        return ok;
    }
    agent_models_reset();
    tuim_home_set();
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("a-one");
    cfg.provider = buf_from_cstr("alpha");
    cfg.provider_set = true;
    cfg.context_window = -1;
    agent_models_ensure(&cfg);
    if agent_models_count() != 3 {
        tuis_fail(tag, "目录条目数不是 3（alpha 2 + beta 1）", &ok);
        return ok;
    }

    // ---- 1) /model 浮层：分组标题 + ✓ 标当前 ----
    tuis_reset(100, 28);
    agent_model_overlay_open(&cfg);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_MODEL {
        tuis_fail(tag, "/model 没有开出模型浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("模型（enter 切换 · esc 取消）" as &const byte) {
        tuis_fail(tag, "模型浮层标题不对", &ok);
    }
    if !tuis_screen_has("# alpha" as &const byte) || !tuis_screen_has("# beta" as &const byte) {
        tuis_fail(tag, "模型浮层没有按提供方分组", &ok);
    }
    if !tuis_screen_has("a-two" as &const byte) || !tuis_screen_has("b-plain" as &const byte) {
        tuis_fail(tag, "模型浮层没有列出全部模型", &ok);
    }
    if !tuis_screen_has("effort: off, low, high" as &const byte) {
        tuis_fail(tag, "模型浮层没有显示公布的档位", &ok);
    }
    if !tuis_screen_has("（不公布推理档位）" as &const byte) {
        tuis_fail(tag, "非推理模型没有标成「不公布推理档位」", &ok);
    }
    // ✓ 只出现在当前模型（a-one）那一行
    var cur_ok: bool = false;
    var other_ok: bool = true;
    var r: usize = 0;
    while r < tui_nrows() {
        if tui_row_has(r, "✓" as &const byte) {
            if tui_row_has(r, "a-one" as &const byte) {
                cur_ok = true;
            } else {
                other_ok = false;
            }
        }
        r = r + 1;
    }
    if !cur_ok {
        tuis_fail(tag, "当前模型（a-one）那一行没有 ✓", &ok);
    }
    if !other_ok {
        tuis_fail(tag, "非当前模型的行也带了 ✓", &ok);
    }

    // ---- 2) 反解：分组行不是模型名、模型行是；选中 a-two 能切过去 ----
    var sel: Buf = buf_new(1024);
    defer { buf_free(&sel); }
    var mnm: Buf = buf_new(128);
    defer { buf_free(&mnm); }
    // 反解吃的是 Buf（浮层交回的就是 Buf）；先包一层
    var lgrp: Buf = buf_new(64);
    defer { buf_free(&lgrp); }
    _ = buf_append_cstr(&lgrp, "# alpha");
    if agent_model_item_parse(&lgrp, &mnm) {
        tuis_fail(tag, "分组行不该被反解成模型名", &ok);
    }
    var lmod: Buf = buf_new(128);
    defer { buf_free(&lmod); }
    _ = buf_append_cstr(&lmod, "  a-two  effort: off, low, high");
    if !agent_model_item_parse(&lmod, &mnm) {
        tuis_fail(tag, "普通模型行应当能反解出模型名", &ok);
    } else if !tuis_has(&mnm, "a-two" as &const byte) {
        tuis_fail(tag, "反解出来的不是 a-two", &ok);
    }
    // 键路：关掉再开，↓ 一次到 a-two。条目序是 [# alpha, a-one, a-two, # beta, b-plain]，
    // 而**游标默认停在当前模型（a-one，第 1 项）**上 —— 所以一次 ↓ 就是 a-two（早先按「从 0 起」
    // 写了两次 ↓，落到 # beta 上，回车交回的是分组行）。
    tui_overlay_close();
    agent_model_overlay_open(&cfg);
    tui_keys_inject("\x1b[B" as &const byte, 3);
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "模型浮层没有可交回的条目", &ok);
    } else if !agent_model_item_parse(&sel, &mnm) || !tuis_has(&mnm, "a-two" as &const byte) {
        tuis_fail(tag, "↓ + 回车没有落在 a-two 那一行", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "模型浮层没有交出选中项", &ok);
    }
    _ = agent_tui_model_handle(&cfg, null as &History, &sel);
    if !tuis_has(&cfg.model, "a-two" as &const byte) {
        tuis_fail(tag, "选中 a-two 之后 cfg.model 没换", &ok);
    }
    if cfg.context_window == -1 {
        tuis_fail(tag, "选中 a-two 之后能力没跟随（context_window 还是 -1）", &ok);
    }

    // ---- 3) /effort 浮层：只列公布的档位 ----
    tui_overlay_close();
    agent_effort_overlay_open(&cfg);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_EFFORT {
        tuis_fail(tag, "/effort 没有开出强度浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("推理强度（enter 切换 · esc 取消）" as &const byte) {
        tuis_fail(tag, "强度浮层标题不对", &ok);
    }
    if !tuis_screen_has("high" as &const byte) || !tuis_screen_has("low" as &const byte) {
        tuis_fail(tag, "强度浮层没有列出公布的档位", &ok);
    }
    if tuis_screen_has("medium" as &const byte) {
        tuis_fail(tag, "强度浮层列出了没公布的档位（medium）—— 不该发明档位", &ok);
    }
    var esel: Buf = buf_new(256);
    defer { buf_free(&esel); }
    var ev: Buf = buf_new(64);
    defer { buf_free(&ev); }
    var lef: Buf = buf_new(64);
    defer { buf_free(&lef); }
    _ = buf_append_cstr(&lef, "✓ high");
    if !agent_effort_item_parse(&lef, &ev) || !tuis_has(&ev, "high" as &const byte) {
        tuis_fail(tag, "强度行反解不出档位名", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_take(&esel) {
        tuis_fail(tag, "强度浮层没有交出选中项", &ok);
    } else {
        _ = agent_tui_model_handle(&cfg, null as &History, &esel);
        if cfg.reasoning_effort.len == 0 || !cfg.effort_set {
            tuis_fail(tag, "选中的档位没有落到 cfg.reasoning_effort", &ok);
        }
    }

    // ---- 4) 不公布档位的模型：/effort 不开浮层、只给一行说明 ----
    _ = agent_model_apply(&cfg, "beta" as &const byte, 4, "b-plain" as &const byte, 7,
        "human" as &const byte, false);
    tui_overlay_close();
    agent_effort_overlay_open(&cfg);
    if tui_overlay_open() {
        tuis_fail(tag, "不公布档位的模型上 /effort 不该开浮层（那会是个做不到事的控件）", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("没有公布推理档位" as &const byte) {
        tuis_fail(tag, "不公布档位时没有留下可见说明", &ok);
    }

    // ---- 5) 信息行里的强度：设了才挂 `· <强度>`，清掉就一个字节都不多 ----
    tuis_reset(100, 28);
    tui_set_effort("high" as &const byte, 4);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has(" · high" as &const byte) {
        tuis_fail(tag, "信息行没有显示推理强度", &ok);
    }
    tui_set_effort("" as &const byte, 0);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if tuis_screen_has(" · high" as &const byte) {
        tuis_fail(tag, "清掉强度之后还在画它", &ok);
    }

    agent_models_reset();
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（/model 分组+✓+反解 / /effort 只列公布档位 / 非推理模型不开浮层 / 信息行强度）\n");
    }
    return ok;
}

// ============================================================
// P41：/worktree 的动作选择浮层（+ finish/discard 的二次确认）
// ============================================================
// 两段：
//   A) 不需要 git：浮层排版（标题 / 七个动作 / ✓ 标当前模式）、反解（认动作行，不认
//      「取消」与别的浮层的条目）、默认游标 = status、不可逆动作**选定不生效**；
//   B) 真 git：建 worktree → 键盘走到 finish → 确认浮层上**什么都不许动**（目录还在、
//      phase 还是 READY）→ 只按回车（游标默认停在「取消」）同样什么都不做 →
//      真的把游标挪到 finish 那一行才合并 + 删除。
// fixture 是 pid 独占的 /tmp 仓（与 P37 那两轮同一套理由：整轮 selftest 会 fork 出一堆
// 子进程，共享目录会互相踩；相对路径会被前面几轮的 chdir 带跑）。造仓复用 selftest.uya
// 的 wt_fixture_make（同一份 fixture，不写第二遍）。
fn tuis_wt_ws_pid(out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, "/tmp/selftest_p41_wt_");
    const pid: i64 = sys_getpid() catch { 0 as i64; };
    _ = buf_append_i64(out, pid);
}

// 路径 + 尾 NUL（fs_stat / write_text_file 收 C 字符串；Buf.ptr 没有尾 NUL）
fn tuis_wt_z(src: &const Buf, suffix: &const byte, out: &Buf) void {
    buf_reset(out);
    _ = buf_append(out, src.ptr as &const byte, src.len);
    _ = buf_append_cstr_z(out, suffix);
}

fn tuis_wt_exists(path_z: &const byte) bool {
    var st: FsStat = FsStat{ exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0 };
    _ = fs_stat(path_z, &st);
    return st.exists;
}

// ============================================================
// tui-watch-pick：/watch 现役清单 ↔ 「选中即跟随」这一条链（P46）
// ============================================================
// 用户报的「敲了 /watch 没反应」在 TUI 里是三件事叠在一起，逐个钉住：
//   A) 清单浮层的 kind 必须是**自己的** TUI_OVK_WATCH_LIST —— 以前借 /tasks 的
//      TUI_OVK_TASKS，而那个 kind 在接收端是「纯查看」语义，回车交出来的行没人接、
//      被静默丢掉（「选中代理」与「什么都没发生」是同一屏）；
//   B) 默认游标要落在**第一个代理行**上（第 0 行是表头）：不放的话「打开就回车」落在表头上，
//      用户拿到的是一句「没认出编号」；
//   C) 选中之后的**每条失败路**都要有回执：认不出编号、目标已经不在了（清单还开着的时候
//      子代理可能刚跑完）、目标写错（`/watch sub-9`）——静默是最难查的一种。
// 真终端那半（清单 → 回车 → 跟随浮层 + 实时事件）走 `make e2e-watch-pick`。
fn tui_watch_pick_round(tag: &const byte) bool {
    var ok: bool = true;
    const wsa: &const byte = "build/selftest_ws_watch_pick" as &const byte;
    if !ws_prepare(wsa) {
        tuis_fail(tag, "工作目录准备失败", &ok);
        return false;
    }
    var c: Config = cfg_default();
    tuis_cmd_cfg(&c, wsa);
    defer { cfg_free(&c); }
    var h: History = hist_init();
    defer { hist_free(&h); }

    // ---- A) 裸 /watch 走 agent_tui_command 这条真路：开出清单浮层，kind 是 WATCH_LIST ----
    tuis_reset(100, 30);
    tui_set_commands(TUIS_ACC_CMDS, bufx_cstr_len(TUIS_ACC_CMDS));
    tui_begin_session();
    var cmd: Buf = buf_new(32);
    defer { buf_free(&cmd); }
    _ = buf_append_cstr(&cmd, "/watch");
    _ = agent_tui_command(&c, &h, &cmd);
    if !tui_overlay_open() {
        tuis_fail(tag, "裸 /watch 没有开出清单浮层", &ok);
        return ok;
    }
    if tui_overlay_kind() != TUI_OVK_WATCH_LIST {
        tuis_fail(tag, "清单浮层的 kind 不是 TUI_OVK_WATCH_LIST（借 /tasks 的 kind ⇒ 回车的结果没人接）", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("跟随子代理（" as &const byte) {
        tuis_fail(tag, "清单浮层没有画出来", &ok);
    }
    if !tuis_screen_has("回车跟随" as &const byte) {
        tuis_fail(tag, "清单标题里没写「回车跟随」（用户不知道回车能干什么）", &ok);
    }
    if !tuis_screen_has("（没有正在跑的子代理）" as &const byte) {
        tuis_fail(tag, "现役空态没画出来（清单内容不是 agent_watch_list 那一份？）", &ok);
    }

    // ---- B) 默认游标 = 第一个代理行（纯函数，喂一份带表头的清单）----
    var items: Buf = buf_new(512);
    defer { buf_free(&items); }
    _ = buf_append_cstr(&items,
        "[watch] 现役子代理（/watch sub-N 跟随，/watch off 停）：\n  sub-1 [running] a\n  sub-2 [idle] b\n");
    if agent_watch_list_first_row(&items) != 1 {
        tuis_fail(tag, "默认游标没落在第一个代理行上（打开就回车会落在表头上）", &ok);
    }
    buf_reset(&items);
    _ = buf_append_cstr(&items, "[watch] 现役子代理（/watch sub-N 跟随，/watch off 停）：\n  （没有正在跑的子代理）\n");
    if agent_watch_list_first_row(&items) != 0 {
        tuis_fail(tag, "空态清单的游标不该越界", &ok);
    }

    // ---- C1) 回车：浮层把**选中行原文**交出来（且交给主循环那条落点）----
    tui_keys_inject("\r" as &const byte, 1);
    var got: Buf = buf_new(256);
    defer { buf_free(&got); }
    if !tui_overlay_take(&got) {
        tuis_fail(tag, "清单没把选中行交出来（回车的结果被丢了？）", &ok);
    }
    // 空态清单上选中行是表头：认不出编号 ⇒ 必须落一条 notice，不许静默
    if agent_tui_watch_pick(&c, &got) {
        tuis_fail(tag, "空态清单上回车不该开始跟随", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("没认出子代理编号" as &const byte) {
        tuis_fail(tag, "选中表头行时没有回执（静默）", &ok);
    }

    // ---- C2) 选中一个**已经不在**的编号：回执里要点名（清单开着时子代理可能刚跑完）----
    var fake: Buf = buf_new(64);
    defer { buf_free(&fake); }
    _ = buf_append_cstr(&fake, "  sub-7 [running] 早就跑完了");
    if agent_tui_watch_pick(&c, &fake) {
        tuis_fail(tag, "目标不存在却报「已开始跟随」", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("没有 sub-7 这个子代理" as &const byte) {
        tuis_fail(tag, "目标不存在时没有回执（TUI 里就是「敲了没反应」）", &ok);
    }

    // ---- C3) /watch 的三种落点码（TUI 靠它决定开哪张浮层、要不要给回执）----
    var out: Buf = buf_new(256);
    defer { buf_free(&out); }
    if agent_cmd_watch(&c, "" as &const byte, 0, &out) != WATCH_CMD_LIST {
        tuis_fail(tag, "裸 /watch 该回 WATCH_CMD_LIST", &ok);
    }
    buf_reset(&out);
    if agent_cmd_watch(&c, " sub-9" as &const byte, 6, &out) != WATCH_CMD_BAD {
        tuis_fail(tag, "不存在的编号该回 WATCH_CMD_BAD（回 true 的话回执会被丢掉）", &ok);
    }
    buf_reset(&out);
    if agent_cmd_watch(&c, " off" as &const byte, 4, &out) != WATCH_CMD_STOPPED {
        tuis_fail(tag, "/watch off 该回 WATCH_CMD_STOPPED", &ok);
    }

    // ---- D) 回合运行中敲 /watch sub-1：只读命令要能**当场**派发（不许被当成给模型的文本）----
    var live: Buf = buf_new(32);
    defer { buf_free(&live); }
    _ = buf_append_cstr(&live, "/watch sub-1");
    if !agent_tui_cmd_safe(&live) {
        tuis_fail(tag, "带参数的 /watch 不在「只读当场派发」集合里（回合里敲它会等到回合结束）", &ok);
    }
    if agent_steer_line(&live) {
        tuis_fail(tag, "泵点上下文没登记时不该当场派发（那条路归主循环）", &ok);
    }
    var txt: Buf = buf_new(32);
    defer { buf_free(&txt); }
    _ = buf_append_cstr(&txt, "顺便看看日志");
    if agent_steer_line(&txt) {
        tuis_fail(tag, "普通文本不该被当成命令派发", &ok);
    }

    if ok {
        tuis_ok(tag, "清单 kind 是自己的（回车结果有人接）+ 默认游标在第一个代理行 + 选中即跟随的三条失败路都有回执 + 三种落点码 + 带参数的 /watch 在只读集合里" as &const byte);
    }
    return ok;
}

fn tui_worktree_round(tag: &const byte) bool {
    var ok: bool = true;
    wt_set_on(false);
    wt_reset();
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if !agent_getcwd_into(&root) {
        tuis_fail(tag, "拿不到仓库根", &ok);
        return ok;
    }
    defer { wst_back(&root); }
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_from_cstr("wt-model");
    var h: History = hist_init();
    defer { hist_free(&h); }
    var sel: Buf = buf_new(1024);
    defer { buf_free(&sel); }
    var act: Buf = buf_new(64);
    defer { buf_free(&act); }
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    var cmd: Buf = buf_new(64);
    defer { buf_free(&cmd); }

    // ---- A1) 裸 /worktree（走 agent_tui_command 那条真路）→ 动作选择浮层 ----
    tuis_reset(100, 28);
    tui_overlay_close();
    _ = buf_append_cstr(&cmd, "/worktree");
    _ = agent_tui_command(&cfg, &h, &cmd);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_WORKTREE {
        tuis_fail(tag, "裸 /worktree 没有开出动作选择浮层", &ok);
        return ok;
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("Git worktree（enter 执行 · esc 取消）" as &const byte) {
        tuis_fail(tag, "动作浮层的标题不对", &ok);
    }
    var i: usize = 0;
    while i < WT_ACT_N {
        if !tuis_screen_has(wt_act_name(i)) {
            tuis_fail(tag, "动作浮层里少了某个动作（动作表与排版对不上）", &ok);
        }
        i = i + 1;
    }
    if !tuis_screen_has("合并回基分支" as &const byte) {
        tuis_fail(tag, "动作行没有带一行说明", &ok);
    }
    // 模式关：✓ 只挂在 off 那一行
    if !tuis_screen_has("✓ off" as &const byte) {
        tuis_fail(tag, "模式关时 ✓ 没有挂在 off 那一行", &ok);
    }
    if tuis_screen_has("✓ on" as &const byte) {
        tuis_fail(tag, "模式关时 on 那一行也带了 ✓", &ok);
    }
    // 模式开：✓ 跟着挪过去
    wt_set_on(true);
    tui_overlay_close();
    agent_tui_worktree_open();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("✓ on" as &const byte) {
        tuis_fail(tag, "模式开时 ✓ 没挪到 on 那一行", &ok);
    }
    if tuis_screen_has("✓ off" as &const byte) {
        tuis_fail(tag, "模式开时 off 那一行还挂着 ✓", &ok);
    }
    wt_set_on(false);
    tui_overlay_close();

    // ---- A2) 反解：动作行认得出，别的浮层的条目与「取消」认不出 ----
    agent_tui_worktree_line(WT_ACT_STATUS, &line);
    if !agent_tui_worktree_parse(&line, &act) || !tuis_has(&act, "status" as &const byte) {
        tuis_fail(tag, "status 行反解不出动作名", &ok);
    }
    agent_tui_worktree_line(WT_ACT_FINISH, &line);
    if !agent_tui_worktree_parse(&line, &act) || !tuis_has(&act, "finish" as &const byte) {
        tuis_fail(tag, "finish 行反解不出动作名", &ok);
    }
    if wt_act_needs_confirm(&act) == false {
        tuis_fail(tag, "finish 没被判成需要确认的不可逆动作", &ok);
    }
    var alien: Buf = buf_new(64);
    defer { buf_free(&alien); }
    _ = buf_append_cstr(&alien, "取消");
    if agent_tui_worktree_parse(&alien, &act) {
        tuis_fail(tag, "「取消」被反解成了动作（那会误执行）", &ok);
    }
    buf_reset(&alien);
    _ = buf_append_cstr(&alien, "✓ Read Only        — 只读");
    if agent_tui_worktree_parse(&alien, &act) {
        tuis_fail(tag, "别的浮层的条目被反解成了动作", &ok);
    }
    buf_reset(&alien);
    _ = buf_append_cstr(&alien, "✓ discard");
    if !agent_tui_worktree_parse(&alien, &act) || !tuis_has(&act, "discard" as &const byte) {
        tuis_fail(tag, "带 ✓ 的动作行反解不出动作名", &ok);
    }
    if wt_act_needs_confirm(&act) == false {
        tuis_fail(tag, "discard 没被判成需要确认的不可逆动作", &ok);
    }

    // ---- A3) 打开就回车 = status（游标默认落在 status，P37 的老手感不变）----
    tui_overlay_close();
    agent_tui_worktree_open();
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "动作浮层没有可交回的条目", &ok);
    } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "status" as &const byte) {
        tuis_fail(tag, "打开就回车没有落在 status 那一行", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "动作浮层没有交出选中项", &ok);
    }
    _ = agent_tui_worktree_handle(&cfg, &h, &sel);
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("worktree mode is off" as &const byte) {
        tuis_fail(tag, "status 的结果没有落进转录", &ok);
    }

    // ---- A4) on / off：真翻模式，结果以 notice 落进转录 ----
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(0, &line);          // on 那一行
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if !wt_on() {
        tuis_fail(tag, "选 on 之后模式没打开", &ok);
    }
    // 浮层还开着会盖住转录：先关掉再看屏幕（看得见的才是「落进转录」）
    tui_overlay_close();
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("worktree 模式：开" as &const byte) {
        tuis_fail(tag, "on 的结果没有落进转录", &ok);
    }
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(1, &line);          // off 那一行
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if wt_on() {
        tuis_fail(tag, "选 off 之后模式没关掉", &ok);
    }

    // ---- A5) finish / discard：选定**不生效**，先翻确认浮层；默认游标在「取消」----
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(WT_ACT_FINISH, &line);
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if !tui_overlay_open() || tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
        tuis_fail(tag, "选 finish 没有翻出确认浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("确认 finish？" as &const byte) {
        tuis_fail(tag, "确认浮层的标题不对", &ok);
    }
    if wt_phase() != WT_PHASE_NONE {
        tuis_fail(tag, "还没确认就动了 worktree（phase 变了）", &ok);
    }
    tui_keys_inject("\r" as &const byte, 1);
    if !tui_overlay_peek(&sel) {
        tuis_fail(tag, "确认浮层没有可交回的条目", &ok);
    } else if agent_tui_worktree_parse(&sel, &act) {
        tuis_fail(tag, "确认浮层的默认游标不在「取消」上（回车会真执行）", &ok);
    }
    if !tui_overlay_take(&sel) {
        tuis_fail(tag, "确认浮层没有交出选中项", &ok);
    }
    _ = agent_tui_worktree_handle(&cfg, &h, &sel);
    if wt_phase() != WT_PHASE_NONE {
        tuis_fail(tag, "取消之后 worktree 状态被动了", &ok);
    }
    if tui_overlay_open() {
        tuis_fail(tag, "取消之后浮层还开着", &ok);
    }
    // discard 走同一条闸门（标题与提示词是另一份，得单独看一眼）
    tui_overlay_close();
    agent_tui_worktree_open();
    agent_tui_worktree_line(WT_ACT_DISCARD, &line);
    _ = agent_tui_worktree_handle(&cfg, &h, &line);
    if tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
        tuis_fail(tag, "选 discard 没有翻出确认浮层", &ok);
    }
    tui_build();
    tuis_scan_rows(100, &ok, tag);
    if !tuis_screen_has("确认 discard？" as &const byte) {
        tuis_fail(tag, "discard 的确认浮层标题不对", &ok);
    }
    if wt_phase() != WT_PHASE_NONE {
        tuis_fail(tag, "discard 还没确认就动了 worktree", &ok);
    }
    tui_overlay_close();

    // ---- B) 真 git：确认之前一个字节都不许动，确认之后才合并 + 删除 ----
    if !gitx_available() {
        out_err("selftest[");
        out_err(tag);
        out_err("] skip B（本机 PATH 里没有 git）\n");
    } else {
        var errout: Buf = buf_new(4096);
        defer { buf_free(&errout); }
        var wsz: Buf = buf_new(128);
        defer { buf_free(&wsz); }
        tuis_wt_ws_pid(&wsz);
        if !wt_fixture_make(&wsz, &errout) {
            tuis_fail(tag, "造 fixture 仓失败", &ok);
        } else {
            wt_reset();
            wt_set_on(true);
            const prc: i32 = wt_provision(&cfg, wsz.ptr as &const byte, wsz.len,
                "session-41414141-4141-4141-8141-414141414141" as &const byte, 43);
            if prc != 0 || !wt_ready() {
                tuis_fail(tag, "wt_provision 没建出 worktree", &ok);
                const stx: &const WtState = wt_state();
                out_err("  note=");
                out_err_bytes(stx.note.ptr as &const byte, stx.note.len);
                out_err("\n");
            } else {
                const st0: &const WtState = wt_state();
                var wtz: Buf = buf_new(1200);
                defer { buf_free(&wtz); }
                tuis_wt_z(&st0.worktree_path, "/p41.txt" as &const byte, &wtz);
                if !write_text_file(wtz.ptr as &const byte, "p41 from the worktree\n" as &const byte) {
                    tuis_fail(tag, "往 worktree 里写文件失败", &ok);
                }
                var wtrootz: Buf = buf_new(1200);
                defer { buf_free(&wtrootz); }
                tuis_wt_z(&st0.worktree_path, "" as &const byte, &wtrootz);
                var mergedz: Buf = buf_new(1200);
                defer { buf_free(&mergedz); }
                tuis_wt_z(&wsz, "/p41.txt" as &const byte, &mergedz);

                // 键盘走一遍：浮层 → ↓（status→finish）→ 回车 → 确认浮层
                tui_overlay_close();
                agent_tui_worktree_open();
                tui_keys_inject("\x1b[B" as &const byte, 3);
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_peek(&sel) {
                    tuis_fail(tag, "动作浮层没有可交回的条目", &ok);
                } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "finish" as &const byte) {
                    tuis_fail(tag, "↓ 一次没有落在 finish 那一行", &ok);
                }
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "动作浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
                    tuis_fail(tag, "finish 没有翻成确认浮层", &ok);
                }
                if wt_phase() != WT_PHASE_READY {
                    tuis_fail(tag, "还没确认就把 worktree 合并/删掉了", &ok);
                }
                if !tuis_wt_exists(wtrootz.ptr as &const byte) {
                    tuis_fail(tag, "还没确认 worktree 目录就没了", &ok);
                }
                // 确认浮层上只按回车（默认游标 = 取消）：什么都不该发生
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_peek(&sel) {
                    tuis_fail(tag, "确认浮层没有可交回的条目", &ok);
                } else if agent_tui_worktree_parse(&sel, &act) {
                    tuis_fail(tag, "确认浮层的默认游标不在「取消」上", &ok);
                }
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "确认浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if wt_phase() != WT_PHASE_READY {
                    tuis_fail(tag, "取消之后 worktree 的 phase 变了", &ok);
                }
                if !tuis_wt_exists(wtrootz.ptr as &const byte) {
                    tuis_fail(tag, "取消之后 worktree 目录没了", &ok);
                }
                if tuis_wt_exists(mergedz.ptr as &const byte) {
                    tuis_fail(tag, "取消之后改动竟然合并到主干上了", &ok);
                }
                // 真的确认：重新走到确认浮层，把游标从「取消」挪到 finish 那一行
                tui_overlay_close();
                agent_tui_worktree_open();
                tui_keys_inject("\x1b[B" as &const byte, 3);
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "动作浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if tui_overlay_kind() != TUI_OVK_WORKTREE_CONFIRM {
                    tuis_fail(tag, "第二次选 finish 没有翻出确认浮层", &ok);
                }
                tui_keys_inject("\x1b[A" as &const byte, 3);   // 取消 → finish 那一行
                tui_keys_inject("\r" as &const byte, 1);
                if !tui_overlay_peek(&sel) {
                    tuis_fail(tag, "确认浮层没有可交回的条目", &ok);
                } else if !agent_tui_worktree_parse(&sel, &act) || !tuis_has(&act, "finish" as &const byte) {
                    tuis_fail(tag, "↑ 一次没有落在 finish 那一行", &ok);
                }
                if !tui_overlay_take(&sel) {
                    tuis_fail(tag, "确认浮层没有交出选中项", &ok);
                }
                _ = agent_tui_worktree_handle(&cfg, &h, &sel);
                if wt_phase() != WT_PHASE_FINISHED {
                    tuis_fail(tag, "确认之后没有走完 finish", &ok);
                }
                if tuis_wt_exists(wtrootz.ptr as &const byte) {
                    tuis_fail(tag, "finish 之后 worktree 目录还在", &ok);
                }
                if !tuis_wt_exists(mergedz.ptr as &const byte) {
                    tuis_fail(tag, "finish 之后主干上没有合并进来的文件", &ok);
                }
                tui_build();
                tuis_scan_rows(100, &ok, tag);
                if !tuis_screen_has("removed worktree" as &const byte) {
                    tuis_fail(tag, "finish 的结果没有落进转录", &ok);
                }
            }
        }
    }
    wt_set_on(false);
    wt_reset();
    tui_overlay_close();
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok（浮层排版+✓ / 反解只认动作行 / 默认游标=status / finish·discard 先确认 / 真 git：确认前不动、确认后才合并删除）\n");
    }
    return ok;
}
