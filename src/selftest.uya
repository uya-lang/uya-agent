// ============================================================
// mock LLM 服务端（跑在 fork 出的子进程里）
// ============================================================
fn count_sub(hay: &const Buf, needle: &const byte) i32 {
    const view: &[byte] = hay.ptr[0: hay.len];
    const pat: &[byte] = needle[0: strlen(needle)];
    if pat.len == 0 {
        return 0;
    }
    var n: i32 = 0;
    var from: usize = 0;
    while true {
        const at: isize = find_sub(view, pat, from);
        if at < 0 {
            break;
        }
        n = n + 1;
        from = (at as usize) + pat.len;
    }
    return n;
}

fn contains(hay: &const Buf, needle: &const byte) bool {
    const view: &[byte] = hay.ptr[0: hay.len];
    return find_sub(view, needle[0: strlen(needle)], 0) >= 0;
}

fn mock_read_request(cfd: i32, rx: &Buf) bool {
    var tmp: [byte: 4096] = [0: 4096];
    while true {
        const n: isize = sys_read(cfd, &tmp[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            return false;
        }
        if !buf_append(rx, &tmp[0], n as usize) {
            return false;
        }
        const view: &[byte] = rx.ptr[0: rx.len];
        const he: isize = find_sub(view, &"\r\n\r\n"[0: 4], 0);
        if he >= 0 {
            const head_end: usize = (he as usize) + 4;
            var need: usize = 0;
            var cl_off: usize = 0;
            var cl_len: usize = 0;
            if head_value(view, head_end, &"content-length"[0: 14], &cl_off, &cl_len) && cl_len > 0 {
                const want: i64 = parse_u64_at(view, cl_off, cl_len);
                if want > 0 {
                    need = want as usize;
                }
            }
            if rx.len >= head_end + need {
                return true;
            }
        }
    }
}

// 完整响应体 → 一帧 SSE：把 "message" 键换成 "delta"，补齐 [DONE]。
// 非流式与流式的响应体除了这个键名之外结构一致，所以这层转换足以让同一份
// mock 数据同时覆盖两条路径（且 arguments 会一次性给全）。
fn sse_from_body(body: &const Buf, out: &Buf) bool {
    var i: usize = 0;
    while i < body.len {
        if i + 9 <= body.len && bufx_eq_cstr(&body.ptr[i] as &const byte, 9, "\"message\"") {
            if !buf_append_cstr(out, "\"delta\"") {
                return false;
            }
            i = i + 9;
            continue;
        }
        if !buf_append_byte(out, body.ptr[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 与 mock_send_sse 相同，但**不发 [DONE]**（用于中断/截断测试）
fn mock_send_sse_nodone(cfd: i32, body: &const Buf) bool {
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    if !buf_append_cstr(&text, "data: ") {
        return false;
    }
    if !sse_from_body(body, &text) {
        return false;
    }
    if !buf_append_cstr(&text, "\n\n") {
        return false;
    }
    var head: Buf = buf_new(256);
    defer { buf_free(&head); }
    _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n");
    _ = buf_append_u64_hex(&head, text.len);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append(&head, text.ptr, text.len);
    _ = buf_append_cstr(&head, "\r\n");
    https_write_all(cfd, &head.ptr[0] as &const byte, head.len) catch {
        return false;
    };
    return true;
}

// 以 SSE（chunked，两段 chunk）回一个完整响应体
fn mock_send_sse(cfd: i32, body: &const Buf) bool {
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    if !buf_valid(&text) {
        return false;
    }
    if !buf_append_cstr(&text, "data: ") {
        return false;
    }
    if !sse_from_body(body, &text) {
        return false;
    }
    if !buf_append_cstr(&text, "\n\ndata: [DONE]\n\n") {
        return false;
    }

    var head: Buf = buf_new(256);
    defer { buf_free(&head); }
    _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n");
    const half: usize = text.len / 2;
    _ = buf_append_u64_hex(&head, half);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append(&head, text.ptr, half);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append_u64_hex(&head, text.len - half);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append(&head, &text.ptr[half], text.len - half);
    _ = buf_append_cstr(&head, "\r\n0\r\n\r\n");
    https_write_all(cfd, &head.ptr[0] as &const byte, head.len) catch {
        return false;
    };
    return true;
}

fn mock_send(cfd: i32, body: &const Buf) bool {
    var head: Buf = buf_new(256);
    defer { buf_free(&head); }
    if !buf_valid(&head) {
        return false;
    }
    _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: ");
    _ = buf_append_u64(&head, body.len as u64);
    _ = buf_append_cstr(&head, "\r\n\r\n");
    https_write_all(cfd, &head.ptr[0] as &const byte, head.len) catch {
        return false;
    };
    https_write_all(cfd, body.ptr as &const byte, body.len) catch {
        return false;
    };
    return true;
}

// chunked 响应：顺带覆盖客户端的 chunked 解码路径
fn mock_send_chunked(cfd: i32, body: &const Buf) bool {
    var head: Buf = buf_new(256);
    defer { buf_free(&head); }
    if !buf_valid(&head) {
        return false;
    }
    _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n");
    const half: usize = body.len / 2;
    _ = buf_append_u64_hex(&head, half);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append(&head, body.ptr, half);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append_u64_hex(&head, body.len - half);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append(&head, &body.ptr[half], body.len - half);
    _ = buf_append_cstr(&head, "\r\n0\r\n\r\n");
    https_write_all(cfd, &head.ptr[0] as &const byte, head.len) catch {
        return false;
    };
    return true;
}

fn buf_append_u64_hex(b: &Buf, v: usize) bool {
    const hexd: &[byte] = &"0123456789abcdef"[0: 16];
    var tmp: [byte: 16] = [0: 16];
    var n: usize = v;
    var i: usize = 0;
    if n == 0 {
        return buf_append_byte(b, 48);
    }
    while n > 0 && i < 16 {
        tmp[i] = hexd[n % (16 as usize)];
        n = n / (16 as usize);
        i = i + 1;
    }
    while i > 0 {
        i = i - 1;
        if !buf_append_byte(b, tmp[i]) {
            return false;
        }
    }
    return true;
}

// HTTP 401 + 错误体
fn mock_send_401(cfd: i32, body: &const Buf) bool {
    var head: Buf = buf_new(256);
    defer { buf_free(&head); }
    _ = buf_append_cstr(&head, "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: ");
    _ = buf_append_u64(&head, body.len as u64);
    _ = buf_append_cstr(&head, "\r\n\r\n");
    https_write_all(cfd, &head.ptr[0] as &const byte, head.len) catch {
        return false;
    };
    const w2: !void = https_write_all(cfd, body.ptr as &const byte, body.len);
    _ = w2 catch {
        return false;
    };
    return true;
}

// 期望落盘的字节（真实换行 + 真实引号）
fn esc_content() &byte {
    return "line1\nline2 \"q\" tail" as &byte;
}

// 用 JsonWriter 生成 write_file 的 arguments：
// 内层 JSON 由 writer 正确转义，再作为一个 JSON 字符串塞进 arguments。
fn mock_call_escaped(w: &JsonWriter, id: &const byte, name: &const byte, path: &const byte, content: &const byte) void {
    var inner: Buf = buf_new(256);
    var wi: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&wi, inner.ptr, inner.cap);
    jw_byte(&wi, 123);
    jw_key(&wi, "file_path");
    jw_str_cstr(&wi, path);
    jw_byte(&wi, 44);
    jw_key(&wi, "content");
    jw_str_cstr(&wi, content);
    jw_byte(&wi, 125);
    if jw_overflow(&wi) {
        buf_free(&inner);
        return;
    }
    inner.len = jw_used(&wi);
    jw_byte(w, 123);
    jw_key(w, "id");
    jw_str_cstr(w, id);
    jw_byte(w, 44);
    jw_key(w, "type");
    jw_str_cstr(w, "function");
    jw_byte(w, 44);
    jw_key(w, "function");
    jw_byte(w, 123);
    jw_key(w, "name");
    jw_str_cstr(w, name);
    jw_byte(w, 44);
    jw_key(w, "arguments");
    jw_str(w, inner.ptr, inner.len);      // 整段内层 JSON 作为字符串（转义由 writer 负责）
    jw_byte(w, 125);
    jw_byte(w, 125);
    buf_free(&inner);
}

// 一轮里塞多个工具调用：正常写/读文件 / 越权路径 / 超时被杀
fn mock_toolcall_tools_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-tools");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    // 1) write_file：content 里**带换行和引号**，专门盯住「字段值必须再反转义一次」这个坑
    mock_call_escaped(&w, "call_w1", "write", "esc.txt", esc_content());
    jw_byte(&w, 44);
    // 2) read_file 读回同一文件
    mock_call(&w, "call_r1", "read", "{\"file_path\":\"esc.txt\"}");
    jw_byte(&w, 44);
    // 3) read_file 越权（应被路径守卫拒绝）
    mock_call(&w, "call_r2", "read", "{\"file_path\":\"../escape.txt\"}");
    jw_byte(&w, 44);
    // 4) run_shell 超时（应被 SIGKILL 并回 timeout）
    mock_call(&w, "call_r3", "bash", "{\"command\":\"sleep 5\",\"description\":\"sleep to test timeout\",\"timeoutMs\":300}");
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

fn mock_call(w: &JsonWriter, id: &const byte, name: &const byte, args_json: &const byte) void {
    jw_byte(w, 123);
    jw_key(w, "id");
    jw_str_cstr(w, id);
    jw_byte(w, 44);
    jw_key(w, "type");
    jw_str_cstr(w, "function");
    jw_byte(w, 44);
    jw_key(w, "function");
    jw_byte(w, 123);
    jw_key(w, "name");
    jw_str_cstr(w, name);
    jw_byte(w, 44);
    jw_key(w, "arguments");
    jw_str_cstr(w, args_json);
    jw_byte(w, 125);
    jw_byte(w, 125);
}

// 返回 0 表示 mock 端所有断言通过
fn mock_server(lfd: i32) i32 {
    var round: i32 = 0;
    var verdict: i32 = 0;
    var limit: i32 = 2;
    var is_stream: bool = false;   // 由每轮请求体决定
    if mock_mode == 3 {
        limit = 1;          // 401 轮：只服务一次，agent 拿到 401 就该退出
    }
    if mock_mode == 5 {
        limit = 3;          // 熔断轮：agent 的 max_steps 是 3
    }
    if mock_mode == 6 {
        limit = 1;          // 中断轮：客户端被打断后不会再发请求，只服务一次
    }
    if mock_mode == 12 {
        limit = 1;          // 压缩轮：只断言「压缩之后的那一次请求」（摘要请求不占轮次）
    }
    if mock_mode == 13 {
        limit = 2;          // 技能轮：工具轮 → 断言轮（/messages 不算轮次）
    }
    if mock_mode == 14 {
        limit = 2;          // 派生轮：工具轮 → 断言轮（子代理的请求不算轮次）
    }
    if mock_mode == 16 {
        limit = 1;          // workflow 轮：假脚本只派 1 个子代理
    }
    if mock_mode == 17 {
        limit = 15;         // 不限步数轮：14 轮工具调用 + 1 轮最终答案
    }
    while round < limit {
        // accept 最多等 10 秒：客户端不再发请求时 mock 必须自己退出，
        // 否则「mock 卡在 accept」会变成整个自测卡死（踩过）
        var lpfds: [PollFd: 1] = [PollFd{ fd: lfd, events: POLLIN, revents: 0 }];
        const lpr: i32 = sys_poll(&lpfds[0], 1, 10000) catch { 0; };
        if lpr <= 0 || (lpfds[0].revents & POLLIN) == 0 {
            // 请求数不够也用同一个 verdict 通道报出来（否则「断言没跑」会被误判成通过）
            if verdict == 0 && round < limit {
                return 62 + round;   // 62/63/64… 表示只服务了 round 次
            }
            return verdict;
        }
        var peer: [byte: 16] = [0: 16];
        var alen: u32 = 16;
        const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch {
            return 10;
        };
        var rx: Buf = buf_new(8192);
        if !mock_read_request(cfd, &rx) {
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            return 11;
        }
        // P10：web_search 的 provider 请求（Anthropic Messages API）
        if contains(&rx, "POST /messages") || contains(&rx, "/messages HTTP") {
            expect(&rx, "web_search_20250305", 93, &verdict);   // 服务端搜索工具
            expect(&rx, "x-api-key: selftest-web-key", 94, &verdict);
            expect(&rx, "anthropic-version: 2023-06-01", 95, &verdict);
            if sel_count_sub(&rx, "query=uya language") != 1 {
                verdict = 96;   // 重复的 query 必须被去重（只出现一次）
            }
            expect(&rx, "query=second query", 97, &verdict);
            if !mock_send_messages(cfd) {
                verdict = 96;
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            // 注意：provider 的 /messages 请求**不占** chat 轮次
            continue;
        }
        is_stream = contains(&rx, "\"stream\":true");
        if mock_mode == 3 {
            // 直接回 401 + 错误体
            var errb: Buf = buf_new(256);
            _ = buf_append_cstr(&errb, "{\"error\":{\"message\":\"mock unauthorized\",\"type\":\"invalid_request_error\"}}");
            if !mock_send_401(cfd, &errb) {
                verdict = 30;
            }
            buf_free(&errb);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 16 {
            var body16: Buf = buf_new(256);
            if !mock_final_body(&body16, "WF-AGENT-OK") {
                verdict = 150;
            }
            var sent16: bool = false;
            if is_stream {
                sent16 = mock_send_sse(cfd, &body16);
            } else {
                sent16 = mock_send(cfd, &body16);
            }
            if !sent16 {
                verdict = 151;
            }
            buf_free(&body16);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 17 {
            // 不限步数轮：连给 14 轮 tool_calls（旧默认 12 会在第 12 步熔断），
            // 第 15 轮才给最终答案。断言口径是「请求里的 tool_call_id 条数 == 已经跑过的步数」，
            // 所以少跑一步（熔断/丢历史）都会被抓出来。
            const tool_rounds: i32 = 14;
            var body17: Buf = buf_new(512);
            if round < tool_rounds {
                if round > 0 && sel_count_sub(&rx, "\"tool_call_id\":\"call_step\"") != round as usize {
                    verdict = 160;
                }
                if !mock_steps_body(&body17) {
                    verdict = 161;
                }
            } else {
                if sel_count_sub(&rx, "\"tool_call_id\":\"call_step\"") != tool_rounds as usize {
                    verdict = 163;   // 14 步的工具结果必须一条不少地回到请求里
                }
                if !contains(&rx, "SELFTEST-STEP-OK") {
                    verdict = 164;
                }
                if verdict == 0 {
                    if !mock_final_body(&body17, "SELFTEST_UNLIMITED_OK") {
                        verdict = 165;
                    }
                } else if !mock_final_body(&body17, "SELFTEST_FAIL") {
                    verdict = 165;
                }
            }
            var sent17: bool = false;
            if is_stream {
                sent17 = mock_send_sse(cfd, &body17);
            } else {
                sent17 = mock_send(cfd, &body17);
            }
            if !sent17 {
                verdict = 162;
            }
            buf_free(&body17);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 14 {
            // 区分父子请求：用子代理特有的请求头（历史文本靠不住：fork 的子代理继承父的全部历史）
            if contains(&rx, "x-uya-subagent: ") {
                var sub: Buf = buf_new(512);
                if !mock_final_body(&sub, "SUBAGENT-RESULT-MARKER 42") {
                    verdict = 120;
                }
                var sent_sub: bool = false;
                if is_stream {
                    sent_sub = mock_send_sse(cfd, &sub);
                } else {
                    sent_sub = mock_send(cfd, &sub);
                }
                if !sent_sub {
                    verdict = 121;
                }
                buf_free(&sub);
                buf_free(&rx);
                _ = sys_close(cfd) catch {};
                continue;   // 子代理的请求不占 chat 轮次
            }
            if round == 0 {
                expect(&rx, "\"name\":\"subagent\"", 122, &verdict);
                expect(&rx, "\"name\":\"subagent_fork\"", 123, &verdict);
                expect(&rx, "\"name\":\"ralph\"", 124, &verdict);
                expect(&rx, "\"name\":\"create_goal\"", 125, &verdict);
                expect(&rx, "\"name\":\"update_goal\"", 126, &verdict);
                var sb14: Buf = buf_new(4096);
                if !mock_deleg_body(&sb14) {
                    verdict = 127;
                }
                var sent14: bool = false;
                if is_stream {
                    sent14 = mock_send_sse(cfd, &sb14);
                } else {
                    sent14 = mock_send(cfd, &sb14);
                }
                if !sent14 {
                    verdict = 128;
                }
                buf_free(&sb14);
            } else {
                expect(&rx, "created goal-1", 129, &verdict);
                expect(&rx, "revision = 1", 130, &verdict);              // get_goal 的输出
                expect(&rx, "updated goal-1", 131, &verdict);
                expect(&rx, "phase paused", 132, &verdict);
                expect(&rx, "SUBAGENT-RESULT-MARKER", 133, &verdict);    // 子代理的结果回到父
                expect(&rx, "sub-1 [subagent]", 134, &verdict);          // list_agents
                expect(&rx, "[status: idle]", 135, &verdict);
                expect(&rx, "[sub-2 status: idle]", 139, &verdict);      // subagent_fork 前台返回
                expect(&rx, "[round 1]", 140, &verdict);                 // ralph 的逐轮报告
                expect(&rx, "[round 2]", 141, &verdict);
                var body14: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body14, "SELFTEST_DELEG_OK") {
                        verdict = 136;
                    }
                } else if !mock_final_body(&body14, "SELFTEST_FAIL") {
                    verdict = 137;
                }
                var sent14b: bool = false;
                if is_stream {
                    sent14b = mock_send_sse(cfd, &body14);
                } else {
                    sent14b = mock_send(cfd, &body14);
                }
                if !sent14b {
                    verdict = 138;
                }
                buf_free(&body14);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 13 {
            if round == 0 {
                if !contains(&rx, "演示用技能") || !contains(&rx, "available_skills") {
                    verdict = 97;   // 技能目录必须被注入
                }
                if !contains(&rx, "\"name\":\"skill\"") || !contains(&rx, "\"name\":\"web_search\"") {
                    verdict = 98;   // 两个工具的 schema 都要在
                }
                var sb13: Buf = buf_new(2048);
                if !mock_skill_body(&sb13) {
                    verdict = 99;
                }
                var sent13: bool = false;
                if is_stream {
                    sent13 = mock_send_sse(cfd, &sb13);
                } else {
                    sent13 = mock_send(cfd, &sb13);
                }
                if !sent13 {
                    verdict = 100;
                }
                buf_free(&sb13);
            } else {
                // 注意：结果文本在请求里是 JSON 字符串，引号被转义成 \" —— 断言不要带引号
                expect(&rx, "skill_content name=", 101, &verdict);
                expect(&rx, "demo-skill", 102, &verdict);
                expect(&rx, "Base directory for this skill:", 103, &verdict);
                expect(&rx, "SELFTEST-SKILL-BODY", 104, &verdict);
                expect(&rx, "unknown or no longer available", 105, &verdict);
                expect(&rx, "Uya is a small systems language.", 106, &verdict);
                expect(&rx, "https://example.org/uya2", 107, &verdict);
                expect(&rx, "Uya docs", 108, &verdict);
                var body13: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body13, "SELFTEST_SKILL_OK") {
                        verdict = 107;
                    }
                } else if !mock_final_body(&body13, "SELFTEST_FAIL") {
                    verdict = 108;
                }
                var sent13b: bool = false;
                if is_stream {
                    sent13b = mock_send_sse(cfd, &body13);
                } else {
                    sent13b = mock_send(cfd, &body13);
                }
                if !sent13b {
                    verdict = 109;
                }
                buf_free(&body13);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 11 {
            // 剪枝轮：让 bash 产生 >8192 码点的输出，第二轮断言请求里出现剪枝标记
            if round == 0 {
                var sb11: Buf = buf_new(1024);
                if !mock_prune_body(&sb11) {
                    verdict = 76;
                }
                var sent11: bool = false;
                if is_stream {
                    sent11 = mock_send_sse(cfd, &sb11);
                } else {
                    sent11 = mock_send(cfd, &sb11);
                }
                if !sent11 {
                    verdict = 77;
                }
                buf_free(&sb11);
            } else {
                if !contains(&rx, "[... tool result middle pruned ...]") {
                    verdict = 78;
                }
                // 剪枝后不该再出现完整的长输出（尾部片段仍在，所以只查中段特征）
                if contains(&rx, "abcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghijabcdefghij") {
                    verdict = 79;
                }
                var body11: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body11, "SELFTEST_PRUNE_OK") {
                        verdict = 80;
                    }
                } else if !mock_final_body(&body11, "SELFTEST_FAIL") {
                    verdict = 81;
                }
                var sent11b: bool = false;
                if is_stream {
                    sent11b = mock_send_sse(cfd, &body11);
                } else {
                    sent11b = mock_send(cfd, &body11);
                }
                if !sent11b {
                    verdict = 82;
                }
                buf_free(&body11);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 12 {
            // 压缩轮：压力在**第一步之前**就超标，所以顺序是
            //   (1) 摘要请求（不占轮次）→ (2) 压缩之后的真实请求（断言 checkpoint）
            if contains(&rx, "acting as a compaction engine") {
                expect(&rx, "## Primary Request and Intent", 83, &verdict);   // 摘要提示词的模板
                expect(&rx, "## Critical Context", 84, &verdict);
                var sum: Buf = buf_new(512);
                if !mock_final_body(&sum, "## Primary Request and Intent\n- 测试压缩\n\n## Next Step\n- 继续") {
                    verdict = 85;
                }
                var sent12a: bool = false;
                if is_stream {
                    sent12a = mock_send_sse(cfd, &sum);
                } else {
                    sent12a = mock_send(cfd, &sum);
                }
                if !sent12a {
                    verdict = 86;
                }
                buf_free(&sum);
                buf_free(&rx);
                _ = sys_close(cfd) catch {};
                continue;   // 摘要请求不占 chat 轮次
            }
            expect(&rx, "automatically generated checkpoint", 88, &verdict);   // CHECKPOINT_PREAMBLE
            expect(&rx, "<compacted-summary>", 89, &verdict);
            expect(&rx, "## Primary Request and Intent", 90, &verdict);         // 摘要正文
            var body12: Buf = buf_new(512);
            if verdict == 0 {
                if !mock_final_body(&body12, "SELFTEST_COMPACT_OK") {
                    verdict = 91;
                }
            } else if !mock_final_body(&body12, "SELFTEST_FAIL") {
                verdict = 92;
            }
            var sent12b: bool = false;
            if is_stream {
                sent12b = mock_send_sse(cfd, &body12);
            } else {
                sent12b = mock_send(cfd, &body12);
            }
            if !sent12b {
                verdict = 93;
            }
            buf_free(&body12);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 10 {
            // prompt/todo/plan 轮：第一轮断言 system prompt 与注入，第二轮断言工具结果
            if round == 0 {
                if buf_has_nul(&rx) {
                    verdict = 75;   // 请求里有 NUL：长度/指针算错了
                }
                if !contains(&rx, "You are a coding agent powered by the selftest-model model") {
                    verdict = 61;   // persona + {{model}} 替换
                }
                if !contains(&rx, "selftest_ws_prompt") {
                    verdict = 62;   // {{cwd}} 替换
                }
                if !contains(&rx, "Use the read tool") {
                    verdict = 63;   // 工具引导段
                }
                if !contains(&rx, "Current runtime context.") {
                    verdict = 64;   // 运行时上下文（user 消息）
                }
                if !contains(&rx, "SELFTEST-AGENTS-MARKER") || !contains(&rx, "Instructions from:") {
                    verdict = 65;   // AGENTS.md 注入
                }
                var sb10: Buf = buf_new(4096);
                if !mock_prompt_body(&sb10) {
                    verdict = 66;
                }
                var sent10: bool = false;
                if is_stream {
                    sent10 = mock_send_sse(cfd, &sb10);
                } else {
                    sent10 = mock_send(cfd, &sb10);
                }
                if !sent10 {
                    verdict = 67;
                }
                buf_free(&sb10);
            } else {
                if !contains(&rx, "Updated todo list: 2 pending, 1 in progress, 1 completed.") {
                    verdict = 68;
                }
                if !contains(&rx, "duplicate content") {
                    verdict = 69;
                }
                if !contains(&rx, "exit_plan_mode is only available in plan mode") {
                    verdict = 70;
                }
                if !contains(&rx, "requires a non-empty markdown plan starting with a # heading") {
                    verdict = 71;
                }
                var body10: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body10, "SELFTEST_PROMPT_OK") {
                        verdict = 72;
                    }
                } else if !mock_final_body(&body10, "SELFTEST_FAIL") {
                    verdict = 73;
                }
                var sent10b: bool = false;
                if is_stream {
                    sent10b = mock_send_sse(cfd, &body10);
                } else {
                    sent10b = mock_send(cfd, &body10);
                }
                if !sent10b {
                    verdict = 74;
                }
                buf_free(&body10);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 9 {
            // bash / jobs 轮：一轮 6 个调用，第二轮断言结果文本
            if round == 0 {
                var sb9: Buf = buf_new(4096);
                if !mock_jobs_body(&sb9) {
                    verdict = 50;
                }
                var sent9: bool = false;
                if is_stream {
                    sent9 = mock_send_sse(cfd, &sb9);
                } else {
                    sent9 = mock_send(cfd, &sb9);
                }
                if !sent9 {
                    verdict = 51;
                }
                buf_free(&sb9);
            } else {
                if !contains(&rx, "started background job job-1") {
                    verdict = 52;
                }
                if !contains(&rx, "job-2 [bash]") {
                    verdict = 53;   // job_list 必须列出两个任务
                }
                if !contains(&rx, "BG-DONE") {
                    verdict = 54;   // job_output(wait) 拿到增量输出
                }
                if !contains(&rx, "[status: completed") {
                    verdict = 55;
                }
                if !contains(&rx, "requested cancellation of job 2") {
                    verdict = 56;
                }
                if !contains(&rx, "(no output)") || !contains(&rx, "[exit code: 0]") {
                    verdict = 57;
                }
                var body9: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body9, "SELFTEST_JOBS_OK") {
                        verdict = 58;
                    }
                } else if !mock_final_body(&body9, "SELFTEST_FAIL") {
                    verdict = 59;
                }
                var sent9b: bool = false;
                if is_stream {
                    sent9b = mock_send_sse(cfd, &body9);
                } else {
                    sent9b = mock_send(cfd, &body9);
                }
                if !sent9b {
                    verdict = 60;
                }
                buf_free(&body9);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 7 {
            // 文件工具轮：一轮里发 6 个调用，第二轮断言每个结果的文本
            if round == 0 {
                var sb7: Buf = buf_new(4096);
                if !mock_fs_body(&sb7) {
                    verdict = 34;
                }
                var sent7: bool = false;
                if is_stream {
                    sent7 = mock_send_sse(cfd, &sb7);
                } else {
                    sent7 = mock_send(cfd, &sb7);
                }
                if !sent7 {
                    verdict = 35;
                }
                buf_free(&sb7);
            } else {
                if !contains(&rx, "requires reading") {
                    verdict = 36;   // 未读就覆盖 → 被观察策略拦住
                }
                if !contains(&rx, "2: beta two") || !contains(&rx, "3: gamma three") {
                    verdict = 37;   // read 的窗口/行号
                }
                if !contains(&rx, "(Showing lines 2-3 of 5. Use offset=4 to continue.)") {
                    verdict = 38;   // read 的 footer
                }
                if !contains(&rx, "Updated file") {
                    verdict = 39;   // 读后覆盖成功
                }
                if !contains(&rx, "appears 2 times") {
                    verdict = 40;   // edit 要求唯一匹配
                }
                if !contains(&rx, "has been updated successfully.") {
                    verdict = 41;   // edit 成功
                }
                if !contains(&rx, "old_string not found") {
                    verdict = 42;
                }
                // glob：*.txt 应当列出 doc.txt 与 note.txt
                if !contains(&rx, "doc.txt") || !contains(&rx, "note.txt") {
                    verdict = 46;
                }
                // grep：按文件分组 + "Line N: 预览"
                if !contains(&rx, "Line 2: beta two") || !contains(&rx, "Line 4: beta four") {
                    verdict = 47;
                }
                if !contains(&rx, "No matches found") {
                    verdict = 48;
                }
                if !contains(&rx, "No files found") {
                    verdict = 49;
                }
                var body7: Buf = buf_new(512);
                if verdict == 0 {
                    if !mock_final_body(&body7, "SELFTEST_FS_OK") {
                        verdict = 43;
                    }
                } else if !mock_final_body(&body7, "SELFTEST_FAIL") {
                    verdict = 44;
                }
                var sent7b: bool = false;
                if is_stream {
                    sent7b = mock_send_sse(cfd, &body7);
                } else {
                    sent7b = mock_send(cfd, &body7);
                }
                if !sent7b {
                    verdict = 45;
                }
                buf_free(&body7);
            }
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 6 {
            // 中断轮：发一帧工具调用后挂 300ms（不发 [DONE]），客户端应被 Ctrl-C 打断
            var sb6: Buf = buf_new(512);
            _ = buf_append_cstr(&sb6, "{\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"working on it\",\"tool_calls\":[{\"id\":\"call_x1\",\"type\":\"function\",\"function\":{\"name\":\"read_file\",\"arguments\":\"{\\\"path\\\":\\\"note.txt\\\"}\"}}]},\"finish_reason\":\"tool_calls\"}]}");
            if !mock_send_sse_nodone(cfd, &sb6) {
                verdict = 33;
            }
            var req6: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 300000000 };
            var rem6: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
            _ = sys_nanosleep(&req6, &rem6) catch {};
            buf_free(&sb6);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 5 {
            // 一直给工具调用：agent 必须靠 max_steps 自己停下
            var sb: Buf = buf_new(2048);
            if !mock_toolcall_body(&sb, true) {
                verdict = 31;
            }
            var sent5: bool = false;
            if is_stream {
                sent5 = mock_send_sse(cfd, &sb);
            } else {
                sent5 = mock_send(cfd, &sb);
            }
            if !sent5 {
                verdict = 32;
            }
            buf_free(&sb);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if round == 0 {
            // 断言：tools schema 里 run_shell 的有无符合预期
            const has_shell: bool = contains(&rx, "\"name\":\"bash\"");
            if has_shell != mock_expect_shell {
                verdict = 12;
            }
            var body: Buf = buf_new(4096);
            var built: bool = false;
            if mock_mode == 2 {
                built = mock_toolcall_tools_body(&body);
            } else {
                built = mock_toolcall_body(&body, mock_expect_shell);
            }
            if !built {
                buf_free(&body);
                buf_free(&rx);
                _ = sys_close(cfd) catch {};
                return 13;
            }
            var sent_a: bool = false;
            if is_stream {
                sent_a = mock_send_sse(cfd, &body);
            } else {
                sent_a = mock_send(cfd, &body);
            }
            if !sent_a {
                verdict = 14;
            }
            buf_free(&body);
        } else {
            // 断言：第二轮请求里必须带上第一轮的工具执行结果
            if mock_mode != 2 {
                // write 的结果信封：<path>note.txt</path> … Created file
                if !contains(&rx, "Created file") || !contains(&rx, "note.txt") {
                    verdict = 15;
                }
            }
            // P3：运行中用户输入（steer）必须在**下一个 step 的请求**里出现
            if mock_expect_steer && !contains(&rx, "STEER-MARKER") {
                verdict = 29;
            }
            // P2 严格协议断言：assistant 的 tool_calls 原样回灌 + 每个结果都有配对的
            // tool_call_id（折叠协议下这些都不该出现，见 --compat-fold 轮）
            if mock_expect_fold {
                // 折叠协议：必须有折叠头，且不能出现 role:"tool"
                if !contains(&rx, "工具执行结果如下") || contains(&rx, "\"role\":\"tool\"") {
                    verdict = 28;
                }
            } else if is_stream {
                if !contains(&rx, "\"role\":\"assistant\"") || !contains(&rx, "\"tool_calls\"") {
                    verdict = 23;
                }
                if !contains(&rx, "\"role\":\"tool\"") || !contains(&rx, "\"tool_call_id\"") {
                    verdict = 24;
                }
                if !contains(&rx, "\"id\":\"call_") {
                    verdict = 25;   // 调用 id 必须原样出现在历史里
                }
                // 配对数：tools 轮有 4 个调用，其它轮 1 个
                // 每轮 mock 发出的调用数：shell 轮 2 个（write+bash）、
                // no-shell 轮 1 个、tools 轮 4 个、熔断轮沿用 2 个
                var want_ids: i32 = 2;
                if mock_mode == 1 {
                    want_ids = 1;
                } else if mock_mode == 2 {
                    want_ids = 4;
                }
                const got_ids: i32 = count_sub(&rx, "\"tool_call_id\":\"call_");
                if got_ids != want_ids {
                    verdict = 27;
                }
                // 折叠协议标记不该出现
                if contains(&rx, "工具执行结果如下") {
                    verdict = 26;
                }
            }
            if mock_expect_shell && mock_mode != 2 {
                if !contains(&rx, "SELFTEST-SHELL-OK") || !contains(&rx, "[exit code: 0]") {
                    verdict = 19;
                }
            }
            if mock_mode == 2 {
                // 读回的文本在请求里应当只被转义一次：line1\nline2 \"q\" tail
                // （如果字段值忘了反转义，这里会是 line1\\nline2，断言就会失败）
                if !contains(&rx, "2: line2 \\\"q\\\" tail") {
                    verdict = 20;
                }
                if !contains(&rx, "unsafe path") {
                    verdict = 21;
                }
                if !contains(&rx, "[timed out after 300ms]") || !contains(&rx, "[killed by signal: 9]") {
                    verdict = 22;
                }
            }
            var body2: Buf = buf_new(1024);
            if verdict == 0 {
                if !mock_final_body(&body2, "SELFTEST_OK 已写入 note.txt") {
                    buf_free(&body2);
                    buf_free(&rx);
                    _ = sys_close(cfd) catch {};
                    return 16;
                }
            } else {
                if !mock_final_body(&body2, "SELFTEST_FAIL") {
                    buf_free(&body2);
                    buf_free(&rx);
                    _ = sys_close(cfd) catch {};
                    return 17;
                }
            }
            var sent: bool = false;
            if is_stream {
                sent = mock_send_sse(cfd, &body2);       // 流式路径（内部就是 chunked）
            } else if mock_mode == 2 {
                sent = mock_send_chunked(cfd, &body2);   // 非流式 + chunked 解码
            } else {
                sent = mock_send(cfd, &body2);
            }
            if !sent {
                verdict = 18;
            }
            buf_free(&body2);
        }
        buf_free(&rx);
        _ = sys_close(cfd) catch {};
        round = round + 1;
    }
    _ = sys_close(lfd) catch {};
    return verdict;
}

// ============================================================
// selftest 单轮
// ============================================================
fn ws_prepare(ws: &const byte) bool {
    _ = sys_mkdir(ws as *const byte, 493 as u32) catch {};
    var f: Buf = buf_new(strlen(ws) + 32);
    defer { buf_free(&f); }
    if !buf_valid(&f) {
        return false;
    }
    _ = buf_append_cstr(&f, ws);
    // 必须补 NUL（README 坑 2）：否则 unlink 拿到的是缓冲区后面的垃圾路径，
    // 清理静默失败 —— 第二轮就会撞上「write 需要先 read」的观察策略。
    _ = buf_append_cstr_z(&f, "/note.txt");
    _ = sys_unlink(&f.ptr[0] as *const byte) catch {};
    return true;
}

fn file_equals(path: &const byte, expect: &const byte) bool {
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var buf: [byte: 512] = [0: 512];
    const n: isize = sys_read(fd, &buf[0], 512) catch { 0 as isize; };
    if n < 0 {
        return false;
    }
    const got: usize = n as usize;
    const want: usize = strlen(expect);
    if got != want {
        return false;
    }
    var i: usize = 0;
    while i < want {
        if buf[i] != expect[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn selftest_round(base: &const Config, tag: &const byte, mode: i32, allow_shell: bool, ws: &const byte, stream: bool, fold: bool, steer: bool, interrupt: bool) bool {
    mock_mode = mode;
    mock_expect_shell = allow_shell;
    mock_expect_fold = fold;
    mock_expect_steer = steer;
    if !ws_prepare(ws) {
        out_err("selftest: cannot prepare workspace\n");
        return false;
    }
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        out_err("selftest: socket() failed\n");
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: bind() failed\n");
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: listen() failed\n");
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: getsockname() failed\n");
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);

    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: fork() failed\n");
        return false;
    };
    if pid64 == 0 {
        const rc: i32 = mock_server(lfd);
        sys_exit(rc);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    // 父进程：跑真实 agent 循环
    var c: Config = cfg_default();
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(128);
    if mode == 2 {
        _ = buf_append_cstr(&c.task, "写文件、读文件、越权路径、超时命令");
    } else {
        _ = buf_append_cstr(&c.task, "把 hello-selftest 写进 note.txt");
    }
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = allow_shell;
    c.stream = stream;
    // tools 轮要验证路径守卫：DSH 标准模式默认是全权（confine=false），这里显式开守卫
    if mode == 2 {
        c.confine = true;
    }
    c.compat_fold = fold;
    if mode == 5 {
        c.max_steps = 3;      // 熔断轮：mock 每轮都给 tool_calls，agent 必须在 3 步停下
    } else if mode == 17 {
        // 不限步数轮：**故意不设** max_steps —— 吃的就是 cfg_default() 的默认值（0 = 不限）。
        // 默认值一旦被人改回 12，这轮会因为在第 12 步熔断而失败（mock 只服务了 12 次）。
    } else {
        c.max_steps = 4;
    }
    c.timeout_ms = 15000;
    c.quiet = true;
    // 会话落到 build/ 下，别污染 ~/.uya-agent
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    // P3：预置「运行中用户输入」（steer）与「预置 Ctrl-C 按键」
    inbox_globals_init();
    if steer {
        _ = inbox_push(&g_steer, "STEER-MARKER 追加要求", strlen("STEER-MARKER 追加要求"));
    }
    g_interactive = interrupt;
    if interrupt {
        // 把 Ctrl-C 预先塞进行编辑器的按键队列：第一次 pump 就会取到它
        tty_init(&tty_ui, 0);
        var ctrl_c: [byte: 1] = [3: 1];
        tty_feed(&tty_ui, &ctrl_c[0], 1);
    }
    const rc: i32 = agent_run(&c);
    g_interactive = false;
    inbox_globals_free();
    cfg_free(&c);

    const mock_rc: i32 = wait_child(pid);

    var file_path: Buf = buf_new(strlen(ws) + 32);
    defer { buf_free(&file_path); }
    _ = buf_append_cstr(&file_path, ws);
    _ = buf_append_cstr_z(&file_path, "/note.txt");
    file_path.len = file_path.len - 1;

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if mock_mode == 2 && rc == AGENT_OK && mock_rc == 0 {
        // mode 2 还要逐字节校验写出来的文件内容（换行/引号必须是真的）
        var esc_path: Buf = buf_new(strlen(ws) + 32);
        _ = buf_append_cstr(&esc_path, ws);
        _ = buf_append_cstr_z(&esc_path, "/esc.txt");
        const want: &const byte = esc_content();
        if !file_equals(&esc_path.ptr[0] as &const byte, want) {
            out_err("[esc.txt 内容不符] ");
            ok = false;
        }
        buf_free(&esc_path);
    }
    var expect_rc: i32 = AGENT_OK;
    if mode == 3 || mode == 5 {
        expect_rc = AGENT_PROTO;
    }
    if interrupt {
        expect_rc = AGENT_INTERRUPTED;
    }
    if rc != expect_rc {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        out_err(" (expected ");
        out_err_dec(expect_rc as usize);
        out_err(")");
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else if mode == 0 || mode == 1 {
        if !file_equals(&file_path.ptr[0] as &const byte, "hello-selftest") {
            out_err("FAIL: note.txt content mismatch");
            ok = false;
        } else {
            out_err("ok");
        }
    } else if !ok {
        out_err("FAIL");
    } else {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

// ============================================================
// P1 流式解析自测
//
// mock 端发 text/event-stream + chunked，并且**按 19 字节切片、每片间隔 2ms** 写出，
// 保证客户端读到的是半截帧（chunk 长度行、data 行、JSON 字符串都可能被切开），
// 从而真正验证 httpstream 的增量解码 + sse 的分帧 + llm 的分片累积。
// 客户端直接调 llm_stream_chat（不经过 agent_run），逐字段断言 ChatOut。
// ============================================================
const SSE_CASE_BASIC: i32 = 0;
const SSE_CASE_TOOLS: i32 = 1;
const SSE_CASE_NODONE: i32 = 2;
const SSE_CASE_BADJSON: i32 = 3;
const SSE_CASE_REASONING_LENGTH: i32 = 4;

// 写出的切片大小与间隔：小到必然把 SSE 帧切碎
const SSE_SLICE: usize = 19;
const SSE_GAP_NS: i64 = 2000000;

var sse_case: i32 = 0;

fn sse_eq(p: &const byte, n: usize, lit: &const byte) bool {
    return bufx_cstr_len(lit) == n && bufx_mem_eq(p, lit, n);
}

fn sse_buf_eq(b: &const Buf, lit: &const byte) bool {
    return sse_eq(b.ptr as &const byte, b.len, lit);
}

// 把 writer 写好的 payload 当作一帧 data 追加到 out
fn sse_emit(out: &Buf, w: &const JsonWriter, payload: &Buf) bool {
    if jw_overflow(w) {
        return false;
    }
    payload.len = jw_used(w);
    if !buf_append_cstr(out, "data: ") {
        return false;
    }
    if !buf_append(out, payload.ptr, payload.len) {
        return false;
    }
    return buf_append_cstr(out, "\n\n");
}

// {"choices":[{"index":0,"delta":{"content"|"reasoning_content":"<text>"}}]}
fn sse_delta_text(out: &Buf, payload: &Buf, text: &const byte, reasoning: bool) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, payload.ptr, payload.cap);
    jw_byte(&w, 123);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "delta");
    jw_byte(&w, 123);
    if reasoning {
        jw_key(&w, "reasoning_content");
    } else {
        jw_key(&w, "content");
    }
    jw_str_cstr(&w, text);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    return sse_emit(out, &w, payload);
}

// {"choices":[{"index":0,"delta":{"tool_calls":[{"index":N,"id":…,"function":{…}}]}}]}
fn sse_delta_tool(out: &Buf, payload: &Buf, index: i64, id: &const byte, name: &const byte, args_frag: &const byte) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, payload.ptr, payload.cap);
    jw_byte(&w, 123);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "delta");
    jw_byte(&w, 123);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, index);
    if bufx_cstr_len(id) > 0 {
        jw_byte(&w, 44);
        jw_key(&w, "id");
        jw_str_cstr(&w, id);
    }
    jw_byte(&w, 44);
    jw_key(&w, "function");
    jw_byte(&w, 123);
    if bufx_cstr_len(name) > 0 {
        jw_key(&w, "name");
        jw_str_cstr(&w, name);
        jw_byte(&w, 44);
    }
    jw_key(&w, "arguments");
    jw_str_cstr(&w, args_frag);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    return sse_emit(out, &w, payload);
}

// finish 帧：{"choices":[{"index":0,"delta":{},"finish_reason":"<why>"}][,"usage":{…}]}
fn sse_finish(out: &Buf, payload: &Buf, why: &const byte, with_usage: bool) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, payload.ptr, payload.cap);
    jw_byte(&w, 123);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "delta");
    jw_byte(&w, 123);
    jw_byte(&w, 125);
    jw_byte(&w, 44);
    jw_key(&w, "finish_reason");
    jw_str_cstr(&w, why);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    if with_usage {
        jw_byte(&w, 44);
        jw_key(&w, "usage");
        jw_byte(&w, 123);
        jw_key(&w, "prompt_tokens");
        jw_i64(&w, 100);
        jw_byte(&w, 44);
        jw_key(&w, "completion_tokens");
        jw_i64(&w, 7);
        jw_byte(&w, 44);
        jw_key(&w, "prompt_tokens_details");
        jw_byte(&w, 123);
        jw_key(&w, "cached_tokens");
        jw_i64(&w, 40);
        jw_byte(&w, 125);
        jw_byte(&w, 44);
        jw_key(&w, "completion_tokens_details");
        jw_byte(&w, 123);
        jw_key(&w, "reasoning_tokens");
        jw_i64(&w, 3);
        jw_byte(&w, 125);
        jw_byte(&w, 125);
    }
    jw_byte(&w, 125);
    return sse_emit(out, &w, payload);
}

// usage-only 帧：{"choices":[],"usage":{…}}
fn sse_usage_only(out: &Buf, payload: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, payload.ptr, payload.cap);
    jw_byte(&w, 123);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 93);
    jw_byte(&w, 44);
    jw_key(&w, "usage");
    jw_byte(&w, 123);
    jw_key(&w, "prompt_tokens");
    jw_i64(&w, 100);
    jw_byte(&w, 44);
    jw_key(&w, "completion_tokens");
    jw_i64(&w, 7);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    return sse_emit(out, &w, payload);
}

fn sse_raw_frame(out: &Buf, text: &const byte) bool {
    if !buf_append_cstr(out, "data: ") {
        return false;
    }
    if !buf_append_cstr(out, text) {
        return false;
    }
    return buf_append_cstr(out, "\n\n");
}

// 生成一整个 SSE 文本（未分块）
fn sse_mock_text(case_id: i32, out: &Buf, payload: &Buf) bool {
    if case_id == SSE_CASE_BASIC {
        if !sse_delta_text(out, payload, "", false) { return false; }
        if !sse_delta_text(out, payload, "Hello", false) { return false; }
        if !sse_delta_text(out, payload, ", Uya!", false) { return false; }
        if !sse_finish(out, payload, "stop", true) { return false; }
        if !sse_usage_only(out, payload) { return false; }
        return sse_raw_frame(out, "[DONE]");
    }
    if case_id == SSE_CASE_TOOLS {
        if !sse_delta_text(out, payload, "I will read it", false) { return false; }
        if !sse_delta_tool(out, payload, 0, "call_a", "read", "") { return false; }
        if !sse_delta_tool(out, payload, 1, "call_b", "bash", "") { return false; }
        // arguments 分片：拼起来必须是 {"file_path":"a.txt"}
        if !sse_delta_tool(out, payload, 0, "", "", "{\"file") { return false; }
        if !sse_delta_tool(out, payload, 1, "", "", "{\"command\":\"ls") { return false; }
        if !sse_delta_tool(out, payload, 0, "", "", "_path\":\"a.txt\"}") { return false; }
        if !sse_delta_tool(out, payload, 1, "", "", "\"}") { return false; }
        if !sse_finish(out, payload, "tool_calls", false) { return false; }
        return sse_raw_frame(out, "[DONE]");
    }
    if case_id == SSE_CASE_NODONE {
        if !sse_delta_text(out, payload, "partial", false) { return false; }
        if !sse_finish(out, payload, "stop", false) { return false; }
        return true;   // 故意不发 [DONE]
    }
    if case_id == SSE_CASE_BADJSON {
        if !sse_delta_text(out, payload, "before-bad", false) { return false; }
        if !sse_raw_frame(out, "{\"choices\":[{\"index\":0,") { return false; }
        return sse_raw_frame(out, "[DONE]");
    }
    // SSE_CASE_REASONING_LENGTH
    if !sse_delta_text(out, payload, "think1", true) { return false; }
    if !sse_delta_text(out, payload, "think2", true) { return false; }
    if !sse_delta_text(out, payload, "cut", false) { return false; }
    return sse_finish(out, payload, "length", false);
}

// mock 端：一次连接，回 SSE（chunked + 受控切片）
fn sse_mock_server(lfd: i32) i32 {
    var peer: [byte: 16] = [0: 16];
    var alen: u32 = 16;
    const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch {
        _ = sys_close(lfd) catch {};
        return 40;
    };
    var rx: Buf = buf_new(8192);
    var verdict: i32 = 0;
    if !mock_read_request(cfd, &rx) {
        verdict = 41;
    } else if !contains(&rx, "\"stream\":true") {
        verdict = 42;   // 必须是流式请求
    } else if !contains(&rx, "Accept: text/event-stream") {
        verdict = 43;
    }
    buf_free(&rx);

    var text: Buf = buf_new(16384);
    var payload: Buf = buf_new(4096);
    if verdict == 0 {
        if !sse_mock_text(sse_case, &text, &payload) {
            verdict = 44;
        }
    }

    // SSE 文本 → chunked 分帧（每 37 字节一个 chunk，切点必然落在帧中间）
    var wire: Buf = buf_new(32768);
    if verdict == 0 {
        var off: usize = 0;
        while off < text.len {
            var take: usize = text.len - off;
            if take > 37 {
                take = 37;
            }
            _ = buf_append_u64_hex(&wire, take);
            _ = buf_append_cstr(&wire, "\r\n");
            _ = buf_append(&wire, &text.ptr[off], take);
            _ = buf_append_cstr(&wire, "\r\n");
            off = off + take;
        }
        _ = buf_append_cstr(&wire, "0\r\n\r\n");
    }

    if verdict == 0 {
        var head: Buf = buf_new(256);
        _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n");
        const hw: !void = https_write_all(cfd, &head.ptr[0] as &const byte, head.len);
        _ = hw catch {
            verdict = 45;
        };
        buf_free(&head);
    }

    if verdict == 0 {
        var woff: usize = 0;
        while woff < wire.len {
            var take: usize = wire.len - woff;
            if take > SSE_SLICE {
                take = SSE_SLICE;
            }
            const w: !void = https_write_all(cfd, &wire.ptr[woff] as &const byte, take);
            _ = w catch {
                verdict = 46;
                break;
            };
            woff = woff + take;
            if woff < wire.len {
                var req: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: SSE_GAP_NS };
                var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
                _ = sys_nanosleep(&req, &rem) catch {};
            }
        }
    }

    buf_free(&wire);
    buf_free(&text);
    buf_free(&payload);
    _ = sys_close(cfd) catch {};
    _ = sys_close(lfd) catch {};
    return verdict;
}

// 客户端：调一次 llm_stream_chat。返回 0=成功 1=malformed 2=stream-closed 3=其它错误 4=状态码非 200
fn sse_call(url: &[byte], hdrs: &[byte], body: &const Buf, o: &ChatOut) i32 {
    var empty_pin: [byte: 0] = [];
    const res: !i32 = llm_stream_chat(
        url,
        hdrs,
        body.ptr as &const byte,
        body.len,
        15000,
        262144,
        HC_VERIFY_NONE,
        &empty_pin[0: 0],
        o,
        false,
        false,
        false
    );
    const status: i32 = res catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        var r: i32 = 3;
        if eid == @error_id(error.LlmMalformed) {
            r = 1;
        } else if eid == @error_id(error.LlmStreamClosed) {
            r = 2;
        }
        r;
    };
    if status == 0 || status == 1 || status == 2 {
        return status;
    }
    if status != 200 {
        return 4;
    }
    return 0;
}

fn sse_round(case_id: i32, tag: &const byte) bool {
    sse_case = case_id;
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        out_err("selftest: socket() failed\n");
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: bind() failed\n");
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: listen() failed\n");
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: getsockname() failed\n");
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);

    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: fork() failed\n");
        return false;
    };
    if pid64 == 0 {
        const rc: i32 = sse_mock_server(lfd);
        sys_exit(rc);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var url: Buf = buf_new(96);
    _ = buf_append_cstr(&url, "http://127.0.0.1:");
    _ = buf_append_u64(&url, port as u64);
    _ = buf_append_cstr(&url, "/v1/chat/completions");
    var hdrs: Buf = buf_new(128);
    _ = buf_append_cstr(&hdrs, "Content-Type: application/json\r\nAccept: text/event-stream\r\n");
    var body: Buf = buf_new(256);
    _ = buf_append_cstr(&body, "{\"model\":\"selftest-model\",\"stream\":true,\"messages\":[]}");

    var o: ChatOut = chat_out_new();
    const call_rc: i32 = sse_call(url.ptr[0: url.len], hdrs.ptr[0: hdrs.len], &body, &o);

    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    if mock_rc != 0 {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: mock verdict ");
        out_err_dec(mock_rc as usize);
        out_err("\n");
        ok = false;
    }

    if ok && case_id == SSE_CASE_BASIC {
        if call_rc != 0 || !o.saw_done || o.finish != LLM_FINISH_STOP {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: call_rc/finish");
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.content, "Hello, Uya!") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: content=");
            out_err_bytes(o.content.ptr as &const byte, o.content.len);
            out_err("\n");
            ok = false;
        } else if o.usage_in != 60 || o.usage_out != 7 || o.usage_cache_read != 40 || o.usage_reasoning != 3 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: usage");
            out_err("\n");
            ok = false;
        } else if o.ncalls != 0 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: unexpected tool_calls");
            out_err("\n");
            ok = false;
        }
    } else if ok && case_id == SSE_CASE_TOOLS {
        if call_rc != 0 || !o.saw_done || o.finish != LLM_FINISH_TOOL_CALLS {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: call_rc/finish");
            out_err("\n");
            ok = false;
        } else if o.ncalls != 2 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: ncalls=");
            out_err_dec(o.ncalls);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.calls[0].id, "call_a") || !sse_buf_eq(&o.calls[0].name, "read")
            || !sse_buf_eq(&o.calls[0].args, "{\"file_path\":\"a.txt\"}") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: call0=");
            out_err_bytes(o.calls[0].args.ptr as &const byte, o.calls[0].args.len);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.calls[1].id, "call_b") || !sse_buf_eq(&o.calls[1].name, "bash")
            || !sse_buf_eq(&o.calls[1].args, "{\"command\":\"ls\"}") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: call1=");
            out_err_bytes(o.calls[1].args.ptr as &const byte, o.calls[1].args.len);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.content, "I will read it") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: content");
            out_err("\n");
            ok = false;
        }
    } else if ok && case_id == SSE_CASE_NODONE {
        if call_rc != 2 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: expected LlmStreamClosed, got ");
            out_err_dec(call_rc as usize);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.content, "partial") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: content before truncation");
            out_err("\n");
            ok = false;
        }
    } else if ok && case_id == SSE_CASE_BADJSON {
        if call_rc != 1 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: expected LlmMalformed, got ");
            out_err_dec(call_rc as usize);
            out_err("\n");
            ok = false;
        } else if o.err_text.len == 0 {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: no err_text");
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.content, "before-bad") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: content before bad frame");
            out_err("\n");
            ok = false;
        }
    } else if ok && case_id == SSE_CASE_REASONING_LENGTH {
        if call_rc != 2 {
            // 这一轮故意不发 [DONE]，所以是 stream-closed
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: expected LlmStreamClosed, got ");
            out_err_dec(call_rc as usize);
            out_err("\n");
            ok = false;
        } else if !sse_buf_eq(&o.reasoning, "think1think2") {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: reasoning=");
            out_err_bytes(o.reasoning.ptr as &const byte, o.reasoning.len);
            out_err("\n");
            ok = false;
        } else if o.finish != LLM_FINISH_MAX_TOKENS {
            out_err("selftest[");
            out_err(tag);
            out_err("] FAIL: finish != max-tokens");
            out_err("\n");
            ok = false;
        }
    }

    chat_out_free(&o);
    buf_free(&url);
    buf_free(&hdrs);
    buf_free(&body);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}


// ============================================================
// P3 终端层自测（不需要真 TTY：行编辑器是纯字节流逻辑，转义序列可以分片喂）
// ============================================================
fn ty_fail(tag: &const byte, what: &const byte, ok: &bool) void {
    out_err("selftest[");
    out_err(tag);
    out_err("] FAIL: ");
    out_err(what);
    out_err("\n");
    ok[0] = false;
}

fn ty_feed_cstr(ui: &TtyUi, s: &const byte) void {
    tty_feed(ui, s, bufx_cstr_len(s));
}

// 喂单个字节：必须用数组取址，&"\x1b"[0:1] 是**切片**不是指针
fn ty_feed_byte1(ui: &TtyUi, b: byte) void {
    var one: [byte: 1] = [0: 1];
    one[0] = b;
    tty_feed(ui, &one[0], 1);
}

fn ty_line_is(ui: &const TtyUi, want: &const byte) bool {
    const n: usize = bufx_cstr_len(want);
    if ui.line.len != n {
        return false;
    }
    return bufx_mem_eq(ui.line.ptr as &const byte, want, n);
}

fn ty_line_dump(ui: &const TtyUi) void {
    out_err("[");
    out_err_bytes(ui.line.ptr as &const byte, ui.line.len);
    out_err("]");
}

fn tty_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- ABI：termios / winsize 布局与 raw 位运算 ----
    const tsz: usize = @size_of(TtyTermios) as usize;
    if tsz != 60 {
        ty_fail(tag, "TtyTermios 布局不是 60 字节", &ok);
    }
    const wsz: usize = @size_of(TtyWinsize) as usize;
    if wsz != 8 {
        ty_fail(tag, "TtyWinsize 布局不是 8 字节", &ok);
    }
    const all: u32 = 0xFFFFFFFF;
    const lc: u32 = tty_raw_lflag_clear(all);
    if (lc & TTY_LFLAG_TEST_ISIG) != 0 || (lc & TTY_LFLAG_TEST_ICANON) != 0
        || (lc & TTY_LFLAG_TEST_ECHO) != 0 || (lc & TTY_LFLAG_TEST_IEXTEN) != 0 {
        ty_fail(tag, "raw 模式没有清掉 lflag 位", &ok);
    }
    const keep_bit: u32 = 0x00000010;
    if (lc & keep_bit) == 0 {
        ty_fail(tag, "raw 模式误清了无关位", &ok);
    }
    const ic: u32 = tty_raw_iflag_clear(all);
    const icrnl: u32 = 0x00000100;
    const ixon: u32 = 0x00000400;
    if (ic & icrnl) != 0 || (ic & ixon) != 0 {
        ty_fail(tag, "raw 模式没有清掉 iflag 位", &ok);
    }

    // ---- 行编辑 ----
    var ui: TtyUi = tty_ui;
    tty_init(&ui, 0);   // 自测环境下 fd 0 不是 TTY → 只测编辑逻辑，不做渲染

    // 输入 + 回车 → SUBMIT
    ty_feed_cstr(&ui, "abc");
    ty_feed_cstr(&ui, "\r");
    if tty_next_event(&ui) != TTY_EV_SUBMIT {
        ty_fail(tag, "回车没有产生 SUBMIT", &ok);
    }
    if !ty_line_is(&ui, "abc") {
        ty_fail(tag, "提交的行内容不对", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 退格
    ty_feed_cstr(&ui, "abX");
    ty_feed_cstr(&ui, "\x7f");
    if !ty_line_is(&ui, "ab") {
        ty_fail(tag, "退格没删掉最后一个字符", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 左移 + 插入：ac ← + b → abc
    ty_feed_cstr(&ui, "ac");
    ty_feed_cstr(&ui, "\x1b[D");
    ty_feed_cstr(&ui, "b");
    if !ty_line_is(&ui, "abc") {
        ty_fail(tag, "左移插入结果不是 abc", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // Delete 键（ESC [ 3 ~）
    ty_feed_cstr(&ui, "abc");
    ty_feed_cstr(&ui, "\x1b[D\x1b[D");   // 光标到 'b' 前
    ty_feed_cstr(&ui, "\x1b[3~");        // 删 'b'
    if !ty_line_is(&ui, "ac") {
        ty_fail(tag, "Delete 键没有删掉光标处字符", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 转义序列**分片**喂入（状态必须跨调用保持）
    ty_feed_cstr(&ui, "xy");
    ty_feed_byte1(&ui, 27);
    ty_feed_byte1(&ui, 91);
    ty_feed_byte1(&ui, 68);
    ty_feed_cstr(&ui, "z");
    if !ty_line_is(&ui, "xzy") {
        ty_fail(tag, "分片转义序列状态丢了", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 裸 ESC → ESC 事件（中断意图）；由 tty_flush_esc 在一次读取结束时判定
    ty_feed_cstr(&ui, "\x1b");
    tty_flush_esc(&ui);
    if tty_next_event(&ui) != TTY_EV_ESC {
        ty_fail(tag, "裸 ESC 没有产生 ESC 事件", &ok);
    }

    // Ctrl-C / Ctrl-U / Ctrl-D
    ty_feed_cstr(&ui, "keep");
    ty_feed_cstr(&ui, "\x03");
    if tty_next_event(&ui) != TTY_EV_CTRL_C {
        ty_fail(tag, "Ctrl-C 没有产生事件", &ok);
    }
    if !ty_line_is(&ui, "keep") {
        ty_fail(tag, "Ctrl-C 不该清掉已输入文本（由调用方决定）", &ok);
    }
    ty_feed_cstr(&ui, "\x15");   // Ctrl-U
    if tty_next_event(&ui) != TTY_EV_CLEARED || ui.line.len != 0 {
        ty_fail(tag, "Ctrl-U 没有清行", &ok);
    }
    ty_feed_cstr(&ui, "\x04");   // 空行 Ctrl-D
    if tty_next_event(&ui) != TTY_EV_EOF {
        ty_fail(tag, "空行 Ctrl-D 没有产生 EOF", &ok);
    }
    // 非空 Ctrl-D = 删光标处字符（先把光标左移，行尾 Ctrl-D 本就不该删）
    ty_feed_cstr(&ui, "ab");
    ty_feed_cstr(&ui, "\x1b[D");
    ty_feed_cstr(&ui, "\x04");
    if !ty_line_is(&ui, "a") {
        ty_fail(tag, "非空 Ctrl-D 应删除光标处字符", &ok);
        ty_line_dump(&ui);
    }
    // 行尾 Ctrl-D 不应改动内容
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "ab");
    ty_feed_cstr(&ui, "\x04");
    if !ty_line_is(&ui, "ab") {
        ty_fail(tag, "行尾 Ctrl-D 不该改动内容", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // Ctrl-W 删词
    ty_feed_cstr(&ui, "foo bar");
    ty_feed_cstr(&ui, "\x17");
    if !ty_line_is(&ui, "foo ") {
        ty_fail(tag, "Ctrl-W 没有删掉一个词", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // 历史：提交 one → 输入 two → Up 回到 one → Down 回到 two
    ty_feed_cstr(&ui, "one");
    ty_feed_cstr(&ui, "\r");
    _ = tty_next_event(&ui);
    tty_line_clear(&ui);   // 真实调用方在消费 SUBMIT 后清行
    ty_feed_cstr(&ui, "two");
    ty_feed_cstr(&ui, "\x1b[A");
    if !ty_line_is(&ui, "one") {
        ty_fail(tag, "上翻历史没有取到上一条", &ok);
        ty_line_dump(&ui);
    }
    ty_feed_cstr(&ui, "\x1b[B");
    if !ty_line_is(&ui, "two") {
        ty_fail(tag, "下翻历史没有回到暂存行", &ok);
        ty_line_dump(&ui);
    }
    // 前面已经提交过 "abc" 与 "one" 两次，所以历史里应有 2 条
    if ui.hist_len != 2 {
        ty_fail(tag, "历史条数不对", &ok);
    }
    // ---- UTF-8 行编辑：中文 1 字符 3 字节 2 列，按字节编辑必出乱码 ----
    // 退格必须删**整个字符**（只删 1 字节会留下 \xe4\xb8 这种半截序列，屏幕上就是乱码）
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "写一篇");
    ty_feed_cstr(&ui, "\x7f");
    if !ty_line_is(&ui, "写一") {
        ty_fail(tag, "退格没有删掉整个中文字符", &ok);
        ty_line_dump(&ui);
    }
    ty_feed_cstr(&ui, "\x7f\x7f");
    if ui.line.len != 0 {
        ty_fail(tag, "连退三次没有清空中文行", &ok);
        ty_line_dump(&ui);
    }

    // 左右方向键按字符走：光标不能停在字符中间
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "中文ab");
    ty_feed_cstr(&ui, "\x1b[D");          // 退到 'b' 前
    ty_feed_cstr(&ui, "\x1b[D");          // 退到 'a' 前
    ty_feed_cstr(&ui, "\x1b[D");          // 退到「文」前
    ty_feed_cstr(&ui, "X");
    if !ty_line_is(&ui, "中X文ab") {
        ty_fail(tag, "方向键没有按字符移动（插到字符中间了）", &ok);
        ty_line_dump(&ui);
    }

    // Delete：一次删掉光标处的整个中文字符
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "中文");
    ty_feed_cstr(&ui, "\x1b[D");          // 光标到「文」前
    ty_feed_cstr(&ui, "\x1b[3~");
    if !ty_line_is(&ui, "中") {
        ty_fail(tag, "Delete 没有删掉整个中文字符", &ok);
        ty_line_dump(&ui);
    }

    // Ctrl-W：整词删除同样要按字符退
    tty_line_clear(&ui);
    ty_feed_cstr(&ui, "写 中文任务");
    ty_feed_cstr(&ui, "\x17");
    if !ty_line_is(&ui, "写 ") {
        ty_fail(tag, "Ctrl-W 没有整词删掉中文", &ok);
        ty_line_dump(&ui);
    }

    // UTF-8 原语
    if tty_utf8_len(65 as byte) != 1 || tty_utf8_len(0xE5 as byte) != 3 || tty_utf8_len(0xF0 as byte) != 4 {
        ty_fail(tag, "tty_utf8_len 判定不对", &ok);
    }
    if tty_utf8_len(0x80 as byte) != 1 {
        ty_fail(tag, "孤立续字节应按单字节处理（否则编辑会卡死）", &ok);
    }
    const cjk: &const byte = "写a文" as &const byte;      // 3 + 1 + 3 = 7 字节
    if tty_utf8_prev(cjk, 7) != 4 || tty_utf8_prev(cjk, 4) != 3 || tty_utf8_prev(cjk, 3) != 0 {
        ty_fail(tag, "tty_utf8_prev 没有停在字符边界", &ok);
    }
    if tty_utf8_next(cjk, 0, 7) != 3 || tty_utf8_next(cjk, 3, 7) != 4 || tty_utf8_next(cjk, 4, 7) != 7 {
        ty_fail(tag, "tty_utf8_next 步进不对", &ok);
    }
    if tty_utf8_decode(cjk, 0, 7) != 0x5199 || tty_utf8_decode(cjk, 3, 7) != 97 {
        ty_fail(tag, "tty_utf8_decode 解出来的码点不对", &ok);
    }

    // 显示列宽：中文 2 列、ASCII 1 列、组合符 0 列
    if tty_cols_between(cjk, 0, 7) != 5 {
        ty_fail(tag, "「写a文」的显示列数不是 5（2+1+2）", &ok);
    }
    if tty_char_cols(0x5199) != 2 || tty_char_cols(65) != 1 || tty_char_cols(0x0301) != 0 {
        ty_fail(tag, "tty_char_cols 宽度判定不对", &ok);
    }

    // 折行口径：写满整行时光标停在**本行最后一列**（DECAWM 挂起换行），不是下一行第 0 列。
    // 这两个函数口径必须一致，否则擦除会多上移一行、把上一行输出（banner 之类）擦掉。
    var rrow: usize = 0;
    var rcol: usize = 0;
    tty_end_row_col(80, 80, &rrow, &rcol);
    if rrow != 0 || rcol != 79 {
        ty_fail(tag, "写满整行的光标位置口径不对", &ok);
    }
    tty_end_row_col(81, 80, &rrow, &rcol);
    if rrow != 1 || rcol != 1 {
        ty_fail(tag, "折行第二行的光标位置不对", &ok);
    }
    tty_end_row_col(0, 80, &rrow, &rcol);
    if rrow != 0 || rcol != 0 {
        ty_fail(tag, "空行的光标位置不对", &ok);
    }
    if tty_rows_of(0, 80) != 1 || tty_rows_of(80, 80) != 1 || tty_rows_of(81, 80) != 2 || tty_rows_of(160, 80) != 2 {
        ty_fail(tag, "tty_rows_of 行数计算不对", &ok);
    }

    // 擦除序列（协议错一个字节，屏幕上就是乱码/残影）：单行 = \r ESC[J；折行第二行要先上移
    var eseq: [byte: 20] = [0: 20];
    var ek: usize = tty_build_erase_seq(&eseq[0], 0, 0);
    if ek != 4 || eseq[0] != 13 || eseq[1] != 27 || eseq[2] != 91 || eseq[3] != 74 {
        ty_fail(tag, "单行擦除序列不是 CR ESC[J", &ok);
    }
    ek = tty_build_erase_seq(&eseq[0], 2, 0);
    // ESC [ 2 A CR ESC [ J —— 共 8 字节
    if ek != 8 || eseq[0] != 27 || eseq[1] != 91 || eseq[2] != 50 || eseq[3] != 65
        || eseq[4] != 13 || eseq[5] != 27 || eseq[6] != 91 || eseq[7] != 74 {
        ty_fail(tag, "折行擦除序列不是 ESC[2A CR ESC[J", &ok);
    }
    // 上移行数 0 时不能写 ESC[0A —— CSI 参数 0 是「默认值」，终端会当成上移 1 行
    if tty_build_erase_seq(&eseq[0], 0, 0) != 4 || eseq[0] != 13 {
        ty_fail(tag, "cur_row=0 时不该写 ESC[0A", &ok);
    }
    // 输入行块不在第 0 列时（流式输出没换行）：必须先右移到块首列再清，
    // 否则会把同一行前半段的正文一起擦掉
    ek = tty_build_erase_seq(&eseq[0], 0, 12);
    // CR ESC [ 1 2 C ESC [ J —— 共 9 字节
    if ek != 9 || eseq[0] != 13 || eseq[1] != 27 || eseq[2] != 91 || eseq[3] != 49
        || eseq[4] != 50 || eseq[5] != 67 || eseq[6] != 27 || eseq[7] != 91 || eseq[8] != 74 {
        ty_fail(tag, "带起始列的擦除序列不对", &ok);
    }

    // 物理列追踪（输入行的起始列全靠它算）
    ui.cols = 80;
    ui.out_col = 0;
    ui.out_wrap = false;
    tty_advance_col(&ui, "abc" as &const byte, 3);
    if ui.out_col != 3 || ui.out_wrap {
        ty_fail(tag, "写 3 个 ASCII 后列位置不对", &ok);
    }
    tty_advance_col(&ui, "\n" as &const byte, 1);
    if ui.out_col != 0 || ui.out_wrap {
        ty_fail(tag, "换行后列位置没归零", &ok);
    }
    // 正好写满一行：列停在最后一列并挂起待换行
    var pad: [byte: 80] = [0: 80];
    var pi: usize = 0;
    while pi < 80 {
        pad[pi] = 97;
        pi = pi + 1;
    }
    tty_advance_col(&ui, &pad[0], 80);
    if ui.out_col != 79 || !ui.out_wrap {
        ty_fail(tag, "写满整行后没有置「挂起换行」", &ok);
    }
    // 挂起换行状态下写中文：先落到下一行第 0 列，再占 2 列
    tty_advance_col(&ui, cjk, 3);
    if ui.out_col != 2 || ui.out_wrap {
        ty_fail(tag, "挂起换行后写中文的列位置不对", &ok);
    }
    // 十进制写入（光标回退/列定位都用它）
    var dnum: [byte: 8] = [0: 8];
    if tty_put_dec(&dnum[0], 0, 4) != 1 || dnum[0] != 48 {
        ty_fail(tag, "tty_put_dec(0) 不对", &ok);
    }
    if tty_put_dec(&dnum[0], 1234, 4) != 4 || dnum[0] != 49 || dnum[3] != 52 {
        ty_fail(tag, "tty_put_dec(1234) 不对", &ok);
    }

    tty_free(&ui);

    // 一次喂入多行（粘贴）：必须一行一个 SUBMIT，剩下的一行留在 pend 里等下次处理
    tty_line_clear(&ui);
    while tty_next_event(&ui) != TTY_EV_NONE {
    }
    ty_feed_cstr(&ui, "a\nb\n");
    if tty_next_event(&ui) != TTY_EV_SUBMIT {
        ty_fail(tag, "粘贴多行时第一行没有产生 SUBMIT", &ok);
    }
    if !ty_line_is(&ui, "a") {
        ty_fail(tag, "粘贴多行时第一行内容不对", &ok);
        ty_line_dump(&ui);
    }
    if !tty_has_pending(&ui) {
        ty_fail(tag, "第二行没有留在 pend 缓冲里", &ok);
    }
    tty_line_clear(&ui);
    tty_feed(&ui, null as &const byte, 0);
    if tty_next_event(&ui) != TTY_EV_SUBMIT {
        ty_fail(tag, "pend 里的第二行没有产生 SUBMIT", &ok);
    }
    if !ty_line_is(&ui, "b") {
        ty_fail(tag, "pend 里的第二行内容不对", &ok);
        ty_line_dump(&ui);
    }
    tty_line_clear(&ui);

    // getcwd 的长度含结尾 NUL：剥掉之后工作目录里不能有 NUL（真机踩过）
    var wsc: Config = cfg_default();
    if agent_workspace_set_cwd(&wsc) {
        if buf_has_nul(&wsc.workspace) {
            ty_fail(tag, "工作目录里残留了 NUL", &ok);
        }
        if wsc.workspace.len == 0 {
            ty_fail(tag, "工作目录为空", &ok);
        }
    }
    cfg_free(&wsc);

    // 中断时保留「非空白前缀」的规则（DSH 语义）
    const trim_in: &const byte = "abc  \n\t " as &const byte;
    const trimmed: usize = agent_trim_trailing_ws(trim_in, 8);
    if trimmed != 3 {
        ty_fail(tag, "尾部空白没有被裁掉", &ok);
    }
    const all_ws: &const byte = "  \n" as &const byte;
    if agent_trim_trailing_ws(all_ws, 3) != 0 {
        ty_fail(tag, "全空白应裁成 0", &ok);
    }
    const none_ws: &const byte = "keep" as &const byte;
    if agent_trim_trailing_ws(none_ws, 4) != 4 {
        ty_fail(tag, "无尾部空白不该改动长度", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}


// ============================================================
// P4 会话自测：写日志 → 逐行校验 → 崩溃尾部裁剪 → 恢复重建历史
// ============================================================
fn sess_round(tag: &const byte) bool {
    var ok: bool = true;
    var home: Buf = buf_new(512);
    defer { buf_free(&home); }
    _ = buf_append_cstr(&home, "build/selftest_sess_home");
    _ = buf_append_byte(&home, 0);
    _ = sess_mkdir_p(home.ptr as &const byte);
    // 清掉旧文件，保证这一轮是干净的
    var idx: Buf = buf_new(600);
    defer { buf_free(&idx); }
    _ = buf_append_cstr(&idx, "build/selftest_sess_home/index.jsonl");
    _ = buf_append_byte(&idx, 0);
    _ = sys_unlink(idx.ptr as *const byte) catch {};

    // ---- 1) 写：header + 若干事件 ----
    var log: SessionLog = sess_log_empty();
    defer { sess_log_free(&log); }
    if !sess_open(&log, "build/selftest_sess_home", "build/selftest_sess_ws", "selftest-model", "uya-agent", "", true, 0 as i64, true) {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: sess_open\\n");
        return false;
    }
    if log.id.len < 10 || log.path.len == 0 {
        ty_fail(tag, "会话 id/路径没生成", &ok);
    }
    var ev: Buf = buf_new(4096);
    defer { buf_free(&ev); }
    // user/message
    if !sess_begin(&log, "user/message", &ev) {
        ty_fail(tag, "sess_begin 失败", &ok);
    }
    _ = buf_append_cstr(&ev, "{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":");
    _ = jw_str_into(&ev, "写一个 hello\n带换行 \"引号\"", bufx_cstr_len("写一个 hello\n带换行 \"引号\""));
    _ = buf_append_cstr(&ev, "}],\"source\":{\"kind\":\"user\"}}");
    _ = sess_end(&log, &ev);
    // assistant/message（带 tool_calls，arguments 里有转义）
    if !sess_begin(&log, "assistant/message", &ev) {
        ty_fail(tag, "assistant 事件开始失败", &ok);
    }
    _ = buf_append_cstr(&ev, "{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":\"我来写\",\"tool_calls\":[{\"id\":\"call_s1\",\"type\":\"function\",\"function\":{\"name\":\"write_file\",\"arguments\":");
    _ = jw_str_into(&ev, "{\"path\":\"note.txt\",\"content\":\"hello\"}", bufx_cstr_len("{\"path\":\"note.txt\",\"content\":\"hello\"}"));
    _ = buf_append_cstr(&ev, "}}]},\"usage\":{\"inputTokens\":7}}");
    _ = sess_end(&log, &ev);
    // tool/result
    if !sess_begin(&log, "tool/result", &ev) {
        ty_fail(tag, "tool/result 事件开始失败", &ok);
    }
    _ = buf_append_cstr(&ev, "{\"turn\":1,\"step\":1,\"callId\":\"call_s1\",\"content\":");
    _ = jw_str_into(&ev, "wrote 5 bytes", bufx_cstr_len("wrote 5 bytes"));
    _ = buf_append_cstr(&ev, "}");
    _ = sess_end(&log, &ev);
    buf_reset(&log.title);
    _ = buf_append_cstr(&log.title, "写一个 hello");
    if log.events != 3 {
        ty_fail(tag, "事件计数不对", &ok);
    }
    var id_copy: Buf = buf_new(64);
    defer { buf_free(&id_copy); }
    _ = buf_append(&id_copy, log.id.ptr, log.id.len);
    var path_copy: Buf = buf_new(1200);
    defer { buf_free(&path_copy); }
    _ = buf_append(&path_copy, log.path.ptr, log.path.len);
    _ = buf_append_byte(&path_copy, 0);
    sess_close(&log, "build/selftest_sess_home");

    // ---- 2) 读回：header、逐行事件、字段还原 ----
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path_copy.ptr as &const byte, &r) {
        ty_fail(tag, "会话文件读不回来", &ok);
        return ok;
    }
    if !r.header_ok || r.id.len == 0 {
        ty_fail(tag, "header 没解析出来", &ok);
    }
    if !bufx_eq_cstr(r.id.ptr as &const byte, r.id.len, id_copy.ptr as &const byte) && r.id.len != id_copy.len {
        ty_fail(tag, "header id 与写入不一致", &ok);
    }
    var line: Buf = buf_new(8192);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    var args: Buf = buf_new(8192);
    defer { buf_free(&args); }
    var n_lines: i32 = 0;
    var expect_seq: i64 = 0;
    var saw_user: bool = false;
    var saw_calls: bool = false;
    var saw_result: bool = false;
    while sess_next(&r, &line) {
        n_lines = n_lines + 1;
        const seq: i64 = sess_line_seq(&line);
        if seq != expect_seq {
            ty_fail(tag, "seq 不连续", &ok);
        }
        expect_seq = seq + 1;
        if !sess_line_type(&line, &typ) {
            ty_fail(tag, "事件没有 type", &ok);
            continue;
        }
        const view: &[byte] = line.ptr[0: line.len];
        if sv_eq_cstr(&typ, "user/message") {
            saw_user = true;
            if !sess_json_str(view, "text", &text) || !sess_line_has(&text, "带换行") {
                ty_fail(tag, "用户文本没有正确落盘/反转义", &ok);
            }
        } else if sv_eq_cstr(&typ, "assistant/message") {
            if !sess_extract_array(view, "tool_calls", &args) {
                ty_fail(tag, "tool_calls 数组没提取出来", &ok);
            } else {
                saw_calls = true;
                if !sess_line_has(&args, "call_s1") {
                    ty_fail(tag, "tool_calls 里没有 call_s1", &ok);
                }
                if !sess_line_has(&args, "\\\"path\\\"") {
                    ty_fail(tag, "arguments 的转义层级不对", &ok);
                }
            }
        } else if sv_eq_cstr(&typ, "tool/result") {
            saw_result = true;
            if !sess_json_str(view, "callId", &text) || !sess_line_has(&text, "call_s1") {
                ty_fail(tag, "tool/result 的 callId 不对", &ok);
            }
        }
    }
    if n_lines != 3 || !saw_user || !saw_calls || !saw_result {
        ty_fail(tag, "读回的事件条数/种类不对", &ok);
    }
    if r.dropped_tail {
        ty_fail(tag, "正常文件不该被判为截断", &ok);
    }

    // ---- 3) 崩溃尾部：手动追加半条记录，读的时候必须丢掉它 ----
    var ap: Buf = buf_new(1300);
    defer { buf_free(&ap); }
    _ = buf_append_cstr(&ap, path_copy.ptr as &const byte);
    _ = buf_append_byte(&ap, 0);
    const flags: i32 = (O_WRONLY | O_APPEND) as i32;
    const fd: i32 = sys_open(ap.ptr as *const byte, flags, 420) catch {
        -1;
    };
    if fd >= 0 {
        const half: &const byte = "{\"type\":\"tool/result\",\"seq\":3,\"time\":1,\"data\":{\"callId\":\"call_x\"" as &const byte;
        _ = write_all_fd(fd, half, bufx_cstr_len(half));
        _ = sys_close(fd) catch {};
    }
    var r2: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r2); }
    if !sess_reader_load(ap.ptr as &const byte, &r2) {
        ty_fail(tag, "带残缺尾部的文件读不回来", &ok);
    }
    var n2: i32 = 0;
    while sess_next(&r2, &line) {
        n2 = n2 + 1;
    }
    if n2 != 3 {
        ty_fail(tag, "残缺尾部应被丢弃（应读到 3 条）", &ok);
    }
    if !r2.dropped_tail {
        ty_fail(tag, "没有标记 dropped_tail", &ok);
    }

    // ---- 4) 恢复：用日志重建消息历史 ----
    var h: History = hist_init();
    defer { hist_free(&h); }
    var next_seq0: i64 = 0;
    var c_hist: Config = cfg_default();
    c_hist.model = buf_new(32);
    _ = buf_append_cstr(&c_hist.model, "selftest-model");
    c_hist.workspace = buf_new(64);
    _ = buf_append_cstr(&c_hist.workspace, "build/selftest_sess_ws");
    const restored: i32 = agent_hist_from_log(&c_hist, &h, &path_copy, &next_seq0);
    cfg_free(&c_hist);
    if restored != 3 {
        ty_fail(tag, "恢复的消息条数不对", &ok);
    }
    // system +（运行上下文等注入）+ user + assistant(带 calls) + tool
    // 注入条数不固定（AGENTS.md 取决于工作区），所以从**尾部**校验恢复出来的三条
    const nmsg: usize = h.len;
    if nmsg < 4 {
        ty_fail(tag, "恢复后的历史长度不对", &ok);
    } else if msg_role_at(&h, nmsg - 2) != ROLE_ASSISTANT_CALLS || msg_role_at(&h, nmsg - 1) != ROLE_TOOL {
        ty_fail(tag, "恢复后的角色不对", &ok);
    } else if !msg_extra_is(&h, nmsg - 1, "call_s1") {
        ty_fail(tag, "恢复后的 tool_call_id 不对", &ok);
    } else {
        // 恢复出来的历史必须能原样再序列化成请求
        var req: Buf = buf_new(65536);
        defer { buf_free(&req); }
        var c2: Config = cfg_default();
        c2.model = buf_new(32);
        _ = buf_append_cstr(&c2.model, "selftest-model");
        if !build_chat_request(&c2, &h, &req) {
            ty_fail(tag, "恢复的历史无法组装请求", &ok);
        } else if !contains(&req, "\"tool_call_id\":\"call_s1\"") || !contains(&req, "\"tool_calls\"") {
            ty_fail(tag, "恢复的历史里缺少严格协议字段", &ok);
        }
        cfg_free(&c2);
    }

    // ---- 5) 索引 + 最近会话查找 ----
    if !sess_find_last("build/selftest_sess_home", "", &line) {
        ty_fail(tag, "sess_find_last 找不到刚写的会话", &ok);
    }
    var fpath: Buf = buf_new(1200);
    defer { buf_free(&fpath); }
    if !sess_find("build/selftest_sess_home", "build/selftest_sess_ws", id_copy.ptr as &const byte, id_copy.len, &fpath) {
        ty_fail(tag, "sess_find 按 id 找不到会话", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\\n");
    }
    return ok;
}

fn sess_line_has(b: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if b.len < n {
        return false;
    }
    return find_sub(b.ptr[0: b.len], lit[0: n], 0) >= 0;
}


// ============================================================
// P5 自测：DSH 设置解析（假 DSH_HOME）+ YAML 预处理
// ============================================================
// 历史消息的安全访问（固定数组下标的证明放在函数内部）
fn msg_role_at(h: &const History, i: usize) u8 {
    if i >= MSG_MAX {
        return 255;
    }
    return h.items[i].role;
}

fn msg_extra_is(h: &const History, i: usize, lit: &const byte) bool {
    if i >= MSG_MAX {
        return false;
    }
    const m: &const Msg = &h.items[i];
    if m.extra_len == 0 {
        return false;
    }
    return bufx_eq_cstr(m.extra as &const byte, m.extra_len, lit);
}

fn write_text_file(path: &const byte, text: &const byte) bool {
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(path as *const byte, flags, 420) catch {
        return false;
    };
    const n: usize = bufx_cstr_len(text);
    const ok: bool = write_all_fd(fd, text, n);
    _ = sys_close(fd) catch {};
    return ok;
}

fn dshcfg_round(tag: &const byte) bool {
    var ok: bool = true;
    const home: &const byte = "build/selftest_dsh_home";
    _ = sess_mkdir_p("build/selftest_dsh_home");
    var spath: Buf = buf_new(256);
    defer { buf_free(&spath); }
    _ = buf_append_cstr(&spath, home);
    _ = buf_append_cstr_z(&spath, "/settings.yaml");
    const settings: &const byte = "# 顶层注释：这一行必须被去掉\nllm-pi-ai:\n  providers:\n    {\n      fakeprov:\n        {\n          apiKeyEnv: FAKE_API_KEY,\n          api: openai-completions,\n          baseURL: https://fake.example/v1,   # 行尾注释\n          models:\n            [\n              { id: fake-model, contextWindow: 65536, maxTokens: 4096, input: [ text, image ] }\n            ]\n        }\n    }\nagent-presets:\n  default: standard\nagent-default-model:\n  provider: fakeprov\n  model: fake-model\n  reasoningEffort: high\npermission:\n  defaultPreset: workspace-write\nuya-agent:\n  tls: { verify: pin, pin: abc123 }\nplan: |\n  # 块标量里的井号必须保留\n  second line\ndisabled_row: !!js process.platform === 'win32'\n";
    if !write_text_file(&spath.ptr[0] as &const byte, settings) {
        ty_fail(tag, "写 settings.yaml 失败", &ok);
        return false;
    }
    var cpath: Buf = buf_new(256);
    defer { buf_free(&cpath); }
    _ = buf_append_cstr(&cpath, home);
    _ = buf_append_cstr_z(&cpath, "/.credentials.yaml");
    const creds: &const byte = "version: 1\nrefs:\n  FAKE_API_KEY: sk-fake-123456\n";
    if !write_text_file(&cpath.ptr[0] as &const byte, creds) {
        ty_fail(tag, "写 .credentials.yaml 失败", &ok);
    }
    // 确保环境变量不会抢先（否则测的是 env 而不是当前逻辑）

    var dsh: DshCfg = dsh_cfg_empty();
    defer { dsh_cfg_free(&dsh); }
    if !dsh_cfg_load(home, "build/selftest_dsh_ws", &dsh) {
        ty_fail(tag, "dsh_cfg_load 失败", &ok);
        return false;
    }
    if !ty_buf_is(&dsh.provider, "fakeprov") {
        ty_fail(tag, "provider 解析错", &ok);
    }
    if !ty_buf_is(&dsh.model, "fake-model") {
        ty_fail(tag, "model 解析错", &ok);
    }
    if !ty_buf_is(&dsh.base_url, "https://fake.example/v1") {
        ty_fail(tag, "baseURL 解析错（行尾注释没被去掉？）", &ok);
        out_err("[dbg] base_url=");
        out_err_bytes(dsh.base_url.ptr, dsh.base_url.len);
        out_err("\n");
    }
    if !ty_buf_is(&dsh.api_key_env, "FAKE_API_KEY") {
        ty_fail(tag, "apiKeyEnv 解析错", &ok);
    }
    if !ty_buf_is(&dsh.api_key, "sk-fake-123456") || dsh.key_src != DSHSRC_CREDS {
        ty_fail(tag, "凭据没有从 .credentials.yaml 取到", &ok);
    }
    if dsh.context_window != 65536 {
        ty_fail(tag, "contextWindow 解析错", &ok);
    }
    if dsh.max_tokens != 4096 {
        ty_fail(tag, "maxTokens 解析错", &ok);
    }
    if !dsh.input_image {
        ty_fail(tag, "input 里的 image 没识别出来", &ok);
    }
    if !ty_buf_is(&dsh.reasoning_effort, "high") {
        ty_fail(tag, "reasoningEffort 解析错", &ok);
    }
    if !dsh.confine_set || !dsh.confine {
        ty_fail(tag, "workspace-write 应当推出 confine=true", &ok);
    }
    if !ty_buf_is(&dsh.tls_verify, "pin") || !ty_buf_is(&dsh.tls_pin, "abc123") {
        ty_fail(tag, "uya-agent.tls 命名空间没读到", &ok);
    }
    if !ty_buf_is(&dsh.preset_default, "standard") {
        ty_fail(tag, "agent-presets.default 解析错", &ok);
    }

    // YAML 预处理：注释被去掉、块标量里的 # 保留、!!js 被中和成带引号标量
    var ytree: YTree = YTree{ nodes: [], n: 0, lines: [], nlines: 0, raw: buf_empty(), cur: 0, err_line: 0 };
    yt_init(&ytree);
    defer { yt_free(&ytree); }
    if !yt_load_file(&spath.ptr[0] as &const byte, &ytree) {
        ty_fail(tag, "yt_load_file 失败", &ok);
        return ok;
    }
    const r: i32 = yt_root(&ytree);
    const plan: i32 = yt_get(&ytree, r, "plan");
    const pv: &[byte] = yt_str(&ytree, plan);
    if pv.len == 0 || !sess_has_cstr(pv, "# 块标量里的井号必须保留") {
        ty_fail(tag, "块标量里的注释被误删了", &ok);
    }
    const dis: i32 = yt_get(&ytree, r, "disabled_row");
    const dv: &[byte] = yt_str(&ytree, dis);
    if dv.len == 0 || !sess_has_cstr(dv, "process.platform") {
        ty_fail(tag, "!!js 标签没有被中和成标量", &ok);
    }
    if pv.len > 0 && sess_has_cstr(pv, "# 顶层注释") {
        ty_fail(tag, "顶层注释没有被去掉", &ok);
    }

    // 真机 DSH：存在就顺带校验一次（不存在就跳过，保持自测离线）
    const realhome: &byte = getenv("HOME");
    if (realhome as usize) != 0 {
        var rh: Buf = buf_new(1024);
        defer { buf_free(&rh); }
        _ = buf_append_cstr(&rh, realhome);
        _ = buf_append_cstr(&rh, "/.dsh");
        _ = buf_append_byte(&rh, 0);
        var rsettings: Buf = buf_new(1200);
        defer { buf_free(&rsettings); }
        _ = buf_append_cstr(&rsettings, rh.ptr as &const byte);
        _ = buf_append_cstr_z(&rsettings, "/settings.yaml");
        if sess_file_exists(rsettings.ptr as &const byte) {
            var real: DshCfg = dsh_cfg_empty();
            defer { dsh_cfg_free(&real); }
            if dsh_cfg_load(&rh.ptr[0] as &const byte, ".", &real) {
                if real.provider.len == 0 || real.model.len == 0 {
                    ty_fail(tag, "真实 ~/.dsh 里没解析出 provider/model", &ok);
                }
            } else {
                ty_fail(tag, "真实 ~/.dsh/settings.yaml 解析失败", &ok);
            }
        }
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

fn ty_buf_is(b: &const Buf, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    if b.len != n {
        return false;
    }
    return bufx_mem_eq(b.ptr as &const byte, lit, n);
}

// 文件工具轮的 6 个调用（write 未读→拒 / read 窗口 / write 读后覆盖 / edit 多匹配→拒 /
// edit 成功 / edit 找不到）
fn mock_fs_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-fs");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    mock_call(&w, "fs_1", "write", "{\"file_path\":\"doc.txt\",\"content\":\"x\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_2", "read", "{\"file_path\":\"doc.txt\",\"offset\":2,\"limit\":2}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_3", "write", "{\"file_path\":\"doc.txt\",\"content\":\"alpha one\\nbeta two\\ngamma three\\nbeta four\\ndelta five\\n\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_4", "edit", "{\"file_path\":\"doc.txt\",\"old_string\":\"beta\",\"new_string\":\"BETA\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_5", "edit", "{\"file_path\":\"doc.txt\",\"old_string\":\"alpha\",\"new_string\":\"ALPHA\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_6", "edit", "{\"file_path\":\"doc.txt\",\"old_string\":\"zzz\",\"new_string\":\"y\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_7", "glob", "{\"pattern\":\"*.txt\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_8", "grep", "{\"pattern\":\"beta\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_9", "grep", "{\"pattern\":\"nosuchthingzzz\"}");
    jw_byte(&w, 44);
    mock_call(&w, "fs_10", "glob", "{\"pattern\":\"*.nomatch\"}");
    jw_byte(&w, 93);       // ] tool_calls
    jw_byte(&w, 125);      // } message
    jw_byte(&w, 44);       // ,   ← finish_reason 属于 choice，不能写到 choices 外面
    jw_key(&w, "finish_reason");
    jw_str_cstr(&w, "tool_calls");
    jw_byte(&w, 125);      // } choice
    jw_byte(&w, 93);       // ] choices
    jw_byte(&w, 125);      // } root
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);   // 必须回填长度，否则发出去的是 0 字节（踩过）
    return true;
}

// 文件工具轮的 workspace 准备：先放一个 doc.txt（内容已知）
fn fs_ws_prepare(ws: &const byte) bool {
    if !ws_prepare(ws) {
        return false;
    }
    var p: Buf = buf_new(256);
    defer { buf_free(&p); }
    _ = buf_append_cstr(&p, ws);
    _ = buf_append_cstr_z(&p, "/doc.txt");
    if !write_text_file(&p.ptr[0] as &const byte, "alpha one\nbeta two\ngamma three\nbeta four\ndelta five\n") {
        return false;
    }
    buf_reset(&p);
    _ = buf_append_cstr(&p, ws);
    _ = buf_append_cstr_z(&p, "/note.txt");
    return write_text_file(&p.ptr[0] as &const byte, "hello-selftest");
}

// 文件工具轮：断言最终落盘内容（write 覆盖 + edit 替换各一次）
fn fs_round(base: &const Config, tag: &const byte, ws: &const byte) bool {
    mock_mode = 7;
    mock_expect_shell = false;
    mock_expect_fold = false;
    mock_expect_steer = false;
    if !fs_ws_prepare(ws) {
        out_err("selftest: cannot prepare fs workspace\n");
        return false;
    }
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        out_err("selftest: socket() failed\n");
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var c: Config = cfg_default();
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append_cstr(&c.task, "玩一下文件工具");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = false;
    c.stream = true;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.quiet = true;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    const rc: i32 = agent_run(&c);
    cfg_free(&c);
    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if rc != AGENT_OK {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else {
        // 最终内容：write 覆盖成 5 行，edit 把 alpha → ALPHA
        var p2: Buf = buf_new(256);
        defer { buf_free(&p2); }
        _ = buf_append_cstr(&p2, ws);
        _ = buf_append_cstr_z(&p2, "/doc.txt");
        const want: &const byte = "ALPHA one\nbeta two\ngamma three\nbeta four\ndelta five\n";
        if !file_equals(&p2.ptr[0] as &const byte, want) {
            out_err("FAIL: doc.txt 内容不符");
            ok = false;
        } else {
            out_err("ok");
        }
    }
    out_err("\n");
    _ = base;
    return ok;
}

// bash/jobs 轮的 6 个调用
fn mock_jobs_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-jobs");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    mock_call(&w, "jb_1", "bash", "{\"command\":\"sleep 1; echo BG-DONE\",\"description\":\"short background echo\",\"run_in_background\":true}");
    jw_byte(&w, 44);
    mock_call(&w, "jb_2", "bash", "{\"command\":\"sleep 30\",\"description\":\"long background sleep\",\"run_in_background\":true}");
    jw_byte(&w, 44);
    mock_call(&w, "jb_3", "job_list", "{}");
    jw_byte(&w, 44);
    mock_call(&w, "jb_4", "job_output", "{\"job_id\":\"job-1\",\"wait\":true,\"timeout_ms\":15000}");
    jw_byte(&w, 44);
    mock_call(&w, "jb_5", "job_kill", "{\"job_id\":\"job-2\",\"reason\":\"test cancellation\"}");
    jw_byte(&w, 44);
    mock_call(&w, "jb_6", "bash", "{\"command\":\"true\",\"description\":\"silent command\"}");
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 44);
    jw_key(&w, "finish_reason");
    jw_str_cstr(&w, "tool_calls");
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// bash/jobs 轮
fn jobs_round(base: &const Config, tag: &const byte, ws: &const byte) bool {
    mock_mode = 9;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    if !ws_prepare(ws) {
        out_err("selftest: cannot prepare jobs workspace\n");
        return false;
    }
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var c: Config = cfg_default();
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append_cstr(&c.task, "玩一下后台任务");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.max_steps = 4;
    c.timeout_ms = 20000;
    c.quiet = true;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    const rc: i32 = agent_run(&c);
    cfg_free(&c);
    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    out_err("selftest[");
