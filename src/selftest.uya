    jw_key(&w, "output_index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "delta");
    jw_str_cstr(&w, answer);
    jw_byte(&w, 125);
    if !resp_emit(out, &w, &payload) {
        return false;
    }

    jw_init(&w, payload.ptr, payload.cap);
    jw_byte(&w, 123);
    jw_key(&w, "type");
    jw_str_cstr(&w, "response.completed");
    jw_byte(&w, 44);
    jw_key(&w, "response");
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "resp_r2");
    jw_byte(&w, 44);
    jw_key(&w, "status");
    jw_str_cstr(&w, "completed");
    jw_byte(&w, 44);
    jw_key(&w, "output");
    jw_byte(&w, 91);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    return resp_emit(out, &w, &payload);
}

// Responses 非流式：一个 function_call
fn mock_resp_json_tool(out: &Buf, marker: &const byte) bool {
    var cmd: Buf = buf_new(256);
    defer { buf_free(&cmd); }
    if !mock_resp_args(&cmd, marker) {
        return false;
    }
    var args: Buf = buf_new(512);
    defer { buf_free(&args); }
    var wa: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&wa, args.ptr, args.cap);
    jw_byte(&wa, 123);
    jw_key(&wa, "command");
    jw_str(&wa, cmd.ptr, cmd.len);
    jw_byte(&wa, 44);
    jw_key(&wa, "description");
    jw_str_cstr(&wa, "echo a marker");
    jw_byte(&wa, 125);
    args.len = jw_used(&wa);

    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "resp_ns1");
    jw_byte(&w, 44);
    jw_key(&w, "status");
    jw_str_cstr(&w, "completed");
    jw_byte(&w, 44);
    jw_key(&w, "output");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "type");
    jw_str_cstr(&w, "function_call");
    jw_byte(&w, 44);
    jw_key(&w, "id");
    jw_str_cstr(&w, "fc_ns1");
    jw_byte(&w, 44);
    jw_key(&w, "call_id");
    jw_str_cstr(&w, "call_r1");
    jw_byte(&w, 44);
    jw_key(&w, "name");
    jw_str_cstr(&w, "bash");
    jw_byte(&w, 44);
    jw_key(&w, "arguments");
    jw_str(&w, args.ptr, args.len);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 44);
    jw_key(&w, "usage");
    jw_byte(&w, 123);
    jw_key(&w, "input_tokens");
    jw_i64(&w, 20);
    jw_byte(&w, 44);
    jw_key(&w, "output_tokens");
    jw_i64(&w, 6);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

