// src/selftest.uya — 离线自测（内置 mock LLM）+ 传输层探针
//
// --selftest 完全不联网、不需要 API key：
//   1) 父进程 bind 127.0.0.1:0 拿到端口，fork 出子进程跑 mock LLM；
//   2) 父进程用 http://127.0.0.1:<port>/v1 跑完整的 agent 循环（build_request →
//      http_request → std.json 解析 → 工具执行 → 结果回灌 → 第二轮）；
//   3) mock 端断言：第一轮请求的 tools 里 run_shell 的出现与否符合预期，
//      第二轮请求里必须带上工具执行结果；父进程断言写出的文件内容与退出码。
//   共跑两轮：allow_shell=true / false，覆盖 A3 与 A6。

use libc.syscall;
use libc.unistd;
use libc.heap;
use std.json.encoder.JsonWriter;

var mock_expect_shell: bool = true;

// 自测轮次模式（fork 前设置，子进程继承）：
//   0 = shell 轮（write_file，tools 里应有 run_shell）
//   1 = no-shell 轮（write_file，tools 里不应有 run_shell）
//   2 = tools 轮（read_file 成功 / read_file 越权被拒 / run_shell 超时被杀；末轮响应用 chunked）
//   3 = HTTP 401（非 200 必须报错退出，且把错误体打出来）
//   5 = max-steps 熔断（模型每轮都调工具，agent 必须在 N 步后停下）
var mock_mode: i32 = 0;

// ============================================================
// 探针
// ============================================================
export fn probe_main(cfg: &const Config) i32 {
    var url: Buf = chat_url(cfg);
    defer { buf_free(&url); }
    if !buf_valid(&url) {
        out_err("error: out of memory\n");
        return AGENT_PROTO;
    }
    var hdrs: Buf = buf_new(512);
    defer { buf_free(&hdrs); }
    if !build_headers(cfg, &hdrs) {
        out_err("error: out of memory\n");
        return AGENT_PROTO;
    }
    // 探针用配置里的 model 发一个最小请求：这样一次就能同时验证
    // 网络 / TLS / 鉴权 / model 名字 四件事
    var payload: Buf = buf_new(512);
    defer { buf_free(&payload); }
    var pw: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&pw, payload.ptr, payload.cap);
    jw_byte(&pw, 123);
    jw_key(&pw, "model");
    jw_str(&pw, cfg.model.ptr, cfg.model.len);
    jw_byte(&pw, 44);
    jw_key(&pw, "messages");
    jw_byte(&pw, 91);
    jw_byte(&pw, 123);
    jw_key(&pw, "role");
    jw_str_cstr(&pw, "user");
    jw_byte(&pw, 44);
    jw_key(&pw, "content");
    jw_str_cstr(&pw, "ping");
    jw_byte(&pw, 125);
    jw_byte(&pw, 93);
    jw_byte(&pw, 44);
    jw_key(&pw, "max_tokens");
    jw_i64(&pw, 8);
    jw_byte(&pw, 125);
    if jw_overflow(&pw) {
        out_err("error: probe payload overflow\n");
        return AGENT_PROTO;
    }
    payload.len = jw_used(&pw);

    out_err("probe: POST ");
    out_err_bytes(url.ptr, url.len);
    out_err("\n");

    var r: Resp = resp_empty();
    defer { resp_free(&r); }
    var tc: TlsConn = tls_conn_empty();
    var guard: FdGuard = FdGuard{ saved: -1, nullfd: -1, active: false };
    tls_noise_mute(&guard, !cfg.tls_debug && !hc_debug);
    const call_res: !void = http_request(
        url.ptr[0: url.len],
        &"POST"[0: 4],
        hdrs.ptr[0: hdrs.len],
        payload.ptr as &const byte,
        payload.len,
        cfg.timeout_ms,
        cfg.max_response,
        cfg.verify,
        cfg.pin.ptr[0: cfg.pin.len],
        &r,
        &tc
    );
    tls_noise_unmute(&guard);
    _ = call_res catch |err| {
        out_err("probe: request failed, error name = ");
        const nm: *byte = @error_name(err);
        _ = sys_write(2, nm as *const byte, strlen(nm as &const byte)) catch {};
        out_err("\n");
        if tc.observed_len > 0 {
            out_err("probe: observed leaf sha256 = ");
            out_err_bytes(&tc.observed[0], tc.observed_len);
            out_err("\n");
        }
        return AGENT_NET;
    };
    out_err("probe: HTTP status = ");
    out_err_dec(r.status as usize);
    out_err("\n");
    if tc.observed_len > 0 {
        out_err("probe: leaf_sha256 = ");
        out_err_bytes(&tc.observed[0], tc.observed_len);
        out_err("\n");
    } else {
        out_err("probe: leaf_sha256 = (plain HTTP, no certificate)\n");
    }
    var n: usize = r.body.len;
    if n > 400 {
        n = 400;
    }
    out_err("probe: body[0..");
    out_err_dec(n);
    out_err("] =\n");
    out_err_bytes(r.body.ptr, n);
    out_err("\n");
    return AGENT_OK;
}

// ============================================================
// mock LLM 的响应体
// ============================================================
fn mock_toolcall_body(out: &Buf, with_shell: bool) bool {
    var inner: Buf = buf_new(256);
    defer { buf_free(&inner); }
    if !buf_valid(&inner) {
        return false;
    }
    var wi: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&wi, inner.ptr, inner.cap);
    jw_byte(&wi, 123);
    jw_key(&wi, "path");
    jw_str_cstr(&wi, "note.txt");
    jw_byte(&wi, 44);
    jw_key(&wi, "content");
    jw_str_cstr(&wi, "hello-selftest");
    jw_byte(&wi, 125);
    if jw_overflow(&wi) {
        return false;
    }
    inner.len = jw_used(&wi);

    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-selftest");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "call_1");
    jw_byte(&w, 44);
    jw_key(&w, "type");
    jw_str_cstr(&w, "function");
    jw_byte(&w, 44);
    jw_key(&w, "function");
    jw_byte(&w, 123);
    jw_key(&w, "name");
    jw_str_cstr(&w, "write_file");
    jw_byte(&w, 44);
    jw_key(&w, "arguments");
    jw_str(&w, inner.ptr, inner.len);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    if with_shell {
        // 同一轮里再来一个 run_shell 调用，覆盖 fork+pipe+exec+退出码 这条路径
        jw_byte(&w, 44);
        jw_byte(&w, 123);
        jw_key(&w, "id");
        jw_str_cstr(&w, "call_2");
        jw_byte(&w, 44);
        jw_key(&w, "type");
        jw_str_cstr(&w, "function");
        jw_byte(&w, 44);
        jw_key(&w, "function");
        jw_byte(&w, 123);
        jw_key(&w, "name");
        jw_str_cstr(&w, "run_shell");
        jw_byte(&w, 44);
        jw_key(&w, "arguments");
        jw_str_cstr(&w, "{\"command\":\"echo SELFTEST-SHELL-OK; pwd\"}");
        jw_byte(&w, 125);
        jw_byte(&w, 125);
    }
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

fn mock_final_body(out: &Buf, marker: &const byte) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-selftest");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_str_cstr(&w, marker);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// ============================================================
// mock LLM 服务端（跑在 fork 出的子进程里）
// ============================================================
fn contains(hay: &const Buf, needle: &const byte) bool {
    const view: &[byte] = hay.ptr[0: hay.len];
    return find_sub(view, needle[0: strlen(needle)], 0) >= 0;
}

fn mock_read_request(cfd: i32, rx: &Buf) bool {
    var tmp: [byte: 4096] = [0: 4096];
    while true {
        const n: isize = sys_read(cfd, &tmp[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            return false;
        }
        if !buf_append(rx, &tmp[0], n as usize) {
            return false;
        }
        const view: &[byte] = rx.ptr[0: rx.len];
        const he: isize = find_sub(view, &"\r\n\r\n"[0: 4], 0);
        if he >= 0 {
            const head_end: usize = (he as usize) + 4;
            var need: usize = 0;
            var cl_off: usize = 0;
            var cl_len: usize = 0;
            if head_value(view, head_end, &"content-length"[0: 14], &cl_off, &cl_len) && cl_len > 0 {
                const want: i64 = parse_u64_at(view, cl_off, cl_len);
                if want > 0 {
                    need = want as usize;
                }
            }
            if rx.len >= head_end + need {
                return true;
            }
        }
    }
}

fn mock_send(cfd: i32, body: &const Buf) bool {
    var head: Buf = buf_new(256);
    defer { buf_free(&head); }
    if !buf_valid(&head) {
        return false;
    }
    _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: ");
    _ = buf_append_u64(&head, body.len as u64);
    _ = buf_append_cstr(&head, "\r\n\r\n");
    https_write_all(cfd, &head.ptr[0] as &const byte, head.len) catch {
        return false;
    };
    https_write_all(cfd, body.ptr as &const byte, body.len) catch {
        return false;
    };
    return true;
}

// chunked 响应：顺带覆盖客户端的 chunked 解码路径
fn mock_send_chunked(cfd: i32, body: &const Buf) bool {
    var head: Buf = buf_new(256);
    defer { buf_free(&head); }
    if !buf_valid(&head) {
        return false;
    }
    _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n");
    const half: usize = body.len / 2;
    _ = buf_append_u64_hex(&head, half);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append(&head, body.ptr, half);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append_u64_hex(&head, body.len - half);
    _ = buf_append_cstr(&head, "\r\n");
    _ = buf_append(&head, &body.ptr[half], body.len - half);
    _ = buf_append_cstr(&head, "\r\n0\r\n\r\n");
    https_write_all(cfd, &head.ptr[0] as &const byte, head.len) catch {
        return false;
    };
    return true;
}

fn buf_append_u64_hex(b: &Buf, v: usize) bool {
    const hexd: &[byte] = &"0123456789abcdef"[0: 16];
    var tmp: [byte: 16] = [0: 16];
    var n: usize = v;
    var i: usize = 0;
    if n == 0 {
        return buf_append_byte(b, 48);
    }
    while n > 0 && i < 16 {
        tmp[i] = hexd[n % (16 as usize)];
        n = n / (16 as usize);
        i = i + 1;
    }
    while i > 0 {
        i = i - 1;
        if !buf_append_byte(b, tmp[i]) {
            return false;
        }
    }
    return true;
}

// HTTP 401 + 错误体
fn mock_send_401(cfd: i32, body: &const Buf) bool {
    var head: Buf = buf_new(256);
    defer { buf_free(&head); }
    _ = buf_append_cstr(&head, "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/json\r\nConnection: close\r\nContent-Length: ");
    _ = buf_append_u64(&head, body.len as u64);
    _ = buf_append_cstr(&head, "\r\n\r\n");
    https_write_all(cfd, &head.ptr[0] as &const byte, head.len) catch {
        return false;
    };
    const w2: !void = https_write_all(cfd, body.ptr as &const byte, body.len);
    _ = w2 catch {
        return false;
    };
    return true;
}

// 期望落盘的字节（真实换行 + 真实引号）
fn esc_content() &byte {
    return "line1\nline2 \"q\" tail" as &byte;
}

// 用 JsonWriter 生成 write_file 的 arguments：
// 内层 JSON 由 writer 正确转义，再作为一个 JSON 字符串塞进 arguments。
fn mock_call_escaped(w: &JsonWriter, id: &const byte, name: &const byte, path: &const byte, content: &const byte) void {
    var inner: Buf = buf_new(256);
    var wi: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&wi, inner.ptr, inner.cap);
    jw_byte(&wi, 123);
    jw_key(&wi, "path");
    jw_str_cstr(&wi, path);
    jw_byte(&wi, 44);
    jw_key(&wi, "content");
    jw_str_cstr(&wi, content);
    jw_byte(&wi, 125);
    if jw_overflow(&wi) {
        buf_free(&inner);
        return;
    }
    inner.len = jw_used(&wi);
    jw_byte(w, 123);
    jw_key(w, "id");
    jw_str_cstr(w, id);
    jw_byte(w, 44);
    jw_key(w, "type");
    jw_str_cstr(w, "function");
    jw_byte(w, 44);
    jw_key(w, "function");
    jw_byte(w, 123);
    jw_key(w, "name");
    jw_str_cstr(w, name);
    jw_byte(w, 44);
    jw_key(w, "arguments");
    jw_str(w, inner.ptr, inner.len);      // 整段内层 JSON 作为字符串（转义由 writer 负责）
    jw_byte(w, 125);
    jw_byte(w, 125);
    buf_free(&inner);
}

// 一轮里塞多个工具调用：正常写/读文件 / 越权路径 / 超时被杀
fn mock_toolcall_tools_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-tools");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    // 1) write_file：content 里**带换行和引号**，专门盯住「字段值必须再反转义一次」这个坑
    mock_call_escaped(&w, "call_w1", "write_file", "esc.txt", esc_content());
    jw_byte(&w, 44);
    // 2) read_file 读回同一文件
    mock_call(&w, "call_r1", "read_file", "{\"path\":\"esc.txt\"}");
    jw_byte(&w, 44);
    // 3) read_file 越权（应被路径守卫拒绝）
    mock_call(&w, "call_r2", "read_file", "{\"path\":\"../escape.txt\"}");
    jw_byte(&w, 44);
    // 4) run_shell 超时（应被 SIGKILL 并回 timeout）
    mock_call(&w, "call_r3", "run_shell", "{\"command\":\"sleep 5\",\"timeout_ms\":300}");
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

fn mock_call(w: &JsonWriter, id: &const byte, name: &const byte, args_json: &const byte) void {
    jw_byte(w, 123);
    jw_key(w, "id");
    jw_str_cstr(w, id);
    jw_byte(w, 44);
    jw_key(w, "type");
    jw_str_cstr(w, "function");
    jw_byte(w, 44);
    jw_key(w, "function");
    jw_byte(w, 123);
    jw_key(w, "name");
    jw_str_cstr(w, name);
    jw_byte(w, 44);
    jw_key(w, "arguments");
    jw_str_cstr(w, args_json);
    jw_byte(w, 125);
    jw_byte(w, 125);
}

// 返回 0 表示 mock 端所有断言通过
fn mock_server(lfd: i32) i32 {
    var round: i32 = 0;
    var verdict: i32 = 0;
    var limit: i32 = 2;
    if mock_mode == 3 {
        limit = 1;          // 401 轮：只服务一次，agent 拿到 401 就该退出
    }
    if mock_mode == 5 {
        limit = 3;          // 熔断轮：agent 的 max_steps 是 3
    }
    while round < limit {
        var peer: [byte: 16] = [0: 16];
        var alen: u32 = 16;
        const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch {
            return 10;
        };
        var rx: Buf = buf_new(8192);
        if !mock_read_request(cfd, &rx) {
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            return 11;
        }
        if mock_mode == 3 {
            // 直接回 401 + 错误体
            var errb: Buf = buf_new(256);
            _ = buf_append_cstr(&errb, "{\"error\":{\"message\":\"mock unauthorized\",\"type\":\"invalid_request_error\"}}");
            if !mock_send_401(cfd, &errb) {
                verdict = 30;
            }
            buf_free(&errb);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if mock_mode == 5 {
            // 一直给工具调用：agent 必须靠 max_steps 自己停下
            var sb: Buf = buf_new(2048);
            if !mock_toolcall_body(&sb, true) {
                verdict = 31;
            }
            if !mock_send(cfd, &sb) {
                verdict = 32;
            }
            buf_free(&sb);
            buf_free(&rx);
            _ = sys_close(cfd) catch {};
            round = round + 1;
            continue;
        }
        if round == 0 {
            // 断言：tools schema 里 run_shell 的有无符合预期
            const has_shell: bool = contains(&rx, "\"name\":\"run_shell\"");
            if has_shell != mock_expect_shell {
                verdict = 12;
            }
            var body: Buf = buf_new(4096);
            var built: bool = false;
            if mock_mode == 2 {
                built = mock_toolcall_tools_body(&body);
            } else {
                built = mock_toolcall_body(&body, mock_expect_shell);
            }
            if !built {
                buf_free(&body);
                buf_free(&rx);
                _ = sys_close(cfd) catch {};
                return 13;
            }
            if !mock_send(cfd, &body) {
                verdict = 14;
            }
            buf_free(&body);
        } else {
            // 断言：第二轮请求里必须带上第一轮的工具执行结果
            if mock_mode != 2 {
                if !contains(&rx, "wrote ") || !contains(&rx, "note.txt") {
                    verdict = 15;
                }
            }
            if mock_expect_shell && mock_mode != 2 {
                if !contains(&rx, "SELFTEST-SHELL-OK") || !contains(&rx, "exit=0") {
                    verdict = 19;
                }
            }
            if mock_mode == 2 {
                // 读回的文本在请求里应当只被转义一次：line1\nline2 \"q\" tail
                // （如果字段值忘了反转义，这里会是 line1\\nline2，断言就会失败）
                if !contains(&rx, "line1\\nline2 \\\"q\\\" tail") {
                    verdict = 20;
                }
                if !contains(&rx, "unsafe path") {
                    verdict = 21;
                }
                if !contains(&rx, "(timeout, killed)") {
                    verdict = 22;
                }
            }
            var body2: Buf = buf_new(1024);
            if verdict == 0 {
                if !mock_final_body(&body2, "SELFTEST_OK 已写入 note.txt") {
                    buf_free(&body2);
                    buf_free(&rx);
                    _ = sys_close(cfd) catch {};
                    return 16;
                }
            } else {
                if !mock_final_body(&body2, "SELFTEST_FAIL") {
                    buf_free(&body2);
                    buf_free(&rx);
                    _ = sys_close(cfd) catch {};
                    return 17;
                }
            }
            var sent: bool = false;
            if mock_mode == 2 {
                sent = mock_send_chunked(cfd, &body2);   // 顺便覆盖 chunked 解码
            } else {
                sent = mock_send(cfd, &body2);
            }
            if !sent {
                verdict = 18;
            }
            buf_free(&body2);
        }
        buf_free(&rx);
        _ = sys_close(cfd) catch {};
        round = round + 1;
    }
    _ = sys_close(lfd) catch {};
    return verdict;
}

// ============================================================
// selftest 单轮
// ============================================================
fn ws_prepare(ws: &const byte) bool {
    _ = sys_mkdir(ws as *const byte, 493 as u32) catch {};
    var f: Buf = buf_new(strlen(ws) + 32);
    defer { buf_free(&f); }
    if !buf_valid(&f) {
        return false;
    }
    _ = buf_append_cstr(&f, ws);
    _ = buf_append_cstr(&f, "/note.txt");
    _ = sys_unlink(&f.ptr[0] as *const byte) catch {};
    return true;
}

fn file_equals(path: &const byte, expect: &const byte) bool {
    const fd: i32 = sys_open(path as *const byte, O_RDONLY as i32, 0) catch {
        return false;
    };
    defer { _ = sys_close(fd) catch {}; }
    var buf: [byte: 512] = [0: 512];
    const n: isize = sys_read(fd, &buf[0], 512) catch { 0 as isize; };
    if n < 0 {
        return false;
    }
    const got: usize = n as usize;
    const want: usize = strlen(expect);
    if got != want {
        return false;
    }
    var i: usize = 0;
    while i < want {
        if buf[i] != expect[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn selftest_round(base: &const Config, tag: &const byte, mode: i32, allow_shell: bool, ws: &const byte) bool {
    mock_mode = mode;
    mock_expect_shell = allow_shell;
    if !ws_prepare(ws) {
        out_err("selftest: cannot prepare workspace\n");
        return false;
    }
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        out_err("selftest: socket() failed\n");
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: bind() failed\n");
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: listen() failed\n");
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: getsockname() failed\n");
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);

    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        out_err("selftest: fork() failed\n");
        return false;
    };
    if pid64 == 0 {
        const rc: i32 = mock_server(lfd);
        sys_exit(rc);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    // 父进程：跑真实 agent 循环
    var c: Config = cfg_default();
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(128);
    if mode == 2 {
        _ = buf_append_cstr(&c.task, "写文件、读文件、越权路径、超时命令");
    } else {
        _ = buf_append_cstr(&c.task, "把 hello-selftest 写进 note.txt");
    }
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = allow_shell;
    if mode == 5 {
        c.max_steps = 3;      // 熔断轮：mock 每轮都给 tool_calls，agent 必须在 3 步停下
    } else {
        c.max_steps = 4;
    }
    c.timeout_ms = 15000;
    c.quiet = true;
    const rc: i32 = agent_run(&c);
    cfg_free(&c);

    var st: i32 = 0;
    _ = sys_waitpid(pid, &st, 0) catch {};
    const mock_rc: i32 = (st >> (8 as i32)) & 255;

    var file_path: Buf = buf_new(strlen(ws) + 32);
    defer { buf_free(&file_path); }
    _ = buf_append_cstr(&file_path, ws);
    _ = buf_append_cstr_z(&file_path, "/note.txt");
    file_path.len = file_path.len - 1;

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if mock_mode == 2 && rc == AGENT_OK && mock_rc == 0 {
        // mode 2 还要逐字节校验写出来的文件内容（换行/引号必须是真的）
        var esc_path: Buf = buf_new(strlen(ws) + 32);
        _ = buf_append_cstr(&esc_path, ws);
        _ = buf_append_cstr_z(&esc_path, "/esc.txt");
        const want: &const byte = esc_content();
        if !file_equals(&esc_path.ptr[0] as &const byte, want) {
            out_err("[esc.txt 内容不符] ");
            ok = false;
        }
        buf_free(&esc_path);
    }
    const expect_rc: i32 = if mode == 3 || mode == 5 {
        AGENT_PROTO
    } else {
        AGENT_OK
    };
    if rc != expect_rc {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        out_err(" (expected ");
        out_err_dec(expect_rc as usize);
        out_err(")");
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else if mode == 0 || mode == 1 {
        if !file_equals(&file_path.ptr[0] as &const byte, "hello-selftest") {
            out_err("FAIL: note.txt content mismatch");
            ok = false;
        } else {
            out_err("ok");
        }
    } else if !ok {
        out_err("FAIL");
    } else {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

export fn selftest_main(base: &const Config) i32 {
    _ = base;
    out_err("selftest: offline end-to-end (mock LLM on 127.0.0.1, no network, no API key)\n");
    const r1: bool = selftest_round(base, "shell", 0, true, "build/selftest_ws_shell");
    const r2: bool = selftest_round(base, "no-shell", 1, false, "build/selftest_ws_noshell");
    const r3: bool = selftest_round(base, "tools", 2, true, "build/selftest_ws_tools");
    const r4: bool = selftest_round(base, "http401", 3, true, "build/selftest_ws_401");
    const r5: bool = selftest_round(base, "max-steps", 5, true, "build/selftest_ws_steps");
    if r1 && r2 && r3 && r4 && r5 {
        out_err("SELFTEST PASS\n");
        return AGENT_OK;
    }
    out_err("SELFTEST FAIL\n");
    return AGENT_PROTO;
}
