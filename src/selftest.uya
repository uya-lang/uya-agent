// 请求体里不允许出现 NUL 字节（脏指针/长度算错都会在这里露出来）
fn buf_has_nul(b: &const Buf) bool {
    var i: usize = 0;
    while i < b.len {
        if b.ptr[i] == 0 as byte {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// prompt/todo/plan 轮的 4 个调用
fn mock_prompt_body(out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "id");
    jw_str_cstr(&w, "chatcmpl-prompt");
    jw_byte(&w, 44);
    jw_key(&w, "choices");
    jw_byte(&w, 91);
    jw_byte(&w, 123);
    jw_key(&w, "index");
    jw_i64(&w, 0);
    jw_byte(&w, 44);
    jw_key(&w, "message");
    jw_byte(&w, 123);
    jw_key(&w, "role");
    jw_str_cstr(&w, "assistant");
    jw_byte(&w, 44);
    jw_key(&w, "content");
    jw_null(&w);
    jw_byte(&w, 44);
    jw_key(&w, "tool_calls");
    jw_byte(&w, 91);
    mock_call(&w, "pr_1", "todo_write", "{\"todos\":[{\"content\":\"第一步\",\"status\":\"completed\"},{\"content\":\"第二步\",\"status\":\"in_progress\"},{\"content\":\"第三步\",\"status\":\"pending\"},{\"content\":\"第四步\",\"status\":\"pending\"}]}");
    jw_byte(&w, 44);
    mock_call(&w, "pr_2", "todo_write", "{\"todos\":[{\"content\":\"重复项\",\"status\":\"pending\"},{\"content\":\"重复项\",\"status\":\"completed\"}]}");
    jw_byte(&w, 44);
    mock_call(&w, "pr_3", "exit_plan_mode", "{\"plan\":\"# 计划标题\\n\\n先做 A，再做 B。\"}");
    jw_byte(&w, 44);
    mock_call(&w, "pr_4", "exit_plan_mode", "{\"plan\":\"没有井号开头的计划\"}");
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    jw_byte(&w, 44);
    jw_key(&w, "finish_reason");
    jw_str_cstr(&w, "tool_calls");
    jw_byte(&w, 125);
    jw_byte(&w, 93);
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// prompt/todo/plan 轮
fn prompt_round(base: &const Config, tag: &const byte, ws: &const byte) bool {
    mock_mode = 10;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    if !ws_prepare(ws) {
        out_err("selftest: cannot prepare prompt workspace\n");
        return false;
    }
    // 放一份 AGENTS.md，验证注入
    var ap: Buf = buf_new(256);
    defer { buf_free(&ap); }
    _ = buf_append_cstr(&ap, ws);
    _ = buf_append_cstr_z(&ap, "/AGENTS.md");
    if !write_text_file(&ap.ptr[0] as &const byte, "# 工作区约定\n\nSELFTEST-AGENTS-MARKER 这条指令必须出现在请求里。\n") {
        out_err("selftest: cannot write AGENTS.md\n");
        return false;
    }
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var c: Config = cfg_default();
    cfg_pin_api(&c, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append_cstr(&c.task, "试一下 todo 与 plan");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.max_steps = 4;
    c.timeout_ms = 15000;
    c.quiet = true;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    const rc: i32 = agent_run(&c);
    cfg_free(&c);
    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if rc != AGENT_OK {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

