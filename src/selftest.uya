// ============================================================
// P12：workflow 轮
//
// 两个变体：
//   A) 脚本用 /bin/sh 写的「假 runner」（说话的就是钩子协议），验证协议本身；
//   B) 真的用 `uya run` 跑一个 Uya 的 .ush 脚本，验证主路径。
// 钩子里的 agent_start/agent_wait 会派生子代理 → 由 mock LLM 服务。
// ============================================================
fn wf_make_args(out: &Buf, script: &const byte, name: &const byte) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "{\"script\":") {
        return false;
    }
    if !jw_str_into(out, script, bufx_cstr_len(script)) {
        return false;
    }
    if !buf_append_cstr(out, ",\"meta\":{\"name\":") {
        return false;
    }
    if !jw_str_into(out, name, bufx_cstr_len(name)) {
        return false;
    }
    return buf_append_cstr(out, ",\"description\":\"两阶段审计\"},\"args\":{\"files\":[\"a.uya\",\"b.uya\"]}}");
}

fn wf_parse_args(text: &const Buf, out: &JsonValue) bool {
    var raw: &void = malloc(65536);
    if ((raw as &byte) as usize) == 0 {
        return false;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 65536);
    if !js_parse(&arena, text.ptr, text.len, out) {
        return false;
    }
    return true;
}

// 写一个「假 runner」：接受 `run <script>` 的参数形态，直接执行脚本
fn wf_write_stub_runner(path: &const byte) bool {
    const body: &const byte = "#!/bin/sh\n# uya-agent workflow 的测试替身：忽略 run 子命令，直接跑脚本\nshift\nexec /bin/sh \"$1\"\n";
    return write_text_file(path, body);
}

// A) 假 runner + /bin/sh 脚本（用 /dev/tcp 说钩子协议）
fn wf_variant_stub(cfg: &const Config, tag: &const byte, out: &Buf) bool {
    var runner: Buf = buf_new(256);
    defer { buf_free(&runner); }
    _ = buf_append_cstr(&runner, "testdata/wf_runner.sh");
    _ = buf_append_byte(&runner, 0);
    var okflag: bool = false;
    if !wf_write_stub_runner(runner.ptr as &const byte) {
        ty_fail(tag, "写假 runner 失败", &okflag);
        return false;
    }
    var c: Config = cfg_default();
    cfg_pin_api(&c, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    c.base_url = buf_new(cfg.base_url.len + 8);
    _ = buf_append(&c.base_url, cfg.base_url.ptr, cfg.base_url.len);
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(64);
    _ = buf_append_cstr(&c.workspace, "build/selftest_wf_ws");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.timeout_ms = 30000;
    c.quiet = true;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_wf_home");
    c.max_steps = 3;
    c.quiet = true;
    c.uya_bin = buf_new(64);
    _ = buf_append_cstr(&c.uya_bin, "/bin/bash");   // 直接解释器模式：<bin> <script>
    // 假脚本从磁盘读（内嵌 shell 会被 Uya 字符串转义搞死；testdata/ 里是真实文件）
    var stub: Buf = buf_new(8192);
    defer { buf_free(&stub); }
    if !fs_read_file_all("testdata/wf_stub.sh" as &const byte, &stub, 65536) {
        ty_fail(tag, "读不到 testdata/wf_stub.sh", &okflag);
        return false;
    }
    if !sess_has_cstr(stub.ptr[0: stub.len], "dev/tcp") {
        ty_fail(tag, "testdata/wf_stub.sh 内容不对（缺少 dev/tcp）", &okflag);
        return false;
    }
    _ = buf_append_byte(&stub, 0);
    const script: &const byte = stub.ptr as &const byte;
    var args: Buf = buf_new(8192);
    defer { buf_free(&args); }
    var badflag: bool = false;
    if !wf_make_args(&args, script, "stub-audit") {
        ty_fail(tag, "组参失败", &badflag);
        return false;
    }
    var jv: JsonValue = JsonValue.json_null();
    if !wf_parse_args(&args, &jv) {
        ty_fail(tag, "参数不是合法 JSON", &badflag);
        return false;
    }
    buf_reset(out);
    wf_tool_workflow(&c, &jv, out);
    var ok: bool = true;
    if !contains(out, "WF-AGENT-OK") {
        ty_fail(tag, "子代理结果没有回到 workflow 结果里", &ok);
    }
    if !contains(out, "phases: phase audit files") && !contains(out, "audit files") {
        ty_fail(tag, "阶段没有记录", &ok);
    }
    if !contains(out, "agents started: 1") {
        ty_fail(tag, "子代理计数不对", &ok);
    }
    if !contains(out, "审计完成：WF-AGENT-OK") {
        ty_fail(tag, "wf_done 的结果没收到", &ok);
    }
    cfg_free(&c);
    return ok;
}

// B) 真 `uya run` + Uya 的 .ush 脚本
fn wf_variant_real(cfg: &const Config, tag: &const byte, out: &Buf) bool {
    const uya_bin: &byte = getenv("UYA_BIN");
    var binpath: Buf = buf_new(256);
    defer { buf_free(&binpath); }
    if (uya_bin as usize) != 0 && bufx_cstr_len(uya_bin) > 0 {
        _ = buf_append_cstr(&binpath, uya_bin);
    } else {
        _ = buf_append_cstr(&binpath, "/home/winger/uya-0.10/bin/uya");
    }
    // 交给系统调用前补 NUL（这个坑第 N 次了）
    _ = buf_append_byte(&binpath, 0);
    if !sess_file_exists(binpath.ptr as &const byte) {
        // 没装 uya 就跳过（离线自测不因此失败）
        return true;
    }
    var c: Config = cfg_default();
    cfg_pin_api(&c, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:1/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(64);
    _ = buf_append_cstr(&c.workspace, "build/selftest_wf_ws");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = false;
    c.timeout_ms = 60000;
    c.quiet = true;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_wf_home");
    c.uya_bin = buf_new(binpath.len + 8);
    _ = buf_append(&c.uya_bin, binpath.ptr, binpath.len);
    // 脚本只用 phase/log/done（不派生子代理 → 不需要模型）
    const script: &const byte = "use hooks;\n\nexport fn main() i32 {\n    wf_phase(\"compile\");\n    wf_log(\"编译完成\");\n    wf_phase(\"verify\");\n    wf_done(\"uya run 变体完成\");\n    return 0;\n}\n";
    var args: Buf = buf_new(8192);
    defer { buf_free(&args); }
    var badflag2: bool = false;
    if !wf_make_args(&args, script, "real-ush") {
        ty_fail(tag, "组参失败", &badflag2);
        return false;
    }
    var jv: JsonValue = JsonValue.json_null();
    if !wf_parse_args(&args, &jv) {
        ty_fail(tag, "参数不是合法 JSON", &badflag2);
        return false;
    }
    buf_reset(out);
    wf_tool_workflow(&c, &jv, out);
    var ok: bool = true;
    if !contains(out, "uya run 变体完成") {
        ty_fail(tag, "真 uya run 的 wf_done 结果没收到", &ok);
    }
    if !contains(out, "compile") || !contains(out, "verify") {
        ty_fail(tag, "真 uya run 的阶段没记录", &ok);
    }
    if !contains(out, "script exit: 0") {
        ty_fail(tag, "真 uya run 的脚本退出码不是 0", &ok);
    }
    cfg_free(&c);
    return ok;
}

fn wf_round(base: &const Config, tag: &const byte, ws: &const byte) bool {
    mock_mode = 16;
    mock_expect_shell = false;
    mock_expect_fold = false;
    mock_expect_steer = false;
    if !ws_prepare(ws) {
        out_err("selftest: cannot prepare workspace\n");
        return false;
    }
    _ = sess_mkdir_p("build/selftest_wf_home");
    // mock 只服务子代理的请求
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var mcfg: Config = cfg_default();
    cfg_pin_api(&mcfg, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    mcfg.base_url = buf_new(64);
    _ = buf_append_cstr(&mcfg.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&mcfg.base_url, port as u64);
    _ = buf_append_cstr(&mcfg.base_url, "/v1");
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if !wf_variant_stub(&mcfg, tag, &out) {
        ok = false;
    }
    if !wf_variant_real(&mcfg, tag, &out) {
        ok = false;
    }
    cfg_free(&mcfg);
    const mock_rc: i32 = wait_child(pid);
    if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    }
    if ok {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

// ============================================================
// P13 轮：preset 旋钮驱动 + 读 DSH 会话（都离线、用假数据）
// ============================================================
fn knobs_round(tag: &const byte) bool {
    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    // 1) 假 preset：非默认旋钮（含 group 里嵌套的 config 列表）
    const dir: &const byte = "build/selftest_knobs";
    _ = sess_mkdir_p("build/selftest_knobs/config/agent-presets/standard");
    const preset: &const byte = "- id: persona\n  name: '@deepseek-ai/dsh-persona'\n  config:\n    text: >-\n      You are {{model}} in {{cwd}}.\n\n- id: fs\n  name: '@deepseek-ai/dsh-tool-fs'\n  config:\n    readLimit: 7\n    readMaxBytes: 1234\n    readMaxLineLength: 99\n\n- id: compaction\n  name: cordis:group\n  config:\n    - id: pruner\n      name: '@deepseek-ai/dsh-compaction-tool-result-pruner'\n      config:\n        thresholdChars: 111\n        headChars: 22\n        tailChars: 33\n";
    if !write_text_file("build/selftest_knobs/config/agent-presets/standard/agent.cordis.yml", preset) {
        ty_fail(tag, "写假 preset 失败", &ok);
        return false;
    }
    var texts: PromptTexts = prompt_texts_empty();
    var knobs: PresetKnobs = preset_knobs_default();
    prompt_texts_init(dir, &"x"[0: 0], &texts, &knobs);
    if !knobs.loaded {
        ty_fail(tag, "preset 没被读到", &ok);
    }
    if knobs.read_limit != 7 || knobs.read_max_bytes != 1234 || knobs.read_max_line != 99 {
        ty_fail(tag, "tool-fs 的三个旋钮不对", &ok);
    }
    if knobs.prune_threshold != 111 || knobs.prune_head != 22 || knobs.prune_tail != 33 {
        ty_fail(tag, "嵌套 config 列表里的剪枝旋钮没读到", &ok);
    }
    if !sess_has_cstr(texts.persona.ptr[0: texts.persona.len], "You are {{model}} in {{cwd}}.") {
        ty_fail(tag, "persona 文案没读到（折叠标量）", &ok);
    }
    prompt_texts_free(&texts);

    // 2) 假 DSH 会话：header + user/assistant/tool 事件，裸 jsonl
    _ = sess_mkdir_p("build/selftest_dshs/sessions/--tmp-dshs--/session-aaaa1111-2222-3333-4444-555566667777");
    const hdr: &const byte = "{\"type\":\"session\",\"version\":0,\"id\":\"session-aaaa1111-2222-3333-4444-555566667777\",\"createdAt\":1790000000000,\"cwd\":\"/tmp/dshs\",\"delegationDepth\":0,\"agentPreset\":\"standard\"}\n{\"type\":\"user/message\",\"seq\":1,\"time\":1,\"data\":{\"content\":[{\"type\":\"text\",\"text\":\"请记住 5150\"}]}}\n{\"type\":\"assistant/message\",\"seq\":2,\"time\":2,\"data\":{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"记住了\"}],\"tool_calls\":[{\"id\":\"call_d1\",\"type\":\"function\",\"function\":{\"name\":\"read\",\"arguments\":\"{\\\"file_path\\\":\\\"x.txt\\\"}\"}}]}}\n{\"type\":\"tool/result\",\"seq\":3,\"time\":3,\"data\":{\"callId\":\"call_d1\",\"content\":\"file x.txt: 5150\"}}\n";
    if !write_text_file("build/selftest_dshs/sessions/--tmp-dshs--/session-aaaa1111-2222-3333-4444-555566667777/session.jsonl", hdr) {
        ty_fail(tag, "写假 DSH 会话失败", &ok);
        return false;
    }
    var ss: DshSessions = DshSessions{ items: [], n: 0 };
    dshs_init(&ss);
    defer { dshs_free(&ss); }
    var dsh_home_b: Buf = buf_new(64);
    defer { buf_free(&dsh_home_b); }
    _ = buf_append_cstr(&dsh_home_b, "build/selftest_dshs");
    dshs_list(dsh_home_b.ptr[0: dsh_home_b.len], &"x"[0: 0], &ss);
    if ss.n != 1 {
        ty_fail(tag, "DSH 会话没扫到", &ok);
    } else if !bufx_eq_cstr(ss.items[0].id.ptr as &const byte, ss.items[0].id.len, "session-aaaa1111-2222-3333-4444-555566667777") {
        ty_fail(tag, "DSH header 的 id 没解析对", &ok);
    } else if ss.items[0].depth != 0 || ss.items[0].zstd {
        ty_fail(tag, "DSH header 的 depth/压缩标记不对", &ok);
    }
    // 前缀查找 + 导入
    if dshs_find(&ss, "session-aaaa") < 0 {
        ty_fail(tag, "DSH 会话前缀查找失败", &ok);
    }
    var h: History = hist_init();
    defer { hist_free(&h); }
    var c13: Config = cfg_default();
    cfg_pin_api(&c13, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
    c13.model = buf_new(32);
    _ = buf_append_cstr(&c13.model, "selftest-model");
    const imported: usize = dshs_import(&c13, &ss.items[0], &h);
    if imported != 3 {
        ty_fail(tag, "DSH 导入的消息条数不对", &ok);
    } else if msg_role_at(&h, 0) != ROLE_USER || msg_role_at(&h, 1) != ROLE_ASSISTANT_CALLS || msg_role_at(&h, 2) != ROLE_TOOL {
        ty_fail(tag, "DSH 导入的角色序列不对", &ok);
    } else if !msg_extra_is(&h, 2, "call_d1") {
        ty_fail(tag, "DSH 导入的 tool_call_id 丢了", &ok);
    } else {
        var req: Buf = buf_new(65536);
        defer { buf_free(&req); }
        var cc: Config = cfg_default();
        cfg_pin_api(&cc, LLM_STYLE_CHAT);   // 自测钉住协议：默认是 responses + 一次性协商
        cc.model = buf_new(32);
        _ = buf_append_cstr(&cc.model, "selftest-model");
        if !build_model_request(&cc, &h, &req, LLM_STYLE_CHAT) {
            ty_fail(tag, "DSH 导入的历史无法组装请求", &ok);
        } else if !contains(&req, "\"tool_call_id\":\"call_d1\"") {
            ty_fail(tag, "DSH 导入的请求里没有 tool_call_id", &ok);
        }
        cfg_free(&cc);
    }
    cfg_free(&c13);
    if ok {
        out_err("ok");
    }
    out_err("\n");
    return ok;
}

// 历史消息的文本比对（下标安全 + 长度先比）
fn hist_text_is(h: &const History, i: usize, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    const m: &const Msg = msg_at(h, i);
    if m.text_len != n {
        return false;
    }
    return bufx_mem_eq(m.text, lit, n);
}

// 不限步数带来的长跑副作用：历史会反复「丢最老」。这一轮钉住两条不变量：
//   1) system 与**任务原文**（下标 1 的 user）永远留住 —— 否则跑几十步之后 agent
//      会把自己的任务丢掉；
//   2) assistant(tool_calls) 与它的 tool 结果整组丢，历史绝不会以悬空的 tool 开头。
fn hist_keep_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- 1) 小历史：丢的是一条完整的 assistant(tool_calls)+tool 组，任务原文留住 ----
    var h: History = hist_init();
    defer { hist_free(&h); }
    _ = hist_push(&h, ROLE_SYSTEM, "S" as &const byte, 1);
    _ = hist_push(&h, ROLE_USER, "TASK" as &const byte, 4);
    _ = hist_push_msg(&h, ROLE_ASSISTANT_CALLS, "c" as &const byte, 1, "[]" as &const byte, 2);
    _ = hist_push_msg(&h, ROLE_TOOL, "r" as &const byte, 1, "call_1" as &const byte, 6);
    _ = hist_push(&h, ROLE_USER, "next" as &const byte, 4);
    if h.len != 5 {
        ty_fail(tag, "历史没按预期堆起来", &ok);
    }
    const dropped: bool = hist_drop_oldest(&h);
    if !dropped {
        ty_fail(tag, "hist_drop_oldest 拒绝丢（历史够长却返回 false）", &ok);
    } else if h.len != 3 {
        ty_fail(tag, "丢的条数不对（assistant+tool 必须整组丢）", &ok);
    } else if msg_role_at(&h, 0) != ROLE_SYSTEM {
        ty_fail(tag, "system 被丢掉了", &ok);
    } else if msg_role_at(&h, 1) != ROLE_USER || !hist_text_is(&h, 1, "TASK" as &const byte) {
        ty_fail(tag, "任务原文（下标 1 的 user）被丢掉了", &ok);
    } else if msg_role_at(&h, 2) != ROLE_USER {
        ty_fail(tag, "丢掉一组之后剩下的消息不对", &ok);
    }

    // ---- 2) 首位不是 user（导入的会话/裁剪过的历史）时，退回「从下标 1 丢」的老行为 ----
    var h2: History = hist_init();
    defer { hist_free(&h2); }
    _ = hist_push(&h2, ROLE_SYSTEM, "S" as &const byte, 1);
    _ = hist_push_msg(&h2, ROLE_ASSISTANT_CALLS, "c" as &const byte, 1, "[]" as &const byte, 2);
    _ = hist_push_msg(&h2, ROLE_TOOL, "r" as &const byte, 1, "call_1" as &const byte, 6);
    _ = hist_push(&h2, ROLE_USER, "later" as &const byte, 5);
    const d2: bool = hist_drop_oldest(&h2);
    if !d2 {
        ty_fail(tag, "首位不是 user 时 hist_drop_oldest 拒绝丢", &ok);
    } else if h2.len != 2 {
        ty_fail(tag, "首位不是 user 时丢的条数不对", &ok);
    } else if msg_role_at(&h2, 0) != ROLE_SYSTEM || msg_role_at(&h2, 1) != ROLE_USER {
        ty_fail(tag, "首位不是 user 时剩下的角色序列不对", &ok);
    }

    // ---- 3) 连着追加 40 组（远超旧 MSG_MAX=64）之后：任务原文仍在，且不会以悬空 tool 开头 ----
    // 历史条数现在默认不限制，所以这里断言的是「长度 = 2 + 40 组 × 2 条」而不是 MSG_MAX。
    var h3: History = hist_init();
    defer { hist_free(&h3); }
    _ = hist_push(&h3, ROLE_SYSTEM, "S" as &const byte, 1);
    _ = hist_push(&h3, ROLE_USER, "TASK-KEEP" as &const byte, 9);
    var k: i32 = 0;
    var pa: bool = true;
    var pt: bool = true;
    while k < 40 {
        pa = hist_push_msg(&h3, ROLE_ASSISTANT_CALLS, "c" as &const byte, 1, "[]" as &const byte, 2);
        while !pa {
            if !hist_drop_oldest(&h3) {
                break;
            }
            pa = hist_push_msg(&h3, ROLE_ASSISTANT_CALLS, "c" as &const byte, 1, "[]" as &const byte, 2);
        }
        pt = hist_push_msg(&h3, ROLE_TOOL, "r" as &const byte, 1, "call_x" as &const byte, 6);
        while !pt {
            if !hist_drop_oldest(&h3) {
                break;
            }
            pt = hist_push_msg(&h3, ROLE_TOOL, "r" as &const byte, 1, "call_x" as &const byte, 6);
        }
        k = k + 1;
    }
    if !pa || !pt {
        ty_fail(tag, "长跑之后仍然追加失败（默认不限条数，不该失败）", &ok);
    } else if h3.len != 2 + 40 * 2 {
        ty_fail(tag, "长跑之后历史长度不等于 2 + 40 组 × 2 条（历史被打断/被丢？）", &ok);
    } else if msg_role_at(&h3, 0) != ROLE_SYSTEM {
        ty_fail(tag, "长跑之后 system 被丢掉了", &ok);
    } else if msg_role_at(&h3, 1) != ROLE_USER || !hist_text_is(&h3, 1, "TASK-KEEP" as &const byte) {
        ty_fail(tag, "长跑之后任务原文被丢掉了", &ok);
    } else if msg_role_at(&h3, 2) == ROLE_TOOL {
        ty_fail(tag, "长跑之后历史以悬空 tool 消息开头", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok");
    }
    out_err("\n");
    return ok;
}

// ============================================================
// P14 显示层自测：diff 渲染 + 工具内容块（逐字节断言；off 态用 fd 2 捕获验证「零输出」）
// ============================================================
fn vw_mk(text: &const byte) Buf {
    var b: Buf = buf_new(bufx_cstr_len(text) + 16);
    if buf_valid(&b) {
        _ = buf_append_cstr(&b, text);
    }
    return b;
}

// 把 fd 2 接到 path（返回 saved fd，-1 = 没接上）；cfd 回传打开的文件 fd
fn vw_cap_on(path: &const byte, cfd: &i32) i32 {
    cfd[0] = -1;
    const saved: i32 = sys_dup(2) catch { -1; };
    if saved < 0 {
        return -1;
    }
    const fd: i32 = sys_open(path as *const byte, (1 | 64 | 512) as i32, 420) catch { -1; };
    if fd < 0 {
        _ = sys_close(saved) catch {};
        return -1;
    }
    _ = sys_dup2(fd, 2) catch {};
    cfd[0] = fd;
    return saved;
}

// 还原 fd 2，并把捕获到的字节读回 out
fn vw_cap_off(path: &const byte, saved: i32, cfd: i32, out: &Buf) void {
    buf_reset(out);
    if cfd >= 0 {
        _ = sys_dup2(saved, 2) catch {};
        _ = sys_close(cfd) catch {};
    }
    if saved >= 0 {
        _ = sys_close(saved) catch {};
    }
    const fd: i32 = sys_open(path as *const byte, 0 as i32, 0) catch { -1; };
    if fd < 0 {
        return;
    }
    // 关键：dup2 之后 fd 2 和这个文件共用**同一个文件描述**，偏移量是一起走的 ——
    // 写完不复位就读，读回来的是「跳过前 N 字节」的内容（P15 自测在这里绕过一圈）。
    _ = sys_lseek(fd, 0, SEEK_SET) catch {};
    var tmp: [byte: 4096] = [0: 4096];
    while true {
        const n: isize = sys_read(fd, &tmp[0], 4096) catch { 0 as isize; };
        if n <= 0 {
            break;
        }
        _ = buf_append(out, &tmp[0], n as usize);
    }
    _ = sys_close(fd) catch {};
}

// P15：请求体字符串转义的纯函数轮。
// 不联网、不起服务端 —— 直接把「必须转义的字节全集」喂给 jw_str/jw_key，逐字节比对输出。
// std.json.encoder.json_write_str_view 只认 " \ \n \r \t，其余控制字节原样上线；
// 这条测试就是防止再退回那个实现（真机后果见 README 踩坑 27）。
fn jsonesc_round(tag: &const byte) bool {
    var ok: bool = true;
    // 输入：a NUL 0x01 0x1f " \ LF TAB BS FF CR B
    var raw: [byte: 12] = [97, 0, 1, 31, 34, 92, 10, 9, 8, 12, 13, 66];
    var out: Buf = buf_new(128);
    defer { buf_free(&out); }
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_str(&w, &raw[0], 12);
    if jw_overflow(&w) {
        ty_fail(tag, "转义输出溢出", &ok);
        return ok;
    }
    out.len = jw_used(&w);
    // 期望：短转义用 \b \f \n \r \t，其余控制字节用 \u00XX（\u0000 就是 NUL）
    const want: &const byte = "\"a\\u0000\\u0001\\u001f\\\"\\\\\\n\\t\\b\\f\\rB\"";
    if !ty_buf_is(&out, want) {
        ty_fail(tag, "控制字节转义文本不对", &ok);
        out_err("[json-esc] 得到 ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    // 输出（含引号）里不允许再有裸控制字节
    var i: usize = 0;
    while i < out.len {
        if out.ptr[i] < 32 as byte {
            ty_fail(tag, "转义后的字面量里还有裸控制字节", &ok);
            break;
        }
        i = i + 1;
    }
    // key 走同一套转义，再补一个冒号
    var out2: Buf = buf_new(64);
    defer { buf_free(&out2); }
    var w2: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w2, out2.ptr, out2.cap);
    jw_key(&w2, "k");
    out2.len = jw_used(&w2);
    if !ty_buf_is(&out2, "\"k\":") {
        ty_fail(tag, "jw_key 输出不对", &ok);
    }
    // 空串 / 普通 UTF-8 中文不能被改坏
    var out3: Buf = buf_new(64);
    defer { buf_free(&out3); }
    var w3: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w3, out3.ptr, out3.cap);
    jw_str(&w3, &raw[0], 0);
    jw_str_cstr(&w3, "中文 ok");
    out3.len = jw_used(&w3);
    if !ty_buf_is(&out3, "\"\"\"中文 ok\"") {
        ty_fail(tag, "空串/中文被改坏了", &ok);
    }
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

fn diffx_round(tag: &const byte) bool {
    var ok: bool = true;
    var out: Buf = buf_new(16384);
    defer { buf_free(&out); }
    var a: usize = 0;
    var r: usize = 0;

    // ---- 1) 新旧一样 → 空 ----
    var e1: Buf = vw_mk("a\nb\nc\n");
    var e2: Buf = vw_mk("a\nb\nc\n");
    const e1v: &[byte] = e1.ptr[0: e1.len];
    const e2v: &[byte] = e2.ptr[0: e2.len];
    diffx_render_ex(&out, e1v, e2v, 6, 72, &a, &r);
    if out.len != 0 {
        ty_fail(tag, "相同内容不该产生 diff", &ok);
    }
    buf_free(&e1);
    buf_free(&e2);

    // ---- 2) 中间一行改动：前后 2 行上下文 + -/+ ----
    var f1: Buf = vw_mk("a\nb\nc\nd\ne\n");
    var f2: Buf = vw_mk("a\nb\nX\nd\ne\n");
    const f1v: &[byte] = f1.ptr[0: f1.len];
    const f2v: &[byte] = f2.ptr[0: f2.len];
    diffx_render_ex(&out, f1v, f2v, 6, 72, &a, &r);
    if !ty_buf_is(&out, "      a\n      b\n    - c\n    + X\n      d\n      e\n") {
        ty_fail(tag, "单行改动的 diff 文本不对", &ok);
        out_err("[diff] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    if a != 1 || r != 1 {
        ty_fail(tag, "单行改动的增删计数不对", &ok);
    }
    buf_free(&f1);
    buf_free(&f2);

    // ---- 3) 新文件（旧内容为空）→ 全是 + ----
    var g1: Buf = vw_mk("");
    var g2: Buf = vw_mk("x\ny\n");
    const g1v: &[byte] = g1.ptr[0: g1.len];
    const g2v: &[byte] = g2.ptr[0: g2.len];
    diffx_render_ex(&out, g1v, g2v, 6, 72, &a, &r);
    if !ty_buf_is(&out, "    + x\n    + y\n") || a != 2 || r != 0 {
        ty_fail(tag, "新文件的 diff 应该全是 +", &ok);
    }
    buf_free(&g1);
    buf_free(&g2);

    // ---- 4) 整体重写（两侧都 > 60 行）→ 只给精确汇总 ----
    var h1: Buf = buf_new(2048);
    var h2: Buf = buf_new(2048);
    var i: usize = 0;
    while i < 100 {
        _ = buf_append_cstr(&h1, "old line\n");
        _ = buf_append_cstr(&h2, "new line\n");
        i = i + 1;
    }
    const h1v: &[byte] = h1.ptr[0: h1.len];
    const h2v: &[byte] = h2.ptr[0: h2.len];
    diffx_render_ex(&out, h1v, h2v, 6, 72, &a, &r);
    if !ty_buf_is(&out, "    - (100 行旧内容)\n    + (100 行新内容)\n") || a != 100 || r != 100 {
        ty_fail(tag, "大改写的汇总行不对", &ok);
        out_err("[diff] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&h1);
    buf_free(&h2);

    // ---- 5) 头截断：60 行编辑脚本 → 只留 24 行 + 省略标记 ----
    var k1: Buf = buf_new(1024);
    var k2: Buf = buf_new(1024);
    i = 0;
    while i < 30 {
        _ = buf_append_cstr(&k1, "a");
        _ = buf_append_u64(&k1, i as u64);
        _ = buf_append_byte(&k1, 10);
        _ = buf_append_cstr(&k2, "b");
        _ = buf_append_u64(&k2, i as u64);
        _ = buf_append_byte(&k2, 10);
        i = i + 1;
    }
    const k1v: &[byte] = k1.ptr[0: k1.len];
    const k2v: &[byte] = k2.ptr[0: k2.len];
    diffx_render_ex(&out, k1v, k2v, 6, 72, &a, &r);
    if a != 30 || r != 30 {
        ty_fail(tag, "30 行改写的增删计数不对", &ok);
    }
    if view_count_lines(out.ptr as &const byte, out.len) != 25 {
        ty_fail(tag, "头截断后应该正好 24 行 diff + 1 行省略标记", &ok);
    }
    if !contains(&out, "… (省略 36 行)") {
        ty_fail(tag, "头截断缺少「省略 36 行」标记", &ok);
    }
    buf_free(&k1);
    buf_free(&k2);

    // ---- 6) 一行都不改但末尾多一个换行 ----
    var l1: Buf = vw_mk("a\nb");
    var l2: Buf = vw_mk("a\nb\n");
    const l1v: &[byte] = l1.ptr[0: l1.len];
    const l2v: &[byte] = l2.ptr[0: l2.len];
    diffx_render_ex(&out, l1v, l2v, 6, 72, &a, &r);
    if out.len != 0 {
        ty_fail(tag, "只差结尾换行不该产生 diff", &ok);
    }
    buf_free(&l1);
    buf_free(&l2);

    // ---- 7) 显示列截断（宽字符按 2 列算，不砍半个字）----
    var wide: Buf = vw_mk("中文abc");
    const wv: &const byte = wide.ptr as &const byte;
    const keep4: usize = tty_clip_bytes(wv, wide.len, 4);
    if keep4 != 6 {
        ty_fail(tag, "按列截断：两个汉字（4 列）应保留 6 字节", &ok);
    }
    const keepall: usize = tty_clip_bytes(wv, wide.len, 100);
    if keepall != wide.len {
        ty_fail(tag, "按列截断：不超预算时应原样返回", &ok);
    }
    // P16：从尾部保留（思考行滚动显示用它 —— 屏幕上只留最新的一段）
    const tail4: usize = tty_clip_tail_bytes(wv, wide.len, 4);
    if tail4 != 3 {
        ty_fail(tag, "尾部按列截断：4 列装不下 '文'（2 列），应只保留 'abc' 3 字节", &ok);
    }
    if !bufx_mem_eq(&wv[wide.len - tail4], "abc", 3) {
        ty_fail(tag, "尾部按列截断保留的不是最后 3 个字节 'abc'", &ok);
    }
    const tail5: usize = tty_clip_tail_bytes(wv, wide.len, 5);
    if tail5 != 6 {
        ty_fail(tag, "尾部按列截断：5 列 = '文'（2 列）+ 'abc'（3 列）共 6 字节", &ok);
    }
    const tailall: usize = tty_clip_tail_bytes(wv, wide.len, 100);
    if tailall != wide.len {
        ty_fail(tag, "尾部按列截断：不超预算时应原样返回", &ok);
    }
    // 坏字节：孤续字节 0x80 落在 C1 控制区（0 列），半截 3 字节序列按 U+FFFD（1 列）。
    // 关键是「一定前进、结果不超预算」，不是具体留几个字节。
    const lone: [byte: 1] = [0x80];
    if tty_clip_tail_bytes(&lone[0], 1, 1) != 1 {
        ty_fail(tag, "尾部按列截断：0 列宽的坏字节也要留下（否则指针不前进）", &ok);
    }
    const half: [byte: 2] = [0xE4, 0xB8];       // 少了最后一字节的 3 字节序列
    if tty_clip_tail_bytes(&half[0], 2, 1) != 2 {
        ty_fail(tag, "尾部按列截断：半截序列按 1 列算，2 字节都留", &ok);
    }
    if tty_clip_tail_bytes(&half[0], 2, 0) != 0 {
        ty_fail(tag, "尾部按列截断：预算为 0 时一个字节都不留", &ok);
    }
    buf_free(&wide);

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// 把面板文本按「行」打印出来（换行换成 |，便于在自测输出里肉眼看对齐）
fn win_dump_lines(b: &const Buf) void {
    out_err("[panel] len=");
    out_err_dec(b.len);
    out_err(" lines=");
    out_err_dec(view_count_lines(b.ptr as &const byte, b.len));
    out_err("\n");
    var i: usize = 0;
    var k: usize = 0;
    while i < b.len {
        const nl: isize = bufx_find_byte(b.ptr[0: b.len], 10 as byte, i);
        var stop: usize = b.len;
        var last: bool = true;
        if nl >= 0 {
            stop = nl as usize;
            last = false;
        }
        out_err("  ");
        out_err_dec(k);
        out_err(" cols=");
        out_err_dec(tty_cols_between(b.ptr as &const byte, i, stop));
        out_err(" bytes=");
        out_err_dec(stop - i);
        out_err(" last=");
        if (stop - i) > 0 {
            out_err_dec(b.ptr[stop - 1] as usize);
        }
        out_err(" <");
        out_err_bytes(b.ptr + i, stop - i);
        out_err(">\n");
        k = k + 1;
        if last {
            i = b.len;
        } else {
            i = stop + 1;
        }
    }
}

// ============================================================
// P15：子代理窗口面板（2 行/个、最多 4 个、边框每行等宽）
// ============================================================
fn win_add(t: &DelegTable, i: usize, id: i32, kind: u8, st: u8, secs_ago: u64, label: &const byte, prompt: &const byte, outline: &const byte) void {
    const si: usize = i;
    if si >= DELEG_MAX {
        return;
    }
    t.items[si].used = true;
    t.items[si].id = id;
    t.items[si].kind = kind;
    t.items[si].pid = -1;
    t.items[si].fd = -1;
    t.items[si].status = st;
    t.items[si].code = 0;
    t.items[si].reaped = true;          // 不真 fork：只测显示
    t.items[si].read_off = 0;
    t.items[si].rounds = 0;
    t.items[si].max_rounds = 0;
    t.items[si].ended_noted = false;
    const now: u64 = ua_now_ms();
    if secs_ago > 0 && now > secs_ago * (1000 as u64) {
        t.items[si].started_ms = now - (secs_ago * (1000 as u64));
    } else {
        t.items[si].started_ms = now;
    }
    t.items[si].label = buf_new(bufx_cstr_len(label) + 8);
    _ = buf_append_cstr(&t.items[si].label, label);
    t.items[si].prompt = buf_new(bufx_cstr_len(prompt) + 8);
    _ = buf_append_cstr(&t.items[si].prompt, prompt);
    t.items[si].sid = buf_empty();
    t.items[si].objective = buf_empty();
    t.items[si].buf = buf_empty();
    if bufx_cstr_len(outline) > 0 {
        t.items[si].buf = buf_new(256);
        _ = buf_append_cstr(&t.items[si].buf, outline);
    }
}

// 面板每一行的显示列数是否完全相等（边框不能错位 —— 就是这条断言守着）
fn win_cols_uniform(b: &const Buf, out: &usize) bool {
    if b.len == 0 {
        return false;
    }
    const data: &[byte] = b.ptr[0: b.len];
    var i: usize = 0;
    var w0: usize = 0;
    var k: usize = 0;
    while i < b.len {
        const nl: isize = bufx_find_byte(data, 10 as byte, i);
        var stop: usize = b.len;
        var last: bool = true;
        if nl >= 0 {
            stop = nl as usize;
            last = false;
        }
        const w: usize = tty_cols_between(b.ptr as &const byte, i, stop);
        if k == 0 {
            w0 = w;
        } else if w != w0 {
            return false;
        }
        k = k + 1;
        if last {
            i = b.len;
        } else {
            i = stop + 1;
        }
    }
    out[0] = w0;
    return k > 0;
}

fn win_round(tag: &const byte) bool {
    var ok: bool = true;
    var txt: Buf = buf_new(8192);
    defer { buf_free(&txt); }
    var t: DelegTable = DelegTable{ items: [], next_id: 1 };
    deleg_init(&t);
    defer { deleg_free(&t); }

    view_init(true, 6);

    // ---- A0) buf 原语：字面量必须逐字节落进缓冲区（这里抓过「标题里混进随机字节」）----
    {
        var pb: Buf = buf_new(8);          // 故意给很小：逼出 realloc 路径
        _ = buf_append_cstr(&pb, "agent ");
        _ = buf_append_u64(&pb, 1);
        _ = buf_append_cstr(&pb, "/4");
        if pb.len != 9 || !bufx_mem_eq(pb.ptr as &const byte, "agent 1/4" as &const byte, 9) {
            ty_fail(tag, "buf 原语拼出来的字面量不对", &ok);
        }
        buf_free(&pb);
    }

    // ---- A) 空表：没有窗口可显示 ----
    if view_agents_text(&t, &txt) {
        ty_fail(tag, "空表不该产出面板", &ok);
    }
    if txt.len != 0 {
        ty_fail(tag, "空表时输出必须清空", &ok);
    }

    // ---- B) 混合状态：只有 running 进面板，最多 4 个 ----
    win_add(&t, 0, 1, DELEG_KIND_SUB, DELEG_RUNNING, 3, "审计 deleg 的等待循环与 fork/exec 差异",
            "检查 1030-1120 行的 fork/exec 差异", "l1
l2
");
    win_add(&t, 1, 2, DELEG_KIND_RALPH, DELEG_RUNNING, 12, "ralph loop",
            "Round 2 of 4. Objective: 把骨架补齐", "r1
");
    win_add(&t, 2, 3, DELEG_KIND_SUB, DELEG_DONE, 27, "已经跑完的（不该出现）", "不该出现的预览", "");
    win_add(&t, 3, 4, DELEG_KIND_SUB, DELEG_FAILED, 40, "失败窗口（不该出现）", "不该出现的预览", "");
    if !view_agents_text(&t, &txt) {
        ty_fail(tag, "有两个运行中的子代理，必须产出面板", &ok);
    }
    if !contains(&txt, "sub-1") || !contains(&txt, "sub-2") {
        ty_fail(tag, "运行中的两个窗口都要在面板里", &ok);
    }
    if contains(&txt, "sub-3") || contains(&txt, "sub-4") {
        ty_fail(tag, "跑完/失败的窗口不该留在面板里（跑完即隐）", &ok);
    }
    if !contains(&txt, "● running") || !contains(&txt, "[subagent]") || !contains(&txt, "[ralph]") {
        ty_fail(tag, "状态字形与种类标注不对", &ok);
    }
    if !contains(&txt, "· 2 ·") {
        ty_fail(tag, "状态行少了「已收输出行数」", &ok);
    }
    if !ty_starts(&txt, "┌─ agents ") {
        ty_fail(tag, "面板首行应该是带标题的上边框", &ok);
    }
    if !ty_ends(&txt, "┘\n" as &const byte, 4) {
        ty_fail(tag, "面板末行应该是底框", &ok);
    }
    var w0: usize = 0;
    if !win_cols_uniform(&txt, &w0) {
        ty_fail(tag, "面板每一行的显示列数必须完全相等（边框不能错位）", &ok);
    } else if w0 != 78 {
        ty_fail(tag, "面板宽度应该是显示宽 - 2 = 78 列", &ok);
        out_err("[w0] ");
        out_err_dec(w0);
        out_err("\n");
    }
    if view_count_lines(txt.ptr as &const byte, txt.len) != 6 {
        ty_fail(tag, "两个窗口的面板应该是 6 行（1 标题 + 2×2 内容 + 1 底框）", &ok);
    }

    // ---- C) 表满 + 只有一个 running：标题写成 agents 1/N，面板 4 行 ----
    t.items[1].status = DELEG_DONE;
    if !view_agents_text(&t, &txt) {
        ty_fail(tag, "还剩一个运行中的窗口", &ok);
    }
    if contains(&txt, "sub-2") {
        ty_fail(tag, "跑完的窗口必须立刻从面板消失", &ok);
    }
    if !contains(&txt, "agent 1/4") {
        ty_fail(tag, "标题应写明「运行中/总数」", &ok);
    }
    if view_count_lines(txt.ptr as &const byte, txt.len) != 4 {
        ty_fail(tag, "单个窗口的面板应该是 4 行", &ok);
    }
    var w1: usize = 0;
    if !win_cols_uniform(&txt, &w1) || w1 != 78 {
        ty_fail(tag, "单个窗口时每行也要等宽 78 列", &ok);
    }

    // ---- C2) 秒数：窗口文本必须随「已跑时长」变（1Hz 重画的依据）----
    {
        var t2: DelegTable = DelegTable{ items: [], next_id: 1 };
        deleg_init(&t2);
        win_add(&t2, 0, 7, DELEG_KIND_SUB, DELEG_RUNNING, 1, "beats", "tick", "");
        // 直接改 started_ms：把它推到「刚刚 3 秒前」，再渲染
        t2.items[0].started_ms = ua_now_ms() - (3 as u64) * (1000 as u64);
        var a1: Buf = buf_new(2048);
        _ = view_agents_text(&t2, &a1);
        if !contains(&a1, "3s") {
            ty_fail(tag, "面板状态行应显示已跑 3s", &ok);
            win_dump_lines(&a1);
        }
        t2.items[0].started_ms = ua_now_ms() - (9 as u64) * (1000 as u64);
        var a2: Buf = buf_new(2048);
        _ = view_agents_text(&t2, &a2);
        if !contains(&a2, "9s") {
            ty_fail(tag, "面板状态行应显示已跑 9s（秒数在跳）", &ok);
            win_dump_lines(&a2);
        }
        if a1.len == a2.len && bufx_mem_eq(a1.ptr as &const byte, a2.ptr as &const byte, a1.len) {
            ty_fail(tag, "秒数变化必须改变面板文本（否则 1Hz 重画不会发生）", &ok);
        }
        buf_free(&a1);
        buf_free(&a2);
        deleg_free(&t2);
    }

    // ---- D) 超长中文标签 + 超长预览：截断后每行仍然等宽 ----
    win_add(&t, 1, 5, DELEG_KIND_SUB, DELEG_RUNNING, 127,
            "审计一个名字特别特别长的子代理描述描述描述描述描述描述描述描述描述描述描述",
            "很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览 很长的预览",
            "");
    if !view_agents_text(&t, &txt) {
        ty_fail(tag, "超长内容也要能出面板", &ok);
    }
    var w2: usize = 0;
    if !win_cols_uniform(&txt, &w2) || w2 != 78 {
        ty_fail(tag, "超长中文下每行仍须等宽 78 列", &ok);
    }
    if !contains(&txt, "…") {
        ty_fail(tag, "超长内容必须按列截断并补 …", &ok);
    }
    if !contains(&txt, "2m07s") && !contains(&txt, "2m06s") && !contains(&txt, "2m08s") {
        ty_fail(tag, "127 秒应该显示成 2m07s 这种「分+秒」格式", &ok);
    }

    // ---- E) 秒数格式：<60s 是 Ns、≥1h 是 Nm+、字段宽度恒定 ----
    var sb: Buf = buf_new(32);
    defer { buf_free(&sb); }
    view_ag_secs(&sb, 1, 1 + 3 * (1000 as u64));
    if !ty_buf_is(&sb, "3s") {
        ty_fail(tag, "3 秒应显示 3s", &ok);
    }
    view_ag_secs(&sb, 1, 1 + 65 * (1000 as u64));
    if !ty_buf_is(&sb, "1m05s") {
        ty_fail(tag, "65 秒应显示 1m05s", &ok);
    }
    view_ag_secs(&sb, 1, 1 + (4000 as u64) * (1000 as u64));
    if !ty_buf_is(&sb, "59m+") {
        ty_fail(tag, "超过 1 小时应显示 59m+", &ok);
    }
    if tty_cols_between("  12s" as &const byte, 0, 5) != 5 || tty_cols_between("1m05s" as &const byte, 0, 5) != 5 {
        ty_fail(tag, "秒数字段必须是固定 5 列（否则后面的 · 会左右横跳）", &ok);
    }

    // ---- E2) 走「活」路径：view_agents_sync → 面板块 → tty_draw_line 真画一帧 ----
    {
        tty_init(&tty_ui, 0);
        tty_ui.is_tty = true;
        tty_ui.raw = true;
        tty_ui.cols = 100;                 // 面板宽 = 100 - 2 = 98
        tty_set_block_provider(&tty_ui, true);
        tty_set_prompt(&tty_ui, "[step 1] > ");
        tty_line_clear(&tty_ui);
        var live: DelegTable = DelegTable{ items: [], next_id: 1 };
        deleg_init(&live);
        win_add(&live, 0, 11, DELEG_KIND_SUB, DELEG_RUNNING, 3, "活路径", "验证秒数进了面板块", "");
        live.items[0].started_ms = ua_now_ms() - (3 as u64) * (1000 as u64);
        if !view_agents_sync(&live) {
            ty_fail(tag, "第一次同步必须把面板推给 tty", &ok);
        }
        if tty_block_len() == 0 {
            ty_fail(tag, "同步后面板块里应该有内容", &ok);
        }
        var tpath: [byte: 64] = "build/selftest_panel_live.txt";
        const tp2: &const byte = &tpath[0] as &const byte;
        var lcfd: i32 = -1;
        var lcap: Buf = buf_new(16384);
        defer { buf_free(&lcap); }
        const lsaved: i32 = vw_cap_on(tp2, &lcfd);
        tty_draw_line(&tty_ui, 2);
        vw_cap_off(tp2, lsaved, lcfd, &lcap);
        if !contains(&lcap, "3s") {
            ty_fail(tag, "活路径画出来的帧里应该有 3s", &ok);
        }
        if !contains(&lcap, "sub-11") {
            ty_fail(tag, "活路径画出来的帧里应该有 sub-11", &ok);
        }
        // 每一行（去掉擦除序列后）必须正好 98 列
        var bad: bool = false;
        var li: usize = 0;
        while li < lcap.len {
            const nl2: isize = bufx_find_byte(lcap.ptr[0: lcap.len], 10 as byte, li);
            var stop2: usize = lcap.len;
            var last2: bool = true;
            if nl2 >= 0 {
                stop2 = nl2 as usize;
                last2 = false;
            }
            const ln2: usize = stop2 - li;
            if ln2 > 0 && lcap.ptr[li] == 226 as byte {
                if tty_cols_between(lcap.ptr as &const byte, li, stop2) != 98 {
                    bad = true;
                }
            }
            if last2 {
                li = lcap.len;
            } else {
                li = stop2 + 1;
            }
        }
        if bad {
            ty_fail(tag, "活路径画出来的面板行不都是 98 列", &ok);
        }
        tty_set_block_provider(&tty_ui, false);
        tty_free(&tty_ui);
        tty_init(&tty_ui, 0);
        deleg_free(&live);
    }

    // ---- F) 显示层关闭时（--quiet / 子代理进程）不许产生任何输出 ----
    view_init(false, 6);
    if view_agents_sync(&t) {
        ty_fail(tag, "显示层关闭时不该刷新面板", &ok);
    }
    if tty_block_len() != 0 {
        ty_fail(tag, "显示层关闭时不该往面板块里写东西", &ok);
    }
    view_init(true, 6);

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

fn view_round(tag: &const byte) bool {
    var ok: bool = true;
    var out: Buf = buf_new(16384);
    defer { buf_free(&out); }
    var cap: Buf = buf_new(16384);
    defer { buf_free(&cap); }
    var nm: Buf = buf_new(64);
    defer { buf_free(&nm); }
    var ar: Buf = buf_new(1024);
    defer { buf_free(&ar); }
    var rs: Buf = buf_new(1024);
    defer { buf_free(&rs); }

    var raw: &void = malloc(262144);
    if ((raw as &byte) as usize) == 0 {
        ty_fail(tag, "cannot allocate arena", &ok);
        return false;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 262144);

    view_init(true, 6);
    diffx_init(true, 6);

    // P16：默认（tool_lines = 0）每次调用**只出一行**；正文（diff / 首尾行 / todo 清单）
    // 只在 --tool-lines N（N>0）时才出现 —— A–H 用 0，D2/E/E2 用 6 覆盖正文。

    // ---- A) bash 失败：摘要取 description（DSH 口径），字形 ✗，后缀 exit 1 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "bash");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"command\":\"npm test\",\"description\":\"run tests\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "FAIL src/a.uya\n2 tests failed\n[exit code: 1]");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✗ Bash · run tests · exit 1\n") {
        ty_fail(tag, "bash 失败行不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- B) bash 成功：exit 0 / ✓ ----
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "hi\n[exit code: 0]");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Bash · run tests · exit 0\n") {
        ty_fail(tag, "bash 成功行不对", &ok);
    }

    // ---- B2) bash 没有 description → 摘要退回命令行 ----
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"command\":\"npm test\"}");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Bash · npm test · exit 0\n") {
        ty_fail(tag, "没有 description 时摘要应退回命令行", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- C) read 带 offset/limit → · lines a-b ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "read");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"file_path\":\"src/agent.uya\",\"offset\":100,\"limit\":50}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "src/agent.uya\nline body\n(End of file - total 9 lines)");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Read · src/agent.uya · lines 100-149\n") {
        ty_fail(tag, "read 行不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- D) todo_write（正文关闭）→ 只有计数后缀，没有清单 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "todo_write");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"todos\":[{\"content\":\"a\",\"status\":\"completed\"},{\"content\":\"b\",\"status\":\"in_progress\"},{\"content\":\"c\",\"status\":\"pending\"}]}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "Updated todo list: 1 pending, 1 in progress, 1 completed.");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Todo · 3 items (1 done)\n") {
        ty_fail(tag, "tool_lines=0 时 todo 不该有清单", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- D2) todo_write + tool_lines=6 → 清单正文本回来 ----
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 72);
    if !ty_buf_is(&out, "\n✓ Todo · 3 items (1 done)\n    ✓ a\n    ▸ b\n    · c\n") {
        ty_fail(tag, "tool_lines=6 时 todo 清单不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- E) write + diff：行只有 +A -D；正文（diff）要 tool_lines=6 才有 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "write");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"file_path\":\"note.txt\",\"content\":\"a\\nB\\nc\\n\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "Updated file");
    var d1: Buf = vw_mk("a\nb\nc\n");
    var d2: Buf = vw_mk("a\nB\nc\n");
    const d1v: &[byte] = d1.ptr[0: d1.len];
    const d2v: &[byte] = d2.ptr[0: d2.len];
    diffx_note(d1v, d2v);
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✓ Write · note.txt · +1 -1\n") {
        ty_fail(tag, "tool_lines=0 时 write 不该有 diff 正文", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    diffx_note(d1v, d2v);   // take 过一次就清了，重新采一份给 6 行的断言
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 72);
    if !ty_buf_is(&out, "\n✓ Write · note.txt · +1 -1\n      a\n    - b\n    + B\n      c\n") {
        ty_fail(tag, "write 的 diff 块不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&d1);
    buf_free(&d2);

    // ---- E2) write 失败：不显示假 diff，正文（tool_lines>0 时）用错误文本 ----
    var d3: Buf = vw_mk("a\nb\nc\n");
    var d4: Buf = vw_mk("a\nB\nc\n");
    const d3v: &[byte] = d3.ptr[0: d3.len];
    const d4v: &[byte] = d4.ptr[0: d4.len];
    diffx_note(d3v, d4v);
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "Error: cannot create \"note.txt\"");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✗ Write · note.txt · 1 lines\n") {
        ty_fail(tag, "tool_lines=0 时失败的 write 不该有正文", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    diffx_note(d3v, d4v);
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 72);
    if !ty_buf_is(&out, "\n✗ Write · note.txt · 1 lines\n    Error: cannot create \"note.txt\"\n") {
        ty_fail(tag, "失败的 write 不该显示 diff", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&d3);
    buf_free(&d4);

    // ---- F) 工具报错（Error: 前缀）→ ✗ + 兜底后缀 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "bash");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"command\":\"false\",\"description\":\"x\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "Error: cannot spawn bash");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✗ Bash · x · 1 lines\n") {
        ty_fail(tag, "错误结果行不对", &ok);
    }

    // ---- G) 参数不是合法 JSON → 标题后面没有摘要 ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "read");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{not json");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "error: tool arguments are not valid JSON");
    view_render_block(&out, &arena, &nm, &ar, &rs, 0, 72);
    if !ty_buf_is(&out, "\n✗ Read · 1 lines\n") {
        ty_fail(tag, "坏参数的行不对", &ok);
        out_err("[block] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- H) 中文摘要 + 窄终端 → 行按列截断并补 '…' ----
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "read");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"file_path\":\"文档/这是一个很长的中文文件名字用来测试按显示列截断.txt\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "ok");
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 30);
    if !contains(&out, "…") {
        ty_fail(tag, "窄终端下应该按列截断并补省略号", &ok);
    }

    // ---- I) 结果首尾 + 省略标记 ----
    var many: Buf = buf_new(256);
    var i: usize = 0;
    while i < 10 {
        _ = buf_append_cstr(&many, "l");
        _ = buf_append_u64(&many, i as u64);
        _ = buf_append_byte(&many, 10);
        i = i + 1;
    }
    view_head_tail(&out, many.ptr as &const byte, many.len, 2, 72);
    if !ty_buf_is(&out, "    l0\n    l1\n    … (省略 6 行)\n    l8\n    l9\n") {
        ty_fail(tag, "首尾 + 省略标记不对", &ok);
        out_err("[body] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    // tool_lines=0 → 没有正文
    view_head_tail(&out, many.ptr as &const byte, many.len, 0, 72);
    if out.len != 0 {
        ty_fail(tag, "--tool-lines 0 时不该有正文", &ok);
    }
    buf_free(&many);

    // ---- J) 关闭态：fd 2 上一个字节都不许出现 ----
    var cap_path: [byte: 64] = "build/selftest_view_stderr.txt";
    const cap_p: &const byte = &cap_path[0] as &const byte;
    view_init(false, 6);
    diffx_init(false, 6);
    if view_enabled() || diffx_enabled() {
        ty_fail(tag, "view_init(false) 之后两个开关都该是关的", &ok);
    }
    var cfd: i32 = -1;
    const saved: i32 = vw_cap_on(cap_p, &cfd);
    buf_reset(&nm);
    _ = buf_append_cstr(&nm, "read");
    buf_reset(&ar);
    _ = buf_append_cstr(&ar, "{\"file_path\":\"x\"}");
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "ok\n");
    view_end_tool(&arena, &nm, &ar, &rs);
    vw_cap_off(cap_p, saved, cfd, &cap);
    if cap.len != 0 {
        ty_fail(tag, "--quiet（显示关闭）时不该往 fd 2 写任何字节", &ok);
        out_err("[captured] ");
        out_err_bytes(cap.ptr as &const byte, cap.len);
        out_err("\n");
    }

    // ---- K) 打开态：fd 2 上必须是与 view_render_block 完全一致的那一块 ----
    view_init(true, 6);
    diffx_init(true, 6);
    buf_reset(&rs);
    _ = buf_append_cstr(&rs, "body one\nbody two\n");
    view_render_block(&out, &arena, &nm, &ar, &rs, 6, 72);
    cfd = -1;
    const saved2: i32 = vw_cap_on(cap_p, &cfd);
    view_end_tool(&arena, &nm, &ar, &rs);
    vw_cap_off(cap_p, saved2, cfd, &cap);
    if cap.len != out.len || (cap.len > 0 && !bufx_mem_eq(cap.ptr as &const byte, out.ptr as &const byte, cap.len)) {
        ty_fail(tag, "打开态写到 fd 2 的内容与渲染结果不一致", &ok);
        out_err("[want] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n[got] ");
        out_err_bytes(cap.ptr as &const byte, cap.len);
        out_err("\n");
    }

    view_init(false, 6);
    diffx_init(false, 6);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// ============================================================
// Responses 接口（/v1/responses）自测
//
//   1) 解析器轮（resp_round）：mock 端按 Responses 事件表发一整套 SSE（chunked +
//      受控切片，帧必然被 TCP 切开），客户端直接调 llm_stream_style(RESPONSES)，
//      再逐字段断言 ChatOut —— 覆盖正常/分片/终局回填/incomplete/failed/截断/
//      [DONE] 容错/网关回成 chat 形状/坏 JSON。
//   2) 请求体轮（resp_build_round）：26 个工具常量都能变换成扁平 schema；
//      build_model_request 组装出来的 input items / store / max_output_tokens /
//      reasoning / developer-vs-system 逐条断言。
//   3) 非流式轮（resp_nonstream_round）：responses_out_from_nonstream 解析罐头 JSON。
//   4) 协商轮（api_negotiate_round + mock mode 21）：未声明时先 responses，404 回退 chat
//      且只回退一次；400 之类的状态码不得触发回退。
//   5) 端到端轮（mock mode 19/20）：完整 agent 循环走 responses（流式/非流式）。
// ============================================================
const RESP_CASE_TEXT: i32 = 0;
const RESP_CASE_TOOLS: i32 = 1;
const RESP_CASE_ARGS_DONE: i32 = 2;
const RESP_CASE_TERMINAL_ONLY: i32 = 3;
const RESP_CASE_INCOMPLETE: i32 = 4;
const RESP_CASE_FAILED: i32 = 5;
const RESP_CASE_NOTERMINAL: i32 = 6;
const RESP_CASE_DONEFRAME: i32 = 7;
const RESP_CASE_CHATSHAPE: i32 = 8;
const RESP_CASE_BADJSON: i32 = 9;

var resp_case: i32 = 0;

// 一帧 SSE（带 event: 行，钉住「event 行必须被忽略」）
fn resp_raw(out: &Buf, ev_name: &const byte, payload: &const byte) bool {
    if !buf_append_cstr(out, "event: ") {
        return false;
    }
    if !buf_append_cstr(out, ev_name) {
        return false;
    }
    if !buf_append_cstr(out, "\ndata: ") {
        return false;
    }
    if !buf_append_cstr(out, payload) {
        return false;
    }
    return buf_append_cstr(out, "\n\n");
}

// 只有 data 行（多数网关的形状）
fn resp_data(out: &Buf, payload: &const byte) bool {
    if !buf_append_cstr(out, "data: ") {
        return false;
    }
    if !buf_append_cstr(out, payload) {
        return false;
    }
    return buf_append_cstr(out, "\n\n");
}

fn resp_case_text(out: &Buf) bool {
    if !resp_raw(out, "response.created", `{"type":"response.created","response":{"id":"resp_1","status":"in_progress"}}`) {
        return false;
    }
    if !resp_raw(out, "response.in_progress", `{"type":"response.in_progress","response":{"id":"resp_1","status":"in_progress"}}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.output_item.added","output_index":0,"item":{"type":"message","id":"msg_1","role":"assistant","content":[]}}`) {
        return false;
    }
    if !resp_raw(out, "response.output_text.delta", `{"type":"response.output_text.delta","output_index":0,"delta":"Hello"}`) {
        return false;
    }
    if !resp_raw(out, "response.output_text.delta", `{"type":"response.output_text.delta","output_index":0,"delta":", Uya!"}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.output_item.done","output_index":0,"item":{"type":"message","id":"msg_1","status":"completed","content":[{"type":"output_text","text":"Hello, Uya!","annotations":[]}]}}`) {
        return false;
    }
    return resp_raw(out, "response.completed", `{"type":"response.completed","response":{"id":"resp_1","status":"completed","output":[],"usage":{"input_tokens":100,"input_tokens_details":{"cached_tokens":40},"output_tokens":7,"output_tokens_details":{"reasoning_tokens":3},"total_tokens":107}}}`);
}

fn resp_case_tools(out: &Buf) bool {
    if !resp_data(out, `{"type":"response.output_item.added","output_index":0,"item":{"type":"reasoning","id":"rs_1","summary":[]}}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.reasoning_summary_text.delta","output_index":0,"delta":"think1"}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.reasoning_summary_text.delta","output_index":0,"delta":"think2"}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.output_item.added","output_index":1,"item":{"type":"function_call","id":"fc_1","call_id":"call_a","name":"read","arguments":""}}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.output_item.added","output_index":2,"item":{"type":"function_call","id":"fc_2","call_id":"call_b","name":"bash","arguments":""}}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.output_text.delta","output_index":3,"delta":"I will read it"}`) {
        return false;
    }
    // arguments 分片：拼起来必须是 {"file_path":"a.txt"} / {"command":"ls"}
    if !resp_data(out, `{"type":"response.function_call_arguments.delta","output_index":1,"item_id":"fc_1","delta":"{\"file"}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.function_call_arguments.delta","output_index":2,"item_id":"fc_2","delta":"{\"command\":\"ls"}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.function_call_arguments.delta","output_index":1,"item_id":"fc_1","delta":"_path\":\"a.txt\"}"}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.function_call_arguments.delta","output_index":2,"item_id":"fc_2","delta":"\"}"}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.output_item.done","output_index":1,"item":{"type":"function_call","id":"fc_1","call_id":"call_a","name":"read","arguments":"{\"file_path\":\"a.txt\"}"}}`) {
        return false;
    }
    if !resp_data(out, `{"type":"response.output_item.done","output_index":2,"item":{"type":"function_call","id":"fc_2","call_id":"call_b","name":"bash","arguments":"{\"command\":\"ls\"}"}}`) {
        return false;
    }
    return resp_data(out, `{"type":"response.completed","response":{"id":"resp_2","status":"completed","output":[],"usage":{"input_tokens":50,"output_tokens":9}}}`);
}

fn resp_case_args_done(out: &Buf) bool {
    if !resp_data(out, `{"type":"response.output_item.added","output_index":0,"item":{"type":"function_call","id":"fc_9","call_id":"call_9","name":"bash","arguments":""}}`) {
        return false;
    }
    // 故意不发 delta：参数只在 output_item.done 里
    if !resp_data(out, `{"type":"response.output_item.done","output_index":0,"item":{"type":"function_call","id":"fc_9","call_id":"call_9","name":"bash","arguments":"{\"command\":\"echo hi\"}"}}`) {
        return false;
    }
    return resp_data(out, `{"type":"response.completed","response":{"id":"resp_3","status":"completed"}}`);
}

fn resp_case_terminal_only(out: &Buf) bool {
    if !resp_data(out, `{"type":"response.created","response":{"id":"resp_4","status":"in_progress"}}`) {
        return false;
    }
    // 正文与参数只在终局事件的 response.output[] 里（有些网关就这么发）
    return resp_data(out, `{"type":"response.completed","response":{"id":"resp_4","status":"completed","output":[{"type":"message","id":"msg_4","role":"assistant","status":"completed","content":[{"type":"output_text","text":"from terminal"}]},{"type":"function_call","id":"fc_4","call_id":"call_t","name":"read","arguments":"{\"file_path\":\"t.txt\"}"}],"usage":{"input_tokens":11,"output_tokens":4}}}`);
}

fn resp_case_incomplete(out: &Buf) bool {
    if !resp_data(out, `{"type":"response.output_text.delta","output_index":0,"delta":"cut"}`) {
        return false;
    }
    return resp_data(out, `{"type":"response.incomplete","response":{"id":"resp_5","status":"incomplete","incomplete_details":{"reason":"max_output_tokens"},"usage":{"input_tokens":9,"output_tokens":3}}}`);
}

fn resp_case_failed(out: &Buf) bool {
    if !resp_data(out, `{"type":"response.output_text.delta","output_index":0,"delta":"half"}`) {
        return false;
    }
    return resp_data(out, `{"type":"response.failed","response":{"id":"resp_6","status":"failed","error":{"code":"rate_limit_exceeded","message":"mock rate limited"}}}`);
}

fn resp_case_noterminal(out: &Buf) bool {
    return resp_data(out, `{"type":"response.output_text.delta","output_index":0,"delta":"partial"}`);
}

fn resp_case_doneframe(out: &Buf) bool {
    if !resp_data(out, `{"type":"response.output_text.delta","output_index":0,"delta":"with done"}`) {
        return false;
    }
    return resp_data(out, "[DONE]");   // 少数代理会补一帧 [DONE]：必须当正常收尾
}

fn resp_case_chatshape(out: &Buf) bool {
    // 网关把 /v1/responses 的流按 chat 形状回：解析器要能兜住
    if !resp_data(out, `{"choices":[{"index":0,"delta":{"content":"chat-shaped"}}]}`) {
        return false;
    }
    return resp_data(out, "[DONE]");
}

fn resp_case_badjson(out: &Buf) bool {
    if !resp_data(out, `{"type":"response.output_text.delta","output_index":0,"delta":"before-bad"}`) {
        return false;
    }
    return resp_data(out, `{"type":"response.output_text.delta","output_index":0,`);
}

fn resp_mock_text(case_id: i32, out: &Buf) bool {
    if case_id == RESP_CASE_TEXT {
        return resp_case_text(out);
    }
    if case_id == RESP_CASE_TOOLS {
        return resp_case_tools(out);
    }
    if case_id == RESP_CASE_ARGS_DONE {
        return resp_case_args_done(out);
    }
    if case_id == RESP_CASE_TERMINAL_ONLY {
        return resp_case_terminal_only(out);
    }
    if case_id == RESP_CASE_INCOMPLETE {
        return resp_case_incomplete(out);
    }
    if case_id == RESP_CASE_FAILED {
        return resp_case_failed(out);
    }
    if case_id == RESP_CASE_NOTERMINAL {
        return resp_case_noterminal(out);
    }
    if case_id == RESP_CASE_DONEFRAME {
        return resp_case_doneframe(out);
    }
    if case_id == RESP_CASE_CHATSHAPE {
        return resp_case_chatshape(out);
    }
    return resp_case_badjson(out);
}

// mock 端：一次连接，回 Responses 的 SSE（chunked + 受控切片）
fn resp_mock_server(lfd: i32) i32 {
    var peer: [byte: 16] = [0: 16];
    var alen: u32 = 16;
    const cfd: i32 = sys_accept(lfd, &peer[0] as &void, &alen) catch {
        _ = sys_close(lfd) catch {};
        return 180;
    };
    var rx: Buf = buf_new(8192);
    var verdict: i32 = 0;
    if !mock_read_request(cfd, &rx) {
        verdict = 181;
    } else if !contains(&rx, "POST /v1/responses") {
        verdict = 182;
    } else if !contains(&rx, "\"input\":") {
        verdict = 183;
    } else if !contains(&rx, "\"stream\":true") {
        verdict = 184;
    } else if !contains(&rx, "Accept: text/event-stream") {
        verdict = 185;
    }
    buf_free(&rx);

    var text: Buf = buf_new(16384);
    if verdict == 0 && !resp_mock_text(resp_case, &text) {
        verdict = 186;
    }

    var wire: Buf = buf_new(32768);
    if verdict == 0 {
        var off: usize = 0;
        while off < text.len {
            var take: usize = text.len - off;
            if take > 37 {
                take = 37;
            }
            _ = buf_append_u64_hex(&wire, take);
            _ = buf_append_cstr(&wire, "\r\n");
            _ = buf_append(&wire, &text.ptr[off], take);
            _ = buf_append_cstr(&wire, "\r\n");
            off = off + take;
        }
        _ = buf_append_cstr(&wire, "0\r\n\r\n");
    }

    if verdict == 0 {
        var head: Buf = buf_new(256);
        _ = buf_append_cstr(&head, "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n");
        const hw: !void = https_write_all(cfd, &head.ptr[0] as &const byte, head.len);
        _ = hw catch {
            verdict = 187;
        };
        buf_free(&head);
    }

    if verdict == 0 {
        var woff: usize = 0;
        while woff < wire.len {
            var take: usize = wire.len - woff;
            if take > SSE_SLICE {
                take = SSE_SLICE;
            }
            const w: !void = https_write_all(cfd, &wire.ptr[woff] as &const byte, take);
            _ = w catch {
                verdict = 188;
                break;
            };
            woff = woff + take;
            if woff < wire.len {
                var reqt: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: SSE_GAP_NS };
                var remt: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
                _ = sys_nanosleep(&reqt, &remt) catch {};
            }
        }
    }

    buf_free(&wire);
    buf_free(&text);
    _ = sys_close(cfd) catch {};
    _ = sys_close(lfd) catch {};
    return verdict;
}

// 客户端：调一次 llm_stream_style(RESPONSES)。返回 0=成功 1=malformed 2=stream-closed 3=其它 4=状态码非 200
fn resp_call(url: &[byte], hdrs: &[byte], body: &const Buf, o: &ChatOut) i32 {
    var empty_pin: [byte: 0] = [];
    const res: !i32 = llm_stream_style(
        LLM_STYLE_RESPONSES,
        url,
        hdrs,
        body.ptr as &const byte,
        body.len,
        15000,
        262144,
        HC_VERIFY_NONE,
        &empty_pin[0: 0],
        o,
        false,
        false,
        false
    );
    const status: i32 = res catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        var r: i32 = 3;
        if eid == @error_id(error.LlmMalformed) {
            r = 1;
        } else if eid == @error_id(error.LlmStreamClosed) {
            r = 2;
        }
        r;
    };
    if status == 0 || status == 1 || status == 2 {
        return status;
    }
    if status != 200 {
        return 4;
    }
    return 0;
}

fn resp_round(case_id: i32, tag: &const byte) bool {
    resp_case = case_id;
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        out_err("selftest: socket() failed\n");
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);

    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = resp_mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var url: Buf = buf_new(96);
    _ = buf_append_cstr(&url, "http://127.0.0.1:");
    _ = buf_append_u64(&url, port as u64);
    _ = buf_append_cstr(&url, "/v1/responses");
    var hdrs: Buf = buf_new(128);
    _ = buf_append_cstr(&hdrs, "Content-Type: application/json\r\nAccept: text/event-stream\r\n");
    var body: Buf = buf_new(256);
    _ = buf_append_cstr(&body, "{\"model\":\"selftest-model\",\"stream\":true,\"input\":[]}");

    var o: ChatOut = chat_out_new();
    const call_rc: i32 = resp_call(url.ptr[0: url.len], hdrs.ptr[0: hdrs.len], &body, &o);
    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    if mock_rc != 0 {
        out_err("selftest[");
        out_err(tag);
        out_err("] FAIL: mock verdict ");
        out_err_dec(mock_rc as usize);
        out_err("\n");
        ok = false;
    }
    if ok && case_id == RESP_CASE_TEXT {
        if call_rc != 0 || !o.saw_done || o.finish != LLM_FINISH_STOP {
            ty_fail(tag, "call_rc/finish 不对", &ok);
        } else if !sse_buf_eq(&o.content, "Hello, Uya!") {
            ty_fail(tag, "content 不对", &ok);
        } else if o.usage_in != 60 || o.usage_out != 7 || o.usage_cache_read != 40 || o.usage_reasoning != 3 {
            ty_fail(tag, "usage 映射不对（input 含缓存，要减掉）", &ok);
        } else if o.ncalls != 0 {
            ty_fail(tag, "不该有 tool_calls", &ok);
        }
    } else if ok && case_id == RESP_CASE_TOOLS {
        if call_rc != 0 || !o.saw_done || o.finish != LLM_FINISH_TOOL_CALLS {
            ty_fail(tag, "call_rc/finish 不对", &ok);
        } else if o.ncalls != 2 {
            ty_fail(tag, "ncalls 不对", &ok);
        } else if !sse_buf_eq(&o.calls[0].id, "call_a") || !sse_buf_eq(&o.calls[0].name, "read")
            || !sse_buf_eq(&o.calls[0].args, "{\"file_path\":\"a.txt\"}") {
            ty_fail(tag, "call0 的 call_id/name/args 不对", &ok);
        } else if !sse_buf_eq(&o.calls[1].id, "call_b") || !sse_buf_eq(&o.calls[1].name, "bash")
            || !sse_buf_eq(&o.calls[1].args, "{\"command\":\"ls\"}") {
            ty_fail(tag, "call1 的 call_id/name/args 不对", &ok);
        } else if !sse_buf_eq(&o.content, "I will read it") || !sse_buf_eq(&o.reasoning, "think1think2") {
            ty_fail(tag, "content/reasoning 不对", &ok);
        }
    } else if ok && case_id == RESP_CASE_ARGS_DONE {
        if call_rc != 0 || o.finish != LLM_FINISH_TOOL_CALLS || o.ncalls != 1 {
            ty_fail(tag, "call_rc/finish/ncalls 不对", &ok);
        } else if !sse_buf_eq(&o.calls[0].args, "{\"command\":\"echo hi\"}") {
            ty_fail(tag, "只在 output_item.done 里给的 arguments 没兜住", &ok);
        }
    } else if ok && case_id == RESP_CASE_TERMINAL_ONLY {
        if call_rc != 0 || o.finish != LLM_FINISH_TOOL_CALLS || o.ncalls != 1 {
            ty_fail(tag, "终局回填后的 finish/ncalls 不对", &ok);
        } else if !sse_buf_eq(&o.content, "from terminal") {
            ty_fail(tag, "终局 output[] 里的正文没回填", &ok);
        } else if !sse_buf_eq(&o.calls[0].id, "call_t") || !sse_buf_eq(&o.calls[0].name, "read")
            || !sse_buf_eq(&o.calls[0].args, "{\"file_path\":\"t.txt\"}") {
            ty_fail(tag, "终局 output[] 里的 function_call 没回填", &ok);
        } else if o.usage_in != 11 || o.usage_out != 4 {
            ty_fail(tag, "终局 usage 不对", &ok);
        }
    } else if ok && case_id == RESP_CASE_INCOMPLETE {
        if call_rc != 0 || o.finish != LLM_FINISH_MAX_TOKENS || !sse_buf_eq(&o.content, "cut") {
            ty_fail(tag, "incomplete(max_output_tokens) 应映射成 max-tokens", &ok);
        }
    } else if ok && case_id == RESP_CASE_FAILED {
        if call_rc != 0 || o.finish != LLM_FINISH_ERROR {
            ty_fail(tag, "failed 应映射成 error（且不是流被截断）", &ok);
        } else if !contains(&o.err_text, "rate_limit_exceeded") || !contains(&o.err_text, "mock rate limited") {
            ty_fail(tag, "err_text 里应带上 code: message", &ok);
        }
    } else if ok && case_id == RESP_CASE_NOTERMINAL {
        if call_rc != 2 {
            ty_fail(tag, "缺终局事件应当是 LlmStreamClosed", &ok);
        } else if !sse_buf_eq(&o.content, "partial") {
            ty_fail(tag, "截断前收到的内容不该丢", &ok);
        }
    } else if ok && case_id == RESP_CASE_DONEFRAME {
        if call_rc != 0 || !o.saw_done || o.finish != LLM_FINISH_STOP {
            ty_fail(tag, "[DONE] 兜底帧必须当正常收尾", &ok);
        } else if !sse_buf_eq(&o.content, "with done") {
            ty_fail(tag, "content 不对", &ok);
        }
    } else if ok && case_id == RESP_CASE_CHATSHAPE {
        if call_rc != 0 || !o.saw_done || o.finish != LLM_FINISH_STOP {
            ty_fail(tag, "chat 形状兜底没生效", &ok);
        } else if !sse_buf_eq(&o.content, "chat-shaped") {
            ty_fail(tag, "chat 形状的 content 不对", &ok);
        }
    } else if ok && case_id == RESP_CASE_BADJSON {
        if call_rc != 1 {
            ty_fail(tag, "坏 JSON 帧应当是 LlmMalformed", &ok);
        } else if !sse_buf_eq(&o.content, "before-bad") {
            ty_fail(tag, "坏帧之前的内容不该丢", &ok);
        } else if o.err_text.len == 0 {
            ty_fail(tag, "坏帧的 payload 头部应当留在 err_text", &ok);
        }
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    chat_out_free(&o);
    buf_free(&url);
    buf_free(&hdrs);
    buf_free(&body);
    return ok;
}

// 非流式 Responses 响应体 → ChatOut（--no-stream 路径）
fn resp_nonstream_round(tag: &const byte) bool {
    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    const cap: usize = 65536;
    const raw: &void = malloc(cap);
    if ((raw as &byte) as usize) == 0 {
        ty_fail(tag, "malloc 失败", &ok);
        return false;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, cap);

    const body: &const byte = `{"id":"resp_9","object":"response","status":"incomplete","incomplete_details":{"reason":"max_output_tokens"},"output":[{"type":"reasoning","id":"rs_9","summary":[{"type":"summary_text","text":"thought"}]},{"type":"message","id":"msg_9","role":"assistant","status":"completed","content":[{"type":"output_text","text":"answer ","annotations":[]},{"type":"refusal","refusal":"no"}]},{"type":"function_call","id":"fc_9","call_id":"call_ns|fc_9","name":"bash","arguments":"{\"command\":\"ls\"}"}],"usage":{"input_tokens":80,"input_tokens_details":{"cached_tokens":30},"output_tokens":12,"output_tokens_details":{"reasoning_tokens":5}}}`;
    var bodyb: Buf = buf_new(2048);
    defer { buf_free(&bodyb); }
    _ = buf_append_cstr(&bodyb, body);
    _ = buf_append_byte(&bodyb, 0);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, bodyb.ptr as &byte, bodyb.len - 1, &root) {
        ty_fail(tag, "罐头 JSON 解析失败", &ok);
    } else {
        var o: ChatOut = chat_out_new();
        const fill: !void = responses_out_from_nonstream(&root, &o);
        _ = fill catch {
            ty_fail(tag, "responses_out_from_nonstream 报错", &ok);
        };
        if !sse_buf_eq(&o.content, "answer no") {
            ty_fail(tag, "content（含 refusal）不对", &ok);
        }
        if !sse_buf_eq(&o.reasoning, "thought") {
            ty_fail(tag, "reasoning(summary) 不对", &ok);
        }
        if o.ncalls != 1 || !sse_buf_eq(&o.calls[0].id, "call_ns") || !sse_buf_eq(&o.calls[0].name, "bash")
            || !sse_buf_eq(&o.calls[0].args, "{\"command\":\"ls\"}") {
            ty_fail(tag, "function_call 的 call_id/name/args 不对（'|' 后那段要丢掉）", &ok);
        }
        if o.finish != LLM_FINISH_MAX_TOKENS {
            ty_fail(tag, "incomplete → max-tokens 不对", &ok);
        }
        if o.usage_in != 50 || o.usage_cache_read != 30 || o.usage_out != 12 || o.usage_reasoning != 5 {
            ty_fail(tag, "usage 映射不对", &ok);
        }
        if !o.saw_done {
            ty_fail(tag, "非流式解析完应当算收尾", &ok);
        }
        chat_out_free(&o);
    }
    // 第二份罐头：failed 但没有 error 明细；以及既没有 output 也没有 status 的坏响应
    const body2: &const byte = `{"id":"resp_10","status":"failed"}`;
    var b2: Buf = buf_new(256);
    defer { buf_free(&b2); }
    _ = buf_append_cstr(&b2, body2);
    _ = buf_append_byte(&b2, 0);
    arena_reset(&arena);
    var root2: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, b2.ptr as &byte, b2.len - 1, &root2) {
        ty_fail(tag, "第二份罐头 JSON 解析失败", &ok);
    } else {
        var o2: ChatOut = chat_out_new();
        _ = responses_out_from_nonstream(&root2, &o2) catch {
            ty_fail(tag, "failed 响应解析报错", &ok);
        };
        if o2.finish != LLM_FINISH_ERROR || o2.err_text.len == 0 {
            ty_fail(tag, "failed 没留下可打印的原因（err_text 不能空）", &ok);
        }
        chat_out_free(&o2);
    }
    const body3: &const byte = `{"object":"response","foo":1}`;
    var b3: Buf = buf_new(256);
    defer { buf_free(&b3); }
    _ = buf_append_cstr(&b3, body3);
    _ = buf_append_byte(&b3, 0);
    arena_reset(&arena);
    var root3: JsonValue = JsonValue.json_null();
    if js_parse(&arena, b3.ptr as &byte, b3.len - 1, &root3) {
        var o3: ChatOut = chat_out_new();
        _ = responses_out_from_nonstream(&root3, &o3) catch {
            ty_fail(tag, "坏响应解析报错", &ok);
        };
        if o3.finish != LLM_FINISH_ERROR || o3.err_text.len == 0 {
            ty_fail(tag, "没有 output/status 的响应应当报错并给出原因", &ok);
        }
        chat_out_free(&o3);
    }
    if ok {
        out_err("ok\n");
    }
    return ok;
}

// 请求体：扁平工具 schema + input items + 各开关
fn resp_build_round(tag: &const byte) bool {
    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");

    // 1) 工具数组（allow_shell 时 25 条）必须都能变换成合法的扁平 schema
    //    （顶层 name/parameters，且没有 chat 的 function 键）
    var tools: Buf = buf_new(32768);
    defer { buf_free(&tools); }
    if !tools_json(&tools, true, true) {
        ty_fail(tag, "tools_json(flat) 失败", &ok);
    } else if !buf_append_byte(&tools, 0) {
        ty_fail(tag, "tools buffer 追加 NUL 失败", &ok);
    } else {
        const cap: usize = 65536;
        const raw: &void = malloc(cap);
        if ((raw as &byte) as usize) == 0 {
            ty_fail(tag, "malloc 失败", &ok);
            return false;
        }
        var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
        arena_init(&arena, raw as &byte, cap);
        var root: JsonValue = JsonValue.json_null();
        if !js_parse(&arena, tools.ptr as &byte, tools.len - 1, &root) {
            ty_fail(tag, "扁平 tools 不是合法 JSON", &ok);
        } else if js_arr_len(&root) != 25 {
            ty_fail(tag, "扁平 tools 的条数不是 25", &ok);
        } else {
            var k: usize = 0;
            while k < 25 {
                var item: JsonValue = JsonValue.json_null();
                if !js_arr_get(&root, k, &item) {
                    ty_fail(tag, "扁平 tools 取项失败", &ok);
                    break;
                }
                var nm: JsonStrView = JsonStrView{ ptr: null, len: 0 };
                var pv: JsonValue = JsonValue.json_null();
                var fv: JsonValue = JsonValue.json_null();
                if !js_obj_get_str(&item, "name", 4, &nm) || nm.len == 0 {
                    ty_fail(tag, "扁平 tools 里缺 name", &ok);
                    break;
                }
                if !js_obj_get(&item, "parameters", 10, &pv) {
                    ty_fail(tag, "扁平 tools 里缺 parameters", &ok);
                    break;
                }
                if js_obj_get(&item, "function", 8, &fv) {
                    ty_fail(tag, "扁平 tools 里不该再有 function 键", &ok);
                    break;
                }
                k = k + 1;
            }
        }
        free(raw);
    }

    // 2) 组装请求：system + user + assistant(tool_calls) + tool
    var h: History = hist_init();
    defer { hist_free(&h); }
    _ = hist_push(&h, ROLE_SYSTEM, "SYS-PROMPT" as &const byte, 10);
    _ = hist_push(&h, ROLE_USER, "hello" as &const byte, 5);
    const calls: &const byte = `[{"id":"call_x|fc_y","type":"function","function":{"name":"bash","arguments":"{\"command\":\"echo hi\"}"}}]`;
    _ = hist_push_msg(&h, ROLE_ASSISTANT_CALLS, "working" as &const byte, 7, calls as &byte, bufx_cstr_len(calls));
    _ = hist_push_msg(&h, ROLE_TOOL, "hi\n" as &const byte, 3, "call_x|fc_y" as &byte, 11);

    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    cfg.model = buf_new(32);
    _ = buf_append_cstr(&cfg.model, "selftest-model");
    cfg.max_tokens = 8;
    cfg.reasoning_effort = buf_new(8);
    _ = buf_append_cstr(&cfg.reasoning_effort, "max");
    cfg.api_store = true;
    cfg.api_dev_role = true;
    var req: Buf = buf_new(65536);
    defer { buf_free(&req); }
    if !build_model_request(&cfg, &h, &req, LLM_STYLE_RESPONSES) {
        ty_fail(tag, "build_model_request(responses) 失败", &ok);
    } else {
        if contains(&req, "\"messages\":") {
            ty_fail(tag, "responses 请求里不该有 messages", &ok);
        }
        if !contains(&req, "\"input\":[{\"role\":\"developer\",\"content\":\"SYS-PROMPT\"}") {
            ty_fail(tag, "input[0] 应当是 developer + 普通字符串 content", &ok);
        }
        if !contains(&req, "{\"role\":\"user\",\"content\":[{\"type\":\"input_text\",\"text\":\"hello\"}]}") {
            ty_fail(tag, "user item 形状不对", &ok);
        }
        if !contains(&req, "{\"type\":\"message\",\"role\":\"assistant\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"text\":\"working\"}]}") {
            ty_fail(tag, "assistant message item 形状不对", &ok);
        }
        if !contains(&req, "{\"type\":\"function_call\",\"call_id\":\"call_x\",\"name\":\"bash\",\"arguments\":\"{\\\"command\\\":\\\"echo hi\\\"}\"}") {
            ty_fail(tag, "function_call item 形状不对（call_id 要取 '|' 前那段，arguments 不能二次转义）", &ok);
        }
        if !contains(&req, "{\"type\":\"function_call_output\",\"call_id\":\"call_x\",\"output\":\"hi\\n\"}") {
            ty_fail(tag, "function_call_output item 形状不对", &ok);
        }
        if !contains(&req, "\"store\":false") {
            ty_fail(tag, "默认应当发 store:false", &ok);
        }
        if !contains(&req, "\"max_output_tokens\":16") {
            ty_fail(tag, "max_tokens=8 应当被抬到 16（OpenAI 拒绝 <16）", &ok);
        }
        if !contains(&req, "\"reasoning\":{\"effort\":\"max\"}") {
            ty_fail(tag, "reasoning.effort 没发", &ok);
        }
        if contains(&req, "\"temperature\"") {
            ty_fail(tag, "没给 temperature 就不该发", &ok);
        }
        if !contains(&req, "\"tools\":[{\"type\":\"function\",\"name\":\"read\"") {
            ty_fail(tag, "tools 应当是扁平形状", &ok);
        }
        if contains(&req, "\"function\":{\"name\"") {
            ty_fail(tag, "tools 里不该出现 chat 的嵌套形状", &ok);
        }
    }

    // 3) 开关：developer→system / store 不发 / effort=off 不发 / temperature 发
    cfg.api_dev_role = false;
    cfg.api_store = false;
    cfg.api_reasoning = true;
    buf_reset(&cfg.reasoning_effort);
    _ = buf_append_cstr(&cfg.reasoning_effort, "off");
    cfg.temperature = 0;
    if !build_model_request(&cfg, &h, &req, LLM_STYLE_RESPONSES) {
        ty_fail(tag, "开关轮组装失败", &ok);
    } else {
        if !contains(&req, "\"input\":[{\"role\":\"system\"") {
            ty_fail(tag, "supportsDeveloperRole=false 时应当用 system", &ok);
        }
        if contains(&req, "\"store\"") {
            ty_fail(tag, "supportsStore=false 时不该发 store", &ok);
        }
        if contains(&req, "\"reasoning\"") {
            ty_fail(tag, "effort=off 时不该发 reasoning", &ok);
        }
        if !contains(&req, "\"temperature\":0") {
            ty_fail(tag, "temperature=0 应当发出去", &ok);
        }
    }

    // 4) 端点拼接（含 base 末尾斜杠两种写法）
    var u: Buf = buf_new(128);
    defer { buf_free(&u); }
    var c2: Config = cfg_default();
    defer { cfg_free(&c2); }
    c2.base_url = buf_new(32);
    _ = buf_append_cstr(&c2.base_url, "https://h/v1");
    if !api_url_into(&c2, LLM_STYLE_RESPONSES, &u) || !sse_buf_eq(&u, "https://h/v1/responses") {
        ty_fail(tag, "responses 端点拼接不对", &ok);
    }
    buf_reset(&c2.base_url);
    _ = buf_append_cstr(&c2.base_url, "https://h/v1/");
    if !api_url_into(&c2, LLM_STYLE_CHAT, &u) || !sse_buf_eq(&u, "https://h/v1/chat/completions") {
        ty_fail(tag, "chat 端点拼接（base 带斜杠）不对", &ok);
    }

    if ok {
        out_err("ok\n");
    }
    return ok;
}

// 协商：默认 responses + 只有「端点不存在」才回退，且每进程只回退一次
fn api_negotiate_round(tag: &const byte) bool {
    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    agent_api_reset_negotiation();

    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    if agent_api_style_now(&cfg) != LLM_STYLE_RESPONSES {
        ty_fail(tag, "未声明时默认应当是 responses", &ok);
    }
    if !api_may_negotiate(&cfg, LLM_STYLE_RESPONSES, 404) || !api_may_negotiate(&cfg, LLM_STYLE_RESPONSES, 405)
        || !api_may_negotiate(&cfg, LLM_STYLE_RESPONSES, 501) {
        ty_fail(tag, "404/405/501 应当允许协商", &ok);
    }
    if api_may_negotiate(&cfg, LLM_STYLE_RESPONSES, 200) || api_may_negotiate(&cfg, LLM_STYLE_RESPONSES, 400)
        || api_may_negotiate(&cfg, LLM_STYLE_RESPONSES, 401) || api_may_negotiate(&cfg, LLM_STYLE_RESPONSES, 500) {
        ty_fail(tag, "只有端点不存在才允许协商（200/400/401/500 不行）", &ok);
    }
    if !api_negotiate(&cfg, LLM_STYLE_RESPONSES, 404) {
        ty_fail(tag, "api_negotiate(404) 应当成立", &ok);
    }
    if agent_api_style_now(&cfg) != LLM_STYLE_CHAT {
        ty_fail(tag, "协商后应当改成 chat", &ok);
    }
    if api_negotiate(&cfg, LLM_STYLE_RESPONSES, 404) || api_may_negotiate(&cfg, LLM_STYLE_RESPONSES, 404) {
        ty_fail(tag, "每进程只允许协商一次", &ok);
    }

    // 声明过就完全不协商
    agent_api_reset_negotiation();
    var c2: Config = cfg_default();
    defer { cfg_free(&c2); }
    cfg_pin_api(&c2, LLM_STYLE_CHAT);
    if api_may_negotiate(&c2, LLM_STYLE_CHAT, 404) || api_may_negotiate(&c2, LLM_STYLE_RESPONSES, 404) {
        ty_fail(tag, "显式声明后不该协商", &ok);
    }
    if agent_api_style_now(&c2) != LLM_STYLE_CHAT {
        ty_fail(tag, "声明 chat 就得用 chat", &ok);
    }
    var c3: Config = cfg_default();
    defer { cfg_free(&c3); }
    cfg_pin_api(&c3, LLM_STYLE_RESPONSES);
    if agent_api_style_now(&c3) != LLM_STYLE_RESPONSES || api_may_negotiate(&c3, LLM_STYLE_RESPONSES, 404) {
        ty_fail(tag, "声明 responses 就得用 responses 且不协商", &ok);
    }
    // DSH 设置里的 api: 必须真的落到 Config 上（Buf 不带结尾 NUL，长度要显式传）
    var dshc: DshCfg = dsh_cfg_empty();
    defer { dsh_cfg_free(&dshc); }
    dshc.ok = false;      // ok=false 时 agent_apply_dsh 直接返回：先只测「有 api 的解析」
    dshc.ok = true;
    _ = buf_append_cstr(&dshc.api_style, "openai-responses");
    dshc.compat_dev_role = -1;
    dshc.compat_store = -1;
    dshc.compat_reasoning = -1;
    var c4: Config = cfg_default();
    defer { cfg_free(&c4); }
    agent_apply_dsh(&c4, &dshc);
    if c4.src_api != 1 || c4.api_style != LLM_STYLE_RESPONSES {
        ty_fail(tag, "DSH 的 api: openai-responses 没落到 cfg（src_api/api_style）", &ok);
    }
    var dshc2: DshCfg = dsh_cfg_empty();
    defer { dsh_cfg_free(&dshc2); }
    dshc2.ok = true;
    _ = buf_append_cstr(&dshc2.api_style, "openai-completions");
    var c5: Config = cfg_default();
    defer { cfg_free(&c5); }
    agent_apply_dsh(&c5, &dshc2);
    if c5.src_api != 1 || c5.api_style != LLM_STYLE_CHAT {
        ty_fail(tag, "DSH 的 api: openai-completions 没落到 cfg", &ok);
    }
    var dshc3: DshCfg = dsh_cfg_empty();
    defer { dsh_cfg_free(&dshc3); }
    dshc3.ok = true;
    _ = buf_append_cstr(&dshc3.api_style, "anthropic");
    var c6: Config = cfg_default();
    defer { cfg_free(&c6); }
    agent_apply_dsh(&c6, &dshc3);
    if c6.src_api != API_SRC_DEFAULT || c6.api_style != LLM_STYLE_RESPONSES {
        ty_fail(tag, "不认得的 api: 应当按「未声明」处理（仍先试 responses）", &ok);
    }

    agent_api_reset_negotiation();
    if ok {
        out_err("ok\n");
    }
    return ok;
}

fn think_round(tag: &const byte) bool {
    var ok: bool = true;
    var out: Buf = buf_new(4096);
    defer { buf_free(&out); }
    var cap: Buf = buf_new(4096);
    defer { buf_free(&cap); }
    var ev: Buf = buf_new(1024);
    defer { buf_free(&ev); }
    var cap_path: [byte: 64] = "build/selftest_think_stderr.txt";
    const cap_p: &const byte = &cap_path[0] as &const byte;

    var two: Buf = vw_mk("第一行思考\n第二行思考");
    const two_v: &const byte = two.ptr as &const byte;

    // ---- A) 结算（settled）取第一行 ----
    view_think_line(&out, two_v, two.len, 60, false);
    if !ty_buf_is(&out, "✻ 思考 · 第一行思考") {
        ty_fail(tag, "settled 行应该取第一行", &ok);
        out_err("[line] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- B) 运行中（running）取最后一行 ----
    view_think_line(&out, two_v, two.len, 60, true);
    if !ty_buf_is(&out, "✻ 思考 · 第二行思考") {
        ty_fail(tag, "running 行应该取最后一行", &ok);
        out_err("[line] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }

    // ---- C) 尾部空白要先去干净 ----
    var trail: Buf = vw_mk("abc\n   ");
    view_think_line(&out, trail.ptr as &const byte, trail.len, 60, true);
    if !ty_buf_is(&out, "✻ 思考 · abc") {
        ty_fail(tag, "running 行取最后一行时应先去掉尾部空白", &ok);
    }
    buf_free(&trail);

    // ---- D) running 太长 → 从左边截断、前面补 '…'（屏幕上留最新的一段）----
    var long40: Buf = vw_mk("0123456789012345678901234567890123456789");
    const long_v: &const byte = long40.ptr as &const byte;
    // 宽 30 → 摘要预算 30-9 = 21 列，扣掉 '…' 剩 20 列 → 保留最后 20 个字符
    view_think_line(&out, long_v, long40.len, 30, true);
    if !ty_buf_is(&out, "✻ 思考 · …01234567890123456789") {
        ty_fail(tag, "running 行应按列从左边截断", &ok);
        out_err("[line] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    // settled 同宽度 → 从右边截断、后面补 '…'
    view_think_line(&out, long_v, long40.len, 20, false);
    if !ty_buf_is(&out, "✻ 思考 · 0123456789…") {
        ty_fail(tag, "settled 行应按列从右边截断", &ok);
        out_err("[line] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    buf_free(&long40);

    // ---- E) 宽字符不许砍半个：5 列正好是 '文'（2 列）+ 'abc'（3 列）----
    var cjk: Buf = vw_mk("中文abc");
    const cjk_v: &const byte = cjk.ptr as &const byte;
    view_think_line(&out, cjk_v, cjk.len, 15, true);
    if !ty_buf_is(&out, "✻ 思考 · …文abc") {
        ty_fail(tag, "尾部截断应按显示列（宽字符 2 列、不砍半个）", &ok);
        out_err("[line] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n");
    }
    view_think_line(&out, cjk_v, cjk.len, 14, true);
    if !ty_buf_is(&out, "✻ 思考 · …abc") {
        ty_fail(tag, "4 列装不下 '文' 时应该只留 'abc'", &ok);
    }
    buf_free(&cjk);

    // ---- F) 全空白 / 窄到放不下前缀 → 什么都不出 ----
    var blank: Buf = vw_mk("\n\n   \n");
    view_think_line(&out, blank.ptr as &const byte, blank.len, 60, true);
    if out.len != 0 {
        ty_fail(tag, "全空白的思考不该出行", &ok);
    }
    view_think_line(&out, blank.ptr as &const byte, blank.len, 60, false);
    if out.len != 0 {
        ty_fail(tag, "全空白的思考不该出行（settled）", &ok);
    }
    view_think_line(&out, two_v, two.len, 10, false);
    if out.len != 0 {
        ty_fail(tag, "窄到放不下前缀时不该出行", &ok);
    }
    buf_free(&blank);

    // ---- G) settled 行落进 fd 2：与纯函数完全一致 + 一个换行 ----
    view_init(true, 0);
    diffx_init(false, 0);
    view_think_delta(two_v, two.len);      // 非交互：只记状态，不写任何字节
    var cfd: i32 = -1;
    const saved: i32 = vw_cap_on(cap_p, &cfd);
    view_think_end(two_v, two.len);
    vw_cap_off(cap_p, saved, cfd, &cap);
    view_think_line(&out, two_v, two.len, tty_body_width(), false);
    if cap.len != out.len + 1 {
        ty_fail(tag, "settled 思考行写到 fd 2 的字节数不对", &ok);
        out_err("[captured] ");
        out_err_bytes(cap.ptr as &const byte, cap.len);
        out_err("\n");
    } else if !bufx_mem_eq(cap.ptr as &const byte, out.ptr as &const byte, out.len) || cap.ptr[cap.len - 1] != 10 as byte {
        ty_fail(tag, "settled 思考行写到 fd 2 的内容不对", &ok);
        out_err("[want] ");
        out_err_bytes(out.ptr as &const byte, out.len);
        out_err("\n[got] ");
        out_err_bytes(cap.ptr as &const byte, cap.len);
        out_err("\n");
    }

    // ---- H) 幂等：块已经结算过，再调一次不该再写字节 ----
    cfd = -1;
    const saved2: i32 = vw_cap_on(cap_p, &cfd);
    view_think_end(two_v, two.len);
    vw_cap_off(cap_p, saved2, cfd, &cap);
    if cap.len != 0 {
        ty_fail(tag, "view_think_end 应该幂等（第二次不写字节）", &ok);
    }

    // ---- I) 关闭态（--quiet）：delta / end 都不许写字节 ----
    view_init(false, 0);
    view_think_delta(two_v, two.len);
    cfd = -1;
    const saved3: i32 = vw_cap_on(cap_p, &cfd);
    view_think_end(two_v, two.len);
    vw_cap_off(cap_p, saved3, cfd, &cap);
    if cap.len != 0 {
        ty_fail(tag, "--quiet 时思考行不该往 fd 2 写任何字节", &ok);
    }
    view_init(false, 0);

    // ---- J) 日志事件 JSON（纯函数，逐字节）----
    if !agent_reasoning_event_json(&ev, 2, 7, "想\n法", 7) {
        ty_fail(tag, "reasoning 事件 JSON 构造失败", &ok);
    } else if !ty_buf_is(&ev, "{\"turn\":2,\"step\":7,\"message\":{\"role\":\"assistant\",\"reasoning_content\":\"想\\n法\"}}") {
        ty_fail(tag, "reasoning 事件 JSON 不对", &ok);
        out_err("[json] ");
        out_err_bytes(ev.ptr as &const byte, ev.len);
        out_err("\n");
    }

    // ---- K) 静音窗口里显示层也要看得见 ----
    // tls_noise_mute 期间 fd 2 指向 /dev/null（lib/tls 的握手噪声），P16 的思考行/工具行
    // 正好是在这个窗口里写的：显示层必须走 err_fd()（stderr 原件），否则整段输出凭空消失
    // —— 这正是 P14 的「✻ 思考」表头从来没出现过的原因。
    view_init(true, 0);
    cfd = -1;
    const saved4: i32 = vw_cap_on(cap_p, &cfd);      // fd 2 → 文件
    var g: FdGuard = FdGuard{ saved: -1, nullfd: -1, active: false };
    tls_noise_mute(&g, true);
    const fd_in: i32 = err_fd();
    if fd_in == 2 {
        ty_fail(tag, "静音窗口里 err_fd() 不该还是 2（那写进去就是 /dev/null）", &ok);
    }
    view_think_delta(two_v, two.len);
    view_think_end(two_v, two.len);
    tls_noise_unmute(&g);
    if err_fd() != 2 {
        ty_fail(tag, "静音窗口结束后 err_fd() 必须换回 2", &ok);
    }
    vw_cap_off(cap_p, saved4, cfd, &cap);
    view_think_line(&out, two_v, two.len, tty_body_width(), false);
    if cap.len != out.len + 1 || !bufx_mem_eq(cap.ptr as &const byte, out.ptr as &const byte, out.len) {
        ty_fail(tag, "静音窗口里的思考行没有落到看得见的 stderr 上", &ok);
        out_err("[captured] ");
        out_err_bytes(cap.ptr as &const byte, cap.len);
        out_err("\n");
    }
    view_init(false, 0);

    buf_free(&two);
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

// P16：显示层只留一行，思考全文只在会话日志里活着 —— 这条守着「不许丢」。
// mock 的最终回包带 MOCK_REASONING，跑完一轮之后回读会话日志找 assistant/reasoning。
fn reasoning_log_round(tag: &const byte, home: &const byte, ws: &const byte) bool {
    var ok: bool = true;
    var path: Buf = buf_new(1200);
    defer { buf_free(&path); }
    if !sess_find_last(home, ws, &path) {
        ty_fail(tag, "找不到刚跑完的会话（日志没落盘？）", &ok);
        return false;
    }
    // sess_reader_load 把路径当 C 字符串交给 sys_open（README 坑 2）：
    // Buf 不带 NUL，必须自己补一个（长度照旧不带它）。
    if !buf_append_byte(&path, 0) {
        ty_fail(tag, "路径缓冲不够补 NUL", &ok);
        return false;
    }
    path.len = path.len - 1;
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    if !sess_reader_load(path.ptr as &const byte, &r) {
        ty_fail(tag, "会话日志读不出来", &ok);
        out_err("[path] ");
        out_err_bytes(path.ptr as &const byte, path.len);
        out_err("\n");
        return false;
    }
    var line: Buf = buf_new(65536);
    defer { buf_free(&line); }
    var txt: Buf = buf_new(65536);
    defer { buf_free(&txt); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var seen: usize = 0;
    var found: bool = false;
    while sess_next(&r, &line) {
        buf_reset(&typ);
        if !sess_line_type(&line, &typ) {
            continue;
        }
        if !sv_eq_cstr(&typ, "assistant/reasoning") {
            continue;
        }
        seen = seen + 1;
        buf_reset(&txt);
        if sess_json_str(line.ptr[0: line.len], "reasoning_content", &txt) && bufx_eq_cstr(txt.ptr as &const byte, txt.len, MOCK_REASONING) {
            found = true;
            // turn/step 必须真的写进去了（缺字段时 sess_json_i64 返回 0）
            if sess_json_i64(line.ptr[0: line.len], "turn") < 1 || sess_json_i64(line.ptr[0: line.len], "step") < 1 {
                ty_fail(tag, "reasoning 事件缺少 turn/step", &ok);
            }
        }
    }
    if seen == 0 {
        ty_fail(tag, "会话日志里一条 assistant/reasoning 都没有", &ok);
    } else if !found {
        ty_fail(tag, "会话日志里的思考全文与 mock 不一致", &ok);
        out_err("[got] ");
        out_err_bytes(txt.ptr as &const byte, txt.len);
        out_err("\n");
    }
    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok\n");
    }
    return ok;
}

export fn selftest_main(base: &const Config) i32 {
    _ = base;
    // 调试入口：只跑 TUI 轮（改动 TUI 时不必等整轮 selftest）
    if env_present("UYA_SELFTEST_TUI_ONLY" as &const byte) {
        if tui_selftest_all() {
            out_err("SELFTEST TUI PASS\n");
            return AGENT_OK;
        }
        out_err("SELFTEST TUI FAIL\n");
        return AGENT_PROTO;
    }
    out_err("selftest: offline end-to-end (mock LLM on 127.0.0.1, no network, no API key)\n");
    const r1: bool = selftest_round(base, "shell", 0, true, "build/selftest_ws_shell", true, false, false, false);
    // P16：就着刚跑完的这一轮，回读会话日志确认思考全文落盘（显示层只留一行，全文只在日志里）
    const r1r: bool = reasoning_log_round("reasoning-log", "build/selftest_agent_home", "build/selftest_ws_shell");
    const r2: bool = selftest_round(base, "no-shell", 1, false, "build/selftest_ws_noshell", true, false, false, false);
    const r3: bool = selftest_round(base, "tools", 2, true, "build/selftest_ws_tools", true, false, false, false);
    const r4: bool = selftest_round(base, "http401", 3, true, "build/selftest_ws_401", true, false, false, false);
    const r5: bool = selftest_round(base, "max-steps", 5, true, "build/selftest_ws_steps", true, false, false, false);
    // 默认不限步数：mock 连给 14 轮 tool_calls（超过旧默认 12）才给最终答案，
    // agent 必须一路跑到最终答案并以 0 退出（这轮不设 max_steps，吃的就是默认值）
    const r5b: bool = selftest_round(base, "unlimited-steps", 17, true, "build/selftest_ws_unlimited", true, false, false, false);
    // 非流式回归：--no-stream 走旧路径，同一份 mock 数据（JSON 回包）
    const r6: bool = selftest_round(base, "noshell-nostream", 1, false, "build/selftest_ws_nostream", false, false, false, false);
    // 折叠协议回归：--compat-fold
    const r7: bool = selftest_round(base, "shell-fold", 0, true, "build/selftest_ws_fold", true, true, false, false);
    // P3：运行中用户输入（steer）在下一个 step 被采纳
    const r8: bool = selftest_round(base, "steer", 0, true, "build/selftest_ws_steer", true, false, true, false);
    // P3：Ctrl-C 中断当前回合（不该派发工具、不该有下一轮请求）
    const r9: bool = selftest_round(base, "interrupt", 6, true, "build/selftest_ws_intr", true, false, false, true);
    const s0: bool = sse_round(SSE_CASE_BASIC, "stream-basic");
    const s1: bool = sse_round(SSE_CASE_TOOLS, "stream-tools");
    const s2: bool = sse_round(SSE_CASE_NODONE, "stream-nodone");
    const s3: bool = sse_round(SSE_CASE_BADJSON, "stream-badjson");
    const s4: bool = sse_round(SSE_CASE_REASONING_LENGTH, "stream-length");
    const t0: bool = tty_round("tty-editor");
    const t1: bool = sess_round("session-log");
    const t2: bool = dshcfg_round("dsh-config");
    const t3: bool = fs_round(base, "fs-tools", "build/selftest_ws_fs");
    const t4: bool = jobs_round(base, "bash-jobs", "build/selftest_ws_jobs");
    const t5: bool = prompt_round(base, "prompt-todo-plan", "build/selftest_ws_prompt");
    const t6: bool = round_run(base, "compact-prune", "build/selftest_ws_prune", 11, 0 as i64, "产生大输出");
    const t7: bool = round_run(base, "compact-auto", "build/selftest_ws_compact", 12, 200 as i64, "触发自动压缩");
    // 长历史回归：40 轮 × 2 个工具调用（≈124 条消息）必须全程不丢消息、配对完整
    const t10: bool = round_run_opts(
        base,
        "history-long",
        "build/selftest_ws_histcap",
        18,
        0 as i64,
        HISTCAP_ROUNDS + 5,
        "长历史：连跑 40 轮工具调用，一条消息都不许丢"
    );
    // 尾部修复语义：只丢不完整的一组，完整的一组必须保留
    const t11: bool = hist_round("hist-repair");
    const t8: bool = skill_round(base, "skills-web-search", "build/selftest_ws_skill", "build/selftest_skills");
    const t9: bool = deleg_round(base, "subagent-goal", "build/selftest_ws_deleg");
    const u0: bool = wf_round(base, "workflow", "build/selftest_wf_ws");
    const u1: bool = knobs_round("preset-knobs-dshsess");
    const u2: bool = hist_keep_round("hist-keep");
    // 步数默认值：0 = 不限步数。这条断言是「默认值」这件事的唯一单点保证 ——
    // 谁把默认值改回 12，unlimited-steps 轮与这里会同时红。
    var cdef: Config = cfg_default();
    var u3: bool = true;
    if cdef.max_steps != 0 {
        out_err("selftest[default-max-steps] FAIL: cfg_default().max_steps != 0（默认必须是不限步数）\n");
        u3 = false;
    }
    // 默认协议：responses + 未声明（= 允许一次性协商回退 chat）。谁把它改回 chat，这条会红。
    if cdef.api_style != LLM_STYLE_RESPONSES || cdef.src_api != API_SRC_DEFAULT {
        out_err("selftest[default-api] FAIL: 默认必须是 responses + 可协商（src_api=0）\n");
        u3 = false;
    }
    if !cdef.api_store || !cdef.api_dev_role || !cdef.api_reasoning {
        out_err("selftest[default-api] FAIL: responses 的三个 compat 默认值应当是 true\n");
        u3 = false;
    }
    cfg_free(&cdef);
    const v0: bool = diffx_round("diff-render");
    const v1: bool = view_round("tool-view");
    const v7: bool = win_round("subagent-panel");
    const v5: bool = think_round("think-row");
    // P16：工具正文默认关闭（只留一行）—— 和 max_steps 那条一样，是「默认值」的单点保证：
    // 谁把默认值改回 6，view_round 的 A/D/E 与这里会同时红。
    var cdef2: Config = cfg_default();
    var v6: bool = true;
    if cdef2.tool_lines != 0 {
        out_err("selftest[default-tool-lines] FAIL: cfg_default().tool_lines != 0（默认必须只留一行）\n");
        v6 = false;
    }
    cfg_free(&cdef2);
    // P15：请求体转义（NUL 等控制字节）—— 纯函数轮 + 端到端轮（工具结果里真的带 NUL），
    // 端到端那条 chat 与 responses 各跑一遍（两条协议的请求体都必须合法）。
    const v2: bool = jsonesc_round("json-escape");
    mock_expect_resp = false;
    const v3: bool = round_run_api(base, "ctrl-bytes", "build/selftest_ws_ctrl", 23, 0 as i64, 4, LLM_STYLE_CHAT, false, "跑一条输出含 NUL 的命令");
    mock_expect_resp = true;
    const v4: bool = round_run_api(base, "ctrl-bytes-resp", "build/selftest_ws_ctrl_resp", 23, 0 as i64, 4, LLM_STYLE_RESPONSES, false, "跑一条输出含 NUL 的命令");
    mock_expect_resp = false;
    // Responses 接口：解析器轮（事件表逐项）+ 非流式 + 请求体 + 协商
    const x0: bool = resp_round(RESP_CASE_TEXT, "resp-text");
    const x1: bool = resp_round(RESP_CASE_TOOLS, "resp-tools");
    const x2: bool = resp_round(RESP_CASE_ARGS_DONE, "resp-args-done");
    const x3: bool = resp_round(RESP_CASE_TERMINAL_ONLY, "resp-terminal-only");
    const x4: bool = resp_round(RESP_CASE_INCOMPLETE, "resp-incomplete");
    const x5: bool = resp_round(RESP_CASE_FAILED, "resp-failed");
    const x6: bool = resp_round(RESP_CASE_NOTERMINAL, "resp-noterminal");
    const x7: bool = resp_round(RESP_CASE_DONEFRAME, "resp-doneframe");
    const x8: bool = resp_round(RESP_CASE_CHATSHAPE, "resp-chatshape");
    const x9: bool = resp_round(RESP_CASE_BADJSON, "resp-badjson");
    const x10: bool = resp_nonstream_round("resp-nonstream");
    const x11: bool = resp_build_round("resp-build");
    const x12: bool = api_negotiate_round("api-negotiate");
    const x13: bool = round_run_api(base, "responses", "build/selftest_ws_resp", 19, 0 as i64, 4, LLM_STYLE_RESPONSES, false, "用 bash 跑 echo RESPONSES-TOOL-OK 并只回答这一行");
    const x14: bool = round_run_api(base, "responses-nostream", "build/selftest_ws_resp_ns", 20, 0 as i64, 4, LLM_STYLE_RESPONSES, false, "用 bash 跑 echo RESPONSES-TOOL-OK 并只回答这一行");
    const x15: bool = round_run_api(base, "responses-fallback", "build/selftest_ws_resp_fb", 21, 0 as i64, 4, LLM_STYLE_RESPONSES, true, "用 bash 跑 echo RESPONSES-FALLBACK-OK 并只回答这一行");
    // responses 下的自动压缩（摘要请求 + 压缩后的请求都得走 /v1/responses）
    const x16: bool = round_run_api(base, "responses-compact", "build/selftest_ws_resp_ck", 22, 200 as i64, 4, LLM_STYLE_RESPONSES, false, "触发自动压缩");
    // P18：诊断出口 —— 外来字节（回显型网关的 400 错误体）不许以原文进转录；
    // 完整原文（转义后）落会话日志 diag/dump，原始字节走 --debug-dump。
    const z0: bool = diag_round("diag-preview");
    const z1: bool = selftest_round(base, "diag-echo-400", 24, true, "build/selftest_ws_diag", true, false, false, false);
    // 非流式路径走的是另一个出口（dump_http_error，本来会打 4096 B 原文）
    const z2: bool = selftest_round(base, "diag-echo-400-ns", 24, true, "build/selftest_ws_diag_ns", false, false, false, false);
    // P0/P1：信号层（src/sigx.uya）—— glibc 布局、处理器真的被调用、SIGTERM 先恢复终端、
    // fork 子进程重置处置；轮次实现都在 src/sigselftest.uya 里
    const y0: bool = sigx_selftest_all();
    // P17：全屏 TUI（排版 / 按键 / 显示收口 / headless 端到端 / 真 PTY）
    const y1: bool = tui_selftest_all();
    if r1 && r2 && r3 && r4 && r5 && r5b && r6 && r7 && r8 && r9 && s0 && s1 && s2 && s3 && s4 && t0 && t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && u0 && u1 && u2 && u3 && v0 && v1 && v2 && v3 && v4 && v5 && v6 && v7 && r1r && y0 && y1
        && x0 && x1 && x2 && x3 && x4 && x5 && x6 && x7 && x8 && x9 && x10 && x11 && x12 && x13 && x14 && x15 && x16 && z0 && z1 && z2 {
        out_err("SELFTEST PASS\n");
        return AGENT_OK;
    }
    out_err("SELFTEST FAIL\n");
    return AGENT_PROTO;
}
