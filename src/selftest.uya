    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append_cstr(&c.task, "用一下技能和联网搜索");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.max_steps = 4;
    c.timeout_ms = 20000;
    c.quiet = true;
    c.quiet = false;
    c.skill_dirs = buf_new(strlen(skillroot) + 8);
    _ = buf_append_cstr(&c.skill_dirs, skillroot);
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_agent_home");
    g_skills.scanned = false;   // 让本轮重新扫描（带上 --skill-dir）
    const rc: i32 = agent_run(&c);
    cfg_free(&c);
    buf_free(&web_base_override);
    buf_free(&web_key_override);
    web_base_override = buf_empty();
    web_key_override = buf_empty();
    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if rc != AGENT_OK {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

// 派生轮（子代理 + goal 工具）
fn deleg_round(base: &const Config, tag: &const byte, ws: &const byte) bool {
    mock_mode = 14;
    mock_expect_shell = true;
    mock_expect_fold = false;
    mock_expect_steer = false;
    if !ws_prepare(ws) {
        out_err("selftest: cannot prepare workspace\n");
        return false;
    }
    _ = sess_mkdir_p("build/selftest_deleg_home");
    // 清掉上一轮的 goal.json，保证 id/revision 从 1 开始
    var gp: Buf = buf_new(256);
    defer { buf_free(&gp); }
    _ = buf_append_cstr(&gp, "build/selftest_deleg_home/goal.json");
    _ = buf_append_byte(&gp, 0);
    _ = sys_unlink(&gp.ptr[0] as *const byte) catch {};
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var c: Config = cfg_default();
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&c.base_url, port as u64);
    _ = buf_append_cstr(&c.base_url, "/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(strlen(ws) + 8);
    _ = buf_append_cstr(&c.workspace, ws);
    c.task = buf_new(64);
    _ = buf_append_cstr(&c.task, "DELEGPARENT-TASK 派个子代理，顺便记个目标");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.max_steps = 4;
    c.timeout_ms = 30000;
    c.quiet = true;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_deleg_home");
    const rc: i32 = agent_run(&c);
    cfg_free(&c);
    const mock_rc: i32 = wait_child(pid);

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if rc != AGENT_OK {
        out_err("FAIL: agent_run returned ");
        out_err_dec(rc as usize);
        ok = false;
    } else if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    } else {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

// ============================================================
// P12：workflow 轮
//
// 两个变体：
//   A) 脚本用 /bin/sh 写的「假 runner」（说话的就是钩子协议），验证协议本身；
//   B) 真的用 `uya run` 跑一个 Uya 的 .ush 脚本，验证主路径。
// 钩子里的 agent_start/agent_wait 会派生子代理 → 由 mock LLM 服务。
// ============================================================
fn wf_make_args(out: &Buf, script: &const byte, name: &const byte) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "{\"script\":") {
        return false;
    }
    if !jw_str_into(out, script, bufx_cstr_len(script)) {
        return false;
    }
    if !buf_append_cstr(out, ",\"meta\":{\"name\":") {
        return false;
    }
    if !jw_str_into(out, name, bufx_cstr_len(name)) {
        return false;
    }
    return buf_append_cstr(out, ",\"description\":\"两阶段审计\"},\"args\":{\"files\":[\"a.uya\",\"b.uya\"]}}");
}

fn wf_parse_args(text: &const Buf, out: &JsonValue) bool {
    var raw: &void = malloc(65536);
    if ((raw as &byte) as usize) == 0 {
        return false;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 65536);
    if !js_parse(&arena, text.ptr, text.len, out) {
        return false;
    }
    return true;
}

// 写一个「假 runner」：接受 `run <script>` 的参数形态，直接执行脚本
fn wf_write_stub_runner(path: &const byte) bool {
    const body: &const byte = "#!/bin/sh\n# uya-agent workflow 的测试替身：忽略 run 子命令，直接跑脚本\nshift\nexec /bin/sh \"$1\"\n";
    return write_text_file(path, body);
}

// A) 假 runner + /bin/sh 脚本（用 /dev/tcp 说钩子协议）
fn wf_variant_stub(cfg: &const Config, tag: &const byte, out: &Buf) bool {
    var runner: Buf = buf_new(256);
    defer { buf_free(&runner); }
    _ = buf_append_cstr(&runner, "testdata/wf_runner.sh");
    _ = buf_append_byte(&runner, 0);
    var okflag: bool = false;
    if !wf_write_stub_runner(runner.ptr as &const byte) {
        ty_fail(tag, "写假 runner 失败", &okflag);
        return false;
    }
    var c: Config = cfg_default();
    c.base_url = buf_new(cfg.base_url.len + 8);
    _ = buf_append(&c.base_url, cfg.base_url.ptr, cfg.base_url.len);
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(64);
    _ = buf_append_cstr(&c.workspace, "build/selftest_wf_ws");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = true;
    c.stream = true;
    c.timeout_ms = 30000;
    c.quiet = true;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_wf_home");
    c.max_steps = 3;
    c.quiet = true;
    c.uya_bin = buf_new(64);
    _ = buf_append_cstr(&c.uya_bin, "/bin/bash");   // 直接解释器模式：<bin> <script>
    // 假脚本从磁盘读（内嵌 shell 会被 Uya 字符串转义搞死；testdata/ 里是真实文件）
    var stub: Buf = buf_new(8192);
    defer { buf_free(&stub); }
    if !fs_read_file_all("testdata/wf_stub.sh" as &const byte, &stub, 65536) {
        ty_fail(tag, "读不到 testdata/wf_stub.sh", &okflag);
        return false;
    }
    if !sess_has_cstr(stub.ptr[0: stub.len], "dev/tcp") {
        ty_fail(tag, "testdata/wf_stub.sh 内容不对（缺少 dev/tcp）", &okflag);
        return false;
    }
    _ = buf_append_byte(&stub, 0);
    const script: &const byte = stub.ptr as &const byte;
    var args: Buf = buf_new(8192);
    defer { buf_free(&args); }
    var badflag: bool = false;
    if !wf_make_args(&args, script, "stub-audit") {
        ty_fail(tag, "组参失败", &badflag);
        return false;
    }
    var jv: JsonValue = JsonValue.json_null();
    if !wf_parse_args(&args, &jv) {
        ty_fail(tag, "参数不是合法 JSON", &badflag);
        return false;
    }
    buf_reset(out);
    wf_tool_workflow(&c, &jv, out);
    var ok: bool = true;
    if !contains(out, "WF-AGENT-OK") {
        ty_fail(tag, "子代理结果没有回到 workflow 结果里", &ok);
    }
    if !contains(out, "phases: phase audit files") && !contains(out, "audit files") {
        ty_fail(tag, "阶段没有记录", &ok);
    }
    if !contains(out, "agents started: 1") {
        ty_fail(tag, "子代理计数不对", &ok);
    }
    if !contains(out, "审计完成：WF-AGENT-OK") {
        ty_fail(tag, "wf_done 的结果没收到", &ok);
    }
    cfg_free(&c);
    return ok;
}

// B) 真 `uya run` + Uya 的 .ush 脚本
fn wf_variant_real(cfg: &const Config, tag: &const byte, out: &Buf) bool {
    const uya_bin: &byte = getenv("UYA_BIN");
    var binpath: Buf = buf_new(256);
    defer { buf_free(&binpath); }
    if (uya_bin as usize) != 0 && bufx_cstr_len(uya_bin) > 0 {
        _ = buf_append_cstr(&binpath, uya_bin);
    } else {
        _ = buf_append_cstr(&binpath, "/home/winger/uya-0.10/bin/uya");
    }
    // 交给系统调用前补 NUL（这个坑第 N 次了）
    _ = buf_append_byte(&binpath, 0);
    if !sess_file_exists(binpath.ptr as &const byte) {
        // 没装 uya 就跳过（离线自测不因此失败）
        return true;
    }
    var c: Config = cfg_default();
    c.base_url = buf_new(64);
    _ = buf_append_cstr(&c.base_url, "http://127.0.0.1:1/v1");
    c.model = buf_new(32);
    _ = buf_append_cstr(&c.model, "selftest-model");
    c.api_key = buf_new(32);
    _ = buf_append_cstr(&c.api_key, "selftest-key");
    c.workspace = buf_new(64);
    _ = buf_append_cstr(&c.workspace, "build/selftest_wf_ws");
    c.verify = HC_VERIFY_NONE;
    c.allow_shell = false;
    c.timeout_ms = 60000;
    c.quiet = true;
    c.agent_home = buf_new(64);
    _ = buf_append_cstr(&c.agent_home, "build/selftest_wf_home");
    c.uya_bin = buf_new(binpath.len + 8);
    _ = buf_append(&c.uya_bin, binpath.ptr, binpath.len);
    // 脚本只用 phase/log/done（不派生子代理 → 不需要模型）
    const script: &const byte = "use hooks;\n\nexport fn main() i32 {\n    wf_phase(\"compile\");\n    wf_log(\"编译完成\");\n    wf_phase(\"verify\");\n    wf_done(\"uya run 变体完成\");\n    return 0;\n}\n";
    var args: Buf = buf_new(8192);
    defer { buf_free(&args); }
    var badflag2: bool = false;
    if !wf_make_args(&args, script, "real-ush") {
        ty_fail(tag, "组参失败", &badflag2);
        return false;
    }
    var jv: JsonValue = JsonValue.json_null();
    if !wf_parse_args(&args, &jv) {
        ty_fail(tag, "参数不是合法 JSON", &badflag2);
        return false;
    }
    buf_reset(out);
    wf_tool_workflow(&c, &jv, out);
    var ok: bool = true;
    if !contains(out, "uya run 变体完成") {
        ty_fail(tag, "真 uya run 的 wf_done 结果没收到", &ok);
    }
    if !contains(out, "compile") || !contains(out, "verify") {
        ty_fail(tag, "真 uya run 的阶段没记录", &ok);
    }
    if !contains(out, "script exit: 0") {
        ty_fail(tag, "真 uya run 的脚本退出码不是 0", &ok);
    }
    cfg_free(&c);
    return ok;
}

fn wf_round(base: &const Config, tag: &const byte, ws: &const byte) bool {
    mock_mode = 16;
    mock_expect_shell = false;
    mock_expect_fold = false;
    mock_expect_steer = false;
    if !ws_prepare(ws) {
        out_err("selftest: cannot prepare workspace\n");
        return false;
    }
    _ = sess_mkdir_p("build/selftest_wf_home");
    // mock 只服务子代理的请求
    const lfd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return false;
    };
    var one: i32 = 1;
    _ = sys_setsockopt(lfd, SOL_SOCKET, SO_REUSEADDR, &one as &void, 4 as u32) catch {};
    var addr: [byte: 16] = [0: 16];
    fill_sockaddr_ipv4(127, 0, 0, 1, 0, &addr[0]);
    _ = sys_bind(lfd, &addr[0] as &void, 16 as u32) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    _ = sys_listen(lfd, 4) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    var got: [byte: 16] = [0: 16];
    var glen: u32 = 16;
    _ = sys_getsockname(lfd, &got[0] as &void, &glen) catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    const port: u16 = ((got[2] as u16) << (8 as i32)) | (got[3] as u16);
    const pid64: i64 = sys_fork() catch {
        _ = sys_close(lfd) catch {};
        return false;
    };
    if pid64 == 0 {
        const rc0: i32 = mock_server(lfd);
        sys_exit(rc0);
    }
    const pid: i32 = i64_to_i32(pid64);
    _ = sys_close(lfd) catch {};

    var mcfg: Config = cfg_default();
    mcfg.base_url = buf_new(64);
    _ = buf_append_cstr(&mcfg.base_url, "http://127.0.0.1:");
    _ = buf_append_u64(&mcfg.base_url, port as u64);
    _ = buf_append_cstr(&mcfg.base_url, "/v1");
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }

    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    if !wf_variant_stub(&mcfg, tag, &out) {
        ok = false;
    }
    if !wf_variant_real(&mcfg, tag, &out) {
        ok = false;
    }
    cfg_free(&mcfg);
    const mock_rc: i32 = wait_child(pid);
    if mock_rc != 0 {
        out_err("FAIL: mock server verdict ");
        out_err_dec(mock_rc as usize);
        ok = false;
    }
    if ok {
        out_err("ok");
    }
    out_err("\n");
    _ = base;
    return ok;
}

// ============================================================
// P13 轮：preset 旋钮驱动 + 读 DSH 会话（都离线、用假数据）
// ============================================================
fn knobs_round(tag: &const byte) bool {
    var ok: bool = true;
    out_err("selftest[");
    out_err(tag);
    out_err("] ");
    // 1) 假 preset：非默认旋钮（含 group 里嵌套的 config 列表）
    const dir: &const byte = "build/selftest_knobs";
    _ = sess_mkdir_p("build/selftest_knobs/config/agent-presets/standard");
    const preset: &const byte = "- id: persona\n  name: '@deepseek-ai/dsh-persona'\n  config:\n    text: >-\n      You are {{model}} in {{cwd}}.\n\n- id: fs\n  name: '@deepseek-ai/dsh-tool-fs'\n  config:\n    readLimit: 7\n    readMaxBytes: 1234\n    readMaxLineLength: 99\n\n- id: compaction\n  name: cordis:group\n  config:\n    - id: pruner\n      name: '@deepseek-ai/dsh-compaction-tool-result-pruner'\n      config:\n        thresholdChars: 111\n        headChars: 22\n        tailChars: 33\n";
    if !write_text_file("build/selftest_knobs/config/agent-presets/standard/agent.cordis.yml", preset) {
        ty_fail(tag, "写假 preset 失败", &ok);
        return false;
    }
    var texts: PromptTexts = prompt_texts_empty();
    var knobs: PresetKnobs = preset_knobs_default();
    prompt_texts_init(dir, &"x"[0: 0], &texts, &knobs);
    if !knobs.loaded {
        ty_fail(tag, "preset 没被读到", &ok);
    }
    if knobs.read_limit != 7 || knobs.read_max_bytes != 1234 || knobs.read_max_line != 99 {
        ty_fail(tag, "tool-fs 的三个旋钮不对", &ok);
    }
    if knobs.prune_threshold != 111 || knobs.prune_head != 22 || knobs.prune_tail != 33 {
        ty_fail(tag, "嵌套 config 列表里的剪枝旋钮没读到", &ok);
    }
    if !sess_has_cstr(texts.persona.ptr[0: texts.persona.len], "You are {{model}} in {{cwd}}.") {
        ty_fail(tag, "persona 文案没读到（折叠标量）", &ok);
    }
    prompt_texts_free(&texts);

    // 2) 假 DSH 会话：header + user/assistant/tool 事件，裸 jsonl
    _ = sess_mkdir_p("build/selftest_dshs/sessions/--tmp-dshs--/session-aaaa1111-2222-3333-4444-555566667777");
    const hdr: &const byte = "{\"type\":\"session\",\"version\":0,\"id\":\"session-aaaa1111-2222-3333-4444-555566667777\",\"createdAt\":1790000000000,\"cwd\":\"/tmp/dshs\",\"delegationDepth\":0,\"agentPreset\":\"standard\"}\n{\"type\":\"user/message\",\"seq\":1,\"time\":1,\"data\":{\"content\":[{\"type\":\"text\",\"text\":\"请记住 5150\"}]}}\n{\"type\":\"assistant/message\",\"seq\":2,\"time\":2,\"data\":{\"turn\":1,\"step\":1,\"message\":{\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"记住了\"}],\"tool_calls\":[{\"id\":\"call_d1\",\"type\":\"function\",\"function\":{\"name\":\"read\",\"arguments\":\"{\\\"file_path\\\":\\\"x.txt\\\"}\"}}]}}\n{\"type\":\"tool/result\",\"seq\":3,\"time\":3,\"data\":{\"callId\":\"call_d1\",\"content\":\"file x.txt: 5150\"}}\n";
    if !write_text_file("build/selftest_dshs/sessions/--tmp-dshs--/session-aaaa1111-2222-3333-4444-555566667777/session.jsonl", hdr) {
        ty_fail(tag, "写假 DSH 会话失败", &ok);
        return false;
    }
    var ss: DshSessions = DshSessions{ items: [], n: 0 };
    dshs_init(&ss);
    defer { dshs_free(&ss); }
    var dsh_home_b: Buf = buf_new(64);
    defer { buf_free(&dsh_home_b); }
    _ = buf_append_cstr(&dsh_home_b, "build/selftest_dshs");
    dshs_list(dsh_home_b.ptr[0: dsh_home_b.len], &"x"[0: 0], &ss);
    if ss.n != 1 {
        ty_fail(tag, "DSH 会话没扫到", &ok);
    } else if !bufx_eq_cstr(ss.items[0].id.ptr as &const byte, ss.items[0].id.len, "session-aaaa1111-2222-3333-4444-555566667777") {
        ty_fail(tag, "DSH header 的 id 没解析对", &ok);
    } else if ss.items[0].depth != 0 || ss.items[0].zstd {
        ty_fail(tag, "DSH header 的 depth/压缩标记不对", &ok);
    }
    // 前缀查找 + 导入
    if dshs_find(&ss, "session-aaaa") < 0 {
        ty_fail(tag, "DSH 会话前缀查找失败", &ok);
    }
    var h: History = hist_init();
    defer { hist_free(&h); }
    var c13: Config = cfg_default();
    c13.model = buf_new(32);
    _ = buf_append_cstr(&c13.model, "selftest-model");
    const imported: usize = dshs_import(&c13, &ss.items[0], &h);
    if imported != 3 {
        ty_fail(tag, "DSH 导入的消息条数不对", &ok);
    } else if msg_role_at(&h, 0) != ROLE_USER || msg_role_at(&h, 1) != ROLE_ASSISTANT_CALLS || msg_role_at(&h, 2) != ROLE_TOOL {
        ty_fail(tag, "DSH 导入的角色序列不对", &ok);
    } else if !msg_extra_is(&h, 2, "call_d1") {
        ty_fail(tag, "DSH 导入的 tool_call_id 丢了", &ok);
    } else {
        var req: Buf = buf_new(65536);
        defer { buf_free(&req); }
        var cc: Config = cfg_default();
        cc.model = buf_new(32);
        _ = buf_append_cstr(&cc.model, "selftest-model");
        if !build_chat_request(&cc, &h, &req) {
            ty_fail(tag, "DSH 导入的历史无法组装请求", &ok);
        } else if !contains(&req, "\"tool_call_id\":\"call_d1\"") {
            ty_fail(tag, "DSH 导入的请求里没有 tool_call_id", &ok);
        }
        cfg_free(&cc);
    }
    cfg_free(&c13);
    if ok {
        out_err("ok");
    }
    out_err("\n");
    return ok;
}

// 历史消息的文本比对（下标安全 + 长度先比）
fn hist_text_is(h: &const History, i: usize, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    const m: &const Msg = msg_at(h, i);
    if m.text_len != n {
        return false;
    }
    return bufx_mem_eq(m.text, lit, n);
}

// 不限步数带来的长跑副作用：历史会反复「丢最老」。这一轮钉住两条不变量：
//   1) system 与**任务原文**（下标 1 的 user）永远留住 —— 否则跑几十步之后 agent
//      会把自己的任务丢掉；
//   2) assistant(tool_calls) 与它的 tool 结果整组丢，历史绝不会以悬空的 tool 开头。
fn hist_keep_round(tag: &const byte) bool {
    var ok: bool = true;

    // ---- 1) 小历史：丢的是一条完整的 assistant(tool_calls)+tool 组，任务原文留住 ----
    var h: History = hist_init();
    defer { hist_free(&h); }
    _ = hist_push(&h, ROLE_SYSTEM, "S" as &const byte, 1);
    _ = hist_push(&h, ROLE_USER, "TASK" as &const byte, 4);
    _ = hist_push_msg(&h, ROLE_ASSISTANT_CALLS, "c" as &const byte, 1, "[]" as &const byte, 2);
    _ = hist_push_msg(&h, ROLE_TOOL, "r" as &const byte, 1, "call_1" as &const byte, 6);
    _ = hist_push(&h, ROLE_USER, "next" as &const byte, 4);
    if h.len != 5 {
        ty_fail(tag, "历史没按预期堆起来", &ok);
    }
    const dropped: bool = hist_drop_oldest(&h);
    if !dropped {
        ty_fail(tag, "hist_drop_oldest 拒绝丢（历史够长却返回 false）", &ok);
    } else if h.len != 3 {
        ty_fail(tag, "丢的条数不对（assistant+tool 必须整组丢）", &ok);
    } else if msg_role_at(&h, 0) != ROLE_SYSTEM {
        ty_fail(tag, "system 被丢掉了", &ok);
    } else if msg_role_at(&h, 1) != ROLE_USER || !hist_text_is(&h, 1, "TASK" as &const byte) {
        ty_fail(tag, "任务原文（下标 1 的 user）被丢掉了", &ok);
    } else if msg_role_at(&h, 2) != ROLE_USER {
        ty_fail(tag, "丢掉一组之后剩下的消息不对", &ok);
    }

    // ---- 2) 首位不是 user（导入的会话/裁剪过的历史）时，退回「从下标 1 丢」的老行为 ----
    var h2: History = hist_init();
    defer { hist_free(&h2); }
    _ = hist_push(&h2, ROLE_SYSTEM, "S" as &const byte, 1);
    _ = hist_push_msg(&h2, ROLE_ASSISTANT_CALLS, "c" as &const byte, 1, "[]" as &const byte, 2);
    _ = hist_push_msg(&h2, ROLE_TOOL, "r" as &const byte, 1, "call_1" as &const byte, 6);
    _ = hist_push(&h2, ROLE_USER, "later" as &const byte, 5);
    const d2: bool = hist_drop_oldest(&h2);
    if !d2 {
        ty_fail(tag, "首位不是 user 时 hist_drop_oldest 拒绝丢", &ok);
    } else if h2.len != 2 {
        ty_fail(tag, "首位不是 user 时丢的条数不对", &ok);
    } else if msg_role_at(&h2, 0) != ROLE_SYSTEM || msg_role_at(&h2, 1) != ROLE_USER {
        ty_fail(tag, "首位不是 user 时剩下的角色序列不对", &ok);
    }

    // ---- 3) 塞到 MSG_MAX 之后继续跑：任务原文仍在，且不会以悬空 tool 开头 ----
    var h3: History = hist_init();
    defer { hist_free(&h3); }
    _ = hist_push(&h3, ROLE_SYSTEM, "S" as &const byte, 1);
    _ = hist_push(&h3, ROLE_USER, "TASK-KEEP" as &const byte, 9);
    var k: i32 = 0;
    var pa: bool = true;
    var pt: bool = true;
    while k < 40 {
        pa = hist_push_msg(&h3, ROLE_ASSISTANT_CALLS, "c" as &const byte, 1, "[]" as &const byte, 2);
        while !pa {
            if !hist_drop_oldest(&h3) {
                break;
            }
            pa = hist_push_msg(&h3, ROLE_ASSISTANT_CALLS, "c" as &const byte, 1, "[]" as &const byte, 2);
        }
        pt = hist_push_msg(&h3, ROLE_TOOL, "r" as &const byte, 1, "call_x" as &const byte, 6);
        while !pt {
            if !hist_drop_oldest(&h3) {
                break;
            }
            pt = hist_push_msg(&h3, ROLE_TOOL, "r" as &const byte, 1, "call_x" as &const byte, 6);
        }
        k = k + 1;
    }
    if !pa || !pt {
        ty_fail(tag, "塞满历史后仍然追加失败（丢历史没能腾出位置）", &ok);
    } else if h3.len != MSG_MAX {
        ty_fail(tag, "长跑之后历史长度不等于 MSG_MAX", &ok);
    } else if msg_role_at(&h3, 0) != ROLE_SYSTEM {
        ty_fail(tag, "长跑之后 system 被丢掉了", &ok);
    } else if msg_role_at(&h3, 1) != ROLE_USER || !hist_text_is(&h3, 1, "TASK-KEEP" as &const byte) {
        ty_fail(tag, "长跑之后任务原文被丢掉了", &ok);
    } else if msg_role_at(&h3, 2) == ROLE_TOOL {
        ty_fail(tag, "长跑之后历史以悬空 tool 消息开头", &ok);
    }

    if ok {
        out_err("selftest[");
        out_err(tag);
        out_err("] ok");
    }
    out_err("\n");
    return ok;
}

export fn selftest_main(base: &const Config) i32 {
    _ = base;
    out_err("selftest: offline end-to-end (mock LLM on 127.0.0.1, no network, no API key)\n");
    const r1: bool = selftest_round(base, "shell", 0, true, "build/selftest_ws_shell", true, false, false, false);
    const r2: bool = selftest_round(base, "no-shell", 1, false, "build/selftest_ws_noshell", true, false, false, false);
    const r3: bool = selftest_round(base, "tools", 2, true, "build/selftest_ws_tools", true, false, false, false);
    const r4: bool = selftest_round(base, "http401", 3, true, "build/selftest_ws_401", true, false, false, false);
    const r5: bool = selftest_round(base, "max-steps", 5, true, "build/selftest_ws_steps", true, false, false, false);
    // 默认不限步数：mock 连给 14 轮 tool_calls（超过旧默认 12）才给最终答案，
    // agent 必须一路跑到最终答案并以 0 退出（这轮不设 max_steps，吃的就是默认值）
    const r5b: bool = selftest_round(base, "unlimited-steps", 17, true, "build/selftest_ws_unlimited", true, false, false, false);
    // 非流式回归：--no-stream 走旧路径，同一份 mock 数据（JSON 回包）
    const r6: bool = selftest_round(base, "noshell-nostream", 1, false, "build/selftest_ws_nostream", false, false, false, false);
    // 折叠协议回归：--compat-fold
    const r7: bool = selftest_round(base, "shell-fold", 0, true, "build/selftest_ws_fold", true, true, false, false);
    // P3：运行中用户输入（steer）在下一个 step 被采纳
    const r8: bool = selftest_round(base, "steer", 0, true, "build/selftest_ws_steer", true, false, true, false);
    // P3：Ctrl-C 中断当前回合（不该派发工具、不该有下一轮请求）
    const r9: bool = selftest_round(base, "interrupt", 6, true, "build/selftest_ws_intr", true, false, false, true);
    const s0: bool = sse_round(SSE_CASE_BASIC, "stream-basic");
    const s1: bool = sse_round(SSE_CASE_TOOLS, "stream-tools");
    const s2: bool = sse_round(SSE_CASE_NODONE, "stream-nodone");
    const s3: bool = sse_round(SSE_CASE_BADJSON, "stream-badjson");
    const s4: bool = sse_round(SSE_CASE_REASONING_LENGTH, "stream-length");
    const t0: bool = tty_round("tty-editor");
    const t1: bool = sess_round("session-log");
    const t2: bool = dshcfg_round("dsh-config");
    const t3: bool = fs_round(base, "fs-tools", "build/selftest_ws_fs");
    const t4: bool = jobs_round(base, "bash-jobs", "build/selftest_ws_jobs");
    const t5: bool = prompt_round(base, "prompt-todo-plan", "build/selftest_ws_prompt");
    const t6: bool = round_run(base, "compact-prune", "build/selftest_ws_prune", 11, 0 as i64, "产生大输出");
    const t7: bool = round_run(base, "compact-auto", "build/selftest_ws_compact", 12, 200 as i64, "触发自动压缩");
    const t8: bool = skill_round(base, "skills-web-search", "build/selftest_ws_skill", "build/selftest_skills");
    const t9: bool = deleg_round(base, "subagent-goal", "build/selftest_ws_deleg");
    const u0: bool = wf_round(base, "workflow", "build/selftest_wf_ws");
    const u1: bool = knobs_round("preset-knobs-dshsess");
    const u2: bool = hist_keep_round("hist-keep");
    // 步数默认值：0 = 不限步数。这条断言是「默认值」这件事的唯一单点保证 ——
    // 谁把默认值改回 12，unlimited-steps 轮与这里会同时红。
    var cdef: Config = cfg_default();
    var u3: bool = true;
    if cdef.max_steps != 0 {
        out_err("selftest[default-max-steps] FAIL: cfg_default().max_steps != 0（默认必须是不限步数）\n");
        u3 = false;
    }
    cfg_free(&cdef);
    if r1 && r2 && r3 && r4 && r5 && r5b && r6 && r7 && r8 && r9 && s0 && s1 && s2 && s3 && s4 && t0 && t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && u0 && u1 && u2 && u3 {
        out_err("SELFTEST PASS\n");
        return AGENT_OK;
    }
    out_err("SELFTEST FAIL\n");
    return AGENT_PROTO;
}
