// src/rt/rtloop.uya — 单线程事件循环运行时（P97）：进程唯一的 poll 驱动
//
// 本文件：`rt_run`（把一条 `Future<!i32>` 跑到收口）、`RtRunFut`（每轮迭代先跑一次
//   帧回调，再转给内层 future）、帧回调端口 `RtFrame`（具体后端由调用方赋值登记，
//   与 `ui_port` 同法）、协作取消（`rt_abort_*`：**判据只有一份**，不给各业务散点
//   加标志）、`rt_sleep`（唯一的定时原语）。
//
// 不变量：
//   ① **进程内同时只有一条事件循环在跑** —— `rt_run` 不重入（两套 epoll 会抢同一个
//      fd 的注册：后注册的把前一个的掩码覆盖掉，前一个 future 再也醒不过来）；
//   ② 帧回调**只经接口值**调用，绝不出现 `&具体struct as &接口` —— 后者能编译、能
//      链接，但 codegen 不构造 {vtable, data} 对，跑起来是 SIGSEGV（ui_audit 判据 A）；
//   ③ **定时精度 = `RT_POLL_MS`**（实测，见 DESIGN §16 本轮新增）：`deadline` 只在
//      「poll 返回之后」才被检查，所以 poll 超时 1000ms 时一个 120ms 的 deadline 会
//      跑成 1.003s；超时 10ms 时是 0.123s。⇒ RT_POLL_MS 必须 ≤ 一帧，改它等于改精度；
//   ④ `rt_sleep` 的管道**写端常开**：写端一关，读端立刻 EOF ⇒ 永远「可读」⇒ 忙等
//      （这条坑写在 `rt_sleep_fd` 上方，别在收尾时「顺手」把写端关掉）。
//
// 依赖：foundation/bufx（`ua_now_ms`）、std.async（Future / Waker / Poll /
//   async_wait_readable / error.Cancelled / error.AsyncDeadlineExceeded）、
//   std.async_event（LinuxEpoll）、std.async_scheduler（Scheduler 与
//   `scheduler_run_i32_with_event_loop`：它已经把「按 waker 登记的 fd 兴趣注册进 epoll、
//   Pending 时 poll 一次、eventfd 唤醒」这套驱动写好了 —— 本文件**不重写**它，只包一层
//   帧回调）、libc.syscall（`sys_pipe2`）。
// 命名：`rt_*` / `RT_*`；端口 `RtFrame`。
//
// 为什么取消要两层（本轮定下的纪律，改之前先读 DESIGN §19.21）：
//   * **兜底层**：本文件的 `RtRunFut` 每轮都看一眼 `rt_abort_state()`，置位就直接收口
//     —— 它保证「纯等待」的 future（一觉睡到底、没人来叫醒）也能在 ≤RT_POLL_MS 内停；
//   * **正常层**：持有资源（fd / 管道 / 子进程）的 future **必须**在自己的等待边界
//     检查并 `return error.Cancelled`，让 `defer` 跑完再退。兜底层直接丢弃内层
//     future 是**不会**执行它的 defer 的 —— 所以兜底层只兜「没有资源要收」的那些。

use std;
use std.async;
use std.async.async_wait_readable;
use std.async_event.LinuxEpoll;
use std.async_event.linux_epoll_close;
use std.async_event.linux_epoll_create_config;
use std.async_scheduler.Scheduler;
use std.async_scheduler.scheduler_new;
use std.async_scheduler.scheduler_run_i32_with_event_loop;
use std.async.ok;
use std.time.deadline_after_ms;
use libc.syscall;

// ============================================================
// 常量
// ============================================================

// 取消意图。**与 `term/tui/hook.uya` 的 `TUI_ABORT_*` 同值**：P98 会把那边的读写口
// 改成转发到这三个常量，让「要不要停」全仓只有一份判据（现在先在这里定义，避免
// rt 反过来依赖 term 层 —— SRC 顺序里 rt 在 term 之前）。
export const RT_ABORT_NONE: i32 = 0;
export const RT_ABORT_TURN: i32 = 1;   // esc / ctrl+c：停掉当前回合
export const RT_ABORT_QUIT: i32 = 2;   // ctrl+d / /exit：收口并退出进程

// 事件循环的 poll 超时（毫秒）。**它就是定时精度**（见文件头不变量③）。
export const RT_POLL_MS: i32 = 16;
// 取消延迟上限（毫秒）：所有「等待」都按 ≤ 这个粒度分片，片间看 `rt_abort_state()`。
// 它决定了 esc 之后多久真的停下来 —— 与 RT_POLL_MS 是两个量：后者是帧节奏，
// 前者是取消判据的检查间隔。
export const RT_CANCEL_SLICE_MS: u64 = 32;
// 帧回调的最小间隔（毫秒）：与 TUI 现在的 33ms 节流是同一个量级，但这里是「至少每
// RT_FRAME_MS 跑一次帧」，真正的重绘节流仍在显示层（`tui_tick` 内部）。
export const RT_FRAME_MS: u64 = 16;
// epoll 初始槽位（`linux_epoll_create_config` 的第 2/3 个参数，不是 flags）。
// std 的 LinuxEpoll 满载会自动扩容，这里给的只是起步值：
// 本仓同时在等的 fd 是「一个请求 + 键盘 + 少量管道」，256 已经很宽。
export const RT_EPOLL_SLOTS: i32 = 256;

// `rt_run` 收口时用的**内部**退出码。与 agent 层的 `AGENT_INTERRUPTED`（130）/
// `AGENT_TRANSPORT`（2）**同值**：rt 在 SRC 顺序里排在 agent 之前，不能引用那边的
// 常量，所以在这里各写一份，并用「同值」这条注释把它们钉在一起（改一处要改两处）。
export const RT_RC_CANCELLED: i32 = 130;
export const RT_RC_FAILED: i32 = 2;

// ============================================================
// 帧回调端口
// ============================================================

// 每轮迭代调一次（受 RT_FRAME_MS 节流）。**只做显示/心跳**：尺寸、键盘、spinner、
// 任务块、CPU 采样。不许在这里发起网络请求或改历史 —— 它每 16ms 就跑一次，而
// 那些动作要的是「一个回合一次」。
export interface RtFrame {
    fn rt_frame(self: &Self, now_ms: u64) void;
}

// 空实现：进程起来到显示层登记之前，帧回调就是它（不判空、不分支，调用点只有一条）。
struct RtFrameNone : RtFrame {
    fn rt_frame(self: &Self, now_ms: u64) void {
        _ = self;
        _ = now_ms;
    }
}

var g_rt_frame_none: RtFrameNone = RtFrameNone{};

// 空实现的**接口值**：顶层初始化器里装箱一次，之后一律用它（具体 struct 的值形态
// 装箱在检查器里算一次「移动」，装第二次就报「已被移动」；装箱一次是唯一稳的写法）。
var g_rt_no_frame: RtFrame = g_rt_frame_none;

// 当前帧回调（接口值）。构造方式只有一种：具体 struct → 接口变量（不变量②）。
// ⚠ 文件作用域的初始化器里**只能**写具体 struct（C 侧是常量复合字面量）；
// 写「接口 = 另一个接口全局」会发射成运行期赋值，宿主 C 报
// initializer element is not constant。要复位就在函数体里赋 `g_rt_no_frame`。
var g_rt_frame: RtFrame = g_rt_frame_none;

// 已经跑过的帧数（自测的判据之一：拆掉 tick 这条腿必须当场红）。
var g_rt_frames: i64 = 0;

// 取消意图（唯一判据）。
var g_rt_abort: i32 = RT_ABORT_NONE;

// `rt_sleep` 的管道两端。**两端都要留着**（不变量④）。
var g_rt_sleep_r: i32 = -1;
var g_rt_sleep_w: i32 = -1;

// rt_run 的递归深度：防重入（不变量①）。>0 时再进来直接返回 RT_RC_FAILED，
// 而不是悄悄起第二套 epoll。
var g_rt_depth: i32 = 0;

// 登记帧回调（显示层在自己的 init 里调）。传空实现 = 关掉帧回调。
export fn rt_set_frame(p: RtFrame) void {
    g_rt_frame = p;
}

// 帧回调复位成空实现。
export fn rt_frame_clear() void {
    g_rt_frame = g_rt_no_frame;
}

// 已跑的帧数（自测用）。
export fn rt_frame_count() i64 {
    return g_rt_frames;
}

// 帧计数清零（自测用）。
export fn rt_frame_reset() void {
    g_rt_frames = 0;
}

// 当前是否在事件循环里（诊断用）。
export fn rt_running() bool {
    return g_rt_depth > 0;
}

// ============================================================
// 协作取消
// ============================================================

// 置一个取消意图。规则：
//   * `RT_ABORT_NONE` 是「不置」，不是「清空」—— 清空请显式调 `rt_abort_reset`；
//   * 已经置了 `QUIT` 就不再被 `TURN` 覆盖（退出意图优先，人按了 ctrl+d 之后
//     再来一个 esc 不该把「要退出」降级成「只停这一回合」）。
export fn rt_abort(kind: i32) void {
    if kind == RT_ABORT_NONE {
        return;
    }
    if g_rt_abort == RT_ABORT_QUIT {
        return;
    }
    g_rt_abort = kind;
}

// 读取消意图（不清空）。
export fn rt_abort_state() i32 {
    return g_rt_abort;
}

// 取走取消意图（读并清空）。主循环在收口一个被中断的回合之后调它：
// 不清的话，下一个用户回合会在第一个等待边界被上一轮的意图当场打断。
export fn rt_abort_take() i32 {
    const v: i32 = g_rt_abort;
    g_rt_abort = RT_ABORT_NONE;
    return v;
}

// 清空取消意图。
export fn rt_abort_reset() void {
    g_rt_abort = RT_ABORT_NONE;
}

// 「现在要不要停」的唯一问句。
export fn rt_should_stop() bool {
    return g_rt_abort != RT_ABORT_NONE;
}

// ============================================================
// 定时
// ============================================================

// 取（必要时创建）`rt_sleep` 用的管道读端。
//
// 为什么用管道而不是 `timerfd`：本工具链的 libc 没有 timerfd（实测 `libc/syscall.uya`
// 里没有）；`std` 也没有 `sleep`。而 `async_wait_readable(fd, deadline)` 自带 deadline
// 判定，所以在一条「永远不会有数据的管道」上等 = 精确睡到 deadline（精度 = RT_POLL_MS）。
//
// ⚠ **写端必须留着**：写端全关之后读端就是 EOF，`poll` 每次都说可读 ⇒
// `async_wait_readable` 立刻 Ready ⇒ 调用方拿到的不再是 deadline 而是「马上」，
// `rt_sleep` 退化成忙等（CPU 100%，且一帧都不推进）。所以 `g_rt_sleep_w` 只存不用，
// 全程开着，进程退出时随 fd 一起没了。
fn rt_sleep_fd() i32 {
    if g_rt_sleep_r >= 0 {
        return g_rt_sleep_r;
    }
    var pfd: [i32: 2] = [0: 2];
    const r: !i32 = sys_pipe2(&pfd[0], 0);
    _ = r catch {
        return 0 - 1;
    };
    g_rt_sleep_r = pfd[0];
    g_rt_sleep_w = pfd[1];
    return g_rt_sleep_r;
}

// Windows 的定时 future：**不占 fd、不阻塞**，只看时钟。
//
// 为什么在 Windows 上换一条路：那条「在一条永不写数据的管道上等到 deadline」的做法
// 依赖 `poll(2)` 能对管道返回「未就绪」。而编译器的 Windows 后端对**非 socket**
// fd 的处理是「按超时睡一觉然后把它们全报成就绪」（见 uya 的 c99 后端
// `uya_windows_poll`）—— 于是 `async_wait_readable(pipe)` 立刻 Ready，
// `rt_sleep` 的循环退化成「空转到 deadline」：CPU 100%、界面还不动。
// 这里改成「驱动每 RT_POLL_MS 重 poll 一次，future 自己看时钟」，语义与 Linux 那条
// 路完全一致（精度同样是 RT_POLL_MS），而且一条 fd 都不占。
//
// 取消判据在 poll 里：esc 之后最迟一轮（≤RT_POLL_MS）就 `error.Cancelled`。
struct RtWinSleepFut : Future<!usize> {
    end_ms: u64,

    fn poll(self: &Self, waker: &Waker) Poll<!usize> {
        _ = waker;
        if g_rt_abort != RT_ABORT_NONE {
            return Poll<!usize>.Ready(error.Cancelled);
        }
        if ua_now_ms() >= self.end_ms {
            return Poll<!usize>.Ready(ok<usize>(0 as usize));
        }
        return Poll<!usize>.Pending({});
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

// 本二进制是不是 Windows 目标（编译期常量，非 Windows 目标下恒 false）。
// rt 在 SRC 顺序里排在 term 之前，所以这里各写一份 —— 与 `term/wincon.uya`
// 的 `wincon_target()` **同义**（改一处要改两处）。
fn rt_win_target() bool {
    std.cfg(std.target_os == .tos_windows, {
        return true;
    }, {
        return false;
    })
}

// 定时原语走哪条路：Windows = 纯时钟（`RtWinSleepFut`），其余 = 管道 + deadline。
fn rt_clock_sleep_target() bool {
    return rt_win_target();
}

// 把 `RtWinSleepFut` 装箱成接口值。**返回类型必须是 `Future<!usize>`** —— 具体 struct
// → 接口的转换要发生在「有声明类型的返回位置」，否则 codegen 会把它当 usize 赋值
// （见 `rt_sleep` 里那条注释）。
fn rt_win_sleep_future(ms: u32) Future<!usize> {
    return RtWinSleepFut{ end_ms: ua_now_ms() + (ms as u64) };
}

// 睡 `ms` 毫秒。**唯一的定时原语**：节流、退避、ESC 歧义判定、「等 33ms 再刷一帧」
// 全部走它（`std` 没有 sleep，见 `rt_sleep_fd` 的注释）。
//
// 返回 0；被取消时 `error.Cancelled`（调用方的 defer 会照常跑完）。`ms == 0` 是
// 「不睡」—— 直接返回，别把它当「无限等」（`deadline_after_ms(0)` 的语义是 0 时刻，
// 而 `async_wait_readable` 把 deadline 0 当成「不设超时」，两者不同，所以在这里挡住）。
@async_fn fn rt_sleep(ms: u32) Future<!usize> {
    if g_rt_abort != RT_ABORT_NONE {
        return error.Cancelled;
    }
    if ms == 0 {
        return 0 as usize;
    }
    // Windows：**不占 fd**（见 `RtWinSleepFut` 的注释）—— 管道那条路在 Windows 上
    // 一步都走不通：`sys_poll` 对非 socket fd 一律报「就绪」，于是每一次
    // `async_wait_readable` 都立刻 Ready，循环退化成空转烧 CPU。
    //
    // ⚠ 必须 `@await` 一个**已装箱的** `Future<!usize>`（`rt_win_sleep_future`），
    // 不能 `return RtWinSleepFut{…}`：那样具体 struct 与接口的转换发生在
    // `@async_fn` 的返回值位置上，生成的 C 会把它当 `size_t` 去赋值
    // （实测 zig cc 报 initializing 'size_t' with an expression of incompatible
    // type 'struct RtWinSleepFut'）。
    if rt_clock_sleep_target() {
        return try @await rt_win_sleep_future(ms);
    }
    const fd: i32 = rt_sleep_fd();
    if fd < 0 {
        return 0 as usize;
    }
    const t0: u64 = ua_now_ms();
    const end: u64 = t0 + (ms as u64);
    // **分片睡**（每片 ≤ RT_CANCEL_SLICE_MS）：一次睡到底的话，esc 之后这条 future
    // 仍要等到自己的 deadline 才会被重新 poll —— 取消延迟就等于睡眠长度。
    while true {
        if g_rt_abort != RT_ABORT_NONE {
            return error.Cancelled;
        }
        const now: u64 = ua_now_ms();
        if now >= end {
            return 0 as usize;
        }
        const left: u64 = end - now;
        const slice: u64 = if left > RT_CANCEL_SLICE_MS {
            RT_CANCEL_SLICE_MS;
        } else {
            left;
        };
        const dl: u64 = try deadline_after_ms(slice as u32);
        const w: !usize = @await async_wait_readable(fd, dl);
        _ = w catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            const cancel_id: i32 = (@error_id(error.Cancelled) as! i32).value;
            if eid == cancel_id {
                return error.Cancelled;
            }
            // slice 到点（正常）：回到循环顶再判一次取消与总 deadline。
            // 「fd 出了别的事」也按同一路处理 —— 定时器不因为底层 fd 出问题就
            // 把整个回合打成失败。
            0 as usize;
        };
    }
    return 0 as usize;
}

// 对外入口：睡 `ms` 毫秒（自测/上层用）。
export fn rt_sleep_export(ms: u32) Future<!usize> {
    return rt_sleep(ms);
}

// ============================================================
// 驱动
// ============================================================

// 包在内层 future 外面的一层：每轮先节流跑一次帧回调，再转给内层；顺带兜「取消」。
// 为什么要有这一层而不是在业务里到处 tick：帧回调的位置**只有一个**，
// 谁在等（网络 / 子进程 / 键盘 / 纯睡）都推得动帧 —— 这正是「运行中的命令不再等
// step 边界」的实现基础（替代 P30 的泵点加密）。
struct RtRunFut : Future<!i32> {
    inner: Future<!i32>,
    last_ms: u64,

    fn poll(self: &Self, waker: &Waker) Poll<!i32> {
        const now: u64 = ua_now_ms();
        if now >= self.last_ms + RT_FRAME_MS {
            self.last_ms = now;
            g_rt_frames = g_rt_frames + 1;
            g_rt_frame.rt_frame(now);
        }
        return self.inner.poll(waker);
    }

    fn release(self: &Self) void {
        self.inner.release();
    }
}

// 跑一条 `Future<!i32>` 到收口，返回退出码。
//
// 成功时返回 future 自己的 i32（业务退出码）；`error.Cancelled` 收口返回
// `RT_RC_CANCELLED`（130），其余基础设施错误返回 `RT_RC_FAILED`（2）。
// 重入直接返回 `RT_RC_FAILED`（不变量①）。
export fn rt_run(f: Future<!i32>) i32 {
    if g_rt_depth > 0 {
        return RT_RC_FAILED;
    }
    g_rt_depth = 1;
    defer { g_rt_depth = 0; }

    // Windows：没有 epoll（编译器的 Windows 后端把 epoll_create/ctl/wait 全映射成
    // ENOSYS），走 tick 驱动（`rt_win_drive`）。判据是编译期常量，非 Windows 目标下
    // 这一整段是死代码。
    if rt_win_target() {
        return rt_win_drive(f);
    }

    var s: Scheduler = scheduler_new();
    // 注意第一个参数是 `epoll_create1` 的 **flags**（0 或 EPOLL_CLOEXEC），不是槽位数：
    // 把槽位数传进去当 flags 会拿到 EINVAL（实测：整条腿一条判据都过不了）。
    const slots: i32 = RT_EPOLL_SLOTS;
    var loop: LinuxEpoll = linux_epoll_create_config(0, slots, slots) catch {
        return RT_RC_FAILED;
    };
    defer { linux_epoll_close(&loop); }

    const wrapped: RtRunFut = RtRunFut{ inner: f, last_ms: 0 };
    const r: !i32 = scheduler_run_i32_with_event_loop(
        &s, loop, wrapped, RT_POLL_MS);
    return r catch |err| {
        rt_map_error((@error_id(err) as! i32).value);
    };
}

// Windows 的驱动：**一条 tick 循环**替代 epoll 的事件驱动。
//
// 每轮：poll 一次 future → Ready 就收口 → 否则等一个 RT_POLL_MS 再 poll。时间精度与
// Linux 那条路**完全一致**（`RT_POLL_MS` 就是定时精度，见文件头不变量③），差别只在
// 它不做「谁就绪谁唤醒」的兴趣登记。
//
// 为什么这样够用（而不是「凑合」）：本仓所有等待最终都落成「每次 poll 重新探一次」
// 的形状 —— `AsyncWaitFdFuture.poll` 自己先 `poll(fd, 0)` 探一次；`rt_sleep` 在
// Windows 上换成看时钟的 `RtWinSleepFut`。所以「被唤醒」这件事由 tick 统一代替。
//
// 为什么必须无条件 tick（而不是「有 io 兴趣才等」）：Windows 上 `sys_poll` 对**非
// socket** fd（控制台 / 管道）一律立刻报就绪，于是 `async_wait_readable(0)` 会秒回，
// 上层的读循环就成了空转。无条件 tick 把整个循环钉在 ≤62 圈/秒。
fn rt_win_drive(f: Future<!i32>) i32 {
    var w: Waker = Waker{ _io_fd: 0 - 1, _event_fd: 0 - 1 };
    const wrapped: RtRunFut = RtRunFut{ inner: f, last_ms: 0 };
    while true {
        w.reset();
        w.clear_io_interest();
        const p: Poll<!i32> = wrapped.poll(&w);
        match p {
            .Ready(ok_val) => {
                // 与 `rt_run` 的 Linux 路径同一口写法：catch 块产出 i32，
                // 由外层 return 统一出门（`return x catch {…};` 在嵌套块里过不了解析）。
                const rc: i32 = ok_val catch |err| {
                    rt_map_error((@error_id(err) as! i32).value);
                };
                return rc;
            },
            .Pending(_) => { },
        };
        // 兜底层：纯等待的 future（一觉睡到底、没人来叫醒）也要能在 ≤RT_POLL_MS 内停。
        if g_rt_abort != RT_ABORT_NONE {
            return RT_RC_CANCELLED;
        }
        // 自己被叫醒过（同一次 poll 里已经推进了）：不睡，立刻再 poll 一轮。
        if w.is_woken() {
            continue;
        }
        rt_nanosleep_ms(RT_POLL_MS);
    }
    return RT_RC_FAILED;
}

// 睡 `ms` 毫秒（驱动自己用：这里没有事件循环，只能原地等）。
fn rt_nanosleep_ms(ms: i32) void {
    if ms <= 0 {
        return;
    }
    var ts: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    ts.tv_sec = (ms / 1000) as i64;
    ts.tv_nsec = (((ms % 1000) as i64) * (1000000 as i64));
    var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_nanosleep(&ts, &rem) catch {};
}


// 把基础设施错误折成退出码。**只认取消**，其余一律「传输/运行时失败」——
// 业务错误在进 rt 之前就已经被 agent 层折成 `AGENT_*` 码了，不应该走到这里。
fn rt_map_error(eid: i32) i32 {
    const cancel_id: i32 = (@error_id(error.Cancelled) as! i32).value;
    if eid == cancel_id {
        return RT_RC_CANCELLED;
    }
    return RT_RC_FAILED;
}
