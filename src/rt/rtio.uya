// src/rt/rtio.uya — 异步 I/O 原语（P98）：读 / 写满 / accept / connect / 并发等
//
// 本文件：把「等 fd 就绪」这件事收成**一层**，让上层业务只写 `@await rt_read_some(...)`
//   这样的线性代码（状态机由编译器生成，不手写 poll）。
//
// 不变量：
//   ① **fd 必须是非阻塞的**（`rt_set_nonblock` 一次，之后由 `EAGAIN` → 等可读 → 重试
//      这套循环兜住）。阻塞 fd 上 `sys_read` 会把整条事件循环停住 —— 那正是这轮要
//      消灭的东西；
//   ② 每一次等待都**先看取消意图**（`rt_should_stop()`）再进 `async_wait_readable`：
//      esc 之后最迟一轮（≤RT_POLL_MS）就 `error.Cancelled` 出去，调用方的 `defer`
//      照常跑完（这是「取消的正常层」，见 rtloop 文件头）；
//   ③ `deadline_ms == 0` 表示**不设超时**（`async_wait_readable` 的语义，与
//      `deadline_after_ms(0)` 不同 —— 后者是「0 时刻」）；
//   ④ 路径上**唯一**手写的 poll 是 `RtWaitAny2`（两路 fd 谁先就绪）。其余一律
//      `@async_fn` —— 让编译器生成状态机，是这轮改造的**首选**做法（手写状态机
//      是维护成本的大头，只在「需要一个 Future 而不是一条协程」时才写）。
//
// 依赖：std.async（Waker / Poll / Future / async_wait_readable /
//   async_wait_writable / async_join2_usize_results / error.Cancelled）、
//   libc.errno（EINTR / EAGAIN）、libc.syscall（sys_read / sys_write /
//   sys_accept / sys_connect / sys_fcntl / sys_poll）、rtloop（取消与定时）。
// 命名：`rt_*` / `RT_*`；错误 `RtIoFailed`。

use std.async;
use std.async.async_join2_usize_results;
use std.async.ok;
use libc.errno;
use libc.syscall;

// I/O 失败（除取消与超时之外的一切）。与 httpc 的 `HcIoFailed` 分开：这一层只报
// 「系统调用没成」，把 errno 翻译成人话是上层的事（判据分层，见 DESIGN §16 踩坑 133）。
export error RtIoFailed;

const RT_F_GETFL: i32 = 3;
const RT_F_SETFL: i32 = 4;
const RT_O_NONBLOCK: i32 = 0x800;

// 把 fd 设成非阻塞（幂等）。失败不报错：调用方后续会拿到 EAGAIN 或真错误，
// 由 `rt_read_some` 的循环决定怎么收场 —— 这里报错也做不了别的事。
export fn rt_set_nonblock(fd: i32) void {
    const flags: i32 = sys_fcntl(fd, RT_F_GETFL, 0) catch { -1; };
    if flags < 0 {
        return;
    }
    _ = sys_fcntl(fd, RT_F_SETFL, flags | RT_O_NONBLOCK) catch {};
}

// 等 fd 可读；被取消返回 `error.Cancelled`，到 deadline 返回
// `error.AsyncDeadlineExceeded`（由调用方决定是重试还是收场）。
@async_fn fn rt_wait_readable(fd: i32, deadline_ms: u64) Future<!usize> {
    // **分片等**：一次等到 deadline 的话，esc 之后这条 future 要等 fd 自己就绪或
    // deadline 到才会被重新 poll —— 取消延迟就等于「网络多久回不来」。
    // 分片粒度 RT_CANCEL_SLICE_MS，片间判取消与总 deadline。
    while true {
        if rt_should_stop() {
            return error.Cancelled;
        }
        const now: u64 = ua_now_ms();
        var slice_end: u64 = now + RT_CANCEL_SLICE_MS;
        if deadline_ms != 0 && deadline_ms < slice_end {
            slice_end = deadline_ms;
        }
        const r: !usize = @await async_wait_readable(fd, slice_end);
        const v: usize = r catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            const cancel_id: i32 = (@error_id(error.Cancelled) as! i32).value;
            if eid == cancel_id {
                return error.Cancelled;
            }
            // 片到期（或读就绪探测的 eagain）：回到循环顶重新判一次。
            if deadline_ms != 0 && ua_now_ms() >= deadline_ms {
                return error.AsyncDeadlineExceeded;
            }
            continue;
        };
        return v;
    }
    return 0 as usize;
}

// 等 fd 可写（同上）。
@async_fn fn rt_wait_writable(fd: i32, deadline_ms: u64) Future<!usize> {
    while true {
        if rt_should_stop() {
            return error.Cancelled;
        }
        const now: u64 = ua_now_ms();
        var slice_end: u64 = now + RT_CANCEL_SLICE_MS;
        if deadline_ms != 0 && deadline_ms < slice_end {
            slice_end = deadline_ms;
        }
        const r: !usize = @await async_wait_writable(fd, slice_end);
        const v: usize = r catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            const cancel_id: i32 = (@error_id(error.Cancelled) as! i32).value;
            if eid == cancel_id {
                return error.Cancelled;
            }
            if deadline_ms != 0 && ua_now_ms() >= deadline_ms {
                return error.AsyncDeadlineExceeded;
            }
            continue;
        };
        return v;
    }
    return 0 as usize;
}

// 读一次。返回值：
//   1 = 读到了（长度写进 `n_out`）
//   0 = 对端关闭（EOF）
//   `error.Cancelled` / `error.AsyncDeadlineExceeded` / `error.RtIoFailed`
//
// EINTR 一律重试（装了信号处理器之后 read 会被 SIGWINCH 打断，那**不是** EOF ——
// 与 tty 那边同一条纪律）；EAGAIN 先去等可读再回来重试。
@async_fn fn rt_read_some(
    fd: i32,
    out: &byte,
    cap: usize,
    deadline_ms: u64,
    n_out: &usize
) Future<!usize> {
    while true {
        if rt_should_stop() {
            return error.Cancelled;
        }
        const rr: !isize = sys_read(fd, out, cap);
        var eid: i32 = 0;
        const n: isize = rr catch |err| {
            eid = (@error_id(err) as! i32).value;
            -1 as isize;
        };
        if n < 0 {
            if eid == EINTR {
                continue;
            }
            if eid == EAGAIN || eid == EWOULDBLOCK {
                _ = try @await rt_wait_readable(fd, deadline_ms);
                continue;
            }
            return error.RtIoFailed;
        }
        if n == 0 {
            return 0 as usize;
        }
        n_out[0] = n as usize;
        return 1 as usize;
    }
}

// 对外入口（自测与上层用）。
export fn rt_read(
    fd: i32,
    out: &byte,
    cap: usize,
    deadline_ms: u64,
    n_out: &usize
) Future<!usize> {
    return rt_read_some(fd, out, cap, deadline_ms, n_out);
}

// 写满整段。返回已写字节数（正常等于 len）；短写继续写，EAGAIN 等可写。
@async_fn fn rt_write_all(
    fd: i32,
    src: &const byte,
    len: usize,
    deadline_ms: u64
) Future<!usize> {
    var off: usize = 0;
    while off < len {
        if rt_should_stop() {
            return error.Cancelled;
        }
        const p: *const byte =
            @ptr_from_usize(@usize_from_ptr(src as &void) + off) as *const byte;
        const rr: !isize = sys_write(fd, p, len - off);
        var eid: i32 = 0;
        const n: isize = rr catch |err| {
            eid = (@error_id(err) as! i32).value;
            -1 as isize;
        };
        if n < 0 {
            if eid == EINTR {
                continue;
            }
            if eid == EAGAIN || eid == EWOULDBLOCK {
                _ = try @await rt_wait_writable(fd, deadline_ms);
                continue;
            }
            return error.RtIoFailed;
        }
        if n == 0 {
            // 写 0 字节不是「写完」—— 继续循环就成了死转，报错更诚实
            return error.RtIoFailed;
        }
        off = off + (n as usize);
    }
    return off;
}

// 对外入口。
export fn rt_write(
    fd: i32,
    src: &const byte,
    len: usize,
    deadline_ms: u64
) Future<!usize> {
    return rt_write_all(fd, src, len, deadline_ms);
}

// accept 一条连接。返回 1（新 fd 写进 `fd_out`）。
@async_fn fn rt_accept_fd(
    listen_fd: i32,
    fd_out: &i32,
    deadline_ms: u64
) Future<!usize> {
    while true {
        if rt_should_stop() {
            return error.Cancelled;
        }
        var peer: [byte: 32] = [0: 32];
        var alen: u32 = 32;
        const rr: !i32 = sys_accept(listen_fd, &peer[0] as &void, &alen);
        var eid: i32 = 0;
        const got: i32 = rr catch |err| {
            eid = (@error_id(err) as! i32).value;
            0 - 1 as i32;
        };
        if got < 0 {
            if eid == EINTR {
                continue;
            }
            if eid == EAGAIN || eid == EWOULDBLOCK {
                _ = try @await rt_wait_readable(listen_fd, deadline_ms);
                continue;
            }
            return error.RtIoFailed;
        }
        fd_out[0] = got;
        return 1 as usize;
    }
}

// 对外入口。
export fn rt_accept(
    listen_fd: i32,
    fd_out: &i32,
    deadline_ms: u64
) Future<!usize> {
    return rt_accept_fd(listen_fd, fd_out, deadline_ms);
}

// 非阻塞 connect：EINPROGRESS 等可写，再用 SO_ERROR 判成败（0 = 连上）。
// `addr` 是已填好的 sockaddr（IPv4 16 字节 / IPv6 28 字节），由上层（httpc）自己拼。
@async_fn fn rt_connect_fd(
    fd: i32,
    addr: &const void,
    addr_len: u32,
    deadline_ms: u64
) Future<!usize> {
    if rt_should_stop() {
        return error.Cancelled;
    }
    const rr: !i32 = sys_connect(fd, addr, addr_len);
    var eid: i32 = 0;
    const rc: i32 = rr catch |err| {
        eid = (@error_id(err) as! i32).value;
        0 - 1 as i32;
    };
    if rc == 0 {
        return 1 as usize;
    }
    if !(eid == EINPROGRESS || eid == EAGAIN || eid == EWOULDBLOCK) {
        return error.RtIoFailed;
    }
    _ = try @await rt_wait_writable(fd, deadline_ms);
    const so: i32 = rt_socket_error(fd);
    if so != 0 {
        return error.RtIoFailed;
    }
    return 1 as usize;
}

// 对外入口。
export fn rt_connect(
    fd: i32,
    addr: &const void,
    addr_len: u32,
    deadline_ms: u64
) Future<!usize> {
    return rt_connect_fd(fd, addr, addr_len, deadline_ms);
}

// 读 `SO_ERROR`（非阻塞 connect 的成败判据）。取不到就当 0（让后续读写报真错）。
fn rt_socket_error(fd: i32) i32 {
    var v: i32 = 0;
    var len: u32 = 4;
    var pfds: [i32: 1] = [fd];
    _ = pfds[0];
    const r: !i32 = sys_getsockopt(
        fd, RT_SOL_SOCKET, RT_SO_ERROR, &v as &void, &len);
    _ = r catch {
        return 0;
    };
    return v;
}

const RT_SOL_SOCKET: i32 = 1;
const RT_SO_ERROR: i32 = 4;

// ============================================================
// 并发：两路 fd 谁先就绪（本文件唯一手写的 poll）
// ============================================================
//
// 为什么必须手写：`@async_fn` 里拿不到 waker（`@await` 只是把等待转给子 future），
// 而「同时关注两个 fd」正好需要 waker 的槽表（`WAKER_IO_SLOT_MAX = 4`，两个 fd
// 够用）。这也正是 std 里 `AsyncWaitFdFuture` 手写的同一个理由。
//
// 语义：两路里任一路可读就 Ready（1 = a，2 = b）；`deadline_ms == 0` 不设超时。
struct RtWaitAny2 : Future<!usize> {
    fd_a: i32,
    fd_b: i32,
    deadline_ms: u64,

    fn poll(self: &Self, waker: &Waker) Poll<!usize> {
        if rt_should_stop() {
            return Poll<!usize>.Ready(error.Cancelled);
        }
        if self.deadline_ms != 0 {
            const now: u64 = ua_now_ms();
            if now >= self.deadline_ms {
                return Poll<!usize>.Ready(error.AsyncDeadlineExceeded);
            }
        }
        var pfds: [PollFd: 2] = [
            PollFd{ fd: self.fd_a, events: POLLIN, revents: 0 },
            PollFd{ fd: self.fd_b, events: POLLIN, revents: 0 },
        ];
        const pr: i32 = sys_poll(&pfds[0], 2, 0) catch { 0; };
        if pr > 0 {
            if (pfds[0].revents & (POLLIN | POLLHUP | POLLERR)) != 0 {
                return Poll<!usize>.Ready(ok<usize>(1 as usize));
            }
            if (pfds[1].revents & (POLLIN | POLLHUP | POLLERR)) != 0 {
                return Poll<!usize>.Ready(ok<usize>(2 as usize));
            }
        }
        if self.fd_a >= 0 {
            waker.wait_readable(self.fd_a);
        }
        if self.fd_b >= 0 {
            waker.wait_readable(self.fd_b);
        }
        // 直接构造，不走泛型 helper：`poll_pending<T>()` 的单态名（`std_poll_pending_usize`）
        // 在 std 里没有登记（只有 `*_err_usize` 那一个），链接期会 undefined reference。
        return Poll<!usize>.Pending({});
    }

    fn release(self: &Self) void {
        _ = self;
    }
}

// 等两路 fd 里任一路可读：返回 1（a 就绪）或 2（b 就绪）。
// fd 传 -1 表示「这一路不参与」（只等另一路）。
export fn rt_wait_any2(fd_a: i32, fd_b: i32, deadline_ms: u64) Future<!usize> {
    return RtWaitAny2{ fd_a: fd_a, fd_b: fd_b, deadline_ms: deadline_ms };
}

// 并发跑两条 `Future<!usize>`，两条都收口后返回（结果写进 `a_out` / `b_out`）。
// 这就是「侧路请求与主回合并发」的底座（P102 用它把标题/压缩挂到主回合旁边）。
export fn rt_join2(
    a: Future<!usize>,
    b: Future<!usize>,
    a_out: &usize,
    b_out: &usize
) Future<!usize> {
    var ea: u32 = 0;
    var eb: u32 = 0;
    return async_join2_usize_results(a, a_out, &ea, b, b_out, &eb);
}

// 两路「谁先完成就用谁」：`which_out` 写 1（a 先）或 2（b 先），返回该路的值。
//
// 用途：回合进行中同时等「网络可读」与「键盘可读」—— 没有它，键盘就只能在
// 网络动一下之后才被看见（那正是泵点时代的老毛病）。
@async_fn fn rt_select2_run(
    a: Future<!usize>,
    b: Future<!usize>,
    which_out: &i32
) Future<!usize> {
    var wa: Waker = Waker{ _io_fd: 0 - 1, _event_fd: 0 - 1 };
    var wb: Waker = Waker{ _io_fd: 0 - 1, _event_fd: 0 - 1 };
    while true {
        if rt_should_stop() {
            return error.Cancelled;
        }
        wa.reset();
        wa.clear_io_interest();
        var a_ready: usize = 0;
        var a_val: usize = 0;
        const pa: Poll<!usize> = a.poll(&wa);
        match pa {
            .Pending(_) => {},
            .Ready(va) => {
                const got: !usize = va;
                a_val = try got;
                a_ready = 1;
            },
        };
        if a_ready != 0 {
            which_out[0] = 1;
            return a_val;
        }
        if wa.is_woken() {
            continue;
        }
        wb.reset();
        wb.clear_io_interest();
        var b_ready: usize = 0;
        var b_val: usize = 0;
        const pb: Poll<!usize> = b.poll(&wb);
        match pb {
            .Pending(_) => {},
            .Ready(vb) => {
                const got: !usize = vb;
                b_val = try got;
                b_ready = 1;
            },
        };
        if b_ready != 0 {
            which_out[0] = 2;
            return b_val;
        }
        if wb.is_woken() {
            continue;
        }
        // 两侧都 Pending：等任一侧 fd；没有 fd（纯定时 future）就退化成短睡。
        const fa: i32 = wa.io_fd();
        const fb: i32 = wb.io_fd();
        if fa < 0 && fb < 0 {
            const slept: !usize = @await rt_sleep_export(1);
            _ = slept catch |err| {
                return err;
            };
            continue;
        }
        const r: !usize = @await rt_wait_any2(fa, fb, 0 as u64);
        _ = r catch |err| {
            return err;
        };
    }
    return 0 as usize;
}

// 对外入口：`which_out` 写 1/2。
export fn rt_select2(
    a: Future<!usize>,
    b: Future<!usize>,
    which_out: &i32
) Future<!usize> {
    return rt_select2_run(a, b, which_out);
}
