// src/goal.uya — 会话级目标（P11，对齐 DSH 的 goal 工具）
//
// 目标存在 agent_home 下的 goal.json 里，跨进程可读；字段：objective / phase /
// round / maxRounds / blocker / revision / id。update_goal 要求**精确的 id 与 revision**
// （取值前必须先 get_goal），这样并发/过期写入会被挡住。
//
// phase：active（自动续跑）/ paused / complete / blocked

use libc.syscall;
use libc.unistd;

export struct Goal {
    active_state: bool,     // 是否已经创建
    id: i32,
    revision: i32,
    phase: Buf,             // active / paused / complete / blocked
    objective: Buf,
    round: i32,
    max_rounds: i32,
    blocker: Buf,
    armed: bool,            // 是否还有自动续跑
}

export fn goal_empty() Goal {
    return Goal{
        active_state: false,
        id: 0,
        revision: 0,
        phase: buf_empty(),
        objective: buf_empty(),
        round: 0,
        max_rounds: 20,
        blocker: buf_empty(),
        armed: false,
    };
}

export fn goal_free(g: &Goal) void {
    buf_free(&g.phase);
    buf_free(&g.objective);
    buf_free(&g.blocker);
}

fn goal_path(cfg: &const Config, out: &Buf) bool {
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        return false;
    }
    buf_reset(out);
    _ = buf_append(&out[0], home.ptr, home.len);
    return buf_append_cstr(out, "/goal.json");
}

fn goal_set(dst: &Buf, src: &[byte]) void {
    buf_reset(dst);
    if src.len > 0 {
        _ = buf_append(dst, src.ptr, src.len);
    }
}

// 「指针 + 长度」版本（JsonStrView 与字符串字面量都走这里；
// 写 `ptr as &const byte[0: n]` 会被解析成别的意思，别用）
fn goal_set_n(dst: &Buf, p: &const byte, n: usize) void {
    buf_reset(dst);
    if n > 0 {
        _ = buf_append(dst, p, n);
    }
}

fn goal_set_lit(dst: &Buf, lit: &const byte, n: usize) void {
    goal_set_n(dst, lit, n);
}

export fn goal_load(cfg: &const Config, g: &Goal) bool {
    var p: Buf = buf_new(1200);
    defer { buf_free(&p); }
    if !goal_path(cfg, &p) {
        return false;
    }
    // 交给系统调用前必须补 NUL（否则读到的是缓冲区后面的垃圾）
    if !buf_append_byte(&p, 0) {
        return false;
    }
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    if !fs_read_file_all(p.ptr as &const byte, &text, 65536) || text.len == 0 {
        return false;
    }
    var arena_raw: &void = malloc(65536);
    defer { free(arena_raw); }
    if ((arena_raw as &byte) as usize) == 0 {
        return false;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, text.ptr, text.len, &root) {
        return false;
    }
    var iv: JsonValue = JsonValue.json_null();
    var n: i64 = 0;
    g.active_state = true;
    if js_obj_get(&root, "id", 2, &iv) && js_i64_of(&iv, &n) {
        g.id = n as i32;
    }
    if js_obj_get(&root, "revision", 8, &iv) && js_i64_of(&iv, &n) {
        g.revision = n as i32;
    }
    if js_obj_get(&root, "round", 5, &iv) && js_i64_of(&iv, &n) {
        g.round = n as i32;
    }
    if js_obj_get(&root, "maxRounds", 9, &iv) && js_i64_of(&iv, &n) {
        g.max_rounds = n as i32;
    }
    var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if js_obj_get_str(&root, "phase", 5, &sv) {
        goal_set_n(&g.phase, sv.ptr as &const byte, sv.len);
    }
    if js_obj_get_str(&root, "objective", 9, &sv) {
        goal_set_n(&g.objective, sv.ptr as &const byte, sv.len);
    }
    if js_obj_get_str(&root, "blocker", 7, &sv) {
        goal_set_n(&g.blocker, sv.ptr as &const byte, sv.len);
    }
    var bv: JsonValue = JsonValue.json_null();
    if js_obj_get(&root, "armed", 5, &bv) {
        g.armed = json_bool_of(&bv);
    }
    return true;
}

export fn goal_save(cfg: &const Config, g: &const Goal) bool {
    var p: Buf = buf_new(1200);
    defer { buf_free(&p); }
    if !goal_path(cfg, &p) {
        return false;
    }
    if !buf_append_byte(&p, 0) {
        return false;
    }
    var j: Buf = buf_new(4096);
    defer { buf_free(&j); }
    _ = buf_append_cstr(&j, "{\"id\":");
    _ = buf_append_i64(&j, g.id as i64);
    _ = buf_append_cstr(&j, ",\"revision\":");
    _ = buf_append_i64(&j, g.revision as i64);
    _ = buf_append_cstr(&j, ",\"phase\":");
    _ = jw_str_into(&j, g.phase.ptr as &const byte, g.phase.len);
    _ = buf_append_cstr(&j, ",\"objective\":");
    _ = jw_str_into(&j, g.objective.ptr as &const byte, g.objective.len);
    _ = buf_append_cstr(&j, ",\"round\":");
    _ = buf_append_i64(&j, g.round as i64);
    _ = buf_append_cstr(&j, ",\"maxRounds\":");
    _ = buf_append_i64(&j, g.max_rounds as i64);
    _ = buf_append_cstr(&j, ",\"blocker\":");
    _ = jw_str_into(&j, g.blocker.ptr as &const byte, g.blocker.len);
    _ = buf_append_cstr(&j, ",\"armed\":");
    if g.armed {
        _ = buf_append_cstr(&j, "true");
    } else {
        _ = buf_append_cstr(&j, "false");
    }
    _ = buf_append_cstr(&j, "}\n");
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(p.ptr as *const byte, flags, 420) catch {
        return false;
    };
    var ok: bool = true;
    if j.len > 0 {
        ok = write_all_fd(fd, j.ptr as &const byte, j.len);
    }
    _ = sys_close(fd) catch {};
    return ok;
}

// 把目标状态渲染成一段文本（get_goal 的输出）
// 注意：**不要**在这里 buf_reset —— 调用方会先写 "created …"/"updated …" 再追加渲染结果
//（之前 reset 过，前缀行被整段吃掉）
fn goal_render(g: &const Goal, out: &Buf) void {
    _ = buf_append_cstr(out, "goal_id = goal-");
    _ = buf_append_u64(out, g.id as u64);
    _ = buf_append_cstr(out, "\nrevision = ");
    _ = buf_append_u64(out, g.revision as u64);
    _ = buf_append_cstr(out, "\nphase = ");
    _ = buf_append(out, g.phase.ptr, g.phase.len);
    _ = buf_append_cstr(out, "\nround = ");
    _ = buf_append_u64(out, g.round as u64);
    _ = buf_append_cstr(out, " / ");
    _ = buf_append_u64(out, g.max_rounds as u64);
    _ = buf_append_cstr(out, "\narmed = ");
    if g.armed {
        _ = buf_append_cstr(out, "true");
    } else {
        _ = buf_append_cstr(out, "false");
    }
    _ = buf_append_cstr(out, "\nobjective = ");
    _ = buf_append(out, g.objective.ptr, g.objective.len);
    if g.blocker.len > 0 {
        _ = buf_append_cstr(out, "\nblocker_reason = ");
        _ = buf_append(out, g.blocker.ptr, g.blocker.len);
    }
    _ = buf_append_byte(out, 10);
}

export fn goal_tool_get(cfg: &const Config, out: &Buf) void {
    buf_reset(out);
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "no goal is set for this session");
        return;
    }
    goal_render(&g, out);
}

export fn goal_tool_create(cfg: &const Config, args: &const JsonValue, out: &Buf) void {
    var objective: Buf = buf_empty();
    defer { buf_free(&objective); }
    if !js_obj_get_str_unescaped(args, "objective", 9, &objective) || objective.len == 0 {
        _ = buf_append_cstr(out, "Error: invalid objective: expected a non-empty string");
        return;
    }
    var maxr: i32 = 20;
    var mv: JsonValue = JsonValue.json_null();
    var n: i64 = 0;
    if js_obj_get(args, "max_goal_rounds", 15, &mv) && js_i64_of(&mv, &n) && n > 0 {
        if n > 200 {
            n = 200;
        }
        maxr = n as i32;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    var prev: Goal = goal_empty();
    defer { goal_free(&prev); }
    var id: i32 = 1;
    if goal_load(cfg, &prev) {
        id = prev.id + 1;
    }
    g.active_state = true;
    g.id = id;
    g.revision = 1;
    g.phase = buf_new(16);
    _ = buf_append_cstr(&g.phase, "active");
    g.objective = buf_new(objective.len + 8);
    _ = buf_append(&g.objective, objective.ptr, objective.len);
    g.round = 0;
    g.max_rounds = maxr;
    g.blocker = buf_empty();
    g.armed = true;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal");
        return;
    }
    _ = buf_append_cstr(out, "created goal-");
    _ = buf_append_u64(out, g.id as u64);
    _ = buf_append_cstr(out, " (revision 1, phase active, maxGoalRounds ");
    _ = buf_append_u64(out, maxr as u64);
    _ = buf_append_cstr(out, ")\n");
    goal_render(&g, out);
}

export fn goal_tool_update(cfg: &const Config, args: &const JsonValue, out: &Buf) void {
    var gid: Buf = buf_empty();
    defer { buf_free(&gid); }
    if !js_obj_get_str_unescaped(args, "goal_id", 7, &gid) || gid.len == 0 {
        _ = buf_append_cstr(out, "Error: goal_id is required; call get_goal first and copy the exact id");
        return;
    }
    var rev: i64 = -1;
    var rv: JsonValue = JsonValue.json_null();
    if js_obj_get(args, "revision", 8, &rv) {
        _ = js_i64_of(&rv, &rev);
    }
    var action: Buf = buf_empty();
    defer { buf_free(&action); }
    if !js_obj_get_str_unescaped(args, "action", 6, &action) || action.len == 0 {
        _ = buf_append_cstr(out, "Error: action must be one of edit|pause|resume|complete|blocked");
        return;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "Error: no goal is set for this session");
        return;
    }
    // 精确匹配：id 与 revision 都要对
    var want_id: i32 = 0;
    const idok: bool = deleg_id_from_buf(&gid, &want_id);
    // goal-3 / 3 两种写法都接受
    if idok && want_id != g.id {
        _ = buf_append_cstr(out, "Error: stale goal_id (the current goal is goal-");
        _ = buf_append_u64(out, g.id as u64);
        _ = buf_append_cstr(out, ")");
        return;
    }
    if rev >= 0 && rev != (g.revision as i64) {
        _ = buf_append_cstr(out, "Error: stale revision (the current revision is ");
        _ = buf_append_u64(out, g.revision as u64);
        _ = buf_append_cstr(out, "); call get_goal again");
        return;
    }
    if bufx_eq_cstr(action.ptr as &const byte, action.len, "edit") {
        var nobj: Buf = buf_empty();
        defer { buf_free(&nobj); }
        if !js_obj_get_str_unescaped(args, "objective", 9, &nobj) || nobj.len == 0 {
            _ = buf_append_cstr(out, "Error: action edit requires a non-empty objective");
            return;
        }
        goal_set(&g.objective, nobj.ptr[0: nobj.len]);
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "pause") {
        goal_set_lit(&g.phase, "paused" as &const byte, 6);
        g.armed = false;
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "resume") {
        goal_set_lit(&g.phase, "active" as &const byte, 6);
        g.armed = true;
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "complete") {
        goal_set_lit(&g.phase, "complete" as &const byte, 8);
        g.armed = false;
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "blocked") {
        var reason: Buf = buf_empty();
        defer { buf_free(&reason); }
        if !js_obj_get_str_unescaped(args, "blocked_reason", 14, &reason) || reason.len == 0 {
            _ = buf_append_cstr(out, "Error: action blocked requires a concrete blocked_reason");
            return;
        }
        // DSH 的规则：同一个阻塞条件至少连续 3 轮才允许标记 blocked
        if g.round < 2 {
            _ = buf_append_cstr(out, "Error: blocked is rejected before at least 3 consecutive goal rounds (current round ");
            _ = buf_append_u64(out, g.round as u64);
            _ = buf_append_cstr(out, "); difficulty, uncertainty, or useful remaining work is not blocked");
            return;
        }
        goal_set_lit(&g.phase, "blocked" as &const byte, 7);
        goal_set(&g.blocker, reason.ptr[0: reason.len]);
        g.armed = false;
    } else {
        _ = buf_append_cstr(out, "Error: action must be one of edit|pause|resume|complete|blocked");
        return;
    }
    g.revision = g.revision + 1;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal");
        return;
    }
    _ = buf_append_cstr(out, "updated goal-");
    _ = buf_append_u64(out, g.id as u64);
    _ = buf_append_cstr(out, " → phase ");
    _ = buf_append(out, g.phase.ptr, g.phase.len);
    _ = buf_append_cstr(out, " (revision ");
    _ = buf_append_u64(out, g.revision as u64);
    _ = buf_append_cstr(out, ")\n");
    goal_render(&g, out);
}

// 本轮结束时调用：轮次 +1（自动续跑的计数）
export fn goal_tick(cfg: &const Config) void {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        return;
    }
    g.round = g.round + 1;
    if g.round >= g.max_rounds && g.armed {
        g.armed = false;
    }
    _ = goal_save(cfg, &g);
}
