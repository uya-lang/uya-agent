// src/goal.uya — 会话级目标（P11，对齐 DSH 的 goal 工具）
//
// 目标存在 agent_home 下的 goal.json 里，跨进程可读；字段：objective / phase /
// round / maxRounds / blocker / revision / id。update_goal 要求**精确的 id 与 revision**
// （取值前必须先 get_goal），这样并发/过期写入会被挡住。
//
// phase：active（自动续跑）/ paused / complete / blocked

use libc.syscall;
use libc.unistd;

export struct Goal {
    active_state: bool,     // 是否已经创建
    id: i32,
    revision: i32,
    phase: Buf,             // active / paused / complete / blocked
    objective: Buf,
    round: i32,
    max_rounds: i32,
    blocker: Buf,
    armed: bool,            // 是否还有自动续跑
}

export fn goal_empty() Goal {
    return Goal{
        active_state: false,
        id: 0,
        revision: 0,
        phase: buf_empty(),
        objective: buf_empty(),
        round: 0,
        max_rounds: 20,
        blocker: buf_empty(),
        armed: false,
    };
}

export fn goal_free(g: &Goal) void {
    buf_free(&g.phase);
    buf_free(&g.objective);
    buf_free(&g.blocker);
}

fn goal_path(cfg: &const Config, out: &Buf) bool {
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        return false;
    }
    buf_reset(out);
    _ = buf_append(&out[0], home.ptr, home.len);
    return buf_append_cstr(out, "/goal.json");
}

fn goal_set(dst: &Buf, src: &[byte]) void {
    buf_reset(dst);
    if src.len > 0 {
        _ = buf_append(dst, src.ptr, src.len);
    }
}

// 「指针 + 长度」版本（JsonStrView 与字符串字面量都走这里；
// 写 `ptr as &const byte[0: n]` 会被解析成别的意思，别用）
fn goal_set_n(dst: &Buf, p: &const byte, n: usize) void {
    buf_reset(dst);
    if n > 0 {
        _ = buf_append(dst, p, n);
    }
}

fn goal_set_lit(dst: &Buf, lit: &const byte, n: usize) void {
    goal_set_n(dst, lit, n);
}

export fn goal_load(cfg: &const Config, g: &Goal) bool {
    var p: Buf = buf_new(1200);
    defer { buf_free(&p); }
    if !goal_path(cfg, &p) {
        return false;
    }
    // 交给系统调用前必须补 NUL（否则读到的是缓冲区后面的垃圾）
    if !buf_append_byte(&p, 0) {
        return false;
    }
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    if !fs_read_file_all(p.ptr as &const byte, &text, 65536) || text.len == 0 {
        return false;
    }
    var arena_raw: &void = malloc(65536);
    defer { free(arena_raw); }
    if ((arena_raw as &byte) as usize) == 0 {
        return false;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, text.ptr, text.len, &root) {
        return false;
    }
    var iv: JsonValue = JsonValue.json_null();
    var n: i64 = 0;
    g.active_state = true;
    if js_obj_get(&root, "id", 2, &iv) && js_i64_of(&iv, &n) {
        g.id = n as i32;
    }
    if js_obj_get(&root, "revision", 8, &iv) && js_i64_of(&iv, &n) {
        g.revision = n as i32;
    }
    if js_obj_get(&root, "round", 5, &iv) && js_i64_of(&iv, &n) {
        g.round = n as i32;
    }
    if js_obj_get(&root, "maxRounds", 9, &iv) && js_i64_of(&iv, &n) {
        g.max_rounds = n as i32;
    }
    var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if js_obj_get_str(&root, "phase", 5, &sv) {
        goal_set_n(&g.phase, sv.ptr as &const byte, sv.len);
    }
    if js_obj_get_str(&root, "objective", 9, &sv) {
        goal_set_n(&g.objective, sv.ptr as &const byte, sv.len);
    }
    if js_obj_get_str(&root, "blocker", 7, &sv) {
        goal_set_n(&g.blocker, sv.ptr as &const byte, sv.len);
    }
    var bv: JsonValue = JsonValue.json_null();
    if js_obj_get(&root, "armed", 5, &bv) {
        g.armed = json_bool_of(&bv);
    }
    return true;
}

export fn goal_save(cfg: &const Config, g: &const Goal) bool {
    var p: Buf = buf_new(1200);
    defer { buf_free(&p); }
    if !goal_path(cfg, &p) {
        return false;
    }
    if !buf_append_byte(&p, 0) {
        return false;
    }
    var j: Buf = buf_new(4096);
    defer { buf_free(&j); }
    _ = buf_append_cstr(&j, "{\"id\":");
    _ = buf_append_i64(&j, g.id as i64);
    _ = buf_append_cstr(&j, ",\"revision\":");
    _ = buf_append_i64(&j, g.revision as i64);
    _ = buf_append_cstr(&j, ",\"phase\":");
    _ = jw_str_into(&j, g.phase.ptr as &const byte, g.phase.len);
    _ = buf_append_cstr(&j, ",\"objective\":");
    _ = jw_str_into(&j, g.objective.ptr as &const byte, g.objective.len);
    _ = buf_append_cstr(&j, ",\"round\":");
    _ = buf_append_i64(&j, g.round as i64);
    _ = buf_append_cstr(&j, ",\"maxRounds\":");
    _ = buf_append_i64(&j, g.max_rounds as i64);
    _ = buf_append_cstr(&j, ",\"blocker\":");
    _ = jw_str_into(&j, g.blocker.ptr as &const byte, g.blocker.len);
    _ = buf_append_cstr(&j, ",\"armed\":");
    if g.armed {
        _ = buf_append_cstr(&j, "true");
    } else {
        _ = buf_append_cstr(&j, "false");
    }
    _ = buf_append_cstr(&j, "}\n");
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(p.ptr as *const byte, flags, 420) catch {
        return false;
    };
    var ok: bool = true;
    if j.len > 0 {
        ok = write_all_fd(fd, j.ptr as &const byte, j.len);
    }
    _ = sys_close(fd) catch {};
    return ok;
}

// 把目标状态渲染成一段文本（get_goal 的输出）
// 注意：**不要**在这里 buf_reset —— 调用方会先写 "created …"/"updated …" 再追加渲染结果
//（之前 reset 过，前缀行被整段吃掉）
fn goal_render(g: &const Goal, out: &Buf) void {
    _ = buf_append_cstr(out, "goal_id = goal-");
    _ = buf_append_u64(out, g.id as u64);
    _ = buf_append_cstr(out, "\nrevision = ");
    _ = buf_append_u64(out, g.revision as u64);
    _ = buf_append_cstr(out, "\nphase = ");
    _ = buf_append(out, g.phase.ptr, g.phase.len);
    _ = buf_append_cstr(out, "\nround = ");
    _ = buf_append_u64(out, g.round as u64);
    _ = buf_append_cstr(out, " / ");
    _ = buf_append_u64(out, g.max_rounds as u64);
    _ = buf_append_cstr(out, "\narmed = ");
    if g.armed {
        _ = buf_append_cstr(out, "true");
    } else {
        _ = buf_append_cstr(out, "false");
    }
    _ = buf_append_cstr(out, "\nobjective = ");
    _ = buf_append(out, g.objective.ptr, g.objective.len);
    if g.blocker.len > 0 {
        _ = buf_append_cstr(out, "\nblocker_reason = ");
        _ = buf_append(out, g.blocker.ptr, g.blocker.len);
    }
    _ = buf_append_byte(out, 10);
}

export fn goal_tool_get(cfg: &const Config, out: &Buf) void {
    buf_reset(out);
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "no goal is set for this session");
        return;
    }
    goal_render(&g, out);
}

export fn goal_tool_create(cfg: &const Config, args: &const JsonValue, out: &Buf) void {
    var objective: Buf = buf_empty();
    defer { buf_free(&objective); }
    if !js_obj_get_str_unescaped(args, "objective", 9, &objective) || objective.len == 0 {
        _ = buf_append_cstr(out, "Error: invalid objective: expected a non-empty string");
        return;
    }
    var maxr: i32 = 20;
    var mv: JsonValue = JsonValue.json_null();
    var n: i64 = 0;
    if js_obj_get(args, "max_goal_rounds", 15, &mv) && js_i64_of(&mv, &n) && n > 0 {
        if n > 200 {
            n = 200;
        }
        maxr = n as i32;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    var prev: Goal = goal_empty();
    defer { goal_free(&prev); }
    var id: i32 = 1;
    if goal_load(cfg, &prev) {
        id = prev.id + 1;
    }
    g.active_state = true;
    g.id = id;
    g.revision = 1;
    g.phase = buf_new(16);
    _ = buf_append_cstr(&g.phase, "active");
    g.objective = buf_new(objective.len + 8);
    _ = buf_append(&g.objective, objective.ptr, objective.len);
    g.round = 0;
    g.max_rounds = maxr;
    g.blocker = buf_empty();
    g.armed = true;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal");
        return;
    }
    _ = buf_append_cstr(out, "created goal-");
    _ = buf_append_u64(out, g.id as u64);
    _ = buf_append_cstr(out, " (revision 1, phase active, maxGoalRounds ");
    _ = buf_append_u64(out, maxr as u64);
    _ = buf_append_cstr(out, ")\n");
    goal_render(&g, out);
}

export fn goal_tool_update(cfg: &const Config, args: &const JsonValue, out: &Buf) void {
    var gid: Buf = buf_empty();
    defer { buf_free(&gid); }
    if !js_obj_get_str_unescaped(args, "goal_id", 7, &gid) || gid.len == 0 {
        _ = buf_append_cstr(out, "Error: goal_id is required; call get_goal first and copy the exact id");
        return;
    }
    var rev: i64 = -1;
    var rv: JsonValue = JsonValue.json_null();
    if js_obj_get(args, "revision", 8, &rv) {
        _ = js_i64_of(&rv, &rev);
    }
    var action: Buf = buf_empty();
    defer { buf_free(&action); }
    if !js_obj_get_str_unescaped(args, "action", 6, &action) || action.len == 0 {
        _ = buf_append_cstr(out, "Error: action must be one of edit|pause|resume|complete|blocked");
        return;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "Error: no goal is set for this session");
        return;
    }
    // 精确匹配：id 与 revision 都要对
    var want_id: i32 = 0;
    const idok: bool = deleg_id_from_buf(&gid, &want_id);
    // goal-3 / 3 两种写法都接受
    if idok && want_id != g.id {
        _ = buf_append_cstr(out, "Error: stale goal_id (the current goal is goal-");
        _ = buf_append_u64(out, g.id as u64);
        _ = buf_append_cstr(out, ")");
        return;
    }
    if rev >= 0 && rev != (g.revision as i64) {
        _ = buf_append_cstr(out, "Error: stale revision (the current revision is ");
        _ = buf_append_u64(out, g.revision as u64);
        _ = buf_append_cstr(out, "); call get_goal again");
        return;
    }
    if bufx_eq_cstr(action.ptr as &const byte, action.len, "edit") {
        var nobj: Buf = buf_empty();
        defer { buf_free(&nobj); }
        if !js_obj_get_str_unescaped(args, "objective", 9, &nobj) || nobj.len == 0 {
            _ = buf_append_cstr(out, "Error: action edit requires a non-empty objective");
            return;
        }
        goal_set(&g.objective, nobj.ptr[0: nobj.len]);
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "pause") {
        goal_set_lit(&g.phase, "paused" as &const byte, 6);
        g.armed = false;
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "resume") {
        goal_set_lit(&g.phase, "active" as &const byte, 6);
        g.armed = true;
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "complete") {
        goal_set_lit(&g.phase, "complete" as &const byte, 8);
        g.armed = false;
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "blocked") {
        var reason: Buf = buf_empty();
        defer { buf_free(&reason); }
        if !js_obj_get_str_unescaped(args, "blocked_reason", 14, &reason) || reason.len == 0 {
            _ = buf_append_cstr(out, "Error: action blocked requires a concrete blocked_reason");
            return;
        }
        // DSH 的规则：同一个阻塞条件至少连续 3 轮才允许标记 blocked
        if g.round < 2 {
            _ = buf_append_cstr(out, "Error: blocked is rejected before at least 3 consecutive goal rounds (current round ");
            _ = buf_append_u64(out, g.round as u64);
            _ = buf_append_cstr(out, "); difficulty, uncertainty, or useful remaining work is not blocked");
            return;
        }
        goal_set_lit(&g.phase, "blocked" as &const byte, 7);
        goal_set(&g.blocker, reason.ptr[0: reason.len]);
        g.armed = false;
    } else {
        _ = buf_append_cstr(out, "Error: action must be one of edit|pause|resume|complete|blocked");
        return;
    }
    g.revision = g.revision + 1;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal");
        return;
    }
    _ = buf_append_cstr(out, "updated goal-");
    _ = buf_append_u64(out, g.id as u64);
    _ = buf_append_cstr(out, " → phase ");
    _ = buf_append(out, g.phase.ptr, g.phase.len);
    _ = buf_append_cstr(out, " (revision ");
    _ = buf_append_u64(out, g.revision as u64);
    _ = buf_append_cstr(out, ")\n");
    goal_render(&g, out);
}

// 本轮结束时调用：轮次 +1（自动续跑的计数）
export fn goal_tick(cfg: &const Config) void {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        return;
    }
    g.round = g.round + 1;
    if g.round >= g.max_rounds && g.armed {
        g.armed = false;
    }
    _ = goal_save(cfg, &g);
}

// ============================================================
// /goal：人类命令面（P29，语法与措辞对齐 DSH 的 commands/command-goal）
// ============================================================
//
//   /goal                        看状态；没有 goal 时报用法
//   /goal <objective>            创建；已有**未完成**的 goal 时拒绝（必须先 edit 或 clear）
//   /goal edit <objective>       改目标（phase / armed 不动）；complete 的 goal 换新身份
//   /goal pause | resume         暂停 / 恢复（armed 跟着翻）
//   /goal clear                  清除（删掉 goal.json）
//
// 只有控制词**独占整行**时才不区分大小写，其余任何非空后缀都是字面目标 ——
// 所以 `/goal pause after verification` 创建的就是那个字面目标，而不是「暂停 + 备注」。
//
// 与模型工具的关系：共用同一份 goal.json。工具走 CAS（id + revision 都要对，挡住过期写入），
// 人类命令直接以「当前」为准 —— 人在回路里不存在读过期值这回事，那份 ref 只是给模型的护栏。
//
// clear 是**删文件**：本仓库里「没有 goal.json」与「从未建过目标」本来就是同一个状态
// （goal_load 返回 false），不留 tombstone；代价是 clear 之后 id 从 1 重新开始。

export const GOAL_USAGE: &const byte =
    "Usage: /goal [<objective>|clear|edit <objective>|pause|resume]" as &const byte;

// 人类命令的默认轮次上限（与 goal_tool_create 同口径；工具面还能用 max_goal_rounds 覆写）
const GOAL_CMD_MAX_ROUNDS: i32 = 20;

fn goal_is_space(c: byte) bool {
    return c == 32 as byte || c == 9 as byte || c == 10 as byte || c == 13 as byte;
}

// 去掉 [from, n) 的首尾空白，返回绝对下标 [s_out, e_out)（全空白时两者相等）
fn goal_trim(p: &const byte, from: usize, n: usize, s_out: &usize, e_out: &usize) void {
    var s: usize = from;
    while s < n && goal_is_space(p[s]) {
        s = s + 1;
    }
    var e: usize = n;
    while e > s && goal_is_space(p[e - 1]) {
        e = e - 1;
    }
    s_out[0] = s;
    e_out[0] = e;
}

// 整段 [s, e) 是否就是这个控制词（大小写不敏感）。
// 长度从字面量自己量（bufx_cstr_len）—— 手写长度写大了会读进相邻常量，见 README 踩坑 3。
fn goal_word_eq(p: &const byte, s: usize, e: usize, lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    if e - s != ln {
        return false;
    }
    var i: usize = 0;
    while i < ln {
        if byte_lower(p[s + i]) != byte_lower(lit[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn goal_phase_is(g: &const Goal, lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    return g.phase.len == ln && bufx_eq_cstr(g.phase.ptr as &const byte, ln, lit);
}

// `/goal edit <objective>`：前缀是 "edit" 且**紧跟空白**（大小写不敏感），
// 命中就把替换目标的 [rs, re)（已去空白）交出去
fn goal_edit_span(p: &const byte, s: usize, e: usize, rs: &usize, re: &usize) bool {
    if e < s + 5 {                       // "edit" + 至少一个空白字符
        return false;
    }
    if !goal_word_eq(p, s, s + 4, "edit" as &const byte) {
        return false;
    }
    if !goal_is_space(p[s + 4]) {
        return false;
    }
    goal_trim(p, s + 4, e, rs, re);
    return true;
}

// 用 p[s, e) 替换 dst 的内容（buf_append_span 是**追加**语义，所以先 reset）
fn goal_set_span(dst: &Buf, p: &const byte, s: usize, e: usize) void {
    buf_reset(dst);
    if e > s {
        _ = buf_append_span(dst, p, s, e - s);
    }
}

// clear：删掉 goal.json（失败只有一种可能：文件系统不给删）
export fn goal_clear(cfg: &const Config) bool {
    var p: Buf = buf_new(1200);
    defer { buf_free(&p); }
    if !goal_path(cfg, &p) {
        return false;
    }
    if !buf_append_byte(&p, 0) {         // 系统调用前必须补 NUL，见 README 踩坑 2
        return false;
    }
    _ = sys_unlink(&p.ptr[0] as *const byte) catch {
        return false;
    };
    return true;
}

// 人类看的正文（与工具面的 goal_render 分开：这里是 DSH 同款的键值对排版）
fn goal_render_user(g: &const Goal, out: &Buf) void {
    _ = buf_append_cstr(out, "Status: ");
    _ = buf_append(out, g.phase.ptr, g.phase.len);
    if goal_phase_is(g, "blocked" as &const byte) && g.blocker.len > 0 {
        _ = buf_append_cstr(out, "\nBlocker: ");
        _ = buf_append(out, g.blocker.ptr, g.blocker.len);
    }
    _ = buf_append_cstr(out, "\nObjective: ");
    _ = buf_append(out, g.objective.ptr, g.objective.len);
    _ = buf_append_cstr(out, "\nRounds: ");
    _ = buf_append_u64(out, g.round as u64);
    _ = buf_append_cstr(out, "/");
    _ = buf_append_u64(out, g.max_rounds as u64);
    _ = buf_append_cstr(out, "\nActivation: ");
    if g.armed {
        _ = buf_append_cstr(out, "armed");
    } else {
        _ = buf_append_cstr(out, "disarmed");
    }
    _ = buf_append_cstr(out, "\n\nCommands: ");
    if goal_phase_is(g, "active" as &const byte) {
        if g.armed {
            _ = buf_append_cstr(out, "/goal edit <objective>, /goal pause, /goal clear");
        } else {
            _ = buf_append_cstr(out, "/goal edit <objective>, /goal resume, /goal clear");
        }
    } else if goal_phase_is(g, "complete" as &const byte) {
        _ = buf_append_cstr(out, "/goal <objective>, /goal clear");
    } else {                             // paused / blocked
        _ = buf_append_cstr(out, "/goal edit <objective>, /goal resume, /goal clear");
    }
    _ = buf_append_byte(out, 10);
}

fn goal_cmd_need_objective(out: &Buf) i32 {
    _ = buf_append_cstr(out, "Goal editing requires a replacement objective.\n");
    _ = buf_append_cstr(out, GOAL_USAGE);
    _ = buf_append_byte(out, 10);
    return 1;
}

fn goal_cmd_missing(out: &Buf, verb: &const byte) i32 {
    _ = buf_append_cstr(out, "No goal is currently set; /goal ");
    _ = buf_append_cstr(out, verb);
    _ = buf_append_cstr(out, " requires one.\n");
    _ = buf_append_cstr(out, GOAL_USAGE);
    _ = buf_append_byte(out, 10);
    return 1;
}

// 裸 /goal：有目标报状态，没有就报用法（两者都是成功 —— 看状态本身不会失败）
fn goal_cmd_show(cfg: &const Config, out: &Buf) i32 {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "No goal is currently set.\n");
        _ = buf_append_cstr(out, GOAL_USAGE);
        _ = buf_append_byte(out, 10);
        return 0;
    }
    _ = buf_append_cstr(out, "Goal\n");
    goal_render_user(&g, out);
    return 0;
}

// 创建：已有**未完成**的 goal 时拒绝（DSH 同一条规则：必须先 edit 或 clear）。
// 已完成的 goal 让位 —— 新的目标换新身份（id +1，revision 回到 1）。
fn goal_cmd_create(cfg: &const Config, p: &const byte, s: usize, e: usize, out: &Buf) i32 {
    var cur: Goal = goal_empty();
    defer { goal_free(&cur); }
    var id: i32 = 1;
    if goal_load(cfg, &cur) {
        if !goal_phase_is(&cur, "complete" as &const byte) {
            _ = buf_append_cstr(out, "A goal is already ");
            _ = buf_append(out, cur.phase.ptr, cur.phase.len);
            _ = buf_append_cstr(out,
                ". Use /goal edit <objective> to change it or /goal clear before replacing it.\n");
            return 1;
        }
        id = cur.id + 1;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    g.active_state = true;
    g.id = id;
    g.revision = 1;
    g.phase = buf_new(16);
    _ = buf_append_cstr(&g.phase, "active");
    g.objective = buf_new(e - s + 8);
    _ = goal_set_span(&g.objective, p, s, e);
    g.round = 0;
    g.max_rounds = GOAL_CMD_MAX_ROUNDS;
    g.blocker = buf_empty();
    g.armed = true;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal\n");
        return 1;
    }
    _ = buf_append_cstr(out, "Goal created\n");
    goal_render_user(&g, out);
    return 0;
}

// 改目标：phase / armed / round 都不动，只换 objective 并 +1 revision
fn goal_cmd_edit(cfg: &const Config, p: &const byte, s: usize, e: usize, out: &Buf) i32 {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        return goal_cmd_missing(out, "edit" as &const byte);
    }
    if goal_phase_is(&g, "complete" as &const byte) {
        return goal_cmd_create(cfg, p, s, e, out);   // 已完成：edit 就是换一个新目标
    }
    goal_set_span(&g.objective, p, s, e);
    g.revision = g.revision + 1;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal\n");
        return 1;
    }
    _ = buf_append_cstr(out, "Goal updated\n");
    goal_render_user(&g, out);
    return 0;
}

// pause / resume：phase 与 armed 一起翻（armed=false 才是「不会自动续跑」的那个开关）
fn goal_cmd_switch(cfg: &const Config, out: &Buf, armed: bool, verb: &const byte,
        phase: &const byte, title: &const byte) i32 {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        return goal_cmd_missing(out, verb);
    }
    goal_set_lit(&g.phase, phase, bufx_cstr_len(phase));
    g.armed = armed;
    g.revision = g.revision + 1;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal\n");
        return 1;
    }
    _ = buf_append_cstr(out, title);
    _ = buf_append_byte(out, 10);
    goal_render_user(&g, out);
    return 0;
}

// clear：没有目标时也算成功（幂等），只是回一句「没得清」
fn goal_cmd_clear(cfg: &const Config, out: &Buf) i32 {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "No goal to clear.\n");
        return 0;
    }
    if !goal_clear(cfg) {
        _ = buf_append_cstr(out, "Error: cannot remove the goal file\n");
        return 1;
    }
    _ = buf_append_cstr(out, "Goal cleared.\n");
    return 0;
}

// 执行一条人类 /goal 命令。line 是**整行**（含命令名，如 "/goal edit 把测试跑绿"）。
// out 会被重置：返回 0 = 成功，1 = 用法或状态错误 —— 两种情况都把可直接展示的正文写进 out，
// 调用方不需要自己拼字符串（滚动模式打出来，TUI 塞进浮层）。
export fn goal_cmd_run(cfg: &const Config, line: &const Buf, out: &Buf) i32 {
    buf_reset(out);
    const p: &const byte = line.ptr as &const byte;
    const n: usize = line.len;
    if n < 5 {                           // 调用方只会把 "/goal…" 送进来，防一手
        _ = buf_append_cstr(out, GOAL_USAGE);
        _ = buf_append_byte(out, 10);
        return 1;
    }
    var s: usize = 0;
    var e: usize = 0;
    goal_trim(p, 5, n, &s, &e);          // 跳过 "/goal" 这 5 个字节
    if e == s {                          // 裸 /goal = 看状态
        return goal_cmd_show(cfg, out);
    }
    if goal_word_eq(p, s, e, "clear" as &const byte) {
        return goal_cmd_clear(cfg, out);
    }
    if goal_word_eq(p, s, e, "pause" as &const byte) {
        return goal_cmd_switch(cfg, out, false, "pause" as &const byte,
            "paused" as &const byte, "Goal paused" as &const byte);
    }
    if goal_word_eq(p, s, e, "resume" as &const byte) {
        return goal_cmd_switch(cfg, out, true, "resume" as &const byte,
            "active" as &const byte, "Goal resumed" as &const byte);
    }
    if goal_word_eq(p, s, e, "edit" as &const byte) {
        return goal_cmd_need_objective(out);   // 只有 "edit"、没有替换内容
    }
    var rs: usize = 0;
    var re: usize = 0;
    if goal_edit_span(p, s, e, &rs, &re) {
        if re == rs {
            return goal_cmd_need_objective(out);
        }
        return goal_cmd_edit(cfg, p, rs, re, out);
    }
    return goal_cmd_create(cfg, p, s, e, out);
}
