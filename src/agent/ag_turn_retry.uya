// src/agent/ag_turn_retry.uya — 回合没收完就自动继续（P94 / P96）
//
// 本文件：`agent_turn_loop` 外面那一层「失败 → 说清 → 退避 → 替人打一句继续 → 再跑一个
//   回合」。判据（`tr_should`）、退避与中断（`turn_retry_after`）、账（`tr_note` 的转录行与
//   `tr_log` 的 `turn/retry` 事件）都在这里。
// 不变量：① **所有「没跑完」的收场都自动继续**（P96）：协议错、传输错、工具错、被 token
//   上限截断（有正文那种）、模型空响应 —— 只有 `AGENT_OK`（跑完了）与 `AGENT_INTERRUPTED`
//   （人按了 esc / ctrl+c）不收；② 预算**出厂不限**（`RTX_UNLIMITED`）：这个功能的
//   验收口径就是「一直续到成功，或者我按停」，所以正常情况只有人能叫停它；
//   CI / 脚本要 fail fast 就 `--turn-retry-max 0` / `UYA_AGENT_TURN_RETRY_MAX=0`
//   （与 `--api-retry-max` 同口径）；
//   ③ **没人能叫停的场合不续跑**（非交互：管道、CI、子代理）—— 那儿续跑就是挂死，与
//   `agent_goal_drive` 的「只在有人在键盘前的前台会话里跑」同一条纪律；④ 退避与传输层重试
//   用**同一套数值**（0.5–3 s 随机，`net/retryx`）与同一条可中断等待（≤50 ms 切片 + 泵点），
//   所以 esc / ctrl+c 当场收口 ——「自动重试」不许变成「按了没反应」；⑤ 人已经要停 / 要退出
//   （`tui_abort_state()` 非 NONE）时**一次都不续**。
// 依赖：net/retryx（退避区间与随机取值）、agent/ag_request_stream（`agent_rtx_wait`
//   的可中断等待、`RTX_GO_*` 三态与 `g_interactive`）、term/tui（`tui_abort_state`）、
//   会话日志（`sess_begin`/`sess_end`）、历史写入
//   （`agent_push_user_with_imgs`/`agent_log_user_att`）。
// 命名：对外 `turn_retry_*` + 常量 `TURN_RETRY_MAX`；私有 `tr_*`。
//
// 为什么要有这个文件（用户报的现场）：异常收尾时屏幕上只说一句「本回合异常结束（可直接
// 输入继续）」，而**人接着敲一句「继续」通常就好了** —— 那件事机器自己能做。第一版（P94）
// 只对「模型空响应」开闸；用户随即补了一句「所有自动继续，直到成功或者我主动中断」，
// P96 因此把闸门放开到「所有没收完的回合」，并把预算从两次改成不限。

// 出厂预算 = **不限次数**（与传输层重试同一个值）。理由见文件头 ②：任何固定次数都只是把
// 「人还得再敲一次继续」往后挪几格。
export const TURN_RETRY_MAX: i32 = RTX_UNLIMITED;

// 提示位：本回合为什么值得再跑一次。0 = 没定性（判据只看退出码）。
const TR_HINT_NONE: i32 = 0;
// 模型空响应：正文与 tool_calls 都没有，本步的同一步重发额度也用尽了。
const TR_HINT_DEGENERATE: i32 = 1;
// 被 token 上限截断，但**有正文**：接着输出正是人会说「继续」的那件事。
// 一个字节正文都没有的截断留成 NONE —— 那一档再跑一次只是把同一笔钱再花一遍。
const TR_HINT_TRUNCATED: i32 = 2;

// 自动继续塞进历史的那句话：与 `/continue` **逐字相同** —— 人打的是什么，机器打的就是
// 什么（历史形状、模型看到的东西、会话日志三样因此都一样）。
const TR_CONTINUE: &const byte = "继续" as &const byte;

// 预算（进程级：`turn_retry_set_max` 写、`tr_should` 读）。
var g_turn_retry_max: i32 = TURN_RETRY_MAX;
// 人（CLI / env）或自测**显式**设过预算吗。没设过且这一进程又不在交互态 ⇒ 一次都不续
// （不变量③：没人能叫停的地方不续，否则管道里一个必然失败的请求就是挂死）。
var g_turn_retry_set: bool = false;
// 本回合的提示位（回合入口清、失败那一刻置）。
var g_turn_retry_hint: i32 = TR_HINT_NONE;

// 设预算：`RTX_UNLIMITED` = 不限、0 = 关、N > 0 = 最多自动继续 N 次。
// 负数（除 -1）按「关」处理：不自作主张把 `-2` 当不限（那是 CI 里最危险的一档）。
export fn turn_retry_set_max(n: i32) void {
    g_turn_retry_set = true;
    if n < 0 && n != RTX_UNLIMITED {
        g_turn_retry_max = 0;
        return;
    }
    g_turn_retry_max = n;
}

// 当前预算（排障与 `--print-config` 用；判据读的是同一个全局量）。
export fn turn_retry_max() i32 {
    return g_turn_retry_max;
}

// 回合入口复位提示位。**每一回合都必须清**：上一回合留下的「空响应」不能给这一回合的
// 401 当通行证 —— 那会让一个确定性的错被自动重跑（预算花在一个必然失败的请求上）。
// 另外两位（`g_turn_retry_max` / `g_turn_retry_set`）是**人的选择**，不在这里动。
export fn turn_retry_clear() void {
    g_turn_retry_hint = TR_HINT_NONE;
}

// 记一笔「这一回合是模型空响应收的场」（`agent_note_degenerate` 在额度用尽时调它）。
export fn turn_retry_note_degenerate() void {
    g_turn_retry_hint = TR_HINT_DEGENERATE;
}

// 记一笔「这一回合是被输出上限截断的，而且已经产出了正文」（`agent_finish_step` 调它）。
export fn turn_retry_note_truncated() void {
    g_turn_retry_hint = TR_HINT_TRUNCATED;
}

// 要不要自动继续：跑完了 / 人叫停 / 使用错误都不续，其余一律续（预算见文件头 ②③）。
// 判据写在一个函数里（而不是散在 step 循环里），是为了「哪些失败会自动继续」只有一份答案。
fn tr_should(rc: i32, attempt: i32) bool {
    if rc == AGENT_OK || rc == AGENT_INTERRUPTED || rc == AGENT_USAGE {
        return false;
    }
    // 人按了 esc / ctrl+c，或者要退出（ctrl+d / /exit）：一个字都不许再发。
    if tui_abort_state() != TUI_ABORT_NONE {
        return false;
    }
    // 一个字节正文都没有的截断：再发一次只是重复花同一笔钱，交回人手。
    if rc == AGENT_MAX_TOKENS && g_turn_retry_hint != TR_HINT_TRUNCATED {
        return false;
    }
    // 没人能叫停的场合（管道 / CI / 子代理）默认不续；显式设过预算就听人的。
    if !g_turn_retry_set && !g_interactive {
        return false;
    }
    if g_turn_retry_max == RTX_UNLIMITED {
        return true;
    }
    if g_turn_retry_max <= 0 {
        return false;
    }
    return attempt < g_turn_retry_max;
}

// 屏幕上那句「为什么又跑一次」的原因（给人看的）。
fn tr_why(rc: i32) &const byte {
    if rc == AGENT_MAX_TOKENS {
        return "模型输出被 token 上限截断" as &const byte;
    }
    if rc == AGENT_NET {
        return "这一回合栽在传输层（网络 / TLS / 流早断）" as &const byte;
    }
    if rc == AGENT_TOOL {
        return "这一回合栽在工具层" as &const byte;
    }
    if g_turn_retry_hint == TR_HINT_DEGENERATE {
        return "模型空响应（无正文、无工具调用）" as &const byte;
    }
    return "这一回合按协议错收场" as &const byte;
}

// 同一条原因在会话日志里的机器名（`reason` 字段，事后按它分组统计）。
fn tr_reason_name(rc: i32) &const byte {
    if rc == AGENT_MAX_TOKENS {
        return "truncated" as &const byte;
    }
    if rc == AGENT_NET {
        return "network-error" as &const byte;
    }
    if rc == AGENT_TOOL {
        return "tool-error" as &const byte;
    }
    if g_turn_retry_hint == TR_HINT_DEGENERATE {
        return "degenerate-response" as &const byte;
    }
    return "protocol-error" as &const byte;
}

// 转录里那一行：说清「为什么又跑一次、第几次、等多久、怎么停」。
// --quiet 也照打 —— 它是「屏幕为什么又动起来了」的唯一解释（与 `[retry]` 那条同口径）。
fn tr_note(cfg: &const Config, attempt: i32, wait_ms: i32, rc: i32) void {
    out_err("[turn-retry] ");
    out_err(tr_why(rc));
    out_err("——自动替你打一句「继续」再跑一回合（第 ");
    out_err_dec(attempt as usize);
    if g_turn_retry_max == RTX_UNLIMITED {
        out_err(" 次，不限次数，backoff=");
    } else {
        out_err("/");
        out_err_dec(g_turn_retry_max as usize);
        out_err(" 次，backoff=");
    }
    out_err_dec((wait_ms / 1000) as usize);
    out_err(".");
    out_err_dec(((wait_ms % 1000) / 100) as usize);
    out_err("s；esc/ctrl+c 可停）\n");
    if cfg.tui && tui_active() {
        var note: Buf = buf_new(128);
        if buf_valid(&note) {
            _ = buf_append_cstr(&note, "自动继续（第 ");
            _ = buf_append_u64(&note, attempt as u64);
            _ = buf_append_cstr(&note, " 次）");
            tui_add_notice(note.ptr as &const byte, note.len);
            buf_free(&note);
        }
    }
}

// 同一条账进会话日志（`turn/retry`）：resume / 事后排障看的就是它。
// 形状与 `llm/retry` 一致（attempt / maxRetries / reason / backoffMs），另加 `rc`
// （这一回合是按哪个退出码收的场）—— 它记的是**回合级**那一次「替人打了继续」，
// 不是同一请求的重发。
fn tr_log(attempt: i32, wait_ms: i32, rc: i32) void {
    if !g_sess.save {
        return;
    }
    var ev: Buf = buf_new(512);
    defer { buf_free(&ev); }
    if !sess_begin(&g_sess, "turn/retry", &ev) {
        return;
    }
    _ = buf_append_cstr(&ev, "{\"turn\":");
    _ = buf_append_i64(&ev, g_turn as i64);
    _ = buf_append_cstr(&ev, ",\"attempt\":");
    _ = buf_append_i64(&ev, attempt as i64);
    _ = buf_append_cstr(&ev, ",\"maxRetries\":");
    _ = buf_append_i64(&ev, g_turn_retry_max as i64);
    _ = buf_append_cstr(&ev, ",\"reason\":");
    const why: &const byte = tr_reason_name(rc);
    _ = jw_str_into(&ev, why, bufx_cstr_len(why));
    _ = buf_append_cstr(&ev, ",\"rc\":");
    _ = buf_append_i64(&ev, rc as i64);
    _ = buf_append_cstr(&ev, ",\"backoffMs\":");
    _ = buf_append_i64(&ev, wait_ms as i64);
    _ = buf_append_cstr(&ev, "}");
    _ = sess_end(&g_sess, &ev);
}

// 一次自动继续：先说清 + 记账 + 退避（可中断）+ 把「继续」压进历史。
//
// 返回 `RTX_GO_RETRY`（可以再跑一回合）/ `RTX_GO_INTERRUPTED`（人在退避里叫停，
// 调用方按 AGENT_INTERRUPTED 收口，**不许**再打错误行）/ `RTX_GO_GIVEUP`（连「继续」
// 都压不进历史：内存或条数上限，认账，把原来的退出码交回去）。
//
// 顺序是刻意的：**先说话再睡**（沉默 3 s 与卡死没有区别），**先退避再注入**
// （人若在退避里叫停，历史里不该多出一条没人要的 user 消息）。
export fn turn_retry_after(cfg: &const Config, h: &History, attempt: i32,
                           rc: i32) i32 {
    const wait_ms: i32 = rtx_backoff_ms();
    tr_note(cfg, attempt, wait_ms, rc);
    tr_log(attempt, wait_ms, rc);
    if agent_rtx_wait(wait_ms) {
        return RTX_GO_INTERRUPTED;
    }
    var cont: Buf = buf_new(16);
    defer { buf_free(&cont); }
    var att: Buf = buf_new(1024);
    defer { buf_free(&att); }
    var have_att: bool = false;
    if !buf_append_cstr(&cont, TR_CONTINUE) {
        out_err("[turn-retry] 内存不足，续不上（本回合到此为止）\n");
        return RTX_GO_GIVEUP;
    }
    // 与交互入口走**同一条**入史路径（`/continue` 也是这个函数）：图片附件的处理、
    // 历史条数上限的腾挪都由它负责，这里不另写一份。
    if !agent_push_user_with_imgs(h, &cont, &att, &have_att) {
        out_err("[turn-retry] 「继续」写不进历史（内存或条数上限）\n");
        return RTX_GO_GIVEUP;
    }
    agent_log_user_att(cont.ptr as &const byte, cont.len, false, &att,
        &have_att);
    return RTX_GO_RETRY;
}
