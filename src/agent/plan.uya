// src/agent/plan.uya — 会话模式（build / plan / chat）：P8 状态机 + P26 写闸门与审阅浮窗
//   + P126 chat 问答模式
//
// 本文件：三态词表（`MODE_*`/`mode_label`/`mode_name`/`mode_known`）、状态机
//   （`plan_init`/`mode_set`/`plan_on`/`chat_on`/`mode_blocks_write`）、
//   审阅浮窗与四条裁决（`plan_review`/`plan_verdict_of`，常量 `PLAN_*`）、
//   工具入口 `plan_tool_exit`、诊断转储 `plan_dump`。
// 不变量：① `s.mode` 只能经 `plan_init`/`mode_set` 改 —— 它们同时同步进程级镜像
//   `g_mode` 与输入面板的模式 chip（`tui_set_mode`），漏一处就是「状态对了但 UI 不对」；
//   ② **审阅画不出来时返回 `PLAN_NO_CHANNEL`，绝不等于批准**（fail closed）；
//   ③ `plan_verdict_of` 对**认不出**的项一律当 `PLAN_KEEP`（保守）；
//   ④ `plan_tool_exit` 要求计划非空且**首字符 `#`**；非 plan 模式调用报错
//   （工具目录跨模式恒定）；
//   ⑤ 三态**互斥由一个 `u8` 保证**（不是两个 bool）—— 加/改模式只动本文件。
// 依赖：无 `use` 行；依赖 foundation/bufx、foundation/jsonx，以及显示层
//   （term/tty、term/tui/ask、term/tui/overlay、term/tui/status、term/tui/style）
//   与 tools/askuser（落点见下）。
// 命名：`mode_*`（三态通用）、`plan_*` / `PlanState` / `PLAN_*`（plan 专属与审阅）。
//
// 状态：{mode, pending}。pending 表示「下一步生效」的切换意图（DSH 的 set() 语义：
// 运行中挂起、空闲时立即生效；这里简化为立即改 mode，因为我们只在 step 边界检查）。
// exit_plan_mode：两种模式都注册（保持工具目录稳定），非 plan 模式调用报错。
//
// P26 两件事：
//   1) **写闸门**：plan 模式下 write/edit 硬拒（fsx 查 mode_blocks_write()）。DSH 的
//      plan mode 是纯引导（「需要强制只读规划的部署必须组合独立的沙箱与审批策略」），
//      这里把那条策略落在写工具上：不然模型压根不调 exit_plan_mode 就直接开工，
//      审阅浮窗永远不会出现（现场证据见 §16 踩坑 36）。bash 不拦 —— 探索要用它，
//      它归访问模式（P21）管。
//   2) **审阅浮窗**：TUI 里弹 reader 浮层（正文可滚动 + 三动作），三个裁决与 DSH 的
//      plan-review 卡一一对应：继续讨论 = Keep planning、解决 = Chat about it、
//      确认执行 = Approve。滚动模式仍是 P8 的 y/N 问答。
//
// P126 为什么加第三态 chat：plan 与 build 之间缺一个「只答问题、不动手」的位置 ——
//   「先别改，跟我说说这个仓怎么跑」用 plan 反而会被逼着交计划、走 exit_plan_mode。
//   chat 与 plan 共用同一道写闸门（`mode_blocks_write`），差别只有两处：一是**出口
//   不同**（plan 走审阅浮窗的 `exit_plan_mode`，chat 走 `exit_chat_mode` 直接退到
//   build），二是提示词明确「只回答、要改就用 exit_chat_mode 或请人切 build」。
//   bash 与 plan 一样**不拦**（理由见上）；真正只读请配
//   `--permission read-only`（两者叠加 = 全只读）。
//   tab 的轮转顺序（chat → plan → build → chat）定义在显示层
//   （`term/tui/status.uya` 的 `tui_mode_cycle`）：键层只表达「切」，不认顺序。
//
// P132 为什么把默认从 plan 翻成 chat：新会话的第一件事多半是**问**（「这个仓怎么跑」
//   「这段为什么会这样」），而不是动手；默认 plan 会逼着模型交计划、走审阅浮窗，
//   人还得先按 tab 降一级。默认落在 chat 之后，想动手的人按 tab 两下到 build，
//   管道/CI 里的模型则用 `exit_chat_mode` 自己申请开工 —— 出口从「只有人能给」
//   变成「模型能申请、人也能按 tab 给」。

// 三态词表。**值进会话日志与 UI chip**，别改既有两个数。
export const MODE_BUILD: u8 = 0;   // 正常模式：写工具可用（仍受访问模式约束）
export const MODE_PLAN: u8 = 1;    // 先出计划、批准后再动手（写硬拒 + exit_plan_mode）
export const MODE_CHAT: u8 = 2;    // 问答模式：只答问题，写工具硬拒

export struct PlanState {
    mode: u8,       // MODE_*
    pending: i32,   // 0=无 1=准备进入 2=准备退出（保留的意图位；见文件头）
}

// 进程级镜像（工具层闸门用；与 perm.uya 的 g_perm 同款）。
// fork 出来的子代理会继承它 —— 与子代理本来就会继承会话模式的提示词一致。
// 初值必须与 `plan_init` 一致（P132 起 chat 是新会话的默认模式）。
var g_mode: u8 = MODE_CHAT;

// 审阅裁决（plan_tool_exit 的四条出口）
export const PLAN_KEEP: i32 = 0;          // 继续讨论：留在 plan 模式，改一版再弹
export const PLAN_APPROVE: i32 = 1;       // 确认执行：退出 plan 模式，照计划动手
export const PLAN_NO_CHANNEL: i32 = 2;    // 没有提问渠道（管道/CI、子代理、浮窗画不出来）
export const PLAN_DISMISS: i32 = 3;       // 解决：关掉浮窗、留在 plan 模式，等用户自己说

// 浮层标题与三个动作（生成与反解共用一份，别写两遍）
export const PLAN_TITLE: &const byte = "计划待审" as &const byte;
export const PLAN_ITEM_KEEP: &const byte = "继续讨论" as &const byte;
export const PLAN_ITEM_DISMISS: &const byte = "解决" as &const byte;
export const PLAN_ITEM_APPROVE: &const byte = "确认执行" as &const byte;
export const PLAN_ITEMS: &const byte = "继续讨论\n解决\n确认执行\n" as &const byte;

// 认不认得这个模式值（越界一律拒：宁可不动，也不许把状态写成表外的数）。
export fn mode_known(m: u8) bool {
    return m == MODE_BUILD || m == MODE_PLAN || m == MODE_CHAT;
}

// 模式名（**信息行 chip 用**：三个单词，英文与既有的 Build / Plan 同款）
export fn mode_label(m: u8) &const byte {
    if m == MODE_PLAN {
        return "Plan" as &const byte;
    }
    if m == MODE_CHAT {
        return "Chat" as &const byte;
    }
    return "Build" as &const byte;
}

// 模式机器名（**会话日志 `plan/mode` 的载荷用**：小写，便于外部按值匹配）
export fn mode_name(m: u8) &const byte {
    if m == MODE_PLAN {
        return "plan" as &const byte;
    }
    if m == MODE_CHAT {
        return "chat" as &const byte;
    }
    return "build" as &const byte;
}

// 初始态：**chat**（P132：会话默认 chat → plan → build 的起点就落在 chat 上）、
// 无 pending 意图、进程级镜像归 chat。
// 顺手 `tui_set_mode(MODE_CHAT)` —— 输入面板的模式 chip **只在这一个变更点**同步，
// 所以任何改模式的路径都必须经过 plan_init / mode_set（别直接写 s.mode）。
// 想直接开工的人用 `--build`（或在 TUI 里两下 tab）显式跳过 chat；
// 想要「先交计划」的人用 `--plan`。
export fn plan_init(s: &PlanState) void {
    s.mode = MODE_CHAT;
    s.pending = 0;
    g_mode = MODE_CHAT;
    tui_set_mode(MODE_CHAT);   // 输入面板的 chip：唯一变更点顺手同步
}

// 设模式的**唯一入口**：写 s.mode、清 pending、同步进程级镜像 g_mode 与 UI chip。
// 越界值**保持不动**（与 be_tui 对非法载荷的口径一致：显示层与状态层的镜像不许被
// 一个表外的数改掉）。DSH 的 `set()` 语义是「运行中挂起、空闲时立即生效」；这里
// **简化为立即改 mode**，因为本仓只在 step 边界检查状态（详见文件头）。
export fn mode_set(s: &PlanState, m: u8) void {
    if !mode_known(m) {
        return;
    }
    s.mode = m;
    s.pending = 0;
    g_mode = m;
    tui_set_mode(m);
}

// 当前是不是 plan 模式（进程级）
export fn plan_on() bool {
    return g_mode == MODE_PLAN;
}

// 当前是不是 chat 模式（进程级）
export fn chat_on() bool {
    return g_mode == MODE_CHAT;
}

// 写工具闸门：plan 与 chat 两种模式下 write/edit 硬拒。
// 这两种模式的**拒绝串不同**（plan 指路 exit_plan_mode，chat 指路切 build），
// 调用方用 `chat_on()` 选串，别在这里合并成一句。
export fn mode_blocks_write() bool {
    return g_mode != MODE_BUILD;
}

// 把计划正文落进转录（记录用：浮窗是临时的，转录里这份留着回看）。
// 注意**按长度写**：js_obj_get_str_unescaped 给的 Buf 没有 NUL 结尾，用 ask_write()
// 那种 C 字符串口径会一路读到未初始化的堆尾巴（§16 踩坑 37）。
fn plan_dump(plan: &const Buf) void {
    _ = ask_write("\n=== 计划 ===\n");
    tty_stream_write(2, plan.ptr as &const byte, plan.len);
    _ = ask_write("\n=== 计划结束 ===\n");
}

// 浮层选中项原文 → 裁决（认不出的项一律当「继续讨论」：绝不误批准）
export fn plan_verdict_of(pick: &const Buf) i32 {
    if bufx_eq_cstr(pick.ptr as &const byte, pick.len, PLAN_ITEM_APPROVE) {
        return PLAN_APPROVE;
    }
    if bufx_eq_cstr(pick.ptr as &const byte, pick.len, PLAN_ITEM_DISMISS) {
        return PLAN_DISMISS;
    }
    return PLAN_KEEP;
}

// 审阅。返回 PLAN_* 之一。
//   1) TUI 在跑：浮窗（画不出来就 fail closed，绝不等于批准）
//   2) 子代理 / 管道：没有提问渠道
//   3) 滚动模式真 TTY：P8 的 y/N 问答
fn plan_review(cfg: &const Config, plan: &const Buf) i32 {
    plan_dump(plan);
    if tui_active() {
        if !tui_reader_fits() {
            return PLAN_NO_CHANNEL;
        }
        var pick: Buf = buf_new(64);
        defer { buf_free(&pick); }
        const rc: i32 = tui_reader_wait(TUI_OVK_PLAN, PLAN_TITLE, bufx_cstr_len(PLAN_TITLE),
            plan.ptr as &const byte, plan.len,
            PLAN_ITEMS, bufx_cstr_len(PLAN_ITEMS), 0, &pick);
        if rc != 1 {
            // esc / 中断 / headless 没人回答：留在 plan 模式，模型停下等用户说话
            return PLAN_DISMISS;
        }
        return plan_verdict_of(&pick);
    }
    if cfg.is_subagent || !tty_is_interactive() {
        return PLAN_NO_CHANNEL;
    }
    _ = ask_write("批准这个计划并退出 plan 模式？[y/N] ");
    const ans: i32 = ask_read_yes_no();
    if ans == 1 {
        return PLAN_APPROVE;
    }
    if ans == 0 {
        return PLAN_KEEP;
    }
    return PLAN_NO_CHANNEL;
}

// exit_plan_mode 工具
export fn plan_tool_exit(cfg: &const Config, s: &PlanState, args: &const JsonValue, out: &Buf) void {
    var plan: Buf = buf_empty();
    defer { buf_free(&plan); }
    if !js_obj_get_str_unescaped(args, "plan", 4, &plan) || plan.len == 0 {
        _ = buf_append_cstr(out, "Error: exit_plan_mode requires a non-empty markdown plan starting with a # heading");
        return;
    }
    if plan.ptr[0] != 35 as byte {
        _ = buf_append_cstr(out, "Error: exit_plan_mode requires a non-empty markdown plan starting with a # heading");
        return;
    }
    if s.mode != MODE_PLAN {
        _ = buf_append_cstr(out, "Error: exit_plan_mode is only available in plan mode");
        return;
    }
    const verdict: i32 = plan_review(cfg, &plan);
    if verdict == PLAN_APPROVE {
        mode_set(s, MODE_BUILD);
        _ = buf_append_cstr(out, "Plan approved — plan mode exited; carry out the plan starting with your next step.");
        return;
    }
    if verdict == PLAN_KEEP {
        _ = buf_append_cstr(out, "The user chose to keep planning; revise the plan and present it again.");
        return;
    }
    if verdict == PLAN_DISMISS {
        _ = buf_append_cstr(out, "The user dismissed the plan review to speak instead; stay in plan mode, stop here, and wait for their message.");
        return;
    }
    _ = buf_append_cstr(out, "no user-questions channel is available to review the plan; ask the user to switch the session mode instead");
}

// exit_chat_mode 工具（P132）：chat 模式在**管道/CI/子代理**里没有 tab 可按时的出口。
// 它是人给的授权（「这个会话要动手」），所以**不弹浮层**：审阅浮窗那套是「模型先提、
// 用户批」，而 chat 的语义就是用户已经说了「去改吧」，再引一个浮层等于把
// exit_plan_mode 重讲一遍。与 exit_plan_mode 对称：非 chat 模式调用报错，
// 工具目录跨模式恒定（照旧列着，只是调用时报错）。
// 只改会话模式，**不改访问模式** —— read-only 之类仍由 perm_* 独立把关。
// 行宽豁免：两条拒绝/成功串是不可断的逐字文案（自测逐字断言它们）。
export fn mode_tool_exit_chat(s: &PlanState, out: &Buf) void {
    if s.mode != MODE_CHAT {
        _ = buf_append_cstr(out, "Error: exit_chat_mode is only available in chat mode");
        return;
    }
    mode_set(s, MODE_BUILD);
    _ = buf_append_cstr(out, "Chat mode exited — build mode is active; the write and edit tools are available from your next step. Carry out the change the user asked for.");
}
