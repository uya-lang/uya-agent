// src/agent/todo.uya — todo_write（P8，对齐 DSH tool-todo）
//
// 本文件：清单项与状态的零值/生命周期（`td_item_empty`/`todo_init`/`todo_free`）、
//   工具入口 `todo_tool_write`（校验 + 整表替换 + 回显）、**落盘**（`todo_log_write`）
//   与**折回**（`todo_from_json`）、空白处理 `td_trim`、状态串映射 `td_status_of`、
//   执行中的清单提醒 `todo_remind_step`（P131）。
// 不变量：① **整表替换** —— 每次调用提交完整列表，不做增量合并；
//   ② **先全量校验再落状态**（content 去空白后非空、列表内不重复、status 合法、条数 ≤ 32）——
//   否则会出现「一半校验过一半没过」的半更新；③ 上限 `TODO_MAX = 32`；
//   ④ 清单**不再注入回上下文**（与 DSH 一致：那是 UI/replay 状态，不是第二条模型消息）；
//   ⑤ 清空时机有两个：**回合开始时**（`todo_clear`，DSH 口径）与**换会话时**
//   （agent 的 `agent_session_scoped_reset`）；
//   ⑥ **提交成功的整表落一条 `todo/write` 事件**（后写覆盖先写），恢复会话时由
//   `agent_hist_from_log` 折回最后一次 —— 修前清单只在内存里，`--resume` 之后恒为空；
//   ⑦ **执行中也要回头看一眼**：step 边界按间隔补一条几十字节的自问式提醒
//   （`todo_remind_step`）—— 不变量 ④ 让模型看不到清单，事后防线又只有收工那一条，
//   于是「做完了不标」成了常态（见该函数的注释）。
// 依赖：无 `use` 行；依赖 libc.heap（malloc/free，同 goal.uya 的手法）、
//   foundation/bufx（Buf / bufx_mem_eq）、foundation/jsonx
//   （Arena / arena_init / JsonValue / JsonStrView / js_parse / js_obj_get /
//   js_obj_get_str / js_arr_len / js_arr_get）。
// 命名：`td_*`（清单项与校验）、`todo_*`（集合与工具入口）、`TodoItem`/`TodoState`、
//   `TD_PENDING`/`TD_INPROGRESS`/`TD_COMPLETED`。
//
// 整表替换语义：每次调用都提交**完整**列表；回显
// `Updated todo list: N pending, N in progress, N completed.`
// 校验：content 去空白后非空、列表内不重复；status 只能是三个枚举值。
// 列表**不会**再注入回上下文（与 DSH 一致：那是 UI/replay 状态，不是第二条模型消息）；
// 它落进**会话日志**（`todo/write`，与 DSH 的
// `exec.agent.session.append("todo/write", { todos })` 逐字段同形），恢复时折最后一次、
// 下一个 `turn/start` 清空 —— 与 DSH 的投影
// （`apply: todo/write → event.data.todos / turn/start → null`）同序。

const TODO_MAX: usize = 32;
const TODO_CONTENT_MAX: usize = 4096;

// ---- P131：执行中的清单提醒（`todo_remind_step`）----
//
// 用户报的现场：**跑着就不更新**，做完的那一项一路挂在 `in_progress` 上，直到收工
// （或被下一条任务挤掉）才有人回头补。根因不是措辞 —— 工具描述与 DSH 逐字相同，写的
// 正是 "mark a todo completed the moment it is done"。真实缺口是两侧都空着：
//   * 不变量 ④ 让清单**不进上下文**，模型手里没有当前值；
//   * 事后防线只有 system prompt 的收工纪律（`SEC_FINISH` 第三条），它只管收工那一刻。
// DSH 那边有 `dsh-repeat-tool-reminder` 与 session projection 兜着，本仓两样都没有。
// 修法：step 边界补一条**几十字节**的自问式提醒，按间隔节流。为什么这样够：上一次
// `todo_write` 的**参数**就在历史里（assistant 的 `tool_calls`），模型看得见 ——
// 缺的从来不是数据，是「现在该回头看它一眼」这个动作。抄正文既白花 token，又多一份
// 可能与真实状态不一致的副本（与 `agent_ctx_est` 不抄正文同一条纪律）。

// 提醒间隔（step 边界个数）：一次提交之后至少隔两步才吭声（刚标过就不打扰），
// 而「标完又干了两步」正好是「这一步大概做完了」的时间尺度。
const TODO_REMIND_EVERY: i32 = 3;
// 提醒消息的固定前缀。两个用途：① `hist_drop_user_prefix` 按它删掉上一条 ——
// 历史里只留一条（与运行时快照 supersede 同一手法，见 `hist_drop_user_prefix`）；
// ② 别处本来就按 `<system-reminder>` 过滤注入消息（`tm_is_task_msg` /
// `agent_title_user_into`），用同一形状就不必再教它们认第三种。
const TODO_REMIND_TAG: &const byte = "<system-reminder>\nTodo check: ";

// 距上一条提醒 / 上一次提交过了几个 step 边界。四个写点：本行的初值、
// `todo_clear`（回合开始）、`todo_tool_write`（提交成功）都清零，
// `todo_remind_step` 自己每步 +1、注入成功时归零 —— 别处只读。
var g_todo_remind_wait: i32 = 0;

export const TD_PENDING: u8 = 0;
export const TD_INPROGRESS: u8 = 1;
export const TD_COMPLETED: u8 = 2;

export struct TodoItem {
    content: Buf,
    status: u8,
}

export struct TodoState {
    items: [TodoItem: TODO_MAX],
    n: usize,
}

// 零值 TodoItem：空 content（`buf_empty`，不是 buf_new）+ 状态 pending。
// 全局数组的初始化式在 C 里必须是常量，所以只能这样逐个填。
fn td_item_empty() TodoItem {
    return TodoItem{ content: buf_empty(), status: TD_PENDING };
}

// 复位整张清单并把 n 归 0。幂等。
export fn todo_init(s: &TodoState) void {
    var i: usize = 0;
    while i < TODO_MAX {
        s.items[i] = td_item_empty();
        i = i + 1;
    }
    s.n = 0;
}

// 释放 `[0, n)` 并归零。n 之外的槽位从未装过（td_item_empty 给的），不需要也不能释放。
export fn todo_free(s: &TodoState) void {
    var i: usize = 0;
    while i < s.n {
        buf_free(&s.items[i].content);
        s.items[i] = td_item_empty();
        i = i + 1;
    }
    s.n = 0;
}

// DSH：回合开始时清空（投影在 turn/start 复位）
export fn todo_clear(s: &TodoState) void {
    todo_free(s);
    // P131：提醒的节奏跟着清单一起复位 —— 不然上一回合最后两步攒下的等待会
    // 让新回合的第一个 step 边界立刻补一条（那时清单还是空的，白扫一遍历史）
    g_todo_remind_wait = 0;
}

// 算出 `[0, n)` 去掉**首尾**空白（空格 / tab / LF / CR）之后的（偏移, 长度），
// 经两个出参回传。中间的空格保留 —— 清单项的正文按原样显示。
fn td_trim(p: &const byte, n: usize, out_off: &usize, out_len: &usize) void {
    var a: usize = 0;
    var b: usize = n;
    while a < b && (p[a] == 32 as byte || p[a] == 9 as byte || p[a] == 10 as byte || p[a] == 13 as byte) {
        a = a + 1;
    }
    while b > a && (p[b - 1] == 32 as byte || p[b - 1] == 9 as byte || p[b - 1] == 10 as byte || p[b - 1] == 13 as byte) {
        b = b - 1;
    }
    out_off[0] = a;
    out_len[0] = b - a;
}

// 状态串 → 枚举。只认 DSH 的三个字面量（pending / in_progress / completed），
// 长度先比对再比内容（省一次 memcmp）；认不出来返回 false，调用方据此拒掉整个清单。
fn td_status_of(v: &const JsonStrView, out: &u8) bool {
    if v.len == 7 && bufx_mem_eq(v.ptr as &const byte, "pending", 7) {
        out[0] = TD_PENDING;
        return true;
    }
    if v.len == 11 && bufx_mem_eq(v.ptr as &const byte, "in_progress", 11) {
        out[0] = TD_INPROGRESS;
        return true;
    }
    if v.len == 9 && bufx_mem_eq(v.ptr as &const byte, "completed", 9) {
        out[0] = TD_COMPLETED;
        return true;
    }
    return false;
}

// 把**当前**清单写一条 `todo/write` 会话事件（`g_sess.save` 为假时什么都不写）。
//
// 为什么要落盘：清单原来只活在内存里（`g_todos`），`--resume` 之后恒为空 —— 用户看到
// 的就是「恢复会话后任务清单没了」。落一条事件之后，恢复那条路（`agent_hist_from_log`）
// 折最后一次就是当时的清单；下一个 `turn/start` 再清空。形状与 DSH 的
// `exec.agent.session.append("todo/write", { todos })` 逐字段同形（`data.todos` 是数组）。
//
// 调用点只有 `todo_tool_write` 的提交分支一处 —— 「日志与实际派发必须一致」这条纪律
// （见 §5.4.1）要求它**只**记真正落进状态的那一版：被校验拒掉的提交一个字节都不许进日志。
export fn todo_log_write(s: &const TodoState) void {
    var ev: Buf = buf_new(256);
    defer { buf_free(&ev); }
    if !sess_begin(&g_sess, "todo/write", &ev) {
        return;
    }
    _ = buf_append_cstr(&ev, "{\"todos\":[");
    var i: usize = 0;
    while i < s.n {
        if i > 0 {
            _ = buf_append_byte(&ev, 44);
        }
        _ = buf_append_cstr(&ev, "{\"content\":");
        _ = jw_str_into(&ev, s.items[i].content.ptr as &const byte,
                        s.items[i].content.len);
        // status 是**我们自己**的三个字面量之一（内容由 `td_status_of` 保证），
        // 不含需要转义的字节 —— 直接写引号 + 名字，不走 jw_str_into（那要传长度，
        // 而三个名字不等长：pending 7 / in_progress 11 / completed 9，写错会读越界）。
        _ = buf_append_cstr(&ev, ",\"status\":\"");
        _ = buf_append_cstr(&ev, td_status_name(s.items[i].status));
        _ = buf_append_cstr(&ev, "\"}");
        i = i + 1;
    }
    _ = buf_append_cstr(&ev, "]}");
    _ = sess_end(&g_sess, &ev);
}

// status 枚举 → 线缆上的字面量（DSH 投影 schema 的三个枚举值）。
fn td_status_name(st: u8) &const byte {
    if st == TD_INPROGRESS {
        return "in_progress" as &const byte;
    }
    if st == TD_COMPLETED {
        return "completed" as &const byte;
    }
    return "pending" as &const byte;
}

// 折一条 `todo/write` 事件的 `data.todos` 数组回状态（`p` 是**整行**事件文本）。
//
// **全或无**：任何一条不合法（content 去空白后为空、status 不是三值之一、条数超上限、
// 结构不是数组）就一个字节都不改，返回 false。理由与 `todo_tool_write` 的「先全量校验
// 再落状态」同一条：半截清单比没有清单更难查（屏幕上会挂着一份不存在的计划）。
//
// ⚠ 数组在 **`data` 里面**（信封是 `{type, seq, time, data:{todos:[…]}}`）——
// 少了往里钻一层就恒返回 false，而那表现为「清单照样恢复不出来」，与没写这条事件
// 一模一样（实测踩到过：第一版只取顶层 `todos`，恢复后清单仍为空）。
//
// 不做去重校验：日志里的那一份是**我们自己**写下去的（写之前已经查过重复），
// 而这里再查一遍只会让「手改过的日志」整条被丢掉 —— 少显示一条胜过整块消失。
export fn todo_from_json(s: &TodoState, p: &const byte, n: usize) bool {
    var arena_raw: &void = malloc(65536);
    defer { free(arena_raw); }
    if ((arena_raw as &byte) as usize) == 0 {
        return false;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, p, n, &root) {
        return false;
    }
    var data: JsonValue = JsonValue.json_null();
    if !js_obj_get(&root, "data", 4, &data) {
        return false;
    }
    var arr: JsonValue = JsonValue.json_null();
    if !js_obj_get(&data, "todos", 5, &arr) {
        return false;
    }
    const cnt: usize = js_arr_len(&arr);
    if cnt > TODO_MAX {
        return false;
    }
    // 先全量校验到一份暂存里，全过了才动 s（与工具入口同一条纪律）
    var staged: [Buf: TODO_MAX] = [buf_empty(): TODO_MAX];
    var statuses: [u8: TODO_MAX] = [0: TODO_MAX];
    var keep: usize = 0;
    var ok: bool = true;
    var i: usize = 0;
    while i < cnt && ok {
        var item: JsonValue = JsonValue.json_null();
        if !js_arr_get(&arr, i, &item) {
            ok = false;
            break;
        }
        var cv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
        if !js_obj_get_str(&item, "content", 7, &cv) {
            ok = false;
            break;
        }
        var a: usize = 0;
        var l: usize = 0;
        td_trim(cv.ptr as &const byte, cv.len, &a, &l);
        if l == 0 {
            ok = false;
            break;
        }
        var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
        var st: u8 = 0;
        if !js_obj_get_str(&item, "status", 6, &sv) || !td_status_of(&sv, &st) {
            ok = false;
            break;
        }
        staged[keep] = buf_new(l + 8);
        if !buf_valid(&staged[keep]) {
            ok = false;
            break;
        }
        if !sv_unescape(&cv, &staged[keep]) {
            // 反转义失败退回原始视图（与 goal_set_unescaped 同一条：宁可显示得难看，
            // 也不静默丢内容）
            buf_reset(&staged[keep]);
            _ = buf_append(&staged[keep], cv.ptr as &const byte, cv.len);
        }
        statuses[keep] = st;
        keep = keep + 1;
        i = i + 1;
    }
    if !ok {
        var j: usize = 0;
        while j < keep {
            buf_free(&staged[j]);
            j = j + 1;
        }
        return false;
    }
    todo_free(s);
    var m: usize = 0;
    while m < keep {
        s.items[m].content = staged[m];
        s.items[m].status = statuses[m];
        m = m + 1;
    }
    s.n = keep;
    return true;
}
// 先**全量**校验（content 去空白后非空、列表内不重复、status 合法、条数 ≤ TODO_MAX）
// 再落状态 —— 不这么做会出现「一半校验过一半没过」的半更新。
// 结果文本回显 `Updated todo list: N pending, N in progress, N completed.`。
export fn todo_tool_write(s: &TodoState, args: &const JsonValue, out: &Buf) void {
    var todos: JsonValue = JsonValue.json_null();
    if !js_obj_get(args, "todos", 5, &todos) {
        _ = buf_append_cstr(out, "Error: invalid todos: expected an array");
        return;
    }
    const n: usize = js_arr_len(&todos);
    if n > TODO_MAX {
        _ = buf_append_cstr(out, "Error: invalid todos: too many items (max ");
        _ = buf_append_u64(out, TODO_MAX as u64);
        _ = buf_append_cstr(out, ")");
        return;
    }
    // 先全量校验，再落状态（避免半截更新）
    var staged: [Buf: TODO_MAX] = [buf_empty(): TODO_MAX];
    var statuses: [u8: TODO_MAX] = [0: TODO_MAX];
    var i: usize = 0;
    var ok: bool = true;
    while i < n && ok {
        var item: JsonValue = JsonValue.json_null();
        if !js_arr_get(&todos, i, &item) {
            ok = false;
            break;
        }
        var cv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
        if !js_obj_get_str(&item, "content", 7, &cv) {
            _ = buf_append_cstr(out, "Error: invalid todo: `content` must be a non-empty string");
            ok = false;
            break;
        }
        var a: usize = 0;
        var l: usize = 0;
        td_trim(cv.ptr as &const byte, cv.len, &a, &l);
        if l == 0 {
            _ = buf_append_cstr(out, "Error: invalid todo: `content` must be a non-empty string");
            ok = false;
            break;
        }
        var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
        if !js_obj_get_str(&item, "status", 6, &sv) {
            _ = buf_append_cstr(out, "Error: invalid todo: `status` must be one of pending|in_progress|completed");
            ok = false;
            break;
        }
        var st: u8 = 0;
        if !td_status_of(&sv, &st) {
            _ = buf_append_cstr(out, "Error: invalid todo: `status` must be one of pending|in_progress|completed");
            ok = false;
            break;
        }
        // 值指针：指针算术要用 @ptr_from_usize（&p[a] 不是左值）
        const vbase: &const byte = cv.ptr as &const byte;
        const vptr: &const byte = @ptr_from_usize(@usize_from_ptr(vbase as &const void) + a) as &const byte;
        // 去重
        var k: usize = 0;
        while k < i {
            if staged[k].len == l && bufx_mem_eq(staged[k].ptr as &const byte, vptr, l) {
                _ = buf_append_cstr(out, "Error: invalid todos: duplicate content \"");
                _ = buf_append(out, vptr, l);
                _ = buf_append_cstr(out, "\"");
                ok = false;
                break;
            }
            k = k + 1;
        }
        if !ok {
            break;
        }
        staged[i] = buf_new(l + 8);
        if !buf_valid(&staged[i]) {
            ok = false;
            break;
        }
        _ = buf_append(&staged[i], vptr, l);
        statuses[i] = st;
        i = i + 1;
    }
    if !ok {
        var j: usize = 0;
        while j < n {
            buf_free(&staged[j]);
            j = j + 1;
        }
        return;
    }
    // 提交
    todo_free(s);
    var m: usize = 0;
    while m < n {
        if m < TODO_MAX {
            s.items[m].content = staged[m];
            s.items[m].status = statuses[m];
            s.n = m + 1;
        }
        m = m + 1;
    }
    // 落一条 `todo/write`：**只有走到这一行的提交**才会进日志（被上面任何一档拒掉的
    // 提交一个字节都不写）。恢复会话时折最后一次 —— 见 `todo_log_write` 的注释。
    todo_log_write(s);
    // P131：刚提交过 ⇒ 提醒重新计时（否则下一步边界立刻补一条「你刚写过的清单」）
    g_todo_remind_wait = 0;
    var np: usize = 0;
    var ni: usize = 0;
    var nc: usize = 0;
    var q: usize = 0;
    while q < s.n {
        if s.items[q].status == TD_PENDING {
            np = np + 1;
        } else if s.items[q].status == TD_INPROGRESS {
            ni = ni + 1;
        } else {
            nc = nc + 1;
        }
        q = q + 1;
    }
    _ = buf_append_cstr(out, "Updated todo list: ");
    _ = buf_append_u64(out, np as u64);
    _ = buf_append_cstr(out, " pending, ");
    _ = buf_append_u64(out, ni as u64);
    _ = buf_append_cstr(out, " in progress, ");
    _ = buf_append_u64(out, nc as u64);
    _ = buf_append_cstr(out, " completed.");
}

// 每个 step 边界调一次（`agent_turn_loop_once` 组请求之前，P131）。清单里有
// `in_progress` 且距上一条提醒够久，就往历史尾部补一条几十字节的提醒；
// 返回是否真的注入了（自测按它钉节流，产品侧不看返回值）。
//
// 两条节流都要有：没有在做的条目就**一个字节都不说**（没开始的事没什么可标的）；
// 间隔没到也不说（每步一句等于把上下文预算和前缀缓存一起烧掉）。另外，清单变成
// 「没有 in_progress」时要把上一条提醒**撤掉** —— 它描述的状态已经不成立了，
// 留着只会让模型看见一份和现实相反的计数。
export fn todo_remind_step(h: &History) bool {
    // 饱和加：撞到上限也只是「一直该提醒」，不会翻成负数把节流整条关掉
    g_todo_remind_wait = g_todo_remind_wait +| 1;
    var np: usize = 0;
    var ni: usize = 0;
    var nc: usize = 0;
    var i: usize = 0;
    while i < g_todos.n {
        if g_todos.items[i].status == TD_INPROGRESS {
            ni = ni + 1;
        } else if g_todos.items[i].status == TD_COMPLETED {
            nc = nc + 1;
        } else {
            np = np + 1;
        }
        i = i + 1;
    }
    const tag_n: usize = bufx_cstr_len(TODO_REMIND_TAG);
    if ni == 0 {
        _ = hist_drop_user_prefix(h, TODO_REMIND_TAG, tag_n);
        return false;
    }
    if g_todo_remind_wait < TODO_REMIND_EVERY {
        return false;
    }
    var m: Buf = buf_new(384);
    if !buf_valid(&m) {
        return false;
    }
    defer { buf_free(&m); }
    var ok: bool = buf_append_cstr(&m, TODO_REMIND_TAG);
    ok = ok && buf_append_u64(&m, ni as u64);
    ok = ok && buf_append_cstr(&m, " in_progress, ");
    ok = ok && buf_append_u64(&m, nc as u64);
    ok = ok && buf_append_cstr(&m, " completed, ");
    ok = ok && buf_append_u64(&m, np as u64);
    ok = ok && buf_append_cstr(&m, " pending.\nIf you just finished one of");
    ok = ok && buf_append_cstr(&m, " them, call todo_write now with the");
    ok = ok && buf_append_cstr(&m, " COMPLETE list (all items, not a diff)");
    ok = ok && buf_append_cstr(&m, " and mark it completed — do not batch");
    ok = ok && buf_append_cstr(&m, " completions.\n</system-reminder>");
    if !ok {
        return false;   // 分配失败：不注入，也不动节奏（下一步再试）
    }
    // 旧的先撤再推：反过来会连刚插进去的那一条一起删掉（前缀相同）
    _ = hist_drop_user_prefix(h, TODO_REMIND_TAG, tag_n);
    g_todo_remind_wait = 0;
    return hist_push(h, ROLE_USER, m.ptr as &const byte, m.len);
}
