// src/agent/ag_worktree.uya — agent.uya 的拆分片 6/9（纯搬移）
//
// 本文件：P41：/worktree 的动作选择浮层（TUI）；P9：自动压缩；CLI；P3 交互模式：提示符 + 流式 + Ctrl-C 中断 + 运行中输入 + 继续；P15/P22：输入行上方的面板块（子代理窗口 + 任务状态块）；P42：/watch —— 跟随某个子代理的实时过程消息
// 不变量：与原文件一致 —— 拆分只搬移，不改任何声明的代码；同族轮/段集中在一片里。
// 依赖：见锚点 agent.uya 的文件头（本片与它同处合并命名空间，无本地 use）。
// 命名：沿用原文件前缀（本片是同一历史模块的内部拆分）。

// ============================================================
// P41：/worktree 的动作选择浮层（TUI）
//
// P37 的 `/worktree` 在人这一侧一直是「文本命令 + 一张状态报告」：动作只写在
// `/help` 的一行里，TUI 里敲裸命令看到的是报告、不是「有哪些动作」。而同一条线上
// 的 /permission、/model、/effort 早就都是**底对齐选择浮层**了 —— 这一节把 /worktree
// 补齐成同一套观感：
//   * 裸 `/worktree` 开浮层，七个动作一行一个（`✓` 标当前模式，游标**默认停在 status**，
//     所以「打开就回车」仍等于 P37 的裸命令 —— 老手感不变）；
//   * P111：`on` 那一行撤了（出厂就开着，想开是 `start`），`off` 挪到最后一行当**逃生口**。
//   * `finish` / `discard` 是**删目录删分支**的不可逆动作：选定不生效，先翻第二道确认
//     浮层，游标默认停在「取消」（与 Full access 的风险确认同一态度，彩排过：只按回车
//     不会把 worktree 合掉/删掉）；
//   * `reclaim`（P53）也删目录，但它只清**确定的垃圾**（干净 + 零提交 + 没人在用），
//     所以不翻确认框 —— 真判据在 worktreex 里，人敲这个动作是「顺手扫一下」。
//   * 执行结果走 wt_cmd_run 的同一份文本，以一条 notice 落进转录（滚动模式那条 tty_write
//     的路一个字都没动）。
// ============================================================

// 动作表：机器名（= tools 的 action 词汇，也是浮层条目行首那个词）与一行说明。
// 顺序就是浮层里的行序；下标的几个常量是「游标默认停哪儿」与「哪两个要先确认」。
//
// P111：`on` 没了（出厂就开着，想开是 `start`），`off` 挪到**最后一行**当逃生口。
// 删掉一对之后下标整体重排 —— 名字表 / 显示名表 / 下面这组常量 / 浮层默认游标
// **四处必须同步**，漏一处就是「选中一行却执行了另一行动作」。
const WT_ACT_N: usize = 7;
const WT_ACT_STATUS: usize = 1;    // 裸命令打开时的默认游标
const WT_ACT_FINISH: usize = 2;
const WT_ACT_DISCARD: usize = 3;
const WT_ACT_OFF_ROW: usize = 6;   // 逃生口那一行（`✓` 只在显式关过之后才挂）

// worktree 动作的**机器名**（第 i 个）：start/status/finish/discard/list/reclaim/off。
// 与 `wt_act_gloss` 配对，两个表**必须一一对应**（浮层生成与反解共用它们）。
fn wt_act_name(i: usize) &const byte {
    if i == 0 {
        return "start" as &const byte;
    }
    if i == 1 {
        return "status" as &const byte;
    }
    if i == 2 {
        return "finish" as &const byte;
    }
    if i == 3 {
        return "discard" as &const byte;
    }
    if i == 4 {
        return "list" as &const byte;
    }
    if i == 5 {
        return "reclaim" as &const byte;
    }
    return "off" as &const byte;
}

// worktree 动作的**显示名**。与 `wt_act_name` 同下标对应 —— 改动要两张表一起改。
fn wt_act_gloss(i: usize) &const byte {
    if i == 0 {
        return "当场建独立工作区（没建过时；幂等；模式关着也顺带开回来）" as &const byte;
    }
    if i == 1 {
        return "worktree / 分支 / 基分支 / 未提交路径" as &const byte;
    }
    if i == 2 {
        return "提交 → 合并回基分支 → 删掉 worktree 与分支" as &const byte;
    }
    if i == 3 {
        return "不合并，直接删掉 worktree 与分支" as &const byte;
    }
    if i == 4 {
        return "这个仓库里还留着的会话 worktree" as &const byte;
    }
    if i == 5 {
        return "清掉这个仓库里确定的垃圾：干净且零提交的残留 worktree，外加目录已没、零提交的孤儿分支" as &const byte;
    }
    return "关掉模式（逃生口：非 git 目录/CI；当前 worktree 还在，要清用 discard）" as &const byte;
}

// 浮层里的一行：`✓ `（当前模式）或两个空格 + 机器名补齐 + ` — ` + 一行说明。
// 生成与反解共用这一份（与 /permission 的选择器同一套排版）
fn agent_tui_worktree_line(i: usize, out: &Buf) void {
    buf_reset(out);
    const name: &const byte = wt_act_name(i);
    const n: usize = bufx_cstr_len(name);
    // 出厂默认开着（P111），所以 `off` 那一行只在有人显式关过之后才带 ✓
    var marked: bool = false;
    if i == WT_ACT_OFF_ROW {
        marked = !wt_on();
    }
    if marked {
        _ = buf_append_cstr(out, "✓ ");
    } else {
        _ = buf_append_cstr(out, "  ");
    }
    _ = buf_append(out, name, n);
    var pad: usize = n;
    while pad < 8 {          // 机器名补齐（最长 discard = 7 列 + 1 空格）
        _ = buf_append_byte(out, 32);
        pad = pad + 1;
    }
    _ = buf_append_cstr(out, "— ");
    _ = buf_append_cstr(out, wt_act_gloss(i));
}

// 拼 `/worktree` 选择框的条目：七个动作一行一个，`✓` 标当前模式，游标默认停在 `status`
// —— 所以「打开就回车」与裸 `/worktree` 的文本版逐字节同效（§7 的 worktree 段）。
fn agent_tui_worktree_items() Buf {
    var out: Buf = buf_new(1024);
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    var i: usize = 0;
    while i < WT_ACT_N {
        agent_tui_worktree_line(i, &line);
        _ = buf_append(&out, line.ptr, line.len);
        _ = buf_append_byte(&out, 10);
        i = i + 1;
    }
    return out;
}

// 浮层选中项 → 动作名（`✓ `/两空格 之后的第一个词）。认不出来的行（确认浮层里的
// 「取消」、别的浮层漏进来的条目）返回 false —— 调用方按「什么都没选」处理，绝不猜
fn agent_tui_worktree_parse(sel: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if sel.len < 3 {
        return false;
    }
    const p: &const byte = sel.ptr as &const byte;
    var s: usize = 2;
    // "✓" 是 3 字节（E2 9C 93）+ 1 空格 = 4；"  " 是 2 字节
    if p[0] == 0xE2 as byte {
        s = 4;
    }
    while s < sel.len && p[s] != 32 as byte && p[s] != 9 as byte {
        _ = buf_append_byte(out, p[s]);
        s = s + 1;
    }
    if out.len == 0 {
        return false;
    }
    var i: usize = 0;
    while i < WT_ACT_N {
        if bufx_eq_cstr(out.ptr as &const byte, out.len, wt_act_name(i)) {
            return true;
        }
        i = i + 1;
    }
    buf_reset(out);
    return false;
}

// 这个动作要不要先过一道确认？（finish / discard 都会删掉 worktree 与分支）
fn wt_act_needs_confirm(act: &const Buf) bool {
    return bufx_eq_cstr(act.ptr as &const byte, act.len, "finish" as &const byte) ||
        bufx_eq_cstr(act.ptr as &const byte, act.len, "discard" as &const byte);
}

// 动作名 → 下标（`wt_act_name` 的反解）。认不出返回一个**越界**值，由调用方当非法动作拒掉。
fn wt_act_index_of(act: &const Buf) usize {
    if bufx_eq_cstr(act.ptr as &const byte, act.len, "finish" as &const byte) {
        return WT_ACT_FINISH;
    }
    return WT_ACT_DISCARD;
}

// 打开 `/worktree` 动作选择浮层（游标默认落在 status：打开就回车 = P37 的裸命令看状态）
export fn agent_tui_worktree_open() void {
    const items: Buf = agent_tui_worktree_items();
    defer { buf_free(&items); }
    const title: &const byte = "Git worktree（enter 执行 · esc 取消）" as &const byte;
    tui_overlay_menu(TUI_OVK_WORKTREE, title, bufx_cstr_len(title),
        items.ptr as &const byte, items.len, WT_ACT_STATUS);
}

// 执行选中的动作：文本与滚动模式共用 wt_cmd_run，结果以一条 notice 落进转录
fn agent_tui_worktree_exec(cfg: &Config, act: &const Buf) void {
    var out: Buf = buf_new(16384);
    defer { buf_free(&out); }
    wt_cmd_run(cfg, act.ptr as &const byte, act.len, &out);
    if out.len == 0 {
        return;
    }
    tui_add_notice(out.ptr as &const byte, out.len);
}

// 消费 /worktree 浮层的结果（TUI 主循环与自测共用；返回 true = 处理了一个浮层结果）
export fn agent_tui_worktree_handle(cfg: &Config, h: &const History, sel: &const Buf) bool {
    const kind: u8 = tui_overlay_kind();
    if kind == TUI_OVK_WORKTREE {
        var act: Buf = buf_new(32);
        defer { buf_free(&act); }
        if !agent_tui_worktree_parse(sel, &act) {
            return true;
        }
        if wt_act_needs_confirm(&act) {
            // 不可逆动作：选定不生效，先翻一道确认（游标默认停在「取消」）
            var line: Buf = buf_new(256);
            defer { buf_free(&line); }
            agent_tui_worktree_line(wt_act_index_of(&act), &line);
            var items: Buf = buf_new(512);
            defer { buf_free(&items); }
            _ = buf_append(&items, line.ptr, line.len);
            _ = buf_append_cstr(&items, "\n取消\n");
            var ct: Buf = buf_new(64);
            defer { buf_free(&ct); }
            _ = buf_append_cstr(&ct, "确认 ");
            _ = buf_append(&ct, act.ptr as &const byte, act.len);
            _ = buf_append_cstr(&ct, "？");
            var prompt: Buf = buf_new(256);
            defer { buf_free(&prompt); }
            if bufx_eq_cstr(act.ptr as &const byte, act.len, "finish" as &const byte) {
                _ = buf_append_cstr(&prompt,
                    "会提交 worktree 里的改动、合并回基分支，然后删掉 worktree 与分支（合并后不可撤销）。" as &const byte);
            } else {
                _ = buf_append_cstr(&prompt,
                    "会直接删掉 worktree 与它的分支，里面的改动**不会**合并，也找不回来。" as &const byte);
            }
            tui_overlay_menu_confirm(TUI_OVK_WORKTREE_CONFIRM, ct.ptr as &const byte, ct.len,
                prompt.ptr as &const byte, prompt.len, items.ptr as &const byte, items.len, 1);
            return true;
        }
        agent_tui_worktree_exec(cfg, &act);
        _ = h;
        return true;
    }
    if kind == TUI_OVK_WORKTREE_CONFIRM {
        var act: Buf = buf_new(32);
        defer { buf_free(&act); }
        // 「取消」与认不出的行都会走到这里：反解失败 ⇒ 什么都不做
        if !agent_tui_worktree_parse(sel, &act) {
            return true;
        }
        agent_tui_worktree_exec(cfg, &act);
        return true;
    }
    return false;
}

// ============================================================
// P91：/goal 的动作选择浮层（TUI）
//
// 用户报的：命令面板里选中 `goal` 回车之后，屏幕上只有一张状态报告 —— 目标这件事
// 有六个动作（看 / 建 / 改 / 暂停 / 恢复 / 清除），却没有一处能把它们**列出来**。
// 同一条线上的 /permission、/model、/effort、/worktree 早就都是**底对齐选择浮层**了
// （P41 那条注释里写着同一句话），这一节把 /goal 补齐：
//   * 裸 `/goal`（手敲或面板选中）开浮层，六个动作一行一个（`✓` 标「当前续跑态对应的
//     那个动作」，对齐 DSH `commandHint` 的口径），游标**默认停在 status** ——
//     所以「打开就回车」仍等于 P29 的裸命令看状态，老手感一个字节不变；
//   * 六个动作执行完都开**原来那张状态浮层**（`TUI_OVK_GOAL`，标题「目标（esc 关闭）」）
//     显示 `goal_cmd_run` 的回执 —— 与带参数 `/goal …` 今天的落点完全一致；
//   * `create` / `edit` 先在 P48 的单行输入框里收正文（`edit` 预填当前正文），
//     空正文/取消/终端太矮一律落 notice（绝不静默、也不 fail closed：这是「换个地方说」）；
//   * `clear` 删的是 goal.json，但**不翻二次确认**：DSH 的 GoalBar 清除本身就不确认，
//     `/goal clear` 今天也没有；菜单行自带一句「不可撤销」，且游标默认不落在它上面。
//
// ⚠ 一条必须记住的边界：`status` / `create` / `edit` **不走 `goal_cmd_run` 的控制词解析**
// （status → `goal_cmd_show`；create / edit → `goal_cmd_create` /
// `goal_cmd_edit`）——
// 那边的控制词只有 clear/pause/resume/edit，其余任何非空后缀都是**字面目标**：
// 输入框里填的正文是**数据**（填「pause」若走解析就变成了一次暂停），而菜单默认游标
// 那一行是 `status`（走解析会真的建出一个叫 "status" 的目标）。控制词那条路只属于
// 「人敲的整行」。pause / resume / clear 三条是控制词，照旧走整行入口。
//
// 与 /worktree 那条线的分工完全相同：浮层的**结果**由主循环收口（`TUI_OVK_GOAL_MENU`
// 那一支），泵点只给一次回执并把结果原样留在队列里 —— create/edit 要弹阻塞式输入框，
// 不能塞进泵点（那里是流式/工具循环的中间，见踩坑 47 的同族理由）。
// ============================================================

// 动作表：机器名（与 `/goal <词>` 的词汇一致，也是浮层条目行首那个词）与一行说明。
// 顺序就是浮层里的行序；`GOAL_ACT_STATUS` 是「打开时游标停哪儿」。
const GOAL_ACT_N: usize = 6;
const GOAL_ACT_STATUS: usize = 0;

// goal 动作的**机器名**（第 i 个）：status/create/edit/pause/resume/clear。
// 与 `goal_act_gloss` 配对，两个表**必须一一对应**（浮层生成与反解共用它们）。
fn goal_act_name(i: usize) &const byte {
    if i == 0 {
        return "status" as &const byte;
    }
    if i == 1 {
        return "create" as &const byte;
    }
    if i == 2 {
        return "edit" as &const byte;
    }
    if i == 3 {
        return "pause" as &const byte;
    }
    if i == 4 {
        return "resume" as &const byte;
    }
    return "clear" as &const byte;
}

// goal 动作的**显示名**（说明那一行）。`status` 那行带上**当前状态**（有目标时
// `active · 3/20 · armed`），因为它是默认游标停的那一行、也是「打开就回车」的结果。
// g 是调用方 `goal_load` 出来的当前目标（没有目标时 active_state=false）。
fn goal_act_gloss(i: usize, g: &const Goal, out: &Buf) void {
    if i == 0 {
        if !g.active_state {
            _ = buf_append_cstr(out, "看当前状态（现在还没有目标）" as &const byte);
            return;
        }
        _ = buf_append_cstr(out, "看当前状态（" as &const byte);
        _ = buf_append(out, g.phase.ptr as &const byte, g.phase.len);
        _ = buf_append_cstr(out, " · " as &const byte);
        _ = buf_append_i64(out, g.round as i64);
        _ = buf_append_cstr(out, "/" as &const byte);
        _ = buf_append_i64(out, g.max_rounds as i64);
        // P116：沿用 get_goal / `/goal` 的**生效值**口径（盘上意愿 && 进程本地授权）——
        // `--resume` 之后盘上可能仍是 true，只报它就会写着 armed 而驱动器其实停着。
        if g.armed && g_goal_armed {
            _ = buf_append_cstr(out, " · armed" as &const byte);
        } else {
            _ = buf_append_cstr(out, " · disarmed" as &const byte);
        }
        _ = buf_append_cstr(out, "）" as &const byte);
        return;
    }
    if i == 1 {
        _ = buf_append_cstr(out, "建一个新目标（先在输入框里写正文）" as &const byte);
        return;
    }
    if i == 2 {
        _ = buf_append_cstr(out, "改目标正文（phase / 授权 / 轮次都不动）" as &const byte);
        return;
    }
    if i == 3 {
        _ = buf_append_cstr(out, "暂停，并停掉自动续跑" as &const byte);
        return;
    }
    if i == 4 {
        _ = buf_append_cstr(out, "恢复，并重新授权自动续跑" as &const byte);
        return;
    }
    _ = buf_append_cstr(out, "清除目标（删掉 goal.json，不可撤销）" as &const byte);
}

// 这个动作是不是「当前续跑态对应的那个」—— `✓` 挂在它那一行（对齐 DSH 的 commandHint：
// active+armed → pause；paused/blocked/active-disarmed → resume；
// 无目标或 complete → create）。
fn goal_act_marked(i: usize, g: &const Goal) bool {
    // P116：`✓` 也跟**进程本地授权**走（与 get_goal / `/goal` 的 Activation 同口径）——
    // 只看盘上的 armed，`--resume` 之后会把「pause」标成当前动作，而驱动器其实停着。
    const on: bool = g.armed && g_goal_armed;
    if i == 1 {
        return !g.active_state || goal_phase_is(g, "complete" as &const byte);
    }
    if i == 3 {
        return g.active_state && on
            && goal_phase_is(g, "active" as &const byte);
    }
    if i == 4 {
        return g.active_state && !on
            && !goal_phase_is(g, "complete" as &const byte);
    }
    return false;
}

// 浮层里的一行：`✓ `（当前续跑态对应的动作）或两个空格 + 机器名补齐 + ` — ` + 一行说明。
// 生成与反解共用这一份（与 /worktree 的选择器同一套排版）。
fn agent_tui_goal_line(i: usize, g: &const Goal, out: &Buf) void {
    buf_reset(out);
    const name: &const byte = goal_act_name(i);
    const n: usize = bufx_cstr_len(name);
    if goal_act_marked(i, g) {
        _ = buf_append_cstr(out, "✓ ");
    } else {
        _ = buf_append_cstr(out, "  ");
    }
    _ = buf_append(out, name, n);
    var pad: usize = n;
    while pad < 8 {          // 机器名补齐（最长 status/create/resume = 6 列 + 2 空格）
        _ = buf_append_byte(out, 32);
        pad = pad + 1;
    }
    _ = buf_append_cstr(out, "— ");
    goal_act_gloss(i, g, out);
}

// 拼 `/goal` 动作选择框的条目：六个动作一行一个，`✓` 标当前续跑态对应的那个，
// 游标默认停在 `status` —— 所以「打开就回车」与裸 `/goal` 的文本版逐字节同效。
// 自己读一份当前目标（调用方不必先 load）；没有目标时 phase/round 走空值与 0。
fn agent_tui_goal_items(cfg: &const Config) Buf {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    _ = goal_load(cfg, &g);
    var out: Buf = buf_new(1024);
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    var i: usize = 0;
    while i < GOAL_ACT_N {
        agent_tui_goal_line(i, &g, &line);
        _ = buf_append(&out, line.ptr, line.len);
        _ = buf_append_byte(&out, 10);
        i = i + 1;
    }
    return out;
}

// 打开 `/goal` 动作选择浮层（游标默认落在 status：打开就回车 = P29 的裸命令看状态）
export fn agent_tui_goal_open(cfg: &const Config) void {
    const items: Buf = agent_tui_goal_items(cfg);
    defer { buf_free(&items); }
    const title: &const byte = "会话目标（enter 执行 · esc 取消）" as &const byte;
    tui_overlay_menu(TUI_OVK_GOAL_MENU, title, bufx_cstr_len(title),
        items.ptr as &const byte, items.len, GOAL_ACT_STATUS);
}

// 浮层选中项 → 动作名（`✓ `/两空格 之后的第一个词）。认不出来的行（别的浮层漏进来的
// 条目）返回 false —— 调用方按「什么都没选」处理，绝不猜。
fn agent_tui_goal_parse(sel: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if sel.len < 3 {
        return false;
    }
    const p: &const byte = sel.ptr as &const byte;
    var s: usize = 2;
    // "✓" 是 3 字节（E2 9C 93）+ 1 空格 = 4；"  " 是 2 字节
    if p[0] == 0xE2 as byte {
        s = 4;
    }
    while s < sel.len && p[s] != 32 as byte && p[s] != 9 as byte {
        _ = buf_append_byte(out, p[s]);
        s = s + 1;
    }
    if out.len == 0 {
        return false;
    }
    var i: usize = 0;
    while i < GOAL_ACT_N {
        if bufx_eq_cstr(out.ptr as &const byte, out.len, goal_act_name(i)) {
            return true;
        }
        i = i + 1;
    }
    buf_reset(out);
    return false;
}

// 把一条动作执行掉，并把结果开成**状态浮层**（`TUI_OVK_GOAL`，标题「目标（esc 关闭）」）。
// text 只在 create / edit 上有意义（输入框收来的正文）。
//
// ⚠ `status` **必须**走 `goal_cmd_show`：`goal_cmd_run` 的控制词只有
// clear/pause/resume/edit，
// 别的一律当**字面目标** —— `/goal status` 会真的建出一个叫 "status" 的目标（菜单里
// 默认游标那一行，回车就中）。pause / resume / clear 三条走整行入口是对的（它们是控制词），
// 措辞与状态机只有一处实现。
fn agent_tui_goal_run(cfg: &const Config, act: &const Buf,
        text: &const Buf) void {
    var gtxt: Buf = buf_new(4096);
    defer { buf_free(&gtxt); }
    if bufx_eq_cstr(act.ptr as &const byte, act.len, "status" as &const byte) {
        _ = goal_cmd_show(cfg, &gtxt);
    } else if bufx_eq_cstr(act.ptr as &const byte, act.len,
            "create" as &const byte) {
        _ = goal_cmd_create(cfg, text.ptr as &const byte, 0, text.len, &gtxt);
    } else if bufx_eq_cstr(act.ptr as &const byte, act.len,
            "edit" as &const byte) {
        _ = goal_cmd_edit(cfg, text.ptr as &const byte, 0, text.len, &gtxt);
    } else {
        var line: Buf = buf_new(64);
        defer { buf_free(&line); }
        _ = buf_append_cstr(&line, "/goal " as &const byte);
        _ = buf_append(&line, act.ptr as &const byte, act.len);
        _ = goal_cmd_run(cfg, &line, &gtxt);
    }
    const gtitle: &const byte = "目标（esc 关闭）" as &const byte;
    tui_overlay_list(TUI_OVK_GOAL, gtitle, strlen(gtitle),
        gtxt.ptr as &const byte, gtxt.len);
    // 动作可能改过 goal.json：常驻块的目标段当场重画（status 也会走一遍，幂等）
    tasks_goal_reload(cfg);
    _ = tasks_panel_sync();
}

// create / edit 那两条动作的**输入框标题**与**预填内容**：create 空着，edit 预填当前
// 正文（改一改比重打一遍顺手）。抽成一个函数是为了让自测**不必走阻塞的等待**就能断言
// 「框会叫什么、会预填什么」—— 那条同步路在 headless 里走不通（见 agent_tui_goal_handle）。
fn agent_tui_goal_prompt(cfg: &const Config, is_edit: bool, title_out: &Buf,
        prefill: &Buf) void {
    buf_reset(title_out);
    buf_reset(prefill);
    if !is_edit {
        _ = buf_append_cstr(title_out,
            "新目标（enter 采纳 · esc 取消）" as &const byte);
        return;
    }
    _ = buf_append_cstr(title_out,
        "改目标正文（enter 采纳 · esc 取消）" as &const byte);
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if goal_load(cfg, &g) {
        _ = buf_append(prefill, g.objective.ptr as &const byte,
            g.objective.len);
    }
}

// 消费 /goal 动作浮层的结果（TUI 主循环与自测共用；返回 true = 处理了一个浮层结果）。
//
// create / edit 先弹 P48 的单行输入框收正文：取消（esc / 终端太矮）就**什么都不做**
// 并落一条 notice —— 静默是最难查的一种，用户分不清「没选中」与「选了没生效」。
// 空正文同样拒掉（`goal_cmd_create` 会照收，于是盘上出现一个 `objective:""` 的目标）。
//
// ⚠ 输入框是**阻塞式**的（`tui_title_input_wait` 自己抽帧等按键，见 ask.uya）：
// 它回来之后浮层状态已经换过一轮（kind 是那个输入框的 TITLE，不再是 GOAL_MENU），
// 所以阻塞之后**不许再读 kind 做判断** —— 开状态浮层由 `agent_tui_goal_run` 直接开
// （它自己 `tui_overlay_list(TUI_OVK_GOAL, …)`），动作名从 `sel` 重新解析一遍
// （调用方各自持有 sel，阻塞期间不会被改写）。
export fn agent_tui_goal_handle(cfg: &const Config, sel: &const Buf) bool {
    if tui_overlay_kind() != TUI_OVK_GOAL_MENU {
        return false;
    }
    var act: Buf = buf_new(32);
    defer { buf_free(&act); }
    if !agent_tui_goal_parse(sel, &act) {
        return true;
    }
    const is_create: bool = bufx_eq_cstr(act.ptr as &const byte, act.len,
        "create" as &const byte);
    const is_edit: bool = bufx_eq_cstr(act.ptr as &const byte, act.len,
        "edit" as &const byte);
    if !is_create && !is_edit {
        agent_tui_goal_run(cfg, &act, &act);
        return true;
    }
    // 输入框的标题与预填由 agent_tui_goal_prompt 一处生成（自测用同一个函数断言，
    // 不走这条阻塞路）
    var title: Buf = buf_new(128);
    defer { buf_free(&title); }
    var prefill: Buf = buf_new(1024);
    defer { buf_free(&prefill); }
    agent_tui_goal_prompt(cfg, is_edit, &title, &prefill);
    // 阻塞之前先把浮层收干净（输入框自己会再开一张）：省得残留的 kind 被后面读到
    tui_overlay_close();
    var picked: Buf = buf_new(1024);
    defer { buf_free(&picked); }
    const acted: i32 = tui_title_input_wait(title.ptr as &const byte, title.len,
        prefill.ptr as &const byte, prefill.len, &picked);
    if acted == 0 {
        const msg: &const byte = "（已取消：目标未改动）" as &const byte;
        tui_add_notice(msg, bufx_cstr_len(msg));
        return true;
    }
    if picked.len == 0 {
        const msg: &const byte = "（目标是空的：至少写一个可见字符；目标未改动）" as &const byte;
        tui_add_notice(msg, bufx_cstr_len(msg));
        return true;
    }
    // 动作名重新解析一遍（不依赖跨阻塞调用的任何缓存）
    if !agent_tui_goal_parse(sel, &act) {
        return true;
    }
    agent_tui_goal_run(cfg, &act, &picked);
    return true;
}

// ============================================================
// P9：自动压缩
//
// 压力 = 最近一次响应的 prompt_tokens（DSH tokenMeter 的口径）；没有就按字节/4 估。
// 超过 floor(contextWindow × 0.8) 时：调一次模型做 checkpoint，然后
//   system 原文保留 + checkpoint 消息插在其后 + 尾部最近一段原文保留。
// ============================================================
fn agent_pressure_tokens(cfg: &const Config, h: &const History) i64 {
    if g_last_prompt_tokens > 0 {
        return g_last_prompt_tokens;
    }
    // 估算：请求体大致是历史 + tools + system
    var est: i64 = 0;
    var i: usize = 0;
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        est = est + ((m.text_len + m.extra_len) as i64) / 4;
        i = i + 1;
    }
    _ = cfg;
    return est;
}

// P88：组**摘要请求**的输入 —— `system + 被遮蔽的那一段 + 摘要提示词`。
//
// 为什么不再带整份历史（这是 §19.10 那个死锁的根因）：摘要请求原来是把 `h` 整个复制
// 一份再挂提示词，于是**它自己的体量与主请求一样大** —— 历史一旦超过窗口，连
// 「压小它」的那一发请求也被同一个窗口拒掉，压缩永远起不来，而屏幕上只看到主请求
// 反复 500/400。摘要只需要看**要被替换掉的那一段**，所以这里只带那一段。
//
// 预算闸门（`budget`）：系统提示词 + 提示词 + 工具表先扣掉，剩下的按**保守**口径
// （`CMP_EST_*`）从**新往旧**装。装不下的最老那几段直接不进摘要请求 —— 它们照样会被
// `cmp_apply` 遮蔽掉，只是没有进摘要（`from_out` 回传起点，调用方据此如实回执）。
//
// ⚠ **闸门只在窗口装得下「固定开销」时才生效**（`budget > fixed`）：窗口小到连
// system + 提示词 + 工具表都放不下时，它已经不是一个「请求上界」了（那是触发线的
// 语义 —— 实测 `compact-auto` 那轮给的 200 就是这种口径），此时**退回不设闸门**
// 的旧行为。反过来（不区分这一档就一律拦下）会让压缩在一切小窗口配置上**永远**
// 不发生 —— 而「压缩永远不发生」正是 §19.10 那个死锁的成因，等于用一个死锁换另一个。
// 返回 false 只剩一条路：闸门生效、但**一条**被遮蔽的消息都装不进去（摘要无从谈起）。
fn agent_summary_input(cfg: &const Config, h: &const History, shadow: usize,
                       tmp: &History, from_out: &usize) bool {
    var prompt: Buf = buf_new(8192);
    defer { buf_free(&prompt); }
    if !cmp_summary_prompt_ctx(h, shadow, &prompt) {
        return false;
    }
    var from: usize = 1;                     // 0 = system，永远保留（它是请求的骨架）
    const budget: i64 = cmp_summary_budget(cfg.context_window);
    if budget > 0 {
        // 先扣掉三样不随遮蔽段伸缩的东西：system、摘要提示词、tools schema。
        var fixed: i64 = 0;
        if h.len > 0 {
            const sys_n: usize = msg_at(h, 0).text_len + msg_at(h, 0).extra_len;
            fixed = cmp_est_tokens(sys_n);
        }
        fixed = fixed +% cmp_est_tokens(prompt.len);
        fixed = fixed +% cmp_est_tokens(tools_json_max_bytes(cfg.allow_shell));
        const room: i64 = budget -% fixed;
        // room <= 0 = 窗口装不下固定开销 ⇒ 窗口不是可用的请求上界，闸门让开（见上）。
        if room > 0 {
            from = cmp_fit_start(h, 1, shadow, room);
            if from >= shadow {
                return false;
            }
        }
    }
    from_out[0] = from;
    // system 原文（照抄）＋ 被遮蔽段的正文
    var i: usize = 0;
    while i < shadow {
        if i != 0 && i < from {
            i = i + 1;
            continue;                        // 预算外的最老那几段：不进摘要请求
        }
        const m: &const Msg = msg_at(h, i);
        _ = hist_push_msg_kind(tmp, m.role, m.kind, m.text as &const byte,
                               m.text_len, m.extra as &const byte,
                               m.extra_len);
        i = i + 1;
    }
    return hist_push(tmp, ROLE_USER, prompt.ptr as &const byte, prompt.len);
}

// force=true 时忽略阈值（/compact 手动触发）
fn agent_maybe_compact(cfg: &const Config, h: &History, step: i32, force: bool) bool {
    const cw: i64 = cfg.context_window;
    // 窗口未知（<=0）不再直接放行：智能压缩的绝对线与增长线不依赖窗口，
    // 而「窗口未知就永不压」正是大窗口/未知窗口路线上一路涨到爆的原因。
    // 窗口线的判据交给 cmp_should_compact（cw<=0 时它内部返回 0 = 那条线不成立）。
    const pressure: i64 = agent_pressure_tokens(cfg, h);
    // 增长线的基线：第一次采到时就用当前压力当起点（会话开工必然先到这一步）。
    // 不在这里播种的话基线一直是 -1，增长线永远不成立 —— 只剩绝对线兜底，
    // 而绝对线是固定阈值，会话一旦压到它以下就再也不涨不上来（少了滞回）。
    if cmp_growth_base_tokens < 0 && pressure > 0 {
        cmp_growth_reset(pressure);
    }
    if pressure <= 0 {
        return false;
    }
    const shadow: usize = cmp_shadow_count(h, pressure);
    if shadow == 0 {
        return false;
    }
    const shadow_bytes: usize = cmp_shadow_bytes(h, shadow);
    if !force && !cmp_should_compact_ctx(pressure, cw, shadow_bytes, step) {
        return false;
    }
    // 组摘要请求：system + 被遮蔽段 + 摘要提示词（DSH 把提示词作为最后一条 user 消息）
    var tmp: History = hist_init();
    defer { hist_free(&tmp); }
    var from: usize = 1;
    if !agent_summary_input(cfg, h, shadow, &tmp, &from) {
        // 预算闸门都没放行（连 system + 提示词都装不下窗口）：**不许**发出这一发，
        // 它只会换回一个 400，还会把「压不动」伪装成「摘要失败」。
        if !cfg.quiet {
            out_err("[compact] 摘要请求放不进上下文窗口，跳过本次压缩（见 --context-window）\n");
        }
        return false;
    }
    if from > 1 && !cfg.quiet {
        // 如实回执：最老的那几段没有进摘要，它们会被直接换成 checkpoint（信息有损）
        out_err("[compact] 注：最老的 ");
        out_err_dec((from - 1) as usize);
        out_err(" 条放不进摘要请求，将被直接丢弃\n");
    }
    var req: Buf = buf_new(request_bytes_needed(&tmp, cfg));
    defer { buf_free(&req); }
    var url: Buf = buf_new(cfg.base_url.len + 24);
    defer { buf_free(&url); }
    var hdrs: Buf = buf_new(512);
    defer { buf_free(&hdrs); }
    if !build_headers(cfg, &hdrs) {
        return false;
    }
    var o: ChatOut = chat_out_new();
    defer { chat_out_free(&o); }
    var tc: TlsConn = tls_conn_empty();

    // 摘要请求也跟随生效协议；未声明时同样允许一次协商回退（否则空窗口路由上压不动）
    var status: i32 = 0;
    var tried: i32 = 0;
    var interrupted: bool = false;
    while true {
        tried = tried + 1;
        const style: u8 = api_style_now(cfg);
        if !api_url_into(cfg, style, &url) || !build_model_request(cfg, &tmp, &req, style) {
            return false;
        }
        var guard: FdGuard = FdGuard{ saved: -1, nullfd: -1, active: false };
        tls_noise_mute(&guard, !cfg.tls_debug && !hc_debug);
        const res: !i32 = llm_stream_style(
            style,
            url.ptr[0: url.len],
            hdrs.ptr[0: hdrs.len],
            req.ptr as &const byte,
            req.len,
            cfg.timeout_ms,
            cfg.max_response,
            cfg.verify,
            cfg.pin.ptr[0: cfg.pin.len],
            &o,
            false,
            false,
            // P31：压缩也是「请求在飞」的一段。这里原来写死 false → 摘要请求的整段流式
            // 一个泵点都没有：上下文一大（自动压缩或 /compact），界面就是冻的，敲 /status
            // 要等摘要回来。跟随交互标志之后，键盘与运行中的只读命令照常服务，而且
            // esc/ctrl+c 现在能中断压缩本身。
            g_interactive
        );
        tls_noise_unmute(&guard);
        status = res catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            if eid == @error_id(error.LlmInterrupted) {
                interrupted = true;
            }
            0;
        };
        if api_negotiate(cfg, style, status) && tried < 2 {
            buf_reset(&o.content);   // 换协议重发：上一轮没解析出内容，清掉以防串味
            continue;
        }
        api_lock(cfg, style);
        break;
    }
    if interrupted {
        // 用户按了 esc/ctrl+c：这不是「摘要失败」，别用那句话误导人（历史一个字没改）
        if !cfg.quiet {
            out_err("[compact] 已中断（历史未改动）\n");
        }
        return false;
    }
    if status != 200 || o.content.len == 0 {
        if !cfg.quiet {
            out_err("[compact] 摘要请求失败，跳过本次压缩");
            if status != 0 {
                out_err("（HTTP ");
                out_err_dec(status as usize);
                out_err("）");
            }
            out_err("\n");
        }
        return false;
    }
    // 应用：先算被遮蔽内容的字节数（cmp_apply 会用），再改写历史
    if !cmp_apply(h, shadow, &o.content) {
        if !cfg.quiet {
            out_err("[compact] 摘要不比被遮蔽内容短，放弃压缩\n");
        }
        return false;
    }
    // cmp_apply 从 0 开始遮蔽，把 system 也清掉了：这里补回
    //   [system 原文] + [checkpoint 消息] + [保留的尾部]
    var ck: Buf = buf_new(o.content.len + 512);
    defer { buf_free(&ck); }
    if cmp_build_checkpoint(&o.content, &ck) {
        // 先插 checkpoint 到 0，再把 system 插到 0 → 顺序就是 system, checkpoint, …
        _ = hist_insert_at(h, 0, ROLE_USER, ck.ptr as &const byte, ck.len, null, 0);
        var sp: Buf = buf_new(32768);
        defer { buf_free(&sp); }
        if agent_system_prompt(cfg, &sp) {
            _ = hist_insert_at(h, 0, ROLE_SYSTEM, sp.ptr as &const byte, sp.len, null, 0);
        }
        // P88：**落盘**。不落这一步的话压缩只活在内存里，而 `--resume` 是把日志
        // 从头折一遍 —— 被压掉的那一段会原样回来，下次启动又是同一个超窗死锁
        // （§19.10 记录的正是这个：会话从此再也发不出任何请求）。
        agent_log_checkpoint(ck.ptr as &const byte, ck.len, shadow, from);
    }
    if !cfg.quiet {
        out_err("[compact] 已压缩较早的 ");
        out_err_dec(shadow);
        out_err(" 条消息（pressure=");
        out_err_dec(pressure as usize);
        out_err("）\n");
    }
    agent_log_simple("compaction/summary", "{\"kind\":\"auto\"}");
    g_last_prompt_tokens = 0;
    // 智能压缩：压完把压力基线落到**压缩后的实际压力**上，增长线据此重新起算。
    // 不重置的话基线还停在压之前的值，下一次增长判据会立刻再次成立（连压）。
    const after_pressure: i64 = agent_pressure_tokens(cfg, h);
    cmp_growth_reset(after_pressure);
    cmp_last_compact_step = step;
    cmp_last_compact_pressure = after_pressure;
    return true;
}

// 在 idx 处插入一条消息（其余后移）
fn hist_insert_at(h: &History, idx: usize, role: u8, text: &const byte, text_len: usize, extra: &const byte, extra_len: usize) bool {
    if idx > h.len {
        return false;
    }
    // 先腾容量再取地址：realloc 可能把整块搬走
    if !hist_reserve(h, 1) {
        return false;
    }
    var i: usize = h.len;
    while i > idx {
        const cur: usize = i;
        const prev: usize = i - 1;
        const cm: &Msg = msg_at_mut(h, cur);
        const pm: &Msg = msg_at_mut(h, prev);
        cm[0] = pm[0];
        i = prev;
    }
    const slot: &Msg = msg_at_mut(h, idx);
    slot[0] = Msg{ role: role, kind: CMP_KIND_TOOL, text: null, text_len: 0, extra: null, extra_len: 0 };
    if text_len > 0 {
        slot.text = hist_dup(text, text_len);
        if (slot.text as usize) == 0 {
            return false;
        }
    }
    slot.text_len = text_len;
    if extra_len > 0 {
        slot.extra = hist_dup(extra, extra_len);
        if (slot.extra as usize) == 0 {
            return false;
        }
    }
    slot.extra_len = extra_len;
    h.len = h.len + 1;
    h.bytes = h.bytes + text_len + extra_len;
    return true;
}

// --list-dsh-sessions：列出 DSH 自己的会话
fn agent_list_dsh_sessions(cfg: &const Config) i32 {
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_dsh_home(cfg, &home) {
        out_err("error: 找不到 DSH_HOME\n");
        return AGENT_USAGE;
    }
    var s: DshSessions = DshSessions{ items: [], n: 0 };
    dshs_init(&s);
    defer { dshs_free(&s); }
    dshs_list(home.ptr[0: home.len], &"x"[0: 0], &s);
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    dshs_render_list(&s, &out, home.ptr[0: home.len]);
    out_err_bytes(out.ptr as &const byte, out.len);
    return AGENT_OK;
}

// DSH_HOME：cfg.dsh_home > $DSH_HOME > ~/.dsh
//
// ⚠ `dsh_home_resolve` 的入参是 **C 串**，而 `cfg.dsh_home` 是 `Buf`（没有 NUL
// 结尾）：直接传指针会一路读到相邻内存 —— 拼出来的路径多带一个字节，而症状只是
// 「读不到 settings.yaml」（与 `whost.uya` 的 `dwh_dsh_home` 同一条，那里实测到
// `/tmp/lp2/dsh4`）。所以先补一个 NUL 再传。
fn agent_default_dsh_home(cfg: &const Config, out: &Buf) bool {
    var ex: Buf = buf_empty();
    defer { buf_free(&ex); }
    if cfg.dsh_home.len > 0 {
        ex = buf_new(cfg.dsh_home.len + 1);
        if !buf_append(&ex, cfg.dsh_home.ptr as &const byte, cfg.dsh_home.len) {
            return false;
        }
        if !buf_append_byte(&ex, 0) {
            return false;
        }
        return dsh_home_resolve(ex.ptr as &const byte, out);
    }
    return dsh_home_resolve("" as &const byte, out);
}

// **非交互**回合入口（一次性任务）：查 key → 建历史 → `agent_turn_loop`。
// `defer` 里 `hist_free` + `agent_session_close`（顺序不能换：会话关闭要用到历史之外的状态）。
fn agent_run(cfg: &Config) i32 {
    if cfg.api_key.len == 0 {
        out_err("error: no API key. set UYA_AGENT_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY\n");
        return AGENT_USAGE;
    }
    var h: History = hist_init();
    defer { hist_free(&h); }
    defer { agent_session_close(); }
    if !agent_history_begin(cfg, &h, &cfg.task) {
        out_err("error: cannot build history\n");
        return AGENT_PROTO;
    }
    if cfg.task.len > 0 && h.len > 0 {
        // 新建会话时才记录本轮任务（恢复会话时任务为空）
        agent_log_user(cfg.task.ptr as &const byte, cfg.task.len, false);
    }
    return agent_turn_loop(cfg, &h);
}

// ============================================================
// CLI
// ============================================================
fn print_usage() void {
    out_err("uya-agent — 极简 CLI 编程 agent（纯 Uya）\n\n");
    out_err("用法:\n");
    out_err("  uya-agent [任务词...]            一次性执行任务\n");
    out_err("  uya-agent                        REPL：逐行输入任务\n");
    out_err("  uya-agent --selftest             离线自测（内置 mock LLM，不需要网络与 key）\n");
    out_err("  uya-agent --probe                传输层探针（打印 HTTP 状态与 leaf 指纹）\n\n");
    out_err("选项:\n");
    out_err("  --base-url URL      默认 https://api.deepseek.com/v1\n");
    out_err("  --model NAME        默认 deepseek-chat\n");
    out_err("  --workspace DIR     工作目录（工具只在这里面活动），默认当前目录；\n");
    out_err("                      恢复会话时默认跟随会话记录的工作区，这条显式指定优先\n");
    out_err("  --max-steps N       熔断上限：最多几轮工具调用，默认 0 = 不限（跑到模型给出最终答案）\n");
    out_err("  --max-response N    响应体上限字节，默认 262144\n");
    out_err("  --timeout-ms N      单次 HTTP 超时，默认 120000\n");
    out_err("  --no-shell          不提供 run_shell 工具\n");
    out_err("  --api=MODE          线协议：openai-responses（默认，未声明时先试它）| openai-completions\n");
    out_err("                      不写 = 未声明：先打 /responses，404/405/501 自动回退 chat/completions（每进程一次）\n");
    out_err("  --reasoning-effort V  推理强度：completions 发顶层 reasoning_effort，responses 发 reasoning.effort\n");
    out_err("                      （compat.supportsReasoningEffort=false 时不发；off/none = 不发）\n");
    out_err("  --exec-effort V     低思考执行态：前 --exec-after N 步用 --reasoning-effort 把方案想清，\n");
    out_err("                      第 N+1 步起切到 V 执行（默认关；人运行中 /effort 改过就不自动切）\n");
    out_err("  --exec-after N      想清的窗口（步数）；0 = 关闭低思考执行态（默认）\n");
    out_err("  --grace-steps N     验收类命令在改动之后首次跑绿起，还允许再走 N 步；0 = 只提醒不截断\n");
    out_err("  --no-stream         关闭流式（SSE），回退到一次性响应\n");
    out_err("  --compat-fold       工具结果折叠成一条 user 消息（老端点兼容）\n");
    out_err("  --no-stream-options 不发送 stream_options.include_usage\n");
    out_err("  --show-reasoning    显示思考行：滚动模式=运行中在提示符那一行滚动、结束落一行；\n");
    out_err("                      TUI=额外把思考收进转录条目（TUI 的状态区默认已有实时一行）\n");
    out_err("  --show-usage        每轮打印 token 用量（in/out/cache/reasoning）\n");
    out_err("  --tool-lines N      工具正文：默认 0 = 只留一行；N>0 = 首尾各 N 行（含 diff/todo 清单）\n");
    out_err("  --debug-dump FILE   诊断原文（网关错误体/坏 payload 等）以**原始字节**追加落盘；\n");
    out_err("                      默认关：转录里只有转义预览，全文仍进会话日志 diag/dump\n");
    out_err("  --max-tokens N      覆盖输出上限（默认 256000；不发会被网关兜底成更小的值）\n");
    out_err("  --temperature N     发送 temperature 0..N（默认不发送）\n");
    out_err("  --agent-home DIR    会话/索引存放根目录，默认 ~/.uya-agent\n");
    out_err("  --no-save           不写会话日志（只跑不记）\n");
    out_err("  --continue          接着当前目录下最近一条会话继续\n");
    out_err("  --resume ID         恢复指定会话（id 或 last）\n");
    out_err("  --list-sessions     列出本机会话后退出\n");
    out_err("  --dsh-home DIR      DSH 用户目录（默认 $DSH_HOME 或 ~/.dsh）\n");
    out_err("  --no-dsh-config     完全不读 DSH 设置\n");
    out_err("  --no-dsh-writeback  /model、/effort 切完不写回 settings.yaml\n");
    out_err("                      （UYA_AGENT_DSH_WRITEBACK=0 同口径）\n");
    out_err("  --strict-dsh-config 读不到 DSH 设置就报错退出\n");
    out_err("  --print-config      打印生效配置与来源后退出\n");
    out_err("  --list-dsh-sessions 列出 DSH 自己的会话（读 ~/.dsh/sessions）\n");
    out_err("  --resume-dsh ID     把 DSH 会话导入并继续（id 可用前缀）\n");
    out_err("  --plan              以 plan 模式启动（先出计划再执行）\n");
    out_err("  --no-compact        关闭自动上下文压缩\n");
    out_err("  --context-window N  压缩判定的上下文窗口（正整数）\n");
    out_err("                      也可用 UYA_AGENT_CONTEXT_WINDOW\n");
    out_err("                      或 settings.yaml 的 uya-agent 那一节\n");
    out_err("                      （contextWindows: 模型: 窗口）；默认取 DSH 模型条目\n");
    out_err("  --permission MODE   访问模式：read-only | workspace-write | danger-full-access（默认 danger-full-access）\n");
    out_err("                      只读=写工具被拒+bash 逐条批准；工作区写=bash 关在沙箱里只写工作区；全权=不限制\n");
    out_err("  --no-sandbox        关掉 bash 的内核沙箱（bwrap），confined 模式下不再 fail closed\n");
    out_err("  --no-worktree       关掉独立工作区执行（默认就是开：会话开始建 git worktree，\n");
    out_err("                      干完用 worktree 工具 finish 合并并删掉；\n");
    out_err("                      非 git 目录自动 fail soft）\n");
    out_err("  --model NAME / --provider P / --effort V  模型与推理强度（默认取 DSH 设置；/model、/effort 运行中也能切）\n");
    out_err("                     同名模型跨提供方时用 `--model P/NAME`（或 `--provider P`）指定是哪一家\n");
    out_err("  --input-image       这个模型收图（/image、ctrl+v、/paste 挂图）；默认就是开\n");
    out_err("                      带上它可把设置里声明的「不收图」压回去\n");
    out_err("                      （UYA_AGENT_INPUT_IMAGE=1 同口径）\n");
    out_err("  --no-input-image    这个模型不收图（网关不认图时用它，免得每挂一张吃一个 400）\n");
    out_err("                     （UYA_AGENT_INPUT_IMAGE=0 同口径）\n");
    out_err("  --bwrap PATH        指定 bwrap 可执行文件（默认探测 /usr/bin/bwrap、/bin/bwrap）\n");
    out_err("  --proxy URL         出站请求走代理（host:port，或带 user:pass@ 的形式）；\n");
