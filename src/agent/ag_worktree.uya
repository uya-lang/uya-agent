    out_err("  --no-proxy          不走代理（压过 UYA_AGENT_PROXY）\n");
    out_err("  --dsh-profile NAME  设置页读写哪个 profile 的配置（默认 web）\n");
    out_err("  --dsh-root DIR      packaged preset 根（读 persona/plan 文案）\n");
    out_err("  --dsh-assets DIR    DSH 资源目录（优先于 --dsh-root；给不存在的目录直接报错）\n");
