    out_err("  --tls-pin HEX       pin 模式下要求的 leaf 证书 SHA-256（小写 hex）\n");
    out_err("  --tls-tofu-learn    tofu 档遇到没记过的新证书时，先做发证机构校验（链到系统根），\n");
