    out_err("  --dsh-assets-repo URL  取件源（默认 npm registry）\n");
    out_err("  --skill-dir DIR     额外的技能根（冒号分隔，可多次）\n");
    out_err("  --mcp-server SPEC   加一个 MCP 插件 server（可多次）\n");
    out_err("                      SPEC = name=command [args…]\n");
    out_err("  --no-mcp            不读不连任何 MCP 插件（UYA_AGENT_MCP=0 同口径）\n");
    out_err("  --list-plugins      打印 MCP 插件与工具的诊断后退出\n");
    out_err("  --uya-bin PATH      跑 workflow 脚本的 uya（默认 $UYA_BIN 或 uya）\n");
