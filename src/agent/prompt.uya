// src/agent/prompt.uya — system prompt 分节装配 + 运行时上下文（P8）
//
// 本文件：分节装配（`prompt_build_system`）、运行时上下文（`prompt_runtime_context`）、
//   preset 读取（`prompt_load_preset` / `prompt_load_embedded_preset` /
//   `prompt_texts_init`）、
//   旋钮默认（`preset_knobs_default`）、变量替换（`prompt_subst_vars`、只认 `{{model}}` /
//   `{{cwd}}`）、各节常量（`SEC_*`）、Uya 语言速查表（`UYA_LANG_NOTES` + 工具入口
//   `uya_notes_tool`，P63）。
// 不变量：① 分节按 **order 升序**、渲染后为空的节**丢弃**、用 `"\n\n"` 连接、最终**只有一条**
//   system 消息；② 变量替换只替换**完整变量组**，替换结果**不再二次扫描**（防内容里的 `{{` 被展开）；
//   ③ persona 非空由 `prompt_texts_init` 保证（磁盘 → 内嵌 → `DEFAULT_PERSONA` 三级）；
//   ④ 运行时上下文是**独立的 user 消息**，开头那句 `supersedes earlier runtime-context snapshots`
//   是有功能的（模型须按最后一份快照解析路径，历史里可能堆着多份）；
//   ⑤ `session workspace:` 机读句报的是**归类键**（linked worktree 折回主工作区，见 P71），
//   与上一句人读的 `Current workspace:` **故意不同** —— 前者答「归哪一桶」，后者答「在哪」；
//   ⑥ preset 的两条来源**共用同一个抽取器**（`prompt_apply_all`）：磁盘与内嵌各写一套的话，
//   同一份 YAML 在两条路上会解出不同的旋钮（`source` 也就失去意义）。
// 依赖：libc（syscall / unistd）；本仓 foundation/bufx、foundation/yamlcfg（读 preset 的 YAML）、
//   agent/instr（AGENTS.md 的预算）、agent/skill（技能目录段）、pm/pm_repo（归类键）。
// 命名：`prompt_*`（装配与加载）、`pt_*`（内部小工具）、`PresetKnobs`/`PromptTexts`、
//   `PRESET_SRC_*`（来源码）、`SEC_*`（各引导节）、`DEFAULT_PERSONA`、`EMBEDDED_PRESET`。
//
// 对齐 DSH `renderPrompt`：
//   * 分节按 order 升序；渲染后为空的节**丢弃**；用 "\n\n" 连接；最终只有一条 system 消息；
//   * 变量替换 {{model}} / {{cwd}}（只替换完整变量组，替换结果不再二次扫描）；
//   * persona 文案优先从 DSH preset（agent.cordis.yml 的 persona 行）读，读不到就用
//     DSH 标准 preset 的内置默认值（逐字一致）；
//   * plan 策略段只在 plan 模式激活时输出（文案同样优先取 preset 的 plan-mode.section）。
//
// **preset 三级来源**（P73，`--print-config` 的 `knobs (source: …)` 报的就是它）：
//   ① 磁盘（`--dsh-root` / `$UYA_AGENT_DSH_ROOT` / 常见 npm 全局路径）—— **优先级最高**，
//      装了 DSH 就听它的，用户的权不被夺；
//   ② 内嵌（`EMBEDDED_PRESET`，编译期 `@embed` 进来的同一份上游 preset）—— 补「这台机器
//      没装 DSH」这一种情形。为什么必须有它：plan 策略段只在磁盘上，没有内嵌兜底时
//      「换个机器」会让 plan 段**整段消失**，而写闸门（`plan_blocks_write`）照样硬拒
//      write/edit —— 模型被挡住写、又没被告知该调 `exit_plan_mode`。见 §16 踩坑 124；
//   ③ 都失败 ⇒ `DEFAULT_PERSONA`（纵深防御，正常编译下到不了）。
//
// 为什么内嵌的是**整份** preset 而不是只内嵌 plan 段的字符串常量：旋钮（`maxBytes` /
// pruner 的 8192/4096/1024 / `timeoutMs` …）与 persona 都在同一个文件里，只抄 plan 段等于
// 把上游的其余部分**冻在代码里** —— 上游改了它们，磁盘那条路会跟上、内嵌那条路不会，
// 两条路的结果就分叉了。整份内嵌让「内嵌 = 上游的一个快照」，只有一处需要跟着上游更新。
//
// 运行时上下文不是 system 的一部分，而是**独立的 user 消息**（DSH 的 joinContextSections）：
//   "Current runtime context. This snapshot supersedes earlier runtime-context snapshots.\n\n" + 各节

use libc.syscall;
use libc.unistd;

export const PROMPT_LINE_MAX: usize = 16384;

// ---- DSH 标准 preset 的内置默认（逐字）----
const DEFAULT_PERSONA: &const byte = "You are a coding agent powered by the {{model}} model. Your working directory is {{cwd}}.";

// DSH 标准 preset 的**编译期快照**（P73）：上游 `0.1.1-rc.2`(MIT) 的
// `config/agent-presets/standard/agent.cordis.yml` 逐字节副本（13103 B，
// sha256 fa14feb98daef20b810fef30bb7239a89a786de3c45c602b37743f7100d9a5af）。
// 路径相对**本文件所在目录**解析（`@embed` 的规则）⇒ 与构建时的 cwd 无关。
// 改了这份资产**必须重编**（它是编译期输入，不是运行时可换的配置文件）：
// `rm -rf build && make build`。它的角色是「磁盘上没有 preset 时的兜底」，
// 不是替代 —— 磁盘上装了 DSH 一律以磁盘为准（见文件头的三级来源）。
const EMBEDDED_PRESET: &[const byte] = @embed("assets/agent.cordis.yml");

// preset 的来源码（`--print-config` 的 `knobs (source: …)` 直接报它）。
// 为什么单独一个字段而不是复用 `loaded`：`loaded` 的语义是「读到过 preset 吗」
// （`agent_apply_knobs` 按它决定要不要落旋钮），而来源要区分**从哪读的** ——
// 「本机没装 DSH、用的是内嵌快照」与「读了磁盘上那份」必须能分开报，
// 否则「内嵌到底生效了没有」这个问题在机器上无法回答。
export const PRESET_SRC_DEFAULT: i32 = 0;    // 三级都没成 ⇒ 用内置缺省
export const PRESET_SRC_DISK: i32 = 1;       // 磁盘上的 agent.cordis.yml
export const PRESET_SRC_EMBEDDED: i32 = 2;   // 编译期内嵌快照

// ---- 各工具引导段（order 100–106）。read/bash 两条与 DSH 原文一致；其余为等价精简表述 ----
//
// order 99：**并发探索**。这条是实测补上的（2026-10-22 的 webcore 对比）：
// 同一道题、同一模型，本仓 53 步而 dsh 21 步，差距不在能力也不在 token ——
// 在「一步发几个工具调用」。本仓前 10 步平均每步 2.0 个调用，dsh 每步 3.4 个
// （前 5 步就把 14 个文件一次读完）。
//
// 为什么以前没有这条：本仓**一直支持**一步多个调用（`while ci < o.ncalls` 逐个
// 派发、结果一起回灌），但提示词里从没说过。模型不会用一个没被告知的能力 ——
// 它只会保守地一次读一个，于是「读完 14 个文件」从 4 步变成 10 步，而每一步
// 都是一个完整的上游往返。这是纯提示词层面的浪费，不是执行层缺陷。
//
// 措辞刻意只说「可以并行、什么时候值得并行」，不加「必须」：有些调用天然有依赖
// （先读到内容才知道下一步读什么），硬性要求反而会制造无效调用。
// 行宽豁免：整段是一句英文提示词，断行会改变模型读到的语气与语义。
const SEC_PARALLEL: &const byte = "Independent tool calls can go in ONE step: they are dispatched together and all their results come back at once. When you already know several files you need, or several commands that do not depend on each other's output, send them in a single step instead of one per step — every step is a full model round trip. Reading a handful of files concurrently at the start of a task is usually the fastest way to build a picture; calls that depend on an earlier result still have to wait for it. For multi-region changes, prefer one whole-file write over many small edits; independent whole-file writes to different files can go in one step; edits to the same file must be sequential.";
// order 98：先设计再动手。2026-10-23 的 ds.conf 对照跑：dsh 干净跑 41 轮，
// 3 次 write、0 次 edit；本仓 89 轮、18 次 edit、61 次 bash。dsh 的 transcript
// 是一份完整设计（约 281 KB），先想清 10 条需求再整文件写；本仓边读边改边测。
// 行宽豁免：整段是一句英文提示词，断行会改变语气。
const SEC_DESIGN: &const byte = "Before touching files, design the complete solution: enumerate every requirement, the existing module APIs, edge cases, and likely hidden tests; decide the file-level layout and implementation order. Then implement in a few complete, coherent passes. Do not implement one requirement at a time or start an edit-test loop before the whole design is clear.";
const SEC_READ: &const byte = "Use the read tool — not shell commands like cat — to inspect text files. Results include line numbers. Use offset and limit to continue reading large files.";
// 2026-10-23：webcore 轨迹里 41 次 read 覆盖 14 个文件，很多是编辑后的回读。
// edit 成功会刷新观察记录；把「不必回读」写进引导，避免把写-读-写拖成两步。
// 行宽豁免：工具引导是单条不可断的英文提示词，断行会改变语气。
const SEC_WRITE: &const byte = "Use write to create a file or replace its whole contents. Overwriting an existing file requires reading it first at the same version. After a successful write you do not need to read it back. When a change spans several regions of the same file, rewrite the whole file with write instead of a series of edits.";
const SEC_EDIT: &const byte = "Use edit for targeted literal replacements. old_string must match exactly and uniquely unless replace_all is true. A successful edit refreshes the file observation: do not read the file again just to make the next edit. Re-read only when you need surrounding context or the file changed outside the edit tool. If you need more than two or three edits in one file, stop and rewrite the whole file with write instead.";
const SEC_GLOB: &const byte = "Use glob to find files by path pattern; without a slash the pattern matches the basename at any depth.";
const SEC_GREP: &const byte = "Use grep to search file contents with a ripgrep regular expression; results are grouped by file as `Line N: …`.";
const SEC_BASH: &const byte = "Check the [exit code: N] marker on every bash result; investigate failures before moving on.";
// P104：后台任务/子代理的完成通知（见 agent/ag_bg_notes.uya）—— 模型不必自己盯，
// 所以这句话里明确禁掉「轮询 + bash 等待循环」这两种实测出来的固定浪费。
// 行宽豁免：整段是一句英文提示词，断行会改变模型读到的语气与语义。
const SEC_JOBS: &const byte = "Use bash with run_in_background for long-running commands, then job_list / job_output / job_kill to control them. A background job or subagent that finishes while you are doing something else is reported to you automatically at the next step — so do not poll job_output(wait=true) in a loop, and do not write bash sleep/pgrep wait loops; go do other useful work instead.";
// order 107：收工纪律。这几条针对实测出来的固定浪费（整份读到的文件被重读、验收跑绿后
// 自造额外验证脚本），措辞刻意限定在「文件已读全」「有可运行的验收命令」这两种可判定情形，
// 探索类任务不受约束。见 §19 的 P44 条。
//
// P55 追加三条（前两条同样是可判定情形，第三条是执行期纪律）：
//   * 验收命令通过之后不得再跑它、也不得另造一条验收 —— 除非那之后又改过文件；
//     「再跑一次保险」实测是固定浪费（同一条 make build 在一回合里跑了三遍）。
//   * 与本任务无关的**既有失败**：记一行、继续走；别追查，也别另拉一份基线去证明它是既有的
//     （实测：一条本来就红的 selftest 吃掉了 6 步）。
//   * 方案一次定下并外化：定了就写进 todo 清单，之后照着清单执行；不要在推理里一步一遍地
//     重列同一批文件 / 路径 / 目录映射（实测：50 个文件的映射在推理里被重列了 8 步）。
// 行宽豁免：整段是收工纪律提示词，断行会改变语气。
const SEC_FINISH: &const byte = "Read each file once: when a read result contains `(End of file - total N lines)` you already hold the whole file — do not read it again. When the project's acceptance command (test suite, build, or type check) passes, you are done: at most one more confirmation run, and do not write verification scripts of your own unless the user asked for them. Once that acceptance command has passed, do not run it again — and do not invent a second acceptance command — unless you changed files after that run. A failure that was already there before your change is not yours to fix here: note it in one line and move on; do not chase it, and do not build a baseline copy or a reference run to prove it was pre-existing. Settle the plan once and externalize it: as soon as the approach is fixed, write it into a todo list (or one compact list in the answer) and execute against that list — do not re-enumerate the same files, paths or directory mapping in your reasoning step after step. If you are keeping a todo list, close it out too: before you report done, every step you actually finished must be `completed` and nothing may be left `in_progress` — a stale list is part of the deliverable, not bookkeeping. If the task has no explicit acceptance command, stop after the implementation compiles and one smoke test passes; do not write more ad-hoc test scripts.";

// preset 里的工具/上下文旋钮（缺省值 = DSH 标准 preset 的默认值）
export struct PresetKnobs {
    read_limit: i64,
    read_max_bytes: i64,
    read_max_line: i64,
    prune_threshold: i64,
    prune_head: i64,
    prune_tail: i64,
    bash_prune_threshold: i64,   // 0 = 沿用 prune_threshold（bash 结果专用）
    bash_prune_permille: i64,    // 0 = 沿用 1000‰（bash 剪枝预算缩放）
    glob_max: i64,
    grep_max: i64,
    grep_line: i64,
    bash_timeout_ms: i64,
    instr_max_bytes: i64,
    compact_threshold_permille: i64,
    retain_permille: i64,
    loaded: bool,
    // preset 从哪来的（`PRESET_SRC_*`）。**只在诊断出口用** —— 旋钮值与
    // `agent_apply_knobs` 都不看它（两条来源共用同一个抽取器，值本来就同源）。
    source: i32,
}

// DSH 标准 preset 的**缺省**旋钮值（逐字对齐）。读不到 preset 时全用它。
// 注意两个「0 = 沿用通用值」的约定：`bash_prune_threshold` / `bash_prune_permille`，
// 所以 0 在这里是「没单独配过」而不是「配成 0」。
export fn preset_knobs_default() PresetKnobs {
    return PresetKnobs{
        read_limit: 2000,
        read_max_bytes: 51200,
        read_max_line: 2000,
        prune_threshold: 8192,
        prune_head: 4096,
        prune_tail: 1024,
        bash_prune_threshold: 0,
        bash_prune_permille: 0,
        glob_max: 100,
        grep_max: 250,
        grep_line: 2000,
        bash_timeout_ms: 120000,
        instr_max_bytes: 65536,
        compact_threshold_permille: 800,
        retain_permille: 160,
        loaded: false,
        source: PRESET_SRC_DEFAULT,
    };
}

export struct PromptTexts {
    persona: Buf,
    plan_section: Buf,
    instr_max_bytes: i64,
    loaded_from_preset: bool,
}

// 零值 PromptTexts（两个 `buf_empty` + 默认预算 + loaded_from_preset=false）。
// 固定字段的初始化式必须是常量，所以全局只能靠它填。
export fn prompt_texts_empty() PromptTexts {
    return PromptTexts{
        persona: buf_empty(),
        plan_section: buf_empty(),
        instr_max_bytes: 65536,
        loaded_from_preset: false,
    };
}

// 只释放两个 Buf —— `instr_max_bytes` / `loaded_from_preset` 是值字段，不需要释放。
export fn prompt_texts_free(t: &PromptTexts) void {
    buf_free(&t.persona);
    buf_free(&t.plan_section);
}

// 把 src 覆盖写进 dst（调用方的缓冲，先 reset 再追加）。空 src 只 reset ——
// 「设成空」与「什么都不做」在这里是**同一件事**，这让 preset 里的空字段天然等于缺省。
fn pt_set(dst: &Buf, src: &[byte]) void {
    buf_reset(dst);
    if src.len > 0 {
        _ = buf_append(dst, src.ptr, src.len);
    }
}

// C 字符串版本（内置默认文案是 &const byte）
fn pt_set_cstr(dst: &Buf, src: &const byte) void {
    buf_reset(dst);
    const n: usize = bufx_cstr_len(src);
    if n > 0 {
        _ = buf_append(dst, src, n);
    }
}

// 判一条**候选路径**在磁盘上存在吗。
// 为什么需要这个函数（而不是直接 `sess_file_exists(cand.ptr)`）：`sess_file_exists`
// 收的是 **C 字符串**（内部 `sys_open`），而 `buf_append_cstr` **不补 NUL**（踩坑 2），
// `buf_new` 也不清零 —— 直接把 `cand.ptr` 喂进去，路径尾巴会粘上那块内存里的残留字节。
// 实测症状（P73）：**同一个二进制**，`cwd=/tmp` 读得到 preset、`cwd` 是个长路径就读不到，
// strace 里看到它去 `open("…/@deepseek-ai/dsh-6e03-496b-9881-81544214")` —— 尾巴那截正是
// cwd 的残留。所以这里**先补 NUL 再判**，判完把那一字节缩回去（调用方按 `b.len` 追加，
// 不要 NUL：`root` 后面还要接 `/config/...`）。
fn pt_path_exists(b: &Buf) bool {
    if !buf_append_byte(b, 0) {
        return false;
    }
    const ok: bool = sess_file_exists(b.ptr as &const byte);
    b.len = b.len - 1;
    return ok;
}

// DSH preset 根目录：--dsh-root > $UYA_AGENT_DSH_ROOT > 常见 npm 全局路径
fn preset_path(out: &Buf, explicit_root: &const byte, dsh_home: &[byte]) bool {
    buf_reset(out);
    var root: Buf = buf_new(1024);
    defer { buf_free(&root); }
    if bufx_cstr_len(explicit_root) > 0 {
        _ = buf_append_cstr(&root, explicit_root);
    } else {
        const env: &byte = getenv("UYA_AGENT_DSH_ROOT");
        if (env as usize) != 0 && bufx_cstr_len(env) > 0 {
            _ = buf_append_cstr(&root, env);
        }
    }
    if root.len == 0 {
        // 常见位置（本机是第一个）
        const home: &byte = getenv("HOME");
        if (home as usize) == 0 {
            return false;
        }
        var cand: Buf = buf_new(1024);
        defer { buf_free(&cand); }
        _ = buf_append_cstr(&cand, home);
        _ = buf_append_cstr(&cand, "/.npm-global/lib/node_modules/@deepseek-ai/dsh");
        if pt_path_exists(&cand) {
            _ = buf_append(&root, cand.ptr, cand.len);
        } else {
            buf_reset(&cand);
            _ = buf_append_cstr(&cand, home);
            _ = buf_append_cstr(&cand, "/.local/lib/node_modules/@deepseek-ai/dsh");
            if pt_path_exists(&cand) {
                _ = buf_append(&root, cand.ptr, cand.len);
            }
        }
        if root.len == 0 {
            _ = dsh_home;
            return false;
        }
    }
    if !buf_append(&out[0], root.ptr, root.len) {
        return false;
    }
    return buf_append_cstr(out, "/config/agent-presets/standard/agent.cordis.yml");
}

// 匹配一行插件（persona / plan / 各工具旋钮）；config 是列表时递归进去
// （tool-result-pruner 这类在 group 的 config 列表里，只扫顶层会漏掉）
fn prompt_apply_row(t: &const YTree, row: i32, out: &PromptTexts, knobs: &PresetKnobs, got_persona: &bool) void {
    const name: &[byte] = yt_get_str(t, row, "name");
    const cfg_node: i32 = yt_get(t, row, "config");
    if cfg_node >= 0 && name.len > 0 {
        if bufx_eq_cstr(name.ptr as &const byte, name.len, "@deepseek-ai/dsh-persona") {
            const txt: &[byte] = yt_get_str(t, cfg_node, "text");
            if txt.len > 0 {
                pt_set(&out.persona, txt);
                got_persona[0] = true;
            }
        } else if bufx_eq_cstr(name.ptr as &const byte, name.len, "@deepseek-ai/dsh-plan-mode") {
            pt_set(&out.plan_section, yt_get_str(t, cfg_node, "section"));
        } else if bufx_eq_cstr(name.ptr as &const byte, name.len, "@deepseek-ai/dsh-agent-instructions") {
            knobs.instr_max_bytes = knob_i64(t, cfg_node, "maxBytes", knobs.instr_max_bytes);
            out.instr_max_bytes = knobs.instr_max_bytes;
        } else if bufx_eq_cstr(name.ptr as &const byte, name.len, "@deepseek-ai/dsh-tool-fs") {
            knobs.read_limit = knob_i64(t, cfg_node, "readLimit", knobs.read_limit);
            knobs.read_max_bytes = knob_i64(t, cfg_node, "readMaxBytes", knobs.read_max_bytes);
            knobs.read_max_line = knob_i64(t, cfg_node, "readMaxLineLength", knobs.read_max_line);
        } else if bufx_eq_cstr(name.ptr as &const byte, name.len, "@deepseek-ai/dsh-tool-fs-search") {
            knobs.glob_max = knob_i64(t, cfg_node, "globMaxResults", knobs.glob_max);
            knobs.grep_max = knob_i64(t, cfg_node, "grepMaxMatches", knobs.grep_max);
            knobs.grep_line = knob_i64(t, cfg_node, "grepMaxLinePreviewBytes", knobs.grep_line);
        } else if bufx_eq_cstr(name.ptr as &const byte, name.len, "@deepseek-ai/dsh-compaction-tool-result-pruner") {
            knobs.prune_threshold = knob_i64(t, cfg_node, "thresholdChars", knobs.prune_threshold);
            knobs.prune_head = knob_i64(t, cfg_node, "headChars", knobs.prune_head);
            knobs.prune_tail = knob_i64(t, cfg_node, "tailChars", knobs.prune_tail);
            knobs.bash_prune_threshold = knob_i64(t, cfg_node, "bashThresholdChars", knobs.bash_prune_threshold);
            knobs.bash_prune_permille = knob_i64(t, cfg_node, "bashBudgetPermille", knobs.bash_prune_permille);
        } else if bufx_eq_cstr(name.ptr as &const byte, name.len, "@deepseek-ai/dsh-compaction-basic") {
            knobs.compact_threshold_permille = knob_i64(t, cfg_node, "thresholdRatioPermille", knobs.compact_threshold_permille);
            knobs.retain_permille = knob_i64(t, cfg_node, "retainRatioPermille", knobs.retain_permille);
        } else if bufx_eq_cstr(name.ptr as &const byte, name.len, "@deepseek-ai/dsh-tool-bash") {
            knobs.bash_timeout_ms = knob_i64(t, cfg_node, "timeoutMs", knobs.bash_timeout_ms);
        }
        knobs.loaded = true;
    }
    // 递归：config 是列表时，里面的每一项也可能是插件行
    if cfg_node < 0 {
        return;
    }
    if yt_kind(t, cfg_node) != YK_SEQ {
        return;
    }
    const n: usize = yt_len(t, cfg_node);
    var k: usize = 0;
    while k < n {
        const sub: i32 = yt_at(t, cfg_node, k);
        if sub >= 0 {
            prompt_apply_row(t, sub, out, knobs, got_persona);
        }
        k = k + 1;
    }
}

// 从 preset 的某一行 config 里读一个整数旋钮
fn knob_i64(t: &const YTree, node: i32, key: &const byte, cur: i64) i64 {
    if node < 0 {
        return cur;
    }
    const v: i64 = yt_get_i64(t, node, key, -1);
    if v > 0 {
        return v;
    }
    return cur;
}

// 扫一棵已解析的 preset 树：顶层是**序列**，逐行找 name 匹配的插件（`config` 是列表时
// 递归进去，因为 tool-result-pruner / compaction 这类都在 group 的 config 列表里）。
// 返回「读到过 persona 吗」—— 调用方据此决定要不要补 `DEFAULT_PERSONA`。
// **磁盘与内嵌两条来源共用这一个抽取器**（见文件头不变量⑥）：各写一套的话，同一份 YAML
// 在两条路上会解出不同的旋钮，而 `source` 也就失去意义了。
fn prompt_apply_all(t: &const YTree, out: &PromptTexts,
    knobs: &PresetKnobs) bool {
    const root: i32 = yt_root(t);
    if root < 0 {
        return false;
    }
    const rows: usize = yt_len(t, root);
    var got_persona: bool = false;
    var i: usize = 0;
    while i < rows {
        const row: i32 = yt_at(t, root, i);
        if row >= 0 {
            prompt_apply_row(t, row, out, knobs, &got_persona);
        }
        i = i + 1;
    }
    return got_persona;
}

// 读 DSH preset（`agent.cordis.yml`）并抽出 persona / plan 段文案 + 各旋钮。
// **读不到任何东西返回 false**，由调用方回落到下一级来源（内嵌 → 内置默认），
// 而不是给一个空 persona。
export fn prompt_load_preset(explicit_root: &const byte, dsh_home: &[byte], out: &PromptTexts, knobs: &PresetKnobs) bool {
    var path: Buf = buf_new(1200);
    defer { buf_free(&path); }
    if !preset_path(&path, explicit_root, dsh_home) {
        return false;
    }
    _ = buf_append_byte(&path, 0);
    if !sess_file_exists(path.ptr as &const byte) {
        return false;
    }
    var tree: YTree = YTree{ nodes: [], n: 0, lines: [], nlines: 0,
        raw: buf_empty(), cur: 0, err_line: 0 };
    yt_init(&tree);
    defer { yt_free(&tree); }
    if !yt_load_file(path.ptr as &const byte, &tree) {
        return false;
    }
    if !prompt_apply_all(&tree, out, knobs) {
        pt_set_cstr(&out.persona, DEFAULT_PERSONA);
    }
    out.loaded_from_preset = true;
    // 注意**不**在这里动 `knobs.loaded` —— 它的语义是「扫到过带 config 的插件行吗」，
    // 由 `prompt_apply_row` 置位；来源不用它表达（`--print-config` 按 `source` 报）。
    knobs.source = PRESET_SRC_DISK;
    return true;
}

// 从**编译期内嵌**的那份 preset 快照里抽同样的东西（磁盘上没有 preset 时走这条）。
// 与磁盘路径的差别只有两处：① 输入是 `EMBEDDED_PRESET` 这段只读切片（`Buf` 只是
// 借它的 ptr/len —— 所以**不能** `buf_free` 它，那是静态数据）；② 解析走
// `yt_parse_text`（已有缓冲）而不是 `yt_load_file`（开文件）。
// 为什么它能替磁盘那份：`yt_parse_text` 与 `yt_load_file` 的差别只在「文本从哪来」，
// 之后是同一套解析器 + 同一个 `prompt_apply_all`。
export fn prompt_load_embedded_preset(out: &PromptTexts,
    knobs: &PresetKnobs) bool {
    var src: Buf = Buf{
        ptr: EMBEDDED_PRESET.ptr as &byte,
        len: EMBEDDED_PRESET.len,
        cap: EMBEDDED_PRESET.len,
    };
    var tree: YTree = YTree{ nodes: [], n: 0, lines: [], nlines: 0,
        raw: buf_empty(), cur: 0, err_line: 0 };
    yt_init(&tree);
    defer { yt_free(&tree); }
    if !yt_parse_text(&src, &tree) {
        return false;
    }
    if !prompt_apply_all(&tree, out, knobs) {
        pt_set_cstr(&out.persona, DEFAULT_PERSONA);
    }
    out.loaded_from_preset = true;
    // 同磁盘那条：`knobs.loaded` 由 `prompt_apply_row` 置位，这里只记来源。
    knobs.source = PRESET_SRC_EMBEDDED;
    return true;
}

// `PromptTexts` 的**唯一**构造入口：先分配两个缓冲、再按三级来源取 preset。
//
// 三级（见文件头）：**磁盘 → 内嵌 → `DEFAULT_PERSONA`**。为什么磁盘优先：装了 DSH 的
// 机器上，用户/上游改过的 preset 必须生效（那是他们的配置，内嵌只是「没装」的兜底）。
// 为什么内嵌必须有：没有它时，换台机器会让 plan 策略段**整段消失**，而写闸门照样硬拒
// write/edit（§16 踩坑 124）。最后那道 `persona.len == 0` 是纵深防御：
// persona 为空会让 system 的第一个节直接消失。
export fn prompt_texts_init(explicit_root: &const byte, dsh_home: &[byte], out: &PromptTexts, knobs: &PresetKnobs) void {
    out.persona = buf_new(512);
    out.plan_section = buf_new(4096);
    out.instr_max_bytes = 65536;
    out.loaded_from_preset = false;
    if !prompt_load_preset(explicit_root, dsh_home, out, knobs) {
        if !prompt_load_embedded_preset(out, knobs) {
            pt_set_cstr(&out.persona, DEFAULT_PERSONA);
            knobs.source = PRESET_SRC_DEFAULT;
        }
    }
    if out.persona.len == 0 {
        pt_set_cstr(&out.persona, DEFAULT_PERSONA);
        knobs.source = PRESET_SRC_DEFAULT;
    }
}

// 变量替换：{{name}}，替换结果不再扫描
fn prompt_subst_vars(text: &[byte], model: &[byte], cwd: &[byte], out: &Buf) void {
    var i: usize = 0;
    while i < text.len {
        if i + 4 <= text.len && text.ptr[i] == 123 as byte && text.ptr[i + 1] == 123 as byte {
            // 找 "}}"
            var j: usize = i + 2;
            var found: bool = false;
            while j + 1 < text.len {
                if text.ptr[j] == 125 as byte && text.ptr[j + 1] == 125 as byte {
                    found = true;
                    break;
                }
                j = j + 1;
            }
            if found {
                const key: &[byte] = text[i + 2: j - (i + 2)];
                if key.len == 5 && bufx_mem_eq(key.ptr, "model", 5) {
                    _ = buf_append(out, model.ptr, model.len);
                    i = j + 2;
                    continue;
                }
                if key.len == 3 && bufx_mem_eq(key.ptr, "cwd", 3) {
                    _ = buf_append(out, cwd.ptr, cwd.len);
                    i = j + 2;
                    continue;
                }
            }
        }
        _ = buf_append_byte(out, text.ptr[i]);
        i = i + 1;
    }
}

// 注意：persona / plan_section 来自 YAML 解析（Buf，**没有 NUL 结尾**），
// 所以这里必须用「指针 + 长度」，不能当 C 字符串读（否则会读进堆里的垃圾，
// 真实网关会直接报 `invalid character '\x00' in string literal`）。
fn prompt_add_section_n(out: &Buf, text: &const byte, n: usize, model: &[byte], cwd: &[byte], first: &bool) void {
    if n == 0 {
        return;
    }
    var tmp: Buf = buf_new(n + 512);
    defer { buf_free(&tmp); }
    prompt_subst_vars(text[0: n], model, cwd, &tmp);
    if tmp.len == 0 {
        return;
    }
    if !first[0] {
        _ = buf_append_cstr(out, "\n\n");
    }
    _ = buf_append(out, tmp.ptr, tmp.len);
    first[0] = false;
}

// 组装 system prompt（分节 + 空节丢弃 + "\n\n" 连接）
export fn prompt_build_system(
    cfg: &const Config,
    texts: &const PromptTexts,
    plan_active: bool,
    out: &Buf
) bool {
    buf_reset(out);
    var first: bool = true;
    const model: &[byte] = cfg.model.ptr[0: cfg.model.len];
    const cwd: &[byte] = cfg.workspace.ptr[0: cfg.workspace.len];
    // order 0：persona
    prompt_add_section_n(out, texts.persona.ptr as &const byte, texts.persona.len, model, cwd, &first);
    // order 50：plan 策略（仅在 plan 模式）
    if plan_active {
        prompt_add_section_n(out, texts.plan_section.ptr as &const byte, texts.plan_section.len, model, cwd, &first);
    }
    // order 98/99：先设计再动手 + 并发探索（放在工具引导的最前面 ——
    // 它们管的是「怎么用这些工具」，位置比各工具的用法更靠前）
    if !first {
        _ = buf_append_cstr(out, "\n\n");
    }
    _ = buf_append_cstr(out, SEC_DESIGN);
    _ = buf_append_cstr(out, "\n\n");
    _ = buf_append_cstr(out, SEC_PARALLEL);
    _ = buf_append_cstr(out, "\n\n");
    // order 100–106：工具引导
    _ = buf_append_cstr(out, SEC_READ);
    _ = buf_append_cstr(out, "\n\n");
    _ = buf_append_cstr(out, SEC_WRITE);
    _ = buf_append_cstr(out, "\n\n");
    _ = buf_append_cstr(out, SEC_EDIT);
    _ = buf_append_cstr(out, "\n\n");
    _ = buf_append_cstr(out, SEC_GLOB);
    _ = buf_append_cstr(out, "\n\n");
    _ = buf_append_cstr(out, SEC_GREP);
    if cfg.allow_shell {
        _ = buf_append_cstr(out, "\n\n");
        _ = buf_append_cstr(out, SEC_BASH);
        _ = buf_append_cstr(out, "\n\n");
        _ = buf_append_cstr(out, SEC_JOBS);
    }
    // order 107：收敛纪律（与工具引导同一块，紧跟其后）
    _ = buf_append_cstr(out, "\n\n");
    _ = buf_append_cstr(out, SEC_FINISH);
    // P63：Uya 语言速查表**不再是 system 的一节**（每轮白付 ~1.2 KB 前缀），改成按需的
    // `uya_notes` 工具（见文件末尾的 uya_notes_tool）；这里一个字节都不再追加。
    return out.len > 0;
}

// 归类键：`session workspace:` 机读句该报的那个值（P71）。
// 直接转发 `pm_main_worktree_into`（pm/pm_repo.uya）—— 归一规则只许有一份实现，
// 这里只是把它的参数形状收成「按 cfg 取」。
// 返回 false = 分配失败 / 路径为空（调用方回退字面工作区）。
fn pt_ws_key_into(cfg: &const Config, out: &Buf) bool {
    return pm_main_worktree_into(cfg.workspace.ptr as &const byte,
        cfg.workspace.len, out);
}

// 运行时上下文（独立的 user 消息）
export fn prompt_runtime_context(cfg: &const Config, plan_active: bool, out: &Buf) bool {
    buf_reset(out);
    var body: Buf = buf_new(2048);
    defer { buf_free(&body); }
    var first: bool = true;
    // context:file-policy
    // P21：三级访问模式（对齐 DSH sandbox:policy 的三句），并按沙箱实际可用性收尾。
    // 沙箱只覆盖 spawn 出去的 shell 代码；进程内的 write/edit 是工具层策略。
    var san_on: bool = false;
    if cfg.sandbox != SAN_OFF {
        san_on = san_available();
    }
    if cfg.access == PERM_READ_ONLY {
        _ = buf_append_cstr(&body, "Current uya-agent file policy: read-only. The write and edit tools are refused; ");
        if san_on {
            _ = buf_append_cstr(&body, "bash runs in a read-only file sandbox (only /dev/null is writable) and every command needs the user's approval.");
        } else {
            _ = buf_append_cstr(&body, "bash needs the user's approval for every command and runs without a kernel sandbox on this host.");
        }
    } else if cfg.access == PERM_WORKSPACE_WRITE {
        _ = buf_append_cstr(&body, "Current uya-agent file policy: workspace-write. Absolute paths and \"..\" are rejected by the file tools; ");
        if san_on {
            _ = buf_append_cstr(&body, "bash is confined to the working directory plus an ephemeral /tmp by the kernel.");
        } else {
            _ = buf_append_cstr(&body, "bash runs without a kernel sandbox on this host.");
        }
    } else {
        _ = buf_append_cstr(&body, "Current uya-agent file policy: full access. The file tools are not confined and bash runs without a sandbox.");
    }
    // context:workspace（P34）
    // 工作区是「当前会话」的状态、运行中会被切（workspace 工具 / /workspace）：模型每一轮
    // 都要能一眼看到自己现在在哪 —— 这也是切换后补推新快照时要说明的那件事。
    _ = buf_append_cstr(&body, "\n\nCurrent workspace: ");
    _ = buf_append(&body, cfg.workspace.ptr, cfg.workspace.len);
    _ = buf_append_cstr(&body, " (all relative paths, the file tools, bash and /diff resolve against it; call the workspace tool to report or switch).");
    // 机读副本：网关 `~/ai-gateway` 从**最新一条** `Current runtime context.` 消息里按
    // `session workspace: "<JSON 路径>"` 取 workspace 维度（internal/responses/dimensions.go
    // 的 dshWorkspace）。与 DSH 的 sandbox 策略句同口径 —— 引号内是 JSON 字符串，网关按
    // JSON 解码而不是 trim，所以这里必须走 jw_str_into（转义反斜杠/引号），不能裸拼。
    // 人类可读的上一句保持不动：TUI 与既有自测都依赖它。
    //
    // P71：这一句报的是**归类键**，不是上一句那个字面工作区。两句话的分工要分清：
    //   * `Current workspace:`（上一句）= 这个会话真正在哪个目录（路径问题）；
    //   * `session workspace:`（这一句）= 网关该把它归到哪一桶（归属问题）。
    // 为什么必须分开：本机 `agent-presets.default: git-worktree`，顶层会话的 cwd 是
    // `<主仓>/.git/dsh-worktrees/session-<id>` —— 每个会话一条唯一路径，网关的工作区维度
    // 于是退化成「会话」维度（一桶一行）。归类键把 linked worktree 折回主工作区，
    // 「一个仓一桶」才成立。人读的那句若也跟着折，模型就会以为自己在主仓里干活（那是假话）。
    // 归类失败一律回退字面工作区：宁可按会话分桶，也不报一个错路径。
    var wskey: Buf = buf_new(cfg.workspace.len + 16);
    defer { buf_free(&wskey); }
    if !pt_ws_key_into(cfg, &wskey) {
        buf_reset(&wskey);
        _ = buf_append(&wskey, cfg.workspace.ptr as &const byte,
            cfg.workspace.len);
    }
    _ = buf_append_cstr(&body, "session workspace: ");
    _ = jw_str_into(&body, wskey.ptr as &const byte, wskey.len);
    first = false;
    // context:plan
    _ = first;
    if plan_active {
        _ = buf_append_cstr(&body, "\n\nPlan mode is active: do not change any file. The write and edit tools are refused until the user approves a plan; explore, then present the COMPLETE plan through exit_plan_mode.");
    }
    if body.len == 0 {
        _ = buf_append_cstr(out, "Current runtime context: none. Earlier runtime-context snapshots no longer apply.");
        return true;
    }
    _ = buf_append_cstr(out, "Current runtime context. This snapshot supersedes earlier runtime-context snapshots.\n\n");
    return buf_append(out, body.ptr, body.len);
}


// ============================================================
// P63：Uya 语言速查表（从 system prompt 挪出来的那一节）
// ============================================================
// 为什么挪走：这一节**每一轮请求**都随 system 前缀发出去（原文案 467 B，扩成速查表后 ~1.2 KB），
// 而它只在「模型要写 / 改 Uya 源码」那一步有用 —— 其余回合是纯粹的前缀开销，还会把
// 缓存前缀撑长。改成 `uya_notes` 工具之后：system 少一整节，速查表只在真调用那一步进对话。
//
// 内容逐条都在本仓与 `$UYA_ROOT/std` 里核对过，**不发明语法**：没有 `for`（实测全仓零
// `for` 关键字）、只有 `while`；`match` / `!T` / `try` / `catch |err|` / `as!` / `defer` /
// 定长数组 `[T: N]` 与 `[0: N]` / 结构体字面量 `Type{...}` 都是仓内真实用法。
//
// 末两条（build 命令与 write 的真换行）**逐字保留**旧文案，而且各有一条措辞钉子守着
// （`prompt-todo-plan` 轮的 verdict 156 与 158）—— 改了就会红，那是有意的。
// 行宽豁免：整张速查表是一条**不可断的单条字符串字面量**（Uya 没有相邻字面量拼接）。
export const UYA_LANG_NOTES: &const byte = "Uya language cheat sheet for files you write here.\n\n- Entry point: `export fn main() i32 { ... return 0; }`; print with the built-in `@println(\"text\")`.\n- Variables need explicit types: `const x: i32 = 1;` / `var s: &[const byte] = \"abc\";`. There is no `let`/`mut` and no `i++`.\n- String literals are byte slices: write `\"abc\" as &const byte` where a `&const byte` is expected.\n- Loops: only `while cond { ... }` — there is no `for`. Dispatch on a value with `match val { ... }`.\n- Errors: a function that can fail returns `!T` and fails with `return error.X;`; callers use `try f()`, `f() catch { 0 as i32; }`, or `catch |err| { ... }`. Narrow with `as!`.\n- Integer arithmetic is overflow-checked by the prover. Plain `+ - *` must be provably safe; otherwise use `try a + b` (propagate `error.Overflow`), `(a + b) catch { ... }`, a range guard, or the saturating `+| -| *|` / wrapping `+% -% *%` operators. Saturating/wrapping require both operands to have the same type — cast literals explicitly (`86400 as i64`).\n- Wrapping ops (`+%` `-%` `*%`) are emitted at 32 bits unless the LEFT operand is a plain identifier, field access, or call (array element, `@builtin(...)`, parenthesized or chained expressions all fall back to int32 and silently truncate i64/usize). Land the left side in a typed local and split chains: `const v10: i64 = v *% 10; v = v10 +% b;`. Never apply them to pointers: use `const at: &const byte = base + off;` then plain `at + i`.\n- Free resources with `defer { free(p); }` right after acquiring them.\n- Arrays are fixed size: `[byte: 16]`, initialized as `[0: 16]`. Structs use `Type{ field: value, ... }`.\n- Modules are directories and the namespace is merged across them: do not add local `use` lines in this repo, and keep the `SRC` file order meaningful.\n- Build and run with `UYA_ROOT=<lib> <uya> build <file> -o <out> && ./<out>`; `<uya> check <files>` only type-checks.\n- When writing file content, put real newlines in the string you pass to the write tool; do not double-escape them." as &const byte;

// `uya_notes` 工具的实现：把速查表写进工具结果。
// 只读、无参数、不碰文件系统与任何闸门（read-only / plan 模式下照常可用 —— 它不改任何东西）。
export fn uya_notes_tool(out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, UYA_LANG_NOTES);
}
