// src/agent/instr.uya — AGENTS.md / CLAUDE.md 工作区指令（P8）
//
// 本文件：发现并装载工作区指令文件 —— 候选名（`instr_try_file`）、集合管理
//   （`instr_init`/`instr_free`/`instr_push`）、预算裁剪与渲染（`instr_*`）。
// 不变量：① 整段预算 `maxBytes`（标准 preset 是 65536），超预算从**最广**的一端丢弃，
//   必要时把剩下的内容**二分截断**到刚好放得下 —— 二分是为了「不切坏 UTF-8 又不超预算」；
//   ② 只读、**失败就跳过**：目录不存在、文件读不了都不算错误（绝大多数目录本来就没有指令文件）；
//   ③ `InstrSet.items` 是固定数组，`n` 是**唯一**的有效边界，`instr_push` 失败不推进 n。
// 依赖：libc（syscall / unistd）；本仓 foundation/bufx（Buf 与 buf_*）。
// 命名：`instr_*`（集合与装载）、`InstrFile` / `InstrSet` / `INSTR_*`。
//
// 对齐 DSH `agent-instructions`：
//   * 候选文件名（按目录内顺序）：AGENTS.md → CLAUDE.md → AGENTS.local.md → CLAUDE.local.md；
//   * 用户全局：$DSH_HOME/AGENTS.md 排在最前（作用域最广）；
//   * 项目根：从 cwd 向上找到第一个含 `.git` 的目录；然后从项目根到 cwd 逐级（由广到窄）；
//   * 整段预算 maxBytes（标准 preset 是 65536）：超预算从**最广**的一端丢弃，必要时把剩下的
//     内容二分截断到刚好放得下；
//   * 渲染成一条 user 消息：`<system-reminder>\n<body>\n</system-reminder>`，
//     body = 预算标记 + intro + 每个文件的 `Instructions from: <路径>\n\n<内容>`（用 "\n\n" 连接）。
//
// 只读、失败就跳过：目录不存在、文件读不了都不算错误。

use libc.syscall;
use libc.unistd;

export const INSTR_MAX_SOURCE: i64 = 1048576;   // 单文件超过这个大小直接忽略

const INSTR_MAX_FILES: usize = 16;
const INSTR_PATH_MAX: usize = 4096;

export struct InstrFile {
    path: Buf,      // 显示路径
    body: Buf,
    absent: bool,
}

export struct InstrSet {
    items: [InstrFile: INSTR_MAX_FILES],
    n: usize,
}

// 零值 InstrFile：两个空 Buf（`buf_empty`，不是 `buf_new`）+ absent=false。
// 全局数组的初始化式在 C 里必须是常量，所以只能靠这个函数逐个填（踩坑：`buf_empty()` 不能进初始化式）。
fn instr_file_empty() InstrFile {
    return InstrFile{ path: buf_empty(), body: buf_empty(), absent: false };
}

// 复位整个指令集：逐项填零值并把 n 归 0。幂等 —— 调用方（fsctx_init 一族）每轮都会调一次。
export fn instr_init(s: &InstrSet) void {
    var i: usize = 0;
    while i < INSTR_MAX_FILES {
        s.items[i] = instr_file_empty();
        i = i + 1;
    }
    s.n = 0;
}

// 释放已经装下的每一项并归零。只释放 `[0, n)`，所以 n 之外的槽位不需要也不能释放。
export fn instr_free(s: &InstrSet) void {
    var i: usize = 0;
    while i < s.n {
        buf_free(&s.items[i].path);
        buf_free(&s.items[i].body);
        s.items[i] = instr_file_empty();
        i = i + 1;
    }
    s.n = 0;
}

// 追加一项（path + body 各拷一份进新 Buf）。超过 INSTR_MAX_FILES 或分配失败返回 false，
// 失败时**不推进 n** —— 半装进去的那一项会被后续的 instr_init 回收（有 n 保护，不会漏也不会重）。
fn instr_push(s: &InstrSet, path: &[byte], body: &[byte]) bool {
    const idx: usize = s.n;
    if idx >= INSTR_MAX_FILES {
        return false;
    }
    const it: &InstrFile = &s.items[idx];
    it.path = buf_new(path.len + 8);
    it.body = buf_new(body.len + 8);
    if !buf_valid(&it.path) || !buf_valid(&it.body) {
        return false;
    }
    _ = buf_append(&it.path, path.ptr, path.len);
    _ = buf_append(&it.body, body.ptr, body.len);
    s.n = idx + 1;
    return true;
}

// 在 dir 下找 AGENTS.md / CLAUDE.md 并把内容收进集合；找不到就**静默跳过**（这是常态：
// 绝大多数目录没有指令文件）。display_dir 只用于诊断输出，不参与路径拼接。
fn instr_try_file(s: &InstrSet, dir: &[byte], name: &const byte, display_dir: &[byte]) void {
    var path: Buf = buf_new(INSTR_PATH_MAX);
    defer { buf_free(&path); }
    if !buf_append(&path, dir.ptr, dir.len) {
        return;
    }
    if path.len > 0 && path.ptr[path.len - 1] != 47 as byte {
        _ = buf_append_byte(&path, 47);
    }
    _ = buf_append_cstr(&path, name);
    _ = buf_append_byte(&path, 0);
    var st: FsStat = FsStat{ exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0 };
    _ = fs_stat(path.ptr as &const byte, &st);
    if !st.exists || st.is_dir {
        return;
    }
    if st.size > INSTR_MAX_SOURCE {
        return;
    }
    var body: Buf = buf_new(8192);
    defer { buf_free(&body); }
    if !fs_read_file_all(path.ptr as &const byte, &body, INSTR_MAX_SOURCE as usize) {
        return;
    }
    // 显示路径：<目录显示名>/<文件名>
    var disp: Buf = buf_new(INSTR_PATH_MAX);
    defer { buf_free(&disp); }
    if display_dir.len > 0 {
        _ = buf_append(&disp, display_dir.ptr, display_dir.len);
        if disp.len > 0 && disp.ptr[disp.len - 1] != 47 as byte {
            _ = buf_append_byte(&disp, 47);
        }
    }
    _ = buf_append_cstr(&disp, name);
    _ = instr_push(s, disp.ptr[0: disp.len], body.ptr[0: body.len]);
}

// 从 workspace 向上找到第一个含 .git 的目录；找不到就用 workspace
fn instr_project_root(ws: &[byte], out: &Buf) bool {
    buf_reset(out);
    if !buf_append(out, ws.ptr, ws.len) {
        return false;
    }
    var probe: Buf = buf_new(INSTR_PATH_MAX);
    defer { buf_free(&probe); }
    while out.len > 1 {
        buf_reset(&probe);
        _ = buf_append(&probe, out.ptr, out.len);
        _ = buf_append_cstr_z(&probe, "/.git");
        var st: FsStat = FsStat{ exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0 };
        _ = fs_stat(probe.ptr as &const byte, &st);
        if st.exists {
            return true;
        }
        // 去掉最后一段
        var k: usize = out.len;
        while k > 1 && out.ptr[k - 1] != 47 as byte {
            k = k - 1;
        }
        if k <= 1 {
            break;
        }
        out.len = k - 1;
    }
    buf_reset(out);
    return buf_append(out, ws.ptr, ws.len);
}

// 收集：用户全局 → 项目根……cwd（由广到窄），每个目录按候选顺序
export fn instr_collect(ws: &[byte], dsh_home: &[byte], s: &InstrSet) void {
    // 用户全局
    if dsh_home.len > 0 {
        var ug: Buf = buf_new(INSTR_PATH_MAX);
        defer { buf_free(&ug); }
        _ = buf_append(&ug, dsh_home.ptr, dsh_home.len);
        _ = buf_append_byte(&ug, 0);
        instr_try_file(s, ug.ptr[0: ug.len - 1], "AGENTS.md", &"[user-global]"[0: 13]);
    }
    var root: Buf = buf_new(INSTR_PATH_MAX);
    defer { buf_free(&root); }
    if !instr_project_root(ws, &root) {
        return;
    }
    // 从 root 到 ws：逐级目录
    var dir: Buf = buf_new(INSTR_PATH_MAX);
    defer { buf_free(&dir); }
    var i: usize = 0;
    while i <= root.len && dir.len < root.len {
        i = 0;
        break;
    }
    // 先把 root 放进去，再逐段追加到 ws
    _ = buf_append(&dir, root.ptr, root.len);
    var step: usize = 0;
    while true {
        var disp: Buf = buf_new(INSTR_PATH_MAX);
        defer { buf_free(&disp); }
        if dir.len == root.len {
            _ = buf_append_cstr(&disp, ".");
        } else {
            _ = buf_append(&disp, &dir.ptr[root.len], dir.len - root.len);
        }
        instr_try_file(s, dir.ptr[0: dir.len], "AGENTS.md", disp.ptr[0: disp.len]);
        instr_try_file(s, dir.ptr[0: dir.len], "CLAUDE.md", disp.ptr[0: disp.len]);
        instr_try_file(s, dir.ptr[0: dir.len], "AGENTS.local.md", disp.ptr[0: disp.len]);
        instr_try_file(s, dir.ptr[0: dir.len], "CLAUDE.local.md", disp.ptr[0: disp.len]);
        if dir.len >= ws.len {
            break;
        }
        // 追加 ws 的下一段
        var next: usize = dir.len;
        if next > 0 && dir.ptr[next - 1] != 47 as byte {
            _ = buf_append_byte(&dir, 47);
        }
        while next < ws.len && ws.ptr[next] != 47 as byte {
            _ = buf_append_byte(&dir, ws.ptr[next]);
            next = next + 1;
        }
        step = step + 1;
        if step > 32 {
            break;
        }
    }
    _ = i;
}

const INSTR_INTRO: &const byte = "The following workspace instructions may be relevant to your work. Use them as guidance when applicable. More specific instructions take precedence over broader ones. They do not override system, developer, or direct user instructions.";

// 渲染成 `<system-reminder>` 消息；超出预算时从最广端丢弃，再二分截断
export fn instr_render(s: &InstrSet, max_bytes: i64, out: &Buf) bool {
    buf_reset(out);
    if s.n == 0 {
        return false;
    }
    var start: usize = 0;
    var omitted: usize = 0;
    // 先算总长（body + intro + 各文件的 section 头）
    while true {
        var total: usize = bufx_cstr_len(INSTR_INTRO) + 2;
        var i: usize = start;
        while i < s.n {
            total = total + 26 + s.items[i].path.len + 2 + s.items[i].body.len + 2;
            i = i + 1;
        }
        if total <= (max_bytes as usize) || start + 1 >= s.n {
            break;
        }
        start = start + 1;
        omitted = omitted + 1;
    }
    var body: Buf = buf_new(max_bytes as usize + 4096);
    defer { buf_free(&body); }
    if omitted > 0 {
        _ = buf_append_cstr(&body, "Workspace instruction budget ");
        _ = buf_append_u64(&body, max_bytes as u64);
        _ = buf_append_cstr(&body, " bytes: omitted ");
        _ = buf_append_u64(&body, omitted as u64);
        _ = buf_append_cstr(&body, " broader file(s).\n\n");
    }
    _ = buf_append_cstr(&body, INSTR_INTRO);
    var i2: usize = start;
    while i2 < s.n {
        _ = buf_append_cstr(&body, "\n\n");
        _ = buf_append_cstr(&body, "Instructions from: ");
        _ = buf_append(&body, s.items[i2].path.ptr, s.items[i2].path.len);
        _ = buf_append_cstr(&body, "\n\n");
        _ = buf_append(&body, s.items[i2].body.ptr, s.items[i2].body.len);
        i2 = i2 + 1;
    }
    // 还超预算就截断（按 UTF-8 码点安全切）
    if body.len > (max_bytes as usize) {
        const keep: usize = bufx_utf8_prefix_bytes(body.ptr as &const byte, body.len, max_bytes as usize);
        body.len = keep;
    }
    _ = buf_append_cstr(out, "<system-reminder>\n");
    _ = buf_append(out, body.ptr, body.len);
    return buf_append_cstr(out, "\n</system-reminder>");
}
