// src/agent/goal.uya — 会话级目标（P11，对齐 DSH 的 goal 工具）+ 同会话续跑驱动器
//
// 本文件：持久化（`goal_session_dir`/`goal_path`/`goal_load`/`goal_save`，手写 JSON）、
//   字段读写小工具
//   （`goal_set`/`goal_set_n`/`goal_set_lit`/`goal_is_space`/`goal_phase_is`）、
//   三个工具入口（`goal_tool_get`/`goal_tool_create`/`goal_tool_update`）、
//   人类命令面（`goal_cmd_run` 与它的几条回执）、**同会话 Goal Round 驱动器**
//   （`goal_round_admit`：一次调用同时回答「该不该开下一轮」并把这一轮记在账上）。
// 不变量：① `update_goal` 是 **CAS**：id 与 revision 都必须精确匹配（`goal-3` / `3` 都收），
//   过期即拒并要求重取 —— 目标**跨进程/跨回合**持久（同一个会话重新打开还是它），
//   没有这道校验两个并发分支会静默互相覆盖；
//   ② `blocked` 需要非空 `blocked_reason` 且 **round < 2 时拒绝**（DSH 规则：同一阻塞条件
//   至少连续 3 轮）；③ `phase` 只有 active / paused / complete / blocked；
//   ④ 已有**未完成**目标时 `create` 拒绝顶掉；⑤ `/goal clear` 是**删文件、不留 tombstone**
//   （清掉后 id 从 1 重新开始）；⑥ 控制词只有**独占整行**时才不区分大小写，其余非空后缀都是
//   **字面目标**（`/goal pause after verification` 创建的就是那个字面目标）；
//   ⑦ **`round` 只在一次续跑真正开始之后才 +1**（`goal_round_admit` 里落盘），被拒的预留
//   **不消耗轮号** —— 与 DSH 的 `roundsStarted` 口径一致；⑧ 续跑授权分**盘上**（`Goal.armed`）
//   与**进程本地**（`g_goal_armed`）两份，后者**不跨会话**；`get_goal` / `/goal` 报的是两者
//   同时成立的**生效值**（P116：`--resume` 之后盘上可能仍是 true，只报盘上就会写着 armed
//   而驱动器根本不看那一位）；
//   ⑨ 目标**属于会话**：落点是**会话目录**里的 `goal.json`（与 `session.jsonl` 同目录），
//   所以两条会话各有各的目标、互不可见 —— 这是「会话目标」这个名字的实体化
//   （修前落在 agent_home 根上，同一台机器的所有会话共用一份）。
// 依赖：libc（syscall / unistd）；本仓 foundation/bufx、foundation/jsonx、session/session。
// 命名：`goal_*`、`Goal`、`GOAL_*`。
//
// 续跑驱动器（P58，对齐 DSH 的 `dsh-goal-round-driver`，见 DESIGN §9.5）：
//   * 只在**活着的会话**进入 idle 时驱动（调用点是主循环那两处，见 `agent_goal_drive`）；
//   * 只驱动 `phase=active` + 已授权 + 还有余量的目标；complete / paused / blocked 一律不动，
//     `round >= maxRounds` 是**把盘上的 phase 改成 blocked**（与 DSH 的 `round-limit` 同口径）；
//   * 每一轮是往**同一个会话**追加一条 user 消息（`<goal_round>` 块）—— 不开新 agent、
//     也不 fork 历史（Ralph 那种 fresh-agent 循环在 `agent/deleg.uya`）；
//   * `armed` **不跨进程**：换会话/恢复那条路（`agent_history_begin` 里的会话级复位）把它
//     清成进程本地的未授权。于是 `--resume` 之后目标还在盘上、自动续跑却停着，要接着跑必须
//     由人明确授权（`/goal resume` 或 `update_goal action=resume`）—— 与 DSH 的激活边界同一条。
//     P116：resume 除了重新授权，还会清掉上一次的 `blocker`，并在轮次预算用尽时补一段
//     （`round + 默认预算`）—— 不补的话下一次 admit 立刻又标回 blocked，「已恢复」等于没恢复。
//     模型侧规则（恢复/中断后要 resume、blocked 门槛）在 system prompt 的
//     `SEC_GOAL`（`agent/prompt.uya`）—— `<goal_round>` 末尾那句 "Follow the
//     configured goal-tool policy"（order 108）指的就是它。
//
// 目标存在**会话目录**下的 goal.json 里（`<agent_home>/sessions/--<cwd>--/<id>/goal.json`），
// 跨进程可读；字段：objective / phase / round / maxRounds / blocker / revision / id。
// update_goal 要求**精确的 id 与 revision**（取值前必须先 get_goal），这样并发/过期写入会被挡住。
//
// 落点为什么跟着会话走（P87）：goal 是**会话级**的东西，与「这台机器上装了这个 agent」
// 无关。原来落在 agent_home 根上，于是同一个 home 下所有会话共用一份目标 ——
// 甲会话建的目标乙会话一打开就看到（还带着 armed=true，甲的目标会被乙的进程续跑），
// 乙想建自己的目标则被「A goal is already active.」顶回来；web 那种一个 home 下并存
// 8 条会话的形态里症状最重。挪进会话目录之后，「属于会话」由**文件位置**保证，
// 跨会话隔离不需要任何额外判断。
//
// phase：active（自动续跑）/ paused / complete / blocked

use libc.syscall;
use libc.unistd;

export struct Goal {
    active_state: bool,     // 是否已经创建
    id: i32,
    revision: i32,
    phase: Buf,             // active / paused / complete / blocked
    objective: Buf,
    round: i32,
    max_rounds: i32,
    blocker: Buf,
    armed: bool,            // 盘上的续跑意愿（与进程本地的 g_goal_armed 是两件事）
}

// P58：**进程本地**的续跑授权。`Goal.armed` 是盘上那份（跨进程持久、`get_goal` 报它），
// 这一位才是驱动器认的开关 —— 为什么不合并成一个字段：goal.json 跨进程持久，而「继续自动
// 跑」是**这一次会话的授权**；合并的话 `--resume` 会把上一条会话的授权一起继承过来
// （人不在键盘前，agent 自己接着跑）。DSH 正是用一个进程本地的 activation 位分开这两件事。
// 版本串与命名纪律（CODING.md §3：常量大写前缀）不适用于它 —— 它是可变状态量，
// 与 `g_todos` / `g_deleg` 同一族；`export` 是因为 `agent/agent.uya` 要读写它。
export var g_goal_armed: bool = false;

// 翻这一位的地方就是「谁授权了自动续跑」的完整名单，共五处，都在本文件里（本仓顶层函数
// 预算为 0，见 CODING.md §6，所以不再包一层 `goal_arm()`）：
//   * `goal_tool_create` / `goal_cmd_create`：create 就是授权（DSH 的 create 也 armed）；
//   * `goal_tool_update` / `goal_cmd_switch`：resume → true，pause/complete/blocked → false；
//   * `goal_cmd_clear`：目标没了，授权一起收掉；
//   * `goal_disarm`：**人叫停续跑**（esc / ctrl+c）时收掉，盘上 armed 一起翻；
//   * `goal_round_admit`：轮次用尽或写盘失败 → false。
// 换会话的复位在 `agent_session_scoped_reset`（`agent/agent.uya`，直接写这一位）。

// P116：默认轮次预算 —— 对齐 DSH `dsh-goal` 的 `defaultMaxGoalRounds`（256）。
//
// 原来给 20，实测太少：一条 25 项的迁移任务跑到 16/20 时，模型看到「只剩 4 轮」就自己
// `update_goal action=blocked` 收工（真机 session-28118a0a，blocker 原文就是「剩余轮次
// 不够」）。轮次预算只该兜住「无限空转」，不该在任务做完之前逼模型选停。
export const GOAL_DEFAULT_MAX_ROUNDS: i32 = 256;
// 工具面 `max_goal_rounds` 的显式上限。比默认大一截，给「一次多给点」留余地；
// 再大就不是预算，只是面板上一个没人看的数字。
const GOAL_MAX_ROUNDS_CAP: i32 = 1000;

// 零值 Goal：无 goal（id 0）、phase/objective/blocker 是 `buf_empty`、
// `max_rounds` 给默认预算（不是 0 —— 0 会被下游当成「不许跑」）、armed=false。
export fn goal_empty() Goal {
    return Goal{
        active_state: false,
        id: 0,
        revision: 0,
        phase: buf_empty(),
        objective: buf_empty(),
        round: 0,
        max_rounds: GOAL_DEFAULT_MAX_ROUNDS,
        blocker: buf_empty(),
        armed: false,
    };
}

// 释放三个 Buf 字段（phase / objective / blocker）。其余是值字段，不动。
export fn goal_free(g: &Goal) void {
    buf_free(&g.phase);
    buf_free(&g.objective);
    buf_free(&g.blocker);
}

// 会话日志的尾名（`sess_session_path` 拼的就是它）。目标文件与它**同目录** ⇒ 属于会话。
const GOAL_SESS_TAIL: &const byte = "/session.jsonl" as &const byte;

// 会话目录在 home 底下的那段前缀（判据③：只比 home 前缀的话，`/tmp/ab` 与 `/tmp/abc`
// 这种兄弟目录会被误判成会话目录）。
const GOAL_SESS_ROOT: &const byte = "/sessions/" as &const byte;

// 会话目录（会话日志路径去掉尾名那一段）写进 dir。命中返回 true；否则 dir 一个字节不动。
//
// 三条同时成立才算命中（缺一条就由 `goal_path` 退回 agent home 根）：
//   ① `g_sess.path` 的尾名整段就是 `/session.jsonl`（只认整段，不做「路径里出现过」），
//      且 `g_sess.id` 非空 —— 会话身份齐了；
//   ② 它在**本次 cfg 的 agent home** 底下（`<home>/sessions/`）—— `g_sess` 是进程级的，
//      而夹具会换 `cfg.agent_home` 去测别的 home（那时 `g_sess` 里那条会话属于**另一个**
//      home，按它落盘会写到夹具没准备的地方）；
//   ③ home 只是整条路径的前缀还不够，紧跟的必须是 `/sessions/` —— 否则 `/tmp/ab` 这种
//      前缀相同的兄弟目录会被误判成会话目录。
fn goal_session_dir(cfg: &const Config, dir: &Buf) bool {
    const n: usize = g_sess.path.len;
    const tn: usize = bufx_cstr_len(GOAL_SESS_TAIL);
    if g_sess.id.len == 0 || n <= tn {
        return false;
    }
    const p: &const byte = g_sess.path.ptr as &const byte;
    if !bufx_mem_eq(&p[n - tn] as &const byte, GOAL_SESS_TAIL, tn) {
        return false;
    }
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) || home.len == 0 {
        return false;
    }
    const sn: usize = bufx_cstr_len(GOAL_SESS_ROOT);
    if n < home.len + sn {
        return false;
    }
    if !bufx_mem_eq(p, home.ptr as &const byte, home.len) {
        return false;
    }
    if !bufx_mem_eq(&p[home.len] as &const byte, GOAL_SESS_ROOT, sn) {
        return false;
    }
    buf_reset(dir);
    return buf_append_span(dir, p, 0, n - tn);
}

// 算出目标文件的路径写进 out（调用方的）。**属于会话**（P87）：会话目录里那份优先，
// 于是两条会话各有各的目标、互不可见。
// 拿不到会话（还没开会话，例如 `--print-config` 那条路径；或 `g_sess` 属于别的 home）
// 就退回 `<agent_home>/goal.json` —— 与「落点跟着会话走」之前的行为一致。
fn goal_path(cfg: &const Config, out: &Buf) bool {
    var dir: Buf = buf_new(1200);
    defer { buf_free(&dir); }
    if goal_session_dir(cfg, &dir) {
        buf_reset(out);
        if !buf_append(out, dir.ptr, dir.len) {
            return false;
        }
        return buf_append_cstr(out, "/goal.json");
    }
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        return false;
    }
    buf_reset(out);
    _ = buf_append(&out[0], home.ptr, home.len);
    return buf_append_cstr(out, "/goal.json");
}

// 落盘前把目标文件**所在的目录**补出来（逐级 mkdir，已存在不算错）。
// 为什么要补：`--no-save` 的会话不建目录（`sess_open` 在建目录之前就返回了），而目标
// 照样要落盘 —— 不补的话 sys_open 会因为目录不存在而失败，目标静默存不下。
// 目录不存在（找不到分隔符 / 只在根）就直接返回 false，让写盘那一步去报错。
fn goal_dir_ensure(p: &const byte, n: usize) bool {
    var i: usize = n;
    while i > 0 {
        if p[i - 1] == 47 as byte {
            break;
        }
        i = i - 1;
    }
    if i <= 1 {
        return false;
    }
    var dir: Buf = buf_new(i + 1);
    defer { buf_free(&dir); }
    if !buf_append_span(&dir, p, 0, i - 1) {
        return false;
    }
    return buf_append_byte(&dir, 0) && sess_mkdir_p(dir.ptr as &const byte);
}

// 用切片给 dst 赋值（先 reset）。空 src 只 reset ——「设成空」与「不设」同义，
// 于是读取时缺字段天然等于空。
fn goal_set(dst: &Buf, src: &[byte]) void {
    buf_reset(dst);
    if src.len > 0 {
        _ = buf_append(dst, src.ptr, src.len);
    }
}

// 「指针 + 长度」版本（JsonStrView 与字符串字面量都走这里；
// 写 `ptr as &const byte[0: n]` 会被解析成别的意思，别用）
fn goal_set_n(dst: &Buf, p: &const byte, n: usize) void {
    buf_reset(dst);
    if n > 0 {
        _ = buf_append(dst, p, n);
    }
}

// `goal_set_n` 的字面量外壳（`&const byte` + 显式长度）。
// 存在的意义是让「取 JSON 出来的视图」与「代码里的字面量」走同一条赋值口径。
fn goal_set_lit(dst: &Buf, lit: &const byte, n: usize) void {
    goal_set_n(dst, lit, n);
}

// 从 JSON 字符串视图赋值：**先反转义**。
//
// 为什么必须反转义（这是一处修过的真缺陷）：`goal_save` 用 `jw_str_into` 写盘，
// 它把 `"` `\` 与全部控制字节转义（`\n` / `\u00XX` …）。而 `js_obj_get_str` 给的是
// **零拷贝原始视图** —— 转义序列没有被解码。于是不带这一步读回时，用户看到的是
// **字面量** `\n`（两个字符）而不是换行：`/goal A\B` 存盘再读回会变成 `A\\B`，
// 每存读一次就多一层反斜杠。写与读必须是同一套转义口径（与 `jsonx.uya` 的
// 「改一边就得改另一边」同一条纪律，见那里 `jw_str_into` 的注释）。
// 反转义失败（非法序列）就退回原始视图：宁可显示得难看，也不静默丢内容。
fn goal_set_unescaped(dst: &Buf, sv: &const JsonStrView) void {
    var tmp: Buf = buf_empty();
    defer { buf_free(&tmp); }
    if sv_unescape_to_buf(sv, &tmp) && buf_valid(&tmp) {
        buf_reset(dst);
        _ = buf_append(dst, tmp.ptr, tmp.len);
        return;
    }
    goal_set_n(dst, sv.ptr as &const byte, sv.len);
}

// 从 `<agent_home>/goal.json` 读回目标。读文件上限 65536，用 64 KiB arena 解析。
// **文件不存在返回 false 并把 g 置零**（不是报错 —— 没有目标是最常见的状态）；
// 解析失败也返回 false，同样不半更新。
export fn goal_load(cfg: &const Config, g: &Goal) bool {
    var p: Buf = buf_new(1200);
    defer { buf_free(&p); }
    if !goal_path(cfg, &p) {
        return false;
    }
    // 交给系统调用前必须补 NUL（否则读到的是缓冲区后面的垃圾）
    if !buf_append_byte(&p, 0) {
        return false;
    }
    var text: Buf = buf_new(8192);
    defer { buf_free(&text); }
    if !fs_read_file_all(p.ptr as &const byte, &text, 65536) || text.len == 0 {
        return false;
    }
    var arena_raw: &void = malloc(65536);
    defer { free(arena_raw); }
    if ((arena_raw as &byte) as usize) == 0 {
        return false;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, 65536);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, text.ptr, text.len, &root) {
        return false;
    }
    var iv: JsonValue = JsonValue.json_null();
    var n: i64 = 0;
    g.active_state = true;
    if js_obj_get(&root, "id", 2, &iv) && js_i64_of(&iv, &n) {
        g.id = n as i32;
    }
    if js_obj_get(&root, "revision", 8, &iv) && js_i64_of(&iv, &n) {
        g.revision = n as i32;
    }
    if js_obj_get(&root, "round", 5, &iv) && js_i64_of(&iv, &n) {
        g.round = n as i32;
    }
    if js_obj_get(&root, "maxRounds", 9, &iv) && js_i64_of(&iv, &n) {
        g.max_rounds = n as i32;
    }
    var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if js_obj_get_str(&root, "phase", 5, &sv) {
        goal_set_unescaped(&g.phase, &sv);
    }
    if js_obj_get_str(&root, "objective", 9, &sv) {
        goal_set_unescaped(&g.objective, &sv);
    }
    if js_obj_get_str(&root, "blocker", 7, &sv) {
        goal_set_unescaped(&g.blocker, &sv);
    }
    var bv: JsonValue = JsonValue.json_null();
    if js_obj_get(&root, "armed", 5, &bv) {
        g.armed = json_bool_of(&bv);
    }
    return true;
}

// 把手写 JSON 落盘（`O_WRONLY|O_CREAT|O_TRUNC`，权限 420）。
// 字段顺序固定：id / revision / phase / objective / round / maxRounds / blocker / armed。
// 写失败返回 false；调用方（goal_tool_* 与 goal_cmd_run）据此回一句错误。
// P87：落点可能在会话目录里，而那个目录不一定已经建出来（`--no-save` 的会话不建目录），
// 所以写之前先补一次 mkdir —— 补不出来不算错，交给下面的 sys_open 去报。
export fn goal_save(cfg: &const Config, g: &const Goal) bool {
    var p: Buf = buf_new(1200);
    defer { buf_free(&p); }
    if !goal_path(cfg, &p) {
        return false;
    }
    _ = goal_dir_ensure(p.ptr as &const byte, p.len);
    if !buf_append_byte(&p, 0) {
        return false;
    }
    var j: Buf = buf_new(4096);
    defer { buf_free(&j); }
    _ = buf_append_cstr(&j, "{\"id\":");
    _ = buf_append_i64(&j, g.id as i64);
    _ = buf_append_cstr(&j, ",\"revision\":");
    _ = buf_append_i64(&j, g.revision as i64);
    _ = buf_append_cstr(&j, ",\"phase\":");
    _ = jw_str_into(&j, g.phase.ptr as &const byte, g.phase.len);
    _ = buf_append_cstr(&j, ",\"objective\":");
    _ = jw_str_into(&j, g.objective.ptr as &const byte, g.objective.len);
    _ = buf_append_cstr(&j, ",\"round\":");
    _ = buf_append_i64(&j, g.round as i64);
    _ = buf_append_cstr(&j, ",\"maxRounds\":");
    _ = buf_append_i64(&j, g.max_rounds as i64);
    _ = buf_append_cstr(&j, ",\"blocker\":");
    _ = jw_str_into(&j, g.blocker.ptr as &const byte, g.blocker.len);
    _ = buf_append_cstr(&j, ",\"armed\":");
    if g.armed {
        _ = buf_append_cstr(&j, "true");
    } else {
        _ = buf_append_cstr(&j, "false");
    }
    _ = buf_append_cstr(&j, "}\n");
    const flags: i32 = (O_WRONLY | O_CREAT | O_TRUNC) as i32;
    const fd: i32 = sys_open(p.ptr as *const byte, flags, 420) catch {
        return false;
    };
    var ok: bool = true;
    if j.len > 0 {
        ok = write_all_fd(fd, j.ptr as &const byte, j.len);
    }
    _ = sys_close(fd) catch {};
    return ok;
}

// 把目标状态渲染成一段文本（get_goal 的输出）
// 注意：**不要**在这里 buf_reset —— 调用方会先写 "created …"/"updated …" 再追加渲染结果
//（之前 reset 过，前缀行被整段吃掉）
fn goal_render(g: &const Goal, out: &Buf) void {
    _ = buf_append_cstr(out, "goal_id = goal-");
    _ = buf_append_u64(out, g.id as u64);
    _ = buf_append_cstr(out, "\nrevision = ");
    _ = buf_append_u64(out, g.revision as u64);
    _ = buf_append_cstr(out, "\nphase = ");
    _ = buf_append(out, g.phase.ptr, g.phase.len);
    _ = buf_append_cstr(out, "\nround = ");
    _ = buf_append_u64(out, g.round as u64);
    _ = buf_append_cstr(out, " / ");
    _ = buf_append_u64(out, g.max_rounds as u64);
    // P116：报**生效值**（盘上意愿 && 进程本地授权），不是盘上那个字段 ——
    // `--resume` 之后盘上可能还留着 true，只报它的话模型/人都会以为续跑开着，
    // 而驱动器根本不看盘上这一位（g_goal_armed 已被会话复位清掉）。
    _ = buf_append_cstr(out, "\narmed = ");
    if g.armed && g_goal_armed {
        _ = buf_append_cstr(out, "true");
    } else {
        _ = buf_append_cstr(out, "false");
    }
    _ = buf_append_cstr(out, "\nobjective = ");
    _ = buf_append(out, g.objective.ptr, g.objective.len);
    if g.blocker.len > 0 {
        _ = buf_append_cstr(out, "\nblocker_reason = ");
        _ = buf_append(out, g.blocker.ptr, g.blocker.len);
    }
    _ = buf_append_byte(out, 10);
}

// `get_goal` 工具：报状态（id / revision / phase / objective / round / maxRounds / blocker / armed）。
// 没有目标时给一句「还没建」，**不报错** —— 模型据此知道该 create。
export fn goal_tool_get(cfg: &const Config, out: &Buf) void {
    buf_reset(out);
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "no goal is set for this session");
        return;
    }
    goal_render(&g, out);
}

// `create_goal` 工具：`max_goal_rounds` 默认 `GOAL_DEFAULT_MAX_ROUNDS`（256）、
// 上限 `GOAL_MAX_ROUNDS_CAP`（1000）—— P116 从 20/200 提上来的，理由见常量那里；
// 新 id = 上一个 id + 1，revision 1、phase active、armed true。
// 已经有**未完成**的目标时**拒绝顶掉**（要换目标必须先 update 或 clear）。
export fn goal_tool_create(cfg: &const Config, args: &const JsonValue, out: &Buf) void {
    var objective: Buf = buf_empty();
    defer { buf_free(&objective); }
    if !js_obj_get_str_unescaped(args, "objective", 9, &objective) || objective.len == 0 {
        _ = buf_append_cstr(out, "Error: invalid objective: expected a non-empty string");
        return;
    }
    var maxr: i32 = GOAL_DEFAULT_MAX_ROUNDS;
    var mv: JsonValue = JsonValue.json_null();
    var n: i64 = 0;
    if js_obj_get(args, "max_goal_rounds", 15, &mv) && js_i64_of(&mv, &n) && n > 0 {
        if n > (GOAL_MAX_ROUNDS_CAP as i64) {
            n = GOAL_MAX_ROUNDS_CAP as i64;
        }
        maxr = n as i32;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    var prev: Goal = goal_empty();
    defer { goal_free(&prev); }
    var id: i32 = 1;
    if goal_load(cfg, &prev) {
        id = prev.id +% 1;
    }
    g.active_state = true;
    g.id = id;
    g.revision = 1;
    g.phase = buf_new(16);
    _ = buf_append_cstr(&g.phase, "active");
    g.objective = buf_new(objective.len + 8);
    _ = buf_append(&g.objective, objective.ptr, objective.len);
    g.round = 0;
    g.max_rounds = maxr;
    g.blocker = buf_empty();
    g.armed = true;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal");
        return;
    }
    g_goal_armed = true;   // P58：create 就是授权（DSH 的 create 也 armed）
    _ = buf_append_cstr(out, "created goal-");
    _ = buf_append_u64(out, g.id as u64);
    _ = buf_append_cstr(out, " (revision 1, phase active, maxGoalRounds ");
    _ = buf_append_u64(out, maxr as u64);
    _ = buf_append_cstr(out, ")\n");
    goal_render(&g, out);
}

// `update_goal` 工具：**CAS** —— `goal_id` 与 `revision` 都必须精确匹配（`goal-3` 与 `3`
// 两种写法都收），过期即报错并要求重取；每次成功 revision + 1。
// 动作五种：edit / pause / resume / complete / blocked；`blocked` 需要非空 `blocked_reason`
// 且 **round < 2 时拒绝**（DSH 规则：同一阻塞条件至少连续 3 轮）。
// **为什么必须 CAS**：目标跨进程/跨回合持久，没有 revision 校验两个并发分支会互相静默覆盖。
export fn goal_tool_update(cfg: &const Config, args: &const JsonValue, out: &Buf) void {
    var gid: Buf = buf_empty();
    defer { buf_free(&gid); }
    if !js_obj_get_str_unescaped(args, "goal_id", 7, &gid) || gid.len == 0 {
        _ = buf_append_cstr(out, "Error: goal_id is required; call get_goal first and copy the exact id");
        return;
    }
    var rev: i64 = -1;
    var rv: JsonValue = JsonValue.json_null();
    if js_obj_get(args, "revision", 8, &rv) {
        _ = js_i64_of(&rv, &rev);
    }
    var action: Buf = buf_empty();
    defer { buf_free(&action); }
    if !js_obj_get_str_unescaped(args, "action", 6, &action) || action.len == 0 {
        _ = buf_append_cstr(out, "Error: action must be one of edit|pause|resume|complete|blocked");
        return;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "Error: no goal is set for this session");
        return;
    }
    // 精确匹配：id 与 revision 都要对
    var want_id: i32 = 0;
    const idok: bool = deleg_id_from_buf(&gid, &want_id);
    // goal-3 / 3 两种写法都接受
    if idok && want_id != g.id {
        _ = buf_append_cstr(out, "Error: stale goal_id (the current goal is goal-");
        _ = buf_append_u64(out, g.id as u64);
        _ = buf_append_cstr(out, ")");
        return;
    }
    if rev >= 0 && rev != (g.revision as i64) {
        _ = buf_append_cstr(out, "Error: stale revision (the current revision is ");
        _ = buf_append_u64(out, g.revision as u64);
        _ = buf_append_cstr(out, "); call get_goal again");
        return;
    }
    if bufx_eq_cstr(action.ptr as &const byte, action.len, "edit") {
        var nobj: Buf = buf_empty();
        defer { buf_free(&nobj); }
        if !js_obj_get_str_unescaped(args, "objective", 9, &nobj) || nobj.len == 0 {
            _ = buf_append_cstr(out, "Error: action edit requires a non-empty objective");
            return;
        }
        goal_set(&g.objective, nobj.ptr[0: nobj.len]);
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "pause") {
        goal_set_lit(&g.phase, "paused" as &const byte, 6);
        g.armed = false;
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "resume") {
        // P116：resume 是「人明确要求继续」，两件事一起做 ——
        //   ① 清掉上一次的 blocker：它是上一次停下的原因，接着跑之后留在 get_goal /
        //      面板上只会误导（真机上「phase=active + 旧 blocker」同时存在过）；
        //   ② 轮次预算真的用尽（round-limit）时补一段：不补的话下一次 admit 立刻又把它
        //      标回 blocked，人看到的「已恢复」等于没恢复。
        goal_set_lit(&g.phase, "active" as &const byte, 6);
        g.armed = true;
        buf_reset(&g.blocker);
        if g.max_rounds > 0 && g.round >= g.max_rounds {
            g.max_rounds = g.round +% GOAL_DEFAULT_MAX_ROUNDS;
        }
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "complete") {
        goal_set_lit(&g.phase, "complete" as &const byte, 8);
        g.armed = false;
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "blocked") {
        var reason: Buf = buf_empty();
        defer { buf_free(&reason); }
        if !js_obj_get_str_unescaped(args, "blocked_reason", 14, &reason) || reason.len == 0 {
            _ = buf_append_cstr(out, "Error: action blocked requires a concrete blocked_reason");
            return;
        }
        // DSH 的规则：同一个阻塞条件至少连续 3 轮才允许标记 blocked
        if g.round < 2 {
            _ = buf_append_cstr(out, "Error: blocked is rejected before at least 3 consecutive goal rounds (current round ");
            _ = buf_append_u64(out, g.round as u64);
            _ = buf_append_cstr(out, "); difficulty, uncertainty, or useful remaining work is not blocked");
            return;
        }
        goal_set_lit(&g.phase, "blocked" as &const byte, 7);
        goal_set(&g.blocker, reason.ptr[0: reason.len]);
        g.armed = false;
    } else {
        _ = buf_append_cstr(out, "Error: action must be one of edit|pause|resume|complete|blocked");
        return;
    }
    g.revision = g.revision +% 1;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal");
        return;
    }
    // P58：本地续跑授权跟着动作翻 —— resume 是**人明确授权**的入口；pause / complete /
    // blocked 都要把授权收掉；edit 不碰（它只换目标正文，与 DSH 的 commitCurrent 保留
    // cache.activation 同口径）。
    if bufx_eq_cstr(action.ptr as &const byte, action.len, "resume") {
        g_goal_armed = true;
    } else if bufx_eq_cstr(action.ptr as &const byte, action.len, "pause")
        || bufx_eq_cstr(action.ptr as &const byte, action.len, "complete")
        || bufx_eq_cstr(action.ptr as &const byte, action.len, "blocked") {
        g_goal_armed = false;
    }
    _ = buf_append_cstr(out, "updated goal-");
    _ = buf_append_u64(out, g.id as u64);
    _ = buf_append_cstr(out, " → phase ");
    _ = buf_append(out, g.phase.ptr, g.phase.len);
    _ = buf_append_cstr(out, " (revision ");
    _ = buf_append_u64(out, g.revision as u64);
    _ = buf_append_cstr(out, ")\n");
    goal_render(&g, out);
}

// ============================================================
// /goal：人类命令面（P29，语法与措辞对齐 DSH 的 commands/command-goal）
// ============================================================
//
//   /goal                        看状态；没有 goal 时报用法
//   /goal <objective>            创建；已有**未完成**的 goal 时拒绝（必须先 edit 或 clear）
//   /goal edit <objective>       改目标（phase / armed 不动）；complete 的 goal 换新身份
//   /goal pause | resume         暂停 / 恢复（armed 跟着翻）
//   /goal clear                  清除（删掉 goal.json）
//
// 只有控制词**独占整行**时才不区分大小写，其余任何非空后缀都是字面目标 ——
// 所以 `/goal pause after verification` 创建的就是那个字面目标，而不是「暂停 + 备注」。
//
// 与模型工具的关系：共用同一份 goal.json。工具走 CAS（id + revision 都要对，挡住过期写入），
// 人类命令直接以「当前」为准 —— 人在回路里不存在读过期值这回事，那份 ref 只是给模型的护栏。
//
// clear 是**删文件**：本仓库里「没有 goal.json」与「从未建过目标」本来就是同一个状态
// （goal_load 返回 false），不留 tombstone；代价是 clear 之后 id 从 1 重新开始。

export const GOAL_USAGE: &const byte =
    "Usage: /goal [<objective>|clear|edit <objective>|pause|resume]" as &const byte;

// 人类命令的默认轮次上限与工具面**同一个常量**（`GOAL_DEFAULT_MAX_ROUNDS`；工具面还能用
// max_goal_rounds 覆写）。P116 起是 256 —— 原来这里另写死 20，两处只能各改各的。

// 是不是空白（空格 / tab / LF / CR）。用于 `/goal` 命令行的控制词判定。
fn goal_is_space(c: byte) bool {
    return c == 32 as byte || c == 9 as byte || c == 10 as byte || c == 13 as byte;
}

// 去掉 [from, n) 的首尾空白，返回绝对下标 [s_out, e_out)（全空白时两者相等）
fn goal_trim(p: &const byte, from: usize, n: usize, s_out: &usize, e_out: &usize) void {
    var s: usize = from;
    while s < n && goal_is_space(p[s]) {
        s = s + 1;
    }
    var e: usize = n;
    while e > s && goal_is_space(p[e - 1]) {
        e = e - 1;
    }
    s_out[0] = s;
    e_out[0] = e;
}

// 整段 [s, e) 是否就是这个控制词（大小写不敏感）。
// 长度从字面量自己量（bufx_cstr_len）—— 手写长度写大了会读进相邻常量，见 §16 踩坑 3。
fn goal_word_eq(p: &const byte, s: usize, e: usize, lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    if e - s != ln {
        return false;
    }
    var i: usize = 0;
    while i < ln {
        if byte_lower(p[s + i]) != byte_lower(lit[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 当前 phase 是不是这个字面量（`bufx_eq_cstr` 口径，长度由 NUL 前的部分定）。
fn goal_phase_is(g: &const Goal, lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    return g.phase.len == ln && bufx_eq_cstr(g.phase.ptr as &const byte, ln, lit);
}

// `/goal edit <objective>`：前缀是 "edit" 且**紧跟空白**（大小写不敏感），
// 命中就把替换目标的 [rs, re)（已去空白）交出去
fn goal_edit_span(p: &const byte, s: usize, e: usize, rs: &usize, re: &usize) bool {
    if e < s + 5 {                       // "edit" + 至少一个空白字符
        return false;
    }
    if !goal_word_eq(p, s, s + 4, "edit" as &const byte) {
        return false;
    }
    if !goal_is_space(p[s + 4]) {
        return false;
    }
    goal_trim(p, s + 4, e, rs, re);
    return true;
}

// 用 p[s, e) 替换 dst 的内容（buf_append_span 是**追加**语义，所以先 reset）
fn goal_set_span(dst: &Buf, p: &const byte, s: usize, e: usize) void {
    buf_reset(dst);
    if e > s {
        _ = buf_append_span(dst, p, s, e - s);
    }
}

// clear：删掉 goal.json（失败只有一种可能：文件系统不给删）
export fn goal_clear(cfg: &const Config) bool {
    var p: Buf = buf_new(1200);
    defer { buf_free(&p); }
    if !goal_path(cfg, &p) {
        return false;
    }
    if !buf_append_byte(&p, 0) {         // 系统调用前必须补 NUL，见 §16 踩坑 2
        return false;
    }
    _ = sys_unlink(&p.ptr[0] as *const byte) catch {
        return false;
    };
    return true;
}

// 人类看的正文（与工具面的 goal_render 分开：这里是 DSH 同款的键值对排版）
//
// **Objective / Blocker 必须压成一行**：它们是外来文本（`create_goal` 能塞多行、塞 ESC），
// 而这个正文要么进 TUI 浮层、要么打进转录的「一行」—— 行内带 `'\n'` 会把方框拆坏、
// 让后几行从第 0 列开始（踩坑 81 那一族）。口径直接复用 `tasks_flat_into`
// （`term/tasks.uya`：`tui_clean_into` + 换行/回车折成空格），与常驻块、`/tasks` 报告
// **同源** —— 不在这里另写一套折行。
// 键名 `Status:` / `Rounds:` / `Activation:` / `Commands:` 一个字节都不动：逐字对齐 DSH 的
// commands/command-goal（`make e2e-goal` 也在 grep 它们）。
fn goal_render_user(g: &const Goal, out: &Buf) void {
    // P116：与 get_goal 同一个口径 —— 报**生效值**（盘上意愿 && 进程本地授权）。
    // `--resume` 之后盘上可能仍是 true，只报盘上就会写着 armed 却根本不跑。
    const on: bool = g.armed && g_goal_armed;
    _ = buf_append_cstr(out, "Status: ");
    _ = buf_append(out, g.phase.ptr, g.phase.len);
    if goal_phase_is(g, "blocked" as &const byte) && g.blocker.len > 0 {
        var bl: Buf = buf_new(g.blocker.len + 16);
        defer { buf_free(&bl); }
        tasks_flat_into(&bl, g.blocker.ptr as &const byte, g.blocker.len);
        _ = buf_append_cstr(out, "\nBlocker: ");
        _ = buf_append(out, bl.ptr, bl.len);
    }
    var obj: Buf = buf_new(g.objective.len + 16);
    defer { buf_free(&obj); }
    tasks_flat_into(&obj, g.objective.ptr as &const byte, g.objective.len);
    _ = buf_append_cstr(out, "\nObjective: ");
    _ = buf_append(out, obj.ptr, obj.len);
    _ = buf_append_cstr(out, "\nRounds: ");
    _ = buf_append_u64(out, g.round as u64);
    _ = buf_append_cstr(out, "/");
    _ = buf_append_u64(out, g.max_rounds as u64);
    _ = buf_append_cstr(out, "\nActivation: ");
    if on {
        _ = buf_append_cstr(out, "armed");
    } else {
        _ = buf_append_cstr(out, "disarmed");
    }
    _ = buf_append_cstr(out, "\n\nCommands: ");
    if goal_phase_is(g, "active" as &const byte) {
        if on {
            _ = buf_append_cstr(out, "/goal edit <objective>, /goal pause, /goal clear");
        } else {
            _ = buf_append_cstr(out, "/goal edit <objective>, /goal resume, /goal clear");
        }
    } else if goal_phase_is(g, "complete" as &const byte) {
        _ = buf_append_cstr(out, "/goal <objective>, /goal clear");
    } else {                             // paused / blocked
        _ = buf_append_cstr(out, "/goal edit <objective>, /goal resume, /goal clear");
    }
    _ = buf_append_byte(out, 10);
}

// `/goal edit` 没给新目标时的回执：报「必须有替代目标」+ 用法，返回 **1**（用法错）。
// 返回码是 `/goal` 这一族统一的契约（0 成功 / 1 用法错），调用方直接拿它当退出码用。
fn goal_cmd_need_objective(out: &Buf) i32 {
    _ = buf_append_cstr(out, "Goal editing requires a replacement objective.\n");
    _ = buf_append_cstr(out, GOAL_USAGE);
    _ = buf_append_byte(out, 10);
    return 1;
}

// 还没有目标却敲了需要目标的动词（edit/pause/resume/clear）时的回执：
// 报「没有目标」+ 用法，返回 **1**。verb 只用于文案，不参与判定。
fn goal_cmd_missing(out: &Buf, verb: &const byte) i32 {
    _ = buf_append_cstr(out, "No goal is currently set; /goal ");
    _ = buf_append_cstr(out, verb);
    _ = buf_append_cstr(out, " requires one.\n");
    _ = buf_append_cstr(out, GOAL_USAGE);
    _ = buf_append_byte(out, 10);
    return 1;
}

// 裸 /goal：有目标报状态，没有就报用法（两者都是成功 —— 看状态本身不会失败）
fn goal_cmd_show(cfg: &const Config, out: &Buf) i32 {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "No goal is currently set.\n");
        _ = buf_append_cstr(out, GOAL_USAGE);
        _ = buf_append_byte(out, 10);
        return 0;
    }
    _ = buf_append_cstr(out, "Goal\n");
    goal_render_user(&g, out);
    return 0;
}

// 创建：已有**未完成**的 goal 时拒绝（DSH 同一条规则：必须先 edit 或 clear）。
// 已完成的 goal 让位 —— 新的目标换新身份（id +1，revision 回到 1）。
fn goal_cmd_create(cfg: &const Config, p: &const byte, s: usize, e: usize, out: &Buf) i32 {
    var cur: Goal = goal_empty();
    defer { goal_free(&cur); }
    var id: i32 = 1;
    if goal_load(cfg, &cur) {
        if !goal_phase_is(&cur, "complete" as &const byte) {
            _ = buf_append_cstr(out, "A goal is already ");
            _ = buf_append(out, cur.phase.ptr, cur.phase.len);
            _ = buf_append_cstr(out,
                ". Use /goal edit <objective> to change it or /goal clear before replacing it.\n");
            return 1;
        }
        id = cur.id +% 1;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    g.active_state = true;
    g.id = id;
    g.revision = 1;
    g.phase = buf_new(16);
    _ = buf_append_cstr(&g.phase, "active");
    g.objective = buf_new(e - s + 8);
    _ = goal_set_span(&g.objective, p, s, e);
    g.round = 0;
    g.max_rounds = GOAL_DEFAULT_MAX_ROUNDS;
    g.blocker = buf_empty();
    g.armed = true;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal\n");
        return 1;
    }
    g_goal_armed = true;   // P58：人刚说了要干这件事 —— 当场授权续跑
    _ = buf_append_cstr(out, "Goal created\n");
    goal_render_user(&g, out);
    return 0;
}

// 改目标：phase / armed / round 都不动，只换 objective 并 +1 revision
fn goal_cmd_edit(cfg: &const Config, p: &const byte, s: usize, e: usize, out: &Buf) i32 {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        return goal_cmd_missing(out, "edit" as &const byte);
    }
    if goal_phase_is(&g, "complete" as &const byte) {
        return goal_cmd_create(cfg, p, s, e, out);   // 已完成：edit 就是换一个新目标
    }
    goal_set_span(&g.objective, p, s, e);
    g.revision = g.revision +% 1;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal\n");
        return 1;
    }
    _ = buf_append_cstr(out, "Goal updated\n");
    goal_render_user(&g, out);
    return 0;
}

// pause / resume：phase 与 armed 一起翻（armed=false 才是「不会自动续跑」的那个开关）
fn goal_cmd_switch(cfg: &const Config, out: &Buf, armed: bool, verb: &const byte,
        phase: &const byte, title: &const byte) i32 {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        return goal_cmd_missing(out, verb);
    }
    // P116：resume（armed=true）与 update_goal 的 resume 同口径 —— 清掉上一次的 blocker，
    // 并在轮次预算用尽时补一段（否则下一次 admit 立刻又标回 blocked）。
    goal_set_lit(&g.phase, phase, bufx_cstr_len(phase));
    g.armed = armed;
    if armed {
        buf_reset(&g.blocker);
        if g.max_rounds > 0 && g.round >= g.max_rounds {
            g.max_rounds = g.round +% GOAL_DEFAULT_MAX_ROUNDS;
        }
    }
    g.revision = g.revision +% 1;
    if !goal_save(cfg, &g) {
        _ = buf_append_cstr(out, "Error: cannot persist the goal\n");
        return 1;
    }
    g_goal_armed = armed;   // P58：resume 是人授权的唯一入口；pause 要把它收掉
    _ = buf_append_cstr(out, title);
    _ = buf_append_byte(out, 10);
    goal_render_user(&g, out);
    return 0;
}

// clear：没有目标时也算成功（幂等），只是回一句「没得清」
fn goal_cmd_clear(cfg: &const Config, out: &Buf) i32 {
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) {
        _ = buf_append_cstr(out, "No goal to clear.\n");
        return 0;
    }
    if !goal_clear(cfg) {
        _ = buf_append_cstr(out, "Error: cannot remove the goal file\n");
        return 1;
    }
    g_goal_armed = false;   // P58：目标没了，进程本地的续跑授权也一并收掉
    _ = buf_append_cstr(out, "Goal cleared.\n");
    return 0;
}

// 执行一条人类 /goal 命令。line 是**整行**（含命令名，如 "/goal edit 把测试跑绿"）。
// out 会被重置：返回 0 = 成功，1 = 用法或状态错误 —— 两种情况都把可直接展示的正文写进 out，
// 调用方不需要自己拼字符串（滚动模式打出来，TUI 塞进浮层）。
export fn goal_cmd_run(cfg: &const Config, line: &const Buf, out: &Buf) i32 {
    buf_reset(out);
    const p: &const byte = line.ptr as &const byte;
    const n: usize = line.len;
    if n < 5 {                           // 调用方只会把 "/goal…" 送进来，防一手
        _ = buf_append_cstr(out, GOAL_USAGE);
        _ = buf_append_byte(out, 10);
        return 1;
    }
    var s: usize = 0;
    var e: usize = 0;
    goal_trim(p, 5, n, &s, &e);          // 跳过 "/goal" 这 5 个字节
    if e == s {                          // 裸 /goal = 看状态
        return goal_cmd_show(cfg, out);
    }
    if goal_word_eq(p, s, e, "clear" as &const byte) {
        return goal_cmd_clear(cfg, out);
    }
    if goal_word_eq(p, s, e, "pause" as &const byte) {
        return goal_cmd_switch(cfg, out, false, "pause" as &const byte,
            "paused" as &const byte, "Goal paused" as &const byte);
    }
    if goal_word_eq(p, s, e, "resume" as &const byte) {
        return goal_cmd_switch(cfg, out, true, "resume" as &const byte,
            "active" as &const byte, "Goal resumed" as &const byte);
    }
    if goal_word_eq(p, s, e, "edit" as &const byte) {
        return goal_cmd_need_objective(out);   // 只有 "edit"、没有替换内容
    }
    var rs: usize = 0;
    var re: usize = 0;
    if goal_edit_span(p, s, e, &rs, &re) {
        if re == rs {
            return goal_cmd_need_objective(out);
        }
        return goal_cmd_edit(cfg, p, rs, re, out);
    }
    return goal_cmd_create(cfg, p, s, e, out);
}

// 把「继续自动跑」这一位收掉：**进程本地与盘上都收**，phase 一个字节不动。
//
// 为什么要连盘上一起翻（P96；P116 起显示改看「盘上 && 本地」的生效值，这一笔仍要写）：
// 写盘让 goal.json 自己也不留着一个早就没了的授权 —— 别的进程/工具读到它时不该以为
// 这条目标还在自动跑。只清本地的话，盘上会永久留着一次「早就作废的 armed=true」。
// phase 保持 active 是刻意的：目标本身没被放弃，`/goal resume` 一条命令就接着跑；
// 顺手改成 paused 反而要人多想一步「我是不是把它弄坏了」。
// 写盘失败不做补救（授权照样收掉 ——「不再自己跑」比「盘上好看」重要）。
export fn goal_disarm(cfg: &const Config) void {
    g_goal_armed = false;
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) || !g.armed {
        return;
    }
    g.armed = false;
    g.revision = g.revision +% 1;
    _ = goal_save(cfg, &g);
}

// P121：**人的新输入 = 重新授权自动续跑**。
//
// 症状（用户报的，现场 `session-c7f98113` 的 goal.json 正是 phase=active、
// armed=false、round=264/512）：目标在跑，人按 esc 停下当前这一轮（P96 收掉
// 授权），然后敲一句「为什么这么耗内存」/「修复」/「继续」。agent 答完那句
// 话就停在提示符上 —— 目标盘上还是 active，可再也不会自己开下一轮；人得反复
// 敲「继续」，而模型不一定记得去 `update_goal action=resume`（P116 §19.36 记
// 的就是这种失速）。人**还在键盘前**指挥，那不是「不要跑了」。
//
// 所以：目标还是 active、而授权收着（esc 叫停 / 异常收场 / `--resume` 之后）
// 时，人的**任何**一条新输入（新回合，或回合运行中被采纳的插话）都把授权翻回
// 来一次，驱动器下一圈照常开轮。三条明确的「不要跑了」不受影响：
//   * `/goal pause` 或模型的 `update_goal action=pause` → phase=paused，这里
//     一个字节都不动（complete / blocked 同理）；
//   * esc 之后**不再输入** → 没人说话，授权就一直收着（P96 仍在）；
//   * 非交互（管道 / CI / 子代理）→ 与驱动器同一对闸门，一次都不翻。
// 盘上也要翻回 `armed=true`：面板与别的进程看的是「盘上 && 本地」（P116），
// 只翻本地会让它们继续写着 disarmed —— `goal_disarm` 的反向操作必须成对。
//
// 返回 true = 这一次真的把授权翻开了（调用方据此刷新面板）。
export fn goal_rearm_on_human(cfg: &const Config) bool {
    if !g_interactive || cfg.is_subagent || g_goal_armed {
        return false;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) || !g.active_state {
        return false;
    }
    if !goal_phase_is(&g, "active" as &const byte) {
        return false;   // paused / blocked / complete：只能显式 resume
    }
    if !g.armed {
        g.armed = true;
        g.revision = g.revision +% 1;
        if !goal_save(cfg, &g) {
            // 写不进去就别空转：授权不打开（与 admit 的记账失败同一条纪律）
            out_err("[goal] 收到人的新输入，但记不上账（goal.json 写失败），续跑授权没有恢复\n");
            return false;
        }
    }
    g_goal_armed = true;
    if !cfg.quiet {
        out_err("[goal] 人的新输入已恢复自动续跑（/goal pause 可停）\n");
    }
    return true;
}


// ============================================================
// P58：同会话 Goal Round 驱动器（对齐 DSH 的 goal-round-driver）
// ============================================================
//
// 触发点是**主循环的空闲那一支**（`agent_goal_drive`，TUI 与滚动模式各一处调用点），
// 也就是「agent 已经 idle、没有待提交输入、没有浮层结果」的那一刻 —— 与 DSH 的
// 「agent.status === 'idle' && 没有竞争 prompt」同一个检查点。
//
// 这一个函数同时干两件事（本仓顶层函数预算为 0，见 CODING.md §6，所以合成一个）：
//   ① 回答「该不该开下一轮」——不能开的每一档都在这里挡住（顺序即优先级）；
//   ② 能开就把这一轮的正文拼进 out，**并把这一轮记在账上**（round / revision +1 落盘）。
//      「记账」与「投递」成对放在这里是为了原子性：**只有记上账的轮次才会被投递**。
//      反过来（先投递后记账）一旦落盘失败就是个没有记录的轮次，下一次驱动又会拿同一个
//      轮号重发一遍；投递本身失败反而没关系 —— 账已经记了，那一轮确实开了。
//
// 不能开的四档（顺序即优先级）：
//   * 进程本地没授权（换过会话 / 从没 resume 过）→ 不动（DSH：activation !== armed）；
//   * 没有目标、或 phase 不是 active → 不动（complete / paused / blocked 都是「别再跑了」）；
//   * 轮次用尽（round >= maxRounds）→ 把**盘上**的 phase 改成 blocked + blocker=round-limit、
//     armed=false、revision+1，并把本地授权收掉。与 DSH 的 `round-limit` 一致：这不是
//     「悄悄停下」，而是目标明确的终态（面板与 get_goal 都看得见）；
//   * 落盘失败 → 一个字节都不给（返回 false，并把授权收掉：写不进去就别再空转）。
//
// 正文措辞与 DSH 的 `renderGoalRoundPrompt` 逐句对应（`<goal_round>` 标签也照抄 ——
// 模型认这个形状）。objective 走 JSON 字符串转义（`jw_str_into`）：目标里带换行或形似标签
// 的文本只能是**数据**，不许在提示词里变成结构（DSH 的 `JSON.stringify(goal.objective)`
// 是同一个理由）。
export fn goal_round_admit(cfg: &const Config, out: &Buf) bool {
    buf_reset(out);
    if !g_goal_armed {
        return false;
    }
    var g: Goal = goal_empty();
    defer { goal_free(&g); }
    if !goal_load(cfg, &g) || !g.active_state {
        return false;
    }
    if !goal_phase_is(&g, "active" as &const byte) {
        return false;
    }
    if g.max_rounds > 0 && g.round >= g.max_rounds {
        goal_set_lit(&g.phase, "blocked" as &const byte, 7);
        goal_set_lit(&g.blocker, "round-limit" as &const byte, 11);
        g.armed = false;
        g.revision = g.revision +% 1;
        _ = goal_save(cfg, &g);
        g_goal_armed = false;
        return false;
    }
    g.round = g.round +% 1;
    g.revision = g.revision +% 1;
    if !goal_save(cfg, &g) {
        out_err("[goal] 续跑：记不上账（goal.json 写失败），本轮不发\n");
        g_goal_armed = false;
        return false;
    }
    _ = buf_append_cstr(out, "<goal_round>\nObjective: ");
    _ = jw_str_into(out, g.objective.ptr as &const byte, g.objective.len);
    _ = buf_append_cstr(out, "\nRound: ");
    _ = buf_append_i64(out, g.round as i64);
    _ = buf_append_cstr(out, "/");
    _ = buf_append_i64(out, g.max_rounds as i64);
    // P120：把**真实的**上下文占用报给模型。模型的「上下文只剩 3%」是它自己猜的
    // （真值 20%），而它拿那个猜出来的数当理由把整段目标停下 —— 每轮给一行真数
    // 只要二十几字节，且它随时能对上 `compact` 工具回执里的同一组数字。
    // 拿不到样本（提供方没回过用量）时**一个字都不加**：不报假数。
    if st_pressure() > 0 {
        _ = buf_append_cstr(out, "\nContext: ~");
        st_fmt_tokens(out, st_pressure());
        _ = buf_append_cstr(out, " tokens used");
        if cfg.context_window > 0 {
            _ = buf_append_cstr(out, " of ");
            st_fmt_tokens(out, cfg.context_window);
            _ = buf_append_cstr(out, " (");
            _ = buf_append_u64(out,
                st_ctx_percent(st_pressure(), cfg.context_window) as u64);
            _ = buf_append_cstr(out, "%)");
        } else {
            _ = buf_append_cstr(out, "; the window size is unknown");
        }
        // 行宽豁免：这句是给模型的单句英文指令，拆开只会让措辞更难维护。
        _ = buf_append_cstr(out, " — a long conversation is not an exhausted context; the compact tool frees it on demand.");
    }
    _ = buf_append_cstr(out,
        "\n\nContinue working toward the objective in this same session. Treat the current workspace, tool results, and durable session state as authoritative; inspect them instead of assuming earlier narration is still current. Make concrete progress and verify the result. Before claiming completion, gather evidence that the whole objective is achieved, read the current goal, and mark it complete. If work remains, leave the goal active for the next round. Follow the configured goal-tool policy before reporting a blocker.\n</goal_round>");
    return out.len > 0;
}
