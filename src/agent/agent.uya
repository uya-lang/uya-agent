// src/agent/agent.uya — 极简 CLI 编程 agent：CLI / 环境变量 / REPL / 主循环 / tools schema
//
// 本文件：进程入口 `main` 与配置来源链、对话历史（`Msg`/`History` 与 `hist_*`）、
//   system prompt 与运行时上下文的装配调用点、请求组装（`build_chat_request` /
//   `build_responses_request`）、一步的收发与收尾（`agent_step_stream` / `agent_step_plain` /
//   `agent_finish_step`）、回合与 step 循环（`agent_turn_loop*`）、工具派发
//   （`dispatch_tool_body`）与 28 条工具 schema、会话事件写入（`agent_bound_*` / `agent_log_*`）、
//   标题（`agent_title_*`）、工作区（`agent_workspace_apply_full`）、TUI 生命周期
//   （`agent_tui_start`/`agent_tui_stop`/`agent_tui_demo`）、全部斜杠命令与 `--print-config`。
// 不变量：① **`--dsh-home` / `--dsh-root` / `--no-dsh-config` / `--strict-dsh-config` 必须
//   在读设置之前预扫** —— 放到主循环再解析会静默失效（§3.1）；② 配置优先级 **DSH 设置 →
//   环境变量 → CLI**，每个取值都带来源标签；③ **`main` 必须 `export fn main() i32`**（不能
//   写 `!i32`：split-C 下会与 entry 冲突，§16 踩坑 8）；④ **任何 `&Msg` 不许跨 `hist_push*` /
//   `hist_reserve` 使用**（realloc 搬家，§3.6）；⑤ 历史里 `assistant(tool_calls)` + N 条 tool
//   结果是**原子组**，派发失败要整组回滚（`hist_truncate_to`）；⑥ 退化响应那一步**不留痕**
//   （不写 `assistant/message`、不进历史、不计统计，§5.4）；⑦ 所有显示输出走 `err_fd()`
//   （`tls_noise_mute` 会动 fd 2）。
// 依赖：libc（fcntl / heap / stdlib / syscall / unistd）、std.json、std.mem（arena / mem）、
//   std.runtime（get_argc / get_argv）、std.string.strlen；本仓的**几乎每一个域** ——
//   foundation（bufx / jsonx / yamlcfg）、net（httpc / llm / webx）、term（含 tui/）、tools、
//   session、vcs、diff、media。它是分层图的最上层（§2.2）。
// 命名：`agent_*`（主流程与命令）、`cfg_*`（配置）、`hist_*`/`msg_*`（历史）、`build_*`（构请求）、
//   `tools_*`（schema）、`dispatch_*`、`dump_*`/`out_*`（诊断输出）、`parse_*`、
//   `wt_act_*`（worktree 工具面）、`g_*`（状态全局，见 §3.3 的表）。
//
// 协议（刻意极简）：
//   * 非流式 POST {base_url}/chat/completions，带 tools（OpenAI function calling）；
//   * 模型返回 tool_calls 时本地执行工具，把结果拼成**一条 user 消息**回灌，
//     不回灌 assistant 的 tool_calls 原样 JSON —— 因此完全不需要 tool_call_id 配对，
//     对 DeepSeek / ollama / vLLM 等 OpenAI 兼容端点都一样稳；
//   * 没有任何 tool_calls 的回复就是最终答案。

use libc.syscall;
use libc.unistd;
use libc.heap;
use libc.stdlib;
use libc.fcntl;
use std.runtime.get_argc;
use std.runtime.get_argv;
use std.string.strlen;
use std.mem.mem.mem_copy;
use std.mem.mem.mem_set;
use std.json.value.JsonValue;
use std.json.value.JsonStrView;
use std.json.encoder.JsonWriter;
use std.mem.arena.Arena;
use std.mem.arena.arena_init;
use std.mem.arena.arena_alloc;
use std.mem.arena.arena_reset;

// =====================================================// 配置
// ============================================================
export struct Config {
    base_url: Buf,
    model: Buf,
    api_key: Buf,
    workspace: Buf,
    // P34：工作区是「当前会话」的状态 —— 模型能用 workspace 工具切、人能用 /workspace 切、
    // 恢复会话时按日志里最后一条 session/workspace 落位。
    //   ws_src：当前值从哪来（0 默认 getcwd / 1 会话记录 / 2 env / 3 cli）
    //   ws_explicit：cli 或 env **显式**指定过（显式优先于会话记录）
    //   resume_ws：被恢复会话记录的工作区（空 = 没有记录）
    ws_src: u8,
    ws_explicit: bool,
    resume_ws: Buf,
    task: Buf,
    pin: Buf,
    verify: i32,
    max_steps: i32,
    max_response: usize,
    max_tool_out: usize,
    shell_timeout_ms: u32,
    allow_shell: bool,
    quiet: bool,
    tls_debug: bool,
    timeout_ms: u32,
    // P1：流式
    stream: bool,             // false = 走旧的非流式路径（--no-stream）
    stream_options: bool,     // 发 stream_options.include_usage
    show_reasoning: bool,     // P16：把思考压成一行显示（`✻ 思考 · …`，落盘不受它影响）
    show_usage: bool,         // 每轮结束打印 token 用量
    tool_lines: i32,          // P16：工具正文档位（默认 0 = 只留一行；N>0 = 首尾各 N 行 + diff/todo）
    max_tokens: i64,          // 0 = 不发送 max_tokens
    temperature: i32,         // -1 = 不发送 temperature（对齐 DSH 默认行为）
    compat_fold: bool,        // true = 工具结果折叠成一条 user 消息（老端点兼容）
    // P4：会话
    save_session: bool,       // false = --no-save
    resume_id: Buf,           // --resume <id> / --continue 解析出的 id（空 = 新会话）
    agent_home: Buf,          // ~/.uya-agent 之类
    list_sessions: bool,      // --list-sessions：打印后退出
    list_dsh_sessions: bool,  // --list-dsh-sessions
    resume_dsh: Buf,          // --resume-dsh <id 或前缀>
    // P5：DSH 设置兼容
    dsh_home: Buf,            // --dsh-home（缺省 $DSH_HOME 或 ~/.dsh）
    no_dsh_config: bool,      // --no-dsh-config
    strict_dsh_config: bool,  // --strict-dsh-config：读不到就报错退出
    print_config: bool,       // --print-config
    context_window: i64,      // 来自模型条目（压缩阈值基准）
    reasoning_effort: Buf,    // 来自 agent-default-model
    input_image: bool,        // 模型条目 input 含 image
    // P55：低思考执行态 —— 前 exec_after 步用 reasoning_effort 把方案想清，之后切到 exec_effort 执行。
    //   exec_after <= 0 或 exec_effort 为空 = 关闭（默认，行为与改动前逐字节一致）。
    //   grace_steps：验收类命令首次「改动之后」通过起，还允许再走几步；0 = 只提醒、不设硬上限。
    exec_effort: Buf,
    exec_after: i32,
    grace_steps: i32,
    // P37：模型路线（对齐 DSH 的 session.selectModel：一次选择 = provider + model + reasoning effort）
    //   provider：提供方键（settings.yaml 里的 providers.<key>）；空 = 未知（--no-dsh-config 或目录为空）
    //   provider_set：provider 是不是「已知的」（决定 /model 浮层要不要按提供方分组）
    //   src_provider：来源码（与 cfg_src_name 同口径）
    //   effort_set：reasoning effort 是不是「模型公布过的档位」（false = 用户/设置硬塞的值，
    //               原样透传、不做 clamp，与既有 --reasoning-effort 的行为一致）
    provider: Buf,
    provider_set: bool,
    src_provider: u8,
    effort_set: bool,
    // P37：worktree 模式的来源（0 默认关 / 1 DSH preset / 2 env / 3 cli）
    wt_src: u8,
    access: u8,               // P21：访问模式（PERM_READ_ONLY / PERM_WORKSPACE_WRITE / PERM_FULL_ACCESS）
    src_base_url: u8,
    src_model: u8,
    src_key: u8,
    src_context: u8,
    src_access: u8,           // 访问模式的来源（0 默认 / 1 dsh-settings / 2 env / 3 cli）
    src_verify: u8,           // TLS 信任策略的来源（0 默认 / 1 dsh-settings / 2 env / 3 cli）
    src_pin: u8,              // leaf 指纹的来源
    // 线协议（§4.8）：默认 = responses；未声明时可一次性协商回退 chat
    api_style: u8,            // LLM_STYLE_CHAT / LLM_STYLE_RESPONSES
    api_dev_role: bool,       // true = 系统提示发 role:"developer"（false = "system"）
    api_store: bool,          // true = responses 请求里发 "store":false
    api_reasoning: bool,      // true = 允许发 reasoning.effort
    src_api: u8,              // 0 未声明（可协商）/ 1 dsh-settings / 2 env / 3 cli
    src_effort: u8,           // reasoning effort 的来源（复用 cfg_src_name）
    // P8
    dry_run: bool,            // --dry-run：只组装请求并打印（不联网）
    plan: bool,               // --plan：以 plan 模式启动
    dsh_root: Buf,            // --dsh-root：packaged preset 根
    skill_dirs: Buf,          // --skill-dir（冒号分隔，可多次）
    uya_bin: Buf,             // --uya-bin：跑 workflow 脚本的 uya 可执行文件
    // P17：全屏 TUI
    tui: bool,                // --tui / --no-tui（TTY 交互模式默认开）
    tui_src: u8,              // 0 默认 / 1 env / 2 cli
    // P22：终端标题（TTY title）—— 交互模式下把窗口/标签页标题写成当前会话标题
    title: bool,              // --title / --no-title（交互模式默认开）
    title_src: u8,            // 0 默认 / 2 env / 3 cli（与 cfg_src_name 同口径）
    // P46：自动起标题（每来一条人类消息、回合收口时让模型给个标题）
    title_auto: bool,         // --title-auto / --no-title-auto（默认开）
    title_auto_src: u8,       // 0 默认 / 2 env / 3 cli
    // 踩坑 72：鼠标上报（TUI 里 --mouse / --no-mouse / UYA_AGENT_MOUSE）。
    // 默认开（滚轮要靠它）；关掉之后终端接管拖选 —— 这就是「不能复制文本」的出口。
    mouse: bool,
    mouse_src: u8,            // 0 默认 / 2 env / 3 cli
    tui_headless: bool,       // 自测用：不碰终端，直接把帧写进给定 fd
    tui_demo: bool,           // --tui-demo：渲染一帧示例屏就退出（诊断/文档）
    tui_cols: usize,          // headless 画布宽（自测用）
    tui_rows: usize,          // headless 画布高（自测用）
    color_mode: u8,           // 0 auto / 1 always / 2 never / 3 16 色 / 4 256 色
    // P11：派生化
    is_subagent: bool,        // 这个进程是被派生出来的子代理
    fork_from: Buf,           // 子代理要继承的父会话 id（subagent_fork）
    deleg_depth: i32,         // 派生深度（父 + 1）
    parent_session: Buf,      // 父会话 id
    deleg_label: Buf,         // 显示用标签（description）
    // P21：沙箱（bwrap profile 由访问模式决定）
    sandbox: u8,              // SAN_AUTO（默认，探测 bwrap）/ SAN_OFF（--no-sandbox）
    sandbox_src: u8,          // 来源（0 默认 / 2 env / 3 cli）
    bwrap: Buf,               // --bwrap / UYA_AGENT_BWRAP：显式指定 bwrap 路径
    // 父进程**预先**为子代理指定的会话 id（NUL 结尾的 C 字符串）。
    // 为什么要有它：父进程 spawn 之后要拿子会话 id 才能 send_message 续跑，
    // 但子进程是 fork 出来的、id 由子进程自己生成，父进程无从得知（原实现里
    // d.sid 永远是空的 → 续跑其实每次都新开一个会话、上下文全丢）。
    // 由父进程先生成 id、传给子进程用，父子就天然对上了。
    force_session_id: Buf,}

// 配置的**唯一**出厂值（约 100 个字段）。main 的第一件事就是它，
// 之后按「DSH 设置 → 环境变量 → CLI」逐层覆盖（§3.1）。
// 改这里的默认值等于改「用户什么都不给时的行为」，所以每一处都要能说出理由。
fn cfg_default() Config {
    return Config{
        base_url: buf_empty(),
        model: buf_empty(),
        api_key: buf_empty(),
        workspace: buf_empty(),
        ws_src: 0,
        ws_explicit: false,
        resume_ws: buf_empty(),
        task: buf_empty(),
        pin: buf_empty(),
        verify: HC_VERIFY_CHAIN,
        // 0（默认）= 不限步数：一直跑到模型给出最终答案（不再有 12 步熔断）
        max_steps: 0,
        max_response: 262144,
        max_tool_out: 65536,
        shell_timeout_ms: 120000,
        allow_shell: true,
        quiet: false,
        tls_debug: false,
        timeout_ms: 120000,
        stream: true,
        stream_options: true,
        show_reasoning: false,
        show_usage: false,
        tool_lines: 0,
        max_tokens: 0,
        temperature: -1,
        compat_fold: false,
        tui: true,
        tui_src: 0,
        title: true,
        title_src: 0,
        title_auto: true,
        title_auto_src: 0,
        mouse: true,
        mouse_src: 0,
        tui_headless: false,
        tui_demo: false,
        tui_cols: 160,     // --tui-demo 默认画布：够放下完整的统计行（约 120 列）
        tui_rows: 40,
        color_mode: 0,
        save_session: true,
        resume_id: buf_empty(),
        agent_home: buf_empty(),
        list_sessions: false,
        list_dsh_sessions: false,
        resume_dsh: buf_empty(),
        dsh_home: buf_empty(),
        no_dsh_config: false,
        strict_dsh_config: false,
        print_config: false,
        context_window: -1,
        reasoning_effort: buf_empty(),
        input_image: false,
        exec_effort: buf_empty(),
        exec_after: 0,
        grace_steps: 0,
        provider: buf_empty(),
        provider_set: false,
        src_provider: 0,
        effort_set: false,
        wt_src: 0,
        access: PERM_FULL_ACCESS,
        src_base_url: 0,
        src_model: 0,
        src_key: 0,
        src_context: 0,
        src_access: 0,
        src_verify: 0,
        src_pin: 0,
        api_style: LLM_STYLE_RESPONSES,
        api_dev_role: true,
        api_store: true,
        api_reasoning: true,
        src_api: API_SRC_DEFAULT,
        src_effort: 0,
        dry_run: false,
        plan: false,
        dsh_root: buf_empty(),
        skill_dirs: buf_empty(),
        uya_bin: buf_empty(),
        is_subagent: false,
        fork_from: buf_empty(),
        deleg_depth: 0,
        parent_session: buf_empty(),
        deleg_label: buf_empty(),
        sandbox: SAN_AUTO,
        sandbox_src: 0,
        bwrap: buf_empty(),
        force_session_id: buf_empty(),    };
}

// 释放 Config 里所有的 Buf 字段。**幂等**（buf_free 后清零），
// 所以重复调用安全 —— CLI 的早退分支都靠 defer 收尾。
fn cfg_free(c: &Config) void {
    buf_free(&c.resume_id);
    buf_free(&c.agent_home);
    buf_free(&c.dsh_home);
    buf_free(&c.reasoning_effort);
    buf_free(&c.exec_effort);
    buf_free(&c.provider);
    buf_free(&c.dsh_root);
    buf_free(&c.skill_dirs);
    buf_free(&c.resume_dsh);
    buf_free(&c.uya_bin);
    buf_free(&c.fork_from);
    buf_free(&c.parent_session);
    buf_free(&c.deleg_label);
    buf_free(&c.force_session_id);
    buf_free(&c.base_url);
    buf_free(&c.model);
    buf_free(&c.api_key);
    buf_free(&c.workspace);
    buf_free(&c.resume_ws);
    buf_free(&c.task);
    buf_free(&c.pin);
    buf_free(&c.bwrap);
}

// ============================================================
// 线协议：选择与一次性协商（§4.8）
//
// 默认（什么都没声明）= 先按 Responses 发；只有「端点不存在」（404/405/501）才回退
// chat/completions，并且**每个进程只协商一次**，结果记在下面两个全局里（子代理是
// fork 出来的副本，会继承父进程已经协商好的结果，这正是想要的）。
// 一旦 DSH 设置 / 环境变量 / 命令行显式声明了协议，就完全不协商 —— 声明即权威。
// ============================================================
export const API_SRC_DEFAULT: u8 = 0;

// P22：终端标题开关的来源码。取值刻意与 `cfg_src_name` 同口径（1=dsh-settings / 2=env / 3=cli），
// 而不是跟 `tui_src` 那套 1=env / 2=cli —— `--print-config` 打的就是 `cfg_src_name`。
// 标题没有 DSH 设置这一路，所以只用 0 / 2 / 3。
const TITLE_SRC_ENV: u8 = 2;
const TITLE_SRC_CLI: u8 = 3;

var g_api_probe_done: bool = false;
var g_api_resolved: u8 = LLM_STYLE_RESPONSES;

// 本次请求用哪个协议
fn api_style_now(cfg: &const Config) u8 {
    if cfg.src_api != API_SRC_DEFAULT {
        return cfg.api_style;      // 声明过：不协商
    }
    if g_api_probe_done {
        return g_api_resolved;     // 协商过：用记住的结果
    }
    return cfg.api_style;          // 默认 = responses（首次请求）
}

// 「端点不存在」才值得换协议；任何别的状态码（200/400/401/500…）都说明协议没选错。
// style 必须是本次真正用的那个协议：只有「未声明 + 正在用 responses」才谈得上回退。
fn api_may_negotiate(cfg: &const Config, style: u8, status: i32) bool {
    if cfg.src_api != API_SRC_DEFAULT || g_api_probe_done {
        return false;
    }
    if style != LLM_STYLE_RESPONSES {
        return false;
    }
    return status == 404 || status == 405 || status == 501;
}

// 锁存本次尝试的协议（只在未声明时有意义）
fn api_lock(cfg: &const Config, style: u8) void {
    if cfg.src_api != API_SRC_DEFAULT || g_api_probe_done {
        return;
    }
    g_api_probe_done = true;
    g_api_resolved = style;
}

// 回退开关：只有「未声明 + 还在 responses + 端点不存在」时成立，且只成立一次
fn api_negotiate(cfg: &const Config, style: u8, status: i32) bool {
    if !api_may_negotiate(cfg, style, status) {
        return false;
    }
    g_api_probe_done = true;
    g_api_resolved = LLM_STYLE_CHAT;
    out_err("[api] /v1/responses 不可用（HTTP ");
    out_err_dec(status as usize);
    out_err("），本进程改用 chat/completions\n");
    return true;
}

// 自测用：复位协商状态（进程级全局，跑「协商」那一轮之前必须调）
export fn agent_api_reset_negotiation() void {
    g_api_probe_done = false;
    g_api_resolved = LLM_STYLE_RESPONSES;
}

// 自测用：看当前生效的协议（含协商结果）
export fn agent_api_style_now(cfg: &const Config) u8 {
    return api_style_now(cfg);
}

// ============================================================
// 输出小工具
// ============================================================
// 所有输出都走 tty 协议：交互模式下先擦掉输入行再写、写完重画，
// 避免流式输出和用户正在敲的字互相踩；非交互时就是裸 write。
fn out_err(p: &const byte) void {
    tty_stream_write(2, p as &const byte, strlen(p));
}

// 往**显示用的 stderr**（`err_fd()`，不是裸 fd 2）原样写 n 字节。
// 必须走 `err_fd()`：`tls_noise_mute` 会把 fd 2 指到 /dev/null（§16 踩坑 21/30）。
fn out_bytes(p: &const byte, n: usize) void {
    tty_stream_write(1, p, n);
}

// 同 `out_bytes`，语义上归入「错误输出」那一族（目前实现一致，分开只是为了让
// 调用点的意图可读，也便于以后给错误流单独加前缀）。
fn out_err_bytes(p: &const byte, n: usize) void {
    tty_stream_write(2, p, n);
}

// 以**十进制**打印一个 usize（不换行）。给 `[step N]`、计数这类拼装行用。
fn out_err_dec(v: usize) void {
    var tmp: [byte: 24] = [0: 24];
    var n: usize = v;
    var i: usize = 0;
    if n == 0 {
        tmp[0] = 48;
        i = 1;
    }
    while n > 0 && i < 24 {
        const d: i32 = ((n % (10 as usize)) as i32) + 48;
        tmp[i] = d as byte;
        n = n / (10 as usize);
        i = i + 1;
    }
    var rev: [byte: 24] = [0: 24];
    var k: usize = 0;
    while i > 0 {
        i = i - 1;
        rev[k] = tmp[i];
        k = k + 1;
    }
    out_err_bytes(&rev[0], k);
}

// ============================================================
// 诊断出口（**唯一**）
//
// 诊断打的是外来字节（网关错误体 / 坏 payload 头部 / 网关错误消息）：既可能夹带控制
// 字节（含 ESC），也可能正好被按**字节**截断在多字符中间。原样 out_err_bytes 打出去
// 就是屏幕上那串乱码（半个汉字 + 一屏 JSON），因为 TUI 会把 fd 2 的每一行都渲染成
// 带 `· ` 前缀的 NOTICE 行（通道 2 → tui_sink_line）。所以：
//   * 转录（fd 2）只留 DIAG_PREVIEW_MAX 字节的**转义预览** + 「… N bytes total」后缀，
//     整条只有一行（规则表见 tty.uya::tty_diag_escape_into）；
//   * 完整原文（同样转义）进会话日志 `diag/dump` —— 会话日志因此永远是合法 UTF-8；
//   * `--debug-dump <file>` 额外把**原始字节**追加落盘（要二进制现场时才开）。
// ============================================================
const DIAG_PREVIEW_MAX: usize = 320;
const DIAG_LOG_MAX: usize = 65536;

var g_diag_dump: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // --debug-dump 的落盘路径（空 = 不落盘）

// 设 `--debug-dump` 的落盘路径（**原始字节**追加：网关错误体 / 坏 payload 头部）。
// 长度由调用方给（CLI 解出来的值不一定有 NUL）；空路径 = 关闭。
export fn agent_set_debug_dump(path: &const byte, n: usize) void {
    if !buf_valid(&g_diag_dump) {
        g_diag_dump = buf_new(n + 8);
    }
    buf_reset(&g_diag_dump);
    if n > 0 {
        _ = buf_append(&g_diag_dump, path, n);
        // 每次设置路径都清掉旧文件：落盘的是「这一次」的现场（追加式写入会让
        // 上一次的字节混进来，自测里就会变成「断言被旧文件满足」的假绿）
        var z: Buf = buf_new(n + 1);
        defer { buf_free(&z); }
        if buf_append(&z, path, n) {
            _ = buf_append_byte(&z, 0);
            _ = sys_unlink(&z.ptr[0] as *const byte) catch {};
        }
    }
}

// 完整原文 → 会话日志（转义后进：日志里永远没有裸控制字节，也没有半个字符）
fn agent_diag_log(kind: &const byte, p: &const byte, n: usize, used: usize) void {
    if !g_sess.save {
        return;
    }
    var text: Buf = buf_new(n + 16);
    defer { buf_free(&text); }
    _ = tty_diag_escape_into(&text, p, n, DIAG_LOG_MAX);
    var ev: Buf = buf_new(text.len + 256);
    defer { buf_free(&ev); }
    if !sess_begin(&g_sess, "diag/dump", &ev) {
        return;
    }
    const kn: usize = bufx_cstr_len(kind);
    _ = buf_append_cstr(&ev, "{\"kind\":");
    _ = jw_str_into(&ev, kind, kn);
    _ = buf_append_cstr(&ev, ",\"bytes\":");
    _ = buf_append_i64(&ev, n as i64);
    _ = buf_append_cstr(&ev, ",\"truncated\":");
    if used < n {
        _ = buf_append_cstr(&ev, "true");
    } else {
        _ = buf_append_cstr(&ev, "false");
    }
    _ = buf_append_cstr(&ev, ",\"text\":");
    _ = jw_str_into(&ev, text.ptr as &const byte, text.len);
    _ = buf_append_cstr(&ev, "}");
    _ = sess_end(&g_sess, &ev);
}

// 原始字节 → --debug-dump 文件（默认关；开了才写）
fn agent_diag_file(kind: &const byte, p: &const byte, n: usize) void {
    if !buf_valid(&g_diag_dump) || g_diag_dump.len == 0 {
        return;
    }
    var path: Buf = buf_new(g_diag_dump.len + 1);
    defer { buf_free(&path); }
    _ = buf_append(&path, g_diag_dump.ptr, g_diag_dump.len);
    _ = buf_append_byte(&path, 0);
    const flags: i32 = (O_WRONLY | O_CREAT | O_APPEND) as i32;
    const fd: i32 = sys_open(&path.ptr[0] as *const byte, flags, 420 as u32) catch {
        return;
    };
    defer { _ = sys_close(fd) catch {}; }
    var head: Buf = buf_new(192);
    defer { buf_free(&head); }
    _ = buf_append_cstr(&head, "=== ");
    _ = buf_append(&head, kind, bufx_cstr_len(kind));
    _ = buf_append_cstr(&head, " ");
    _ = buf_append_i64(&head, n as i64);
    _ = buf_append_cstr(&head, " bytes ===\n");
    _ = write_all_fd(fd, head.ptr as &const byte, head.len);
    if n > 0 {
        _ = write_all_fd(fd, p, n);
    }
    if n == 0 || p[n - 1] != 10 as byte {
        _ = write_all_fd(fd, "\n" as &const byte, 1);
    }
}

// 诊断打印入口：一行转义预览 + 截断后缀；全文进日志（+ 可选落盘）
fn out_diag(kind: &const byte, label: &const byte, p: &const byte, n: usize) void {
    var prev: Buf = buf_new(DIAG_PREVIEW_MAX + 8);
    if !buf_valid(&prev) {
        out_err(label);
        out_err("(out of memory)\n");
        return;
    }
    defer { buf_free(&prev); }
    const used: usize = tty_diag_escape_into(&prev, p, n, DIAG_PREVIEW_MAX);
    out_err(label);
    if n == 0 {
        out_err("(0 bytes)");
    } else {
        out_err_bytes(prev.ptr as &const byte, prev.len);
        if used < n {
            out_err(" … ");
            out_err_dec(n);
            out_err(" bytes total");
        }
    }
    out_err("\n");
    agent_diag_log(kind, p, n, used);
    agent_diag_file(kind, p, n);
}

// lib/tls 会把握手过程直接写到 fd 2（https_debug/hs_debug），
// 对一个 CLI 来说太吵；这里在发请求期间把 stderr 暂时指向 /dev/null，
// 自己的诊断信息都在静音窗口之外打印。--tls-debug 可关闭静音。
//
// P16 补充：**显示层**（工具行 / 思考行）不能跟着一起静音 —— 它本来就是给用户看的，
// 而 LLM 流式期间正好是这个窗口（P14 的「✻ 思考」表头当年就是这么消失的：
// `--show-reasoning` 一直在写 fd 2，写进去的是 /dev/null）。所以这里额外记住那个
// 「还看得见的」stderr fd，显示层一律走 err_fd() 而不是字面量 2。
struct FdGuard {
    saved: i32,
    nullfd: i32,
    active: bool,
}

var g_err_fd: i32 = 2;

// 显示层该写的 fd：静音窗口内是 stderr 的原件，否则就是 2
export fn err_fd() i32 {
    return g_err_fd;
}

// **TLS 噪声静音**：`lib/tls` 把握手全过程写到 fd 2（满屏 `[HS] ...`），
// 所以发请求期间把 fd 2 重定向到 /dev/null。
// `g` 记下 `dup(2)` 的原 fd（用于还原），**副作用是显示层也被静音** ——
// 这正是显示层一律走 `err_fd()` 的原因（§16 踩坑 21/30）。
// `enabled = false`（或 `--tls-debug`）时什么都不做，一个字节都不改。
fn tls_noise_mute(g: &FdGuard, enabled: bool) void {
    g.saved = -1;
    g.nullfd = -1;
    g.active = false;
    if !enabled {
        return;
    }
    const saved: i32 = sys_dup(2) catch { -1; };
    if saved < 0 {
        return;
    }
    var devnull: [byte: 16] = "/dev/null";
    const nfd: i32 = sys_open(&devnull[0] as *const byte, O_WRONLY as i32, 0) catch {
        -1;
    };
    if nfd < 0 {
        _ = sys_close(saved) catch {};
        return;
    }
    _ = sys_dup2(nfd, 2) catch {};
    g.saved = saved;
    g.nullfd = nfd;
    g.active = true;
    g_err_fd = saved;
}

// 还原 `tls_noise_mute` 抢走的 fd 2（dup2 往返）并把 `g` 清零。
// 与 mute 严格配对（同一层 defer），不还原就会把后面所有输出都吞掉。
fn tls_noise_unmute(g: &FdGuard) void {
    if g.active {
        _ = sys_dup2(g.saved, 2) catch {};
        g.active = false;
    }
    g_err_fd = 2;                 // 必须在关闭 saved 之前换回来
    if g.nullfd >= 0 {
        _ = sys_close(g.nullfd) catch {};
        g.nullfd = -1;
    }
    if g.saved >= 0 {
        _ = sys_close(g.saved) catch {};
        g.saved = -1;
    }
}

// C 串长度（扫到 NUL 为止）。**只用于确认是 C 串的输入**（argv / env），
// 对 `Buf.ptr` 用它就是踩坑（Buf 不带尾 NUL，会读到堆尾巴 —— §16 踩坑 57/67）。
fn cstr_len(p: &byte) usize {
    return strlen(p);
}

// CLI 参数严格相等（`p` 是 C 串，`lit` 是字面量）。值**不参与**匹配 ——
// 要匹配 `--model=x` 这种形式得用别的前缀函数。
fn arg_eq(p: &byte, lit: &const byte) bool {
    const n: usize = cstr_len(p);
    const m: usize = strlen(lit);
    if n != m {
        return false;
    }
    var i: usize = 0;
    while i < n {
        if p[i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// p 是否以 lit 开头（argv 的取值形式 flag=value 用）
fn arg_starts_with(p: &byte, lit: &const byte) bool {
    const n: usize = bufx_cstr_len(lit);
    var i: usize = 0;
    while i < n {
        if p[i] == 0 as byte || p[i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// C 串 → 新 Buf（拷一份，带长度）。给「CLI/env 里取到的值要留到后面用」的场合。
// 返回的 Buf 归调用方，必须 `buf_free`。分配失败返回 `buf_empty()`。
fn buf_from_cstr(p: &byte) Buf {
    const n: usize = cstr_len(p);
    var b: Buf = buf_new(n + 8);
    if buf_valid(&b) {
        _ = buf_append(&b, p, n);
    }
    return b;
}

// 读环境变量 `name`，没有就用 `fallback` 字面量。返回新 Buf（归调用方，要 free）。
// 这是「环境变量 → 默认值」这一层的统一入口（§3.1 的第 3 步）。
fn env_or(name: &const byte, fallback: &const byte) Buf {
    const p: &byte = getenv(name);
    if (p as usize) != 0 {
        return buf_from_cstr(p);
    }
    var b: Buf = buf_new(strlen(fallback) + 8);
    if buf_valid(&b) {
        _ = buf_append_cstr(&b, fallback);
    }
    return b;
}

// 按顺序试三个环境变量名，取**第一个非空**的值；都没有返回空 Buf。
// 用在 API key 的三选一（`UYA_AGENT_API_KEY` / `DEEPSEEK_API_KEY` / `OPENAI_API_KEY`）。
fn env_first(n1: &const byte, n2: &const byte, n3: &const byte) Buf {
    var b: Buf = env_or(n1, "");
    if b.len > 0 {
        return b;
    }
    b = env_or(n2, "");
    if b.len > 0 {
        return b;
    }
    return env_or(n3, "");
}

// 与 env_or 相同，但顺带回答「这个值来自环境变量还是内置默认」，
// 好让 --print-config 的 source 列说实话（0 默认 / 2 env）。
fn env_or_src(name: &const byte, fallback: &const byte, src: &u8) Buf {
    const p: &byte = getenv(name);
    if (p as usize) != 0 {
        src[0] = 2;
        return buf_from_cstr(p);
    }
    src[0] = 0;
    var b: Buf = buf_new(strlen(fallback) + 8);
    if buf_valid(&b) {
        _ = buf_append_cstr(&b, fallback);
    }
    return b;
}

// ============================================================
// 对话历史
// ============================================================
const ROLE_SYSTEM: u8 = 0;
const ROLE_USER: u8 = 1;
const ROLE_ASSISTANT: u8 = 2;
// P2：严格工具协议用到的两种消息
//   ROLE_ASSISTANT_CALLS  assistant 消息里带 tool_calls（extra = tool_calls 数组原文）
//   ROLE_TOOL             工具结果（extra = tool_call_id）
const ROLE_ASSISTANT_CALLS: u8 = 3;
const ROLE_TOOL: u8 = 4;
// 单条消息的存储上限。超过它不是「拒绝入史」（那会让 assistant(tool_calls) 挂空），
// 而是先按 DSH 剪枝规则缩一次、仍超再头尾截断（见 hist_fit_text）。
const MSG_CONTENT_MAX: usize = 200000;
const HIST_MIN_CAP: usize = 8;
// 硬截断时的头尾预算与标记
const HIST_TRUNC_TAIL: usize = 16384;
const HIST_TRUNC_MARK: &const byte = "\n\n[... message truncated to fit history storage ...]\n\n";

// text = content 正文；extra 的含义由 role 决定（tool_calls 数组原文 / tool_call_id）。
// kind 只对 ROLE_TOOL 有意义：产它的工具种类（CMP_KIND_BASH / CMP_KIND_TOOL），
// 构请求时据此选剪枝规则 —— 历史本身不动，剪枝仍然只发生在构请求这一层。
// assistant 展开成「assistant + N 条 tool」消息对，这是 OpenAI 严格协议的要求，
// 也是 DSH 的做法（DSH 会把 assistant 消息连同 tool_calls 原样回灌）。
struct Msg {
    role: u8,
    kind: u8,
    text: &byte,
    text_len: usize,
    extra: &byte,
    extra_len: usize,
}

// 对话历史：**默认不限条数**（DSH 的历史同样没有条数上限，靠 token 压力压缩来收敛），
// 所以这里是按需翻倍增长的堆数组，不再是固定 [Msg: 64]。
// 注意：增长用 realloc，可能整块搬家 —— 任何 &Msg 都不能跨 hist_push*/hist_reserve 使用。
struct History {
    items: &Msg,
    len: usize,
    cap: usize,
    bytes: usize,
}

// 零值 Msg（role 0、kind 取 CMP_KIND_TOOL、两个指针 null、长度 0）。
// 固定数组/结构体的初始化式必须是常量，所以全局只能靠它填。
// 注意 `Msg` 用的是**裸指针 + 长度**而不是 Buf（见 §3.6）。
fn msg_zero() Msg {
    return Msg{ role: 0, kind: CMP_KIND_TOOL, text: null, text_len: 0, extra: null, extra_len: 0 };
}

// 空历史（items=null、len/cap/bytes 全 0），随后按需翻倍增长。
// **不限条数**（对齐 DSH）：条数由上下文压力管，不由历史管（§3.6）。
fn hist_init() History {
    return History{ items: null, len: 0, cap: 0, bytes: 0 };
}

// 保证还能再放 extra 条消息（容量翻倍；realloc(null, n) 即首次分配）
fn hist_reserve(h: &History, extra: usize) bool {
    if h.cap >= h.len + extra {
        return true;
    }
    var ncap: usize = h.cap * 2;
    if ncap < HIST_MIN_CAP {
        ncap = HIST_MIN_CAP;
    }
    if ncap < h.len + extra {
        ncap = h.len + extra;
    }
    const esz: usize = @size_of(Msg) as usize;
    const raw: &void = realloc(h.items as &void, ncap * esz);
    if ((raw as &byte) as usize) == 0 {
        return false;
    }
    h.items = raw as &Msg;
    h.cap = ncap;
    return true;
}

// 释放历史里每一条的 text / extra 与 items 本身。幂等。
fn hist_free(h: &History) void {
    var i: usize = 0;
    while i < h.len {
        const m: &Msg = msg_at_mut(h, i);
        if (m.text as usize) != 0 {
            free(m.text as &void);
        }
        if (m.extra as usize) != 0 {
            free(m.extra as &void);
        }
        m[0] = msg_zero();
        i = i + 1;
    }
    if (h.items as usize) != 0 {
        free(h.items as &void);
    }
    h.items = null;
    h.len = 0;
    h.cap = 0;
    h.bytes = 0;
}

// 复制一段字节到堆上（补 NUL，便于调试时当 C 字符串看）
fn hist_dup(p: &const byte, n: usize) &byte {
    const raw: &void = malloc(n + 1);
    if ((raw as &byte) as usize) == 0 {
        return null;
    }
    const q: &byte = raw as &byte;
    if n > 0 {
        _ = mem_copy(q, p, n);
    }
    const q_end: &byte = @ptr_from_usize(@usize_from_ptr(q as &void) + n) as &byte;
    _ = mem_set(q_end, 0, 1);
    return q;
}

// 某条消息因为超 `MSG_CONTENT_MAX` 被裁剪时落一行诊断（before → after 字节数）。
// 裁剪是**静默**发生的（模型不会被告知），所以至少让它进会话日志/转录可查。
fn hist_fit_note(before: usize, after: usize) void {
    out_err("[history] 单条消息过长（");
    out_err_dec(before);
    out_err(" 字节），已缩到 ");
    out_err_dec(after);
    out_err(" 字节存入历史（会话日志里仍是全文）\n");
}

// 单条消息「装得下」：<= MSG_CONTENT_MAX 时返回 false（原样入史）；
// 超上限时把处理后的文本写进 out 并返回 true：
//   1) 先按 DSH 的剪枝规则缩一次（头 4096 + 标记 + 尾 1024 码点）；
//   2) 仍超上限（旋钮被调大、或极端字节分布）就按 UTF-8 边界做「头 + 标记 + 尾」硬截断。
// 保证返回 true 时 out.len <= MSG_CONTENT_MAX —— 于是「单条太大」永远不会变成入史失败。
fn hist_fit_text(text: &const byte, n: usize, out: &Buf) bool {
    if n <= MSG_CONTENT_MAX {
        return false;
    }
    var pruned: Buf = buf_empty();
    defer { buf_free(&pruned); }
    if cmp_maybe_prune(text, n, &pruned) && pruned.len > 0 && pruned.len <= MSG_CONTENT_MAX {
        if !buf_append(out, pruned.ptr, pruned.len) {
            return false;
        }
        hist_fit_note(n, out.len);
        return true;
    }
    const mark_len: usize = bufx_cstr_len(HIST_TRUNC_MARK);
    var tail_budget: usize = HIST_TRUNC_TAIL;
    var head_budget: usize = MSG_CONTENT_MAX - mark_len - tail_budget;
    if head_budget >= n {
        head_budget = n / 2;
        tail_budget = n - head_budget;
    }
    // 头：退到字符起始字节；尾：进到字符起始字节（避免把汉字砍成半个）
    var head_bytes: usize = head_budget;
    while head_bytes > 0 && (text[head_bytes] & 192 as byte) == 128 as byte {
        head_bytes = head_bytes - 1;
    }
    var tail_start: usize = n - tail_budget;
    while tail_start < n && (text[tail_start] & 192 as byte) == 128 as byte {
        tail_start = tail_start + 1;
    }
    if tail_start < head_bytes {
        tail_start = head_bytes;
    }
    buf_reset(out);
    if !buf_append(out, text, head_bytes) {
        return false;
    }
    if !buf_append_cstr(out, HIST_TRUNC_MARK) {
        return false;
    }
    const tail_ptr: &const byte = @ptr_from_usize(@usize_from_ptr(text as &const void) + tail_start) as &const byte;
    if !buf_append(out, tail_ptr, n - tail_start) {
        return false;
    }
    hist_fit_note(n, out.len);
    return true;
}

// 追加一条消息；text/extra 允许为空（n == 0 时存 null）。
// 默认不限条数：只有真 OOM（realloc/malloc 失败）才返回 false。调用方必须保证
// 「assistant(tool_calls) 与它的 tool 结果」不会因此变成半截（见 agent_finish_step 的回滚）。
fn hist_push_msg(h: &History, role: u8, text: &const byte, text_len: usize, extra: &const byte, extra_len: usize) bool {
    return hist_push_msg_kind(h, role, CMP_KIND_TOOL, text, text_len, extra, extra_len);
}

// 工具结果入史：带上产它的工具种类（构请求时选剪枝规则用）
fn hist_push_tool_kind(h: &History, kind: u8, text: &const byte, text_len: usize, extra: &const byte, extra_len: usize) bool {
    return hist_push_msg_kind(h, ROLE_TOOL, kind, text, text_len, extra, extra_len);
}

// 往历史尾部压一条消息（`role` / `kind` / 正文 / `extra` 各拷一份）。
// **会 realloc 搬家** ⇒ 调用之后任何 `&Msg` 都失效（§3.6 的头号不变量）。
// 单条超 `MSG_CONTENT_MAX` 时先按 DSH 剪枝缩、再头尾截断（`hist_fit_note` 落诊断）。
fn hist_push_msg_kind(h: &History, role: u8, kind: u8, text: &const byte, text_len: usize, extra: &const byte, extra_len: usize) bool {
    // extra 不做裁剪：它是 tool_calls 数组原文 / tool_call_id，截断后就是非法 JSON
    // （比「失败 + 回滚」更糟），所以这里仍然按上限拒绝。
    if extra_len > MSG_CONTENT_MAX {
        return false;
    }
    var fitted: Buf = buf_empty();
    defer { buf_free(&fitted); }
    var src: &const byte = text;
    var n: usize = text_len;
    if hist_fit_text(text, text_len, &fitted) {
        src = fitted.ptr as &const byte;
        n = fitted.len;
    }
    if !hist_reserve(h, 1) {
        return false;
    }
    const idx: usize = h.len;
    var t: &byte = null;
    if n > 0 {
        t = hist_dup(src, n);
        if (t as usize) == 0 {
            return false;
        }
    }
    var e: &byte = null;
    if extra_len > 0 {
        e = hist_dup(extra, extra_len);
        if (e as usize) == 0 {
            if (t as usize) != 0 {
                free(t as &void);
            }
            return false;
        }
    }
    const slot: &Msg = msg_at_mut(h, idx);
    slot.role = role;
    slot.kind = kind;
    slot.text = t;
    slot.text_len = n;
    slot.extra = e;
    slot.extra_len = extra_len;
    h.len = idx + 1;
    h.bytes = h.bytes + n + extra_len;
    return true;
}

// 老签名（纯文本消息）
fn hist_push(h: &History, role: u8, p: &const byte, n: usize) bool {
    if n == 0 {
        return false;
    }
    return hist_push_msg(h, role, p, n, null, 0);
}

// 释放一条消息的两块堆内存（text / extra）并清零长度。
// 拆出来是为了让 `hist_drop_oldest` 与 `hist_free` 走同一条释放口径。
fn msg_free_one(m: &Msg) void {
    if (m.text as usize) != 0 {
        free(m.text as &void);
    }
    if (m.extra as usize) != 0 {
        free(m.extra as &void);
    }
    m.text = null;
    m.extra = null;
    m.text_len = 0;
    m.extra_len = 0;
}

// 截断到 idx 条（释放后面的消息）。用于「本步这一组写不进去就整组回滚」——
// 保证历史里永远不会留下「assistant(tool_calls) 后面缺 tool 应答」的半截状态。
export fn hist_truncate_to(h: &History, idx: usize) void {
    if idx >= h.len {
        return;
    }
    var i: usize = idx;
    while i < h.len {
        const m: &Msg = msg_at_mut(h, i);
        h.bytes = h.bytes - (m.text_len + m.extra_len);
        msg_free_one(m);
        i = i + 1;
    }
    h.len = idx;
}

// 丢掉最老的一条（或一整组）非 system 消息，但**只在下标 < floor 的区域里丢**。
// floor 用来保护「本步刚压入的 assistant(tool_calls) 及其 tool 结果」：
// 未保护的丢法会把当前这一组自己丢掉，剩下一串孤儿 tool 结果，端点照样 400。
//
// **不能拆散 assistant(tool_calls) 与它的 tool 结果**：丢掉带 tool_calls 的
// assistant 时，紧随其后的 tool 消息必须一起丢，否则请求里会出现「悬空结果」，
// 端点会直接 400。保留段同样不允许以 tool 消息开头。
//
// 下标 1 是 user（本会话的任务原文）时从下标 2 开始丢：默认不限条数/不限步数之后，
// 一次长跑会反复走到这条兜底路径，而把任务原文丢掉就等于 agent 跑到一半忘了自己要干什么
// （system 与任务原文都留下）。这也是「不限步数」那个改动里的同一条保护。
fn hist_drop_oldest_below(h: &History, floor: usize) bool {
    var s: usize = 1;
    if h.len > 2 && msg_at(h, 1).role == ROLE_USER {
        s = 2;
    }
    if floor <= s || h.len <= s + 1 {
        return false;
    }
    var end: usize = s;
    if msg_at(h, s).role == ROLE_ASSISTANT_CALLS {
        while end + 1 < h.len && end + 1 < floor && msg_at(h, end + 1).role == ROLE_TOOL {
            end = end + 1;
        }
    }
    if end >= floor {
        return false;   // 这一组会伸进受保护区域：宁可不丢
    }
    var k: usize = s;
    while k <= end {
        const mk: &Msg = msg_at_mut(h, k);
        h.bytes = h.bytes - (mk.text_len + mk.extra_len);
        msg_free_one(mk);
        k = k + 1;
    }
    const removed: usize = end - s + 1;   // 移除下标 s..=end
    var i: usize = s;
    while i + removed < h.len {
        const dm: &Msg = msg_at_mut(h, i);
        const sm: &Msg = msg_at_mut(h, i + removed);
        dm[0] = sm[0];
        i = i + 1;
    }
    h.len = h.len - removed;
    // 兜底：保留段之后不允许以 tool 消息开头
    while h.len > s && msg_at(h, s).role == ROLE_TOOL {
        const ms: &Msg = msg_at_mut(h, s);
        h.bytes = h.bytes - (ms.text_len + ms.extra_len);
        msg_free_one(ms);
        var j: usize = s;
        while j + 1 < h.len {
            const dm2: &Msg = msg_at_mut(h, j);
            const sm2: &Msg = msg_at_mut(h, j + 1);
            dm2[0] = sm2[0];
            j = j + 1;
        }
        h.len = h.len - 1;
    }
    return true;
}

// 丢掉**最老**的那条消息并把后面的整体前移（用于压缩/裁剪后腾空间）。
// 历史为空返回 false。注意这会 `memmove` 整块 —— 之前取到的 `&Msg` 一律失效。
fn hist_drop_oldest(h: &History) bool {
    return hist_drop_oldest_below(h, h.len);
}

// 固定数组的安全取址：把「下标证明」换成指针运算（编译器对复合条件的证明很挑）
// 历史是堆数组（不再是固定 [Msg: N]），取址就是普通指针运算；
// 下标边界由调用方保证（h.len 之内），这里保留这两个辅助是为了调用点写法统一。
export fn msg_at(h: &const History, i: usize) &const Msg {
    const base: &const Msg = h.items;
    const esz: usize = @size_of(Msg) as usize;
    return @ptr_from_usize(@usize_from_ptr(base as &const void) + i * esz) as &const Msg;
}

// 取第 i 条消息的**可写**指针（越界返回 null）。
// 返回的指针指向堆数组内部：**不许跨任何 `hist_push*` / `hist_reserve` / `hist_drop_*` 留存**。
export fn msg_at_mut(h: &History, i: usize) &Msg {
    const base: &Msg = h.items;
    const esz: usize = @size_of(Msg) as usize;
    return @ptr_from_usize(@usize_from_ptr(base as &void) + i * esz) as &Msg;
}

// role 码 → OpenAI 协议的字符串（`system` / `user` / `assistant` / `tool`）。
// 认不出的码当 `user`（防御：宁可发一条 user 也不要发一个协议里不存在的 role）。
fn role_cstr(role: u8) &byte {
    if role == ROLE_SYSTEM {
        return "system" as &byte;
    }
    if role == ROLE_ASSISTANT || role == ROLE_ASSISTANT_CALLS {
        return "assistant" as &byte;
    }
    if role == ROLE_TOOL {
        return "tool" as &byte;
    }
    return "user" as &byte;
}

// ============================================================
// P4：会话日志
//
// 事件词表（data 载荷刻意做成无歧义键，恢复时不必猜）：
//   user/message      {"role":"user","content":[{"type":"text","text":…}],"source":{…}}
//   assistant/message {"turn":N,"step":N,"message":{"role":"assistant","content":…,"tool_calls":[…]?},"usage":{…}}
//   assistant/first-token {"turn":N,"step":N}
//   tool/call         {"turn":N,"step":N,"callId":…,"name":…,"arguments":…}
//   tool/result       {"turn":N,"step":N,"callId":…,"content":…}
//   turn/start|end    {"turn":N}[,"reason":…]
//   step/start|end    {"turn":N,"step":N}
//   session/title     {"title":…,"source":{"kind":"fallback"}}
//
// P18 起这张表同时是**统计折叠**的输入（stats.uya），于是多出三条硬约束：
//   * step/start 与 step/end 必须成对写（DSH 是 finally 语义：进过的步都计数，
//     失败/取消/max-tokens 的步也算）—— 给回合循环加退出分支时别忘了补 step/end；
//   * `assistant/first-token` 是首个非空正文 delta 的那一刻。事件是流结束后才补写的，
//     所以时间必须用 sess_begin_at 钉成那一刻，不能用写盘时的 ua_now_ms()；
//   * tool/call 在**工具真正开始前**写、tool/result 在其后写：两者的 time 差就是
//     toolMs（早期实现是执行完再背靠背写两条，时间差恒为 0，统计会永远显示 0s）。
// ============================================================
var g_sess: SessionLog = SessionLog{
    id: Buf{ ptr: null, len: 0, cap: 0 },
    path: Buf{ ptr: null, len: 0, cap: 0 },
    cwd: Buf{ ptr: null, len: 0, cap: 0 },
    model: Buf{ ptr: null, len: 0, cap: 0 },
    fd: -1,
    seq: 0,
    events: 0,
    save: false,
    title: Buf{ ptr: null, len: 0, cap: 0 },
    turns: 0,
};
var g_home: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_turn: i32 = 0;
var g_tools_scratch: Buf = Buf{ ptr: null, len: 0, cap: 0 };
// 压力估算的剪枝 scratch：只在 agent_ctx_est 里用（步边界），与 g_tools_scratch 不混用
var g_ctx_scratch: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_jobs: JobTable = JobTable{ items: [], next_id: 1 };
// P9：最近一次请求的 prompt_tokens（压力口径）与压缩开关
var g_last_prompt_tokens: i64 = 0;
// P18：上下文占用的增量基准（DSH 的 projectedTokens 锚点）。-1 = 还没有锚点。
var g_ctx_est_at_sample: i64 = -1;
// P11：最后一个「有内容的助手消息」正文（子代理用它回报结果）
var g_last_answer: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_compact_enabled: bool = true;
// preset 的 bash 超时旋钮（只在用户没改过默认值时生效）
var g_bash_timeout_knob: u32 = 0;

// 当前生效的 bash 默认超时（毫秒）。工具层读它当 `timeoutMs` 的缺省值。
export fn agent_bash_timeout_knob() u32 {
    return g_bash_timeout_knob;
}
// P10：技能表（首次请求前扫描一次）
var g_skills: SkillSet = SkillSet{ items: [], n: 0, scanned: false };
// P11：子代理表
var g_deleg: DelegTable = DelegTable{ items: [], next_id: 1 };
// P42：/watch 的跟随状态（进程内一份；不落盘 —— 它是「我现在想看谁」，不是会话状态）
var g_watch: Watch = Watch{
    active: false, slot: 0, id: 0,
    path: Buf{ ptr: null, len: 0, cap: 0 },
    off: 0,
    partial: Buf{ ptr: null, len: 0, cap: 0 },
    rendered: Buf{ ptr: null, len: 0, cap: 0 },
    polled_ms: 0, ended: false,
};

// 设 agent home（会话/索引/附件/goal 的根）。返回值 = 是否设置成功。
// 必须在 `agent_session_open` 之前调 —— 会话路径是按它算出来的。
export fn agent_set_home(home: &const byte) bool {
    buf_free(&g_home);
    g_home = buf_new(bufx_cstr_len(home) + 8);
    // 这个缓冲后面要当 C 字符串用（sess_close 会把它传给索引写入），必须补 NUL
    return buf_append_cstr_z(&g_home, home);
}

// 当前 agent home（默认 `~/.uya-agent`）。**返回内部全局的切片**，调用方不许留存。
export fn agent_home() &[byte] {
    return g_home.ptr[0: g_home.len];
}

// 默认 agent home：--agent-home > $UYA_AGENT_HOME > $HOME/.uya-agent
fn agent_default_home(cfg: &const Config, out: &Buf) bool {
    buf_reset(out);
    if cfg.agent_home.len > 0 {
        return buf_append(out, cfg.agent_home.ptr, cfg.agent_home.len);
    }
    const env: &byte = getenv("UYA_AGENT_HOME");
    if (env as usize) != 0 {
        return buf_append_cstr(out, env);
    }
    const home: &byte = getenv("HOME");
    if (home as usize) == 0 {
        return false;
    }
    if !buf_append_cstr(out, home) {
        return false;
    }
    return buf_append_cstr(out, "/.uya-agent");
}

// ============================================================
// P22：终端标题（TTY title）
//
// 「当前会话的标题」只有一份：`g_sess.title`。它的写入点 —— 首条用户消息的兜底派生、
// 会话日志里的 `session/title` 事件（--continue / --resume / /resume）、--resume-dsh
// 导入的 DSH 标题、P46 的人手 `/title` / 模型 `set_title`、P46 的自动起标题 —— 全都汇到
// `agent_title_apply()`：有标题就上标题，没有就上 `uya-agent · <工作目录名>`。
// 清洗与 OSC 2 编码在 src/tty.uya（唯一实现）；这里只管「标题是什么」与「什么时候同步」。
// 只有交互模式（TUI / 滚动 REPL）才打开过标题通道，非交互路径 `tty_title_set` 是空操作。
//
// P46：标题**在执行过程中就能改**，四件事：
//   1) 人敲 `/title <新标题>` / `/title clear`（TUI 里裸 `/title` 先让模型起一个建议、
//      填进输入框再让人改）；
//   2) 模型自己调 `set_title` 工具；
//   3) 自动起标题：每个新的人类消息之后（回合收口时）跑一次侧路请求，
//      把 `session/title` 与索引换成模型给的标题（kind = provider）；
//   4) `clear` 退回基标题并解锁自动起标题。
//
// kind 三档沿用 DSH：`fallback`（前 5 词兜底）/ `provider`（模型生成）/ `user`（人写、模型写、
// 导入 —— **显式钉住**：钉住之后自动起标题不再动手，与 DSH 的 rename 同语义）。
// 标题会不会被改写，只看**最后一条** `session/title` 事件的 kind 是不是 user；
// 这个状态跟着日志（g_title_pinned），所以 --resume 之后仍然钉住。
//
// ⚠ 自动起标题是**同步**的侧路请求（单线程，踩坑 47：不能起第二条线程并发 malloc），
// 所以它排在回合收口之后、回到输入态之前 —— 一次人类消息最多一个额外小请求，
// `--no-title-auto` / UYA_AGENT_TITLE_AUTO=0 可关。
// ============================================================

var g_title_base: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_title_base_ready: bool = false;
var g_title_pinned: bool = false;        // 最后一条 title 事件是不是 user（显式钉住）
var g_title_human_msgs: usize = 0;       // 本会话收到的人类消息条数（自动起标题的 revision）
var g_title_auto_rev: usize = 0;         // 上一次自动起标题时的人类消息条数（revision 门控）
var g_title_auto_done: bool = false;     // 本会话已经成功自动起过标题（供 /status 观测）
var g_title_auto_pending: bool = false;  // 回合收尾挂下的待办（空闲主循环里消费）
// P46：当前在飞的是「后台请求」（自动起标题）。泵点据此**不读键盘/不派发命令** ——
// 用户不知道它在飞，它就没有资格取走用户那几秒里敲的任何字节（见 agent_pump_block）。
var g_bg_request: bool = false;

// llm.uya 的流式循环用：后台请求别读键盘（见 agent_pump_block 的注释）
export fn agent_bg_request() bool {
    return g_bg_request;
}

// 后台请求的「让路」判据：终端缓冲里已经有待读的按键吗？（只看一眼，不消费）
// TUI 走 tui 侧那一份；滚动模式（--no-tui）的键盘在 fd 0 上，直接 poll 一眼。
// 非交互（管道/子代理）恒 false —— 那种场合根本没有「用户要说话」这回事。
export fn agent_bg_input_pending() bool {
    if tui_active() {
        return tui_input_pending();
    }
    if !tty_is_interactive() {
        return false;
    }
    var pfd: [PollFd: 1] = [PollFd{ fd: 0, events: POLLIN, revents: 0 }];
    const pr: i32 = sys_poll(&pfd[0], 1, 0) catch { 0; };
    return pr > 0 && (pfd[0].revents & POLLIN) != 0;
}
// P46：自动起标题要等**两段静默**都满足才发：
//   * 距「回合收尾挂上待办」已经过了 QUIET（arm 窗口）；
//   * 距「用户最后一次敲键」也过了 QUIET（键盘窗口）。
//
// 为什么必须两段：这是个**同步**请求（单线程，踩坑 47 起不了第二条线程），一发出去就是
// 几百毫秒到几秒。只看键盘窗口不行 —— 回合本身可能就跑了十几秒，回合一结束「键盘早就静了」，
// 于是它抢在用户下一条命令之前发出去，用户看到的就是「敲完没反应」
// （p30-check 的 status-during-compact 实测：/compact 与紧随的 /status 都被推迟 844ms）。
// arm 窗口给用户一个「回合刚结束、我马上要接着敲」的机会：这段里只要他一动键盘，
// 待办就继续往后等 —— 标题只在他真正闲下来时才更新。
// 键盘时刻由 tui 侧唯一的键盘入口记（tui_last_key_ms）。
const TITLE_AUTO_QUIET_MS: u64 = 900;
var g_title_auto_arm_ms: u64 = 0;

// 压掉尾部 '/' 之后取最后一段（工作目录名）
fn agent_path_basename_into(out: &Buf, p: &const byte, n: usize) usize {
    buf_reset(out);
    var end: usize = n;
    while end > 0 && p[end - 1] == 47 as byte {
        end = end - 1;
    }
    var start: usize = end;
    while start > 0 && p[start - 1] != 47 as byte {
        start = start - 1;
    }
    _ = buf_append(out, p + start, end - start);
    return out.len;
}

// 还没有标题时的基标题：`uya-agent · <工作目录名>`（目录名取不到就只留 uya-agent）
fn agent_title_base_into(out: &Buf, ws: &const byte, n: usize) void {
    buf_reset(out);
    _ = buf_append_cstr(out, "uya-agent");
    var base: Buf = buf_new(280);
    defer { buf_free(&base); }
    if agent_path_basename_into(&base, ws, n) > 0 {
        _ = buf_append_cstr(out, " · ");
        _ = buf_append(out, base.ptr as &const byte, base.len);
    }
}

// 用**首条用户消息**算初始标题（前 5 词 / ≤40 B，对齐 DSH preset），
// 并记住「用户没手动改过」这件事（手改之后不再被自动值覆盖）。
fn agent_title_base_set(cfg: &const Config) void {
    if !buf_valid(&g_title_base) {
        g_title_base = buf_new(320);
    }
    agent_title_base_into(&g_title_base, cfg.workspace.ptr as &const byte, cfg.workspace.len);
    g_title_base_ready = true;
}

// 把「当前会话标题」同步到终端（标题通道没开 / 清洗后为空时，tty 层自己会跳过）
fn agent_title_apply() void {
    if g_sess.title.len > 0 {
        tty_title_set(g_sess.title.ptr as &const byte, g_sess.title.len);
        return;
    }
    if g_title_base_ready {
        tty_title_set(g_title_base.ptr as &const byte, g_title_base.len);
        return;
    }
    tty_title_set("uya-agent" as &const byte, 10);
}

// 首条用户消息 → 兜底标题（对齐 DSH：前 5 个词、≤40 B、清洗 + 空白折叠、按码点边界截断）。
// 清洗后为空就**不**落标题，留给后面真正有内容的输入（DSH 的空输入等后来者）。
// 只写内存里的 `g_sess.title`（`--no-save` 时同样要派生：终端标题不依赖落盘）；
// 落 `session/title` 事件由调用方按 `g_sess.save` 决定，且**必须排在 user/message 之后**
// （DSH 的事件顺序就是这样：title 事件引用它据以生成的 message seq）。
// 返回 true = 这次真的派生了标题。
fn agent_title_derive(text: &const byte, n: usize) bool {
    if g_sess.title.len > 0 || n == 0 {
        return false;
    }
    var t: Buf = buf_new(TTY_TITLE_FALLBACK_BYTES + 16);
    defer { buf_free(&t); }
    _ = tty_title_fallback_into(&t, text, n, TTY_TITLE_FALLBACK_WORDS, TTY_TITLE_FALLBACK_BYTES);
    if t.len == 0 {
        return false;
    }
    buf_reset(&g_sess.title);
    _ = buf_append(&g_sess.title, t.ptr as &const byte, t.len);
    return true;
}

// 落一条标题事件（DSH 也有 session/title）
fn agent_title_log_event() void {
    var tev: Buf = buf_new(256);
    defer { buf_free(&tev); }
    if sess_begin(&g_sess, "session/title", &tev) {
        _ = buf_append_cstr(&tev, "{\"title\":");
        _ = jw_str_into(&tev, g_sess.title.ptr as &const byte, g_sess.title.len);
        _ = buf_append_cstr(&tev, ",\"source\":{\"kind\":\"fallback\"}}");
        _ = sess_end(&g_sess, &tev);
    }
}

// P46：把「当前标题」重新写进 `/sessions` 用的索引（标题列读的就是它）。
// 与 agent_workspace_log / agent_model_log 同一套分工：改会话级字段就顺手追一条索引。
fn agent_title_write_index(cfg: &const Config) void {
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        return;
    }
    var hz: Buf = buf_new(home.len + 1);
    defer { buf_free(&hz); }
    _ = buf_append(&hz, home.ptr, home.len);
    _ = buf_append_byte(&hz, 0);
    _ = sess_write_index(hz.ptr as &const byte, &g_sess);
}

// P46：落一条**带 kind** 的 title 事件（DSH 的三档：fallback / provider / user）。
// 空标题也要落（clear 用）：不落的话 `--resume` 折叠到最后一条旧事件会把标题复活，
// 索引与日志就不一致了（自测 title-cmd 钉住这条）。
fn agent_title_log_kind(kind: &const byte, t: &const byte, n: usize) void {
    if !g_sess.save {
        return;
    }
    var tev: Buf = buf_new(n + 192);
    defer { buf_free(&tev); }
    if sess_begin(&g_sess, "session/title", &tev) {
        _ = buf_append_cstr(&tev, "{\"title\":");
        _ = jw_str_into(&tev, t, n);
        _ = buf_append_cstr(&tev, ",\"source\":{\"kind\":\"");
        _ = buf_append(&tev, kind, bufx_cstr_len(kind));
        _ = buf_append_cstr(&tev, "\"}}");
        _ = sess_end(&g_sess, &tev);
    }
}

// P46：显式设置会话标题（人手 `/title <t>` 与模型 `set_title` 共用这一处）。
//
// `pin` = 是否钉住（人写与模型写都钉住；自动起标题不钉）。
// 只写内存 + 一条日志事件 + 索引 + OSC 2，**不动历史** —— 所以回合运行中当场派发是安全的
// （与 /mouse 同一条口径，见 agent_tui_cmd_safe）。
//
// 返回 0 = 成功；1 = 清洗后为空（调用方给话术，标题一个字节都不动）。
export const TITLE_SET_OK: i32 = 0;
export const TITLE_SET_EMPTY: i32 = 1;

// 设标题并标明**来源**（人类 / 模型自动 / 显式命令）。来源决定后续能不能被自动值覆盖：
// 人类改过的标题，自动起标题不再动它。
fn agent_title_set_kind(
    cfg: &const Config,
    text: &const byte,
    n: usize,
    kind: &const byte,
    pin: bool
) i32 {
    var clean: Buf = buf_new(TTY_TITLE_MAX_BYTES + 16);
    defer { buf_free(&clean); }
    _ = tty_title_clean_into(&clean, text, n, TTY_TITLE_MAX_BYTES);
    // 空标题：显式给的那一条不许静默成功（DSH 的 rename 也是抛 title-invalid），
    // 但 clear 那条路（下面）要能落空标题 —— 所以判空放在调用方。
    if pin && clean.len == 0 {
        return TITLE_SET_EMPTY;
    }
    buf_reset(&g_sess.title);
    _ = buf_append(&g_sess.title, clean.ptr as &const byte, clean.len);
    g_title_pinned = pin;
    agent_title_log_kind(kind, clean.ptr as &const byte, clean.len);
    agent_title_write_index(cfg);
    agent_title_apply();
    return TITLE_SET_OK;
}

// P46：人手 / 模型显式改名（kind = user，钉住）
fn agent_title_set_user(cfg: &const Config, text: &const byte, n: usize) i32 {
    return agent_title_set_kind(cfg, text, n, "user" as &const byte, true);
}

// P46：/title clear —— 退回基标题 + 解锁自动起标题。
// 落一条**空标题**的 user 事件（见 agent_title_log_kind 的注释），索引跟着写成空。
// DSH 的 rename 明确不做删除，这一档是本项目加的。
fn agent_title_clear(cfg: &const Config) void {
    buf_reset(&g_sess.title);
    g_title_pinned = false;
    agent_title_log_kind("user" as &const byte, "" as &const byte, 0);
    agent_title_write_index(cfg);
    agent_title_apply();
}

// --resume-dsh：把 DSH 会话的标题接过来当本会话的标题。
// 事件里的 source.kind 记 `user`：DSH 的三种 kind（fallback / provider / user）中，
// 「显式给定、且钉住不再自动改写」的那一种就是 user —— 这条标题来自用户显式导入的会话，
// 不是我们自动推导的，也不该被后面第一条消息改写（`agent_title_derive` 只在标题为空时动手）。
fn agent_title_adopt_imported(cfg: &const Config, t: &const Buf) void {
    if t.len == 0 {
        return;
    }
    var clean: Buf = buf_new(TTY_TITLE_MAX_BYTES + 16);
    defer { buf_free(&clean); }
    _ = tty_title_clean_into(&clean, t.ptr as &const byte, t.len, TTY_TITLE_MAX_BYTES);
    if clean.len == 0 {
        return;
    }
    buf_reset(&g_sess.title);
    _ = buf_append(&g_sess.title, clean.ptr as &const byte, clean.len);
    g_title_pinned = true;
    agent_title_log_kind("user" as &const byte, clean.ptr as &const byte, clean.len);
    agent_title_write_index(cfg);
    agent_title_apply();
}

// ============================================================
// P46：自动起标题（对齐 DSH 的 provider 一路）
//
// 侧路请求，与 agent_maybe_compact 同一套骨架：复制历史 + 追加提示词 → 走生效协议
// （未声明时同样允许一次协商回退）→ 结果**只**用来改标题，不进主历史、不进统计、不进转录。
//
// 三条纪律：
//   * `print_content=false / print_reasoning=false`：起标题的请求不许在正文里吐字；
//   * `interactive=g_interactive`：esc/ctrl+c 能中断它（中断 = 不改标题，不是错误）；
//   * 失败一律静默（返回 false），由调用方决定给不给话术 —— 标题是 UI 特性，
//     起标题失败绝不能让回合失败或让人以为出错了。
// ============================================================

// 起标题的提示词：只输出一行标题。口径对齐 DSH 的 fallback（≤40 B）+ maxTitleBytes（80 B）：
// 让模型给短的，最后仍由 tty_title_clean_into 收口（前 80 B、码点边界）。
fn agent_title_prompt_into(out: &Buf) bool {
    buf_reset(out);
    const head: &const byte = "Write a session title for the conversation above.\n\n";
    if !buf_append_cstr(out, head) {
        return false;
    }
    if !buf_append_cstr(out, "Rules:\n") {
        return false;
    }
    if !buf_append_cstr(out, "- Reply with the title ONLY: one single line, no quotes, no markdown, no trailing punctuation.\n") {
        return false;
    }
    if !buf_append_cstr(out, "- Write it in the same language as the user's most recent message.\n") {
        return false;
    }
    if !buf_append_cstr(out, "- Name the concrete task or topic (files, subsystems, error strings) rather than the general area.\n") {
        return false;
    }
    if !buf_append_cstr(out, "- Keep it within 40 characters (at most 5 words).\n") {
        return false;
    }
    return buf_append_cstr(out, "- No preamble, no explanation, call no tool.");
}

// 让模型给一个候选标题（成功 = 建议值写进 out，返回 true）。
//
// `serve_input` = 这次请求要不要在流式期间服务键盘（esc 中断、运行中的只读命令）。
//   * 裸 /title（前台）：true —— 用户可能想 esc 掉它，与别的请求同一条口径；
//   * 自动起标题（后台）：调用方传 g_interactive（真机上就是 true），但 `g_bg_request`
//     会让泵点退化成「只刷帧」，所以它仍然一个键都不读（见 agent_pump_block）。
//     为什么不干脆传 false：false 会让流式循环完全不泵，界面在那几秒里是冻的 ——
//     而这是个用户没发起的请求，冻住界面比「读键串味」更糟。
//     `agent_bg_input_pending()` 是它的让路机制：一发现终端缓冲里有待读字节就中止自己。
fn agent_title_generate(
    cfg: &const Config,
    h: &const History,
    out: &Buf,
    serve_input: bool
) bool {
    buf_reset(out);
    if cfg.api_key.len == 0 || h.len == 0 {
        return false;
    }
    // 历史副本 + 提示词（DSH 也是把提示词作为最后一条 user 消息，不动真历史）
    var tmp: History = hist_init();
    defer { hist_free(&tmp); }
    var i: usize = 0;
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        _ = hist_push_msg_kind(&tmp, m.role, m.kind, m.text as &const byte, m.text_len, m.extra as &const byte, m.extra_len);
        i = i + 1;
    }
    var prompt: Buf = buf_new(2048);
    defer { buf_free(&prompt); }
    if !agent_title_prompt_into(&prompt) {
        return false;
    }
    if !hist_push(&tmp, ROLE_USER, prompt.ptr as &const byte, prompt.len) {
        return false;
    }
    var req: Buf = buf_new(request_bytes_needed(&tmp, cfg));
    defer { buf_free(&req); }
    var url: Buf = buf_new(cfg.base_url.len + 24);
    defer { buf_free(&url); }
    var hdrs: Buf = buf_new(512);
    defer { buf_free(&hdrs); }
    if !build_headers(cfg, &hdrs) {
        return false;
    }
    var o: ChatOut = chat_out_new();
    defer { chat_out_free(&o); }
    var tc: TlsConn = tls_conn_empty();

    var status: i32 = 0;
    var tried: i32 = 0;
    var interrupted: bool = false;
    while true {
        tried = tried + 1;
        const style: u8 = api_style_now(cfg);
        if !api_url_into(cfg, style, &url) || !build_model_request(cfg, &tmp, &req, style) {
            return false;
        }
        var guard: FdGuard = FdGuard{ saved: -1, nullfd: -1, active: false };
        tls_noise_mute(&guard, !cfg.tls_debug && !hc_debug);
        const res: !i32 = llm_stream_style(
            style,
            url.ptr[0: url.len],
            hdrs.ptr[0: hdrs.len],
            req.ptr as &const byte,
            req.len,
            cfg.timeout_ms,
            cfg.max_response,
            cfg.verify,
            cfg.pin.ptr[0: cfg.pin.len],
            &o,
            false,
            false,
            serve_input
        );
        tls_noise_unmute(&guard);
        status = res catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            if eid == @error_id(error.LlmInterrupted) {
                interrupted = true;
            }
            0;
        };
        if api_negotiate(cfg, style, status) && tried < 2 {
            buf_reset(&o.content);
            continue;
        }
        api_lock(cfg, style);
        break;
    }
    if interrupted || status != 200 || o.content.len == 0 {
        return false;
    }
    // 模型给的字节不可信：过唯一的标题规范化实现，再按 fallback 的口径压到「5 词 / 40 B」
    // （模型偶尔会回一整句；DSH 的 provider 结果同样要过 normalizeSessionTitle 才落地）。
    var fb: Buf = buf_new(TTY_TITLE_FALLBACK_BYTES + 16);
    defer { buf_free(&fb); }
    _ = tty_title_fallback_into(
        &fb,
        o.content.ptr as &const byte,
        o.content.len,
        TTY_TITLE_FALLBACK_WORDS,
        TTY_TITLE_FALLBACK_BYTES
    );
    if fb.len == 0 {
        return false;
    }
    _ = buf_append(out, fb.ptr as &const byte, fb.len);
    return true;
}

// 回合收尾时**只是挂个待办**，真正发请求在空闲主循环里（见 agent_title_auto_pending_tick）。
//
// 为什么不能直接在这儿发：这一句在回合的同步路径上，请求在飞的那段会**拖长「回合还没结束」
// 的窗口**，而运行中敲进来的命令走的是 steer 收件箱 —— 那玩意儿只在 step 边界被领取
// （泵点里的 agent_tui_poll_pending_cmd 只管面板结果）。于是「起标题的请求在飞时敲 /status」
// 会掉进收件箱干等，屏幕上就是没反应 —— p30-check 的 status-during-compact 当场抓到这条。
// 挪到空闲循环 + 泵点上下文之后，落点就与 /compact 完全一样（P31 那条纪律）。
export fn agent_title_auto_schedule(cfg: &const Config) void {
    if (!agent_title_auto_on(cfg)) {
        return;
    }
    g_title_auto_pending = true;
    g_title_auto_arm_ms = ua_now_ms();
}

// 自动起标题是否**真的**该跑：开关开着 **且** 非交互（管道/CI）不跑 **且** 子代理不跑。
// 理由：标题只服务交互界面，那两条路径上 `tty_title_set` 本来就是空操作 (§11.7)。
fn agent_title_auto_on(cfg: &const Config) bool {
    if !cfg.title || !cfg.title_auto || !g_interactive || cfg.is_subagent {
        return false;
    }
    if g_title_pinned {
        return false;
    }
    if g_title_human_msgs == 0 || g_title_human_msgs == g_title_auto_rev {
        return false;   // 没有新的人类消息：不重复烧钱（revision 门控）
    }
    return true;
}

// 空闲主循环里消费待办：把标题换成模型给的（kind = provider，**不钉住** —— 下一条人类消息还能再换）。
// 与 /compact 同一落点（空闲循环里发），但**泵点的口径不同**：/compact 是前台请求，
// 泵点照常读键盘、照常派发运行中的只读命令；起标题是后台请求，泵点只刷帧（g_bg_request），
// 一个字节的键都不读，而且一发现用户动键盘就中止自己。
//
// ⚠ 只在**真空闲**时才发：起标题是锦上添花，绝不能抢用户的输入。它是个同步请求，
// 一发出去就是几百毫秒到几秒；那段时间用户敲的字只会落进 steer 收件箱，而收件箱要等
// step 边界才被领取 —— 于是「起标题时敲 /status」看起来就是没反应（p30-check 的
// status-during-compact 抓到过，落点还串成了「未知命令」）。有输入就先让给用户，
// 下一圈空闲了再发。
fn agent_title_auto_idle_ok() bool {
    if !g_title_auto_pending {
        return false;
    }
    // 两段静默（理由见 TITLE_AUTO_QUIET_MS 的注释）：arm 窗口 + 键盘窗口。
    const now: u64 = ua_now_ms();
    if g_title_auto_arm_ms > 0 && now >= g_title_auto_arm_ms
        && now - g_title_auto_arm_ms < TITLE_AUTO_QUIET_MS {
        return false;
    }
    const last_key: u64 = tui_last_key_ms();
    if last_key > 0 && now >= last_key && now - last_key < TITLE_AUTO_QUIET_MS {
        return false;
    }
    if tui_active() {
        if tui_has_submit() || tui_overlay_open() {
            return false;
        }
        // 有还没派发的浮层结果（面板里刚选中一条命令）也不行：那一圈的下一次迭代会
        // 去派发它，而它顺手要收走「触发面板的那个 /」—— 与用户正在敲的命令搅在一起
        // 就是 `//status`（实测症状，见 tui_overlay_result_pending 的注释）。
        if tui_overlay_result_pending() {
            return false;
        }
        // 输入行里已经有字 = 用户正在打字（可能刚敲了一个 `/` 在等面板）。
        // 这时候发请求，那半个命令会被后面的泵点/主循环当成整条命令派发 ——
        // 实测症状是 `/status` 变成 `//status` 然后「未知命令」（p30-check 的
        // status-during-compact 抓到过）。
        if tui_input_len() > 0 {
            return false;
        }
    }
    return inbox_len(&g_steer) == 0;
}

// 自动起标题的**发起**（P48）：只有「距回合收尾与距最后一次敲键都 ≥900 ms」才真的发。
// 它是同步的（单线程，踩坑 47 起不了第二条线程），而且**用户一动键盘就中止自己**。
// `--no-title-auto` 时整个函数是空操作。
export fn agent_title_auto_pending_tick(cfg: &const Config, h: &const History) void {
    if (!g_title_auto_pending) {
        return;
    }
    // 用户的东西优先：有输入/有浮层就这一圈不发（待办留着，下一圈再看）
    if !agent_title_auto_idle_ok() {
        return;
    }
    g_title_auto_pending = false;
    if (!agent_title_auto_on(cfg)) {
        return;
    }
    // 先把 revision 记上：这次不管成没成，都不该为同一条消息再试一次
    g_title_auto_rev = g_title_human_msgs;
    // 后台请求：不读键盘、也不派发命令（g_bg_request 让泵点退化成「只刷帧」）
    g_bg_request = true;
    var t: Buf = buf_new(TTY_TITLE_FALLBACK_BYTES + 16);
    defer { buf_free(&t); }
    const got: bool = agent_title_generate(cfg, h, &t, g_interactive);
    g_bg_request = false;
    if !got {
        return;
    }
    buf_reset(&g_sess.title);
    _ = buf_append(&g_sess.title, t.ptr as &const byte, t.len);
    g_title_auto_done = true;
    agent_title_log_kind("provider" as &const byte, t.ptr as &const byte, t.len);
    agent_title_write_index(cfg);
    agent_title_apply();
}

// P46：`set_title` 工具。
//
// 与 /title 走同一个落点（agent_title_set_user），所以「钉住 / 落 user 事件 / 写索引 /
// OSC 2」四条语义两条路完全一致 —— 这是本仓的既定纪律：同一件事只有一处实现。
// 空串 = clear（退回基标题、解锁自动起标题），与 `/title clear` 同语义。
// 参数缺失（没有 title 键）则报用法，不做任何改动。
export fn agent_title_tool_set(cfg: &const Config, args: &const JsonValue, out: &Buf) void {
    var t: Buf = buf_empty();
    defer { buf_free(&t); }
    if !js_obj_get_str_unescaped(args, "title", 5, &t) {
        _ = buf_append_cstr(out, "error: set_title needs a \"title\" string (pass \"\" to clear it)\n");
        return;
    }
    if t.len == 0 {
        agent_title_clear(cfg);
        _ = buf_append_cstr(out, "title cleared; the terminal title is back to the default and automatic titling resumes\n");
        return;
    }
    const rc: i32 = agent_title_set_user(cfg, t.ptr as &const byte, t.len);
    if rc == TITLE_SET_EMPTY {
        _ = buf_append_cstr(out, "error: title must contain visible characters (control characters and whitespace alone are not a title)\n");
        return;
    }
    _ = buf_append_cstr(out, "title set to \"");
    _ = buf_append(out, g_sess.title.ptr as &const byte, g_sess.title.len);
    _ = buf_append_cstr(out, "\" (pinned: automatic titling will not overwrite it; pass \"\" to clear)\n");
}

// 写一条 `user/message` 事件。`steer = true` 时带 `source.kind = "steer"`
// （运行中敲进来的文本，见 §3.4 的 step 边界领取）。
// 带图片附件时**多写一个 `attachments` 数组**；为空时一个字节都不多写（老日志形状不变）。
fn agent_log_user(text: &const byte, n: usize, steer: bool) void {
    var empty_att: Buf = buf_empty();
    var no: bool = false;
    agent_log_user_att(text, n, steer, &empty_att, &no);
}

// P51：与 agent_log_user 同一条路，只是**多写一个 attachments 数组**。
// 为什么图片附件要进日志：`--resume` 之后那些图还得能重发（历史里存的是路径与元数据，
// 字节在附件目录里按 id 存着）。attachments 为空时**一个字节都不多写** —— 老日志的形状
// 与即将写入的日志逐字节相同。
fn agent_log_user_att(text: &const byte, n: usize, steer: bool, att: &const Buf, have_att: &const bool) void {
    if n == 0 {
        return;
    }
    // P46：人类消息计数 = 自动起标题的 revision（steer 也算：用户确实又说了话）
    g_title_human_msgs = g_title_human_msgs + 1;
    const fresh: bool = agent_title_derive(text, n);
    if g_sess.save {
        var ev: Buf = buf_new(n + att.len + 256);
        defer { buf_free(&ev); }
        if sess_begin(&g_sess, "user/message", &ev) {
            _ = buf_append_cstr(&ev, "{\"role\":\"user\",\"content\":[{\"type\":\"text\",\"text\":");
            if jw_str_into(&ev, text, n) {
                _ = buf_append_cstr(&ev, "}]");
                if have_att[0] && att.len > 0 {
                    _ = buf_append_cstr(&ev, ",\"attachments\":");
                    _ = buf_append(&ev, att.ptr as &const byte, att.len);
                }
                if steer {
                    _ = buf_append_cstr(&ev, ",\"source\":{\"kind\":\"steer\"}}");
                } else {
                    _ = buf_append_cstr(&ev, ",\"source\":{\"kind\":\"user\"}}");
                }
                _ = sess_end(&g_sess, &ev);
            }
        }
        if fresh && g_sess.title.len > 0 {
            agent_title_log_event();
        }
    }
    agent_title_apply();
}

// 写一条 `assistant/message` 事件（正文 + 本次 usage）。
// **退化响应那一步不写**（§5.4）—— 否则「上游正常收尾但什么都没给」在日志里
// 与「模型真的回了空串」长得一模一样。
//
// keep_calls=false 是给 **max_tokens 截断**那一步用的（§5.4.1）：那一步的 tool_calls
// **一个都不会被派发**（参数可能是半截的），留在日志里就是「日志说有调用、实际一条结果都没有」
// 的悬空形状 —— 而且 `--resume` 折日志时会把那半组当「未完成一轮」**整组丢掉**
// （`hist_trim_incomplete_tail`），连截断前那段正文一起丢。DSH 的 assembler 在 max-tokens 时
// 同样把 tool-call 块整块滤掉（"Emitted blocks and replay metadata both derive from this
// result, so they cannot disagree"）—— 日志与实际派发必须一致。
fn agent_log_assistant(step: i32, o: &const ChatOut, t: u64, keep_calls: bool) void {
    if !g_sess.save {
        return;
    }
    var ev: Buf = buf_new(o.content.len + 8192);
    defer { buf_free(&ev); }
    if !sess_begin_at(&g_sess, "assistant/message", t, &ev) {
        return;
    }
    _ = buf_append_cstr(&ev, "{\"turn\":");
    _ = buf_append_i64(&ev, g_turn as i64);
    _ = buf_append_cstr(&ev, ",\"step\":");
    _ = buf_append_i64(&ev, step as i64);
    _ = buf_append_cstr(&ev, ",\"message\":{\"role\":\"assistant\",\"content\":");
    agent_note_answer(o.content.ptr as &const byte, o.content.len);
    if o.content.len > 0 {
        if !jw_str_into(&ev, o.content.ptr as &const byte, o.content.len) {
            return;
        }
    } else if !buf_append_cstr(&ev, "\"\"") {
        return;
    }
    if keep_calls && o.ncalls > 0 {
        // 容量按实际需要算（不再是固定 8192）：见 calls_json_make
        var cj: Buf = buf_empty();
        defer { buf_free(&cj); }
        if !calls_json_make(o, &cj) {
            // 会话日志是尽力而为：这里不能让整轮崩，但必须留话 —— 否则「这一步的
            // assistant 事件里没有 tool_calls」事后完全查不出原因（真机踩过）。
            out_err("[session] assistant 事件的 tool_calls 写不进日志（需要 ");
            out_err_dec(calls_json_need(o));
            out_err(" 字节，分配或写入失败）\n");
            return;
        }
        _ = buf_append_cstr(&ev, ",\"tool_calls\":");
        _ = buf_append(&ev, cj.ptr, cj.len);
    }
    _ = buf_append_cstr(&ev, "},\"usage\":{\"inputTokens\":");
    _ = buf_append_i64(&ev, o.usage_in);
    _ = buf_append_cstr(&ev, ",\"outputTokens\":");
    _ = buf_append_i64(&ev, o.usage_out);
    _ = buf_append_cstr(&ev, ",\"cacheReadTokens\":");
    _ = buf_append_i64(&ev, o.usage_cache_read);
    _ = buf_append_cstr(&ev, ",\"cacheWriteTokens\":");
    _ = buf_append_i64(&ev, o.usage_cache_write);
    _ = buf_append_cstr(&ev, ",\"reasoningTokens\":");
    _ = buf_append_i64(&ev, o.usage_reasoning);
    _ = buf_append_cstr(&ev, "}}");
    _ = sess_end(&g_sess, &ev);
}

// P16：思考全空白（只有空白字符）就不值得记/不值得显示
fn agent_text_blank(p: &const byte, n: usize) bool {
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c != 32 as byte && c != 9 as byte && c != 10 as byte && c != 13 as byte {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 纯函数：assistant/reasoning 事件的 data 对象（自测逐字节断言的就是它）。
// 形状跟着 assistant/message 走（message 包一层、字段名用线上协议名 reasoning_content）。
fn agent_reasoning_event_json(out: &Buf, turn: i32, step: i32, text: &const byte, n: usize) bool {
    if !buf_append_cstr(out, "{\"turn\":") {
        return false;
    }
    if !buf_append_i64(out, turn as i64) {
        return false;
    }
    if !buf_append_cstr(out, ",\"step\":") {
        return false;
    }
    if !buf_append_i64(out, step as i64) {
        return false;
    }
    if !buf_append_cstr(out, ",\"message\":{\"role\":\"assistant\",\"reasoning_content\":") {
        return false;
    }
    if !jw_str_into(out, text, n) {
        return false;
    }
    return buf_append_cstr(out, "}}");
}

// P16：思考全文落一条独立事件 —— 显示层只留一行，全文在这里活下来。
// 独立事件（而不是塞进 assistant/message）有两个理由：message 那条要**原样**回灌给端点
// （P4 的严格工具协议），而且 DSH 自己也是把 reasoning 与 message 分开记的。
// reader（agent_hist_from_events）按已知类型分支，不认识这个类型就跳过，所以 --resume 不受影响。
fn agent_log_reasoning(step: i32, o: &const ChatOut) void {
    if !g_sess.save || o.reasoning.len == 0 {
        return;
    }
    if agent_text_blank(o.reasoning.ptr as &const byte, o.reasoning.len) {
        return;
    }
    var ev: Buf = buf_new(o.reasoning.len + 512);
    defer { buf_free(&ev); }
    if !sess_begin(&g_sess, "assistant/reasoning", &ev) {
        return;
    }
    if !agent_reasoning_event_json(&ev, g_turn, step, o.reasoning.ptr as &const byte, o.reasoning.len) {
        return;
    }
    _ = sess_end(&g_sess, &ev);
}

// 一步的思考收尾：显示上把那一行落进转录（幂等），日志上把全文记下来。
// 成功 / 中断 / 报错、流式 / 非流式都走这里 —— 中断时也要先把提示符还回去再打别的。
fn agent_note_reasoning(step: i32, o: &const ChatOut) void {
    view_think_end(o.reasoning.ptr as &const byte, o.reasoning.len);
    agent_log_reasoning(step, o);
}

// tool/call 在工具**真正开始执行前**写（tool/result 在它之后写）：统计折叠用两者的
// time 差当 toolMs，背靠背写两条的话这个数字恒为 0。
fn agent_log_tool_call(step: i32, call_id: &const Buf, name: &const Buf, args: &const Buf, t: u64) void {
    if !g_sess.save {
        return;
    }
    var ev: Buf = buf_new(args.len + 512);
    defer { buf_free(&ev); }
    if sess_begin_at(&g_sess, "tool/call", t, &ev) {
        _ = buf_append_cstr(&ev, "{\"turn\":");
        _ = buf_append_i64(&ev, g_turn as i64);
        _ = buf_append_cstr(&ev, ",\"step\":");
        _ = buf_append_i64(&ev, step as i64);
        _ = buf_append_cstr(&ev, ",\"callId\":");
        _ = jw_str_into(&ev, call_id.ptr as &const byte, call_id.len);
        _ = buf_append_cstr(&ev, ",\"name\":");
        _ = jw_str_into(&ev, name.ptr as &const byte, name.len);
        _ = buf_append_cstr(&ev, ",\"arguments\":");
        _ = jw_str_into(&ev, args.ptr as &const byte, args.len);
        _ = buf_append_cstr(&ev, "}");
        _ = sess_end(&g_sess, &ev);
    }
}

// 写一条 `tool/result` 事件（工具名、call_id、结果正文）。
// `call_id` 是严格工具协议回放的锚点 —— 与 `tool/call` 那一条配对（§3.5 的原子组）。
fn agent_log_tool_result(step: i32, call_id: &const Buf, result: &const Buf, t: u64) void {
    if !g_sess.save {
        return;
    }
    var ev: Buf = buf_new(result.len + 512);
    defer { buf_free(&ev); }
    if sess_begin_at(&g_sess, "tool/result", t, &ev) {
        _ = buf_append_cstr(&ev, "{\"turn\":");
        _ = buf_append_i64(&ev, g_turn as i64);
        _ = buf_append_cstr(&ev, ",\"step\":");
        _ = buf_append_i64(&ev, step as i64);
        _ = buf_append_cstr(&ev, ",\"callId\":");
        _ = jw_str_into(&ev, call_id.ptr as &const byte, call_id.len);
        _ = buf_append_cstr(&ev, ",\"content\":");
        _ = jw_str_into(&ev, result.ptr as &const byte, result.len);
        _ = buf_append_cstr(&ev, "}");
        _ = sess_end(&g_sess, &ev);
    }
}

// ============================================================
// P18：统计边界（记日志 + 喂折叠 + 推给 TUI）
// ============================================================
//
// 每个边界只在这里做一次：同一个毫秒值既进日志（sess_begin_at）又进折叠（st_*），
// 所以「实时数字」与「resume 回放出来的数字」必须逐位相同（自测 stats-fold 钉这条）。
// --no-save 时日志不写，折叠照常 —— 界面上的统计与有没有落盘无关。

fn agent_bound_step_start(cfg: &const Config, h: &const History, step: i32) void {
    const t: u64 = ua_now_ms();
    if g_sess.save {
        var ev: Buf = buf_new(96);
        defer { buf_free(&ev); }
        if sess_begin_at(&g_sess, "step/start", t, &ev) {
            _ = buf_append_cstr(&ev, "{\"turn\":");
            _ = buf_append_i64(&ev, g_turn as i64);
            _ = buf_append_cstr(&ev, ",\"step\":");
            _ = buf_append_i64(&ev, step as i64);
            _ = buf_append_cstr(&ev, "}");
            _ = sess_end(&g_sess, &ev);
        }
    }
    st_step_start(g_turn as i64, step as i64, t);
    agent_stats_sync(cfg, h);
}

// step 收尾记账：写 `step/end` 事件并把本步的统计折进 `Stats`（§3.4 的第 l 步）。
// 早退路径（分配失败等）也要走到它，否则 `step/start` 与 `step/end` 会不成对。
fn agent_bound_step_end(cfg: &const Config, h: &const History, step: i32) void {
    const t: u64 = ua_now_ms();
    if g_sess.save {
        var ev: Buf = buf_new(96);
        defer { buf_free(&ev); }
        if sess_begin_at(&g_sess, "step/end", t, &ev) {
            _ = buf_append_cstr(&ev, "{\"turn\":");
            _ = buf_append_i64(&ev, g_turn as i64);
            _ = buf_append_cstr(&ev, ",\"step\":");
            _ = buf_append_i64(&ev, step as i64);
            _ = buf_append_cstr(&ev, "}");
            _ = sess_end(&g_sess, &ev);
        }
    }
    st_step_end(g_turn as i64, step as i64);
    agent_stats_sync(cfg, h);
}

// ms = ChatOut.first_token_ms（流式路径记的首 token 时刻）
fn agent_bound_first_token(cfg: &const Config, h: &const History, step: i32, ms: i64) void {
    if ms <= 0 {
        return;
    }
    const t: u64 = ms as u64;
    if g_sess.save {
        var ev: Buf = buf_new(96);
        defer { buf_free(&ev); }
        if sess_begin_at(&g_sess, "assistant/first-token", t, &ev) {
            _ = buf_append_cstr(&ev, "{\"turn\":");
            _ = buf_append_i64(&ev, g_turn as i64);
            _ = buf_append_cstr(&ev, ",\"step\":");
            _ = buf_append_i64(&ev, step as i64);
            _ = buf_append_cstr(&ev, "}");
            _ = sess_end(&g_sess, &ev);
        }
    }
    st_first_token(g_turn as i64, step as i64, t);
}

// step 边界记账 + 写 `assistant/message`。步骤见 §3.5 的第 4 步。
// 与「把 assistant 消息压进历史」是两件事：这里是日志侧，那里是历史侧。
// keep_calls 一路带给 `agent_log_assistant`：截断那一步传 false（那一步的 tool_calls
// 不会被派发，见 §5.4.1），其余路径传 true。
fn agent_bound_assistant_message(cfg: &const Config, h: &const History, step: i32, o: &const ChatOut, keep_calls: bool) void {
    const t: u64 = ua_now_ms();
    agent_log_assistant(step, o, t, keep_calls);
    st_assistant_message(
        g_turn as i64,
        step as i64,
        t,
        o.usage_in,
        o.usage_cache_read,
        o.usage_cache_write,
        o.usage_out
    );
    // 压力样本就是这次请求的 prompt 规模（DSH 的 pressureTokens）；同时把增量基准
    // 锚在当下，之后 used = 样本 + (est_now - 锚点)（DSH 的 projectedTokens 口径）
    var sys_t: i64 = 0;
    var tools_t: i64 = 0;
    var msgs_t: i64 = 0;
    agent_ctx_est(cfg, h, &sys_t, &tools_t, &msgs_t);
    g_ctx_est_at_sample = sys_t + tools_t + msgs_t;
    agent_stats_sync(cfg, h);
}

// 记账 + 写 `tool/call`。**在工具真正执行之前**写 —— 所以 `/watch` 能在长 step 中途
// 看到「正在跑哪个工具」（§9.1 说的实时粒度就是这条）。
fn agent_bound_tool_call(cfg: &const Config, h: &const History, step: i32, call_id: &const Buf, name: &const Buf, args: &const Buf) void {
    const t: u64 = ua_now_ms();
    agent_log_tool_call(step, call_id, name, args, t);
    st_tool_call(call_id.ptr as &const byte, call_id.len, t);
    agent_stats_sync(cfg, h);
}

// 记账 + 写 `tool/result`（工具执行完之后）。与 `agent_bound_tool_call` 严格配对。
fn agent_bound_tool_result(cfg: &const Config, h: &const History, step: i32, call_id: &const Buf, result: &const Buf) void {
    const t: u64 = ua_now_ms();
    agent_log_tool_result(step, call_id, result, t);
    st_tool_result(call_id.ptr as &const byte, call_id.len, t);
    agent_stats_sync(cfg, h);
}

// ------------------------------------------------------------
// P18：上下文占用（DSH contextPressure / contextBreakdown 的等价物）
// ------------------------------------------------------------
//
// 三段启发式：固定「4 字符 ≈ 1 token」（与 agent_pressure_tokens 同口径），
// 刻意不做 provider 精确 tokenizer —— DSH 的 contextBreakdown 也是这个性质，
// 所以三项之和**不等于**总量（CJK 会被低估），界面按「近似组成」呈现。
//
// g_tools_scratch 是请求组装也在用的共享 scratch。这里的调用点全部落在步边界上，
// 与 build_*_request 不会嵌套（同一线程顺序执行），所以复用是安全的。
fn agent_ctx_est(cfg: &const Config, h: &const History, sys_t: &i64, tools_t: &i64, msgs_t: &i64) void {
    var sys_bytes: i64 = 0;
    if h.len > 0 {
        const m0: &const Msg = msg_at(h, 0);
        if m0.role == ROLE_SYSTEM {
            sys_bytes = (m0.text_len + m0.extra_len) as i64;
        }
    }
    var tools_bytes: i64 = 0;
    if tools_json(&g_tools_scratch, cfg.allow_shell, false) {
        tools_bytes = g_tools_scratch.len as i64;
    }
    var msg_bytes: i64 = 0;
    var i: usize = 1;   // h[0] 是系统提示词，已经算进 sys
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        // P27：工具结果按**构请求后**的字节算 —— 请求里带的是剪枝过的文本，
        // 估算必须同口径，否则投影压力偏高、压缩会提前触发（一次前缀重写是全价）。
        if m.role == ROLE_TOOL {
            msg_bytes = msg_bytes + (cmp_request_bytes(m.text as &const byte, m.text_len, m.kind, &g_ctx_scratch) as i64);
        } else {
            msg_bytes = msg_bytes + (m.text_len as i64);
        }
        msg_bytes = msg_bytes + (m.extra_len as i64);
        i = i + 1;
    }
    sys_t[0] = sys_bytes / 4;
    tools_t[0] = tools_bytes / 4;
    msgs_t[0] = msg_bytes / 4;
}

// 展示用的 used（DSH 的 projectedTokens）：返回 -1 = 还不可用（提供方没报过用量）
fn agent_ctx_used(cfg: &const Config, h: &const History, sys_t: &i64, tools_t: &i64, msgs_t: &i64) i64 {
    agent_ctx_est(cfg, h, sys_t, tools_t, msgs_t);
    if !st_have_pressure() {
        return -1;
    }
    const est_now: i64 = sys_t[0] + tools_t[0] + msgs_t[0];
    if g_ctx_est_at_sample < 0 {
        // 没有增量基准（--resume 后第一帧：样本来自日志，当时的估算没落盘）：
        // 锚在当下，先只用样本，等下一次请求再把锚点接上
        g_ctx_est_at_sample = est_now;
    }
    return st_ctx_projected(st_pressure(), g_ctx_est_at_sample, est_now);
}

// 让运行时上下文快照与当前 cfg 一致（权限/plan/工作区变了就补推一条新的 user 消息）。
// 与 `agent_plan_snapshot_sync` / `agent_ws_snapshot_sync` 同一套「比对快照再补推」的形状。
fn agent_ctx_sync(cfg: &const Config, h: &const History) void {
    var sys_t: i64 = 0;
    var tools_t: i64 = 0;
    var msgs_t: i64 = 0;
    const used: i64 = agent_ctx_used(cfg, h, &sys_t, &tools_t, &msgs_t);
    const pct: i32 = if used < 0 { -1 } else { st_ctx_percent(used, cfg.context_window) };
    tui_set_ctx(pct);
}

// 统计行 + 上下文占用一起推给 TUI（没有 TUI 时是空操作：数字只在折叠里，不花冤枉钱）
fn agent_stats_sync(cfg: &const Config, h: &const History) void {
    if !tui_active() {
        return;
    }
    var line: Buf = buf_new(512);
    defer { buf_free(&line); }
    if st_line(&line) {
        tui_set_stats(line.ptr as &const byte, line.len);
    } else {
        tui_set_stats("" as &const byte, 0);
    }
    agent_ctx_sync(cfg, h);
}

// 写一条**只有 type + data** 的会话事件（无 step 上下文的那些）。
// 有 step 归属的事件走 `agent_bound_*` 那一族。
fn agent_log_simple(typ: &const byte, payload: &const byte) void {
    if !g_sess.save {
        return;
    }
    var ev: Buf = buf_new(256);
    defer { buf_free(&ev); }
    if !sess_begin(&g_sess, typ, &ev) {
        return;
    }
    _ = buf_append_cstr(&ev, payload);
    _ = sess_end(&g_sess, &ev);
}

// 回合开始：`g_turn` 加一、写 `turn/start`，并把会话级的 todo 清空（DSH 口径）。
fn agent_log_turn_start() void {
    var ev: Buf = buf_new(64);
    defer { buf_free(&ev); }
    if !g_sess.save {
        return;
    }
    if !sess_begin(&g_sess, "turn/start", &ev) {
        return;
    }
    _ = buf_append_cstr(&ev, "{\"turn\":");
    _ = buf_append_i64(&ev, g_turn as i64);
    _ = buf_append_cstr(&ev, "}");
    _ = sess_end(&g_sess, &ev);
    g_sess.turns = g_turn as i64;
}

// 回合结束：写 `turn/end`（带一句 reason，便于事后区分「正常收尾」与「中断/超预算」）。
fn agent_log_turn_end(reason: &const byte) void {
    if !g_sess.save {
        return;
    }
    var ev: Buf = buf_new(128);
    defer { buf_free(&ev); }
    if !sess_begin(&g_sess, "turn/end", &ev) {
        return;
    }
    _ = buf_append_cstr(&ev, "{\"turn\":");
    _ = buf_append_i64(&ev, g_turn as i64);
    _ = buf_append_cstr(&ev, ",\"reason\":");
    _ = jw_str_into(&ev, reason, bufx_cstr_len(reason));
    _ = buf_append_cstr(&ev, "}");
    _ = sess_end(&g_sess, &ev);
}

// 从会话日志恢复消息历史（返回恢复的消息条数；0 表示没有可恢复内容）
//
// fold_stats=true 时顺带把**同一遍扫描**的每一行喂进统计折叠 —— 统计因此是全会话
// 口径，resume 之后与恢复前逐位相同（子代理 fork 父历史时传 false：那份历史的步数
// 是父会话的，不该算进子会话的统计）。
fn agent_hist_from_log(cfg: &const Config, h: &History, path: &const Buf, out_next_seq: &i64, fold_stats: bool) i32 {
    var r: SessReader = sess_reader_empty();
    defer { sess_reader_free(&r); }
    var pz: Buf = buf_new(path.len + 1);
    defer { buf_free(&pz); }
    _ = buf_append(&pz, path.ptr, path.len);
    _ = buf_append_byte(&pz, 0);
    if !sess_reader_load(pz.ptr as &const byte, &r) {
        return 0;
    }
    var sp: Buf = buf_new(32768);
    defer { buf_free(&sp); }
    if !agent_system_prompt(cfg, &sp) {
        return 0;
    }
    if !hist_push(h, ROLE_SYSTEM, sp.ptr as &const byte, sp.len) {
        return 0;
    }
    // 恢复出来的历史**重新注入**运行时上下文与 AGENTS.md（DSH 也是重新求值）
    agent_inject_context(cfg, h);
    var line: Buf = buf_new(65536);
    defer { buf_free(&line); }
    var typ: Buf = buf_new(64);
    defer { buf_free(&typ); }
    var text: Buf = buf_new(65536);
    defer { buf_free(&text); }
    var extra: Buf = buf_new(65536);
    defer { buf_free(&extra); }
    var added: i32 = 0;
    var expect: i64 = 0;
    out_next_seq[0] = 0;
    if fold_stats {
        st_reset();
    }
    while sess_next(&r, &line) {
        if fold_stats {
            st_fold_line(&line);
        }
        const seq: i64 = sess_line_seq(&line);
        if seq >= 0 {
            if seq != expect {
                out_err("[session] 警告：seq 不连续（");
                out_err_dec(seq as usize);
                out_err(" != ");
                out_err_dec(expect as usize);
                out_err("），日志可能损坏\n");
            }
            expect = seq + 1;
        }
        if !sess_line_type(&line, &typ) {
            continue;
        }
        const view: &[byte] = line.ptr[0: line.len];
        if sv_eq_cstr(&typ, "user/message") {
            if sess_json_str(view, "text", &text) && text.len > 0 {
                // P51：图片附件（`"attachments":[...]`）随消息一起回放 —— 少了它，
                // --resume 之后那些图就发不出去了（历史里存的是路径 + 元数据）。
                var att: Buf = buf_empty();
                defer { buf_free(&att); }
                const have_att: bool = sess_extract_array(view, "attachments", &att) && att.len > 0;
                if have_att {
                    if hist_push_msg(h, ROLE_USER, text.ptr as &const byte, text.len,
                        att.ptr as &const byte, att.len) {
                        added = added + 1;
                    }
                } else if hist_push(h, ROLE_USER, text.ptr as &const byte, text.len) {
                    added = added + 1;
                }
            }
        } else if sv_eq_cstr(&typ, "assistant/message") {
            const has_text: bool = sess_json_str(view, "content", &text);
            const has_calls: bool = sess_extract_array(view, "tool_calls", &extra);
            if has_calls && extra.len > 0 {
                if hist_push_msg(
                    h,
                    ROLE_ASSISTANT_CALLS,
                    text.ptr as &const byte,
                    if has_text { text.len } else { 0 as usize },
                    extra.ptr as &const byte,
                    extra.len
                ) {
                    added = added + 1;
                }
            } else if has_text && text.len > 0 {
                if hist_push(h, ROLE_ASSISTANT, text.ptr as &const byte, text.len) {
                    added = added + 1;
                }
            }
        } else if sv_eq_cstr(&typ, "tool/result") {
            var cid: Buf = buf_new(128);
            defer { buf_free(&cid); }
            if sess_json_str(view, "callId", &cid) && sess_json_str(view, "content", &text) {
                // 会话日志不带工具名，回放出来的结果一律按通用规则剪（同 dshsess.uya 的说明）
                if hist_push_msg(h, ROLE_TOOL, text.ptr as &const byte, text.len, cid.ptr as &const byte, cid.len) {
                    added = added + 1;
                }
            }
        } else if sv_eq_cstr(&typ, "session/title") {
            var ttl: Buf = buf_new(256);
            defer { buf_free(&ttl); }
            if sess_json_string_dup(view, "title", &ttl) {
                buf_reset(&g_sess.title);
                _ = buf_append(&g_sess.title, ttl.ptr, ttl.len);
                // P46：钉住与否只看**最后一条** title 事件的 kind（latest-wins，与 DSH 的
                // foldSessionTitle 同口径）。不读它的话 `--resume` 之后钉住状态就丢了，
                // 自动起标题会把用户手写的标题覆盖掉。
                var kd: Buf = buf_new(32);
                defer { buf_free(&kd); }
                g_title_pinned = sess_json_str(view, "kind", &kd)
                    && bufx_eq_cstr(kd.ptr as &const byte, kd.len, "user" as &const byte);
            }
        }
    }
    if r.dropped_tail {
        out_err("[session] 最后一条记录不完整，已丢弃（崩溃恢复）\n");
    }
    out_next_seq[0] = expect;   // 续写时接着这个 seq 往下写
    return added;
}

// 取字段并复制到独立缓冲（sess_json_str 内部用临时缓冲，这里要留下副本）
fn sess_json_string_dup(view: &[byte], key: &const byte, out: &Buf) bool {
    return sess_json_str(view, key, out);
}

// 打开（或恢复）会话：返回 false 表示只能新建
// 子代理会话的父子关联（写进会话日志，便于看出派生关系）
fn agent_log_delegation(cfg: &const Config) void {
    if !cfg.is_subagent {
        return;
    }
    g_sess.deleg_depth = cfg.deleg_depth;
    if !g_sess.save {
        return;
    }
    var line: Buf = buf_new(1024);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "{\"parentSession\":");
    _ = jw_str_into(&line, cfg.parent_session.ptr as &const byte, cfg.parent_session.len);
    _ = buf_append_cstr(&line, ",\"delegationDepth\":");
    _ = buf_append_i64(&line, cfg.deleg_depth as i64);
    _ = buf_append_cstr(&line, ",\"label\":");
    _ = jw_str_into(&line, cfg.deleg_label.ptr as &const byte, cfg.deleg_label.len);
    _ = buf_append_cstr(&line, "}");
    _ = buf_append_byte(&line, 0);
    agent_log_simple("subagent/start", line.ptr as &const byte);
}

// 只**新建**自己的会话日志（不恢复任何历史）；fork 出来的子代理用它
fn agent_session_create(cfg: &const Config) bool {
    // 必须在 sess_open **之前**把深度交给 SessionLog：header 是在 sess_open 里写的，
    // 而 agent_log_delegation（原来唯一设置它的地方）在 agent_hist_init 里跑得更晚，
    // 于是子代理会话 header 的 delegationDepth 一直是 0（靠 header 判断子会话的地方会认错）。
    g_sess.deleg_depth = cfg.deleg_depth;
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        return false;
    }
    var hz: Buf = buf_new(home.len + 1);
    defer { buf_free(&hz); }
    _ = buf_append(&hz, home.ptr, home.len);
    _ = buf_append_byte(&hz, 0);
    _ = agent_set_home(hz.ptr as &const byte);
    var cwdz: Buf = buf_new(cfg.workspace.len + 1);
    defer { buf_free(&cwdz); }
    _ = buf_append(&cwdz, cfg.workspace.ptr, cfg.workspace.len);
    _ = buf_append_byte(&cwdz, 0);
    var modelz: Buf = buf_new(cfg.model.len + 1);
    defer { buf_free(&modelz); }
    _ = buf_append(&modelz, cfg.model.ptr, cfg.model.len);
    _ = buf_append_byte(&modelz, 0);
    var empty: [byte: 1] = [0];
    // fork 出来的子代理也用父进程预指定的会话 id（否则父进程拿不到 d.sid，无法续跑）
    var wantf: Buf = buf_empty();
    defer { buf_free(&wantf); }
    if cfg.force_session_id.len > 0 {
        wantf = buf_new(cfg.force_session_id.len + 1);
        if buf_valid(&wantf) {
            _ = buf_append(&wantf, cfg.force_session_id.ptr, cfg.force_session_id.len);
            _ = buf_append_byte(&wantf, 0);
        }
    }
    return sess_open(
        &g_sess,
        hz.ptr as &const byte,
        cwdz.ptr as &const byte,
        modelz.ptr as &const byte,
        "uya-agent",
        if wantf.len > 0 { wantf.ptr as &const byte } else { &empty[0] as &const byte },
        cfg.save_session,
        0,
        true
    );
}

// 开会话：算路径、写 header、按 `--no-save` 决定要不要真落盘。
// 新建走 `sess_open`；**恢复走 `sess_open_resume`**（往已经解析出来的那份日志续写、
// 不按 cwd 重算路径 —— 重算会在同 id 下造一个无 header 的空文件、把会话劈成两半，踩坑 48）。
// 开之前工作区必须已经定下来（§8.6）。
export fn agent_session_open(cfg: &Config, h: &History, resume_path: &const Buf) bool {
    // 同 agent_session_create：header 由 sess_open 写，深度必须在它之前落进 g_sess
    g_sess.deleg_depth = cfg.deleg_depth;
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        return false;
    }
    var hz: Buf = buf_new(home.len + 1);
    defer { buf_free(&hz); }
    _ = buf_append(&hz, home.ptr, home.len);
    _ = buf_append_byte(&hz, 0);
    _ = agent_set_home(hz.ptr as &const byte);

    var id: Buf = buf_new(64);
    defer { buf_free(&id); }
    var rpath: Buf = buf_empty();       // 要恢复的会话文件路径（空 = 新建）
    defer { buf_free(&rpath); }
    var resumed: bool = false;
    // P34：会话记录的工作区（日志里最后一条 session/workspace；没有就用 header 的创建时工作区）
    var sess_ws: Buf = buf_new(1024);
    defer { buf_free(&sess_ws); }
    var ws_fallback: bool = false;      // 记录的工作区已不存在 → 留在当前工作区
    if resume_path.len > 0 {
        // 已解析出路径（--resume/--continue 或 fork 的父会话）：读身份 + 当前工作区
        if buf_append(&rpath, resume_path.ptr, resume_path.len) {
            var meta: SessMeta = sess_meta_empty();
            defer { sess_meta_free(&meta); }
            var pz: Buf = buf_new(resume_path.len + 1);
            defer { buf_free(&pz); }
            _ = buf_append(&pz, resume_path.ptr, resume_path.len);
            _ = buf_append_byte(&pz, 0);
            if sess_read_meta(pz.ptr as &const byte, &meta) {
                _ = buf_append(&id, meta.id.ptr, meta.id.len);
                resumed = true;
                // 「这个会话在哪」必须在 agent_hist_from_log **之前**定下来：system prompt 的
                // {{cwd}}、AGENTS.md、技能目录都在那里面按工作区求值
                agent_session_workspace_pick(cfg, &meta, &sess_ws, &ws_fallback);
                // P37：模型也跟随会话记录（必须在 system prompt 求值之前定：{{model}} 要它）
                agent_session_model_pick(cfg, &meta);
            }
        }
    } else if cfg.force_session_id.len > 0 {
        // 父进程**预先**给这个子代理指定了会话 id（deleg_spawn 里约定）：
        //   * 该 id 的日志已存在 → 这是 send_message 续跑，恢复历史继续写同一个日志；
        //   * 不存在 → 这是首次派生，就用这个 id 新建（父进程因此知道 d.sid）。
        // 原实现把会话 id 交给子进程随机生成，父进程无从得知 → d.sid 恒空 →
        // send_message 每次都新开会话，续跑时上下文全丢（实测确认）。
        var cwdz0: Buf = buf_new(cfg.workspace.len + 1);
        defer { buf_free(&cwdz0); }
        _ = buf_append(&cwdz0, cfg.workspace.ptr, cfg.workspace.len);
        _ = buf_append_byte(&cwdz0, 0);
        var found: Buf = buf_empty();
        defer { buf_free(&found); }
        if sess_find(hz.ptr as &const byte, cwdz0.ptr as &const byte, cfg.force_session_id.ptr as &const byte, cfg.force_session_id.len, &found) {
            if buf_append(&rpath, found.ptr, found.len) {
                var r1: SessReader = sess_reader_empty();
                defer { sess_reader_free(&r1); }
                var pz1: Buf = buf_new(found.len + 1);
                defer { buf_free(&pz1); }
                _ = buf_append(&pz1, found.ptr, found.len);
                _ = buf_append_byte(&pz1, 0);
                if sess_read_header(pz1.ptr as &const byte, &r1) {
                    _ = buf_append(&id, r1.id.ptr, r1.id.len);
                    resumed = true;
                }
            }
        }
        if !resumed {
            _ = buf_append(&id, cfg.force_session_id.ptr, cfg.force_session_id.len);
        }
    }
    if resumed {
        var next_seq: i64 = 0;
        const n: i32 = agent_hist_from_log(cfg, h, &rpath, &next_seq, true);
        if n > 0 {
            // P22：`agent_hist_from_log` 顺带把日志里的 `session/title` 恢复进了 `g_sess.title`，
            // 但下面 `sess_open` 会把 SessionLog 整个重新初始化（`l.title` 重新分配 = 清空）。
            // 先把标题抄出来，sess_open 之后再放回去 —— 否则 `--continue` 的会话标题每次都丢。
            var kept_title: Buf = buf_new(g_sess.title.len + 8);
            defer { buf_free(&kept_title); }
            if g_sess.title.len > 0 {
                _ = buf_append(&kept_title, g_sess.title.ptr as &const byte, g_sess.title.len);
            }
            const trimmed: usize = hist_trim_incomplete_tail(h);
            if trimmed > 0 {
                out_err("[session] 丢弃了 ");
                out_err_dec(trimmed);
                out_err(" 条「未完成一轮」的尾部消息\n");
            }
            out_err("[session] 已恢复 ");
            out_err_dec(n as usize);
            out_err(" 条消息（id=");
            out_err_bytes(id.ptr, id.len);
            out_err("）\n");
            // 继续往**同一个**日志追加：路径用会话自己的那份（sess_open 会按当前 cwd 重算，
            // 那正是「改挂」的入口 —— P34 换成 sess_open_resume，见 §16 踩坑 52）。
            // l.cwd 传当前工作区：它表示「这个会话现在在哪」，索引（/sessions 的工作区列）
            // 按它写；header 里的创建时工作区不动（那是元数据）。
            var cwdz: Buf = buf_new(cfg.workspace.len + 1);
            defer { buf_free(&cwdz); }
            _ = buf_append(&cwdz, cfg.workspace.ptr, cfg.workspace.len);
            _ = buf_append_byte(&cwdz, 0);
            var modelz: Buf = buf_new(cfg.model.len + 1);
            defer { buf_free(&modelz); }
            _ = buf_append(&modelz, cfg.model.ptr, cfg.model.len);
            _ = buf_append_byte(&modelz, 0);
            var idz: Buf = buf_new(id.len + 1);
            defer { buf_free(&idz); }
            _ = buf_append(&idz, id.ptr, id.len);
            _ = buf_append_byte(&idz, 0);
            if !sess_open_resume(
                &g_sess,
                hz.ptr as &const byte,
                cwdz.ptr as &const byte,
                rpath.ptr as &const byte,
                rpath.len,
                modelz.ptr as &const byte,
                "uya-agent",
                idz.ptr as &const byte,
                cfg.save_session,
                next_seq
            ) {
                return false;
            }
            // P22：把日志里恢复出来的标题放回（sess_open 刚把它清掉）
            if kept_title.len > 0 {
                buf_reset(&g_sess.title);
                _ = buf_append(&g_sess.title, kept_title.ptr as &const byte, kept_title.len);
            }
            // P34：记录的工作区已经没了（worktree 合并后被删是常态）—— 把「本次实际在哪」
            // 补记一条，日志与索引因此不会停在一条对不上的记录上
            if ws_fallback {
                agent_workspace_log(cfg, "fallback" as &const byte, &sess_ws);
            }
            return true;
        }
        out_err("[session] 日志为空或无法解析，改为新建会话\n");
    }
    var cwdz2: Buf = buf_new(cfg.workspace.len + 1);
    defer { buf_free(&cwdz2); }
    _ = buf_append(&cwdz2, cfg.workspace.ptr, cfg.workspace.len);
    _ = buf_append_byte(&cwdz2, 0);
    var modelz2: Buf = buf_new(cfg.model.len + 1);
    defer { buf_free(&modelz2); }
    _ = buf_append(&modelz2, cfg.model.ptr, cfg.model.len);
    _ = buf_append_byte(&modelz2, 0);
    // 新建：子代理用父进程预指定的 id（父进程要拿它做 send_message 续跑），其余留空自生成
    var want2: Buf = buf_empty();
    defer { buf_free(&want2); }
    if cfg.force_session_id.len > 0 {
        want2 = buf_new(cfg.force_session_id.len + 1);
        if buf_valid(&want2) {
            _ = buf_append(&want2, cfg.force_session_id.ptr, cfg.force_session_id.len);
            _ = buf_append_byte(&want2, 0);
        }
    }
    return sess_open(
        &g_sess,
        hz.ptr as &const byte,
        cwdz2.ptr as &const byte,
        modelz2.ptr as &const byte,
        "uya-agent",
        if want2.len > 0 { want2.ptr as &const byte } else { "" as &const byte },
        cfg.save_session,
        0 as i64,
        true
    );
}

// 收尾：**先** `wt_reclaim_own` 回收本会话自己的确定性垃圾（结果要落一条 `session/worktree`
// 事件，所以必须排在 `sess_close` 之前），再关日志、写索引。
// **不自动 finish**：没验完的活不该被自动合并（§10.5）。
export fn agent_session_close() void {
    // P53：会话退出时先回收**本会话这个** worktree（如果它是「确定的垃圾」）。
    // 顺序很重要：必须排在 sess_close **之前** —— 回收结果要落一条会话日志
    // （`session/worktree`，action=reclaim），日志句柄一关就写不进去了。
    // 为什么不在这里自动 finish：没验完的活不该被自动合并（P37 的老口径没变），
    // 所以只有「零改动 + 零提交 + 没人在用」的那种才清掉，其余原样留着。
    // --no-save / 子代理 / 没开这个模式：wt_reclaim_own 自己会判，这里不用管。
    agent_worktree_reclaim_on_exit();
    if g_sess.path.len > 0 {
        sess_close(&g_sess, g_home.ptr as &const byte);
    }
}

// 退出时回收自己的 worktree：清掉了就落一条日志 + 说一句话。
// 只在交互式会话里出声（一次性任务 / 管道里少一句噪声），但**清**是照做的。
fn agent_worktree_reclaim_on_exit() void {
    if !wt_on() || !wt_ready() {
        return;
    }
    // 子代理共享父的 worktree：它的退出绝不能把父的工作区拆了
    if g_sess.deleg_depth > 0 {
        return;
    }
    var out: Buf = buf_new(1024);
    defer { buf_free(&out); }
    if !wt_reclaim_own(&out) {
        return;
    }
    agent_worktree_log_cstr("reclaim" as &const byte);
    if g_interactive {
        tty_write(&tty_ui, 2, out.ptr as &const byte, out.len);
    }
}

// ============================================================
// system prompt + tools schema
// ============================================================
// ============================================================
// 提示词状态（P8）：persona/plan 段从 DSH preset 读，读不到用内置默认
// ============================================================
var g_texts: PromptTexts = PromptTexts{
    persona: Buf{ ptr: null, len: 0, cap: 0 },
    plan_section: Buf{ ptr: null, len: 0, cap: 0 },
    instr_max_bytes: 65536,
    loaded_from_preset: false,
};
var g_plan: PlanState = PlanState{ active: false, pending: 0 };

// ============================================================
// P51：待发送的图片附件
//
// **批次语义**：`/image <path>`（或剪贴板贴图）把图挂进 g_pending_imgs，随**下一条**
// 用户消息一起发出，然后清空（对齐 DSH composer 的「附件跟着这一次提交走」）。
// 为什么不直接塞进历史：历史里是「已经发过的消息」，而挂图是一次**部署**动作 ——
// 用户可以连挂三张再敲回车；挂上之后屏幕上立刻有一行占位，用户看得见挂了什么。
//
// 为什么历史里存**路径**而不是字节：一张截图 base64 之后几 MB，几十条消息各带几 MB
// 会把内存与请求缓冲一起顶爆。字节只在**构请求那一刻**从磁盘读一次并立刻编码
// （见 build_chat_request / build_responses_request），历史里只留元数据。
// ============================================================
var g_pending_imgs: ImgList = ImgList{
    items: [ImgRef{
        kind: IMGX_NONE, width: 0, height: 0, bytes: 0,
        path: Buf{ ptr: null, len: 0, cap: 0 }, name: Buf{ ptr: null, len: 0, cap: 0 }
    }: IMGX_MAX_PER_MSG],
    len: 0,
};
var g_pending_ready: bool = false;

// 惰性初始化待发图片表（`g_pending_imgs`）。幂等；`/image`、`ctrl+v`、`/paste` 都先调它。
fn agent_imgs_ensure() void {
    if !g_pending_ready {
        g_pending_imgs = imgx_list_new();
        g_pending_ready = true;
    }
}

// 清空待发图片（**批次语义**：随下一条用户消息发出后清空，对齐 DSH composer 的
// 「附件跟着这一次提交走」，见 §13.1）。
fn agent_imgs_clear() void {
    agent_imgs_ensure();
    imgx_list_free(&g_pending_imgs);
    g_pending_imgs = imgx_list_new();
}

// 附件目录：<agent_home>/attachments（内容寻址落这里，见 imgx_store）。
// 放 agent_home 而不是工作区：切工作区不该让已挂的图失联，而且附件是「这个 agent
// 自己的东西」，跟着会话记录同一个根更好找。
//
// 这里**不能用 g_home**：那个全局只在会话打开时才被 agent_set_home 填上，而 /image
// 可以在滚动模式的 REPL 里、会话还没开（或已经关）的时候敲 —— 实测那时的 g_home 是
// 空的，路径退化成 "/attachments"，mkdir 建不出目录、落盘必然失败。cfg.agent_home
// 是启动时就定下来的，任何时候都有值。
fn agent_attach_dir(cfg: &const Config, out: &Buf) void {
    buf_reset(out);
    if cfg.agent_home.len > 0 {
        _ = buf_append(out, cfg.agent_home.ptr as &const byte, cfg.agent_home.len);
    } else {
        // 兜底：home 没配（cfg 默认空）时用当前目录下的 .uya-agent，至少不写到根上去
        _ = buf_append_cstr(out, ".uya-agent");
    }
    _ = buf_append_cstr(out, "/attachments");
}
var g_todos: TodoState = TodoState{ items: [], n: 0 };
var g_texts_ready: bool = false;
// P13：preset 旋钮（缺省 = DSH 标准 preset 默认值）
var g_knobs: PresetKnobs = PresetKnobs{
    read_limit: 2000,
    read_max_bytes: 51200,
    read_max_line: 2000,
    prune_threshold: 8192,
    prune_head: 4096,
    prune_tail: 1024,
    bash_prune_threshold: 0,      // 0 = 沿用 prune_threshold
    bash_prune_permille: 0,       // 0 = 沿用 1000‰（headChars + tailChars）
    glob_max: 100,
    grep_max: 250,
    grep_line: 2000,
    bash_timeout_ms: 120000,
    instr_max_bytes: 65536,
    compact_threshold_permille: 800,
    retain_permille: 160,
    loaded: false,
};

// 本项目的补充节：Uya 语言要点（DSH 没有，但模型写 Uya 代码时需要）
fn agent_extra_section() &const byte {
    return "Uya language notes for files you write here:\n- Entry point is `export fn main() i32 { ... return 0; }`; print with the built-in `@println(\"text\")`.\n- Variables need explicit types: `const x: i32 = 1;` / `var s: &[const byte] = \"abc\";`. There is no `let`/`mut` and no `i++`.\n- Build and run with `UYA_ROOT=<lib> <uya> build <file> -o <out> && ./<out>`.\n- When writing file content, put real newlines in the string you pass to the write tool; do not double-escape them." as &const byte;
}

// 把 preset 旋钮落到各模块的全局上（缺省值就是 DSH 标准 preset 的值）
fn agent_apply_knobs(cfg: &const Config) void {
    if g_knobs.read_limit > 0 {
        fs_read_limit = g_knobs.read_limit as usize;
    }
    if g_knobs.read_max_bytes > 0 {
        fs_read_max_bytes = g_knobs.read_max_bytes as usize;
    }
    if g_knobs.read_max_line > 0 {
        fs_read_max_line = g_knobs.read_max_line as usize;
    }
    if g_knobs.prune_threshold > 0 {
        cmp_prune_threshold = g_knobs.prune_threshold as usize;
    }
    if g_knobs.prune_head > 0 {
        cmp_prune_head = g_knobs.prune_head as usize;
    }
    if g_knobs.prune_tail > 0 {
        cmp_prune_tail = g_knobs.prune_tail as usize;
    }
    cmp_bash_threshold = 0;
    if g_knobs.bash_prune_threshold > 0 {
        cmp_bash_threshold = g_knobs.bash_prune_threshold as usize;
    }
    cmp_bash_permille = 0;
    if g_knobs.bash_prune_permille > 0 {
        cmp_bash_permille = g_knobs.bash_prune_permille as usize;
    }
    if g_knobs.glob_max > 0 {
        search_glob_max = g_knobs.glob_max as usize;
    }
    if g_knobs.grep_max > 0 {
        search_grep_max = g_knobs.grep_max as usize;
    }
    if g_knobs.grep_line > 0 {
        search_line_max = g_knobs.grep_line as usize;
    }
    if g_knobs.bash_timeout_ms > 0 {
        g_bash_timeout_knob = g_knobs.bash_timeout_ms as u32;
    }
    _ = cfg;
}

// 惰性加载提示词文案与 preset 旋钮（`g_texts` / `g_knobs`，只做一次）。
// 幂等：`g_texts_ready` 已经置上就立刻返回。
fn agent_texts_ensure(cfg: &const Config) void {
    if g_texts_ready {
        return;
    }
    g_knobs = preset_knobs_default();
    prompt_texts_init(cfg.dsh_root.ptr as &const byte, agent_dsh_home(), &g_texts, &g_knobs);
    agent_apply_knobs(cfg);
    plan_init(&g_plan);
    todo_init(&g_todos);
    if cfg.plan {
        plan_set(&g_plan, true);
    }
    g_texts_ready = true;
}

// 组装 system prompt（分节 + 空节丢弃 + "\n\n" 连接）
fn agent_note_answer(text: &const byte, n: usize) void {
    if n == 0 {
        return;
    }
    if !buf_valid(&g_last_answer) {
        g_last_answer = buf_new(n + 64);
    }
    buf_reset(&g_last_answer);
    _ = buf_append(&g_last_answer, text, n);
}

// 取**最终答复**（子代理与 ralph 靠它把结果写回管道）。
// 返回内部全局的切片，调用方不许留存（下一回合会被覆盖）。
export fn agent_last_answer() &[byte] {
    if !buf_valid(&g_last_answer) {
        return &"x"[0: 0];
    }
    return g_last_answer.ptr[0: g_last_answer.len];
}

// P28：这一步是不是「provider 侧缓存被淘汰」？是就记一条事件 + 打一行提示。
// 判据在 compact.uya（cmp_cache_burst）；这里只负责落日志与提示，判错了也不会
// 影响任何请求内容 —— 纯观测，不参与决策。
fn agent_cache_burst_note(cfg: &const Config, o: &const ChatOut) void {
    const prompt: i64 = o.usage_in + o.usage_cache_read;
    if !cmp_cache_burst(o.usage_in, prompt) {
        return;
    }
    var pl: Buf = buf_new(192);
    defer { buf_free(&pl); }
    if !cmp_cache_burst_json(o.usage_in, prompt, o.usage_cache_read, &pl) {
        return;
    }
    if !buf_append_byte(&pl, 0) {
        return;
    }
    agent_log_simple("cache/evicted", pl.ptr as &const byte);
    if cfg.quiet {
        return;
    }
    out_err("[cache] 本步 prompt ");
    out_err_dec(prompt as usize);
    out_err(" 里有 ");
    out_err_dec(o.usage_in as usize);
    out_err(" 未命中：provider 侧缓存淘汰（会话私有块被清，共享前缀还在）—— 重算一次，不是客户端改动\n");
}

// 装配 system prompt：分节（order 升序）+ 空节丢弃 + `{{model}}`/`{{cwd}}` 替换（§5.1）。
// **必须在工作区定下来之后调** —— 这里的 `{{cwd}}`、AGENTS.md 发现、技能目录
// 全按当前工作目录求值（§3.2）。
fn agent_system_prompt(cfg: &const Config, out: &Buf) bool {
    agent_texts_ensure(cfg);
    if !prompt_build_system(cfg, &g_texts, g_plan.active, out) {
        return false;
    }
    // P37：worktree 纪律（对齐 DSH preset 的 renderSection）。没开这个模式时是空串，一个字节不变。
    var wts: Buf = buf_new(2048);
    defer { buf_free(&wts); }
    wt_section_into(&wts);
    if wts.len > 0 {
        if !buf_append_cstr(out, "\n\n") {
            return false;
        }
        if !buf_append(out, wts.ptr as &const byte, wts.len) {
            return false;
        }
    }
    if !buf_append_cstr(out, "\n\n") {
        return false;
    }
    return buf_append_cstr(out, agent_extra_section());
}

// 首次请求前注入：运行时上下文 + AGENTS.md（都是 user 消息，与 DSH 一致）
fn agent_inject_context(cfg: &const Config, h: &History) void {
    if h.len != 1 {
        return;   // 只在「刚建好 system」时注入一次
    }
    var rctx: Buf = buf_new(2048);
    defer { buf_free(&rctx); }
    if prompt_runtime_context(cfg, g_plan.active, &rctx) && rctx.len > 0 {
        _ = hist_push(h, ROLE_USER, rctx.ptr as &const byte, rctx.len);
    }
    g_plan_snap = g_plan.active;   // 这份快照描述了当时的 plan 状态（见 agent_plan_snapshot_sync）
    var set: InstrSet = InstrSet{ items: [], n: 0 };
    instr_init(&set);
    defer { instr_free(&set); }
    var ws: Buf = buf_new(FS_PATH_MAX);
    defer { buf_free(&ws); }
    _ = buf_append(&ws, cfg.workspace.ptr, cfg.workspace.len);
    instr_collect(ws.ptr[0: ws.len], agent_dsh_home(), &set);
    if set.n > 0 {
        var msg: Buf = buf_new((g_texts.instr_max_bytes as usize) + 8192);
        defer { buf_free(&msg); }
        if instr_render(&set, g_texts.instr_max_bytes, &msg) {
            _ = hist_push(h, ROLE_USER, msg.ptr as &const byte, msg.len);
        }
    }
    // P10：技能目录（没有可模型调用的技能就不注入）
    if !g_skills.scanned {
        skills_collect(&g_skills, ws.ptr[0: ws.len], agent_dsh_home(), &cfg.skill_dirs);
    }
    var cat: Buf = buf_new(16384);
    defer { buf_free(&cat); }
    if skills_catalog(&g_skills, &cat) {
        _ = hist_push(h, ROLE_USER, cat.ptr as &const byte, cat.len);
    }
}

// plan 模式：模型看到的运行时上下文只在会话开始时注入一次，运行中切模式（tab / `/plan` /
// 批准退出）必须**再推一份新快照**，否则模型下一轮看到的仍是旧状态 —— 那正是「plan 模式
// 什么都没发生」的另一半原因（访问模式 P21 走的是同一条路子，见 agent_set_access）。
// 记一份「模型已经被告知的状态」，step 边界对不上就补推：一处做完，所有切换路径都覆盖。
var g_plan_snap: bool = false;

// 每个 step 边界比对 `g_plan_snap` 与当前 plan 状态，**变了才**补推一条新的运行时上下文。
// 顺序上放在压缩之后：别刚推就被折进 checkpoint（§3.4 第 g 步）。
fn agent_plan_snapshot_sync(cfg: &const Config, h: &History) void {
    if g_plan_snap == g_plan.active {
        return;
    }
    var rctx: Buf = buf_new(2048);
    defer { buf_free(&rctx); }
    if prompt_runtime_context(cfg, g_plan.active, &rctx) && rctx.len > 0 {
        var pushed: bool = hist_push(h, ROLE_USER, rctx.ptr as &const byte, rctx.len);
        while !pushed {
            if !hist_drop_oldest(h) {
                break;
            }
            pushed = hist_push(h, ROLE_USER, rctx.ptr as &const byte, rctx.len);
        }
    }
    g_plan_snap = g_plan.active;
    var pl: Buf = buf_new(64);
    defer { buf_free(&pl); }
    _ = buf_append_cstr(&pl, "{\"active\":");
    if g_plan.active {
        _ = buf_append_cstr(&pl, "true");
    } else {
        _ = buf_append_cstr(&pl, "false");
    }
    _ = buf_append_cstr(&pl, "}");
    _ = buf_append_byte(&pl, 0);   // agent_log_simple 收的是 C 字符串
    agent_log_simple("plan/mode", pl.ptr as &const byte);
}

// ============================================================
// 工具 schema（P6：改用 DSH 标准模式的原名与参数）
//
// 名字/参数/描述逐字对齐 DSH v0.1.1-rc.2 的 standard preset；schema 是预计算好的
// 字符串常量，每轮拼一次数组即可（不必每轮走 JsonWriter）。
// ============================================================
const TOOL_READ: &const byte = `{"type":"function","function":{"name":"read","description":"Read a UTF-8 text file and return line-numbered content.","parameters":{"type":"object","properties":{"file_path":{"type":"string","description":"Path to read, resolved by the filesystem backend."},"offset":{"type":"number","description":"1-based first line to return. Defaults to 1."},"limit":{"type":"number","description":"Maximum number of lines to return."}},"required":["file_path"]}}}`;

const TOOL_WRITE: &const byte = `{"type":"function","function":{"name":"write","description":"Create or fully replace a UTF-8 text file.","parameters":{"type":"object","properties":{"file_path":{"type":"string","description":"Path to write, resolved by the filesystem backend."},"content":{"type":"string","description":"Full file content. An empty string is legitimate (it writes an empty file)."}},"required":["file_path","content"]}}}`;

const TOOL_EDIT: &const byte = `{"type":"function","function":{"name":"edit","description":"Replace an exact string in a UTF-8 text file. Requires a prior read; the match must be unique unless replace_all is true.","parameters":{"type":"object","properties":{"file_path":{"type":"string","description":"Path to edit, resolved by the filesystem backend."},"old_string":{"type":"string","description":"Exact literal text to replace; must be non-empty."},"new_string":{"type":"string","description":"Replacement text."},"replace_all":{"type":"boolean","description":"Replace every occurrence instead of requiring a unique match. Defaults to false."}},"required":["file_path","old_string","new_string"]}}}`;

const TOOL_GLOB: &const byte = `{"type":"function","function":{"name":"glob","description":"Find file paths matching a glob pattern.","parameters":{"type":"object","properties":{"pattern":{"type":"string","description":"Glob pattern. Without a slash it matches the basename at any depth, so * matches the whole tree."},"path":{"type":"string","description":"Optional directory to search; defaults to the working directory."}},"required":["pattern"]}}}`;

const TOOL_GREP: &const byte = `{"type":"function","function":{"name":"grep","description":"Search file contents with a ripgrep regular expression.","parameters":{"type":"object","properties":{"pattern":{"type":"string","description":"ripgrep regex."},"path":{"type":"string","description":"Optional file or directory target; defaults to the working directory."},"include":{"type":"string","description":"ONE positive glob filter (no leading '!' and no comma list)."}},"required":["pattern"]}}}`;

const TOOL_BASH: &const byte = `{"type":"function","function":{"name":"bash","description":"Run a bash command and return stdout, an optional [stderr] section, then applicable markers ([exit code: N], [timed out after Nms], [killed by signal: N], [stopped by signal: N]). Check the [exit code: N] marker on every result; investigate failures before moving on. Commands get no terminal: stdin is /dev/null and the command runs in its own session.","parameters":{"type":"object","properties":{"command":{"type":"string","description":"Command to run via bash -c. No state persists between calls; use workdir rather than cd. There is no TTY, so interactive prompts (password/credential prompts, editors) cannot work and will fail fast instead of waiting."},"description":{"type":"string","description":"One-line active-voice summary of the command (5-10 words), for display only."},"timeoutMs":{"type":"number","description":"Timeout override in milliseconds."},"workdir":{"type":"string","description":"Working directory for this call; defaults to the working directory."},"run_in_background":{"type":"boolean","description":"Return a job id immediately; no timeout applies."}},"required":["command","description"]}}}`;

const TOOL_JOB_LIST: &const byte = `{"type":"function","function":{"name":"job_list","description":"List the background jobs visible to this agent.","parameters":{"type":"object","properties":{}}}}`;

const TOOL_JOB_OUTPUT: &const byte = `{"type":"function","function":{"name":"job_output","description":"Read a background job's output. Incremental by default: only new output since the previous read.","parameters":{"type":"object","properties":{"job_id":{"type":"string","description":"Job id returned when the job started."},"wait":{"type":"boolean","description":"Block until the job finishes or the timeout expires."},"timeout_ms":{"type":"number","description":"Wait budget in milliseconds (default 30000, max 600000)."}},"required":["job_id"]}}}`;

const TOOL_JOB_KILL: &const byte = `{"type":"function","function":{"name":"job_kill","description":"Request cancellation of a background job.","parameters":{"type":"object","properties":{"job_id":{"type":"string","description":"Job id to cancel."},"reason":{"type":"string","description":"Optional short reason."}},"required":["job_id"]}}}`;

// P34：工作区（报告 / 切换）。始终可见 —— 与 todo/plan/ask 同一条口径：工具目录跨模式稳定
const TOOL_WORKSPACE: &const byte = `{"type":"function","function":{"name":"workspace","description":"Report or switch the current session's workspace: the directory that every file, bash and /diff operation resolves against. Call it with no arguments to see where you are; pass path to move there. A switch takes effect immediately for later tool calls, moves the path guard, the bash sandbox root, the terminal footer and /diff with it, and it is recorded in the session log as a session/workspace event, so a resumed session comes back to the same place. Outside full access the user must approve each switch, and it fails closed when there is nobody to ask (non-interactive or subagent).","parameters":{"type":"object","properties":{"path":{"type":"string","description":"Directory to switch to: absolute, or relative to the current workspace. It must exist and be a directory. Omit it to just report the current workspace."}}}}}`;

const TOOL_WORKTREE: &const byte = `{"type":"function","function":{"name":"worktree","description":"The Git worktree this session works in. This session was started in its own worktree (a separate branch of the same repository), so all of your work lands there and the shared checkout stays untouched. Actions: start (provision a worktree if this session has none), status (the current diff, commit count, and uncommitted paths), finish (commit anything pending, merge your branch into the base branch in the shared checkout, then REMOVE the worktree and delete the branch), discard (remove the worktree and delete its branch without merging), list (leftover session worktrees in this repository), reclaim (delete the abandoned session worktrees of this repository that are provably junk: clean, with zero commits of their own, and with no live process inside, plus the leftover dsh/* branches whose worktree is already gone and that carry no commits of their own — anything that still holds uncommitted or unmerged work is always kept). Call finish only when the work is complete and verified; subagents must never call finish or discard on their parent's worktree.","parameters":{"type":"object","properties":{"action":{"type":"string","enum":["start","status","finish","discard","list","reclaim"],"description":"start (provision) | status (report) | finish (merge to base and clean up) | discard (clean up without merging) | list (leftover worktrees) | reclaim (delete the abandoned worktrees and leftover branches that are provably junk)."},"message":{"type":"string","description":"Commit message for \"finish\" when it has to commit pending changes or create the merge commit. Omit to use a generated one."},"keepWorktree":{"type":"boolean","description":"For \"finish\" only: merge but leave the worktree in place for inspection. Defaults to false — the worktree is removed after a successful merge."}},"required":["action"]}}}`;

// P46：会话标题。它只影响终端窗口/标签页标题与 /sessions 列表的标题列 —— 不改任务、不改历史。
const TOOL_SET_TITLE: &const byte = `{"type":"function","function":{"name":"set_title","description":"Rename this session: the title becomes the terminal window/tab title (OSC 2) and the title column of the session list. Call it when the session's topic has clearly moved on from the auto-generated title, or once you understand what the task actually is. Set it in the user's language, name the concrete task (files, subsystem, error string) rather than the general area, and keep it short — at most 5 words / 40 bytes. A title you set is pinned: it will not be overwritten by automatic titling, so set it deliberately and not more than once or twice per session. Passing an empty title clears it back to the default (the automatic titling resumes).","parameters":{"type":"object","properties":{"title":{"type":"string","description":"The new session title: one line, at most 5 words / 40 bytes, in the user's language. Pass an empty string to clear it back to the default title."}},"required":["title"]}}}`;

const TOOL_TODO: &const byte = `{"type":"function","function":{"name":"todo_write","description":"Record and update a structured task list for the current work. Send the ENTIRE list every call — it REPLACES the previous list (there are no partial updates, no per-item edits). Use it to plan multi-step work and show progress: add one todo per concrete step before you start. Mark every todo being actively worked on \u0060in_progress\u0060 — several at once when work genuinely runs in parallel (e.g. concurrent subagents or background commands), one for sequential work; while work remains, at least one task should be \u0060in_progress\u0060. Mark a todo \u0060completed\u0060 the moment it is done (do not batch completions), and allow no \u0060in_progress\u0060 item only once all work is complete. Skip the list for trivial single-step tasks.","parameters":{"type":"object","properties":{"todos":{"type":"array","description":"The COMPLETE task list, replacing any previous list.","items":{"type":"object","additionalProperties":false,"properties":{"content":{"type":"string","description":"What the task is — a short imperative line."},"status":{"type":"string","enum":["pending","in_progress","completed"],"description":"pending (not started) | in_progress (now) | completed (done)."}},"required":["content","status"]}}},"required":["todos"]}}}`;

const TOOL_EXIT_PLAN: &const byte = `{"type":"function","function":{"name":"exit_plan_mode","description":"Use only in plan mode. Present your plan for the user's review and, on approval, leave plan mode. Send the COMPLETE plan as markdown, starting with a # heading that names it. The user reviews it in a dialog and either approves (carry out the plan from your next step), asks for a revision (keep planning and present it again), or dismisses it to speak instead (stay in plan mode and wait for their message); the decision comes back in the tool result.","parameters":{"type":"object","properties":{"plan":{"type":"string","description":"The complete plan as markdown, starting with a # heading that names it."}},"required":["plan"]}}}`;

const TOOL_ASK_USER: &const byte = `{"type":"function","function":{"name":"ask_user_question","description":"Ask the user a blocking question and return their answer as JSON.","parameters":{"type":"object","properties":{"questions":{"type":"array","description":"One or more questions to ask.","items":{"type":"object","properties":{"id":{"type":"string","description":"Stable id echoed back in the answer."},"question":{"type":"string","description":"The question to show the user."},"header":{"type":"string","description":"Optional short heading."},"options":{"type":"array","description":"Optional choices.","items":{"type":"object","properties":{"label":{"type":"string"},"description":{"type":"string"}},"required":["label"]}},"multi_select":{"type":"boolean","description":"Allow selecting more than one option."}},"required":["id","question"]}}},"required":["questions"]}}}`;

const TOOL_SKILL: &const byte = `{"type":"function","function":{"name":"skill","description":"Load the full instructions for an available skill.","parameters":{"type":"object","properties":{"name":{"type":"string","description":"Exact skill name from the available-skills catalog."}},"required":["name"]}}}`;

const TOOL_WEB_SEARCH: &const byte = `{"type":"function","function":{"name":"web_search","description":"Search the web with one or more queries and return an answer plus source URLs.","parameters":{"type":"object","properties":{"queries":{"type":"array","description":"1-4 search queries; duplicates are collapsed.","items":{"type":"string"}}},"required":["queries"]}}}`;

const TOOL_SUBAGENT: &const byte = `{"type":"function","function":{"name":"subagent","description":"Delegate a self-contained task to a subagent (a separate agent that works in its own context) to offload focused, independent work — research, a scoped implementation, an analysis — so it does not consume this conversation's context. The subagent returns its result, not its intermediate steps. Give it a complete, standalone prompt: it does not see this conversation.","parameters":{"type":"object","properties":{"prompt":{"type":"string","description":"The complete, self-contained task for the subagent."},"description":{"type":"string","description":"Short (3-5 word) description of the delegated task, for display."},"run_in_background":{"type":"boolean","description":"Run in the background and return an id immediately. Defaults to true."}},"required":["prompt","description"]}}}`;

const TOOL_SUBAGENT_FORK: &const byte = `{"type":"function","function":{"name":"subagent_fork","description":"Delegate a task to a subagent that inherits this conversation: a child agent seeded with all completed turns so far (it does not see the current in-flight turn). Use this when the subtask builds on this conversation's context — a follow-up analysis, a review, a continuation — without consuming this conversation's context for the work itself.","parameters":{"type":"object","properties":{"prompt":{"type":"string","description":"The task for the subagent. It already sees this conversation's completed turns, so build on them freely and state only what is new."},"description":{"type":"string","description":"Short (3-5 word) description of the delegated task, for display."},"run_in_background":{"type":"boolean","description":"Run in the background and return an id immediately. Defaults to true."}},"required":["prompt","description"]}}}`;

const TOOL_LIST_AGENTS: &const byte = `{"type":"function","function":{"name":"list_agents","description":"List your continuable subagents by durable id and label. Use it to recall which ones you started, not to poll for completion.","parameters":{"type":"object","properties":{}}}}`;

const TOOL_SUBAGENT_OUTPUT: &const byte = `{"type":"function","function":{"name":"subagent_output","description":"Read a background subagent's output. Incremental by default: only new output since the previous read.","parameters":{"type":"object","properties":{"subagent_id":{"type":"string","description":"Id returned when the subagent started."},"wait":{"type":"boolean","description":"Block until the subagent finishes or the timeout expires."}},"required":["subagent_id"]}}}`;

const TOOL_SEND_MESSAGE: &const byte = `{"type":"function","function":{"name":"send_message","description":"Send a message to a subagent by its id, continuing the same conversation. Use it to give it more work; the reply arrives later as a notice.","parameters":{"type":"object","properties":{"subagent_id":{"type":"string","description":"Id of the subagent to continue."},"message":{"type":"string","description":"The message to deliver."}},"required":["subagent_id","message"]}}}`;

const TOOL_INTERRUPT_AGENT: &const byte = `{"type":"function","function":{"name":"interrupt_agent","description":"Request cancellation of a subagent's current turn by its id.","parameters":{"type":"object","properties":{"subagent_id":{"type":"string","description":"Id of the subagent to interrupt."}},"required":["subagent_id"]}}}`;

const TOOL_RALPH: &const byte = `{"type":"function","function":{"name":"ralph","description":"Run a foreground fresh-agent Ralph loop toward one immutable objective. Use only when the direct human explicitly asks for Ralph or fresh-agent iteration. Each round opens a new child with no parent conversation or prior child session; the shared workspace is long-term memory, and only a bounded structured report crosses rounds. The call returns when a worker reports completion or a concrete blocker, or at the round limit.","parameters":{"type":"object","properties":{"objective":{"type":"string","description":"The immutable completion objective for every fresh Ralph round."},"maxRounds":{"type":"number","description":"Optional positive round cap."}},"required":["objective"]}}}`;

const TOOL_CREATE_GOAL: &const byte = `{"type":"function","function":{"name":"create_goal","description":"Create one persisted same-session completion goal when the current direct human request is a long-running objective that should continue across autonomous goal rounds. You may infer that intent without requiring the user to say \u0060create a goal\u0060. Do not use this for trivial single-turn work.","parameters":{"type":"object","properties":{"objective":{"type":"string","description":"The concrete completion objective inferred from the direct human request."},"max_goal_rounds":{"type":"number","description":"Optional positive safe-integer limit on automatic continuation rounds."}},"required":["objective"]}}}`;

const TOOL_GET_GOAL: &const byte = `{"type":"function","function":{"name":"get_goal","description":"Read the current same-session goal, including its exact id/revision, objective, phase, completed continuation rounds, round limit, blocker reason when present, and whether another continuation is armed. Call this before updating a goal.","parameters":{"type":"object","properties":{}}}}`;

const TOOL_UPDATE_GOAL: &const byte = `{"type":"function","function":{"name":"update_goal","description":"Update the exact current goal revision. edit, pause, and resume require a direct top-level human request. During an automatic continuation of the current goal, complete and blocked are also allowed. blocked is rejected before the configured minimum round count; the model remains responsible for judging that the same condition persisted across those rounds and must explain it in blocked_reason.","parameters":{"type":"object","properties":{"goal_id":{"type":"string","description":"Exact id returned by get_goal."},"revision":{"type":"number","description":"Exact positive revision returned by get_goal."},"action":{"type":"string","description":"edit | pause | resume | complete | blocked","enum":["edit","pause","resume","complete","blocked"]},"objective":{"type":"string","description":"Replacement objective; valid only with action edit."},"blocked_reason":{"type":"string","description":"Concrete blocking condition; required only with action blocked."}},"required":["goal_id","revision","action"]}}}`;

const TOOL_WORKFLOW: &const byte = `{"type":"function","function":{"name":"workflow","description":"Run a Uya workflow script that orchestrates subagents at scale. Use this for work that fans out across many independent pieces — an audit over many files, a migration, multi-angle research, adversarial verification of findings — where you write the orchestration as a script instead of delegating turn by turn.","parameters":{"type":"object","properties":{"script":{"type":"string","description":"The plain Uya script body ONLY (a .ush file run with uya run; NOT TypeScript). Top-level code is allowed; call wf_agent(prompt, label), wf_agent_start/wf_agent_wait, wf_parallel_*, wf_phase(title), wf_log(message), wf_args(), wf_done(result) from the generated hooks module; end by calling wf_done(<result>)."},"meta":{"type":"object","description":"The workflow identity block (plain JSON — never code).","properties":{"name":{"type":"string","description":"Short kebab-case workflow name."},"description":{"type":"string","description":"One-line description of what the workflow does."},"whenToUse":{"type":"string","description":"Optional guidance on when this workflow applies."},"phases":{"type":"array","description":"Optional phase declarations matched by wf_phase() calls.","items":{"type":"object","properties":{"title":{"type":"string","description":"The phase title wf_phase() calls match by exact string."},"detail":{"type":"string","description":"Optional one-line description of the phase."}},"required":["title"]}}},"required":["name","description"]},"args":{"type":"object","description":"Optional JSON input exposed to the script as the wf_args() text."}},"required":["script","meta"]}}}`;

const TOOL_RUN_SHELL: &const byte = `{"type":"function","function":{"name":"run_shell","description":"在工作目录下执行 shell 命令，返回 stdout+stderr 与退出码。","parameters":{"type":"object","properties":{"command":{"type":"string","description":"shell 命令"},"timeout_ms":{"type":"integer","description":"超时毫秒，默认 120000"}},"required":["command"]}}}`;

// 工具 schema：
//   flat = false → chat/completions 形状（{"type":"function","function":{…}}）原样拼接
//   flat = true  → Responses 形状（{"type":"function","name":…,"parameters":…}）
// Responses 用「去前缀 + 去末尾大括号」的文本变换，而不是再抄 26 份常量：常量形状唯一，
// 变换后顶层键正好是 type/name/description/parameters（自测逐个 parse 校验过）。
const TOOL_FLAT_STRIP: &const byte = `{"type":"function","function":{`;   // 31 字节

// 把一条工具 schema 追加进 out；`flat = true` 时做 Responses 形状的文本变换
// （`TOOL_FLAT_STRIP` 去前缀 + 去尾大括号）—— **只有一份 schema 真值**，两边不会漂移。
fn tools_put(out: &Buf, tool: &const byte, flat: bool) bool {
    if out.len > 1 && !buf_append_byte(out, 44) {   // 44 = ','
        return false;
    }
    if !flat {
        return buf_append_cstr(out, tool);
    }
    const n: usize = bufx_cstr_len(tool);
    if n < 33 || !bufx_eq_cstr(tool, 31, TOOL_FLAT_STRIP) {
        out_err("error: tool schema constant is not in the expected chat shape\n");
        return false;
    }
    if !buf_append_cstr(out, `{"type":"function",`) {
        return false;
    }
    return buf_append_span(out, tool, 31, n - 32);
}

// 按**固定顺序**拼出全部 28 个工具的 schema 数组（§6.1）。
// `allow_shell = false` 时 bash/job_* 整组不出现（`--no-shell`）；其余分组**跨模式恒定可见**，
// 这样前缀缓存不会因为「模式变了」而失效。
fn tools_json(out: &Buf, allow_shell: bool, flat: bool) bool {
    buf_reset(out);
    if !buf_append_byte(out, 91) {
        return false;
    }
    if !tools_put(out, TOOL_READ, flat) {
        return false;
    }
    if !tools_put(out, TOOL_WRITE, flat) {
        return false;
    }
    if !tools_put(out, TOOL_EDIT, flat) {
        return false;
    }
    if !tools_put(out, TOOL_GLOB, flat) {
        return false;
    }
    if !tools_put(out, TOOL_GREP, flat) {
        return false;
    }
    if allow_shell {
        if !tools_put(out, TOOL_BASH, flat) {
            return false;
        }
        if !tools_put(out, TOOL_JOB_LIST, flat) {
            return false;
        }
        if !tools_put(out, TOOL_JOB_OUTPUT, flat) {
            return false;
        }
        if !tools_put(out, TOOL_JOB_KILL, flat) {
            return false;
        }
    }
    // todo / plan / ask_user 始终可见（DSH：工具目录跨模式稳定）
    // P34：workspace（报告/切换当前会话的工作区）同样始终可见
    if !tools_put(out, TOOL_WORKSPACE, flat) {
        return false;
    }
    if !tools_put(out, TOOL_WORKTREE, flat) {
        return false;
    }
    // P46：会话标题（模型也能改；它只动标题，不动历史 —— 与 workspace/worktree 同一条口径）
    if !tools_put(out, TOOL_SET_TITLE, flat) {
        return false;
    }
    if !tools_put(out, TOOL_TODO, flat) {
        return false;
    }
    if !tools_put(out, TOOL_EXIT_PLAN, flat) {
        return false;
    }
    if !tools_put(out, TOOL_ASK_USER, flat) {
        return false;
    }
    if !tools_put(out, TOOL_SKILL, flat) {
        return false;
    }
    if !tools_put(out, TOOL_WEB_SEARCH, flat) {
        return false;
    }
    // P11：派生一族
    if !tools_put(out, TOOL_SUBAGENT, flat) {
        return false;
    }
    if !tools_put(out, TOOL_SUBAGENT_FORK, flat) {
        return false;
    }
    if !tools_put(out, TOOL_LIST_AGENTS, flat) {
        return false;
    }
    if !tools_put(out, TOOL_SUBAGENT_OUTPUT, flat) {
        return false;
    }
    if !tools_put(out, TOOL_SEND_MESSAGE, flat) {
        return false;
    }
    if !tools_put(out, TOOL_INTERRUPT_AGENT, flat) {
        return false;
    }
    if !tools_put(out, TOOL_RALPH, flat) {
        return false;
    }
    if !tools_put(out, TOOL_CREATE_GOAL, flat) {
        return false;
    }
    if !tools_put(out, TOOL_GET_GOAL, flat) {
        return false;
    }
    if !tools_put(out, TOOL_UPDATE_GOAL, flat) {
        return false;
    }
    if !tools_put(out, TOOL_WORKFLOW, flat) {
        return false;
    }
    return buf_append_byte(out, 93);
}

// ============================================================
// 文件系统工具的运行上下文（进程级；子代理是 fork 的独立进程，各有一份）
// ============================================================
var g_fsctx: FsCtx = FsCtx{ workspace: null, workspace_len: 0, confine: false };
var g_fsobs: FsObsTable = FsObsTable{ items: [], n: 0 };

// 回合前的**统一初始化**（全部幂等）：权限模式 → 沙箱探测（fail closed）、`jobs_init`、
// `deleg_init`、显示层与 diff 层初始化、文件工具上下文 `g_fsctx`。见 §3.2 的表。
fn fsctx_init(cfg: &const Config) void {
    g_fsctx.workspace = cfg.workspace.ptr as &const byte;
    g_fsctx.workspace_len = cfg.workspace.len;
    // P21：访问模式是进程级运行期状态（运行中可切），工作区守卫由它推出
    perm_sync_from_cfg(cfg.access);
    g_fsctx.confine = perm_confine();
    // P21：沙箱后端探测（进程级缓存；--no-sandbox 时根本不探）
    if cfg.sandbox == SAN_AUTO {
        if cfg.bwrap.len > 0 {
            san_set_bwrap(cfg.bwrap.ptr as &const byte, cfg.bwrap.len);
        }
        _ = san_probe(false);
    }
    fs_obs_init(&g_fsobs);
    jobs_init(&g_jobs);
    deleg_init(&g_deleg);
    // P14：显示层与 diff 采集（--quiet / 子代理 = quiet 时整层关闭）。
    // REPL 每轮都会走到这里，所以两个 init 都必须是幂等的。
    view_init(!cfg.quiet, cfg_tool_lines(cfg));
    diffx_init(!cfg.quiet, cfg_tool_lines(cfg));
}

// --tool-lines 的取值（负数当 0；0 表示不显示正文）
fn cfg_tool_lines(cfg: &const Config) usize {
    if cfg.tool_lines <= 0 {
        return 0;
    }
    return cfg.tool_lines as usize;
}

// ============================================================
// 组装请求
// ============================================================

// ============================================================
// P51：把一条 user 消息上的附件写进请求体
//
// 两种协议的形状不一样（实测过网关都收）：
//   * completions：content 是数组，图片项 {"type":"image_url",
//                  "image_url":{"url":"data:<mime>;base64,..."}}；
//   * responses  ：{"type":"input_image","detail":"auto","image_url":"data:..."}。
// 文本项由调用方先写（两种协议的文本项形状也不同，见各自的调用点）。
//
// 为什么字节在这里才读：历史里只存路径（见 g_pending_imgs 的说明）。读不到或编码
// 失败就**只发文本**并留一条诊断 —— 宁可少一张图，也不能让整轮请求失败。
// ============================================================
fn agent_emit_images_json(w: &JsonWriter, att: &const byte, att_len: usize, resp_style: bool) bool {
    if att_len == 0 {
        return true;
    }
    var list: ImgList = imgx_list_new();
    defer { imgx_list_free(&list); }
    if !imgx_list_parse(att, att_len, &list) {
        return true;   // 认不出来就当没有附件（坏记录不该废掉整轮）
    }
    var i: usize = 0;
    while i < list.len {
        const r: &const ImgRef = &list.items[i];
        var raw: Buf = buf_new(1 << 16);
        defer { buf_free(&raw); }
        i = i + 1;
        if !imgx_load(r.path.ptr as &const byte, r.path.len, &raw) || raw.len == 0 {
            out_diag("image", "error: 附件读不到（已跳过）：", r.path.ptr as &const byte, r.path.len);
            continue;
        }
        var b64: Buf = buf_new((raw.len / 3 + 2) * 4 + 16);
        defer { buf_free(&b64); }
        if !imgx_b64(raw.ptr as &const byte, raw.len, &b64) {
            out_diag("image", "error: 附件 base64 编码失败（已跳过）：", r.path.ptr as &const byte, r.path.len);
            continue;
        }
        // 先拼 data URI（避免在 jw_str 里嵌套转义逻辑）
        var uri: Buf = buf_new(b64.len + 64);
        defer { buf_free(&uri); }
        _ = buf_append_cstr(&uri, "data:");
        _ = buf_append_cstr(&uri, imgx_mime(r.kind));
        _ = buf_append_cstr(&uri, ";base64,");
        _ = buf_append(&uri, b64.ptr as &const byte, b64.len);

        jw_byte(w, 44);
        jw_byte(w, 123);
        jw_key(w, "type");
        if resp_style {
            jw_str_cstr(w, "input_image");
            jw_byte(w, 44);
            jw_key(w, "detail");
            jw_str_cstr(w, "auto");
            jw_byte(w, 44);
            jw_key(w, "image_url");
            jw_str(w, uri.ptr, uri.len);
        } else {
            jw_str_cstr(w, "image_url");
            jw_byte(w, 44);
            jw_key(w, "image_url");
            jw_byte(w, 123);
            jw_key(w, "url");
            jw_str(w, uri.ptr, uri.len);
            jw_byte(w, 125);
        }
        jw_byte(w, 125);
    }
    return true;
}

// 请求缓冲要装得下「附件读进来再 base64」的那一份（4/3 膨胀 + data URI 前缀）。
// 不把这一份算进去的话，构请求会在 jw_overflow 上静默失败（见 request_bytes_needed）。
fn agent_request_img_extra(h: &const History) usize {
    var total: usize = 0;
    var i: usize = 0;
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        if m.role == ROLE_USER && m.extra_len > 0 {
            var list: ImgList = imgx_list_new();
            defer { imgx_list_free(&list); }
            if imgx_list_parse(m.extra as &const byte, m.extra_len, &list) {
                var k: usize = 0;
                while k < list.len {
                    total = total + list.items[k].bytes;
                    k = k + 1;
                }
            }
        }
        i = i + 1;
    }
    if total == 0 {
        return 0;
    }
    return total + (total / 3) + 4096;
}

// 估出这一次请求要多大的缓冲：`h.bytes*2 + 8192 + 8192 + model.len*2 + img_extra`。
// 多算不亏（够用一次分配），少算就是构请求失败。
fn request_bytes_needed(h: &const History, cfg: &const Config) usize {
    const overhead: usize = 8192;
    const tools_max: usize = 8192;   // 全部工具 schema 的上界
    // P51：附件要按「读进来 + base64」之后的大小算（4/3 膨胀）。不算这一份的话，
    // 挂一张大图就会让构请求在 jw_overflow 上静默失败（请求体被截断）。
    const img_extra: usize = agent_request_img_extra(h);
    return h.bytes * 2 + overhead + tools_max + cfg.model.len * 2 + img_extra;
}


// ============================================================
// P51：把「一条用户消息 + 待发图片」写进历史，并在成功时清空待发列表
//
// 三个入口（一次性任务 / 滚动模式 REPL / TUI 主循环）必须**完全同口径** —— 图片挂上
// 之后属于这一条消息，发出去就清空；写入失败（OOM/丢老消息也救不回来）时**不清空**，
// 否则图会静默消失而用户已经看到占位行了。返回 false = 没写进去。
// ============================================================
// 附件占位行：在用户条目**后面**补一行（TUI 走转录条目，滚动模式直接打）。
// 终端不渲染图片，这一行就是「这条消息带了图」的全部证据 —— 所以宽高与大小都要真的。
fn agent_echo_imgs(att: &const Buf, have_att: &const bool) void {
    if !have_att[0] || att.len == 0 {
        return;
    }
    var list: ImgList = imgx_list_new();
    defer { imgx_list_free(&list); }
    if !imgx_list_parse(att.ptr as &const byte, att.len, &list) || list.len == 0 {
        return;
    }
    var lbl: Buf = buf_new(1024);
    defer { buf_free(&lbl); }
    imgx_labels(&list, &lbl);
    if lbl.len == 0 {
        return;
    }
    if tui_active() {
        tui_add_notice(lbl.ptr as &const byte, lbl.len);
        tui_mark_dirty();
        return;
    }
    tty_puts(&tty_ui, 2, "[image] ");
    tty_write(&tty_ui, 2, lbl.ptr as &const byte, lbl.len);
    tty_puts(&tty_ui, 2, "\n");
}

// 把用户消息连同**待发图片**压进历史，并把 attachments JSON 回传（记日志用）。
// 有图时该条消息的 content 变成**数组** `[{type:text},{type:image_url,…}]`（§13.1）。
fn agent_push_user_with_imgs(h: &History, line: &const Buf, att_out: &Buf, have_out: &bool) bool {
    agent_imgs_ensure();
    buf_reset(att_out);
    have_out[0] = false;
    if g_pending_imgs.len > 0 && imgx_list_json(&g_pending_imgs, att_out) && att_out.len > 0 {
        have_out[0] = true;
    }
    var pushed: bool = if have_out[0] {
        hist_push_msg(h, ROLE_USER, line.ptr as &const byte, line.len, att_out.ptr as &const byte, att_out.len)
    } else {
        hist_push(h, ROLE_USER, line.ptr as &const byte, line.len)
    };
    while !pushed {
        if !hist_drop_oldest(h) {
            break;
        }
        pushed = if have_out[0] {
            hist_push_msg(h, ROLE_USER, line.ptr as &const byte, line.len, att_out.ptr as &const byte, att_out.len)
        } else {
            hist_push(h, ROLE_USER, line.ptr as &const byte, line.len)
        };
    }
    if pushed && have_out[0] {
        agent_imgs_clear();
    }
    return pushed;
}

// 构 `chat/completions` 请求体。**字段顺序固定**：model / messages / stream /
// stream_options / tools / temperature / max_tokens / reasoning_effort —— 顺序稳定是为了
// 保住提供方的 KV 前缀缓存（字段插在中间会让缓存全失效）。
// tool 结果在**构请求这一层**过 `cmp_maybe_prune_kind`（剪枝不动历史，§5.3.1）。
fn build_chat_request(cfg: &const Config, h: &const History, out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "model");
    jw_str(&w, cfg.model.ptr, cfg.model.len);
    jw_byte(&w, 44);
    jw_key(&w, "messages");
    jw_byte(&w, 91);
    var i: usize = 0;
    while i < h.len {
        if i > 0 {
            jw_byte(&w, 44);
        }
        jw_byte(&w, 123);
        jw_key(&w, "role");
        jw_str_cstr(&w, role_cstr(msg_at(h, i).role));
        jw_byte(&w, 44);
        jw_key(&w, "content");
        const m_txt_len: usize = msg_at(h, i).text_len;
        // P51：user 消息带附件时 content 必须变成**数组**（[{"type":"text"},{"type":"image_url"}]）。
        // 这是两种协议的硬形状：字符串 content 与图片项不能混用（实测网关会拒）。
        const is_user_img: bool = msg_at(h, i).role == ROLE_USER && msg_at(h, i).extra_len > 0;
        if is_user_img {
            jw_byte(&w, 91);
            jw_byte(&w, 123);
            jw_key(&w, "type");
            jw_str_cstr(&w, "text");
            jw_byte(&w, 44);
            jw_key(&w, "text");
            jw_str(&w, msg_at(h, i).text, m_txt_len);
            jw_byte(&w, 125);
            _ = agent_emit_images_json(&w, msg_at(h, i).extra as &const byte, msg_at(h, i).extra_len, false);
            jw_byte(&w, 93);
        } else if m_txt_len > 0 {
            const m_txt: &byte = msg_at(h, i).text;
            // P9：工具结果过大时在**构请求**这一层剪掉中段（历史保持不变，天然幂等）
            var pruned: Buf = buf_empty();
            defer { buf_free(&pruned); }
            if msg_at(h, i).role == ROLE_TOOL && cmp_maybe_prune_kind(m_txt as &const byte, m_txt_len, msg_at(h, i).kind, &pruned) {
                jw_str(&w, pruned.ptr, pruned.len);
            } else {
                jw_str(&w, m_txt, m_txt_len);
            }
        } else {
            // DSH：只有工具调用时 content 是空串（不是 null）
            jw_str_cstr(&w, "");
        }
        if msg_at(h, i).role == ROLE_ASSISTANT_CALLS && msg_at(h, i).extra_len > 0 {
            jw_byte(&w, 44);
            jw_key(&w, "tool_calls");
            // extra 是已经序列化好的 tool_calls 数组原文，直接内联，绝不二次转义
            jw_raw(&w, msg_at(h, i).extra as &const byte, msg_at(h, i).extra_len);
        }
        if msg_at(h, i).role == ROLE_TOOL && msg_at(h, i).extra_len > 0 {
            jw_byte(&w, 44);
            jw_key(&w, "tool_call_id");
            jw_str(&w, msg_at(h, i).extra, msg_at(h, i).extra_len);
        }
        jw_byte(&w, 125);
        i = i + 1;
    }
    jw_byte(&w, 93);
    // 字段顺序对齐 DSH：model, messages, stream, stream_options, tools, temperature, max_tokens
    // （OpenAI 兼容端点上顺序不影响语义，但固定顺序让 KV 缓存前缀稳定、也便于自测断言）
    jw_byte(&w, 44);
    jw_key(&w, "stream");
    jw_bool(&w, cfg.stream);
    if cfg.stream && cfg.stream_options {
        jw_byte(&w, 44);
        jw_key(&w, "stream_options");
        jw_byte(&w, 123);
        jw_key(&w, "include_usage");
        jw_bool(&w, true);
        jw_byte(&w, 125);
    }
    jw_byte(&w, 44);
    jw_key(&w, "tools");
    if !tools_json(&g_tools_scratch, cfg.allow_shell, false) {
        return false;
    }
    jw_raw(&w, g_tools_scratch.ptr as &const byte, g_tools_scratch.len);
    if cfg.temperature >= 0 {
        jw_byte(&w, 44);
        jw_key(&w, "temperature");
        jw_i64(&w, cfg.temperature as i64);
    }
    if cfg.max_tokens > 0 {
        jw_byte(&w, 44);
        jw_key(&w, "max_tokens");
        jw_i64(&w, cfg.max_tokens);
    }
    // 推理强度：completions 走顶层 reasoning_effort（responses 走 reasoning.effort）。
    // 曾经只发 responses，于是 --effort / DSH 的 agent-default-model.reasoningEffort
    // 在默认的 openai-completions 路由上被静默丢弃（见 §16 踩坑 71）。
    // 与 responses 同一条门槛：compat.supportsReasoningEffort=false 时不发。
    //
    // P56：`off`/`none` 不再「干脆不发字段」。实测（autodl 网关、同一道题各 3 发）：
    //   不发字段 → 网关按自己的默认档思考，completion 中位 755（其中 reasoning 647）
    //   发 `"none"` → reasoning 恒为 0，completion 中位 214，正文还更长
    // 也就是「不发」≠「关掉」：用户设 off 想要的是后者。settings.yaml 里该 provider 的
    // `reasoningEfforts` 映射写的正是 `off: none`（全仓唯一一份映射，值就是 none），
    // 所以这里按它把 off 翻成线上值 none 再发 —— DSH 走的是同一条语义（实测 DSH off → 135 tok）。
    if cfg.api_reasoning && cfg.reasoning_effort.len > 0 {
        const eff_off: bool = sv_eq_cstr(&cfg.reasoning_effort, "off" as &const byte)
            || sv_eq_cstr(&cfg.reasoning_effort, "none" as &const byte);
        jw_byte(&w, 44);
        jw_key(&w, "reasoning_effort");
        if eff_off {
            jw_str(&w, "none" as &const byte, 4);
        } else {
            jw_str(&w, cfg.reasoning_effort.ptr, cfg.reasoning_effort.len);
        }
    }
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// ============================================================
// 组装请求：Responses（POST {base_url}/responses）
//
// 与 chat 的差别只在「外壳」：历史消息 → input items、工具 schema 扁平化、
// max_tokens → max_output_tokens。内部历史/会话日志格式完全不动，映射只发生在这一刻。
// 字段顺序固定，便于断言与 KV 前缀稳定：
//   model, input, stream, store, tools, temperature, max_output_tokens, reasoning
// ============================================================
const RESP_MSG_MIN_TOKENS: i64 = 16;   // OpenAI 拒绝 max_output_tokens < 16

// call_id 只回放 '|' 前那段（DSH 会话里可能是 "call_x|fc_y"；item id 不回放，
// 与 pi-ai 的「外来消息」路径一致，省掉 fc_*/rs_* 的配对校验）
fn resp_id_before_pipe(p: &const byte, n: usize, w: &JsonWriter) void {
    var cut: usize = n;
    var i: usize = 0;
    while i < n {
        if p[i] == 124 as byte {
            cut = i;
            break;
        }
        i = i + 1;
    }
    jw_str(w, p as &byte, cut);
}

// assistant 的 tool_calls 数组（chat 形状原文）→ 逐条 {"type":"function_call",…}
// 返回 false = 解析失败（调用方报错，绝不发半截请求）
fn resp_emit_calls(arena: &Arena, extra: &byte, extra_len: usize, w: &JsonWriter) bool {
    arena_reset(arena);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(arena, extra, extra_len, &root) {
        return false;
    }
    const n: usize = js_arr_len(&root);
    // 反转义目标：JsonStrView 是**未解码**的原始视图，直接喂 jw_str 会二次转义
    var idb: Buf = buf_empty();
    defer { buf_free(&idb); }
    var argsb: Buf = buf_empty();
    defer { buf_free(&argsb); }
    var nameb: Buf = buf_empty();
    defer { buf_free(&nameb); }
    var k: usize = 0;
    while k < n {
        var call: JsonValue = JsonValue.json_null();
        if js_arr_get(&root, k, &call) {
            var name: JsonStrView = JsonStrView{ ptr: null, len: 0 };
            var args: JsonStrView = JsonStrView{ ptr: null, len: 0 };
            var idv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
            var fnv: JsonValue = JsonValue.json_null();
            if js_obj_get(&call, "function", 8, &fnv) {
                _ = js_obj_get_str(&fnv, "name", 4, &name);
                _ = js_obj_get_str(&fnv, "arguments", 9, &args);
            }
            _ = js_obj_get_str(&call, "id", 2, &idv);
            buf_reset(&idb);
            buf_reset(&argsb);
            buf_reset(&nameb);
            if idv.len > 0 && !sv_unescape(&idv, &idb) {
                return false;
            }
            if args.len > 0 && !sv_unescape(&args, &argsb) {
                return false;
            }
            if name.len > 0 && !sv_unescape(&name, &nameb) {
                return false;
            }
            if k > 0 {
                jw_byte(w, 44);
            }
            jw_byte(w, 123);
            jw_key(w, "type");
            jw_str_cstr(w, "function_call");
            jw_byte(w, 44);
            jw_key(w, "call_id");
            resp_id_before_pipe(idb.ptr as &const byte, idb.len, w);
            jw_byte(w, 44);
            jw_key(w, "name");
            jw_str(w, nameb.ptr, nameb.len);
            jw_byte(w, 44);
            jw_key(w, "arguments");
            jw_str(w, argsb.ptr, argsb.len);
            jw_byte(w, 125);
        }
        k = k + 1;
    }
    return true;
}

// 一条 assistant 正文 → {"type":"message","role":"assistant","status":"completed",…}
fn resp_emit_assistant_text(w: &JsonWriter, p: &byte, n: usize) void {
    jw_byte(w, 123);
    jw_key(w, "type");
    jw_str_cstr(w, "message");
    jw_byte(w, 44);
    jw_key(w, "role");
    jw_str_cstr(w, "assistant");
    jw_byte(w, 44);
    jw_key(w, "status");
    jw_str_cstr(w, "completed");
    jw_byte(w, 44);
    jw_key(w, "content");
    jw_byte(w, 91);
    jw_byte(w, 123);
    jw_key(w, "type");
    jw_str_cstr(w, "output_text");
    jw_byte(w, 44);
    jw_key(w, "text");
    jw_str(w, p, n);
    jw_byte(w, 125);
    jw_byte(w, 93);
    jw_byte(w, 125);
}

// 构 `/v1/responses` 请求体：工具 schema 走 flat 形状、推理强度走 `reasoning.effort`、
// 图片走 `input_image`。与 chat 侧共用同一个历史，只是线上形状不同（§4.5）。
fn build_responses_request(cfg: &const Config, h: &const History, out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 123);
    jw_key(&w, "model");
    jw_str(&w, cfg.model.ptr, cfg.model.len);

    // ---- input：逐条历史消息 ----
    // 解析 tool_calls 用的临时 arena：逐条消息 reset，所以只要放得下**最大的一条** extra
    // （按整个历史给容量会在长会话上白吃一份与历史等大的内存）
    var max_extra: usize = 0;
    var mi: usize = 0;
    while mi < h.len {
        const me: usize = msg_at(h, mi).extra_len;
        if me > max_extra {
            max_extra = me;
        }
        mi = mi + 1;
    }
    const arena_cap: usize = max_extra + 8192;
    const arena_raw: &void = malloc(arena_cap);
    if ((arena_raw as &byte) as usize) == 0 {
        return false;
    }
    defer { free(arena_raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, arena_cap);

    jw_byte(&w, 44);
    jw_key(&w, "input");
    jw_byte(&w, 91);
    var items: usize = 0;
    var i: usize = 0;
    while i < h.len {
        const role: u8 = msg_at(h, i).role;
        const m_txt: &byte = msg_at(h, i).text;
        const m_txt_len: usize = msg_at(h, i).text_len;
        if role == ROLE_SYSTEM {
            if items > 0 {
                jw_byte(&w, 44);
            }
            jw_byte(&w, 123);
            jw_key(&w, "role");
            if cfg.api_dev_role {
                jw_str_cstr(&w, "developer");
            } else {
                jw_str_cstr(&w, "system");
            }
            jw_byte(&w, 44);
            jw_key(&w, "content");
            // pi-ai 同形：system/developer 的 content 是普通字符串
            jw_str(&w, m_txt, m_txt_len);
            jw_byte(&w, 125);
            items = items + 1;
        } else if role == ROLE_USER {
            if items > 0 {
                jw_byte(&w, 44);
            }
            jw_byte(&w, 123);
            jw_key(&w, "role");
            jw_str_cstr(&w, "user");
            jw_byte(&w, 44);
            jw_key(&w, "content");
            jw_byte(&w, 91);
            jw_byte(&w, 123);
            jw_key(&w, "type");
            jw_str_cstr(&w, "input_text");
            jw_byte(&w, 44);
            jw_key(&w, "text");
            jw_str(&w, m_txt, m_txt_len);
            jw_byte(&w, 125);
            // P51：附件作为 input_image 项跟在文本项之后（同一个 content 数组）。
            // responses 的形状与 completions 不同（多了 detail，没有嵌套 image_url 对象）。
            _ = agent_emit_images_json(&w, msg_at(h, i).extra as &const byte, msg_at(h, i).extra_len, true);
            jw_byte(&w, 93);
            jw_byte(&w, 125);
            items = items + 1;
        } else if role == ROLE_ASSISTANT {
            if m_txt_len > 0 {
                if items > 0 {
                    jw_byte(&w, 44);
                }
                resp_emit_assistant_text(&w, m_txt, m_txt_len);
                items = items + 1;
            }
        } else if role == ROLE_ASSISTANT_CALLS {
            if m_txt_len > 0 {
                if items > 0 {
                    jw_byte(&w, 44);
                }
                resp_emit_assistant_text(&w, m_txt, m_txt_len);
                items = items + 1;
            }
            if msg_at(h, i).extra_len > 0 {
                if items > 0 {
                    jw_byte(&w, 44);
                }
                if !resp_emit_calls(&arena, msg_at(h, i).extra, msg_at(h, i).extra_len, &w) {
                    out_err("error: cannot parse tool_calls while building the responses request\n");
                    return false;
                }
                items = items + 1;
            }
        } else if role == ROLE_TOOL {
            if items > 0 {
                jw_byte(&w, 44);
            }
            jw_byte(&w, 123);
            jw_key(&w, "type");
            jw_str_cstr(&w, "function_call_output");
            jw_byte(&w, 44);
            jw_key(&w, "call_id");
            resp_id_before_pipe(msg_at(h, i).extra as &const byte, msg_at(h, i).extra_len, &w);
            jw_byte(&w, 44);
            jw_key(&w, "output");
            // P9：与 chat 路径同一条剪枝规则（构请求这一层剪，历史不变）
            var pruned: Buf = buf_empty();
            defer { buf_free(&pruned); }
            if m_txt_len > 0 && cmp_maybe_prune_kind(m_txt as &const byte, m_txt_len, msg_at(h, i).kind, &pruned) {
                jw_str(&w, pruned.ptr, pruned.len);
            } else if m_txt_len > 0 {
                jw_str(&w, m_txt, m_txt_len);
            } else {
                // 空结果在线上必须是 "(no output)"（与 chat 的严格协议一致）
                jw_str_cstr(&w, "(no output)");
            }
            jw_byte(&w, 125);
            items = items + 1;
        }
        i = i + 1;
    }
    jw_byte(&w, 93);

    // ---- 其余字段 ----
    jw_byte(&w, 44);
    jw_key(&w, "stream");
    jw_bool(&w, cfg.stream);
    if cfg.api_store {
        jw_byte(&w, 44);
        jw_key(&w, "store");
        jw_bool(&w, false);
    }
    jw_byte(&w, 44);
    jw_key(&w, "tools");
    if !tools_json(&g_tools_scratch, cfg.allow_shell, true) {
        return false;
    }
    jw_raw(&w, g_tools_scratch.ptr as &const byte, g_tools_scratch.len);
    if cfg.temperature >= 0 {
        jw_byte(&w, 44);
        jw_key(&w, "temperature");
        jw_i64(&w, cfg.temperature as i64);
    }
    if cfg.max_tokens > 0 {
        var mt: i64 = cfg.max_tokens;
        if mt < RESP_MSG_MIN_TOKENS {
            mt = RESP_MSG_MIN_TOKENS;
        }
        jw_byte(&w, 44);
        jw_key(&w, "max_output_tokens");
        jw_i64(&w, mt);
    }
    // P56：off/none 按 settings 的 `off: none` 映射发出去（理由见 chat 那侧的注释）；
    // 以前是「off/none 就不发这个字段」，于是「关掉思考」在线上变成了「用网关默认档」。
    if cfg.api_reasoning && cfg.reasoning_effort.len > 0 {
        const eff_off2: bool = sv_eq_cstr(&cfg.reasoning_effort, "off" as &const byte)
            || sv_eq_cstr(&cfg.reasoning_effort, "none" as &const byte);
        jw_byte(&w, 44);
        jw_key(&w, "reasoning");
        jw_byte(&w, 123);
        jw_key(&w, "effort");
        if eff_off2 {
            jw_str(&w, "none" as &const byte, 4);
        } else {
            jw_str(&w, cfg.reasoning_effort.ptr, cfg.reasoning_effort.len);
        }
        jw_byte(&w, 125);
    }
    jw_byte(&w, 125);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// 按协议组装请求（style 由 api_style_now() 决定，见「线协议」一节）
fn build_model_request(cfg: &const Config, h: &const History, out: &Buf, style: u8) bool {
    if style == LLM_STYLE_RESPONSES {
        return build_responses_request(cfg, h, out);
    }
    return build_chat_request(cfg, h, out);
}

// ============================================================
// 调用模型
// ============================================================
fn build_headers(cfg: &const Config, out: &Buf) bool {
    if !buf_append_cstr(out, "Content-Type: application/json\r\n") {
        return false;
    }
    // 子代理的请求带一个标记头：便于服务端/日志区分父子（自测也用它判断请求来自谁；
    // 不能靠 prompt 文本判断 —— fork 出来的子代理会继承父的整段历史）
    if cfg.is_subagent || cfg.deleg_depth > 0 {
        if !buf_append_cstr(out, "x-uya-subagent: ") {
            return false;
        }
        _ = buf_append_i64(out, cfg.deleg_depth as i64);
        if !buf_append_cstr(out, "\r\n") {
            return false;
        }
    }
    if cfg.stream {
        if !buf_append_cstr(out, "Accept: text/event-stream\r\n") {
            return false;
        }
    } else {
        if !buf_append_cstr(out, "Accept: application/json\r\n") {
            return false;
        }
    }
    if cfg.api_key.len > 0 {
        if !buf_append_cstr(out, "Authorization: Bearer ") {
            return false;
        }
        if !buf_append(out, cfg.api_key.ptr, cfg.api_key.len) {
            return false;
        }
        if !buf_append_cstr(out, "\r\n") {
            return false;
        }
    }
    return true;
}

// p[0..n] 是不是以 `/` 结尾（拼 URL 路径时决定要不要补一个斜杠）。
fn ends_with_slash(p: &const byte, n: usize) bool {
    if n == 0 {
        return false;
    }
    return p[n - 1] == '/' as byte;
}

// 端点：{base_url}/{chat/completions | responses}（尾部斜杠由这里补）
fn api_url_into(cfg: &const Config, style: u8, u: &Buf) bool {
    buf_reset(u);
    if !buf_valid(u) {
        return false;
    }
    if !buf_append(u, cfg.base_url.ptr, cfg.base_url.len) {
        return false;
    }
    if !ends_with_slash(cfg.base_url.ptr as &const byte, cfg.base_url.len) {
        if !buf_append_byte(u, 47) {
            return false;
        }
    }
    return buf_append_cstr(u, llm_endpoint_path(style));
}

// 打印 HTTP 错误的诊断：状态码 + 错误体（**原始字节**可选落 `--debug-dump`，
// 转录里只给转义预览）。见 §16 踩坑 33 的来由。
fn dump_http_error(status: i32, body: &const Buf) void {
    out_err("model endpoint returned HTTP ");
    out_err_dec(status as usize);
    out_err("\n");
    // 外来字节走唯一诊断出口：转义 + 字符边界截断 + 限长（原文进日志 / --debug-dump）
    out_diag("http-error-body", "body: ", body.ptr as &const byte, body.len);
}

// ============================================================
// 工具分发
// ============================================================
fn sv_eq_cstr(b: &const Buf, lit: &const byte) bool {
    const n: usize = strlen(lit);
    if b.len != n {
        return false;
    }
    var i: usize = 0;
    while i < n {
        if b.ptr[i] != lit[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// ============================================================
// 主循环
// ============================================================
export const AGENT_OK: i32 = 0;
export const AGENT_USAGE: i32 = 1;
export const AGENT_NET: i32 = 2;
export const AGENT_PROTO: i32 = 3;
export const AGENT_TOOL: i32 = 4;

// P59：**输出到达上限（max_tokens）被截断** —— 回合走完了它的步数，但没走到最终答复就收场。
//
// 为什么不并进 3（「模型或协议错」）：模型与协议都没问题，只是我们给这一轮的输出预算用完了。
// 也不当 0（「跑完了」）—— 屏幕上那段正文是半截的，脚本必须看得出来。所以单开一个码。
// 两条腿都对齐 DSH：它的 UI 打 warn 色的「已达到输出 token 上限」+「发送"继续"可让模型接着
// 输出」；`dsh-headless` 那条腿把正文照样打到 stdout、退出码按「没跑完」给非 0
// （`outcome.reason?.kind === "completed" ? 0 : 1`）。这里取它的语义、给它一个自己的码。
export const AGENT_MAX_TOKENS: i32 = 5;

// ============================================================
// 流式一步（P1）
//
// 返回 STEP_CONTINUE 表示「已执行工具、继续下一步」，其余值是 agent_run 的退出码。
// content 在流式过程中就直接打印（--quiet 关闭），收尾时不再重复打印。
// ============================================================
export const STEP_CONTINUE: i32 = 100;

// P54：**退化响应 → 同一步重发**（step 循环的内部码，不是退出码）。
//
// 退化响应 = 上游正常收尾（不是 error、不是 max-tokens），但这一步既没有正文也没有工具调用。
// 最典型的样子是「思考流了一大段、正文一个字都没有」，也可能反过来：上游嘴上说 tool_calls
// 而调用在流里没了。这种响应不值得让整个回合失败 —— 同一份历史重发一次通常就有正文
// （网关抖动 / 上游偶发只回思考）。
//
// 对齐 DSH 的 request-error 通道（`compaction-basic` 就是这么接 context-overflow 的）：
// 重发发生在**同一步**（step 不递增、历史一个字节没动，所以重算出来的请求体逐字节相同），
// 额度每步一次 —— 由 agent_note_degenerate 扣；扣不动时它给的是 AGENT_PROTO，不是这个码。
// 于是这个码**只可能被 step 循环消费**（`continue` 重发），绝不会当退出码还回去。
export const STEP_RETRY: i32 = 101;

// 交互模式：本回合被用户 Ctrl-C 打断（不是错误，回到提示符即可）
export const AGENT_INTERRUPTED: i32 = 130;

// 每步允许的退化响应重发次数。写成常量是为了让证据里的 maxRetries 与真正执行的次数
// 只有一个出处 —— 自测的「只重发一次」那条腿钉的就是它。
const EMPTY_RETRY_MAX: i32 = 1;

// 交互模式标志（前台界面唯一，用全局避免把参数穿过整条调用链）
var g_interactive: bool = false;

// P46：给自测用的一把钥匙 —— 「交互模式」这个标志决定了自动起标题跑不跑，
// 而自测（headless）不走真终端入口，否则那条闸门永远测不到。
export fn agent_set_interactive(v: bool) void {
    g_interactive = v;
}

// ---- P55：执行期两条纪律的运行时状态（全局，避免把参数穿过整条调用链）----
//   on：本回合已经切到 exec_effort
//   off：人**运行中**手动改过强度 ⇒ 自动切换让位（人优先）；档位不被模型公布时也置它
//   base：切换前的档位（本回合结束时还原；空 = 没切过）
//   step：当前步号（step 边界写；工具的收尾钩子在 dispatch_tool_body 里，那儿拿不到 step）
//   accept_step：验收类命令最近一次「改动之后」通过的步号（0 = 还没发生）
//   mod_seq / accept_mod_seq：改动计数，用来判定「这次验收是不是新的」
//   notes：已经给过几条收工提醒（上限见 GRACE_NOTE_MAX，别刷屏）
//
// ⚠ 这两个机制的代码全部内联在既有函数里（step 边界 / dispatch_tool_body），**一个顶层函数都没加**：
//   本仓「顶层函数 reachable 集合」是编译器里写死的容量，HEAD 的余量是 0（§16 踩坑 87），
//   加两个函数会撑爆表 —— 症状不是一句「容量不足」，而是链接期 undefined reference
//   指着一堆**你没改过的**函数（实测踩过一次）。
struct ExecState {
    on: bool,
    off: bool,
    base: Buf,
    step: i32,
    accept_step: i32,
    mod_seq: i64,
    accept_mod_seq: i64,
    notes: i32,
}
var g_exec: ExecState = ExecState{
    on: false,
    off: false,
    base: Buf{ ptr: null, len: 0, cap: 0 },
    step: 0,
    accept_step: 0,
    mod_seq: 0,
    accept_mod_seq: 0,
    notes: 0,
};
// 一个回合里最多给几条收工提醒（实测：同一条 make build 在一回合里被跑了三遍）
const GRACE_NOTE_MAX: i32 = 2;

// 流式路径上的错误诊断（与 `dump_http_error` 同一份口径，区别是流式那侧
// 手上的体只有头部若干字节 —— 见 `LLM_ERR_HEAD`）。
fn dump_stream_error(cfg: &const Config, status: i32, body: &const Buf) void {
    _ = cfg;
    out_err("model endpoint returned HTTP ");
    out_err_dec(status as usize);
    out_err("\n");
    // 同 dump_http_error：流式路径的非 2xx 体也一律走转义预览（原文进日志）
    out_diag("http-error-body", "body: ", body.ptr as &const byte, body.len);
}

// 打一行 token 用量（`--show-usage`）：in / out / cache / reasoning。
// `usage_in` 是**非缓存输入**，所以打印时与 cache_read 分开列（§4.5.1）。
fn print_usage_line(o: &const ChatOut) void {
    out_err("[usage] in=");
    out_err_dec(o.usage_in as usize);
    out_err(" out=");
    out_err_dec(o.usage_out as usize);
    out_err(" cache_read=");
    out_err_dec(o.usage_cache_read as usize);
    out_err(" reasoning=");
    out_err_dec(o.usage_reasoning as usize);
    out_err("\n");
}

// 工具分发的「正文」版本：只写结果文本，不带 [tool name] 前缀。
// 严格协议下工具名由 assistant 的 tool_calls + tool_call_id 表达，前缀是冗余。
fn dispatch_tool_body(cfg: &Config, name: &const Buf, args_json: &const Buf, arena: &Arena, out: &Buf) void {
    var parsed: bool = false;
    var arg_val: JsonValue = JsonValue.json_null();
    if args_json.len > 0 {
        parsed = js_parse(arena, args_json.ptr, args_json.len, &arg_val);
    }
    if !parsed {
        _ = buf_append_cstr(out, "error: tool arguments are not valid JSON (expects an object like {\"path\":\"...\"})\n");
        return;
    }
    if sv_eq_cstr(name, "read") {
        fs_tool_read(&g_fsctx, &g_fsobs, &arg_val, out);
    } else if sv_eq_cstr(name, "write") {
        fs_tool_write(&g_fsctx, &g_fsobs, &arg_val, out);
    } else if sv_eq_cstr(name, "edit") {
        fs_tool_edit(&g_fsctx, &g_fsobs, &arg_val, out);
    } else if sv_eq_cstr(name, "glob") {
        search_glob(&g_fsctx, &arg_val, out);
    } else if sv_eq_cstr(name, "grep") {
        search_grep(&g_fsctx, &arg_val, out);
    } else if sv_eq_cstr(name, "bash") {
        sh_tool_bash(cfg, &arg_val, out);
    } else if sv_eq_cstr(name, "job_list") {
        jobs_tool_list(&g_jobs, out);
    } else if sv_eq_cstr(name, "job_output") {
        jobs_tool_output(&g_jobs, &arg_val, out);
    } else if sv_eq_cstr(name, "job_kill") {
        jobs_tool_kill(&g_jobs, &arg_val, out);
    } else if sv_eq_cstr(name, "todo_write") {
        todo_tool_write(&g_todos, &arg_val, out);
    } else if sv_eq_cstr(name, "workspace") {
        ws_tool_workspace(cfg, &arg_val, out);
    } else if sv_eq_cstr(name, "worktree") {
        wt_tool_worktree(cfg, &arg_val, out);
    } else if sv_eq_cstr(name, "set_title") {
        agent_title_tool_set(cfg, &arg_val, out);
    } else if sv_eq_cstr(name, "exit_plan_mode") {
        plan_tool_exit(cfg, &g_plan, &arg_val, out);
    } else if sv_eq_cstr(name, "ask_user_question") {
        ask_tool_question(&arg_val, out);
    } else if sv_eq_cstr(name, "skill") {
        if !g_skills.scanned {
            skills_collect(&g_skills, cfg.workspace.ptr[0: cfg.workspace.len], agent_dsh_home(), &cfg.skill_dirs);
        }
        skill_tool(&g_skills, &arg_val, out);
    } else if sv_eq_cstr(name, "web_search") {
        web_tool_search(cfg, &arg_val, out);
    } else if sv_eq_cstr(name, "subagent") {
        deleg_tool_subagent(cfg, &g_deleg, &arg_val, out, false);
    } else if sv_eq_cstr(name, "subagent_fork") {
        deleg_tool_subagent(cfg, &g_deleg, &arg_val, out, true);
    } else if sv_eq_cstr(name, "list_agents") {
        deleg_tool_list(&g_deleg, out);
    } else if sv_eq_cstr(name, "subagent_output") {
        deleg_tool_output(&g_deleg, &arg_val, out);
    } else if sv_eq_cstr(name, "send_message") {
        deleg_tool_send(cfg, &g_deleg, &arg_val, out);
    } else if sv_eq_cstr(name, "interrupt_agent") {
        deleg_tool_interrupt(&g_deleg, &arg_val, out);
    } else if sv_eq_cstr(name, "ralph") {
        deleg_tool_ralph(cfg, &g_deleg, &arg_val, out);
    } else if sv_eq_cstr(name, "create_goal") {
        goal_tool_create(cfg, &arg_val, out);
    } else if sv_eq_cstr(name, "get_goal") {
        goal_tool_get(cfg, out);
    } else if sv_eq_cstr(name, "update_goal") {
        goal_tool_update(cfg, &arg_val, out);
    } else if sv_eq_cstr(name, "workflow") {
        wf_tool_workflow(cfg, &arg_val, out);
    } else {
        _ = buf_append_cstr(out, "error: unknown tool");
        return;
    }
    // P22：任务块的目标段吃的是内存投影 —— goal 工具刚写过盘，这里立刻重读一次
    if sv_eq_cstr(name, "create_goal") || sv_eq_cstr(name, "get_goal") || sv_eq_cstr(name, "update_goal") {
        tasks_goal_reload(cfg);
    }
    // ---- P55：执行期纪律的收尾钩子 ----
    //
    // 放在这里的原因有两个：① 两个工具派发点（流式 / 非流式）都必经 dispatch_tool_body，
    // 一处顶两处；② 本仓「顶层函数 reachable 集合」是编译器里写死的容量，HEAD 的余量是 **0**
    // （§16 踩坑 87：净增函数过不了清缓存重编），所以这两个机制都不新增顶层函数。
    //
    // 干两件事：
    //   * 记「改动」：write / edit，或 bash 里**有一整段**是改动类命令（git / mv / sed / …）；
    //   * 收工提醒：bash 里**有一整段**是验收类命令（make / pytest / cargo / …）且这一段跑绿时，
    //     往结果尾部追加一行提醒（一回合最多 GRACE_NOTE_MAX 条），并把步号记进
    //     g_exec.accept_step（--grace-steps 的锚点）。
    //
    // ⚠ 判据是**按段锚定**的，不是「命令文本里出现过 make」—— 第一版就是后者，真机上当场误报两次：
    //   ① `git mv … && sed -i 's|src/x.uya|…|' Makefile && grep -n "make" …`（搬家命令，50 个文件
    //      才搬了 1 个就被告知「验收已通过，提交并给出最终答复」）；
    //   ② 探索期的 `grep …; time make build`（改动还没开始）。
    //   误报会把模型往「提前收工」上带：那两腿反而更贵（$0.0472 / $0.0531，对照腿 $0.0272）。
    //   分段对齐 shell 常见写法：`&&`、`;`、`|`、换行、`(` 都算段边界；段首的
    //   time / sudo / env / nohup / nice / command 前缀先剥掉，再看这一段的第一个 token。
    if sv_eq_cstr(name, "bash" as &const byte) {
        var xcmd: Buf = buf_empty();
        defer { buf_free(&xcmd); }
        // ⚠ 两个坑都踩过：① 这个 helper 的第一个参数是**已 parse 的** `&JsonValue`（用上面的
        // arg_val），传裸 args 文本会被隐式强转成指针、函数永远返回 false —— 静默失效，
        // 日志里连一条痕迹都没有；② 它内部 `out[0] = buf_new(...)` 换掉整个缓冲，
        // 所以出参必须是**空 Buf**（给 buf_new(256) 过去等于每次泄漏 256 字节）。
        if js_obj_get_str_unescaped(&arg_val, "command" as &const byte, 7, &xcmd) {
            // 段首 token 复用一个 64 字节的小 Buf（sv_eq_cstr 收的是 Buf，不是视图；
            // 超过 64 字节的 token 一律不认 —— 验收命令的名字都不长）
            var xtok: Buf = buf_new(64);
            defer { buf_free(&xtok); }
            var acc_hit: bool = false;
            var mut_hit: bool = false;
            var seg_head: bool = true;   // 处在段首（前导空白不算离开段首）
            var i: usize = 0;
            while i < xcmd.len {
                const c: byte = xcmd.ptr[i];
                if c == 59 as byte || c == 124 as byte || c == 38 as byte
                    || c == 10 as byte || c == 13 as byte || c == 40 as byte {
                    seg_head = true;
                    i = i + 1;
                    continue;
                }
                if c == 32 as byte || c == 9 as byte {
                    i = i + 1;
                    continue;
                }
                if seg_head {
                    // 这一段的第一个 token = [i, j)
                    var j: usize = i;
                    while j < xcmd.len {
                        const d: byte = xcmd.ptr[j];
                        if d == 32 as byte || d == 9 as byte || d == 10 as byte || d == 13 as byte
                            || d == 59 as byte || d == 124 as byte || d == 38 as byte {
                            break;
                        }
                        j = j + 1;
                    }
                    buf_reset(&xtok);
                    if j - i <= xtok.cap {
                        _ = buf_append(&xtok, xcmd.ptr + i, j - i);
                    }
                    // 前缀剥掉再看下一个 token（`time make build` 这种要认出来）
                    while sv_eq_cstr(&xtok, "time" as &const byte) || sv_eq_cstr(&xtok, "sudo" as &const byte)
                        || sv_eq_cstr(&xtok, "nohup" as &const byte) || sv_eq_cstr(&xtok, "nice" as &const byte)
                        || sv_eq_cstr(&xtok, "command" as &const byte) || sv_eq_cstr(&xtok, "env" as &const byte) {
                        var k: usize = j;
                        while k < xcmd.len && (xcmd.ptr[k] == 32 as byte || xcmd.ptr[k] == 9 as byte) {
                            k = k + 1;
                        }
                        var m: usize = k;
                        while m < xcmd.len {
                            const d2: byte = xcmd.ptr[m];
                            if d2 == 32 as byte || d2 == 9 as byte || d2 == 10 as byte || d2 == 13 as byte
                                || d2 == 59 as byte || d2 == 124 as byte || d2 == 38 as byte {
                                break;
                            }
                            m = m + 1;
                        }
                        if m <= k {
                            break;
                        }
                        buf_reset(&xtok);
                        if m - k <= xtok.cap {
                            _ = buf_append(&xtok, xcmd.ptr + k, m - k);
                        }
                        j = m;
                    }
                    if sv_eq_cstr(&xtok, "make" as &const byte) || sv_eq_cstr(&xtok, "pytest" as &const byte)
                        || sv_eq_cstr(&xtok, "npm" as &const byte) || sv_eq_cstr(&xtok, "yarn" as &const byte)
                        || sv_eq_cstr(&xtok, "pnpm" as &const byte) || sv_eq_cstr(&xtok, "cargo" as &const byte)
                        || sv_eq_cstr(&xtok, "go" as &const byte) || sv_eq_cstr(&xtok, "tsc" as &const byte)
                        || sv_eq_cstr(&xtok, "gradle" as &const byte) || sv_eq_cstr(&xtok, "mvn" as &const byte)
                        || sv_eq_cstr(&xtok, "cmake" as &const byte) || sv_eq_cstr(&xtok, "ninja" as &const byte)
                        || sv_eq_cstr(&xtok, "bazel" as &const byte) || sv_eq_cstr(&xtok, "meson" as &const byte)
                        || sv_eq_cstr(&xtok, "dotnet" as &const byte) || sv_eq_cstr(&xtok, "tox" as &const byte) {
                        acc_hit = true;
                    }
                    if sv_eq_cstr(&xtok, "git" as &const byte) || sv_eq_cstr(&xtok, "mv" as &const byte)
                        || sv_eq_cstr(&xtok, "cp" as &const byte) || sv_eq_cstr(&xtok, "rm" as &const byte)
                        || sv_eq_cstr(&xtok, "mkdir" as &const byte) || sv_eq_cstr(&xtok, "touch" as &const byte)
                        || sv_eq_cstr(&xtok, "sed" as &const byte) || sv_eq_cstr(&xtok, "patch" as &const byte)
                        || sv_eq_cstr(&xtok, "tee" as &const byte) || sv_eq_cstr(&xtok, "truncate" as &const byte)
                        || sv_eq_cstr(&xtok, "ln" as &const byte) || sv_eq_cstr(&xtok, "chmod" as &const byte) {
                        mut_hit = true;
                    }
                    seg_head = false;
                }
                i = i + 1;
            }
            if mut_hit {
                g_exec.mod_seq = g_exec.mod_seq + 1;
            }
            if acc_hit && g_exec.notes < GRACE_NOTE_MAX && g_exec.mod_seq > g_exec.accept_mod_seq
                && view_find(out, "[exit code: 0]" as &const byte) >= 0 {
                g_exec.accept_mod_seq = g_exec.mod_seq;
                g_exec.notes = g_exec.notes + 1;
                if g_exec.accept_step == 0 {
                    g_exec.accept_step = g_exec.step;
                }
                _ = buf_append_cstr(out, "\n[acceptance] 验收命令已通过（第 ");
                _ = buf_append_u64(out, g_exec.step as u64);
                _ = buf_append_cstr(out, " 步）：收工纪律 —— 不要再跑这条验收命令、不要另造一条验收；与本次改动无关的既有失败记一行就走，不要追查、不要另拉基线。提交并给出最终答复。\n");
            }
        }
    } else if sv_eq_cstr(name, "write" as &const byte) || sv_eq_cstr(name, "edit" as &const byte) {
        g_exec.mod_seq = g_exec.mod_seq + 1;
    }
}

// 折叠协议用（--compat-fold / 老端点）：[tool name] + 正文 + 换行
fn dispatch_tool_buf(cfg: &Config, name: &const Buf, args_json: &const Buf, arena: &Arena, out: &Buf) void {
    _ = buf_append_cstr(out, "[tool ");
    _ = buf_append(out, name.ptr, name.len);
    _ = buf_append_cstr(out, "] ");
    dispatch_tool_body(cfg, name, args_json, arena, out);
    _ = buf_append_byte(out, 10);
}

// 一个 tool_calls 元素的骨架：X / Y / Z 是三个字符串值的占位符（各占 1 字节），
// 真实长度由 jw_str_esc_len 给。**必须与 calls_json_from_chat 的写法逐字对应** ——
// 两边不一致时 calls_json_need 会算少，靠 calls_json_from_chat 的返回值兜底（见调用点）。
const CALLS_JSON_SKELETON: &const byte = "{\"id\":X,\"type\":\"function\",\"function\":{\"name\":Y,\"arguments\":Z}}";
// 预算余量：宁可多要几百字节，也不要因为骨架算错而把「参数有点大」误报成 OOM
const CALLS_JSON_SLACK: usize = 256;

// 序列化一批调用**需要多少字节**（精确值 + 余量）。
//
// 为什么要有它：以前这里是拍脑袋的 buf_new(8192)。工具参数一大（write 的正文、
// 长 heredoc 的命令行、一次改好几个文件）序列化就 jw_overflow，调用点于是把
// 「参数比 8 KiB 大」报成 "out of memory serializing tool_calls" 并**中止整轮**
// （turn/end reason=error）。真机踩到：模型写一个 8 KiB 出头的 shim，命令行参数刚
// 过线，于是「创建目录成功」之后的那一步直接死掉。
//
// 真正的上限不是这里：历史里单条 extra（tool_calls 原文）的上限是 MSG_CONTENT_MAX，
// 8 KiB 只是当年随手写的容量。容量按需要算之后，「装不下」只剩真 OOM 一种可能。
fn calls_json_need(o: &const ChatOut) usize {
    const skeleton: usize = bufx_cstr_len(CALLS_JSON_SKELETON) - 3;   // 减掉 X/Y/Z 三个占位符
    var n: usize = 2;   // [ ]
    var i: usize = 0;
    while i < o.ncalls {
        if i > 0 {
            n = n + 1;   // 元素之间的逗号
        }
        n = n + skeleton;
        n = n + jw_str_esc_len(o.calls[i].id.ptr as &const byte, o.calls[i].id.len);
        n = n + jw_str_esc_len(o.calls[i].name.ptr as &const byte, o.calls[i].name.len);
        n = n + jw_str_esc_len(o.calls[i].args.ptr as &const byte, o.calls[i].args.len);
        i = i + 1;
    }
    return n + CALLS_JSON_SLACK;
}

// 序列化一批调用的完整动作：**按实际需要分配 + 序列化**。
//
// 容量只有这一个出处（calls_json_need）—— 谁都不许再写「拍脑袋的固定容量」
// （老代码就是 buf_new(8192)，工具参数刚过 8 KiB 就把整轮打成
// "error: out of memory serializing tool_calls"）。自测的 toolcalls-cap 轮钉的就是它。
//
// out 必须是**空 Buf**（本函数内部新建；旧内容不会释放）。返回 false = 装不下
// （预算都装不下＝只剩真 OOM 一种可能）。无论成功失败，调用方都要 buf_free(out)。
fn calls_json_make(o: &const ChatOut, out: &Buf) bool {
    out[0] = buf_new(calls_json_need(o));
    return calls_json_from_chat(o, out);
}

// 把一批调用序列化成 assistant 的 tool_calls 数组原文（arguments 只转义一次）。
// 返回 false = 缓冲装不下 —— 容量请用 calls_json_make 算，别自己给固定值。
fn calls_json_from_chat(o: &const ChatOut, out: &Buf) bool {
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, used: 0, overflow: false };
    jw_init(&w, out.ptr, out.cap);
    jw_byte(&w, 91);
    var i: usize = 0;
    while i < o.ncalls {
        if i > 0 {
            jw_byte(&w, 44);
        }
        jw_byte(&w, 123);
        jw_key(&w, "id");
        jw_str(&w, o.calls[i].id.ptr, o.calls[i].id.len);
        jw_byte(&w, 44);
        jw_key(&w, "type");
        jw_str_cstr(&w, "function");
        jw_byte(&w, 44);
        jw_key(&w, "function");
        jw_byte(&w, 123);
        jw_key(&w, "name");
        jw_str(&w, o.calls[i].name.ptr, o.calls[i].name.len);
        jw_byte(&w, 44);
        jw_key(&w, "arguments");
        jw_str(&w, o.calls[i].args.ptr, o.calls[i].args.len);
        jw_byte(&w, 125);
        jw_byte(&w, 125);
        i = i + 1;
    }
    jw_byte(&w, 93);
    if jw_overflow(&w) {
        return false;
    }
    out.len = jw_used(&w);
    return true;
}

// 去掉尾部空白后的长度（DSH：中断时只保留 content/reasoning 的非空白前缀）
export fn agent_trim_trailing_ws(p: &const byte, n: usize) usize {
    var keep: usize = n;
    while keep > 0 {
        const c: byte = p[keep - 1];
        if c == 32 as byte || c == 9 as byte || c == 10 as byte || c == 13 as byte {
            keep = keep - 1;
        } else {
            break;
        }
    }
    return keep;
}

// 流式一步。style 必须与 req 的组装协议一致（调用方用同一个 style 建 url/req）。
// out_status 回传本次请求的 HTTP 状态码（0 = 没走到 HTTP）—— 协商回退要用它。
// retry_ok = 本步剩余的退化响应重发额度（P54；指针一路带到 agent_finish_step 去扣）。
fn agent_step_stream(cfg: &Config, style: u8, url: &const Buf, hdrs: &const Buf, req: &const Buf, arena: &Arena, h: &History, step: i32, interactive: bool, out_status: &i32, retry_ok: &bool) i32 {
    var o: ChatOut = chat_out_new();
    defer { chat_out_free(&o); }
    var tc: TlsConn = tls_conn_empty();
    var guard: FdGuard = FdGuard{ saved: -1, nullfd: -1, active: false };
    tls_noise_mute(&guard, !cfg.tls_debug && !hc_debug);
    const call_res: !i32 = llm_stream_style(
        style,
        url.ptr[0: url.len],
        hdrs.ptr[0: hdrs.len],
        req.ptr as &const byte,
        req.len,
        cfg.timeout_ms,
        cfg.max_response,
        cfg.verify,
        cfg.pin.ptr[0: cfg.pin.len],
        &o,
        !cfg.quiet,
        cfg.show_reasoning,
        interactive
    );
    tls_noise_unmute(&guard);

    var err_kind: i32 = 0;   // 0=无错 1=malformed 2=stream-closed 3=其它（传输/TLS） 4=用户中断
    const status: i32 = call_res catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        var r: i32 = 3;
        if eid == @error_id(error.LlmMalformed) {
            r = 1;
        } else if eid == @error_id(error.LlmStreamClosed) {
            r = 2;
        } else if eid == @error_id(error.LlmInterrupted) {
            r = 4;
        }
        r;
    };
    if err_kind == 0 && (status == 1 || status == 2 || status == 3 || status == 4) {
        err_kind = status;
    }

    // P16：不管后面走哪条路（成功 / 中断 / malformed / 网络），先把思考收拾干净 ——
    // 显示上落一行、日志上记全文，并且把被思考行顶掉的提示符还回去。
    // 正常路径下思考块早就因为「正文开始 / 工具调用开始」结算过了，这里是幂等的兜底。
    agent_note_reasoning(step, &o);
    // P18：首 token 边界。用 ChatOut 记下的那一刻写事件与折叠（不是现在），
    // 否则 TTFT 会变成「整段流式时间」。非流式路径没有 delta，这里自然地不打点。
    agent_bound_first_token(cfg, h, step, o.first_token_ms);

    if err_kind == 4 {
        // 对齐 DSH：中断流式时只保留 content/reasoning 的**非空白前缀**，
        // **绝不**保留 tool_calls（参数可能是半截的）。
        const keep: usize = agent_trim_trailing_ws(o.content.ptr as &const byte, o.content.len);
        if keep > 0 {
            var pushed_i: bool = hist_push(h, ROLE_ASSISTANT, o.content.ptr as &const byte, keep);
            while !pushed_i {
                if !hist_drop_oldest(h) {
                    break;
                }
                pushed_i = hist_push(h, ROLE_ASSISTANT, o.content.ptr as &const byte, keep);
            }
        }
        tty_puts(&tty_ui, 2, "\n[interrupted] 已中断本回合（历史保留，可直接继续输入）\n");
        return AGENT_INTERRUPTED;
    }

    if err_kind == 1 {
        // 坏 payload 的头部：走唯一诊断出口（不把裸字节刷进转录）
        out_diag("malformed-sse-payload", "error: malformed SSE payload: ", o.err_text.ptr as &const byte, o.err_text.len);
        return AGENT_PROTO;
    }
    if err_kind == 2 {
        out_err("error: SSE stream ended without [DONE] (stream closed early)\n");
        return AGENT_NET;
    }
    if err_kind == 3 {
        out_err("error: 请求失败（网络或 TLS 校验）。\n");
        if tc.observed_len > 0 {
            out_err("  本次观测到的 leaf 证书 SHA-256 = ");
            out_err_bytes(&tc.observed[0], tc.observed_len);
            out_err("\n");
            out_err("  链校验在真实站点常失败（见 §18）；用这个指纹重试：\n");
            out_err("  uya-agent --tls-verify=pin --tls-pin <上面的指纹> ...\n");
        } else {
            out_err("  检查 base-url / 网络；证书问题可先用 --probe --tls-verify=none 看指纹。\n");
        }
        return AGENT_NET;
    }
    if status != 200 {
        out_status[0] = status;
        // 协商探测的那一次（未声明协议 + 端点不存在）不刷屏：由 api_negotiate() 打一行提示
        if !api_may_negotiate(cfg, style, status) {
            dump_stream_error(cfg, status, &o.err_text);
        }
        return AGENT_PROTO;
    }
    out_status[0] = status;

    return agent_finish_step(cfg, arena, h, step, &o, req.len, retry_ok);
}


// P54：**退化响应**的唯一出口 —— 上游正常收尾，但这一步既没有正文也没有工具调用。
//
// ① 为什么要把证据一次给全：以前这里只打一句 "model returned neither content nor tool_calls"，
// 会话日志里则只剩一条 `content=""` 的 assistant/message —— 事后分不清「上游说了 stop」还是
// 「tool_calls 在流里丢了」，只能靠旁证凑。判据其实都在手上：
//   * finish / have_finish / bad_finish：上游到底声明了什么（未知 finish_reason 的原文也在）；
//   * reasoning 字节数：只思考没正文正是退化响应最典型的样子（正文一个字都没上来）；
//   * usage：输出 token 花在哪儿了（思考里？还是压根没生成？）；
//   * 本次请求的体量：prompt 字节数（我们真发出去的）+ prompt token 读数（提供方口径）。
//
// ② 为什么值得重发：同一请求再发一次通常就有正文。对齐 DSH 的 request-error 通道
// （`compaction-basic` 接 context-overflow 就是这条）：**同一步**重发，历史一个字节没动，
// 所以重算出来的请求体逐字节相同；额度每步一次（retry_ok 由 step 循环持有，指针传进来扣）。
//
// 返回 true = 已安排重发（调用方把这一步重来，即 STEP_RETRY）；false = 额度用尽，回合按错误收口。
// 两个分支都**不留 assistant/message、不进历史、不计统计**：这一步没有任何产出，硬记一条空的
// assistant 消息只会让「退化」和「模型真的回了空串」在日志里长得一模一样。
fn agent_note_degenerate(step: i32, o: &const ChatOut, prompt_bytes: usize, retry_ok: &bool) bool {
    const retrying: bool = retry_ok[0];
    if retrying {
        retry_ok[0] = false;   // 额度当场扣掉：同一步只可能重发 EMPTY_RETRY_MAX 次
    }
    const used: i64 = if retrying { 0 as i64 } else { EMPTY_RETRY_MAX as i64 };
    // 负数读数只在「网关报的缓存命中 > prompt」时出现，证据里按 0 打（别打成一个天文数字）
    const u_in: i64 = if o.usage_in > 0 { o.usage_in } else { 0 as i64 };
    const u_cache_read: i64 = if o.usage_cache_read > 0 { o.usage_cache_read } else { 0 as i64 };
    const u_cache_write: i64 = if o.usage_cache_write > 0 { o.usage_cache_write } else { 0 as i64 };
    const u_out: i64 = if o.usage_out > 0 { o.usage_out } else { 0 as i64 };
    const u_reason: i64 = if o.usage_reasoning > 0 { o.usage_reasoning } else { 0 as i64 };
    const prompt_tokens: i64 = u_in + u_cache_read;
    // finish 的机器名（证据与事件共用一份，避免两处各写一张表）
    var fname: &const byte = "none" as &const byte;
    if o.finish == LLM_FINISH_STOP {
        fname = "stop" as &const byte;
    } else if o.finish == LLM_FINISH_TOOL_CALLS {
        fname = "tool_calls" as &const byte;
    } else if o.finish == LLM_FINISH_MAX_TOKENS {
        fname = "length" as &const byte;
    } else if o.finish == LLM_FINISH_ERROR {
        fname = "error" as &const byte;
    }
    // 未知 finish_reason 的原文是**外来字节**：转义 + 限长之后才许上屏（踩坑 33 的口径）
    var bad: Buf = buf_new(128);
    defer { buf_free(&bad); }
    if buf_valid(&bad) && o.bad_finish.len > 0 {
        _ = tty_diag_escape_into(&bad, o.bad_finish.ptr as &const byte, o.bad_finish.len, 64);
    }

    // 1) 转录一行：先说要干什么，再把证据（字段名固定，grep 得到）挂上
    if retrying {
        out_err("[retry] empty response from upstream (no content, no tool_calls) — resending the same request once");
    } else {
        out_err("error: model returned neither content nor tool_calls");
    }
    out_err(" [step=");
    out_err_dec(step as usize);
    out_err(" finish=");
    out_err(fname);
    out_err(" have_finish=");
    if o.have_finish {
        out_err("1");
    } else {
        out_err("0");
    }
    out_err(" bad_finish=");
    if bad.len == 0 {
        out_err("(none)");
    } else {
        out_err_bytes(bad.ptr as &const byte, bad.len);
    }
    out_err(" content=");
    out_err_dec(o.content.len);
    out_err("B reasoning=");
    out_err_dec(o.reasoning.len);
    out_err("B calls=");
    out_err_dec(o.ncalls);
    out_err(" usage={in=");
    out_err_dec(u_in as usize);
    out_err(" cache_read=");
    out_err_dec(u_cache_read as usize);
    out_err(" cache_write=");
    out_err_dec(u_cache_write as usize);
    out_err(" out=");
    out_err_dec(u_out as usize);
    out_err(" reasoning=");
    out_err_dec(u_reason as usize);
    out_err("} prompt=");
    out_err_dec(prompt_bytes);
    out_err("B/");
    out_err_dec(prompt_tokens as usize);
    out_err("tok retries=");
    out_err_dec(used as usize);
    out_err("/");
    out_err_dec(EMPTY_RETRY_MAX as usize);
    out_err("]\n");

    // 2) 同一条证据进会话日志：resume / 事后排障看的就是它（形状对齐 DSH 的 llm/retry：
    //    retry/maxRetries + 一个 failure 对象；retrying=false 表示「这次不重发了」）
    if g_sess.save {
        var ev: Buf = buf_new(1024);
        defer { buf_free(&ev); }
        if sess_begin(&g_sess, "llm/degenerate", &ev) {
            _ = buf_append_cstr(&ev, "{\"turn\":");
            _ = buf_append_i64(&ev, g_turn as i64);
            _ = buf_append_cstr(&ev, ",\"step\":");
            _ = buf_append_i64(&ev, step as i64);
            _ = buf_append_cstr(&ev, ",\"reason\":\"empty-response\",\"retries\":");
            _ = buf_append_i64(&ev, used);
            _ = buf_append_cstr(&ev, ",\"maxRetries\":");
            _ = buf_append_i64(&ev, EMPTY_RETRY_MAX as i64);
            _ = buf_append_cstr(&ev, ",\"retrying\":");
            if retrying {
                _ = buf_append_cstr(&ev, "true");
            } else {
                _ = buf_append_cstr(&ev, "false");
            }
            _ = buf_append_cstr(&ev, ",\"failure\":{\"finish\":");
            _ = jw_str_into(&ev, fname, bufx_cstr_len(fname));
            _ = buf_append_cstr(&ev, ",\"finishCode\":");
            _ = buf_append_i64(&ev, o.finish as i64);
            _ = buf_append_cstr(&ev, ",\"haveFinish\":");
            if o.have_finish {
                _ = buf_append_cstr(&ev, "true");
            } else {
                _ = buf_append_cstr(&ev, "false");
            }
            _ = buf_append_cstr(&ev, ",\"badFinish\":");
            _ = jw_str_into(&ev, bad.ptr as &const byte, bad.len);
            _ = buf_append_cstr(&ev, ",\"contentBytes\":");
            _ = buf_append_i64(&ev, o.content.len as i64);
            _ = buf_append_cstr(&ev, ",\"reasoningBytes\":");
            _ = buf_append_i64(&ev, o.reasoning.len as i64);
            _ = buf_append_cstr(&ev, ",\"calls\":");
            _ = buf_append_i64(&ev, o.ncalls as i64);
            _ = buf_append_cstr(&ev, ",\"promptBytes\":");
            _ = buf_append_i64(&ev, prompt_bytes as i64);
            _ = buf_append_cstr(&ev, ",\"promptTokens\":");
            _ = buf_append_i64(&ev, prompt_tokens);
            _ = buf_append_cstr(&ev, ",\"sawDone\":");
            if o.saw_done {
                _ = buf_append_cstr(&ev, "true");
            } else {
                _ = buf_append_cstr(&ev, "false");
            }
            _ = buf_append_cstr(&ev, ",\"events\":");
            _ = buf_append_i64(&ev, o.events as i64);
            _ = buf_append_cstr(&ev, ",\"usage\":{\"in\":");
            _ = buf_append_i64(&ev, u_in);
            _ = buf_append_cstr(&ev, ",\"cacheRead\":");
            _ = buf_append_i64(&ev, u_cache_read);
            _ = buf_append_cstr(&ev, ",\"cacheWrite\":");
            _ = buf_append_i64(&ev, u_cache_write);
            _ = buf_append_cstr(&ev, ",\"out\":");
            _ = buf_append_i64(&ev, u_out);
            _ = buf_append_cstr(&ev, ",\"reasoning\":");
            _ = buf_append_i64(&ev, u_reason);
            _ = buf_append_cstr(&ev, "}}}");
            _ = sess_end(&g_sess, &ev);
        }
    }
    return retrying;
}

// 一步收尾（流式/非流式共用）：usage、finish 语义、工具派发、最终回答。
// prompt_bytes = 本次请求体（prompt + tools + 外壳）的字节数 —— 退化响应的证据要用它，
// 而它只有调用方（拼请求的那一层）知道，所以一路带下来。
// retry_ok = 本步剩余的退化重发额度（指针：step 循环持有，这里扣）。
fn agent_finish_step(cfg: &Config, arena: &Arena, h: &History, step: i32, o: &const ChatOut, prompt_bytes: usize, retry_ok: &bool) i32 {
    // P9：记下这次请求的 prompt_tokens，作为下一次压缩判定的压力口径
    g_last_prompt_tokens = o.usage_in + o.usage_cache_read;
    if cfg.show_usage {
        print_usage_line(o);
    }
    agent_cache_burst_note(cfg, o);
    if o.finish == LLM_FINISH_ERROR {
        // 网关消息同样是外来字节：转义 + 限长（原来是无上限原样打印）
        out_diag("gateway-error", "model/gateway error: ", o.err_text.ptr as &const byte, o.err_text.len);
        return AGENT_PROTO;
    }

    // P54：退化响应（正常收尾但既没正文也没工具调用）—— 先取证据、再决定重发。
    // max-tokens 有自己的诊断分支（那是「截断」不是「退化」），所以先把它排掉。
    if o.ncalls == 0 && o.content.len == 0 && o.finish != LLM_FINISH_MAX_TOKENS {
        if agent_note_degenerate(step, o, prompt_bytes, retry_ok) {
            return STEP_RETRY;
        }
        return AGENT_PROTO;
    }

    // P59：**max_tokens 截断**（§5.4.1）。三件事，一件都不能少：
    //
    // ① **不派发**任何工具调用 —— 参数可能是半截的，派发出去只会得到一条协议错
    //    （对齐 DSH：它的 assembler 在 max-tokens 时把 tool-call 块整块滤掉）；
    // ② 日志与历史**只留正文**：日志不留 tool_calls（keep_calls=false，理由见
    //    `agent_log_assistant`），历史压一条普通 assistant 消息 —— 这与中断那条路
    //    同一个形状（`agent_trim_trailing_ws` 剪掉断口处的空白再入史）；
    // ③ 收口是 **warning 而不是 error**：截断不是「模型/协议出错」，是这一轮的输出
    //    预算用完了。DSH 在这一步打的是 warn 色的「已达到输出 token 上限 / 回答被截断，
    //    已有输出保留在对话中。发送"继续"可让模型接着输出」—— 本函数照抄它的语义。
    //
    // **为什么正文必须进历史**：用户看到「这一轮被截断了」之后的第一个动作就是回一句
    // 「继续」。历史里没有那段正文的话，模型连自己刚写到哪都不知道，只能从零重来
    // （真机现场：一整轮的工具调用白跑）。DSH 的提示语里那句「已有输出保留在对话中」
    // 说的就是这件事。
    if o.finish == LLM_FINISH_MAX_TOKENS {
        agent_bound_assistant_message(cfg, h, step, o, false);
        // 断口处的空白先剪掉：半句话尾巴上挂一串空白，下一轮请求里就是噪声
        const keep_cut: usize = agent_trim_trailing_ws(o.content.ptr as &const byte, o.content.len);
        if keep_cut > 0 {
            var pushed_c: bool = hist_push(h, ROLE_ASSISTANT, o.content.ptr as &const byte, keep_cut);
            while !pushed_c {
                if !hist_drop_oldest(h) {
                    break;
                }
                out_err("[history] dropped oldest message to stay within limits\n");
                pushed_c = hist_push(h, ROLE_ASSISTANT, o.content.ptr as &const byte, keep_cut);
            }
        }
        if keep_cut > 0 && o.printed_chars == 0 {
            out_bytes(o.content.ptr as &const byte, keep_cut);
        }
        // 正文和收口那两行之间必须先断开：流式（默认）早就把正文打出去了、**不带收尾换行**，
        // 少这一下 `warning:` 就会粘在半句话的尾巴上（与最终答复那条路同一个写法）。
        if keep_cut > 0 {
            out_err("\n");
        }
        // 转录：一句 warning + 一句「下一步怎么做」。--quiet 也照打 —— 它是「这一轮
        // 没跑完、画面上的东西是半截的」的唯一信号，静音掉等于骗人。
        out_err("warning: 模型输出到达 token 上限（max_tokens）被截断，本回合到此为止（不是错误）\n");
        out_err("[max-tokens] ");
        if o.ncalls > 0 {
            out_err_dec(o.ncalls as usize);
            out_err(" 个工具调用已丢弃（参数可能是半截的，派发只会得到协议错）；");
        }
        if keep_cut > 0 {
            out_err("已产出的正文留在对话里 —— 直接发「继续」即可让模型接着做\n");
        } else {
            out_err("这一步没有正文可留（输出预算全花在思考上）—— 发「继续」重试，或调低推理强度 / 调高 max_tokens\n");
        }
        return AGENT_MAX_TOKENS;
    }

    agent_bound_assistant_message(cfg, h, step, o, true);

    if o.ncalls > 0 {
        if cfg.compat_fold {
            // 折叠协议：工具结果拼成**一条 user 消息**回灌（老端点兼容）
            var results: Buf = buf_new(16384);
            if !buf_valid(&results) {
                out_err("error: out of memory (tool results)\n");
                return AGENT_PROTO;
            }
            _ = buf_append_cstr(&results, "工具执行结果如下，请据此继续；如果你已经能给出最终答案就直接回答：\n");
            if o.content.len > 0 {
                _ = buf_append_cstr(&results, "[你上一轮的说明] ");
                _ = buf_append(&results, o.content.ptr, o.content.len);
                _ = buf_append_byte(&results, 10);
            }
            var ci: usize = 0;
            while ci < o.ncalls {
                view_begin_tool(arena, &o.calls[ci].name, &o.calls[ci].args);
                var res_f: Buf = buf_new(4096);
                // tool/call 在派发**之前**落地，tool/result 在之后：日志上的时间差才是
                // 真实工具耗时（统计的 toolMs 就吃这个差值）
                agent_bound_tool_call(cfg, h, step, &o.calls[ci].id, &o.calls[ci].name, &o.calls[ci].args);
                dispatch_tool_body(cfg, &o.calls[ci].name, &o.calls[ci].args, arena, &res_f);
                view_end_tool(arena, &o.calls[ci].name, &o.calls[ci].args, &res_f);
                agent_tasks_sync();
                agent_bound_tool_result(cfg, h, step, &o.calls[ci].id, &res_f);
                _ = buf_append_cstr(&results, "[tool ");
                _ = buf_append(&results, o.calls[ci].name.ptr, o.calls[ci].name.len);
                _ = buf_append_cstr(&results, "] ");
                _ = buf_append(&results, res_f.ptr, res_f.len);
                _ = buf_append_byte(&results, 10);
                buf_free(&res_f);
                ci = ci + 1;
            }
            var pushed_f: bool = hist_push(h, ROLE_USER, results.ptr as &const byte, results.len);
            while !pushed_f {
                if !hist_drop_oldest(h) {
                    break;
                }
                out_err("[history] dropped oldest message to stay within limits\n");
                pushed_f = hist_push(h, ROLE_USER, results.ptr as &const byte, results.len);
            }
            buf_free(&results);
            if !pushed_f {
                // 折叠路径没有 assistant(tool_calls) 要配对，失败不会留下坏历史；
                // 超长文本已由 hist_fit_text 缩过，这里只剩真 OOM。
                out_err("error: 工具结果无法写入历史（内存不足）\n");
                return AGENT_PROTO;
            }
            return STEP_CONTINUE;
        }

        // 严格协议：assistant（含 tool_calls 原样）→ 逐条 role:"tool" 结果
        //
        // 容量按**实际需要**算（calls_json_make）：以前是固定 8192，工具参数一大就把
        // 「参数比 8 KiB 大」误报成 "out of memory serializing tool_calls" 并中止整轮 ——
        // 而且报错点在入史之前，那一步的 assistant 事件也不会落日志，事后无从查证。
        const need: usize = calls_json_need(o);
        var calls_json: Buf = buf_empty();
        defer { buf_free(&calls_json); }
        if !calls_json_make(o, &calls_json) {
            // 容量是精确算的（还带 CALLS_JSON_SLACK 余量）：走到这里只剩真分配不出来
            out_err("error: out of memory serializing tool_calls (");
            out_err_dec(need);
            out_err(" bytes)\n");
            return AGENT_PROTO;
        }
        var pushed_a: bool = hist_push_msg(h, ROLE_ASSISTANT_CALLS, o.content.ptr as &const byte, o.content.len, calls_json.ptr as &const byte, calls_json.len);
        while !pushed_a {
            if !hist_drop_oldest(h) {
                break;
            }
            out_err("[history] dropped oldest message to stay within limits\n");
            pushed_a = hist_push_msg(h, ROLE_ASSISTANT_CALLS, o.content.ptr as &const byte, o.content.len, calls_json.ptr as &const byte, calls_json.len);
        }
        if !pushed_a {
            // extra（tool_calls 原文）不能裁剪（截断就是非法 JSON，端点必 400），
            // 所以超过单条上限只能整轮退出 —— 把两个数字都报出来，别再让人猜
            out_err("error: could not append assistant message to history（tool_calls 原文 ");
            out_err_dec(calls_json.len);
            out_err(" 字节，单条上限 ");
            out_err_dec(MSG_CONTENT_MAX);
            out_err("；或内存不足）\n");
            return AGENT_PROTO;
        }
        // 本步这一组的起点：它就是受保护区域的下界 —— 丢老消息时**不允许**碰到
        // 这条 assistant(tool_calls) 以及它已经压入的 tool 结果，否则历史会变成
        // 「悬空 tool_calls」，端点必然 400（历史默认不限条数，所以这条只在内存吃紧时生效）。
        const group_start: usize = h.len - 1;

        var ci: usize = 0;
        while ci < o.ncalls {
            view_begin_tool(arena, &o.calls[ci].name, &o.calls[ci].args);
            var res: Buf = buf_new(4096);
            if !buf_valid(&res) {
                out_err("error: out of memory (tool result)\n");
                hist_truncate_to(h, group_start);
                return AGENT_PROTO;
            }
            agent_bound_tool_call(cfg, h, step, &o.calls[ci].id, &o.calls[ci].name, &o.calls[ci].args);
            dispatch_tool_body(cfg, &o.calls[ci].name, &o.calls[ci].args, arena, &res);
            view_end_tool(arena, &o.calls[ci].name, &o.calls[ci].args, &res);
            agent_tasks_sync();
            agent_bound_tool_result(cfg, h, step, &o.calls[ci].id, &res);
            if res.len == 0 {
                // 空结果在线上必须是 "(no output)"（对齐 DSH）
                _ = buf_append_cstr(&res, "(no output)");
            }
            // 结果来自哪个工具，决定构请求时用哪条剪枝规则（P27：bash 走行式剪枝）
            var rkind: u8 = CMP_KIND_TOOL;
            if sv_eq_cstr(&o.calls[ci].name, "bash") {
                rkind = CMP_KIND_BASH;
            }
            // 每条结果都必须进历史：assistant(tool_calls) 与它的 tool 结果是一个原子组，
            // 半截的话请求会被端点以 "insufficient tool messages following tool_calls" 拒掉，
            // 而且这条坏历史会一直留在会话里（/continue 永远 400）。
            //
            // 本组起点 = h.len - ci - 1（ci 条结果已在本组里；丢老消息只是让两边同比下移）。
            // 它是 hist_drop_oldest_below 的上界：受保护区域之内一条都不许丢。
            var pushed_t: bool = hist_push_tool_kind(h, rkind, res.ptr as &const byte, res.len, o.calls[ci].id.ptr as &const byte, o.calls[ci].id.len);
            while !pushed_t {
                var floor: usize = 1;
                if h.len > ci + 1 {
                    floor = h.len - ci - 1;
                }
                if !hist_drop_oldest_below(h, floor) {
                    break;
                }
                out_err("[history] dropped oldest message to stay within limits\n");
                pushed_t = hist_push_tool_kind(h, rkind, res.ptr as &const byte, res.len, o.calls[ci].id.ptr as &const byte, o.calls[ci].id.len);
            }
            buf_free(&res);
            if !pushed_t {
                // 回滚整组：宁可不记这一步，也不留下半截（历史必须始终满足配对要求）
                var floor2: usize = 1;
                if h.len > ci + 1 {
                    floor2 = h.len - ci - 1;
                }
                hist_truncate_to(h, floor2);
                out_err("error: out of memory appending tool result; step rolled back\n");
                return AGENT_PROTO;
            }
            ci = ci + 1;
        }
        return STEP_CONTINUE;
    }

    if o.content.len > 0 {
        if o.printed_chars == 0 {
            out_bytes(o.content.ptr as &const byte, o.content.len);
        }
        out_err("\n");
        return AGENT_OK;
    }
    out_err("error: model returned neither content nor tool_calls\n");
    return AGENT_PROTO;
}

// 建历史：一条 system + 可选的第一条 user
fn agent_hist_init(cfg: &const Config, h: &History, first: &const Buf) bool {
    // P37：worktree 模式 —— 新会话在**建 system prompt 之前**就把工作区搬进 worktree
    // （独立工作区执行）。调用点只有这里，所以「新会话」的判定就落在这个函数上：
    // --resume / fork / 子代理 都不走这条路（它们的会话记录里已经带着工作区）。
    agent_worktree_begin(cfg);
    var sp: Buf = buf_new(32768);
    defer { buf_free(&sp); }
    if !agent_system_prompt(cfg, &sp) {
        return false;
    }
    if !hist_push(h, ROLE_SYSTEM, sp.ptr as &const byte, sp.len) {
        return false;
    }
    agent_inject_context(cfg, h);
    agent_log_delegation(cfg);
    if first.len > 0 {
        return hist_push(h, ROLE_USER, first.ptr as &const byte, first.len);
    }
    return true;
}

// 一次 turn 的 step 循环：history 里已经包含 system 与本轮的 user 消息
fn agent_turn_loop(cfg: &Config, h: &History) i32 {
    g_turn = g_turn + 1;
    agent_log_turn_start();
    const rc: i32 = agent_turn_loop_inner(cfg, h);
    // 回合结束时历史可能停在「一步只压了一半」的形状上（这一步的 tool 结果没能进历史）。
    // 修回配对完整 —— 否则下一条 /continue 会被端点以
    // "insufficient tool messages following tool_calls" 一直 400（用户实际踩到过）。
    if h.len > 1 {
        const tail_role: u8 = msg_at(h, h.len - 1).role;
        if tail_role == ROLE_TOOL || tail_role == ROLE_ASSISTANT_CALLS {
            const repaired: usize = hist_trim_incomplete_tail(h);
            if repaired > 0 {
                out_err("[history] 丢弃了 ");
                out_err_dec(repaired);
                out_err(" 条「未完成一轮」的尾部消息\n");
            }
        }
    }
    if rc == AGENT_INTERRUPTED {
        agent_log_turn_end("aborted");
    } else if rc == AGENT_OK {
        agent_log_turn_end("completed");
    } else if rc == AGENT_MAX_TOKENS {
        // P59：对齐 DSH 的 turn/end reason —— 它在这一步记的是 `{kind:"max-tokens"}`：
        // 「截断」既不是 completed（没走到最终答复）也不是 error（谁都没出错）。
        agent_log_turn_end("max-tokens");
    } else if rc == AGENT_NET {
        agent_log_turn_end("error");
    } else {
        // 可能是 max-steps 熔断，也可能是协议/工具错
        agent_log_turn_end("error");
    }
    st_turn_end();
    agent_stats_sync(cfg, h);
    // P46：自动起标题 —— 回合收尾**只挂待办**，真正发请求在空闲主循环里
    // （理由见 agent_title_auto_schedule：在这里同步发会拖长「回合没结束」的窗口，
    // 而运行中敲进来的命令要等 step 边界才被领取 —— p30-check 抓到过这条）。
    if rc == AGENT_OK {
        agent_title_auto_schedule(cfg);
    }
    agent_pump_ctx_end(cfg);
    return rc;
}

// 非流式响应体按协议解析（两条路径共用同一个 ChatOut）
fn agent_parse_nonstream(style: u8, root: &JsonValue, o: &ChatOut) !void {
    if style == LLM_STYLE_RESPONSES {
        return responses_out_from_nonstream(root, o);
    }
    return chat_out_from_nonstream(root, o);
}

// 非流式一步（--no-stream）：与流式共用 agent_finish_step 收尾。
// style 必须与 req 的组装协议一致；out_status 回传 HTTP 状态码（协商回退要用）。
fn agent_step_plain(cfg: &const Config, style: u8, url: &const Buf, hdrs: &const Buf, req: &const Buf, arena: &Arena, h: &History, step: i32, out_status: &i32, retry_ok: &bool) i32 {
    var resp: Resp = resp_empty();
    var tc: TlsConn = tls_conn_empty();
    var guard: FdGuard = FdGuard{ saved: -1, nullfd: -1, active: false };
    tls_noise_mute(&guard, !cfg.tls_debug && !hc_debug);
    const call_res: !void = http_request(
        url.ptr[0: url.len],
        &"POST"[0: 4],
        hdrs.ptr[0: hdrs.len],
        req.ptr as &const byte,
        req.len,
        cfg.timeout_ms,
        cfg.max_response,
        cfg.verify,
        cfg.pin.ptr[0: cfg.pin.len],
        &resp,
        &tc
    );
    tls_noise_unmute(&guard);
    _ = call_res catch {
        out_err("error: 请求失败（网络或 TLS 校验）。\n");
        if tc.observed_len > 0 {
            out_err("  本次观测到的 leaf 证书 SHA-256 = ");
            out_err_bytes(&tc.observed[0], tc.observed_len);
            out_err("\n");
            out_err("  链校验在真实站点常失败（见 §18）；用这个指纹重试：\n");
            out_err("  uya-agent --tls-verify=pin --tls-pin <上面的指纹> ...\n");
        } else {
            out_err("  检查 base-url / 网络；证书问题可先用 --probe --tls-verify=none 看指纹。\n");
        }
        return AGENT_NET;
    };

    if resp.status != 200 {
        out_status[0] = resp.status;
        // 协商探测的那一次不刷屏（同流式路径）
        if !api_may_negotiate(cfg, style, resp.status) {
            dump_http_error(resp.status, &resp.body);
        }
        resp_free(&resp);
        return AGENT_PROTO;
    }
    out_status[0] = resp.status;

    // 关键：std.json 的 parse 是**零拷贝**的 —— JsonValue 树（含所有字符串视图）
    // 都指向输入缓冲区。所以先把响应体复制进 arena 再解析，解析完就能安全释放响应体；
    // 否则会出现「偶发 use-after-free」：free 之后堆内存一被复用，
    // choices/message 就查不到，表现为莫名其妙的 "response has no choices[0].message"。
    const resp_len: usize = resp.body.len;
    const body_copy: &byte = arena_alloc(arena, resp_len + 1);
    if (body_copy as usize) == 0 {
        out_err("error: out of memory copying response\n");
        resp_free(&resp);
        return AGENT_PROTO;
    }
    _ = mem_copy(body_copy, resp.body.ptr as &const byte, resp_len);
    const body_copy_end: &byte = @ptr_from_usize(@usize_from_ptr(body_copy as &void) + resp_len) as &byte;
    _ = mem_set(body_copy_end, 0, 1);
    resp_free(&resp);

    var root: JsonValue = JsonValue.json_null();
    if !js_parse(arena, body_copy, resp_len, &root) {
        out_err("error: cannot parse model response as JSON\n");
        out_diag("non-json-body", "body: ", body_copy as &const byte, resp_len);
        return AGENT_PROTO;
    }

    // 非流式响应 → 与流式相同的 ChatOut 结构，收尾逻辑完全共用
    var o2: ChatOut = chat_out_new();
    defer { chat_out_free(&o2); }
    const fill_res: !void = agent_parse_nonstream(style, &root, &o2);
    _ = fill_res catch {
        out_err("error: cannot parse model response message\n");
        return AGENT_PROTO;
    };
    // P16：非流式没有实时行，思考只在收尾时落一行 + 记全文（与流式同一个收尾口径）
    agent_note_reasoning(step, &o2);
    return agent_finish_step(cfg, arena, h, step, &o2, req.len, retry_ok);
}

// ---- P55：执行期两条纪律 ----
//
// 实测（同一个「把 50 个源文件拆进子目录」任务，dsh 对比 uya-agent）：
//   * 输出 token 的 90% 是**思考**，正文只占 2%、工具参数两边几乎一样多；
//   * uya-agent 的思考量是 dsh 的 4.5 倍，其中一条固定浪费是「方案在推理里被反复重列」
//     （50 个文件的映射在 step10–17 被重列，`src/` 在一段推理里出现 281 次）；
//   * 另一条是「验收通过之后还不收工」：make build 在同一回合里跑了三遍。
// 所以这里加两个可判定的机制（都不改默认行为）：
//   ① 低思考执行态（--exec-effort V --exec-after N）：前 N 步用配置档位把方案想清，
//      之后切到 V 执行 —— 对齐实测里"想一次就进入低思考执行"的那种形态。
//   ② 收工提醒 + 收工预算（--grace-steps N）：验收类 bash 命令在**改动之后**第一次跑绿时，
//      往结果尾部追加一行提醒；配了 N 就再给 N 步收工，用尽即提前结束本回合。

fn agent_turn_loop_inner(cfg: &Config, h: &History) i32 {
    // P30：登记「当前回合」——阻塞循环里的统一泵点要用它来派发运行中的命令
    // （P31：主循环跑命令时也登记同一份上下文，见 agent_pump_ctx_begin）
    agent_pump_ctx_begin(cfg, h);
    // P55：回合开始复位执行期纪律的那点状态 ——
    //   * 上一回合切下去的低档位先还原（配置档位是每个回合的起点，不然一次任务之后就永久降档了）；
    //   * 本回合的改动计数 / 验收锚点 / 提醒计数清零（收工预算按回合算）。
    g_exec.mod_seq = 0;
    g_exec.accept_mod_seq = 0;
    g_exec.accept_step = 0;
    g_exec.notes = 0;
    if g_exec.on {
        g_exec.on = false;
        if g_exec.base.len > 0 {
            _ = agent_effort_apply(cfg, g_exec.base.ptr as &const byte, g_exec.base.len, false, "exec-restore" as &const byte);
        }
    }
    var hdrs: Buf = buf_new(512);
    defer { buf_free(&hdrs); }
    if !build_headers(cfg, &hdrs) {
        out_err("error: out of memory\n");
        return AGENT_PROTO;
    }

    const arena_cap: usize = cfg.max_response + 65536;
    const arena_raw: &void = malloc(arena_cap);
    if ((arena_raw as &byte) as usize) == 0 {
        out_err("error: out of memory (arena)\n");
        return AGENT_PROTO;
    }
    defer { free(arena_raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, arena_cap);

    var step: i32 = 0;
    // max_steps <= 0（默认）＝ 不限步数：只有模型给出「不含 tool_calls 的最终答案」才结束。
    // 显式给了正整数时才是熔断上限（下面循环结束后那条错误）。
    while cfg.max_steps <= 0 || step < cfg.max_steps {
        step = step + 1;
        // P55：收工预算（--grace-steps N，默认 0 = 只提醒、不设硬上限）。
        // 锚点是「验收类命令在改动之后第一次跑绿」的那一步：从那一步起只给 N 步收工，
        // 用尽就提前结束本回合。默认关闭 —— 硬截断会让模型来不及给最终答复。
        if cfg.grace_steps > 0 && g_exec.accept_step > 0 && step > g_exec.accept_step + cfg.grace_steps {
            out_err("[grace] 验收已通过（第 ");
            out_err_dec(g_exec.accept_step as usize);
            out_err(" 步），收工预算 ");
            out_err_dec(cfg.grace_steps as usize);
            out_err(" 步已用尽：本回合提前收工（改动已保留，请查 /diff 或 git log）\n");
            return AGENT_PROTO;
        }
        // P28：step 边界先问一句「用户是不是已经要停了」。
        // 中断/退出意图在**下一个 step 边界**生效（DSH 口径）——那就没必要再发一个
        // 注定会被自己掐断的请求出去：用户按下 esc/ctrl+d 之后，要的是**马上**回到输入态，
        // 而不是等一个来回的网络（真机上这一下就是 1–2 秒）。
        if tui_abort_state() != TUI_ABORT_NONE {
            tty_puts(&tty_ui, 2, "\n[interrupted] 已中断本回合（历史保留，可直接继续输入）\n");
            return AGENT_INTERRUPTED;
        }
        // DSH steer 语义：step 边界领取「运行期间用户敲进来的输入」，作为普通 user 消息
        agent_claim_steer(cfg, h);
        // P23：运行中在命令面板里选中的只读命令（/status 等）也在这一步派发 ——
        // 以前面板结果只有主循环会取，而主循环整个回合都不跑，屏幕上就是「没反应」。
        agent_tui_poll_pending_cmd(cfg, h);
        // P30：step 边界是 /compact 的落点（运行中敲进来的排队命令终于有地方落地了）
        agent_tui_step_boundary_cmd(cfg, h);
        // P9：step 边界测压，必要时压缩上下文（DSH 也是在 request derivation 之前做）
        if g_compact_enabled {
            _ = agent_maybe_compact(cfg, h, step, false);
        }
        // P26：plan 模式变了就在这一步补推一份新快照（放在压缩之后：别刚推就被折进 checkpoint）
        agent_plan_snapshot_sync(cfg, h);
        // P34：工作区变了（模型自己调的 workspace 工具 / 人敲的 /workspace）也在这一步补推：
        // 运行时上下文里那句 Current workspace 与新工作区的 AGENTS.md 都要跟上
        agent_ws_snapshot_sync(cfg, h);
        agent_bound_step_start(cfg, h, step);
        // P55：低思考执行态 —— 前 exec_after 步用配置档位把方案想清，之后切到 exec_effort 执行。
        // 只在配了 --exec-effort / --exec-after 时生效；逻辑内联在这里（本仓不能再加顶层函数，
        // 见 ExecState 上面那段注释）。
        g_exec.step = step;
        if !g_exec.on && !g_exec.off && cfg.exec_after > 0 && cfg.exec_effort.len > 0 && step > cfg.exec_after {
            if cfg.reasoning_effort.len > 0 {
                buf_free(&g_exec.base);
                g_exec.base = buf_new(cfg.reasoning_effort.len + 8);
                _ = buf_append(&g_exec.base, cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);
            }
            const xrc: i32 = agent_effort_apply(cfg, cfg.exec_effort.ptr as &const byte, cfg.exec_effort.len, false, "exec-effort" as &const byte);
            if xrc == 2 {
                // 档位不在该模型公布的清单里：不切，并且别每一步白试一次
                g_exec.off = true;
                out_err("[exec-effort] 跳过：");
                out_err_bytes(cfg.exec_effort.ptr, cfg.exec_effort.len);
                out_err(" 不在当前模型公布的档位里\n");
            } else {
                g_exec.on = true;
                if g_interactive {
                    var xnote: Buf = buf_new(128);
                    if buf_valid(&xnote) {
                        _ = buf_append_cstr(&xnote, "执行期降档 → ");
                        _ = buf_append(&xnote, cfg.exec_effort.ptr as &const byte, cfg.exec_effort.len);
                        _ = buf_append_cstr(&xnote, "（前 ");
                        _ = buf_append_u64(&xnote, cfg.exec_after as u64);
                        _ = buf_append_cstr(&xnote, " 步用原档位）");
                        tui_add_notice(xnote.ptr as &const byte, xnote.len);
                        buf_free(&xnote);
                    }
                }
            }
        }
        if g_interactive {
            // 状态显示走提示符（避免两行光标的复杂度）；子代理面板在提示符上方
            agent_agents_tick();
            var ps: Buf = buf_new(64);
            if buf_valid(&ps) {
                _ = buf_append_cstr(&ps, "[step ");
                _ = buf_append_u64(&ps, step as u64);
                agent_prompt_suffix(&ps);
                _ = buf_append_cstr(&ps, "] > ");
                _ = buf_append_byte(&ps, 0);
                tty_set_prompt(&tty_ui, ps.ptr as &const byte);
                buf_free(&ps);
                tty_draw_line(&tty_ui, 2);
            }
        }
        arena_reset(&arena);

        const need: usize = request_bytes_needed(h, cfg);
        var req: Buf = buf_new(need);
        if !buf_valid(&req) {
            out_err("error: out of memory (request)\n");
            agent_bound_step_end(cfg, h, step);
            return AGENT_PROTO;
        }
        var url: Buf = buf_new(cfg.base_url.len + 24);
        if !buf_valid(&url) {
            buf_free(&req);
            out_err("error: out of memory\n");
            agent_bound_step_end(cfg, h, step);
            return AGENT_PROTO;
        }

        // 协议协商：未声明时首个请求先按 responses 发；只有「端点不存在」（404/405/501）
        // 才回退 chat/completions 并在**同一步**用另一个协议重发一次（每进程只协商一次）。
        //
        // P54：本步的**退化响应重发额度**（step 循环持有，agent_note_degenerate 扣）。
        // 与协商回退同一个形状：都在这个内层循环里把同一步重发一次，历史不动 ——
        // 于是重算出来的 url/req 与上一次逐字节相同（自测「重发的请求体一字不差」钉的就是它）。
        var retry_ok: bool = EMPTY_RETRY_MAX > 0;
        var step_rc: i32 = AGENT_PROTO;
        var sent: bool = false;
        while !sent {
            const style: u8 = api_style_now(cfg);
            if !api_url_into(cfg, style, &url) {
                buf_free(&req);
                buf_free(&url);
                out_err("error: out of memory\n");
                agent_bound_step_end(cfg, h, step);
                return AGENT_PROTO;
            }
            if !build_model_request(cfg, h, &req, style) {
                buf_free(&req);
                buf_free(&url);
                out_err("error: cannot build request（历史可能过大，试 /compact 或 --context-window）\n");
                agent_bound_step_end(cfg, h, step);
                return AGENT_PROTO;
            }
            var status: i32 = 0;
            var rc: i32 = AGENT_PROTO;
            if cfg.stream {
                rc = agent_step_stream(cfg, style, &url, &hdrs, &req, &arena, h, step, g_interactive, &status, &retry_ok);
            } else {
                rc = agent_step_plain(cfg, style, &url, &hdrs, &req, &arena, h, step, &status, &retry_ok);
            }
            if api_negotiate(cfg, style, status) {
                continue;   // 换协议重发：下一轮重算 url/req
            }
            api_lock(cfg, style);
            if rc == STEP_RETRY {
                // 退化响应：额度已经在 agent_note_degenerate 里扣掉、证据也落了，这里只管重来
                continue;
            }
            step_rc = rc;
            sent = true;
        }
        buf_free(&req);
        buf_free(&url);
        agent_bound_step_end(cfg, h, step);
        if step_rc == STEP_CONTINUE {
            continue;
        }
        return step_rc;
    }
    out_err("error: step limit reached (");
    out_err_dec(cfg.max_steps as usize);
    out_err(" steps); raise it with --max-steps N, or 0 for unlimited");
    if g_interactive {
        out_err("；输入 /continue 可继续，或直接给新任务");
    }
    out_err("\n");
    return AGENT_PROTO;
}


// 建/恢复会话历史：先尝试恢复（含 system），否则新建（system + 可选首条 user）
// tool_calls 数组里有几个调用（extra 是本项目自己序列化出来的数组原文）
fn hist_calls_count(arena: &Arena, extra: &byte, extra_len: usize) usize {
    if extra_len == 0 {
        return 0;
    }
    arena_reset(arena);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(arena, extra, extra_len, &root) {
        return 0;
    }
    return js_arr_len(&root);
}

// 下标 g 处的 assistant(tool_calls) 这一组是否**应答完整**：
// 紧跟其后的 tool 消息条数等于调用条数，且每个 tool_call_id 都能在该组的调用 id 里找到。
// 完整的一组才是网关接受的形状；不完整的一组必须整组丢掉。
fn hist_group_ok(arena: &Arena, h: &const History, g: usize) bool {
    if g >= h.len {
        return false;
    }
    const a: &const Msg = msg_at(h, g);
    if a.role != ROLE_ASSISTANT_CALLS || a.extra_len == 0 {
        return false;
    }
    arena_reset(arena);
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(arena, a.extra, a.extra_len, &root) {
        return false;   // tool_calls 本身坏了：当作不完整（整组丢）
    }
    const nc: usize = js_arr_len(&root);
    if nc == 0 {
        return false;
    }
    var nt: usize = 0;
    var i: usize = g + 1;
    while i < h.len && msg_at(h, i).role == ROLE_TOOL {
        nt = nt + 1;
        i = i + 1;
    }
    if nt != nc {
        return false;
    }
    var k: usize = 0;
    while k < nc {
        var cm: JsonValue = JsonValue.json_null();
        if !js_arr_get(&root, k, &cm) {
            return false;
        }
        var cid: JsonStrView = JsonStrView{ ptr: null, len: 0 };
        if !js_obj_get_str(&cm, "id", 2, &cid) || cid.len == 0 {
            return false;
        }
        var hit: bool = false;
        var t: usize = 0;
        while t < nt {
            const tm: &const Msg = msg_at(h, g + 1 + t);
            if tm.extra_len == cid.len {
                var same: bool = true;
                var q: usize = 0;
                while q < cid.len {
                    if tm.extra[q] != cid.ptr[q] {
                        same = false;
                        break;
                    }
                    q = q + 1;
                }
                if same {
                    hit = true;
                    break;
                }
            }
            t = t + 1;
        }
        if !hit {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// 整段历史是否满足严格工具协议的配对要求：每个 assistant(tool_calls) 后面必须紧跟
// 应答它的 N 条 tool，且不允许出现孤儿 tool 消息。自测/排障用，不进请求热路径。
export fn hist_pairing_ok(h: &const History) bool {
    const raw: &void = malloc(1 << 20);
    if ((raw as &byte) as usize) == 0 {
        return false;
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 1 << 20);
    var i: usize = 0;
    while i < h.len {
        const r: u8 = msg_at(h, i).role;
        if r == ROLE_ASSISTANT_CALLS {
            if !hist_group_ok(&arena, h, i) {
                return false;
            }
            const nc: usize = hist_calls_count(&arena, msg_at(h, i).extra, msg_at(h, i).extra_len);
            i = i + 1 + nc;
            continue;
        }
        if r == ROLE_TOOL {
            return false;   // 孤儿 tool：它的 assistant 已经不在了
        }
        i = i + 1;
    }
    return true;
}

// 去掉结尾「不完整的一轮」：悬空的 tool 结果，以及应答不全（或压根没有应答）的
// assistant(tool_calls)。三种场景都会遇到：
//   1) fork 出来的子代理在父回合**进行中**读取父历史（父的 tool 结果还没落盘）；
//   2) 会话日志在崩溃时停在半路；
//   3) 某一组 tool 结果没能写进历史（旧实现里 MSG_MAX 打满就是这样）。
// **只丢不完整的那一组**：完整的一组必须原样保留（旧实现会把完整的一组也丢掉，
// 等于每次恢复都白丢一步）。修完以后历史一定满足配对要求，请求不会再被网关以
// "an assistant message with 'tool_calls' must be followed by tool messages" 拒掉。
export fn hist_trim_incomplete_tail(h: &History) usize {
    const raw: &void = malloc(1 << 20);
    if ((raw as &byte) as usize) == 0 {
        return 0;   // 内存不足时不做破坏性裁剪
    }
    defer { free(raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, raw as &byte, 1 << 20);
    var dropped: usize = 0;
    while h.len > 1 {
        const last: usize = h.len - 1;
        const r: u8 = msg_at(h, last).role;
        if r == ROLE_ASSISTANT_CALLS {
            hist_truncate_to(h, last);   // 一个应答都没有：整条丢
            dropped = dropped + 1;
            continue;
        }
        if r != ROLE_TOOL {
            break;   // 结尾是 user/system/纯文本 assistant：形状本来就是合法的
        }
        var start: usize = last;
        while start > 0 && msg_at(h, start - 1).role == ROLE_TOOL {
            start = start - 1;
        }
        if start == 0 || msg_at(h, start - 1).role != ROLE_ASSISTANT_CALLS {
            dropped = dropped + (h.len - start);   // 孤儿 tool 结果
            hist_truncate_to(h, start);
            continue;
        }
        const g: usize = start - 1;
        if hist_group_ok(&arena, h, g) {
            break;   // 完整的一组：保留
        }
        dropped = dropped + (h.len - g);
        hist_truncate_to(h, g);
    }
    return dropped;
}

// 回合前的历史准备（§3.2 的最后一步）。三条路：
//   恢复（`--resume` / `--continue`）→ 读元信息定工作区 → `agent_hist_from_log` → 续写；
//   `--resume-dsh` → 先导入 DSH 会话；
//   新建 → `agent_hist_init`：`agent_worktree_begin`（可能 chdir）→ 装配 system prompt →
//     注入运行时上下文 → 记 `subagent/start` → push 首条 user 消息。
// **这个顺序不能换**：worktree 会 chdir，而 prompt 的 `{{cwd}}`、AGENTS.md、技能根
// 全按当前工作目录求值（§3.2）。
fn agent_history_begin(cfg: &Config, h: &History, first: &const Buf) bool {
    fsctx_init(cfg);
    // 统计是「当前会话」口径：换会话（/new、/resume）先清零，resume 的那一份由
    // agent_hist_from_log 在扫描日志时重建
    st_reset();
    // 清单同理：它只活在这一条会话里（--resume 也不回填，见 README §7）。
    // 放在这里而不是 /new、/resume 各自的落点：启动、fork、恢复、换会话走的都是这条路。
    agent_session_scoped_reset();
    g_ctx_est_at_sample = -1;
    // 导入 DSH 自己的会话（--resume-dsh <id 前缀>）：读它的 jsonl(.zstd) 转成我们的历史，
    // 然后开**我们自己的**会话继续（不写 DSH 的日志）
    if cfg.resume_dsh.len > 0 {
        var home: Buf = buf_new(1024);
        defer { buf_free(&home); }
        if agent_default_dsh_home(cfg, &home) {
            var ss: DshSessions = DshSessions{ items: [], n: 0 };
            dshs_init(&ss);
            defer { dshs_free(&ss); }
            dshs_list(home.ptr[0: home.len], &"x"[0: 0], &ss);
            const found: isize = dshs_find(&ss, cfg.resume_dsh.ptr as &const byte);
            if found < 0 {
                out_err("error: 找不到 DSH 会话 ");
                out_err_bytes(cfg.resume_dsh.ptr, cfg.resume_dsh.len);
                out_err("（用 --list-dsh-sessions 看可用 id；id 前缀 8 个字符以上即可）\n");
                return false;
            }
            const si: usize = found as usize;
            if si >= DSHS_MAX {
                return false;
            }
            // P22：DSH 的会话标题在日志的 session/title 事件里，导入时一并取出来
            var dsh_title: Buf = buf_new(512);
            defer { buf_free(&dsh_title); }
            const n: usize = dshs_import(cfg, &ss.items[si], h, &dsh_title);
            out_err("[dsh-session] 从 ");
            out_err_bytes(ss.items[si].id.ptr, ss.items[si].id.len);
            out_err(" 导入了 ");
            out_err_dec(n);
            out_err(" 条消息（cwd=");
            out_err_bytes(ss.items[si].cwd.ptr, ss.items[si].cwd.len);
            out_err("）\n");
            if n > 0 {
                _ = hist_trim_incomplete_tail(h);
                if !agent_session_create(cfg) {
                    return false;
                }
                // P22：标题要在 sess_open **之后**落（sess_open 会把 l.title 重置成空）
                agent_title_adopt_imported(cfg, &dsh_title);
                if first.len > 0 {
                    _ = hist_push(h, ROLE_USER, first.ptr as &const byte, first.len);
                }
                return true;
            }
        }
    }
    // 子代理 fork：先把父会话历史读进来，但会话日志开一个新的（不写父的日志）
    if cfg.fork_from.len > 0 {
        var ppath: Buf = buf_empty();
        defer { buf_free(&ppath); }
        var pnext: i64 = 0;
        var wscopy: Buf = buf_new(cfg.workspace.len + 1);
        defer { buf_free(&wscopy); }
        _ = buf_append(&wscopy, cfg.workspace.ptr, cfg.workspace.len);
        _ = buf_append_byte(&wscopy, 0);
        const found_parent: bool = sess_find(g_home.ptr as &const byte, wscopy.ptr as &const byte, cfg.fork_from.ptr as &const byte, cfg.fork_from.len, &ppath);
        if (getenv("UYA_AGENT_DEBUG_SUBAGENT") as usize) != 0 {
            out_err("[fork] parent_session=");
            out_err_bytes(cfg.fork_from.ptr, cfg.fork_from.len);
            out_err(" found=");
            if found_parent {
                out_err("Y");
            } else {
                out_err("N");
            }
            out_err("\n");
        }
        if found_parent {
            const n: i32 = agent_hist_from_log(cfg, h, &ppath, &pnext, false);
            if (getenv("UYA_AGENT_DEBUG_SUBAGENT") as usize) != 0 {
                out_err("[fork] restored=");
                out_err_dec(n as usize);
                out_err("\n");
            }
            if n > 0 {
                _ = hist_trim_incomplete_tail(h);   // 父回合进行中 → 尾部一定不完整
            }
        }
        // 找不到父历史就退化成普通新会话
    }
    const opened: bool = agent_session_open(cfg, h, &cfg.resume_id);
    if opened && h.len > 0 {
        // 已从日志恢复（system 在里面）：本轮的任务/首条输入仍要接上去，
        // 否则恢复运行只会看到上一轮的内容（踩过：模型回答了上一轮的话）。
        if first.len > 0 {
            var pushed: bool = hist_push(h, ROLE_USER, first.ptr as &const byte, first.len);
            while !pushed {
                if !hist_drop_oldest(h) {
                    break;
                }
                pushed = hist_push(h, ROLE_USER, first.ptr as &const byte, first.len);
            }
            return pushed;
        }
        return true;
    }
    return agent_hist_init(cfg, h, first);
}

// 一次性运行（命令行给了任务）
// --list-sessions：读索引打印 —— P33 起与 `/sessions` 浮层**同一份**三列排版
// （标题 / 工作区 / session id，同 id 取最后一条；P35 起**最新的排最后一行**）
fn agent_list_sessions(cfg: &const Config) i32 {
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        out_err("error: 找不到 agent home（HOME 未设置？）\n");
        return AGENT_USAGE;
    }
    var out: Buf = buf_new(16384);
    defer { buf_free(&out); }
    // P33：`--list-sessions` 这条路径排在 `agent_run_interactive` 之前，还没走过 tty_init
    // （那时 tty_ui.cols 是全局初值 80）—— 这里只补「探一探 + 读一次窗口宽度」，
    // 不重跑 tty_init（那会把行编辑器状态与历史清掉）。不在 TTY 上就是空操作。
    if !tty_ui.is_tty {
        tty_ui.is_tty = tty_probe(0);
    }
    tty_refresh_cols(&tty_ui);
    // 滚动模式没有渲染层，宽度按终端宽度（`tty_body_width()`：收在 [40,200]）；
    // 打印前再按列硬裁一遍（窄终端上 44 列的 id 不能让行折行）
    const body: usize = tty_body_width();
    var raw: Buf = buf_new(16384);
    defer { buf_free(&raw); }
    agent_sess_list_items(cfg, body, &raw);
    if raw.len == 0 {
        out_err("(没有会话记录)\n");
        return AGENT_OK;
    }
    sess_rows_clip_into(&raw, body, &out);
    out_err_bytes(out.ptr, out.len);
    return AGENT_OK;
}

// 解析 --continue / --resume：把会话文件绝对路径写进 cfg.resume_id
fn agent_resolve_resume(cfg: &Config, want: &const byte) bool {
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        return false;
    }
    var hz: Buf = buf_new(home.len + 1);
    defer { buf_free(&hz); }
    _ = buf_append(&hz, home.ptr, home.len);
    _ = buf_append_byte(&hz, 0);
    var path: Buf = buf_new(1200);
    defer { buf_free(&path); }
    var found: bool = false;
    var cwdz: Buf = buf_new(cfg.workspace.len + 1);
    defer { buf_free(&cwdz); }
    _ = buf_append(&cwdz, cfg.workspace.ptr, cfg.workspace.len);
    _ = buf_append_byte(&cwdz, 0);
    if bufx_cstr_len(want) == 0 || bufx_eq_cstr(want, bufx_cstr_len(want), "last") {
        found = sess_find_last(hz.ptr as &const byte, cwdz.ptr as &const byte, &path);
    } else {
        found = sess_find(hz.ptr as &const byte, cwdz.ptr as &const byte, want, bufx_cstr_len(want), &path);
    }
    if !found {
        return false;
    }
    buf_free(&cfg.resume_id);
    cfg.resume_id = buf_new(path.len + 8);
    return buf_append(&cfg.resume_id, path.ptr, path.len);
}

export // --dry-run：组装请求并打印（不可打印字节转义成 \xNN，便于找 NUL 之类的脏字节）
// `--dry-run`：只组装并打印请求体（不可打印字节转义成 `\xNN`），不发请求。
// 存在的意义是排查「脏字节」—— 请求体里混进控制字符时，看转义比看十六进制快。
fn agent_dry_run(cfg: &Config) i32 {
    var h: History = hist_init();
    defer { hist_free(&h); }
    // 走**真实**的建历史路径（含 --continue/--resume 的恢复），否则 dry-run 看到的不是真请求
    if !agent_history_begin(cfg, &h, &cfg.task) {
        out_err("error: cannot build history\n");
        return AGENT_PROTO;
    }
    // 按真实历史算大小：历史默认不限条数，固定 256 KiB 会让长会话的 dry-run 直接报错
    var req: Buf = buf_new(request_bytes_needed(&h, cfg));
    defer { buf_free(&req); }
    if !buf_valid(&req) {
        out_err("error: out of memory (request buffer)\n");
        return AGENT_PROTO;
    }
    const style: u8 = api_style_now(cfg);
    if !build_model_request(cfg, &h, &req, style) {
        out_err("error: cannot build request（历史可能过大，试 /compact 或 --context-window）\n");
        return AGENT_PROTO;
    }
    out_err("[dry-run] api=");
    out_err(llm_style_name(style));
    if cfg.src_api == API_SRC_DEFAULT {
        out_err(" (negotiable: 404/405/501 → chat/completions)");
    }
    out_err(" messages=");
    out_err_dec(h.len);
    out_err(" request_bytes=");
    out_err_dec(req.len);
    out_err("\n");
    // 与诊断出口同一套转义（tty.uya::tty_diag_escape_into）：不可打印字节转义成 \xNN，
    // 便于找 NUL 之类的脏字节。dry-run 要看**整条**请求体，所以 cap 开到最大展开长度。
    var esc: Buf = buf_new(req.len * 4 + 16);
    defer { buf_free(&esc); }
    if buf_valid(&esc) {
        _ = tty_diag_escape_into(&esc, req.ptr as &const byte, req.len, req.len * 4);
        out_err_bytes(esc.ptr as &const byte, esc.len);
    }
    out_err("\n");
    return AGENT_OK;
}

// getcwd 到 Buf。注意 sys_getcwd 返回的长度**含结尾 NUL**，
// 不剥掉的话它会被当作路径的一部分（真实网关会报 invalid character '\x00'）。
fn agent_getcwd_into(out: &Buf) bool {
    var storage: [byte: 1024] = [0: 1024];
    const res: !isize = sys_getcwd(&storage[0], 1024);
    const raw_len: isize = res catch { 0 as isize; };
    if raw_len <= 0 {
        return false;
    }
    var n: usize = raw_len as usize;
    if n >= 1024 {
        n = 1023;
    }
    // 用指针走（固定数组下标要给编译器看的证明，指针下标不需要）
    const base: &byte = &storage[0];
    while n > 0 {
        const p: &const byte = @ptr_from_usize(@usize_from_ptr(base as &void) + (n - 1)) as &const byte;
        if p[0] != 0 as byte {
            break;
        }
        n = n - 1;
    }
    if n == 0 {
        return false;
    }
    buf_reset(out);
    return buf_append(out, &storage[0], n);
}

// 工作目录默认值 = getcwd
export fn agent_workspace_set_cwd(cfg: &Config) bool {
    var got: Buf = buf_new(1024);
    defer { buf_free(&got); }
    if !agent_getcwd_into(&got) {
        return false;
    }
    buf_free(&cfg.workspace);
    cfg.workspace = buf_new(got.len + 8);
    if !buf_valid(&cfg.workspace) {
        return false;
    }
    return buf_append(&cfg.workspace, got.ptr as &const byte, got.len);
}

// 启动路径里的相对值 → 启动目录下的绝对路径。
// 为什么必须固定：运行中切工作区是**真的 chdir**，相对路径会跟着跑到新工作区去 ——
// 会话日志、技能目录、workflow 脚本这些「一次定下来、之后一直用」的路径不该跟着跑。
fn agent_start_path_into(base: &const Buf, v: &const Buf, out: &Buf) void {
    buf_reset(out);
    if v.len == 0 {
        return;
    }
    if v.ptr[0] == 47 as byte {
        _ = buf_append(out, v.ptr as &const byte, v.len);
        return;
    }
    _ = buf_append(out, base.ptr as &const byte, base.len);
    _ = buf_append_byte(out, 47);
    _ = buf_append(out, v.ptr as &const byte, v.len);
}

// 启动时把「一次定下来」的目录固定住：agent home / DSH home / uya 可执行文件，
// 以及工作区本身（工作区还要顺带证明它存在且是目录）。
fn agent_workspace_canon(cfg: &Config) void {
    var here: Buf = buf_new(1024);
    defer { buf_free(&here); }
    if !agent_getcwd_into(&here) {
        return;
    }
    var tmp: Buf = buf_new(2048);
    defer { buf_free(&tmp); }
    agent_start_path_into(&here, &cfg.agent_home, &tmp);
    if tmp.len > 0 {
        buf_reset(&cfg.agent_home);
        _ = buf_append(&cfg.agent_home, tmp.ptr as &const byte, tmp.len);
    }
    agent_start_path_into(&here, &cfg.dsh_home, &tmp);
    if tmp.len > 0 {
        buf_reset(&cfg.dsh_home);
        _ = buf_append(&cfg.dsh_home, tmp.ptr as &const byte, tmp.len);
    }
    // 只处理带 '/' 的：不带 '/' 的名字按 PATH 找（execve 收名字时按 cwd 找是另一回事，
    // 那种用法本来就要求 cwd 不变，见 uya 那份 shim 的注释）
    if bufx_find_byte(cfg.uya_bin.ptr[0: cfg.uya_bin.len], 47, 0) > 0 {
        agent_start_path_into(&here, &cfg.uya_bin, &tmp);
        buf_reset(&cfg.uya_bin);
        _ = buf_append(&cfg.uya_bin, tmp.ptr as &const byte, tmp.len);
    }
    if cfg.workspace.len == 0 {
        return;
    }
    if cfg.workspace.ptr[0] == 47 as byte {
        return;   // 已经是绝对路径
    }
    var want: Buf = buf_new(cfg.workspace.len + 8);
    defer { buf_free(&want); }
    if !buf_append(&want, cfg.workspace.ptr as &const byte, cfg.workspace.len) {
        return;
    }
    if agent_workspace_switch(cfg, want.ptr as &const byte, want.len) != WS_OK {
        return;
    }
    var hz: Buf = buf_new(here.len + 1);
    defer { buf_free(&hz); }
    _ = buf_append(&hz, here.ptr as &const byte, here.len);
    _ = buf_append_byte(&hz, 0);
    _ = sys_chdir(&hz.ptr[0] as *const byte) catch {};
}

// ============================================================
// P34：工作区 —— 模型能切、人能切、会话记录它、/diff 跟着它
//
// 为什么要有这一层：文件工具、bash 默认 workdir、沙箱可写 bind、AGENTS.md/{{cwd}}、
// 终端标题、脚注、/diff 全都按 `cfg.workspace` 现取。以前它只在启动时定一次，于是
// 「当前会话在哪」这件事既没人记、也切不动（恢复别的目录的会话时 /diff 看的是启动目录）。
// 现在切换只有一条路：agent_workspace_apply → agent_workspace_switch（改状态）→
// agent_workspace_commit（TUI/技能缓存/diff 缓存/日志与索引）。
//
// 顺序上的两个硬约束（都踩过）：
//   1) `sys_chdir` 成功才算提交 —— 沙箱的 san_bind_root 对相对路径读的是 getcwd，
//      子进程的默认 cwd 也是它，所以进程 cwd 必须跟着工作区走；
//   2) 重建 `cfg.workspace` 之后必须**立刻**重指 `g_fsctx.workspace`（那是裸指针，
//      指向旧缓冲就是悬垂）。
// ============================================================

export const WS_OK: i32 = 0;
export const WS_E_MISSING: i32 = 1;    // 目标不存在 / 不是目录 / 没有权限
export const WS_E_FAIL: i32 = 2;       // 内存、getcwd 之类
export const WS_E_SAME: i32 = 3;       // 已经就是它（幂等，不记录）

// 把当前工作区切到 `path`（相对路径按**当前**工作区解析）。
// 只改状态，不记录、不通知 —— 记录与通知在 agent_workspace_commit。
export fn agent_workspace_switch(cfg: &Config, path: &const byte, n: usize) i32 {
    if n == 0 {
        return WS_E_MISSING;
    }
    var target: Buf = buf_new(n + cfg.workspace.len + 8);
    defer { buf_free(&target); }
    if !buf_valid(&target) {
        return WS_E_FAIL;
    }
    if path[0] != 47 as byte {
        if !buf_append(&target, cfg.workspace.ptr as &const byte, cfg.workspace.len) ||
            !buf_append_byte(&target, 47) {
            return WS_E_FAIL;
        }
    }
    if !buf_append(&target, path, n) {
        return WS_E_FAIL;
    }
    // 幂等：同一条路径（字面相同）不动任何状态。
    // 逐字节比 —— bufx_eq_cstr 的第三个参数要被 strlen 量长度，而 Buf 缓冲没有 NUL 结尾，
    // 量出来会偏大直接判不等（这条一开始就写错了：幂等分支永远走不到）。
    if target.len == cfg.workspace.len &&
        bufx_mem_eq(target.ptr as &const byte, cfg.workspace.ptr as &const byte, target.len) {
        return WS_E_SAME;
    }
    var tz: Buf = buf_new(target.len + 1);
    defer { buf_free(&tz); }
    _ = buf_append(&tz, target.ptr as &const byte, target.len);
    _ = buf_append_byte(&tz, 0);
    // 目标不可用（不存在 / 不是目录 / 无权限）时 chdir 失败 —— 状态一个字节都没变
    const rc0: !i32 = sys_chdir(&tz.ptr[0] as *const byte);
    const chdir_ok: i32 = rc0 catch { -1; };
    if chdir_ok != 0 {
        return WS_E_MISSING;
    }
    // 规范化（内核解析 symlink / ".."），也是沙箱 bind 与子进程 cwd 要的那份
    var canon: Buf = buf_new(1024);
    defer { buf_free(&canon); }
    if !agent_getcwd_into(&canon) {
        var back: Buf = buf_new(cfg.workspace.len + 1);
        defer { buf_free(&back); }
        _ = buf_append(&back, cfg.workspace.ptr as &const byte, cfg.workspace.len);
        _ = buf_append_byte(&back, 0);
        _ = sys_chdir(&back.ptr[0] as *const byte) catch {};
        return WS_E_FAIL;
    }
    var nb: Buf = buf_new(canon.len + 8);
    if !buf_valid(&nb) || !buf_append(&nb, canon.ptr as &const byte, canon.len) {
        var back2: Buf = buf_new(cfg.workspace.len + 1);
        defer { buf_free(&back2); }
        _ = buf_append(&back2, cfg.workspace.ptr as &const byte, cfg.workspace.len);
        _ = buf_append_byte(&back2, 0);
        _ = sys_chdir(&back2.ptr[0] as *const byte) catch {};
        return WS_E_FAIL;
    }
    // 提交：换缓冲 + 立刻重指 FsCtx（裸指针）
    var old: Buf = cfg.workspace;
    cfg.workspace = nb;
    g_fsctx.workspace = cfg.workspace.ptr as &const byte;
    g_fsctx.workspace_len = cfg.workspace.len;
    buf_free(&old);
    return WS_OK;
}

// 切换之后的副作用收口：TUI、技能缓存、/diff 缓存、会话记录（日志事件 + 索引）
// record=false：会话日志还没打开（恢复路径，记录由日志自己带着）—— 只做状态与显示
fn agent_workspace_commit(cfg: &const Config, src: &const byte, previous: &const Buf, announce: bool, record: bool) void {
    // 技能是「按工作区扫出来的」，换了工作区必须重扫（工具调用时懒加载）
    g_skills.scanned = false;
    // 脚注 cwd / 分支 / 基标题（会话已有标题时 agent_title_apply 不会动它）
    var home: Buf = env_or("HOME" as &const byte, "" as &const byte);
    defer { buf_free(&home); }
    tui_set_cwd(cfg.workspace.ptr as &const byte, cfg.workspace.len,
        home.ptr as &const byte, home.len);
    var br: Buf = buf_new(64);
    defer { buf_free(&br); }
    agent_git_branch(cfg.workspace.ptr as &const byte, cfg.workspace.len, &br);
    tui_set_branch(br.ptr as &const byte, br.len);
    agent_title_base_set(cfg);
    agent_title_apply();
    // /diff 的缓存是**旧工作区**解析出来的：关掉浮层再作废（开着不关就等于「看不见却吞键」）
    if tui_overlay_open() && tui_overlay_kind() == TUI_OVK_DIFF {
        tui_overlay_close();
        tui_add_notice("工作区变了：/diff 浮窗已关闭（再敲一次看新工作区）" as &const byte,
            bufx_cstr_len("工作区变了：/diff 浮窗已关闭（再敲一次看新工作区）" as &const byte));
    }
    gd_reset();
    // 记录：日志事件（权威）+ 索引里的「最后已知」
    if record {
        agent_workspace_log(cfg, src, previous);
    }
    if announce {
        var note: Buf = buf_new(cfg.workspace.len + 32);
        defer { buf_free(&note); }
        _ = buf_append_cstr(&note, "工作区 → ");
        _ = buf_append(&note, cfg.workspace.ptr as &const byte, cfg.workspace.len);
        tui_add_notice(note.ptr as &const byte, note.len);
    }
}

// 会话日志里的 `session/workspace`（append-only，权威）+ 索引里的当前工作区
fn agent_workspace_log(cfg: &const Config, src: &const byte, previous: &const Buf) void {
    if !g_sess.save {
        return;
    }
    var ev: Buf = buf_new(cfg.workspace.len + previous.len + 128);
    defer { buf_free(&ev); }
    if sess_begin(&g_sess, "session/workspace", &ev) {
        _ = buf_append_cstr(&ev, "{\"workspace\":");
        if jw_str_into(&ev, cfg.workspace.ptr as &const byte, cfg.workspace.len) {
            _ = buf_append_cstr(&ev, ",\"previous\":");
            if jw_str_into(&ev, previous.ptr as &const byte, previous.len) {
                _ = buf_append_cstr(&ev, ",\"source\":");
                _ = jw_str_into(&ev, src, bufx_cstr_len(src));
                _ = buf_append_cstr(&ev, "}");
                _ = sess_end(&g_sess, &ev);
            }
        }
    }
    // SessionLog.cwd 是「当前工作区」：索引（/sessions 的工作区列）按它写，
    // header 里的创建时工作区不动（那是元数据）
    buf_reset(&g_sess.cwd);
    _ = buf_append(&g_sess.cwd, cfg.workspace.ptr as &const byte, cfg.workspace.len);
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if agent_default_home(cfg, &home) {
        var hz: Buf = buf_new(home.len + 1);
        defer { buf_free(&hz); }
        _ = buf_append(&hz, home.ptr as &const byte, home.len);
        _ = buf_append_byte(&hz, 0);
        _ = sess_write_index(hz.ptr as &const byte, &g_sess);
    }
}

// 工具 / /workspace / 恢复三处共用的入口：切换 + 记录 + 通知。
// 返回 WS_OK（切了）/ WS_E_SAME（本来就在这）/ WS_E_MISSING / WS_E_FAIL。
export fn agent_workspace_apply(cfg: &Config, path: &const byte, n: usize, src: &const byte, announce: bool) i32 {
    return agent_workspace_apply_full(cfg, path, n, src, announce, true);
}

// 恢复路径专用：会话日志这会儿还没打开，记录（session/workspace 事件 + 索引）留给
// sess_open_resume 之后那次 agent_workspace_log —— 在这里写会静默丢掉（fd 还没开）。
export fn agent_workspace_apply_pre(cfg: &Config, path: &const byte, n: usize, src: &const byte, announce: bool) i32 {
    return agent_workspace_apply_full(cfg, path, n, src, announce, false);
}

// 切工作区的**唯一落点**：真 `chdir` + `getcwd` 规范化 + 重指文件工具上下文 + 清技能缓存
// + `gd_reset` + 记 `session/workspace` 与索引。
// `src` 是来源标签（cli / env / session / tool / fallback），进日志便于事后归因；
// 失败时**什么都不改**（`chdir` 本身就是校验：目标必须存在且是目录）。
fn agent_workspace_apply_full(cfg: &Config, path: &const byte, n: usize, src: &const byte, announce: bool, record: bool) i32 {
    var previous: Buf = buf_new(cfg.workspace.len + 8);
    defer { buf_free(&previous); }
    if !buf_append(&previous, cfg.workspace.ptr as &const byte, cfg.workspace.len) {
        return WS_E_FAIL;
    }
    const rc: i32 = agent_workspace_switch(cfg, path, n);
    if rc != WS_OK {
        return rc;
    }
    const sn: usize = bufx_cstr_len(src);
    if bufx_eq_cstr(src, sn, "cli" as &const byte) {
        cfg.ws_src = 3;
    } else if bufx_eq_cstr(src, sn, "env" as &const byte) {
        cfg.ws_src = 2;
    } else if bufx_eq_cstr(src, sn, "resume" as &const byte) {
        cfg.ws_src = 1;
    } else if bufx_eq_cstr(src, sn, "tool" as &const byte) || bufx_eq_cstr(src, sn, "human" as &const byte) {
        cfg.ws_src = 4;   // 运行中被切过（来源见会话日志的 session/workspace）
    }
    agent_workspace_commit(cfg, src, &previous, announce, record);
    return WS_OK;
}

// 恢复会话时决定「这个会话现在在哪」，并把运行期工作区切过去（P34）：
//   * 显式指定过（--workspace / env）→ 不动，只把记录抄给调用方；
//   * 记录的工作区存在 → 切过去（/diff、文件工具、bash、沙箱、标题、脚注一起跟过去）；
//   * 记录的工作区已经没了（worktree 合并后就删是常态）→ 留在当前工作区、打一行可见的话，
//     由调用方在会话日志打开之后补一条 source=fallback 的事件。
// 切不切都要把「记录在哪」写进 cfg.resume_ws：/workspace 与 /status 要能说出这句话。
fn agent_session_workspace_pick(cfg: &Config, meta: &const SessMeta, out_ws: &Buf, fallback: &bool) void {
    fallback[0] = false;
    buf_reset(out_ws);
    // 当前工作区以日志里**最后一条** session/workspace 为准（会话搬过家就是它），
    // 没有那条事件才退回 header 的创建时工作区
    if meta.workspace.len > 0 {
        _ = buf_append(out_ws, meta.workspace.ptr as &const byte, meta.workspace.len);
    } else if meta.cwd.len > 0 {
        _ = buf_append(out_ws, meta.cwd.ptr as &const byte, meta.cwd.len);
    }
    if out_ws.len == 0 {
        return;
    }
    buf_reset(&cfg.resume_ws);
    _ = buf_append(&cfg.resume_ws, out_ws.ptr as &const byte, out_ws.len);
    if cfg.ws_explicit {
        out_err("[session] 工作区按显式指定（会话记录的是 ");
        out_err_bytes(out_ws.ptr as &const byte, out_ws.len);
        out_err("）\n");
        return;
    }
    const rc: i32 = agent_workspace_apply_pre(cfg, out_ws.ptr as &const byte, out_ws.len, "resume" as &const byte, true);
    if rc == WS_OK {
        out_err("[session] 工作区跟随会话：");
        out_err_bytes(cfg.workspace.ptr as &const byte, cfg.workspace.len);
        out_err("\n");
        return;
    }
    if rc == WS_E_SAME {
        return;
    }
    fallback[0] = true;
    out_err("[session] 会话记录的工作区已不存在：");
    out_err_bytes(out_ws.ptr as &const byte, out_ws.len);
    out_err(" —— 留在当前工作区 ");
    out_err_bytes(cfg.workspace.ptr as &const byte, cfg.workspace.len);
    out_err("\n");
}

// 工作区来源（--print-config / /status 用；与 cfg_src_name 同一套口径）
export fn ws_src_name(src: u8) &const byte {
    if src == 1 {
        return "session" as &const byte;
    }
    if src == 2 {
        return "env" as &const byte;
    }
    if src == 3 {
        return "cli" as &const byte;
    }
    if src == 4 {
        return "runtime" as &const byte;
    }
    return "default" as &const byte;
}

// 「模型已经被告知的工作区」：step 边界对不上就补推一份新快照（与 plan 模式同一条路子）
var g_ws_snap: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var g_ws_snap_ready: bool = false;

// 每个 step 边界比对 `g_ws_snap` 与当前工作区，变了才补推运行时上下文
// （里面那句 `Current workspace` 与新工作区的 AGENTS.md 都要跟上）。
export fn agent_ws_snapshot_sync(cfg: &const Config, h: &History) void {
    if !buf_valid(&g_ws_snap) {
        g_ws_snap = buf_empty();
    }
    if !g_ws_snap_ready {
        buf_reset(&g_ws_snap);
        _ = buf_append(&g_ws_snap, cfg.workspace.ptr as &const byte, cfg.workspace.len);
        g_ws_snap_ready = true;
        return;
    }
    if g_ws_snap.len == cfg.workspace.len &&
        bufx_mem_eq(g_ws_snap.ptr as &const byte, cfg.workspace.ptr as &const byte, g_ws_snap.len) {
        return;
    }
    var rctx: Buf = buf_new(cfg.workspace.len + 1024);
    defer { buf_free(&rctx); }
    if prompt_runtime_context(cfg, g_plan.active, &rctx) && rctx.len > 0 {
        var pushed: bool = hist_push(h, ROLE_USER, rctx.ptr as &const byte, rctx.len);
        while !pushed {
            if !hist_drop_oldest(h) {
                break;
            }
            pushed = hist_push(h, ROLE_USER, rctx.ptr as &const byte, rctx.len);
        }
    }
    // 新工作区的 AGENTS.md 也补一份（渲染出来就是 `<system-reminder>`，转录里当注入消息过滤）
    var set: InstrSet = InstrSet{ items: [], n: 0 };
    instr_init(&set);
    defer { instr_free(&set); }
    var ws: Buf = buf_new(FS_PATH_MAX);
    defer { buf_free(&ws); }
    _ = buf_append(&ws, cfg.workspace.ptr as &const byte, cfg.workspace.len);
    instr_collect(ws.ptr[0: ws.len], agent_dsh_home(), &set);
    if set.n > 0 {
        var msg: Buf = buf_new((g_texts.instr_max_bytes as usize) + 8192);
        defer { buf_free(&msg); }
        if instr_render(&set, g_texts.instr_max_bytes, &msg) {
            _ = hist_push(h, ROLE_USER, msg.ptr as &const byte, msg.len);
        }
    }
    buf_reset(&g_ws_snap);
    _ = buf_append(&g_ws_snap, cfg.workspace.ptr as &const byte, cfg.workspace.len);
}

// ============================================================
// P34：workspace 工具（报告 / 切换）+ /workspace 人类命令
// ============================================================
const WS_DENIED: &const byte = "Error: the user denied this workspace switch. Do not retry it or an equivalent; the current workspace is still " as &const byte;
const WS_NO_CHANNEL: &const byte = "Error: switching the workspace needs the user's approval outside full access, but this session has no answer channel (non-interactive or subagent). Fail closed: work inside the current workspace " as &const byte;
const WS_MISSING: &const byte = "Error: cannot switch the workspace: that path does not exist, is not a directory, or is not readable. Nothing changed; the current workspace is still " as &const byte;
const WS_FAIL: &const byte = "Error: the workspace switch failed (out of memory or getcwd failed). Nothing changed; the current workspace is still " as &const byte;

// 报告当前工作区（模型无参调用 / 人敲 /workspace / /status 都用它）
fn ws_report_into(cfg: &const Config, out: &Buf) void {
    _ = buf_append_cstr(out, "workspace: ");
    _ = buf_append(out, cfg.workspace.ptr as &const byte, cfg.workspace.len);
    _ = buf_append_cstr(out, " (source: ");
    _ = buf_append_cstr(out, ws_src_name(cfg.ws_src));
    _ = buf_append_cstr(out, ")\n");
    var br: Buf = buf_new(64);
    defer { buf_free(&br); }
    agent_git_branch(cfg.workspace.ptr as &const byte, cfg.workspace.len, &br);
    if br.len > 0 {
        _ = buf_append_cstr(out, "git branch: ");
        _ = buf_append(out, br.ptr as &const byte, br.len);
        _ = buf_append_byte(out, 10);
    } else {
        // 与脚注同一套口径：只有 `.git` 是文件（worktree）时才读得到分支名
        _ = buf_append_cstr(out, "git branch: (not detected here)\n");
    }
    if g_sess.id.len > 0 {
        _ = buf_append_cstr(out, "session: ");
        _ = buf_append(out, g_sess.id.ptr as &const byte, g_sess.id.len);
        _ = buf_append_cstr(out, " (a switch is recorded as a session/workspace event)\n");
    }
}

// 失败文案 = 前缀 + 当前工作区 + 换行
fn ws_fail_into(out: &Buf, prefix: &const byte, cfg: &const Config) void {
    _ = buf_append_cstr(out, prefix);
    _ = buf_append(out, cfg.workspace.ptr as &const byte, cfg.workspace.len);
    _ = buf_append_cstr(out, ".\n");
}

// workspace 工具：无参（或空 path）= 报告；给了 path = 切换
export fn ws_tool_workspace(cfg: &Config, args: &const JsonValue, out: &Buf) void {
    var rel: Buf = buf_empty();
    defer { buf_free(&rel); }
    if !js_obj_get_str_unescaped(args, "path", 4, &rel) || rel.len == 0 {
        ws_report_into(cfg, out);
        return;
    }
    // 非全权（read-only / workspace-write）：切换会把沙箱的可写根、路径守卫一起搬走，
    // 等于扩权 —— 逐次要用户点头（与 read-only 的 bash 审批同一条通道，无渠道即 fail closed）。
    // 全权模式没有边界可越，直接切。
    if perm_confine() {
        const verdict: i32 = ask_approve_action(cfg, "workspace" as &const byte, rel.ptr as &const byte, rel.len);
        if verdict == 0 {
            ws_fail_into(out, WS_DENIED, cfg);
            return;
        }
        if verdict == 2 {
            ws_fail_into(out, WS_NO_CHANNEL, cfg);
            return;
        }
    }
    const rc: i32 = agent_workspace_apply(cfg, rel.ptr as &const byte, rel.len, "tool" as &const byte, true);
    if rc == WS_E_SAME {
        _ = buf_append_cstr(out, "workspace: ");
        _ = buf_append(out, cfg.workspace.ptr as &const byte, cfg.workspace.len);
        _ = buf_append_cstr(out, " (already the current workspace; nothing changed)\n");
        return;
    }
    if rc == WS_E_MISSING {
        ws_fail_into(out, WS_MISSING, cfg);
        return;
    }
    if rc != WS_OK {
        ws_fail_into(out, WS_FAIL, cfg);
        return;
    }
    _ = buf_append_cstr(out, "switched workspace: ");
    _ = buf_append(out, cfg.workspace.ptr as &const byte, cfg.workspace.len);
    _ = buf_append_byte(out, 10);
    ws_report_into(cfg, out);
    _ = buf_append_cstr(out, "This switch is recorded in the session log; file paths and bash now resolve against the new workspace.\n");
}

// /workspace [dir]：人看 / 人切。人自己敲的就是批准，不再弹审批。
// /model [name] 与 /effort [level]：人看 / 人切（P37）。
// 两个入口（TUI 浮层 / 滚动模式文本）都落在这里，选择本身由 agent_model_apply / agent_effort_apply 收口。
// 输出写进 `out`（TUI 当 notice 显示、滚动模式打到 fd 2），逻辑只有一份。
fn agent_repl_model_text(cfg: &Config, line: &const Buf, effort: bool, out: &Buf) void {
    // 参数：命令名之后那段（允许前导空格；名字里可以有空格）
    const clen: usize = if effort { 7 as usize } else { 6 as usize };   // "/effort" = 7, "/model" = 6
    var at: usize = clen;
    while at < line.len && line.ptr[at] == 32 as byte {
        at = at + 1;
    }
    var arg: Buf = buf_empty();
    defer { buf_free(&arg); }
    if line.len > at {
        arg = buf_new(line.len);
        _ = buf_append(&arg, &line.ptr[at], line.len - at);
    }
    agent_models_ensure(cfg);
    if arg.len > 0 {
        if effort {
            const rc: i32 = agent_effort_apply(cfg, arg.ptr as &const byte, arg.len, false, "human" as &const byte);
            if rc == 2 {
                _ = buf_append_cstr(out, "error: ");
                _ = buf_append(out, arg.ptr as &const byte, arg.len);
                _ = buf_append_cstr(out, " 不是这个模型公布的档位；可选：");
                agent_effort_list_into(cfg, out);
                return;
            }
            if rc == 1 {
                _ = buf_append_cstr(out, "已经就是这个档位（没有变化）\n");
                return;
            }
            _ = buf_append_cstr(out, "推理强度已切换\n");
            return;
        }
        const rc: i32 = agent_model_apply(cfg, cfg.provider.ptr as &const byte, cfg.provider.len,
            arg.ptr as &const byte, arg.len, "human" as &const byte, false);
        if rc == 1 {
            _ = buf_append_cstr(out, "已经就是这个模型（没有变化）\n");
            return;
        }
        if rc != 0 {
            _ = buf_append_cstr(out, "error: 模型名不能为空\n");
            return;
        }
        _ = buf_append_cstr(out, "模型已切换\n");
        agent_model_report_into(cfg, out);
        return;
    }
    // 裸命令：报当前 + 可选清单
    if effort {
        agent_effort_report_into(cfg, out);
    } else {
        agent_model_report_into(cfg, out);
    }
}

// 滚动模式下的 `/model [名字]` 与 `/effort [档位]` 文本入口（TUI 里是浮层）。
// `effort = true` 时按档位处理；**只收当前模型公布的档位**，不发明新档（§7 的模型目录口径）。
fn agent_repl_model(cfg: &Config, line: &const Buf, effort: bool) void {
    var rep: Buf = buf_new(2048);
    defer { buf_free(&rep); }
    agent_repl_model_text(cfg, line, effort, &rep);
    tty_write(&tty_ui, 2, rep.ptr as &const byte, rep.len);
}

// 当前选择的报告（/model 裸命令与 /status 共用）
fn agent_model_report_into(cfg: &const Config, out: &Buf) void {
    agent_models_ensure(cfg);
    _ = buf_append_cstr(out, "model      ");
    _ = buf_append(out, cfg.model.ptr as &const byte, cfg.model.len);
    if cfg.provider.len > 0 {
        _ = buf_append_cstr(out, "  ·  provider ");
        _ = buf_append(out, cfg.provider.ptr as &const byte, cfg.provider.len);
    }
    _ = buf_append_cstr(out, "  ·  effort ");
    if cfg.reasoning_effort.len > 0 {
        _ = buf_append(out, cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);
        if !cfg.effort_set {
            _ = buf_append_cstr(out, "（不是该模型公布的档位，原样透传）");
        }
    } else {
        _ = buf_append_cstr(out, "(未设置)");
    }
    _ = buf_append_byte(out, 10);
    var lvls: Buf = buf_new(128);
    defer { buf_free(&lvls); }
    const idx: i32 = mx_find(&g_mc, cfg.provider.ptr as &const byte, cfg.provider.len,
        cfg.model.ptr as &const byte, cfg.model.len);
    if idx >= 0 {
        const e: &const McEntry = mx_entry_at(&g_mc, idx as usize);
        mx_levels_into(e, &lvls);
    }
    if lvls.len > 0 {
        _ = buf_append_cstr(out, "efforts    ");
        _ = buf_append(out, lvls.ptr as &const byte, lvls.len);
        _ = buf_append_byte(out, 10);
    }
    // 可选模型（按提供方分组，与 TUI 浮层同一份清单）
    _ = buf_append_cstr(out, "可选模型：\n");
    agent_model_items_into(cfg, 0, out);
}

// 可选档位的清单（/effort 裸命令与非法值提示共用）
fn agent_effort_list_into(cfg: &const Config, out: &Buf) void {
    agent_models_ensure(cfg);
    const idx: i32 = mx_find(&g_mc, cfg.provider.ptr as &const byte, cfg.provider.len,
        cfg.model.ptr as &const byte, cfg.model.len);
    if idx < 0 {
        _ = buf_append_cstr(out, "（目录里没有当前模型；可用档位：off, minimal, low, medium, high, xhigh, max）\n");
        return;
    }
    const e: &const McEntry = mx_entry_at(&g_mc, idx as usize);
    if !e.reasoning {
        _ = buf_append_cstr(out, "（该模型不公布推理档位；--effort 的值会原样透传）\n");
        return;
    }
    mx_levels_into(e, out);
    _ = buf_append_byte(out, 10);
}

// 把当前推理强度与**可选档位表**追加进 out（给 `/effort` 与 `/status` 共用）。
// ⚠ 契约：**不 reset out**，只追加；「没有档位表就一个字节都不加」是刻意的 ——
// 早期实现开头 `buf_reset(out)` 把调用方已经拼好的前缀抹掉了（§16 踩坑 55）。
fn agent_effort_report_into(cfg: &const Config, out: &Buf) void {
    _ = buf_append_cstr(out, "当前推理强度：");
    if cfg.reasoning_effort.len > 0 {
        _ = buf_append(out, cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);
        if cfg.effort_set {
            _ = buf_append_cstr(out, "（模型公布）");
        } else {
            _ = buf_append_cstr(out, "（不是模型公布的档位）");
        }
    } else {
        _ = buf_append_cstr(out, "(未设置)");
    }
    _ = buf_append_byte(out, 10);
    _ = buf_append_cstr(out, "可选：");
    agent_effort_list_into(cfg, out);
}

// 滚动模式下的 `/workspace [目录]`：人自己敲的就是批准，**不再弹审批**（§7.5 的口径）。
// 实际切换走 `agent_workspace_apply_full`。
fn agent_repl_workspace(cfg: &Config, line: &const Buf) void {
    // 解析：`/workspace` 或 `/workspace <dir>`（dir 里可以有空格，全是字面量路径）
    var arg: Buf = buf_empty();
    defer { buf_free(&arg); }
    var at: usize = 11;              // "/workspace " 之后
    while at < line.len && line.ptr[at] == 32 as byte {
        at = at + 1;                 // 多敲几个空格也认
    }
    if line.len > at {
        arg = buf_new(line.len);
        _ = buf_append(&arg, &line.ptr[at], line.len - at);
    }
    if arg.len == 0 {
        if g_sess.id.len > 0 {
            var hdr: Buf = buf_new(64 + g_sess.id.len);
            defer { buf_free(&hdr); }
            _ = buf_append_cstr(&hdr, "[session] ");
            _ = buf_append(&hdr, g_sess.id.ptr as &const byte, g_sess.id.len);
            _ = buf_append_cstr(&hdr, "（工作区以日志里最后一条 session/workspace 为准）\n");
            tty_puts(&tty_ui, 2, hdr.ptr as &const byte);
        }
        var rep: Buf = buf_new(cfg.workspace.len + 512);
        defer { buf_free(&rep); }
        ws_report_into(cfg, &rep);
        tty_write(&tty_ui, 2, rep.ptr as &const byte, rep.len);
        return;
    }
    const rc: i32 = agent_workspace_apply(cfg, arg.ptr as &const byte, arg.len, "human" as &const byte, true);
    if rc == WS_E_SAME {
        tty_puts(&tty_ui, 2, "已经在这个工作区里（没有变化）\n");
        return;
    }
    if rc == WS_E_MISSING {
        tty_puts(&tty_ui, 2, "error: 切不过去：这个路径不存在 / 不是目录（工作区没变）\n");
        return;
    }
    if rc != WS_OK {
        tty_puts(&tty_ui, 2, "error: 切换失败（内存或 getcwd 出错，工作区没变）\n");
        return;
    }
    tty_puts(&tty_ui, 2, "工作区已切换：");
    tty_write(&tty_ui, 2, cfg.workspace.ptr as &const byte, cfg.workspace.len);
    tty_puts(&tty_ui, 2, "\n");
}

// ============================================================
// P37：模型选择 + 推理强度（对齐 DSH 的 /model 与 composer 的 Model/Effort 两级菜单）
//
// 一次选择在 DSH 里是**一个三元组**：provider + model + reasoning effort（Host 的
// ModelSelection）。这里照抄这个形状：
//   * 目录（modelx.uya）回答「有哪些可选、这个模型公布了哪些档位」；
//   * agent_model_apply 是**唯一**的切换入口：切模型时把该模型公布的 contextWindow /
//     maxTokens / input / compat 一起搬过来，再校验推理强度；改了哪些**可见地**说出来；
//   * 选择落一条会话日志 `session/model`（append-only、最后一条为准），--resume 跟着它走。
//
// 三条口径（都是「绝不猜」）：
//   1) 模型不在目录里（目录空、或用户敲了目录外的名字）⇒ **只改名字**，provider 与各项能力
//      保持不动，并打一行 warning —— 静默把 contextWindow 清成 -1 会让压缩直接失效；
//   2) 推理强度不在新模型公布的档位里 ⇒ 回落到该模型的默认档（第一个公布的档位），并**说清楚**
//      改成了什么（DSH 的 resolveReasoningLevel 宁可报错不 clamp；我们这里选了可用性优先）；
//   3) 模型没公布档位 ⇒ 不移除用户**显式**给的 effort（effort_set=false 时原样透传，和
//      --reasoning-effort 的老口径一致），也不在界面上装出有档位可选。
// ============================================================

// 进程级模型目录（settings.yaml 的 providers/models 摊平结果）。
// 懒加载：第一次用到时才读盘，之后复用（/model 浮层、/effort 校验、--print-config 共用一份）。
var g_mc: McTable = McTable{ items: [], n: 0, loaded: false };
var g_mc_ready: bool = false;

// 载入（或复用）目录。cfg 为空时只保证「准备过」（自测会先重置）。
fn agent_models_ensure(cfg: &const Config) void {
    if g_mc_ready {
        return;
    }
    mx_init(&g_mc);
    if !cfg.no_dsh_config {
        var home: Buf = buf_new(1024);
        defer { buf_free(&home); }
        const dh: &[byte] = agent_dsh_home();
        if dh.len > 0 {
            _ = buf_append(&home, dh.ptr, dh.len);
            // mx_load 里的路径参数是 C 字符串（要接 "/settings.yaml"）：拿 Buf 当 C 串用
            // 就得先补尾 NUL，否则拼出来的路径带一截旧字节（实测目录只剩 seeded 的那一条）。
            _ = buf_append_byte(&home, 0);
            _ = mx_load(home.ptr as &const byte, &g_mc);
        }
    }
    // 目录空（--no-dsh-config / 读不到设置 / 设置里没有模型条目）：把当前 model 当唯一条目，
    // 界面仍能说出「现在用的是它」，只是没有别的可选。
    if g_mc.n == 0 {
        mx_seed_sole(&g_mc, cfg.provider.ptr as &const byte, cfg.provider.len,
            cfg.model.ptr as &const byte, cfg.model.len);
    }
    g_mc_ready = true;
}

// 自测用：丢掉缓存的目录（下一轮重新读 fixture 的 settings.yaml）
export fn agent_models_reset() void {
    if g_mc_ready {
        mx_free(&g_mc);
    }
    g_mc_ready = false;
}

// 模型目录里有多少条（TUI 的 `/model` 浮层与 `--print-config` 用）。
export fn agent_models_count() usize {
    return mx_count(&g_mc);
}

// 把目录条目的能力搬进 cfg（与 agent_apply_dsh 同一套字段、同一套来源码）
fn agent_model_adopt_caps(cfg: &Config, e: &const McEntry) void {
    if e.context_window > 0 {
        cfg.context_window = e.context_window;
        cfg.src_context = 1;
    }
    if e.max_tokens > 0 && cfg.max_tokens == 0 {
        cfg.max_tokens = e.max_tokens;
    }
    if e.input_image {
        cfg.input_image = true;
    }
    if e.compat_dev_role == 0 {
        cfg.api_dev_role = false;
    } else if e.compat_dev_role == 1 {
        cfg.api_dev_role = true;
    }
    if e.compat_store == 0 {
        cfg.api_store = false;
    } else if e.compat_store == 1 {
        cfg.api_store = true;
    }
    if e.compat_reasoning == 0 {
        cfg.api_reasoning = false;
    } else if e.compat_reasoning == 1 {
        cfg.api_reasoning = true;
    }
}

// 目录就绪后把 effort_set 判准：值是该模型公布的档位才算「已校验」，否则是原样透传。
// （DSH / env / CLI 都是先落值、后载目录，所以这一次重算必要。）
fn agent_effort_recheck(cfg: &Config) void {
    if cfg.reasoning_effort.len == 0 {
        cfg.effort_set = false;
        return;
    }
    const idx: i32 = mx_find(&g_mc, cfg.provider.ptr as &const byte, cfg.provider.len,
        cfg.model.ptr as &const byte, cfg.model.len);
    if idx < 0 {
        cfg.effort_set = false;
        return;   // 目录里没有这个模型：不猜
    }
    const e: &const McEntry = mx_entry_at(&g_mc, idx as usize);
    const li: i32 = mx_level_index(cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);
    if li >= 0 && e.reasoning && mx_has_level(e, li as usize) {
        cfg.effort_set = true;
    } else {
        cfg.effort_set = false;
    }
}

// 一次选择的收口。返回：0 = 换了模型，1 = 本来就是它（幂等），2 = 参数不对。
//   model 必给；provider 可空（空 = 沿用当前 / 由目录反查）。
export fn agent_model_apply(cfg: &Config, provider: &const byte, pn: usize, model: &const byte, mn: usize, src: &const byte, announce: bool) i32 {
    if mn == 0 {
        return 2;
    }
    agent_models_ensure(cfg);
    // 先按「指定的 provider + model」查；查不到再**跨提供方**按 model 查（DSH 的 model id 一般
    // 全局唯一，`--model` / `/model <名字>` 只给了名字一条 —— 写死在当前 provider 下会漏掉别的路线）。
    var idx: i32 = mx_find(&g_mc, provider, pn, model, mn);
    if idx < 0 && pn > 0 {
        idx = mx_find(&g_mc, "" as &const byte, 0, model, mn);
    }
    // 幂等：同一个 (provider, model) 就什么都不动（连日志都不写）
    if idx >= 0 {
        const e: &const McEntry = mx_entry_at(&g_mc, idx as usize);
        const same_model: bool = cfg.model.len == e.model.len &&
            bufx_mem_eq(cfg.model.ptr as &const byte, e.model.ptr as &const byte, cfg.model.len);
        const same_prov: bool = cfg.provider.len == e.provider.len &&
            bufx_mem_eq(cfg.provider.ptr as &const byte, e.provider.ptr as &const byte, cfg.provider.len);
        if same_model && same_prov {
            return 1;
        }
    }
    // 旧的 (provider, model, effort) 用来落日志与说清变化
    var old_prov: Buf = buf_new(cfg.provider.len + 64);
    defer { buf_free(&old_prov); }
    _ = buf_append(&old_prov, cfg.provider.ptr as &const byte, cfg.provider.len);
    var old_model: Buf = buf_new(cfg.model.len + 64);
    defer { buf_free(&old_model); }
    _ = buf_append(&old_model, cfg.model.ptr as &const byte, cfg.model.len);
    var old_eff: Buf = buf_new(cfg.reasoning_effort.len + 64);
    defer { buf_free(&old_eff); }
    _ = buf_append(&old_eff, cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);

    var note: Buf = buf_new(1024);
    defer { buf_free(&note); }
    _ = buf_append_cstr(&note, "model → ");
    _ = buf_append(&note, model, mn);

    if idx < 0 {
        // 目录里没有：只改名字（provider 与能力保持不动），并说清楚为什么
        buf_free(&cfg.model);
        cfg.model = buf_new(mn + 8);
        _ = buf_append(&cfg.model, model, mn);
        cfg.src_model = 4;   // 4 = 「目录外的手输值」（cfg_src_name 会印 manual）
        _ = buf_append_cstr(&note, "（目录里没有这个模型：只换了名字，通道/上下文窗口沿用原值）");
    } else {
        const e: &const McEntry = mx_entry_at(&g_mc, idx as usize);
        buf_free(&cfg.model);
        cfg.model = buf_new(e.model.len + 8);
        _ = buf_append(&cfg.model, e.model.ptr as &const byte, e.model.len);
        buf_free(&cfg.provider);
        cfg.provider = buf_new(e.provider.len + 8);
        _ = buf_append(&cfg.provider, e.provider.ptr as &const byte, e.provider.len);
        cfg.provider_set = true;
        cfg.src_model = 1;
        if bufx_eq_cstr(src, bufx_cstr_len(src), "cli" as &const byte) {
            cfg.src_model = 3;
            cfg.src_provider = 3;
        } else if bufx_eq_cstr(src, bufx_cstr_len(src), "env" as &const byte) {
            cfg.src_model = 2;
            cfg.src_provider = 2;
        } else if bufx_eq_cstr(src, bufx_cstr_len(src), "session" as &const byte) {
            cfg.src_model = 1;
            cfg.src_provider = 1;
        } else {
            cfg.src_model = 1;
            cfg.src_provider = 1;
        }
        agent_model_adopt_caps(cfg, e);
        _ = buf_append_cstr(&note, "（");
        _ = buf_append(&note, e.provider.ptr as &const byte, e.provider.len);
        _ = buf_append_cstr(&note, "）");
        // 推理强度：公布了档位才校验；没公布就不动（显式值原样透传，见上面的口径 3）
        if e.reasoning {
            var lvls: Buf = buf_new(128);
            defer { buf_free(&lvls); }
            mx_levels_into(e, &lvls);
            var cur: i32 = -1;
            if cfg.reasoning_effort.len > 0 {
                cur = mx_level_index(cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);
            }
            if cur < 0 || !mx_has_level(e, cur as usize) {
                const dfl: i32 = mx_default_level(e);
                if dfl >= 0 {
                    buf_free(&cfg.reasoning_effort);
                    cfg.reasoning_effort = buf_from_cstr(mx_level_name(dfl as usize));
                    cfg.effort_set = true;
                    cfg.src_effort = 1;
                    _ = buf_append_cstr(&note, "，强度 → ");
                    _ = buf_append_cstr(&note, mx_level_name(dfl as usize));
                    if old_eff.len > 0 {
                        _ = buf_append_cstr(&note, "（原 ");
                        _ = buf_append(&note, old_eff.ptr as &const byte, old_eff.len);
                        _ = buf_append_cstr(&note, " 不在它公布的档位里）");
                    }
                }
            } else {
                cfg.effort_set = true;
            }
        } else if cfg.reasoning_effort.len > 0 {
            // 没公布档位：不动值，但 explicitly 说明「它不公布档位」
            _ = buf_append_cstr(&note, "（该模型不公布推理档位）");
        }
    }
    // provider 单独给了但模型在目录里没命中时，仍然把 provider 记下来（人工声明优先）。
    // ⚠ 顺序：`provider` 很可能就是 `cfg.provider.ptr` 自己（调用方习惯传 cfg.provider 的缓冲）；
    // 先 buf_free 再读它 = 读已释放的内存（实测读到乱字节）。所以先拷贝再换。
    if idx < 0 && pn > 0 {
        var keep: Buf = buf_new(pn + 8);
        _ = buf_append(&keep, provider, pn);
        buf_free(&cfg.provider);
        cfg.provider = keep;
        cfg.provider_set = true;
        cfg.src_provider = 3;
    }
    // 换了模型 ⇒ 旧档位在新模型下的「公布/未公布」可能不同，收尾重算一次
    // （否则切到一个不公布档位的模型后，/effort 还报「模型公布」）
    agent_effort_recheck(cfg);
    agent_model_log(cfg, src);
    if announce {
        tui_add_notice(note.ptr as &const byte, note.len);
    }
    agent_model_refresh_ui(cfg);
    _ = old_prov;
    _ = old_model;
    return 0;
}

// 只换推理强度（模型不动）。返回 0 = 换了，1 = 本来就是它，2 = 参数不对（不在公布的档位里）。
// P55：src 是「这次改动从哪来」的来源标签（"human" = 人运行中敲的 /model、/effort、TUI 浮层；
//   "cli" = 命令行 / --effort；"exec-effort" = 执行期自动降档）。它写进日志的 session/model，
//   另有一条语义：**人运行中手动挑过档位之后，执行期自动降档让位**（人优先）。
export fn agent_effort_apply(cfg: &Config, value: &const byte, vn: usize, announce: bool, src: &const byte) i32 {
    if vn == 0 {
        return 2;
    }
    const li: i32 = mx_level_index(value, vn);
    if li < 0 {
        return 2;
    }
    agent_models_ensure(cfg);
    const idx: i32 = mx_find(&g_mc, cfg.provider.ptr as &const byte, cfg.provider.len,
        cfg.model.ptr as &const byte, cfg.model.len);
    var allowed: bool = false;
    var hint: Buf = buf_new(160);
    defer { buf_free(&hint); }
    if idx >= 0 {
        const e: &const McEntry = mx_entry_at(&g_mc, idx as usize);
        if e.reasoning {
            const lu: usize = li as usize;
            allowed = mx_has_level(e, lu);
        } else {
            // 不公布档位：与 --reasoning-effort 的老口径一致，原样透传（不 clamp、不拒绝）
            allowed = true;
        }
        if !allowed {
            _ = buf_append_cstr(&hint, "该模型只公布：");
            _ = buf_append_cstr(&hint, "（");
            mx_levels_into(e, &hint);
            _ = buf_append_cstr(&hint, "）");
        }
    } else {
        // 目录里没有这个模型：不猜，原样透传
        allowed = true;
    }
    if !allowed {
        if announce {
            tui_add_notice(hint.ptr as &const byte, hint.len);
        }
        return 2;
    }
    if cfg.reasoning_effort.len == vn &&
        bufx_mem_eq(cfg.reasoning_effort.ptr as &const byte, value, vn) {
        return 1;
    }
    buf_free(&cfg.reasoning_effort);
    cfg.reasoning_effort = buf_new(vn + 8);
    _ = buf_append(&cfg.reasoning_effort, value, vn);
    // 值来自模型公布的档位 ⇒ effort_set；否则（目录外的模型 / 不公布档位的模型）只是「显式给了」。
    // 统一走 agent_effort_recheck 判定，别在這裡另写一套（两处口径分叉过）。
    agent_effort_recheck(cfg);
    if cfg.effort_set {
        cfg.src_effort = 4;   // 运行中改的（cfg_src_name 印 runtime）
    } else {
        cfg.src_effort = 4;
    }
    agent_model_log(cfg, src);
    // P55：来源是人（运行中手动改）⇒ 关掉本会话的执行期自动降档，别跟人抢
    if sv_eq_cstr(src, "human" as &const byte) {
        g_exec.off = true;
    }
    if announce {
        var note: Buf = buf_new(64);
        defer { buf_free(&note); }
        _ = buf_append_cstr(&note, "推理强度 → ");
        _ = buf_append(&note, value, vn);
        tui_add_notice(note.ptr as &const byte, note.len);
    }
    agent_model_refresh_ui(cfg);
    return 0;
}

// 恢复会话时决定「这个会话用哪个模型/档位」，并切过去（P37，与工作区同一条路子）：
//   * CLI 显式给过 --model / --effort ⇒ 不动（显式优先）；
//   * 日志里最后一条 session/model 有效 ⇒ 切过去（provider + model + effort 一起）；
//   * 会话没有记录 / 模型已不在目录里 ⇒ 保持当前选择，不报错（只在目录里补一条说明）。
fn agent_session_model_pick(cfg: &Config, meta: &const SessMeta) void {
    if meta.model.len == 0 {
        return;   // 没有记录：沿用当前选择
    }
    if cfg.src_model == 3 || cfg.src_effort == 3 {
        out_err("[session] 模型按显式指定（会话记录的是 ");
        _ = meta;
        out_err_bytes(meta.model.ptr as &const byte, meta.model.len);
        out_err("）\n");
        return;
    }
    agent_models_ensure(cfg);
    const idx: i32 = mx_find(&g_mc, meta.provider.ptr as &const byte, meta.provider.len,
        meta.model.ptr as &const byte, meta.model.len);
    if idx < 0 {
        out_err("[session] 会话记录的模型不在当前目录里，保持当前选择：");
        out_err_bytes(meta.model.ptr as &const byte, meta.model.len);
        out_err("\n");
        return;
    }
    const e: &const McEntry = mx_entry_at(&g_mc, idx as usize);
    buf_free(&cfg.model);
    cfg.model = buf_new(e.model.len + 8);
    _ = buf_append(&cfg.model, e.model.ptr as &const byte, e.model.len);
    buf_free(&cfg.provider);
    cfg.provider = buf_new(e.provider.len + 8);
    _ = buf_append(&cfg.provider, e.provider.ptr as &const byte, e.provider.len);
    cfg.provider_set = true;
    cfg.src_model = 1;
    cfg.src_provider = 1;
    agent_model_adopt_caps(cfg, e);
    if meta.effort.len > 0 {
        buf_free(&cfg.reasoning_effort);
        cfg.reasoning_effort = buf_new(meta.effort.len + 8);
        _ = buf_append(&cfg.reasoning_effort, meta.effort.ptr as &const byte, meta.effort.len);
        cfg.effort_set = true;
        cfg.src_effort = 1;
    }
    out_err("[session] 模型跟随会话：");
    out_err_bytes(cfg.model.ptr as &const byte, cfg.model.len);
    if cfg.reasoning_effort.len > 0 {
        out_err("（effort ");
        out_err_bytes(cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);
        out_err("）");
    }
    out_err("\n");
}

// 会话日志的 `session/model`（append-only，最后一条为准；--resume 跟着它走）
fn agent_model_log(cfg: &const Config, src: &const byte) void {    if !g_sess.save {
        return;
    }
    var ev: Buf = buf_new(512);
    defer { buf_free(&ev); }
    if sess_begin(&g_sess, "session/model", &ev) {
        _ = buf_append_cstr(&ev, "{\"provider\":");
        if jw_str_into(&ev, cfg.provider.ptr as &const byte, cfg.provider.len) {
            _ = buf_append_cstr(&ev, ",\"model\":");
            if jw_str_into(&ev, cfg.model.ptr as &const byte, cfg.model.len) {
                _ = buf_append_cstr(&ev, ",\"reasoningEffort\":");
                if jw_str_into(&ev, cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len) {
                    _ = buf_append_cstr(&ev, ",\"source\":");
                    _ = jw_str_into(&ev, src, bufx_cstr_len(src));
                    _ = buf_append_cstr(&ev, "}");
                    _ = sess_end(&g_sess, &ev);
                }
            }
        }
    }
    // 索引里的 model 字段也跟着走（/sessions 之外的观察口）
    buf_reset(&g_sess.model);
    _ = buf_append(&g_sess.model, cfg.model.ptr as &const byte, cfg.model.len);
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if agent_default_home(cfg, &home) {
        var hz: Buf = buf_new(home.len + 1);
        defer { buf_free(&hz); }
        _ = buf_append(&hz, home.ptr as &const byte, home.len);
        _ = buf_append_byte(&hz, 0);
        _ = sess_write_index(hz.ptr as &const byte, &g_sess);
    }
}

// 换了模型/强度之后要跟着变的东西：TUI 信息行（模型 + 提供方）与脚注强度段。
// 每次都要重算，所以集中在这里（与 agent_workspace_commit 同一套分工）。
fn agent_model_refresh_ui(cfg: &const Config) void {
    var prov: Buf = buf_new(64);
    defer { buf_free(&prov); }
    agent_provider_label(cfg, &prov);
    tui_set_model(cfg.model.ptr as &const byte, cfg.model.len, prov.ptr as &const byte, prov.len);
    tui_set_effort(cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);
    tui_mark_dirty();
}

// 信息行里显示的「提供方」：优先用 settings.yaml 里的 provider 键（/model 选出来的那个），
// 没有就退回按 base_url 猜的短名（老行为）。
fn agent_provider_label(cfg: &const Config, out: &Buf) void {
    if cfg.provider.len > 0 {
        buf_reset(out);
        _ = buf_append(out, cfg.provider.ptr as &const byte, cfg.provider.len);
        return;
    }
    agent_provider_short(cfg, out);
}

// `/model` 的选择清单（每行一个模型，按提供方分组；当前那个打 ✓）。
// 分组标题不参与选中：条目文本里 `✓` 只出现在模型行上，反解因此只看行首两字节。
fn agent_model_items_into(cfg: &const Config, body_cols: usize, out: &Buf) void {
    agent_models_ensure(cfg);
    const n: usize = mx_count(&g_mc);
    if n == 0 {
        return;
    }
    var last_prov: Buf = buf_empty();
    defer { buf_free(&last_prov); }
    var i: usize = 0;
    while i < n {
        const e: &const McEntry = mx_entry_at(&g_mc, i);
        // 提供方变了就插一行分组标题（# 起头；`#` 不是模型名里会出现的字符）
        if e.provider.len > 0 && (last_prov.len != e.provider.len ||
                !bufx_mem_eq(last_prov.ptr as &const byte, e.provider.ptr as &const byte, e.provider.len)) {
            buf_reset(&last_prov);
            _ = buf_append(&last_prov, e.provider.ptr as &const byte, e.provider.len);
            _ = buf_append_cstr(out, "# ");
            _ = buf_append(out, e.provider.ptr as &const byte, e.provider.len);
            _ = buf_append_byte(out, 10);
        }
        const cur: bool = cfg.model.len == e.model.len &&
            bufx_mem_eq(cfg.model.ptr as &const byte, e.model.ptr as &const byte, cfg.model.len);
        if cur {
            _ = buf_append_cstr(out, "✓ ");
        } else {
            _ = buf_append_cstr(out, "  ");
        }
        _ = buf_append(out, e.model.ptr as &const byte, e.model.len);
        var lv: Buf = buf_new(64);
        defer { buf_free(&lv); }
        mx_levels_into(e, &lv);
        _ = buf_append_cstr(out, "  ");
        if lv.len > 0 {
            _ = buf_append_cstr(out, "effort: ");
            _ = buf_append(out, lv.ptr as &const byte, lv.len);
        } else if e.declared {
            _ = buf_append_cstr(out, "（不公布推理档位）");
        } else {
            _ = buf_append_cstr(out, "（未声明推理档位）");
        }
        _ = buf_append_byte(out, 10);
        _ = body_cols;
        i = i + 1;
    }
}

// `/effort` 的选择清单（只列**当前模型公布**的档位；一行一个）
fn agent_effort_items_into(cfg: &const Config, out: &Buf) void {
    agent_models_ensure(cfg);
    const idx: i32 = mx_find(&g_mc, cfg.provider.ptr as &const byte, cfg.provider.len,
        cfg.model.ptr as &const byte, cfg.model.len);
    if idx < 0 {
        return;
    }
    const e: &const McEntry = mx_entry_at(&g_mc, idx as usize);
    if !e.reasoning {
        return;   // 没档位可列：浮层不该开（调用方据此给一行说明）
    }
    var i: usize = 0;
    while i < MX_LEVELS {
        if mx_has_level(e, i) {
            const cur: bool = cfg.reasoning_effort.len == bufx_cstr_len(mx_level_name(i)) &&
                bufx_mem_eq(cfg.reasoning_effort.ptr as &const byte, mx_level_name(i), cfg.reasoning_effort.len);
            if cur {
                _ = buf_append_cstr(out, "✓ ");
            } else {
                _ = buf_append_cstr(out, "  ");
            }
            _ = buf_append_cstr(out, mx_level_name(i));
            _ = buf_append_byte(out, 10);
        }
        i = i + 1;
    }
}

// 浮层选中项 → 模型名（行首两字节是 "✓ " 或 "  "）；分组行（`# `）与认不出的都交回空串。
fn agent_model_item_parse(sel: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if sel.len < 3 {
        return false;
    }
    const p: &const byte = sel.ptr as &const byte;
    if p[0] == 35 as byte {   // '#'
        return false;
    }
    if !(p[0] == 32 as byte || p[0] == 0xE2 as byte) {
        return false;
    }
    var s: usize = 2;
    // "✓" 是 3 字节（E2 9C 93）+ 1 空格 = 4；"  " 是 2 字节
    if p[0] == 0xE2 as byte {
        s = 4;
    }
    while s < sel.len && p[s] != 32 as byte && p[s] != 9 as byte {
        _ = buf_append_byte(out, p[s]);
        s = s + 1;
    }
    return out.len > 0;
}

// 浮层选中项 → 档位名（行首两字节同上）
fn agent_effort_item_parse(sel: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if sel.len < 3 {
        return false;
    }
    const p: &const byte = sel.ptr as &const byte;
    var s: usize = 2;
    if p[0] == 0xE2 as byte {
        s = 4;
    }
    while s < sel.len && p[s] != 32 as byte && p[s] != 9 as byte {
        _ = buf_append_byte(out, p[s]);
        s = s + 1;
    }
    return out.len > 0;
}

// 打开 `/model` 选择浮层（shift+tab 那种菜单型：游标默认落在当前模型那一行）
fn agent_model_overlay_open(cfg: &const Config) void {
    agent_models_ensure(cfg);
    var items: Buf = buf_new(4096);
    defer { buf_free(&items); }
    agent_model_items_into(cfg, 0, &items);
    if items.len == 0 {
        tui_add_notice("（目录里没有可选模型；设置 DSH 的 llm-pi-ai.providers 后可用）" as &const byte,
            bufx_cstr_len("（目录里没有可选模型；设置 DSH 的 llm-pi-ai.providers 后可用）" as &const byte));
        return;
    }
    // 游标停在当前模型那一行（逐行找一个以 ✓ 起头的）
    var sel: usize = 0;
    var line_no: usize = 0;
    var p: usize = 0;
    while p < items.len {
        var e: usize = p;
        while e < items.len && items.ptr[e] != 10 as byte {
            e = e + 1;
        }
        if e > p + 1 && items.ptr[p] == 0xE2 as byte {
            sel = line_no;
            break;
        }
        line_no = line_no + 1;
        p = e + 1;
    }
    const title: &const byte = "模型（enter 切换 · esc 取消）" as &const byte;
    tui_overlay_menu(TUI_OVK_MODEL, title, bufx_cstr_len(title),
        items.ptr as &const byte, items.len, sel);
}

// 打开 `/effort` 选择浮层；模型没公布档位时给一行说明、不开浮层（不装出有档位可选）
fn agent_effort_overlay_open(cfg: &const Config) void {
    agent_models_ensure(cfg);
    var items: Buf = buf_new(512);
    defer { buf_free(&items); }
    agent_effort_items_into(cfg, &items);
    if items.len == 0 {
        const msg: &const byte = "（该模型没有公布推理档位：没有可选的强度）" as &const byte;
        tui_add_notice(msg, bufx_cstr_len(msg));
        return;
    }
    var sel: usize = 0;
    var line_no: usize = 0;
    var p: usize = 0;
    while p < items.len {
        var e: usize = p;
        while e < items.len && items.ptr[e] != 10 as byte {
            e = e + 1;
        }
        if e > p + 1 && items.ptr[p] == 0xE2 as byte {
            sel = line_no;
            break;
        }
        line_no = line_no + 1;
        p = e + 1;
    }
    const title: &const byte = "推理强度（enter 切换 · esc 取消）" as &const byte;
    tui_overlay_menu(TUI_OVK_EFFORT, title, bufx_cstr_len(title),
        items.ptr as &const byte, items.len, sel);
}

// 消费模型/强度浮层的结果（TUI 主循环与自测共用；返回 true = 处理了一个浮层结果）
export fn agent_tui_model_handle(cfg: &Config, h: &const History, sel: &const Buf) bool {
    const kind: u8 = tui_overlay_kind();
    if kind == TUI_OVK_MODEL {
        var m: Buf = buf_new(256);
        defer { buf_free(&m); }
        if agent_model_item_parse(sel, &m) {
            // 选中项只给了模型名；提供方由目录反查（同名模型跨提供方时用当前 provider 优先）
            _ = agent_model_apply(cfg, cfg.provider.ptr as &const byte, cfg.provider.len,
                m.ptr as &const byte, m.len, "human" as &const byte, true);
        }
        _ = h;
        return true;
    }
    if kind == TUI_OVK_EFFORT {
        var v: Buf = buf_new(64);
        defer { buf_free(&v); }
        if agent_effort_item_parse(sel, &v) {
            _ = agent_effort_apply(cfg, v.ptr as &const byte, v.len, true, "human" as &const byte);
        }
        return true;
    }
    return false;
}

// ============================================================
// P37：Git worktree —— 独立工作区执行 → 合并 → 删除
//
// 会话开始就把工作区搬进 worktree（对齐 DSH git-worktree preset 的 session-start 钩子），
// 于是文件工具 / bash 默认 workdir / 沙箱 / {{cwd}} / AGENTS.md / /diff **全都自动跟过去**
// —— 这条路是 P34 铺好的（agent_workspace_switch 是唯一收口）。
// 干完由 `worktree` 工具的 finish 提交/合并/删除（见 worktreex.uya）。
// ============================================================

// 会话开始时的 provisioning（agent_history_begin 里、system prompt 求值之前调）
fn agent_worktree_begin(cfg: &Config) void {
    if !wt_on() {
        return;
    }
    // 新会话才建：--resume 的会话可能已经有 worktree（也可能已被 finish 删掉），
    // 那时按「记录的工作区」落位就好，不要凭空另建一个（会跟 finish 的语义打架）。
    if cfg.resume_id.len > 0 || cfg.fork_from.len > 0 || cfg.force_session_id.len > 0 {
        return;
    }
    var sid: Buf = buf_empty();
    defer { buf_free(&sid); }
    if g_sess.id.len > 0 {
        _ = buf_append(&sid, g_sess.id.ptr as &const byte, g_sess.id.len);
    } else {
        _ = buf_append_cstr(&sid, "session");
    }
    const rc: i32 = wt_provision(cfg, cfg.workspace.ptr as &const byte, cfg.workspace.len,
        sid.ptr as &const byte, sid.len);
    if wt_ready() {
        // 把（当前）工作区切到 worktree —— 注意 session id 要等会话真的开了才有，
        // 而 system prompt 又必须在那之前求值，所以这里先用「仓库根 + slug」定路径。
        var ws2: Buf = buf_new(cfg.workspace.len + 1);
        defer { buf_free(&ws2); }
        _ = buf_append(&ws2, cfg.workspace.ptr as &const byte, cfg.workspace.len);
        _ = buf_append_byte(&ws2, 0);
        const st: &const WtState = wt_state();
        _ = ws2;
        const wsrc: i32 = agent_workspace_apply(cfg, st.worktree_path.ptr as &const byte,
            st.worktree_path.len, "worktree" as &const byte, false);
        if wsrc != WS_OK && wsrc != WS_E_SAME {
            // 切不过去（目录没建成之类）：状态回滚成 skipped，照常在原工作区干活
            wt_reset();
            wt_set_on(false);
            out_err("warning: worktree 建好了但切不过去，已退回原工作区\n");
        }
    }
    _ = rc;
}

// worktree 工具（对齐 DSH preset 的 worktree 工具动作词汇）
export fn wt_tool_worktree(cfg: &const Config, args: &const JsonValue, out: &Buf) void {
    var act: Buf = buf_empty();
    defer { buf_free(&act); }
    if !js_obj_get_str_unescaped(args, "action", 6, &act) || act.len == 0 {
        _ = buf_append_cstr(out, "error: action must be one of start|status|finish|discard|list|reclaim");
        return;
    }
    if bufx_eq_cstr(act.ptr as &const byte, act.len, "list" as &const byte) {
        wt_list_into(out);
        return;
    }
    if bufx_eq_cstr(act.ptr as &const byte, act.len, "reclaim" as &const byte) {
        // P53：把这个仓库里**确定的垃圾** worktree 清掉（会话攒下来的残留）。
        // 判据见 worktreex 那一节：干净 + 零提交 + 没人在用，且只碰 dsh/* 的。
        // 收尾动作 —— 子代理共享父的 worktree，不许它来清。
        if cfg.is_subagent || cfg.deleg_depth > 0 {
            _ = buf_append_cstr(out, "error: a subagent shares its parent's worktree and must not reclaim worktrees.\n");
            return;
        }
        var repo: Buf = buf_empty();
        defer { buf_free(&repo); }
        const st: &const WtState = wt_state();
        if st.repo_root.len > 0 {
            _ = buf_append(&repo, st.repo_root.ptr as &const byte, st.repo_root.len);
        }
        if repo.len == 0 {
            // 本会话还没建过 worktree（模式关着 / 非仓库）⇒ 现问一次当前工作区在哪
            const q: i32 = wt_repo_of(cfg.workspace.ptr as &const byte, cfg.workspace.len, &repo);
            if q != 0 || repo.len == 0 {
                _ = buf_append_cstr(out, "error: this workspace is not inside a Git repository, so there is nothing to reclaim\n");
                return;
            }
        } else {
            // 从 wt_state 抄过来的这一份**不带尾 NUL**（g_wt.repo_root 自己那个 NUL 是
            // 留给自己的 argv 用的），而 wt_reclaim_scan 要把它当 git 的 `-C` 参数 ——
            // 不补这一下会报「fatal: cannot change to '…'」，整条动作静默失败（踩坑 57）。
            _ = buf_append_byte(&repo, 0);
            repo.len = repo.len - 1;
        }
        _ = wt_reclaim_scan(repo.ptr as &const byte, out);
        return;
    }
    if bufx_eq_cstr(act.ptr as &const byte, act.len, "status" as &const byte) {
        wt_status_into(out);
        return;
    }
    if bufx_eq_cstr(act.ptr as &const byte, act.len, "start" as &const byte) {
        if !wt_on() {
            _ = buf_append_cstr(out, "error: worktree mode is off for this session (start it with --worktree or /worktree on)\n");
            return;
        }
        if wt_ready() {
            _ = buf_append_cstr(out, "the worktree is already provisioned:\n");
            wt_status_into(out);
            return;
        }
        var sid: Buf = buf_empty();
        defer { buf_free(&sid); }
        if g_sess.id.len > 0 {
            _ = buf_append(&sid, g_sess.id.ptr as &const byte, g_sess.id.len);
        } else {
            _ = buf_append_cstr(&sid, "session");
        }
        _ = wt_provision(cfg, cfg.workspace.ptr as &const byte, cfg.workspace.len,
            sid.ptr as &const byte, sid.len);
        if wt_ready() {
            const st: &const WtState = wt_state();
            _ = agent_workspace_apply(cfg, st.worktree_path.ptr as &const byte,
                st.worktree_path.len, "worktree" as &const byte, true);
            _ = buf_append_cstr(out, "provisioned worktree:\n");
            wt_status_into(out);
        } else {
            _ = buf_append_cstr(out, "error: no worktree could be provisioned: ");
            const st2: &const WtState = wt_state();
            _ = buf_append(out, st2.note.ptr as &const byte, st2.note.len);
            _ = buf_append_byte(out, 10);
        }
        return;
    }
    if bufx_eq_cstr(act.ptr as &const byte, act.len, "finish" as &const byte) {
        if cfg.is_subagent || cfg.deleg_depth > 0 {
            _ = buf_append_cstr(out, "error: a subagent shares its parent's worktree and must not merge it; only the root session calls finish.\n");
            return;
        }
        var msg: Buf = buf_empty();
        defer { buf_free(&msg); }
        _ = js_obj_get_str_unescaped(args, "message", 7, &msg);
        // wt_finish 的 `msg` 是 **C 串口径**（worktreex 里用 bufx_cstr_len / buf_append_cstr），
        // 而 js_obj_get_str_unescaped 只写内容、**不补 NUL**。不补这一下，那边就会一路读到
        // 堆尾巴：实测 merge 的 commit message 后面黏上了 `.rodata` 里的工具 schema
        // （"function","funct1"type":"function",…）—— 提交说明被污染，而且读的字节数不确定
        // （踩坑 57/67 同族）。空 msg 也补，语义仍是「没给 message」→ 用默认说明。
        if !buf_append_byte(&msg, 0) {
            _ = buf_append_cstr(out, "error: out of memory\n");
            return;
        }

        var keep: bool = false;
        var kv: JsonValue = JsonValue.json_null();
        if js_obj_get(args, "keepWorktree", 12, &kv) {
            keep = json_bool_of(&kv);
        }
        const rc: i32 = wt_finish(msg.ptr as &const byte, keep, out);
        if rc == 0 {
            // 合并成功后 worktree 已被删：把工作区搬回**仓库根**（共享 checkout 还在原分支上）
            const st: &const WtState = wt_state();
            _ = agent_workspace_apply(cfg, st.repo_root.ptr as &const byte, st.repo_root.len,
                "worktree" as &const byte, false);
            agent_worktree_log(cfg, "finish" as &const byte);
        }
        return;
    }
    if bufx_eq_cstr(act.ptr as &const byte, act.len, "discard" as &const byte) {
        if cfg.is_subagent || cfg.deleg_depth > 0 {
            _ = buf_append_cstr(out, "error: a subagent shares its parent's worktree and must not discard it.\n");
            return;
        }
        const rc2: i32 = wt_discard(out);
        if rc2 == 0 {
            const st2: &const WtState = wt_state();
            _ = agent_workspace_apply(cfg, st2.repo_root.ptr as &const byte, st2.repo_root.len,
                "worktree" as &const byte, false);
            agent_worktree_log(cfg, "discard" as &const byte);
        }
        return;
    }
    _ = buf_append_cstr(out, "error: unknown action; expected start|status|finish|discard|list");
}

// 落一条会话日志（finish/discard/reclaim 都是**删工作区**这种不可逆动作，值得留痕）
fn agent_worktree_log(cfg: &const Config, act: &const byte) void {
    _ = cfg;
    agent_worktree_log_cstr(act);
}

// 与上面同一件事，只是不收 cfg —— 退出路径（agent_session_close）里没有 cfg 可用。
fn agent_worktree_log_cstr(act: &const byte) void {
    if !g_sess.save {
        return;
    }
    const st: &const WtState = wt_state();
    var ev: Buf = buf_new(1024);
    defer { buf_free(&ev); }
    if sess_begin(&g_sess, "session/worktree", &ev) {
        _ = buf_append_cstr(&ev, "{\"action\":");
        if jw_str_into(&ev, act, bufx_cstr_len(act)) {
            _ = buf_append_cstr(&ev, ",\"worktree\":");
            if jw_str_into(&ev, st.worktree_path.ptr as &const byte, st.worktree_path.len) {
                _ = buf_append_cstr(&ev, ",\"branch\":");
                if jw_str_into(&ev, st.branch.ptr as &const byte, st.branch.len) {
                    _ = buf_append_cstr(&ev, ",\"base\":");
                    if jw_str_into(&ev, st.base.ptr as &const byte, st.base.len) {
                        _ = buf_append_cstr(&ev, "}");
                        _ = sess_end(&g_sess, &ev);
                    }
                }
            }
        }
    }
}

// /worktree 的动作执行（滚动模式的文本入口与 P41 的 TUI 选择浮层**共用这一份文本**）：
// 空参数与 `status` 都是状态报告，`on`/`off` 只翻进程内的模式开关，其余动作复用 tools
// 那条路（人自己敲的就是批准）。out 会被重置 —— 调用方拿到的是「这一个动作的完整输出」。
fn wt_cmd_run(cfg: &Config, a: &const byte, an: usize, out: &Buf) void {
    buf_reset(out);
    if an == 0 || bufx_eq_cstr(a, an, "status" as &const byte) {
        wt_status_into(out);
        return;
    }
    if bufx_eq_cstr(a, an, "on" as &const byte) {
        wt_set_on(true);
        _ = buf_append_cstr(out, "worktree 模式：开（下一个新会话开始时建独立工作区）\n");
        return;
    }
    if bufx_eq_cstr(a, an, "off" as &const byte) {
        wt_set_on(false);
        _ = buf_append_cstr(out, "worktree 模式：关（当前 worktree 仍在；要清掉用 /worktree discard）\n");
        return;
    }
    // 其余动作复用 tools 那条路（人自己敲的就是批准）
    var jb: Buf = buf_new(an + 32);
    defer { buf_free(&jb); }
    _ = buf_append_cstr(&jb, "{\"action\":\"");
    _ = buf_append(&jb, a, an);
    _ = buf_append_cstr(&jb, "\"}");
    var arena_raw: [byte: 4096] = [0: 4096];
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, &arena_raw[0], 4096);
    var val: JsonValue = JsonValue.json_null();
    if !js_parse(&arena, jb.ptr as &const byte, jb.len, &val) {
        _ = buf_append_cstr(out, "error: 用法：/worktree [on|off|start|status|finish|discard|list|reclaim]\n");
        return;
    }
    wt_tool_worktree(cfg, &val, out);
}

// /worktree [on|off|start|status|finish|discard|list|reclaim]（人看 / 人管；非 TUI 的文本入口）
fn agent_repl_worktree(cfg: &Config, line: &const Buf) void {
    var arg: Buf = buf_empty();
    defer { buf_free(&arg); }
    var at: usize = 9;   // "/worktree" 之后
    while at < line.len && line.ptr[at] == 32 as byte {
        at = at + 1;
    }
    if line.len > at {
        arg = buf_new(line.len);
        _ = buf_append(&arg, &line.ptr[at], line.len - at);
    }
    var out: Buf = buf_new(16384);
    defer { buf_free(&out); }
    wt_cmd_run(cfg, arg.ptr as &const byte, arg.len, &out);
    tty_write(&tty_ui, 2, out.ptr as &const byte, out.len);
}

// ============================================================
// P41：/worktree 的动作选择浮层（TUI）
//
// P37 的 `/worktree` 在人这一侧一直是「文本命令 + 一张状态报告」：动作只写在
// `/help` 的一行里，TUI 里敲裸命令看到的是报告、不是「有哪些动作」。而同一条线上
// 的 /permission、/model、/effort 早就都是**底对齐选择浮层**了 —— 这一节把 /worktree
// 补齐成同一套观感：
//   * 裸 `/worktree` 开浮层，八个动作一行一个（`✓` 标当前模式，游标**默认停在 status**，
//     所以「打开就回车」仍等于 P37 的裸命令 —— 老手感不变）；
//   * `finish` / `discard` 是**删目录删分支**的不可逆动作：选定不生效，先翻第二道确认
//     浮层，游标默认停在「取消」（与 Full access 的风险确认同一态度，彩排过：只按回车
//     不会把 worktree 合掉/删掉）；
//   * `reclaim`（P53）也删目录，但它只清**确定的垃圾**（干净 + 零提交 + 没人在用），
//     所以不翻确认框 —— 真判据在 worktreex 里，人敲这个动作是「顺手扫一下」。
//   * 执行结果走 wt_cmd_run 的同一份文本，以一条 notice 落进转录（滚动模式那条 tty_write
//     的路一个字都没动）。
// ============================================================

// 动作表：机器名（= tools 的 action 词汇，也是浮层条目行首那个词）与一行说明。
// 顺序就是浮层里的行序；下标的三个常量是「游标默认停哪儿」与「哪两个要先确认」。
const WT_ACT_N: usize = 8;
const WT_ACT_STATUS: usize = 3;    // 裸命令打开时的默认游标
const WT_ACT_FINISH: usize = 4;
const WT_ACT_DISCARD: usize = 5;

// worktree 动作的**机器名**（第 i 个）：on/off/start/status/finish/discard/list/reclaim。
// 与 `wt_act_gloss` 配对，两个表**必须一一对应**（浮层生成与反解共用它们）。
fn wt_act_name(i: usize) &const byte {
    if i == 0 {
        return "on" as &const byte;
    }
    if i == 1 {
        return "off" as &const byte;
    }
    if i == 2 {
        return "start" as &const byte;
    }
    if i == 3 {
        return "status" as &const byte;
    }
    if i == 4 {
        return "finish" as &const byte;
    }
    if i == 5 {
        return "discard" as &const byte;
    }
    if i == 6 {
        return "list" as &const byte;
    }
    return "reclaim" as &const byte;
}

// worktree 动作的**显示名**。与 `wt_act_name` 同下标对应 —— 改动要两张表一起改。
fn wt_act_gloss(i: usize) &const byte {
    if i == 0 {
        return "下一个新会话开始时建独立工作区" as &const byte;
    }
    if i == 1 {
        return "不建（当前 worktree 还在；要清掉用 discard）" as &const byte;
    }
    if i == 2 {
        return "当场给这个会话建一个（没建过时；幂等）" as &const byte;
    }
    if i == 3 {
        return "worktree / 分支 / 基分支 / 未提交路径" as &const byte;
    }
    if i == 4 {
        return "提交 → 合并回基分支 → 删掉 worktree 与分支" as &const byte;
    }
    if i == 5 {
        return "不合并，直接删掉 worktree 与分支" as &const byte;
    }
    if i == 6 {
        return "这个仓库里还留着的会话 worktree" as &const byte;
    }
    return "清掉这个仓库里确定的垃圾：干净且零提交的残留 worktree，外加目录已没、零提交的孤儿分支" as &const byte;
}

// 浮层里的一行：`✓ `（当前模式）或两个空格 + 机器名补齐 + ` — ` + 一行说明。
// 生成与反解共用这一份（与 /permission 的选择器同一套排版）
fn agent_tui_worktree_line(i: usize, out: &Buf) void {
    buf_reset(out);
    const name: &const byte = wt_act_name(i);
    const n: usize = bufx_cstr_len(name);
    var marked: bool = false;
    if i == 0 {
        marked = wt_on();
    }
    if i == 1 {
        marked = !wt_on();
    }
    if marked {
        _ = buf_append_cstr(out, "✓ ");
    } else {
        _ = buf_append_cstr(out, "  ");
    }
    _ = buf_append(out, name, n);
    var pad: usize = n;
    while pad < 8 {          // 机器名补齐（最长 discard = 7 列 + 1 空格）
        _ = buf_append_byte(out, 32);
        pad = pad + 1;
    }
    _ = buf_append_cstr(out, "— ");
    _ = buf_append_cstr(out, wt_act_gloss(i));
}

// 拼 `/worktree` 选择框的条目：八个动作一行一个，`✓` 标当前模式，游标默认停在 `status`
// —— 所以「打开就回车」与裸 `/worktree` 的文本版逐字节同效（§7 的 worktree 段）。
fn agent_tui_worktree_items() Buf {
    var out: Buf = buf_new(1024);
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    var i: usize = 0;
    while i < WT_ACT_N {
        agent_tui_worktree_line(i, &line);
        _ = buf_append(&out, line.ptr, line.len);
        _ = buf_append_byte(&out, 10);
        i = i + 1;
    }
    return out;
}

// 浮层选中项 → 动作名（`✓ `/两空格 之后的第一个词）。认不出来的行（确认浮层里的
// 「取消」、别的浮层漏进来的条目）返回 false —— 调用方按「什么都没选」处理，绝不猜
fn agent_tui_worktree_parse(sel: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if sel.len < 3 {
        return false;
    }
    const p: &const byte = sel.ptr as &const byte;
    var s: usize = 2;
    // "✓" 是 3 字节（E2 9C 93）+ 1 空格 = 4；"  " 是 2 字节
    if p[0] == 0xE2 as byte {
        s = 4;
    }
    while s < sel.len && p[s] != 32 as byte && p[s] != 9 as byte {
        _ = buf_append_byte(out, p[s]);
        s = s + 1;
    }
    if out.len == 0 {
        return false;
    }
    var i: usize = 0;
    while i < WT_ACT_N {
        if bufx_eq_cstr(out.ptr as &const byte, out.len, wt_act_name(i)) {
            return true;
        }
        i = i + 1;
    }
    buf_reset(out);
    return false;
}

// 这个动作要不要先过一道确认？（finish / discard 都会删掉 worktree 与分支）
fn wt_act_needs_confirm(act: &const Buf) bool {
    return bufx_eq_cstr(act.ptr as &const byte, act.len, "finish" as &const byte) ||
        bufx_eq_cstr(act.ptr as &const byte, act.len, "discard" as &const byte);
}

// 动作名 → 下标（`wt_act_name` 的反解）。认不出返回一个**越界**值，由调用方当非法动作拒掉。
fn wt_act_index_of(act: &const Buf) usize {
    if bufx_eq_cstr(act.ptr as &const byte, act.len, "finish" as &const byte) {
        return WT_ACT_FINISH;
    }
    return WT_ACT_DISCARD;
}

// 打开 `/worktree` 动作选择浮层（游标默认落在 status：打开就回车 = P37 的裸命令看状态）
export fn agent_tui_worktree_open() void {
    const items: Buf = agent_tui_worktree_items();
    defer { buf_free(&items); }
    const title: &const byte = "Git worktree（enter 执行 · esc 取消）" as &const byte;
    tui_overlay_menu(TUI_OVK_WORKTREE, title, bufx_cstr_len(title),
        items.ptr as &const byte, items.len, WT_ACT_STATUS);
}

// 执行选中的动作：文本与滚动模式共用 wt_cmd_run，结果以一条 notice 落进转录
fn agent_tui_worktree_exec(cfg: &Config, act: &const Buf) void {
    var out: Buf = buf_new(16384);
    defer { buf_free(&out); }
    wt_cmd_run(cfg, act.ptr as &const byte, act.len, &out);
    if out.len == 0 {
        return;
    }
    tui_add_notice(out.ptr as &const byte, out.len);
}

// 消费 /worktree 浮层的结果（TUI 主循环与自测共用；返回 true = 处理了一个浮层结果）
export fn agent_tui_worktree_handle(cfg: &Config, h: &const History, sel: &const Buf) bool {
    const kind: u8 = tui_overlay_kind();
    if kind == TUI_OVK_WORKTREE {
        var act: Buf = buf_new(32);
        defer { buf_free(&act); }
        if !agent_tui_worktree_parse(sel, &act) {
            return true;
        }
        if wt_act_needs_confirm(&act) {
            // 不可逆动作：选定不生效，先翻一道确认（游标默认停在「取消」）
            var line: Buf = buf_new(256);
            defer { buf_free(&line); }
            agent_tui_worktree_line(wt_act_index_of(&act), &line);
            var items: Buf = buf_new(512);
            defer { buf_free(&items); }
            _ = buf_append(&items, line.ptr, line.len);
            _ = buf_append_cstr(&items, "\n取消\n");
            var ct: Buf = buf_new(64);
            defer { buf_free(&ct); }
            _ = buf_append_cstr(&ct, "确认 ");
            _ = buf_append(&ct, act.ptr as &const byte, act.len);
            _ = buf_append_cstr(&ct, "？");
            var prompt: Buf = buf_new(256);
            defer { buf_free(&prompt); }
            if bufx_eq_cstr(act.ptr as &const byte, act.len, "finish" as &const byte) {
                _ = buf_append_cstr(&prompt,
                    "会提交 worktree 里的改动、合并回基分支，然后删掉 worktree 与分支（合并后不可撤销）。" as &const byte);
            } else {
                _ = buf_append_cstr(&prompt,
                    "会直接删掉 worktree 与它的分支，里面的改动**不会**合并，也找不回来。" as &const byte);
            }
            tui_overlay_menu_confirm(TUI_OVK_WORKTREE_CONFIRM, ct.ptr as &const byte, ct.len,
                prompt.ptr as &const byte, prompt.len, items.ptr as &const byte, items.len, 1);
            return true;
        }
        agent_tui_worktree_exec(cfg, &act);
        _ = h;
        return true;
    }
    if kind == TUI_OVK_WORKTREE_CONFIRM {
        var act: Buf = buf_new(32);
        defer { buf_free(&act); }
        // 「取消」与认不出的行都会走到这里：反解失败 ⇒ 什么都不做
        if !agent_tui_worktree_parse(sel, &act) {
            return true;
        }
        agent_tui_worktree_exec(cfg, &act);
        return true;
    }
    return false;
}

// ============================================================
// P9：自动压缩
//
// 压力 = 最近一次响应的 prompt_tokens（DSH tokenMeter 的口径）；没有就按字节/4 估。
// 超过 floor(contextWindow × 0.8) 时：调一次模型做 checkpoint，然后
//   system 原文保留 + checkpoint 消息插在其后 + 尾部最近一段原文保留。
// ============================================================
fn agent_pressure_tokens(cfg: &const Config, h: &const History) i64 {
    if g_last_prompt_tokens > 0 {
        return g_last_prompt_tokens;
    }
    // 估算：请求体大致是历史 + tools + system
    var est: i64 = 0;
    var i: usize = 0;
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        est = est + ((m.text_len + m.extra_len) as i64) / 4;
        i = i + 1;
    }
    _ = cfg;
    return est;
}

// force=true 时忽略阈值（/compact 手动触发）
fn agent_maybe_compact(cfg: &const Config, h: &History, step: i32, force: bool) bool {
    const cw: i64 = cfg.context_window;
    if cw <= 0 {
        return false;
    }
    const limit: i64 = cmp_pressure_limit(cw);
    const pressure: i64 = agent_pressure_tokens(cfg, h);
    if !force && pressure < limit {
        return false;
    }
    const shadow: usize = cmp_shadow_count(h, pressure);
    if shadow == 0 {
        return false;
    }
    // 组摘要请求：历史副本 + 摘要提示词（DSH 把提示词作为最后一条 user 消息）
    var tmp: History = hist_init();
    defer { hist_free(&tmp); }
    var i: usize = 0;
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        _ = hist_push_msg_kind(&tmp, m.role, m.kind, m.text as &const byte, m.text_len, m.extra as &const byte, m.extra_len);
        i = i + 1;
    }
    var prompt: Buf = buf_new(8192);
    defer { buf_free(&prompt); }
    if !cmp_summary_prompt(&prompt) {
        return false;
    }
    if !hist_push(&tmp, ROLE_USER, prompt.ptr as &const byte, prompt.len) {
        return false;
    }
    var req: Buf = buf_new(request_bytes_needed(&tmp, cfg));
    defer { buf_free(&req); }
    var url: Buf = buf_new(cfg.base_url.len + 24);
    defer { buf_free(&url); }
    var hdrs: Buf = buf_new(512);
    defer { buf_free(&hdrs); }
    if !build_headers(cfg, &hdrs) {
        return false;
    }
    var o: ChatOut = chat_out_new();
    defer { chat_out_free(&o); }
    var tc: TlsConn = tls_conn_empty();

    // 摘要请求也跟随生效协议；未声明时同样允许一次协商回退（否则空窗口路由上压不动）
    var status: i32 = 0;
    var tried: i32 = 0;
    var interrupted: bool = false;
    while true {
        tried = tried + 1;
        const style: u8 = api_style_now(cfg);
        if !api_url_into(cfg, style, &url) || !build_model_request(cfg, &tmp, &req, style) {
            return false;
        }
        var guard: FdGuard = FdGuard{ saved: -1, nullfd: -1, active: false };
        tls_noise_mute(&guard, !cfg.tls_debug && !hc_debug);
        const res: !i32 = llm_stream_style(
            style,
            url.ptr[0: url.len],
            hdrs.ptr[0: hdrs.len],
            req.ptr as &const byte,
            req.len,
            cfg.timeout_ms,
            cfg.max_response,
            cfg.verify,
            cfg.pin.ptr[0: cfg.pin.len],
            &o,
            false,
            false,
            // P31：压缩也是「请求在飞」的一段。这里原来写死 false → 摘要请求的整段流式
            // 一个泵点都没有：上下文一大（自动压缩或 /compact），界面就是冻的，敲 /status
            // 要等摘要回来。跟随交互标志之后，键盘与运行中的只读命令照常服务，而且
            // esc/ctrl+c 现在能中断压缩本身。
            g_interactive
        );
        tls_noise_unmute(&guard);
        status = res catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            if eid == @error_id(error.LlmInterrupted) {
                interrupted = true;
            }
            0;
        };
        if api_negotiate(cfg, style, status) && tried < 2 {
            buf_reset(&o.content);   // 换协议重发：上一轮没解析出内容，清掉以防串味
            continue;
        }
        api_lock(cfg, style);
        break;
    }
    if interrupted {
        // 用户按了 esc/ctrl+c：这不是「摘要失败」，别用那句话误导人（历史一个字没改）
        if !cfg.quiet {
            out_err("[compact] 已中断（历史未改动）\n");
        }
        return false;
    }
    if status != 200 || o.content.len == 0 {
        if !cfg.quiet {
            out_err("[compact] 摘要请求失败，跳过本次压缩\n");
        }
        return false;
    }
    // 应用：先算被遮蔽内容的字节数（cmp_apply 会用），再改写历史
    if !cmp_apply(h, shadow, &o.content) {
        if !cfg.quiet {
            out_err("[compact] 摘要不比被遮蔽内容短，放弃压缩\n");
        }
        return false;
    }
    // cmp_apply 从 0 开始遮蔽，把 system 也清掉了：这里补回
    //   [system 原文] + [checkpoint 消息] + [保留的尾部]
    var ck: Buf = buf_new(o.content.len + 512);
    defer { buf_free(&ck); }
    if cmp_build_checkpoint(&o.content, &ck) {
        // 先插 checkpoint 到 0，再把 system 插到 0 → 顺序就是 system, checkpoint, …
        _ = hist_insert_at(h, 0, ROLE_USER, ck.ptr as &const byte, ck.len, null, 0);
        var sp: Buf = buf_new(32768);
        defer { buf_free(&sp); }
        if agent_system_prompt(cfg, &sp) {
            _ = hist_insert_at(h, 0, ROLE_SYSTEM, sp.ptr as &const byte, sp.len, null, 0);
        }
    }
    if !cfg.quiet {
        out_err("[compact] 已压缩较早的 ");
        out_err_dec(shadow);
        out_err(" 条消息（pressure=");
        out_err_dec(pressure as usize);
        out_err(" limit=");
        out_err_dec(limit as usize);
        out_err("）\n");
    }
    agent_log_simple("compaction/summary", "{\"kind\":\"auto\"}");
    g_last_prompt_tokens = 0;
    _ = step;
    return true;
}

// 在 idx 处插入一条消息（其余后移）
fn hist_insert_at(h: &History, idx: usize, role: u8, text: &const byte, text_len: usize, extra: &const byte, extra_len: usize) bool {
    if idx > h.len {
        return false;
    }
    // 先腾容量再取地址：realloc 可能把整块搬走
    if !hist_reserve(h, 1) {
        return false;
    }
    var i: usize = h.len;
    while i > idx {
        const cur: usize = i;
        const prev: usize = i - 1;
        const cm: &Msg = msg_at_mut(h, cur);
        const pm: &Msg = msg_at_mut(h, prev);
        cm[0] = pm[0];
        i = prev;
    }
    const slot: &Msg = msg_at_mut(h, idx);
    slot[0] = Msg{ role: role, kind: CMP_KIND_TOOL, text: null, text_len: 0, extra: null, extra_len: 0 };
    if text_len > 0 {
        slot.text = hist_dup(text, text_len);
        if (slot.text as usize) == 0 {
            return false;
        }
    }
    slot.text_len = text_len;
    if extra_len > 0 {
        slot.extra = hist_dup(extra, extra_len);
        if (slot.extra as usize) == 0 {
            return false;
        }
    }
    slot.extra_len = extra_len;
    h.len = h.len + 1;
    h.bytes = h.bytes + text_len + extra_len;
    return true;
}

// --list-dsh-sessions：列出 DSH 自己的会话
fn agent_list_dsh_sessions(cfg: &const Config) i32 {
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_dsh_home(cfg, &home) {
        out_err("error: 找不到 DSH_HOME\n");
        return AGENT_USAGE;
    }
    var s: DshSessions = DshSessions{ items: [], n: 0 };
    dshs_init(&s);
    defer { dshs_free(&s); }
    dshs_list(home.ptr[0: home.len], &"x"[0: 0], &s);
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    dshs_render_list(&s, &out, home.ptr[0: home.len]);
    out_err_bytes(out.ptr as &const byte, out.len);
    return AGENT_OK;
}

// DSH_HOME：cfg.dsh_home > $DSH_HOME > ~/.dsh
fn agent_default_dsh_home(cfg: &const Config, out: &Buf) bool {
    return dsh_home_resolve(cfg.dsh_home.ptr as &const byte, out);
}

// **非交互**回合入口（一次性任务）：查 key → 建历史 → `agent_turn_loop`。
// `defer` 里 `hist_free` + `agent_session_close`（顺序不能换：会话关闭要用到历史之外的状态）。
fn agent_run(cfg: &Config) i32 {
    if cfg.api_key.len == 0 {
        out_err("error: no API key. set UYA_AGENT_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY\n");
        return AGENT_USAGE;
    }
    var h: History = hist_init();
    defer { hist_free(&h); }
    defer { agent_session_close(); }
    if !agent_history_begin(cfg, &h, &cfg.task) {
        out_err("error: cannot build history\n");
        return AGENT_PROTO;
    }
    if cfg.task.len > 0 && h.len > 0 {
        // 新建会话时才记录本轮任务（恢复会话时任务为空）
        agent_log_user(cfg.task.ptr as &const byte, cfg.task.len, false);
    }
    return agent_turn_loop(cfg, &h);
}

// ============================================================
// CLI
// ============================================================
fn print_usage() void {
    out_err("uya-agent — 极简 CLI 编程 agent（纯 Uya）\n\n");
    out_err("用法:\n");
    out_err("  uya-agent [任务词...]            一次性执行任务\n");
    out_err("  uya-agent                        REPL：逐行输入任务\n");
    out_err("  uya-agent --selftest             离线自测（内置 mock LLM，不需要网络与 key）\n");
    out_err("  uya-agent --probe                传输层探针（打印 HTTP 状态与 leaf 指纹）\n\n");
    out_err("选项:\n");
    out_err("  --base-url URL      默认 https://api.deepseek.com/v1\n");
    out_err("  --model NAME        默认 deepseek-chat\n");
    out_err("  --workspace DIR     工作目录（工具只在这里面活动），默认当前目录；\n");
    out_err("                      恢复会话时默认跟随会话记录的工作区，这条显式指定优先\n");
    out_err("  --max-steps N       熔断上限：最多几轮工具调用，默认 0 = 不限（跑到模型给出最终答案）\n");
    out_err("  --max-response N    响应体上限字节，默认 262144\n");
    out_err("  --timeout-ms N      单次 HTTP 超时，默认 120000\n");
    out_err("  --no-shell          不提供 run_shell 工具\n");
    out_err("  --api=MODE          线协议：openai-responses（默认，未声明时先试它）| openai-completions\n");
    out_err("                      不写 = 未声明：先打 /responses，404/405/501 自动回退 chat/completions（每进程一次）\n");
    out_err("  --reasoning-effort V  推理强度：completions 发顶层 reasoning_effort，responses 发 reasoning.effort\n");
    out_err("                      （compat.supportsReasoningEffort=false 时不发；off/none = 不发）\n");
    out_err("  --exec-effort V     低思考执行态：前 --exec-after N 步用 --reasoning-effort 把方案想清，\n");
    out_err("                      第 N+1 步起切到 V 执行（默认关；人运行中 /effort 改过就不自动切）\n");
    out_err("  --exec-after N      想清的窗口（步数）；0 = 关闭低思考执行态（默认）\n");
    out_err("  --grace-steps N     验收类命令在改动之后首次跑绿起，还允许再走 N 步；0 = 只提醒不截断\n");
    out_err("  --no-stream         关闭流式（SSE），回退到一次性响应\n");
    out_err("  --compat-fold       工具结果折叠成一条 user 消息（老端点兼容）\n");
    out_err("  --no-stream-options 不发送 stream_options.include_usage\n");
    out_err("  --show-reasoning    显示思考行：滚动模式=运行中在提示符那一行滚动、结束落一行；\n");
    out_err("                      TUI=额外把思考收进转录条目（TUI 的状态区默认已有实时一行）\n");
    out_err("  --show-usage        每轮打印 token 用量（in/out/cache/reasoning）\n");
    out_err("  --tool-lines N      工具正文：默认 0 = 只留一行；N>0 = 首尾各 N 行（含 diff/todo 清单）\n");
    out_err("  --debug-dump FILE   诊断原文（网关错误体/坏 payload 等）以**原始字节**追加落盘；\n");
    out_err("                      默认关：转录里只有转义预览，全文仍进会话日志 diag/dump\n");
    out_err("  --max-tokens N      发送 max_tokens（默认不发送）\n");
    out_err("  --temperature N     发送 temperature 0..N（默认不发送）\n");
    out_err("  --agent-home DIR    会话/索引存放根目录，默认 ~/.uya-agent\n");
    out_err("  --no-save           不写会话日志（只跑不记）\n");
    out_err("  --continue          接着当前目录下最近一条会话继续\n");
    out_err("  --resume ID         恢复指定会话（id 或 last）\n");
    out_err("  --list-sessions     列出本机会话后退出\n");
    out_err("  --dsh-home DIR      DSH 用户目录（默认 $DSH_HOME 或 ~/.dsh）\n");
    out_err("  --no-dsh-config     完全不读 DSH 设置\n");
    out_err("  --strict-dsh-config 读不到 DSH 设置就报错退出\n");
    out_err("  --print-config      打印生效配置与来源后退出\n");
    out_err("  --list-dsh-sessions 列出 DSH 自己的会话（读 ~/.dsh/sessions）\n");
    out_err("  --resume-dsh ID     把 DSH 会话导入并继续（id 可用前缀）\n");
    out_err("  --plan              以 plan 模式启动（先出计划再执行）\n");
    out_err("  --no-compact        关闭自动上下文压缩\n");
    out_err("  --context-window N  压缩判定的上下文窗口（默认取 DSH 模型条目）\n");
    out_err("  --permission MODE   访问模式：read-only | workspace-write | danger-full-access（默认 danger-full-access）\n");
    out_err("                      只读=写工具被拒+bash 逐条批准；工作区写=bash 关在沙箱里只写工作区；全权=不限制\n");
    out_err("  --no-sandbox        关掉 bash 的内核沙箱（bwrap），confined 模式下不再 fail closed\n");
    out_err("  --worktree          独立工作区执行：会话开始建 git worktree，干完用 worktree 工具 finish 合并并删掉\n");
    out_err("  --no-worktree       不建 worktree（DSH agent-presets.default=git-worktree 会自动开，这个能关掉）\n");
    out_err("  --model NAME / --provider P / --effort V  模型与推理强度（默认取 DSH 设置；/model、/effort 运行中也能切）\n");
    out_err("  --bwrap PATH        指定 bwrap 可执行文件（默认探测 /usr/bin/bwrap、/bin/bwrap）\n");
    out_err("  --dsh-root DIR      packaged preset 根（读 persona/plan 文案）\n");
    out_err("  --skill-dir DIR     额外的技能根（冒号分隔，可多次）\n");
    out_err("  --uya-bin PATH      跑 workflow 脚本的 uya（默认 $UYA_BIN 或 uya）\n");
    out_err("  --tls-verify=MODE   chain（默认）| pin | none\n");
    out_err("  --tls-pin HEX       pin 模式下要求的 leaf 证书 SHA-256（小写 hex）\n");
    out_err("  --tui               全屏 TUI（TTY 交互模式默认）；--no-tui 退回滚动转录\n");
    out_err("  --title             交互模式下把终端标题写成当前会话标题（默认开）\n");
    out_err("  --no-title          不改终端标题（UYA_AGENT_TITLE=0 同口径）\n");
    out_err("  --no-title-auto     不让模型自动起标题（每来一条人类消息多一次小请求；\n");
    out_err("                      UYA_AGENT_TITLE_AUTO=0 同口径；/title 手写仍可用）\n");
    out_err("  --no-mouse          关掉 TUI 的鼠标上报（就能直接拖选复制文本；F2 / /mouse 同效）\n");
    out_err("  --color=MODE        auto（默认）| always | never | 16 | 256；NO_COLOR 也认\n");
    out_err("  --tui-demo          打印 TUI 的 home/chat 两屏纯文本快照后退出\n");
    out_err("  --quiet             不打印工具调用内容块（回退到旧的最小转录）\n");
    out_err("  --tls-debug         保留 lib/tls 的握手调试输出（默认静音）\n");
    out_err("  --http-debug        打印每轮响应头与体首字节（排查网关怪异响应）\n");
    out_err("  -h, --help          显示本帮助\n\n");
    out_err("环境变量:\n");
    out_err("  UYA_AGENT_BASE_URL / UYA_AGENT_MODEL / UYA_AGENT_WORKSPACE / UYA_AGENT_MAX_STEPS\n");
    out_err("  UYA_AGENT_API（openai-responses | openai-completions）/ UYA_AGENT_REASONING_EFFORT\n");
    out_err("  UYA_AGENT_PERMISSION（read-only | workspace-write | danger-full-access）/ UYA_AGENT_SANDBOX=0\n");
    out_err("  UYA_AGENT_BWRAP（bwrap 路径）\n");
    out_err("  UYA_AGENT_TUI=0|1（全屏 TUI 开关）/ UYA_AGENT_TITLE=0|1（终端标题开关）/ NO_COLOR\n");
    out_err("  UYA_AGENT_MOUSE=0|1（TUI 鼠标上报开关；=0 可直接拖选复制文本）\n");
    out_err("  UYA_AGENT_API_KEY 或 DEEPSEEK_API_KEY 或 OPENAI_API_KEY\n");
    out_err("  UYA_AGENT_EXEC_EFFORT / UYA_AGENT_EXEC_AFTER / UYA_AGENT_GRACE_STEPS（同 --exec-effort 等）\n");
}

// 从 stdin 取一行：inbuf 保存「上一批读进来但还没消费的剩余字节」，
// 这样管道/多行粘贴也能一行一个任务（不能假设一次 read 就是一行）。
fn read_line(inbuf: &Buf, out: &Buf) isize {
    buf_reset(out);
    while true {
        var nl: usize = inbuf.len;
        var i: usize = 0;
        while i < inbuf.len {
            if inbuf.ptr[i] == 10 as byte {
                nl = i;
                break;
            }
            i = i + 1;
        }
        if nl < inbuf.len {
            var line_len: usize = nl;
            if line_len > 0 && inbuf.ptr[line_len - 1] == 13 as byte {
                line_len = line_len - 1;
            }
            if !buf_append(out, inbuf.ptr, line_len) {
                return -1 as isize;
            }
            var k: usize = 0;
            var j: usize = nl + 1;
            while j < inbuf.len {
                inbuf.ptr[k] = inbuf.ptr[j];
                k = k + 1;
                j = j + 1;
            }
            inbuf.len = k;
            return 1 as isize;
        }
        if inbuf.len + 4096 + 1 > inbuf.cap {
            return -1 as isize;      // 单行过长
        }
        const n: isize = sys_read(0, &inbuf.ptr[inbuf.len], inbuf.cap - inbuf.len - 1) catch { -1 as isize; };
        if n <= 0 {
            if inbuf.len > 0 {
                // EOF 前最后一行（没有换行结尾）
                if !buf_append(out, inbuf.ptr, inbuf.len) {
                    return -1 as isize;
                }
                inbuf.len = 0;
                return 1 as isize;
            }
            return n;
        }
        inbuf.len = inbuf.len + (n as usize);
    }
}

// 十进制有符号整数参数解析；解析不出（空串/有非数字）返回 fallback。
// 不做溢出检查 —— CLI 上给了超范围的值，回落到 fallback 比截断更安全。
fn parse_i32_arg(p: &byte, fallback: i32) i32 {
    const n: usize = cstr_len(p);
    if n == 0 {
        return fallback;
    }
    var v: i32 = 0;
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c < 48 as byte || c > 57 as byte {
            return fallback;
        }
        v = v * 10 + ((c as i32) - 48);
        i = i + 1;
    }
    if v <= 0 {
        return fallback;
    }
    return v;
}

// 允许 0 的非负整数解析（--temperature 0 必须与「未给」区分开）
fn parse_i32_nonneg(p: &byte, fallback: i32) i32 {
    const n: usize = cstr_len(p);
    if n == 0 {
        return fallback;
    }
    var v: i32 = 0;
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c < 48 as byte || c > 57 as byte {
            return fallback;
        }
        v = v * 10 + ((c as i32) - 48);
        i = i + 1;
    }
    return v;
}

// 步数取值（--max-steps / UYA_AGENT_MAX_STEPS 共用）：
//   0（也是默认）= 不限步数；正整数 = 熔断上限。
// 非法值必须告警后再按默认处理 —— 否则 `--max-steps 12x` 这类手误会**静默**变成
// 「不限步数」，用户以为还有熔断，实际没有。
// 解析 `COLSxROWS`（--tui-demo 的可选尺寸）。返回 false = 不是这个形状。
fn parse_size_pair(s: &[byte], cols: &usize, rows: &usize) bool {
    const at: isize = bufx_find_byte(s, 120, 0);   // 'x'
    if at <= 0 {
        return false;
    }
    const a: i64 = parse_u64_at(s, 0, at as usize);
    const b: i64 = parse_u64_at(s, (at as usize) + 1, s.len - (at as usize) - 1);
    if a < 20 || b < 6 || a > 500 || b > 200 {
        return false;
    }
    cols[0] = a as usize;
    rows[0] = b as usize;
    return true;
}

// 解析步数类参数（`--max-steps` / `--grace-steps` 等）。非法值**告警后按「不限」(0)** 处理，
// 并把标签一起打出来 —— 静默忽略会让人以为上限生效了！
fn parse_steps_arg(p: &byte, label: &const byte) i32 {
    const n: usize = cstr_len(p);
    var i: usize = 0;
    while i < n && is_digit(p[i]) {
        i = i + 1;
    }
    if n == 0 || i != n {
        out_err("warning: ");
        out_err_bytes(label, cstr_len(label));
        out_err(" expects a non-negative integer; using the default (unlimited)\n");
        return 0;
    }
    return parse_i32_nonneg(p, 0);
}


// ============================================================
// P3 交互模式：提示符 + 流式 + Ctrl-C 中断 + 运行中输入 + 继续
// ============================================================

// 领取运行期间用户输入的文本（DSH steer）：每条作为独立的 user 消息。
// 例外：行首是 `/` 的**只读命令**（/status、/help、/sessions）按命令派发 ——
// 与滚动模式在 REPL 循环里那句「运行中输入的 slash 命令也按命令走」同一个口径，
// 用户并不知道回合是否已经结束。不安全的命令（会 hist_free / 改写历史）仍旧按文本走。
// P46：steer 那一侧的安全判定。比 agent_tui_cmd_safe 多认识一种命令的**带参形态**：
// `/title <新标题>` / `/title clear` 只写内存 + 一条日志事件 + OSC 2（不动历史、不发请求），
// 所以回合运行中当场派发是安全的 —— 用户改标题时并不知道回合有没有跑完。
//
// 为什么不能直接把 `/title` 塞进 agent_tui_cmd_safe：那个函数只拿得到**命令名**，
// 而裸 `/title` 要发一个侧路请求 + 开输入框浮层，在泵点里重入 llm_stream_style 是不行的
// （单线程，见踩坑 47）—— 它必须走「已收到 …：本回合结束后执行」那条路。
// 这里按**整行**判定，所以能分开这两支。
fn agent_tui_cmd_safe_steer(line: &const Buf) bool {
    if arg_starts_with(line.ptr as &const byte, "/title ") {
        // 带参数的那支：确认不是只有空白（`/title   ` 其实是裸命令，按不安全处理）
        var at: usize = 6;
        while at < line.len && (line.ptr[at] == 32 as byte || line.ptr[at] == 9 as byte) {
            at = at + 1;
        }
        return at < line.len;
    }
    return agent_tui_cmd_safe(line);
}

// **step 边界**领取运行期间用户敲进来的文本（DSH 的 steer 语义）：
// 作为**普通 user 消息**进入下一次请求（不加任何包装文案）；回合在领取前就结束了，
// 文本留在箱里成为下一轮的 prompt（§3.4 第 c 步）。
fn agent_claim_steer(cfg: &const Config, h: &History) void {
    var line: Buf = buf_new(4096);
    defer { buf_free(&line); }
    while inbox_pop(&g_steer, &line) {
        if line.len == 0 {
            continue;
        }
        if line.ptr[0] == 47 as byte && agent_tui_cmd_safe_steer(&line) {
            if cfg.tui && tui_active() {
                _ = agent_tui_command(cfg, h, &line);
            } else {
                _ = agent_repl_command(cfg, h, &line);
            }
            continue;
        }
        var pushed: bool = hist_push(h, ROLE_USER, line.ptr as &const byte, line.len);
        while !pushed {
            if !hist_drop_oldest(h) {
                break;
            }
            pushed = hist_push(h, ROLE_USER, line.ptr as &const byte, line.len);
        }
        agent_log_user(line.ptr as &const byte, line.len, true);
        if !cfg.quiet {
            tty_puts(&tty_ui, 2, "[steer] 已采纳运行中的输入\n");
        }
    }
}

// ============================================================
// P15/P22：输入行上方的面板块（子代理窗口 + 任务状态块）
//
// 面板内容的**生成**在 view（`view_agents_text`）与 tasks（`tasks_panel_text`），
// 多行块的**擦除/重画**在 tty（`tty_block_*`），这里只负责「什么时候刷新」：
//   * 起一个子代理、某个子代理跑完 → deleg 自己调 deleg_agents_refresh（立刻生效）；
//   * 长等待期间（前台 subagent / subagent_output wait）→ deleg 的等待循环每秒刷一次；
//   * 每个工具结果之后 → agent_tasks_sync（下面）；
//   * step 边界 → agent_agents_tick（下面）；TUI 另有 1Hz 心跳（tui_tick → tasks_tick）。
// 刻意不用回调：uya 0.10 没有函数指针，只能「上层推、下层画」。
// ============================================================
var g_agents_tick_ms: u64 = 0;

// 工具结果之后立刻刷一次：后台任务/子代理/清单都可能刚变过
fn agent_tasks_sync() void {
    tasks_poll();
    _ = tasks_panel_sync();
}

// P25：换会话（`/new` / `/resume` / fork / 启动）时清零的**会话级**状态。
//
// todo 清单原来**没人清**：`/new` 只关了旧会话、换掉历史、清了统计（`st_reset`），清单
// 原封不动，于是新会话的常驻任务块与 `/tasks` 里还挂着上一条会话的「第几步」—— 用户报的
// 正是这条（「new 指令后任务清单没有清空」）。
//
// 这里**只**清 todo：后台任务/子代理的复位是另一回事（`fsctx_init` 里的 `jobs_init` /
// `deleg_init`，那是「新会话 = 新的进程状态」，不是「清单没地方存」）；会话目标在盘上
// （`goal.json`）、按设计跨会话（见 README §7）。
fn agent_session_scoped_reset() void {
    todo_clear(&g_todos);
    // P58：续跑的**进程本地授权**不跨会话（DSH 的 goal/session-start 同一条）：目标本体在
    // 盘上、跨会话照旧（goal.json），但「继续自动跑」这件事要人重新授权。不清的话
    // `--resume` 会把上一条会话的授权继承过来 —— 人不在键盘前，agent 自己接着跑。
    // 启动、fork、`--resume`、`/new`、`/resume` 走的都是这条路，一处收口。
    g_goal_armed = false;
    // P46：标题的会话级状态跟着换会话复位。**不清 g_sess.title 本身** ——
    // 它由 sess_open / agent_hist_from_log 那条路负责（引用数超容量会丢，见踩坑 51）；
    // 这里只清「自动起标题有没有跑过」与「钉住」这两个进程级标志，
    // 否则 /new 之后新会话会被上一条会话的 pin 挡住、永远起不了标题。
    g_title_pinned = false;
    g_title_human_msgs = 0;
    g_title_auto_rev = 0;
    g_title_auto_done = false;
}

// P58：同会话 Goal Round 驱动器的唯一外部入口（主循环的空闲那一支调它）。
//
// 只做一件事：该开下一轮就开**一轮**，返回 true；否则返回 false。所谓「开一轮」是
//   ① `goal_round_admit` 要正文 —— 它顺带把这一轮记在账上（round/revision +1 落盘），
//      落盘失败就一个字节都不发（理由见那边的注释：不许出现「跑了没记账」的轮次）；
//   ② 把正文当**普通 user 消息**投进同一个会话（历史 + 日志 + 转录），再跑 `agent_turn_loop`；
//   ③ 收口时看盘上还是不是 active+armed、以及这一轮的退出码，该收就把本地授权收掉
//      （判据内联在下面，省一个顶层函数 —— 本仓函数表余量是 0，见 CODING.md §6）。
//
// 为什么**不在这里 while 循环**：轮与轮之间要留给主循环那圈输入处理（用户敲键、浮层结果、
// 只读命令）。在这里自转会把输入饿死，与 P46 自动起标题踩过的坑同族（"起标题的圈里敲进来的
// /status 被当成未知命令"）。所以它跑完**一轮**就 return，由主循环下一圈再问一次 —— 那圈本来
// 就要 poll 键盘，用户总有插话的机会。
fn agent_goal_drive(cfg: &Config, h: &History) bool {
    // 只在**有人在键盘前的前台会话**里自动续跑，与自动起标题同一条闸门（`agent_title_auto_on`）：
    // 管道 / CI 里不跑 —— 那儿没人能叫停它，而每一轮都是**真的**发请求（e2e-goal 那种离线
    // 脚本里建完目标就走，不该被它拖去打网络）。子代理也不跑（它自己的目标由父进程管）。
    if !g_interactive || cfg.is_subagent {
        return false;
    }
    // **人的优先权**（两道闸门放在这里，TUI 与滚动模式两个调用点因此不用各写一份）：
    //   * 已经要退出（ctrl+d / /exit）→ 不许再开新轮，否则「按了退出却先跑了一整轮」。
    //     **刻意不用 `tui_quit_wanted()`**：那个还含 headless 的「注入键用完」，是自测的收工
    //     信号而不是人的退出意图（headless 下用它等于自动续跑永不生效，这条路就没法验收）。
    //   * 键盘上还有待读的字节 → 让行（`agent_bg_input_pending` 在 TUI 下走 tui 侧那一份、
    //     滚动模式下 poll fd 0）：自动续跑永远不该抢在人的输入前面。
    if tui_abort_state() == TUI_ABORT_QUIT || agent_bg_input_pending() {
        return false;
    }
    var body: Buf = buf_new(8192);
    defer { buf_free(&body); }
    if !goal_round_admit(cfg, &body) || body.len == 0 {
        return false;
    }
    // 与「用户提交一行」同一条路：进历史、进日志、进转录 —— 它是同一会话里的一条 user 消息
    var pushed: bool = hist_push(h, ROLE_USER, body.ptr as &const byte, body.len);
    while !pushed {
        if !hist_drop_oldest(h) {
            break;
        }
        pushed = hist_push(h, ROLE_USER, body.ptr as &const byte, body.len);
    }
    if !pushed {
        out_err("[goal] 续跑：写不进历史，本轮放弃\n");
        return false;
    }
    agent_log_user(body.ptr as &const byte, body.len, false);
    // 回执走诊断通道（TUI 下它就是转录里的一条 NOTICE，滚动模式直接打终端，`--quiet`
    // 由 tty/view 那一层关掉）；**不用** tui_add_notice：那个接口在非 TUI 的滚动模式里
    // 也会开条目，白白堆转录。
    if !cfg.quiet {
        out_err("[goal] 自动续跑一轮（/goal pause 可停）\n");
    }
    tasks_goal_reload(cfg);
    if cfg.tui && tui_active() {
        tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    }
    tui_interrupt_clear();   // 新回合 = 把上一轮遗留的中断意图清掉（与主循环提交任务同一条纪律）
    const rrc: i32 = agent_turn_loop(cfg, h);
    if cfg.tui && tui_active() {
        agent_tui_turn_done();
    }
    // 收口。两件事，都要看**跑完之后**的盘上与退出码：
    //   ① 模型可能在这一轮里把目标标成 complete / blocked / pause —— 盘上不再是
    //      「active + armed」就把本地授权跟着收掉，下一轮 admit 的第一道闸门就挡住；
    //   ② 这一轮**异常收场**（网络/协议错误）时也把授权收掉。DSH 的规则是「异常不自动重试，
    //      等用户明确 resume」—— 不收的话，上游一直 500 就是主循环一圈一圈地重发，
    //      屏幕上刷满「自动续跑一轮」，用户还看不出它在空转（真正踩过的形状）。
    //      中断（esc / ctrl+c）不算异常：那是人主动停下当前这一轮，目标该留着。
    //      P59：**截断也不算异常** —— 目标显然还没做完，而且截断那一轮的正文已经进历史，
    //      下一轮（新预算）正好接着写。DSH 的 goal 驱动器同样按「token 上限不是这一轮的
    //      目标结论」处理（它压根不看 turn/end 的 reason），轮次上限兜住空转。
    if g_goal_armed {
        var g: Goal = goal_empty();
        defer { goal_free(&g); }
        if rrc != AGENT_OK && rrc != AGENT_INTERRUPTED && rrc != AGENT_MAX_TOKENS {
            out_err("[goal] 这一轮异常收场，已停下自动续跑（修好后 /goal resume 接着跑）\n");
            g_goal_armed = false;
        } else if !goal_load(cfg, &g) || !g.active_state || !g.armed
            || !bufx_eq_cstr(g.phase.ptr as &const byte, g.phase.len, "active" as &const byte) {
            g_goal_armed = false;
        }
    }
    tasks_goal_reload(cfg);
    return true;
}

// 秒数 1Hz 刷新 + 面板内容变化检测（内容没变时 view 侧一个字节都不写）
export fn agent_agents_tick() void {
    const now: u64 = ua_now_ms();
    if now >= g_agents_tick_ms && (now - g_agents_tick_ms) < (1000 as u64) {
        return;
    }
    g_agents_tick_ms = now;
    agent_tasks_sync();
    _ = agent_watch_tick_if_active();
}

// P42：watch 的节流入口（1Hz 心跳、泵点、TUI 空闲主循环都走它）——没有 active 时立刻返回，零开销。
//
// 为什么要存一份 cfg：空闲的 TUI 主循环里 `g_pump_cfg` 是空的（它只在命令派发期间登记），
// 而跟随必须在那段时间也继续长（用户就是盯着它等子代理跑完的）。
export fn agent_watch_tick_if_active() bool {
    if !g_watch.active {
        return false;
    }
    if !g_watch_cfg_on {
        return false;
    }
    return agent_watch_tick(&g_watch_cfg);
}

// 强制刷一次（回合结束 / 退出前兜底；不受 1 秒节流限制）
export fn agent_agents_tick_force() void {
    g_agents_tick_ms = ua_now_ms();
    agent_tasks_sync();
}

// ============================================================
// P42：/watch —— 跟随某个子代理的实时过程消息
//
// 设计要点：
//   * **按需**：没有 active 的 watch 时，agent_watch_tick 一个字节都不读盘；
//   * **只读**：读的是子代理自己那份会话日志，绝不碰它的管道（subagent_output 的
//     增量游标因此完全不受影响）；
//   * 内容变了才重推浮层/转录（逐字节比），避免 1Hz 无脑重画。
// ============================================================
var g_watch_last_len: usize = 0;
var g_watch_last_id: i32 = 0;
// 跟随期间的配置副本（指针 + 有效位）：空闲 TUI 主循环也能继续 poll（见下面注释）
var g_watch_cfg: &const Config = null as &const Config;
var g_watch_cfg_on: bool = false;

// 把 cfg 的指针存进 `g_watch_cfg`，让**空闲 TUI 主循环**（那一轮没有 cfg 可传）也能
// 继续推进 /watch 的 1 Hz 轮询（§9.1）。
fn agent_watch_hold_cfg(cfg: &const Config) void {
    g_watch_cfg = cfg;
    g_watch_cfg_on = true;
}

// 关掉跟随（不开浮层的调用点：用户 /watch off / 子代理没了）
export fn agent_watch_stop() void {
    watch_stop(&g_watch);
    g_watch_last_len = 0;
    g_watch_last_id = 0;
    g_watch_cfg_on = false;
    g_watch_cfg = null as &const Config;
}

// 子代理进终态时把它记下来（标题里显示 idle/failed，并补一行结束语）
fn agent_watch_ended_name(status: u8) &const byte {
    return deleg_status_name(status);
}

// 一拍：读增量 → 变了就重推。返回 true = 有变化（调用方可据此决定重画）。
var g_watch_in_tick: bool = false;

// 一拍：读增量 → 变了就重推。返回 true = 有变化（调用方可据此决定重画）。
//
// **重入保护**：本函数会走 deleg_check / deleg_drain 收状态，而那两条内部走泵点
// （agent_pump_light），泵点里又会回调 agent_watch_tick_if_active —— 不设闸门就是
// watch_tick → deleg_check → deleg_drain → pump → watch_tick 的无限递归
// （实测 SIGSEGV，core 里 25 层全是这个环）。
export fn agent_watch_tick(cfg: &const Config) bool {
    if !g_watch.active {
        return false;
    }
    if g_watch_in_tick {
        return false;   // 已经在里面了：这一拍让外层那一次跑完
    }
    const wslot: usize = g_watch.slot;
    if wslot >= DELEG_MAX {
        agent_watch_stop();
        return true;
    }
    // 槽位被回收/换人了：跟随自动结束（编号对不上就是别人了）
    if !g_deleg.items[wslot].used || g_deleg.items[wslot].id != g_watch.id {
        agent_watch_stop();
        return true;
    }
    g_watch_in_tick = true;
    defer { g_watch_in_tick = false; }
    var changed: bool = false;
    if !g_watch.ended {
        // 收一下这个槽位的状态：跟随期间主循环可能没在 poll（滚动模式空闲、或跟的是
        // 后台子代理），不主动收的话「已结束」等不到 —— 日志读完、进程也退了，
        // status 却还停在 RUNNING。重入闸门保证这一段的泵点回调不会再进本函数。
        deleg_check(&g_deleg, wslot);
        if g_deleg.items[wslot].status == DELEG_RUNNING {
            _ = deleg_drain(&g_deleg, wslot);
        }
        // ralph 每轮换一份日志：路径变了就重定位（保留已渲染内容，插一行切换提示）
        var cur: Buf = buf_new(1200);
        defer { buf_free(&cur); }
        if deleg_watch_path(cfg, &g_deleg, g_watch.slot, &cur) && cur.len > 0 {
            if cur.len != g_watch.path.len
                || !bufx_mem_eq(cur.ptr as &const byte, g_watch.path.ptr as &const byte, cur.len) {
                watch_retarget(&g_watch, &cur);
                changed = true;
            }
        }
        if watch_poll(&g_watch, 200) {
            changed = true;
        }
        // 子代理跑完了：补一行结束语，之后不再读盘（日志已经不会再增长）
        const d: &const Deleg = &g_deleg.items[wslot];
        if d.status != DELEG_RUNNING {
            var ms: u64 = 0;
            if d.started_ms > 0 {
                const now: u64 = ua_now_ms();
                if now > d.started_ms {
                    ms = now - d.started_ms;
                }
            }
            watch_mark_ended(&g_watch, agent_watch_ended_name(d.status), ms / 1000);
            changed = true;
        }
    }
    if !changed {
        return false;
    }
    agent_watch_present();
    return true;
}

// 把当前 rendered 推给界面：TUI 走浮层（保留滚动位置），滚动模式追加到转录。
fn agent_watch_present() void {
    const abs: usize = watch_abs_len(&g_watch);
    if abs == 0 {
        return;
    }
    if abs == g_watch_last_len {
        return;   // 内容没变
    }
    if tui_active() {
        // 浮层整块重推（滚动位置由 tui_overlay_watch_update 按跟随态恢复）
        if g_watch.ended {
            var title: Buf = buf_new(96);
            defer { buf_free(&title); }
            _ = buf_append_cstr(&title, "跟随 sub-");
            _ = buf_append_u64(&title, g_watch.id as u64);
            _ = buf_append_cstr(&title, " · 已结束");
            tui_overlay_watch_set_title(title.ptr as &const byte, title.len);
        }
        tui_overlay_watch_update(g_watch.rendered.ptr as &const byte, g_watch.rendered.len);
    } else {
        // 滚动模式：append-only，只写**新增**的那一段（等同 tail -f）。
        // 用绝对长度做偏移：watch_trim 丢前缀时相对下标会失效（见 watch_abs_len 的注释）。
        const seg: &[byte] = watch_since(&g_watch, g_watch_last_len);
        if seg.len > 0 {
            tty_write(&tty_ui, 2, seg.ptr, seg.len);
        }
    }
    g_watch_last_len = abs;
}

// ------------------------------------------------------------
// /watch 命令：开始/停止/查看跟随
// ------------------------------------------------------------
// 把 `sub-N` 解析成槽位并开始跟随。写回执到 out（滚动模式打出）；TUI 里由调用方开浮层。
// 返回 true = 已开始跟随。
fn agent_watch_start(cfg: &const Config, idb: &const Buf, out: &Buf) bool {
    var id: i32 = -1;
    if !deleg_id_parse(idb, &id) {
        _ = buf_append_cstr(out, "[watch] 目标要写成 sub-N（如 /watch sub-1）\n");
        return false;
    }
    var slot: usize = 0;
    if !deleg_slot_of(&g_deleg, id, &slot) {
        _ = buf_append_cstr(out, "[watch] 没有 sub-");
        _ = buf_append_u64(out, id as u64);
        _ = buf_append_cstr(out, " 这个子代理（/tasks 或 list_agents 看现役清单）\n");
        return false;
    }
    // 路径可能还没落盘（刚 fork、header 还没写）：先试一次，失败也先把跟随挂上，
    // 之后的 tick 会反复重试（子代理一旦写出第一条事件就能读到）。
    var path: Buf = buf_new(1200);
    defer { buf_free(&path); }
    const have_path: bool = deleg_watch_path(cfg, &g_deleg, slot, &path);
    if !have_path {
        buf_reset(&path);   // 空路径 = 还没落盘，watch_read_more 会直接返回 0，下一拍重试
    }
    watch_begin(&g_watch, slot, id, &path);
    agent_watch_hold_cfg(cfg);
    g_watch_last_len = 0;
    _ = buf_append_cstr(out, "[watch] 跟随 sub-");
    _ = buf_append_u64(out, id as u64);
    _ = buf_append_cstr(out, "（");
    _ = buf_append_cstr(out, deleg_status_name(g_deleg.items[slot].status));
    _ = buf_append_cstr(out, "）");
    if !have_path {
        _ = buf_append_cstr(out, "；日志还没落盘，等第一条事件");
    }
    _ = buf_append_cstr(out, "\n");
    // 立刻读一拍（可能已经有内容），并把浮层开起来
    _ = agent_watch_tick(cfg);
    if tui_active() {
        var title: Buf = buf_new(96);
        defer { buf_free(&title); }
        _ = buf_append_cstr(&title, "跟随 sub-");
        _ = buf_append_u64(&title, id as u64);
        _ = buf_append_cstr(&title, " · ");
        _ = buf_append_cstr(&title, deleg_status_name(g_deleg.items[slot].status));
        tui_overlay_watch_open(
            title.ptr as &const byte,
            title.len,
            g_watch.rendered.ptr as &const byte,
            g_watch.rendered.len
        );
    }
    return true;
}

// 拼 `/watch` 的现役清单（表头 + 每个在跑的子代理一行）。
// 表头与代理行的分界是「行里有没有数字」（`watch_line_id` 那一族的口径）。
fn agent_watch_list(out: &Buf) void {
    _ = buf_append_cstr(out, "[watch] 现役子代理（/watch sub-N 跟随，/watch off 停）：\n");
    var n: usize = 0;
    var i: usize = 0;
    while i < DELEG_MAX {
        if g_deleg.items[i].used {
            _ = buf_append_cstr(out, "  sub-");
            _ = buf_append_u64(out, g_deleg.items[i].id as u64);
            _ = buf_append_cstr(out, " [");
            _ = buf_append_cstr(out, deleg_status_name(g_deleg.items[i].status));
            _ = buf_append_cstr(out, "] ");
            _ = buf_append(out, g_deleg.items[i].label.ptr, g_deleg.items[i].label.len);
            _ = buf_append_byte(out, 10);
            n = n + 1;
        }
        i = i + 1;
    }
    if n == 0 {
        _ = buf_append_cstr(out, "  （没有正在跑的子代理）\n");
    }
}

// 派发 /watch。args 是 "/watch" 之后的原文（含前导空格）。
//
// P46：返回值从 bool 换成「落点」码。旧口径只有「处理了 / 没处理」两格，于是「开始跟随」
// 与「目标无效」挤在同一格里 —— TUI 那条路分不出来，只好把 out（回执）整段丢掉，
// 用户敲 `/watch sub-9`（编号不存在）屏幕上就是一片静默，最难查的那种。
const WATCH_CMD_LIST: i32 = 0;     // 裸 /watch：清单已写进 out
const WATCH_CMD_STARTED: i32 = 1;  // 已开始/切换跟随（TUI 里浮层就是回执）
const WATCH_CMD_STOPPED: i32 = 2;  // 已停止跟随
const WATCH_CMD_BAD: i32 = 3;      // 目标无效：原因在 out 里，调用方**必须**把它说出来

// `/watch [sub-N]` 命令：无参数给清单（带「回车跟随」提示），带参数当场开跟随浮层。
// **只读命令** —— 属于「在每个泵点当场派发」那一类（§11.2），所以长 step 中途也能开。
// 返回落点码，供调用方区分「开了浮层」/「只回了清单」/「没认出编号」。
fn agent_cmd_watch(cfg: &const Config, args: &const byte, n: usize, out: &Buf) i32 {
    // 掐掉前导空白
    var s: usize = 0;
    while s < n && (args[s] == 32 as byte || args[s] == 9 as byte) {
        s = s + 1;
    }
    var e: usize = n;
    while e > s && (args[e - 1] == 32 as byte || args[e - 1] == 9 as byte) {
        e = e - 1;
    }
    var arg: Buf = buf_new(64);
    defer { buf_free(&arg); }
    _ = buf_append(&arg, @ptr_from_usize(@usize_from_ptr(args as &const void) + s) as &const byte, e - s);
    if arg.len == 0 {
        agent_watch_list(out);
        // WATCH_CMD_LIST = 「这不是一次开始/停止」：TUI 里据此开清单浮层；滚动模式已经把
        // 清单写进 out，调用方照打不误（两条路的落点不同，但内容同源）。
        return WATCH_CMD_LIST;
    }
    if sv_eq_cstr(&arg, "off") || sv_eq_cstr(&arg, "stop") {
        agent_watch_stop();
        if tui_overlay_watch_wanted() {
            tui_overlay_close();
        }
        _ = buf_append_cstr(out, "[watch] 已停止跟随\n");
        return WATCH_CMD_STOPPED;
    }
    if !agent_watch_start(cfg, &arg, out) {
        return WATCH_CMD_BAD;
    }
    return WATCH_CMD_STARTED;
}

// P46：现役清单里**第一个代理行**的下标（第 0 行是表头）。
// 裸 /watch 打开时把游标放上去 —— 「打开就回车」= 跟随第一个，与 /worktree
// 「打开就回车 = status」是同一套手感；不放的话默认游标停在表头那一行，回车只会得到
// 一句「没认出编号」。
fn agent_watch_list_first_row(items: &const Buf) usize {
    var id: Buf = buf_new(16);
    defer { buf_free(&id); }
    var line: usize = 0;
    var from: usize = 0;
    while from < items.len {
        var to: usize = from;
        while to < items.len && items.ptr[to] != 10 as byte {
            to = to + 1;
        }
        if watch_line_id(items.ptr + from, to - from, &id) {
            return line;
        }
        if to >= items.len {
            break;
        }
        from = to + 1;
        line = line + 1;
    }
    return 0;
}

// P46：清单里选中一行 → 开始跟随（TUI 主循环收到 TUI_OVK_WATCH_LIST 的结果时调它）。
// 两条失败路都**必须**落一条 notice：认不出编号（选到表头或空态行）、目标已经不在了
// （清单开着的时候子代理可能刚跑完）—— 静默是「什么都没发生」里最难查的一种。
export fn agent_tui_watch_pick(cfg: &const Config, sel: &const Buf) bool {
    var id: Buf = buf_new(16);
    defer { buf_free(&id); }
    if !watch_line_id(sel.ptr as &const byte, sel.len, &id) {
        const msg: &const byte = "error: 这一行里没认出子代理编号（↓ 选到 sub-N 那一行再回车）" as &const byte;
        tui_add_notice(msg, bufx_cstr_len(msg));
        return false;
    }
    var out: Buf = buf_new(512);
    defer { buf_free(&out); }
    if !agent_watch_start(cfg, &id, &out) {
        tui_add_notice(out.ptr as &const byte, out.len);
        return false;
    }
    return true;
}

// P46：回合运行中敲进来的一行文本的落点。返回 true = 已经**当场**按只读命令派发掉了
// （调用方不要再把它塞进 steer 收件箱）。
//
// 为什么要有它：收件箱要等 step 边界才被领取（agent_claim_steer），而「趁子代理在跑时敲
// /watch sub-1」等的正是那一刻 —— 一个长 bash 里几十秒都不来一个边界，屏幕上就是
// 「敲了没反应」。只读命令（agent_tui_cmd_safe）不改历史，借泵点上下文当场派发是安全的，
// 与 agent_tui_poll_pending_cmd 走同一条路。
//
// 泵点上下文没登记（不在回合里）时返回 false：那条路由主循环自己接。
export fn agent_steer_line(line: &const Buf) bool {
    if line.len == 0 || line.ptr[0] != 47 as byte {
        return false;
    }
    if !agent_tui_cmd_safe(line) {
        return false;
    }
    if (g_pump_cfg as usize) == 0 || (g_pump_hist as usize) == 0 {
        return false;
    }
    _ = agent_tui_command(g_pump_cfg, g_pump_hist, line);
    return true;
}

// 提示符里的子代理扇出摘要：运行中时把 `● 2 agents` 挂到 [step N] 后面
fn agent_prompt_suffix(out: &Buf) void {
    var n: usize = 0;
    var i: usize = 0;
    while i < DELEG_MAX {
        if g_deleg.items[i].used && g_deleg.items[i].status == DELEG_RUNNING {
            n = n + 1;
        }
        i = i + 1;
    }
    if n == 0 {
        return;
    }
    _ = buf_append_cstr(out, " [● ");
    _ = buf_append_u64(out, n as u64);
    if n == 1 {
        _ = buf_append_cstr(out, " agent]");
    } else {
        _ = buf_append_cstr(out, " agents]");
    }
}

// 滚动模式的启动横幅（工作区 / 模型 / 权限一类的摘要）。
fn agent_repl_banner(cfg: &const Config) void {
    tty_puts(&tty_ui, 2, "uya-agent 交互模式（纯 Uya）\n");    tty_puts(&tty_ui, 2, "  · 直接输入任务回车执行；回合运行中输入的文本会在下一个 step 被采纳\n");
    tty_puts(&tty_ui, 2, "  · 默认不限步数：一直跑到模型给出最终答案（--max-steps N 可熔断）\n");
    tty_puts(&tty_ui, 2, "  · Ctrl-C 中断当前回合（历史保留），Ctrl-D 退出\n");
    tty_puts(&tty_ui, 2, "  · /help 看命令；model=");
    tty_write(&tty_ui, 2, cfg.model.ptr as &const byte, cfg.model.len);
    tty_puts(&tty_ui, 2, "\n");
}

// 滚动模式的 `/help`：命令表。**TUI 的命令面板也读同一份文案** ——
// 两处措辞不一致会让人以为命令不一样（§11.6 的命令清单）。
fn agent_repl_help() void {
    tty_puts(&tty_ui, 2, "命令：\n");
    tty_puts(&tty_ui, 2, "  /help      显示本帮助\n");
    tty_puts(&tty_ui, 2, "  /continue  不再输入新内容，带着历史再跑一轮\n");
    tty_puts(&tty_ui, 2, "  /status    打印当前配置与历史条数\n");
    tty_puts(&tty_ui, 2, "  /tasks     任务状态进度（清单/后台任务/子代理/目标）；/tasks open|close 切常驻块\n");
    tty_puts(&tty_ui, 2, "  /watch     跟随子代理的实时过程消息（/watch sub-N 开始 · /watch off 停；裸 /watch 列现役）\n");
    tty_puts(&tty_ui, 2, "  /goal [<objective>|edit <objective>|pause|resume|clear]  会话目标（看/建/改/暂停/恢复/清除）\n");
    tty_puts(&tty_ui, 2, "  /compact   立即压缩上下文\n");
    tty_puts(&tty_ui, 2, "  /plan      切换 plan 模式\n");
    tty_puts(&tty_ui, 2, "  /permission [预设]  查看/切换访问模式（read-only|workspace-write|danger-full-access）\n");
    tty_puts(&tty_ui, 2, "  /mouse [on|off]  开关鼠标上报（关掉就能拖选复制文本；TUI 里 F2 同效）\n");
    tty_puts(&tty_ui, 2, "  /fullscreen [on|off]  浮层全屏（TUI 里占满转录区；ctrl+f / F11 同效）\n");
    tty_puts(&tty_ui, 2, "  /image [路径]  挂一张图到下一条消息（PNG|JPEG|GIF|WebP；需模型支持图片输入）\n");
    tty_puts(&tty_ui, 2, "  /paste     贴剪贴板（图片挂附件、文本进输入行；TUI 里 ctrl+v 同效）\n");
    tty_puts(&tty_ui, 2, "  /diff      查看 git 修改（非 TUI 模式打单列 unified diff）\n");
    tty_puts(&tty_ui, 2, "  /workspace [目录]  看/切当前会话的工作区（切换会记进会话日志；恢复会话时回到这里）\n");
    tty_puts(&tty_ui, 2, "  /model [名字]      看/切模型（按提供方分组；带名字直接切）\n");
    tty_puts(&tty_ui, 2, "  /effort [档位]     看/切推理强度（只列该模型公布的档位：off/minimal/low/medium/high/xhigh/max）\n");
    tty_puts(&tty_ui, 2, "  /worktree  Git worktree：独立工作区执行 → finish 合并回主干并删掉它（reclaim 清残留；TUI 里裸命令开动作选择框）\n");
    tty_puts(&tty_ui, 2, "  /title [<新标题>|clear]  看/改会话标题（裸命令让模型起一个建议；clear 清回基标题）\n");
    tty_puts(&tty_ui, 2, "  /sessions  列出本机会话\n");
    tty_puts(&tty_ui, 2, "  /resume ID 切换到指定会话（id 或 last）\n");
    tty_puts(&tty_ui, 2, "  /new       开一条新会话（当前会话保留在磁盘上）\n");
    tty_puts(&tty_ui, 2, "  /exit      退出（同 Ctrl-D）\n");
    tty_puts(&tty_ui, 2, "其余输入一律作为新任务提交；Ctrl-C 中断当前回合。\n");
    tty_puts(&tty_ui, 2, "默认不限步数：回合一直跑到模型给出最终答案；--max-steps N 才有熔断。\n");
}

// /status 用的占用条宽度（字符格）
const STATS_BAR_CELLS: i64 = 20;

// /status 的统计 + 上下文 + cpu/内存 块（TUI 浮层与滚动模式共用）。
// 注意这里会顺带把增量基准锚一次（agent_ctx_used 的副作用），所以它是「读+顺手校准」。
fn agent_status_stats_block(cfg: &const Config, h: &const History, out: &Buf) void {
    _ = buf_append_cstr(out, "--- 统计（整个会话，含 --resume 前的部分）---\n");
    st_stats_detail(out);
    var sys_t: i64 = 0;
    var tools_t: i64 = 0;
    var msgs_t: i64 = 0;
    const used: i64 = agent_ctx_used(cfg, h, &sys_t, &tools_t, &msgs_t);
    _ = buf_append_cstr(out, "--- 上下文（启发式，4 字符 ≈ 1 token）---\n");
    if used >= 0 {
        st_ctx_detail(out, used, cfg.context_window, sys_t, tools_t, msgs_t, STATS_BAR_CELLS);
    } else {
        _ = buf_append_cstr(out, "上下文已用   还没有可用样本（第一次请求返回后才有）\n");
    }
    _ = buf_append_cstr(out, "--- 进程 ---\ncpu         ");
    if procx_cpu_pct() >= 0 {
        _ = buf_append_u64(out, procx_cpu_pct() as u64);
        _ = buf_append_cstr(out, "%（uya-agent 进程 ");
        _ = buf_append_u64(out, procx_proc_count() as u64);
        _ = buf_append_cstr(out, " 个");
        if procx_last_span_ms() > 0 {
            _ = buf_append_cstr(out, " · 最近 ");
            st_fmt_duration(out, procx_last_span_ms());
            _ = buf_append_cstr(out, " 采样");
        }
        _ = buf_append_byte(out, 41);
    } else if procx_failed() {
        _ = buf_append_cstr(out, "不可用（读不到 /proc/<pid>/stat）");
    } else {
        _ = buf_append_cstr(out, "采样中（全屏 TUI 每 1s 采一次；滚动模式不采样）");
    }
    _ = buf_append_byte(out, 10);
    // P24：内存合计（与 cpu 同一次走查；口径 PSS / RSS 由 procx 探明）
    _ = buf_append_cstr(out, "内存        ");
    var mem: Buf = buf_new(32);
    defer { buf_free(&mem); }
    if procx_mem_kb() >= 0 && procx_fmt_mem_kb(&mem, procx_mem_kb()) {
        const kind: &const byte = procx_mem_kind_name();
        _ = buf_append(out, mem.ptr, mem.len);
        _ = buf_append_cstr(out, "（");
        _ = buf_append(out, kind, bufx_cstr_len(kind));
        _ = buf_append_cstr(out, " 合计 · uya-agent 进程 ");
        _ = buf_append_u64(out, procx_proc_count() as u64);
        _ = buf_append_cstr(out, " 个 · 5s 采样）");
    } else if procx_failed() {
        _ = buf_append_cstr(out, "不可用（读不到 /proc/<pid>/smaps_rollup 与 status）");
    } else {
        _ = buf_append_cstr(out, "采样中（全屏 TUI 每 5s 采一次；滚动模式不采样）");
    }
    _ = buf_append_byte(out, 10);
    _ = buf_append_cstr(out, "version    ");
    _ = buf_append(out, &AGENT_VERSION[0], AGENT_VERSION_LEN);
    _ = buf_append_byte(out, 10);
}

// 滚动模式的 `/status`：工作区 / 模型 / 权限 / plan / 目标 / 统计 / 上下文占用。
// 只读、不联网；TUI 里同一份内容走 reader 浮层。
fn agent_repl_status(cfg: &const Config, h: &const History) void {
    tty_puts(&tty_ui, 2, "base_url=");
    tty_write(&tty_ui, 2, cfg.base_url.ptr as &const byte, cfg.base_url.len);
    tty_puts(&tty_ui, 2, "\nmodel=");
    tty_write(&tty_ui, 2, cfg.model.ptr as &const byte, cfg.model.len);
    tty_puts(&tty_ui, 2, "\npermission=");
    tty_puts(&tty_ui, 2, perm_name(perm_get()));
    tty_puts(&tty_ui, 2, "\nsandbox=");
    if cfg.sandbox == SAN_OFF {
        tty_puts(&tty_ui, 2, "off (--no-sandbox)");
    } else {
        tty_puts(&tty_ui, 2, san_backend_name());
    }
    tty_puts(&tty_ui, 2, "\nworkspace=");
    tty_write(&tty_ui, 2, cfg.workspace.ptr as &const byte, cfg.workspace.len);
    // P46：会话标题（终端窗口/标签页上那一行 + /sessions 的标题列）
    tty_puts(&tty_ui, 2, "\ntitle=");
    if g_sess.title.len > 0 {
        tty_write(&tty_ui, 2, g_sess.title.ptr as &const byte, g_sess.title.len);
        if g_title_pinned {
            tty_puts(&tty_ui, 2, " (pinned; /title clear 解锁)");
        } else {
            tty_puts(&tty_ui, 2, " (auto; 下一条消息可能改写)");
        }
    } else {
        tty_puts(&tty_ui, 2, "(无标题，终端显示基标题)");
    }
    tty_puts(&tty_ui, 2, "\ntitle_auto=");
    if cfg.title_auto {
        tty_puts(&tty_ui, 2, "on");
    } else {
        tty_puts(&tty_ui, 2, "off (--no-title-auto)");
    }
    tty_puts(&tty_ui, 2, "\napi=");
    tty_puts(&tty_ui, 2, llm_style_name(api_style_now(cfg)));
    if cfg.src_api == API_SRC_DEFAULT {
        tty_puts(&tty_ui, 2, " (negotiable)");
    }
    tty_puts(&tty_ui, 2, " stream=");
    if cfg.stream {
        tty_puts(&tty_ui, 2, "on");
    } else {
        tty_puts(&tty_ui, 2, "off");
    }
    tty_puts(&tty_ui, 2, " shell=");
    if cfg.allow_shell {
        tty_puts(&tty_ui, 2, "on");
    } else {
        tty_puts(&tty_ui, 2, "off");
    }
    tty_puts(&tty_ui, 2, " max_steps=");
    if cfg.max_steps <= 0 {
        tty_puts(&tty_ui, 2, "unlimited");
    } else {
        out_err_dec(cfg.max_steps as usize);
    }
    tty_puts(&tty_ui, 2, " messages=");
    out_err_dec(h.len);
    if g_sess.path.len > 0 {
        tty_puts(&tty_ui, 2, "\nsession=");
        tty_write(&tty_ui, 2, g_sess.id.ptr as &const byte, g_sess.id.len);
        if g_sess.save {
            tty_puts(&tty_ui, 2, " (logging)");
        } else {
            tty_puts(&tty_ui, 2, " (no-save)");
        }
        tty_puts(&tty_ui, 2, " events=");
        out_err_dec(g_sess.events);
    }
    tty_puts(&tty_ui, 2, "\n");
    var blk: Buf = buf_new(4096);
    defer { buf_free(&blk); }
    agent_status_stats_block(cfg, h, &blk);
    tty_write(&tty_ui, 2, blk.ptr as &const byte, blk.len);
}

// ============================================================
// P22：/tasks —— 任务状态进度（todo 清单 / 后台任务 / 子代理 / 会话目标）
//
//   * 裸 /tasks      → TUI 开浮层、滚动模式打印报告（内容同源：tasks_report）
//   * /tasks open|close|toggle → 只切「常驻块」的展开态
//   * TUI 里 ctrl+t 与 /tasks toggle 同效
// ============================================================

// 报告只认「现取」的四张表：先 poll 一次（job/deleg 的状态与增量输出），再把 goal.json 读一遍
fn agent_tasks_refresh(cfg: &const Config) void {
    tasks_init();
    tasks_goal_reload(cfg);
    tasks_poll();
}

// `/tasks` 的完整报告（四张表：todo 清单 / 后台任务 / 子代理 / 会话目标）。
// 与常驻任务块**共用** `term/tasks` 的纯函数折叠（§9.5）—— 两处口径不会漂移。
fn agent_tasks_report(cfg: &const Config, out: &Buf) void {
    agent_tasks_refresh(cfg);
    tasks_report_globals(tasks_report_width(), out);
}

// 滚动模式：直接打进转录（与 /status 同一条路）
fn agent_repl_tasks(cfg: &const Config) void {
    var txt: Buf = buf_new(16384);
    defer { buf_free(&txt); }
    agent_tasks_report(cfg, &txt);
    tty_puts(&tty_ui, 2, "--- 任务 ---\n");
    tty_write(&tty_ui, 2, txt.ptr as &const byte, txt.len);
}

// P46：/title —— 会话标题（看 / 改 / 清 / 让模型起一个）。
//
// 三种形状，解析与语义只有这一份（TUI 与滚动模式共用）：
//   /title <新标题>  显式改名（钉住，落 kind=user，写索引 + OSC 2）
//   /title clear     退回基标题 + 解锁自动起标题（落一条空标题的 user 事件）
//   /title           让模型给一个**建议**（不改标题 —— 改不改由调用方决定）
//
// 返回码：0 = 已处理（含「建议已放进 out」）；调用方按各自界面把 out 打出去。
// `suggest` 出参只在裸 /title 时非空（= 模型建议，可能是空 = 没生成出来）。
//
// 为什么要把它做成「共用一份」：TUI 要拿建议去填输入框、滚动模式只能打在屏幕上，
// 但「哪个词是 clear」「空标题算不算合法」「钉不钉住」这些语义必须完全一致 ——
// 与 /goal 同一条纪律（解析与措辞只在 goal_cmd_run 一处）。
const TITLE_CMD_USAGE: &const byte = "用法：/title <新标题> · /title clear（清回基标题）· 裸 /title 让模型起一个建议" as &const byte;

// `/title [新标题]`：显式改标题（题、模型自动、显式命令是三个来源）。
// TUI 里裸 `/title` 先让模型填个草稿再让人改；滚动模式只报建议（没有输入框浮层，§11.7）。
fn agent_title_cmd(cfg: &const Config, h: &const History, line: &const Buf, out: &Buf, suggest: &Buf) bool {
    buf_reset(out);
    buf_reset(suggest);
    // 参数从 "/title" 之后开始（跳过多敲的空格）
    var at: usize = 6;
    while at < line.len && (line.ptr[at] == 32 as byte || line.ptr[at] == 9 as byte) {
        at = at + 1;
    }
    if at >= line.len {
        // 裸 /title：让模型起一个建议（**不改标题**）
        var t: Buf = buf_new(TTY_TITLE_FALLBACK_BYTES + 16);
        defer { buf_free(&t); }
        if agent_title_generate(cfg, h, &t, true) {
            _ = buf_append(suggest, t.ptr as &const byte, t.len);
            _ = buf_append_cstr(out, "[title] 建议标题：");
            _ = buf_append(out, t.ptr as &const byte, t.len);
            _ = buf_append_cstr(out, "\n");
        } else {
            _ = buf_append_cstr(out, "[title] 起不出来（没 key / 空历史 / 请求失败或被中断）\n");
        }
        if g_sess.title.len > 0 {
            _ = buf_append_cstr(out, "当前标题：");
            _ = buf_append(out, g_sess.title.ptr as &const byte, g_sess.title.len);
            _ = buf_append_cstr(out, "\n");
        } else {
            _ = buf_append_cstr(out, "当前标题：(无标题，终端显示基标题)\n");
        }
        _ = buf_append_cstr(out, TITLE_CMD_USAGE);
        _ = buf_append_cstr(out, "\n");
        return true;
    }
    // 整行就是 clear 才当动词（标题里带 clear 的走字面量那条，与 /goal 同一条口径）
    const arg: &const byte = @ptr_from_usize(@usize_from_ptr(line.ptr as &const void) + at) as &const byte;
    const an: usize = line.len - at;
    if bufx_eq_cstr(arg, an, "clear" as &const byte) {
        agent_title_clear(cfg);
        _ = buf_append_cstr(out, "[title] 已清回基标题（自动起标题重新生效）\n");
        return true;
    }
    const rc: i32 = agent_title_set_user(cfg, arg, an);
    if rc == TITLE_SET_EMPTY {
        // 静默成功是最坏的一种：用户以为改了，屏幕上什么都没有
        _ = buf_append_cstr(out, "[title] error: 这个标题清洗后是空的（控制字符 / 空白不算标题）；标题未改动\n");
        return false;
    }
    _ = buf_append_cstr(out, "[title] 会话标题已更新：");
    _ = buf_append(out, g_sess.title.ptr as &const byte, g_sess.title.len);
    _ = buf_append_cstr(out, "（已钉住：自动起标题不会再改写它；/title clear 可解锁）\n");
    return true;
}

// /goal（P29）：滚动模式直接打进转录；TUI 走浮层（见 agent_tui_command）。
// 命令解析与措辞全在 src/goal.uya（goal_cmd_run），这里只管「打到哪儿」。
fn agent_repl_goal(cfg: &const Config, line: &const Buf) void {
    var txt: Buf = buf_new(2048);
    defer { buf_free(&txt); }
    _ = goal_cmd_run(cfg, line, &txt);
    tty_write(&tty_ui, 2, txt.ptr as &const byte, txt.len);
    // 带参数的调用可能改过 goal.json：常驻任务块的目标段要跟着新值重画
    // （裸 /goal 是纯读，不碰面板 —— 与 /status 同一条纪律）
    if !sv_eq_cstr(line, "/goal") {
        tasks_goal_reload(cfg);
        _ = tasks_panel_sync();
    }
}

// 踩坑 72：/mouse [on|off] —— 开/关鼠标上报。这是「不能复制文本」的开关：鼠标上报开着时
// 终端把左键按下/拖动都交给我们（TUI 只吃滚轮、其余丢弃），终端自己的拖选复制就没了；
// 关掉之后终端重新接管拖选。TUI 里还多一条 F2 快捷键（同一个函数）。
// 滚动模式（--no-tui）从没开过鼠标上报，这里只回一行说明。
// 显示开关命令：/mouse（鼠标上报）与 /fullscreen（浮层全屏）。同一族 —— 裸命令报状态、
// on/off 切、非法取值只报错且**不动状态**、TUI 里都当场派发（回合运行中也生效）。
//
// ⚠ 合成一个函数是**刻意的**：uya 0.10 的函数表是固定容量（`FUNCTION_TABLE_SIZE`，
// 写死在编译器里、没有开关），本仓合并到本轮之后只剩 2 个名额（声明 6748 通过 / 6749 就红）。
// 两个命令各占一个函数正好超容 —— make check / make build 从干净缓存起当场失败（踩坑 87）。
// which == 0 → /mouse；which == 1 → /fullscreen（参数偏移不同，解析骨架逐字相同）。
fn agent_cmd_display(line: &const Buf, which: i32) void {
    if which == 1 {
        if !tui_active() {
            tty_puts(&tty_ui, 2, "[fullscreen] 滚动模式没有浮层，不需要全屏；文本本来就可以拖选复制。\n");
            return;
        }
        // 参数：on / off / 空（裸命令 = 报当前状态）
        var want: i32 = -1;   // -1 报状态 / 0 关 / 1 开
        if line.len > 11 {
            var nm: Buf = buf_new(16);
            defer { buf_free(&nm); }
            const raw: &const byte = @ptr_from_usize(@usize_from_ptr(line.ptr as &const void) + 11) as &const byte;
            const rn: usize = line.len - 11;
            var s0: usize = 0;
            while s0 < rn && (raw[s0] == 32 as byte || raw[s0] == 9 as byte) {
                s0 = s0 + 1;
            }
            var e0: usize = rn;
            while e0 > s0 && (raw[e0 - 1] == 32 as byte || raw[e0 - 1] == 9 as byte) {
                e0 = e0 - 1;
            }
            _ = buf_append(&nm, &raw[s0], e0 - s0);
            if nm.len > 0 {
                if bufx_eq_cstr(nm.ptr as &const byte, nm.len, "on") {
                    want = 1;
                } else if bufx_eq_cstr(nm.ptr as &const byte, nm.len, "off") {
                    want = 0;
                } else {
                    var msg: Buf = buf_new(128);
                    defer { buf_free(&msg); }
                    _ = buf_append_cstr(&msg, "[fullscreen] 未知取值 \"");
                    _ = buf_append(&msg, nm.ptr as &const byte, nm.len);
                    _ = buf_append_cstr(&msg, "\"（可选：on / off；不带给当前状态）\n");
                    tui_add_notice(msg.ptr as &const byte, msg.len);
                    return;
                }
            }
        }
        if want < 0 {
            // 裸命令：报状态（不改）
            var cur: Buf = buf_new(256);
            defer { buf_free(&cur); }
            const has_ov: bool = tui_overlay_open();
            const on: bool = tui_overlay_full(-2);
            if on {
                _ = buf_append_cstr(&cur, "on（浮层占满转录区；/fullscreen off 或 ctrl+f / F11 关掉）\n");
            } else if has_ov {
                _ = buf_append_cstr(&cur, "off（浮层是居中框；/fullscreen on 或 ctrl+f / F11 放大到占满转录区）\n");
            } else {
                // 没浮层时 on/off 都是「下一张浮层」的事，所以报的是「现在没得全屏」
                _ = buf_append_cstr(&cur, "off（当前没有浮层 —— 先开一个，再 ctrl+f / F11 或 /fullscreen on）\n");
            }
            tui_add_notice(cur.ptr as &const byte, cur.len);
            return;
        }
        const on: bool = want == 1;
        if !tui_overlay_open() {
            // 没有浮层可切：说清楚「现在没有」，别静默什么都不发生
            const m: &const byte = "(浮层全屏：现在没有浮层 —— 先开一个（/status、/help、ctrl+p…），再按 ctrl+f / F11)" as &const byte;
            tui_add_notice(m, bufx_cstr_len(m));
            return;
        }
        if !tui_overlay_full(if on { 1 } else { 0 }) {
            // 同值：幂等，只报「已经是这个态」（与 /mouse 同一条口径）
            if on {
                const m: &const byte = "(浮层全屏：已经是开 —— 浮层占满转录区)" as &const byte;
                tui_add_notice(m, bufx_cstr_len(m));
            } else {
                const m: &const byte = "(浮层全屏：已经是关 —— 浮层是居中框)" as &const byte;
                tui_add_notice(m, bufx_cstr_len(m));
            }
            return;
        }
        if on {
            tui_add_notice("(浮层全屏：开 —— 占满转录区；/fullscreen off 或 ctrl+f / F11 关掉)" as &const byte,
                bufx_cstr_len("(浮层全屏：开 —— 占满转录区；/fullscreen off 或 ctrl+f / F11 关掉)" as &const byte));
        } else {
            tui_add_notice("(浮层全屏：关 —— 回到居中框；/fullscreen on 或 ctrl+f / F11 切回来)" as &const byte,
                bufx_cstr_len("(浮层全屏：关 —— 回到居中框；/fullscreen on 或 ctrl+f / F11 切回来)" as &const byte));
        }
        return;
    }
    // ---- which == 0：/mouse ----
    if !tui_active() {
        tty_puts(&tty_ui, 2, "[mouse] 滚动模式没开鼠标上报；文本可以直接拖选复制。\n");
        return;
    }
    // 参数：on / off / 空（裸命令 = 报当前状态，与 /permission 的裸命令同口径）
    var want: i32 = -1;   // -1 报状态 / 0 关 / 1 开
    if line.len > 6 {
        var nm: Buf = buf_new(16);
        defer { buf_free(&nm); }
        const raw: &const byte = @ptr_from_usize(@usize_from_ptr(line.ptr as &const void) + 6) as &const byte;
        const rn: usize = line.len - 6;
        var s0: usize = 0;
        while s0 < rn && (raw[s0] == 32 as byte || raw[s0] == 9 as byte) {
            s0 = s0 + 1;
        }
        var e0: usize = rn;
        while e0 > s0 && (raw[e0 - 1] == 32 as byte || raw[e0 - 1] == 9 as byte) {
            e0 = e0 - 1;
        }
        _ = buf_append(&nm, &raw[s0], e0 - s0);
        if nm.len > 0 {
            if bufx_eq_cstr(nm.ptr as &const byte, nm.len, "on") {
                want = 1;
            } else if bufx_eq_cstr(nm.ptr as &const byte, nm.len, "off") {
                want = 0;
            } else {
                var msg: Buf = buf_new(128);
                defer { buf_free(&msg); }
                _ = buf_append_cstr(&msg, "[mouse] 未知取值 \"");
                _ = buf_append(&msg, nm.ptr as &const byte, nm.len);
                _ = buf_append_cstr(&msg, "\"（可选：on / off；不带给当前状态）\n");
                tui_add_notice(msg.ptr as &const byte, msg.len);
                return;
            }
        }
    }
    if want < 0 {
        // 裸命令：报状态（不改）
        var cur: Buf = buf_new(256);
        defer { buf_free(&cur); }
        _ = buf_append_cstr(&cur, "[mouse] 鼠标上报：");
        if tui_mouse_enabled() {
            _ = buf_append_cstr(&cur, "on（滚轮能翻滚录；要拖选复制文本请 /mouse off 或按 F2，也可按住 shift 拖选）\n");
        } else {
            _ = buf_append_cstr(&cur, "off（可直接拖选复制文本；滚轮交给终端，翻滚录用 ctrl+↑/↓ 或 pgup/pgdn）\n");
        }
        tui_add_notice(cur.ptr as &const byte, cur.len);
        return;
    }
    const on: bool = want == 1;
    if on == tui_mouse_enabled() {
        // 幂等：值没变就只说一句，不重复往终端写序列
        if on {
            const m: &const byte = "(鼠标上报：已经是开 —— 滚轮翻转录；要选文本复制请 /mouse off 或按 F2)" as &const byte;
            tui_add_notice(m, bufx_cstr_len(m));
        } else {
            const m: &const byte = "(鼠标上报：已经是关 —— 可以直接拖选复制文本)" as &const byte;
            tui_add_notice(m, bufx_cstr_len(m));
        }
        return;
    }
    tui_set_mouse(on);
    if on {
        tui_add_notice("(鼠标上报：开 —— 滚轮翻转录；要选文本复制请 /mouse off 或按 F2)" as &const byte,
            bufx_cstr_len("(鼠标上报：开 —— 滚轮翻转录；要选文本复制请 /mouse off 或按 F2)" as &const byte));
    } else {
        tui_add_notice("(鼠标上报：关 —— 现在可以直接拖选复制文本；滚轮交给终端，翻滚录请用 ctrl+↑/↓ 或 pgup/pgdn)" as &const byte,
            bufx_cstr_len("(鼠标上报：关 —— 现在可以直接拖选复制文本；滚轮交给终端，翻滚录请用 ctrl+↑/↓ 或 pgup/pgdn)" as &const byte));
    }
}

// 把一坨图片字节挂成附件（`/image`、`ctrl+v`、`/paste` 三条路都汇到这里）。
// 顺序：嗅探 → `imgx_check(&info,0,0,&why)`（0 = 用缺省预算）→ 模型不吃图
// （`!cfg.input_image`）直接拒 → 超 8 张拒 → `imgx_store`（内容寻址落盘）→ push `g_pending_imgs`。
// 每一步失败都给**明确原因**（超了多少 / 为什么不吃图），不静默丢（§13.1）。
fn agent_image_attach_bytes(cfg: &const Config, raw: &const Buf, name: &const byte, nl: usize, from_clip: bool, vision: bool) bool {
    if raw.len == 0 {
        return false;
    }
    var info: ImgInfo = ImgInfo{ kind: IMGX_NONE, width: 0, height: 0, bytes: 0 };
    if !imgx_sniff(raw.ptr as &const byte, raw.len, &info) {
        agent_attach_notice("这不是认识的图片格式（只认 PNG / JPEG / GIF / WebP）" as &const byte,
            bufx_cstr_len("这不是认识的图片格式（只认 PNG / JPEG / GIF / WebP）" as &const byte));
        return false;
    }
    var why: Buf = buf_new(256);
    defer { buf_free(&why); }
    const verdict: i32 = imgx_check(&info, 0, 0, &why);
    if verdict != IMGX_OK {
        var m: Buf = buf_new(why.len + 64);
        defer { buf_free(&m); }
        _ = buf_append_cstr(&m, "图片没收下：");
        _ = buf_append(&m, why.ptr as &const byte, why.len);
        _ = buf_append_cstr(&m, " —— 纯 Uya 没有图片编码器，缩不小，请自己压一下再来");
        agent_attach_notice(m.ptr as &const byte, m.len);
        return false;
    }
    // 不吃图的模型上直接拒：收下来只会让请求 400（见 cfg.input_image）
    if !vision {
        var m: Buf = buf_new(160);
        defer { buf_free(&m); }
        _ = buf_append_cstr(&m, "当前模型不吃图（input 不含 image），这张没收下：");
        _ = buf_append(&m, imgx_mime(info.kind), bufx_cstr_len(imgx_mime(info.kind)));
        agent_attach_notice(m.ptr as &const byte, m.len);
        return false;
    }
    agent_imgs_ensure();
    if g_pending_imgs.len >= IMGX_MAX_PER_MSG {
        var m: Buf = buf_new(96);
        defer { buf_free(&m); }
        _ = buf_append_cstr(&m, "一条消息最多挂 ");
        _ = buf_append_u64(&m, IMGX_MAX_PER_MSG as u64);
        _ = buf_append_cstr(&m, " 张图");
        agent_attach_notice(m.ptr as &const byte, m.len);
        return false;
    }
    // 落盘（内容寻址）
    var dir: Buf = buf_new(cfg.agent_home.len + 32);
    defer { buf_free(&dir); }
    agent_attach_dir(cfg, &dir);
    var stored: Buf = buf_new(dir.len + 96);
    defer { buf_free(&stored); }
    var id: Buf = buf_new(80);
    defer { buf_free(&id); }
    if imgx_store(dir.ptr as &const byte, dir.len, raw.ptr as &const byte, raw.len, info.kind, &stored, &id) != IMGX_OK {
        agent_attach_notice("图片落盘失败（agent home 写不进去？）" as &const byte,
            bufx_cstr_len("图片落盘失败（agent home 写不进去？）" as &const byte));
        return false;
    }
    var r: ImgRef = ImgRef{
        kind: info.kind, width: info.width, height: info.height, bytes: raw.len,
        path: stored, name: buf_empty(),
    };
    // 展示名由调用方给（文件来源是文件名、剪贴板来源是空）
    var nm: Buf = buf_new(nl + 8);
    defer { buf_free(&nm); }
    _ = buf_append(&nm, name, nl);
    r.name = nm;
    if !imgx_list_push(&g_pending_imgs, &r) {
        agent_attach_notice("图片没能挂上下一条消息（列表已满）" as &const byte,
            bufx_cstr_len("图片没能挂上下一条消息（列表已满）" as &const byte));
        return false;
    }
    // 占位行上屏：终端不渲染图片，这一行就是「挂上了」的全部证据
    var lbl: Buf = buf_new(256);
    defer { buf_free(&lbl); }
    imgx_label(&r, &lbl);
    var msg: Buf = buf_new(lbl.len + 96);
    defer { buf_free(&msg); }
    if from_clip {
        _ = buf_append_cstr(&msg, "已从剪贴板挂上：");
    } else {
        _ = buf_append_cstr(&msg, "已挂上：");
    }
    _ = buf_append(&msg, lbl.ptr as &const byte, lbl.len);
    _ = buf_append_cstr(&msg, "（随下一条消息发出）");
    agent_attach_notice(msg.ptr as &const byte, msg.len);
    return true;
}

// /image 那条路：读文件 → 交给同一个挂图逻辑
fn agent_image_attach(cfg: &const Config, path: &const byte, pn: usize, from_clip: bool, vision: bool) bool {
    var raw: Buf = buf_new(1 << 16);
    defer { buf_free(&raw); }
    if !imgx_load(path, pn, &raw) || raw.len == 0 {
        var m: Buf = buf_new(pn + 64);
        defer { buf_free(&m); }
        _ = buf_append_cstr(&m, "读不到图片文件：");
        _ = buf_append(&m, path, pn);
        agent_attach_notice(m.ptr as &const byte, m.len);
        return false;
    }
    var nm: Buf = buf_new(128);
    defer { buf_free(&nm); }
    agent_basename_into(path, pn, &nm);
    return agent_image_attach_bytes(cfg, &raw, nm.ptr as &const byte, nm.len, from_clip, vision);
}

// ============================================================
// P52：贴剪贴板（ctrl+v / /paste）
//
// 分流：先问 clipx（纯 Uya 的 X11 客户端，读一次快照）。
//   * 图片 → 走 P51 的附件管线（落盘 + 挂到下一条消息）；
//   * 文本 → 直接插进输入行（**不**提交，用户可以接着编辑）；
//   * 读不到 → 明确说一句（没有 X11 / 剪贴板空），绝不静默。
//
// 为什么不做常驻监听：剪贴板是「用户按一下才看」的东西，常驻只会白占一个 X 连接
// 与一次轮询；而且一次性读取失败的回执更干净（用户知道为什么没贴上）。
// ============================================================
fn agent_clip_paste(cfg: &const Config) void {
    var data: Buf = buf_new(1 << 16);
    defer { buf_free(&data); }
    var mime: Buf = buf_new(32);
    defer { buf_free(&mime); }
    const code: i32 = clipx_paste(&data, &mime);
    if code == CLIPX_IMAGE {
        const ok: bool = agent_image_attach_bytes(cfg, &data, "" as &const byte, 0, true, cfg.input_image);
        _ = ok;
        return;
    }
    if code == CLIPX_TEXT {
        // 文本：插进输入行（走 tui_input_text 那条缓冲，光标跟到末尾）
        if tui_active() {
            var cur: Buf = buf_new(tui_input_len() + data.len + 8);
            defer { buf_free(&cur); }
            _ = buf_append(&cur, tui_input_text().ptr as &const byte, tui_input_len());
            _ = buf_append(&cur, data.ptr as &const byte, data.len);
            tui_input_set(cur.ptr as &const byte, cur.len);
            tui_mark_dirty();
            var m: Buf = buf_new(96);
            defer { buf_free(&m); }
            _ = buf_append_cstr(&m, "已粘贴剪贴板文本（");
            _ = buf_append_u64(&m, data.len as u64);
            _ = buf_append_cstr(&m, " 字节），回车发送");
            tui_add_notice(m.ptr as &const byte, m.len);
        } else {
            // 滚动模式：直接把文本打到提示符后面（与用户自己敲的效果一致）
            tty_write(&tty_ui, 2, data.ptr as &const byte, data.len);
        }
        return;
    }
    // CLIPX_NONE / NO_X11 / ERR：给一句人话
    var m: Buf = buf_new(256);
    defer { buf_free(&m); }
    _ = buf_append_cstr(&m, "粘贴失败：");
    _ = buf_append_cstr(&m, clipx_reason(code));
    agent_attach_notice(m.ptr as &const byte, m.len);
}

// basename（末段路径），给附件展示名用
fn agent_basename_into(path: &const byte, n: usize, out: &Buf) void {
    buf_reset(out);
    var s: usize = 0;
    var i: usize = 0;
    while i < n {
        if path[i] == 47 as byte {
            s = i + 1;
        }
        i = i + 1;
    }
    if s < n {
        _ = buf_append(out, path + s, n - s);
    }
}

// 附件相关提示：TUI 走 notice（转录里一行），滚动模式直接打一行
fn agent_attach_notice(p: &const byte, n: usize) void {
    if tui_active() {
        tui_add_notice(p, n);
        tui_mark_dirty();
        return;
    }
    tty_puts(&tty_ui, 2, "[image] ");
    tty_write(&tty_ui, 2, p, n);
    tty_puts(&tty_ui, 2, "\n");
}

// /image [路径]：裸命令报当前挂了什么；带路径则挂一张
fn agent_cmd_image(cfg: &const Config, line: &const Buf) void {
    agent_imgs_ensure();
    var arg: Buf = buf_new(1024);
    defer { buf_free(&arg); }
    if line.len > 6 {
        const raw: &const byte = @ptr_from_usize(@usize_from_ptr(line.ptr as &const void) + 6) as &const byte;
        const rn: usize = line.len - 6;
        var s0: usize = 0;
        while s0 < rn && (raw[s0] == 32 as byte || raw[s0] == 9 as byte) {
            s0 = s0 + 1;
        }
        var e0: usize = rn;
        while e0 > s0 && (raw[e0 - 1] == 32 as byte || raw[e0 - 1] == 9 as byte) {
            e0 = e0 - 1;
        }
        _ = buf_append(&arg, &raw[s0], e0 - s0);
    }
    if arg.len == 0 {
        // 裸命令：报状态（挂了几张 / 这个模型吃不吃图 / 怎么用）
        var m: Buf = buf_new(512);
        defer { buf_free(&m); }
        _ = buf_append_cstr(&m, "[image] 待发图片 ");
        _ = buf_append_u64(&m, g_pending_imgs.len as u64);
        _ = buf_append_cstr(&m, " 张");
        if !cfg.input_image {
            _ = buf_append_cstr(&m, "；当前模型不吃图（");
            _ = buf_append(&m, cfg.model.ptr as &const byte, cfg.model.len);
            _ = buf_append_cstr(&m, " 的 input 不含 image），挂了也会被拒");
        }
        _ = buf_append_cstr(&m, "\n用法：/image <图片路径>（PNG / JPEG / GIF / WebP）");
        agent_attach_notice(m.ptr as &const byte, m.len);
        return;
    }
    // 相对路径按**当前工作区**解析（与文件工具同一口径）
    var full: Buf = buf_new(1200);
    defer { buf_free(&full); }
    if arg.ptr[0] == 47 as byte {
        _ = buf_append(&full, arg.ptr as &const byte, arg.len);
    } else {
        _ = buf_append(&full, cfg.workspace.ptr as &const byte, cfg.workspace.len);
        _ = buf_append_byte(&full, 47);
        _ = buf_append(&full, arg.ptr as &const byte, arg.len);
    }
    _ = agent_image_attach(cfg, full.ptr as &const byte, full.len, false, cfg.input_image);
}


// /tasks <open|close|toggle>：只动常驻块的展开态（TUI 的 ctrl+t 走同一个函数）
fn agent_tasks_set_cmd(cfg: &const Config, arg: &const byte, alen: usize) void {
    var nm: Buf = buf_new(32);
    defer { buf_free(&nm); }
    var s0: usize = 0;
    while s0 < alen && (arg[s0] == 32 as byte || arg[s0] == 9 as byte) {
        s0 = s0 + 1;
    }
    var e0: usize = alen;
    while e0 > s0 && (arg[e0 - 1] == 32 as byte || arg[e0 - 1] == 9 as byte) {
        e0 = e0 - 1;
    }
    _ = buf_append(&nm, @ptr_from_usize(@usize_from_ptr(arg as &const void) + s0) as &const byte, e0 - s0);
    var on: bool = false;
    if bufx_eq_cstr(nm.ptr as &const byte, nm.len, "open" as &const byte)
        || bufx_eq_cstr(nm.ptr as &const byte, nm.len, "expand" as &const byte) {
        on = true;
    } else if bufx_eq_cstr(nm.ptr as &const byte, nm.len, "close" as &const byte)
        || bufx_eq_cstr(nm.ptr as &const byte, nm.len, "collapse" as &const byte) {
        on = false;
    } else if bufx_eq_cstr(nm.ptr as &const byte, nm.len, "toggle" as &const byte) {
        on = !tasks_expanded();
    } else {
        tty_puts(&tty_ui, 2, "未知参数 \"");
        tty_write(&tty_ui, 2, nm.ptr as &const byte, nm.len);
        tty_puts(&tty_ui, 2, "\"（可选：open / close / toggle）\n");
        return;
    }
    tasks_expand_set(on);
    agent_tasks_refresh(cfg);
    _ = tasks_panel_sync();
    tty_puts(&tty_ui, 2, "[tasks] 常驻块：");
    if (on) {
        tty_puts(&tty_ui, 2, "展开（ctrl+t 同效）\n");
    } else {
        tty_puts(&tty_ui, 2, "收起\n");
    }
}

// 返回 true = 该退出 REPL
fn agent_repl_command(cfg: &Config, h: &History, line: &const Buf) bool {
    if sv_eq_cstr(line, "/exit") || sv_eq_cstr(line, "/quit") {
        return true;
    }
    if sv_eq_cstr(line, "/help") {
        agent_repl_help();
        return false;
    }
    if sv_eq_cstr(line, "/status") {
        agent_repl_status(cfg, h);
        return false;
    }
    if sv_eq_cstr(line, "/tasks") {
        agent_repl_tasks(cfg);
        return false;
    }
    if arg_starts_with(line.ptr as &const byte, "/tasks ") {
        // 参数从 "/tasks " 之后开始（`&line.ptr[7]` 不是左值，只能走指针算术）
        const ap: &const byte = @ptr_from_usize(@usize_from_ptr(line.ptr as &const void) + 7) as &const byte;
        agent_tasks_set_cmd(cfg, ap, line.len - 7);
        return false;
    }
    // P42：/watch —— 滚动模式下跟随的行**追加进转录**（append-only，等同 tail -f）
    if sv_eq_cstr(line, "/watch") || arg_starts_with(line.ptr as &const byte, "/watch ") {
        var wout: Buf = buf_new(4096);
        defer { buf_free(&wout); }
        const an: usize = if (line.len > 6) { line.len - 6 } else { 0 as usize };
        const ap: &const byte = @ptr_from_usize(@usize_from_ptr(line.ptr as &const void) + 6) as &const byte;
        // P46：三种落点的回执都打进转录（裸 /watch 的清单、跟随回执、失败原因、已停止）——
        // 滚动模式没有浮层，回执就是唯一的反馈。
        _ = agent_cmd_watch(cfg, ap, an, &wout);
        if wout.len > 0 {
            tty_write(&tty_ui, 2, wout.ptr as &const byte, wout.len);
        }
        return false;
    }
    // P29：/goal —— 语法与措辞对齐 DSH 的 /goal（见 src/goal.uya 顶部注释）
    if sv_eq_cstr(line, "/goal") || arg_starts_with(line.ptr as &const byte, "/goal ") {
        agent_repl_goal(cfg, line);
        return false;
    }
    // P46：/title —— 滚动模式没有输入框浮层，所以裸 /title 只把模型建议打出来，
    // **不改标题**（改不改由人接着敲 `/title <新标题>` 决定）
    if sv_eq_cstr(line, "/title") || arg_starts_with(line.ptr as &const byte, "/title ") {
        var tout: Buf = buf_new(1024);
        defer { buf_free(&tout); }
        var suggest: Buf = buf_new(TTY_TITLE_FALLBACK_BYTES + 16);
        defer { buf_free(&suggest); }
        _ = agent_title_cmd(cfg, h, line, &tout, &suggest);
        tty_write(&tty_ui, 2, tout.ptr as &const byte, tout.len);
        return false;
    }
    if sv_eq_cstr(line, "/continue") {
        var cont: Buf = buf_new(16);
        defer { buf_free(&cont); }
        _ = buf_append_cstr(&cont, "继续");
        var pushed: bool = hist_push(h, ROLE_USER, cont.ptr as &const byte, cont.len);
        while !pushed {
            if !hist_drop_oldest(h) {
                break;
            }
            pushed = hist_push(h, ROLE_USER, cont.ptr as &const byte, cont.len);
        }
        const rc: i32 = agent_turn_loop(cfg, h);
        if rc != AGENT_OK && rc != AGENT_INTERRUPTED && rc != AGENT_MAX_TOKENS {
            tty_puts(&tty_ui, 2, "[turn] 本回合异常结束（可直接输入继续）\n");
        }
        return false;
    }
    if sv_eq_cstr(line, "/compact") {
        const did: bool = agent_maybe_compact(cfg, h, 0, true);
        if did {
            tty_puts(&tty_ui, 2, "[compact] 完成\n");
        } else {
            tty_puts(&tty_ui, 2, "[compact] 没有可压缩的内容（或摘要请求失败）\n");
        }
        // 压缩换掉的是历史（表层）→ 上下文占用要立刻跟着降，不必等下一轮请求
        agent_stats_sync(cfg, h);
        return false;
    }
    if sv_eq_cstr(line, "/permission") || arg_starts_with(line.ptr as &const byte, "/permission ") {
        // P21：对齐 DSH —— 裸 /permission 报当前值与可选值，/permission <preset> 直接切（不过闸门）
        if line.len > 12 {
            var nm: Buf = buf_new(64);
            defer { buf_free(&nm); }
            const raw: &const byte = @ptr_from_usize(@usize_from_ptr(line.ptr as &const void) + 12) as &const byte;
            const rn: usize = line.len - 12;
            // 去掉前后的空白
            var s0: usize = 0;
            while s0 < rn && (raw[s0] == 32 as byte || raw[s0] == 9 as byte) {
                s0 = s0 + 1;
            }
            var e0: usize = rn;
            while e0 > s0 && (raw[e0 - 1] == 32 as byte || raw[e0 - 1] == 9 as byte) {
                e0 = e0 - 1;
            }
            _ = buf_append(&nm, &raw[s0], e0 - s0);
            if nm.len > 0 {
                const m: i32 = perm_from_name(nm.ptr as &const byte, nm.len);
                if m < 0 {
                    tty_puts(&tty_ui, 2, "未知预设 \"");
                    tty_write(&tty_ui, 2, nm.ptr as &const byte, nm.len);
                    tty_puts(&tty_ui, 2, "\"（可选：read-only / workspace-write / danger-full-access）\n");
                    return false;
                }
                agent_set_access(cfg, h, m as u8, false);
                tty_puts(&tty_ui, 2, "[permission] ");
                tty_puts(&tty_ui, 2, perm_label(m as u8));
                tty_puts(&tty_ui, 2, "\n");
                return false;
            }
            // 只有空白 → 当裸命令走（下面那两路）
        }
        if cfg.tui && tui_active() {
            agent_tui_access_open();
            return false;
        }
        tty_puts(&tty_ui, 2, "当前访问模式：");
        tty_puts(&tty_ui, 2, perm_label(perm_get()));
        tty_puts(&tty_ui, 2, "（");
        tty_puts(&tty_ui, 2, perm_name(perm_get()));
        tty_puts(&tty_ui, 2, "）；可选：read-only / workspace-write / danger-full-access\n");
        return false;
    }
    if sv_eq_cstr(line, "/plan") {
        // P26：切模式 = 改状态 + 给模型推一份新快照（顺便同步 TUI 的 Plan chip）
        agent_plan_apply(cfg, h, !g_plan.active);
        if g_plan.active {
            tty_puts(&tty_ui, 2, "Plan mode on. Use /plan to leave.\n");
        } else {
            tty_puts(&tty_ui, 2, "Plan mode off.\n");
        }
        return false;
    }
    // 踩坑 72：/mouse [on|off] —— 开/关鼠标上报（「不能复制文本」的开关）。
    // 滚动模式（--no-tui）本来就没开鼠标上报，所以那里只回一行说明。
    if sv_eq_cstr(line, "/mouse") || arg_starts_with(line.ptr as &const byte, "/mouse ") {
        agent_cmd_display(line, 0);
        return false;
    }
    // P53：/fullscreen [on|off] —— 浮层全屏。滚动模式没有浮层，只回一行说明。
    if sv_eq_cstr(line, "/fullscreen") || arg_starts_with(line.ptr as &const byte, "/fullscreen ") {
        agent_cmd_display(line, 1);
        return false;
    }
    // P51：/image [路径] —— 挂一张图到下一条消息（零依赖通道，不碰剪贴板）
    if sv_eq_cstr(line, "/image") || arg_starts_with(line.ptr as &const byte, "/image ") {
        agent_cmd_image(cfg, line);
        return false;
    }
    // P52：/paste —— 贴剪贴板（与 ctrl+v 同一个函数；图挂附件、文本插输入行）
    if sv_eq_cstr(line, "/paste") {
        agent_clip_paste(cfg);
        return false;
    }
    if sv_eq_cstr(line, "/diff") {
        agent_diff_print(cfg);
        return false;
    }
    // P34：/workspace [dir] —— 看当前会话的工作区 / 切过去（人自己敲的就是批准）
    if sv_eq_cstr(line, "/workspace") || (line.len > 11 && bufx_eq_cstr(line.ptr as &const byte, 11, "/workspace ")) {
        agent_repl_workspace(cfg, line);
        return false;
    }
    // P37：/model [name] 与 /effort [level]（滚动模式文本入口；TUI 里是浮层，见 agent_tui_command）
    // "/model " = 7 字节、"/effort " = 8 字节 —— bufx_eq_cstr 的第二个参数是**字节数**，
    // 且要和字面量长度相等才会走（写少了永远不会命中，见上面那条踩坑）。
    if sv_eq_cstr(line, "/model") || (line.len > 7 && bufx_eq_cstr(line.ptr as &const byte, 7, "/model ")) {
        agent_repl_model(cfg, line, false);
        return false;
    }
    // P37：/effort [level]
    if sv_eq_cstr(line, "/effort") || (line.len > 8 && bufx_eq_cstr(line.ptr as &const byte, 8, "/effort ")) {
        agent_repl_model(cfg, line, true);
        return false;
    }
    // P37：/worktree [on|off|start|status|finish|discard|list|reclaim]
    // "/worktree " = 10 字节（又是那个「第二个参数是字节数」的坑，见上面那条注释）
    if sv_eq_cstr(line, "/worktree") || (line.len > 10 && bufx_eq_cstr(line.ptr as &const byte, 10, "/worktree ")) {
        agent_repl_worktree(cfg, line);
        return false;
    }
    if sv_eq_cstr(line, "/sessions") {
        _ = agent_list_sessions(cfg);
        return false;
    }
    if sv_eq_cstr(line, "/new") {
        agent_session_close();
        hist_free(h);
        h[0] = hist_init();
        g_turn = 0;
        buf_free(&cfg.resume_id);
        cfg.resume_id = buf_empty();
        var none_first: Buf = buf_empty();
        if agent_history_begin(cfg, h, &none_first) {
            // P39：先把旧会话的正文清掉，再打这一行 —— 否则刚写的回执又会被清走
            agent_tui_session_switched(h, false);   // 清转录；新会话没有正文可回放
            tty_puts(&tty_ui, 2, "[session] 已开新会话\n");
            agent_stats_sync(cfg, h);
            agent_title_apply();   // P22：新会话没有标题 → 回到基标题
            // 清单在 agent_history_begin 里已经清了（会话级状态）：常驻块是「推」出来的，
            // 当场重推一次，否则要等到下一个 1Hz 心跳（滚动模式更是要等下一回合）
            _ = tasks_panel_sync();
        } else {
            tty_puts(&tty_ui, 2, "error: 无法新建会话\n");
        }
        return false;
    }
    if line.len > 8 && bufx_eq_cstr(line.ptr as &const byte, 8, "/resume ") {
        var id: Buf = buf_new(line.len + 1);
        defer { buf_free(&id); }
        _ = buf_append(&id, &line.ptr[8], line.len - 8);
        _ = buf_append_byte(&id, 0);
        if !agent_resolve_resume(cfg, id.ptr as &const byte) {
            tty_puts(&tty_ui, 2, "error: 找不到该会话（/sessions 看列表）\n");
            return false;
        }
        agent_session_close();
        hist_free(h);
        h[0] = hist_init();
        g_turn = 0;
        var none_first2: Buf = buf_empty();
        if agent_history_begin(cfg, h, &none_first2) {
            // P39：清掉旧会话的正文，再把恢复出来的历史**回放**一遍（与启动时 --resume 的
            // 观感一致 —— 那时走的就是 agent_tui_seed_history 那条路），最后才打回执
            agent_tui_session_switched(h, true);
            tty_puts(&tty_ui, 2, "[session] 已恢复会话\n");
            agent_stats_sync(cfg, h);
            agent_title_apply();   // P22：换成被恢复会话的标题（日志里的 session/title）
            // 清单是会话级状态（agent_history_begin 里清过，恢复也不回填）→ 常驻块重推
            _ = tasks_panel_sync();
        } else {
            tty_puts(&tty_ui, 2, "error: 无法恢复会话\n");
        }
        return false;
    }
    tty_puts(&tty_ui, 2, "未知命令（/help 看可用命令）；已忽略\n");
    return false;
}

// 阻塞读一行（raw 模式）。返回 TTY_EV_SUBMIT / TTY_EV_EOF / TTY_EV_CTRL_C
//
// P46：自动起标题的待办也要在这一层消费 —— 滚动模式下这个 read 会一直阻塞到用户按键，
// 而「回合收尾挂待办、空闲时发请求」的分工要求有人主动去 poll。它拿不到 cfg/h
// （那是调用方的局部量），所以走一份进程级登记（与 /watch 的 agent_watch_hold_cfg 同一手法）。
var g_title_auto_cfg: &const Config = null as &const Config;
var g_title_auto_hist: &const History = null as &const History;

// 登记「有自动起标题的请求在飞」—— 流式期间**一个字节的键都不许读**（§4.7）。
// 用户那几秒敲的字必须原样留给主循环，否则会被拼成 `//status` 这种怪东西。
export fn agent_title_auto_hold(cfg: &const Config, h: &const History) void {
    g_title_auto_cfg = cfg;
    g_title_auto_hist = h;
}

// 上一行登记的请求回来后，用**当时那份 cfg/h** 继续推进自动起标题（`_held` 版）。
fn agent_title_auto_pending_tick_held() void {
    if (!g_title_auto_pending) {
        return;
    }
    if g_title_auto_cfg == null as &const Config || g_title_auto_hist == null as &const History {
        return;
    }
    agent_title_auto_pending_tick(g_title_auto_cfg, g_title_auto_hist);
}

// 非 TUI 的**阻塞**读一行（返回码给调用方区分 提交 / 中断 / EOF）。
// 与 TUI 的按键路径不同：这里没有每帧 tick，所以是「阻塞等回车」。
fn tty_read_line_blocking() i32 {
    while true {
        // 顺序很重要：**先取已排队的事件**（事件对应的行内容此刻才在 line 里），
        // 队列空了才处理 pend（粘贴的后续行），最后才去读键盘。
        const ev: i32 = tty_next_event(&tty_ui);
        if ev != TTY_EV_NONE {
            if ev == TTY_EV_SUBMIT || ev == TTY_EV_EOF || ev == TTY_EV_CTRL_C {
                // 提交/退出时把输入行从屏幕上抹掉，正文由调用方回显
                tty_out_begin(&tty_ui, 2);
                return ev;
            }
            if ev == TTY_EV_CLEARED || ev == TTY_EV_REDRAW {
                tty_draw_line(&tty_ui, 2);
            }
            continue;
        }
        if tty_has_pending(&tty_ui) {
            // n == 0 时不会解引用 p，传 null 比传空切片更诚实（切片不是指针）
            tty_feed(&tty_ui, null as &const byte, 0);
            tty_flush_esc(&tty_ui);
            continue;
        }
        var tmp: [byte: 256] = [0: 256];
        // P42：跟随子代理时别死等键盘 —— 先带超时 poll 一下 fd 0，超时就推一拍 watch。
        // 不做这一步的话，滚动模式下「看着它跑」的那段时间屏幕是死的（read 会一直阻塞，
        // 泵点和心跳都轮不到）。
        // P46：自动起标题的待办同理 —— 这一轮先 poll 再决定要不要发那个请求，
        // 否则 read 会一直阻塞到用户按键为止（标题永远起不出来）。
        if g_watch.active || g_title_auto_pending {
            var pfd: [PollFd: 1] = [PollFd{ fd: 0, events: POLLIN, revents: 0 }];
            const pr: i32 = sys_poll(&pfd[0], 1, 200) catch { 0; };
            if pr <= 0 {
                _ = agent_watch_tick_if_active();
                agent_title_auto_pending_tick_held();
                continue;
            }
        }
        // P1：装了信号处理器以后 read 会被打断（SIGWINCH 等）返回 EINTR —— 那是「重来一次」，
        // 不是 EOF。把 EINTR 当 EOF 会让一次终端缩放直接把 REPL 关掉。
        const rr: !isize = sys_read(0, &tmp[0], 256);
        var eid: i32 = 0;
        const n: isize = rr catch |err| {
            eid = (@error_id(err) as! i32).value;
            -1 as isize;
        };
        if n < 0 && eid == 4 {
            continue;
        }
        if n <= 0 {
            tty_out_begin(&tty_ui, 2);
            return TTY_EV_EOF;
        }
        tty_feed(&tty_ui, &tmp[0], n as usize);
        tty_flush_esc(&tty_ui);
        tty_draw_line(&tty_ui, 2);
    }
}

// 行式 REPL（stdin 不是 TTY：管道/重定向）。同一份 history 连续对话。
fn agent_repl_plain(cfg: &Config) i32 {
    var h: History = hist_init();
    defer { hist_free(&h); }
    defer { agent_session_close(); }
    var no_first: Buf = buf_empty();
    if !agent_history_begin(cfg, &h, &no_first) {
        out_err("error: cannot build history\n");
        return AGENT_PROTO;
    }
    var inbuf: Buf = buf_new(8192);
    defer { buf_free(&inbuf); }
    var line: Buf = buf_new(4096);
    defer { buf_free(&line); }
    if !buf_valid(&inbuf) || !buf_valid(&line) {
        out_err("error: out of memory\n");
        return AGENT_PROTO;
    }
    out_err("uya-agent REPL（stdin 不是终端：行式输入）— 空行/exit/Ctrl-D 退出\n");
    var rc: i32 = AGENT_OK;
    while true {
        out_err("> ");
        const n: isize = read_line(&inbuf, &line);
        if n <= 0 {
            out_err("\n");
            break;
        }
        if line.len == 0 {
            continue;
        }
        if line.len == 4 && line.ptr[0] == 101 as byte && line.ptr[1] == 120 as byte && line.ptr[2] == 105 as byte && line.ptr[3] == 116 as byte {
            break;
        }
        // P21：行式（管道/CI）也认 slash 命令 —— 访问模式在脚本里同样要能查、能切
        if line.ptr[0] == 47 as byte {
            const stop_p: bool = agent_repl_command(cfg, &h, &line);
            if stop_p {
                break;
            }
            continue;
        }
        var att: Buf = buf_new(1024);
        defer { buf_free(&att); }
        var have_att: bool = false;
        const pushed: bool = agent_push_user_with_imgs(&h, &line, &att, &have_att);
        _ = pushed;
        if !pushed {
            out_err("error: 无法把任务写入历史\n");
            continue;
        }
        agent_log_user_att(line.ptr as &const byte, line.len, false, &att, &have_att);
        rc = agent_turn_loop(cfg, &h);
        // P59：截断（AGENT_MAX_TOKENS）不算异常 —— 上面已经用 `warning:` + `[max-tokens] …`
        // 说清「怎么回事 + 发「继续」接着做」，再报一句「异常结束」只会让人以为出事了。
        if rc != AGENT_OK && rc != AGENT_MAX_TOKENS {
            out_err("[turn] 本回合异常结束（可继续输入）\n");
            rc = AGENT_OK;
        }
    }
    return rc;
}

// 交互入口：TTY 走 raw 模式行编辑器，否则退回行式 REPL
fn agent_run_interactive(cfg: &Config) i32 {
    if cfg.api_key.len == 0 {
        out_err("error: no API key. set UYA_AGENT_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY\n");
        return AGENT_USAGE;
    }
    tty_init(&tty_ui, 0);
    if !tty_ui.is_tty {
        return agent_repl_plain(cfg);
    }
    // P1：装信号处理器。**必须在 tty_raw_on 之前** —— 处理器要拿到原始终端属性才还原得回去。
    // 装好之后被 SIGTERM/SIGINT/SIGHUP/SIGPIPE 打断，会先把终端还回去再以 128+sig 退出。
    if !sigx_install_terminal(0) {
        tty_puts(&tty_ui, 2, "warning: 信号处理器安装失败（被打断时终端可能停在 raw 模式）\n");
    }
    _ = sigx_install_winch();
    // 滚动模式：显示通道是 fd 2，没有备用屏幕；P22 的终端标题也要跟着弹栈
    sigx_arm(2, false, agent_title_enabled(cfg));
    if !tty_raw_on(&tty_ui, 0) {
        tty_puts(&tty_ui, 2, "warning: 无法进入 raw 模式（termios 设置失败），退回行式 REPL\n");
        sigx_disarm();
        return agent_repl_plain(cfg);
    }
    g_interactive = true;
    // P22：从这一刻起终端标题跟随会话标题（--no-title 时这条通道根本不开）
    agent_title_begin(cfg, 2);
    tty_set_block_provider(&tty_ui, true);   // P15：输入行上方允许画子代理面板
    inbox_globals_init();

    var h: History = hist_init();
    var rc: i32 = AGENT_OK;
    var no_first: Buf = buf_empty();
    if !agent_history_begin(cfg, &h, &no_first) {
        out_err("error: cannot build history\n");
        tty_title_end();
        tty_raw_off(&tty_ui, 0);
        sigx_disarm();
        tty_free(&tty_ui);
        return AGENT_PROTO;    }
    // P22：历史回填完（--continue / --resume 的 session/title 已经进 g_sess.title）再同步一次，
    // 否则起始标题会一直停在基标题上，直到用户打出第一条消息才换过来
    agent_title_apply();
    agent_repl_banner(cfg);
    // P22：任务块（清单/后台任务/子代理/目标）—— 启动先读一次 goal.json，再把面板刷出来
    tasks_init();
    tasks_goal_reload(cfg);
    agent_agents_tick_force();
    // P46：把 cfg/h 登记给 tty_read_line_blocking 那一层（它在阻塞读里要消费
    // 自动起标题的待办，拿不到这里的局部量）
    agent_title_auto_hold(cfg, &h);

    var line: Buf = buf_new(8192);
    var run: bool = true;
    var ctrl_c_armed: bool = false;
    while run {
        // 1) 先取已经排队的输入（回合运行期间敲进来的），否则等提示符输入
        var have: bool = inbox_pop(&g_steer, &line);
        if have && line.len > 0 && line.ptr[0] == 47 as byte {
            // 运行中输入的 slash 命令也按命令走：用户并不知道回合是否已经结束
            tty_puts(&tty_ui, 2, "> ");
            tty_write(&tty_ui, 2, line.ptr as &const byte, line.len);
            tty_puts(&tty_ui, 2, "\n");
            const stop_c: bool = agent_repl_command(cfg, &h, &line);
            if stop_c {
                run = false;
            }
            continue;
        }
        if !have {
            // P58：进阻塞读之前先问一次「要不要续跑」。滚动模式这里没有 TUI 那种「fd 0 上还有
            // 待读字节吗」的探测，所以顺序反过来 —— 先驱动一轮，用户敲的字留给紧接着的
            // read（驱动那一轮期间敲进来的会进 steer 收件箱，与回合运行中同一条路）。
            // 驱动过一轮就回顶部（不在这儿等输入），下一圈再问 —— 用户总有插话的机会。
            if agent_goal_drive(cfg, &h) {
                continue;
            }
            tty_line_clear(&tty_ui);
            tty_set_prompt(&tty_ui, "> ");
            tty_draw_line(&tty_ui, 2);
            const ev: i32 = tty_read_line_blocking();
            if ev == TTY_EV_EOF {
                run = false;
                break;
            }
            if ev == TTY_EV_CTRL_C {
                if tty_line_len(&tty_ui) > 0 {
                    tty_line_clear(&tty_ui);
                    tty_puts(&tty_ui, 2, "\n");
                    ctrl_c_armed = false;
                    continue;
                }
                if ctrl_c_armed {
                    run = false;
                    break;
                }
                ctrl_c_armed = true;
                tty_puts(&tty_ui, 2, "\n(再按一次 Ctrl-C 退出；或直接输入任务)\n");
                continue;
            }
            ctrl_c_armed = false;
            const n: usize = tty_line_len(&tty_ui);
            if n == 0 {
                continue;
            }
            buf_reset(&line);
            _ = buf_append(&line, tty_ui.line.ptr, n);
            // 立刻清空编辑器行：回合期间用户再敲的字属于**下一行**（也就是 steer），
            // 否则会在同一缓冲里和刚提交的内容粘在一起。
            tty_line_clear(&tty_ui);
            // 回显到正文
            tty_puts(&tty_ui, 2, "> ");
            tty_write(&tty_ui, 2, line.ptr as &const byte, line.len);
            tty_puts(&tty_ui, 2, "\n");
            if line.ptr[0] == 47 as byte {
                const stop: bool = agent_repl_command(cfg, &h, &line);
                if stop {
                    run = false;
                }
                tty_line_clear(&tty_ui);
                continue;
            }
            have = true;
        }
        if !have || line.len == 0 {
            continue;
        }
        // 2) 追加 user 消息，跑一轮
        var att: Buf = buf_new(1024);
        defer { buf_free(&att); }
        var have_att: bool = false;
        const pushed: bool = agent_push_user_with_imgs(&h, &line, &att, &have_att);
        _ = pushed;
        if !pushed {
            tty_puts(&tty_ui, 2, "error: 无法把任务写入历史\n");
            continue;
        }
        agent_log_user_att(line.ptr as &const byte, line.len, false, &att, &have_att);
        agent_echo_imgs(&att, &have_att);
        rc = agent_turn_loop(cfg, &h);
        // P59：截断（AGENT_MAX_TOKENS）不算「异常结束」—— 那句话上面已经用
        // `[max-tokens] …` 说清「怎么回事 + 下一步怎么做」了，再说一句「异常」只会让人以为
        // 出错了（用户报的就是这条错味的现场）。
        if rc != AGENT_OK && rc != AGENT_INTERRUPTED && rc != AGENT_MAX_TOKENS {
            tty_puts(&tty_ui, 2, "[turn] 本回合异常结束（可直接输入继续）\n");
        }
        // 回合结束：跑完的子代理窗口已经收掉，这里兜底把面板同步一次
        deleg_poll_all(&g_deleg);
        agent_agents_tick_force();
        // 3) 回合结束后没被采纳的 steer 留在箱里：下一轮循环顶部会取（keepInbox）
    }

    tty_set_block_provider(&tty_ui, false);
    tty_title_end();   // P22：弹标题栈（终端支持标题栈 = 回到 shell 原来的标题）
    tty_raw_off(&tty_ui, 0);
    sigx_disarm();   // 终端已经还原过了，别让残留的信号再触发一次「恢复终端」
    tty_puts(&tty_ui, 2, "\nbye\n");
    agent_session_close();
    tasks_free();
    inbox_globals_free();
    hist_free(&h);
    buf_free(&line);
    tty_free(&tty_ui);
    g_interactive = false;
    return rc;
}

// 一次性任务的入口（有任务词时走这条）：打印 `[task] …` 再 `agent_run`。
fn run_once(cfg: &Config) i32 {
    if cfg.task.len == 0 {
        return AGENT_USAGE;
    }
    if !cfg.quiet {
        out_err("[task] ");
        out_err_bytes(cfg.task.ptr, cfg.task.len);
        out_err("\n");
    }
    return agent_run(cfg);
}

// $DSH_HOME（AGENTS.md / skills 的根），进程级
var g_dsh_home: Buf = Buf{ ptr: null, len: 0, cap: 0 };

// 当前 `$DSH_HOME`（默认 `~/.dsh`）。返回内部全局切片，调用方不许留存。
export fn agent_dsh_home() &[byte] {
    return g_dsh_home.ptr[0: g_dsh_home.len];
}

// 设 `$DSH_HOME`（`--dsh-home` / `--dsh-root` **预扫**阶段调，必须早于读设置）。
fn agent_set_dsh_home(home: &[byte]) bool {
    buf_free(&g_dsh_home);
    g_dsh_home = buf_new(home.len + 8);
    return buf_append(&g_dsh_home, home.ptr, home.len);
}

// 环境变量**存在**即真（不要求非空）。
// 用在「`0` 关、其它非空值开」这类三态开关上（如 UYA_AGENT_TITLE / _MOUSE）。
fn env_present(name: &const byte) bool {
    const p: &byte = getenv(name);
    if (p as usize) == 0 {
        return false;
    }
    return bufx_cstr_len(p) > 0;
}

// 把 src 覆盖写进 dst（覆盖层次链的统一赋值：后一层覆盖前一层）。
// 分配失败返回 false —— 调用方据此报「out of memory」而不是静默留旧值。
fn cfg_set_buf(dst: &Buf, src: &const Buf) bool {
    buf_free(dst);
    dst[0] = buf_new(src.len + 8);
    if !buf_valid(&dst[0]) {
        return false;
    }
    return buf_append(&dst[0], src.ptr, src.len);
}

// --dsh-root 收口：非 '/' 开头的一律在这里补成绝对路径。
// 这个值要到「第一次构 system prompt」才被读（agent_texts_ensure 幂等，只跑一次），
// 而那时进程已经不在启动时的 cwd 上了 —— 实测相对路径会静默失效（踩坑 70）。
fn cfg_set_dsh_root(cfg: &Config, raw: &const byte) void {
    buf_free(&cfg.dsh_root);
    cfg.dsh_root = buf_new(1200);
    if !buf_valid(&cfg.dsh_root) {
        return;
    }
    if raw == null {
        return;
    }
    if raw[0] != 0 as byte && raw[0] != 47 as byte {
        var cwdb: Buf = buf_new(1024);
        defer { buf_free(&cwdb); }
        if agent_getcwd_into(&cwdb) && cwdb.len > 0 {
            _ = buf_append(&cfg.dsh_root, cwdb.ptr, cwdb.len);
            _ = buf_append_byte(&cfg.dsh_root, 47);
        }
    }
    _ = buf_append_cstr(&cfg.dsh_root, raw);
}

// 把 DSH 设置里解析出来的东西填进 Config（在 env 之后、CLI 之前调用）
fn agent_apply_dsh(cfg: &Config, dsh: &const DshCfg) void {
    if !dsh.ok {
        return;
    }
    if dsh.base_url.len > 0 && !env_present("UYA_AGENT_BASE_URL") {
        if cfg_set_buf(&cfg.base_url, &dsh.base_url) {
            cfg.src_base_url = 1;
        }
    }
    if dsh.model.len > 0 && !env_present("UYA_AGENT_MODEL") {
        if cfg_set_buf(&cfg.model, &dsh.model) {
            cfg.src_model = 1;
        }
    }
    if dsh.api_key.len > 0 && cfg.api_key.len == 0 {
        if cfg_set_buf(&cfg.api_key, &dsh.api_key) {
            cfg.src_key = 1;
        }
    }
    // P37：提供方键（settings.yaml 里的 agent-default-model.provider）—— /model 浮层按它分组，
    // 信息行也显示它（比按 base_url 猜出来的短名准确）
    if dsh.provider.len > 0 && !cfg.provider_set {
        if cfg_set_buf(&cfg.provider, &dsh.provider) {
            cfg.provider_set = true;
            cfg.src_provider = 1;
        }
    }
    if dsh.context_window > 0 {
        cfg.context_window = dsh.context_window;
        cfg.src_context = 1;
    }
    if dsh.max_tokens > 0 && cfg.max_tokens == 0 {
        cfg.max_tokens = dsh.max_tokens;
    }
    if dsh.reasoning_effort.len > 0 && !env_present("UYA_AGENT_REASONING_EFFORT") {
        if cfg_set_buf(&cfg.reasoning_effort, &dsh.reasoning_effort) {
            cfg.src_effort = 1;
        }
    }
    if dsh.input_image {
        cfg.input_image = true;
    }
    if dsh.access_set && cfg.src_access == 0 {
        // P21：DSH 的 permission.defaultPreset 就是这三个机器名；env/CLI 声明过的优先
        cfg.access = dsh.access;
        cfg.src_access = 1;
    }
    if dsh.home.len > 0 {
        _ = agent_set_dsh_home(dsh.home.ptr[0: dsh.home.len]);
    }
    // 线协议：DSH 的 api: 是权威声明（env/CLI 已在各自的层里覆盖过；未被覆盖才用）
    if dsh.api_style.len > 0 && !env_present("UYA_AGENT_API") {
        const st: i32 = llm_style_from_name(dsh.api_style.ptr as &const byte, dsh.api_style.len);
        if st >= 0 {
            cfg.api_style = st as u8;
            cfg.src_api = 1;
        } else {
            // 认不出来（anthropic / azure-… / codex-…）就当「没声明」：仍然先试 responses
            out_err("warning: DSH provider api=");
            out_err_bytes(dsh.api_style.ptr, dsh.api_style.len);
            out_err(" 不受支持（只会 openai-completions / openai-responses）；按未声明处理（先试 /responses，404 回退 chat）\n");
        }
    }
    // Responses 的三个 compat 开关（DSH 的 provider.compat / models[].compat，-1 = 未声明）
    if dsh.compat_dev_role == 0 {
        cfg.api_dev_role = false;
    } else if dsh.compat_dev_role == 1 {
        cfg.api_dev_role = true;
    }
    if dsh.compat_store == 0 {
        cfg.api_store = false;
    } else if dsh.compat_store == 1 {
        cfg.api_store = true;
    }
    if dsh.compat_reasoning == 0 {
        cfg.api_reasoning = false;
    } else if dsh.compat_reasoning == 1 {
        cfg.api_reasoning = true;
    }
    // 信任策略：环境变量优先（来源记在 src_verify / src_pin，--print-config 会打印）
    if !env_present("UYA_AGENT_TLS_VERIFY") {
        const v: &[byte] = dsh.tls_verify.ptr[0: dsh.tls_verify.len];
        if v.len == 4 && bufx_mem_eq(v.ptr, "none", 4) {
            cfg.verify = HC_VERIFY_NONE;
            cfg.src_verify = 1;
        } else if v.len == 3 && bufx_mem_eq(v.ptr, "pin", 3) {
            cfg.verify = HC_VERIFY_PIN;
            cfg.src_verify = 1;
        } else if v.len == 5 && bufx_mem_eq(v.ptr, "chain", 5) {
            cfg.verify = HC_VERIFY_CHAIN;
            cfg.src_verify = 1;
        }
    }
    if dsh.tls_pin.len > 0 && cfg.pin.len == 0 {
        if cfg_set_buf(&cfg.pin, &dsh.tls_pin) {
            cfg.src_pin = 1;
        }
    }
}

// 信任策略的名字（--print-config 用）：与 --tls-verify= 的取值逐字一致
fn verify_name(v: i32) &const byte {
    if v == HC_VERIFY_NONE {
        return "none" as &const byte;
    }
    if v == HC_VERIFY_PIN {
        return "pin" as &const byte;
    }
    return "chain" as &const byte;
}

// 配置来源码 → 标签文本：`cli` / `env` / `dsh-settings` / `default`（§3.1）。
// `--print-config` 每个取值后面那个括号里的词就是它 —— 这是「配置到底生效了没有」的凭据。
fn cfg_src_name(src: u8) &const byte {
    if src == 1 {
        return "dsh-settings" as &const byte;
    }
    if src == 2 {
        return "env" as &const byte;
    }
    if src == 3 {
        return "cli" as &const byte;
    }
    // P37：运行中改的（/model、/effort）—— 「目录外的手输值」是 4
    if src == 4 {
        return "runtime" as &const byte;
    }
    return "default" as &const byte;
}

// 敏感值打码：sk-abcdef… → sk-…cdef
fn out_masked(key: &const Buf) void {
    if key.len == 0 {
        out_err("(none)");
        return;
    }
    if key.len <= 8 {
        out_err_bytes(key.ptr, key.len);
        return;
    }
    out_err_bytes(key.ptr, 3);
    out_err("…");
    out_err_bytes(&key.ptr[key.len - 4], 4);
}

// `--print-config`：打印**生效值 + 来源**（含 preset 旋钮、tls_verify/tls_pin、
// exec_effort/exec_after/grace_steps）。不联网。
// 这个出口存在的唯一目的就是让配置可证 —— 参见 §3.1 的「最常见的故障不是崩溃，
// 而是我以为它生效了」。
fn agent_print_config(cfg: &const Config, dsh: &const DshCfg) void {
    // 先把 preset 文案/旋钮载入（否则这里看到的是静态初始值）
    agent_texts_ensure(cfg);
    // P34：工作区是「当前会话」的状态（可切、可被恢复覆盖），所以连来源一起打。
    // 注意 --print-config 在会话打开之前就返回了：这里看到的是**启动时**解析出来的值，
    // 「会话记录里的工作区」要么在 /status 里看，要么带 --resume 跑一次。
    out_err("workspace = ");
    out_err_bytes(cfg.workspace.ptr, cfg.workspace.len);
    out_err("  (source: ");
    out_err(ws_src_name(cfg.ws_src));
    out_err(")\n");
    if cfg.resume_ws.len > 0 {
        out_err("session_workspace = ");
        out_err_bytes(cfg.resume_ws.ptr, cfg.resume_ws.len);
        out_err("  (recorded in the resumed session's log; the session opens there)\n");
    } else if cfg.resume_id.len > 0 {
        // 还没开会话（--print-config 在 agent_session_open 之前返回）：现场读一眼日志，
        // 把「会落在哪」说出来 —— 正是这条命令最常见的用途（确认 --resume 会切到哪）
        var meta: SessMeta = sess_meta_empty();
        defer { sess_meta_free(&meta); }
        var pz: Buf = buf_new(cfg.resume_id.len + 1);
        defer { buf_free(&pz); }
        _ = buf_append(&pz, cfg.resume_id.ptr, cfg.resume_id.len);
        _ = buf_append_byte(&pz, 0);
        if sess_read_meta(pz.ptr as &const byte, &meta) {
            out_err("session_workspace = ");
            if meta.workspace.len > 0 {
                out_err_bytes(meta.workspace.ptr, meta.workspace.len);
            } else {
                out_err_bytes(meta.cwd.ptr, meta.cwd.len);
            }
            out_err("  (recorded in the resumed session's log; ");
            if cfg.ws_explicit {
                out_err("--workspace wins, so this run stays in ");
                out_err_bytes(cfg.workspace.ptr, cfg.workspace.len);
            } else {
                out_err("the session opens there");
            }
            out_err(")\n");
        }
    }
    out_err("base_url = ");
    out_err_bytes(cfg.base_url.ptr, cfg.base_url.len);
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.src_base_url));
    out_err(")\n");
    out_err("model = ");
    out_err_bytes(cfg.model.ptr, cfg.model.len);
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.src_model));
    out_err(")\n");
    out_err("api_key = ");
    out_masked(&cfg.api_key);
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.src_key));
    out_err(")\n");
    out_err("context_window = ");
    out_err_dec(cfg.context_window as usize);
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.src_context));
    out_err(")\n");
    out_err("max_tokens = ");
    out_err_dec(cfg.max_tokens as usize);
    out_err("\n");
    out_err("reasoning_effort = ");
    out_err_bytes(cfg.reasoning_effort.ptr, cfg.reasoning_effort.len);
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.src_effort));
    out_err(")");
    // P56：印出**线上真正会发的值**。以前 off/none 走「不发字段」，屏幕上写着 off、线上其实是
    // 网关默认档（照想不误，输出 token 差 5.6 倍）—— 配置在说谎。
    if cfg.reasoning_effort.len > 0 {
        const p_off: bool = sv_eq_cstr(&cfg.reasoning_effort, "off" as &const byte)
            || sv_eq_cstr(&cfg.reasoning_effort, "none" as &const byte);
        if !cfg.api_reasoning {
            out_err("  [not sent: provider/model declares no reasoning support]");
        } else if p_off {
            out_err("  [sent as \"none\" — 明确关掉思考]");
        }
    }
    if cfg.reasoning_effort.len > 0 && !cfg.effort_set {
        out_err("  [not a level this model publishes; passed through]");
    }
    out_err("\n");
    // P55：低思考执行态 + 收工预算（两个都默认关；关了就不打印第二段）
    if cfg.exec_effort.len > 0 || cfg.exec_after > 0 || cfg.grace_steps > 0 {
        out_err("exec_effort = ");
        if cfg.exec_effort.len > 0 {
            out_err_bytes(cfg.exec_effort.ptr, cfg.exec_effort.len);
        } else {
            out_err("(off)");
        }
        out_err("  exec_after = ");
        out_err_dec(cfg.exec_after as usize);
        out_err("  grace_steps = ");
        out_err_dec(cfg.grace_steps as usize);
        out_err("\n");
    }
    // P37：提供方 + 该模型公布的推理档位（目录口径：只认模型自己公布的档位）
    out_err("provider = ");
    if cfg.provider.len > 0 {
        out_err_bytes(cfg.provider.ptr, cfg.provider.len);
        out_err("  (source: ");
        out_err(cfg_src_name(cfg.src_provider));
        out_err(")");
    } else {
        out_err("(unknown; --no-dsh-config or no provider in settings)");
    }
    out_err("\n");
    out_err("model_catalog = ");
    out_err_dec(agent_models_count());
    out_err(" model(s)");
    if mx_loaded(&g_mc) {
        out_err("  (loaded from settings.yaml)");
    } else {
        out_err("  (no DSH settings read; only the current model)");
    }
    out_err("\n");
    var mx_lv: Buf = buf_new(128);
    defer { buf_free(&mx_lv); }
    const mx_i: i32 = mx_find(&g_mc, cfg.provider.ptr as &const byte, cfg.provider.len,
        cfg.model.ptr as &const byte, cfg.model.len);
    if mx_i >= 0 {
        const mx_e: &const McEntry = mx_entry_at(&g_mc, mx_i as usize);
        out_err("efforts = ");
        mx_levels_into(mx_e, &mx_lv);
        if mx_lv.len > 0 {
            out_err_bytes(mx_lv.ptr as &const byte, mx_lv.len);
        } else if mx_e.declared {
            out_err("(none; this model publishes no reasoning level)");
        } else {
            out_err("(model entry declares no reasoningEfforts)");
        }
        out_err("\n");
    }
    // 生效的线协议 + 来源；未声明时说明会先试 /responses 并允许一次回退
    out_err("api = ");
    out_err(llm_style_name(api_style_now(cfg)));
    out_err("  (source: ");
    if cfg.src_api == API_SRC_DEFAULT {
        out_err("default, negotiable→chat/completions");
    } else {
        out_err(cfg_src_name(cfg.src_api));
    }
    out_err(")  endpoint = ");
    out_err(llm_endpoint_path(api_style_now(cfg)));
    if dsh.api_style.len > 0 {
        out_err("  dsh_api = ");
        out_err_bytes(dsh.api_style.ptr, dsh.api_style.len);
    }
    out_err("\n");
    out_err("tool_lines = ");
    out_err_dec(cfg_tool_lines(cfg));
    if cfg.quiet {
        out_err("  (display: off, --quiet)\n");
    } else {
        out_err("  (display: on)\n");
    }
    out_err("title = ");
    if cfg.title {
        out_err("on");
    } else {
        out_err("off");
    }
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.title_src));
    out_err(")\n");
    out_err("title_auto = ");
    if cfg.title_auto {
        out_err("on");
    } else {
        out_err("off");
    }
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.title_auto_src));
    out_err(")\n");
    out_err("mouse = ");
    if cfg.mouse {
        out_err("on");
    } else {
        out_err("off");
    }
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.mouse_src));
    out_err(")\n");
    out_err("input_image = ");
    if cfg.input_image {
        out_err("true\n");
    } else {
        out_err("false\n");
    }
    out_err("permission = ");
    out_err(perm_name(cfg.access));
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.src_access));
    out_err(")\n");
    out_err("debug_dump = ");
    if buf_valid(&g_diag_dump) && g_diag_dump.len > 0 {
        out_err_bytes(g_diag_dump.ptr as &const byte, g_diag_dump.len);
        out_err("  (raw diagnostic bytes appended here)\n");
    } else {
        out_err("(off; transcript keeps an escaped preview, session log keeps diag/dump)\n");
    }
    out_err("sandbox = ");
    if cfg.sandbox == SAN_OFF {
        out_err("off");
        out_err("  (source: ");
        out_err(cfg_src_name(cfg.sandbox_src));
        out_err(", probe: skipped)\n");
    } else {
        if cfg.bwrap.len > 0 {
            san_set_bwrap(cfg.bwrap.ptr as &const byte, cfg.bwrap.len);
        }
        _ = san_probe(false);
        out_err(san_backend_name());
        out_err("  (source: ");
        out_err(cfg_src_name(cfg.sandbox_src));
        out_err(", probe: ");
        out_err(san_reason());
        out_err(")\n");
    }
    out_err("tls_verify = ");
    out_err(verify_name(cfg.verify));
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.src_verify));
    out_err(")\n");
    out_err("tls_pin = ");
    if cfg.pin.len > 0 {
        // 指纹是公开信息（不是密钥），完整打印才好和 openssl 的输出对比，故不打码
        out_err_bytes(cfg.pin.ptr, cfg.pin.len);
    } else {
        out_err("(none)");
    }
    out_err("  (source: ");
    out_err(cfg_src_name(cfg.src_pin));
    out_err(")\n");
    out_err("stream = ");
    if cfg.stream {
        out_err("true");
    } else {
        out_err("false");
    }
    out_err("  compat_fold = ");
    if cfg.compat_fold {
        out_err("true");
    } else {
        out_err("false");
    }
    out_err("  max_steps = ");
    if cfg.max_steps <= 0 {
        out_err("unlimited (0)");
    } else {
        out_err_dec(cfg.max_steps as usize);
    }
    out_err("\n");
    out_err("tui = ");
    if cfg.tui {
        out_err("on");
    } else {
        out_err("off");
    }
    out_err("  (source: ");
    if cfg.tui_src == 1 {
        out_err("env");
    } else if cfg.tui_src == 2 {
        out_err("cli");
    } else {
        out_err("default");
    }
    out_err(")\n");
    out_err("color = ");
    if cfg.color_mode == 1 {
        out_err("always");
    } else if cfg.color_mode == 2 {
        out_err("never");
    } else if cfg.color_mode == 3 {
        out_err("16");
    } else if cfg.color_mode == 4 {
        out_err("256");
    } else {
        out_err("auto");
    }
    out_err("  (source: ");
    if cfg.color_mode == 0 {
        out_err("default");
    } else {
        out_err("cli");
    }
    out_err(")\n");
    out_err("dsh_home = ");
    out_err_bytes(dsh.home.ptr, dsh.home.len);
    out_err("  (loaded: ");
    if dsh.ok {
        out_err("yes");
    } else {
        out_err("no");
    }
    out_err(")  provider = ");
    out_err_bytes(dsh.provider.ptr, dsh.provider.len);
    out_err("  api_style = ");
    out_err_bytes(dsh.api_style.ptr, dsh.api_style.len);
    out_err("\n");
    out_err("api_key_env = ");
    out_err_bytes(dsh.api_key_env.ptr, dsh.api_key_env.len);
    out_err("  key_source = ");
    out_err(dsh_key_src_name(dsh.key_src));
    out_err("  agent_home = ");
    out_err_bytes(g_home.ptr as &const byte, g_home.len);
    out_err("\n");
    out_err("preset = ");
    out_err_bytes(dsh.preset_default.ptr, dsh.preset_default.len);
    out_err("\n");
    // P13：preset 旋钮（来源 = DSH preset 的 config，读不到就是标准默认值）
    out_err("knobs (source: ");
    if g_knobs.loaded {
        out_err("preset");
    } else {
        out_err("defaults");
    }
    out_err(") readLimit=");
    out_err_dec(g_knobs.read_limit as usize);
    out_err(" readMaxBytes=");
    out_err_dec(g_knobs.read_max_bytes as usize);
    out_err(" readMaxLine=");
    out_err_dec(g_knobs.read_max_line as usize);
    out_err("\n");
    out_err("knobs prune=");
    out_err_dec(g_knobs.prune_threshold as usize);
    out_err("/");
    out_err_dec(g_knobs.prune_head as usize);
    out_err("/");
    out_err_dec(g_knobs.prune_tail as usize);
    out_err("/");
    out_err_dec(g_knobs.bash_prune_threshold as usize);
    out_err("/");
    out_err_dec(g_knobs.bash_prune_permille as usize);
    out_err(" glob=");
    out_err_dec(g_knobs.glob_max as usize);
    out_err(" grep=");
    out_err_dec(g_knobs.grep_max as usize);
    out_err("/");
    out_err_dec(g_knobs.grep_line as usize);
    out_err(" bashTimeoutMs=");
    out_err_dec(g_knobs.bash_timeout_ms as usize);
    out_err(" instrMaxBytes=");
    out_err_dec(g_knobs.instr_max_bytes as usize);
    out_err(" compactThresholdPermille=");
    out_err_dec(g_knobs.compact_threshold_permille as usize);
    out_err("retainPermille=");
    out_err_dec(g_knobs.retain_permille as usize);
    out_err("\n");
}

// 进程入口。完整阶段序列见 §3.2：预扫 4 flag（--dsh-home / --dsh-root / --no-dsh-config /
// --strict-dsh-config，必须早于读设置）→ 读 DSH 设置 → 环境变量默认 → CLI 解析 →
// 工作区规范化 → 早退分支（--print-config / --selftest / --probe / --tui-demo …）→
// 模型目录 → 形态选择（一次性 / 全屏 TUI / 滚动模式兜底）→ 回合准备。
// **必须 `export fn main() i32`，不能写 `!i32`**：split-C 下 `!i32` 生成的 `main_main`
// 会与 entry 冲突（§16 踩坑 8）。
export fn main() i32 {
    var cfg: Config = cfg_default();
    defer { cfg_free(&cfg); }
    var selftest: bool = false;
    var probe: bool = false;
    var task_words: Buf = buf_new(2048);
    defer { buf_free(&task_words); }

    // 1) 环境变量默认值
    cfg.base_url = env_or("UYA_AGENT_BASE_URL", "https://api.deepseek.com/v1");
    cfg.model = env_or("UYA_AGENT_MODEL", "deepseek-chat");
    cfg.api_key = env_first("UYA_AGENT_API_KEY", "DEEPSEEK_API_KEY", "OPENAI_API_KEY");

    // 2) 工作目录（默认当前目录，可用 UYA_AGENT_WORKSPACE / --workspace 覆盖）
    cfg.workspace = buf_empty();
    _ = agent_workspace_set_cwd(&cfg);
    cfg.uya_bin = buf_empty();
    const ub: &byte = getenv("UYA_BIN");
    if (ub as usize) != 0 && bufx_cstr_len(ub) > 0 {
        cfg.uya_bin = buf_from_cstr(ub);
    } else {
        cfg.uya_bin = buf_from_cstr("uya" as &const byte);
    }
    const ws_env: &byte = getenv("UYA_AGENT_WORKSPACE");
    if (ws_env as usize) != 0 {
        buf_free(&cfg.workspace);
        cfg.workspace = buf_from_cstr(ws_env);
        cfg.ws_src = 2;
        cfg.ws_explicit = true;   // P34：显式指定优先于「会话记录里的工作区」
    }
    const tui_env: &byte = getenv("UYA_AGENT_TUI");
    if (tui_env as usize) != 0 && bufx_cstr_len(tui_env) > 0 {
        if bufx_eq_cstr(tui_env, bufx_cstr_len(tui_env), "0") {
            cfg.tui = false;
            cfg.tui_src = 1;
        } else {
            cfg.tui = true;
            cfg.tui_src = 1;
        }
    }
    const title_env: &byte = getenv("UYA_AGENT_TITLE");
    if (title_env as usize) != 0 && bufx_cstr_len(title_env) > 0 {
        if bufx_eq_cstr(title_env, bufx_cstr_len(title_env), "0") {
            cfg.title = false;
            cfg.title_src = TITLE_SRC_ENV;
        } else {
            cfg.title = true;
            cfg.title_src = TITLE_SRC_ENV;
        }
    }
    // P46：自动起标题（UYA_AGENT_TITLE_AUTO=0/1）—— 与标题/鼠标同一套「0 关、其它当开」
    const title_auto_env: &byte = getenv("UYA_AGENT_TITLE_AUTO");
    if (title_auto_env as usize) != 0 && bufx_cstr_len(title_auto_env) > 0 {
        if bufx_eq_cstr(title_auto_env, bufx_cstr_len(title_auto_env), "0") {
            cfg.title_auto = false;
            cfg.title_auto_src = TITLE_SRC_ENV;
        } else {
            cfg.title_auto = true;
            cfg.title_auto_src = TITLE_SRC_ENV;
        }
    }
    // 踩坑 72：鼠标上报（UYA_AGENT_MOUSE=0/1）—— 与标题同一套「0 关、其它当开」的口径
    const mouse_env: &byte = getenv("UYA_AGENT_MOUSE");
    if (mouse_env as usize) != 0 && bufx_cstr_len(mouse_env) > 0 {
        if bufx_eq_cstr(mouse_env, bufx_cstr_len(mouse_env), "0") {
            cfg.mouse = false;
            cfg.mouse_src = TITLE_SRC_ENV;
        } else {
            cfg.mouse = true;
            cfg.mouse_src = TITLE_SRC_ENV;
        }
    }
    const steps_env: &byte = getenv("UYA_AGENT_MAX_STEPS");
    if (steps_env as usize) != 0 {
        cfg.max_steps = parse_steps_arg(steps_env, "UYA_AGENT_MAX_STEPS" as &const byte);
    }

    const tlsv: &byte = getenv("UYA_AGENT_TLS_VERIFY");
    if (tlsv as usize) != 0 {
        if bufx_cstr_len(tlsv) == 4 && bufx_eq_cstr(tlsv, 4, "none") {
            cfg.verify = HC_VERIFY_NONE;
            cfg.src_verify = 2;
        } else if bufx_cstr_len(tlsv) == 3 && bufx_eq_cstr(tlsv, 3, "pin") {
            cfg.verify = HC_VERIFY_PIN;
            cfg.src_verify = 2;
        } else if bufx_cstr_len(tlsv) == 5 && bufx_eq_cstr(tlsv, 5, "chain") {
            cfg.verify = HC_VERIFY_CHAIN;
            cfg.src_verify = 2;
        }
    }
    const tlsp: &byte = getenv("UYA_AGENT_TLS_PIN");
    if (tlsp as usize) != 0 && bufx_cstr_len(tlsp) > 0 {
        buf_free(&cfg.pin);
        cfg.pin = buf_from_cstr(tlsp);
        cfg.src_pin = 2;
    }
    // 线协议与推理档位（未声明时默认 responses，并允许一次性协商回退 chat）
    const api_env: &byte = getenv("UYA_AGENT_API");
    if (api_env as usize) != 0 && bufx_cstr_len(api_env) > 0 {
        const st: i32 = llm_style_from_name(api_env, bufx_cstr_len(api_env));
        if st >= 0 {
            cfg.api_style = st as u8;
            cfg.src_api = 2;
        } else {
            out_err("warning: UYA_AGENT_API=");
            out_err_bytes(api_env, bufx_cstr_len(api_env));
            out_err(" 不认识（只会 openai-completions / openai-responses）；忽略，按未声明处理\n");
        }
    }
    const eff_env: &byte = getenv("UYA_AGENT_REASONING_EFFORT");
    if (eff_env as usize) != 0 && bufx_cstr_len(eff_env) > 0 {
        buf_free(&cfg.reasoning_effort);
        cfg.reasoning_effort = buf_from_cstr(eff_env);
        cfg.src_effort = 2;
    }
    // P55：低思考执行态（--exec-effort / --exec-after / --grace-steps 的 env 口径）
    const xeff_env: &byte = getenv("UYA_AGENT_EXEC_EFFORT");
    if (xeff_env as usize) != 0 && bufx_cstr_len(xeff_env) > 0 {
        buf_free(&cfg.exec_effort);
        cfg.exec_effort = buf_from_cstr(xeff_env);
    }
    const xafter_env: &byte = getenv("UYA_AGENT_EXEC_AFTER");
    if (xafter_env as usize) != 0 && bufx_cstr_len(xafter_env) > 0 {
        cfg.exec_after = parse_i32_arg(xafter_env, 0);
    }
    const grace_env: &byte = getenv("UYA_AGENT_GRACE_STEPS");
    if (grace_env as usize) != 0 && bufx_cstr_len(grace_env) > 0 {
        cfg.grace_steps = parse_i32_arg(grace_env, 0);
    }
    // P21：访问模式（read-only / workspace-write / danger-full-access，机器名与 DSH 一致）
    const perm_env: &byte = getenv("UYA_AGENT_PERMISSION");
    if (perm_env as usize) != 0 && bufx_cstr_len(perm_env) > 0 {
        const pm: i32 = perm_from_name(perm_env, bufx_cstr_len(perm_env));
        if pm >= 0 {
            cfg.access = pm as u8;
            cfg.src_access = 2;
        } else {
            out_err("warning: UYA_AGENT_PERMISSION=");
            out_err_bytes(perm_env, bufx_cstr_len(perm_env));
            out_err(" 不认识（只会 read-only / workspace-write / danger-full-access）；忽略\n");
        }
    }
    // P21：沙箱开关与 bwrap 路径（UYA_AGENT_SANDBOX=0 等价于 --no-sandbox）
    const san_env: &byte = getenv("UYA_AGENT_SANDBOX");
    if (san_env as usize) != 0 && bufx_cstr_len(san_env) > 0 {
        if bufx_eq_cstr(san_env, bufx_cstr_len(san_env), "0") || bufx_eq_cstr(san_env, bufx_cstr_len(san_env), "off") {
            cfg.sandbox = SAN_OFF;
            cfg.sandbox_src = 2;
        } else {
            cfg.sandbox = SAN_AUTO;
            cfg.sandbox_src = 2;
        }
    }
    const bwrap_env: &byte = getenv("UYA_AGENT_BWRAP");
    if (bwrap_env as usize) != 0 && bufx_cstr_len(bwrap_env) > 0 {
        buf_free(&cfg.bwrap);
        cfg.bwrap = buf_from_cstr(bwrap_env);
    }

    // 2.5) 预扫「决定去哪儿读设置」的三个 flag：--dsh-home / --no-dsh-config / --strict-dsh-config
    // 它们的语义是「影响加载本身」，必须在下一次调用之前生效；而完整 CLI 解析排在第 4 步
    // （在 DSH 加载之后），只靠主循环会让这三个 flag 静默失效。主循环稍后还会再解析一次（幂等）。
    var pi: i32 = 1;
    while pi < get_argc() {
        const pp: &byte = get_argv(pi);
        if pp == null {
            pi = pi + 1;
            continue;
        }
        if arg_eq(pp, "--dsh-home") {
            pi = pi + 1;
            if pi < get_argc() {
                buf_free(&cfg.dsh_home);
                cfg.dsh_home = buf_from_cstr(get_argv(pi));
            }
        } else if arg_eq(pp, "--dsh-root") {
            // --dsh-root 与 --dsh-home 同类：它决定 persona/plan/旋钮从哪个 preset 树读，
            // 而 preset 文案在第一次构 system prompt 时就固化了（agent_texts_ensure 只跑一次），
            // 所以必须在这里预扫；只靠主循环那次解析会静默失效（与踩坑 25 同因）。
            // 相对路径由 cfg_set_dsh_root 当场补成绝对路径。
            pi = pi + 1;
            if pi < get_argc() {
                cfg_set_dsh_root(&cfg, get_argv(pi));
            }
        } else if arg_eq(pp, "--no-dsh-config") {
            cfg.no_dsh_config = true;
        } else if arg_eq(pp, "--strict-dsh-config") {
            cfg.strict_dsh_config = true;
        }
        pi = pi + 1;
    }

    // 3) DSH 设置（优先级：env 之后、CLI 之前）
    var dsh: DshCfg = dsh_cfg_empty();
    defer { dsh_cfg_free(&dsh); }
    if !cfg.no_dsh_config {
        var cwdz: Buf = buf_new(cfg.workspace.len + 1);
        defer { buf_free(&cwdz); }
        _ = buf_append(&cwdz, cfg.workspace.ptr, cfg.workspace.len);
        _ = buf_append_byte(&cwdz, 0);
        const loaded: bool = dsh_cfg_load(cfg.dsh_home.ptr as &const byte, cwdz.ptr as &const byte, &dsh);
        if !loaded {
            if cfg.strict_dsh_config {
                out_err("error: 读不到 DSH 设置（--strict-dsh-config）：");
                out_err_bytes(cfg.dsh_home.ptr, cfg.dsh_home.len);
                out_err("\n");
                return AGENT_USAGE;
            }
            dsh.ok = false;
        } else {
            agent_apply_dsh(&cfg, &dsh);
        }
    }
    // 3.5) P37：目录就绪（--model / --effort / /model 浮层都要它）。
    // CLI（第 4 步）会再走一遍 agent_model_apply，这里先把「DSH 默认路线」按目录补齐：
    // 默认档位也在这时落地（settings.yaml 里没写 reasoningEffort 时才补，写了就尊重它）。
    agent_models_ensure(&cfg);
    // 目录就绪后**重算** effort_set：DSH/env/CLI 那几条路都是先落值、后载目录，
    // 之前那次判定拿不到目录，会把手填的合法档位误报成「模型没公布」。
    agent_effort_recheck(&cfg);
    if cfg.reasoning_effort.len == 0 {
        const di: i32 = mx_find(&g_mc, cfg.provider.ptr as &const byte, cfg.provider.len,
            cfg.model.ptr as &const byte, cfg.model.len);
        if di >= 0 {
            const de: &const McEntry = mx_entry_at(&g_mc, di as usize);
            const dfl: i32 = mx_default_level(de);
            if dfl >= 0 {
                buf_free(&cfg.reasoning_effort);
                cfg.reasoning_effort = buf_from_cstr(mx_level_name(dfl as usize));
                cfg.effort_set = true;
                cfg.src_effort = 1;
            }
        }
    }

    // 3.6) P37：worktree 模式的默认开关 —— DSH 的 agent-presets.default=git-worktree
    // 就是「这个会话在独立工作区里跑」的声明（对齐 DSH：选了这个 preset 就自动建）。
    if dsh.ok && bufx_eq_cstr(dsh.preset_default.ptr as &const byte, dsh.preset_default.len,
            "git-worktree" as &const byte) {
        wt_set_on(true);
        cfg.wt_src = 1;
    }

    // 4) 命令行
    var i: i32 = 1;
    while i < get_argc() {
        const p: &byte = get_argv(i);
        if p == null {
            i = i + 1;
            continue;
        }
        if arg_eq(p, "--yaml-dump") {
            i = i + 1;
            if i < get_argc() {
                var t: YTree = YTree{ nodes: [], n: 0, lines: [], nlines: 0, raw: buf_empty(), cur: 0, err_line: 0 };
                yt_init(&t);
                const got: bool = yt_dump(get_argv(i), &t);
                yt_free(&t);
                return if got { AGENT_OK } else { AGENT_PROTO };
            }
            out_err("error: --yaml-dump 需要文件路径\n");
            return AGENT_USAGE;
        }
        if arg_eq(p, "-h") || arg_eq(p, "--help") {
            print_usage();
            return AGENT_OK;
        } else if arg_eq(p, "--selftest") {
            selftest = true;
        } else if arg_eq(p, "--probe") {
            probe = true;
        } else if arg_eq(p, "--tui") {
            cfg.tui = true;
            cfg.tui_src = 2;
        } else if arg_eq(p, "--no-tui") {
            cfg.tui = false;
            cfg.tui_src = 2;
        } else if arg_eq(p, "--title") {
            cfg.title = true;
            cfg.title_src = TITLE_SRC_CLI;
        } else if arg_eq(p, "--no-title") {
            cfg.title = false;
            cfg.title_src = TITLE_SRC_CLI;
        } else if arg_eq(p, "--title-auto") {
            cfg.title_auto = true;
            cfg.title_auto_src = TITLE_SRC_CLI;
        } else if arg_eq(p, "--no-title-auto") {
            cfg.title_auto = false;
            cfg.title_auto_src = TITLE_SRC_CLI;
        } else if arg_eq(p, "--mouse") {
            cfg.mouse = true;
            cfg.mouse_src = TITLE_SRC_CLI;
        } else if arg_eq(p, "--no-mouse") {
            cfg.mouse = false;
            cfg.mouse_src = TITLE_SRC_CLI;
        } else if arg_starts_with(p, "--color=") {
            cfg.color_mode = agent_parse_color(p);
        } else if arg_eq(p, "--no-color") {
            cfg.color_mode = 2;
        } else if arg_eq(p, "--tui-demo") {
            cfg.tui_demo = true;
            // 可选尺寸：`--tui-demo 100x30`（不给就用 cfg 里的内置画布）
            if i + 1 < get_argc() {
                const nx: &byte = get_argv(i + 1);
                if parse_size_pair(nx[0: cstr_len(nx)], &cfg.tui_cols, &cfg.tui_rows) {
                    i = i + 1;
                }
            }
        } else if arg_eq(p, "--no-shell") {
            cfg.allow_shell = false;
        } else if arg_eq(p, "--no-stream") {
            cfg.stream = false;
        } else if arg_eq(p, "--compat-fold") {
            cfg.compat_fold = true;
        } else if arg_eq(p, "--agent-home") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.agent_home);
                cfg.agent_home = buf_from_cstr(get_argv(i));
            }
        } else if arg_eq(p, "--no-save") {
            cfg.save_session = false;
        } else if arg_eq(p, "--dsh-home") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.dsh_home);
                cfg.dsh_home = buf_from_cstr(get_argv(i));
            }
        } else if arg_eq(p, "--no-dsh-config") {
            cfg.no_dsh_config = true;
        } else if arg_eq(p, "--strict-dsh-config") {
            cfg.strict_dsh_config = true;
        } else if arg_eq(p, "--list-dsh-sessions") {
            cfg.list_dsh_sessions = true;
        } else if arg_eq(p, "--resume-dsh") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.resume_dsh);
                cfg.resume_dsh = buf_from_cstr(get_argv(i));
            }
        } else if arg_eq(p, "--print-config") {
            cfg.print_config = true;
        } else if arg_eq(p, "--no-compact") {
            g_compact_enabled = false;
        } else if arg_eq(p, "--context-window") {
            i = i + 1;
            if i < get_argc() {
                cfg.context_window = parse_i32_arg(get_argv(i), 0) as i64;
                cfg.src_context = 3;
            }
        } else if arg_starts_with(p, "--api=") {
            // 显式声明协议 ⇒ 不协商（声明即权威）。取值与 DSH 的 api: 同名，另接受两个简写
            const val: &const byte = @ptr_from_usize(@usize_from_ptr(p as &const void) + 6) as &const byte;
            const st: i32 = llm_style_from_name(val, bufx_cstr_len(val));
            if st < 0 {
                out_err("error: --api expects openai-completions|completions|chat|openai-responses|responses\n");
                return AGENT_USAGE;
            }
            cfg.api_style = st as u8;
            cfg.src_api = 3;
        } else if arg_starts_with(p, "--permission=") {
            // P21：访问模式。取值与 DSH 的 preset key 逐字一致（声明即权威）
            const pval: &const byte = @ptr_from_usize(@usize_from_ptr(p as &const void) + 13) as &const byte;
            const pm: i32 = perm_from_name(pval, bufx_cstr_len(pval));
            if pm < 0 {
                out_err("error: --permission expects read-only|workspace-write|danger-full-access\n");
                return AGENT_USAGE;
            }
            cfg.access = pm as u8;
            cfg.src_access = 3;
        } else if arg_eq(p, "--permission") {
            i = i + 1;
            if i < get_argc() {
                const pval: &byte = get_argv(i);
                const pm: i32 = perm_from_name(pval, bufx_cstr_len(pval));
                if pm < 0 {
                    out_err("error: --permission expects read-only|workspace-write|danger-full-access\n");
                    return AGENT_USAGE;
                }
                cfg.access = pm as u8;
                cfg.src_access = 3;
            } else {
                out_err("error: --permission needs a value (read-only / workspace-write / danger-full-access)\n");
                return AGENT_USAGE;
            }
        } else if arg_eq(p, "--worktree") {
            // P37：独立工作区执行（会话开始时建 worktree）
            wt_set_on(true);
            cfg.wt_src = 3;
        } else if arg_eq(p, "--no-worktree") {
            wt_set_on(false);
            cfg.wt_src = 3;
        } else if arg_eq(p, "--no-sandbox") {
            cfg.sandbox = SAN_OFF;
            cfg.sandbox_src = 3;
        } else if arg_eq(p, "--bwrap") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.bwrap);
                cfg.bwrap = buf_from_cstr(get_argv(i));
            } else {
                out_err("error: --bwrap needs a path\n");
                return AGENT_USAGE;
            }
        } else if arg_eq(p, "--reasoning-effort") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.reasoning_effort);
                cfg.reasoning_effort = buf_from_cstr(get_argv(i));
                cfg.src_effort = 3;
            } else {
                out_err("error: --reasoning-effort needs a value (off / minimal / low / medium / high / xhigh / max)\n");
                return AGENT_USAGE;
            }
        } else if arg_eq(p, "--dry-run") {
            cfg.dry_run = true;
        } else if arg_eq(p, "--plan") {
            cfg.plan = true;
        } else if arg_eq(p, "--uya-bin") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.uya_bin);
                cfg.uya_bin = buf_from_cstr(get_argv(i));
            }
        } else if arg_eq(p, "--skill-dir") {
            i = i + 1;
            if i < get_argc() {
                if cfg.skill_dirs.len > 0 {
                    _ = buf_append_byte(&cfg.skill_dirs, 58);
                }
                _ = buf_append_cstr(&cfg.skill_dirs, get_argv(i));
            }
        } else if arg_eq(p, "--dsh-root") {
            i = i + 1;
            if i < get_argc() {
                cfg_set_dsh_root(&cfg, get_argv(i));
            }
        } else if arg_eq(p, "--list-sessions") {
            cfg.list_sessions = true;
        } else if arg_eq(p, "--continue") {
            // 不带参数：接当前目录下最近一条会话（别吞后面的任务词）
            if !agent_resolve_resume(&cfg, "last") {
                out_err("error: 当前目录下没有可继续的会话（用 --list-sessions 看）\n");
                return AGENT_USAGE;
            }
        } else if arg_eq(p, "--resume") {
            i = i + 1;
            if i < get_argc() {
                if !agent_resolve_resume(&cfg, get_argv(i)) {
                    out_err("error: 找不到会话：");
                    out_err_bytes(get_argv(i), cstr_len(get_argv(i)));
                    out_err("\n");
                    return AGENT_USAGE;
                }
            } else {
                out_err("error: --resume 需要会话 id（或用 --continue 接最近一条）\n");
                return AGENT_USAGE;
            }
        } else if arg_eq(p, "--no-stream-options") {
            cfg.stream_options = false;
        } else if arg_eq(p, "--show-reasoning") {
            cfg.show_reasoning = true;
        } else if arg_eq(p, "--show-usage") {
            cfg.show_usage = true;
        } else if arg_eq(p, "--max-tokens") {
            i = i + 1;
            if i < get_argc() {
                cfg.max_tokens = parse_i32_arg(get_argv(i), 0) as i64;
            }
        } else if arg_eq(p, "--temperature") {
            i = i + 1;
            if i < get_argc() {
                cfg.temperature = parse_i32_nonneg(get_argv(i), -1);
            }
        } else if arg_eq(p, "--tool-lines") {
            i = i + 1;
            if i < get_argc() {
                cfg.tool_lines = parse_i32_nonneg(get_argv(i), 6);
            }
        } else if arg_eq(p, "--debug-dump") {
            i = i + 1;
            if i < get_argc() {
                const dv: &byte = get_argv(i);
                agent_set_debug_dump(dv as &const byte, bufx_cstr_len(dv as &const byte));
            }
        } else if arg_eq(p, "--quiet") {
            cfg.quiet = true;
        } else if arg_eq(p, "--tls-debug") {
            cfg.tls_debug = true;
        } else if arg_eq(p, "--http-debug") {
            hc_debug = true;
        } else if arg_eq(p, "--base-url") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.base_url);
                cfg.base_url = buf_from_cstr(get_argv(i));
            }
        } else if arg_eq(p, "--model") {
            i = i + 1;
            if i < get_argc() {
                // P37：走目录收口 —— 命中就把该模型的 provider/能力/档位一起搬过来，没命中也只换名字
                _ = agent_model_apply(&cfg, cfg.provider.ptr as &const byte, cfg.provider.len,
                    get_argv(i), cstr_len(get_argv(i)), "cli" as &const byte, false);
            }
        } else if arg_eq(p, "--provider") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.provider);
                cfg.provider = buf_from_cstr(get_argv(i));
                cfg.provider_set = true;
                cfg.src_provider = 3;
            }
        } else if arg_eq(p, "--effort") {
            i = i + 1;
            if i < get_argc() {
                _ = agent_effort_apply(&cfg, get_argv(i), cstr_len(get_argv(i)), false, "cli" as &const byte);
            }
        } else if arg_eq(p, "--workspace") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.workspace);
                cfg.workspace = buf_from_cstr(get_argv(i));
                cfg.ws_src = 3;
                cfg.ws_explicit = true;   // P34：显式指定优先于「会话记录里的工作区」
            }
        } else if arg_eq(p, "--max-steps") {
            i = i + 1;
            if i < get_argc() {
                cfg.max_steps = parse_steps_arg(get_argv(i), "--max-steps" as &const byte);
            }
        } else if arg_eq(p, "--max-response") {
            i = i + 1;
            if i < get_argc() {
                cfg.max_response = parse_i32_arg(get_argv(i), 262144) as usize;
            }
        } else if arg_eq(p, "--timeout-ms") {
            i = i + 1;
            if i < get_argc() {
                cfg.timeout_ms = parse_i32_arg(get_argv(i), 120000) as u32;
            }
        } else if arg_eq(p, "--exec-effort") {
            // P55：执行期档位（配了 --exec-after 才生效）
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.exec_effort);
                cfg.exec_effort = buf_from_cstr(get_argv(i));
            }
        } else if arg_eq(p, "--exec-after") {
            i = i + 1;
            if i < get_argc() {
                cfg.exec_after = parse_i32_arg(get_argv(i), 0);
            }
        } else if arg_eq(p, "--grace-steps") {
            // P55：验收通过之后的收工预算（0 = 只提醒、不设硬上限）
            i = i + 1;
            if i < get_argc() {
                cfg.grace_steps = parse_i32_arg(get_argv(i), 0);
            }
        } else if arg_eq(p, "--tls-verify=chain") {
            cfg.verify = HC_VERIFY_CHAIN;
            cfg.src_verify = 3;
        } else if arg_eq(p, "--tls-verify=pin") {
            cfg.verify = HC_VERIFY_PIN;
            cfg.src_verify = 3;
        } else if arg_eq(p, "--tls-verify=none") {
            cfg.verify = HC_VERIFY_NONE;
            cfg.src_verify = 3;
        } else if arg_eq(p, "--tls-pin") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.pin);
                cfg.pin = buf_from_cstr(get_argv(i));
                cfg.src_pin = 3;
            }
        } else if arg_eq(p, "--api-key") {
            i = i + 1;
            if i < get_argc() {
                buf_free(&cfg.api_key);
                cfg.api_key = buf_from_cstr(get_argv(i));
            }
        } else if p[0] == '-' as byte {
            out_err("error: unknown option: ");
            out_err_bytes(p, cstr_len(p));
            out_err("\n");
            print_usage();
            return AGENT_USAGE;
        } else {
            if task_words.len > 0 {
                _ = buf_append_byte(&task_words, 32);
            }
            _ = buf_append(&task_words, p, cstr_len(p));
        }
        i = i + 1;
    }
    // P34：--workspace / $UYA_AGENT_WORKSPACE 给的可能是相对路径 —— 规范化成绝对路径
    // （沙箱 bind、/diff 的「工作区 vs 仓库根」比较、/status 与脚注都想看到绝对路径）。
    // 失败（目录不存在之类）就原样留着：开会话时会照旧报出来。
    agent_workspace_canon(&cfg);
    if cfg.verify == HC_VERIFY_PIN && cfg.pin.len == 0 {
        out_err("error: --tls-verify=pin requires --tls-pin <sha256 hex>\n");
        return AGENT_USAGE;
    }
    if cfg.list_dsh_sessions {
        return agent_list_dsh_sessions(&cfg);
    }
    if cfg.print_config {
        agent_print_config(&cfg, &dsh);
        return AGENT_OK;
    }
    if cfg.dry_run {
        return agent_dry_run(&cfg);
    }
    if cfg.list_sessions {
        return agent_list_sessions(&cfg);
    }
    if selftest {
        return selftest_main(&cfg);
    }
    if probe {
        return probe_main(&cfg);
    }
    if cfg.tui_demo {
        return agent_tui_demo(&cfg, cfg.tui_cols, cfg.tui_rows);
    }
    if task_words.len > 0 {
        cfg.task = task_words;
        task_words = buf_empty();
        return run_once(&cfg);
    }
    if agent_tui_wanted(&cfg) {
        // 全屏 TUI：终端不满足条件（不是 TTY / 太小 / dup 失败）时内部自己退回滚动模式
        return agent_run_tui(&cfg);
    }
    return agent_run_interactive(&cfg);
}

// ============================================================
// P17：全屏 TUI（opencode 风格）
//
// 分层：`src/tui.uya` 只管画与按键；这里负责「把 agent 的状态喂给它」和
// 「把它交出来的提交/中断送回回合循环」。数据流见 §11。
// ============================================================

// P21–P29 这九个编号都已被并行线占用（访问模式三级 + 内核沙箱 = p21-perm；
// 终端标题 = p22-title；命令面板与 `/status` 浮层 = p23-cmd；脚注内存字段 + 首 token 口径 =
// p24-mem；任务状态 /tasks + 常驻任务块 = p25-tasks；plan 写闸门 + 审阅浮窗 = p26-plan；
// /diff 浮窗 = p27-diff；「退不出」：运行中的 esc/ctrl+c/ctrl+d/`/exit` 必须当场生效 = p28-quit；
// /goal 人类命令 = p29-goal；运行中的 `/` 命令不再等 step 边界 = p30-pump；
// 「请求在飞」的那段也插泵点（等响应头 / 写请求体 / 压缩请求 + 派发当场出帧）= p31-wait；
// **工作区翻看**（滚轮 / ctrl+home·end / 长条目真总量走查 / `^` 溢出指示）= p32-scroll）。
// 本条线（**`/sessions` 列表：三列 = 标题 / 工作区 / session id、按 lastActiveAt 倒序、
// 列宽随终端自适应**）与 p31-wait / p32-scroll 前后脚撞号，按「后到的顺延」记成 **P33**，
// 版本串 `p33-sess` —— 与 README §1.1 同一套记法。
// P35（本线）：**恢复会话段错误修复**（`sess_read_meta` 把切片第二个参数当「终点」写，
// 越界读到映射尾 —— 大日志必崩）+ **/sessions 最新的排最后一行**，版本串 `p35-sess`。
// ⚠ 手写的长度常量要跟着版本串一起改：P30 这条线在分支上把串改成 8 字节时忘了改它（当时是 9），
// 末尾那个 NUL 就进了 /status 浮层 —— 自测的「正文层不许出现 NUL」不变量当场抓住。
// P37（本线）：**模型选择 + 推理强度 + Git worktree**（独立工作区执行 → 合并 → 删除）。
// 编号说明：P36 已被并行线 `dsh/p36-diffbg` 认领（当时未合），按「后到的顺延」记成 **P37**，
// 版本串 `p37-model` —— 与 README §1.1 同一套记法。
// P38（本线）：**bash 工具的命令不再有终端**（stdin=/dev/null + `setsid` + 按进程组收子树）。
// P36（并行线 `dsh/p36-diffbg`，**现已并入**）：**`/diff` 改动部分的背景色高亮 + `n`/`N` 跳转**。
// 它的编号是这条主线早就给它留着的（见上面那条「后到的顺延」的反向用例），所以并进来仍记
// **P36**；那条线自己的验收串是 `p36-diffbg`，合回主线后**版本串沿用主线的 `p37-model`**
// （与 P38 的 `p38-tty` 同一种记法：只有选定要动 `AGENT_VERSION` 的那条线才改它）。
// P43（本线）：**`ask_user_question` 在 TUI 里改成提问弹窗**（问题 + 编号选项 + 一行自定义回答：
// ↑/↓ 选、1-9 直选、space 多选、直接打字 = 自己回答、enter 提交、esc 取消）——
// 不再把问题当 notice 落进转录、让用户去输入行盲打。浮窗画不出来（终端太矮）回落输入行，
// 管道 / 子代理仍是 no answer channel；回答语义（单选 custom 排他、多选两者都带、跳过 = 空
// selected、取消 ≠ 渠道不通）对齐 DSH 的 `ask_user_question`。版本串 `p43-ask` —— 与 README §1.1 同一套记法。
// P45（本线）：**提问弹窗的框宽自适应内容** —— 以前无论问题多短都撑满 78 列（P43 沿用
// reader 的宽度档），短问题（「选哪个？」+ 两个短选项）一半是留白、窄终端还会被压到 24 列。
// 现在按「标题 / 问题 / 编号选项 / 自定义行」的**显示列宽**算出内容宽度，夹在
// [TUI_ASK_MIN_W=34, 终端宽 - 6] 之间（上限本来写死 min(78, …)，见下面那条修复）；
// 提示行与自定义占位**不撑框**，框小了就按 full → mid → min 降级改文案（绝不吃掉
// `esc 取消` 这类关键键）。版本串 `p45-askw`。
// 踩坑 81（修复，不占阶段号）：**提问弹窗的长内容 / 多行内容不再跑出框外**。三个根因：
// ① 内容里的 '\n' 被原样画进「帧里的一行」（终端拆行 ⇒ 后一行从第 0 列开始、方框右边框错位；
// 标题那时**根本没清洗**，ESC 也能进帧）；② 宽度上限写死 78（宽终端上长问题也只画到 78 列）；
// ③ 问题正文只画一行。修法：`tui_clean_line_into`（单行清洗，'\n' → 空格）覆盖 ask 的
// 标题/问题/选项/自定义行与共享的标题/prompt 槽位；上限改成「终端宽 - TUI_ASK_EDGE_W」；
// 问题按框宽折行、多行全画（放不下时末行补 '…'）。判据是新增不变量 `tui_rows_have_lf()`
// （帧里不许有行内换行）；细节与六条防假绿对照实验见 §16 踩坑 81。
// P46（并行线，**现已并入**）：**`/watch` 的现役清单选中即跟随** —— 裸 `/watch` 开的清单以前借
// `/tasks` 的 `TUI_OVK_TASKS` kind（接收端是「纯查看」语义），回车交出来的行没人接、被静默丢掉；
// 现在换成自己的 `TUI_OVK_WATCH_LIST` + 收结果的两条分支（主循环与泵点；选中行 →
// `watch_line_id` 取编号 → 开始跟随），游标默认落在第一个代理行；`agent_cmd_watch` 的返回值
// 改成落点码（LIST/STARTED/STOPPED/BAD），BAD/STOPPED 在 TUI 里落 notice（以前 `/watch sub-9`、
// `/watch off` 都是一片静默）；带参数的 `/watch sub-N` 进只读集合，泵点上当场派发
// （回合运行中敲它不再等 step 边界、也不再被当成给模型的文本）。那条线自己的验收串是
// `p46-wpick`，并进来仍记 **P46**（它的编号是主线早就给它留着的）。
// P47（本线）：**TUI 的 markdown 渲染** —— 块级（标题分级 / 引用 / 三种列表 / 任务清单 /
// 分隔线 / 围栏代码块带语言标签 / GFM 表格）+ 行内（粗体 / 斜体 / 删除线 / `code` / 链接）。
// 一并修掉旧的 markdown-lite 两处硬伤：① 折行宽度（`cols - 6`）与绘制预算（`cols - 7`）
// 各算一份 ⇒ 长行**静默丢 1–3 个字符**再补 `…`（实测 60/80/100 列下 100 字符代码行只显示
// 97 个）；② 样式靠帧级全局 `g_md_code` ⇒ 滚到代码块中间就串样式。新实现把「前缀 + 内容」
// 放进同一条折行流，并把样式**逐字节**落在可见文本上（src/mdview.uya），于是滚到哪儿都对。
// 编号说明：P46 被并行线 `dsh/63ce84e4ffa3` 先占了，按「后到的顺延」记成 **P47**，
// 版本串 `p47-md` —— 与 README §1.1 同一套记法。
// P48（本线）：**会话标题可在执行过程中修改** —— `/title <新标题>` / `/title clear` /
// 模型自己调 `set_title` / 自动起标题（每个新的人类消息后跑一次侧路请求，把标题换成
// 模型给的，kind=provider）。标题被显式写过就**钉住**（kind=user），自动起标题不再动它。
// 编号说明：P46 被 `dsh/63ce84e4ffa3`（/watch 现役清单）与 markdown 那条线先后占了，
// 按「后到的顺延」记成 **P48**，版本串 `p48-title` —— 与 README §1.1 同一套记法。
// ⚠ 长度常量必须跟着版本串一起改（P30 那条线在这儿踩过，见上面）：`p48-title` 是 9 字节。
// P49（并行线，**现已并入**）：**残留 worktree 的回收** —— 会话退出时回收自己那个「确定的垃圾」worktree
// （干净 + 零提交 + 没人在用），外加 `/worktree reclaim` / 工具动作 `reclaim` 扫全仓的
// dsh/* 残留：先收目录还在的（worktree list），再收「目录已没、只剩分支」的孤儿分支
// （for-each-ref refs/heads/dsh/，判据只有零提交）—— 后者才是真机残留的大头
// （清完 14 个目录之后还剩 25 条）。没验完的活（有改动 / 有提交）一律留着。
// 详见 src/worktreex.uya 那一节。那条线自己的验收串是 `p49-reclaim`。
// ⚠ 长度常量必须跟着版本串一起改（P30 那条线在这儿踩过，见上面）：`p49-reclaim` 是 11 字节。
// ⚠ 长度常量必须跟着版本串一起改（P30 那条线在这儿踩过，见上面）：`p52-paste` 是 9 字节。
// P50–P52（并行线，**现已并入**）：**剪贴板粘贴（多行文本 + 图片）** —— 三件事：
//   P50 修「括起粘贴从未生效」（`tui_esc_final` 内部置 5 之后被调用点无条件清零，
//       于是粘多行逐行提交、TAB 变成 plan 开关；见 §16 踩坑 83）；
//   P51 图片附件（`/image` 挂图 → 内联 base64 进请求 → 日志/恢复，src/imgx.uya）；
//   P52 `ctrl+v` / `/paste` 贴剪贴板（纯 Uya 的 X11 客户端，src/clipx.uya）。
// 编号说明：P49 被并行线（worktree 残留回收）先占了，按「后到的顺延」记成 P50–P52。
// ⚠ 长度常量必须跟着版本串一起改（P30 那条线在这儿踩过，见上面）：`p52-paste` 是 9 字节。
// P53（本线）：**浮层全屏**（`ctrl+f` / `F11` / `/fullscreen [on|off]`）—— 浮层把**转录区**
// 用满（宽 = 终端列数、高 = panel_top、左上角 = (0,0)），刻意**不吃**面板 / 状态区 / 脚注：
// 输入行是常驻的打字目标（踩坑 66），状态区是「分不清在跑还是卡住」时唯一要看的那一眼（P18）。
// 一并把浮层几何收成**一个**函数（tui_ov_box_w 的四个出参）—— 在这之前宽/高/左上角在四份绘制里
// 各写了一遍（列表型 / reader / ask / input），全屏要动就得改四处、漏一处就是右边框参差
// （踩坑 42 那一族）。非全屏路径**逐字节返回本线之前的结果**（`--tui-demo` 前六屏只差版本串）。
// 全屏**不碰** fail-closed 判据（tui_overlay_available / tui_reader_fits / ask 的太矮回落 /
// tui_overlay_diff_fits）—— 全屏只改「画出来多大」，不改「能不能画」。
// 编号说明：P50–P52 被并行线（剪贴板粘贴那条）先占了，按「后到的顺延」记成 **P53**；
// 版本串 `p53-full` —— 与 README §1.1 同一套记法。
// P54（本线）：**退化响应的证据 + 同一步重发一次**。空回复分支以前只打一句
// "model returned neither content nor tool_calls"、日志里只剩一条 content="" 的
// assistant/message —— 事后分不清「上游说 stop」还是「tool_calls 丢了」。现在：
//   ① 证据一次给全（finish / have_finish / bad_finish 原文、reasoning 字节数、usage、
//      本次请求体量与 prompt token 读数），并且**两边都留**：转录一行 + `llm/degenerate` 事件；
//   ② 退化响应（正常收尾但既没正文也没工具调用）**同一步重发一次**，额度每步一次，
//      形状对齐 DSH 的 `agent/request-error` → `{kind:"retry"}`（compaction-basic 接
//      context-overflow 走的就是这条通道）；重发不动历史，所以请求体逐字节相同；
//   ③ 退化那一步**不留 assistant/message、不计统计**（没有产出，硬记一条空的 assistant
//      消息只会让「退化」和「模型真回了空串」在日志里长得一样）。
// 版本串 `p54-empty` —— 与 README §1.1 同一套记法。
// P57（本线）：**命令弹窗的循环选择 + 已输入文本显示**。两件事都是「列表型浮窗」的
// 基本手感问题，各有一条明确的症状：
//   ① **循环选择**：`↑` 在第一项再按、`↓` 在最后一项再按，以前都是**没反应**
//      （`tui_ov_sel_move` 对 `[0, n-1]` 夹取）。命令面板动辄二三十条，走到头之后再按
//      一下不动，用户会以为卡住。现在 `↑`/`↓` 越界**回绕**；而 `Home`/`End`/`PgUp`/`PgDn`
//      **仍旧夹取** —— 它们的语义是「跳到那一头 / 翻一屏」，若也回绕，`Home` 的 delta 是
//      `-n`、绕一次正好回原位（等于空操作）。所以判据只能是**按键**：`tui_ov_sel_move`
//      的入参从 `delta` 改成按键事件。刻意不按 `|delta| == 1` 猜 —— 框里只放得下一行时
//      `PgUp`/`PgDn` 的步长也是 ±1，会被误判成「走一步」（自测 F 段有一条专门钉它的判别腿）。
//   ② **已输入文本显示**：敲进命令面板的字符只进 `g_tui_ov_filter`（过滤是生效的），
//      但屏幕上一个字节都不显示 —— 用户只能**盲打盲删**。现在把过滤词画在标题栏上
//      （`╭─ 命令 › stat▌ ──╮`）：非空才画，长词保留尾部（最新敲的字优先、前面补 `…`），
//      框太窄时整段让位给标题（绝不顶破边框）；进帧的文本走**单行清洗**（与踩坑 81 同一份
//      口径：`\n` → 空格、ESC → `␛`、控制字节 → `·`、TAB → 四个空格），过滤缓冲本身
//      一个字节不动（匹配与「无匹配还回输入行」用的都是原始字节）。
// 编号说明：P55/P56 被并行线先占了，按「后到的顺延」记成 **P57**；
// P58（goal 续跑驱动器）记在下方 goal 那一段的注释里；
// P59（max_tokens 截断的收口：正文进历史 + warning + 退出码 5）记在 §5.4.1 与 `agent_finish_step` 里。
// 版本串 `p59-max-tokens` —— 与 README §1.1 同一套记法。
const AGENT_VERSION: [byte: 16] = [112, 53, 57, 45, 109, 97, 120, 45, 116, 111, 107, 101, 110, 115, 0, 0];   // "p59-max-tokens"
const AGENT_VERSION_LEN: usize = 14;
// 解析 `--color=` 的取值：auto / always / never / 16 / 256。
// 认不出按 `auto`（同时认 `NO_COLOR`）。
fn agent_parse_color(p: &byte) u8 {
    // auto / always / never / 16 / 256
    if bufx_cstr_len(p) == 4 && bufx_eq_cstr(p, 4, "auto") {
        return 0;
    }
    if bufx_cstr_len(p) == 6 && bufx_eq_cstr(p, 6, "always") {
        return 1;
    }
    if bufx_cstr_len(p) == 5 && bufx_eq_cstr(p, 5, "never") {
        return 2;
    }
    if bufx_cstr_len(p) == 2 && bufx_eq_cstr(p, 2, "16") {
        return 3;
    }
    if bufx_cstr_len(p) == 3 && bufx_eq_cstr(p, 3, "256") {
        return 4;
    }
    return 0;
}

// 该不该上色：`auto` 看是不是 TTY（`always`/`never` 直接决定）。
fn agent_color_on(cfg: &const Config) bool {
    if cfg.color_mode == 2 {
        return false;
    }
    if cfg.color_mode == 1 || cfg.color_mode == 3 || cfg.color_mode == 4 {
        return true;
    }
    // auto：NO_COLOR 优先；TERM=dumb 无色
    if env_present("NO_COLOR" as &const byte) {
        return false;
    }
    const t: &byte = getenv("TERM");
    if (t as usize) != 0 && bufx_cstr_len(t) == 4 && bufx_eq_cstr(t, 4, "dumb") {
        return false;
    }
    return true;
}

// 能不能用 256 色（`--color=256`，否则 16 色）。
fn agent_color_256(cfg: &const Config) bool {
    if cfg.color_mode == 3 {
        return false;
    }
    if cfg.color_mode == 4 {
        return true;
    }
    const ct: &byte = getenv("COLORTERM");
    if (ct as usize) != 0 && bufx_cstr_len(ct) > 0 {
        return true;
    }
    const t: &byte = getenv("TERM");
    if (t as usize) != 0 && bufx_cstr_len(t) > 0 {
        // xterm-256color / screen-256color / tmux-256color …
        var i: usize = 0;
        const n: usize = bufx_cstr_len(t);
        while i + 4 <= n {
            if bufx_eq_cstr(t + i, 4, "256c") {
                return true;
            }
            i = i + 1;
        }
    }
    return false;
}

// 从 base_url 猜一个短 provider 名（面板信息行用）：去掉 scheme 与 api. 前缀，取第一个点之前
fn agent_provider_short(cfg: &const Config, out: &Buf) void {
    buf_reset(out);
    var p: &const byte = cfg.base_url.ptr as &const byte;
    var n: usize = cfg.base_url.len;
    if n > 8 && bufx_mem_eq(p, "https://" as &const byte, 8) {
        p = p + 8;
        n = n - 8;
    } else if n > 7 && bufx_mem_eq(p, "http://" as &const byte, 7) {
        p = p + 7;
        n = n - 7;
    }
    var end: usize = 0;
    while end < n && p[end] != 47 as byte && p[end] != 58 as byte {
        end = end + 1;
    }
    if end >= 4 && bufx_mem_eq(p, "api." as &const byte, 4) {
        p = p + 4;
        end = end - 4;
    }
    var dot: usize = end;
    var i: usize = 0;
    while i < end {
        if p[i] == 46 as byte {
            dot = i;
            break;
        }
        i = i + 1;
    }
    _ = buf_append(out, p, dot);
}

// 直读 .git/HEAD 取分支名（**不 fork git**）。worktree 里 .git 是文件，内容是 `gitdir: <path>`。
fn agent_git_branch(cwd: &const byte, cn: usize, out: &Buf) void {
    buf_reset(out);
    var path: Buf = buf_new(cn + 64);
    defer { buf_free(&path); }
    _ = buf_append(&path, cwd, cn);
    _ = buf_append_cstr_z(&path, "/.git");
    const fd: i32 = sys_open(path.ptr as *const byte, O_RDONLY as i32, 0) catch { -1; };
    if fd < 0 {
        return;
    }
    var buf: [byte: 512] = [0: 512];
    const n: isize = sys_read(fd, &buf[0], 511) catch { -1 as isize; };
    _ = sys_close(fd) catch {};
    if n <= 0 {
        return;
    }
    const un: usize = n as usize;
    var gitdir: Buf = buf_new(cn + 128);
    defer { buf_free(&gitdir); }
    if un > 8 && bufx_mem_eq(&buf[0], "gitdir: " as &const byte, 8) {
        // .git 是文件：读里面的目录，再读它的 HEAD
        var e: usize = 8;
        while e < un && buf[e] != 10 as byte && buf[e] != 13 as byte {
            e = e + 1;
        }
        if e > 8 {
            if buf[8] == 47 as byte {
                _ = buf_append(&gitdir, &buf[8], e - 8);
            } else {
                _ = buf_append(&gitdir, cwd, cn);
                _ = buf_append_cstr(&gitdir, "/");
                _ = buf_append(&gitdir, &buf[8], e - 8);
            }
        }
        if gitdir.len == 0 {
            return;
        }
        _ = buf_append_cstr_z(&gitdir, "/HEAD");
        const fd2: i32 = sys_open(gitdir.ptr as *const byte, O_RDONLY as i32, 0) catch { -1; };
        if fd2 < 0 {
            return;
        }
        var buf2: [byte: 512] = [0: 512];
        const n2: isize = sys_read(fd2, &buf2[0], 511) catch { -1 as isize; };
        _ = sys_close(fd2) catch {};
        if n2 <= 0 {
            return;
        }
        agent_branch_from_head(&buf2[0], n2 as usize, out);
        return;
    }
    agent_branch_from_head(&buf[0], un, out);
}

// 从 `git rev-parse --abbrev-ref HEAD` 的输出里取分支名写进 out（去掉结尾换行）。
// 失败/空输出时 out 留空 —— 脚注里就少显示一段，不是错误。
fn agent_branch_from_head(p: &const byte, n: usize, out: &Buf) void {
    buf_reset(out);
    var e: usize = 0;
    while e < n && p[e] != 10 as byte && p[e] != 13 as byte {
        e = e + 1;
    }
    if e >= 16 && bufx_mem_eq(p, "ref: refs/heads/" as &const byte, 16) {
        _ = buf_append(out, p + 16, e - 16);
        return;
    }
    if e >= 4 && bufx_mem_eq(p, "ref:" as &const byte, 4) {
        // 其它 ref（detached / 远程）：取最后一段
        var s: usize = 0;
        var i: usize = 0;
        while i < e {
            if p[i] == 47 as byte {
                s = i + 1;
            }
            i = i + 1;
        }
        _ = buf_append(out, p + s, e - s);
        return;
    }
    // HEAD 里直接是 40 位 sha（detached）：显示短 sha
    if e >= 7 {
        _ = buf_append(out, p, 7);
    }
}

// 命令面板的清单（export：TUI 自测要断言「清单里真的有这条命令」，见 tuiselftest 的 tui-tasks 轮）
export fn agent_tui_commands(out: &Buf) void {
    buf_reset(out);
    _ = buf_append_cstr(out, "/help      显示帮助浮层\n");
    _ = buf_append_cstr(out, "/status    当前配置与会话信息\n");
    _ = buf_append_cstr(out, "/tasks     任务状态进度（清单/后台任务/子代理/目标）\n");
    _ = buf_append_cstr(out, "/watch     跟随子代理的实时过程消息（/watch sub-N · /watch off）\n");
    _ = buf_append_cstr(out, "/goal      会话目标（查看/创建/编辑/暂停/恢复/清除）\n");
    _ = buf_append_cstr(out, "/sessions  会话列表（选一个恢复）\n");
    _ = buf_append_cstr(out, "/diff      查看 git 修改（左文件列表 · 右双列全文比对）\n");
    _ = buf_append_cstr(out, "/workspace [目录]  看/切当前会话的工作区（切换记进会话日志）\n");
    _ = buf_append_cstr(out, "/model [名字]  看/切模型（按提供方分组；/effort 管推理强度）\n");
    _ = buf_append_cstr(out, "/effort [档位]  看/切推理强度（只列该模型公布的档位）\n");
    _ = buf_append_cstr(out, "/worktree  Git worktree（独立工作区→合并→删除；reclaim 清残留；裸命令开选择框）\n");
    _ = buf_append_cstr(out, "/title [<新标题>|clear]  看/改会话标题（裸命令让模型起一个建议、填进输入框）\n");
    _ = buf_append_cstr(out, "/new       开一个新会话\n");
    _ = buf_append_cstr(out, "/compact   手动压缩上下文\n");
    _ = buf_append_cstr(out, "/plan      切换计划模式\n");
    _ = buf_append_cstr(out, "/permission 切换访问模式（read-only / workspace-write / danger-full-access）\n");
    _ = buf_append_cstr(out, "/mouse [on|off]  开关鼠标上报（关掉就能拖选复制文本，F2 同效）\n");
    _ = buf_append_cstr(out, "/fullscreen [on|off]  浮层全屏（占满转录区；ctrl+f / F11 同效）\n");
    _ = buf_append_cstr(out, "/image [路径]  挂一张图到下一条消息（PNG / JPEG / GIF / WebP）\n");
    _ = buf_append_cstr(out, "/paste     贴剪贴板（图片挂附件、文本进输入行；ctrl+v 同效）\n");
    _ = buf_append_cstr(out, "/continue  再跑一轮（带着现有历史）\n");
    _ = buf_append_cstr(out, "/exit      退出\n");
}

// ============================================================
// P33/P35：/sessions 的列表排版 —— 三列（标题 / 工作区 / session id）· 时间序 · 宽度自适应
// ============================================================
// 数据源是 sess_index_rows_sorted（索引去重 + lastActiveAt **倒序**：第 0 行最新，
// 每行一条记录原文 —— 这个契约不变，去重与排序归 session.uya）。
//
// P35：**展示顺序翻过来** —— 最新的那条画在**最后一行**（紧挨输入行/提示符，人眼先落在
// 最近用的那个会话上），最旧的回到第一行。数据层不动，只在这里按行倒着排版，
// 所以「同 id 取最后一条」这类被踩坑 51 钉住的逻辑一个字节都没碰。
// 参数 newest_last = true 就是这个展示序；false = 原样（第 0 行在最上，留给需要旧口径的调用方）。
//
// 列宽按「浮层条目能用的显示列数」分配，退化阶梯：
//   三列（标题 + 工作区 + id）→ 两列（丢工作区列）→ 只剩 id。
// 硬约束：**id 在条目文本里永不裁剪**。选中项的 id 是从条目文本里取的，显示层
// （tui_ov_put_clipped）再怎么裁都只是看不见，绝不让 /resume 拿到半个 id。
const SESS_COL_GAP: usize = 2;          // 列间两个空格
const SESS_TITLE_MIN: usize = 6;        // 保留三列时每列的下限
const SESS_TITLE_EMPTY: &const byte = "(无标题)" as &const byte;
const SESS_CWD_EMPTY: &const byte = "(未知)" as &const byte;
const SESS_ID_PREFIX: &const byte = "session-" as &const byte;

// 单元格：清洗（控制字节 / ESC / 半截 UTF-8 都换掉）→ 空则占位 → 按**显示列**裁剪 → 补齐。
// head = true 保头（标题：开头信息量最大，尾巴补 '…'）；
// head = false 保尾（路径：末尾几级目录信息量最大，前面补 '…'）。
fn sess_cell_fill(out: &Buf, src: &const byte, n: usize, width: usize, head: bool, empty_hint: &const byte) void {
    buf_reset(out);
    if width == 0 {
        return;
    }
    var clean: Buf = buf_new(512);
    defer { buf_free(&clean); }
    // 每显示列最多 4 字节（emoji/宽字符），这个上限足够填满列宽；再长的由下面的裁剪兜住
    _ = tty_title_clean_into(&clean, src, n, width * 4 + 16);
    var body: &const byte = clean.ptr as &const byte;
    var blen: usize = clean.len;
    if blen == 0 {
        body = empty_hint;
        blen = bufx_cstr_len(empty_hint);
    }
    // 只有真的超宽才裁；会被裁时先给 '…' 留一列（踩坑 42 的口径：省略号不能画到预算外面去）。
    // width == 1 时没有余量画 '…'（画了就超宽），只留一列。
    var keep: usize = blen;
    var cut: bool = false;
    if blen > 0 && tty_cols_between(body, 0, blen) > width {
        if width > 1 {
            if head {
                keep = tty_clip_bytes(body, blen, width - 1);
            } else {
                keep = tty_clip_tail_bytes(body, blen, width - 1);
            }
            cut = true;
        } else {
            keep = tty_clip_bytes(body, blen, width);
        }
    }
    if cut && !head {
        _ = buf_append_cstr(out, "…");
    }
    if head {
        _ = buf_append(out, body, keep);
    } else {
        _ = buf_append(out, body + (blen - keep), keep);
    }
    if cut && head {
        _ = buf_append_cstr(out, "…");
    }
    // 补齐到列宽：后面那条列（以及行尾的 id）才在同一列上
    var used: usize = tty_cols_between(out.ptr as &const byte, 0, out.len);
    while used < width {
        _ = buf_append_byte(out, 32);
        used = used + 1;
    }
}

// 索引记录原文（每行一条，'\n' 分隔）→ 三列表
fn sess_rows_render(rows: &Buf, body_cols: usize, out: &Buf, newest_last: bool) void {
    buf_reset(out);
    if rows.len == 0 || body_cols == 0 {
        return;
    }
    // 1) 量 id 列宽（同一份索引里 id 等长，取最长的那条更稳）并数出有效行数
    var id_col: usize = 0;
    var cnt: usize = 0;
    var id: Buf = buf_new(128);
    defer { buf_free(&id); }
    // ⚠ 每行先拷进 scratch 再解析：uya 的 `p[a: b]` 是「偏移 + 长度」，`p[i: i+ll]`
    // 会拿到 `i+ll` 字节的窗口（越读到后面几行；见 §16 踩坑 51）
    var scratch: Buf = buf_new(4096);
    defer { buf_free(&scratch); }
    var i: usize = 0;
    while i < rows.len {
        var e: usize = i;
        while e < rows.len && rows.ptr[e] != 10 as byte {
            e = e + 1;
        }
        const ll: usize = e - i;
        if ll > 0 {
            buf_reset(&scratch);
            _ = buf_append(&scratch, rows.ptr + i, ll);
        }
        if ll > 0 && sess_json_str(scratch.ptr[0: scratch.len], "id", &id) && id.len > 0 {
            const w: usize = tty_cols_between(id.ptr as &const byte, 0, id.len);
            if w > id_col {
                id_col = w;
            }
            cnt = cnt + 1;
        }
        i = e + 1;
    }
    if cnt == 0 || id_col == 0 {
        return;
    }
    // 2) 列宽分配（先留 id 与列间空格，剩下的给标题/工作区；不够就逐级退化）
    //    行宽 = 标题 + 2 空格 [+ 工作区 + 2 空格] + id —— **两个**列间间隔都要算进去，
    //    只扣一个的话每行会正好超宽 2 列（实测：80 列终端上 id 尾巴被裁掉）。
    //    退化阶梯（都要求每一列至少 SESS_TITLE_MIN 列，否则那一列不如不画）：
    //      body >= id+8  三列；body >= id+8-2*? 两列（丢工作区）；再窄就只剩 id。
    var title_w: usize = 0;
    var ws_w: usize = 0;
    if body_cols > id_col + SESS_COL_GAP * 2 {
        const three: usize = body_cols - id_col - SESS_COL_GAP * 2;   // 三列时标题+工作区的份额
        if three >= SESS_TITLE_MIN * 2 {
            ws_w = three / 2;              // 三列：工作区分一半（向下取整）
            title_w = three - ws_w;
        }
    }
    if title_w == 0 && body_cols > id_col + SESS_COL_GAP {
        const two: usize = body_cols - id_col - SESS_COL_GAP;         // 两列时标题的份额
        if two >= SESS_TITLE_MIN {
            title_w = two;                 // 两列：丢工作区列
        }
    }
    // 3) 排版：`<标题列><2 空格>[<工作区列><2 空格>]<id>`
    //
    // P35：定位每一行的字节区间；newest_last = true 时**从最后一行往回**画
    // （最新的在最后一行）。用「区间倒着取」而不是「先画到临时缓冲再整段倒序」：
    // 少一次整表拷贝，也免得再写一个按行倒排的辅助函数。
    var title: Buf = buf_new(512);
    defer { buf_free(&title); }
    var ws: Buf = buf_new(1024);
    defer { buf_free(&ws); }
    var ttl: Buf = buf_new(512);
    defer { buf_free(&ttl); }
    var cwd: Buf = buf_new(2048);
    defer { buf_free(&cwd); }
    // 行区间表（行数最多几百，一次分配足够）
    var lo_arr: &usize = malloc((cnt + 1) * @size_of(usize) as usize) as &usize;
    var ll_arr: &usize = malloc((cnt + 1) * @size_of(usize) as usize) as &usize;
    if ((lo_arr as usize) == 0) || ((ll_arr as usize) == 0) {
        if (lo_arr as usize) != 0 {
            free(lo_arr as &void);
        }
        if (ll_arr as usize) != 0 {
            free(ll_arr as &void);
        }
        return;
    }
    defer {
        free(lo_arr as &void);
        free(ll_arr as &void);
    }
    var nrows: usize = 0;
    i = 0;
    while i < rows.len {
        var e: usize = i;
        while e < rows.len && rows.ptr[e] != 10 as byte {
            e = e + 1;
        }
        const lo0: usize = i;
        const ll0: usize = e - i;
        i = e + 1;
        if ll0 == 0 {
            continue;
        }
        lo_arr[nrows] = lo0;
        ll_arr[nrows] = ll0;
        nrows = nrows + 1;
    }
    var k: usize = 0;
    while k < nrows {
        // 第 k 个画出来的行：旧口径 = 第 0 行（最新的）；新口径 = 最后一行
        const src_i: usize = if newest_last { nrows - 1 - k } else { k };
        const lo: usize = lo_arr[src_i];
        const ll: usize = ll_arr[src_i];
        buf_reset(&scratch);
        if !buf_append(&scratch, rows.ptr + lo, ll) {
            k = k + 1;
            continue;
        }
        if !sess_json_str(scratch.ptr[0: scratch.len], "id", &id) || id.len == 0 {
            k = k + 1;
            continue;
        }
        if title_w > 0 {
            _ = sess_json_str(scratch.ptr[0: scratch.len], "title", &ttl);
            sess_cell_fill(&title, ttl.ptr as &const byte, ttl.len, title_w, true, SESS_TITLE_EMPTY);
            _ = buf_append(out, title.ptr, title.len);
            if ws_w > 0 {
                _ = sess_json_str(scratch.ptr[0: scratch.len], "cwd", &cwd);
                sess_cell_fill(&ws, cwd.ptr as &const byte, cwd.len, ws_w, false, SESS_CWD_EMPTY);
                _ = buf_append_cstr(out, "  ");   // SESS_COL_GAP
                _ = buf_append(out, ws.ptr, ws.len);
            }
            _ = buf_append_cstr(out, "  ");       // SESS_COL_GAP
        }
        _ = buf_append(out, id.ptr, id.len);
        _ = buf_append_byte(out, 10);
        k = k + 1;
    }
}

// 读索引 → 三列排版（浮层与 --list-sessions / 滚动模式共用这一份）
fn agent_sess_list_items(cfg: &const Config, body_cols: usize, out: &Buf) void {
    buf_reset(out);
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) {
        return;
    }
    var hz: Buf = buf_new(home.len + 1);
    defer { buf_free(&hz); }
    _ = buf_append(&hz, home.ptr, home.len);
    _ = buf_append_byte(&hz, 0);
    var rows: Buf = buf_new(65536);
    defer { buf_free(&rows); }
    if !sess_index_rows_sorted(hz.ptr as &const byte, &rows) {
        return;
    }
    // P35：最新的排最后一行（浮层与滚动模式都吃这一份）
    sess_rows_render(&rows, body_cols, out, true);
}

// 行级硬裁（**只给滚动模式 / --list-sessions 用**）：每行最多 body_cols 显示列，裁了就补 '…'。
// TUI 不需要它 —— 浮层画的时候 tui_ov_put_clipped 会按箱体宽度裁（条目文本里那份 id
// 必须保持完整，选中项就是靠它 /resume 的）。
// 为什么非裁不可：列窄到放不下 id 时（只剩 id 列）行宽就是 id 的 44 列，
// 直接打到 40 列的终端上会折行；而且**半个 id 抄去 /resume 一定失败**，
// 补一个 '…' 至少让人看出「这里被裁过，去 TUI 里复制」。
fn sess_rows_clip_into(src: &Buf, body_cols: usize, out: &Buf) void {
    buf_reset(out);
    if body_cols == 0 {
        return;
    }
    var i: usize = 0;
    while i < src.len {
        var e: usize = i;
        while e < src.len && src.ptr[e] != 10 as byte {
            e = e + 1;
        }
        const lo: usize = i;
        const ll: usize = e - i;
        i = e + 1;
        if ll == 0 {
            continue;
        }
        var keep: usize = ll;
        // 只有真的超宽才裁：三列/两列排版本就是**正好** body_cols 列（补齐到列宽），
        // 无条件预留 '…' 会把本来放得下的 id 也截掉（实测踩过一次）。
        const cols: usize = tty_cols_between(src.ptr + lo, 0, ll);
        if cols > body_cols {
            if body_cols > 1 {
                keep = tty_clip_bytes(src.ptr + lo, ll, body_cols - 1);   // 给 '…' 留一列
            } else {
                keep = tty_clip_bytes(src.ptr + lo, ll, body_cols);
            }
        }
        _ = buf_append(out, src.ptr + lo, keep);
        if keep < ll {
            _ = buf_append_cstr(out, "…");
        }
        _ = buf_append_byte(out, 10);
    }
}

// 浮层选中的条目 → 取出首段（会话 id / 命令名）
// ============================================================
// P26：plan 模式的用户侧切换入口（tab / `/plan` 共用）
// 模型自己走 exit_plan_mode 那条路不进这里（它的工具结果就是模式变化的说明）。
// 切换后立刻推一份新快照：会话中途切模式，模型必须下一轮就知道
// （system prompt 与首份运行时上下文都只在会话开始时装配/注入一次）。
// ============================================================
export fn agent_plan_apply(cfg: &const Config, h: &History, on: bool) void {
    if on == g_plan.active {
        return;
    }
    agent_plan_force(on);
    agent_plan_snapshot_sync(cfg, h);
}

// 进程级 plan 状态的直接置位（plan_set 里已经同步了 TUI 的 Plan chip）。
// 自测轮之间必须显式复位：fork 出来的子进程会继承这份状态。
export fn agent_plan_force(on: bool) void {
    plan_set(&g_plan, on);
}

// ============================================================
// P21：访问模式（切换 = 改策略 + 同步守卫 + 更新 chip + 给模型推一份新快照 + 落日志）
// ============================================================
export fn agent_set_access(cfg: &Config, h: &History, mode: u8, announce: bool) void {
    if !perm_known(mode) || mode == perm_get() {
        return;
    }
    perm_set(mode);
    cfg.access = mode;   // 配置里的当前值也要跟上：运行时上下文那句策略就是按它生成的
    g_fsctx.confine = perm_confine();   // fsctx_init 只在会话开始跑，运行中切换必须自己同步
    tui_set_access(mode);
    // 模型可见面：新快照自称「supersedes earlier snapshots」（与 DSH 同语义）。
    // 前缀里必须留着 "Current runtime context"，否则 TUI 会把它当成假用户条目打出来。
    var rctx: Buf = buf_new(2048);
    defer { buf_free(&rctx); }
    if prompt_runtime_context(cfg, g_plan.active, &rctx) && rctx.len > 0 {
        var pushed: bool = hist_push(h, ROLE_USER, rctx.ptr as &const byte, rctx.len);
        while !pushed {
            if !hist_drop_oldest(h) {
                break;
            }
            pushed = hist_push(h, ROLE_USER, rctx.ptr as &const byte, rctx.len);
        }
    }
    var pl: Buf = buf_new(64);
    defer { buf_free(&pl); }
    _ = buf_append_cstr(&pl, "{\"mode\":\"");
    _ = buf_append_cstr(&pl, perm_name(mode));
    _ = buf_append_cstr(&pl, "\"}");
    _ = buf_append_byte(&pl, 0);   // agent_log_simple 收的是 C 字符串
    agent_log_simple("permission/mode", pl.ptr as &const byte);
    if announce {
        tui_add_notice(perm_notice(mode), bufx_cstr_len(perm_notice(mode)));
    }
}

// 打开访问模式选择器（shift+tab 与裸 /permission 共用）
export fn agent_tui_access_open() void {
    const items: Buf = agent_tui_access_items();
    defer { buf_free(&items); }
    const title: &const byte = "访问模式（enter 切换 · esc 取消）" as &const byte;
    tui_overlay_menu(TUI_OVK_ACCESS, title, bufx_cstr_len(title),
        items.ptr as &const byte, items.len, perm_get() as usize);
}

// 浮层条目：`✓` 标当前模式（游标另用反显，两回事），后面跟一行短说明
// 一个模式在浮层里那一行的原文（生成与反解共用同一份，别写两遍）
fn agent_tui_access_line(m: u8, out: &Buf) void {
    buf_reset(out);
    if m == perm_get() {
        _ = buf_append_cstr(out, "✓ ");
    } else {
        _ = buf_append_cstr(out, "  ");
    }
    _ = buf_append_cstr(out, perm_label(m));
    var pad: usize = bufx_cstr_len(perm_label(m));
    while pad < 17 {
        _ = buf_append_byte(out, 32);
        pad = pad + 1;
    }
    _ = buf_append_cstr(out, "— ");
    _ = buf_append_cstr(out, perm_gloss(m));
}

// 浮层条目：`✓` 标当前模式（游标另用反显，两回事），后面跟一行短说明
fn agent_tui_access_items() Buf {
    var out: Buf = buf_new(512);
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    var m: u8 = 0;
    while m <= PERM_FULL_ACCESS {
        agent_tui_access_line(m, &line);
        _ = buf_append(&out, line.ptr, line.len);
        _ = buf_append_byte(&out, 10);
        if m == PERM_FULL_ACCESS {
            break;
        }
        m = m + 1;
    }
    return out;
}

// 把浮层选中那一行反解成模式；-1 = 不是我们认识的条目
fn agent_tui_access_parse(sel: &const Buf) i32 {
    var line: Buf = buf_new(256);
    defer { buf_free(&line); }
    var m: u8 = 0;
    while m <= PERM_FULL_ACCESS {
        agent_tui_access_line(m, &line);
        if bufx_mem_eq(sel.ptr as &const byte, line.ptr as &const byte, sel.len) && sel.len == line.len {
            return m as i32;
        }
        if m == PERM_FULL_ACCESS {
            break;
        }
        m = m + 1;
    }
    return -1;
}

// 消费「访问模式」浮层的结果（TUI 主循环与自测共用）。
// 返回 true = 这次真的处理了一个浮层结果（调用方继续下一轮）。
export fn agent_tui_access_handle(cfg: &Config, h: &History, sel: &const Buf) bool {
    const kind: u8 = tui_overlay_kind();
    if kind == TUI_OVK_ACCESS {
        // 浮层给回来的是「那一行的原文」（带 ✓ 与短说明），所以按行反解；
        // 机器名（perm_from_name）是命令行那条路径用的。
        const m: i32 = agent_tui_access_parse(sel);
        if m < 0 {
            return true;
        }
        if m as u8 == PERM_FULL_ACCESS {
            // 对齐 DSH 的 RiskConfirmation：选定不生效，先过一道风险确认（游标默认停在取消）
            const prompt: &const byte = "启用后不再询问：agent 可以直接改文件、跑任意命令（含关闭文件沙箱）。仅建议在你信任当前任务时使用。" as &const byte;
            const items: &const byte = "启用 Full access\n取消\n" as &const byte;
            const ctitle: &const byte = "确认启用 Full access？" as &const byte;
            tui_overlay_menu_confirm(TUI_OVK_ACCESS_CONFIRM, ctitle, bufx_cstr_len(ctitle),
                prompt, bufx_cstr_len(prompt), items, bufx_cstr_len(items), 1);
            return true;
        }
        agent_set_access(cfg, h, m as u8, true);
        return true;
    }
    if kind == TUI_OVK_ACCESS_CONFIRM {
        if bufx_eq_cstr(sel.ptr as &const byte, sel.len, "启用 Full access" as &const byte) {
            agent_set_access(cfg, h, PERM_FULL_ACCESS, true);
        }
        return true;
    }
    return false;
}

// 从一条面板/清单条目里取下标的**首段**（面板栏与清单用同一套编号口径）。
fn agent_tui_item_head(line: &const Buf, out: &Buf) void {
    buf_reset(out);
    var i: usize = 0;
    while i < line.len {
        const c: byte = line.ptr[i];
        if c == 32 as byte || c == 9 as byte {
            break;
        }
        _ = buf_append_byte(out, c);
        i = i + 1;
    }
}

// P33：会话浮层选中项 → session id。
// 条目是三列（标题 | 工作区 | session id），**id 永远在行尾**，第一列反而是标题 ——
// 所以这里不能再用 agent_tui_item_head（它取行首那个词 = 标题），否则 /resume 会拿着
// 标题去查会话（见 §16 踩坑 50）。行尾那个词必须以 `session-` 开头才算数；
// 认不出来就交回空串，由调用方给一条可见提示 —— 绝不猜。
fn agent_tui_sessions_head(line: &const Buf, out: &Buf) void {
    buf_reset(out);
    var e: usize = line.len;
    while e > 0 && (line.ptr[e - 1] == 32 as byte || line.ptr[e - 1] == 9 as byte) {
        e = e - 1;
    }
    var s: usize = e;
    while s > 0 && line.ptr[s - 1] != 32 as byte && line.ptr[s - 1] != 9 as byte {
        s = s - 1;
    }
    if e <= s {
        return;
    }
    const pn: usize = bufx_cstr_len(SESS_ID_PREFIX);
    if e - s <= pn || !bufx_mem_eq(line.ptr + s, SESS_ID_PREFIX, pn) {
        return;
    }
    _ = buf_append(out, line.ptr + s, e - s);
}

// /diff（P25）：打开 git 修改浮窗（左文件列表 + 右旧/新两栏全文比对）。
// 三种「开不了」都留下可见的话：不是 git 仓库 / 找不到 git（gd_error）、没有修改、
// 终端太小（放不下就不开 —— 画不出来却吞键是老坑）。只读：不套沙箱、不走审批。
fn agent_diff_open(cfg: &const Config) void {
    const rc: i32 = gd_open(cfg.workspace.ptr as &const byte, cfg.workspace.len);
    if rc < 0 {
        const e: &const Buf = gd_error();
        tui_add_notice(e.ptr as &const byte, e.len);
        return;
    }
    if gd_file_count() == 0 {
        const none: &const byte = "(没有 git 修改)" as &const byte;
        tui_add_notice(none, bufx_cstr_len(none));   // 别手数长度：差一个字节就把后面的字节也打进转录
        return;
    }
    if !tui_overlay_diff_fits() {
        const small: &const byte = "终端太小：/diff 需要 ≥ 60 列 × 11 行（或用 --no-tui 看单列文本）" as &const byte;
        tui_add_notice(small, bufx_cstr_len(small));
        return;
    }
    tui_overlay_diff_open();
}

// /diff 的滚动模式（非 TUI）回退：单列 unified diff（含文件列表 + 每个文件的改动）
fn agent_diff_print(cfg: &const Config) void {
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    gd_print_text(cfg.workspace.ptr as &const byte, cfg.workspace.len, &out);
    tty_write(&tty_ui, 2, out.ptr as &const byte, out.len);
}


// 命令面板的派发收口（P23）。
//
// 面板是由输入行里的那个 `/` 触发开的，之后敲的字进的是面板过滤器；所以派发时必须
// 把触发用的 `/` 从输入行收走 —— 否则第二次敲 `/status` 会拼成 `//status`，被当成
// 未知命令丢掉，屏幕上就是「/status 没反应」（用户报的正是这一条）。
// 主循环（空闲态）与 step 边界（回合运行中）都走这里，回显与派发只有一份。
// 返回值与 agent_tui_command 同义：true = 该停（`/exit` 在面板里选中也要真退出，
// 主循环据此收工 —— 见踩坑 44）。
fn agent_tui_palette_apply(cfg: &Config, h: &History, sel: &const Buf) bool {
    tui_input_drop_slash_trigger();
    var head: Buf = buf_new(128);
    defer { buf_free(&head); }
    agent_tui_item_head(sel, &head);
    if head.len == 0 {
        return false;
    }
    tui_add_notice(head.ptr as &const byte, head.len);
    return agent_tui_command(cfg, h, &head);
}

// 回合运行中也能安全当场派发的面板命令：只读、不改写也不释放历史。
// 其余命令（/new、/resume 会 hist_free、/compact 会改写历史、/continue 会再跑一轮）
// 必须等回合结束由主循环派发 —— 回合还攥着那份 History。
// 约定：安全集里只能放**不返回「停」**的命令（step 边界的派发点丢掉返回值：回合的
// 收工由主循环统一处理），所以 `/exit` 不在这里。
fn agent_tui_cmd_safe(head: &const Buf) bool {
    if sv_eq_cstr(head, "/status") {
        return true;
    }
    // P25：/tasks 是只读视图（poll 一次 job/deleg + 读一眼 goal.json，不动历史），
    // 也让它在回合运行中当场派发 —— 用户不知道回合跑完了没有
    if sv_eq_cstr(head, "/tasks") {
        return true;
    }
    // P29：裸 /goal 同样是只读（读一眼 goal.json 就开浮层，不写盘也不动历史）。
    // 带参数的 /goal 会改 goal.json：面板项只会交出**裸命令名**，所以这里放行的是
    // 裸那一支；回合里手敲的 `/goal pause` 走 steer → 主循环那条路，不经过这里。
    if sv_eq_cstr(head, "/goal") {
        return true;
    }
    // P26：/diff 同样只读（不改历史、也不返回「停」），回合里可以当场开浮窗
    if sv_eq_cstr(head, "/diff") {
        return true;
    }
    // P34：裸 /workspace 只读（看一眼 cfg.workspace 就打转录，不动历史也不切）；
    // 带参数的 `/workspace <dir>` 会切工作区，走 steer → 主循环那条路，不经过这里
    // （与 /goal 同一条口径：面板项只会交出裸命令名）。
    if sv_eq_cstr(head, "/workspace") {
        return true;
    }
    // P37：裸 /model 与 /effort 只读（看一眼目录就开浮层；选择本身等主循环收口）。
    // 面板项只会交出裸命令名，带参数的那条走 steer → 主循环，不经过这里。
    if sv_eq_cstr(head, "/model") {
        return true;
    }
    if sv_eq_cstr(head, "/effort") {
        return true;
    }
    // P41：裸 /worktree 只**开菜单**（读一眼 wt 状态就画浮层，不动历史、不切工作区、不跑 git）；
    // 动作的执行与 finish/discard 的确认都等主循环收口 —— 与 /model 同一分工。
    if sv_eq_cstr(head, "/worktree") {
        return true;
    }
    // P42：裸 /watch 只读（列一眼现役子代理就开浮层，不动历史也不读日志 ——
    // 真正开始跟随要带 sub-N，那条走 steer → 主循环那条路，不经过这里）。
    // P46：带参数的 `/watch sub-N` 同样是只读（只读子代理的会话日志 + 开浮层，一个字节都不
    // 写历史），所以它也要能在回合运行中**当场**生效 —— 用户本来就是趁子代理在跑的时候想看
    // 它，那一句要是等整个回合结束才派发，屏幕上就是「敲了没反应」。
    // 只在 head 上匹配（`/watch sub-1` 整行也能进这条）：它不会顺带放行改历史的命令
    // （`/goal pause` 那种走的是另一条判断）。
    if sv_eq_cstr(head, "/watch") || arg_starts_with(head.ptr as &const byte, "/watch ") {
        return true;
    }
    if sv_eq_cstr(head, "/help") {
        return true;
    }
    // 踩坑 72：/mouse 只往终端写一条鼠标开关序列 + 一条 notice（不动历史、不返回「停」），
    // 所以回合运行中也能当场派发 —— 用户随时能把拖选复制打开。
    if sv_eq_cstr(head, "/mouse") {
        return true;
    }
    // P53：/fullscreen 只翻一个**显示开关** + 一条 notice（不动历史、不返回「停」）——
    // 与 /mouse 同一条口径。它必须在只读集合里：正看着 /watch 或 /status 时想放大，
    // 那时回合多半正在跑，等 step 边界就等于「按了没反应」。
    // 带参数的形态也放行（`/fullscreen off` 同样只动显示态）——与 /watch 那条同样在 head 上匹配。
    if sv_eq_cstr(head, "/fullscreen") || arg_starts_with(head.ptr as &const byte, "/fullscreen ") {
        return true;
    }
    if sv_eq_cstr(head, "/sessions") {
        return true;
    }
    return false;
}

// 回合运行中：step 边界（agent_turn_loop_inner 里、agent_claim_steer 之后）看一眼
// 面板刚交回的结果。安全命令当场派发（/status 在回合里就能看），不安全的原样留在
// 待取队列里给主循环 —— 非 TUI 模式是空操作。
// ============================================================
// P30：泵点上下文与统一泵点
//
// 为什么需要它：P23 之前「运行中的只读命令」只有 **step 边界** 一个派发点，而一个 step
// 可能长达几分钟（长流式 / 长 bash），用户敲 /status 十几秒没动静 —— 看着就是卡死。
// P30 把派发点铺到**每个泵点**（流式每 ≤50ms 一次、bash/jobs/deleg/search/workflow 的
// 轮询循环各一次），并把「历史类命令」的落点写清楚（见 agent_tui_poll_pending_cmd）。
//
// 泵点上下文只用在本线程（没有跨线程共享），所以在回合入口登记一次、出口清掉即可。
// ============================================================

var g_pump_cfg: &const Config = null as &const Config;
var g_pump_hist: &const History = null as &const History;

// P31：主循环里跑的 `/` 命令也可能**发起请求**（空闲时敲 /compact → 摘要请求）。请求在飞
// 的那段同样要能派发运行中的只读命令，所以命令处理期间也把泵点上下文登记上（与回合入口
// 同一份全局）。`h` 是主循环自己的局部变量，`/new`、`/resume` 都是原地重置它，指针不悬垂。
fn agent_pump_ctx_begin(cfg: &const Config, h: &const History) void {
    g_pump_cfg = cfg;
    g_pump_hist = h;
}

// 撤销 `agent_pump_ctx_begin` 登记的泵点上下文（回合结束时调）。
// 不撤的话下一回合的泵点会拿到**已经 free 的** cfg/h。
fn agent_pump_ctx_end(cfg: &const Config) void {
    if g_pump_cfg == cfg as &const Config {
        g_pump_cfg = null as &const Config;
        g_pump_hist = null as &const History;
    }
}

// 阻塞循环里的统一泵点（P30 与 P28「退不出」那条线合流后的口径）：
//   1) `tui_abort_check()`：用户意图优先 —— 读键/刷帧，返回中止意图（P28 加的）；
//   2) 命令派发：运行中在面板里选中 /status 之类**当场生效**（P30）；
//   3) P46：运行中**刚敲完回车**的那一行，只读命令也当场生效（见 agent_pump_submitted_cmd）。
// 返回中止意图给调用方（bash/jobs/deleg/search/workflow 各自决定怎么收场）。
fn agent_pump_block() i32 {
    // P46：后台请求（自动起标题）**不读键盘、也不派发命令** —— 用户根本不知道它在飞，
    // 那几秒里敲的字一个都不该被它取走（连 `/` 被吞掉都不行：剩下的 `status` 会与
    // 后面那个 `/` 拼成 `//status`，屏幕上就是「未知命令」，p30-check 抓到过）。
    // 后台请求的泵点只做「别让界面冻住」那一半：刷帧 + watch 跟随。
    if g_bg_request {
        _ = tui_tick(tui_now_ms());
        _ = agent_watch_tick_if_active();
        return TUI_ABORT_NONE;
    }
    const ab: i32 = tui_abort_check();
    if g_pump_cfg != null as &const Config && g_pump_hist != null as &const History {
        agent_tui_poll_pending_cmd(g_pump_cfg, g_pump_hist);
        agent_pump_submitted_cmd(g_pump_cfg, g_pump_hist);
    }
    // P42：阻塞等待期间也要让 /watch 的跟随继续长（否则等子代理跑完那段时间屏幕是死的）
    _ = agent_watch_tick_if_active();
    return ab;
}

// P46：泵点上收「运行中刚提交的那一行」——只读命令当场派发，别的一律不动队列
// （留给 llm_pump_input：流式循环还要靠 TUI_EV_SUBMIT 把文本推进 steer 收件箱）。
//
// 为什么需要：tui_take_submit 只有两个消费者 —— llm_pump_input（流式开始时）与主循环
// （回合结束时）。而「等响应头」那一段（hc_open 的 poll 泵点）两个都轮不到：实测把网关
// 按住 12 s，期间敲 /watch sub-1 回车，屏上 1.2 s / 5 s / 10 s 都什么都没有，直到回合收工
// 才开出跟随浮层 —— 用户看到的就是「敲了没反应」。只读命令不改历史，当场派发是安全的
// （与 agent_tui_poll_pending_cmd 同一条路）。
fn agent_pump_submitted_cmd(cfg: &const Config, h: &const History) void {
    if !tui_has_submit() {
        return;
    }
    var line: Buf = buf_new(65536);
    defer { buf_free(&line); }
    if !tui_peek_submit(&line) {
        return;
    }
    if !agent_steer_line(&line) {
        return;   // 不是「行首 / 的只读命令」：队列一个字节都不动
    }
    // 已经派发掉了：把队列里那一条消费掉（否则流式一开始它会被再推一次进收件箱）
    _ = tui_take_submit(&line);
    tui_render();
}

// 只要「泵一下」、不关心中止意图的调用点（例如流式循环里的 llm_pump_input）
fn agent_pump_light() void {
    _ = agent_pump_block();
}

// 已给过回执的那条命令（同一条只提示一次，别在泵点里刷屏）
var g_pump_receipt: Buf = Buf{ ptr: null, len: 0, cap: 0 };

// 清掉「泵点回执」（泵点当场派发命令后留给主循环看的那一小段文本）。
fn agent_pump_receipt_clear() void {
    if buf_valid(&g_pump_receipt) {
        buf_reset(&g_pump_receipt);
    }
}

// 当前泵点回执是不是以 head 开头（主循环据此避免把同一条命令**再派发一次**）。
fn agent_pump_receipt_is(head: &const Buf) bool {
    if !buf_valid(&g_pump_receipt) {
        g_pump_receipt = buf_new(256);
        return false;
    }
    return head.len > 0 && g_pump_receipt.len == head.len
        && bufx_mem_eq(g_pump_receipt.ptr as &const byte, head.ptr as &const byte, head.len);
}

// 不安全/未知命令的回执 + 落点说明（P30 的口径见 README §7）
fn agent_pump_receipt_note(head: &const Buf) void {
    if !buf_valid(&g_pump_receipt) {
        g_pump_receipt = buf_new(256);
    }
    buf_reset(&g_pump_receipt);
    _ = buf_append(&g_pump_receipt, head.ptr, head.len);
    var msg: Buf = buf_new(512);
    defer { buf_free(&msg); }
    if sv_eq_cstr(head, "/new") || sv_eq_cstr(head, "/resume") {
        // 「先中断再执行」那一类：这两个本来就是换会话，中断最符合直觉
        _ = buf_append_cstr(&msg, "已收到 ");
        _ = buf_append(&msg, head.ptr, head.len);
        _ = buf_append_cstr(&msg, "：先中断当前回合，随后执行");
        // 立刻请求中断：流式的下一个泵点就会把本回合收掉（历史保留），主循环随后执行它
        tui_request_interrupt();
    } else if sv_eq_cstr(head, "/compact") {
        // 排队那一类：改历史只能在 step 之间办（与自动压缩同一处落点）
        _ = buf_append_cstr(&msg, "已排队 ");
        _ = buf_append(&msg, head.ptr, head.len);
        _ = buf_append_cstr(&msg, "：当前 step 结束后执行");
    } else if sv_eq_cstr(head, "/continue") {
        // /continue 会再跑一轮：只能等本回合彻底结束（主循环那一侧执行）
        _ = buf_append_cstr(&msg, "已排队 ");
        _ = buf_append(&msg, head.ptr, head.len);
        _ = buf_append_cstr(&msg, "：本回合结束后执行");
    } else {
        _ = buf_append_cstr(&msg, "已收到 ");
        _ = buf_append(&msg, head.ptr, head.len);
        _ = buf_append_cstr(&msg, "：本回合结束后执行（/help 看可用命令）");
    }
    tui_add_notice(msg.ptr as &const byte, msg.len);
}

// step 边界专属的落点：`/compact` 在这里执行。
// 它会改写历史，但 step 之间本来就是压缩的既定落点（自动压缩也在这儿）；
// `/new`、`/resume` 走「中断 + 回合结束」那条路，`/continue` 会再跑一轮，
// 绝不能从回合内部递归进去。
fn agent_tui_step_boundary_cmd(cfg: &Config, h: &History) void {
    if !tui_active() {
        return;
    }
    if tui_overlay_kind() != TUI_OVK_PALETTE {
        return;
    }
    var sel: Buf = buf_new(4096);
    defer { buf_free(&sel); }
    if !tui_overlay_peek(&sel) {
        return;
    }
    var head: Buf = buf_new(128);
    defer { buf_free(&head); }
    agent_tui_item_head(&sel, &head);
    if !sv_eq_cstr(&head, "/compact") {
        return;
    }
    if !tui_overlay_take(&sel) {
        return;
    }
    agent_pump_receipt_clear();
    _ = agent_tui_palette_apply(cfg, h, &sel);
}

// step 边界派发「运行中在命令面板里选中的只读命令」（§3.4 第 d 步）。
// 以前面板结果只有主循环会取，而主循环整个回合都不跑 ⇒ 屏幕上就是「没反应」。
fn agent_tui_poll_pending_cmd(cfg: &Config, h: &History) void {
    if !tui_active() {
        return;
    }
    // P46：/watch 现役清单的结果也在泵点上收。理由与下面那条一模一样：主循环在回合运行时
    // 不跑，而这张清单的结果只有主循环那条分支会取 —— 于是「趁子代理在跑时从清单里选它」
    // 要等整个回合结束才开跟随浮层（实测：父代理被按住 12 s，回车后 1.2 s 屏上什么都没有）。
    // 它只读（读子代理日志 + 开浮层，一个字节都不写历史），当场收是安全的。
    if tui_overlay_kind() == TUI_OVK_WATCH_LIST {
        var picked: Buf = buf_new(512);
        defer { buf_free(&picked); }
        if !tui_overlay_take(&picked) {
            return;
        }
        _ = agent_tui_watch_pick(cfg, &picked);
        tui_render();
        return;
    }
    if tui_overlay_kind() != TUI_OVK_PALETTE {
        agent_pump_receipt_clear();
        return;
    }
    var sel: Buf = buf_new(4096);
    defer { buf_free(&sel); }
    if !tui_overlay_peek(&sel) {
        agent_pump_receipt_clear();
        return;
    }
    var head: Buf = buf_new(128);
    defer { buf_free(&head); }
    agent_tui_item_head(&sel, &head);
    if agent_tui_cmd_safe(&head) {
        // 只读命令（/status /help /sessions /tasks 这一类）：**当场派发**。
        // 它们只读当前状态，同一条线程里执行就是安全的；P23 把它们限制在 step 边界
        // 是「TUI 没法回调进 agent」的架构限制，不是安全性 —— P30 把这条限制去掉了。
        if !tui_overlay_take(&sel) {
            return;
        }
        // 安全集里的命令都不返回「停」，所以这里的返回值可以丢（回合的收工由主循环处理）
        _ = agent_tui_palette_apply(cfg, h, &sel);
        agent_pump_receipt_clear();
        // P31：派发之后**当场**画一帧。以前要等下一个泵点（bash/流式各 ≤50ms）才上屏，
        // 用户看到的那一下还是「敲完没反应」。tui_render 只在脏时真画。
        tui_render();
        return;
    }
    // 不安全（会改历史 / 会换会话）或未知命令：给一次回执，说明它落在哪儿；
    // 结果**原样留在队列里**给主循环（那里才是它的安全落点）。
    if !agent_pump_receipt_is(&head) {
        agent_pump_receipt_note(&head);
        // P31：回执也是要看的反馈，同一帧里画出去
        tui_render();
    }
}

// TUI 模式下的命令处理（复用滚动模式的 agent_repl_command，只把「要浮层的」拦下来）
fn agent_tui_command(cfg: &Config, h: &History, line: &const Buf) bool {
    if sv_eq_cstr(line, "/diff") {
        agent_diff_open(cfg);
        return false;
    }
    // P37：/model 与 /effort —— 裸命令开选择浮层；带参数的当文本命令走（切完给一行回执浮层）
    if sv_eq_cstr(line, "/model") {
        agent_model_overlay_open(cfg);
        return false;
    }
    if sv_eq_cstr(line, "/effort") {
        agent_effort_overlay_open(cfg);
        return false;
    }
    if arg_starts_with(line.ptr as &const byte, "/model ") {
        var rep: Buf = buf_new(2048);
        defer { buf_free(&rep); }
        agent_repl_model_text(cfg, line, false, &rep);
        tui_add_notice(rep.ptr as &const byte, rep.len);
        return false;
    }
    if arg_starts_with(line.ptr as &const byte, "/effort ") {
        var rep: Buf = buf_new(512);
        defer { buf_free(&rep); }
        agent_repl_model_text(cfg, line, true, &rep);
        tui_add_notice(rep.ptr as &const byte, rep.len);
        return false;
    }
    // P41：裸 /worktree 开**动作选择浮层**（游标默认停在 status，打开就回车 = P37 的裸命令）；
    // 带参数的那条（/worktree on|off|...）仍旧走文本命令 —— 与 /model 同一口径。
    // 这是 P37 留下的最后一处「有动作词汇却没有选择框」的命令。
    if sv_eq_cstr(line, "/worktree") {
        agent_tui_worktree_open();
        return false;
    }
    if sv_eq_cstr(line, "/help") {
        // TUI 里 /help 是帮助**浮层**（与 /status、/sessions 同一套观感）；
        // §11.6 的浮层清单这么写，但这里一直缺一个分支 ——
        // 结果 /help 掉进滚动模式的纯文本帮助，浮层函数 tui_help_open() 没人调。
        tui_help_open();
        return false;
    }
    // 踩坑 72：/mouse [on|off] —— 开关鼠标上报（关掉才能用终端自己的拖选复制文本）。
    // 与 F2 同一个函数；只写一条终端序列 + 一条 notice，不动历史也不返回「停」，
    // 所以回合运行中也能当场派发（见 agent_tui_cmd_safe）。
    if sv_eq_cstr(line, "/mouse") || arg_starts_with(line.ptr as &const byte, "/mouse ") {
        agent_cmd_display(line, 0);
        return false;
    }
    // P53：/fullscreen [on|off] —— 与 ctrl+f / F11 同一个函数；只翻一个显示开关 + 一条
    // notice（不动历史、不返回「停」），所以回合运行中也能当场派发（见 agent_tui_cmd_safe）。
    if sv_eq_cstr(line, "/fullscreen") || arg_starts_with(line.ptr as &const byte, "/fullscreen ") {
        agent_cmd_display(line, 1);
        return false;
    }
    // P51：/image [路径] —— 挂图（与 REPL 同一个函数；只读路径 + 落盘，不动历史，
    // 所以回合运行中也能当场派发，见 agent_tui_cmd_safe）
    if sv_eq_cstr(line, "/image") || arg_starts_with(line.ptr as &const byte, "/image ") {
        agent_cmd_image(cfg, line);
        return false;
    }
    // P52：/paste —— 与 ctrl+v 同一个函数（读一次剪贴板快照）
    if sv_eq_cstr(line, "/paste") {
        agent_clip_paste(cfg);
        return false;
    }
    if sv_eq_cstr(line, "/sessions") {
        // P33：会话列表铺满终端宽度（三列要地方），列宽按可用列数自适应。
        // want = 0 表示「默认档」（tui_ov_box_w 自己按终端宽度退），窄终端走这条路。
        var want: usize = 0;
        if tui_cols() > 30 {
            want = tui_cols() - 6;
        }
        var items: Buf = buf_new(16384);
        defer { buf_free(&items); }
        agent_sess_list_items(cfg, tui_overlay_body_cols(want), &items);
        if items.len == 0 {
            tui_add_notice("(没有找到会话)" as &const byte, bufx_cstr_len("(没有找到会话)" as &const byte));
            return false;
        }
        // 标题长度必须用 strlen 量：写死的字节数一旦比字面量长，就会把 .rodata 里
        // 紧邻的字节当作标题的一部分复制进浮层（× 会先在 client 里 OOB 稳定崩溃）。
        const sess_title: &const byte = "会话（enter 恢复 · esc 取消）" as &const byte;
        tui_overlay_list_wide(TUI_OVK_SESSIONS, sess_title, strlen(sess_title), items.ptr as &const byte, items.len, want);
        // P35：最新的那条现在画在**最后一行** —— 游标得跟着落到最后一项，
        // 否则「打开就回车」会恢复到最旧的会话（越界夹取交给 tui_overlay_sel_set）。
        const n_items: usize = tui_ov_line_count(items.ptr as &const byte, items.len);
        if n_items > 0 {
            tui_overlay_sel_set(n_items - 1);
        }
        return false;
    }
    if sv_eq_cstr(line, "/tasks") {
        // P25：任务状态报告（与滚动模式同一份 tasks_report）
        var txt: Buf = buf_new(16384);
        defer { buf_free(&txt); }
        agent_tasks_report(cfg, &txt);
        const ttitle: &const byte = "任务（esc 关闭）" as &const byte;
        tui_overlay_list(TUI_OVK_TASKS, ttitle, strlen(ttitle), txt.ptr as &const byte, txt.len);
        return false;
    }
    // P42：/watch —— 裸命令开「现役子代理」浮层；sub-N 开跟随浮层；off 停
    if sv_eq_cstr(line, "/watch") || arg_starts_with(line.ptr as &const byte, "/watch ") {
        var wout: Buf = buf_new(4096);
        defer { buf_free(&wout); }
        const an: usize = if (line.len > 6) { line.len - 6 } else { 0 as usize };
        const ap: &const byte = @ptr_from_usize(@usize_from_ptr(line.ptr as &const void) + 6) as &const byte;
        const rc: i32 = agent_cmd_watch(cfg, ap, an, &wout);
        if rc == WATCH_CMD_LIST {
            // 裸 /watch：现役清单浮层。P46 起**回车即跟随选中那个**（kind 必须是自己的
            // TUI_OVK_WATCH_LIST：以前借 /tasks 的 kind，回车的结果没人接，被静默丢掉），
            // 游标默认落在第一个代理行上（第 0 行是表头）。
            const wtitle: &const byte = "跟随子代理（↑/↓ 选 · 回车跟随 · esc 关闭）" as &const byte;
            tui_overlay_list(TUI_OVK_WATCH_LIST, wtitle, strlen(wtitle), wout.ptr as &const byte, wout.len);
            tui_overlay_sel_set(agent_watch_list_first_row(&wout));
        } else if rc == WATCH_CMD_BAD || rc == WATCH_CMD_STOPPED {
            // P46：以前这里只处理「裸 /watch」，另两种落点的回执被整段丢掉 ——
            // 目标写错（`/watch sub-9`）与 `/watch off` 在 TUI 里都是一片静默。
            tui_add_notice(wout.ptr as &const byte, wout.len);
        }
        return false;
    }
    // P29：/goal —— 输出走浮层（滚动模式那条打转录的路由 agent_repl_goal 守着）
    if sv_eq_cstr(line, "/goal") || arg_starts_with(line.ptr as &const byte, "/goal ") {
        var gtxt: Buf = buf_new(4096);
        defer { buf_free(&gtxt); }
        _ = goal_cmd_run(cfg, line, &gtxt);
        const gtitle: &const byte = "目标（esc 关闭）" as &const byte;
        tui_overlay_list(TUI_OVK_GOAL, gtitle, strlen(gtitle), gtxt.ptr as &const byte, gtxt.len);
        // 带参数的调用可能改过 goal.json：常驻块的目标段当场重画（裸 /goal 是纯读，不碰面板）
        if !sv_eq_cstr(line, "/goal") {
            tasks_goal_reload(cfg);
            _ = tasks_panel_sync();
        }
        return false;
    }
    // P46：/title —— 带参数的两支（`<新标题>` / `clear`）当场生效；**裸 /title** 先在后台
    // （同步的侧路请求）让模型起一个建议，再把建议**预填进输入框**让人改 —— AI 只填草稿，
    // 落不落地由人按的那个回车决定。生成失败/被中断也照常开框（预填当前标题），
    // 让人自己写：起不出来标题不该把改名这条路一起堵死。
    if sv_eq_cstr(line, "/title") || arg_starts_with(line.ptr as &const byte, "/title ") {
        if !sv_eq_cstr(line, "/title") {
            var tout: Buf = buf_new(1024);
            defer { buf_free(&tout); }
            var suggest0: Buf = buf_new(TTY_TITLE_FALLBACK_BYTES + 16);
            defer { buf_free(&suggest0); }
            _ = agent_title_cmd(cfg, h, line, &tout, &suggest0);
            tui_add_notice(tout.ptr as &const byte, tout.len);
            return false;
        }
        var suggest: Buf = buf_new(TTY_TITLE_FALLBACK_BYTES + 16);
        defer { buf_free(&suggest); }
        const gen_ok: bool = agent_title_generate(cfg, h, &suggest, true);
        var prefill: Buf = buf_new(TTY_TITLE_MAX_BYTES + 16);
        defer { buf_free(&prefill); }
        if gen_ok {
            _ = buf_append(&prefill, suggest.ptr as &const byte, suggest.len);
        } else if g_sess.title.len > 0 {
            // 起不出来就预填当前标题：框里至少有东西可改，不至于一片空白
            _ = buf_append(&prefill, g_sess.title.ptr as &const byte, g_sess.title.len);
        }
        const ttitle: &const byte = "会话标题（enter 采纳 · esc 取消）" as &const byte;
        var picked: Buf = buf_new(TTY_TITLE_MAX_BYTES + 16);
        defer { buf_free(&picked); }
        const acted: i32 = tui_title_input_wait(
            ttitle,
            strlen(ttitle),
            prefill.ptr as &const byte,
            prefill.len,
            &picked
        );
        if acted == 0 {
            // 终端太矮画不出框（或用户 esc 取消）：落到转录里说清楚，别静默
            if tui_overlay_available() {
                tui_add_notice("[title] 已取消（标题未改动）" as &const byte,
                    bufx_cstr_len("[title] 已取消（标题未改动）" as &const byte));
            } else {
                var hint: Buf = buf_new(512);
                defer { buf_free(&hint); }
                _ = buf_append_cstr(&hint, TITLE_CMD_USAGE);
                _ = buf_append_cstr(&hint, "\n");
                tui_add_notice(hint.ptr as &const byte, hint.len);
            }
            return false;
        }
        const rc: i32 = agent_title_set_user(cfg, picked.ptr as &const byte, picked.len);
        if rc == TITLE_SET_EMPTY {
            tui_add_notice("[title] error: 标题是空的（至少留一个可见字符）；标题未改动" as &const byte,
                bufx_cstr_len("[title] error: 标题是空的（至少留一个可见字符）；标题未改动" as &const byte));
            return false;
        }
        var done: Buf = buf_new(TTY_TITLE_MAX_BYTES + 160);
        defer { buf_free(&done); }
        _ = buf_append_cstr(&done, "[title] 会话标题已更新：");
        _ = buf_append(&done, g_sess.title.ptr as &const byte, g_sess.title.len);
        _ = buf_append_cstr(&done, "（已钉住；/title clear 可解锁）");
        tui_add_notice(done.ptr as &const byte, done.len);
        return false;
    }
    if sv_eq_cstr(line, "/status") {
        var items: Buf = buf_new(2048);
        defer { buf_free(&items); }
        _ = buf_append_cstr(&items, "model      ");
        _ = buf_append(&items, cfg.model.ptr, cfg.model.len);
        _ = buf_append_cstr(&items, "  (source: ");
        _ = buf_append_cstr(&items, cfg_src_name(cfg.src_model));
        _ = buf_append_cstr(&items, ")\nprovider   ");
        if cfg.provider.len > 0 {
            _ = buf_append(&items, cfg.provider.ptr, cfg.provider.len);
            _ = buf_append_cstr(&items, "  (source: ");
            _ = buf_append_cstr(&items, cfg_src_name(cfg.src_provider));
            _ = buf_append_cstr(&items, ")");
        } else {
            _ = buf_append_cstr(&items, "(未知：--no-dsh-config 或设置里没有 provider)");
        }
        _ = buf_append_cstr(&items, "\neffort     ");
        if cfg.reasoning_effort.len > 0 {
            _ = buf_append(&items, cfg.reasoning_effort.ptr, cfg.reasoning_effort.len);
            if cfg.effort_set {
                _ = buf_append_cstr(&items, "（模型公布）");
            } else {
                _ = buf_append_cstr(&items, "（原样透传，未按目录校验）");
            }
        } else {
            _ = buf_append_cstr(&items, "(未设置)");
        }
        var lv: Buf = buf_new(128);
        defer { buf_free(&lv); }
        agent_effort_list_into(cfg, &lv);
        if lv.len > 0 {
            _ = buf_append_cstr(&items, "  可选：");
            _ = buf_append(&items, lv.ptr, lv.len);
            if items.len > 0 && items.ptr[items.len - 1] == 10 as byte {
                items.len = items.len - 1;   // agent_effort_list_into 自带换行，这里不要多一行
            }
        }
        _ = buf_append_cstr(&items, "\nbase_url   ");
        _ = buf_append(&items, cfg.base_url.ptr, cfg.base_url.len);
        _ = buf_append_cstr(&items, "\nworkspace  ");
        _ = buf_append(&items, cfg.workspace.ptr, cfg.workspace.len);
        _ = buf_append_cstr(&items, "  (source: ");
        _ = buf_append_cstr(&items, ws_src_name(cfg.ws_src));
        _ = buf_append_cstr(&items, ")\n");
        // P46：会话标题（裸 /title 让模型起一个建议；这里只报当前值）
        _ = buf_append_cstr(&items, "\ntitle      ");
        if g_sess.title.len > 0 {
            _ = buf_append(&items, g_sess.title.ptr as &const byte, g_sess.title.len);
            if g_title_pinned {
                _ = buf_append_cstr(&items, "  (pinned)");
            } else {
                _ = buf_append_cstr(&items, "  (auto)");
            }
        } else {
            _ = buf_append_cstr(&items, "(无标题，终端显示基标题)");
        }
        _ = buf_append_cstr(&items, "\ntitle_auto ");
        if cfg.title_auto {
            _ = buf_append_cstr(&items, "on");
        } else {
            _ = buf_append_cstr(&items, "off (--no-title-auto)");
        }
        _ = buf_append_byte(&items, 10);
        _ = buf_append_cstr(&items, "\npermission ");
        _ = buf_append_cstr(&items, perm_name(perm_get()));
        _ = buf_append_cstr(&items, " (");
        _ = buf_append_cstr(&items, perm_label(perm_get()));
        _ = buf_append_cstr(&items, ")\nsandbox    ");
        if cfg.sandbox == SAN_OFF {
            _ = buf_append_cstr(&items, "off (--no-sandbox)");
        } else {
            _ = buf_append_cstr(&items, san_backend_name());
            _ = buf_append_cstr(&items, " (probe: ");
            _ = buf_append_cstr(&items, san_reason());
            _ = buf_append_cstr(&items, ")");
        }
        _ = buf_append_cstr(&items, "\ntui        on (headless=");
        if cfg.tui_headless {
            _ = buf_append_cstr(&items, "yes");
        } else {
            _ = buf_append_cstr(&items, "no");
        }
        _ = buf_append_cstr(&items, ")\n");
        agent_status_stats_block(cfg, h, &items);
        const status_title: &const byte = "状态（esc 关闭）" as &const byte;
        tui_overlay_list(TUI_OVK_HELP, status_title, strlen(status_title), items.ptr as &const byte, items.len);
        return false;
    }
    return agent_repl_command(cfg, h, line);
}

// 会话恢复：`/resume <id>`（与滚动模式的命令同一套解析）
fn agent_tui_resume(cfg: &Config, h: &History, id: &const Buf) void {
    var line: Buf = buf_new(id.len + 16);
    defer { buf_free(&line); }
    _ = buf_append_cstr(&line, "/resume ");
    _ = buf_append(&line, id.ptr, id.len);
    _ = agent_repl_command(cfg, h, &line);
}

// 「回合一结束就回到输入态」：把运行状态与流式条目收口
fn agent_tui_turn_done() void {
    tui_close_stream_entries();
    tui_sink_flush_partial();
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    tui_set_step(0);
    // 中断意图属于「刚才那个回合」：回合收口就作废（退出标志 g_tui_quit 不动 ——
    // 它是给主循环看的，主循环据此收工）
    tui_interrupt_clear();
    tui_mark_dirty();
}

// 注入类的 user 消息（运行时上下文 / AGENTS.md / 技能目录）不进转录：
// 它们是我们自己塞给模型的背景，不是「用户说的话」，回填进屏幕只会让人以为用户打过这些字
fn agent_tui_is_injected(m: &const Msg) bool {
    if m.text_len < 8 {
        return false;
    }
    const p: &const byte = m.text as &const byte;
    if bufx_mem_eq(p, "<system-reminder>" as &const byte, 17) {
        return true;
    }
    if bufx_mem_eq(p, "Current runtime context" as &const byte, 23) {
        return true;
    }
    if bufx_mem_eq(p, "Current uya-agent file policy" as &const byte,
            bufx_cstr_len("Current uya-agent file policy" as &const byte)) {
        return true;
    }
    if bufx_mem_eq(p, "# 项目约定" as &const byte, bufx_cstr_len("# 项目约定" as &const byte)) {
        return true;
    }
    // P58：续跑那一轮的 `<goal_round>` 块也不回放 —— 它是驱动器写给模型的指令，不是人打的字
    // （回放成 `▎ 你` 会让人以为用户自己敲了那一大段）。
    if bufx_mem_eq(p, "<goal_round>" as &const byte, 12) {
        return true;
    }
    return false;
}

// P39：**运行时换会话**（`/new` / `/resume` / `/sessions` 浮层选中）之后「屏幕跟着换」。
//
// 以前只有启动那条路会把历史铺进转录（`--resume` → agent_tui_seed_history），
// 运行中换会话则什么都不做：旧会话的正文原样留在屏幕上，新恢复出来的历史接着往下堆 ——
// 一屏里两段会话的正文混在一起，用户既看不出「换成功了」，也分不清哪句是哪条会话说的。
//
// 收口成两件事，按顺序（回执由调用方在这之后打，别被清掉）：
//   1. `tui_transcript_clear()` —— 旧正文、半行、滚动状态一起清（见 tui.uya 里那段注释：
//      为什么不能拿自测的 `tui_reset_all()` 顶替）；
//   2. `replay = true` 时把新历史回放一遍（`/resume`：屏幕上是「被恢复的那个会话」；
//      `/new` 传 false：新会话本来就没有正文，屏幕上只剩一条回执）。
//
// 滚动模式（`tui_active()` 为假）直接返回：那边的「正文」是终端自己滚出去的，
// 不归转录层管，也不该由我们去抹 —— 抹了就是把用户刚看过的内容删了。
fn agent_tui_session_switched(h: &const History, replay: bool) void {
    if !tui_active() {
        return;
    }
    tui_transcript_clear();
    if replay {
        agent_tui_seed_history(h);
    }
    tui_mark_dirty();
}

// 把历史回填进转录（--resume / --resume-dsh 之后屏幕不是空的）
fn agent_tui_seed_history(h: &const History) void {
    const n: usize = h.len;
    var start: usize = 0;
    if n > 200 {
        start = n - 200;
        tui_add_notice("… 更早的会话记录已省略" as &const byte, bufx_cstr_len("… 更早的会话记录已省略" as &const byte));
    }
    var i: usize = start;
    while i < n {
        const m: &const Msg = msg_at(h, i);
        if m.role == ROLE_USER {
            if agent_tui_is_injected(m) {
                i = i + 1;
                continue;
            }
            tui_add_user(m.text as &const byte, m.text_len);
        } else if m.role == ROLE_ASSISTANT {
            if m.text_len > 0 {
                tui_sink_bytes(1, m.text as &const byte, m.text_len);
            }
            tui_close_stream_entries();
        } else if m.role == ROLE_TOOL {
            tui_add_tool_block(m.text as &const byte, m.text_len);
            if m.text_len > 0 && m.text[m.text_len - 1] != 10 as byte {
                var nl: [byte: 1] = [10];
                tui_add_tool_block(&nl[0], 0);
            }
        }
        i = i + 1;
    }
    tui_sink_flush_partial();
}

// 起全屏 TUI：raw 模式 → sigx（终止/winch/arm）→ 私有输出 fd（`dup(1)`）→
// 进备用屏幕 → `tty_sink_on = true`（**从这一刻起所有显示字节都进转录**）。
// 任一步失败返回 false，由调用方退回滚动模式（§11.1）。
fn agent_tui_start(cfg: &const Config) bool {
    // 私有输出 fd：请求期间 tls_noise_mute 会把 fd 2 指向 /dev/null，帧不能走 fd 2
    const ofd: i32 = sys_dup(1) catch { -1; };
    if ofd < 0 {
        return false;
    }
    var model: Buf = buf_empty();
    var prov: Buf = buf_new(32);
    defer { buf_free(&prov); }
    agent_provider_label(cfg, &prov);
    var ver: Buf = buf_empty();
    tui_state_init(cfg.model.ptr as &const byte, cfg.model.len, prov.ptr as &const byte, prov.len,
        &AGENT_VERSION[0], AGENT_VERSION_LEN);
    // P37：档位在脚注/信息行里挂一小段（没设置过就是空的，排版与之前逐字节相同）
    tui_set_effort(cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);
    // cwd / HOME / 分支
    var home: Buf = env_or("HOME" as &const byte, "" as &const byte);
    defer { buf_free(&home); }
    tui_set_cwd(cfg.workspace.ptr as &const byte, cfg.workspace.len, home.ptr as &const byte, home.len);
    var br: Buf = buf_new(64);
    defer { buf_free(&br); }
    agent_git_branch(cfg.workspace.ptr as &const byte, cfg.workspace.len, &br);
    tui_set_branch(br.ptr as &const byte, br.len);
    var cmds: Buf = buf_new(1024);
    defer { buf_free(&cmds); }
    agent_tui_commands(&cmds);
    tui_set_commands(cmds.ptr as &const byte, cmds.len);
    tui_set_color(agent_color_on(cfg), agent_color_256(cfg));
    tui_set_plan(g_plan.active);
    tui_set_access(cfg.access);
    // 踩坑 72：鼠标上报的启动值（--mouse / --no-mouse / UYA_AGENT_MOUSE）。必须在
    // tui_start（→ tui_term_enter）之前落定 —— 进 TUI 那一刻就要按它发序列。
    tui_set_mouse(cfg.mouse);
    _ = model;
    // 终端
    if !sigx_install_terminal(0) {
        tty_puts(&tty_ui, 2, "warning: 信号处理器安装失败（被打断时终端可能停在 raw 模式）\n");
    }
    _ = sigx_install_winch();
    sigx_arm(ofd, true, agent_title_enabled(cfg));
    if !tty_raw_on(&tty_ui, 0) {
        sigx_disarm();
        _ = sys_close(ofd) catch {};
        return false;
    }
    tui_start(ofd);
    // P22：备用屏幕起来之后再压标题栈 + 上基标题（顺序：先有界面，再有标题）
    agent_title_begin(cfg, ofd);
    tty_sink_on = true;       // 从这一刻起，所有显示字节都进转录
    tui_set_size(tty_ui.cols, tty_ui.rows);
    return true;
}

// 收尾，**顺序不能换**：`tty_sink_on = false` → `tty_title_end()` → `tui_stop()`
// （离开备用屏幕）→ `tty_raw_off()` → `sigx_disarm()`。
// 先停 sink 再退屏幕：反过来的话退屏过程中的输出会漏进转录。
fn agent_tui_stop(out_fd: i32) void {
    tty_sink_on = false;
    tty_title_end();   // P22：先弹标题栈（写的是 TUI 自己的 fd），再离开备用屏幕
    tui_stop();
    tty_raw_off(&tty_ui, 0);
    sigx_disarm();
    if out_fd >= 0 {
        _ = sys_close(out_fd) catch {};
    }
}

// P22：交互模式下要不要改终端标题（--title / --no-title / UYA_AGENT_TITLE）。
// 子代理一律不碰：它们只跑回合循环（stdout/stderr 已经指向 /dev/null，stdin 却继承父进程的
// TTY），万一将来给它们接了交互界面，也不该去改父进程的终端标题。
fn agent_title_enabled(cfg: &const Config) bool {
    return cfg.title && !cfg.is_subagent;
}

// P22：打开标题通道（压栈 + 上基标题）。`--no-title` 时整条通道都不开 —— 后面所有
// `agent_title_apply()` 都会因为 `tty_title_active()` 为假而变成空操作。
//
// 这里**只**上基标题、不看 `g_sess.title`：这个函数跑在 `agent_history_begin` 之前，
// 此刻 `g_sess.title` 要么是空的（新进程），要么是 fork 继承来的**上一个会话**的残留
// （自测里真踩到过：PTY 子进程把上一轮的标题先顶上去，屏幕上就是「任务标题 + 基标题」
// 两条 OSC）。真正的会话标题由「开完会话之后」的那次 `agent_title_apply()` 上。
fn agent_title_begin(cfg: &const Config, fd: i32) void {
    if !agent_title_enabled(cfg) {
        return;
    }
    tty_title_begin(fd);
    agent_title_base_set(cfg);
    tty_title_set(g_title_base.ptr as &const byte, g_title_base.len);
}

// TUI 主循环：与 agent_run_interactive 同构（取 steer → 等提交 → 跑回合），
// 只是输入输出全走 TUI，回合运行期间由 tick 保持界面活着。
fn agent_run_tui(cfg: &Config) i32 {
    if cfg.api_key.len == 0 {
        out_err("error: no API key. set UYA_AGENT_API_KEY / DEEPSEEK_API_KEY / OPENAI_API_KEY\n");
        return AGENT_USAGE;
    }
    // 自测模式：不碰终端（不 raw / 不进备用屏幕 / 不装信号处理器），按键由测试注入
    if cfg.tui_headless {
        tui_set_headless(true);
        tui_set_size(cfg.tui_cols, cfg.tui_rows);
        return agent_run_tui_body(cfg, -1);
    }
    tty_init(&tty_ui, 0);
    if !tty_ui.is_tty {
        cfg.tui = false;
        return agent_run_interactive(cfg);
    }
    _ = tty_refresh_size(&tty_ui);
    const ofd: i32 = sys_dup(1) catch { -1; };
    if ofd < 0 {
        cfg.tui = false;
        return agent_run_interactive(cfg);
    }
    _ = sys_close(ofd) catch {};
    if tty_ui.cols < 32 || tty_ui.rows < 8 {
        tty_puts(&tty_ui, 2, "warning: 终端太小（<32x8），退回滚动模式\n");
        cfg.tui = false;
        return agent_run_interactive(cfg);
    }
    if !agent_tui_start(cfg) {
        cfg.tui = false;
        return agent_run_interactive(cfg);
    }
    return agent_run_tui_body(cfg, tui_out_fd());
}

// TUI 主循环（headless 与真实终端共用）
fn agent_run_tui_body(cfg: &Config, tui_fd: i32) i32 {
    if cfg.tui_headless {
        tui_headless_enable(true);
        tty_sink_on = true;
        tui_mark_dirty();
        _ = tui_tick(0);
    }
    g_interactive = true;
    inbox_globals_init();
    tui_key_reset();

    var h: History = hist_init();
    var rc: i32 = AGENT_OK;
    var no_first: Buf = buf_empty();
    if !agent_history_begin(cfg, &h, &no_first) {
        out_err("error: cannot build history\n");
        agent_tui_stop(tui_fd);
        tty_free(&tty_ui);
        g_interactive = false;
        return AGENT_PROTO;
    }
    // P22：历史回填完再同步标题（--continue / --resume / --resume-dsh 的标题此刻才在 g_sess.title 里）
    agent_title_apply();
    agent_tui_seed_history(&h);
    // P22：常驻任务块 —— 启动先读一次 goal.json，再把面板文本备好（tui_build 只 memcpy）
    tasks_init();
    tasks_goal_reload(cfg);
    agent_agents_tick_force();
    tui_mark_dirty();

    var line: Buf = buf_new(8192);
    var sel: Buf = buf_new(4096);
    var run: bool = true;
    var ctrl_c_armed: bool = false;
    _ = ctrl_c_armed;
    while run {
        // P31：脏了就先画一帧再进阻塞等待。命令在上一圈末尾派发完（浮层/notice 都写好了），
        // 以前要等下一次 tui_poll_keys(200) 回来才上屏 —— 空闲敲 /status 的 243ms 全在这里。
        // tui_render 只在脏时真画，且不受 tui_tick 的空闲节流（120ms）限制。
        tui_render();
        // 0) 空闲等待：有 spinner 时 80ms 转一次，否则 200ms（不忙等）
        var wait_ms: i32 = 200;
        if tui_run_kind() != TUI_RUN_IDLE {
            wait_ms = 80;
        }
        // P46：自动起标题的待办**不在这里**早退式消费 —— 那会把这一圈的按键/浮层处理
        // 整段跳过去（实测：起标题的圈里敲进来的 /status 被当成「未知命令」）。
        // 它排在循环体最后（所有输入处理之后），闸门见 agent_title_auto_idle_ok。
        if !tui_has_submit() {
            _ = tui_poll_keys(wait_ms);
            _ = tui_tick(tui_now_ms());
            // P42：空闲时也要让 /watch 的跟随继续长（这一段没有泵点，g_pump_cfg 是空的）
            _ = agent_watch_tick_if_active();
        }
        // 1) 模式切换请求（tab = plan / shift+tab = 访问模式选择器）
        const req: i32 = tui_take_request();
        if req == TUI_REQ_PLAN_ON {
            agent_plan_apply(cfg, &h, true);
        } else if req == TUI_REQ_PLAN_OFF {
            agent_plan_apply(cfg, &h, false);
        } else if req == TUI_REQ_ACCESS {
            agent_tui_access_open();
        } else if req == TUI_REQ_TASKS {
            // P22：ctrl+t 只置请求，真正切展开态与重画在这里（与 plan/access 同一套分工）
            _ = tasks_toggle();
            _ = tasks_panel_sync();
        } else if req == TUI_REQ_PASTE {
            // P51：ctrl+v 贴剪贴板。读的是一次快照（图 → 挂附件；文本 → 插进输入行），
            // 所以放在主循环这一层做（那里才有 cfg 与 h）。
            agent_clip_paste(cfg);
        }
        // 2) 浮层结果（会话选择 / 命令面板）
        if tui_overlay_take(&sel) {
            const kind: u8 = tui_overlay_kind();
            if kind == TUI_OVK_PALETTE {
                // 命令面板：把命令名当输入提交。返回值 = 「该停」（面板里选中 /exit 也
                // 要真的退出 —— 以前这里把返回值丢了，选中之后什么都不发生，见踩坑 44）。
                // 注意：回合运行中主循环不在这条路上，所以面板选中 /exit 时还得靠
                // tui_ov_accept() 当场把退出标志置上（那边有注释）。
                // P30：这条命令已经被主循环接手了，把「已回执」标记清掉，
                // 下一条同名命令还能再提示一次。
                agent_pump_receipt_clear();
                // 命令面板：把命令名当输入提交（顺带收走触发面板的那个 "/"，见
                // agent_tui_palette_apply 的注释）。返回 true = 「该停」—— 面板里选中
                // /exit 也要真的退出，见踩坑 44。
                // P31：面板里选中的命令也可能发请求（/compact 的摘要请求），命令处理
                // 期间把泵点上下文登记上 —— 请求在飞的时候运行中的只读命令照常派发。
                agent_pump_ctx_begin(cfg, &h);
                if agent_tui_palette_apply(cfg, &h, &sel) {
                    run = false;                }
                agent_pump_ctx_end(cfg);
            } else if kind == TUI_OVK_SESSIONS {
                // P33：条目是「标题 | 工作区 | id」，id 在行尾（不能再用 item_head 取行首）
                var sid: Buf = buf_new(128);
                defer { buf_free(&sid); }
                agent_tui_sessions_head(&sel, &sid);
                if sid.len > 0 {
                    agent_tui_resume(cfg, &h, &sid);
                } else {
                    // 认不出 id 就明说：静默什么都不发生是最难查的一种
                    tui_add_notice("error: 这一行里没认出会话 id（/sessions 重开一次）" as &const byte,
                        bufx_cstr_len("error: 这一行里没认出会话 id（/sessions 重开一次）" as &const byte));
                }
            } else if kind == TUI_OVK_ACCESS || kind == TUI_OVK_ACCESS_CONFIRM {
                // P21：访问模式（Full access 会在这里翻成第二道确认浮层）
                _ = agent_tui_access_handle(cfg, &h, &sel);
            } else if kind == TUI_OVK_MODEL || kind == TUI_OVK_EFFORT {
                // P37：模型 / 推理强度（浮层只画，选择由这里收口）
                _ = agent_tui_model_handle(cfg, &h, &sel);
            } else if kind == TUI_OVK_WATCH_LIST {
                // P46：/watch 现役清单里选中一行 = 跟随那个子代理（认不出编号 / 目标已经
                // 不在了都给 notice，见 agent_tui_watch_pick）
                _ = agent_tui_watch_pick(cfg, &sel);
            } else if kind == TUI_OVK_WORKTREE || kind == TUI_OVK_WORKTREE_CONFIRM {
                // P41：/worktree 的动作选择（finish/discard 会在这里翻成第二道确认浮层）
                _ = agent_tui_worktree_handle(cfg, &h, &sel);
            }
            continue;
        }
        if tui_overlay_cancelled() {
            continue;
        }
        // 3) 运行中输入的文本（steer 收件箱里没被采纳的）→ 当作新任务
        const steer_got: bool = inbox_pop(&g_steer, &line);
        if steer_got && line.len > 0 && line.ptr[0] == 47 as byte {
            // P31：命令期间登记泵点上下文（它会发请求的只有 /compact，见上面那条注释）
            agent_pump_ctx_begin(cfg, &h);
            const stop: bool = agent_tui_command(cfg, &h, &line);
            agent_pump_ctx_end(cfg);
            if stop {
                run = false;
            }
            continue;
        }
        // 4) 等提交
        if !steer_got {
            if !tui_take_submit(&line) {
                // P58：同会话 Goal Round 的驱动器也挂在这一支（与 DSH 的 idle 检查点同一个
                // 位置）。让路判据（要退出 / 键盘上还有待读字节）都在 `agent_goal_drive`
                // 里面，两个调用点共用一份。驱动过一轮就回顶部再问一次，**别**在同一圈顺手
                // 把标题请求也发了。
                if agent_goal_drive(cfg, &h) {
                    continue;
                }
                // P46：这是**真空闲**的那一支（没有提交、浮层结果已在第 2 步消费掉、
                // steer 也在第 3 步领取过）—— 只有走到这里才发自动起标题的侧路请求。
                // 放在这一支而不是循环开头：早发会把这一圈的浮层/按键处理整段跳过去
                // （实测：起标题的圈里，上一圈留下的 /compact 结果与用户正敲的 /status
                //  搅成了 `//status` → 「未知命令」，p30-check 的 status-during-compact 抓到）。
                agent_title_auto_pending_tick(cfg, &h);
                tui_render();
                if tui_quit_wanted() {
                    run = false;
                }
                continue;
            }
        }
        if line.len == 0 {
            continue;
        }
        if tui_quit_wanted() {
            run = false;
            continue;
        }
        if line.ptr[0] == 47 as byte {
            // P31：命令期间登记泵点上下文（理由同上面那条）
            agent_pump_ctx_begin(cfg, &h);
            const stop: bool = agent_tui_command(cfg, &h, &line);
            agent_pump_ctx_end(cfg);
            if stop {
                run = false;
            }
            continue;
        }
        // 5) 跑一轮
        var att: Buf = buf_new(1024);
        defer { buf_free(&att); }
        var have_att: bool = false;
        const pushed: bool = agent_push_user_with_imgs(&h, &line, &att, &have_att);
        _ = pushed;
        if !pushed {
            tui_add_notice("error: 无法把任务写入历史" as &const byte,
                bufx_cstr_len("error: 无法把任务写入历史" as &const byte));            continue;
        }
        agent_log_user_att(line.ptr as &const byte, line.len, false, &att, &have_att);
        tui_add_user(line.ptr as &const byte, line.len);
        agent_echo_imgs(&att, &have_att);
        tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
        // 新任务 = 新回合：把上一轮遗留的中断意图清掉。不清的话流式循环一开头就会
        // 看到它并立刻打断本回合 —— 用户看到的是「中断一次之后，后面每个任务都秒退」
        // （§16 踩坑 44）。
        tui_interrupt_clear();
        tui_tick(tui_now_ms());
        rc = agent_turn_loop(cfg, &h);
        agent_tui_turn_done();
        if rc != AGENT_OK && rc != AGENT_INTERRUPTED && rc != AGENT_MAX_TOKENS {
            tui_add_notice("[turn] 本回合异常结束（可直接输入继续）" as &const byte, bufx_cstr_len("[turn] 本回合异常结束（可直接输入继续）" as &const byte));
        }
        rc = AGENT_OK;
        // 注意：这里**不要**再补一句「quit 就直接 run = false」——回合结束后主循环还要
        // 走一圈（poll + tick）才能把最后一屏画出来；提前跳出会让屏幕停在「思考中」的
        // 旧帧上（自测里表现为「转录里什么都没有」，§16 踩坑 44）。
    }
    if cfg.tui_headless {
        tty_sink_on = false;
        tui_headless_enable(false);
    } else {
        agent_tui_stop(tui_fd);
    }
    agent_session_close();
    tasks_free();
    inbox_globals_free();
    hist_free(&h);
    buf_free(&line);
    buf_free(&sel);
    if !cfg.tui_headless {
        tty_free(&tty_ui);
    }
    g_interactive = false;
    return rc;
}

// --tui-demo：把 home / chat 两种屏渲染成**纯文本**打出来（诊断 + §11 用）
fn agent_tui_dump(cols: usize, rows: usize) void {
    var out: Buf = buf_new(65536);
    defer { buf_free(&out); }
    tui_set_size(cols, rows);
    tui_build();
    _ = tui_screen_text(&out);
    out_bytes(out.ptr as &const byte, out.len);
}

// --tui-demo 用的统计 fixture：数字刻意选成 DSH 截图那一行
// （1 轮 · 12 步 | LLM 50.7s · 工具调用 4.1s | 首 token 平均 1.5s · 221 tok/s |
//   缓存命中 71% | 输入 238K tok · 输出 12K tok），并且**全部经真实边界喂入**，
// 所以它同时是折叠的一次端到端演练；自测 `stats-line` 直接复用它。
fn agent_stats_fixture_demo() void {
    st_reset();
    // 步 1..10：只有 llm 时间（没有首 token、不进 ttft/解码），各带 979 个输出 token
    // —— 这些 token 进「输出 12K」但不进 tok/s（DSH 的 tokenUsage 与 decode 是两个口径）
    var t: i64 = 0;
    var i: i64 = 1;
    while i <= 10 {
        st_step_start(1, i, t as u64);
        st_assistant_message(1, i, (t + 3770) as u64, 0, 0, 0, 979);
        t = t + 3770;
        i = i + 1;
    }
    // 步 11：llm 5.2s（ttft 1.2s / 解码 4.0s）+ 一次工具调用 4.1s
    st_step_start(1, 11, t as u64);
    st_first_token(1, 11, (t + 1200) as u64);
    st_assistant_message(1, 11, (t + 5200) as u64, 0, 0, 0, 1000);
    st_tool_call("call_demo_1" as &const byte, 11, (t + 5200) as u64);
    st_tool_result("call_demo_1" as &const byte, 11, (t + 9300) as u64);
    // 步 12：llm 7.8s（ttft 1.8s / 解码 6.0s），压力样本落在这一步：
    // 未缓存 69K + 缓存读 169K = 计费输入 238K → 缓存命中 71%
    const t12: i64 = t + 9300;
    st_step_start(1, 12, t12 as u64);
    st_first_token(1, 12, (t12 + 1800) as u64);
    st_assistant_message(1, 12, (t12 + 7800) as u64, 69000, 169000, 0, 1210);
    i = 1;
    while i <= 12 {
        st_step_end(1, i);
        i = i + 1;
    }
}

// --tui-demo 第 5 屏用的示例计划（P26）：多节、够长，能看出「正文可滚动」
const DEMO_PLAN: &const byte = "# 把 hello.uya 的问候语改成 Hello, DSH!\n\n## 第一步：读现状\n- 读 hello.uya，确认现在的问候语是 Hello, Uya!\n- 顺手看一眼 Makefile 里有没有别处引用这个字符串\n\n## 第二步：改一行\n- 只动那一行字面量，不动缩进与分号\n- 用 edit 工具替换，避免整文件重写带来的 diff 噪音\n\n## 第三步：验证\n- 编译并运行：期望输出 Hello, DSH!\n- 跑一次 make check，确认没有连带影响\n\n## 风险与回滚\n- 风险只有一处字符串，回滚就是把这一行改回去\n- 不碰 Makefile、不碰 TUI 代码\n" as &const byte;
// --tui-demo 第 4 屏的 fixture：在**真实 globals** 上装一份「跑了一半」的任务状态。
// 全部 reaped/pid=-1/fd=-1：面板刷新绝不能真去 waitpid 或读管道（自测同款约定）。
fn agent_todo_fixture_add(text: &const byte, st: u8) void {
    const i: usize = g_todos.n;
    if i >= TODO_MAX {
        return;
    }
    const n: usize = bufx_cstr_len(text);
    g_todos.items[i].content = buf_new(n + 8);
    _ = buf_append_cstr(&g_todos.items[i].content, text);
    g_todos.items[i].status = st;
    g_todos.n = i + 1;
}

// 给 `--tui-demo` 造一套**假**的任务状态（清单 2/4、后台 1/2、子代理 1/1、目标 3/20），
// 好让 demo 的常驻任务块有东西可画。只被 demo 与自测调用。
export fn agent_tasks_fixture_demo() void {
    // 清单：2 完成 / 1 进行中 / 1 待办
    todo_free(&g_todos);
    todo_init(&g_todos);
    agent_todo_fixture_add("写 src/tasks.uya（聚合 + 文本 + 快照推送）" as &const byte, TD_COMPLETED);
    agent_todo_fixture_add("接进 TUI 浮层与常驻块" as &const byte, TD_COMPLETED);
    agent_todo_fixture_add("补自测轮与 make 目标" as &const byte, TD_INPROGRESS);
    agent_todo_fixture_add("把 doc-audit 的告警清零" as &const byte, TD_PENDING);

    // 后台任务：1 跑中（12s、已收 3 行输出）+ 1 已完成 exit 0
    jobs_free(&g_jobs);
    jobs_init(&g_jobs);
    g_jobs.items[0].used = true;
    g_jobs.items[0].id = 1;
    g_jobs.items[0].kind = 0;
    g_jobs.items[0].pid = -1;
    g_jobs.items[0].rfd = -1;
    g_jobs.items[0].status = JOB_RUNNING;
    g_jobs.items[0].exit_code = 0;
    g_jobs.items[0].truncated = false;
    g_jobs.items[0].start_ms = ua_now_ms() - (12 as u64) * (1000 as u64);
    g_jobs.items[0].read_off = 0;
    g_jobs.items[0].reaped = true;
    g_jobs.items[0].label = buf_new(64);
    _ = buf_append_cstr(&g_jobs.items[0].label, "编译内核模块" as &const byte);
    g_jobs.items[0].buf = buf_new(64);
    _ = buf_append_cstr(&g_jobs.items[0].buf, "cc -c kernel.c
ld -r kernel.o
ok
" as &const byte);
    g_jobs.items[1].used = true;
    g_jobs.items[1].id = 2;
    g_jobs.items[1].kind = 0;
    g_jobs.items[1].pid = -1;
    g_jobs.items[1].rfd = -1;
    g_jobs.items[1].status = JOB_DONE;
    g_jobs.items[1].exit_code = 0;
    g_jobs.items[1].truncated = false;
    g_jobs.items[1].start_ms = ua_now_ms() - (4 as u64) * (1000 as u64);
    g_jobs.items[1].read_off = 0;
    g_jobs.items[1].reaped = true;
    g_jobs.items[1].label = buf_new(64);
    _ = buf_append_cstr(&g_jobs.items[1].label, "跑一遍单测" as &const byte);
    g_jobs.items[1].buf = buf_new(64);
    _ = buf_append_cstr(&g_jobs.items[1].buf, "all 128 tests passed
" as &const byte);
    g_jobs.next_id = 3;

    // 子代理：1 跑中（7s、12 行输出）
    deleg_free(&g_deleg);
    deleg_init(&g_deleg);
    g_deleg.items[0].used = true;
    g_deleg.items[0].id = 1;
    g_deleg.items[0].kind = DELEG_KIND_SUB;
    g_deleg.items[0].pid = -1;
    g_deleg.items[0].fd = -1;
    g_deleg.items[0].status = DELEG_RUNNING;
    g_deleg.items[0].code = 0;
    g_deleg.items[0].reaped = true;
    g_deleg.items[0].read_off = 0;
    g_deleg.items[0].rounds = 0;
    g_deleg.items[0].max_rounds = 0;
    g_deleg.items[0].ended_noted = false;
    g_deleg.items[0].started_ms = ua_now_ms() - (7 as u64) * (1000 as u64);
    g_deleg.items[0].label = buf_new(64);
    _ = buf_append_cstr(&g_deleg.items[0].label, "审计 deleg 的等待循环" as &const byte);
    g_deleg.items[0].prompt = buf_new(96);
    _ = buf_append_cstr(&g_deleg.items[0].prompt, "把 deleg 的等待循环与 fork/exec 差异看一遍" as &const byte);
    g_deleg.items[0].sid = buf_new(16);
    g_deleg.items[0].objective = buf_new(16);
    g_deleg.items[0].buf = buf_new(512);
    var li: usize = 0;
    while li < 12 {
        _ = buf_append_cstr(&g_deleg.items[0].buf, "检查 1030-1120 行的 fork/exec 差异
" as &const byte);
        li = li + 1;
    }
    g_deleg.next_id = 2;

    // 目标：active、round 3/20
    const g: &Goal = tasks_goal_ref();
    goal_free(g);
    g[0] = goal_empty();
    g.active_state = true;
    g.id = 1;
    g.revision = 4;
    g.round = 3;
    g.max_rounds = 20;
    g.phase = buf_new(16);
    _ = buf_append_cstr(&g.phase, "active" as &const byte);
    g.objective = buf_new(128);
    _ = buf_append_cstr(&g.objective, "把 /tasks 的任务状态进度接进 TUI 与滚动模式" as &const byte);
}

// `--tui-demo [WxH]`：在给定尺寸上渲染若干屏**纯文本快照**后退出（诊断 + 文档）。
// 它同时是 markdown 排版与浮层全屏的**自测基准** —— 快照走 `tui_screen_text`，
// 与画帧**同源**，所以「demo 逐字节不变」才算真没改渲染（§11.3）。
fn agent_tui_demo(cfg: &const Config, cols: usize, rows: usize) i32 {
    var prov: Buf = buf_new(32);
    defer { buf_free(&prov); }
    agent_provider_label(cfg, &prov);
    tui_state_init(cfg.model.ptr as &const byte, cfg.model.len, prov.ptr as &const byte, prov.len,
        &AGENT_VERSION[0], AGENT_VERSION_LEN);
    tui_set_effort(cfg.reasoning_effort.ptr as &const byte, cfg.reasoning_effort.len);
    var home: Buf = env_or("HOME" as &const byte, "" as &const byte);
    defer { buf_free(&home); }
    tui_set_cwd(cfg.workspace.ptr as &const byte, cfg.workspace.len, home.ptr as &const byte, home.len);
    var br: Buf = buf_new(64);
    defer { buf_free(&br); }
    agent_git_branch(cfg.workspace.ptr as &const byte, cfg.workspace.len, &br);
    tui_set_branch(br.ptr as &const byte, br.len);
    tui_set_color(agent_color_on(cfg), agent_color_256(cfg));
    tui_set_commands("" as &const byte, 0);

    // ① 空态（logo + 居中面板）：还没有步数 → 右半区退回版本号，左半区只有 cwd
    tui_set_stats("" as &const byte, 0);
    tui_set_ctx(-1);
    tui_set_cpu(-1);
    tui_set_mem(-1);
    tui_set_plan(false);
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);
    // 空态也用同一个画布（早期实现没设尺寸，空态快照一直是 80×24 的默认值）
    agent_tui_dump(cols, rows);

    // ② 对话态
    tui_add_user("把 hello.uya 的问候语改成 Hello, DSH!" as &const byte,
        bufx_cstr_len("把 hello.uya 的问候语改成 Hello, DSH!" as &const byte));
    agent_stats_fixture_demo();
    var sline: Buf = buf_new(512);
    defer { buf_free(&sline); }
    _ = st_line(&sline);
    tui_set_stats(sline.ptr as &const byte, sline.len);
    tui_set_ctx(21);
    tui_set_cpu(37);
    tui_set_mem(319488);   // 312M（P24：内存合计口径与 /status 一致）

    // 再给一份带转录的（模拟真实一轮的形状）。
    // P46：这里的正文刻意放成「模型真会吐的那种 markdown」—— 标题、**粗体**、`行内码`、
    // 列表（含任务清单）、引用、带语言标签的代码块、以及一张表格，`--tui-demo` 因此
    // 同时是 P46 渲染能力的排版基准。
    tui_sink_bytes(1, "我先读一下文件，再改一行，顺手跑一次编译：\n" as &const byte, bufx_cstr_len("我先读一下文件，再改一行，顺手跑一次编译：\n" as &const byte));
    tui_sink_bytes(1, "### 改动\n\n- 只动 `@println` 那一行，**不动**缩进\n- [x] 读现状\n- [ ] 跑一遍 `make check`\n\n> 回滚就是把这一行改回去。\n\n```uya\n@println(\"Hello, DSH!\")\n```\n\n| 文件 | 改动 |\n| --- | ---: |\n| `hello.uya` | 1 |\n" as &const byte, bufx_cstr_len("### 改动\n\n- 只动 `@println` 那一行，**不动**缩进\n- [x] 读现状\n- [ ] 跑一遍 `make check`\n\n> 回滚就是把这一行改回去。\n\n```uya\n@println(\"Hello, DSH!\")\n```\n\n| 文件 | 改动 |\n| --- | ---: |\n| `hello.uya` | 1 |\n" as &const byte));
    tui_sink_bytes(2, "✓ Read(hello.uya) · 4 lines\n" as &const byte, bufx_cstr_len("✓ Read(hello.uya) · 4 lines\n" as &const byte));
    tui_sink_bytes(2, "    -     @println(\"Hello, Uya!\");\n" as &const byte, bufx_cstr_len("    -     @println(\"Hello, Uya!\");\n" as &const byte));
    tui_sink_bytes(2, "    +     @println(\"Hello, DSH!\");\n" as &const byte, bufx_cstr_len("    +     @println(\"Hello, DSH!\");\n" as &const byte));
    tui_sink_bytes(2, "✓ Bash(./hello) · exit 0\n" as &const byte, bufx_cstr_len("✓ Bash(./hello) · exit 0\n" as &const byte));
    tui_sink_bytes(2, "    Hello, DSH!\n" as &const byte, bufx_cstr_len("    Hello, DSH!\n" as &const byte));
    tui_sink_bytes(1, "已改成 Hello, DSH! 并重新编译运行，输出 Hello, DSH!。\n" as &const byte, bufx_cstr_len("已改成 Hello, DSH! 并重新编译运行，输出 Hello, DSH!。\n" as &const byte));
    tui_set_run(TUI_RUN_TOOL, "Bash(make check)" as &const byte,
        bufx_cstr_len("Bash(make check)" as &const byte));
    agent_tui_dump(cols, rows);
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);

    // ③ 运行中（P18）：状态区常驻在面板正上方，第二行是思考实时行。
    //    下面先堆一大段转录把视口铺满 —— P18 之前这一屏里状态行会被挤掉（一个字节都不显示）。
    var i: usize = 0;
    while i < 8 {
        tui_sink_bytes(1, "为了把视口铺满，这里再补几行转录：状态区必须照样看得见。\n" as &const byte, bufx_cstr_len("为了把视口铺满，这里再补几行转录：状态区必须照样看得见。\n" as &const byte));
        i = i + 1;
    }
    tui_close_stream_entries();
    tui_set_run(TUI_RUN_THINK, "" as &const byte, 0);
    tui_think_live("先核对 tui_build_chat 的视口夹取与状态区预留对不对，再看 view_think_pick 的 latestLine 口径，最后跑一轮 tui-selftest 收尾" as &const byte,
        bufx_cstr_len("先核对 tui_build_chat 的视口夹取与状态区预留对不对，再看 view_think_pick 的 latestLine 口径，最后跑一轮 tui-selftest 收尾" as &const byte));
    agent_tui_dump(cols, rows);
    tui_set_run(TUI_RUN_IDLE, "" as &const byte, 0);

    // ④ 常驻任务块（P22）：④a 折叠 1 行 / ④b 展开（ctrl+t 之后的样子）
    tui_close_stream_entries();
    view_init(true, 0);
    tui_headless_enable(true);      // tasks_panel_sync 要走 TUI 那条路（拉取 + mark dirty）
    tasks_init();
    agent_tasks_fixture_demo();
    tasks_expand_set(false);
    _ = tasks_panel_sync();
    agent_tui_dump(cols, rows);
    tasks_expand_set(true);
    _ = tasks_panel_sync();
    agent_tui_dump(cols, rows);
    tasks_expand_set(false);

    // ④c /tasks 报告本体（TUI 浮层与滚动模式打印的是同一份文本）
    var rep: Buf = buf_new(16384);
    defer { buf_free(&rep); }
    tasks_report_globals(cols - 12, &rep);
    out_bytes("\n--- 任务（/tasks 的内容）---\n" as &const byte, bufx_cstr_len("\n--- 任务（/tasks 的内容）---\n" as &const byte));
    out_bytes(rep.ptr as &const byte, rep.len);

    // ⑤ plan 审阅浮窗（P26）：模型交出计划时弹的 reader 浮层 ——
    //    正文可滚动（标题栏是「第 a 行/共 b 行」）、下面一行说明 + 一行动作。
    //    （最后一张快照：任务块与它互不影响）
    tui_set_plan(true);
    tui_overlay_reader(TUI_OVK_PLAN, PLAN_TITLE, bufx_cstr_len(PLAN_TITLE),
        DEMO_PLAN, bufx_cstr_len(DEMO_PLAN),
        PLAN_ITEMS, bufx_cstr_len(PLAN_ITEMS), 0);
    agent_tui_dump(cols, rows);
    tui_overlay_close();
    tui_set_plan(false);
    // ⑥ /diff 浮窗（P27）：左侧文件列表 + 右侧旧/新两栏全文比对。
    //    数据用 gd_load_fixture 注入 —— demo 不碰 git，输出才可复现（本文引用的就是这一屏）。
    var dfiles: Buf = buf_new(256);
    defer { buf_free(&dfiles); }
    var ddiff: Buf = buf_new(4096);
    defer { buf_free(&ddiff); }
    _ = buf_append_cstr(&dfiles, " M  src/diffx.uya  (+13 -4)\n??  src/gitdiff.uya  (new)\n M  README.md  (+1 -0)\n" as &const byte);
    _ = buf_append_cstr(&ddiff, "diff --git a/src/diffx.uya b/src/diffx.uya\n" as &const byte);
    _ = buf_append_cstr(&ddiff, "index 1111111..2222222 100644\n--- a/src/diffx.uya\n+++ b/src/diffx.uya\n" as &const byte);
    _ = buf_append_cstr(&ddiff, "@@ -1,7 +1,7 @@\n" as &const byte);
    _ = buf_append_cstr(&ddiff, " // src/diffx.uya — 行级 diff（P14：write / edit 的显示正文）\n" as &const byte);
    _ = buf_append_cstr(&ddiff, "-// 只服务显示，不参与线上协议。\n" as &const byte);
    _ = buf_append_cstr(&ddiff, "+// 只服务显示，不参与线上协议（P27 起 /diff 走 git 的 unified diff）。\n" as &const byte);
    _ = buf_append_cstr(&ddiff, " const DIFFX_MID_MAX: usize = 60;\n" as &const byte);
    _ = buf_append_cstr(&ddiff, " const DIFFX_MID_LINES: usize = 3721;\n" as &const byte);
    _ = buf_append_cstr(&ddiff, " const DIFFX_MAX_BYTES: usize = 2 * 1024 * 1024;\n" as &const byte);
    _ = buf_append_cstr(&ddiff, " const DIFFX_CTX_LINES: usize = 2;\n" as &const byte);
    _ = buf_append_cstr(&ddiff, "@@ -20,3 +20,4 @@\n" as &const byte);
    _ = buf_append_cstr(&ddiff, " fn diffx_note(old: &[byte], new: &[byte]) void {\n" as &const byte);
    _ = buf_append_cstr(&ddiff, "+    // P27：/diff 的双列视图不复用这里的 LCS（git 自己算）\n" as &const byte);
    _ = buf_append_cstr(&ddiff, "     if !g_diffx_on {\n" as &const byte);
    _ = buf_append_cstr(&ddiff, "         return;\n" as &const byte);
    gd_load_fixture("uya-agent" as &const byte, &dfiles, &ddiff);
    tui_overlay_diff_open();
    agent_tui_dump(cols, rows);
    tui_overlay_close();
    gd_reset();

    // ⑦ 浮层全屏（P53）：同一张任务报告，非全屏是 60 列的居中框（上面第 ④c 屏是文本本体），
    //    全屏则占满转录区 —— 面板 / 状态区 / 脚注一行都不动。这一屏就是「全屏」的排版基准。
    tui_overlay_list(TUI_OVK_TASKS, "任务（esc 关闭）" as &const byte,
        bufx_cstr_len("任务（esc 关闭）" as &const byte), rep.ptr as &const byte, rep.len);
    _ = tui_overlay_full(1);
    agent_tui_dump(cols, rows);
    tui_overlay_close();


    return AGENT_OK;
}

// TUI 是否该启用（真正的「终端够不够」判断在 agent_run_tui 里做）
fn agent_tui_wanted(cfg: &const Config) bool {
    return cfg.tui && !cfg.quiet && !cfg.is_subagent;
}
