// src/agent/ag_memory_tui.uya — `/memory` 的动作选择框 + 工作区蒸馏的编排（P107）
//
// 本文件：动作表（`MEM_ACT_*` / `mem_act_name` / `mem_act_gloss`）、菜单行与整表
//   （`agent_tui_memory_line` / `agent_tui_memory_items`）、
//   打开（`agent_tui_memory_open`）、
//   反解（`agent_tui_memory_parse`）、收口（`agent_tui_memory_handle`）、
//   以及蒸馏的编排 `agent_memory_learn`（带 TUI 后台指示）。
// 不变量：① 菜单 kind 与查看器 kind **必须不同**（`TUI_OVK_MEMORY_MENU` vs `TUI_OVK_MEMORY`）：
//   前者「回车派发动作」，后者「回车不派发」。共用一个 kind 时接收端只能挑一种语义，
//   另一种被静默丢弃 —— 这是本仓踩过两次的坑（/watch 借 /tasks、/goal 借 /goal）。
//   ② 只做**已经实现**的动作：菜单里不摆「点了才知道没做」的条目。蒸馏只有 `learn`
//   （工作区、确定性、不调 LLM）；会话蒸馏 / 跨项目晋升 / 候选确认属于后续阶段，
//   落地时才加进表里 —— 摆假条目比不摆更坏（用户会以为记忆在长）。
//   ③ 不可逆动作（`forget`）必须过第二道确认浮层，且游标默认停在「取消」。
//   ④ `learn` 的后台指示**失败也要收尾**：`defer tui_bg_end()` 是硬要求，
//   转轮留在屏幕上不动与「卡死」在观感上无法区分。
// 依赖：foundation/bufx、term/tui（`tui_overlay_menu` / `tui_overlay_list`）、
//   agent/ag_config（`Config`）、
//   agent/ag_pm（`agent_pm_report` / `agent_pm_forget` / `agent_pm_search`）、
//   pm/pm_seed（`pm_seed_run`）、pm/pm_store（`PmSet` 一族）、
//   pm/pm_repo（`PM_PATH_MAX`）、
//   vcs/gitx（`gitx_run`，`all` 列表要用仓库根）。
// 命名：`agent_tui_memory_*` / `agent_memory_*` / `mem_act_*` / `MEM_ACT_*`。

// 动作表。顺序就是菜单行序；`MEM_ACT_SHOW` 是「打开时游标停哪儿」——
// 裸 `/memory` 回车 = 看概况，与 P68 之前的裸命令行为一致（向后兼容）。
const MEM_ACT_N: usize = 6;
const MEM_ACT_SHOW: usize = 0;
const MEM_ACT_SEARCH: usize = 1;
const MEM_ACT_LEARN: usize = 2;
const MEM_ACT_ALL: usize = 3;
const MEM_ACT_FORGET: usize = 4;
const MEM_ACT_OFF: usize = 5;

// 第 i 个动作的**机器名**（反解与派发共用；浮层里也印它，人照着敲也认）。
fn mem_act_name(i: usize) &const byte {
    if i == MEM_ACT_SEARCH {
        return "search" as &const byte;
    }
    if i == MEM_ACT_LEARN {
        return "learn" as &const byte;
    }
    if i == MEM_ACT_ALL {
        return "all" as &const byte;
    }
    if i == MEM_ACT_FORGET {
        return "forget" as &const byte;
    }
    if i == MEM_ACT_OFF {
        return "off" as &const byte;
    }
    return "show" as &const byte;
}

// 第 i 个动作的一句话说明（**只写真的会发生的后果**；危险动作必须写清不可逆）。
fn mem_act_gloss(i: usize, out: &Buf) void {
    buf_reset(out);
    if i == MEM_ACT_SEARCH {
        _ = buf_append_cstr(out,
            "按关键词检索（输入框收词；结果带状态与出处）" as &const byte);
        return;
    }
    if i == MEM_ACT_LEARN {
        _ = buf_append_cstr(out,
            "蒸馏工作区：抽 Makefile 目标与源文件职责（确定性，不调模型）" as &const byte);
        return;
    }
    if i == MEM_ACT_ALL {
        _ = buf_append_cstr(out,
            "看本机全部记忆桶（各项目分别攒了多少）" as &const byte);
        return;
    }
    if i == MEM_ACT_FORGET {
        _ = buf_append_cstr(out,
            "清空**本项目**记忆（不可逆，需二次确认）" as &const byte);
        return;
    }
    if i == MEM_ACT_OFF {
        _ = buf_append_cstr(out,
            "本会话关闭记忆（/new 之后恢复默认）" as &const byte);
        return;
    }
    _ = buf_append_cstr(out,
        "看概况：目录、事实数、各类计数与前几条" as &const byte);
}

// 这一行要不要画 `✓ `（只有 `off` 有状态可言：已关就标上）。
fn mem_act_marked(i: usize, cfg: &const Config) bool {
    if i == MEM_ACT_OFF {
        return cfg.memory_off;
    }
    return false;
}

// 菜单的第 i 行：`✓|  ` + 机器名补齐 8 列 + `— ` + 说明（与 /goal 的行格式一致，
// 因为反解逻辑完全相同：跳过 ✓/两空格，取第一个词）。
fn agent_tui_memory_line(i: usize, cfg: &const Config, out: &Buf) void {
    buf_reset(out);
    const name: &const byte = mem_act_name(i);
    const n: usize = bufx_cstr_len(name);
    if mem_act_marked(i, cfg) {
        _ = buf_append_cstr(out, "✓ " as &const byte);
    } else {
        _ = buf_append_cstr(out, "  " as &const byte);
    }
    _ = buf_append(out, name, n);
    var pad: usize = n;
    while pad < 8 {
        _ = buf_append_byte(out, 32);
        pad = pad + 1;
    }
    _ = buf_append_cstr(out, "— " as &const byte);
    var g: Buf = buf_new(256);
    defer { buf_free(&g); }
    mem_act_gloss(i, &g);
    _ = buf_append(out, g.ptr as &const byte, g.len);
}

// 整张菜单（每行一个 `\n` 结尾的条目）。
fn agent_tui_memory_items(cfg: &const Config) Buf {
    var out: Buf = buf_new(2048);
    var line: Buf = buf_new(512);
    defer { buf_free(&line); }
    var i: usize = 0;
    while i < MEM_ACT_N {
        agent_tui_memory_line(i, cfg, &line);
        _ = buf_append(&out, line.ptr, line.len);
        _ = buf_append_byte(&out, 10);
        i = i + 1;
    }
    return out;
}

// 打开 `/memory` 动作选择浮层（游标默认落 `show`：回车 = 看概况）。
export fn agent_tui_memory_open(cfg: &const Config) void {
    const items: Buf = agent_tui_memory_items(cfg);
    defer { buf_free(&items); }
    const title: &const byte = "记忆（enter 执行 · esc 取消）" as &const byte;
    tui_overlay_menu(TUI_OVK_MEMORY_MENU, title, bufx_cstr_len(title),
        items.ptr as &const byte, items.len, MEM_ACT_SHOW);
}

// 把选中行反解成动作名：跳过 `✓ `（3 字节 + 空格）或两空格，取到第一个空白为止。
// 认不出来返回 false（调用方按「什么都没选」处理，**绝不猜**）。
fn agent_tui_memory_parse(sel: &const Buf, out: &Buf) bool {
    buf_reset(out);
    if sel.len < 3 {
        return false;
    }
    const p: &const byte = sel.ptr as &const byte;
    var s: usize = 2;
    if p[0] == 0xE2 as byte {
        s = 4;      // "✓" 是 E2 9C 93 + 空格
    }
    while s < sel.len && p[s] != 32 as byte && p[s] != 9 as byte {
        _ = buf_append_byte(out, p[s]);
        s = s + 1;
    }
    if out.len == 0 {
        return false;
    }
    var i: usize = 0;
    while i < MEM_ACT_N {
        if bufx_eq_cstr(out.ptr as &const byte, out.len, mem_act_name(i)) {
            return true;
        }
        i = i + 1;
    }
    buf_reset(out);
    return false;
}

// 第 i 个动作在表里的下标（`mem_act_name` 的反函数）；认不出返回 MEM_ACT_N。
fn mem_act_index_of(act: &const Buf) usize {
    var i: usize = 0;
    while i < MEM_ACT_N {
        if bufx_eq_cstr(act.ptr as &const byte, act.len, mem_act_name(i)) {
            return i;
        }
        i = i + 1;
    }
    return MEM_ACT_N;
}

// 消费 `/memory` 浮层的结果（TUI 主循环与自测共用）。返回 true = 处理了一个浮层结果。
// 两道浮层都在这里收口：`TUI_OVK_MEMORY_MENU`（选动作）与 `TUI_OVK_MEMORY_CONFIRM`
// （forget 的第二道确认）。
export fn agent_tui_memory_handle(cfg: &Config, sel: &const Buf) bool {
    const kind: u8 = tui_overlay_kind();
    if kind == TUI_OVK_MEMORY_CONFIRM {
        // 确认框只有两行：第 1 行是动作本身，第 2 行是「取消」。
        // 判据是「选中的是不是第 1 行」，而不是文本相等 —— 文本可能被框宽裁掉。
        if sel.len > 0 && sel.ptr[0] == 0xE2 as byte {
            var out: Buf = buf_new(512);
            defer { buf_free(&out); }
            _ = agent_pm_forget(cfg, &out);
            agent_memory_notice(&out);
        } else {
            agent_memory_notice_cstr("[memory] 已取消\n");
        }
        return true;
    }
    if kind != TUI_OVK_MEMORY_MENU {
        return false;
    }
    var act: Buf = buf_new(32);
    defer { buf_free(&act); }
    if !agent_tui_memory_parse(sel, &act) {
        return true;
    }
    const idx: usize = mem_act_index_of(&act);
    if idx == MEM_ACT_FORGET {
        agent_tui_memory_confirm_forget();
        return true;
    }
    if idx == MEM_ACT_OFF {
        cfg.memory_off = true;
        agent_pm_reset();
        agent_memory_notice_cstr(
            "[memory] 已关闭（本会话不再注入、不再摄取；/new 之后恢复默认）\n");
        return true;
    }
    var out: Buf = buf_new(16384);
    defer { buf_free(&out); }
    if idx == MEM_ACT_SHOW {
        agent_pm_report(cfg, &out);
    } else if idx == MEM_ACT_LEARN {
        _ = agent_memory_learn(cfg, &out);
    } else if idx == MEM_ACT_ALL {
        agent_memory_report_all(cfg, &out);
    } else if idx == MEM_ACT_SEARCH {
        _ = buf_append_cstr(&out,
            "[memory] 检索要关键词：/memory search <词>\n" as &const byte);
    }
    if out.len > 0 {
        tui_overlay_list(TUI_OVK_MEMORY, "记忆（esc 关闭）" as &const byte,
            bufx_cstr_len("记忆（esc 关闭）" as &const byte),
            out.ptr as &const byte, out.len);
    }
    return true;
}

// 开 forget 的第二道确认浮层。**游标默认停在「取消」**（第 2 行）：
// 不可逆动作上「打开就回车」不该等于「删」。
fn agent_tui_memory_confirm_forget() void {
    const items: &const byte =
        "清空本项目记忆\n取消\n" as &const byte;
    // 行宽豁免：确认框文案（断行会改变浮层内容）
    // 行宽豁免：确认框正文（断行会改变浮层内容）
    const prompt: &const byte = "会删掉本项目的整个记忆目录：事实分片、指纹、已蒸馏的知识全部消失，不可撤销（真相仍在工作区与会话日志里，但索引要从头攒）。" as &const byte;
    tui_overlay_menu_confirm(TUI_OVK_MEMORY_CONFIRM,
        "确认清空记忆？" as &const byte,
        bufx_cstr_len("确认清空记忆？" as &const byte),
        prompt, bufx_cstr_len(prompt),
        items, bufx_cstr_len(items), 1);
}

// 一条 notice 打到 tty（TUI 与滚动模式都看得见）。
fn agent_memory_notice_cstr(s: &const byte) void {
    tty_puts(&tty_ui, 2, s);
}

// 把一段缓冲当 notice 打出去（空则什么都不打）。
fn agent_memory_notice(b: &const Buf) void {
    if b.len == 0 {
        return;
    }
    tty_write(&tty_ui, 2, b.ptr as &const byte, b.len);
}

// 本机全部记忆桶：`<agent_home>/memory/*` 逐个报「键 / 分片数 / 事实数」。
// 为什么需要它：记忆按仓库根分桶，用户要知道「这台机器上我一共有几摊记忆、
// 哪些是陈的」—— 没有这一眼，`/memory` 只能看到当前这一个桶。
export fn agent_memory_report_all(cfg: &const Config, out: &Buf) void {
    var home: Buf = buf_new(1024);
    defer { buf_free(&home); }
    if !agent_default_home(cfg, &home) || home.len == 0 {
        _ = buf_append_cstr(out, "取不到 agent home\n" as &const byte);
        return;
    }
    var root: Buf = buf_new(home.len + 16);
    defer { buf_free(&root); }
    if !buf_append(&root, home.ptr, home.len) ||
       !buf_append_cstr(&root, "/memory") {
        return;
    }
    _ = buf_append_cstr(out, "记忆根：" as &const byte);
    _ = buf_append(out, root.ptr as &const byte, root.len);
    _ = buf_append_byte(out, 10);
    var n_bucket: i32 = 0;
    pm_seed_buckets(&root, out, &n_bucket);
    if n_bucket == 0 {
        _ = buf_append_cstr(out, "（还没有任何记忆桶）\n" as &const byte);
    }
    _ = buf_append_cstr(out,
        "（每个桶 = 一个仓库根；当前这个的键见 show）\n" as &const byte);
}

// 蒸馏工作区并写盘（带 TUI 后台指示）。
//
// 阶段与文案（五步各报一次，用户能看出「在动」）：
//   扫描 → 抽 Makefile 目标 → 抽源文件职责 → 写盘 → 收尾
//
// 为什么 `defer tui_bg_end()` 是硬要求：任何一步 return false 都要把转轮收掉。
// 失败静默（记忆是旁路）——但**指示必须收尾**，两者不矛盾：一个管副作用，一个管观感。
export fn agent_memory_learn(cfg: &const Config, out: &Buf) bool {
    if cfg.memory_off {
        _ = buf_append_cstr(out,
            "[memory] 记忆已关闭（--no-memory 或 /memory off）\n" as &const byte);
        return false;
    }
    if !g_pm.ready || g_pm.dir.len == 0 {
        _ = buf_append_cstr(out,
            "[memory] 本会话没有可用的记忆目录\n" as &const byte);
        return false;
    }
    defer tui_bg_end();
    const c1: &const byte = "蒸馏知识中 · 扫描工作区" as &const byte;
    tui_bg_begin(c1, bufx_cstr_len(c1));
    const c2: &const byte = "蒸馏知识中 · 抽 Makefile 与文件职责" as &const byte;
    tui_bg_update(c2, bufx_cstr_len(c2));
    const t: i64 = ua_now_ms() as i64;
    // 分片名固定为 `seed`：这批事实**不是**某一次会话的观测，而是工作区的派生索引。
    // 用会话 id 会让「同一个工作区蒸馏两次」写成两个分片，读取时虽然会归并，
    // 但盘上会越积越多（而这批东西的真相永远在工作区里，不需要按会话留存）。
    var sidb: Buf = buf_new(8);
    defer { buf_free(&sidb); }
    _ = buf_append_cstr(&sidb, "seed");
    const n: i32 = pm_seed_run(g_pm.dir.ptr as &const byte, g_pm.dir.len,
                               sidb.ptr as &const byte, sidb.len,
                               g_pm.ws.ptr as &const byte, g_pm.ws.len, t);
    const c3: &const byte = "蒸馏知识中 · 写盘" as &const byte;
    tui_bg_update(c3, bufx_cstr_len(c3));
    if n > 0 {
        _ = buf_append_cstr(out, "[memory] 蒸馏完成：新增 " as &const byte);
        _ = buf_append_i64(out, n as i64);
        _ = buf_append_cstr(out, " 条事实（用 show 看）\n" as &const byte);
    } else {
        _ = buf_append_cstr(out,
            "[memory] 工作区指纹没变（或抽不出东西）：这次一个字节都没读\n" as &const byte);
    }
    return true;
}
