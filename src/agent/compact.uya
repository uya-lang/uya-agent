// src/agent/compact.uya — 上下文管理（P9，对齐 DSH compaction + tool-result-pruner）
//
// 本文件：件① tool 结果剪枝（通用 `cmp_maybe_prune` + bash 专用行式 `cmp_maybe_prune_bash`
//   与兜底 `cmp_span_cut`）**及其压力闸门 `cmp_prune_armed`**（P79：没压力就不剪，
//   否则会自锁成补救读，见 §5.3.1）；件② 自动压缩（`cmp_*` 的 checkpoint 组装、
//   保留量估算 `cmp_retain_bytes`）；件③ P88 的**保守** token 估算与「装得下」判据
//   （`cmp_est_tokens` / `cmp_summary_budget` / `cmp_fit_start`，给摘要请求与恢复路径用，
//   见 §19.10）；另有观测用的小工具（`cmp_cache_burst`、
//   `cmp_pressure_limit`、`cmp_line_ptr`）。旋钮是一组 `var cmp_*`，preset 可覆盖。
// 不变量：① 剪枝**只在构请求层生效、不动历史** —— 于是天然幂等、日志里留的是原文、
//   `--resume` 后重新构请求仍得同一结果；② 剪枝**按码点**计数（对齐 DSH `Array.from(text).length`），
//   不是字节；③ 剪枝契约统一：需要剪就写 out 返回 true，**不剪就不动 out** 返回 false；
//   ④ 结果**不许超过触发阈值**（否则下一轮会被再剪一次）也**不许比原文长**；
//   ⑤ 预算太小或保留量不足预算 1/4 时**退回通用规则**（任何输入都不比旧行为更差）；
//   ⑥ 压缩压力口径 = `usage_in + usage_cache_read`（= prompt_tokens，与 DSH tokenMeter 一致），
//   拿不到 usage 时退化成「字节 / 4」估算；触发线 `floor(window × 0.8)`；
//   ⑦ 压缩的**硬规则**：摘要不比被遮蔽内容短就**拒绝**（否则「压缩」会反而撑大上下文）；
//   ⑧ **两套 token 口径不许合并**：调度用 `bytes / 4`（中位口径，估偏只是早晚一步的事），
//   安全用 `CMP_EST_*`（2.5 B/tok，低估会让请求发出去被窗口拒掉 —— 那条路上没有第二次机会）。
// 依赖：无 `use` 行；依赖 foundation/bufx（Buf / `bufx_utf8_count` / `bufx_utf8_prefix_bytes` /
//   `bufx_utf8_suffix_offset`）与 foundation/jsonx。
// 命名：`cmp_*`、`CMP_*`、`CHECKPOINT_*`。
//
// 两件事：
//   1) **tool 结果剪枝**：文本超过 thresholdChars（8192）**码点**时，替换成
//      前 headChars（4096）码点 + 固定标记 + 后 tailChars（1024）码点。
//      只在**构请求**时生效（不动历史），所以天然幂等；标记逐字对齐 DSH：
//      "\n\n[... tool result middle pruned ...]\n\n"
//   2) **自动压缩**：step 边界测压（压力 ≥ floor(contextWindow × 0.8)）时，
//      调一次模型把**较早的一段**对话压成 checkpoint，替换成一条 user 消息：
//      CHECKPOINT_PREAMBLE + "\n\n" + <compacted-summary>…</compacted-summary>。
//      保留最近 retainRatio(0.16) 的原文；摘要不比被遮蔽内容短就拒绝（DSH 的硬规则）。
//
// 压力口径与 DSH 的 tokenMeter 一致：inputTokens + cacheReadTokens（即 prompt_tokens）。
// 拿不到 usage 时退化成「字节 / 4」的估算。

export var cmp_prune_threshold: usize = 8192;   // thresholdChars（码点）
export var cmp_prune_head: usize = 4096;        // headChars
export var cmp_prune_tail: usize = 1024;        // tailChars
export const CMP_PRUNE_MARK: &const byte = "\n\n[... tool result middle pruned ...]\n\n";

export const CHECKPOINT_PREAMBLE: &const byte = "This is an automatically generated checkpoint condensing an earlier span of the conversation to free up context. Treat the captured context as established background and build on it without restating it. Continue the task directly from the messages that follow, without acknowledging this checkpoint.";

// ============================================================
// tool 结果剪枝
// ============================================================
// 需要剪枝就把剪枝后的文本写进 out 并返回 true；否则 out 不动、返回 false。
export fn cmp_maybe_prune(text: &const byte, n: usize, out: &Buf) bool {
    const cps: usize = bufx_utf8_count(text, n);
    if cps <= cmp_prune_threshold {
        return false;
    }
    const head_bytes: usize = bufx_utf8_prefix_bytes(text, n, cmp_prune_head);
    const tail_start: usize = bufx_utf8_suffix_offset(text, n, cmp_prune_tail);
    buf_reset(out);
    if !buf_append(out, text, head_bytes) {
        return false;
    }
    if !buf_append_cstr(out, CMP_PRUNE_MARK) {
        return false;
    }
    const tail: &const byte = @ptr_from_usize(@usize_from_ptr(text as &const void) + tail_start) as &const byte;
    return buf_append(out, tail, n - tail_start);
}

// ============================================================
// bash 结果的剪枝（P27）：同一预算内按「信息价值」重分配
// ============================================================
// 实测口径（34 个真会话 / 1375 个 bash 结果的真轨迹分析）：
//   * bash 结果占请求窗口的 57.9%，read 只占 12.9%；
//   * 其中 >8192 码点、会走剪枝的只有 13 个（占 bash 内容 7.7%）；
//   * 旧规则（头 4096 + 尾 1024 码点）在这 13 个样本上只保住 60.2% 的信号行
//     （error/fail/panic/…），输出十分位覆盖只有首尾两段。
//
// 新规则在**同一预算**（headChars + tailChars 码点）内改三段分配：
//   头 = 1/5（命令开场）、尾 = 1/5（构建/测试结论通常在末尾）、中段 = 其余；
//   中段先收信号行（最多占 80% 预算），余量按等距抽样铺满整个输出，
//   抽样行带原始行号 @N:，模型据此能再跑一条更窄的命令。
// 同样本实测（把本实现原样移植回 Python 复算，与 selftest[prune-bash] 夹具逐项对齐）：
// 信号行保全 0.602 → 1.000，十分位覆盖 0.2 → 0.83，
// 结构标记保全 0.358 → 0.309（略降），token 23,619 → 21,379（-9.5%，同预算下反而更省）。
// 预算太小（total < CMP_BASH_MIN_BUDGET）或结果异常（保留量不足预算 1/4）时
// 退回通用规则，保证任何输入都不会比旧行为更差。
export const CMP_KIND_TOOL: u8 = 0;     // read / grep / … 等工具结果
export const CMP_KIND_BASH: u8 = 1;     // bash 结果：走下面的行式剪枝

// bash 专用旋钮（0 = 沿用通用值，所以默认行为与没有这两个旋钮时**逐字一致**）：
//   cmp_bash_threshold  触发阈值（默认 thresholdChars）
//   cmp_bash_permille   预算缩放千分比（默认 1000‰ = headChars + tailChars）
// 用途：把「2–8K 这一档从没被剪过的 bash 输出」纳入剪枝时，可以在不改动 read/grep
// 行为的前提下单独调 bash（A/B 的两条臂就靠它们切换）。
export var cmp_bash_threshold: usize = 0;
export var cmp_bash_permille: usize = 0;

const CMP_BASH_MIN_BUDGET: usize = 512;   // 低于这个预算就别剪 bash 结果了（剪了也没信息量）
const CMP_BASH_SIGNAL_PERMILLE: usize = 800;   // 中段预算里信号行最多占的比例
const CMP_BASH_LINE_MAX: usize = 200;          // 单行最多保留多少码点
const CMP_BASH_MARK_ALLOW: usize = 160;        // 标记自身的预算预留（码点）

const CMP_BASH_MARK_A: &const byte = "\n\n[... bash output pruned: ";
const CMP_BASH_MARK_B: &const byte = " line(s) kept (@N = original line number; run a narrower command such as grep/sed -n for the rest) ...]\n\n";

// 行尾（'\n' 的下标，或 limit）
fn cmp_line_end(p: &const byte, limit: usize, from: usize) usize {
    var i: usize = from;
    while i < limit && p[i] != 10 {
        i = i + 1;
    }
    return i;
}

// pos 之前那一行的起始下标（pos 处通常是 '\n'）
fn cmp_prev_line_start(p: &const byte, pos: usize) usize {
    var i: usize = pos;
    if i > 0 && p[i - 1] == 10 {
        i = i - 1;
    }
    while i > 0 && p[i - 1] != 10 {
        i = i - 1;
    }
    return i;
}

// 大小写不敏感的子串匹配（needle 只写小写 ASCII；非 ASCII 按字节等值比）
fn cmp_has_ci(p: &const byte, n: usize, needle: &const byte) bool {
    const nl: usize = bufx_cstr_len(needle);
    if nl == 0 || n < nl {
        return false;
    }
    var i: usize = 0;
    while i + nl <= n {
        var k: usize = 0;
        var hit: bool = true;
        while k < nl {
            if byte_lower(p[i + k]) != byte_lower(needle[k]) {
                hit = false;
                break;
            }
            k = k + 1;
        }
        if hit {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 诊断/失败/结论类「信号行」。这套词表是拿 13 个真实超阈值输出调出来的：
// 目标是让 error/FAIL/exit code 这类决定下一步动作的行一条都不丢。
fn cmp_line_is_signal(p: &const byte, n: usize) bool {
    if cmp_has_ci(p, n, "error") { return true; }
    if cmp_has_ci(p, n, "fail") { return true; }
    if cmp_has_ci(p, n, "fatal") { return true; }
    if cmp_has_ci(p, n, "panic") { return true; }
    if cmp_has_ci(p, n, "exception") { return true; }
    if cmp_has_ci(p, n, "traceback") { return true; }
    if cmp_has_ci(p, n, "denied") { return true; }
    if cmp_has_ci(p, n, "cannot") { return true; }
    if cmp_has_ci(p, n, "undefined") { return true; }
    if cmp_has_ci(p, n, "conflict") { return true; }
    if cmp_has_ci(p, n, "not found") { return true; }
    if cmp_has_ci(p, n, "no such file") { return true; }
    if cmp_has_ci(p, n, "exit code") { return true; }
    if cmp_has_ci(p, n, "warning") { return true; }
    if cmp_has_ci(p, n, "assert") { return true; }
    if cmp_has_ci(p, n, "✗") { return true; }
    return false;
}

// 指针算术：text + off。配套 `bufx_utf8_suffix_offset` 用（它给的是字节偏移）。
fn cmp_line_ptr(text: &const byte, off: usize) &const byte {
    return @ptr_from_usize(@usize_from_ptr(text as &const void) + off) as &const byte;
}

// 写一行（可选行号前缀），单行按 CMP_BASH_LINE_MAX 码点截断
fn cmp_put_line(out: &Buf, text: &const byte, ls: usize, le: usize, lineno: usize, with_no: bool) bool {
    if with_no {
        if !buf_append_byte(out, 64) {          // '@'
            return false;
        }
        if !buf_append_u64(out, lineno as u64) {
            return false;
        }
        if !buf_append_cstr(out, ": ") {
            return false;
        }
    }
    const lp: &const byte = cmp_line_ptr(text, ls);
    var len: usize = le - ls;
    var cut: bool = false;
    if bufx_utf8_count(lp, len) > CMP_BASH_LINE_MAX {
        len = bufx_utf8_prefix_bytes(lp, len, CMP_BASH_LINE_MAX);
        cut = true;
    }
    if !buf_append(out, lp, len) {
        return false;
    }
    if cut {
        // 截断要留痕：模型得知道这一行被切过，否则会把半行当全文
        if !buf_append_cstr(out, " …") {
            return false;
        }
    }
    return buf_append_byte(out, 10);
}

// 兜底：按码点头/尾切。跟行式规则**同一预算**，所以永远不会比原文更长。
// （早先这里退回 cmp_maybe_prune，而它按全局 headChars/tailChars 取值 —— 一旦把
//  bash 的触发阈值调到比 headChars+tailChars 小，剪枝就会把消息**放大**。实测在
//  1024/768 这一档，657 个真实输出里有 600 个被放大，合计多出 60 万码点。）
const CMP_BASH_SPAN_MARK: &const byte = "\n\n[... bash output truncated to head + tail ...]\n\n";

// bash 剪枝的**兜底路径**：按**码点**头 head_cps + 标记 + 尾 tail_cps 切。
// 它与行式规则**同一预算**，所以结果永远不会比原文长。为什么不能退回 `cmp_maybe_prune`：
// 那个按全局 headChars/tailChars 取值，一旦把 bash 触发阈值调到比它们的和小，
// 剪枝就会把消息**放大**（实测 1024/768 档：657 个真输出里 600 个被放大，多出 60 万码点）。
fn cmp_span_cut(text: &const byte, n: usize, head_cps: usize, tail_cps: usize, out: &Buf) bool {
    buf_reset(out);
    const hb: usize = bufx_utf8_prefix_bytes(text, n, head_cps);
    if !buf_append(out, text, hb) {
        return false;
    }
    if !buf_append_cstr(out, CMP_BASH_SPAN_MARK) {
        return false;
    }
    const ts: usize = bufx_utf8_suffix_offset(text, n, tail_cps);
    return buf_append(out, cmp_line_ptr(text, ts), n - ts);
}

// bash 结果的**行式**剪枝（P27）：同一预算内改三段分配（头 1/5、尾 1/5、中段收信号行 +
// 等距抽样），细节与实测数字见文件头。
// 契约与 `cmp_maybe_prune` 一致：需要剪就把结果写进 out 并返回 true，否则 **out 不动**返回 false。
// 预算被夹到「触发阈值 − 标记预留」以内，保证幂等（结果不会再次超阈值）且不反向放大。
export fn cmp_maybe_prune_bash(text: &const byte, n: usize, out: &Buf) bool {
    var trigger: usize = cmp_prune_threshold;
    if cmp_bash_threshold > 0 {
        trigger = cmp_bash_threshold;
    }
    if bufx_utf8_count(text, n) <= trigger {
        return false;                            // 与 cmp_maybe_prune 同契约：不剪就不动 out
    }
    // 预算 = headChars + tailChars；但要夹到「触发阈值 - 标记预留」以内：
    //   1) 剪枝必须幂等（结果不许超过触发阈值，否则下一轮还会被剪一次）；
    //   2) 旋钮被调小时不许反向放大。
    var total: usize = cmp_prune_head + cmp_prune_tail;
    if cmp_bash_permille > 0 {
        total = (total * cmp_bash_permille) / 1000;
    }
    if total + CMP_BASH_MARK_ALLOW > trigger {
        if trigger > CMP_BASH_MARK_ALLOW {
            total = trigger - CMP_BASH_MARK_ALLOW;
        } else {
            total = 0;
        }
    }
    if total < CMP_BASH_MIN_BUDGET {
        return false;                        // 预算太小不值得剪：原样返回（绝不放大）
    }
    const head_b: usize = total / 5;
    const tail_b: usize = total / 5;
    var mid_b: usize = total - head_b - tail_b;
    if mid_b > CMP_BASH_MARK_ALLOW {
        mid_b = mid_b - CMP_BASH_MARK_ALLOW;
    }

    buf_reset(out);
    // ---- 头：从头按行取满 head_b ----
    var hi: usize = 0;
    var hl: usize = 0;
    var used_h: usize = 0;
    while hi < n {
        const le: usize = cmp_line_end(text, n, hi);
        const lcps: usize = bufx_utf8_count(cmp_line_ptr(text, hi), le - hi);
        if hl > 0 && used_h + lcps + 1 > head_b {
            break;
        }
        if !cmp_put_line(out, text, hi, le, hl + 1, false) {
            return false;
        }
        used_h = used_h + lcps + 1;
        hl = hl + 1;
        if le >= n {
            hi = n;
            break;
        }
        hi = le + 1;
    }
    // ---- 尾：从末尾按行回退到 tail_b ----
    var ti: usize = n;
    var tl: usize = 0;
    var used_t: usize = 0;
    while ti > hi {
        const ls: usize = cmp_prev_line_start(text, ti);
        if ls < hi {
            break;
        }
        const le2: usize = cmp_line_end(text, ti, ls);
        const lcps2: usize = bufx_utf8_count(cmp_line_ptr(text, ls), le2 - ls);
        if tl > 0 && used_t + lcps2 + 1 > tail_b {
            break;
        }
        used_t = used_t + lcps2 + 1;
        tl = tl + 1;
        ti = ls;
    }
    // ---- 中段第 1 遍：统计行数 / 信号行 / 码点 ----
    var mid_lines: usize = 0;
    var sig_lines: usize = 0;
    var sig_cps: usize = 0;
    var mid_cps: usize = 0;
    var mi: usize = hi;
    while mi < ti {
        const le3: usize = cmp_line_end(text, ti, mi);
        const lp: &const byte = cmp_line_ptr(text, mi);
        const lcps3: usize = bufx_utf8_count(lp, le3 - mi);
        var kcps: usize = lcps3;
        if kcps > CMP_BASH_LINE_MAX {
            kcps = CMP_BASH_LINE_MAX;
        }
        mid_lines = mid_lines + 1;
        mid_cps = mid_cps + kcps + 1;
        if cmp_line_is_signal(lp, le3 - mi) {
            sig_lines = sig_lines + 1;
            sig_cps = sig_cps + kcps + 16;       // 含 "@行号: " 前缀
        }
        if le3 + 1 <= mi {
            break;
        }
        mi = le3 + 1;
    }
    // ---- 中段预算分配：信号行优先，余量等距抽样 ----
    const sig_budget: usize = (mid_b * CMP_BASH_SIGNAL_PERMILLE) / 1000;
    var sig_keep: usize = sig_lines;
    if sig_cps > sig_budget && sig_cps > 0 {
        sig_keep = (sig_lines * sig_budget) / sig_cps;
        if sig_keep < 1 {
            sig_keep = 1;
        }
    }
    var sig_used: usize = sig_cps;
    if sig_used > sig_budget {
        sig_used = sig_budget;
    }
    var rem: usize = 0;
    if mid_b > sig_used {
        rem = mid_b - sig_used;
    }
    var div_lines: usize = mid_lines;
    if div_lines == 0 {
        div_lines = 1;
    }
    const avg_slot: usize = mid_cps / div_lines + 16;
    var div_slot: usize = avg_slot;
    if div_slot == 0 {
        div_slot = 1;
    }
    var slots: usize = rem / div_slot;
    const other_lines: usize = mid_lines - sig_lines;
    if slots > other_lines {
        slots = other_lines;
    }
    var stride: usize = 1;
    if slots > 0 && other_lines > slots {
        stride = other_lines / slots;
    }
    // ---- 中段第 2 遍：按原顺序收信号行 + 抽样行 ----
    var mid: Buf = buf_new(mid_b + 512);
    defer { buf_free(&mid); }
    var mi2: usize = hi;
    var lineno: usize = hl + 1;
    var s_kept: usize = 0;
    var s_seen: usize = 0;
    var k_kept: usize = 0;
    while mi2 < ti {
        const le4: usize = cmp_line_end(text, ti, mi2);
        const lp2: &const byte = cmp_line_ptr(text, mi2);
        var take: bool = false;
        if cmp_line_is_signal(lp2, le4 - mi2) {
            if s_kept < sig_keep {
                take = true;
                s_kept = s_kept + 1;
            }
        } else {
            if k_kept < slots && s_seen % stride == 0 {
                take = true;
                k_kept = k_kept + 1;
            }
            s_seen = s_seen + 1;
        }
        if take && !cmp_put_line(&mid, text, mi2, le4, lineno, true) {
            return false;
        }
        lineno = lineno + 1;
        if le4 + 1 <= mi2 {
            break;
        }
        mi2 = le4 + 1;
    }
    // ---- 拼装：头 + 标记 + 中段 + 尾 ----
    const kept: usize = hl + s_kept + k_kept + tl;
    if !buf_append_cstr(out, CMP_BASH_MARK_A) {
        return false;
    }
    if !buf_append_u64(out, kept as u64) {
        return false;
    }
    if !buf_append_cstr(out, " of ") {
        return false;
    }
    if !buf_append_u64(out, (hl + mid_lines + tl) as u64) {
        return false;
    }
    if !buf_append_cstr(out, CMP_BASH_MARK_B) {
        return false;
    }
    if !buf_append(out, mid.ptr, mid.len) {
        return false;
    }
    var ti2: usize = ti;
    while ti2 < n {
        const le5: usize = cmp_line_end(text, n, ti2);
        if !cmp_put_line(out, text, ti2, le5, 0, false) {
            return false;
        }
        if le5 + 1 <= ti2 {
            break;
        }
        ti2 = le5 + 1;
    }
    // 保底 1：留得太少（例如整段是一行超长文本）→ 用同预算的头尾码点切
    if bufx_utf8_count(out.ptr as &const byte, out.len) * 4 < total {
        var sh: usize = (total - CMP_BASH_MARK_ALLOW) / 2;
        if sh == 0 {
            sh = total / 2;
        }
        return cmp_span_cut(text, n, sh, sh, out);
    }
    // 保底 2：剪枝永远不许把消息变长（调用方遇到 false 就用原文）
    if out.len >= n {
        buf_reset(out);
        return false;
    }
    return true;
}

// 按工具种类分派：bash 走行式剪枝，其余走通用规则
export fn cmp_maybe_prune_kind(text: &const byte, n: usize, kind: u8, out: &Buf) bool {
    if kind == CMP_KIND_BASH {
        return cmp_maybe_prune_bash(text, n, out);
    }
    return cmp_maybe_prune(text, n, out);
}

// 构请求时这条消息实际会占多少**字节**（压力估算用：估算必须跟请求同口径）
export fn cmp_request_bytes(text: &const byte, n: usize, kind: u8, scratch: &Buf) usize {
    if cmp_maybe_prune_kind(text, n, kind, scratch) {
        return scratch.len;
    }
    return n;
}

// ============================================================
// 压力闸门：**没有压力就不剪**（P79）
// ============================================================
// 为什么必须加这条闸门（真机实测，见 DESIGN §5.3.1）：
// 剪枝原来在**每次构请求**时无条件生效 —— 只要单条工具结果超过 8192 码点就把中段
// 换成标记。而 DSH 用同一套数字（8192/4096/1024）却只在**压力达标**时才剪
// （它自己的 README 写着 "Below-pressure step checks never prune"）。缺这条闸门会
// 造成一个**自锁循环**：读一个 16k 的文件 → 中段被剪掉 → 模型为找回中段再窄读一段
// → 那一段**也**超过 8192 → 又被剪 → 再读……实测 taskflow 一题 29 次 read 里有 11 次
// 是这种补救读，23 步里 21 步在探索，第 19 步才第一次写文件。
//
// 实测 A/B（同题同模型，只把阈值 8192 提到 200000）：模型调用 24 次 → 13 次，
// 得分都是 1.0000 —— 所以这纯是浪费，不是能力。
//
// 闸门开不开都**不改变剪枝本身的语义**（不改历史、按码点、契约统一）——
// 它只决定「这一步要不要动用剪枝」。
export var cmp_prune_pressure_gated: bool = true;

// 闸门用的触发比例（千分数），默认与压缩同一条线（DSH thresholdRatio 0.8）。
// 由 `agent_apply_knobs` 从 preset 的 `thresholdRatioPermille` 灌进来。
export var cmp_compact_threshold_permille: i64 = 800;

// 压力闸门：返回 true = 这一步可以剪（压力达标、或窗口未知这种保守情形）。
// projected_bytes = 当前历史的原始字节数（**未剪**口径，见下面为什么不用 cmp_request_bytes）。
// omit_ratio_permille：给自测用的覆盖值，<=0 时用 cmp_compact_threshold_permille。
export fn cmp_prune_armed(projected_bytes: usize, context_window: i64,
                          omit_ratio_permille: i64) bool {
    if !cmp_prune_pressure_gated {
        return true;                       // 闸门关掉 = 旧行为（自测的对照臂）
    }
    if context_window <= 0 {
        return true;                       // 窗口未知：保守剪，宁可丢中段也不撑爆请求
    }
    var ratio: i64 = omit_ratio_permille;
    if ratio <= 0 {
        ratio = cmp_compact_threshold_permille;
    }
    if ratio <= 0 {
        ratio = CMP_THRESHOLD_PERMILLE;
    }
    // 与压缩同一条触发线：floor(window × ratio)。字节 → token 用「4 字符 ≈ 1 token」
    // （与 agent_pressure_tokens 同口径）。
    const limit: i64 = (context_window *% ratio) / (1000 as i64);
    const est_tokens: i64 = (projected_bytes as i64) / 4;
    return est_tokens >= limit;
}

// 历史里「不剪的话」会占多少字节 —— 闸门的输入口径。
// 刻意**不**用 cmp_request_bytes：那个函数自己会调剪枝，用它当闸门输入就成了
// 「剪枝决定要不要剪枝」的循环论证（剪过之后字节变小 → 压力看起来达标 → 又剪）。
export fn cmp_raw_tool_bytes(h: &const History) usize {
    var total: usize = 0;
    var i: usize = 0;
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        total = total + m.text_len + m.extra_len;
        i = i + 1;
    }
    return total;
}

// ============================================================
// provider 侧缓存淘汰的可见性（P28）
// ============================================================
// 实测（35 个真会话 / 1589 步）：有 15 步「未命中 ≥8192 且占 prompt ≥10%」，
// 它们吃掉全部未命中的 33%，而同会话的相邻步都是几百~几千的小未命中 —— 也就是
// **请求侧字节是稳定的，丢的是会话私有的缓存块**（命中只剩共享前缀，实测那一步
// 命中恰好 4,480 tok），全程 0 次压缩。结论：这部分钱不在客户端，省不掉，但必须
// 看得见 —— 否则会被误当成「压缩太频繁」（第一版诊断我就这么错过了）。
// 正常步的未命中占比实测最高 1.3%，这条 10% 的门槛把两类分得很开。
const CACHE_BURST_MIN_MISS: i64 = 8192;
const CACHE_BURST_MIN_PROMPT: i64 = 32768;
const CACHE_BURST_RATIO_PERMILLE: i64 = 100;

// 事件 payload（纯函数，便于单测）：{"prompt":N,"miss":N,"hit":N}
export fn cmp_cache_burst_json(miss: i64, prompt: i64, hit: i64, out: &Buf) bool {
    buf_reset(out);
    if !buf_append_cstr(out, "{\"prompt\":") {
        return false;
    }
    if !buf_append_i64(out, prompt) {
        return false;
    }
    if !buf_append_cstr(out, ",\"miss\":") {
        return false;
    }
    if !buf_append_i64(out, miss) {
        return false;
    }
    if !buf_append_cstr(out, ",\"hit\":") {
        return false;
    }
    if !buf_append_i64(out, hit) {
        return false;
    }
    return buf_append_byte(out, 125);        // '}'
}

// 缓存「突发未命中」判定：这次请求的未命中量 miss 相对总 prompt 是否超过
// CACHE_BURST_RATIO_PERMILLE 千分比（且两个绝对值都过了最小门槛）。
// 用来解释「上一轮明明命中率很高，这一轮怎么突然贵了」—— 典型原因是历史被改了前缀。
//
// **只对「有缓存明细」的步成立**：缺明细时 miss 等于整个 prompt、hit 等于 0，形状上
// 与一次全量淘汰一模一样，但那是「没读数」而不是「缓存没了」。判据留给调用方
// （`cmp_cache_unknown`），别把它折进这里 —— 两个问题必须能分别回答。
export fn cmp_cache_burst(miss: i64, prompt: i64) bool {
    if miss < CACHE_BURST_MIN_MISS || prompt < CACHE_BURST_MIN_PROMPT {
        return false;
    }
    return miss *% 1000 >= prompt *% CACHE_BURST_RATIO_PERMILLE;
}

// 这一步是不是「提供方根本没回缓存明细」（P72 踩坑 123）。
// 与 cmp_cache_burst 是**互斥**的两个问题：这个答「有没有读数」，那个答「读数是不是突变」。
// 上游 2026-10-07 起会间歇只发 OpenAI 方言、漏发 DeepSeek 方言字段；漏发时整段 prompt 会
// 被记成未命中，若拿它去判突发，日志里就会堆满假警报（实测 375/771 条）。
export fn cmp_cache_unknown(have_split: bool, prompt: i64) bool {
    if have_split {
        return false;
    }
    return prompt > 0;
}

// ============================================================
// 压力与阈值
// ============================================================
// DSH：thresholdRatio 默认 0.8（这里用千分数避免浮点）
const CMP_THRESHOLD_PERMILLE: i64 = 800;
export var cmp_retain_permille: i64 = 160;

// 压缩触发线 = `floor(window × 0.8)`（DSH 的 thresholdRatio 0.8，这里用千分数避免浮点）。
// `window <= 0`（未知）返回 0 = 不触发。
export fn cmp_pressure_limit(context_window: i64) i64 {
    if context_window <= 0 {
        return 0;
    }
    return (context_window *% CMP_THRESHOLD_PERMILLE) / (1000 as i64);
}

// ============================================================
// 智能压缩：**中途收敛**（不能只靠「占满窗口」这一条线）
// ============================================================
// 为什么需要它（真机现场，2026-10-22）：
//   `cmp_pressure_limit` 只有 `window × 0.8` 一条线。deepseek-v4.1-flash 的窗口是
//   1,000,000，触发线就是 800k —— 而 webcore 60 步跑下来压力只到 50–110k，
//   **离触发线差 8 倍，全程一次都没压**。会话日志里 60 个 step/start、0 个压缩事件；
//   上下文从 7.6k 单调爬到 73.8k 不回头，每一步都要把全部历史连同全部 reasoning
//   重新发一遍 ⇒ 同题 token 是对手的 2 倍（3,384k vs 554k）。
//   **大窗口模型上「占满 0.8 窗口才压」等于永不压**。这条线对小窗口是对的
//   （那里 0.8 窗口就是几十 k），对大窗口就失效了。
//
// 判据（三条任一成立就该压，都只看「体量」）：
//   ① 窗口线：`pressure >= window × 0.8` —— 原有行为，一字不改；
//   ② 绝对线：`pressure >= cmp_soft_limit_tokens`。超过它以后每一步的边际成本
//      （每轮重发全部历史）已经明显高于压一次的损失；
//   ③ 增长线：`pressure >= 基线 × cmp_growth_permille/1000` 且
//      `pressure >= cmp_growth_floor_tokens`。基线是**上一次压缩之后**的压力，
//      所以这条线天然带滞回：压完掉到基线以下，要重新长到 N 倍才会再压，
//      不会每步都压。
// 三条都只回答「该不该压」，真正压不压还要过 `cmp_shadow_count` 与摘要预算闸门
// （见 agent_maybe_compact）—— 没有可遮蔽的段就压不动，这里不越权。

// 单请求体量的经验上限（token）。0 = 关掉这条线（回到只看窗口的老行为）。
// 150000 是实测调出来的，不是拍的：60k 时 webcore 压了 17 次、token 反而涨到
// 2.43 倍（每次压缩都要多发一发摘要请求，压得太勤就是纯亏）；150k 只压 4 次，
// token 与不压缩持平（2,559k vs 2,587k）、轮数 53 vs 47。
export var cmp_soft_limit_tokens: i64 = 150000;

// 增长线：涨到基线的多少千分比就收敛。1600‰ = 1.6 倍。0 = 关掉这条线。
export var cmp_growth_permille: i64 = 2500;

// 增长线的地板：压力低于它不谈「涨了没涨」（几千 token 的小会话不该被压）。
export var cmp_growth_floor_tokens: i64 = 60000;

// 大窗口下固定 150k/60k 太早：超过 1M 窗口的 15%/6% 就压，
// 实测 webcore 89 步里压了 6 次、dsh 0 次。按窗口比例抬高下限，
// 0 = 关掉比例项（回到固定值，便于 A/B）。
export var cmp_soft_window_permille: i64 = 300;
export var cmp_growth_window_permille: i64 = 200;

// 上一次压缩之后的压力基线（token）。-1 = 还没采到过。
export var cmp_growth_base_tokens: i64 = -1;

// 记下新的压力基线（每次压缩成功后调用；见 agent_maybe_compact）。
export fn cmp_growth_reset(pressure: i64) void {
    cmp_growth_base_tokens = pressure;
}

// 该不该压？`pressure` = 当前 prompt 压力（token），`window` = 上下文窗口。
export fn cmp_should_compact(pressure: i64, context_window: i64) bool {
    if pressure <= 0 {
        return false;
    }
    // ① 窗口线（原行为，逐字不变）
    const limit: i64 = cmp_pressure_limit(context_window);
    if limit > 0 && pressure >= limit {
        return true;
    }
    // ② 绝对线
    if cmp_soft_limit_tokens > 0 && pressure >= cmp_soft_limit_tokens {
        return true;
    }
    // ③ 增长线：只跟「上一次压完之后」的基线比，天然带滞回
    if cmp_growth_permille > 0 && cmp_growth_base_tokens > 0
        && pressure >= cmp_growth_floor_tokens {
        const target: i64 =
            (cmp_growth_base_tokens *% cmp_growth_permille) / 1000;
        if pressure >= target {
            return true;
        }
    }
    return false;
}

// 窗口相对版的绝对线：大窗口下按比例抬高，小窗口仍用固定下限。
export fn cmp_soft_limit_for(context_window: i64) i64 {
    var limit: i64 = cmp_soft_limit_tokens;
    if cmp_soft_window_permille > 0 && context_window > 0 {
        const rel: i64 =
            (context_window *% cmp_soft_window_permille) / 1000;
        if rel > limit {
            limit = rel;
        }
    }
    return limit;
}

// 窗口相对版的增长线地板：同上。
export fn cmp_growth_floor_for(context_window: i64) i64 {
    var floor: i64 = cmp_growth_floor_tokens;
    if cmp_growth_window_permille > 0 && context_window > 0 {
        const rel: i64 =
            (context_window *% cmp_growth_window_permille) / 1000;
        if rel > floor {
            floor = rel;
        }
    }
    return floor;
}

// 窗口相对版：窗口线不变；绝对线/增长线用 for() 的窗口比例。
// 这是 agent_maybe_compact 实际用的判据；cmp_should_compact 保留
// 固定阈值语义，给旧测试/旧配置做对照。
export fn cmp_should_compact_window(pressure: i64,
    context_window: i64) bool {
    if pressure <= 0 {
        return false;
    }
    const limit: i64 = cmp_pressure_limit(context_window);
    if limit > 0 && pressure >= limit {
        return true;
    }
    const soft: i64 = cmp_soft_limit_for(context_window);
    if soft > 0 && pressure >= soft {
        return true;
    }
    const floor: i64 = cmp_growth_floor_for(context_window);
    if cmp_growth_permille > 0 && cmp_growth_base_tokens > 0
        && pressure >= floor {
        const target: i64 =
            (cmp_growth_base_tokens *% cmp_growth_permille) / 1000;
        if pressure >= target {
            return true;
        }
    }
    return false;
}

// ── 上下文感知闸门（2026-10-23）────────────────────────────
// 压力大不等于该压：压一次要付一次摘要请求，还会丢掉原文。
// 只有阴影段够大、估算净收益够多、离上次压缩够久时才压。
// 窗口线仍是硬安全线，先于这三道闸门。
export var cmp_min_shadow_bytes: usize = 16384;
export var cmp_min_gain_bytes: usize = 8192;
export var cmp_compact_cooldown_steps: i32 = 2;
export var cmp_min_gain_tokens: i64 = 8192;
export var cmp_last_compact_step: i32 = -1;
export var cmp_last_compact_pressure: i64 = -1;

// [0, shadow) 的原始字节数（未剪口径，与 cmp_shadow_count 边界同源）
export fn cmp_shadow_bytes(h: &const History, shadow: usize) usize {
    var total: usize = 0;
    var end: usize = shadow;
    if end > h.len {
        end = h.len;
    }
    var i: usize = 0;
    while i < end {
        const m: &const Msg = msg_at(h, i);
        total = total + m.text_len + m.extra_len;
        i = i + 1;
    }
    return total;
}

// 估算压缩后的净收益：摘要是被遮蔽段的 ~1/4（保守）。
fn cmp_est_gain_bytes(shadow_bytes: usize) usize {
    const quarter: usize = shadow_bytes / 4;
    if shadow_bytes <= quarter {
        return 0;
    }
    return shadow_bytes - quarter;
}

// 上下文感知版：先过原来的体量线，再过“值不值得压”的三道闸门。
// 窗口线是安全线，仍然无条件生效；绝对线/增长线要过：
//   ① 阴影段至少 cmp_min_shadow_bytes；
//   ② 估算净收益至少 cmp_min_gain_bytes；
//   ③ 距上次自动压缩至少 cmp_compact_cooldown_steps 步，
//      且压力比上次压缩后至少涨了 cmp_min_gain_tokens。
// 未压过（last_step < 0）时 ③ 不生效。
export fn cmp_should_compact_ctx(pressure: i64, context_window: i64,
    shadow_bytes: usize, step: i32) bool {
    if pressure <= 0 {
        return false;
    }
    const limit: i64 = cmp_pressure_limit(context_window);
    if limit > 0 && pressure >= limit {
        return true;
    }
    if !cmp_should_compact_window(pressure, context_window) {
        return false;
    }
    if shadow_bytes < cmp_min_shadow_bytes {
        return false;
    }
    if cmp_est_gain_bytes(shadow_bytes) < cmp_min_gain_bytes {
        return false;
    }
    if cmp_last_compact_step >= 0 && step >= 0
        && step - cmp_last_compact_step < cmp_compact_cooldown_steps {
        return false;
    }
    if cmp_last_compact_step >= 0 && cmp_last_compact_pressure > 0
        && pressure - cmp_last_compact_pressure < cmp_min_gain_tokens {
        return false;
    }
    return true;
}

// 保留多少条最近的原文（按字节比例估算，至少 2 条）
fn cmp_retain_bytes(total_bytes: usize) usize {
    var permille: i64 = cmp_retain_permille;
    if permille < 50 {
        permille = 50;
    }
    if permille > 500 {
        permille = 500;
    }
    var keep: usize = (total_bytes * (permille as usize)) / (1000 as usize);
    if keep < 64 {
        keep = 64;
    }
    return keep;
}

// ============================================================
// P88：自保用的**保守** token 估算与「装得下」判据
// ============================================================
// 口径与 `cmp_prune_armed` / `agent_pressure_tokens` 的 `bytes / 4` **刻意不同**，别合并：
//   * 那两个是**调度**判据（这一步该不该剪、该不该压），`/4` 是实测校准过的中位口径，
//     估偏一点只是早晚一步的事；
//   * 这个是**安全**判据（这条请求会不会被窗口拒掉）。在这里**低估就是灾难** ——
//     估低了以为装得下，请求发出去换回一个 400，而那条路上往往**没有第二次机会**
//     （现场见 §19.10：会话从此再也发不出任何请求）。
// 实测本机 360 组「新增字节 / prompt token 增量」：中位 3.25 B/tok、p05 2.90 B/tok。
// 取 **2.5 B/tok** ⇒ 最坏情况仍留 16% 余量（宁可多压一点，不可发出去被打回）。
export const CMP_EST_NUM: usize = 2;
export const CMP_EST_DEN: usize = 5;

// 一段字节的保守 token 估算（向上取整到 1）。只吃长度，不吃内容 ——
// 于是它对调用方是纯函数、可逐值自测。
export fn cmp_est_tokens(nbytes: usize) i64 {
    return (((nbytes * CMP_EST_NUM) / CMP_EST_DEN) as i64) +% 1;
}

// 摘要请求的输入预算 = `window × 85%`。留 15% 给三样不在这个估算里的东西：
//   ① tools schema（实测本仓约 20 KB）② 摘要提示词与 JSON 外壳 ③ 提供方对
//   「输入 + 输出预留」的合计口径差异（实测那条错只按输入算，但不替上游打包票）。
// `window <= 0`（未知）返回 0 = 不设闸门（与 `cmp_pressure_limit` 同口径：不知道就别拦）。
//
// ⚠ **它高于触发线（0.8）不是笔误**，两者是不同的量：触发线答「什么时候开始压」，
// 预算答「摘要请求最多占多少」。预算必须**高于**触发线才合理 —— 压力刚过线时，
// 摘要请求（只带被遮蔽的那一段）还得有放得下的余地。别顺手把两者调成同一个数。
export const CMP_SUMMARY_BUDGET_PERMILLE: i64 = 850;

// 见上：摘要请求的输入预算（token）。0 = 窗口未知，不设闸门。
export fn cmp_summary_budget(context_window: i64) i64 {
    if context_window <= 0 {
        return 0;
    }
    return (context_window *% CMP_SUMMARY_BUDGET_PERMILLE) / (1000 as i64);
}

// 在 [from, to) 里挑一个**起点**，使 `[起点, to)` 的保守估算尽量装进 budget；
// 一段都装不下时返回 to（= 没有可发的内容，调用方按「压不动」收口）。
//
// 为什么从**新往旧**挑：越靠近尾部的内容越相关，而装不下时被舍掉的是最老的那一段。
// 为什么要往后收拢 tool 结果：起点落在 orphan tool 上会被端点直接 400
// （它的 assistant(tool_calls) 已经被丢在外面了 —— 与 `cmp_shadow_count` 的收拢同一条纪律）。
export fn cmp_fit_start(h: &const History, from: usize, to: usize,
                        budget: i64) usize {
    if from >= to {
        return to;
    }
    var i: usize = to;
    var est: i64 = 0;
    while i > from {
        const idx: usize = i - 1;
        const m: &const Msg = msg_at(h, idx);
        const add: i64 = cmp_est_tokens(m.text_len + m.extra_len);
        if est + add > budget {
            break;
        }
        est = est + add;
        i = idx;
    }
    while i < to && msg_at(h, i).role == ROLE_TOOL {
        i = i + 1;
    }
    return i;
}

// ============================================================
// P88：恢复之后的**硬闸门** —— 折出来的历史必须装得进窗口
// ============================================================
// 为什么恢复这条路要单独有一道闸门（§19.10 的现场）：压缩原来只改内存里的历史，
// 日志里没有 checkpoint，于是 `--resume` 折出来的历史**可能比窗口还大**。此时
//   * 主请求 400（超窗）；
//   * 摘要请求也 400（它当时同样带整份历史）⇒ 压不动 ⇒ **这个会话再也发不出请求**。
// 落盘 checkpoint 之后主路已经不会造出这种历史了，但那不构成「不会再发生」的理由：
// 老日志（P88 之前写下的那些）还在，它们折出来就是超窗的。所以这里保一道**确定性**
// 的兜底：折完就量一次，装不下就从头丢，直到装得下（或只剩注入的那几条）。
//
// 返回丢掉的条数。`budget <= 0`（窗口未知）时一条都不丢 —— 不知道就别乱丢东西。
export fn cmp_fit_history(h: &History, context_window: i64) usize {
    const budget: i64 = cmp_summary_budget(context_window);
    if budget <= 0 || h.len == 0 {
        return 0;
    }
    var dropped: usize = 0;
    while h.len > 1 {
        const keep_from: usize = cmp_fit_start(h, 1, h.len, budget);
        if keep_from <= 1 {
            return dropped;                // 已经装得下（1 = system 之后全留）
        }
        // 丢掉 [1, keep_from) 那一段，并把保留段整体前移
        hist_drop_prefix(h, keep_from);
        dropped = dropped + (keep_from - 1);
    }
    return dropped;
}

// 丢掉下标 [1, keep_from) 的消息（**保留下标 0 的 system**），其余整体前移。
// 与 `hist_drop_oldest_below` 的区别：那个一次只丢一组（且必须照顾工具配对），
// 这个按**已经算好的边界**一次丢一段 —— 边界由 `cmp_fit_start` 给，它保证
// 保留段的开头不是孤儿 tool 结果。
fn hist_drop_prefix(h: &History, keep_from: usize) void {
    if keep_from <= 1 || keep_from >= h.len {
        return;
    }
    var k: usize = 1;
    while k < keep_from {
        const mk: &Msg = msg_at_mut(h, k);
        h.bytes = h.bytes - (mk.text_len + mk.extra_len);
        msg_free_one(mk);
        k = k + 1;
    }
    const removed: usize = keep_from - 1;
    var i: usize = 1;
    while i + removed < h.len {
        const dm: &Msg = msg_at_mut(h, i);
        const sm: &Msg = msg_at_mut(h, i + removed);
        dm[0] = sm[0];
        i = i + 1;
    }
    h.len = h.len - removed;
}

// 该压哪一段：从 system 之后开始，留下尾部 retain 比例；返回遮蔽条数（0 = 不用压）
export fn cmp_shadow_count(h: &const History, last_prompt_tokens: i64) usize {
    if h.len <= 3 {
        return 0;
    }
    const keep: usize = cmp_retain_bytes(h.bytes);
    var tail_bytes: usize = 0;
    var i: usize = h.len;
    var keep_msgs: usize = 0;
    while i > 1 && tail_bytes < keep {
        const idx: usize = i - 1;
        const m: &const Msg = msg_at(h, idx);
        tail_bytes = tail_bytes + m.text_len + m.extra_len;
        keep_msgs = keep_msgs + 1;
        i = idx;
    }
    if keep_msgs < 2 {
        keep_msgs = 2;
    }
    if h.len <= keep_msgs + 1 {
        return 0;
    }
    const shadow: usize = h.len - keep_msgs - 1;   // 1 = system 那条
    if shadow == 0 {
        return 0;
    }
    // 不能把 assistant(tool_calls) 和它的 tool 结果拆开：向前收拢到边界
    var s: usize = shadow;
    // 往前收拢：不能把 assistant(tool_calls) 与它的 tool 结果拆开
    while s + 1 < h.len {
        const nxt: usize = s + 1;
        if msg_at(h, nxt).role != ROLE_TOOL {
            break;
        }
        s = nxt;
    }
    // 再往后收拢：保留段的开头不能是孤儿 tool 结果（它的 assistant 已被遮蔽）
    while s < h.len {
        if msg_at(h, s).role != ROLE_TOOL {
            break;
        }
        s = s + 1;
    }
    if s > h.len {
        s = h.len;
    }
    _ = last_prompt_tokens;
    return s;
}

// ============================================================
// 摘要提示词（DSH 原文的头部与小节结构；Rules 用等价表述）
// ============================================================
fn cmp_summary_prompt(out: &Buf) bool {
    buf_reset(out);
    const head: &const byte = "You are now acting as a compaction engine for this AI coding assistant. Condense the conversation ABOVE into a structured checkpoint that lets another model resume the work with no loss of essential context.\n\nOutput EXACTLY the Markdown structure below: keep every section, in order. Use terse bullets, not prose paragraphs. Write \"(none)\" for an empty section — never drop a section.\n\n";
    if !buf_append_cstr(out, head) {
        return false;
    }
    const sections: &const byte = "## Primary Request and Intent\n- (what the user asked for, verbatim where it matters)\n\n## Key Technical Concepts\n- (technologies, invariants, conventions)\n\n## Files and Code\n- (exact paths and the parts that matter)\n\n## Errors and Fixes\n- (what broke, why, and what fixed it)\n\n## Pending Jobs\n- (none)\n\n## Current Work\n- (what is being worked on right now)\n\n## Next Step\n- (the single next action)\n\n## Critical Context\n- (anything a resuming model must not lose)\n\n";
    if !buf_append_cstr(out, sections) {
        return false;
    }
    const rules: &const byte = "Rules:\n- Keep exact paths, commands, error strings, identifiers, numbers and syntax fragments.\n- Capture user feedback and corrections faithfully.\n- Do not mention this summarization request or that the context was compacted.\n- Output only the checkpoint text; call no tool.\n- If the conversation already contains a <compacted-summary> block, treat it as a PRIOR checkpoint to merge into your output rather than copying it verbatim.";
    return buf_append_cstr(out, rules);
}

// 摘要提示词 + 钉住的事实：把原始任务与最近一条用户指令原文附在末尾。
// 摘要模型即使把中间段落压丢，也必须保留这两条。
const CMP_PIN_MAX: usize = 1024;

fn cmp_starts_with(t: &const byte, n: usize,
    prefix: &const byte, pn: usize) bool {
    if n < pn {
        return false;
    }
    return bufx_mem_eq(t, prefix, pn);
}

// 用户消息里哪些是“任务/指令”，哪些是注入的上下文（运行时快照、
// system-reminder、checkpoint）。只钉前者。
fn cmp_is_task_text(m: &const Msg) bool {
    if m.role != ROLE_USER || m.text_len == 0 {
        return false;
    }
    const t: &const byte = m.text as &const byte;
    if cmp_starts_with(t, m.text_len,
        "<system-reminder>" as &const byte, 17) {
        return false;
    }
    if cmp_starts_with(t, m.text_len,
        "Current runtime context" as &const byte, 23) {
        return false;
    }
    if cmp_starts_with(t, m.text_len,
        "This is an automatically generated checkpoint" as &const byte, 45) {
        return false;
    }
    return true;
}

// 把一条消息的正文钉进摘要提示词（按码点截断，不切 UTF-8）。
fn cmp_pin_into(m: &const Msg, label: &const byte, out: &Buf) bool {
    const t: &const byte = m.text as &const byte;
    var cps: usize = CMP_PIN_MAX;
    if cps > m.text_len {
        cps = m.text_len;
    }
    const cut: usize = bufx_utf8_prefix_bytes(t, m.text_len, cps);
    if !buf_append_cstr(out, label) {
        return false;
    }
    return buf_append(out, t, cut);
}

// 在原来的摘要提示词后追加“钉住的事实”：原始任务 + 最近一条指令。
export fn cmp_summary_prompt_ctx(h: &const History, shadow: usize,
    out: &Buf) bool {
    if !cmp_summary_prompt(out) {
        return false;
    }
    var first: isize = -1;
    var latest: isize = -1;
    var i: usize = 1;
    while i < h.len {
        const m: &const Msg = msg_at(h, i);
        if cmp_is_task_text(m) {
            if first < 0 {
                first = i as isize;
            }
            if i < shadow {
                latest = i as isize;
            }
        }
        i = i + 1;
    }
    if first < 0 {
        return true;
    }
    if !buf_append_cstr(
        out,
        "\n\nPinned facts (verbatim; preserve them in the checkpoint):"
    ) {
        return false;
    }
    if !cmp_pin_into(msg_at(h, first as usize),
        "\n- Original task: ", out) {
        return false;
    }
    if latest >= 0 && latest != first {
        if !cmp_pin_into(msg_at(h, latest as usize),
            "\n- Latest instruction: ", out) {
            return false;
        }
    }
    return true;
}

// 构造 checkpoint 消息正文（PREAMBLE + <compacted-summary>…</compacted-summary>）
export fn cmp_build_checkpoint(summary: &const Buf, out: &Buf) bool {
buf_reset(out);
if summary.len == 0 {
    return false;
}
if !buf_append_cstr(out, CHECKPOINT_PREAMBLE) {
    return false;
}
if !buf_append_cstr(out, "\n\n<compacted-summary>\n") {
    return false;
}
if !buf_append(out, summary.ptr, summary.len) {
    return false;
}
return buf_append_cstr(out, "\n</compacted-summary>");
}

// ============================================================
// 压缩：把被遮蔽的一段替换成 checkpoint 消息
//
// 返回 true = 已压缩（h 已被改写）
// ============================================================
export fn cmp_apply(h: &History, shadow: usize, summary: &const Buf) bool {
    if shadow == 0 || summary.len == 0 {
        return false;
    }
    // 摘要必须比被遮蔽的内容小（DSH 的硬规则）
    var shadowed: usize = 0;
    var i: usize = 0;
    while i < shadow {
        const it: &const Msg = msg_at(h, i);
        shadowed = shadowed + it.text_len + it.extra_len;
        i = i + 1;
    }
    if summary.len >= shadowed {
        return false;
    }

// 组 checkpoint 消息
    var msg: Buf = buf_new(summary.len + 512);
    defer { buf_free(&msg); }
    if !buf_append_cstr(&msg, CHECKPOINT_PREAMBLE) {
        return false;
    }
    if !buf_append_cstr(&msg, "\n\n<compacted-summary>\n") {
        return false;
    }
    if !buf_append(&msg, summary.ptr, summary.len) {
        return false;
    }
    if !buf_append_cstr(&msg, "\n</compacted-summary>") {
        return false;
    }
    // 释放被遮蔽的消息（含 system）并整体前移
    var k: usize = 0;
    while k < shadow {
        msg_free_one(msg_at_mut(h, k));
        k = k + 1;
    }
    var dst: usize = 0;
    var src: usize = shadow;
    while src < h.len {
        const sm: &Msg = msg_at_mut(h, src);
        const dm: &Msg = msg_at_mut(h, dst);
        dm[0] = sm[0];
        dst = dst + 1;
        src = src + 1;
    }
    h.len = dst;
    // 头部插回：system 原文 + checkpoint
    const saved_system: usize = 0;
    _ = saved_system;
    return true;
}

