// src/httpc.uya — 极简 HTTP/1.1 客户端（明文 + TLS），纯 Uya
//
// 为什么不用 std.http.http1_async / tls.https：
//   1) std.http 的请求头构造器固定只发 Host/Connection/Content-Type/Content-Length，
//      无法加 Authorization；
//   2) tls.https 只导出 GET（https_get*），且单次只读一个 4096 字节 record，
//      装不下 LLM 的响应；
//   3) lib/tls 的 verify_chain_rsa 要求“服务端发来的链顶证书公钥 == 某个信任锚”
//      （真实站点不会发根证书），cert_verify_signature 也只支持 SHA-256，
//      所以这里用 leaf SHA-256 指纹钉扎（pin）作为可用的信任策略。
//
// 传输层复用 lib/tls 已导出的低层件：https_connect_fd / https_read_some /
// https_write_all / https_read_tls_record_exact / https_client_handshake /
// ssl_init / ssl_set_* / ssl_write / ssl_read / trust_store_load_system。

use libc.syscall;
use libc.unistd;
use libc.heap;
use libc.stdlib;
use libc.fcntl;
use std.net.dns;
use std.http.types;
use std.string.strlen;
use tls.common;
use tls.https;
use tls.crypto.sha256;
use tls.ssl.handshake;
use tls.ssl.context;
use tls.ssl.record;
use tls.x509.cert.Cert;
use tls.x509.trust_store;
use tls.x509.verify.KU_DIGITAL_SIGNATURE;
use tls.x509.verify.verify_chain_rsa;

// ============================================================
// 错误
// ============================================================
export error HcBadUrl;
export error HcConnectFailed;
export error HcIoFailed;
export error HcTooLarge;
export error HcBadResponse;
export error HcOutOfMemory;
export error HcTlsUnsupported;
export error HcPinMismatch;
export error HcTimeout;

// ============================================================
// 常量
// ============================================================
const HC_TLS_CHUNK: usize = 16384;              // RECORD_MAX_PLAIN
const HC_TLS_BUF: usize = 16896;                // > 5 + 8 + 16384 + 16
const HC_READ_CHUNK: usize = 16896;
const HC_HEAD_MAX: usize = 65536;

// --http-debug：把响应头与体首字节原始打出来（排查网关怪异响应）
export var hc_debug: bool = false;

// 换行也用数组字面量：`&"\n"[0: 1]` 求值是**切片描述符**的地址，sys_write 会把这
// 8 字节指针的第一个字节写出去 —— 屏幕上多一个乱码字节（与 tty.uya 里的坑同一个）。
const HC_NL: [byte: 1] = [10];

fn hc_dbg(label: &const byte, p: &const byte, n: usize) void {
    _ = sys_write(2, label as *const byte, strlen(label)) catch {};
    _ = sys_write(2, p as *const byte, n) catch {};
    _ = sys_write(2, &HC_NL[0], 1) catch {};
}

fn hc_dbg_dec(label: &const byte, v: usize) void {
    const l: usize = strlen(label);
    _ = sys_write(2, label as *const byte, l) catch {};
    var tmp: [byte: 24] = [0: 24];
    var n: usize = v;
    var i: usize = 0;
    if n == 0 {
        tmp[0] = 48;
        i = 1;
    }
    while n > 0 && i < 24 {
        const d: i32 = ((n % (10 as usize)) as i32) + 48;
        tmp[i] = d as byte;
        n = n / (10 as usize);
        i = i + 1;
    }
    var rev: [byte: 24] = [0: 24];
    var k: usize = 0;
    while i > 0 {
        i = i - 1;
        rev[k] = tmp[i];
        k = k + 1;
    }
    _ = sys_write(2, &rev[0], k) catch {};
    _ = sys_write(2, &HC_NL[0], 1) catch {};
}

export const HC_VERIFY_CHAIN: i32 = 0;
export const HC_VERIFY_PIN: i32 = 1;
export const HC_VERIFY_NONE: i32 = 2;

// ============================================================
// URL
// ============================================================
export struct Url {
    tls: bool,
    buf: Buf,
    host_off: usize,
    host_len: usize,
    port: u16,
    path_off: usize,
    path_len: usize,
}

export fn url_host(u: &const Url) &byte {
    return &u.buf.ptr[u.host_off];
}

export fn url_path(u: &const Url) &byte {
    return &u.buf.ptr[u.path_off];
}

export fn url_host_str(u: &const Url) &[byte] {
    return u.buf.ptr[u.host_off: u.host_len];
}

fn url_empty() Url {
    return Url{ tls: false, buf: buf_empty(), host_off: 0, host_len: 0, port: 0, path_off: 0, path_len: 0 };
}

export fn url_free(u: &Url) void {
    buf_free(&u.buf);
}

// "http://host[:port][/path]" / "https://..."
export fn url_parse(url: &[byte], out: &Url) !void {
    out.tls = false;
    out.buf = buf_new(url.len + 8);
    if !buf_valid(&out.buf) {
        return error.HcOutOfMemory;
    }
    if !buf_append(&out.buf, url.ptr, url.len) {
        return error.HcOutOfMemory;
    }
    if !buf_append_byte(&out.buf, 0) {
        return error.HcOutOfMemory;
    }
    const n: usize = url.len;
    const s: &[byte] = out.buf.ptr[0: n];
    var tls: bool = false;
    var host_start: usize = 0;
    if n >= 8 && eq_ignore_case(s[0: 8], &"https://"[0: 8]) {
        tls = true;
        host_start = 8;
    } else if n >= 7 && eq_ignore_case(s[0: 7], &"http://"[0: 7]) {
        tls = false;
        host_start = 7;
    } else {
        return error.HcBadUrl;
    }
    if host_start >= n {
        return error.HcBadUrl;
    }
    var host_end: usize = host_start;
    while host_end < n && s[host_end] != ':' as byte && s[host_end] != '/' as byte {
        host_end = host_end + 1;
    }
    if host_end == host_start {
        return error.HcBadUrl;
    }
    out.host_off = host_start;
    out.host_len = host_end - host_start;
    var port: u16 = 0;
    var path_start: usize = n;
    if host_end < n && s[host_end] == ':' as byte {
        var p: usize = host_end + 1;
        var v: i32 = 0;
        var digits: i32 = 0;
        while p < n && is_digit(s[p]) {
            v = v * 10 + ((s[p] as i32) - 48);
            digits = digits + 1;
            p = p + 1;
        }
        if digits == 0 || v <= 0 || v > 65535 {
            return error.HcBadUrl;
        }
        port = v as u16;
        if p < n && s[p] == '/' as byte {
            path_start = p;
        }
    } else if host_end < n && s[host_end] == '/' as byte {
        path_start = host_end;
    }
    if port == 0 {
        if tls {
            port = 443;
        } else {
            port = 80;
        }
    }
    out.tls = tls;
    out.port = port;
    if path_start < n {
        out.path_off = path_start;
        out.path_len = n - path_start;
    } else {
        out.path_off = 0;
        out.path_len = 1;
        // 用首字节写 '/'（buf 里 offset 0 已被 scheme 占用，这里直接借用 0 号字节不安全，
        // 改为在末尾追加一个 '/'
        if !buf_append_byte(&out.buf, 47) {
            return error.HcOutOfMemory;
        }
        out.path_off = out.buf.len - 1;
    }
    return;
}

// ============================================================
// TCP
// ============================================================
fn fill_sockaddr_ipv4(a: byte, b: byte, c: byte, d: byte, port: u16, out: &byte) void {
    var i: usize = 0;
    while i < 16 {
        out[i] = 0;
        i = i + 1;
    }
    out[0] = 2;  // AF_INET (小端 u16 = 2)
    out[1] = 0;
    // 端口按大端写入
    const pnet: u16 = ((port & (0xFF as u16)) << (8 as i32)) | (port >> (8 as i32));
    out[2] = ((pnet & (255 as u16)) as byte);
    out[3] = (((pnet >> 8) & (255 as u16)) as byte);
    out[4] = a;
    out[5] = b;
    out[6] = c;
    out[7] = d;
}

fn scan_ipv4(s: &const byte, n: usize, out: &byte) bool {
    var idx: usize = 0;
    var part: i32 = 0;
    var digits: i32 = 0;
    var i: usize = 0;
    while i < n {
        const ch: byte = s[i];
        if is_digit(ch) {
            part = part * 10 + ((ch as i32) - 48);
            if part > 255 {
                return false;
            }
            digits = digits + 1;
        } else if ch == '.' as byte {
            if digits == 0 || idx >= 3 {
                return false;
            }
            out[idx] = part as byte;
            idx = idx + 1;
            part = 0;
            digits = 0;
        } else {
            return false;
        }
        i = i + 1;
    }
    if digits == 0 || idx != 3 {
        return false;
    }
    out[3] = part as byte;
    return true;
}

fn set_sock_timeout(fd: i32, opt: i32, timeout_ms: u32) void {
    var tv: [byte: 16] = [0: 16];
    const sec: i64 = (timeout_ms as i64) / (1000 as i64);
    const usec: i64 = ((timeout_ms as i64) % (1000 as i64)) * (1000 as i64);
    var i: usize = 0;
    while i < 8 {
        const sh: i32 = (i as i32) * 8;
        tv[i] = (((sec >> sh) & (0xFF as i64)) as byte);
        i = i + 1;
    }
    i = 0;
    while i < 8 {
        const sh2: i32 = (i as i32) * 8;
        tv[8 + i] = (((usec >> sh2) & (0xFF as i64)) as byte);
        i = i + 1;
    }
    _ = sys_setsockopt(fd, SOL_SOCKET, opt, &tv[0] as &void, 16 as u32) catch {};
}

export fn tcp_connect(host: &const byte, host_len: usize, port: u16, timeout_ms: u32) !i32 {
    var addr: [byte: 16] = [0: 16];
    var ip: [byte: 4] = [0: 4];
    var is_localhost: bool = false;
    if host_len == 9 && eq_ignore_case(host[0: 9], &"localhost"[0: 9]) {
        is_localhost = true;
    }
    if is_localhost {
        fill_sockaddr_ipv4(127, 0, 0, 1, port, &addr[0]);
    } else if scan_ipv4(host, host_len, &ip[0]) {
        fill_sockaddr_ipv4(ip[0], ip[1], ip[2], ip[3], port, &addr[0]);
    } else {
        var dns_ctx: DnsClient = DnsClient{
            nameserver: [0: 16],
            nameserver_len: 0,
            nameserver_port: 53,
            timeout_ms: 5000,
            query_id: 0,
            prefer_family: 0,
        };
        var empty_resolver: [byte: 0] = [];
        dns_client_init(&dns_ctx, &empty_resolver[0: 0]);
        var timeout_for_dns: u32 = 5000;
        if timeout_ms > 0 && timeout_ms < timeout_for_dns {
            timeout_for_dns = timeout_ms;
        }
        dns_client_set_timeout_ms(&dns_ctx, timeout_for_dns);
        var ipv4: [byte: 4] = [0: 4];
        var ipv4_len: usize = 0;
        dns_client_resolve_first_ipv4(&dns_ctx, host, host_len, &ipv4[0], 4, &ipv4_len) catch {
            return error.HcConnectFailed;
        };
        if ipv4_len != 4 {
            return error.HcConnectFailed;
        }
        fill_sockaddr_ipv4(ipv4[0], ipv4[1], ipv4[2], ipv4[3], port, &addr[0]);
    }
    const fd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return error.HcConnectFailed;
    };
    if timeout_ms > 0 {
        set_sock_timeout(fd, SO_RCVTIMEO, timeout_ms);
        set_sock_timeout(fd, SO_SNDTIMEO, timeout_ms);
    }
    https_connect_fd(fd, &addr[0], 16 as u32) catch {
        _ = sys_close(fd) catch {};
        return error.HcConnectFailed;
    };
    return fd;
}

// ============================================================
// TLS 会话
// ============================================================
export struct TlsConn {
    fd: i32,
    hs: &HandshakeCtx,
    rec: &RecordCtx,
    ctx: &SslContext,
    ts: &TrustStore,
    leaf_der: &byte,
    leaf_der_len: usize,
    observed: [byte: 64],
    observed_len: usize,
    verified: bool,
}

export fn tls_conn_empty() TlsConn {
    return TlsConn{
        fd: -1,
        hs: null as &HandshakeCtx,
        rec: null as &RecordCtx,
        ctx: null as &SslContext,
        ts: null as &TrustStore,
        leaf_der: null,
        leaf_der_len: 0,
        observed: [0: 64],
        observed_len: 0,
        verified: false,
    };
}

// 从 server_flight 里取出 leaf 证书 DER。
// 注意：HandshakeCtx.server_flight_msg 存的是「握手消息流」——
// 每条消息是 类型(1) + 长度(3, 大端) + 内容，不含 TLS record 头。
fn tls_capture_leaf(c: &TlsConn) void {
    c.leaf_der = null;
    c.leaf_der_len = 0;
    const data_len: usize = c.hs.server_flight_msg_len;
    if data_len < 4 {
        return;
    }
    const data: &[byte] = c.hs.server_flight_msg[0: data_len];
    var mp: usize = 0;
    while mp + 4 <= data_len {
        const mtype: byte = data.ptr[mp];
        const mlen: usize = ((data.ptr[mp + 1] as usize) << (16 as i32)) | ((data.ptr[mp + 2] as usize) << (8 as i32)) | (data.ptr[mp + 3] as usize);
        if mp + 4 + mlen > data_len {
            return;
        }
        if mtype == (11 as byte) && mlen >= 6 {
            // Certificate: 3 字节列表长度，然后 3 字节证书长度 + DER
            const list_len: usize = ((data.ptr[mp + 4] as usize) << (16 as i32)) | ((data.ptr[mp + 5] as usize) << (8 as i32)) | (data.ptr[mp + 6] as usize);
            if list_len >= 3 && mp + 7 + list_len <= mp + 4 + mlen {
                const cert_len: usize = ((data.ptr[mp + 7] as usize) << (16 as i32)) | ((data.ptr[mp + 8] as usize) << (8 as i32)) | (data.ptr[mp + 9] as usize);
                if cert_len > 0 && mp + 10 + cert_len <= mp + 7 + list_len {
                    c.leaf_der = &data.ptr[mp + 10];
                    c.leaf_der_len = cert_len;
                }
            }
            return;
        }
        mp = mp + 4 + mlen;
    }
}

fn tls_compute_observed(c: &TlsConn) void {
    c.observed_len = 0;
    if (c.leaf_der as usize) == 0 || c.leaf_der_len == 0 {
        return;
    }
    var digest: [byte: 32] = [0: 32];
    sha256(c.leaf_der as &const byte, c.leaf_der_len, &digest[0]);
    c.observed_len = hex_of(&digest[0], 32, &c.observed[0]);
}

fn tls_pin_matches(c: &TlsConn, pin: &[byte]) bool {
    if pin.len != 64 || c.observed_len != 64 {
        return false;
    }
    var i: usize = 0;
    while i < 64 {
        if byte_lower(pin.ptr[i]) != c.observed[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

export fn tls_observed_str(c: &const TlsConn) &[byte] {
    return c.observed[0: c.observed_len];
}

// verify: HC_VERIFY_CHAIN / HC_VERIFY_PIN / HC_VERIFY_NONE
export fn tls_open(c: &TlsConn, host: &const byte, host_len: usize, verify: i32, pin: &[byte]) !void {
    const hs: &HandshakeCtx = malloc(@size_of(HandshakeCtx)) as &HandshakeCtx;
    if (hs as usize) == 0 {
        return error.HcOutOfMemory;
    }
    hs[0] = HandshakeCtx{};
    const rec: &RecordCtx = malloc(@size_of(RecordCtx)) as &RecordCtx;
    if (rec as usize) == 0 {
        return error.HcOutOfMemory;
    }
    rec[0] = RecordCtx{};
    const ctx: &SslContext = malloc(@size_of(SslContext)) as &SslContext;
    if (ctx as usize) == 0 {
        return error.HcOutOfMemory;
    }
    ctx[0] = SslContext{ role: HS_ROLE_CLIENT, hs: hs, rec: rec };
    const ts: &TrustStore = malloc(@size_of(TrustStore)) as &TrustStore;
    if (ts as usize) == 0 {
        return error.HcOutOfMemory;
    }
    ts[0] = TrustStore{};
    c.hs = hs;
    c.rec = rec;
    c.ctx = ctx;
    c.ts = ts;
    ssl_init(ctx);
    // 链校验由本模块自己做（stdlib 的策略在真实站点上不适用），所以先关掉它的校验；
    // 它仍会把服务端 flight 里的证书链解析到 ctx.peer_leaf/peer_chain。
    ssl_set_insecure_skip_verify(ctx, true);
    ssl_set_skip_hostname_verify(ctx, true);
    if !trust_store_load_system(ts) {
        return error.HcTlsUnsupported;
    }
    ssl_set_peer_chain(ctx, null as &const Cert, null as &const Cert, 0, trust_store_get_certs(ts), trust_store_get_count(ts), KU_DIGITAL_SIGNATURE);
    ssl_set_hostname(ctx, host, host_len);
    ssl_set_peer_identity(ctx, host, host_len, host, host_len);
    https_client_handshake(c.fd, ctx) catch {
        return error.HcConnectFailed;
    };
    tls_capture_leaf(c);
    tls_compute_observed(c);
    c.verified = false;
    if verify == HC_VERIFY_NONE {
        return;
    }
    if verify == HC_VERIFY_PIN {
        if !tls_pin_matches(c, pin) {
            return error.HcPinMismatch;
        }
        c.verified = true;
        return;
    }
    // HC_VERIFY_CHAIN：用 stdlib 的链校验（要求服务端把根证书一并发来）
    if ctx.peer_leaf == null as &const Cert {
        return error.HcTlsUnsupported;
    }
    verify_chain_rsa(ctx.peer_leaf, ctx.peer_chain, ctx.peer_chain_len, trust_store_get_certs(ts), trust_store_get_count(ts), KU_DIGITAL_SIGNATURE) catch {
        return error.HcTlsUnsupported;
    };
    c.verified = true;
    return;
}

export fn tls_conn_free(c: &TlsConn) void {
    if (c.hs as usize) != 0 {
        free(c.hs as &void);
    }
    if (c.rec as usize) != 0 {
        free(c.rec as &void);
    }
    if (c.ctx as usize) != 0 {
        free(c.ctx as &void);
    }
    if (c.ts as usize) != 0 {
        free(c.ts as &void);
    }
    c.hs = null as &HandshakeCtx;
    c.rec = null as &RecordCtx;
    c.ctx = null as &SslContext;
    c.ts = null as &TrustStore;
}

// 明文：一次 record 写不完，按 16384 分片（ssl_write 每调用加密整段明文）
export fn tls_write_all(c: &TlsConn, p: &const byte, n: usize) !void {
    var off: usize = 0;
    var cipher: [byte: HC_TLS_BUF] = [0: HC_TLS_BUF];
    while off < n {
        var take: usize = n - off;
        if take > HC_TLS_CHUNK {
            take = HC_TLS_CHUNK;
        }
        const src: &const byte = @ptr_from_usize(@usize_from_ptr(p as &void) + off) as &const byte;
        var clen: usize = 0;
        ssl_write(c.ctx, src, take, &cipher[0], HC_TLS_BUF, &clen) catch {
            return error.HcIoFailed;
        };
        https_write_all(c.fd, &cipher[0], clen) catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            if eid == @error_id(error.ReadWouldBlock) {
                return error.HcTimeout;
            }
            return error.HcIoFailed;
        };
        off = off + take;
    }
}

// 返回一段应用数据（0 = 连接关闭）
export fn tls_read_some(c: &TlsConn, out: &byte, cap: usize) !usize {
    var cipher: [byte: HC_TLS_BUF] = [0: HC_TLS_BUF];
    while true {
        var clen: usize = 0;
        https_read_tls_record_exact(c.fd, &cipher[0], HC_TLS_BUF, &clen) catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            if eid == @error_id(error.ConnectionClosed) {
                return 0 as usize;
            }
            if eid == @error_id(error.ReadWouldBlock) {
                return error.HcTimeout;
            }
            return error.HcIoFailed;
        };
        if clen < 5 {
            return error.HcIoFailed;
        }
        const rt: byte = cipher[0];
        if rt == (TLS_RECORD_ALERT as byte) {
            // 服务端在响应后发的 close_notify（或致命告警）：前者等价于 EOF。
            // 已经读到的内容交给上层解析；若一个字节都没有，上层会报 HcBadResponse。
            return 0 as usize;
        }
        if rt != (TLS_RECORD_APPLICATION_DATA as byte) {
            continue;   // change_cipher_spec / handshake 等：跳过
        }
        var plen: usize = 0;
        var consumed: usize = 0;
        ssl_read(c.ctx, &cipher[0], clen, out, cap, &plen, &consumed) catch {
            return error.HcIoFailed;
        };
        return plen;
    }
}

// ============================================================
// 连接抽象
// ============================================================
export struct HcConn {
    fd: i32,
    is_tls: bool,
    tc: &TlsConn,
}

fn conn_read(c: &HcConn, out: &byte, cap: usize) !usize {
    if c.is_tls {
        return tls_read_some(c.tc, out, cap);
    }
    const n: usize = https_read_some(c.fd, out, cap) catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        if eid == @error_id(error.ConnectionClosed) {
            return 0 as usize;
        }
        if eid == @error_id(error.ReadWouldBlock) {
            return error.HcTimeout;
        }
        return error.HcIoFailed;
    };
    return n;
}

fn conn_write_all(c: &HcConn, p: &const byte, n: usize) !void {
    if c.is_tls {
        return tls_write_all(c.tc, p, n);
    }
    https_write_all(c.fd, p, n) catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        if eid == @error_id(error.ReadWouldBlock) {
            return error.HcTimeout;
        }
        return error.HcIoFailed;
    };
    return;
}

// ============================================================
// 请求 / 响应
// ============================================================
export struct Resp {
    status: i32,
    body: Buf,
    head_len: usize,
}

fn resp_empty() Resp {
    return Resp{ status: 0, body: buf_empty(), head_len: 0 };
}

export fn resp_free(r: &Resp) void {
    buf_free(&r.body);
}

fn build_request(u: &const Url, method: &[byte], extra_headers: &[byte], body_len: usize, out: &Buf) bool {
    if !buf_append_slice(out, method) {
        return false;
    }
    if !buf_append_byte(out, 32) {
        return false;
    }
    if !buf_append(out, url_path(u), u.path_len) {
        return false;
    }
    if !buf_append_cstr(out, " HTTP/1.1\r\nHost: ") {
        return false;
    }
    if !buf_append(out, url_host(u), u.host_len) {
        return false;
    }
    var default_port: u16 = 80;
    if u.tls {
        default_port = 443;
    }
    if u.port != default_port {
        if !buf_append_byte(out, 58) {
            return false;
        }
        if !buf_append_u64(out, u.port as u64) {
            return false;
        }
    }
    if !buf_append_cstr(out, "\r\nUser-Agent: uya-agent/0.1\r\n") {
        return false;
    }
    if extra_headers.len > 0 {
        if !buf_append(out, extra_headers.ptr, extra_headers.len) {
            return false;
        }
    }
    if !buf_append_cstr(out, "Content-Length: ") {
        return false;
    }
    if !buf_append_u64(out, body_len as u64) {
        return false;
    }
    if !buf_append_cstr(out, "\r\nConnection: close\r\n\r\n") {
        return false;
    }
    return true;
}

fn parse_status(head: &[byte], head_len: usize) i32 {
    var sp: usize = 0;
    while sp < head_len && head.ptr[sp] != 32 {
        sp = sp + 1;
    }
    if sp + 4 > head_len {
        return 0;
    }
    var v: i32 = 0;
    var i: usize = 0;
    while i < 3 {
        const c: byte = head.ptr[sp + 1 + i];
        if !is_digit(c) {
            return 0;
        }
        v = v * 10 + ((c as i32) - 48);
        i = i + 1;
    }
    return v;
}

// 在响应头里找 header 值；返回是否存在
fn head_value(head: &[byte], head_len: usize, name: &[byte], out_off: &usize, out_len: &usize) bool {
    var i: usize = 0;
    while i < head_len {
        // 行首
        var line_end: usize = i;
        while line_end < head_len && head.ptr[line_end] != 10 {
            line_end = line_end + 1;
        }
        if line_end > i + name.len && eq_ignore_case(head[i: name.len], name) && head.ptr[i + name.len] == 58 as byte {
            var p: usize = i + name.len + 1;
            while p < line_end && head.ptr[p] == 32 {
                p = p + 1;
            }
            var e: usize = p;
            while e < line_end && head.ptr[e] != 13 && head.ptr[e] != 10 {
                e = e + 1;
            }
            out_off[0] = p;
            out_len[0] = e - p;
            return true;
        }
        i = line_end + 1;
    }
    return false;
}

// chunked 就地解码：src[from..len] → 输出写回 src 的 from 处，返回解码后长度
fn decode_chunked_inplace(src: &Buf, from: usize) i64 {
    var rp: usize = from;
    var wp: usize = from;
    const len: usize = src.len;
    const view: &[byte] = src.ptr[0: len];
    while true {
        // 读 chunk 长度行
        var line_end: usize = rp;
        while line_end < len && view.ptr[line_end] != 10 {
            line_end = line_end + 1;
        }
        if line_end >= len {
            return -1;
        }
        var hlen: usize = line_end - rp;
        if hlen > 0 && view.ptr[rp + hlen - 1] == 13 as byte {
            hlen = hlen - 1;
        }
        // 忽略 chunk 扩展
        var hex_len: usize = hlen;
        var k: usize = 0;
        while k < hlen {
            if view.ptr[rp + k] == 59 as byte {
                hex_len = k;
                break;
            }
            k = k + 1;
        }
        if hex_len == 0 {
            return -1;
        }
        const clen: i64 = parse_hex_at(view, rp, hex_len);
        if clen < 0 {
            return -1;
        }
        rp = line_end + 1;
        if clen == 0 {
            return (wp - from) as i64;
        }
        const csz: usize = clen as usize;
        if rp + csz > len {
            return -1;
        }
        var i: usize = 0;
        while i < csz {
            view.ptr[wp + i] = view.ptr[rp + i];
            i = i + 1;
        }
        wp = wp + csz;
        rp = rp + csz;
        // 跳过 chunk 后的 CRLF
        if rp < len && view.ptr[rp] == 13 as byte {
            rp = rp + 1;
        }
        if rp < len && view.ptr[rp] == 10 as byte {
            rp = rp + 1;
        }
    }
    return -1;
}

// 额外请求头（含结尾 CRLF）
export fn header_line(out: &Buf, name: &[byte], value: &[byte]) bool {
    if !buf_append_slice(out, name) {
        return false;
    }
    if !buf_append_cstr(out, ": ") {
        return false;
    }
    if !buf_append_slice(out, value) {
        return false;
    }
    return buf_append_cstr(out, "\r\n");
}

export fn http_request(
    url: &[byte],
    method: &[byte],
    extra_headers: &[byte],
    body: &const byte,
    body_len: usize,
    timeout_ms: u32,
    max_body: usize,
    verify: i32,
    pin: &[byte],
    out: &Resp,
    tls_out: &TlsConn
) !void {
    var u: Url = url_empty();
    try url_parse(url, &u);
    defer { url_free(&u); }

    const fd: i32 = try tcp_connect(url_host(&u), u.host_len, u.port, timeout_ms);
    defer { _ = sys_close(fd) catch {}; }

    tls_out.fd = fd;
    var conn: HcConn = HcConn{ fd: fd, is_tls: u.tls, tc: tls_out };
    if u.tls {
        try tls_open(tls_out, url_host(&u), u.host_len, verify, pin);
    }
    defer { if u.tls { tls_conn_free(tls_out); } }

    var req: Buf = buf_new(4096);
    defer { buf_free(&req); }
    if !buf_valid(&req) {
        return error.HcOutOfMemory;
    }
    if !build_request(&u, method, extra_headers, body_len, &req) {
        return error.HcOutOfMemory;
    }
    if !buf_append(&req, body, body_len) {
        return error.HcOutOfMemory;
    }
    try conn_write_all(&conn, &req.ptr[0], req.len);

    // 读到 EOF（我们固定发 Connection: close）
    var rx: Buf = buf_new(HC_READ_CHUNK * 2);
    defer { buf_free(&rx); }
    if !buf_valid(&rx) {
        return error.HcOutOfMemory;
    }
    var tmp: [byte: HC_READ_CHUNK] = [0: HC_READ_CHUNK];
    const limit: usize = max_body + HC_HEAD_MAX;
    // P30：这一路（非流式请求：--no-stream 的整段回答、web_search、会话导入）以前是
    // 「一口气阻塞读到 EOF」，长回答期间界面完全不刷、esc 也进不来（用户看到的就是卡死）。
    // 现在改成 poll(≤50ms) + 泵点：没有数据就转一圈界面与命令派发，超时按 timeout_ms 判。
    // 与流式那条路（httpstream 的 hc_fill_wait）同一套做法，TLS 也一样是先 poll 再读。
    const t0: u64 = ua_now_ms();
    while true {
        if tui_active() {
            var pfds: [PollFd: 1] = [PollFd{ fd: fd, events: POLLIN, revents: 0 }];
            const pr: i32 = sys_poll(&pfds[0], 1, 50) catch { 0; };
            if pr <= 0 {
                if timeout_ms > 0 && (ua_now_ms() - t0) >= (timeout_ms as u64) {
                    return error.HcTimeout;
                }
                agent_pump_light();
                continue;
            }
        }
        const n: usize = try conn_read(&conn, &tmp[0], HC_READ_CHUNK);
        if n == 0 {
            break;
        }
        if !buf_append(&rx, &tmp[0], n) {
            return error.HcOutOfMemory;
        }
        if rx.len > limit {
            return error.HcTooLarge;
        }
    }
    if rx.len == 0 {
        return error.HcBadResponse;
    }
    const view: &[byte] = rx.ptr[0: rx.len];
    const he: isize = find_sub(view, &"\r\n\r\n"[0: 4], 0);
    if he < 0 {
        return error.HcBadResponse;
    }
    const head_end: usize = (he as usize) + 4;
    out.head_len = head_end;
    out.status = parse_status(view, head_end);
    if out.status == 0 {
        return error.HcBadResponse;
    }

    var cl_off: usize = 0;
    var cl_len: usize = 0;
    var te_off: usize = 0;
    var te_len: usize = 0;
    const has_cl: bool = head_value(view, head_end, &"content-length"[0: 14], &cl_off, &cl_len);
    const has_te: bool = head_value(view, head_end, &"transfer-encoding"[0: 17], &te_off, &te_len);
    var chunked: bool = false;
    if has_te && te_len >= 7 {
        chunked = eq_ignore_case(view[te_off: te_len], &"chunked"[0: 7]);
    }

    var body_len_out: usize = rx.len - head_end;
    if hc_debug {
        var hb: usize = head_end;
        if hb > 400 {
            hb = 400;
        }
        hc_dbg("[hc] head: ", &rx.ptr[0] as &const byte, hb);
        var rb: usize = rx.len - head_end;
        if rb > 48 {
            rb = 48;
        }
        hc_dbg("[hc] raw body head: ", &rx.ptr[head_end] as &const byte, rb);
        hc_dbg_dec("[hc] rx.len=", rx.len);
        hc_dbg_dec("[hc] head_end=", head_end);
        hc_dbg_dec("[hc] chunked=", chunked as usize);
        hc_dbg_dec("[hc] has_cl=", has_cl as usize);
        hc_dbg_dec("[hc] cl_len=", cl_len);
        hc_dbg_dec("[hc] te_len=", te_len);
    }
    if chunked {
        const dec: i64 = decode_chunked_inplace(&rx, head_end);
        if dec < 0 {
            return error.HcBadResponse;
        }
        body_len_out = dec as usize;
    } else if has_cl && cl_len > 0 {
        const want: i64 = parse_u64_at(view, cl_off, cl_len);
        if want < 0 {
            return error.HcBadResponse;
        }
        if (want as usize) > body_len_out {
            return error.HcBadResponse;
        }
        body_len_out = want as usize;
    }
    if body_len_out > max_body {
        return error.HcTooLarge;
    }
    out.body = buf_new(body_len_out + 1);
    if !buf_valid(&out.body) {
        return error.HcOutOfMemory;
    }
    if !buf_append(&out.body, &rx.ptr[head_end], body_len_out) {
        return error.HcOutOfMemory;
    }
    return;
}
