// src/diff/view.uya — 差分模块：打开 / 刷新 / 查询 / 选择滚动 / 跳转 / 文本回退
//
// 本文件：唯一会去碰 git 的入口（gd_open / gd_refresh / gd_load_sel）；对外只读访问器
//   （错误 / 备注 / 条数 / 选中项 / 增删计数 / 行数 / 单元格指针 / 行元数据）；光标移动
//   与视口滚动；跨改动跳转（n / N，同文件环绕 + 跨文件）；以及非 TUI 的单列文本回退。
// 不变量：任何失败都不抛错，一律落 g_gd_err 文本回给界面，失败时**状态不半更新**；
//   滚动一律夹到 [0, max]；gd_cell / gd_file_text 返回的是 g_gd_textp / g_gd_files 上的
//   指针，调用方不许留存到下一次 gd_open / gd_move；文本回退**不动任何 g_gd_* 状态**。
// 依赖：gitcmd / model / rows、vcs/gitx、term/tui（清洗）。

fn gd_load_sel() bool {
    gd_ensure();
    if !g_gd_real {
        // 假数据（--tui-demo / 自测）：内容已经由 gd_load_fixture 解析好，
        // 这里既不能清行表（行表指向 g_gd_out），也不能去跑 git（没有仓库）
        return true;
    }
    g_gd_nrows = 0;
    g_gd_rowcut = false;
    g_gd_added = 0;
    g_gd_removed = 0;
    g_gd_textp = "" as &const byte;
    buf_reset(&g_gd_note);
    buf_reset(&g_gd_out);
    if g_gd_sel >= g_gd_nfiles {
        return false;
    }
    if g_gd_sel >= GD_MAX_FILES {
        return false;
    }
    const untracked: bool = gd_is_untracked(g_gd_sel);
    var rc: i32 = gd_run_file_diff(untracked, g_gd_poff[g_gd_sel], g_gd_plen[g_gd_sel], GD_FULL_CTX, &g_gd_out);
    if rc == GITX_E_NO_GIT || rc == GITX_E_SPAWN {
        gd_set_err(gd_err_fallback(rc));
        return false;
    }
    if rc == GITX_E_TIMEOUT {
        gd_note_add("（git 超时，已放弃这次查询）" as &const byte);
        return true;
    }
    if gitx_last_truncated() {
        // 文件太大：改抓「改动附近的上下文」，至少让改动本身看得见
        buf_reset(&g_gd_out);
        rc = gd_run_file_diff(untracked, g_gd_poff[g_gd_sel], g_gd_plen[g_gd_sel], GD_TXT_CTX, &g_gd_out);
        gd_note_add("（文件过大：只显示改动附近的 3 行上下文）" as &const byte);
    }
    if rc != 0 && rc != 1 && g_gd_out.len == 0 {
        // 真错误（例如未合并的路径）：把 git 的话放进制表
        gd_set_err_text(g_gd_errout.ptr as &const byte, g_gd_errout.len, "git diff 失败" as &const byte);
        gd_note_add("（" as &const byte);
        _ = buf_append(&g_gd_note, g_gd_err.ptr, g_gd_err.len);
        gd_note_add("）" as &const byte);
        gd_set_err(gd_err_fallback(rc));
        g_gd_textp = g_gd_out.ptr as &const byte;
        return true;
    }
    var a: usize = 0;
    var r: usize = 0;
    gd_parse_into(&g_gd_out, &a, &r);
    g_gd_added = a;
    g_gd_removed = r;
    if g_gd_rowcut {
        gd_note_add("（行数超过上限，已截断）" as &const byte);
    }
    if g_gd_nrows == 0 {
        const p: &const byte = g_gd_out.ptr as &const byte;
        const n: usize = g_gd_out.len;
        if gd_has(p, n, "old mode" as &const byte) {
            gd_note_add("（仅文件模式变更）" as &const byte);
        } else if n == 0 {
            gd_note_add("（没有可显示的差异）" as &const byte);
        } else {
            gd_note_add("（没有可显示的内容）" as &const byte);
        }
    }
    return true;
}

// ============================================================
// 对外：打开 / 刷新 / 选择 / 滚动
// ============================================================

export fn gd_open(ws: &const byte, n: usize) i32 {
    gd_ensure();
    buf_reset(&g_gd_err);
    buf_reset(&g_gd_note);
    if n == 0 || ws == null as &const byte {
        gd_set_err("工作区为空" as &const byte);
        return GD_E_NOT_REPO;
    }
    if !gitx_available() {
        gd_set_err("找不到 git 可执行文件（/diff 需要 git 在 PATH 里）" as &const byte);
        return GD_E_NO_GIT;
    }
    buf_reset(&g_gd_ws);
    _ = buf_append(&g_gd_ws, ws, n);
    gitx_cstr(&g_gd_ws_z, ws, n);
    const rc0: i32 = gd_run_toplevel();
    if rc0 != 0 {
        gd_set_err_text(g_gd_errout.ptr as &const byte, g_gd_errout.len, gd_err_fallback(rc0));
        return GD_E_NOT_REPO;
    }
    gitx_trim_nl(&g_gd_out);
    if g_gd_out.len == 0 {
        gd_set_err("工作区不在 git 仓库里" as &const byte);
        return GD_E_NOT_REPO;
    }
    buf_reset(&g_gd_root);
    _ = buf_append(&g_gd_root, g_gd_out.ptr, g_gd_out.len);
    gitx_cstr(&g_gd_root_z, g_gd_root.ptr, g_gd_root.len);
    gd_label_of(&g_gd_root);
    g_gd_has_head = gd_run_has_head() == 0;
    g_gd_real = true;
    const rc1: i32 = gd_run_status();
    if rc1 != 0 {
        gd_set_err_text(g_gd_errout.ptr as &const byte, g_gd_errout.len, gd_err_fallback(rc1));
        return GD_E_NOT_REPO;
    }
    const rc2: i32 = gd_scan();
    if rc2 != 0 {
        return rc2;
    }
    g_gd_sel = 0;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
    _ = gd_load_sel();
    return 0;
}

export fn gd_refresh() i32 {
    gd_ensure();
    if !g_gd_real {
        buf_reset(&g_gd_note);
        gd_note_add("（假数据：没有仓库可刷新）" as &const byte);
        return 0;
    }
    if g_gd_ws.len == 0 {
        gd_set_err("还没有打开过仓库" as &const byte);
        return GD_E_NOT_REPO;
    }
    // 失败时保留原来的列表与内容，只把原因写进 note（浮窗里看得见）
    var ws: Buf = buf_new(g_gd_ws.len + 1);
    defer { buf_free(&ws); }
    _ = buf_append(&ws, g_gd_ws.ptr, g_gd_ws.len);
    const keep: usize = g_gd_sel;
    const rc: i32 = gd_open(ws.ptr as &const byte, g_gd_ws.len);
    if rc < 0 {
        buf_reset(&g_gd_note);
        gd_note_add("（刷新失败：" as &const byte);
        _ = buf_append(&g_gd_note, g_gd_err.ptr, g_gd_err.len);
        gd_note_add("）" as &const byte);
        return rc;
    }
    if g_gd_nfiles > 0 {
        if keep < g_gd_nfiles {
            g_gd_sel = keep;
        } else {
            g_gd_sel = g_gd_nfiles - 1;
        }
        _ = gd_load_sel();
    }
    return 0;
}


export fn gd_error() &const Buf {
    gd_ensure();
    return &g_gd_err;
}

export fn gd_note() &const Buf {
    gd_ensure();
    return &g_gd_note;
}

export fn gd_file_count() usize {
    return g_gd_nfiles;
}

export fn gd_sel() usize {
    return g_gd_sel;
}

export fn gd_added() usize {
    return g_gd_added;
}

export fn gd_removed() usize {
    return g_gd_removed;
}

export fn gd_scroll() usize {
    return g_gd_scroll;
}

export fn gd_hscroll() usize {
    return g_gd_hscroll;
}

export fn gd_rows() usize {
    return g_gd_nrows;
}

// 左列表第 i 行的显示文本（末尾不带换行）

export fn gd_file_text(i: usize, out_len: &usize) &const byte {
    out_len[0] = 0;
    if i >= GD_MAX_FILES {
        return "" as &const byte;
    }
    if i >= g_gd_nfiles {
        return "" as &const byte;
    }
    out_len[0] = g_gd_flen[i];
    return gd_fat(g_gd_foff[i]);
}

// 第 i 行第 side 侧（0 = 旧 / 1 = 新）的单元格文本

export fn gd_cell(i: usize, side: u8, out_len: &usize) &const byte {
    out_len[0] = 0;
    if i >= GD_MAX_ROWS {
        return "" as &const byte;
    }
    if i >= g_gd_nrows {
        return "" as &const byte;
    }
    const r: GdRow = g_gd_rows[i];
    if side == 0 {
        out_len[0] = r.l_len;
        return gd_at(r.l_off);
    }
    out_len[0] = r.r_len;
    return gd_at(r.r_off);
}

export fn gd_row_meta(i: usize, out: &GdRow) bool {
    if i >= GD_MAX_ROWS {
        return false;
    }
    if i >= g_gd_nrows {
        return false;
    }
    out[0] = g_gd_rows[i];
    return true;
}

export fn gd_move(delta: i32) bool {
    if g_gd_nfiles == 0 {
        return false;
    }
    var s: i64 = (g_gd_sel as i64) + (delta as i64);
    if s < 0 {
        s = 0;
    }
    if s > (g_gd_nfiles - 1) as i64 {
        s = (g_gd_nfiles - 1) as i64;
    }
    const ns: usize = s as usize;
    if ns == g_gd_sel {
        return false;
    }
    g_gd_sel = ns;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
    _ = gd_load_sel();
    return true;
}

// 直接选第 i 个文件（自测按「这个文件在第几行」定位，不依赖 git 的排序：
// git status 先报已跟踪的改动，未跟踪的排在最后）

export fn gd_select(i: usize) bool {
    if i >= g_gd_nfiles {
        return false;
    }
    if i == g_gd_sel {
        return true;
    }
    g_gd_sel = i;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
    _ = gd_load_sel();
    return true;
}

export fn gd_set_view(rows: usize) void {
    if rows == 0 {
        g_gd_view = 1;
    } else {
        g_gd_view = rows;
    }
    const m: usize = gd_scroll_max();
    if g_gd_scroll > m {
        g_gd_scroll = m;
    }
}

fn gd_scroll_max() usize {
    if g_gd_nrows > g_gd_view {
        return g_gd_nrows - g_gd_view;
    }
    return 0;
}

export fn gd_scroll_by(pages: i32) void {
    var step: usize = 1;
    if g_gd_view > 1 {
        step = g_gd_view - 1;
    }
    var s: i64 = (g_gd_scroll as i64) + (pages as i64) * (step as i64);
    if s < 0 {
        s = 0;
    }
    const m: i64 = gd_scroll_max() as i64;
    if s > m {
        s = m;
    }
    g_gd_scroll = s as usize;
}

export fn gd_scroll_home() void {
    g_gd_scroll = 0;
}

export fn gd_scroll_end() void {
    g_gd_scroll = gd_scroll_max();
}

export fn gd_hscroll_by(steps: i32) void {
    var h: i64 = (g_gd_hscroll as i64) + (steps as i64) * (GD_HSTEP as i64);
    if h < 0 {
        h = 0;
    }
    if h > 100000 {
        h = 100000;
    }
    g_gd_hscroll = h as usize;
}


export fn gd_next_change(dir: i32) bool {
    if g_gd_nrows == 0 {
        return false;
    }
    if dir >= 0 {
        // 往后：从「顶行的下一行」起找，保证连按有推进
        var i: usize = g_gd_scroll + 1;
        while i < g_gd_nrows {
            if gd_row_is_change(i) {
                g_gd_scroll = i;
                return true;
            }
            i = i + 1;
        }
        // 本文件没了：跨到下一个文件的首个改动
        if gd_next_change_file(1) {
            return true;
        }
        // 已经是最后一个文件：环绕回本文件的第一个改动
        return gd_next_change_wrap_first();
    }
    // 往前：从顶行往前找（顶行本身就是改动行时，再按要真的往上一处走 —— 从顶-1 起）
    var i2: usize = g_gd_scroll;
    while i2 > 0 {
        i2 = i2 - 1;
        if gd_row_is_change(i2) {
            g_gd_scroll = i2;
            return true;
        }
    }
    if gd_next_change_file(-1) {
        return true;
    }
    return gd_next_change_wrap_last();
}

fn gd_row_is_change(i: usize) bool {
    if i >= GD_MAX_ROWS {
        return false;
    }
    if i >= g_gd_nrows {
        return false;
    }
    const k: u8 = g_gd_rows[i].kind;
    return k == GD_K_MIX || k == GD_K_DEL || k == GD_K_ADD;
}

fn gd_first_change() usize {
    var i: usize = 0;
    while i < g_gd_nrows {
        if gd_row_is_change(i) {
            return i;
        }
        i = i + 1;
    }
    return 0;
}

fn gd_last_change() usize {
    var i: usize = g_gd_nrows;
    while i > 0 {
        i = i - 1;
        if gd_row_is_change(i) {
            return i;
        }
    }
    return 0;
}

fn gd_next_change_wrap_first() bool {
    const f: usize = gd_first_change();
    if g_gd_nrows == 0 || !gd_row_is_change(f) {
        return false;
    }
    g_gd_scroll = f;
    return true;
}

fn gd_next_change_wrap_last() bool {
    const l: usize = gd_last_change();
    if g_gd_nrows == 0 || !gd_row_is_change(l) {
        return false;
    }
    g_gd_scroll = l;
    return true;
}

// 换到上/下一个「有改动的文件」并把 scroll 定到它的首/末个改动；换不到返回 false。
// 「换不到」= 一个都不动（g_gd_sel / scroll 保持原样）：调用方失败时会退到环绕那一步，
// 若这里把 sel 留在某个「没有改动行」的文件上，环绕就会作用在错的文件上。

fn gd_next_change_file(step: i32) bool {
    if g_gd_nfiles == 0 {
        return false;
    }
    const keep_sel: usize = g_gd_sel;
    var i: i64 = (g_gd_sel as i64) + (step as i64);
    while i >= 0 && i < (g_gd_nfiles as i64) {
        const fi: usize = i as usize;
        if fi != g_gd_sel {
            g_gd_sel = fi;
            if !gd_load_sel() {
                g_gd_sel = keep_sel;
                return false;
            }
            if g_gd_nrows > 0 {
                const t: usize = if step > 0 { gd_first_change() } else { gd_last_change() };
                if gd_row_is_change(t) {
                    g_gd_scroll = t;
                    g_gd_hscroll = 0;
                    return true;
                }
            }
            // 这个文件没有改动行（例如只有 mode 变更）：接着翻下一个
        }
        i = i + (step as i64);
    }
    // 翻到头也没找到：把选择还原（内容也跟着换过了，重新载回来）
    if g_gd_sel != keep_sel {
        g_gd_sel = keep_sel;
        _ = gd_load_sel();
    }
    return false;
}


fn gd_txt_lines(dst: &Buf, src: &const Buf, max_lines: usize, budget: &usize, wrote: &usize) void {
    var cur: usize = 0;
    var emitted: usize = 0;
    while emitted < max_lines && budget[0] > 0 {
        var off: usize = 0;
        var len: usize = 0;
        var next: usize = 0;
        if !gd_next_line(src.ptr as &const byte, src.len, cur, &off, &len, &next) {
            break;
        }
        cur = next;
        _ = buf_append(dst, src.ptr + off, len);
        _ = buf_append_byte(dst, 10);
        emitted = emitted + 1;
        budget[0] = budget[0] - 1;
    }
    wrote[0] = emitted;
}

export fn gd_print_text(ws: &const byte, n: usize, out: &Buf) void {
    gd_ensure();
    buf_reset(out);
    const rc: i32 = gd_open(ws, n);
    _ = buf_append_cstr(out, "[diff] ");
    if rc < 0 {
        _ = buf_append(out, g_gd_err.ptr, g_gd_err.len);
        _ = buf_append_byte(out, 10);
        return;
    }
    // P34：这里写的是**工作区**（当前会话在哪），不是仓库名 —— 一个仓库多个 worktree 时
    // 「哪个工作区的改动」才是用户要看的那件事
    var wsl: Buf = buf_new(g_gd_ws.len + g_gd_label.len + 8);
    defer { buf_free(&wsl); }
    gd_ws_label_into(&wsl);
    _ = buf_append(out, wsl.ptr as &const byte, wsl.len);
    _ = buf_append_cstr(out, " · ");
    _ = buf_append_u64(out, g_gd_nfiles as u64);
    _ = buf_append_cstr(out, " 个文件（HEAD ↔ 工作区）\n");
    if g_gd_nfiles == 0 {
        _ = buf_append_cstr(out, "（没有 git 修改）\n");
        return;
    }
    var i: usize = 0;
    while i < g_gd_nfiles {
        _ = buf_append_cstr(out, "  ");
        _ = buf_append(out, gd_fat(g_gd_foff[i]), g_gd_flen[i]);
        _ = buf_append_byte(out, 10);
        i = i + 1;
    }
    var budget: usize = GD_TXT_MAX_LINES;
    var shown: usize = 0;
    var clean: Buf = buf_new(65536);
    defer { buf_free(&clean); }
    i = 0;
    while i < g_gd_nfiles && i < GD_TXT_FILES && budget > 0 {
        const untracked: bool = gd_is_untracked(i);
        const rc2: i32 = gd_run_file_diff(untracked, g_gd_poff[i], g_gd_plen[i], GD_TXT_CTX, &g_gd_out);
        if rc2 < 0 {
            break;
        }
        _ = buf_append_cstr(out, "--- ");
        _ = buf_append(out, g_gd_paths.ptr + g_gd_poff[i], g_gd_plen[i]);
        _ = buf_append_byte(out, 10);
        // 外来字节只以「清洗后」的形态上屏（P19 的口径）：ESC/TAB/控制字节都换掉
        buf_reset(&clean);
        tui_clean_into(&clean, g_gd_out.ptr as &const byte, g_gd_out.len);
        var wrote: usize = 0;
        gd_txt_lines(out, &clean, GD_TXT_FILE_LINES, &budget, &wrote);
        shown = shown + wrote;
        i = i + 1;
    }
    if i < g_gd_nfiles {
        _ = buf_append_cstr(out, "…（还有 ");
        _ = buf_append_u64(out, (g_gd_nfiles - i) as u64);
        _ = buf_append_cstr(out, " 个文件没展开；TUI 里的 /diff 是双列全文比对）\n");
    } else if budget == 0 {
        _ = buf_append_cstr(out, "…（输出已达上限；TUI 里的 /diff 可看完整双列比对）\n");
    }
    _ = shown;
}
