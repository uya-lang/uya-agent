// src/diff/rows.uya — 差分模块：unified diff → 行表
//
// 本文件：把 git 的统一差异解析成可渲染的行表 —— 删块/增块**配对**成左右两栏的
//   一行（MIX），上下文行两侧同文（CTX），落单的删/增各占一侧（DEL/ADD），
//   `diff --git` 之类的整行说明落 HDR。
// 不变量：一次增/删块配对上限 GD_RUN_MAX（超了放弃配对，但**内容一行不丢**）；
//   行表上限 GD_MAX_ROWS（超了置 g_gd_rowcut）；行表里的偏移指向 g_gd_textp。
// 依赖：model（状态与配对草稿缓冲）、foundation/bufx。

fn gd_emit(kind: u8, lo: usize, ll: usize, ro: usize, rl: usize, lno: usize, rno: usize) void {
    if g_gd_nrows >= GD_MAX_ROWS {
        g_gd_rowcut = true;
        return;
    }
    g_gd_rows[g_gd_nrows] = GdRow{
        l_off: lo, l_len: ll, r_off: ro, r_len: rl, l_no: lno, r_no: rno, kind: kind
    };
    g_gd_nrows = g_gd_nrows + 1;
}

// 把攒着的删/增描述符落成**不配对**的行（顺序：先删后增，与 unified diff 一致）

fn gd_flush_unpaired(added: &usize, removed: &usize) void {
    var k: usize = 0;
    while k < g_gd_pdn && k < GD_RUN_MAX {
        gd_emit(GD_K_DEL, g_gd_pd[k].off, g_gd_pd[k].len, 0, 0, g_gd_pd[k].no, 0);
        removed[0] = removed[0] + 1;
        k = k + 1;
    }
    k = 0;
    while k < g_gd_pan && k < GD_RUN_MAX {
        gd_emit(GD_K_ADD, 0, 0, g_gd_pa[k].off, g_gd_pa[k].len, 0, g_gd_pa[k].no);
        added[0] = added[0] + 1;
        k = k + 1;
    }
    g_gd_pdn = 0;
    g_gd_pan = 0;
}

// 结算一个变更块：配对成功的部分出 MIX（左删右增），落单的出 DEL / ADD

fn gd_flush_block(added: &usize, removed: &usize) void {
    if g_gd_pdn == 0 && g_gd_pan == 0 {
        g_gd_pair_ok = true;
        return;
    }
    if !g_gd_pair_ok {
        gd_flush_unpaired(added, removed);
        g_gd_pair_ok = true;
        return;
    }
    var k: usize = 0;
    while k < g_gd_pdn && k < g_gd_pan && k < GD_RUN_MAX {
        gd_emit(GD_K_MIX, g_gd_pd[k].off, g_gd_pd[k].len, g_gd_pa[k].off, g_gd_pa[k].len,
            g_gd_pd[k].no, g_gd_pa[k].no);
        removed[0] = removed[0] + 1;
        added[0] = added[0] + 1;
        k = k + 1;
    }
    while k < g_gd_pdn && k < GD_RUN_MAX {
        gd_emit(GD_K_DEL, g_gd_pd[k].off, g_gd_pd[k].len, 0, 0, g_gd_pd[k].no, 0);
        removed[0] = removed[0] + 1;
        k = k + 1;
    }
    var m: usize = g_gd_pdn;
    if g_gd_pdn > g_gd_pan {
        m = g_gd_pan;
    }
    while m < g_gd_pan && m < GD_RUN_MAX {
        gd_emit(GD_K_ADD, 0, 0, g_gd_pa[m].off, g_gd_pa[m].len, 0, g_gd_pa[m].no);
        added[0] = added[0] + 1;
        m = m + 1;
    }
    g_gd_pdn = 0;
    g_gd_pan = 0;
    g_gd_pair_ok = true;
}

// `@@ -a[,b] +c[,d] @@` → 两侧起始行号

fn gd_parse_hunk_head(p: &const byte, n: usize, lno: &usize, rno: &usize) bool {
    var i: usize = 0;
    while i < n && p[i] != 45 as byte {   // '-'：@@ -1,5 +1,5 @@
        i = i + 1;
    }
    if i >= n {
        return false;
    }
    i = i + 1;
    var l: usize = 0;
    var have_l: bool = false;
    while i < n && p[i] >= 48 as byte && p[i] <= 57 as byte {
        l = l * (10 as usize) + ((p[i] - 48 as byte) as usize);
        have_l = true;
        i = i + 1;
    }
    while i < n && p[i] != 43 as byte {
        i = i + 1;
    }
    if i >= n {
        return false;
    }
    i = i + 1;
    var r: usize = 0;
    var have_r: bool = false;
    while i < n && p[i] >= 48 as byte && p[i] <= 57 as byte {
        r = r * (10 as usize) + ((p[i] - 48 as byte) as usize);
        have_r = true;
        i = i + 1;
    }
    if !have_l || !have_r {
        return false;
    }
    lno[0] = l;
    rno[0] = r;
    return true;
}

// 解析一段 unified diff（自测可直接喂文本）。added/removed 出增删行数。

export fn gd_parse_into(text: &const Buf, added: &usize, removed: &usize) void {
    gd_ensure();
    g_gd_nrows = 0;
    g_gd_rowcut = false;
    g_gd_pdn = 0;
    g_gd_pan = 0;
    g_gd_pair_ok = true;
    added[0] = 0;
    removed[0] = 0;
    g_gd_textp = text.ptr as &const byte;
    if text.len == 0 {
        return;
    }
    const p: &const byte = text.ptr as &const byte;
    const n: usize = text.len;
    // 有 hunk 头，或至少像 diff 的输出 → 走状态机；否则（例如 git 的报错）整段作为一行说明
    var has_hunk: bool = false;
    var cur0: usize = 0;
    while true {
        var o: usize = 0;
        var l: usize = 0;
        var nx: usize = 0;
        if !gd_next_line(p, n, cur0, &o, &l, &nx) {
            break;
        }
        cur0 = nx;
        if l >= 3 && gd_startswith(p + o, l, "@@ " as &const byte) {
            has_hunk = true;
            break;
        }
    }
    if !has_hunk && !gd_startswith(p, n, "diff --git" as &const byte) {
        gd_emit(GD_K_HDR, 0, n, 0, 0, 0, 0);
        return;
    }
    var lno: usize = 0;
    var rno: usize = 0;
    var in_hunk: bool = false;
    var cur: usize = 0;
    while true {
        var off: usize = 0;
        var len: usize = 0;
        var next: usize = 0;
        if !gd_next_line(p, n, cur, &off, &len, &next) {
            break;
        }
        cur = next;
        if len >= 3 && gd_startswith(p + off, len, "@@ " as &const byte) {
            gd_flush_block(added, removed);
            var a: usize = 0;
            var b: usize = 0;
            if gd_parse_hunk_head(p + off, len, &a, &b) {
                lno = a;
                rno = b;
                in_hunk = true;
            }
            gd_emit(GD_K_HDR, off, len, 0, 0, 0, 0);
            continue;
        }
        if !in_hunk {
            // 头区：`diff --git` / `index` / `---` / `+++` / mode / rename 之类一律不显示；
            // 「Binary files … differ」是有信息量的，留一行
            if gd_startswith(p + off, len, "Binary files" as &const byte) {
                gd_emit(GD_K_HDR, off, len, 0, 0, 0, 0);
            }
            continue;
        }
        var c: byte = 32 as byte;
        if len > 0 {
            c = p[off];
        }
        if c == 32 as byte || len == 0 {
            gd_flush_block(added, removed);
            // 空行 / 上下文：标记列（空格）不算内容
            var so: usize = off;
            var sl: usize = len;
            if len > 0 {
                so = off + 1;
                sl = len - 1;
            }
            gd_emit(GD_K_CTX, so, sl, so, sl, lno, rno);
            lno = lno + 1;
            rno = rno + 1;
            continue;
        }
        if c == 45 as byte {   // '-'
            if g_gd_pan > 0 {
                gd_flush_block(added, removed);   // 畸形顺序（删行跟在增行后面）：先把上一块结算掉
            }
            if !g_gd_pair_ok {
                gd_emit(GD_K_DEL, off + 1, len - 1, 0, 0, lno, 0);
                removed[0] = removed[0] + 1;
            } else if g_gd_pdn >= GD_RUN_MAX {
                gd_flush_unpaired(added, removed);   // 先把已攒的删行落地（顺序不乱），本块改成不配对
                g_gd_pair_ok = false;
                gd_emit(GD_K_DEL, off + 1, len - 1, 0, 0, lno, 0);
                removed[0] = removed[0] + 1;
            } else {
                g_gd_pd[g_gd_pdn] = GdRun{ off: off + 1, len: len - 1, no: lno };
                g_gd_pdn = g_gd_pdn + 1;
            }
            lno = lno + 1;
            continue;
        }
        if c == 43 as byte {   // '+'
            if !g_gd_pair_ok || g_gd_pdn == 0 {
                gd_emit(GD_K_ADD, 0, 0, off + 1, len - 1, 0, rno);
                added[0] = added[0] + 1;
            } else if g_gd_pan >= GD_RUN_MAX {
                gd_flush_unpaired(added, removed);
                g_gd_pair_ok = false;
                gd_emit(GD_K_ADD, 0, 0, off + 1, len - 1, 0, rno);
                added[0] = added[0] + 1;
            } else {
                g_gd_pa[g_gd_pan] = GdRun{ off: off + 1, len: len - 1, no: rno };
                g_gd_pan = g_gd_pan + 1;
            }
            rno = rno + 1;
            continue;
        }
        if c == 92 as byte {   // '\'：`\ No newline at end of file`
            gd_flush_block(added, removed);
            gd_emit(GD_K_HDR, off, len, 0, 0, 0, 0);
            continue;
        }
        // 不该出现：宁可见到内容（当上下文处理）
        gd_flush_block(added, removed);
        gd_emit(GD_K_CTX, off, len, off, len, lno, rno);
        lno = lno + 1;
        rno = rno + 1;
    }
    gd_flush_block(added, removed);
}
