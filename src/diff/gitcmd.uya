// src/diff/gitcmd.uya — 差分模块：git 子进程调用
//
// 本文件：argv 全是 C 字符串的 git 调用（cwd 交给 `git -C`，不 chdir）——
//   rev-parse --show-toplevel / rev-parse HEAD / status --porcelain -z /
//   diff --numstat -z / diff -U<ctx>；输出落 g_gd_out，rc 落调用方。
// 不变量：**只读**。只用 status / diff / rev-parse，绝不 add / stash / commit；
//   环境里带 GIT_OPTIONAL_LOCKS=0（status 不写 index.lock），实现在 vcs/gitx。
// 依赖：vcs/gitx（gitx_run / gitx_last_truncated / gitx_available / gitx_cstr / gitx_trim_nl）。
// 命名：本文件统一 `gd_` 前缀，且都是 `gd_run_*`（一条 git 命令一个函数）。

// 把 `-U<n>` 写进 g_gd_ctxz（含结尾 NUL），供 gd_run_file_diff 拼 argv 用。
fn gd_arg_line(ctx_lines: usize) void {
    buf_reset(&g_gd_ctxz);
    _ = buf_append_cstr(&g_gd_ctxz, "-U");
    _ = buf_append_u64(&g_gd_ctxz, ctx_lines as u64);
    _ = buf_append_byte(&g_gd_ctxz, 0);
}

// 跑 `git -C <工作区> rev-parse --show-toplevel`：输出（仓库根，带换行）落 g_gd_out，
// 返回 git 退出码；非仓库时非 0，调用方据此回退。
fn gd_run_toplevel() i32 {
    var av: [&const byte: 8] = [null as &const byte: 8];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = g_gd_ws_z.ptr as &const byte;
    av[3] = "rev-parse" as &const byte;
    av[4] = "--show-toplevel" as &const byte;
    av[5] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], &g_gd_out, &g_gd_errout, 8192);
}

// 跑 `rev-parse --verify -q HEAD` 探「仓库有没有首个提交」：只看退出码，
// 输出丢弃到 g_gd_out；无 HEAD（新 init 的仓库）时非 0。
fn gd_run_has_head() i32 {
    var av: [&const byte: 10] = [null as &const byte: 10];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = g_gd_root_z.ptr as &const byte;
    av[3] = "rev-parse" as &const byte;
    av[4] = "--verify" as &const byte;
    av[5] = "-q" as &const byte;
    av[6] = "HEAD" as &const byte;
    av[7] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], &g_gd_out, &g_gd_errout, 4096);
}

// 跑 `status --porcelain=v1 -z --no-renames -uall`，NUL 分隔的原始结果落 g_gd_status
// （不是 g_gd_out）；-uall 让未跟踪目录逐文件列出，输出上限 GD_MAX_DIFF。
fn gd_run_status() i32 {
    var av: [&const byte: 14] = [null as &const byte: 14];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = g_gd_root_z.ptr as &const byte;
    av[3] = "--no-pager" as &const byte;
    av[4] = "status" as &const byte;
    av[5] = "--porcelain=v1" as &const byte;
    av[6] = "-z" as &const byte;
    av[7] = "--no-renames" as &const byte;   // 重命名拆成「删除 + 新增」，-z 的解析就不用管两段式
    av[8] = "-uall" as &const byte;
    av[9] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], &g_gd_status, &g_gd_errout, GD_MAX_DIFF);
}

// 跑 `diff --numstat -z --no-renames HEAD`（整体增删行数），落 g_gd_out；
// 无 HEAD 时失败，调用方退化成「没有行数」，不影响 status 已给出的文件名。
fn gd_run_numstat() i32 {
    var av: [&const byte: 16] = [null as &const byte: 16];
    av[0] = "git" as &const byte;
    av[1] = "-C" as &const byte;
    av[2] = g_gd_root_z.ptr as &const byte;
    av[3] = "--no-pager" as &const byte;
    av[4] = "diff" as &const byte;
    av[5] = "--numstat" as &const byte;
    av[6] = "-z" as &const byte;
    av[7] = "--no-renames" as &const byte;
    av[8] = "HEAD" as &const byte;
    av[9] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], &g_gd_out, &g_gd_errout, GD_MAX_DIFF);
}

// 单个文件的 diff：已跟踪 = `diff HEAD -- <path>`；未跟踪 / 无 HEAD = `diff --no-index /dev/null <path>`
// 返回 git 退出码（--no-index 有差异时是 1，按成功处理）

// 结果写进调用方给的 out（不是 g_gd_out）；路径从 g_gd_paths 的 poff/plen 现取，
// 拼进复用的 g_gd_pathz；-U 的上下文行数由 ctx_lines 决定（GD_FULL_CTX = 整份文件）。
fn gd_run_file_diff(untracked: bool, poff: usize, plen: usize, ctx_lines: usize, out: &Buf) i32 {
    gd_arg_line(ctx_lines);
    buf_reset(&g_gd_pathz);
    _ = buf_append(&g_gd_pathz, g_gd_paths.ptr + poff, plen);
    _ = buf_append_byte(&g_gd_pathz, 0);
    var av: [&const byte: 20] = [null as &const byte: 20];
    var i: usize = 0;
    av[i] = "git" as &const byte; i = i + 1;
    av[i] = "-C" as &const byte; i = i + 1;
    av[i] = g_gd_root_z.ptr as &const byte; i = i + 1;
    av[i] = "--no-pager" as &const byte; i = i + 1;
    av[i] = "diff" as &const byte; i = i + 1;
    av[i] = "--no-color" as &const byte; i = i + 1;
    av[i] = "--no-ext-diff" as &const byte; i = i + 1;
    av[i] = "--no-textconv" as &const byte; i = i + 1;
    av[i] = "--no-renames" as &const byte; i = i + 1;
    av[i] = g_gd_ctxz.ptr as &const byte; i = i + 1;
    if untracked || !g_gd_has_head {
        av[i] = "--no-index" as &const byte; i = i + 1;
        av[i] = "--" as &const byte; i = i + 1;
        av[i] = "/dev/null" as &const byte; i = i + 1;
        av[i] = g_gd_pathz.ptr as &const byte; i = i + 1;
    } else {
        av[i] = "HEAD" as &const byte; i = i + 1;
        av[i] = "--" as &const byte; i = i + 1;
        av[i] = g_gd_pathz.ptr as &const byte; i = i + 1;
    }
    av[i] = null as &const byte;
    return gitx_run(null as &const byte, &av[0], out, &g_gd_errout, GD_MAX_DIFF);
}
