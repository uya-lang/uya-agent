// src/diff/model.uya — 差分模块：数据模型 / 状态 / 文件列表 / 假数据
//
// 本文件：/diff 的行表模型（GdRow / GdRun）、全部上限与枚举常量、全部 g_gd_* 进程级
//   状态、幂等 ensure 与自测隔离 reset、全模块共用的小工具（指针换算、行 / NUL 记录
//   切分、错误与备注文本落盘）、文件列表（status + numstat → 显示行 / 路径 / 偏移表）、
//   标题里的工作区短路径与仓库名，以及不碰 git 的假数据注入（--tui-demo / 自测）。
// 不变量：GdRow 的 l_off/r_off 指向**最近一次解析的文本**（g_gd_textp），gd_open /
//   gd_move / gd_refresh / gd_parse_into 之后失效 —— 渲染层每帧现取，不许跨帧缓存；
//   g_gd_files / g_gd_paths 的第 i 行与两套偏移表一一对应，条数硬上限 GD_MAX_FILES。
// 依赖：foundation/bufx、term/tty、term/tui（清洗）。
// 命名：本目录统一 `gd_` / `GD_` 前缀（uya 是合并命名空间，前缀就是命名空间）。

export const GD_MAX_FILES: usize = 400;

export const GD_MAX_ROWS: usize = 8192;

export const GD_MAX_DIFF: usize = 512 * 1024;

export const GD_FULL_CTX: usize = 100000;   // -U：事实上「整份文件」

export const GD_TXT_CTX: usize = 3;         // 截断回退 / 文本回退用的上下文

export const GD_RUN_MAX: usize = 4096;      // 一次增/删块的配对上限

export const GD_HSTEP: usize = 8;           // ←/→ 每次滚多少显示列

export const GD_TXT_MAX_LINES: usize = 400; // 文本回退的总行数上限

export const GD_TXT_FILE_LINES: usize = 120; // 文本回退里单个文件的行数上限

export const GD_TXT_FILES: usize = 20;      // 文本回退最多详列几个文件

export const GD_E_NOT_REPO: i32 = -1;

export const GD_E_NO_GIT: i32 = -2;

export const GD_E_SPAWN: i32 = -3;

export const GD_E_TIMEOUT: i32 = -4;

// 行类型：CTX = 两侧同文（上下文）；MIX = 左删右增（配对成功）；DEL/ADD = 只占一侧；HDR = 整行说明

export const GD_K_CTX: u8 = 0;

export const GD_K_MIX: u8 = 1;

export const GD_K_DEL: u8 = 2;

export const GD_K_ADD: u8 = 3;

export const GD_K_HDR: u8 = 4;

export struct GdRow {
    l_off: usize,
    l_len: usize,
    r_off: usize,
    r_len: usize,
    l_no: usize,
    r_no: usize,
    kind: u8,
}

struct GdRun {
    off: usize,
    len: usize,
    no: usize,
}

// ---- 状态（进程级：一个前台界面；幂等 ensure，自测用 gd_reset 隔离）----

var g_gd_ready: bool = false;

var g_gd_ws: Buf = Buf{ ptr: null, len: 0, cap: 0 };

var g_gd_ws_z: Buf = Buf{ ptr: null, len: 0, cap: 0 };

var g_gd_root: Buf = Buf{ ptr: null, len: 0, cap: 0 };

var g_gd_root_z: Buf = Buf{ ptr: null, len: 0, cap: 0 };

var g_gd_has_head: bool = false;

// 数据是真的是从 git 来的，还是 gd_load_fixture 注入的假数据（--tui-demo / 自测）。
// 假数据下不许去跑 git：没有仓库，`-C` 会指向未初始化的路径。

var g_gd_real: bool = false;

var g_gd_label: Buf = Buf{ ptr: null, len: 0, cap: 0 };

var g_gd_files: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // 左列表显示行（"\n" 分隔）

var g_gd_paths: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // 路径原文（"\n" 分隔，与 files 行一一对应）

var g_gd_foff: [usize: GD_MAX_FILES] = [0: GD_MAX_FILES];

var g_gd_flen: [usize: GD_MAX_FILES] = [0: GD_MAX_FILES];

var g_gd_poff: [usize: GD_MAX_FILES] = [0: GD_MAX_FILES];

var g_gd_plen: [usize: GD_MAX_FILES] = [0: GD_MAX_FILES];

var g_gd_nfiles: usize = 0;

var g_gd_nstat: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // numstat 行（`<a>\t<d>\t<path>`）

var g_gd_sel: usize = 0;

var g_gd_scroll: usize = 0;

var g_gd_hscroll: usize = 0;

var g_gd_view: usize = 1;

var g_gd_rows: [GdRow: GD_MAX_ROWS] = [GdRow{
    l_off: 0, l_len: 0, r_off: 0, r_len: 0, l_no: 0, r_no: 0, kind: 0
}: GD_MAX_ROWS];

var g_gd_nrows: usize = 0;

var g_gd_rowcut: bool = false;

var g_gd_textp: &const byte = "" as &const byte;   // 最近一次解析的文本起点

var g_gd_added: usize = 0;

var g_gd_removed: usize = 0;

var g_gd_note: Buf = Buf{ ptr: null, len: 0, cap: 0 };

var g_gd_err: Buf = Buf{ ptr: null, len: 0, cap: 0 };

// 草稿缓冲

var g_gd_out: Buf = Buf{ ptr: null, len: 0, cap: 0 };      // git stdout

var g_gd_status: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // status 的原始输出（-z）

var g_gd_errout: Buf = Buf{ ptr: null, len: 0, cap: 0 };   // git stderr

var g_gd_pathz: Buf = Buf{ ptr: null, len: 0, cap: 0 };

var g_gd_ctxz: Buf = Buf{ ptr: null, len: 0, cap: 0 };

var g_gd_tmp: Buf = Buf{ ptr: null, len: 0, cap: 0 };

// 配对用的待结算块（描述符，不复制正文）

var g_gd_pd: [GdRun: GD_RUN_MAX] = [GdRun{ off: 0, len: 0, no: 0 }: GD_RUN_MAX];

var g_gd_pa: [GdRun: GD_RUN_MAX] = [GdRun{ off: 0, len: 0, no: 0 }: GD_RUN_MAX];

var g_gd_pdn: usize = 0;

var g_gd_pan: usize = 0;

var g_gd_pair_ok: bool = false;

// 首次调用时把全部 g_gd_* 缓冲分配到固定初值；幂等（g_gd_ready 短路），
// 任何 gd_* 入口都先调它，所以外部不需要自己初始化状态。
fn gd_ensure() void {
    if g_gd_ready {
        return;
    }
    g_gd_ready = true;
    if !buf_valid(&g_gd_ws) { g_gd_ws = buf_new(4096); }
    if !buf_valid(&g_gd_ws_z) { g_gd_ws_z = buf_new(4104); }
    if !buf_valid(&g_gd_root) { g_gd_root = buf_new(4096); }
    if !buf_valid(&g_gd_root_z) { g_gd_root_z = buf_new(4104); }
    if !buf_valid(&g_gd_label) { g_gd_label = buf_new(256); }
    if !buf_valid(&g_gd_files) { g_gd_files = buf_new(32768); }
    if !buf_valid(&g_gd_paths) { g_gd_paths = buf_new(32768); }
    if !buf_valid(&g_gd_nstat) { g_gd_nstat = buf_new(32768); }
    if !buf_valid(&g_gd_note) { g_gd_note = buf_new(512); }
    if !buf_valid(&g_gd_err) { g_gd_err = buf_new(512); }
    if !buf_valid(&g_gd_out) { g_gd_out = buf_new(65536); }
    if !buf_valid(&g_gd_status) { g_gd_status = buf_new(65536); }
    if !buf_valid(&g_gd_errout) { g_gd_errout = buf_new(4096); }
    if !buf_valid(&g_gd_pathz) { g_gd_pathz = buf_new(4096); }
    if !buf_valid(&g_gd_ctxz) { g_gd_ctxz = buf_new(32); }
    if !buf_valid(&g_gd_tmp) { g_gd_tmp = buf_new(16384); }
}

// 自测隔离：清掉状态（缓冲留着复用，与 diffx_init 同口径）

// 把 g_gd_* 的会话状态全部清零（条数 / 选中 / 滚动 / 计数 / 真数据标志 / 文本指针 /
// 文件列表缓冲 / 工作区）：内存不释放、容量不动，下一次 gd_open 从干净状态开始。
export fn gd_reset() void {
    gd_ensure();
    g_gd_nfiles = 0;
    g_gd_nrows = 0;
    g_gd_sel = 0;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
    g_gd_view = 1;
    g_gd_added = 0;
    g_gd_removed = 0;
    g_gd_has_head = false;
    g_gd_real = false;
    g_gd_rowcut = false;
    g_gd_textp = "" as &const byte;
    buf_reset(&g_gd_files);
    buf_reset(&g_gd_paths);
    buf_reset(&g_gd_nstat);
    buf_reset(&g_gd_note);
    buf_reset(&g_gd_err);
    buf_reset(&g_gd_label);
    buf_reset(&g_gd_root);
    // P34：工作区也属于「这次解析的状态」—— 假数据注入过工作区之后，下一次 gd_open /
    // gd_load_fixture 必须从干净状态开始（不然标题会挂着上一次的工作区）
    buf_reset(&g_gd_ws);
}

// ============================================================
// 小工具
// ============================================================

// 把偏移换算成 g_gd_textp 上的指针；textp 为空时返回空串（不是 null），
// 返回值只在**下一次解析**之前有效。
fn gd_at(off: usize) &const byte {
    if (g_gd_textp as usize) == 0 {
        return "" as &const byte;
    }
    return @ptr_from_usize(@usize_from_ptr(g_gd_textp as &const void) + off) as &const byte;
}

// 同 gd_at，但基准是左列表缓冲 g_gd_files（`i` 是文件序号）。
fn gd_fat(off: usize) &const byte {
    return @ptr_from_usize(@usize_from_ptr(g_gd_files.ptr as &const void) + off) as &const byte;
}

// p[0..n] 里是否**含**子串 lit（限长口径，不要求以 NUL 结尾）。
fn gd_has(p: &const byte, n: usize, lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    if ln == 0 || n < ln {
        return false;
    }
    var i: usize = 0;
    while i + ln <= n {
        if bufx_mem_eq(p + i, lit, ln) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// p[0..n] 是否**以** lit 开头（空 lit 恒真）。
fn gd_startswith(p: &const byte, n: usize, lit: &const byte) bool {
    const ln: usize = bufx_cstr_len(lit);
    if n < ln {
        return false;
    }
    if ln == 0 {
        return true;
    }
    return bufx_mem_eq(p, lit, ln);
}

// 一行：off/len 是去掉尾部 \r 的内容；next = 下一行的起点（>= n 表示到头）

// 取 from 起的下一行：off/len 为**去掉尾部 \r** 的内容，next 为下一行起点；
// from >= n 返回 false。out 参数是 usize 单元，调用方负责给变量。
fn gd_next_line(p: &const byte, n: usize, from: usize, off: &usize, len: &usize, next: &usize) bool {
    if from >= n {
        return false;
    }
    var i: usize = from;
    while i < n && p[i] != 10 as byte {
        i = i + 1;
    }
    off[0] = from;
    len[0] = i - from;
    next[0] = i + 1;
    if len[0] > 0 && p[from + len[0] - 1] == 13 as byte {
        len[0] = len[0] - 1;   // CRLF：别把 \r 显示成 '·'
    }
    return true;
}

// 一条以 NUL 结尾的记录（`--numstat -z` / `status -z` 的形状；末尾可能带一个 \n）

// 取 from 起的一条 NUL 结尾记录（`--numstat -z` / `status -z` 的形状），
// 末尾的 \n / \r 一并剥掉；from >= n 返回 false。
fn gd_next_z(p: &const byte, n: usize, from: usize, off: &usize, len: &usize, next: &usize) bool {
    if from >= n {
        return false;
    }
    var i: usize = from;
    while i < n && p[i] != 0 as byte {
        i = i + 1;
    }
    off[0] = from;
    len[0] = i - from;
    next[0] = i + 1;
    while len[0] > 0 {
        const c: byte = p[off[0] + len[0] - 1];
        if c == 10 as byte || c == 13 as byte {
            len[0] = len[0] - 1;
        } else {
            break;
        }
    }
    return true;
}

// 清洗 + 只留第一行 + 按显示列限长（给「人看的错误文案」用）

// 把 git stderr 裁成「人看的一行」写进 g_gd_err：清洗控制字符、只取第一行、
// 按显示列截到 160（截断加 `…`）；结果为空则用 fallback。
fn gd_set_err_text(p: &const byte, n: usize, fallback: &const byte) void {
    gd_ensure();
    buf_reset(&g_gd_tmp);
    var e: usize = 0;
    while e < n && p[e] != 10 as byte && p[e] != 13 as byte {
        e = e + 1;
    }
    tui_clean_into(&g_gd_tmp, p, e);
    buf_reset(&g_gd_err);
    const keep: usize = tty_clip_bytes(g_gd_tmp.ptr as &const byte, g_gd_tmp.len, 160);
    if keep > 0 {
        _ = buf_append(&g_gd_err, g_gd_tmp.ptr, keep);
    }
    if keep < g_gd_tmp.len {
        _ = buf_append_cstr(&g_gd_err, "…");
    }
    if g_gd_err.len == 0 {
        _ = buf_append_cstr(&g_gd_err, fallback);
    }
}

// 用固定文案覆盖 g_gd_err（清掉上一次的错误）。
fn gd_set_err(fallback: &const byte) void {
    gd_ensure();
    buf_reset(&g_gd_err);
    _ = buf_append_cstr(&g_gd_err, fallback);
}

// git 退出码 → 给用户看的固定文案：认 GITX_E_NO_GIT / TIMEOUT / SPAWN，其余归「命令失败」。
fn gd_err_fallback(rc: i32) &const byte {
    if rc == GITX_E_NO_GIT {
        return "找不到 git 可执行文件（/diff 需要 git 在 PATH 里）" as &const byte;
    }
    if rc == GITX_E_TIMEOUT {
        return "git 超时（已放弃这次查询）" as &const byte;
    }
    if rc == GITX_E_SPAWN {
        return "起不了 git 子进程" as &const byte;
    }
    return "git 命令失败" as &const byte;
}

// 往备注缓冲 g_gd_note 追加一句（只增不清，清楚由 gd_reset / 开头的 reset 负责）。
fn gd_note_add(lit: &const byte) void {
    _ = buf_append_cstr(&g_gd_note, lit);
}


// 从仓库根路径取末段当仓库名写进 g_gd_label；root 为空或没有 `/` 时退回 "git"。
fn gd_label_of(root: &const Buf) void {
    buf_reset(&g_gd_label);
    if root.len == 0 {
        _ = buf_append_cstr(&g_gd_label, "git");
        return;
    }
    var s: usize = 0;
    var i: usize = 0;
    while i < root.len {
        if root.ptr[i] == 47 as byte {
            s = i + 1;
        }
        i = i + 1;
    }
    if s >= root.len {
        _ = buf_append_cstr(&g_gd_label, "git");
        return;
    }
    _ = buf_append(&g_gd_label, root.ptr + s, root.len - s);
}

// ============================================================
// P34：标题里那一段「这是**哪个工作区**的 diff」
//
// /diff 的列表范围是仓库根（P22 口径），但「当前会话在哪」是工作区 —— worktree 时代
// 一个仓库有好几个工作区，标题只写仓库名就分不出是哪一份（用户报的就是这个）。
// 所以标题写工作区短路径（$HOME → ~）；工作区就是仓库根时不再重复仓库名。
// 假数据（--tui-demo / 自测）没有工作区，退回原来的仓库名，排版因此一个字节没变。
// ============================================================

// 工作区是不是就是仓库根（是的话标题不重复写仓库名；长度不等一律算「不是」）。
fn gd_ws_is_root() bool {
    if g_gd_ws.len == 0 || g_gd_root.len != g_gd_ws.len {
        return false;
    }
    return bufx_mem_eq(g_gd_ws.ptr as &const byte, g_gd_root.ptr as &const byte, g_gd_ws.len);
}

// 工作区短路径（$HOME 前缀折成 `~`）

// 把 g_gd_ws 写成短路径（$HOME 前缀折成 `~`）落 out；工作区为空则 out 为空。
// 只折「HOME 后面还有分隔符」的情形，光 `/home/user` 本身不折。
export fn gd_ws_short_into(out: &Buf) void {
    buf_reset(out);
    if g_gd_ws.len == 0 {
        return;
    }
    const home: &byte = getenv("HOME");
    var hn: usize = 0;
    if (home as usize) != 0 {
        hn = bufx_cstr_len(home);
    }
    // 最后一个目录分隔符也不能算进去（`/home/winger` 不能折成 `~` 之后接空串）
    if hn > 1 && g_gd_ws.len > hn && g_gd_ws.ptr[hn] == 47 as byte &&
        bufx_mem_eq(g_gd_ws.ptr as &const byte, home, hn) {
        _ = buf_append_cstr(out, "~");
        _ = buf_append(&out[0], g_gd_ws.ptr + hn, g_gd_ws.len - hn);
        return;
    }
    _ = buf_append(out, g_gd_ws.ptr as &const byte, g_gd_ws.len);
}

// 标题里的工作区段（TUI 浮窗标题与非 TUI 文本头共用同一份文案）

// 标题里的工作区段：短路径（工作区 ≠ 仓库根时再接 " · 仓库名"）；
// 没有工作区（假数据）退回仓库名。TUI 浮窗标题与非 TUI 文本头共用。
export fn gd_ws_label_into(out: &Buf) void {
    buf_reset(out);
    var wsk: Buf = buf_new(g_gd_ws.len + 8);
    defer { buf_free(&wsk); }
    gd_ws_short_into(&wsk);
    if wsk.len == 0 {
        _ = buf_append(out, g_gd_label.ptr, g_gd_label.len);
        return;
    }
    _ = buf_append(out, wsk.ptr as &const byte, wsk.len);
    if !gd_ws_is_root() {
        _ = buf_append_cstr(out, " · ");
        _ = buf_append(out, g_gd_label.ptr, g_gd_label.len);
    }
}

// 工作区短路径的**末段**（窄终端下的退让：标题里放不下整条短路径时用它）

// 同上的**末段**版本：窄终端放不下整条短路径时只给最后一级目录名；
// 没工作区时同样退回仓库名。
export fn gd_ws_short_tail_into(out: &Buf) void {
    buf_reset(out);
    var wsk: Buf = buf_new(g_gd_ws.len + 8);
    defer { buf_free(&wsk); }
    gd_ws_short_into(&wsk);
    if wsk.len == 0 {
        _ = buf_append(out, g_gd_label.ptr, g_gd_label.len);
        return;
    }
    var s: usize = 0;
    var i: usize = 0;
    while i < wsk.len {
        if wsk.ptr[i] == 47 as byte {
            s = i + 1;
        }
        i = i + 1;
    }
    _ = buf_append(out, wsk.ptr + s, wsk.len - s);
}


// 在 g_gd_nstat 里按路径查一整行 numstat，填 add / del 并返回 1；
// 返回 2 = 二进制（计数是 `-`，fill 不动），0 = 没查到 / 解析不出来。
fn gd_numstat_lookup(path: &const byte, pn: usize, add: &usize, del: &usize) u8 {
    var cur: usize = 0;
    while true {
        var off: usize = 0;
        var len: usize = 0;
        var next: usize = 0;
        // numstat -z 是 NUL 分隔的记录（不是按行）
        if !gd_next_z(g_gd_nstat.ptr as &const byte, g_gd_nstat.len, cur, &off, &len, &next) {
            break;
        }
        cur = next;
        if len == 0 {
            continue;
        }
        const lp: &const byte = g_gd_nstat.ptr as &const byte;
        // `<a>\t<d>\t<path>`
        var t1: usize = 0;
        while t1 < len && lp[off + t1] != 9 as byte {
            t1 = t1 + 1;
        }
        if t1 >= len {
            continue;
        }
        var t2: usize = t1 + 1;
        while t2 < len && lp[off + t2] != 9 as byte {
            t2 = t2 + 1;
        }
        if t2 >= len {
            continue;
        }
        const rest: usize = off + t2 + 1;
        const rn: usize = len - (t2 + 1);
        if rn != pn {
            continue;
        }
        if rn > 0 && !bufx_mem_eq(lp + rest, path, rn) {
            continue;
        }
        // 计数：`-` 表示二进制
        if lp[off] == 45 as byte || lp[off + t1 + 1] == 45 as byte {
            return 2;
        }
        const av: i64 = parse_u64_at(g_gd_nstat.ptr[0: g_gd_nstat.len], off, t1);
        const dv: i64 = parse_u64_at(g_gd_nstat.ptr[0: g_gd_nstat.len], off + t1 + 1, t2 - (t1 + 1));
        if av < 0 || dv < 0 {
            return 0;
        }
        add[0] = av as usize;
        del[0] = dv as usize;
        return 1;
    }
    return 0;
}

// 扫描文件列表（填 files / paths / 偏移表 / nfiles）
// 输入：g_gd_status（status 的 -z 输出）+ g_gd_nstat（numstat）

// 扫 g_gd_status（status 的 -z 输出）+ g_gd_nstat（numstat），填
// files / paths / 两套偏移表 / nfiles。跳过 `!!` 忽略项，超过 GD_MAX_FILES 只列前
// 400 个并追加一行省略提示；恒返回 0（错误另有 g_gd_err 口径）。
fn gd_scan() i32 {
    buf_reset(&g_gd_files);
    buf_reset(&g_gd_paths);
    buf_reset(&g_gd_nstat);
    g_gd_nfiles = 0;
    if g_gd_has_head {
        const rc: i32 = gd_run_numstat();
        if rc == 0 {
            _ = buf_append(&g_gd_nstat, g_gd_out.ptr, g_gd_out.len);
        }
    }
    var cur: usize = 0;
    var capped: bool = false;
    while cur < g_gd_status.len {
        // -z：`<XY><空格><path>\0`
        var e: usize = cur;
        while e < g_gd_status.len && g_gd_status.ptr[e] != 0 as byte {
            e = e + 1;
        }
        if e <= cur + 3 {
            cur = e + 1;
            continue;
        }
        const xy0: byte = g_gd_status.ptr[cur];
        const xy1: byte = g_gd_status.ptr[cur + 1];
        if xy0 == 33 as byte && xy1 == 33 as byte {   // '!!' 忽略项：不列
            cur = e + 1;
            continue;
        }
        if g_gd_nfiles >= GD_MAX_FILES {
            capped = true;
            cur = e + 1;
            continue;
        }
        const path_off: usize = cur + 3;
        const path_len: usize = e - path_off;
        // 列表行：`<XY>  <path>  (+A -D)` / `(new)` / `(bin)`
        const fstart: usize = g_gd_files.len;
        _ = buf_append_byte(&g_gd_files, xy0);
        _ = buf_append_byte(&g_gd_files, xy1);
        _ = buf_append_cstr(&g_gd_files, "  ");
        _ = buf_append(&g_gd_files, g_gd_status.ptr + path_off, path_len);
        const untracked: bool = xy0 == 63 as byte && xy1 == 63 as byte;
        if untracked {
            _ = buf_append_cstr(&g_gd_files, "  (new)");
        } else {
            var a: usize = 0;
            var d: usize = 0;
            const k: u8 = gd_numstat_lookup(g_gd_status.ptr + path_off, path_len, &a, &d);
            if k == 2 {
                _ = buf_append_cstr(&g_gd_files, "  (bin)");
            } else if k == 1 {
                _ = buf_append_cstr(&g_gd_files, "  (+");
                _ = buf_append_u64(&g_gd_files, a as u64);
                _ = buf_append_cstr(&g_gd_files, " -");
                _ = buf_append_u64(&g_gd_files, d as u64);
                _ = buf_append_cstr(&g_gd_files, ")");
            }
        }
        const fend: usize = g_gd_files.len;
        g_gd_foff[g_gd_nfiles] = fstart;
        g_gd_flen[g_gd_nfiles] = fend - fstart;
        const pstart: usize = g_gd_paths.len;
        _ = buf_append(&g_gd_paths, g_gd_status.ptr + path_off, path_len);
        g_gd_poff[g_gd_nfiles] = pstart;
        g_gd_plen[g_gd_nfiles] = path_len;
        _ = buf_append_byte(&g_gd_files, 10);
        _ = buf_append_byte(&g_gd_paths, 10);
        g_gd_nfiles = g_gd_nfiles + 1;
        cur = e + 1;
    }
    if capped {
        _ = buf_append_cstr(&g_gd_files, "…（文件太多，只列了前 ");
        _ = buf_append_u64(&g_gd_files, GD_MAX_FILES as u64);
        _ = buf_append_cstr(&g_gd_files, " 个）");
        _ = buf_append_byte(&g_gd_files, 10);
    }
    return 0;
}

// 选中项是不是未跟踪（'??'）

// 第 i 个文件是不是未跟踪（列表行以 `??` 开头）；越界 / 行太短一律返回 false。
fn gd_is_untracked(i: usize) bool {
    if i >= GD_MAX_FILES {
        return false;
    }
    if i >= g_gd_nfiles {
        return false;
    }
    if g_gd_flen[i] < 2 {
        return false;
    }
    const p: &const byte = gd_fat(g_gd_foff[i]);
    return p[0] == 63 as byte && p[1] == 63 as byte;
}


// 假数据注入：只把工作区路径塞进 g_gd_ws（--tui-demo 要标题像真的有工作区）。
export fn gd_fixture_ws(ws: &const byte, n: usize) void {
    gd_ensure();
    buf_reset(&g_gd_ws);
    _ = buf_append(&g_gd_ws, ws, n);
}

// 不碰 git 的假数据入口（--tui-demo / 自测）：先 gd_reset，label 作仓库名，
// files 每行一条列表项（`<XY>  <path>  (+A -D)`，空行忽略），diff_text 走 gd_parse_into
// 解析；置 g_gd_real = false，此后不许再去跑 git。
export fn gd_load_fixture(label: &const byte, files: &const Buf, diff_text: &const Buf) void {
    gd_ensure();
    gd_reset();
    g_gd_real = false;
    buf_reset(&g_gd_label);
    _ = buf_append_cstr(&g_gd_label, label);
    // 假列表：每行 `<XY>  <path>  (+A -D)`，空行忽略
    var cur: usize = 0;
    while true {
        var off: usize = 0;
        var len: usize = 0;
        var next: usize = 0;
        if !gd_next_line(files.ptr as &const byte, files.len, cur, &off, &len, &next) {
            break;
        }
        cur = next;
        if len == 0 || g_gd_nfiles >= GD_MAX_FILES {
            continue;
        }
        const fstart: usize = g_gd_files.len;
        _ = buf_append(&g_gd_files, files.ptr + off, len);
        g_gd_foff[g_gd_nfiles] = fstart;
        g_gd_flen[g_gd_nfiles] = len;
        const pstart: usize = g_gd_paths.len;
        _ = buf_append(&g_gd_paths, files.ptr + off, len);
        g_gd_poff[g_gd_nfiles] = pstart;
        g_gd_plen[g_gd_nfiles] = len;
        _ = buf_append_byte(&g_gd_files, 10);
        _ = buf_append_byte(&g_gd_paths, 10);
        g_gd_nfiles = g_gd_nfiles + 1;
    }
    buf_reset(&g_gd_out);
    _ = buf_append(&g_gd_out, diff_text.ptr, diff_text.len);
    var a: usize = 0;
    var r: usize = 0;
    gd_parse_into(&g_gd_out, &a, &r);
    g_gd_added = a;
    g_gd_removed = r;
    g_gd_sel = 0;
    g_gd_scroll = 0;
    g_gd_hscroll = 0;
}

// 调试：把行表倒成一行摘要（自测失败时打出来看）

// 调试用：把行表倒成每行一条摘要落 out（序号 / kind / 两侧行号与文本），
// 自测失败时打出来看；只读，不改任何状态。
export fn gd_dump_rows(out: &Buf) void {
    gd_ensure();
    buf_reset(out);
    var i: usize = 0;
    while i < g_gd_nrows && i < GD_MAX_ROWS {
        const r: GdRow = g_gd_rows[i];
        _ = buf_append_u64(out, i as u64);
        _ = buf_append_cstr(out, ":k");
        _ = buf_append_u64(out, r.kind as u64);
        _ = buf_append_cstr(out, " L");
        _ = buf_append_u64(out, r.l_no as u64);
        _ = buf_append_cstr(out, "[");
        _ = buf_append(out, gd_at(r.l_off), r.l_len);
        _ = buf_append_cstr(out, "] R");
        _ = buf_append_u64(out, r.r_no as u64);
        _ = buf_append_cstr(out, "[");
        _ = buf_append(out, gd_at(r.r_off), r.r_len);
        _ = buf_append_cstr(out, "]\n");
        i = i + 1;
    }
}
