// src/net/ahttp.uya — 异步 HTTP/1.1 客户端（P99）：与 `hc_open`/`hc_fill` 同语义
//
// 本文件：把 `httpstream` 的「发请求 → 读响应头 → 一条一条喂 SSE/body」那套循环
//     搬到事件循环上：`ahc_open` / `ahc_fill`。**解析全部复用现有件**
//     （`url_parse` / `hc_route_for` / `hc_build_request` / `hc_head_finish` /
//     `hc_decode_step`），本文件只负责「谁去等 I/O」。
//
// 不变量：
//   ① **判据只有一份**：请求行形态（相对 / 绝对形式）、响应头解析（状态码 /
//      Content-Length / Transfer-Encoding）、chunked 与 Content-Length 的优先级、
//      EOF 语义 —— 全部调 `httpc`/`httpstream` 里那几支，本文件一条都不复刻。
//      谁要改语义，改那边，两边一起生效。
//   ② 连接阶段（名字解析 + TCP + TLS 握手）**仍是同步的**：DNS ≤5 s、握手 ≤
//      `timeout_ms`，与改造前逐字节相同（DESIGN §15.1 记的那条边界）。数据阶段
//      （写请求、读头、读体/SSE）全部 async —— 那才是「流式期间能按 esc」的部分。
//      握手要真正异步，得先把 `https_client_handshake` 改成可续（它现在每次调用
//      都从 ClientHello 重来，非阻塞 fd 上会重发），那是另一轮。
//   ③ 连上之后 fd **立刻切非阻塞**（`rt_set_nonblock`）：此后所有读写都走 `rtio`
//      的 EAGAIN→等就绪→重试循环；漏了这一步，`rt_read` 会在阻塞 fd 上把事件循环
//      停住（那正是本轮要消灭的东西）。
//
// 依赖：src/rt/rtloop.uya（取消 / 定时）、src/rt/rtio.uya（`rt_read` / `rt_write` /
//   `rt_connect` / `rt_set_nonblock`）、src/net/httpc.uya（`url_parse` /
//   `hc_route_for` / `hc_connect` / `tcp_connect` / `hc_addr_into` /
//   `tls_open` / `build_request`）、
//   src/net/httpstream.uya（`hc_head_finish` / `hc_decode_step`）。
// 命名：`ahc_*`、`AHC_*`。

use std.async;
use libc.syscall;
use tls.common;
use tls.https;

// 一次最多读多少 wire 字节（与 httpstream 的 `HC_READ_CHUNK` 同值）。
const AHC_READ_CHUNK: usize = 16384;
// 单条 TLS 记录的明文上限 / 密文缓冲（与 httpc 的 `HC_TLS_CHUNK` / `HC_TLS_BUF` 同值）。
// **两处同值改一处要改两处**：记录格式由 tls 标准库定，这里只是按它切与收。
const AHC_TLS_CHUNK: usize = 16384;
const AHC_TLS_BUF: usize = 16896;
// 响应头上限（与 httpstream 的 `HC_HEAD_MAX` 同值：超了就是坏响应）。
// **两处同值改一处要改两处** —— 判据在 httpstream，这里只是提前挡住无界增长。
const AHC_HEAD_MAX: usize = 65536;

// async 建连：**只有 TCP 连接那一步是异步的**（非阻塞 connect + 等可写 + SO_ERROR）。
//
// 名字解析仍同步（`hc_addr_into` 内部走解析器，≤5 s，见文件头不变量②）；代理隧道
// （`HC_ROUTE_TUNNEL`）整段回落到同步的 `hc_connect`：它要发 CONNECT 再读应答，
// 与握手同一档，留到把「可续的读应答」做出来之后一起搬。
@async_fn fn ahc_connect_run(
    u: &const Url,
    timeout_ms: u32,
    route_inout: &u8
) Future<!i32> {
    route_inout[0] = hc_route_for(u);
    hc_note_route(route_inout[0]);
    if route_inout[0] == HC_ROUTE_TUNNEL {
        const fd_sync: i32 = try hc_connect(u, timeout_ms, route_inout);
        rt_set_nonblock(fd_sync);
        return fd_sync;
    }
    var host: &const byte = url_host(u);
    var host_len: usize = u.host_len;
    var port: u16 = u.port;
    if route_inout[0] == HC_ROUTE_PROXY_ABS {
        hpx_note_target(host, host_len, port);
        host = hpx_host_ptr();
        host_len = hpx_host_len();
        port = hpx_port();
    }
    var addr: [byte: 16] = [0: 16];
    var alen: u32 = 16;
    const ar: !void = hc_addr_into(
        host, host_len, port, timeout_ms, &addr[0], &alen);
    ar catch |err| {
        return err;
    };
    const fd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return error.HcConnectFailed;
    };
    // P103：TLS 握手仍是**阻塞**的（不变量②），所以握手前必须让 fd 带上收发超时。
    // 同步路的 `tcp_connect` 一直这么做；async 路自己 sys_socket 出来的 fd 没有，
    // 漏掉它一个不回包的服务器就能把整个进程挂住（超时参数等于没写）。
    hc_set_rw_timeout(fd, timeout_ms);
    rt_set_nonblock(fd);
    var dl: u64 = 0;
    if timeout_ms > 0 {
        dl = deadline_after_ms(timeout_ms) catch { 0 as u64; };
    }
    const cr: !usize = @await rt_connect(fd, &addr[0] as &const void, alen, dl);
    cr catch |err| {
        _ = sys_close(fd) catch {};
        const eid: i32 = (@error_id(err) as! i32).value;
        if eid == (@error_id(error.Cancelled) as! i32).value {
            return error.Cancelled;
        }
        if route_inout[0] == HC_ROUTE_PROXY_ABS {
            hpx_note_fail(HPX_E_DIAL, 0);
            return error.HcProxyUnavailable;
        }
        return error.HcConnectFailed;
    };
    if route_inout[0] == HC_ROUTE_PROXY_ABS {
        hpx_note_ok();
    }
    return fd;
}

// 对外入口：返回可用的 fd（连上之后已是非阻塞）。
export fn ahc_connect(
    u: &const Url,
    timeout_ms: u32,
    route_inout: &u8
) Future<!i32> {
    return ahc_connect_run(u, timeout_ms, route_inout);
}

// 写满整段（请求体可能上百 KB：分片写，片间由 rtio 等可写）。
@async_fn fn ahc_write_all_run(
    fd: i32,
    src: &const byte,
    len: usize,
    deadline_ms: u64
) Future<!usize> {
    const r: !usize = @await rt_write(fd, src, len, deadline_ms);
    const n: usize = try r;
    return n;
}

// 对外入口。
export fn ahc_write_all(
    fd: i32,
    src: &const byte,
    len: usize,
    deadline_ms: u64
) Future<!usize> {
    return ahc_write_all_run(fd, src, len, deadline_ms);
}

// ============================================================
// TLS 数据面（P103）：fd 上是**密文**，读写都得按记录切
//
// 为什么不能直接 `rt_read` / `rt_write`：TLS 的加密在用户态（标准库的
// `ssl_read` / `ssl_write`，见 httpc 的 `tls_read_some` / `tls_write_all`）。
// 直接往 TLS 的 fd 写明文，对端只会看到一条畸形 record 后掐连接 —— 症状是
// 「请求发出去了，收不到一个字节」，与网络故障长得一模一样。
// 同步路一直是对的（`conn_read` / `conn_write_all` 按记录走 TLS），async 路
// P99 只搬了「谁去等 I/O」，漏了这一层，于是**交互模式下所有 https 端点都连不上**
// （一次性/管道模式走同步路，所以同一个 key 在那里是好的）。
//
// 判据与同步路一致：记录头 5 字节（类型 + 版本 + 长度），只解密
// APPLICATION_DATA，alert 当 EOF（close_notify），握手/CCS 记录跳过。
// ============================================================

// 读满 need 字节（记录头与负载都必须读满才谈得上解密）。
// 返回 1 = 读满；0 = 对端关闭；取消 / 超时 / IO 错误照 `rt_read` 的收口。
@async_fn fn ahc_read_exact(
    fd: i32,
    out: &byte,
    need: usize,
    deadline_ms: u64
) Future<!usize> {
    var off: usize = 0;
    while off < need {
        const p: &byte =
            @ptr_from_usize(@usize_from_ptr(out as &void) + off) as &byte;
        var got: usize = 0;
        const rr: !usize = @await rt_read(
            fd, p, need - off, deadline_ms, &got);
        const flag: usize = try rr;
        if flag == 0 || got == 0 {
            return 0 as usize;
        }
        off = off + got;
    }
    return 1 as usize;
}

// 读一条 TLS 记录并解密。返回码与 `rt_read` 同形（1 = 有明文，0 = 对端关闭）。
@async_fn fn ahc_tls_read_some(
    st: &HcStream,
    out: &byte,
    cap: usize,
    deadline_ms: u64,
    n_out: &usize
) Future<!usize> {
    var rec: [byte: AHC_TLS_BUF] = [0: AHC_TLS_BUF];
    while true {
        const h: usize = try @await ahc_read_exact(
            st.fd, &rec[0], 5, deadline_ms);
        if h == 0 {
            return 0 as usize;
        }
        const rec_len: usize = ((rec[3] as usize) << (8 as i32))
            | (rec[4] as usize);
        if 5 +% rec_len > AHC_TLS_BUF {
            return error.HcBadResponse;
        }
        // 负载必须**无条件**读（rec_len == 0 时 `ahc_read_exact` 立刻返回 1）。
        // 不要把这行塞进 `if rec_len > 0 { }` 里：Uya 的 async 状态机在
        // 「await 位于循环体内的 if 里」时会从 await 之后直接跳回循环头，
        // 把 if 之后的语句（解密那一段）整段跳过（P103 实测：只读到记录头，
        // 永远不解密，最后在 EOF 处报 HcBadResponse）。放在循环体顶层就正常。
        const b: usize = try @await ahc_read_exact(
            st.fd, &rec[5], rec_len, deadline_ms);
        if b == 0 {
            return 0 as usize;
        }
        const rt: byte = rec[0];
        if rt == (TLS_RECORD_ALERT as byte) {
            // close_notify（或致命告警）等价于 EOF：手里已解出的明文由上层先消费。
            return 0 as usize;
        }
        if rt != (TLS_RECORD_APPLICATION_DATA as byte) || rec_len == 0 {
            continue;
        }
        var plen: usize = 0;
        var consumed: usize = 0;
        ssl_read(st.tc.ctx, &rec[0], 5 +% rec_len, out, cap,
            &plen, &consumed) catch {
            return error.HcIoFailed;
        };
        if plen == 0 {
            continue;
        }
        n_out[0] = plen;
        return 1 as usize;
    }
    return 0 as usize;
}

// 写满整段明文：按 ≤16 KiB 切记录，加密后交给 `rt_write` 写满密文。
// 返回值是**明文**字节数（与 `rt_write` 同口径）；同步路 `tls_write_all` 同一个形状
// （那边每片还插一次泵点，这里由 rt 的帧回调负责读键 / 刷帧）。
@async_fn fn ahc_tls_write_all(
    st: &HcStream,
    src: &const byte,
    len: usize,
    deadline_ms: u64
) Future<!usize> {
    var off: usize = 0;
    var rec: [byte: AHC_TLS_BUF] = [0: AHC_TLS_BUF];
    while off < len {
        var take: usize = len - off;
        if take > AHC_TLS_CHUNK {
            take = AHC_TLS_CHUNK;
        }
        const p: &const byte = @ptr_from_usize(
            @usize_from_ptr(src as &void) + off) as &const byte;
        var clen: usize = 0;
        ssl_write(st.tc.ctx, p, take, &rec[0], AHC_TLS_BUF, &clen) catch {
            return error.HcIoFailed;
        };
        _ = try @await rt_write(st.fd, &rec[0], clen, deadline_ms);
        off = off + take;
    }
    return off;
}

// 读一段（明文直读 / TLS 解出一条记录的明文）。返回码与 `rt_read` 同形。
@async_fn fn ahc_read_stream(
    st: &HcStream,
    out: &byte,
    cap: usize,
    deadline_ms: u64,
    n_out: &usize
) Future<!usize> {
    if st.is_tls {
        const r: !usize = @await ahc_tls_read_some(
            st, out, cap, deadline_ms, n_out);
        return try r;
    }
    const r2: !usize = @await rt_read(
        st.fd, out, cap, deadline_ms, n_out);
    return try r2;
}

// 写满整段（明文直写 / TLS 分记录加密后写）。返回已写的**明文**字节数。
@async_fn fn ahc_write_stream(
    st: &HcStream,
    src: &const byte,
    len: usize,
    deadline_ms: u64
) Future<!usize> {
    if st.is_tls {
        const w: !usize = @await ahc_tls_write_all(
            st, src, len, deadline_ms);
        return try w;
    }
    const w2: !usize = @await rt_write(st.fd, src, len, deadline_ms);
    return try w2;
}

// async 版的 `hc_open`：建连（TCP 异步 / 握手同步一次）→ 拼请求 → 异步写 →
// 异步读到响应头结束 → 交给 `hc_head_finish` 解析 → 预解一次体。
//
// 参数与错误码与 `hc_open` **逐一对应**（调用方换名字即可）。返回值固定 0 ——
// `@async_fn` 的返回类型必须是 `Future<!T>`，而 `!void` 在 async 里不被接受
// （`Future<!void>` + `return;` 检查器直接拒），所以用 `usize` 0 表示「已就绪」，
// 成败只看 error 分支（与 `hg_open` 的 `!void` 语义等价）。
@async_fn fn ahc_open_run(
    url: &[byte],
    method: &[byte],
    extra_headers: &[byte],
    body: &const byte,
    body_len: usize,
    timeout_ms: u32,
    max_body: usize,
    verify: i32,
    pin: &[byte],
    st: &HcStream,
    tls_out: &TlsConn
) Future<!usize> {
    var u: Url = url_empty();
    try url_parse(url, &u);
    defer { url_free(&u); }

    var route: u8 = HC_ROUTE_DIRECT;
    const cfd: !i32 = @await ahc_connect_run(&u, timeout_ms, &route);
    const fd: i32 = try cfd;
    st.fd = fd;
    st.is_tls = u.tls;
    st.tc = tls_out;
    st.max_body = max_body;

    tls_out.fd = fd;
    var conn: HcConn = HcConn{ fd: fd, is_tls: u.tls, tc: tls_out };
    if u.tls {
        // 握手这一段要的是「阻塞 fd + SO_RCVTIMEO」（见文件头不变量②）：
        // 先切回阻塞，握完再切非阻塞。
        rt_set_blocking(fd);
        var rc_guard: i32 = 0;
        const tr: !void = tls_open(
            tls_out, url_host(&u), u.host_len, verify, pin);
        tr catch |err| {
            rc_guard = 1;
            _ = sys_close(fd) catch {};
            return err;
        };
        _ = rc_guard;
        rt_set_nonblock(fd);
    }

    var req: Buf = buf_new(4096);
    defer { buf_free(&req); }
    if !buf_valid(&req) {
        _ = sys_close(fd) catch {};
        return error.HcOutOfMemory;
    }
    if !build_request(&u, method, extra_headers, body_len, route, &req) {
        _ = sys_close(fd) catch {};
        return error.HcOutOfMemory;
    }
    if !buf_append(&req, body, body_len) {
        _ = sys_close(fd) catch {};
        return error.HcOutOfMemory;
    }
    var dl: u64 = 0;
    if timeout_ms > 0 {
        dl = deadline_after_ms(timeout_ms) catch { 0 as u64; };
    }
    const wr: !usize = @await ahc_write_stream(st, &req.ptr[0], req.len, dl);
    _ = wr catch |err| {
        _ = sys_close(fd) catch {};
        return err;
    };

    st.head = buf_new(512);
    st.rx = buf_new(AHC_READ_CHUNK * 2);
    st.dec = buf_new(AHC_READ_CHUNK);
    if !buf_valid(&st.head) || !buf_valid(&st.rx) || !buf_valid(&st.dec) {
        _ = sys_close(fd) catch {};
        return error.HcOutOfMemory;
    }

    // 读到响应头结束（"\r\n\r\n"）。等待期间**帧回调照常跑**（rt 的 wrapper 负责），
    // 所以网关 prefill 那几秒里界面不冻、esc 也能当场收口（rtio 的取消闸门）。
    var tmp: [byte: AHC_READ_CHUNK] = [0: AHC_READ_CHUNK];
    var head_end: usize = 0;
    while true {
        const view: &[byte] = st.rx.ptr[0: st.rx.len];
        const he: isize = find_sub(view, &"\r\n\r\n"[0: 4], 0);
        if he >= 0 {
            head_end = (he as usize) + 4;
            break;
        }
        if st.rx.len > AHC_HEAD_MAX {
            _ = sys_close(fd) catch {};
            return error.HcBadResponse;
        }
        var got: usize = 0;
        const rr: !usize = @await ahc_read_stream(
            st, &tmp[0], AHC_READ_CHUNK, dl, &got);
        const flag: usize = rr catch |err| {
            _ = sys_close(fd) catch {};
            // 等响应头超时同样折成 `HcTimeout`（与同步路 `hc_open` 同档）。
            const eid: i32 = (@error_id(err) as! i32).value;
            try ahc_map_io_err(eid);
            return err;
        };
        if flag == 0 || got == 0 {
            // 头都没读完就断了（与同步路 `n == 0 ⇒ HcBadResponse` 同判据）
            _ = sys_close(fd) catch {};
            return error.HcBadResponse;
        }
        if !buf_append(&st.rx, &tmp[0], got) {
            _ = sys_close(fd) catch {};
            return error.HcOutOfMemory;
        }
    }
    try hc_head_finish(st, head_end);
    // 头后面可能已经跟着体字节：立刻解一次（与同步路同一步）
    const d0: !i32 = hc_decode_step(st);
    _ = d0 catch {
        0 as i32;
    };
    return 0 as usize;
}

// 对外入口。
export fn ahc_open(
    url: &[byte],
    method: &[byte],
    extra_headers: &[byte],
    body: &const byte,
    body_len: usize,
    timeout_ms: u32,
    max_body: usize,
    verify: i32,
    pin: &[byte],
    st: &HcStream,
    tls_out: &TlsConn
) Future<!usize> {
    return ahc_open_run(url, method, extra_headers, body, body_len, timeout_ms,
        max_body, verify, pin, st, tls_out);
}

// 把 rtio 的两种「等不到」折成上层认识的错误。
//
// `error.AsyncDeadlineExceeded` 是 rtio 的原生收口；同步路在同一个现场报的是
// `error.HcTimeout`（`SO_RCVTIMEO` 触发 ⇒ `conn_read` 折码）。**两条路必须报同一档**，
// 否则上层的 `rtx_retryable_err` / `agent_net_fail_kind` 会在异步腿上多出一个人不认识的
// 码（表现出来就是失败报告里那句笼统的「网络或 TLS 校验」）。
// 取消不折：那是用户按了 esc，语义与超时完全不同。
fn ahc_map_io_err(eid: i32) !void {
    if eid == (@error_id(error.AsyncDeadlineExceeded) as! i32).value {
        return error.HcTimeout;
    }
    return;
}

// async 版的 `hc_fill`：读一次网络并推进解码。返回码与 `hc_fill` 逐一对应
// （1 = 有进展，0 = 体已结束，2 = 暂时没数据 —— 这里没有「暂时」：await 一直等到
// 有数据或 deadline，所以只回 1 / 0）。
//
// `deadline_ms` 是**绝对**毫秒（0 = 不设超时）；到点报 `error.HcTimeout`（见上）。
@async_fn fn ahc_fill_run(st: &HcStream, deadline_ms: u64) Future<!i32> {
    const d0: i32 = try hc_decode_step(st);
    if d0 == 1 {
        return 1 as i32;
    }
    if hc_body_done(st) {
        st.eof = true;
        return 0 as i32;
    }
    var tmp: [byte: AHC_READ_CHUNK] = [0: AHC_READ_CHUNK];
    var got: usize = 0;
    const rr: !usize = @await ahc_read_stream(
        st, &tmp[0], AHC_READ_CHUNK, deadline_ms, &got);
    const flag: usize = rr catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        try ahc_map_io_err(eid);
        return err;
    };
    if flag == 0 || got == 0 {
        // 对端关连接：先尽量把手里剩下的 rx 解完，再报结束（与 `hc_fill` 同判据）
        st.net_eof = true;
        const d1: i32 = try hc_decode_step(st);
        if hc_body_done(st) || d1 == 0 {
            st.eof = true;
            return 0 as i32;
        }
        return 1 as i32;
    }
    if !buf_append(&st.rx, &tmp[0], got) {
        return error.HcOutOfMemory;
    }
    if st.rx.len > st.max_body + AHC_HEAD_MAX + AHC_READ_CHUNK {
        return error.HcTooLarge;
    }
    if st.rx_off > 0 && st.rx_off >= st.rx.len / 2 {
        buf_drop_prefix(&st.rx, st.rx_off);
        st.rx_off = 0;
    }
    const d2: i32 = try hc_decode_step(st);
    if d2 == 1 {
        return 1 as i32;
    }
    if hc_body_done(st) {
        st.eof = true;
        return 0 as i32;
    }
    return 2 as i32;
}

// 对外入口。
export fn ahc_fill(st: &HcStream, deadline_ms: u64) Future<!i32> {
    return ahc_fill_run(st, deadline_ms);
}
