// src/sse.uya — Server-Sent Events 分帧（P1）
//
// 在 httpstream 的「已解码体字节」之上做 SSE 事件切分：
//   * 字段行 `name: value`，`data:` 之后剥掉一个前导空格；
//   * 多行 data 用 "\n" 连接；
//   * 空行 dispatch 一个事件；
//   * 以 ':' 开头的行是注释（忽略），只有非 data 字段的事件不 dispatch；
//   * 流在未终结的事件处结束时**不冲刷**半截事件（与 DSH 用的 eventsource-parser 一致）。
//
// 调用方：反复 hc_fill() 直到返回 0；每轮把 sse_next() 取到的事件交给上层（LLM delta 解析）。

// 单行上限：防畸形流把内存吃光（正常 SSE 行远小于此）
const SSE_LINE_MAX: usize = 262144;

export struct SseReader {
    acc: Buf,          // 当前事件的 data 累积（多行用 \n 连接）
    have_data: bool,
    events: usize,     // 已产出事件数（诊断/自测用）
    comments: usize,   // 已忽略的注释行数
}

export fn sse_init(r: &SseReader) void {
    r.acc = buf_new(4096);
    r.have_data = false;
    r.events = 0;
    r.comments = 0;
}

export fn sse_free(r: &SseReader) void {
    buf_free(&r.acc);
}

// 取下一个事件：
//   1 = 取到一个事件（payload 写入 out，out 会被 reset）
//   0 = 手上数据不够，调用方应先 hc_fill()
//  -1 = 流已结束且没有更多事件
export fn sse_next(st: &HcStream, r: &SseReader, out: &Buf) !i32 {
    if !buf_valid(&r.acc) {
        return error.HcOutOfMemory;
    }
    while true {
        const avail: usize = st.dec.len - st.dec_off;
        if avail == 0 {
            return -1 as i32;
        }
        const view: &[byte] = st.dec.ptr[0: st.dec.len];
        const from: usize = st.dec_off;
        const nl: isize = bufx_find_byte(view, 10, from);
        if nl < 0 {
            if avail > SSE_LINE_MAX {
                return error.HcBadResponse;
            }
            return 0 as i32;   // 这一行还没收完
        }
        const line_end: usize = nl as usize;
        var llen: usize = line_end - from;
        var val_end: usize = line_end;
        if llen > 0 && view.ptr[line_end - 1] == 13 as byte {
            llen = llen - 1;
            val_end = line_end - 1;
        }
        const line_start: usize = from;

        if llen == 0 {
            // 空行 = 事件结束
            hc_consume(st, (line_end + 1) - st.dec_off);
            if r.have_data {
                buf_reset(out);
                if !buf_append(out, r.acc.ptr, r.acc.len) {
                    return error.HcOutOfMemory;
                }
                r.acc.len = 0;
                r.have_data = false;
                r.events = r.events + 1;
                return 1 as i32;
            }
            continue;
        }

        const c0: byte = view.ptr[line_start];
        if c0 == 58 as byte {
            r.comments = r.comments + 1;
            hc_consume(st, (line_end + 1) - st.dec_off);
            continue;
        }

        // 字段名到第一个 ':'；没有 ':' 则整行是字段名、值为空
        var colon: usize = line_start;
        var has_colon: bool = false;
        while colon < val_end {
            if view.ptr[colon] == 58 as byte {
                has_colon = true;
                break;
            }
            colon = colon + 1;
        }

        if has_colon && colon - line_start == 4 {
            if view.ptr[line_start] == 100 as byte && view.ptr[line_start + 1] == 97 as byte
                && view.ptr[line_start + 2] == 116 as byte && view.ptr[line_start + 3] == 97 as byte {
                var vstart: usize = colon + 1;
                if vstart < val_end && view.ptr[vstart] == 32 as byte {
                    vstart = vstart + 1;
                }
                // 多行 data 用 \n 连接（在消费之前先把数据拷进 acc）
                if r.have_data {
                    if !buf_append_byte(&r.acc, 10) {
                        return error.HcOutOfMemory;
                    }
                }
                if val_end > vstart {
                    if !buf_append(&r.acc, &view.ptr[vstart], val_end - vstart) {
                        return error.HcOutOfMemory;
                    }
                }
                r.have_data = true;
            }
        }
        // event: / id: / retry: 等字段忽略（我们只用 data）
        hc_consume(st, (line_end + 1) - st.dec_off);
    }
}
