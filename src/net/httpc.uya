// src/net/httpc.uya — 极简 HTTP/1.1 客户端（明文 + TLS），纯 Uya
//
// 本文件：URL 解析（url_parse）、DNS 解析器发现与名字解析（hc_resolv_* / hc_dns_*，
//   P80）、TCP 连接（tcp_connect）、TLS 开壳（tls_open + 四档信任策略）、请求构造
//   （build_request）、连接读（conn_read）、整段式请求（http_request，非流式路径）、
//   leaf 指纹解析与比对、TOFU 指纹库的读写、TLS 噪声静音（tls_noise_mute）、客户身份
//   （HC_USER_AGENT，网关据此辨认客户端，P71）。
// 不变量：① 信任策略四档且**默认 tofu**（chain / pin / tofu / none，见 §18）；② leaf SHA-256
//   从 `HandshakeCtx.server_flight_msg` 自己解析，**不依赖 `cert_parse` 的 RSA 前提**；③
//   `tls_noise_mute` 把 `dup(2)` 存进 `g_err_fd`，显示层必须经 `err_fd()` 写（踩坑 30 同族）；
//   ④ 明文与 TLS 走同一条上层路径，调用方不需要分支；⑤ 系统根证书库**只有 chain 档加载**
//   （pin / tofu / none 的判据是 leaf 指纹，与 CA 库无关 —— 见踩坑 132）；⑥ **名字解析器
//   自己找**（整份读 resolv.conf，不截断），失败报 `HcDnsFailed`；连接/握手失败各报
//   `HcConnectFailed` / `HcHandshakeFailed` —— 这三条路的修法不同，不许糊成一个码（踩坑 133）。
// 依赖：libc（fcntl/heap/stdlib/syscall/unistd）、std.http.types、std.net.dns、std.string.strlen、
//   lib/tls（tls.common / crypto.sha256 / https / ssl.context / ssl.handshake / ssl.record /
//   x509.cert.Cert / x509.trust_store / x509.verify）；本仓 foundation/bufx、
//   net/tlspin 与 net/httpstream（合并命名空间，无本地 use）。
// 命名：`hc_*`（连接与请求原语）、`url_parse`/`tcp_connect`/`tls_open`/`build_request`/`conn_read`、
//   `Tls*` 常量、`http_request`。DNS 那一节：`HcResolvHit` + `hc_resolv_*`/`hc_dns_*`。
//
// 为什么不用 std.http.http1_async / tls.https：
//   1) std.http 的请求头构造器固定只发 Host/Connection/Content-Type/Content-Length，
//      无法加 Authorization；
//   2) tls.https 只导出 GET（https_get*），且单次只读一个 4096 字节 record，
//      装不下 LLM 的响应；
//   3) lib/tls 的 verify_chain_rsa 要求“服务端发来的链顶证书公钥 == 某个信任锚”
//      （真实站点不会发根证书），cert_verify_signature 也只支持 SHA-256，
//      所以这里用 leaf SHA-256 指纹钉扎（pin）作为可用的信任策略。
//
// 传输层复用 lib/tls 已导出的低层件：https_connect_fd / https_read_some /
// https_write_all / https_read_tls_record_exact / https_client_handshake /
// ssl_init / ssl_set_* / ssl_write / ssl_read / trust_store_load_system。

use libc.syscall;
use libc.unistd;
use libc.heap;
use libc.stdlib;
use libc.fcntl;
use std.net.dns;
use std.http.types;
use std.string.strlen;
use tls.common;
use tls.https;
use tls.crypto.sha256;
use tls.ssl.handshake;
use tls.ssl.context;
use tls.ssl.record;
use tls.x509.cert.Cert;
use tls.x509.trust_store;
use tls.x509.verify.KU_DIGITAL_SIGNATURE;
use tls.x509.verify.verify_chain_rsa;

// ============================================================
// 错误
// ============================================================
export error HcBadUrl;
export error HcConnectFailed;
// 名字解析失败（DNS）。**与 `HcConnectFailed` 分开**：前者的修法是去看解析器
// （resolv.conf / $UYA_AGENT_DNS），后者的修法是去看网络，糊成一个码就是把答案丢掉
// （踩坑 133：用户只看到「请求失败（网络或 TLS 校验）」，而真话是「名字没解开」）。
export error HcDnsFailed;
// TLS 握手失败（TCP 已经连上了）。同样分开：连接失败看网络，握手失败看证书/协议。
export error HcHandshakeFailed;
export error HcIoFailed;
export error HcTooLarge;
export error HcBadResponse;
export error HcOutOfMemory;
export error HcTlsUnsupported;
export error HcPinMismatch;
export error HcTimeout;
// chain 档的两条**可指路**的失败（以前一律糊成 HcTlsUnsupported，排障时指不到根因）：
export error HcTlsNoChain;      // 握手成功但 stdlib 没解析出对端证书链（真实站点的必然结果）
export error HcTlsNoAnchors;    // 机器上没有系统根证书库（chain 档才需要）
export error HcTlsNoLeaf;       // 握手成功但没从 flight 里拿到 leaf 证书（无法算指纹）
// P92：代理侧的两条失败。**与上面那些分开**是这条线的全部价值 —— 配了代理之后
// 「连不上」有三种完全不同的修法（看网络 / 看代理 / 看域名），糊成一个码就是把答案丢掉
// （踩坑 133 的同一条纪律）：
//   * `HcProxyUnavailable` = **可重试**的那一半（连不上代理、隧道应答超时、
//     CONNECT 回 502/503/504 —— 代理刚起来 / 隧道上游抖一下，正是重发能救的现场）；
//   * `HcProxyFailed` = **不可重试**的那一半（407 凭据错、403 被拒、应答畸形 ——
//     属配置面，重发一百次还是同一句）。
// 判据在 net/proxyx 的 `hpx_retryable`（一处定义，两处用：这里抛码、retryx 分类）。
export error HcProxyUnavailable;
export error HcProxyFailed;

// ============================================================
// 常量
// ============================================================
const HC_TLS_CHUNK: usize = 16384;              // RECORD_MAX_PLAIN
const HC_TLS_BUF: usize = 16896;                // > 5 + 8 + 16384 + 16
const HC_READ_CHUNK: usize = 16896;
const HC_HEAD_MAX: usize = 65536;

// 客户身份（P71）。全仓唯一一处 User-Agent，chat / responses / webx 三条路都从
// `build_request` 走这里发出去。
//
// 为什么带 `deepseek-harness`：LLM 网关（`~/ai-gateway` 的
// internal/responses/dimensions.go）用它把请求认成哪个编码 agent，而它的客户端词表是
// **封闭**的 `dsh | codex | console | unknown` —— UA 是唯一的接缝。
// 正文那条路走不通：它要求首条 system 逐字是 `You are an AI agent powered by DeepSeek
// Harness.`，而我们的 persona 是自己的文案（改成那句等于冒充 DSH，还会改模型行为）。
// 认不出客户端时 `workspace` 维度也一起丢（网关只在 dsh/codex 两个分支里取值），
// 于是控制台上本仓的工作区永远是空的 —— 这就是这个常量的全部理由。
//
// `compatible` 这个词是刻意的：我们与 DSH 同方言（会话身份两个头、`session workspace:`
// 机读句、标题提示词逐字同形，见 DESIGN §15.4），但**不是** DSH 本身。
// 41 字节，在网关 64 字节的截断线内（它只取 UA 前 64 字节做子串匹配）。
// 字面量断到下一行，只为守住 80 字符行宽（与 pm_digest 的 PM_DG_T_CONV 同款）。
const HC_USER_AGENT: &const byte =
    "uya-agent/0.1 (deepseek-harness-compatible)" as &const byte;

// --http-debug：把响应头与体首字节原始打出来（排查网关怪异响应）
export var hc_debug: bool = false;

// P92：一次出站请求走三条路里的哪一条。由 `hc_connect` 定（它同时决定连谁），
// 再交给 `build_request` 决定请求行写相对还是绝对形式 —— **判据与用法同源**，
// 不会出现「连了代理却发了相对请求」这种半对状态。
export const HC_ROUTE_DIRECT: u8 = 0;      // 直连目标（没配代理，或目标是回环）
export const HC_ROUTE_TUNNEL: u8 = 1;      // HTTPS 目标：CONNECT 打隧道，TLS 与目标谈
export const HC_ROUTE_PROXY_ABS: u8 = 2;   // HTTP 目标：连代理，请求行写绝对形式

// ============================================================
// TOFU 指纹库（HC_VERIFY_TOFU 的判据来源）
//
// 路径由 agent 层在启动时钉进来（`hc_set_tofu_path`，取 `<agent_home>/tls_pins`）——
// 传输层不认识 agent home，也不该认识。没钉过路径时 TOFU 退化成 none 的语义（见
// `tls_tofu_decide`），绝不静默假装校验过。
// ============================================================
const HC_PIN_FILE_MAX: usize = 65536;
// TOFU 判据的三态（数值本身无意义，只用来区分分支）
const TP_VERDICT_UNPINNED: i32 = 0;   // 没配指纹库：不判据（等价 none 的语义）
const TP_VERDICT_TRUSTED: i32 = 1;    // 库里有这台主机且指纹相符
const TP_VERDICT_MISMATCH: i32 = 2;   // 库里有这台主机但指纹不符
const TP_VERDICT_FRESH: i32 = 3;      // 首次见到（已记录）
// 库里有这台主机、指纹不符，但这次的新证书**过了发证机构校验**，于是追加一条并放行
// （P92「证书轮换」；开关见 hc_tofu_learn）
const TP_VERDICT_LEARNED: i32 = 4;
var hc_tofu_enabled: bool = false;
var hc_tofu_path: Buf = Buf{ ptr: null, len: 0, cap: 0 };
// 学习开关（默认开：这就是 P92 要的行为；关掉 = 逐字节回到「证书一变就拒」）
var hc_tofu_learn: bool = true;
// 发证机构校验要用的系统 CA 库（懒加载：第一次真需要时才整份读进来）
var hc_chain_bundle: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var hc_chain_bundle_tried: bool = false;

// 钉住指纹库路径（C 串，调用方保证 NUL 结尾）。空串 = 关掉记录能力。
export fn hc_set_tofu_path(path: &const byte) bool {
    buf_free(&hc_tofu_path);
    hc_tofu_enabled = false;
    if (path as usize) == 0 || bufx_cstr_len(path) == 0 {
        return false;
    }
    hc_tofu_path = buf_new(bufx_cstr_len(path) + 8);
    if !buf_append_cstr_z(&hc_tofu_path, path) {
        buf_free(&hc_tofu_path);
        return false;
    }
    hc_tofu_enabled = true;
    return true;
}

// 指纹库路径（测试与 --print-config 用）。返回内部缓冲的切片，调用方不许留存。
// 没钉过路径时返回**空切片**（len = 0，ptr 指向一个真实存在的字节）——
// 不要写 `&""[0: 0]`：那是「切片字面量取地址」，codegen 会生成
// `*((struct uya_slice_uint8_t){...})` 这类非法初始化，宿主 C 当场报 invalid initializer。
// 末尾的 NUL **不对外**：这个缓冲是 C 串（sys_open 要用），但报给人看的路径里带上那个
// 不可见字节，复制去 `cat` 会失败、逐字节比对也会红 —— 只有真看不见时才叫坑。
export fn hc_tofu_path_now() &[byte] {
    if !hc_tofu_enabled || hc_tofu_path.len == 0 {
        return hc_tofu_path.ptr[0: 0];
    }
    if hc_tofu_path.ptr[hc_tofu_path.len - 1] == (0 as byte) {
        return hc_tofu_path.ptr[0: hc_tofu_path.len - 1];
    }
    return hc_tofu_path.ptr[0: hc_tofu_path.len];
}

// 开/关「新证书过发证机构校验就学进库」（P92）。默认开。
export fn hc_set_tofu_learn(on: bool) void {
    hc_tofu_learn = on;
}

// 现在开着没有（--print-config 与自测读它）
export fn hc_tofu_learn_now() bool {
    return hc_tofu_learn;
}

// 钉住系统 CA 库的路径（C 串）。不钉 = 让 net/cachain 按 SSL_CERT_FILE 与常见位置自己找。
export fn hc_set_chain_bundle(path: &const byte) bool {
    buf_free(&hc_chain_bundle);
    hc_chain_bundle_tried = false;
    if (path as usize) == 0 || bufx_cstr_len(path) == 0 {
        return false;
    }
    hc_chain_bundle = buf_new(bufx_cstr_len(path) + 8);
    if !buf_append_cstr_z(&hc_chain_bundle, path) {
        buf_free(&hc_chain_bundle);
        return false;
    }
    return true;
}

// 系统 CA 库（整份文本）。第一次调用才读盘；读不到就返回空 Buf（此时链校验一律报
// 「拿不到可信库」，绝不静默放行）。
fn tls_tofu_bundle() &[byte] {
    if hc_chain_bundle_tried {
        return hc_chain_bundle.ptr[0: hc_chain_bundle.len];
    }
    hc_chain_bundle_tried = true;
    var path: Buf = buf_new(512);
    defer { buf_free(&path); }
    if hc_chain_bundle.len > 0 {
        // 调用方钉过路径：照它读（$UYA_AGENT_CA_BUNDLE / --ca-bundle 的落点）。
        // **必须补一个 NUL**：`cc_bundle_load` 里是 `sys_open(path as *const byte)`，
        // 吃的是 C 串语义；少了这个字节，打开的是缓冲后面那段垃圾（症状是「明明有库，
        // 却说拿不到可信库」—— 与 selftest 里拼夹具路径踩的是同一个坑）。
        if !buf_append(&path, hc_chain_bundle.ptr, hc_chain_bundle.len - 1) {
            return hc_chain_bundle.ptr[0: 0];
        }
        if !buf_append_byte(&path, 0) {
            return hc_chain_bundle.ptr[0: 0];
        }
    } else if !cc_bundle_path(&path) {
        return hc_chain_bundle.ptr[0: 0];
    }
    var loaded: Buf = buf_new(CC_BUNDLE_MAX);
    const ok: bool = cc_bundle_load(path.ptr as &const byte, &loaded);
    buf_free(&hc_chain_bundle);
    hc_chain_bundle = loaded;
    if !ok {
        buf_free(&hc_chain_bundle);
        hc_chain_bundle = buf_new(8);
    }
    return hc_chain_bundle.ptr[0: hc_chain_bundle.len];
}

// 发证机构校验：把这次握手的整条链交给 net/cachain 验一遍。返回 CC_OK / CC_FAIL /
// CC_UNSUPPORTED（-1 表示做不了：没库、算法不支持、握手缓冲截断 ⇒ 一律当「没验过」）。
fn tls_tofu_ca_check(
    c: &const TlsConn,
    host: &const byte,
    host_len: usize
) i32 {
    const b: &[byte] = tls_tofu_bundle();
    if b.len == 0 {
        // 这条原因含中文：长度是**字节**数（54），手数容易错 —— 自测里有对它的断言
        // 行宽豁免：一条不可断的报错文案（含中文），拆行反而看不出原句
        const no_ca: &const byte = "这台机器上没有可用的系统 CA 库（装 ca-certificates，或用 --ca-bundle 指定）";
        cc_set_reason(no_ca, 54);
        return CC_UNSUPPORTED;
    }
    var bundle: Buf = Buf{ ptr: b.ptr, len: b.len, cap: b.len };
    var in: CcIn = CcIn{
        flight: &c.hs.server_flight_msg[0],
        flen: c.hs.server_flight_msg_len,
        host: host,
        host_len: host_len,
        bundle: &bundle,
    };
    return cc_verify(&in);
}

// ============================================================
// 最近一次握手的 leaf 指纹（给「连接失败」的诊断用）
//
// 为什么要有这个全局：**流式路径拿不到 TlsConn**。`llm_stream_style` 里那个 TlsConn 是
// 它自己的局部变量，agent 侧的 `agent_step_stream` 里也声明了一个 `tc`，但**从来没有传给
// 它** —— 于是 `tc.observed_len` 恒为 0，错误分支永远走不到「打印指纹」那一支，用户只看到
// 一句「检查 base-url / 网络」（踩坑 132 的现场：最需要指纹的那条路上指纹被丢掉了）。
//
// 一个进程里的 TLS 连接是**串行**的（流式一次一个；自动起标题的请求排在 step 边界），
// 所以「最近一次握手观测到的 leaf」正好就是刚刚失败那一次连接的 leaf —— **前提是每次
// 尝试之前把它清零**（`hc_connect` 的第一件事就是它）。不清零时的现场（P95 用户报的）：
// 前面几个回合都成功，某个回合握手半路断了，屏幕上于是印出「目标 = 本机代理:端口」＋
// 「服务端 leaf SHA-256 = 上一个回合那台站点的证书」—— 两行自相矛盾，看图的人被指向
// 完全错的方向（会去查中间设备，而真话是代理隧道被掐断了）。
// ============================================================
var hc_leaf_buf: [byte: 64] = [0: 64];
var hc_leaf_n: usize = 0;

// 把「最近一次观测到的 leaf」种成给定值 —— **只给自测用**（与 `hc_resolv_set_path`
// 同一条分工：产品路径从不调它）。
//
// 为什么需要它：判据是「这一次没观测到，就不许留着上一次的」，而自测里要造一次**成功**
// 的 TLS 握手得先搬一台 TLS 服务端进来（本仓没有）。把「上一次的观测」直接种进来，再跑
// 一次注定失败的握手，测的正是**产品代码那一行清账**；不种而直接断言 0 是假绿 ——
// 那个 0 从初始化就是 0，删掉清账那行也照样绿（踩坑 132 的教训）。
export fn hc_note_leaf_for_test(p: &const byte, n: usize) void {
    hc_leaf_n = 0;
    if n != 64 {
        return;
    }
    var i: usize = 0;
    while i < 64 {
        hc_leaf_buf[i] = p[i];
        i = i + 1;
    }
    hc_leaf_n = 64;
}

// 记下这次握手观测到的指纹（tls_open 在算完之后调；没有 leaf 时清空）。
fn hc_record_last_leaf(c: &const TlsConn) void {
    if c.observed_len != 64 {
        hc_leaf_n = 0;
        return;
    }
    var i: usize = 0;
    while i < 64 {
        hc_leaf_buf[i] = c.observed[i];
        i = i + 1;
    }
    hc_leaf_n = 64;
}

// 最近一次握手观测到的 leaf 指纹：**指针 + 长度**两个口（没观测到时 len = 0）。
// 为什么不返回切片：`hc_last_leaf` 是定长数组 `[byte: 64]`，对它写 `arr[0: n]` 时
// codegen 会把返回的切片描述符推成 `uya_slice_int32_t`（元素类型猜错了），宿主 C 报
// invalid initializer。定长数组一律走「指针 + 长度」，别走切片。
export fn hc_last_leaf_ptr() &const byte {
    return &hc_leaf_buf[0];
}

// 最近一次握手观测到的 leaf 指纹长度（0 = 没观测到）。
export fn hc_last_leaf_len() usize {
    return hc_leaf_n;
}

// 换行也用数组字面量：`&"\n"[0: 1]` 求值是**切片描述符**的地址，sys_write 会把这
// 8 字节指针的第一个字节写出去 —— 屏幕上多一个乱码字节（与 tty.uya 里的坑同一个）。
const HC_NL: [byte: 1] = [10];

// 调试用：把 label 与 n 字节原始数据写到 fd 2，再补一个换行（仅 hc_debug 路径调用）。
fn hc_dbg(label: &const byte, p: &const byte, n: usize) void {
    _ = sys_write(2, label as *const byte, strlen(label)) catch {};
    _ = sys_write(2, p as *const byte, n) catch {};
    _ = sys_write(2, &HC_NL[0], 1) catch {};
}

// 调试用：把 label 与十进制数 v 写到 fd 2（手写转换，避免依赖 bufx 的格式化）。
fn hc_dbg_dec(label: &const byte, v: usize) void {
    const l: usize = strlen(label);
    _ = sys_write(2, label as *const byte, l) catch {};
    var tmp: [byte: 24] = [0: 24];
    var n: usize = v;
    var i: usize = 0;
    if n == 0 {
        tmp[0] = 48;
        i = 1;
    }
    while n > 0 && i < 24 {
        const d: i32 = ((n % (10 as usize)) as i32) + 48;
        tmp[i] = d as byte;
        n = n / (10 as usize);
        i = i + 1;
    }
    var rev: [byte: 24] = [0: 24];
    var k: usize = 0;
    while i > 0 {
        i = i - 1;
        rev[k] = tmp[i];
        k = k + 1;
    }
    _ = sys_write(2, &rev[0], k) catch {};
    _ = sys_write(2, &HC_NL[0], 1) catch {};
}

export const HC_VERIFY_CHAIN: i32 = 0;
export const HC_VERIFY_PIN: i32 = 1;
export const HC_VERIFY_NONE: i32 = 2;
// HC_VERIFY_TOFU = 「首次使用即信任」（Trust On First Use）：默认档。
// 三档老策略在真机上都有同一个死结 —— chain 在真实站点上**必然失败**（见 §18 与踩坑 132），
// 于是新机器（没有 DSH 设置 ⇒ 取默认档）第一次跑就是「请求失败（网络或 TLS 校验）」；
// pin 又要求人手抄一个 64 位 hex 指纹，不开箱即用。TOFU 是这两者之间唯一能默认的档：
// 第一次连某主机就把 leaf 指纹记进指纹库（pin 文件），之后每次都必须逐字节相符 ——
// 强于 none（有防护）、弱于 pin（第一次没有可比对的基准，是 TOFU 的固有代价）。
export const HC_VERIFY_TOFU: i32 = 3;

// ============================================================
// URL
// ============================================================
export struct Url {
    tls: bool,
    buf: Buf,
    host_off: usize,
    host_len: usize,
    port: u16,
    path_off: usize,
    path_len: usize,
}

// host 部分的**非 NUL 结尾**指针（长度看 Url.host_len，不要当 C 字符串用）。
export fn url_host(u: &const Url) &byte {
    return &u.buf.ptr[u.host_off];
}

// path 部分的**非 NUL 结尾**指针（长度看 Url.path_len；path 为空时指向 '\0'）。
export fn url_path(u: &const Url) &byte {
    return &u.buf.ptr[u.path_off];
}

// 一个空 Url（无 tls、空 buf、端口 0），供调用方零初始化后再喂给 url_parse。
fn url_empty() Url {
    return Url{ tls: false, buf: buf_empty(), host_off: 0, host_len: 0, port: 0, path_off: 0, path_len: 0 };
}

// 释放 Url 持有的 buf（host/path 指针都指向它，free 后即失效）。
export fn url_free(u: &Url) void {
    buf_free(&u.buf);
}

// "http://host[:port][/path]" / "https://..."
export fn url_parse(url: &[byte], out: &Url) !void {
    out.tls = false;
    out.buf = buf_new(url.len + 8);
    if !buf_valid(&out.buf) {
        return error.HcOutOfMemory;
    }
    if !buf_append(&out.buf, url.ptr, url.len) {
        return error.HcOutOfMemory;
    }
    if !buf_append_byte(&out.buf, 0) {
        return error.HcOutOfMemory;
    }
    const n: usize = url.len;
    const s: &[byte] = out.buf.ptr[0: n];
    var tls: bool = false;
    var host_start: usize = 0;
    if n >= 8 && eq_ignore_case(s[0: 8], &"https://"[0: 8]) {
        tls = true;
        host_start = 8;
    } else if n >= 7 && eq_ignore_case(s[0: 7], &"http://"[0: 7]) {
        tls = false;
        host_start = 7;
    } else {
        return error.HcBadUrl;
    }
    if host_start >= n {
        return error.HcBadUrl;
    }
    var host_end: usize = host_start;
    while host_end < n && s[host_end] != ':' as byte && s[host_end] != '/' as byte {
        host_end = host_end + 1;
    }
    if host_end == host_start {
        return error.HcBadUrl;
    }
    out.host_off = host_start;
    out.host_len = host_end - host_start;
    var port: u16 = 0;
    var path_start: usize = n;
    if host_end < n && s[host_end] == ':' as byte {
        var p: usize = host_end + 1;
        var v: i32 = 0;
        var digits: i32 = 0;
        while p < n && is_digit(s[p]) {
            const hch: i32 = s[p] as i32;
            const hv10: i32 = v *% 10;
            v = hv10 +% (hch -% 48);
            digits = digits + 1;
            p = p + 1;
        }
        if digits == 0 || v <= 0 || v > 65535 {
            return error.HcBadUrl;
        }
        port = v as u16;
        if p < n && s[p] == '/' as byte {
            path_start = p;
        }
    } else if host_end < n && s[host_end] == '/' as byte {
        path_start = host_end;
    }
    if port == 0 {
        if tls {
            port = 443;
        } else {
            port = 80;
        }
    }
    out.tls = tls;
    out.port = port;
    if path_start < n {
        out.path_off = path_start;
        out.path_len = n - path_start;
    } else {
        out.path_off = 0;
        out.path_len = 1;
        // 用首字节写 '/'（buf 里 offset 0 已被 scheme 占用，这里直接借用 0 号字节不安全，
        // 改为在末尾追加一个 '/'
        if !buf_append_byte(&out.buf, 47) {
            return error.HcOutOfMemory;
        }
        out.path_off = out.buf.len - 1;
    }
    return;
}

// ============================================================
// DNS 解析器发现（/etc/resolv.conf 与 $UYA_AGENT_DNS）
//
// 为什么本仓自己再读一遍 resolv.conf：标准库那条路（`std.net.dns` 的
// `dns_parse_resolv_conf_first_nameserver`）**只读文件的前 512 字节**，就在这 512 字节里
// 找 `nameserver`。systemd 的 stub-resolv.conf 前面是一大段说明注释：本机实测该文件
// 920 字节、`nameserver 127.0.0.53` 落在**偏移 866** —— 于是「文件里没有 nameserver」
// 被判成 `DnsNoNameserver`，名字解析当场失败（现场见 §16 踩坑 133：`uya-agent hi` 报
// 「请求失败（网络或 TLS 校验）」，而 strace 里**一次 socket 调用都没有**）。
// 静态链接下不能用 `getaddrinfo`（NSS 要 dlopen，见 §16），所以只能把这一步自己做对。
//
// 判据是**纯函数**（`hc_resolv_scan` 只吃文本，离线可测），读文件与读环境都只在
// `hc_dns_resolve` 一处；自测把路径钉到临时文件（`hc_resolv_set_path`，与
// `hc_set_tofu_path` 同一个先例），因此既不联网、也不碰真的 /etc/resolv.conf。
// ============================================================
// 解析器文件的读取上限。**整份读到 EOF 才是重点**（这就是本节的来由）；上限只防
// 「这不是 resolv.conf 而是个大文件」：撞上置 `hc_resolv_trunc` 并**说出来**，
// 绝不静默当成「文件里没有」—— 那正是踩坑 133 的形状。
const HC_RESOLV_MAX: usize = 16384;
// 解析器串（`a.b.c.d[:port]`）的容量；最长 `255.255.255.255:65535` 是 21 字节。
const HC_DNS_SERVER_MAX: usize = 64;
// 「最近一次连接目标」能记下的主机名长度（只用于显示，超了截断）。
const HC_TARGET_MAX: usize = 256;

const HC_RESOLV_PATH: &const byte = "/etc/resolv.conf" as &const byte;
// "nameserver" 的字节（配置项**区分大小写**，用逐字节比而不是大小写折叠）。
const HC_RESOLV_KW: &const byte = "nameserver" as &const byte;

// 解析器的**来源**（`hc_dns_src_now()`）。ENV / FILE 是「真找到并用了」，
// STDLIB 是「我们没找到，交给标准库自己再找一遍」，NONE 只在失败路径上短暂出现。
export const HC_DNS_FROM_NONE: i32 = 0;
export const HC_DNS_FROM_ENV: i32 = 1;
export const HC_DNS_FROM_FILE: i32 = 2;
export const HC_DNS_FROM_STDLIB: i32 = 3;

// 解析失败/只能用默认路径的**原因**（`hc_dns_err_now()`）。前六条是「找解析器」阶段的，
// 后四条是「发查询」阶段的 —— 两段的修法不同，所以不合并成一个「解析失败」。
export const HC_DNS_ERR_NONE: i32 = 0;
export const HC_DNS_ERR_NO_SERVER: i32 = 1;   // 文件里没有可用 IPv4 的 nameserver 行
export const HC_DNS_ERR_ONLY_V6: i32 = 2;     // 只配了 IPv6 的 nameserver
export const HC_DNS_ERR_TRUNC: i32 = 3;       // 文件比 HC_RESOLV_MAX 还大（读窗口外还有）
export const HC_DNS_ERR_ENV_BAD: i32 = 4;     // $UYA_AGENT_DNS 的值不像 IP[:端口]
export const HC_DNS_ERR_OPEN: i32 = 5;        // 打不开解析器文件
export const HC_DNS_ERR_NXDOMAIN: i32 = 6;    // 查询明确回了「没有这个名字」
export const HC_DNS_ERR_TIMEOUT: i32 = 7;     // 解析器不答
export const HC_DNS_ERR_SERVER: i32 = 8;      // 解析器回了错/拒绝/响应坏
export const HC_DNS_ERR_NET: i32 = 9;         // 到解析器这一跳就不通

export struct HcResolvHit {
    found: bool,
    saw_v6: bool,
    ip: [byte: 4],
}

var hc_resolv_path: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var hc_dns_override: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var hc_dns_server: Buf = Buf{ ptr: null, len: 0, cap: 0 };
var hc_dns_src_v: i32 = HC_DNS_FROM_NONE;
var hc_dns_err_v: i32 = HC_DNS_ERR_NONE;
var hc_resolv_trunc: bool = false;
var hc_target_buf: [byte: HC_TARGET_MAX] = [0: HC_TARGET_MAX];
var hc_target_n: usize = 0;
var hc_target_port: u16 = 0;
// 最近一次出站尝试走的**哪条路**（`HC_ROUTE_*`，`hc_connect` 定路由时记下）。
//
// 为什么诊断必须知道路由：走代理时 `hc_target_*` 记的是**代理自己**（`tcp_connect`
// 记的是它真连上的那个地址，而隧道那一路连的是代理），于是「目标 = 本机代理:端口」
// 这种把代理当目标的报告就出来了（P95 用户报的现场：报告里目标与前一条指纹互相矛盾）。
// 真目标在 `hpx_target_*` 里，但**只有走代理时**才有意义 —— 所以先要有路由这一档。
var hc_last_route: u8 = HC_ROUTE_DIRECT;

// 钉住解析器文件路径（C 串）。空串/null = 恢复默认 /etc/resolv.conf（也算成功）。
// 由自测用它指向 build/ 下的临时文件；产品路径从不改它。
export fn hc_resolv_set_path(path: &const byte) bool {
    buf_free(&hc_resolv_path);
    hc_resolv_path = Buf{ ptr: null, len: 0, cap: 0 };
    if (path as usize) == 0 || bufx_cstr_len(path) == 0 {
        return true;
    }
    hc_resolv_path = buf_new(bufx_cstr_len(path) + 8);
    if !buf_append_cstr_z(&hc_resolv_path, path) {
        buf_free(&hc_resolv_path);
        hc_resolv_path = Buf{ ptr: null, len: 0, cap: 0 };
        return false;
    }
    return true;
}

// 解析器文件路径（C 字符串，`sys_open` 要用；给诊断与 `--print-config` 看的是
// `hc_resolv_path_ptr/len` 那一对）。
fn hc_resolv_path_z() &const byte {
    if hc_resolv_path.len > 0 {
        return hc_resolv_path.ptr as &const byte;
    }
    return HC_RESOLV_PATH;
}

// 解析器文件路径的切片口：**指针 + 长度**两件套（不是切片 —— 同 `hc_last_leaf_*` 的理由：
// 定长数组/内部缓冲对外只给指针与长度，免得 codegen 去猜元素类型）。末尾的 NUL 不对外。
export fn hc_resolv_path_ptr() &const byte {
    if hc_resolv_path.len > 0 {
        return hc_resolv_path.ptr as &const byte;
    }
    return HC_RESOLV_PATH;
}

// 解析器文件路径的长度（不含末尾那个 NUL）。
export fn hc_resolv_path_len() usize {
    if hc_resolv_path.len > 0 {
        return hc_resolv_path.len - 1;
    }
    return bufx_cstr_len(HC_RESOLV_PATH);
}

// 钉住「用户显式指定的解析器」（C 串，`a.b.c.d[:port]`）。空 = 没指定。
// 由 agent 层在启动时读 `$UYA_AGENT_DNS` 钉进来 —— 传输层不认识环境变量，
// 与 `hc_set_tofu_path` 是同一个分工。
export fn hc_dns_set_override(z: &const byte) bool {
    buf_free(&hc_dns_override);
    hc_dns_override = Buf{ ptr: null, len: 0, cap: 0 };
    if (z as usize) == 0 || bufx_cstr_len(z) == 0 {
        return true;
    }
    hc_dns_override = buf_new(bufx_cstr_len(z) + 8);
    if !buf_append_cstr_z(&hc_dns_override, z) {
        buf_free(&hc_dns_override);
        hc_dns_override = Buf{ ptr: null, len: 0, cap: 0 };
        return false;
    }
    return true;
}

// 最近一次解析用的解析器（不含 NUL；没找到时 len = 0）。
export fn hc_dns_server_ptr() &const byte {
    return hc_dns_server.ptr as &const byte;
}

// 最近一次解析用的解析器串长度（与 `hc_dns_server_ptr` 成对）。
export fn hc_dns_server_len() usize {
    return hc_dns_server.len;
}

// 解析器的来源 / 解析失败的原因（两个都是**只读快照**，给诊断与 `--print-config`）。
// 解析器的**来源**（`HC_DNS_FROM_*`）：env / 解析器文件 / 标准库默认。
export fn hc_dns_src_now() i32 {
    return hc_dns_src_v;
}

// 最近一次解析失败的**原因**（`HC_DNS_ERR_*`），人话在 agent 侧那张表里。
export fn hc_dns_err_now() i32 {
    return hc_dns_err_v;
}

// 最近一次要连的主机名与端口（**指针 + 长度**）。
//
// 为什么要复制一份：`Url` 在 `http_request` / `llm_stream_style` 里是**局部变量**，
// `defer url_free(&u)` 在错误冒到显示层之前就把它释放了 —— 拿 Url 的指针去报错是悬空的
// （同 `hc_last_leaf_*` 的理由，见踩坑 132 ③）。超长主机名截断：它只用于显示。
fn hc_target_record(host: &const byte, host_len: usize, port: u16) void {
    var n: usize = host_len;
    if n > HC_TARGET_MAX {
        n = HC_TARGET_MAX;
    }
    hc_target_n = n;
    hc_target_port = port;
    var i: usize = 0;
    while i < n {
        hc_target_buf[i] = host[i];
        i = i + 1;
    }
}

// 最近一次连接目标的主机名（**指针 + 长度**；`hc_target_record` 记下的那份拷贝）。
export fn hc_target_host_ptr() &const byte {
    return &hc_target_buf[0];
}

// 最近一次连接目标的主机名长度。
export fn hc_target_host_len() usize {
    return hc_target_n;
}

// 最近一次连接目标的端口（诊断里 `主机:端口` 的那一半）。
export fn hc_target_port_now() u16 {
    return hc_target_port;
}

// 最近一次出站尝试走的路（`HC_ROUTE_*`）。诊断据此决定「目标」该从哪份账里取：
// 非直连时真目标在 `hpx_target_*`，`hc_target_*` 记的是代理自己（见上面那段注释）。
export fn hc_last_route_now() u8 {
    return hc_last_route;
}

// 一个字节是不是空白（空格 / 制表 / CR —— CRLF 行尾的文件也要认；'\n' 是行界，
// 不在这里，反正行内不会出现）。
fn hc_resolv_ws(c: byte) bool {
    return c == (32 as byte) || c == (9 as byte) || c == (13 as byte);
}

// 一个字节是不是注释起点（resolv.conf 的两种注释都认：`#` 与 `;`）。
fn hc_resolv_comment(c: byte) bool {
    return c == (35 as byte) || c == (59 as byte);
}

// 一个字节是不是「token 到此为止」：空白，或行内注释的起点
// （`nameserver 1.1.1.1 # 备用` 这种行要取到 IP 为止）。
fn hc_resolv_token_end(c: byte) bool {
    return hc_resolv_ws(c) || hc_resolv_comment(c);
}

// 这一行（从 p 起、到 line_end 止）是不是 `nameserver` 配置项：关键字 10 字节**逐字节**
// 相等，且**紧跟一个空白**。两个都必须判：
//   * 不做大小写折叠 —— resolv.conf 的关键字区分大小写，`NameServer` 不是配置项；
//   * 关键字后面必须真有空白 —— 单看 `starts_with("nameserver")` 会把
//     `nameserverX 9.9.9.9` 这种行也吃进来（老实现就是这么栽的）。
fn hc_resolv_kw(text: &[byte], p: usize, line_end: usize) bool {
    if line_end - p < 11 {
        return false;
    }
    var i: usize = 0;
    while i < 10 {
        if text.ptr[p + i] != HC_RESOLV_KW[i] {
            return false;
        }
        i = i + 1;
    }
    return hc_resolv_ws(text.ptr[p + 10]);
}

// 取一个 `nameserver` 的参数：能当 IPv4 就记下来，带 ':' 的当 IPv6 **记账**（但继续
// 往后找 IPv4 —— 本模块只做 IPv4 传输，v6-only 的机器要能明确报出来，而不是「没配」）。
fn hc_resolv_take_token(
    text: &[byte],
    from: usize,
    to: usize,
    hit: &HcResolvHit
) void {
    if to <= from {
        return;
    }
    const tok: &[byte] = text[from: to - from];
    var ip: [byte: 4] = [0: 4];
    if scan_ipv4(tok.ptr, tok.len, &ip[0]) {
        if !hit.found {
            hit.ip[0] = ip[0];
            hit.ip[1] = ip[1];
            hit.ip[2] = ip[2];
            hit.ip[3] = ip[3];
            hit.found = true;
        }
        return;
    }
    var i: usize = 0;
    while i < tok.len {
        if tok.ptr[i] == (58 as byte) {
            hit.saw_v6 = true;
            return;
        }
        i = i + 1;
    }
}

// 扫一遍 resolv.conf 的**全部文本**，取第一个可用 IPv4 的 `nameserver`。
//
// 每一条都是能单独变红的判据（见 selftest 的 `dns-resolv` 轮）：
//   * 允许行首空白；`#` / `;` 注释行与空行跳过 —— **注释里的
//     「nameserver 9.9.9.9」是常态**（systemd 那个文件里就有）；
//   * IPv4 必须是四段十进制（复用 `scan_ipv4`）：`999.1.1.1`、`1.2.3` 一律不算；
//   * 畸形行跳过而**不中止** —— 它后面那行好行必须还能被找到；
//   * 认 tab 分隔、CRLF 行尾、末行无换行。
export fn hc_resolv_scan(text: &[byte]) HcResolvHit {
    var hit: HcResolvHit = HcResolvHit{
        found: false, saw_v6: false, ip: [0: 4],
    };
    var i: usize = 0;
    while i < text.len {
        var line_end: usize = i;
        while line_end < text.len && text.ptr[line_end] != (10 as byte) {
            line_end = line_end + 1;
        }
        var p: usize = i;
        while p < line_end && hc_resolv_ws(text.ptr[p]) {
            p = p + 1;
        }
        // 空行（p 到行尾）与注释行都跳过
        var is_comment: bool = true;
        if p < line_end {
            is_comment = hc_resolv_comment(text.ptr[p]);
        }
        if !is_comment && hc_resolv_kw(text, p, line_end) {
            var q: usize = p + 10;
            while q < line_end && hc_resolv_ws(text.ptr[q]) {
                q = q + 1;
            }
            var e: usize = q;
            while e < line_end && !hc_resolv_token_end(text.ptr[e]) {
                e = e + 1;
            }
            hc_resolv_take_token(text, q, e, &hit);
        }
        i = line_end + 1;
    }
    return hit;
}

// 把解析器文件**整份**读进 out（循环读到 EOF，或读满 out 的容量）。
// 返回 false = 打不开/没读到字节（原因记进 hc_dns_err_v）；读满容量置 hc_resolv_trunc。
fn hc_resolv_read(out: &Buf) bool {
    hc_resolv_trunc = false;
    const pz: &const byte = hc_resolv_path_z();
    const fd: i32 = sys_open(pz as *const byte, O_RDONLY as i32, 0) catch {
        hc_dns_err_set(HC_DNS_ERR_OPEN);
        return false;
    };
    while out.len < out.cap {
        const room: usize = out.cap - out.len;
        const got: isize = sys_read(fd, &out.ptr[out.len], room) catch {
            break;
        };
        if got <= 0 {
            break;
        }
        out.len = out.len + (got as usize);
    }
    _ = sys_close(fd) catch {};
    if out.len >= out.cap {
        hc_resolv_trunc = true;
    }
    return out.len > 0;
}

// `hit` 里那四段 → 点分十进制写进 out（调用方已确认 `hit.found`）。返回 false = 分配失败。
// 参数收整个 hit 而不是四个 byte：四个 byte 的调用点会顶穿 80 列硬指标（见 §19）。
fn hc_dns_format(out: &Buf, hit: &const HcResolvHit) bool {
    if !buf_append_u64(out, hit.ip[0] as u64) {
        return false;
    }
    if !buf_append_byte(out, 46) {
        return false;
    }
    if !buf_append_u64(out, hit.ip[1] as u64) {
        return false;
    }
    if !buf_append_byte(out, 46) {
        return false;
    }
    if !buf_append_u64(out, hit.ip[2] as u64) {
        return false;
    }
    if !buf_append_byte(out, 46) {
        return false;
    }
    return buf_append_u64(out, hit.ip[3] as u64);
}

// `a.b.c.d[:port]` 是不是一个能喂给 `dns_client_init` 的解析器串。
// 端口段要么不写，要么是 1..65535 的十进制 —— 其它一律 false（调用方据此报 ENV_BAD，
// 而不是把垃圾喂下去、再以「没解析器」的形式失败）。
fn hc_dns_addr_ok(s: &[byte]) bool {
    if s.len < 7 || s.len > 21 {
        return false;
    }
    var cut: usize = s.len;
    var i: usize = 0;
    while i < s.len {
        if s.ptr[i] == (58 as byte) {
            cut = i;
            break;
        }
        i = i + 1;
    }
    const host: &[byte] = s[0: cut];
    var ip: [byte: 4] = [0: 4];
    if !scan_ipv4(host.ptr, host.len, &ip[0]) {
        return false;
    }
    if cut == s.len {
        return true;
    }
    const port: &[byte] = s[cut + 1: s.len - (cut + 1)];
    if port.len == 0 || port.len > 5 {
        return false;
    }
    var v: usize = 0;
    var k: usize = 0;
    while k < port.len {
        const ch: byte = port.ptr[k];
        if !is_digit(ch) {
            return false;
        }
        v = v * 10 + ((ch as usize) - 48);
        k = k + 1;
    }
    return v >= 1 && v <= 65535;
}

// 原因的**优先级**（只有一个坑位，一趟解析里可能撞上好几条，一次只能报一条；
// 数值大者保留）：
//   * `$UYA_AGENT_DNS` 的值非法最优先 —— 那是用户**刚写下的东西**，与别的原因叠加时
//     必须被看见，否则整趟排查都在修另一个问题；
//   * 其次是「我们没拿到解析器」那四条细节（打不开 > 截断 > 只有 v6 > 没配）：它们的
//     修法各不相同，而查询阶段的原因多半只是它们的**后果**（没有解析器 ⇒ 标准库那条路
//     也找不到 ⇒ 报「没找到解析器」，那句话反而指不到真正该改的地方）；
//   * 查询阶段的原因（no-such-name / 超时 / 拒绝 / 不可达）排最后：它们只在**真拿到
//     解析器并问了**之后才出现，那时前面四条根本不成立。
//
// 这条优先级是**对照实验逼出来的**：把「整份读」退回 512 字节（见 §19 的对照①）时，
// 断言红在「原因被后面的 TRUNC 覆盖」上 —— 判据没变，是产品的记账顺序错了。
fn hc_dns_err_rank(err: i32) i32 {
    if err == HC_DNS_ERR_ENV_BAD {
        return 6;
    }
    if err == HC_DNS_ERR_OPEN {
        return 5;
    }
    if err == HC_DNS_ERR_TRUNC {
        return 4;
    }
    if err == HC_DNS_ERR_ONLY_V6 {
        return 3;
    }
    if err == HC_DNS_ERR_NO_SERVER {
        return 2;
    }
    return 1;   // 查询阶段那四条
}

// 记一条原因：优先级见 `hc_dns_err_rank`，同级后到者覆盖（同级里后写的更接近现场）。
fn hc_dns_err_set(err: i32) void {
    if hc_dns_err_v == HC_DNS_ERR_NONE {
        hc_dns_err_v = err;
        return;
    }
    if hc_dns_err_rank(err) >= hc_dns_err_rank(hc_dns_err_v) {
        hc_dns_err_v = err;
    }
}

// 选一个解析器写进 res_out（不含 NUL 的 `a.b.c.d[:port]`）。返回 true = 有一个显式的
// 解析器可以喂给 `dns_client_init`；false = 没有（res_out 空 ⇒ 调用方走标准库的默认路径
// —— 我们只是**多**找一遍，不抢它的活，找不到时的行为与没有本节时逐字节相同）。
//
// 优先级：`$UYA_AGENT_DNS`（用户显式指定）> 解析器文件里的第一个 IPv4 > 标准库默认。
// 无论走哪条，都把「来源」与「原因」记进 hc_dns_src_v / hc_dns_err_v —— 这两笔账是失败时
// 那句人话的全部依据（四种原因共用一个错误码，就是踩坑 133 里答案被丢掉的机制）。
export fn hc_dns_resolve(res_out: &Buf) bool {
    buf_reset(res_out);
    buf_reset(&hc_dns_server);
    hc_dns_src_v = HC_DNS_FROM_NONE;
    hc_dns_err_v = HC_DNS_ERR_NONE;
    // ① 显式指定：值非法就记一笔（**不静默**），但继续往下找（下一个来源可能可用）
    if hc_dns_override.len > 0 {
        const ov: &[byte] = hc_dns_override.ptr[0: hc_dns_override.len - 1];
        if hc_dns_addr_ok(ov) {
            if !buf_append(res_out, ov.ptr, ov.len) {
                hc_dns_err_v = HC_DNS_ERR_SERVER;
                return false;
            }
            _ = buf_append(&hc_dns_server, ov.ptr, ov.len);
            hc_dns_src_v = HC_DNS_FROM_ENV;
            return true;
        }
        hc_dns_err_v = HC_DNS_ERR_ENV_BAD;
    }
    // ② 解析器文件：整份读，按行扫（**不截断**，见 HC_RESOLV_MAX）
    var text: Buf = buf_new(HC_RESOLV_MAX);
    defer { buf_free(&text); }
    if buf_valid(&text) && hc_resolv_read(&text) {
        const hit: HcResolvHit = hc_resolv_scan(text.ptr[0: text.len]);
        if hit.found {
            if !hc_dns_format(res_out, &hit) {
                hc_dns_err_v = HC_DNS_ERR_SERVER;
                return false;
            }
            _ = buf_append(&hc_dns_server, res_out.ptr, res_out.len);
            hc_dns_src_v = HC_DNS_FROM_FILE;
            return true;
        }
        // 读到了、但里面没有可用 IPv4：三种情况分开报（修法各不相同）
        if hc_resolv_trunc {
            hc_dns_err_set(HC_DNS_ERR_TRUNC);
        } else if hit.saw_v6 {
            hc_dns_err_set(HC_DNS_ERR_ONLY_V6);
        } else {
            hc_dns_err_set(HC_DNS_ERR_NO_SERVER);
        }
    }
    // ③ 都没有：交给标准库自己再找一遍（找不到就还是老样子，我们不假装找到过）
    hc_dns_src_v = HC_DNS_FROM_STDLIB;
    hc_dns_err_set(HC_DNS_ERR_NO_SERVER);
    return false;
}

// 把 `std.net.dns` 的查询失败翻译成「给用户看的」原因（诊断句要用它）。
fn hc_dns_err_from_query(eid: i32) void {
    if eid == @error_id(error.DnsNoSuchName) {
        hc_dns_err_set(HC_DNS_ERR_NXDOMAIN);
    } else if eid == @error_id(error.DnsTimeout) {
        hc_dns_err_set(HC_DNS_ERR_TIMEOUT);
    } else if eid == @error_id(error.DnsNetworkUnreachable) {
        hc_dns_err_set(HC_DNS_ERR_NET);
    } else if eid == @error_id(error.DnsNoNameserver) {
        hc_dns_err_set(HC_DNS_ERR_NO_SERVER);
    } else if eid == @error_id(error.DnsInvalidName) {
        hc_dns_err_set(HC_DNS_ERR_NXDOMAIN);
    } else {
        hc_dns_err_set(HC_DNS_ERR_SERVER);
    }
}

// 发一次 A 查询（`ip` 收 4 字节地址、`ip_len` 收长度）。失败**一律** `HcDnsFailed`，
// 原因记进 hc_dns_err_v（诊断那句话的依据）。单开一个函数只是为了行宽与「两跳各管一段」。
fn hc_dns_query_a(
    ctx: &DnsClient,
    host: &const byte,
    host_len: usize,
    ip: &byte,
    ip_len: &usize
) !void {
    const q: !usize =
        dns_client_resolve_first_ipv4(ctx, host, host_len, ip, 4, ip_len);
    const n: usize = q catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        hc_dns_err_from_query(eid);
        return error.HcDnsFailed;
    };
    if n != 4 || ip_len[0] != 4 {
        hc_dns_err_set(HC_DNS_ERR_NXDOMAIN);
        return error.HcDnsFailed;
    }
}

// 名字 → sockaddr：先向 `hc_dns_resolve` 要一个解析器，再让 std.net.dns 发一下查询。
// 失败**一律** `HcDnsFailed`，原因记进 hc_dns_err_v（诊断那句话的依据）。
fn hc_resolve_sockaddr(
    host: &const byte,
    host_len: usize,
    port: u16,
    timeout_ms: u32,
    addr: &byte
) !void {
    var resolver: Buf = buf_new(HC_DNS_SERVER_MAX);
    defer { buf_free(&resolver); }
    const explicit: bool = hc_dns_resolve(&resolver);
    var dns_ctx: DnsClient = DnsClient{
        nameserver: [0: 16],
        nameserver_len: 0,
        nameserver_port: 53,
        timeout_ms: 5000,
        query_id: 0,
        prefer_family: 0,
    };
    // 没找到解析器时喂一个**空切片**：`dns_client_init` 于是不动 nameserver，
    // 查询时走它自己的默认路径（与没有本节时的行为一致）。
    var empty_resolver: [byte: 0] = [];
    if explicit {
        dns_client_init(&dns_ctx, resolver.ptr[0: resolver.len]);
    } else {
        dns_client_init(&dns_ctx, &empty_resolver[0: 0]);
    }
    var timeout_for_dns: u32 = 5000;
    if timeout_ms > 0 && timeout_ms < timeout_for_dns {
        timeout_for_dns = timeout_ms;
    }
    dns_client_set_timeout_ms(&dns_ctx, timeout_for_dns);
    var ipv4: [byte: 4] = [0: 4];
    var ipv4_len: usize = 0;
    hc_dns_query_a(&dns_ctx, host, host_len, &ipv4[0], &ipv4_len) catch {
        return error.HcDnsFailed;
    };
    fill_sockaddr_ipv4(ipv4[0], ipv4[1], ipv4[2], ipv4[3], port, addr);
}

// 名字 → sockaddr 的**唯一**出口（localhost 直连 / 点分四段直填 / 否则走解析器）。
// 同步与 async 两条连接路径共用它：判据只有一份，`hc_target_record` 的诊断记账
// 也跟着只有一次（失败报告里「目标 = …」那一行就是这份账）。
// `out_len` 写 16（IPv4 sockaddr 的定长）。
export fn hc_addr_into(
    host: &const byte,
    host_len: usize,
    port: u16,
    timeout_ms: u32,
    out: &byte,
    out_len: &u32
) !void {
    out_len[0] = 16;
    var ip: [byte: 4] = [0: 4];
    var is_localhost: bool = false;
    hc_target_record(host, host_len, port);
    if host_len == 9 && eq_ignore_case(host[0: 9], &"localhost"[0: 9]) {
        is_localhost = true;
    }
    if is_localhost {
        fill_sockaddr_ipv4(127, 0, 0, 1, port, out);
        return;
    }
    if scan_ipv4(host, host_len, &ip[0]) {
        fill_sockaddr_ipv4(ip[0], ip[1], ip[2], ip[3], port, out);
        return;
    }
    try hc_resolve_sockaddr(host, host_len, port, timeout_ms, out);
}

// ============================================================
// TCP
// ============================================================
fn fill_sockaddr_ipv4(a: byte, b: byte, c: byte, d: byte, port: u16, out: &byte) void {
    var i: usize = 0;
    while i < 16 {
        out[i] = 0;
        i = i + 1;
    }
    out[0] = 2;  // AF_INET (小端 u16 = 2)
    out[1] = 0;
    // 端口按大端写入
    const pnet: u16 = ((port & (0xFF as u16)) << (8 as i32)) | (port >> (8 as i32));
    out[2] = ((pnet & (255 as u16)) as byte);
    out[3] = (((pnet >> 8) & (255 as u16)) as byte);
    out[4] = a;
    out[5] = b;
    out[6] = c;
    out[7] = d;
}

// 把 "a.b.c.d" 形式的明文 IPv4 解析成 out[0..4]（四段各 0–255）；
// 段数不是 4、有非数字字符或任一段 > 255 都返回 false。
fn scan_ipv4(s: &const byte, n: usize, out: &byte) bool {
    var idx: usize = 0;
    var part: i32 = 0;
    var digits: i32 = 0;
    var i: usize = 0;
    while i < n {
        const ch: byte = s[i];
        if is_digit(ch) {
            part = part * 10 + ((ch as i32) - 48);
            if part > 255 {
                return false;
            }
            digits = digits + 1;
        } else if ch == '.' as byte {
            if digits == 0 || idx >= 3 {
                return false;
            }
            out[idx] = part as byte;
            idx = idx + 1;
            part = 0;
            digits = 0;
        } else {
            return false;
        }
        i = i + 1;
    }
    if digits == 0 || idx != 3 {
        return false;
    }
    out[3] = part as byte;
    return true;
}

// 设置 socket 超时（SO_RCVTIMEO / SO_SNDTIMEO）：手工按 16 字节 timeval 布局
// （前 8 字节秒、后 8 字节微秒，小端），因为不能依赖 libc 的 struct timeval 定义。
fn set_sock_timeout(fd: i32, opt: i32, timeout_ms: u32) void {
    var tv: [byte: 16] = [0: 16];
    const sec: i64 = (timeout_ms as i64) / (1000 as i64);
    const usec: i64 = ((timeout_ms as i64) % (1000 as i64)) * (1000 as i64);
    var i: usize = 0;
    while i < 8 {
        const sh: i32 = (i as i32) * 8;
        tv[i] = (((sec >> sh) & (0xFF as i64)) as byte);
        i = i + 1;
    }
    i = 0;
    while i < 8 {
        const sh2: i32 = (i as i32) * 8;
        tv[8 + i] = (((usec >> sh2) & (0xFF as i64)) as byte);
        i = i + 1;
    }
    _ = sys_setsockopt(fd, SOL_SOCKET, opt, &tv[0] as &void, 16 as u32) catch {};
}

// 给一个已经建好的 fd 打上收发超时（同步连接与 async 连接共用这一份）。
// async 路径自己 `sys_socket` 出来的 fd 没有超时，而 TLS 握手在两条路上都是**阻塞**的：
// 漏了这一步，握手就会一直挂着（`--timeout-ms` 等于没写）。
export fn hc_set_rw_timeout(fd: i32, timeout_ms: u32) void {
    if timeout_ms == 0 {
        return;
    }
    set_sock_timeout(fd, SO_RCVTIMEO, timeout_ms);
    set_sock_timeout(fd, SO_SNDTIMEO, timeout_ms);
}

// DNS + TCP 一步到位：`localhost` 硬编码 127.0.0.1，能 scan_ipv4 就直连，否则先由
// `hc_dns_resolve` 找解析器（P80：整份读 resolv.conf，见本节上面那一节）再走 std.net.dns。
// timeout_ms > 0 时同时设读写超时。
// **名字解析失败返回 `HcDnsFailed`**，socket/connect 失败才是 `HcConnectFailed` ——
// 这两条路的修法不同（看解析器 vs 看网络），共用一个码就是把答案丢掉（踩坑 133）。
export fn tcp_connect(host: &const byte, host_len: usize, port: u16, timeout_ms: u32) !i32 {
    var addr: [byte: 16] = [0: 16];
    var alen: u32 = 16;
    try hc_addr_into(host, host_len, port, timeout_ms, &addr[0], &alen);
    const fd: i32 = sys_socket(AF_INET, SOCK_STREAM, IPPROTO_TCP) catch {
        return error.HcConnectFailed;
    };
    if timeout_ms > 0 {
        hc_set_rw_timeout(fd, timeout_ms);
    }
    https_connect_fd(fd, &addr[0], 16 as u32) catch {
        _ = sys_close(fd) catch {};
        return error.HcConnectFailed;
    };
    return fd;
}

// ============================================================
// P92：出站代理（路由 + CONNECT 隧道）
//
// 分工：**取值解析、状态、失败分类、报文拼装都在 net/proxyx**（那边零 I/O、离线可测），
// 这一节只做「谁去连、连谁」以及隧道那一次真实的读写。为什么不把隧道也放进 proxyx：
// 它要 `tcp_connect`（名字解析在这里）与 `tui_active()`（泵点在这里），搬过去只会
// 把 proxyx 从纯数据变换变成又一个传输层，失掉「离线可测」这条。
//
// 三条路（`HC_ROUTE_*`）：
//   * 没配代理，或目标是回环（`hpx_bypass`）⇒ `DIRECT`，与从前逐字节相同；
//   * HTTPS 目标 ⇒ `TUNNEL`：先连代理、`CONNECT host:port` 打成隧道，之后的 TLS
//     握手仍是**与目标主机**谈 —— SNI / leaf 指纹 / TOFU / pin 判据一个字不变。
//     这是「代理只搬字节、不参与信任」这条不变量的落点：隧道那一段是明文，但里面跑的
//     TLS 是端到端的，代理看不到明文（要看得见就得用户自己换 MITM 证书，那时 pin/tofu
//     会如实报指纹不符 —— 这正是我们要的行为）。
//   * HTTP 目标 ⇒ `PROXY_ABS`：连代理，请求行写**绝对形式**（见 `build_request`）。
// ============================================================

// 连代理并打通一条到 `host:port` 的隧道，返回可用于 TLS 握手的 fd。
//
// 失败分两档（判据在 `hpx_retryable`，一处定义）：可重试的抛 `HcProxyUnavailable`，
// 其余抛 `HcProxyFailed`。**两种情况都会记账**（`hpx_note_fail`），显示层据此说人话。
fn hc_proxy_tunnel(host: &const byte, host_len: usize, port: u16,
    timeout_ms: u32) !i32 {
    hpx_note_target(host, host_len, port);
    const fd: i32 = tcp_connect(hpx_host_ptr(), hpx_host_len(), hpx_port(),
        timeout_ms) catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        if eid == @error_id(error.HcDnsFailed) {
            return error.HcDnsFailed;   // 代理主机名没解开：还是「看解析器」那条路
        }
        hpx_note_fail(HPX_E_DIAL, 0);
        return error.HcProxyUnavailable;
    };
    var req: Buf = buf_new(512);
    defer { buf_free(&req); }
    if !buf_valid(&req) || !hpx_connect_head(&req, host, host_len, port) {
        _ = sys_close(fd) catch {};
        hpx_note_fail(HPX_E_BADRESP, 0);
        return error.HcProxyFailed;
    }
    https_write_all(fd, req.ptr as &const byte, req.len) catch {
        _ = sys_close(fd) catch {};
        hpx_note_fail(HPX_E_TIMEOUT, 0);
        return error.HcProxyUnavailable;
    };
    const st: i32 = hc_tunnel_read_head(fd, timeout_ms);
    if st == 0 {
        _ = sys_close(fd) catch {};
        const e: i32 = hpx_err_now();
        if hpx_retryable(e, 0) {
            return error.HcProxyUnavailable;
        }
        return error.HcProxyFailed;
    }
    if st != 200 {
        _ = sys_close(fd) catch {};
        hpx_note_fail(HPX_E_STATUS, st);
        if hpx_retryable(HPX_E_STATUS, st) {
            return error.HcProxyUnavailable;
        }
        return error.HcProxyFailed;
    }
    hpx_note_ok();
    return fd;
}

// 读 CONNECT 的应答头，返回状态码（0 = 失败，原因已由 hpx_note_fail 记账）。
//
// 「读完之后 rx 里还剩字节」= 代理在隧道建立之后又发了数据。这种情形**当失败**处理：
// 那些字节属于隧道，丢掉它们会让随后的 TLS 握手中途错位（症状是「握手失败」，
// 而真话是代理乱发东西）—— 报错比静默吃掉强。
fn hc_tunnel_read_head(fd: i32, timeout_ms: u32) i32 {
    var rx: Buf = buf_new(1024);
    defer { buf_free(&rx); }
    if !buf_valid(&rx) {
        hpx_note_fail(HPX_E_BADRESP, 0);
        return 0;
    }
    var tmp: [byte: 1024] = [0: 1024];
    const t0: u64 = ua_now_ms();
    var head_end: usize = 0;
    while true {
        const view: &[byte] = rx.ptr[0: rx.len];
        const he: isize = find_sub(view, &"\r\n\r\n"[0: 4], 0);
        if he >= 0 {
            head_end = (he as usize) + 4;
            break;
        }
        if rx.len > HPX_HEAD_MAX {
            hpx_note_fail(HPX_E_BADRESP, 0);
            return 0;
        }
        // 与 httpc 的其它读循环同一套：TUI 里 poll(≤50ms) + 泵点，非 TUI 阻塞读。
        if tui_active() {
            var pfds: [PollFd: 1] =
                [PollFd{ fd: fd, events: POLLIN, revents: 0 }];
            const pr: i32 = sys_poll(&pfds[0], 1, 50) catch { 0; };
            if pr <= 0 {
                if timeout_ms > 0 && (ua_now_ms() - t0) >= (timeout_ms as u64) {
                    hpx_note_fail(HPX_E_TIMEOUT, 0);
                    return 0;
                }
                agent_pump_light();
                continue;
            }
        }
        const n: usize = https_read_some(fd, &tmp[0], 1024) catch {
            hpx_note_fail(HPX_E_BADRESP, 0);
            return 0;
        };
        if n == 0 {
            hpx_note_fail(HPX_E_BADRESP, 0);   // 头都没读完就断了
            return 0;
        }
        if !buf_append(&rx, &tmp[0], n) {
            hpx_note_fail(HPX_E_BADRESP, 0);
            return 0;
        }
    }
    if rx.len != head_end {
        hpx_note_fail(HPX_E_BADRESP, 0);
        return 0;
    }
    const st: i32 = hpx_head_status(rx.ptr[0: head_end], head_end);
    if st == 0 {
        hpx_note_fail(HPX_E_BADRESP, 0);
    }
    return st;
}

// 一次出站请求落在哪条路上（**不连接**，纯判据）。
// 与 `hc_connect` 共用它 —— 于是 `--probe` 印出来的路由与真跑的那条**同源**，
// 不会出现「探测说走隧道、实际直连」这种只有真机才暴露的分叉。
export fn hc_route_for(u: &const Url) u8 {
    if !hpx_active() || hpx_bypass(url_host(u), u.host_len) {
        return HC_ROUTE_DIRECT;
    }
    if u.tls {
        return HC_ROUTE_TUNNEL;
    }
    return HC_ROUTE_PROXY_ABS;
}

// 路由名（诊断/`--probe` 用）。
export fn hc_route_name(route: u8) &const byte {
    if route == HC_ROUTE_TUNNEL {
        return "CONNECT tunnel" as &const byte;
    }
    if route == HC_ROUTE_PROXY_ABS {
        return "absolute-form" as &const byte;
    }
    return "direct" as &const byte;
}

// 从 URL 文本直接问路由（`--probe` 手上只有一串 URL）。解析失败按直连报 ——
// 那种情况下 `http_request` 会在更早的地方以 `HcBadUrl` 停下，这里不必再抢答。
export fn hc_route_for_url(url: &[byte]) u8 {
    var u: Url = url_empty();
    const pr: !void = url_parse(url, &u);
    _ = pr catch {
        return HC_ROUTE_DIRECT;
    };
    const r: u8 = hc_route_for(&u);
    url_free(&u);
    return r;
}

// 一次出站连接：定路由（写进 route）、必要时先打隧道，返回可用的 fd。
// 这是 `http_request` 与 `httpstream` 两条路**共用**的唯一入口 —— 代理要不要起作用，
// 只看它，不看调用方（调用方只负责把 route 传给 build_request）。
//
// 这里还做两件**诊断记账**的事（每次尝试都从这里开始，所以放在这里最合适）：
//   ① 把观测账清零（`hc_leaf_n`）—— 失败报告只许印**这一次**看到的证书指纹；
//   ② 记下这一次走的路由（`hc_last_route`）—— 报告据此决定「目标」从哪份账里取。
// 少了任何一条，报告就会出现「目标写代理、指纹写上一个站点」这种自相矛盾的两行
// （P95 用户报的现场，见文件上面 `hc_last_route` 那段）。
// 一次尝试开始的**诊断记账**：清掉上一次的 leaf 观测账、记下这一次走的路由。
// 同步连接（`hc_connect`）与 async 连接（`net/ahttp` 的 `ahc_connect`）都调它 ——
// 少一条，失败报告就会出现「目标写代理、指纹写上一个站点」这种自相矛盾（P95）。
export fn hc_note_route(route: u8) void {
    hc_last_route = route;
    hc_leaf_n = 0;
}

// 一次出站连接（同步版）：定路由 → 直连 / 打隧道 / 连代理，返回可用 fd。
// 上面的注释（诊断记账 / 路由三态）讲的就是它；async 那条路在 `net/ahttp`
// 的 `ahc_connect`，两条都从 `hc_note_route` 开始记同一份账。
export fn hc_connect(u: &const Url, timeout_ms: u32, route: &u8) !i32 {
    route[0] = hc_route_for(u);
    hc_note_route(route[0]);
    if route[0] == HC_ROUTE_DIRECT {
        return tcp_connect(url_host(u), u.host_len, u.port, timeout_ms);
    }
    if route[0] == HC_ROUTE_TUNNEL {
        return hc_proxy_tunnel(url_host(u), u.host_len, u.port, timeout_ms);
    }
    hpx_note_target(url_host(u), u.host_len, u.port);
    const fd: i32 = tcp_connect(hpx_host_ptr(), hpx_host_len(), hpx_port(),
        timeout_ms) catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        if eid == @error_id(error.HcDnsFailed) {
            return error.HcDnsFailed;
        }
        hpx_note_fail(HPX_E_DIAL, 0);
        return error.HcProxyUnavailable;
    };
    hpx_note_ok();
    return fd;
}

// ============================================================
// TLS 会话
// ============================================================
export struct TlsConn {
    fd: i32,
    hs: &HandshakeCtx,
    rec: &RecordCtx,
    ctx: &SslContext,
    ts: &TrustStore,
    leaf_der: &byte,
    leaf_der_len: usize,
    observed: [byte: 64],
    observed_len: usize,
    verified: bool,
    anchors_ready: bool,     // 信任锚是否真的加载过（只有 chain 档需要）
    host: &const byte,       // 这次连接的主机（TOFU 记账用；非 NUL 结尾）
    host_len: usize,
}

// 一个空 TlsConn（fd = -1、四个上下文指针为 null、verified = false）。
export fn tls_conn_empty() TlsConn {
    return TlsConn{
        fd: -1,
        hs: null as &HandshakeCtx,
        rec: null as &RecordCtx,
        ctx: null as &SslContext,
        ts: null as &TrustStore,
        leaf_der: null,
        leaf_der_len: 0,
        observed: [0: 64],
        observed_len: 0,
        verified: false,
        anchors_ready: false,
        host: null,
        host_len: 0,
    };
}

// 从 server_flight 里取出 leaf 证书 DER。
// 注意：HandshakeCtx.server_flight_msg 存的是「握手消息流」——
// 每条消息是 类型(1) + 长度(3, 大端) + 内容，不含 TLS record 头。
fn tls_capture_leaf(c: &TlsConn) void {
    c.leaf_der = null;
    c.leaf_der_len = 0;
    const data_len: usize = c.hs.server_flight_msg_len;
    if data_len < 4 {
        return;
    }
    const data: &[byte] = c.hs.server_flight_msg[0: data_len];
    var mp: usize = 0;
    while mp + 4 <= data_len {
        const mtype: byte = data.ptr[mp];
        const mlen: usize = ((data.ptr[mp + 1] as usize) << (16 as i32)) | ((data.ptr[mp + 2] as usize) << (8 as i32)) | (data.ptr[mp + 3] as usize);
        if mp + 4 + mlen > data_len {
            return;
        }
        if mtype == (11 as byte) && mlen >= 6 {
            // Certificate: 3 字节列表长度，然后 3 字节证书长度 + DER
            const list_len: usize = ((data.ptr[mp + 4] as usize) << (16 as i32)) | ((data.ptr[mp + 5] as usize) << (8 as i32)) | (data.ptr[mp + 6] as usize);
            if list_len >= 3 && mp + 7 + list_len <= mp + 4 + mlen {
                const cert_len: usize = ((data.ptr[mp + 7] as usize) << (16 as i32)) | ((data.ptr[mp + 8] as usize) << (8 as i32)) | (data.ptr[mp + 9] as usize);
                if cert_len > 0 && mp + 10 + cert_len <= mp + 7 + list_len {
                    c.leaf_der = &data.ptr[mp + 10];
                    c.leaf_der_len = cert_len;
                }
            }
            return;
        }
        mp = mp + 4 + mlen;
    }
}

// 由 leaf 证书 DER 算出 SHA-256 的 64 字符小写 hex 指纹，存进 c.observed。
// 没有 leaf 时 observed_len 置 0（后续 tls_pin_matches 必然失败）。
fn tls_compute_observed(c: &TlsConn) void {
    c.observed_len = 0;
    if (c.leaf_der as usize) == 0 || c.leaf_der_len == 0 {
        return;
    }
    var digest: [byte: 32] = [0: 32];
    sha256(c.leaf_der as &const byte, c.leaf_der_len, &digest[0]);
    c.observed_len = hex_of(&digest[0], 32, &c.observed[0]);
}

// 配置的 pin 与实测指纹是否一致：pin 长度必须正好 64（SHA-256 的 hex 长度），
// 比较时两侧都做 ASCII 小写折叠；长度不符直接 false。
fn tls_pin_matches(c: &TlsConn, pin: &[byte]) bool {
    if pin.len != 64 || c.observed_len != 64 {
        return false;
    }
    var i: usize = 0;
    while i < 64 {
        if byte_lower(pin.ptr[i]) != c.observed[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// verify: HC_VERIFY_CHAIN / HC_VERIFY_PIN / HC_VERIFY_NONE
// 在已连通的 fd（c.fd）上跑 TLS 握手并按 verify 档位判定信任：
//   HC_VERIFY_CHAIN 走 stdlib 链校验（要求服务端发根证书，**真实站点上必然失败** → `HcTlsUnsupported`）
//   HC_VERIFY_PIN   比对 leaf SHA-256 指纹（不匹配 `HcPinMismatch`）
//   HC_VERIFY_TOFU  首次见到某主机则记录其 leaf 指纹，之后必须逐字节相符（不匹配 `HcPinMismatch`）
//   HC_VERIFY_NONE  不校验
// 分配的 4 个上下文一律交给 tls_conn_free 释放；成功时 c.verified 记录是否真的校验过。
export fn tls_open(c: &TlsConn, host: &const byte, host_len: usize, verify: i32, pin: &[byte]) !void {
    const hs: &HandshakeCtx = malloc(@size_of(HandshakeCtx)) as &HandshakeCtx;
    if (hs as usize) == 0 {
        return error.HcOutOfMemory;
    }
    hs[0] = HandshakeCtx{};
    const rec: &RecordCtx = malloc(@size_of(RecordCtx)) as &RecordCtx;
    if (rec as usize) == 0 {
        return error.HcOutOfMemory;
    }
    rec[0] = RecordCtx{};
    const ctx: &SslContext = malloc(@size_of(SslContext)) as &SslContext;
    if (ctx as usize) == 0 {
        return error.HcOutOfMemory;
    }
    ctx[0] = SslContext{ role: HS_ROLE_CLIENT, hs: hs, rec: rec };
    const ts: &TrustStore = malloc(@size_of(TrustStore)) as &TrustStore;
    if (ts as usize) == 0 {
        return error.HcOutOfMemory;
    }
    ts[0] = TrustStore{};
    c.hs = hs;
    c.rec = rec;
    c.ctx = ctx;
    c.ts = ts;
    ssl_init(ctx);
    // 链校验由本模块自己做（stdlib 的策略在真实站点上不适用），所以先关掉它的校验；
    // 它仍会把服务端 flight 里的证书链解析到 ctx.peer_leaf/peer_chain。
    ssl_set_insecure_skip_verify(ctx, true);
    ssl_set_skip_hostname_verify(ctx, true);
    // 信任锚**只有 chain 档需要**。pin / none / tofu 三档一律按 leaf 指纹判定，加载根证书
    // 会在「机器上没有 CA 库」时把这三档一起拖死（实测：把 /etc/ssl 挂空之后，pin 档拿着
    // **正确**的指纹也报 HcTlsUnsupported）—— 这是把「指甲的判据」绑在「体检报告」上。
    c.anchors_ready = false;
    if verify == HC_VERIFY_CHAIN {
        if !trust_store_load_system(ts) {
            return error.HcTlsNoAnchors;
        }
        ssl_set_peer_chain(
            ctx,
            null as &const Cert,
            null as &const Cert,
            0,
            trust_store_get_certs(ts),
            trust_store_get_count(ts),
            KU_DIGITAL_SIGNATURE
        );
        c.anchors_ready = true;
    }
    ssl_set_hostname(ctx, host, host_len);
    ssl_set_peer_identity(ctx, host, host_len, host, host_len);
    // 握手失败**不再**糊成 `HcConnectFailed`：这一步能走到说明 TCP 已经连上了，
    // 于是「连不上」与「握手谈崩」是两条不同的修法（看网络 vs 看证书/协议），
    // 报同一个码等于让人去查错的那一半（踩坑 133）。
    https_client_handshake(c.fd, ctx) catch {
        return error.HcHandshakeFailed;
    };
    tls_capture_leaf(c);
    tls_compute_observed(c);
    hc_record_last_leaf(c);
    c.host = host;
    c.host_len = host_len;
    c.verified = false;
    if verify == HC_VERIFY_NONE {
        return;
    }
    // 没有 leaf 就什么都没有可信的 —— 三档都必须在这里挡住（以前 pin 档靠
    // `tls_pin_matches` 里长度比对顺带挡住，但现在要在错误信息里说清「是没拿到证书」，
    // 分开报比让上层猜更有用）。
    if c.observed_len != 64 {
        return error.HcTlsNoLeaf;
    }
    if verify == HC_VERIFY_PIN {
        if !tls_pin_matches(c, pin) {
            return error.HcPinMismatch;
        }
        c.verified = true;
        return;
    }
    if verify == HC_VERIFY_TOFU {
        return tls_tofu_decide(c, host, host_len);
    }
    // HC_VERIFY_CHAIN：用 stdlib 的链校验（要求服务端把根证书一并发来）
    tls_chain_verify(c) catch |err| {
        return err;
    };
    c.verified = true;
    return;
}

// TOFU 的判定与落盘：库里有这台主机 …
//   * 指纹相符 ⇒ 通过（verified = true）；
//   * 指纹不符 ⇒ 先做**发证机构校验**（P92）：过了就把这次的新指纹追加进库并放行
//     （LEARNED），没过才是 `HcPinMismatch`（**注意这是真的变了**，与「首次见到」是两回事）；
//   * 没有这台主机 ⇒ 记下这一条再放行（verified = false：本次没有任何**先验**可比对，
//     如实记账，别把「首次」算成「验过」）。
//
// 为什么首次也要看**主机**而不只是写一行：TOFU 的价值全在第二次连接上，所以查找必须
// 能在库里找到上一次写的那行 —— 主机名比对大小写无关（tp_host_eq），指纹比对折叠小写。
fn tls_tofu_decide(c: &TlsConn, host: &const byte, host_len: usize) !void {
    var r: i32 = tls_tofu_verdict(
        host, host_len, &c.observed[0], c.observed_len);
    if r == TP_VERDICT_MISMATCH && hc_tofu_learn {
        // 多证书站点（轮换 / 多机房）在这条路上：只有**链能验到系统根**才算新证书可信
        const ca: i32 = tls_tofu_ca_check(c, host, host_len);
        if ca == CC_OK {
            r = tls_tofu_learn(host, host_len, &c.observed[0], c.observed_len);
        }
    }
    c.verified = r == TP_VERDICT_TRUSTED || r == TP_VERDICT_LEARNED;
    if r == TP_VERDICT_MISMATCH {
        return error.HcPinMismatch;
    }
    return;
}

// 「学一条新指纹」：库里有这台主机但指纹没记过，且链校验已过 ⇒ 追加一行
// （库是**只追加**的：上限 TP_MAX_PER_HOST 到了就不再追加，但仍然放行 —— 判据是
// 「这张证书可不可信」，不是「能不能记账」）。
// 返回 TP_VERDICT_LEARNED（学成了；或已满上限但链验过）/ MISMATCH（学习关着）。
export fn tls_tofu_learn(
    host: &const byte,
    host_len: usize,
    hex: &const byte,
    hex_len: usize
) i32 {
    if !hc_tofu_learn {
        return TP_VERDICT_MISMATCH;
    }
    if !hc_tofu_enabled {
        return TP_VERDICT_MISMATCH;      // 没有库路径：不记账也不放行（失败要显式）
    }
    var store: TpStore = tp_empty();
    defer { tp_free(&store); }
    tls_tofu_load(&store);
    const have: usize = tp_count_host(&store, host, host_len);
    if have >= TP_MAX_PER_HOST || store.n >= TP_MAX_ENTRIES {
        return TP_VERDICT_LEARNED;       // 满了：不追加（库只追加，不淘汰），链验过就放行
    }
    _ = tls_tofu_append(host, host_len, hex);
    return TP_VERDICT_LEARNED;
}

// TOFU 的**判据本体**（不含 TlsConn，因而离线可测）：返回三态结论。
//
// 为什么要把判据从 `tls_tofu_decide` 里摘出来：那个函数收 `&TlsConn`，而 TlsConn 只有走完
// 真握手才填得满 —— 离线造不出来。自测若「照着它的形状再写一遍」，覆盖的就是**测试自己
// 的复刻品**而不是产品代码：本文件第一版正是如此，把「首次不落盘」这行删掉之后自测**全绿**
// （防假绿对照实测），而 TOFU 的全部价值就是那行落盘。摘出来之后，自测直接调这个函数，
// 打点落在真判据上。
//
// 三态：TRUSTED（命中）/ MISMATCH（有记录但不符）/ FRESH（首次，已记录）。
fn tls_tofu_verdict(
    host: &const byte,
    host_len: usize,
    hex: &const byte,
    hex_len: usize
) i32 {
    if !hc_tofu_enabled {
        // 没配指纹库路径（比如纯库调用方没走 agent 的配置）⇒ 退化成 none 的语义，
        // 但要留痕：不静默假装校验过。
        return TP_VERDICT_UNPINNED;
    }
    var store: TpStore = tp_empty();
    defer { tp_free(&store); }
    tls_tofu_load(&store);
    if tp_has_host(&store, host, host_len) {
        if tp_trusts(&store, host, host_len, hex, hex_len) {
            return TP_VERDICT_TRUSTED;
        }
        return TP_VERDICT_MISMATCH;
    }
    // 首次见到：记录。写失败不算连接失败 —— 判据是「能不能连上」，不是「能不能记账」；
    // 但结论是 FRESH，调用方据此把 `verified` 留成 false，如实反映「本次没有先验可比对」。
    _ = tls_tofu_append(host, host_len, hex);
    return TP_VERDICT_FRESH;
}

// 从指纹库文件读全部文本并解析进 store（文件不存在/读不动 ⇒ 空库，不是错误）。
fn tls_tofu_load(store: &TpStore) void {
    var text: Buf = buf_new(HC_PIN_FILE_MAX);
    defer { buf_free(&text); }
    const pz: &const byte = hc_tofu_path.ptr as &const byte;
    const fd: i32 = sys_open(pz as *const byte, O_RDONLY as i32, 0) catch {
        return;
    };
    while text.len < HC_PIN_FILE_MAX {
        const room: usize = text.cap - text.len;
        const got: isize = sys_read(fd, &text.ptr[text.len], room) catch {
            break;
        };
        if got <= 0 {
            break;
        }
        text.len = text.len + (got as usize);
    }
    _ = sys_close(fd) catch {};
    if text.len == 0 {
        return;
    }
    _ = tp_parse(store, text.ptr, text.len);
}

// 把 `host hex` 追加到指纹库文件末尾（不存在就创建）。返回是否写成功。
// 追加而不是重写：库里可能已经有别的站点（以及这台主机的多条轮换指纹），
// 重写会把别人的条目一起丢掉 —— 本函数**只追加**，不改动任何已有字节。
fn tls_tofu_append(host: &const byte, host_len: usize, hex: &const byte) bool {
    var line: Buf = buf_new(host_len + TP_HEX_LEN + 8);
    defer { buf_free(&line); }
    if !tp_format_entry(&line, host, host_len, hex) {
        return false;
    }
    const flags: i32 = (O_WRONLY | O_CREAT | O_APPEND) as i32;
    const pz: &const byte = hc_tofu_path.ptr as &const byte;
    const fd: i32 = sys_open(pz as *const byte, flags, 420 as i32) catch {
        return false;
    };
    var off: usize = 0;
    var ok: bool = true;
    while off < line.len {
        const w: isize = sys_write(fd, &line.ptr[off], line.len - off) catch {
            ok = false;
            break;
        };
        if w <= 0 {
            ok = false;
            break;
        }
        off = off + (w as usize);
    }
    _ = sys_close(fd) catch {};
    return ok;
}

// 链校验：把 stdlib 的失败原因翻译成**能指路的**错误码，而不是一律 `HcTlsUnsupported`。
//
// 三条失败路径各有各的修法，糊成一个错误码等于把排障线索丢掉：
//   * peer_leaf 为空 ⇒ `HcTlsNoChain`（本仓实测：真实站点**一律**走这条 —— stdlib 的
//     `ssl_capture_peer_chain_from_server_flight` 认的是带 record 头的 in_ 缓冲，
//     而 hdr.server_flight_msg 存的是**不含 record 头**的握手消息流，于是它解析不出任何证书，
//     见 §18 / 踩坑 132。所以 chain 档在真实站点上是**必然**失败，不是偶发）；
//   * 信任锚为空 ⇒ `HcTlsNoAnchors`（机器上没有 CA 库）；
//   * 其它 ⇒ `HcTlsUnsupported`（签名/有效期/CA 约束不符 —— 真有中间人时会落在这里）。
fn tls_chain_verify(c: &TlsConn) !void {
    if !c.anchors_ready {
        return error.HcTlsNoAnchors;
    }
    const ctx: &SslContext = c.ctx;
    if ctx.peer_leaf == null as &const Cert {
        return error.HcTlsNoChain;
    }
    verify_chain_rsa(
        ctx.peer_leaf,
        ctx.peer_chain,
        ctx.peer_chain_len,
        trust_store_get_certs(c.ts),
        trust_store_get_count(c.ts),
        KU_DIGITAL_SIGNATURE
    ) catch {
        return error.HcTlsUnsupported;
    };
    return;
}

// 释放 tls_open 分配的 4 个上下文并全部置 null；可安全重复调用（与 fd 无关）。
export fn tls_conn_free(c: &TlsConn) void {
    if (c.hs as usize) != 0 {
        free(c.hs as &void);
    }
    if (c.rec as usize) != 0 {
        free(c.rec as &void);
    }
    if (c.ctx as usize) != 0 {
        free(c.ctx as &void);
    }
    if (c.ts as usize) != 0 {
        free(c.ts as &void);
    }
    c.hs = null as &HandshakeCtx;
    c.rec = null as &RecordCtx;
    c.ctx = null as &SslContext;
    c.ts = null as &TrustStore;
}

// 明文：一次 record 写不完，按 16384 分片（ssl_write 每调用加密整段明文）
export fn tls_write_all(c: &TlsConn, p: &const byte, n: usize) !void {
    var off: usize = 0;
    var cipher: [byte: HC_TLS_BUF] = [0: HC_TLS_BUF];
    while off < n {
        // P31：请求体在「大上下文 + 慢上行」时要写好几秒 —— 每写一条 TLS 记录（≤16 KiB）
        // 就泵一次，于是「刚发请求」这段也能当场收到 /status 与 esc/ctrl+c。
        // 非 TUI（子代理 / 一次性运行 / 管道 / --probe）不泵，行为不变。
        if tui_active() {
            agent_pump_light();
        }
        var take: usize = n - off;
        if take > HC_TLS_CHUNK {
            take = HC_TLS_CHUNK;
        }
        const src: &const byte = @ptr_from_usize(@usize_from_ptr(p as &void) + off) as &const byte;
        var clen: usize = 0;
        ssl_write(c.ctx, src, take, &cipher[0], HC_TLS_BUF, &clen) catch {
            return error.HcIoFailed;
        };
        https_write_all(c.fd, &cipher[0], clen) catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            if eid == @error_id(error.ReadWouldBlock) {
                return error.HcTimeout;
            }
            return error.HcIoFailed;
        };
        off = off + take;
    }
}

// 返回一段应用数据（0 = 连接关闭）
export fn tls_read_some(c: &TlsConn, out: &byte, cap: usize) !usize {
    var cipher: [byte: HC_TLS_BUF] = [0: HC_TLS_BUF];
    while true {
        var clen: usize = 0;
        https_read_tls_record_exact(c.fd, &cipher[0], HC_TLS_BUF, &clen) catch |err| {
            const eid: i32 = (@error_id(err) as! i32).value;
            if eid == @error_id(error.ConnectionClosed) {
                return 0 as usize;
            }
            if eid == @error_id(error.ReadWouldBlock) {
                return error.HcTimeout;
            }
            return error.HcIoFailed;
        };
        if clen < 5 {
            return error.HcIoFailed;
        }
        const rt: byte = cipher[0];
        if rt == (TLS_RECORD_ALERT as byte) {
            // 服务端在响应后发的 close_notify（或致命告警）：前者等价于 EOF。
            // 已经读到的内容交给上层解析；若一个字节都没有，上层会报 HcBadResponse。
            return 0 as usize;
        }
        if rt != (TLS_RECORD_APPLICATION_DATA as byte) {
            continue;   // change_cipher_spec / handshake 等：跳过
        }
        var plen: usize = 0;
        var consumed: usize = 0;
        ssl_read(c.ctx, &cipher[0], clen, out, cap, &plen, &consumed) catch {
            return error.HcIoFailed;
        };
        return plen;
    }
}

// ============================================================
// 连接抽象
// ============================================================
export struct HcConn {
    fd: i32,
    is_tls: bool,
    tc: &TlsConn,
}

// 读一次连接（明文或 TLS 都走这里）；返回读到的字节数，**0 表示 EOF（对端已关）**。
// 超时映射成 `HcTimeout`，其余 IO 错误映射成 `HcIoFailed`。
fn conn_read(c: &HcConn, out: &byte, cap: usize) !usize {
    if c.is_tls {
        return tls_read_some(c.tc, out, cap);
    }
    const n: usize = https_read_some(c.fd, out, cap) catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        if eid == @error_id(error.ConnectionClosed) {
            return 0 as usize;
        }
        if eid == @error_id(error.ReadWouldBlock) {
            return error.HcTimeout;
        }
        return error.HcIoFailed;
    };
    return n;
}

// 循环写满整段（明文或 TLS）；短写由底层继续，超时映射 `HcTimeout`，其余 `HcIoFailed`。
fn conn_write_all(c: &HcConn, p: &const byte, n: usize) !void {
    if c.is_tls {
        return tls_write_all(c.tc, p, n);
    }
    https_write_all(c.fd, p, n) catch |err| {
        const eid: i32 = (@error_id(err) as! i32).value;
        if eid == @error_id(error.ReadWouldBlock) {
            return error.HcTimeout;
        }
        return error.HcIoFailed;
    };
    return;
}

// ============================================================
// 请求 / 响应
// ============================================================
export struct Resp {
    status: i32,
    body: Buf,
    head_len: usize,
}

// 一个空响应（status = 0、空 body）；body 由 http_request 分配，用 resp_free 释放。
fn resp_empty() Resp {
    return Resp{ status: 0, body: buf_empty(), head_len: 0 };
}

// 释放 Resp.body；可安全重复调用。
export fn resp_free(r: &Resp) void {
    buf_free(&r.body);
}

// 拼 `Host: host[:port]` 那一行（默认端口不带端口号）。
// 直连与走代理两种形态共用同一个头 —— 代理改的是请求行，不改 Host。
fn hc_append_host_header(u: &const Url, out: &Buf) bool {
    if !buf_append(out, url_host(u), u.host_len) {
        return false;
    }
    var default_port: u16 = 80;
    if u.tls {
        default_port = 443;
    }
    if u.port == default_port {
        return true;
    }
    if !buf_append_byte(out, 58) {
        return false;
    }
    return buf_append_u64(out, u.port as u64);
}

// 拼请求行的目标部分：直连写相对路径（`/v1/chat/completions`），走明文代理写**绝对形式**
// （`http://api.example.com/v1/chat/completions`）。
//
// 为什么绝对形式是必须的：代理要靠它认出去哪（这正是「代理模式」与「源服务器模式」的区别），
// 写成相对路径时请求会被路由到代理自己身上 —— 症状是 404 或代理的欢迎页，与网络错无关，
// 很难从「请求失败」这四个字里查出来。
fn hc_append_target(u: &const Url, route: u8, out: &Buf) bool {
    if route != HC_ROUTE_PROXY_ABS {
        return buf_append(out, url_path(u), u.path_len);
    }
    // 走绝对形式的**只可能是明文目标**（HTTPS 一律走 CONNECT 隧道，见 hc_connect）；
    // 但这里仍按 u.tls 取 scheme，免得将来多一条路由时这里变成静默错的源头。
    if u.tls {
        if !buf_append_cstr(out, "https://") {
            return false;
        }
    } else {
        if !buf_append_cstr(out, "http://") {
            return false;
        }
    }
    if !hc_append_host_header(u, out) {
        return false;
    }
    return buf_append(out, url_path(u), u.path_len);
}

// 拼请求头（追加进 out，不清空）：请求行 + Host（非默认端口才带 :port）+ User-Agent +
// extra_headers 原样（走明文代理时前面先加 Proxy-Authorization）+ Content-Length +
// `Connection: close`。body 由调用方另行追加。分配失败返回 false。
// route 取自 `hc_connect` 写回的那个值 —— 路由与请求形态**同源**，不会半对。
fn build_request(u: &const Url, method: &[byte], extra_headers: &[byte],
    body_len: usize, route: u8, out: &Buf) bool {
    if !buf_append_slice(out, method) {
        return false;
    }
    if !buf_append_byte(out, 32) {
        return false;
    }
    if !hc_append_target(u, route, out) {
        return false;
    }
    if !buf_append_cstr(out, " HTTP/1.1\r\nHost: ") {
        return false;
    }
    if !hc_append_host_header(u, out) {
        return false;
    }
    if !buf_append_cstr(out, "\r\nUser-Agent: ") {
        return false;
    }
    if !buf_append_cstr(out, HC_USER_AGENT) {
        return false;
    }
    if !buf_append_cstr(out, "\r\n") {
        return false;
    }
    // 明文代理的凭据：只有绝对形式那一路需要（CONNECT 那一路在 hpx_connect_head 里带上）。
    // 直连时**一个字节都不发** —— 把凭据发给源服务器是最没有理由的一种泄漏。
    if route == HC_ROUTE_PROXY_ABS && hpx_auth_len() > 0 {
        if !buf_append(out, hpx_auth_ptr(), hpx_auth_len()) {
            return false;
        }
    }
    if extra_headers.len > 0 {
        if !buf_append(out, extra_headers.ptr, extra_headers.len) {
            return false;
        }
    }
    if !buf_append_cstr(out, "Content-Length: ") {
        return false;
    }
    if !buf_append_u64(out, body_len as u64) {
        return false;
    }
    if !buf_append_cstr(out, "\r\nConnection: close\r\n\r\n") {
        return false;
    }
    return true;
}

// 从状态行里取 3 位十进制状态码；格式不对返回 **0**（调用方据此报 `HcBadResponse`）。
fn parse_status(head: &[byte], head_len: usize) i32 {
    var sp: usize = 0;
    while sp < head_len && head.ptr[sp] != 32 {
        sp = sp + 1;
    }
    if sp + 4 > head_len {
        return 0;
    }
    var v: i32 = 0;
    var i: usize = 0;
    while i < 3 {
        const c: byte = head.ptr[sp + 1 + i];
        if !is_digit(c) {
            return 0;
        }
        v = v * 10 + ((c as i32) - 48);
        i = i + 1;
    }
    return v;
}

// 在响应头里找 header 值；返回是否存在
fn head_value(head: &[byte], head_len: usize, name: &[byte], out_off: &usize, out_len: &usize) bool {
    var i: usize = 0;
    while i < head_len {
        // 行首
        var line_end: usize = i;
        while line_end < head_len && head.ptr[line_end] != 10 {
            line_end = line_end + 1;
        }
        if line_end > i + name.len && eq_ignore_case(head[i: name.len], name) && head.ptr[i + name.len] == 58 as byte {
            var p: usize = i + name.len +% 1;
            while p < line_end && head.ptr[p] == 32 {
                p = p + 1;
            }
            var e: usize = p;
            while e < line_end && head.ptr[e] != 13 && head.ptr[e] != 10 {
                e = e + 1;
            }
            out_off[0] = p;
            out_len[0] = e - p;
            return true;
        }
        i = line_end + 1;
    }
    return false;
}

// chunked 就地解码：src[from..len] → 输出写回 src 的 from 处，返回解码后长度
fn decode_chunked_inplace(src: &Buf, from: usize) i64 {
    var rp: usize = from;
    var wp: usize = from;
    const len: usize = src.len;
    const view: &[byte] = src.ptr[0: len];
    while true {
        // 读 chunk 长度行
        var line_end: usize = rp;
        while line_end < len && view.ptr[line_end] != 10 {
            line_end = line_end + 1;
        }
        if line_end >= len {
            return -1;
        }
        var hlen: usize = line_end - rp;
        if hlen > 0 && view.ptr[rp + hlen - 1] == 13 as byte {
            hlen = hlen - 1;
        }
        // 忽略 chunk 扩展
        var hex_len: usize = hlen;
        var k: usize = 0;
        while k < hlen {
            if view.ptr[rp + k] == 59 as byte {
                hex_len = k;
                break;
            }
            k = k + 1;
        }
        if hex_len == 0 {
            return -1;
        }
        const clen: i64 = parse_hex_at(view, rp, hex_len);
        if clen < 0 {
            return -1;
        }
        rp = line_end + 1;
        if clen == 0 {
            return (wp - from) as i64;
        }
        const csz: usize = clen as usize;
        if rp + csz > len {
            return -1;
        }
        var i: usize = 0;
        while i < csz {
            view.ptr[wp + i] = view.ptr[rp + i];
            i = i + 1;
        }
        wp = wp + csz;
        rp = rp + csz;
        // 跳过 chunk 后的 CRLF
        if rp < len && view.ptr[rp] == 13 as byte {
            rp = rp + 1;
        }
        if rp < len && view.ptr[rp] == 10 as byte {
            rp = rp + 1;
        }
    }
    return -1;
}

// 整段式 HTTP 请求（**非流式**路径，`--no-stream` 用）：连接 → 写请求 → 发
// `Connection: close` 一直读到 EOF，再把头/体解析完才返回。体上限 `max_body + HC_HEAD_MAX`，
// 超出报 `HcTooLarge`；chunked 会就地解码，content-length 不足报 `HcBadResponse`。
// out 里的 body 是**独立拷贝的 Buf**，调用方负责 resp_free；tls_out 由调用方 tls_conn_free。
export fn http_request(
    url: &[byte],
    method: &[byte],
    extra_headers: &[byte],
    body: &const byte,
    body_len: usize,
    timeout_ms: u32,
    max_body: usize,
    verify: i32,
    pin: &[byte],
    out: &Resp,
    tls_out: &TlsConn
) !void {
    var u: Url = url_empty();
    try url_parse(url, &u);
    defer { url_free(&u); }

    // P92：连谁、走哪条路（直连 / CONNECT 隧道 / 明文代理）由 `hc_connect` 一处定 ——
    // 它把路由写进 route，紧接的 build_request 据此决定请求行写相对还是绝对形式。
    var route: u8 = HC_ROUTE_DIRECT;
    const fd: i32 = try hc_connect(&u, timeout_ms, &route);
    defer { _ = sys_close(fd) catch {}; }

    tls_out.fd = fd;
    var conn: HcConn = HcConn{ fd: fd, is_tls: u.tls, tc: tls_out };
    if u.tls {
        try tls_open(tls_out, url_host(&u), u.host_len, verify, pin);
    }
    defer { if u.tls { tls_conn_free(tls_out); } }

    var req: Buf = buf_new(4096);
    defer { buf_free(&req); }
    if !buf_valid(&req) {
        return error.HcOutOfMemory;
    }
    if !build_request(&u, method, extra_headers, body_len, route, &req) {
        return error.HcOutOfMemory;
    }
    if !buf_append(&req, body, body_len) {
        return error.HcOutOfMemory;
    }
    try conn_write_all(&conn, &req.ptr[0], req.len);

    // 读到 EOF（我们固定发 Connection: close）
    var rx: Buf = buf_new(HC_READ_CHUNK * 2);
    defer { buf_free(&rx); }
    if !buf_valid(&rx) {
        return error.HcOutOfMemory;
    }
    var tmp: [byte: HC_READ_CHUNK] = [0: HC_READ_CHUNK];
    const limit: usize = max_body + HC_HEAD_MAX;
    // P30：这一路（非流式请求：--no-stream 的整段回答、web_search、会话导入）以前是
    // 「一口气阻塞读到 EOF」，长回答期间界面完全不刷、esc 也进不来（用户看到的就是卡死）。
    // 现在改成 poll(≤50ms) + 泵点：没有数据就转一圈界面与命令派发，超时按 timeout_ms 判。
    // 与流式那条路（httpstream 的 hc_fill_wait）同一套做法，TLS 也一样是先 poll 再读。
    const t0: u64 = ua_now_ms();
    while true {
        if tui_active() {
            var pfds: [PollFd: 1] = [PollFd{ fd: fd, events: POLLIN, revents: 0 }];
            const pr: i32 = sys_poll(&pfds[0], 1, 50) catch { 0; };
            if pr <= 0 {
                if timeout_ms > 0 && (ua_now_ms() - t0) >= (timeout_ms as u64) {
                    return error.HcTimeout;
                }
                agent_pump_light();
                continue;
            }
        }
        const n: usize = try conn_read(&conn, &tmp[0], HC_READ_CHUNK);
        if n == 0 {
            break;
        }
        if !buf_append(&rx, &tmp[0], n) {
            return error.HcOutOfMemory;
        }
        if rx.len > limit {
            return error.HcTooLarge;
        }
    }
    if rx.len == 0 {
        return error.HcBadResponse;
    }
    const view: &[byte] = rx.ptr[0: rx.len];
    const he: isize = find_sub(view, &"\r\n\r\n"[0: 4], 0);
    if he < 0 {
        return error.HcBadResponse;
    }
    const head_end: usize = (he as usize) + 4;
    out.head_len = head_end;
    out.status = parse_status(view, head_end);
    if out.status == 0 {
        return error.HcBadResponse;
    }

    var cl_off: usize = 0;
    var cl_len: usize = 0;
    var te_off: usize = 0;
    var te_len: usize = 0;
    const has_cl: bool = head_value(view, head_end, &"content-length"[0: 14], &cl_off, &cl_len);
    const has_te: bool = head_value(view, head_end, &"transfer-encoding"[0: 17], &te_off, &te_len);
    var chunked: bool = false;
    if has_te && te_len >= 7 {
        chunked = eq_ignore_case(view[te_off: te_len], &"chunked"[0: 7]);
    }

    var body_len_out: usize = rx.len - head_end;
    if hc_debug {
        var hb: usize = head_end;
        if hb > 400 {
            hb = 400;
        }
        hc_dbg("[hc] head: ", &rx.ptr[0] as &const byte, hb);
        var rb: usize = rx.len - head_end;
        if rb > 48 {
            rb = 48;
        }
        hc_dbg("[hc] raw body head: ", &rx.ptr[head_end] as &const byte, rb);
        hc_dbg_dec("[hc] rx.len=", rx.len);
        hc_dbg_dec("[hc] head_end=", head_end);
        hc_dbg_dec("[hc] chunked=", chunked as usize);
        hc_dbg_dec("[hc] has_cl=", has_cl as usize);
        hc_dbg_dec("[hc] cl_len=", cl_len);
        hc_dbg_dec("[hc] te_len=", te_len);
    }
    if chunked {
        const dec: i64 = decode_chunked_inplace(&rx, head_end);
        if dec < 0 {
            return error.HcBadResponse;
        }
        body_len_out = dec as usize;
    } else if has_cl && cl_len > 0 {
        const want: i64 = parse_u64_at(view, cl_off, cl_len);
        if want < 0 {
            return error.HcBadResponse;
        }
        if (want as usize) > body_len_out {
            return error.HcBadResponse;
        }
        body_len_out = want as usize;
    }
    if body_len_out > max_body {
        return error.HcTooLarge;
    }
    out.body = buf_new(body_len_out + 1);
    if !buf_valid(&out.body) {
        return error.HcOutOfMemory;
    }
    if !buf_append(&out.body, &rx.ptr[head_end], body_len_out) {
        return error.HcOutOfMemory;
    }
    return;
}
