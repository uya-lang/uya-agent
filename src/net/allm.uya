// src/net/allm.uya — 异步流式 LLM 请求（P99b）：`llm_stream_style` 的事件循环版
//
// 本文件：`allm_stream_style` / `allm_stream_chat`。与 `llm_stream_style` **同参数、
//   同返回、同错误码**，差别只在「怎么等」：同步版在流式循环里每 ≤50 ms 插一个泵点
//   （`llm_pump_input` + `hc_fill_wait`），本文件把同一个循环放在事件循环上
//   （`ahc_fill` 内部 `rt_read` 分片等待），帧回调与键读取由 `rt` 的包装 future 负责。
//
// 不变量：
//   ① **一帧 payload 交给谁解析不变**：`llm_handle_payload`（chat）/
//      `llm_resp_handle_payload`（responses）与同步版是同一对函数，事件表、终局回填、
//      用法统计一个字都不重写 —— 本文件只换「读字节」那一层；
//   ② 错误码映射是**一张表**（`allm_map_error_err`）：`error.Cancelled` → `LlmInterrupted`
//      （与同步版「泵点看到 esc/ctrl+c/ctrl+d 就 return error.LlmInterrupted」同义），
//      其余透传。上层判 `error.LlmInterrupted` 的那几处（回合收口、侧路请求让路）不改；
//   ③ **后台请求让路保持不变**：`agent_bg_request() && agent_bg_input_pending()` 仍然
//      每轮查一次（纯内存判断、无 I/O）—— 后台请求一发现用户动了键盘就立刻中止自己，
//      这条纪律与「谁来等」无关；
//   ④ 非 2xx 的体照旧收进 `o.err_text`（前 `LLM_ERR_HEAD` 字节）后再返回状态码 ——
//      网关的 400/401 正文是排障的唯一线索，不许因为换了读法就丢。
//
// 依赖：src/net/llm.uya（`ChatOut` / `llm_handle_payload` /
//   `llm_resp_handle_payload` / `LLM_STYLE_*` / `LLM_ERR_HEAD` /
//   `chat_out_new`）、
//   src/net/sse.uya（`SseReader`）、src/net/ahttp.uya（`ahc_open` / `ahc_fill`）、
//   src/net/httpstream.uya（`hc_body_read` / `hc_stream_free`）、
//   src/rt/rtloop.uya（取消）。
// 命名：`allm_*`（async llm）。

use std.async;

// 非 2xx 的收尾：把前面一段体收进 `o.err_text`，返回 0（成败只看 error 分支）。
// 与同步版逐行同形：先把「还能装多少」算出来，再 `hc_body_read` 搬过去。
@async_fn fn allm_drain_error_body(st: &HcStream, o: &ChatOut) Future<!usize> {
    while true {
        const r: !i32 = @await ahc_fill(st, 0 as u64);
        const f0: i32 = r catch |err| {
            const mapped: i32 = try allm_map_error_err(
                (@error_id(err) as! i32).value);
            _ = mapped;
            0 as i32;
        };
        if o.err_text.len < LLM_ERR_HEAD {
            const want: usize = LLM_ERR_HEAD - o.err_text.len;
            const br: !usize = hc_body_read(st, &o.err_text, want);
            _ = br catch {
                0 as usize;
            };
        }
        if f0 == 0 {
            break;
        }
    }
    return 0 as usize;
}

// 主体：建连 → 非 2xx 收错误体 → SSE 事件循环 → 终局判定。与 `llm_stream_style` 同形。
@async_fn fn allm_stream_run(
    style: u8,
    url: &[byte],
    headers: &[byte],
    body: &const byte,
    body_len: usize,
    timeout_ms: u32,
    max_body: usize,
    verify: i32,
    pin: &[byte],
    o: &ChatOut,
    print_content: bool,
    print_reasoning: bool,
    interactive: bool,
    status_out: &i32
) Future<!i32> {
    status_out[0] = 0;
    const arena_raw: &void = malloc(LLM_EVENT_ARENA);
    if ((arena_raw as &byte) as usize) == 0 {
        return error.HcOutOfMemory;
    }
    defer { free(arena_raw); }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, arena_raw as &byte, LLM_EVENT_ARENA);

    var st: HcStream = hc_stream_empty();
    defer { hc_stream_free(&st); }
    var tc: TlsConn = tls_conn_empty();
    const opened: !usize = @await ahc_open(url, &"POST"[0: 4], headers, body,
        body_len, timeout_ms, max_body, verify, pin, &st, &tc);
    const open_val: usize = opened catch |err| {
        const mapped: i32 = try allm_map_error_err(
            (@error_id(err) as! i32).value);
        _ = mapped;
        0 as usize;
    };
    _ = open_val;

    if st.status != 200 {
        const dr: !usize = @await allm_drain_error_body(&st, o);
        _ = dr catch |err| {
            const mapped: i32 = try allm_map_error_err(
                (@error_id(err) as! i32).value);
            _ = mapped;
            0 as usize;
        };
        status_out[0] = st.status;
        return 0 as i32;
    }

    var sr: SseReader = SseReader{
        acc: buf_empty(), have_data: false, events: 0, comments: 0,
    };
    sse_init(&sr);
    defer { sse_free(&sr); }
    var payload: Buf = buf_new(8192);
    defer { buf_free(&payload); }

    var done: bool = false;
    while !done {
        // 1) 先把手上完整的事件全处理掉（与同步版同一步、同一对解析函数）
        while true {
            const ev: !i32 = sse_next(&st, &sr, &payload);
            const got: i32 = ev catch |err| {
                return err;
            };
            if got <= 0 {
                break;
            }
            var cont: bool = false;
            if style == LLM_STYLE_RESPONSES {
                const cr: !bool = llm_resp_handle_payload(
                    &arena, payload.ptr[0: payload.len], o,
                    print_content, print_reasoning);
                cont = cr catch |err| {
                    return err;
                };
            } else {
                const cr: !bool = llm_handle_payload(
                    &arena, payload.ptr[0: payload.len], o,
                    print_content, print_reasoning);
                cont = cr catch |err| {
                    return err;
                };
            }
            if !cont {
                done = true;
                break;
            }
        }
        if done {
            break;
        }
        // 2) 没有完整事件就再读一段。交互模式下这里**不再需要**泵点：
        //    帧回调（`rt` 的包装 future）每 ≤16 ms 跑一次，键在那边读、取消在那边置位。
        if interactive {
            // 后台请求让路（纯内存判断，与同步版一字不差）
            if agent_bg_request() && agent_bg_input_pending() {
                return error.LlmInterrupted;
            }
            // 键服务：位置与同步版 `llm_stream_style` 里那次 `llm_pump_input()` 一致
            // （读到一段之后、还没凑出完整事件的时候）。ctrl+c / esc / ctrl+d 都在这里。
            if agent_stream_pump(true) != 0 {
                return error.LlmInterrupted;
            }
        }
        const fr: !i32 = @await ahc_fill(&st, 0 as u64);
        const f: i32 = fr catch |err| {
            const mapped: i32 = try allm_map_error_err(
                (@error_id(err) as! i32).value);
            _ = mapped;
            0 as i32;
        };
        if f == 0 {
            break;
        }
    }

    if !o.saw_done && o.finish != LLM_FINISH_ERROR {
        return error.LlmStreamClosed;
    }
    status_out[0] = st.status;
    return 0 as i32;
}

// 错误透传：只做 Cancelled → LlmInterrupted 的翻译。
fn allm_map_error_err(e: i32) !i32 {
    if e == (@error_id(error.Cancelled) as! i32).value {
        return error.LlmInterrupted;
    }
    return allm_error_by_id(e);
}

// error id → 具体错误值。**只覆盖本文件会遇到的几种**：其余折成 `HcIoFailed`
// （上层对它的分类已经存在，不会多出一条没人认识的新码）。
//
// P103：传输层那几档必须**逐一保留**，不能一起折成 `HcIoFailed` —— 上层的
// `agent_net_fail_kind` 靠错误值分出「名字没解开 / TCP 没连上 / 握手谈崩 /
// 代理没打通 / 指纹不符」，重试层也靠 `rtx_retryable_err` 分「要不要重发」。
// 折成一个码 = 交互模式下的失败报告永远只剩「网络或 TLS 校验」一句（与同步路
// 不一致：那条路 `try` 直接透传，报告是具体的）。
fn allm_error_by_id(e: i32) !i32 {
    if e == (@error_id(error.HcBadResponse) as! i32).value {
        return error.HcBadResponse;
    }
    if e == (@error_id(error.HcTooLarge) as! i32).value {
        return error.HcTooLarge;
    }
    if e == (@error_id(error.HcOutOfMemory) as! i32).value {
        return error.HcOutOfMemory;
    }
    if e == (@error_id(error.HcTimeout) as! i32).value {
        return error.HcTimeout;
    }
    if e == (@error_id(error.AsyncDeadlineExceeded) as! i32).value {
        return error.HcTimeout;
    }
    if e == (@error_id(error.HcDnsFailed) as! i32).value {
        return error.HcDnsFailed;
    }
    if e == (@error_id(error.HcConnectFailed) as! i32).value {
        return error.HcConnectFailed;
    }
    if e == (@error_id(error.HcHandshakeFailed) as! i32).value {
        return error.HcHandshakeFailed;
    }
    if e == (@error_id(error.HcProxyUnavailable) as! i32).value {
        return error.HcProxyUnavailable;
    }
    if e == (@error_id(error.HcProxyFailed) as! i32).value {
        return error.HcProxyFailed;
    }
    if e == (@error_id(error.HcPinMismatch) as! i32).value {
        return error.HcPinMismatch;
    }
    if e == (@error_id(error.HcTlsNoLeaf) as! i32).value {
        return error.HcTlsNoLeaf;
    }
    if e == (@error_id(error.HcTlsNoChain) as! i32).value {
        return error.HcTlsNoChain;
    }
    if e == (@error_id(error.HcTlsNoAnchors) as! i32).value {
        return error.HcTlsNoAnchors;
    }
    if e == (@error_id(error.HcTlsUnsupported) as! i32).value {
        return error.HcTlsUnsupported;
    }
    return error.HcIoFailed;
}

// 对外入口（与 `llm_stream_style` 同参数；额外一个 `status_out` 把状态码带出来，
// 因为 async 的返回值只能有一个）。
export fn allm_stream_style(
    style: u8,
    url: &[byte],
    headers: &[byte],
    body: &const byte,
    body_len: usize,
    timeout_ms: u32,
    max_body: usize,
    verify: i32,
    pin: &[byte],
    o: &ChatOut,
    print_content: bool,
    print_reasoning: bool,
    interactive: bool,
    status_out: &i32
) Future<!i32> {
    return allm_stream_run(style, url, headers, body, body_len, timeout_ms,
        max_body, verify, pin, o, print_content, print_reasoning,
        interactive, status_out);
}

// chat/completions 的薄包装（自测走这个）。
export fn allm_stream_chat(
    url: &[byte],
    headers: &[byte],
    body: &const byte,
    body_len: usize,
    timeout_ms: u32,
    max_body: usize,
    verify: i32,
    pin: &[byte],
    o: &ChatOut,
    print_content: bool,
    print_reasoning: bool,
    interactive: bool,
    status_out: &i32
) Future<!i32> {
    return allm_stream_run(LLM_STYLE_CHAT, url, headers, body, body_len,
        timeout_ms, max_body, verify, pin, o, print_content, print_reasoning,
        interactive, status_out);
}
