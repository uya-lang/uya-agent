// src/pm/pm_digest.uya — 项目记忆的开工包：渲染 + 失效校验（P67）
//
// 本文件：`pm_verify`（按 stat 三元组判定一条事实是否过期，**要 workspace**）、
//   `pm_digest`（把事实集渲染成一段带字节预算的文本）、分区顺序（`pm_digest_order`）、
//   单节份额（`PM_DIGEST_SECT_DIV`，见 ⑤）、状态与出处 token（`pm_fact_tokens`，见 ⑥）。
// 不变量：① **每条事实注入前当场校验**：文件类事实比对 `(mtime, mtime_nsec, size)` 三元组
//   （抄 `fs_obs_same_version` 的口径）；对不上就标 `STALE`（文件没了标 `GONE`）并**降级为
//   提示**，绝不断言。实测 19.2% 被读过的文件之后会被改动 —— 不校验就是注入过期货。
//   惯例类逐条标 `[confirmed]` / `[proposed]`：自动抽取永远只是候选，只有人确认过才算数。
//   ② **正文永不注入**：只给「去哪读 + 出处 + 次数」。模型要看内容自己去 read，这样
//   过期也不可能造成误改（现有 `fs_obs_same_version` 写闸门继续兜底）。
//   ③ 截断顺序**确定且可解释**：commands → conventions → layout → state，越靠后越先被丢
//   （state 最易过期）；**commands 永不先丢** —— 「这个项目怎么跑」是最值钱也最稳定的。
//   ④ 预算按**字节**算，单条超预算就跳过该条、继续试后面的（不是整段截断 —— 截断会把
//   一行切成半截，读起来像坏数据）。
//   ⑤ **单节份额封顶（正文的 1/2）**：③ 的截断顺序只在「预算不够」时才起作用，而
//   commands 的条数天然远多于另外三节（每次成功的 bash 都记一条）—— 不限份额时它会把
//   预算吃到 99%、把 conventions/layout/state **一条都挤不进来**（实测本仓真记忆目录）。
//   份额只改「怎么分」，不改顺序。
//   ⑥ **状态与出处是两组独立 token，且只有一处实现**（`pm_fact_tokens`）：注入、
//   `/memory` 报告、检索结果三处必须逐字节一致 —— 各写一份必然漂移（本仓踩坑 92 的
//   孪生形态）。`observed` 是默认档**不印**（印它是纯预算税）；`superseded` 渲染成
//   0 字节 ⇒ 永不注入，但仍在盘上可复盘。
// 依赖：libc（syscall / unistd）；本仓 foundation/bufx、tools/fsx（`fs_stat`）、
//   pm/pm_store（`PmSet`/`pm_set_sort`/`pm_kind_is_knowledge`/`PM_S_*`）、
//   pm/pm_repo（`PM_PATH_MAX`）。
// 命名：`pm_dg_*`（本文件内部）、`pm_digest`/`pm_verify`/`pm_fact_tokens`（对外）、
//   `PM_DIGEST_*` 常量。

use libc.syscall;
use libc.unistd;

export const PM_DIGEST_BUDGET: usize = 3072;   // 默认预算（字节）
export const PM_DIGEST_MIN: usize = 256;       // 低于这个值就不注入（宁可不注入也不给碎片）
export const PM_DIGEST_MAX_ITEMS: usize = 48;  // 单次注入的条数上限
export const PM_DIGEST_SECT_DIV: usize = 2;    // 单节最多占正文的 1/2（见 pm_digest）

// 分区标题里这一句较长，提成常量是为了守住 80 字符行宽（AGENTS.md）。
const PM_DG_T_CONV: &const byte =
    "Project rules (proposed unless marked confirmed)";

// 知识类分区的标题。刻意带「verify before relying on it」：蒸馏出来的结论是
// **主张**而不是事实，注入时只能当线索用（与 `Last known state` 同一语气）。
// 前一句说明「这是索引不是正文」——不写的话模型会以为拿到的是原文。
const PM_DG_T_LESSON: &const byte =
    "Lessons from earlier sessions (claims - check the source first)";

// 分区渲染顺序的数值化：
// commands(0) → conventions(1) → lessons(2) → layout(3) → state(4)。
// 这个顺序同时就是**耐久度的降序**：越靠前越稳定，也就是越晚被预算挤掉。
// `lesson` / `fact`（P107 的知识类）排在 conventions 之后、layout 之前：
// 它们比「某个文件在哪」更耐久（后者会被改动），又不如人确认过的规矩稳定。
// `fact` 与 `lesson` 共用同一节（都是蒸馏出来的结论），按 kind 分开只会多一个标题。
export fn pm_digest_order(k: u8) i32 {
    if k == PM_K_COMMANDS {
        return 0;
    }
    if k == PM_K_CONVENTIONS {
        return 1;
    }
    if k == PM_K_LESSON || k == PM_K_FACT {
        return 2;
    }
    if k == PM_K_LAYOUT {
        return 3;
    }
    return 4;
}

// 分区总数（下面的 `pm_dg_kind_at` 与 `pm_digest` 的循环共用这一份）。
const PM_DG_SECTIONS: i32 = 5;

// 第 n 个要渲染的分区（0..PM_DG_SECTIONS-1）；超出返回 255。
fn pm_dg_kind_at(n: i32) u8 {
    if n == 0 {
        return PM_K_COMMANDS;
    }
    if n == 1 {
        return PM_K_CONVENTIONS;
    }
    if n == 2 {
        return PM_K_LESSON;
    }
    if n == 3 {
        return PM_K_LAYOUT;
    }
    if n == 4 {
        return PM_K_STATE;
    }
    return 255 as u8;
}

// 分区标题（英文，与工具/协议同语；正文面向模型）。
// 「惯例」这一节刻意**不写 user-confirmed**：自动抽取的候选只是候选（`PM_S_OBSERVED`），
// 只有人 `/memory confirm` 过才是确认的（`PM_S_CONFIRMED`）。标题写死了会变成一句谎话，
// 所以确认与否标在**每一条**上（见 `pm_dg_line`）。
fn pm_dg_title(k: u8) &const byte {
    if k == PM_K_COMMANDS {
        return "Commands that worked in this project" as &const byte;
    }
    if k == PM_K_CONVENTIONS {
        return PM_DG_T_CONV as &const byte;
    }
    if k == PM_K_LESSON || k == PM_K_FACT {
        return PM_DG_T_LESSON as &const byte;
    }
    if k == PM_K_LAYOUT {
        return "Key files (index only - read them for content)" as &const byte;
    }
    return "Last known state (verify before relying on it)" as &const byte;
}

// ============================================================
// 失效校验
// ============================================================
// 一条文件类事实是否仍与盘上一致。返回：
//   0 = 一致 / 不可校验；1 = 过期（三元组对不上）；2 = 文件已不存在。
// 锚点全 0 视为「不可校验」→ 0（**不是**「过期」）：命令类事实本来就没有锚点。
//
// `ws` 是**必须**的：事实的 key 存的是 read 信封里的**相对路径**（那样模型拿到就能直接
// read —— `fs_resolve` 拒绝绝对路径），而 stat 要绝对路径。少了 ws 就会拿相对路径去
// stat 当前 cwd，结果是「所有文件都不存在」→ 全标 GONE（实测踩过：失效轮假装通过，
// 因为 GONE 那条断言也满足）。
export fn pm_verify(f: &const PmFact, ws: &const byte, ws_len: usize) i32 {
    if f.kind != PM_K_LAYOUT {
        return 0;   // 只有文件类事实带 stat 锚点
    }
    if f.mt == 0 && f.size == 0 && f.mt_ns == 0 {
        return 0;   // 没记锚点 → 不可校验
    }
    if f.key.len == 0 || f.key.len + 1 > PM_PATH_MAX {
        return 0;
    }
    var pz: Buf = buf_new(f.key.len + ws_len + 8);
    defer { buf_free(&pz); }
    // 绝对路径原样；相对路径拼到 ws 之下（与 `pm_ing_abs` 同一口径）
    if f.key.ptr[0] == 47 as byte {
        if !buf_append(&pz, f.key.ptr as &const byte, f.key.len) {
            return 0;
        }
    } else {
        // `pm_trim_slash` 返回的是**长度**（不是指针）；`ws` 是切片，取指针要用 `[0]` 的地址。
        const wsn: usize = pm_trim_slash(ws, ws_len);
        if wsn == 0 {
            return 0;
        }
        if !buf_append(&pz, &ws[0], wsn) {
            return 0;
        }
        if ws[wsn - 1] != 47 as byte {
            if !buf_append_byte(&pz, 47) {
                return 0;
            }
        }
        if !buf_append(&pz, f.key.ptr as &const byte, f.key.len) {
            return 0;
        }
    }
    if !buf_append_byte(&pz, 0) {
        return 0;
    }
    var st: FsStat = FsStat{
        exists: false, is_dir: false, size: 0, mtime: 0, mtime_nsec: 0,
    };
    _ = fs_stat(pz.ptr as &const byte, &st);
    if !st.exists || st.is_dir {
        return 2;   // 文件没了（被删 / 改名）—— 这条索引彻底失效
    }
    if st.mtime != f.mt || st.mtime_nsec != f.mt_ns || st.size != f.size {
        return 1;   // 内容变过：**索引仍有用**（路径没错），但「读到末尾 N 行」这类断言失效
    }
    return 0;
}

// ============================================================
// 渲染
// ============================================================
// 状态 token：**一条事实是不是可信、从哪来**。两段各自独立、可以同时出现：
//   ① 失效：`STALE ` / `GONE `（来自 `pm_verify`，沿用旧的大写无括号形状 ——
//      改形状会让既有的注入断言与人的读法一起失效）
//   ② 状态 / 出处：`[confirmed]` `[proposed]` `[promoted]` `[superseded]`，
//      以及知识类专属的出处 `[hand]` `[ws:xxxxxxxx]` `[sess:xxxx]`
//
// 为什么 `observed` **不印**：它是默认档，印在每一行上是纯预算税
// （实测单节封顶 1536 B、单行均长 183 B —— 每行多 11 B 等于少放 2 条命令）。
// 「没标 = 自动观察」这条约定与 `[proposed]`/`[confirmed]` 成对，读的人不会误解。
//
// 为什么出处只给知识类（`pm_kind_is_knowledge`）：command/layout/state 的 src 恒为
// 工具名（bash/read），那是形状摄取不是主张，标出来没有信息量；而 lesson/fact
// 是**蒸馏出来的主张**，它的可信度整个取决于「谁说的、能不能回溯」。
export fn pm_fact_tokens(f: &const PmFact, stale_kind: i32, out: &Buf) void {
    if stale_kind == 2 {
        _ = buf_append_cstr(out, "GONE " as &const byte);
    } else if stale_kind == 1 {
        _ = buf_append_cstr(out, "STALE " as &const byte);
    }
    if f.status == PM_S_SUPERSEDED {
        _ = buf_append_cstr(out, "[superseded] " as &const byte);
        return;   // 作废的东西不再自称出处：那一半只会让人以为它还活着
    }
    if f.status == PM_S_CONFIRMED {
        _ = buf_append_cstr(out, "[confirmed] " as &const byte);
    } else if f.kind == PM_K_CONVENTIONS {
        // 惯例的候选态是**语义**（模型提议的规矩），必须显式标出来
        _ = buf_append_cstr(out, "[proposed] " as &const byte);
    }
    if pm_fact_src_token(f, out) {
        _ = buf_append_byte(out, 32);
    }
}

// 出处 token（只对知识类事实产出；其余类别返回 false = 不印）。
// `src` 的约定由写入侧定：
//   `hand`             → `[hand]`（人或模型显式 remember）
//   `ws-distill:<hex>` → `[ws:<前 8>]`（工作区蒸馏，后缀是 bundle 指纹）
//   `sess:<id>`        → `[sess:<前 4>]`（会话蒸馏）
//   `promoted:<n>`     → `[promoted:<n>]`（从 n 个项目桶晋升）
//   其他 / 空          → `[obs]`（确定性摄取）
// ⚠ `promoted` 既是状态又是出处，这里只印出处那一段；`[promoted]` 那一段由
// 写入侧把它落成 status（见 pm_store 的 PM_S_* 注释）—— 两处合起来才是
// `[promoted] [promoted:3]`，读起来是「晋升来的、来自 3 个项目」。
fn pm_fact_src_token(f: &const PmFact, out: &Buf) bool {
    if !pm_kind_is_knowledge(f.kind) {
        return false;
    }
    const s: &const byte = f.src.ptr as &const byte;
    const n: usize = f.src.len;
    if n == 4 && bufx_mem_eq(s, "hand", 4) {
        _ = buf_append_cstr(out, "[hand]" as &const byte);
        return true;
    }
    if n > 11 && bufx_mem_eq(s, "ws-distill:", 11) {
        _ = buf_append_cstr(out, "[ws:" as &const byte);
        pm_append_head(out, s, n, 11, 8);
        _ = buf_append_byte(out, 93);
        return true;
    }
    if n > 5 && bufx_mem_eq(s, "sess:", 5) {
        _ = buf_append_cstr(out, "[sess:" as &const byte);
        pm_append_head(out, s, n, 5, 4);
        _ = buf_append_byte(out, 93);
        return true;
    }
    if n > 9 && bufx_mem_eq(s, "promoted:", 9) {
        _ = buf_append_cstr(out, "[from:" as &const byte);
        pm_append_head(out, s, n, 9, 4);
        _ = buf_append_cstr(out, " projects]" as &const byte);
        return true;
    }
    _ = buf_append_cstr(out, "[obs]" as &const byte);
    return true;
}

// 把 `s[skip .. skip+cap)` 追加到 out（不足 cap 就到尾）。
//
// ⚠ 这里**不能**写 `&s[skip]`：那是「对 `&byte` 做下标」，新版 checker 要求
// 下标带可判定的边界证明（`DEBUG_BYTE_PTR_SUBSCRIPT_ERROR`，本仓 frame.uya 就栽在
// 同一类写法上）。指针算术是仓内既有惯例（见 ag_interactive_tasks 的 `/memory ` 解析），
// 它不经过下标检查，且这里本来就只做「取一段字节」。
fn pm_append_head(out: &Buf, s: &const byte, n: usize, skip: usize,
                  cap: usize) void {
    if skip >= n {
        return;
    }
    const rest: usize = n - skip;
    // ⚠ 不能写 `const take = if rest < cap { rest } else { cap }`：0.10.x 的 codegen
    // 会把它发成 `const size_t __uya_ifexpr_0;` 再赋值 ⇒ C 编译器报
    // 「assignment of read-only variable」。用显式分支（与仓内既有写法一致）。
    var take: usize = cap;
    if rest < cap {
        take = rest;
    }
    const at: &const byte = @ptr_from_usize(
        @usize_from_ptr(s as &const void) + skip) as &const byte;
    _ = buf_append(out, at, take);
}

// 把一条事实渲染成 `<前缀>- <key> — <value> (Nx)` + 换行，**追加到 out**。
// 前缀 = 状态 token（见 `pm_fact_tokens`）；惯例类逐条标 `[confirmed]` / `[proposed]`。
fn pm_dg_line(out: &Buf, f: &const PmFact, stale_kind: i32) void {
    if f.status == PM_S_SUPERSEDED {
        return;   // 作废的知识**永不注入**（保留在盘上只为复盘，见 PM_S_SUPERSEDED）
    }
    _ = buf_append_cstr(out, "- " as &const byte);
    pm_fact_tokens(f, stale_kind, out);
    _ = buf_append(out, f.key.ptr as &const byte, f.key.len);
    if f.value.len > 0 {
        _ = buf_append_cstr(out, " — " as &const byte);
        _ = buf_append(out, f.value.ptr as &const byte, f.value.len);
    }
    if f.n > 1 {
        _ = buf_append_cstr(out, " (" as &const byte);
        _ = buf_append_i64(out, f.n as i64);
        _ = buf_append_cstr(out, "x)" as &const byte);
    }
    _ = buf_append_byte(out, 10);
}

// 把一条事实渲染进**临时缓冲**，用于「先量长度再决定收不收」。
// 为什么不直接往 out 上写再看长度：超预算时得回滚，而回滚要求记住长度 —— 临时缓冲更直白。
fn pm_dg_measure(f: &const PmFact, ws: &const byte, ws_len: usize,
                 tmp: &Buf) void {
    buf_reset(tmp);
    pm_dg_line(tmp, f, pm_verify(f, ws, ws_len));
}

// 渲染开工包。返回 false = **不该注入**（没有事实 / 预算太小 / 一条都没选中）。
// 输出形如：
//   <pm-memory>Project memory from earlier sessions in this repository. …
//   \nCommands that worked in this project:\n- make check — exit 0 (4x)\n
//   …其余分区…
//   </pm-memory>
// `s` 必须是已 `pm_set_sort` 过的（全序 → 逐字节可复现）。
export fn pm_digest(s: &const PmSet, ws: &const byte, ws_len: usize,
                    budget: usize, out: &Buf) bool {
    buf_reset(out);
    if s.n == 0 || budget < PM_DIGEST_MIN {
        return false;
    }
    // 头要短：它是**每次注入的固定税**（预算再紧也得先放下它）。那句话必须留下
    // （「这是索引不是内容」是本方案的安全前提），其余压到最短 —— 实测 229 B 的头会把
    // 260 B 的紧预算吃掉，一条正文都放不下。
    // 行宽豁免：不可断的注入文案（断行会改变注入内容）
    const hdr: &const byte = "<pm-memory>Learned from earlier sessions in this repo. This is an index, not file content: read a file before relying on its details; STALE/GONE means verify first.\n";
    const ftr: &const byte = "</pm-memory>";
    const hdr_n: usize = bufx_cstr_len(hdr);
    const ftr_n: usize = bufx_cstr_len(ftr);
    if budget <= hdr_n + ftr_n + 16 {
        return false;
    }
    // 正文可用的字节数（头和尾先扣掉 —— 宁可少一条，也不许超预算）
    const room: usize = budget - hdr_n - ftr_n;
    var body: Buf = buf_new(room + (PM_VALUE_MAX + PM_KEY_MAX) * 2);
    defer { buf_free(&body); }
    var tmp: Buf = buf_new(PM_VALUE_MAX + PM_KEY_MAX + 64);
    defer { buf_free(&tmp); }
    var items: usize = 0;
    // 单节预算上限：**没有它，commands 会把其余各节全饿死**（实测本仓真记忆目录：
    // 预算 3072 B，commands 独占 2869 B = 99%，convention/lesson/layout/state 全进不来）。
    // 那正好把设计的意图反过来 —— commands 的条数**天然最多**（每次成功的 bash 都记一条，
    // 而 layout 只在 read 时记、state 只在验证命令上记），按「谁先写满谁赢」分配，
    // 等于让最易膨胀的那一节独占预算。
    // 用 1/2 而不是更小：单节仍能吃掉一半（commands 单独在场时不浪费预算），
    // 但剩下的一半永远留给别的节。这只改**分配**，不改截断顺序（耐久度降序照旧）。
    const sect_room: usize = room / PM_DIGEST_SECT_DIV;
    var sect: i32 = 0;
    while sect < PM_DG_SECTIONS {
        const kind: u8 = pm_dg_kind_at(sect);
        var wrote_title: bool = false;
        var sect_used: usize = 0;
        var i: usize = 0;
        while i < s.n && items < PM_DIGEST_MAX_ITEMS {
            const f: &const PmFact = &s.items[i];
            i = i + 1;
            if f.kind != kind {
                continue;
            }
            pm_dg_measure(f, ws, ws_len, &tmp);
            // 渲染成 0 字节 = 这条**不该出现**（P107：`superseded` 就是这种）。
            // 不跳过的话，下面会先写一个分区标题、再追加零条 —— 屏幕上是一个
            // 只有标题的空分区，而 `items` 还被算了一条（预算/条数统计跟着失真）。
            if tmp.len == 0 {
                continue;
            }
            // 标题也要占预算：第一条确定能收时才写标题
            var title_cost: usize = 0 as usize;
            if !wrote_title {
                title_cost = bufx_cstr_len(pm_dg_title(kind)) + 4;
            }
            if body.len + title_cost + tmp.len > room {
                continue;   // 这条放不下 → 试下一条（**不是**整段截断）
            }
            if sect_used + title_cost + tmp.len > sect_room {
                break;      // 本节份额用完 → 换下一节（剩下的额度留给它们）
            }
            if !wrote_title {
                _ = buf_append_cstr(&body, "\n" as &const byte);
                _ = buf_append_cstr(&body, pm_dg_title(kind));
                _ = buf_append_cstr(&body, ":\n" as &const byte);
                wrote_title = true;
                sect_used = sect_used + title_cost;
            }
            _ = buf_append(&body, tmp.ptr as &const byte, tmp.len);
            sect_used = sect_used + tmp.len;
            items = items + 1;
        }
        sect = sect + 1;
    }
    if items == 0 {
        return false;
    }
    if !buf_append(out, hdr, hdr_n) {
        return false;
    }
    if !buf_append(out, body.ptr as &const byte, body.len) {
        return false;
    }
    return buf_append(out, ftr, ftr_n);
}
