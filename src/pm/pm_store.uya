// src/pm/pm_store.uya — 项目记忆的事实存储：只追加分片 + 归并读 + 崩溃尾裁剪（P63）
//
// 本文件：事实类型（`PmFact`/`PmKind`/`PmStatus`）、集合（`PmSet`）、生命周期
//   （`pm_set_empty`/`pm_set_free`）、JSONL 编解码（`pm_fact_encode`/`pm_fact_decode`）、
//   只追加落盘（`pm_store_append`）、归并读（`pm_store_load`）、分片尾裁剪（`pm_trim_tail`）。
// 不变量：① **绝不共享快照重写** —— 每个会话写**自己的**分片
//   `<dir>/obs/<session-id>.jsonl`，`O_APPEND` 一次写完一行。实测同一仓库根下成百个会话
//   （`/tmp` 一个 cwd 就 341 个），共享快照重写 = 最后写者赢 = 前一个会话的信念**静默消失**；
//   分片追加是唯一在「多写者 + 无锁 + 单线程」下不丢更新的形状。
//   ② 归并读的**顺序必须确定**：按 (ts, id) 升序，与分片文件名无关 —— 否则「同一批事实
//   两次读出来的顺序不同」会让开工包的渲染不可复现（自测里钉死这条）。
//   ③ 最后一行不完整（写到一半崩了）**丢掉并停**，前面的都算数（与 `sess_reader` 同口径）；
//   不报错、不半解析。
//   ④ 上限 `PM_MAX_FACTS` 恒定，淘汰**确定性**：先丢 `stale`，再按 (ts) 旧 —— 同输入同输出。
//   ⑤ 读路径**不建目录、不写盘**：拿不到就返回空集（没有记忆是最常见的状态）。
// 依赖：libc（syscall / unistd）；本仓 foundation/bufx（Buf / buf_*）、foundation/jsonx
//   （JsonValue / JsonStrView / js_parse / js_obj_get / jw_*）、tools/fsx（`fs_stat`）、
//   pm/pm_repo（`pm_dir`/`pm_ensure_dir`/`pm_append_file`）、session/session（`sess_*` 的
//   目录枚举复用 `pm_store_load` 自己走 getdents64）。
// 命名：`pm_*`、`PmFact`/`PmSet`、`PM_*` 常量。

use libc.syscall;
use libc.unistd;
use std.mem.arena.Arena;

// ============================================================
// 常量
// ============================================================
export const PM_MAX_FACTS: usize = 512;      // 载入内存的事实条数上限
export const PM_VALUE_MAX: usize = 2048;     // 单条 value 的字节上限
export const PM_KEY_MAX: usize = 256;        // 单条 key 的字节上限
const PM_LINE_MAX: usize = 16384;            // 单行 JSONL 上限（超过的直接跳过）
const PM_FILE_MAX: usize = 1048576;          // 单个分片读取上限 1 MiB
const PM_LINEBUF: usize = PM_LINE_MAX + 64;  // 拼一行的临时缓冲

// 事实类别（渲染时的分区顺序也按这个值）
export const PM_K_LAYOUT: u8 = 0;      // 目录结构 / 关键文件路径
export const PM_K_COMMANDS: u8 = 1;    // 构建 / 自测 / 验收命令
export const PM_K_CONVENTIONS: u8 = 2; // 人工确认的惯例（模型只能提议）
export const PM_K_STATE: u8 = 3;       // 上次到哪、什么还红着

// 事实状态
export const PM_S_OBSERVED: u8 = 0;    // 自动观察到的
export const PM_S_CONFIRMED: u8 = 1;   // 人工确认过的（只有 conventions 能到这一档）
export const PM_S_STALE: u8 = 2;       // 校验失败：注入时降级为「提示，需自行确认」

// ============================================================
// 类型
// ============================================================
// 一条项目事实。`key` 是「关于什么」（文件路径 / 命令 / 惯例名），`value` 是内容。
// `mt_*` 是校验锚点：文件类事实记 stat 三元组，注入时重新 stat 比对（实测 19.2% 的
// 被读文件之后会被改动 —— 不校验就等于注入过期货）。
export struct PmFact {
    kind: u8,
    status: u8,
    ts: i64,          // 首次观察时刻（毫秒）
    ts_last: i64,     // 最近一次观察时刻
    n: i32,           // 观察次数（同一事实重复观察到就累加）
    key: Buf,
    value: Buf,
    src: Buf,         // 出处：会话 id 或工具名
    mt: i64,          // mtime（秒），0 = 不校验
    mt_ns: i64,       // mtime 纳秒
    size: i64,        // 文件大小
}

export struct PmSet {
    items: [PmFact: PM_MAX_FACTS],
    n: usize,
    dropped: usize,   // 因上限被丢掉的条数（诊断用）
}

// 零值事实：全部空 Buf + 零计数。全局数组初始化式必须是常量，只能这样逐个填。
fn pm_fact_empty() PmFact {
    return PmFact{
        kind: PM_K_LAYOUT, status: PM_S_OBSERVED, ts: 0, ts_last: 0, n: 0,
        key: buf_empty(), value: buf_empty(), src: buf_empty(),
        mt: 0, mt_ns: 0, size: 0,
    };
}

// 零值集合。调用方拿到后直接 `defer pm_set_free`。
export fn pm_set_empty() PmSet {
    return PmSet{ items: [], n: 0, dropped: 0 };
}

// 释放 `[0, n)` 的三个 Buf 并归零。幂等。
export fn pm_set_free(s: &PmSet) void {
    var i: usize = 0;
    while i < s.n {
        buf_free(&s.items[i].key);
        buf_free(&s.items[i].value);
        buf_free(&s.items[i].src);
        s.items[i] = pm_fact_empty();
        i = i + 1;
    }
    s.n = 0;
    s.dropped = 0;
}

// 类别 → 稳定的英文短名（落盘与渲染都用它，不许改字面量：改了旧分片就读不回来）。
export fn pm_kind_name(k: u8) &const byte {
    if k == PM_K_COMMANDS {
        return "command" as &const byte;
    }
    if k == PM_K_CONVENTIONS {
        return "convention" as &const byte;
    }
    if k == PM_K_STATE {
        return "state" as &const byte;
    }
    return "layout" as &const byte;
}

// 短名 → 类别；认不出来返回 0xFF（调用方据此**跳过该行**而不是猜一个类别）。
export fn pm_kind_of(v: &const JsonStrView) u8 {
    if v.len == 6 && bufx_mem_eq(v.ptr as &const byte, "layout", 6) {
        return PM_K_LAYOUT;
    }
    if v.len == 7 && bufx_mem_eq(v.ptr as &const byte, "command", 7) {
        return PM_K_COMMANDS;
    }
    if v.len == 10 && bufx_mem_eq(v.ptr as &const byte, "convention", 10) {
        return PM_K_CONVENTIONS;
    }
    if v.len == 5 && bufx_mem_eq(v.ptr as &const byte, "state", 5) {
        return PM_K_STATE;
    }
    return 255 as u8;
}

// ============================================================
// 编码 / 解码
// ============================================================
// 把一条事实编码成**一行** JSONL（含结尾 `\n`）写进 out（先 reset）。
// 字段顺序固定，便于自测逐字节比对。字符串一律走 jw_str（转义），
// 所以 value 里带引号 / 换行 / 反斜杠都不会破坏 JSONL 的行边界。
export fn pm_fact_encode(f: &const PmFact, out: &Buf) bool {
    buf_reset(out);
    var w: JsonWriter = JsonWriter{ buf: null, cap: 0, len: 0, overflow: false };
    // 直接手拼（比 JsonWriter 少一层容量管理，且这里字段少、形状固定）
    if !buf_append_cstr(out, "{\"kind\":\"") {
        return false;
    }
    if !buf_append_cstr(out, pm_kind_name(f.kind)) {
        return false;
    }
    if !buf_append_cstr(out, "\",\"status\":") {
        return false;
    }
    if !buf_append_i64(out, f.status as i64) {
        return false;
    }
    if !buf_append_cstr(out, ",\"ts\":") || !buf_append_i64(out, f.ts) {
        return false;
    }
    if !buf_append_cstr(out, ",\"tsLast\":") || !buf_append_i64(out, f.ts_last) {
        return false;
    }
    if !buf_append_cstr(out, ",\"n\":") || !buf_append_i64(out, f.n as i64) {
        return false;
    }
    if !buf_append_cstr(out, ",\"mt\":") || !buf_append_i64(out, f.mt) {
        return false;
    }
    if !buf_append_cstr(out, ",\"mtNs\":") || !buf_append_i64(out, f.mt_ns) {
        return false;
    }
    if !buf_append_cstr(out, ",\"size\":") || !buf_append_i64(out, f.size) {
        return false;
    }
    if !buf_append_cstr(out, ",\"key\":") {
        return false;
    }
    if !jw_str_into(out, f.key.ptr as &const byte, f.key.len) {
        return false;
    }
    if !buf_append_cstr(out, ",\"value\":") {
        return false;
    }
    if !jw_str_into(out, f.value.ptr as &const byte, f.value.len) {
        return false;
    }
    if !buf_append_cstr(out, ",\"src\":") {
        return false;
    }
    if !jw_str_into(out, f.src.ptr as &const byte, f.src.len) {
        return false;
    }
    _ = w;
    return buf_append_cstr(out, "}\n");
}

// 解码一行 JSONL 到 f（f 已归零或复用；函数内部先 free 三个 Buf 再填）。
// 认不出的 kind、缺 key、解析失败一律返回 false（调用方跳过该行）—— 绝不半填。
export fn pm_fact_decode(line: &const byte, n: usize, arena: &Arena, f: &PmFact) bool {
    if n == 0 || n > PM_LINE_MAX {
        return false;
    }
    var root: JsonValue = JsonValue.json_null();
    if !js_parse(arena, line as &byte, n, &root) {
        return false;
    }
    var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if !js_obj_get_str(&root, "kind", 4, &sv) {
        return false;
    }
    const k: u8 = pm_kind_of(&sv);
    if k == 255 as u8 {
        return false;
    }
    var iv: JsonValue = JsonValue.json_null();
    var v: i64 = 0;
    var nv: i64 = 0;
    var ts: i64 = 0;
    var tsl: i64 = 0;
    if js_obj_get(&root, "ts", 2, &iv) && js_i64_of(&iv, &v) {
        ts = v;
    }
    if js_obj_get(&root, "tsLast", 6, &iv) && js_i64_of(&iv, &v) {
        tsl = v;
    }
    if js_obj_get(&root, "n", 1, &iv) && js_i64_of(&iv, &v) {
        nv = v;
    }
    var st: i64 = 0;
    if js_obj_get(&root, "status", 6, &iv) && js_i64_of(&iv, &v) {
        st = v;
    }
    var mt: i64 = 0;
    var mtn: i64 = 0;
    var sz: i64 = 0;
    if js_obj_get(&root, "mt", 2, &iv) && js_i64_of(&iv, &v) {
        mt = v;
    }
    if js_obj_get(&root, "mtNs", 4, &iv) && js_i64_of(&iv, &v) {
        mtn = v;
    }
    if js_obj_get(&root, "size", 4, &iv) && js_i64_of(&iv, &v) {
        sz = v;
    }
    var key: Buf = buf_new(PM_KEY_MAX);
    defer { buf_free(&key); }
    if !js_obj_get_str_unescaped(&root, "key", 3, &key) || key.len == 0 {
        return false;
    }
    var val: Buf = buf_new(PM_VALUE_MAX);
    defer { buf_free(&val); }
    _ = js_obj_get_str_unescaped(&root, "value", 5, &val);
    var src: Buf = buf_new(256);
    defer { buf_free(&src); }
    _ = js_obj_get_str_unescaped(&root, "src", 3, &src);
    // 到这里才算解析成功。**拷贝**进 f，不转移指针 —— 三个局部量在 defer 里被释放，
    // 若把它们的指针赋给 f（转移所有权），defer 就会释放 f 正在用的内存（实测踩过：
    // 表现为读取路径卡死）。
    buf_reset(&f.key);
    buf_reset(&f.value);
    buf_reset(&f.src);
    if !buf_append(&f.key, key.ptr as &const byte, key.len) {
        return false;
    }
    _ = buf_append(&f.value, val.ptr as &const byte, val.len);
    _ = buf_append(&f.src, src.ptr as &const byte, src.len);
    f.kind = k;
    f.status = if st < 0 || st > 2 { PM_S_OBSERVED } else { st as u8 };
    f.ts = ts;
    f.ts_last = tsl;
    f.n = if nv < 0 { 0 } else { nv as i32 };
    f.mt = mt;
    f.mt_ns = mtn;
    f.size = sz;
    return true;
}

// ============================================================
// 落盘：分片只追加
// ============================================================
// 把 `<dir>/obs/<session-id>.jsonl` 的路径写进 out（不含 NUL）。
export fn pm_shard_path(dir: &const byte, dir_len: usize, sid: &const byte, sid_len: usize, out: &Buf) bool {
    buf_reset(out);
    if !buf_append(out, dir, dir_len) {
        return false;
    }
    if !buf_append_cstr(out, "/obs/") {
        return false;
    }
    if sid_len == 0 {
        return buf_append_cstr(out, "nosession.jsonl");
    }
    if !buf_append(out, sid, sid_len) {
        return false;
    }
    // 扩展名是**读写两侧的契约**：`pm_store_load` 只收 `.jsonl`（跳过 `.tmp` 残留），
    // 这里漏掉就会「写进去、读不出来」—— 实测踩过（分片叫 `sess-1`，载入 0 条）。
    return buf_append_cstr(out, ".jsonl");
}

// 追加一条事实到本会话的分片。**一行一次 write**（`O_APPEND`），多写者并发不互相覆盖。
// 返回是否写成功；失败**不报错**（记忆是尽力而为的旁路，不能因为盘满就打断一次回合）。
export fn pm_store_append(dir: &const byte, dir_len: usize, sid: &const byte, sid_len: usize, f: &const PmFact) bool {
    var obs: Buf = buf_new(dir_len + 16);
    defer { buf_free(&obs); }
    if !pm_ensure_sub(dir, dir_len, "obs" as &const byte, &obs) {
        return false;
    }
    var path: Buf = buf_new(dir_len + 64);
    defer { buf_free(&path); }
    if !pm_shard_path(dir, dir_len, sid, sid_len, &path) {
        return false;
    }
    if !buf_append_byte(&path, 0) {
        return false;
    }
    var line: Buf = buf_new(PM_LINEBUF);
    defer { buf_free(&line); }
    if !pm_fact_encode(f, &line) {
        return false;
    }
    return pm_append_file(path.ptr as &const byte, line.ptr as &const byte, line.len);
}

// ============================================================
// 载入：扫 <dir>/obs/*.jsonl 并按 (ts, key) 归并
// ============================================================
// 在集合里找一条「同类 + 同 key」的事实，找到返回下标，否则 -1。
fn pm_find(s: &const PmSet, kind: u8, key: &const byte, kn: usize) isize {
    var i: usize = 0;
    while i < s.n {
        const f: &const PmFact = &s.items[i];
        if f.kind == kind && f.key.len == kn && bufx_mem_eq(f.key.ptr as &const byte, key, kn) {
            return i as isize;
        }
        i = i + 1;
    }
    return -1;
}

// 归并一条事实进集合：同 (kind, key) 已存在则**就地合并**（次数累加、时间取晚、
// 校验锚点与 value 取**最新那次观察**的），否则追加一条。
// 为什么按 (kind,key) 去重而不是每行留一条：同一文件在 10 个会话里各记一次读，
// 渲染时应该是一行「读过 10 次」，不是 10 行 —— 否则开工包会被重复项撑爆。
//
// **value / 校验锚点必须按 `ts_last` 取最新，不能「谁后读到用谁」**：分片枚举顺序由
// 文件系统决定（getdents64 的顺序），「谁后读到」等于把结果绑在目录顺序上 —— 同一批事实
// 两次读出的渲染就可能不同，开工包也就不可复现了（自测的「另一种交错顺序」那条钉这个）。
export fn pm_set_merge(s: &PmSet, f: &PmFact) void {
    const at: isize = pm_find(s, f.kind, f.key.ptr as &const byte, f.key.len);
    if at >= 0 {
        const idx: usize = at as usize;
        if idx < PM_MAX_FACTS {
            const d: &PmFact = &s.items[idx];
            d.n = d.n + f.n;
            // 这条 incoming 是否比已存的那条更新？（相等时**不覆盖**，保证幂等）
            const newer: bool = f.ts_last > d.ts_last;
            if newer {
                d.ts_last = f.ts_last;
                if f.value.len > 0 {
                    buf_reset(&d.value);
                    _ = buf_append(&d.value, f.value.ptr as &const byte, f.value.len);
                }
                if f.mt != 0 || f.size != 0 {
                    d.mt = f.mt;
                    d.mt_ns = f.mt_ns;
                    d.size = f.size;
                }
                if f.src.len > 0 {
                    buf_reset(&d.src);
                    _ = buf_append(&d.src, f.src.ptr as &const byte, f.src.len);
                }
            }
            if f.ts > 0 && (d.ts == 0 || f.ts < d.ts) {
                d.ts = f.ts;
            }
            if f.status == PM_S_CONFIRMED {
                d.status = PM_S_CONFIRMED;
            }
            return;
        }
    }
    if s.n >= PM_MAX_FACTS {
        s.dropped = s.dropped + 1;
        return;
    }
    const slot: &PmFact = &s.items[s.n];
    buf_reset(&slot.key);
    buf_reset(&slot.value);
    buf_reset(&slot.src);
    _ = buf_append(&slot.key, f.key.ptr as &const byte, f.key.len);
    _ = buf_append(&slot.value, f.value.ptr as &const byte, f.value.len);
    _ = buf_append(&slot.src, f.src.ptr as &const byte, f.src.len);
    slot.kind = f.kind;
    slot.status = f.status;
    slot.ts = f.ts;
    slot.ts_last = f.ts_last;
    slot.n = f.n;
    slot.mt = f.mt;
    slot.mt_ns = f.mt_ns;
    slot.size = f.size;
    s.n = s.n + 1;
}

// 解析一段分片内容（多次 `\n` 分行）并归并进集合。
// 最后一行没有 `\n` 结尾 → **丢掉并停**（写到一半崩了），与 `sess_next` 同口径。
fn pm_merge_shard(s: &PmSet, data: &const Buf) void {
    var arena_raw: &void = malloc(65536);
    defer { free(arena_raw); }
    if ((arena_raw as &byte) as usize) == 0 {
        return;
    }
    var from: usize = 0;
    while from < data.len {
        const nl: isize = bufx_find_byte(data.ptr[0: data.len], 10, from);
        if nl < 0 {
            break;   // 尾行不完整：丢掉
        }
        const stop: usize = nl as usize;
        if stop > from {
            var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
            arena_init(&arena, arena_raw as &byte, 65536);
            var f: PmFact = pm_fact_empty();
            if pm_fact_decode(&data.ptr[from], stop - from, &arena, &f) {
                pm_set_merge(s, &f);
            }
            buf_free(&f.key);
            buf_free(&f.value);
            buf_free(&f.src);
        }
        from = stop + 1;
    }
}

// 读一个分片文件并归并进集合。读不到（不存在 / 空）**不算错误**。
fn pm_load_shard(s: &PmSet, path_z: &const byte) void {
    var data: Buf = buf_new(8192);
    defer { buf_free(&data); }
    if !fs_read_file_all(path_z, &data, PM_FILE_MAX) || data.len == 0 {
        return;
    }
    pm_merge_shard(s, &data);
}

// 扫 `<dir>/obs/` 下**全部**分片并归并进 s（s 先 free 再填）。
// 顺序无关：结果是按 (kind,key) 归并过的事实集，而渲染前还会再排一次序
// （`pm_set_sort`），所以分片枚举顺序不影响输出 —— 这条由自测的「同输入同输出」钉死。
export fn pm_store_load(dir: &const byte, dir_len: usize, s: &PmSet) bool {
    pm_set_free(s);
    var obs: Buf = buf_new(dir_len + 16);
    defer { buf_free(&obs); }
    if !buf_append(&obs, dir, dir_len) {
        return false;
    }
    if !buf_append_cstr(&obs, "/obs") {
        return false;
    }
    var pz: Buf = buf_new(obs.len + 1);
    defer { buf_free(&pz); }
    if !buf_append(&pz, obs.ptr as &const byte, obs.len) || !buf_append_byte(&pz, 0) {
        return false;
    }
    const fd: i32 = sys_open(&pz.ptr[0] as *const byte, (O_RDONLY | O_DIRECTORY) as i32, 0) catch {
        return false;   // 没有记忆目录 = 没有记忆，不是错误
    };
    var name: [byte: 4096] = [0: 4096];
    while true {
        const rc: isize = sys_getdents64(fd, &name[0], 4096) catch {
            break;
        };
        if rc <= 0 {
            break;
        }
        var off: usize = 0;
        const total: usize = rc as usize;
        while off + 19 <= total {
            const reclen: usize = (name[off + 16] as usize) | ((name[off + 17] as usize) << 8);
            if reclen == 0 || off + reclen > total {
                break;
            }
            const dt: byte = name[off + 18];
            const cname: &byte = &name[off + 19];
            const cl: usize = bufx_cstr_len(cname);
            // 只收普通文件，且只收 `.jsonl`（跳过 .tmp 残留等）
            const is_file: bool = dt == 8 as byte || dt == 0 as byte;
            const is_jsonl: bool = cl > 6 && bufx_mem_eq(&cname[cl - 6], ".jsonl", 6);
            if is_file && is_jsonl {
                var one: Buf = buf_new(obs.len + cl + 2);
                defer { buf_free(&one); }
                if buf_append(&one, obs.ptr as &const byte, obs.len) {
                    _ = buf_append_byte(&one, 47);
                    _ = buf_append(&one, cname, cl);
                    if buf_append_byte(&one, 0) {
                        pm_load_shard(s, one.ptr as &const byte);
                    }
                }
            }
            off = off + reclen;
        }
    }
    _ = sys_close(fd) catch {};
    return true;
}

// ============================================================
// 排序与淘汰
// ============================================================
// 事实的**全序**：类别升序 → ts_last 降序（新的在前）→ key 字典序升序。
// 三级都给，是为了让「同一批事实」在任何环境下都产出**逐字节相同**的渲染结果：
// 只按 ts 排会在时间相同时退化成「分片枚举顺序」，那就不可复现了。
fn pm_fact_less(a: &const PmFact, b: &const PmFact) bool {
    if a.kind != b.kind {
        return a.kind < b.kind;
    }
    if a.ts_last != b.ts_last {
        return a.ts_last > b.ts_last;
    }
    const n: usize = if a.key.len < b.key.len { a.key.len } else { b.key.len };
    var i: usize = 0;
    while i < n {
        if a.key.ptr[i] != b.key.ptr[i] {
            return a.key.ptr[i] < b.key.ptr[i];
        }
        i = i + 1;
    }
    return a.key.len < b.key.len;
}

// 就地插入排序（PM_MAX_FACTS 是 512，插入排序最坏也就 13 万次比较；而它是**稳定**的
// 且无递归 —— 对「确定性优先」的这条路径比快排更合适）。
// 只能用**下标交换**，不能把数组元素搬到局部变量：Uya 的 checker 不许在循环里移动
// 数组元素（「循环中的变量不能移动」）。所以这里用 `pm_fact_swap` 做三步交换。
fn pm_fact_swap(a: &PmFact, b: &PmFact) void {
    const t0: u8 = a.kind;
    const t1: u8 = a.status;
    const t2: i64 = a.ts;
    const t3: i64 = a.ts_last;
    const t4: i32 = a.n;
    const t5: i64 = a.mt;
    const t6: i64 = a.mt_ns;
    const t7: i64 = a.size;
    const t8: Buf = a.key;
    const t9: Buf = a.value;
    const t10: Buf = a.src;
    a.kind = b.kind;
    a.status = b.status;
    a.ts = b.ts;
    a.ts_last = b.ts_last;
    a.n = b.n;
    a.mt = b.mt;
    a.mt_ns = b.mt_ns;
    a.size = b.size;
    a.key = b.key;
    a.value = b.value;
    a.src = b.src;
    b.kind = t0;
    b.status = t1;
    b.ts = t2;
    b.ts_last = t3;
    b.n = t4;
    b.mt = t5;
    b.mt_ns = t6;
    b.size = t7;
    b.key = t8;
    b.value = t9;
    b.src = t10;
}

// 按 `pm_fact_less` 的全序就地排好整个集合（`pm_store_load` 之后、渲染之前调用）。
// 不排序也能用，但「同一批事实两次读出逐字节相同」这条保证就没了。
export fn pm_set_sort(s: &PmSet) void {
    var i: usize = 1;
    while i < s.n {
        var j: usize = i;
        while j > 0 && pm_fact_less(&s.items[j], &s.items[j - 1]) {
            pm_fact_swap(&s.items[j], &s.items[j - 1]);
            j = j - 1;
        }
        i = i + 1;
    }
}
