// src/plugin/mcptool.uya — MCP 工具的 schema 片段 + `mcp` 元工具（P70）
//
// 本文件：把 MCP `tools/list` 拿到的工具渲染成**请求体里能直接拼的那一段 JSON**
//   （`mcp_tools_append`，两种协议形状各一份），以及给模型用的 `mcp` 元工具
//   （`mcp_tool_meta`：list / reload）。
// 不变量：① **一个 server 都没配（或一个工具都没发现）时，一个字节都不追加** ——
//   `tools_json` 的产物与改动前逐字节相同（自测钉这一条，它保证「没装插件 = 零影响」）。
//   ② 工具顺序**按发现顺序**（= `tools/list` 的返回序，server 与工具名都稳定），
//   不额外排序：同一份配置的产物必须逐字节可复现，否则前缀缓存每轮失效。
//   ③ 只有**一份** schema 真值：chat 形状（`{"type":"function","function":{…}}`）与
//   responses 形状（`{"type":"function","name":…,"parameters":…}`）由同一份字段拼出来，
//   不各写一遍 —— 与 `ag_tools_schema.uya` 的 `tools_put` 同一条纪律（那边用文本变换，
//   这边字段本来就在手上，直接按形状拼）。
// 依赖：libc.syscall/unistd；本仓 foundation/bufx、session/session（`jw_str_into`）、
//   agent/ag_config（`Config`）、plugin/mcp（门面：工具表与诊断）、plugin/mcpcfg。
// 命名：对外 `mcp_tools_*` / `mcp_tool_meta` + `MCP_*`；私有同样 `mcp_` 前缀。
//
// 为什么 provider 名与 raw 名都要在 schema 里出现：模型看到的是**公开名**
// （`mcp__<server>__<raw>`，归一化后可能与 raw 不同），派发时用公开名反查回 raw 再上线
// （`mcp_tool_try`）。schema 里给公开名，raw 名只出现在 description 的提示里（人读）。

use libc.syscall;
use libc.unistd;

// `mcp` 元工具的 schema（常量；形状与 `ag_tools_schema.uya` 的其它 TOOL_* 一致）
// 行宽豁免：错误文案/诊断行是**单条不可断的字面量**（Uya 没有相邻字面量拼接）
const TOOL_MCP: &const byte = `{"type":"function","function":{"name":"mcp","description":"Inspect or reload the MCP plugin servers configured for this workspace. Use {\"action\":\"list\"} to see each server, its tools and why a server failed to load; use {\"action\":\"reload\"} after installing or reconfiguring a server (this restarts the server processes and refreshes the tool list).","parameters":{"type":"object","properties":{"action":{"type":"string","description":"list (default) | reload"}},"required":["action"]}}}`;

// 顶层去前缀（与 `ag_tools_schema.uya` 的 `TOOL_FLAT_STRIP` 逐字相同 —— 两份必须一致，
// 否则 `mcp` 元工具在 responses 形状下会被拼成错的形状）
const MCP_FLAT_STRIP: &const byte = `{"type":"function","function":{`;

// 把 `mcp` 元工具的 schema 追加进 out（`flat` 语义与 `tools_put` 相同）
export fn mcp_tools_put_meta(out: &Buf, flat: bool) bool {
    if out.len > 1 && !buf_append_byte(out, 44) {
        return false;
    }
    if !flat {
        return buf_append_cstr(out, TOOL_MCP);
    }
    const n: usize = bufx_cstr_len(TOOL_MCP);
    if n < 33 || !bufx_eq_cstr(TOOL_MCP, 31, MCP_FLAT_STRIP) {
        return false;
    }
    if !buf_append_cstr(out, `{"type":"function",`) {
        return false;
    }
    return buf_append_span(out, TOOL_MCP, 31, n - 32);
}

// 把已发现的 MCP 工具追加进 tools 数组（调用方保证 out 已经是 `[...` 且至少有一条）。
//
// `flat = false` →
// chat/completions：`{"type":"function","function":{name,description,parameters}}`
// `flat = true`  → responses：
// `{"type":"function",name,description,parameters}`
//
// 逐条拼而**不做**文本变换（那边是「常量只有一份」的手段；这里字段本来就在手上，
// 变换一份再反变换反而多一层出错面）。两种形状的**字段来源完全相同**，不会漂移。
export fn mcp_tools_append(out: &Buf, flat: bool) bool {
    var i: usize = 0;
    while i < MCP_TOOLS_MAX {
        if i >= mcp_tool_count() {
            break;
        }
        const t: &const McpTool = mcp_tool_at(i);
        if t == null as &const McpTool {
            break;
        }
        if !buf_append_byte(out, 44) {   // ','
            return false;
        }
        if !buf_append_cstr(out, `{"type":"function",`) {
            return false;
        }
        if !flat {
            if !buf_append_cstr(out, `"function":{`) {
                return false;
            }
        }
        if !buf_append_cstr(out, `"name":`) {
            return false;
        }
        if !jw_str_into(out, t.public.ptr as &const byte, t.public.len) {
            return false;
        }
        if !buf_append_cstr(out, `,"description":`) {
            return false;
        }
        // desc 已经是转义好的带引号字符串（`mcp_tool_from_frag` 里过的 `jw_str_into`）
        if !buf_append(out, t.desc.ptr, t.desc.len) {
            return false;
        }
        if !buf_append_cstr(out, `,"parameters":`) {
            return false;
        }
        // schema 是 MCP 给的 inputSchema 原文（JSON Schema 对象）
        if !buf_append(out, t.schema.ptr, t.schema.len) {
            return false;
        }
        if !flat {
            if !buf_append_byte(out, 125) {   // '}' 收 function
                return false;
            }
        }
        if !buf_append_byte(out, 125) {   // '}' 收整条
            return false;
        }
        i = i + 1;
    }
    return true;
}

// `mcp` 元工具的实现。
//
// 为什么需要一个元工具，而不是只靠 `--list-plugins`：`--list-plugins` 是**启动前的**
// 一次性输出，而 MCP server 的状态是会话内会变的（装了个 server、server 崩了、
// 工具列表换了）。模型（和人）需要一个「现在到底怎么样了」的入口 —— 这就是它。
//
// 结果形状（纯文本，与其它工具一致）：
//   MCP servers: N
//   fs: 3 tool(s)            ← 每行一个 server
//   broken: no tools (MCP server exited or closed the pipe)
//   配置里扫到但跑不了的进程内 cordis 插件：unsupported: <包名>（每行一条）
export fn mcp_tool_meta(cfg: &Config, args: &const JsonValue, out: &Buf) void {
    var action: Buf = buf_new(64);
    defer { buf_free(&action); }
    _ = js_obj_get_str_unescaped(args, "action" as &const byte, 6, &action);
    const is_reload: bool = bufx_eq_cstr(action.ptr as &const byte, action.len, "reload" as &const byte);
    if is_reload {
        mcp_reload(cfg.workspace.ptr[0: cfg.workspace.len], agent_dsh_home(), cfg.mcp_off, &cfg.mcp_servers);
    } else if action.len > 0 && !bufx_eq_cstr(action.ptr as &const byte, action.len, "list" as &const byte) {
        _ = buf_append_cstr(out, "Error: unknown action (expected \"list\" or \"reload\")");
        return;
    } else {
        // list：确保配置已发现（第一次调用 `mcp` 也要能看到 server）
        mcp_ensure(cfg.workspace.ptr[0: cfg.workspace.len], agent_dsh_home(), cfg.mcp_off, &cfg.mcp_servers);
    }
    if cfg.mcp_off {
        _ = buf_append_cstr(out, "MCP plugins are disabled (--no-mcp).");
        return;
    }
    _ = buf_append_cstr(out, "MCP servers: ");
    _ = buf_append_u64(out, mcp_server_count() as u64);
    _ = buf_append_cstr(out, "\n");
    const d: &const Buf = mcp_diag_text();
    if mcp_server_count() == 0 {
        _ = buf_append_cstr(out, "(none configured; see README \"插件（MCP）\" for the config shape)\n");
    } else if buf_valid(d) && d.len > 0 {
        // 诊断行就是「每个 server 一句话」的形状（mcp_list_tools 写的）
        _ = buf_append(out, d.ptr, d.len);
        _ = buf_append_byte(out, 10);
    } else {
        _ = buf_append_cstr(out, "(configured but not contacted yet)\n");
    }
    _ = buf_append_cstr(out, "MCP tools: ");
    _ = buf_append_u64(out, mcp_tool_count() as u64);
    _ = buf_append_cstr(out, "\n");
    var i: usize = 0;
    while i < mcp_tool_count() && i < MCP_TOOLS_MAX {
        const t: &const McpTool = mcp_tool_at(i);
        if t != null as &const McpTool {
            _ = buf_append(out, t.public.ptr as &const byte, t.public.len);
            _ = buf_append_cstr(out, " ← ");
            _ = buf_append(out, t.server.ptr as &const byte, t.server.len);
            _ = buf_append_byte(out, 47);   // '/'
            _ = buf_append(out, t.raw.ptr as &const byte, t.raw.len);
            _ = buf_append_byte(out, 10);
        }
        i = i + 1;
    }
    const u: &const Buf = mcp_unsupported_text();
    if buf_valid(u) && u.len > 0 {
        _ = buf_append_cstr(out, "unsupported (in-process cordis plugins cannot run out of process):\n");
        _ = buf_append(out, u.ptr, u.len);
        _ = buf_append_byte(out, 10);
    }
}
