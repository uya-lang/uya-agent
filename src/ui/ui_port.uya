// src/ui/ui_port.uya — 界面后端接缝：接口、常量、注册表
//
// 本文件：`UiBackend` 接口（界面后端的唯一契约）、常量（通道 `UI_CH_*` / 状态
//   `UI_ST_*` / 运行态 `UI_RUN_*` / 问项 `UI_ON_*` / 提问种类 `UI_ASK_*` / 回答状态
//   `UI_ANS_*` / 后端号 `UI_BE_*`）、请求与回答结构（`UiReq` / `UiAns`）、注册表
//   （`g_reg` / `g_ui`）与选择（`ui_use` / `ui_kind` / `ui_kind_name` / `ui_on`）。
// 不变量：① **接口值只能由「具体 struct → 接口变量」的赋值构造**（`var r: I = g_reg[i];`）。
//   `&具体struct as &接口` 能编译、能链接，但**运行期 SIGSEGV**（codegen 不构造
//   {vtable, data} 对）—— 见 CODING.md §1.4 的三禁与陷阱；② 注册表索引**处处显式夹取**
//   （Uya 的边界证明器只认「正的 if 里做索引」）；③ `g_reg` 的每个槽在 init 里都必须
//   被填上接口值 —— 空槽的 vtable 是 null，调用即崩；④ 本文件**不许认识 `Config` /
//   `agent_` / `g_sess`**（端口层不认识执行核，否则后端换不动、也不可独立自测）。
// 依赖：foundation/bufx（Buf / buf_*）；各后端（be_null / be_tui / be_scroll）。
//   **不依赖 `term/` 与 `agent/`** —— 这是本域存在的全部意义。
// 命名：对外 `ui_` + `UI_*`；类型 `UiBackend` / `UiReq` / `UiAns`；后端私有见各自文件头。
//
// 为什么是 `interface` 而不是「u8 tag + match」（0.10.3 实测）：
//   * `fn(i32) i32` 这类**函数指针类型编译器不支持**（`意外的 token 'fn'`），所以
//     「函数指针表」这条路走不通；
//   * `interface` 是**真 vtable 派发**，而且**漏实现方法是编译期错误**
//     （`结构体 'X' 缺少接口要求的方法: 'y'`）—— tag + match 漏一个分支是**运行期静默
//     走错**，接口漏一个是**编译期报错**。这是选它的全部理由。
//
// 后端的职责边界（端口只收「效果」，不收「排版」）：
//   * **进端口**：会碰终端、会阻塞等用户、会改变屏幕的那些（`text` / `status` / `pump` /
//     `ask` / `start` / `stop`）；
//   * **不进端口**：纯排版数学（`tty_clip_bytes` / `tty_cols_between` / 显示宽度 /
//     markdown / `view_render_block`）—— 它们无副作用，是所有后端共用的**共享库**，
//     留在 `term/`，谁都能直接调。

// 没有问答渠道（管道 / CI / 子代理 / headless / 浮层画不出来）。
// **fail closed**：调用方拿到它必须当作「没批准」，绝不许当「批准」用。
export error UiNoChannel;

// ---- 文本通道（`text` 方法的 chan 参数）----
// ⚠ **本表与 TUI 内部的编号不是同一套**（实测）：TUI 的 `tui_sink_bytes` 是
//   1=正文 / 2=通知（按行切开）/ 3=思考（`tty_reason_write` 送的）。所以后端的
//   `text` 实现**必须过一张显式映射表**，`tui_sink_bytes(chan, …)` 这种原样转发会把
//   **思考和通知对调** —— 不崩、不报错、编译期看不见，只是内容串位。
//   `make ui-audit` 的判据 G 就是钉这条的。
export const UI_CH_MAIN: u8 = 1;      // 正文（模型输出、工具结果回显）
export const UI_CH_REASON: u8 = 2;    // 思考（reasoning）
export const UI_CH_NOTICE: u8 = 3;    // 通知（命令回执、错误提示）

// ---- 状态通道（`status` 方法的 what 参数）----
export const UI_ST_RUN: u8 = 1;       // 运行态（idle / 思考中 / 流式中 / 跑工具）
export const UI_ST_TEXT: u8 = 2;      // 常驻状态区文本
export const UI_ST_TASKS: u8 = 3;     // 任务块快照（todo/后台/子代理/目标折叠文本）
export const UI_ST_PLAN: u8 = 4;      // plan 模式开关（"1" / "0"）
export const UI_ST_ACCESS: u8 = 5;    // 访问模式（PERM_* 的十进制）
export const UI_ST_MODEL: u8 = 6;     // 模型 / 提供方 / 强度
export const UI_ST_CTX: u8 = 7;       // 上下文占用（百分比 / -1）

// ---- 离散条目种类（`entry` 方法的 kind 参数）----
// 与 `UI_CH_*`（字节流）是**两个词表**：`text` 的通道可以续接，`entry` 的一次调用
// 就是一条完整条目。两者的编号都从 1 起，互不混用（一个方法只收自己那张表的值）。
export const UI_ENT_USER: u8 = 1;      // 用户提交的输入行
export const UI_ENT_STEER: u8 = 2;     // 回合中插进来的用户插话（steer）
export const UI_ENT_TOOL: u8 = 3;      // 工具块（整块已渲染好的文本）
export const UI_ENT_NOTICE: u8 = 4;    // 诊断 / 回执（连续两条各自独立）

// ---- 运行态（UI_ST_RUN 载荷的第一行）----
// 端口**自己的**词表：后端私有那套（TUI 的 TUI_RUN_*）不许漏进来，否则换后端
// 又得改执行核（§11.9.2 的「执行核只报事实」）。
export const UI_RUN_IDLE: u8 = 0;
export const UI_RUN_THINK: u8 = 1;
export const UI_RUN_STREAM: u8 = 2;
export const UI_RUN_TOOL: u8 = 3;

// ---- `ui_on` 的问项 ----
export const UI_ON_ACTIVE: u8 = 1;      // 界面活着吗（start 过且没 stop）
export const UI_ON_OVERLAY_OK: u8 = 2;  // 浮层画得出来吗（**fail closed** 的判据）

// ---- 提问种类（`UiReq.kind`）----
export const UI_ASK_APPROVE: u8 = 1;   // 审批（read-only 的 bash、切换工作区）
export const UI_ASK_QUESTION: u8 = 2;  // ask_user_question
export const UI_ASK_PLAN: u8 = 3;      // plan 审阅
export const UI_ASK_TITLE: u8 = 4;     // 标题输入
export const UI_ASK_READER: u8 = 5;    // 只读正文（/status、/tasks 这类长文本）

// ---- 回答状态（`UiAns.status`）----
export const UI_ANS_OK: u8 = 0;        // 用户答了（`sel` / `text` 有效）
export const UI_ANS_CANCEL: u8 = 1;    // 用户取消（esc / n / 选「拒绝」）
export const UI_ANS_TIMEOUT: u8 = 2;   // 到点没人回答（**不是**同意，也不是取消）

// ---- 后端号 ----
export const UI_BE_NULL: u8 = 0;       // 无界面（headless/子代理/管道）：fail closed
export const UI_BE_SCROLL: u8 = 1;     // 滚动模式（term/tty + term/view）
export const UI_BE_TUI: u8 = 2;        // 全屏 TUI（term/tui/）
export const UI_BE_EVENTS: u8 = 3;     // 事实流（NDJSON；native / robot 的共同底座）
export const UI_BE_MAX: usize = 4;

// 一次提问请求（纯数据：后端不许改它）。
// 返回码一条：`ask` 返回 `!i32` —— 有渠道就回 `UI_ANS_*` 语义的整数（0 起），
// 没渠道回 `error.UiNoChannel`。
export struct UiReq {
    kind: u8,                   // UI_ASK_*
    id: i32,                    // 请求号（同一回合内唯一；native/robot 用它配对回答）
    title: &const byte,         // 标题（可为空）
    tn: usize,
    body: &const byte,          // 正文（审批时是命令原文，已清洗）
    bn: usize,
    items: &const byte,         // 选项，`\n` 分隔（可为空）
    inlen: usize,
    sel: usize,                 // 初始游标
    timeout_ms: u64,            // 0 = 不限（交互式默认）
}

// 一次提问的回答（纯数据）。`text` 由**后端**分配，**调用方**负责 `buf_free`。
export struct UiAns {
    status: u8,                 // UI_ANS_*
    sel: usize,                 // 选中的第几项（status == UI_ANS_OK 时有效）
    text: Buf,                  // 自由文本（可为空 Buf）
}

// 一个界面后端的全部能力。**实现它 = 成为一个可插拔界面**。
//
// 生命周期：`start` 成功之后才会调其余方法；`stop` 之后不许再调（除了下一次 `start`）。
// `start` 返回 false = 起不来（调用方按各自口径退化，比如 TUI 退回滚动模式）。
export interface UiBackend {
    // 后端机器名（诊断 / `--print-config` 用），如 "null" / "scroll" / "tui" / "events"
    fn kind_name(self: &Self) &const byte;
    // 起界面。cols/rows 是画布格子数，后端可自行夹取。返回 false = 起不来。
    fn start(self: &Self, cols: usize, rows: usize) bool;
    // 收界面（幂等：没 start 过也能调）
    fn stop(self: &Self) void;
    // 一条文本事实（chan = UI_CH_*）。**后端在此决定画不画、怎么画**。
    // 语义是**字节流**：后端可以按行切、可以续接上一条同类条目（TUI 的 chan 2 就是
    // 「按 `\n` 切 + 续接上一条 NOTICE」）。
    fn text(self: &Self, chan: u8, p: &const byte, n: usize) void;
    // 一个**离散条目**（kind = UI_ENT_*）：一次调用 = 一条完整条目，**不切行、不续接**。
    // 为什么它与 `text` 是两个方法而不是一个通道号：两者的**边界语义相反** ——
    // 字节流要能续接（否则一段流式正文会碎成几十条），离散条目要各自独立
    // （否则连续两条回执会粘成一条）。压进一个方法就必须在运行时猜调用方意图，
    // 而猜错的症状是「两条回执变成一条」这种静默排版变化（见 DESIGN §11.9.5）。
    fn entry(self: &Self, kind: u8, p: &const byte, n: usize) void;
    // 一条状态事实（what = UI_ST_*）。**不改变屏幕内容的注入不算错**（后端自行去重）。
    fn status(self: &Self, what: u8, p: &const byte, n: usize) void;
    // 泵一次界面：处理输入 / 刷帧 / 采样。返回中断意图码（0 = 无事）。
    // **阻塞循环里调它**（工具执行、等网络），所以 timeout_ms 是等待上限。
    fn pump(self: &Self, timeout_ms: i32) i32;
    // 查询一个**事实**（`what` = UI_ON_*）。刻意不是「当前选了哪个后端」——
    // 那是 `ui_kind()` 的事。执行核问「现在有界面吗 / 浮层画得出来吗」，
    // 据此决定「看不见就不许做」（fail closed）。
    fn on(self: &Self, what: u8) bool;
    // 提问（UI_ASK_*）。没渠道必须回 `error.UiNoChannel` —— **fail closed**。
    fn ask(self: &Self, req: &const UiReq, ans: &UiAns) !i32;
}
