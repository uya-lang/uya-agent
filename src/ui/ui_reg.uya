// src/ui/ui_reg.uya — 界面后端的注册表与端口入口
//
// 本文件：注册表（`g_null` / `g_reg` / `g_ui`）、登记与选择（`ui_reg_put` / `ui_use` /
//   `ui_kind` / `ui_kind_name`）、生命周期（`ui_start` / `ui_stop`），以及执行层唯一的
//   界面入口（`ui_text` / `ui_status` / `ui_pump` / `ui_ask`）。
// 不变量：① **接口值只能由「具体 struct → 接口变量」的赋值构造**（`var r: I = g_reg[i];`）：
//   `&具体struct as &接口` 能编译、能链接，但**运行期 SIGSEGV**（codegen 不构造
//   {vtable, data} 对）—— 见 CODING.md §1.4；② 注册表索引**处处显式夹取**
//   （Uya 的边界证明器只认「正的 if 里做索引」）；③ **`g_reg` 的每个槽都必须被填上
//   接口值**（空槽的 vtable 是 null，调用即崩）—— 所以数组字面量里逐个列全，
//   不许留尾；④ 本文件**不许认识 `Config` / `agent_` / `g_sess`**（端口层不认识
//   执行核）——「用哪个后端」由执行核调 `ui_use(kind)` 决定，端口只照做。
// 依赖：本域 ui/ui_port（接口与常量）、ui/be_null（空后端）。**不依赖 bufx** ——
//   本文件只搬运接口值，不碰任何缓冲。后端实现（be_tui / be_scroll / be_events）
//   在这里登记 —— **新增后端只改这一个文件**。
// 命名：对外 `ui_` + `UI_*`；注册表私有 `g_reg` / `g_ui` / `g_kind`。

// 空后端实例（也是 `g_ui` 的初值：进程起来到 ui_use 之前，一切输出丢弃、提问 fail closed）。
var g_null: NullBe = NullBe{ started: false };

// 注册表：后端号 → 接口值。**每个槽都必须填**（见不变量③）。
// 现在只有空后端一个成员；be_tui / be_scroll / be_events 落地后在这里登记。
var g_reg: [UiBackend: UI_BE_MAX] = [g_null, g_null, g_null, g_null];

// 当前后端（接口值，运行期可整个换掉）与它的编号。
var g_ui: UiBackend = g_null;
var g_kind: u8 = UI_BE_NULL;

// 登记一个后端槽（`ui_use` 之前由各后端的 init 调用）。
// 传进来的是**接口值**（调用方在自己的文件里从具体 struct 构造好）——
// 这样本文件不需要认识任何具体后端类型。
export fn ui_reg_put(kind: u8, be: UiBackend) void {
    const i: usize = kind as usize;
    if i < UI_BE_MAX {
        g_reg[i] = be;
    }
}

// 切到某个后端。越界/没登记的槽一律保持当前后端不动（**不静默换成一个坏值**）。
export fn ui_use(kind: u8) void {
    const i: usize = kind as usize;
    if i < UI_BE_MAX {
        g_ui = g_reg[i];
        g_kind = kind;
    }
}

// 当前后端号（诊断用）。注意它回答的是「选了哪个后端」，不是「界面活着吗」。
export fn ui_kind() u8 {
    return g_kind;
}

// 当前后端的机器名（`--print-config` / 诊断）。
export fn ui_kind_name() &const byte {
    return g_ui.kind_name();
}

// 起当前后端。false = 起不来，由调用方按各自口径退化（TUI 起不来就换滚动模式）。
export fn ui_start(cols: usize, rows: usize) bool {
    return g_ui.start(cols, rows);
}

// 收当前后端（幂等）。
export fn ui_stop() void {
    g_ui.stop();
}

// 一条文本事实（chan = UI_CH_*）。**执行层唯一的正文出口**。
export fn ui_text(chan: u8, p: &const byte, n: usize) void {
    if n == 0 {
        return;
    }
    g_ui.text(chan, p, n);
}

// 一条状态事实（what = UI_ST_*）。
export fn ui_status(what: u8, p: &const byte, n: usize) void {
    g_ui.status(what, p, n);
}

// 泵一次界面（阻塞循环里的统一入口）。返回中断意图码（0 = 无事）。
export fn ui_pump(timeout_ms: i32) i32 {
    return g_ui.pump(timeout_ms);
}

// 提问（UI_ASK_*）。返回 `UI_ANS_*`；没渠道回 `error.UiNoChannel`（fail closed）。
// 调用方**必须**处理 `UiNoChannel` —— 那是「没人能回答」，不是「用户拒绝了」。
export fn ui_ask(req: &const UiReq, ans: &UiAns) !i32 {
    return g_ui.ask(req, ans);
}
