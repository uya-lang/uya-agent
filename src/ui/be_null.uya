// src/ui/be_null.uya — 空后端：无界面 / headless / 子代理 / 管道
//
// 本文件：`NullBe`（`UiBackend` 的空实现）—— 所有输出丢弃，所有提问一律
//   `error.UiNoChannel`。
// 不变量：① **fail closed 是它的全部价值** —— `ask` 绝不许假装「用户同意了」，
//   也绝不许假装「用户拒绝了」（那会让人以为有人回答过）：它只回 `error.UiNoChannel`，
//   由调用方按各自口径落成「没有回答渠道」；② 所有输出方法**一个字节都不写**
//   （不碰 fd、不分配、不置错误）—— headless 的判据就是「显示字节为零」；
//   ③ `start` 恒成功（没有任何资源要申请）；`stop` 幂等。
// 依赖：本域 ui/ui_port（`UiBackend` / `UiReq` / `UiAns` / `UiNoChannel`）。
// 命名：`NullBe`；方法名由接口规定（`kind_name` / `start` / `stop` / `text` /
//   `status` / `pump` / `ask`），它们**只经接口调用**，所以不带文件前缀。
//
// 谁用它：子代理（stdin 是 /dev/null）、`--quiet`、管道 / CI 的非常规路径、
// 自测的 headless 轮。它是「执行核不认识界面」这条设计的兜底 —— 有一个不是终端的
// 后端存在，执行核就永远不会假设「界面上一定看得见」。

// 空后端。不带状态：它没有要记的东西（这正是「事实与渲染分离」最极端的一端）。
export struct NullBe : UiBackend {
    started: bool,

    // 机器名。
    fn kind_name(self: &Self) &const byte {
        return "null" as &const byte;
    }

    // 起界面：没有资源要申请，恒成功。
    fn start(self: &Self, cols: usize, rows: usize) bool {
        self.started = true;
        return true;
    }

    // 收界面：幂等。
    fn stop(self: &Self) void {
        self.started = false;
    }

    // 文本事实：丢弃（一个字节都不写）。
    fn text(self: &Self, chan: u8, p: &const byte, n: usize) void {
        return;
    }

    // 离散条目：丢弃（同上）。
    fn entry(self: &Self, kind: u8, p: &const byte, n: usize) void {
        return;
    }

    // 状态事实：丢弃。
    fn status(self: &Self, what: u8, p: &const byte, n: usize) void {
        return;
    }

    // 泵：无事可做（返回 0 = 没有中断意图）。
    fn pump(self: &Self, timeout_ms: i32) i32 {
        return 0;
    }

    // 事实查询：**一律 false**。这是它 fail closed 的另一半 —— `UI_ON_OVERLAY_OK`
    // 为假时执行核按「看不见就不许做」处理（审批不会「看不见却仍吞键」）。
    // 刻意不看 `self.started`：那个位只说明 `start` 被调过，而空后端**没有界面**。
    fn on(self: &Self, what: u8) bool {
        return false;
    }

    // 提问：**一律 fail closed**（不假装同意、不假装拒绝）。
    fn ask(self: &Self, req: &const UiReq, ans: &UiAns) !i32 {
        return error.UiNoChannel;
    }
}
