// src/ui/ui_fwd.uya — 端口入口的**同名转发器**（A 族迁移用）
//
// 本文件：把执行层今天在用的那几个显示符号（`tui_add_notice` / `tui_add_user` /
//   `tui_add_steer` / `tui_add_tool_block`）**沿用原名**留在这里，体内只做一件事：
//   选一个条目种类 → `ui_entry(...)`。
// 不变量：① 本文件**只转发、不含任何排版**（排版在 `term/tui/`，那是所有后端共用的
//   共享库）；② 这些名字是**端口入口**，不是后端私有符号 —— 后端私有的那份已经改名
//   成 `betui_*`（在 `term/tui/entry.uya`），执行层**不许**直呼 `betui_*`
//   （`make ui-audit` 判据 B 判红）；③ 同后端内部互调直呼 `betui_*`、**不绕端口**
//   （防「端口里再调端口」的无限递归）。
// 依赖：本域 ui/ui_reg（`ui_entry`）、ui/ui_port（`UI_ENT_*`）。
// 命名：**故意沿用 `tui_*` 旧名** —— 这是迁移手法本身（见 DESIGN §11.9.5）：
//   端口入口沿用现有符号名，于是 `agent/` / `tools/` 一行都不用改就先接上了端口，
//   迁移按**符号**推进（154 个）而不是按调用点推进（600 个）。
//
// 为什么 `notice` 与 `user` / `steer` / `tool` 共用一条转发而不各写一个：
// 它们的差别只在**条目种类**，而「怎么画」全在后端（`be_tui.entry`）里按种类分派。
// 这里多写一层 if 只会让「加一种条目」要改两处。

// 离散条目转发（kind = UI_ENT_*）。`n == 0` 时也照样转（`UI_ENT_TOOL` 的空块是
// 合法的「补一个空行」，见 `agent_tui_seed_history`），是否丢弃由后端决定。
fn uifwd_entry(kind: u8, p: &const byte, n: usize) void {
    ui_entry(kind, p, n);
}

// 一条 NOTICE（诊断 / 回执）。语义是**离散条目**：连续两次调用出两条条目，
// 不按 `\n` 切行、也不与上一条续接（这与 `ui_text` 的字节流语义相反，见 ui_port 的
// `entry` 注释）。
export fn tui_add_notice(p: &const byte, n: usize) void {
    uifwd_entry(UI_ENT_NOTICE, p, n);
}

// 一条用户条目（提交的输入行）。
export fn tui_add_user(p: &const byte, n: usize) void {
    uifwd_entry(UI_ENT_USER, p, n);
}

// 一条 steer 条目（回合中插进来的用户插话）。
export fn tui_add_steer(p: &const byte, n: usize) void {
    uifwd_entry(UI_ENT_STEER, p, n);
}

// 一个工具块（整块已由 `view_render_block` 渲染好的文本）。
export fn tui_add_tool_block(p: &const byte, n: usize) void {
    uifwd_entry(UI_ENT_TOOL, p, n);
}
