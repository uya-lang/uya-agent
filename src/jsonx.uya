// src/jsonx.uya — JSON 薄封装：用 std.json 组装请求 / 导航响应
//
// 写：JsonWriter（std.json.encoder）+ 直接往 writer 缓冲里塞原始片段（工具 schema、system prompt）
//     **字符串转义由本文件自己实现**（jw_str/jw_key）：std 的实现不转义 0x00…0x1f 里的
//     非 \n\r\t 字节，一个 NUL 就能让网关 400（见下面「字符串转义」一节的说明）。
// 读：std.json.parser.parse 到 arena，再用 json_object_find_index / json_expect_str 取字段
//
// 语言注意：JsonValue 是 union，match 前先复制到局部 const（std 编码器同款写法）。

use libc.heap;
use std.json.value.JsonValue;
use std.json.value.JsonStrView;
use std.json.parser.parse;
use std.json.encoder.JsonWriter;
use std.json.encoder.json_writer_init;
use std.json.encoder.json_write_byte;
use std.json.encoder.json_write_i64;
use std.json.encoder.json_write_bool;
use std.json.encoder.json_write_null;
use std.json.encoder.json_object_find_index;
use std.json.encoder.json_expect_str;
use std.json.encoder.json_expect_i64;
use std.mem.arena.Arena;
use std.string.strlen;

// ============================================================
// 写
// ============================================================
export fn jw_init(w: &JsonWriter, buf: &byte, cap: usize) void {
    json_writer_init(w, buf, cap);
}

export fn jw_used(w: &const JsonWriter) usize {
    return w.used;
}

export fn jw_overflow(w: &const JsonWriter) bool {
    return w.overflow;
}

// 原样写入片段（不转义）：片段必须是合法 JSON
export fn jw_raw(w: &JsonWriter, p: &const byte, n: usize) void {
    if w.overflow {
        return;
    }
    if w.used + n > w.cap {
        w.overflow = true;
        return;
    }
    var i: usize = 0;
    while i < n {
        w.buf[w.used + i] = p[i];
        i = i + 1;
    }
    w.used = w.used + n;
}

export fn jw_cstr(w: &JsonWriter, p: &const byte) void {
    jw_raw(w, p, strlen(p));
}

export fn jw_byte(w: &JsonWriter, b: byte) void {
    json_write_byte(w, b);
}

// ============================================================
// 字符串转义（请求体正确性的关键点）
//
// 自己转义，不用 std.json.encoder.json_write_str_view：那个实现只转义 " \ \n \r \t，
// 其余 **< 0x20 的控制字节会原样写进请求体** —— 而 JSON 规范要求控制字节必须转义。
// 真机后果（踩坑 27）：bash 结果里只要有一个 NUL（例如 `printf 'A\000B'`、探测终端属性的
// 小程序输出），它就被原文写进 messages[].content，Go 网关的 json 解码立刻 400：
//   Invalid request, invalid character '\x00' in string literal
// 而且这条工具结果会一直留在历史里 —— 之后**每一轮**请求都带着它，会话彻底变成
// 「继续也报 400」。所以这里的规则必须与 RFC 8259 一致：0x00…0x1f 全部转义。
// ============================================================

// 该字节是否必须转义（" \ 与全部控制字节）
fn jw_needs_escape(b: byte) bool {
    return b < 32 as byte || b == 34 as byte || b == 92 as byte;
}

// 写出一个必须转义的字节
fn jw_write_escaped(w: &JsonWriter, b: byte) void {
    if b == 34 as byte {
        jw_byte(w, 92);
        jw_byte(w, 34);
        return;
    }
    if b == 92 as byte {
        jw_byte(w, 92);
        jw_byte(w, 92);
        return;
    }
    if b == 10 as byte { jw_byte(w, 92); jw_byte(w, 110); return; }   // \n
    if b == 13 as byte { jw_byte(w, 92); jw_byte(w, 114); return; }   // \r
    if b == 9 as byte { jw_byte(w, 92); jw_byte(w, 116); return; }    // \t
    if b == 8 as byte { jw_byte(w, 92); jw_byte(w, 98); return; }     // \b
    if b == 12 as byte { jw_byte(w, 92); jw_byte(w, 102); return; }   // \f
    // 其余控制字节：\u00XX（NUL 就是 \u0000）
    const hexd: &[byte] = &"0123456789abcdef"[0: 16];
    const hi: i32 = ((b as i32) >> 4) & 15;
    const lo: i32 = (b as i32) & 15;
    jw_byte(w, 92);
    jw_byte(w, 117);
    jw_byte(w, 48);
    jw_byte(w, 48);
    jw_byte(w, hexd[hi as usize]);
    jw_byte(w, hexd[lo as usize]);
}

// 转义字符串（作为 value）
export fn jw_str(w: &JsonWriter, ptr: &byte, len: usize) void {
    jw_byte(w, 34);
    var i: usize = 0;
    while i < len {
        // 快路径：把「一段不需要转义的字节」一次写完，只在本段末尾做转义
        var j: usize = i;
        while j < len {
            if jw_needs_escape(ptr[j]) {
                break;
            }
            j = j + 1;
        }
        if j > i {
            jw_raw(w, &ptr[i], j - i);
            i = j;
        }
        if i < len {
            jw_write_escaped(w, ptr[i]);
            i = i + 1;
        }
    }
    jw_byte(w, 34);
}

export fn jw_str_cstr(w: &JsonWriter, p: &const byte) void {
    jw_str(w, p as &byte, strlen(p));
}

// 写 "key":（不写值）
export fn jw_key(w: &JsonWriter, key: &const byte) void {
    jw_str(w, key as &byte, strlen(key));
    jw_byte(w, 58);
}

export fn jw_i64(w: &JsonWriter, v: i64) void {
    json_write_i64(w, v);
}

export fn jw_bool(w: &JsonWriter, v: bool) void {
    json_write_bool(w, v);
}

export fn jw_null(w: &JsonWriter) void {
    json_write_null(w);
}

// ============================================================
// 读
// ============================================================
export fn js_parse(arena: &Arena, ptr: &byte, len: usize, out: &JsonValue) bool {
    if len == 0 {
        return false;
    }
    const v: JsonValue = parse(arena, ptr, len) catch {
        return false;
    };
    out[0] = v;
    return true;
}

// v 是 object 时取其 key 字段
export fn js_obj_get(v: &JsonValue, key: &const byte, key_len: usize, out: &JsonValue) bool {
    if key_len == 0 || key_len > 120 {
        return false;
    }
    var kbuf: [byte: 128] = [0: 128];
    var i: usize = 0;
    while i < key_len {
        kbuf[i] = key[i];
        i = i + 1;
    }
    const val: JsonValue = v[0];
    match val {
        .obj(o) => {
            const idx: usize = json_object_find_index(&o, &kbuf[0], key_len) catch {
                return false;
            };
            if idx >= o.len {
                return false;
            }
            out[0] = o.pairs[idx].value;
            return true;
        },
        else => {
            return false;
        },
    }
}

export fn js_arr_get(v: &JsonValue, idx: usize, out: &JsonValue) bool {
    const val: JsonValue = v[0];
    match val {
        .arr(a) => {
            if idx >= a.len {
                return false;
            }
            out[0] = a.items[idx];
            return true;
        },
        else => {
            return false;
        },
    }
}

export fn js_arr_len(v: &JsonValue) usize {
    const val: JsonValue = v[0];
    match val {
        .arr(a) => {
            return a.len;
        },
        else => {
            return 0;
        },
    }
}

export fn js_is_obj(v: &JsonValue) bool {
    const val: JsonValue = v[0];
    match val {
        .obj(o) => {
            _ = o;
            return true;
        },
        else => {
            return false;
        },
    }
}

// 取字符串；null / 非字符串返回 false
export fn js_str_of(v: &JsonValue, out: &JsonStrView) bool {
    const s: JsonStrView = json_expect_str(v) catch {
        return false;
    };
    out[0] = s;
    return true;
}

export fn js_obj_get_str(v: &JsonValue, key: &const byte, key_len: usize, out: &JsonStrView) bool {
    var tmp: JsonValue = JsonValue.json_null();
    if !js_obj_get(v, key, key_len, &tmp) {
        return false;
    }
    return js_str_of(&tmp, out);
}

export fn js_i64_of(v: &JsonValue, out: &i64) bool {
    const n: i64 = json_expect_i64(v) catch {
        return false;
    };
    out[0] = n;
    return true;
}

// 取字符串字段并**反转义**到 out（堆缓冲，调用方负责 buf_free）。
//
// 为什么必须反转义：std.json 的 JsonStrView 是零拷贝的原始视图 —— 字段值里的
// \" \\ \n 等转义序列**没有被解码**。arguments 那层我们已经反转义过一次，
// 但解析出内层对象后，path/content/command 这些**字段值**仍是未解码的原始视图，
// 必须再反转义一次，否则 write_file 会把 "\n" 当两个字符写进文件。
export fn js_obj_get_str_unescaped(v: &JsonValue, key: &const byte, key_len: usize, out: &Buf) bool {
    var sv: JsonStrView = JsonStrView{ ptr: null, len: 0 };
    if !js_obj_get_str(v, key, key_len, &sv) {
        return false;
    }
    return sv_unescape_to_buf(&sv, out);
}

// 把 JsonStrView 复制到堆缓冲（out 必须是空 Buf）
export fn js_view_to_buf(s: &const JsonStrView, out: &Buf) bool {
    out[0] = buf_new(s.len + 1);
    if !buf_valid(&out[0]) {
        return false;
    }
    if !buf_append(&out[0], s.ptr, s.len) {
        return false;
    }
    if !buf_append_byte(&out[0], 0) {
        return false;
    }
    out[0].len = s.len;
    return true;
}

// ============================================================
// JSON 字符串反转义
//
// 注意：std.json 的 parse_string 是**零拷贝**的 —— JsonStrView 指向原始缓冲区，
// 里面的 \"  \\  \n 等转义序列**没有被解码**。所以：
//   * 工具调用的 arguments（它本身是一段 JSON 文本）必须先反转义再 parse；
//   * 要打印给用户的 content 也要反转义，否则换行会显示成 \n。
// ============================================================
fn hex_val(c: byte) i32 {
    if c >= 48 as byte && c <= 57 as byte {
        return (c as i32) - 48;
    }
    if c >= 97 as byte && c <= 102 as byte {
        return (c as i32) - 87;
    }
    if c >= 65 as byte && c <= 70 as byte {
        return (c as i32) - 55;
    }
    return -1;
}

fn read_u4(s: &const JsonStrView, off: usize) i32 {
    var v: i32 = 0;
    var k: usize = 0;
    while k < 4 {
        const d: i32 = hex_val(s.ptr[off + k]);
        if d < 0 {
            return -1;
        }
        v = v * 16 + d;
        k = k + 1;
    }
    return v;
}

fn append_utf8(out: &Buf, cp: i32) bool {
    if cp < 0 {
        return true;
    }
    if cp < 128 {
        return buf_append_byte(out, cp as byte);
    }
    if cp < 2048 {
        if !buf_append_byte(out, (192 | (cp >> (6 as i32))) as byte) {
            return false;
        }
        return buf_append_byte(out, (128 | (cp & 63)) as byte);
    }
    if cp < 65536 {
        if !buf_append_byte(out, (224 | (cp >> (12 as i32))) as byte) {
            return false;
        }
        if !buf_append_byte(out, (128 | ((cp >> (6 as i32)) & 63)) as byte) {
            return false;
        }
        return buf_append_byte(out, (128 | (cp & 63)) as byte);
    }
    if !buf_append_byte(out, (240 | (cp >> (18 as i32))) as byte) {
        return false;
    }
    if !buf_append_byte(out, (128 | ((cp >> (12 as i32)) & 63)) as byte) {
        return false;
    }
    if !buf_append_byte(out, (128 | ((cp >> (6 as i32)) & 63)) as byte) {
        return false;
    }
    return buf_append_byte(out, (128 | (cp & 63)) as byte);
}

export fn sv_unescape(s: &const JsonStrView, out: &Buf) bool {
    var i: usize = 0;
    while i < s.len {
        const c: byte = s.ptr[i];
        if c != (92 as byte) {
            if !buf_append_byte(out, c) {
                return false;
            }
            i = i + 1;
            continue;
        }
        i = i + 1;
        if i >= s.len {
            return false;
        }
        const e: byte = s.ptr[i];
        if e == (110 as byte) {
            if !buf_append_byte(out, 10) {
                return false;
            }
            i = i + 1;
        } else if e == (116 as byte) {
            if !buf_append_byte(out, 9) {
                return false;
            }
            i = i + 1;
        } else if e == (114 as byte) {
            if !buf_append_byte(out, 13) {
                return false;
            }
            i = i + 1;
        } else if e == (98 as byte) {
            if !buf_append_byte(out, 8) {
                return false;
            }
            i = i + 1;
        } else if e == (102 as byte) {
            if !buf_append_byte(out, 12) {
                return false;
            }
            i = i + 1;
        } else if e == (34 as byte) {
            if !buf_append_byte(out, 34) {
                return false;
            }
            i = i + 1;
        } else if e == (92 as byte) {
            if !buf_append_byte(out, 92) {
                return false;
            }
            i = i + 1;
        } else if e == (47 as byte) {
            if !buf_append_byte(out, 47) {
                return false;
            }
            i = i + 1;
        } else if e == (117 as byte) {
            if i + 5 > s.len {
                return false;
            }
            var cp: i32 = read_u4(s, i + 1);
            if cp < 0 {
                return false;
            }
            i = i + 5;
            // 代理对合成
            if cp >= 55296 && cp <= 56319 && i + 6 <= s.len {
                if s.ptr[i] == (92 as byte) && s.ptr[i + 1] == (117 as byte) {
                    const lo: i32 = read_u4(s, i + 2);
                    if lo >= 56320 && lo <= 57343 {
                        cp = 65536 + ((cp - 55296) << (10 as i32)) + (lo - 56320);
                        i = i + 6;
                    }
                }
            }
            if !append_utf8(out, cp) {
                return false;
            }
        } else {
            return false;
        }
    }
    return true;
}

// 反转义成一个堆缓冲（调用方负责 buf_free）
export fn sv_unescape_to_buf(s: &const JsonStrView, out: &Buf) bool {
    out[0] = buf_new(s.len + 8);
    if !buf_valid(&out[0]) {
        return false;
    }
    if !sv_unescape(s, &out[0]) {
        buf_free(&out[0]);
        return false;
    }
    return true;
}
