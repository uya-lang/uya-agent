// std.path - 可移植路径工具模块

use std;
use std.string.strlen;
use libc.Stat;
use libc.X_OK;
use libc.access;
use libc.stat;

std.cfg(std.target_os == .tos_windows, const PATH_EXECUTABLE_SUFFIX: &const byte = ".exe";)
std.cfg(std.target_os == .tos_linux, const PATH_EXECUTABLE_SUFFIX: &const byte = "";)
std.cfg(std.target_os == .tos_macos, const PATH_EXECUTABLE_SUFFIX: &const byte = "";)
std.cfg(std.target_os == .tos_unknown, const PATH_EXECUTABLE_SUFFIX: &const byte = "";)

fn path_is_separator(ch: byte) bool {
    return ch == 47 as byte || ch == 92 as byte;
}

fn path_is_drive_letter(ch: byte) bool {
    if ch >= 65 as byte && ch <= 90 as byte {
        return true;
    }
    if ch >= 97 as byte && ch <= 122 as byte {
        return true;
    }
    return false;
}

fn path_is_absolute(path: &const byte) bool {
    if path == null || path[0] == 0 as byte {
        return false;
    }
    if path_is_separator(path[0]) {
        return true;
    }
    if path_is_drive_letter(path[0]) && path[1] == 58 as byte &&
        (path[2] == 0 as byte || path_is_separator(path[2])) {
        return true;
    }
    return false;
}

fn path_choose_join_separator(base: &const byte, base_len: usize) byte {
    if base_len >= 2usize && path_is_drive_letter(base[0]) && base[1] == 58 as byte {
        return 92 as byte;
    }
    var i: usize = base_len;
    while i > 0usize {
        const ch: byte = base[i - 1usize];
        if path_is_separator(ch) {
            return ch;
        }
        i = i - 1usize;
    }
    return 47 as byte;
}

fn path_copy_cstring(src: &const byte, out: &byte, out_cap: usize) i32 {
    if src == null || out == null || out_cap == 0usize {
        return 1;
    }
    const len: usize = strlen(src);
    if len + 1usize > out_cap {
        return 1;
    }
    var i: usize = 0;
    while i < len {
        out[i] = src[i];
        i = i + 1usize;
    }
    out[len] = 0 as byte;
    return 0;
}

fn path_copy_prefix(src: &const byte, prefix_len: usize, out: &byte, out_cap: usize) i32 {
    if src == null || out == null {
        return 1;
    }
    if prefix_len + 1usize > out_cap {
        return 1;
    }
    var i: usize = 0;
    while i < prefix_len {
        out[i] = src[i];
        i = i + 1usize;
    }
    out[prefix_len] = 0 as byte;
    return 0;
}

fn path_copy_range(src: &const byte, start: usize, end: usize, out: &byte, out_cap: usize) i32 {
    if src == null || out == null || end < start {
        return 1;
    }
    const len: usize = end - start;
    if len + 1usize > out_cap {
        return 1;
    }

    var i: usize = 0;
    while i < len {
        out[i] = src[start + i];
        i = i + 1usize;
    }
    out[len] = 0 as byte;
    return 0;
}

fn path_root_prefix_len(path: &const byte) usize {
    if path == null || path[0] == 0 as byte {
        return 0usize;
    }
    if path_is_separator(path[0]) {
        return 1usize;
    }
    if path_is_drive_letter(path[0]) && path[1] == 58 as byte {
        if path[2] == 0 as byte {
            return 2usize;
        }
        if path_is_separator(path[2]) {
            return 3usize;
        }
    }
    return 0usize;
}

fn path_trim_trailing_separators(path: &const byte, end: usize, root_len: usize) usize {
    var trimmed: usize = end;
    while trimmed > root_len {
        if !path_is_separator(path[trimmed - 1usize]) {
            break;
        }
        trimmed = trimmed - 1usize;
    }
    return trimmed;
}

fn path_trim_duplicate_separators(path: &const byte, end: usize, root_len: usize) usize {
    var trimmed: usize = end;
    while trimmed > root_len {
        if !path_is_separator(path[trimmed - 1usize]) {
            break;
        }
        trimmed = trimmed - 1usize;
    }
    return trimmed;
}

fn path_component_start(path: &const byte, end: usize, root_len: usize) usize {
    var start: usize = end;
    while start > root_len {
        if path_is_separator(path[start - 1usize]) {
            break;
        }
        start = start - 1usize;
    }
    return start;
}

fn path_stem_end(path: &const byte, start: usize, end: usize) usize {
    var i: usize = end;
    while i > start {
        i = i - 1usize;
        if path[i] != 46 as byte {
            continue;
        }

        var has_non_dot_prefix: bool = false;
        var j: usize = start;
        while j < i {
            if path[j] != 46 as byte {
                has_non_dot_prefix = true;
                break;
            }
            j = j + 1usize;
        }
        if has_non_dot_prefix {
            return i;
        }
        return end;
    }
    return end;
}

fn path_drive_prefix_len(path: &const byte) usize {
    if path == null {
        return 0usize;
    }
    if path_is_drive_letter(path[0]) && path[1] == 58 as byte {
        return 2usize;
    }
    return 0usize;
}

fn path_is_dot_segment(path: &const byte, start: usize, end: usize) bool {
    return end == start + 1usize && path[start] == 46 as byte;
}

fn path_is_parent_segment(path: &const byte, start: usize, end: usize) bool {
    return end == start + 2usize &&
        path[start] == 46 as byte &&
        path[start + 1usize] == 46 as byte;
}

fn path_detect_normalize_separator(path: &const byte) byte {
    if path == null {
        return 47 as byte;
    }

    var i: usize = 0usize;
    while path[i] != 0 as byte {
        if path_is_separator(path[i]) {
            return path[i];
        }
        i = i + 1usize;
    }

    if path_drive_prefix_len(path) == 2usize {
        return 92 as byte;
    }
    return 47 as byte;
}

/// 标记 `std.path` 模块已可导入。
///
/// 参数说明：无。
/// 返回值：常量值始终为 `true`。
export const PATH_MODULE_PRESENT: bool = true;

/// PATH executable lookup 的稳定结果分类。
export enum ExecutableLookupKind {
    found,
    path_not_found,
    permission_denied,
    platform_error,
}

/// 返回 PATH 风格环境变量的路径列表分隔符。
///
/// 参数说明：无。
/// 返回值：Windows 目标返回 `';'`；其他目标返回 `':'`。
export fn path_list_separator() byte {
    std.cfg(std.target_os == .tos_windows, return 59 as byte;)
    return 58 as byte;
}

/// 返回当前目标平台的可执行文件后缀。
///
/// 参数说明：无。
/// 返回值：Windows 目标返回 `.exe`；其他目标返回空串。
export fn executable_suffix() &const byte {
    return PATH_EXECUTABLE_SUFFIX;
}

/// 判断路径是否为绝对路径。
///
/// 参数说明：`path` 为输入路径，可以是 Unix 根路径或 Windows 盘符路径。
/// 返回值：若 `path` 为绝对路径则返回 `true`；否则返回 `false`。
export fn is_abs(path: &const byte) bool {
    return path_is_absolute(path);
}

/// 归一化路径中的分隔符与点段。
///
/// 参数说明：`path` 为输入路径；`out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的归一化路径；失败返回 `1`。
export fn normalize(path: &const byte, out: &byte, out_cap: usize) i32 {
    if path == null || out == null || out_cap == 0usize {
        return 1;
    }

    const len: usize = strlen(path);
    if len == 0usize {
        return path_copy_cstring("." as &const byte, out, out_cap);
    }

    var seg_starts: [usize: 256] = [];
    var seg_ends: [usize: 256] = [];
    var seg_count: usize = 0usize;
    const prefix_len: usize = path_drive_prefix_len(path);
    var has_root: bool = false;
    var start_idx: usize = 0usize;
    if path_is_separator(path[0]) {
        has_root = true;
        start_idx = 1usize;
    } else if prefix_len == 2usize {
        start_idx = 2usize;
        if path[2] != 0 as byte && path_is_separator(path[2]) {
            has_root = true;
            start_idx = 3usize;
        }
    }

    var i: usize = start_idx;
    while i < len {
        while i < len && path_is_separator(path[i]) {
            i = i + 1usize;
        }
        if i >= len {
            break;
        }

        const seg_start: usize = i;
        while i < len && !path_is_separator(path[i]) {
            i = i + 1usize;
        }
        const seg_end: usize = i;

        if path_is_dot_segment(path, seg_start, seg_end) {
            continue;
        }

        if path_is_parent_segment(path, seg_start, seg_end) {
            if seg_count > 0usize &&
                !path_is_parent_segment(path, seg_starts[seg_count - 1usize], seg_ends[seg_count - 1usize]) {
                seg_count = seg_count - 1usize;
                continue;
            }
            if !has_root {
                if seg_count >= 256usize {
                    return 1;
                }
                seg_starts[seg_count] = seg_start;
                seg_ends[seg_count] = seg_end;
                seg_count = seg_count + 1usize;
            }
            continue;
        }

        if seg_count >= 256usize {
            return 1;
        }
        seg_starts[seg_count] = seg_start;
        seg_ends[seg_count] = seg_end;
        seg_count = seg_count + 1usize;
    }

    const sep: byte = path_detect_normalize_separator(path);
    var out_pos: usize = 0usize;
    if prefix_len == 2usize {
        if out_cap <= 2usize {
            return 1;
        }
        out[0] = path[0];
        out[1] = 58 as byte;
        out_pos = 2usize;
    }
    if has_root {
        if out_pos + 1usize >= out_cap {
            return 1;
        }
        out[out_pos] = sep;
        out_pos = out_pos + 1usize;
    }

    var seg_i: usize = 0usize;
    while seg_i < seg_count {
        if out_pos > 0usize && out[out_pos - 1usize] != sep {
            if out_pos + 1usize >= out_cap {
                return 1;
            }
            out[out_pos] = sep;
            out_pos = out_pos + 1usize;
        }

        const seg_len: usize = seg_ends[seg_i] - seg_starts[seg_i];
        if out_pos + seg_len + 1usize > out_cap {
            return 1;
        }

        var seg_j: usize = 0usize;
        while seg_j < seg_len {
            out[out_pos] = path[seg_starts[seg_i] + seg_j];
            out_pos = out_pos + 1usize;
            seg_j = seg_j + 1usize;
        }
        seg_i = seg_i + 1usize;
    }

    if out_pos == 0usize {
        return path_copy_cstring("." as &const byte, out, out_cap);
    }
    out[out_pos] = 0 as byte;
    return 0;
}

/// 返回路径的最后一个组件。
///
/// 参数说明：`path` 为输入路径；`out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的 basename；失败返回 `1`。
export fn basename(path: &const byte, out: &byte, out_cap: usize) i32 {
    if path == null || out == null || out_cap == 0usize {
        return 1;
    }

    const len: usize = strlen(path);
    if len == 0usize {
        return path_copy_cstring("." as &const byte, out, out_cap);
    }

    const root_len: usize = path_root_prefix_len(path);
    const end: usize = path_trim_trailing_separators(path, len, root_len);
    if end == root_len {
        if root_len == 0usize {
            return path_copy_cstring("." as &const byte, out, out_cap);
        }
        return path_copy_prefix(path, root_len, out, out_cap);
    }

    const start: usize = path_component_start(path, end, root_len);
    return path_copy_range(path, start, end, out, out_cap);
}

/// 返回路径最后一个组件去掉最后扩展名后的部分。
///
/// 参数说明：`path` 为输入路径；`out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的 stem；失败返回 `1`。
export fn stem(path: &const byte, out: &byte, out_cap: usize) i32 {
    if path == null || out == null || out_cap == 0usize {
        return 1;
    }

    const len: usize = strlen(path);
    if len == 0usize {
        return path_copy_cstring("." as &const byte, out, out_cap);
    }

    const root_len: usize = path_root_prefix_len(path);
    const end: usize = path_trim_trailing_separators(path, len, root_len);
    if end == root_len {
        if root_len == 0usize {
            return path_copy_cstring("." as &const byte, out, out_cap);
        }
        return path_copy_prefix(path, root_len, out, out_cap);
    }

    const start: usize = path_component_start(path, end, root_len);
    const stem_end: usize = path_stem_end(path, start, end);
    return path_copy_range(path, start, stem_end, out, out_cap);
}

/// 返回路径最后一个组件的最后扩展名。
///
/// 参数说明：`path` 为输入路径；`out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的扩展名（包含前导 `.`，若不存在则写入空串）；失败返回 `1`。
export fn extension(path: &const byte, out: &byte, out_cap: usize) i32 {
    if path == null || out == null || out_cap == 0usize {
        return 1;
    }

    const len: usize = strlen(path);
    if len == 0usize {
        return path_copy_cstring("" as &const byte, out, out_cap);
    }

    const root_len: usize = path_root_prefix_len(path);
    const end: usize = path_trim_trailing_separators(path, len, root_len);
    if end == root_len {
        return path_copy_cstring("" as &const byte, out, out_cap);
    }

    const start: usize = path_component_start(path, end, root_len);
    const stem_end: usize = path_stem_end(path, start, end);
    if stem_end == end {
        return path_copy_cstring("" as &const byte, out, out_cap);
    }
    return path_copy_range(path, stem_end, end, out, out_cap);
}

/// 返回路径的父目录部分。
///
/// 参数说明：`path` 为输入路径；`out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的目录名；失败返回 `1`。
export fn dirname(path: &const byte, out: &byte, out_cap: usize) i32 {
    if path == null || out == null || out_cap == 0usize {
        return 1;
    }

    const len: usize = strlen(path);
    if len == 0usize {
        return path_copy_cstring("." as &const byte, out, out_cap);
    }

    const root_len: usize = path_root_prefix_len(path);
    const end: usize = path_trim_trailing_separators(path, len, root_len);
    if end == root_len {
        if root_len == 0usize {
            return path_copy_cstring("." as &const byte, out, out_cap);
        }
        return path_copy_prefix(path, root_len, out, out_cap);
    }

    var sep_idx: usize = end;
    while sep_idx > root_len {
        sep_idx = sep_idx - 1usize;
        if path_is_separator(path[sep_idx]) {
            const prefix_len: usize = path_trim_duplicate_separators(path, sep_idx, root_len);
            if prefix_len == 0usize {
                return path_copy_cstring("." as &const byte, out, out_cap);
            }
            return path_copy_prefix(path, prefix_len, out, out_cap);
        }
    }

    if root_len != 0usize {
        return path_copy_prefix(path, root_len, out, out_cap);
    }
    return path_copy_cstring("." as &const byte, out, out_cap);
}

/// 拼接两个路径片段并写入输出缓冲区。
///
/// 参数说明：`base` 为前缀路径；`child` 为要追加的路径片段，若其本身是绝对路径则直接原样返回；
/// `out` 为输出缓冲区；`out_cap` 为缓冲区总容量（包含末尾 `\\0`）。
/// 返回值：成功返回 `0` 并写入以 `\\0` 结尾的结果；失败返回 `1`。
export fn join(base: &const byte, child: &const byte, out: &byte, out_cap: usize) i32 {
    if base == null || child == null || out == null || out_cap == 0usize {
        return 1;
    }
    if path_is_absolute(child) {
        return path_copy_cstring(child, out, out_cap);
    }

    const base_len: usize = strlen(base);
    if base_len == 0usize {
        return path_copy_cstring(child, out, out_cap);
    }

    const child_len: usize = strlen(child);
    if child_len == 0usize {
        return path_copy_cstring(base, out, out_cap);
    }

    var need_separator: bool = true;
    if path_is_separator(base[base_len - 1usize]) {
        need_separator = false;
    }

    var total_len: usize = base_len + child_len + 1usize;
    if need_separator {
        total_len = total_len + 1usize;
    }
    if total_len > out_cap {
        return 1;
    }

    var out_pos: usize = 0;
    while out_pos < base_len {
        out[out_pos] = base[out_pos];
        out_pos = out_pos + 1usize;
    }
    if need_separator {
        out[out_pos] = path_choose_join_separator(base, base_len);
        out_pos = out_pos + 1usize;
    }

    var child_pos: usize = 0;
    while child_pos < child_len {
        out[out_pos] = child[child_pos];
        out_pos = out_pos + 1usize;
        child_pos = child_pos + 1usize;
    }
    out[out_pos] = 0 as byte;
    return 0;
}

fn path_copy_component(source: &const byte, start: usize, end: usize, out: &byte, cap: usize) i32 {
    if source == null || out == null || end < start || end - start + 1usize > cap { return 1; }
    var i: usize = start;
    while i < end { out[i - start] = source[i]; i = i + 1usize; }
    out[end - start] = 0 as byte;
    return 0;
}

fn path_program_has_extension(program: &const byte) bool {
    if program == null { return false; }
    var i: usize = 0usize;
    while program[i] != 0 as byte {
        if program[i] == 46 as byte { return true; }
        i = i + 1usize;
    }
    return false;
}

/// 使用显式 PATH 值与最终 cwd 查找 bare executable。
/// 参数：path_value 为 child env 中的 PATH；cwd 解释空/相对 component；program 为已校验命令名；out 接收路径。
/// 返回：稳定 lookup 分类；成功时 out 为后续 spawn 必须复用的同一路径。
export fn find_executable(path_value: &const byte, cwd: &const byte, program: &const byte,
    out: &byte, out_cap: usize) ExecutableLookupKind {
    if path_value == null || path_value[0] == 0 as byte || cwd == null || program == null || out == null {
        return ExecutableLookupKind.path_not_found;
    }
    const separator: byte = path_list_separator();
    var saw_unusable: bool = false;
    var start: usize = 0usize;
    var pos: usize = 0usize;
    while true {
        const at_end: bool = path_value[pos] == 0 as byte;
        if at_end || path_value[pos] == separator {
            var component: [byte: 4096] = [];
            if path_copy_component(path_value, start, pos, &component[0], 4096usize) != 0 {
                return ExecutableLookupKind.platform_error;
            }
            var directory: [byte: 4096] = [];
            if component[0] == 0 as byte {
                if path_copy_cstring(cwd, &directory[0], 4096usize) != 0 { return ExecutableLookupKind.platform_error; }
            } else if path_is_absolute(&component[0]) {
                if path_copy_cstring(&component[0], &directory[0], 4096usize) != 0 { return ExecutableLookupKind.platform_error; }
            } else if join(cwd, &component[0], &directory[0], 4096usize) != 0 {
                return ExecutableLookupKind.platform_error;
            }
            var candidate: [byte: 4096] = [];
            if join(&directory[0], program, &candidate[0], 4096usize) != 0 {
                return ExecutableLookupKind.platform_error;
            }
            var info: Stat = Stat{};
            if stat(&candidate[0], &info) == 0 {
                const is_dir: bool = ((info.st_mode as u32) & 61440u32) == 16384u32;
                if !is_dir && access(&candidate[0], X_OK) == 0 {
                    if path_copy_cstring(&candidate[0], out, out_cap) != 0 { return ExecutableLookupKind.platform_error; }
                    return ExecutableLookupKind.found;
                }
                saw_unusable = true;
            }
            std.cfg(std.target_os == .tos_windows, {
                if !path_program_has_extension(program) {
                    var program_exe: [byte: 4096] = [];
                    const program_len: usize = strlen(program);
                    if program_len + 5usize > 4096usize {
                        return ExecutableLookupKind.platform_error;
                    }
                    var pi: usize = 0usize;
                    while pi < program_len { program_exe[pi] = program[pi]; pi = pi + 1usize; }
                    program_exe[program_len] = 46 as byte;
                    program_exe[program_len + 1usize] = 101 as byte;
                    program_exe[program_len + 2usize] = 120 as byte;
                    program_exe[program_len + 3usize] = 101 as byte;
                    program_exe[program_len + 4usize] = 0 as byte;
                    if join(&directory[0], &program_exe[0], &candidate[0], 4096usize) != 0 {
                        return ExecutableLookupKind.platform_error;
                    }
                    var exe_info: Stat = Stat{};
                    if stat(&candidate[0], &exe_info) == 0 {
                        const exe_is_dir: bool = ((exe_info.st_mode as u32) & 61440u32) == 16384u32;
                        if !exe_is_dir && access(&candidate[0], X_OK) == 0 {
                            if path_copy_cstring(&candidate[0], out, out_cap) != 0 {
                                return ExecutableLookupKind.platform_error;
                            }
                            return ExecutableLookupKind.found;
                        }
                        saw_unusable = true;
                    }
                }
            })
            if at_end { break; }
            start = pos + 1usize;
        }
        pos = pos + 1usize;
    }
    if saw_unusable { return ExecutableLookupKind.permission_denied; }
    return ExecutableLookupKind.path_not_found;
}
