// lib/std/thread.uya - 线程与异步计算最小实现
//
// 模块路径：use std.thread
// 当前提供：ThreadPool + 基于 raw compute substrate 的 async_compute<T>（整数/bool/f32/f64）

use std.async;
use std.macro_typeinfo.TypeInfo;
use libc.errno;
use libc.free;
use libc.malloc;
use libc.pthread;
use libc.stdlib;
use libc.syscall;

// Legacy compatibility constants: no longer used as product capacity limits.
export const THREAD_POOL_MAX_WORKERS: i32 = 32;
export const THREAD_POOL_MAX_PENDING: i32 = 32;
export const THREAD_POOL_MAX_TASK_SLOTS: i32 = 16;
export const THREAD_POOL_SUBMIT_STRATEGY_QUEUE_OR_ERROR: i32 = 1;
const THREAD_POOL_MAX_CONFIG_CAPACITY: i32 = 4096;
const THREAD_POOL_DEFAULT_PENDING_PER_WORKER: i32 = 4;
const THREAD_POOL_DEFAULT_SLOT_PER_WORKER: i32 = 4;
const THREAD_SLOT_STATE_FREE: i32 = 0;
const THREAD_SLOT_STATE_READY: i32 = 1;
const THREAD_SLOT_STATE_QUEUED: i32 = 2;
const THREAD_SLOT_STATE_RUNNING: i32 = 3;
const THREAD_SLOT_STATE_DONE: i32 = 4;
const THREAD_SLOT_STATE_CANCELLED: i32 = 5;
const THREAD_WORKER_STOP_SLOT: i32 = 0 - 1;
const THREAD_WORKER_DRAIN_QUEUE: i32 = 0 - 2;
const THREAD_TASK_KIND_I32: i32 = 1;
const THREAD_TASK_KIND_U32: i32 = 2;
const THREAD_TASK_KIND_USIZE: i32 = 3;
const THREAD_TASK_KIND_I64: i32 = 4;
const THREAD_TASK_KIND_U64: i32 = 5;
const THREAD_TASK_KIND_I16: i32 = 6;
const THREAD_TASK_KIND_U16: i32 = 7;
const THREAD_TASK_KIND_I8: i32 = 8;
const THREAD_TASK_KIND_U8: i32 = 9;
const THREAD_TASK_KIND_BOOL: i32 = 10;
const THREAD_TASK_KIND_F32: i32 = 11;
const THREAD_TASK_KIND_F64: i32 = 12;

fn thread_error_id_is_would_block(err_id: u32) bool {
    return err_id == libc_EAGAIN as u32 || err_id == libc_EWOULDBLOCK as u32;
}

fn thread_ready_i32(result: !i32) Future<!i32> {
    return Future<!i32>{ state: Poll<!i32>.Ready(result) };
}

fn thread_generic_error_i32() !i32 {
    return sys_close(0 - 1);
}

fn thread_generic_error_usize() !usize {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! usize;
}

fn thread_generic_error_u32() !u32 {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! u32;
}

fn thread_ok_u32(value: u32) !u32 {
    return value;
}

fn thread_generic_error_i64() !i64 {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! i64;
}

fn thread_generic_error_u64() !u64 {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! u64;
}

fn thread_generic_error_i16() !i16 {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! i16;
}

fn thread_generic_error_u16() !u16 {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! u16;
}

fn thread_generic_error_i8() !i8 {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! i8;
}

fn thread_generic_error_u8() !u8 {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! u8;
}

fn thread_generic_error_bool() !bool {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! bool;
}

fn thread_generic_error_f32() !f32 {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! f32;
}

fn thread_generic_error_f64() !f64 {
    const close_result: !i32 = sys_close(0 - 1);
    return close_result as! f64;
}

/// 经 `ok<bool>` 包装，确保 `thread_async_compute_bool` 路径注册具体 `ok<bool>` 单态。
fn thread_ok_bool(value: bool) !bool {
    const result: !bool = ok<bool>(value);
    return result;
}

fn thread_ok_f32(value: f32) !f32 {
    const result: !f32 = ok<f32>(value);
    return result;
}

fn thread_ok_f64(value: f64) !f64 {
    const result: !f64 = ok<f64>(value);
    return result;
}

fn thread_ok_i64(value: i64) !i64 {
    var result: !i64 = ok<i64>(value);
    return result;
}

fn thread_ok_u64(value: u64) !u64 {
    var result: !u64 = ok<u64>(value);
    return result;
}

fn thread_ok_i16(value: i16) !i16 {
    var result: !i16 = ok<i16>(value);
    return result;
}

fn thread_ok_u16(value: u16) !u16 {
    var result: !u16 = ok<u16>(value);
    return result;
}

fn thread_ok_i8(value: i8) !i8 {
    var result: !i8 = ok<i8>(value);
    return result;
}

fn thread_ok_u8(value: u8) !u8 {
    var result: !u8 = ok<u8>(value);
    return result;
}

fn thread_bool_to_usize(b: bool) usize {
    if b {
        return 1 as usize;
    }
    return 0 as usize;
}

fn thread_cancelled_error_usize() !usize {
    return error.Cancelled;
}

fn thread_capacity_error_i32() !i32 {
    return error.TaskQueueFull;
}

mc thread_type_is_i32(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 2;
}

mc thread_type_is_usize(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 7;
}

mc thread_type_is_u32(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 6;
}

mc thread_type_is_i64(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 3;
}

mc thread_type_is_u64(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 8;
}

mc thread_type_is_i16(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 1;
}

mc thread_type_is_u16(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 5;
}

mc thread_type_is_i8(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 0;
}

mc thread_type_is_u8(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 4;
}

mc thread_type_is_bool(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 9;
}

mc thread_type_is_f32(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 11;
}

mc thread_type_is_f64(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 12;
}

// f32/f64：槽位内 arg/result 的低 32/64 位为 IEEE 位模式（宿主为 64 位 usize 时 f64 完整传递）。
mc thread_type_is_float(T: type) expr {
    const info: TypeInfo = @mc_type(T);
    info.type_id == 11 || info.type_id == 12;
}

// 由 C99 生成器在输出前导中注入 static inline uya_thread_call_*（见 codegen/c99/main.uya）：
// 用宿主编译器做类型化间接调用，保证 -O2 下栈对齐与调用约定正确；勿在此处用 @asm call *%%rax。
extern fn uya_thread_call_i32(fn_ptr: &void, arg: i32) i32;
extern fn uya_thread_call_u32(fn_ptr: &void, arg: u32) u32;
extern fn uya_thread_call_usize(fn_ptr: &void, arg: usize) usize;
extern fn uya_thread_call_i64(fn_ptr: &void, arg: i64) i64;
extern fn uya_thread_call_u64(fn_ptr: &void, arg: u64) u64;
extern fn uya_thread_call_i16(fn_ptr: &void, arg: i16) i16;
extern fn uya_thread_call_u16(fn_ptr: &void, arg: u16) u16;
extern fn uya_thread_call_i8(fn_ptr: &void, arg: i8) i8;
extern fn uya_thread_call_u8(fn_ptr: &void, arg: u8) u8;
extern fn uya_thread_call_bool(fn_ptr: &void, arg: i32) i32;
extern fn uya_thread_call_f32(fn_ptr: &void, arg: u32) u32;
extern fn uya_thread_call_f64(fn_ptr: &void, arg: u64) u64;

fn thread_call_i32(fn_ptr: &void, arg: i32) i32 {
    return uya_thread_call_i32(fn_ptr, arg);
}

fn thread_call_usize(fn_ptr: &void, arg: usize) usize {
    return uya_thread_call_usize(fn_ptr, arg);
}

fn thread_call_u32(fn_ptr: &void, arg: u32) u32 {
    return uya_thread_call_u32(fn_ptr, arg);
}

fn thread_call_i64(fn_ptr: &void, arg: i64) i64 {
    return uya_thread_call_i64(fn_ptr, arg);
}

fn thread_call_u64(fn_ptr: &void, arg: u64) u64 {
    return uya_thread_call_u64(fn_ptr, arg);
}

fn thread_call_i16(fn_ptr: &void, arg: i16) i16 {
    return uya_thread_call_i16(fn_ptr, arg);
}

fn thread_call_u16(fn_ptr: &void, arg: u16) u16 {
    return uya_thread_call_u16(fn_ptr, arg);
}

fn thread_call_i8(fn_ptr: &void, arg: i8) i8 {
    return uya_thread_call_i8(fn_ptr, arg);
}

fn thread_call_u8(fn_ptr: &void, arg: u8) u8 {
    return uya_thread_call_u8(fn_ptr, arg);
}

fn thread_call_bool(fn_ptr: &void, arg: i32) i32 {
    return uya_thread_call_bool(fn_ptr, arg);
}

fn thread_call_f32(fn_ptr: &void, arg: u32) u32 {
    return uya_thread_call_f32(fn_ptr, arg);
}

fn thread_call_f64(fn_ptr: &void, arg: u64) u64 {
    return uya_thread_call_f64(fn_ptr, arg);
}

struct ThreadWorker {
    thread: pthread_t,
    cmd_write_fd: i32,
    result_read_fd: i32,
    busy: i32,
    active: i32,
    active_slot: i32,
}

struct ThreadWorkerCommand {
    slot_idx: i32,
    reserved: i32,
}

struct ThreadTaskSlotRaw {
    state: atomic i32,
    worker_idx: atomic i32,
    task_kind: i32,
    fn_bits: i64,
    arg_bits: usize,
    result_bits: usize,
}

struct ThreadPoolSharedState {
    pending_capacity: i32,
    task_slot_capacity: i32,
    mapped_bytes: usize,
    pending_head: atomic i32,
    pending_tail: atomic i32,
    pending_count: atomic i32,
    peak_pending_count: atomic i32,
    saturation_count: atomic u64,
    drain_count: atomic u64,
    last_drain_time_us: atomic u64,
    max_drain_time_us: atomic u64,
    total_drain_time_us: atomic u64,
    slots: &ThreadTaskSlotRaw,
    pending_slots: &i32,
}

struct ThreadWorkerStart {
    worker_idx: i32,
    cmd_read_fd: i32,
    result_write_fd: i32,
    shared_state: &ThreadPoolSharedState,
}

export struct ThreadPool {
    worker_count: i32,
    pending_capacity: i32,
    task_slot_capacity: i32,
    submit_strategy: i32,
    _started_workers: i32,
    _next_worker: i32,
    _shared_state: &ThreadPoolSharedState,
    _workers: &ThreadWorker,
    _workers_bytes: usize,
    _metrics_peak_queue_depth: i32,
    _metrics_saturation_count: u64,
    _metrics_cancel_count: u64,
    _metrics_drain_count: u64,
    _metrics_last_drain_time_us: u64,
    _metrics_max_drain_time_us: u64,
    _metrics_total_drain_time_us: u64,
}

/// `ThreadPool` 容量配置。
/// 参数：`worker_count` 为最大 worker 数，`pending_capacity` 为等待队列容量，`task_slot_capacity` 为共享任务槽容量，`submit_strategy` 为饱和时的显式提交策略。
/// 返回值：此结构体用于传入 `thread_pool_new_with_config`，各字段会按资源保护上限归一化。
export struct ThreadPoolConfig {
    worker_count: i32,
    pending_capacity: i32,
    task_slot_capacity: i32,
    submit_strategy: i32,
}

/// `ThreadPool` 运行时指标快照。
/// 参数：无；通过 `thread_pool_metrics` 读取指定实例的当前值。
/// 返回值：包含容量、队列深度、当前运行 worker 数、饱和累计次数、取消次数和排空耗时等观测字段。
export struct ThreadPoolMetrics {
    worker_capacity: i32,
    queue_capacity: i32,
    task_slot_capacity: i32,
    started_workers: i32,
    running_workers: i32,
    queue_depth: i32,
    peak_queue_depth: i32,
    saturation_count: u64,
    cancel_count: u64,
    drain_count: u64,
    last_drain_time_us: u64,
    max_drain_time_us: u64,
    total_drain_time_us: u64,
}

fn thread_worker_set_nonblock(fd: i32) !i32 {
    const flags: i32 = try sys_fcntl(fd, F_GETFL, 0);
    _ = try sys_fcntl(fd, F_SETFL, flags | O_NONBLOCK);
    return 0;
}

fn thread_pool_has_shared_state(pool: &ThreadPool) bool {
    if pool == null as &ThreadPool {
        return false;
    }
    return pool._shared_state != null as &ThreadPoolSharedState;
}

fn thread_now_monotonic_us() u64 {
    var ts: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    const now_result: !i32 = sys_clock_gettime(CLOCK_MONOTONIC, &ts);
    _ = now_result catch {
        return 0u64;
    };
    if ts.tv_sec < 0 || ts.tv_nsec < 0 {
        return 0u64;
    }
    return (ts.tv_sec as u64) * (1000000 as u64) + ((ts.tv_nsec as u64) / (1000 as u64));
}

fn thread_elapsed_us(start_us: u64, end_us: u64) u64 {
    if end_us <= start_us {
        return 0u64;
    }
    return end_us - start_us;
}

fn thread_shared_record_peak_queue_depth(shared_state: &ThreadPoolSharedState) void {
    if shared_state == null as &ThreadPoolSharedState {
        return;
    }
    const current_depth: i32 = shared_state.pending_count;
    if current_depth > shared_state.peak_pending_count {
        shared_state.peak_pending_count = current_depth;
    }
}

fn thread_shared_record_drain_metrics(shared_state: &ThreadPoolSharedState, drain_us: u64) void {
    if shared_state == null as &ThreadPoolSharedState {
        return;
    }
    shared_state.total_drain_time_us = shared_state.total_drain_time_us + drain_us;
    if drain_us > shared_state.max_drain_time_us {
        shared_state.max_drain_time_us = drain_us;
    }
    shared_state.last_drain_time_us = drain_us;
    shared_state.drain_count = shared_state.drain_count + 1u64;
}

fn thread_shared_begin_drain(started_us: u64) u64 {
    if started_us != 0u64 {
        return started_us;
    }
    return thread_now_monotonic_us();
}

fn thread_shared_finish_drain(shared_state: &ThreadPoolSharedState, started_us: u64) u64 {
    if started_us == 0u64 {
        return 0u64;
    }
    const ended_us: u64 = thread_now_monotonic_us();
    var drain_us: u64 = thread_elapsed_us(started_us, ended_us);
    if drain_us == 0u64 {
        drain_us = 1u64;
    }
    thread_shared_record_drain_metrics(shared_state, drain_us);
    return 0u64;
}

fn thread_pool_record_cancel(pool: &ThreadPool) void {
    if pool == null as &ThreadPool {
        return;
    }
    pool._metrics_cancel_count = pool._metrics_cancel_count + 1u64;
}

fn thread_pool_running_worker_count(pool: &ThreadPool) i32 {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) {
        return 0;
    }
    var running_workers: i32 = 0;
    var slot_idx: i32 = 0;
    const slot_capacity: i32 = thread_pool_task_slot_capacity(pool);
    while slot_idx < slot_capacity {
        if pool._shared_state.slots[slot_idx as usize].state == THREAD_SLOT_STATE_RUNNING {
            running_workers = running_workers + 1;
        }
        slot_idx = slot_idx + 1;
    }
    return running_workers;
}

fn thread_pool_available_worker_headroom(pool: &ThreadPool) i32 {
    if pool == null as &ThreadPool {
        return 0;
    }
    var headroom: i32 = pool.worker_count - thread_pool_running_worker_count(pool);
    if headroom < 0 {
        headroom = 0;
    }
    return headroom;
}

fn thread_pool_record_saturation_if_needed(pool: &ThreadPool) void {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) {
        return;
    }
    if pool._shared_state.pending_count <= thread_pool_available_worker_headroom(pool) {
        return;
    }
    pool._shared_state.saturation_count = pool._shared_state.saturation_count + 1u64;
}

fn thread_pool_cache_shared_metrics(pool: &ThreadPool) void {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) {
        return;
    }
    pool._metrics_peak_queue_depth = pool._shared_state.peak_pending_count;
    pool._metrics_saturation_count = pool._shared_state.saturation_count;
    pool._metrics_drain_count = pool._shared_state.drain_count;
    pool._metrics_last_drain_time_us = pool._shared_state.last_drain_time_us;
    pool._metrics_max_drain_time_us = pool._shared_state.max_drain_time_us;
    pool._metrics_total_drain_time_us = pool._shared_state.total_drain_time_us;
}

fn thread_pool_capacity_bytes(count: i32, elem_size: usize) usize {
    if count <= 0 {
        return 0 as usize;
    }
    return (count as usize) * elem_size;
}

fn thread_pool_shared_bytes(pending_capacity: i32, task_slot_capacity: i32) usize {
    return @size_of(ThreadPoolSharedState)
        + thread_pool_capacity_bytes(task_slot_capacity, @size_of(ThreadTaskSlotRaw))
        + thread_pool_capacity_bytes(pending_capacity, @size_of(i32));
}

fn thread_pool_init_worker_storage(pool: &ThreadPool) i32 {
    if pool == null as &ThreadPool {
        return 0;
    }
    if pool._workers != null as &ThreadWorker {
        return 1;
    }
    const worker_bytes: usize = thread_pool_capacity_bytes(pool.worker_count, @size_of(ThreadWorker));
    if worker_bytes == 0 as usize {
        return 0;
    }
    const workers: &ThreadWorker = malloc(worker_bytes) as &ThreadWorker;
    if workers == null as &ThreadWorker {
        return 0;
    }
    pool._workers = workers;
    pool._workers_bytes = worker_bytes;
    return 1;
}

fn thread_pool_ensure_shared_state(pool: &ThreadPool) i32 {
    if pool == null as &ThreadPool {
        return 0;
    }
    if thread_pool_has_shared_state(pool) {
        return 1;
    }

    const map_bytes: usize = thread_pool_shared_bytes(pool.pending_capacity, pool.task_slot_capacity);
    if map_bytes == 0 as usize {
        return 0;
    }
    const map_result: !i64 = @syscall(SYS_mmap, 0, map_bytes as i64,
                                      PROT_READ | PROT_WRITE,
                                      MAP_SHARED | MAP_ANONYMOUS, 0 - 1, 0);
    const mapped_ptr: i64 = map_result catch {
        return 0;
    };
    const shared_state: &ThreadPoolSharedState = (mapped_ptr as usize) as &ThreadPoolSharedState;
    if shared_state == null as &ThreadPoolSharedState {
        return 0;
    }
    const slots_offset: usize = @size_of(ThreadPoolSharedState);
    const pending_offset: usize = slots_offset + thread_pool_capacity_bytes(pool.task_slot_capacity, @size_of(ThreadTaskSlotRaw));
    shared_state.pending_capacity = pool.pending_capacity;
    shared_state.task_slot_capacity = pool.task_slot_capacity;
    shared_state.mapped_bytes = map_bytes;
    shared_state.pending_head = 0;
    shared_state.pending_tail = 0;
    shared_state.pending_count = 0;
    shared_state.peak_pending_count = 0;
    shared_state.saturation_count = 0u64;
    shared_state.drain_count = 0u64;
    shared_state.last_drain_time_us = 0u64;
    shared_state.max_drain_time_us = 0u64;
    shared_state.total_drain_time_us = 0u64;
    shared_state.slots = @ptr_from_usize((mapped_ptr as usize) + slots_offset) as &ThreadTaskSlotRaw;
    shared_state.pending_slots = @ptr_from_usize((mapped_ptr as usize) + pending_offset) as &i32;
    pool._shared_state = shared_state;
    return 1;
}

fn thread_pool_slot_is_valid_for_capacity(slot_idx: i32, capacity: i32) bool {
    return slot_idx >= 0 && capacity > 0 && slot_idx < capacity;
}

fn thread_pool_slot_is_valid(pool: &ThreadPool, slot_idx: i32) bool {
    if pool == null as &ThreadPool {
        return false;
    }
    return thread_pool_slot_is_valid_for_capacity(slot_idx, thread_pool_task_slot_capacity(pool));
}

fn thread_shared_slot_is_valid(shared_state: &ThreadPoolSharedState, slot_idx: i32) bool {
    if shared_state == null as &ThreadPoolSharedState {
        return false;
    }
    return thread_pool_slot_is_valid_for_capacity(slot_idx, thread_shared_task_slot_capacity(shared_state));
}

fn thread_pool_task_slot_capacity(pool: &ThreadPool) i32 {
    if pool == null as &ThreadPool {
        return 1;
    }
    if pool.task_slot_capacity <= 0 {
        return 1;
    }
    return pool.task_slot_capacity;
}

fn thread_shared_task_slot_capacity(shared_state: &ThreadPoolSharedState) i32 {
    if shared_state == null as &ThreadPoolSharedState {
        return THREAD_POOL_MAX_TASK_SLOTS;
    }
    if shared_state.task_slot_capacity <= 0 {
        return THREAD_POOL_MAX_TASK_SLOTS;
    }
    return shared_state.task_slot_capacity;
}

fn thread_shared_pending_capacity(shared_state: &ThreadPoolSharedState) i32 {
    if shared_state == null as &ThreadPoolSharedState {
        return THREAD_POOL_MAX_PENDING;
    }
    if shared_state.pending_capacity <= 0 {
        return THREAD_POOL_MAX_PENDING;
    }
    return shared_state.pending_capacity;
}

fn thread_pool_reserve_slot_raw(pool: &ThreadPool, compute_fn: &void, task_kind: i32, arg_bits: usize) !i32 {
    if thread_pool_ensure_shared_state(pool) == 0 {
        return thread_generic_error_i32();
    }

    var i: i32 = 0;
    const slot_capacity: i32 = thread_pool_task_slot_capacity(pool);
    while i < slot_capacity {
        if pool._shared_state.slots[i as usize].state == THREAD_SLOT_STATE_FREE {
            pool._shared_state.slots[i as usize].worker_idx = 0 - 1;
            pool._shared_state.slots[i as usize].task_kind = task_kind;
            pool._shared_state.slots[i as usize].fn_bits = (compute_fn as usize) as i64;
            pool._shared_state.slots[i as usize].arg_bits = arg_bits;
            pool._shared_state.slots[i as usize].result_bits = 0 as usize;
            pool._shared_state.slots[i as usize].state = THREAD_SLOT_STATE_READY;
            const reserved_idx: i32 = i;
            return reserved_idx;
        }
        i = i + 1;
    }

    return thread_capacity_error_i32();
}

fn thread_shared_clear_slot(shared_state: &ThreadPoolSharedState, slot_idx: i32) void {
    if shared_state == null as &ThreadPoolSharedState || !thread_shared_slot_is_valid(shared_state, slot_idx) {
        return;
    }
    if thread_shared_slot_is_valid(shared_state, slot_idx) {
        shared_state.slots[slot_idx as usize].worker_idx = 0 - 1;
        shared_state.slots[slot_idx as usize].task_kind = 0;
        shared_state.slots[slot_idx as usize].result_bits = 0 as usize;
        shared_state.slots[slot_idx as usize].arg_bits = 0 as usize;
        shared_state.slots[slot_idx as usize].fn_bits = 0;
        shared_state.slots[slot_idx as usize].state = THREAD_SLOT_STATE_FREE;
    }
}

fn thread_pool_release_slot(pool: &ThreadPool, slot_idx: i32) void {
    if !thread_pool_has_shared_state(pool) || !thread_pool_slot_is_valid(pool, slot_idx) {
        return;
    }
    thread_shared_clear_slot(pool._shared_state, slot_idx);
}

fn thread_worker_loop(worker_idx: i32, cmd_read_fd: i32, result_write_fd: i32, shared_state: &ThreadPoolSharedState) void {
    while true {
        var drain_started_us: u64 = 0u64;
        var cmd: ThreadWorkerCommand = ThreadWorkerCommand{ slot_idx: THREAD_WORKER_STOP_SLOT, reserved: 0 };
        const read_result: !isize = sys_read(cmd_read_fd, (&cmd) as *byte, @size_of(ThreadWorkerCommand));
        const n: isize = read_result catch {
            (0 - 1) as isize;
        };
        if n < 0 {
            break;
        }
        if n == 0 {
            break;
        }
        if n != @size_of(ThreadWorkerCommand) as isize {
            break;
        }
        if cmd.slot_idx == THREAD_WORKER_STOP_SLOT {
            break;
        }
        if cmd.slot_idx != THREAD_WORKER_DRAIN_QUEUE && !thread_shared_slot_is_valid(shared_state, cmd.slot_idx) {
            break;
        }

        var active_slot: i32 = cmd.slot_idx;
        if active_slot == THREAD_WORKER_DRAIN_QUEUE {
            active_slot = thread_shared_pop_slot(shared_state);
            if active_slot >= 0 {
                drain_started_us = thread_shared_begin_drain(drain_started_us);
            }
        }
        while active_slot >= 0 {
            if !thread_shared_slot_is_valid(shared_state, active_slot) {
                break;
            }
            if active_slot < 0 || active_slot >= thread_shared_task_slot_capacity(shared_state) {
                break;
            }

            const slot_idx: i32 = active_slot;
            if thread_shared_slot_is_valid(shared_state, slot_idx) {
                shared_state.slots[slot_idx as usize].worker_idx = worker_idx;
                shared_state.slots[slot_idx as usize].state = THREAD_SLOT_STATE_RUNNING;
                const fn_ptr: &void = (shared_state.slots[slot_idx as usize].fn_bits as usize) as &void;
                var result_bits: usize = 0 as usize;
                if shared_state.slots[slot_idx as usize].task_kind == THREAD_TASK_KIND_USIZE {
                    result_bits = thread_call_usize(fn_ptr, shared_state.slots[slot_idx as usize].arg_bits);
                } else if shared_state.slots[slot_idx as usize].task_kind == THREAD_TASK_KIND_U32 {
                    const value_u32: u32 = thread_call_u32(fn_ptr, shared_state.slots[slot_idx as usize].arg_bits as u32);
                    result_bits = value_u32 as usize;
                } else if shared_state.slots[slot_idx as usize].task_kind == THREAD_TASK_KIND_F32 {
                    const value_u32: u32 = thread_call_f32(fn_ptr, shared_state.slots[slot_idx as usize].arg_bits as u32);
                    result_bits = value_u32 as usize;
                } else if shared_state.slots[slot_idx as usize].task_kind == THREAD_TASK_KIND_F64 {
                    const value_u64: u64 = thread_call_f64(fn_ptr, shared_state.slots[slot_idx as usize].arg_bits as u64);
                    result_bits = value_u64 as usize;
                } else {
                    const value_i32: i32 = thread_call_i32(fn_ptr, shared_state.slots[slot_idx as usize].arg_bits as i32);
                    result_bits = value_i32 as usize;
                }
                shared_state.slots[slot_idx as usize].result_bits = result_bits;
                shared_state.slots[slot_idx as usize].state = THREAD_SLOT_STATE_DONE;

                var completed_slot_bits: usize = slot_idx as usize;
                const write_result: !isize = sys_write(result_write_fd, (&completed_slot_bits) as *const byte, @size_of(usize));
                const written: isize = write_result catch {
                    (0 - 1) as isize;
                };
                if written < 0 {
                    break;
                }
                if written != @size_of(usize) as isize {
                    break;
                }

                active_slot = thread_shared_pop_slot(shared_state);
                const next_slot: i32 = active_slot;
                if thread_shared_slot_is_valid(shared_state, next_slot) {
                    drain_started_us = thread_shared_begin_drain(drain_started_us);
                    shared_state.slots[next_slot as usize].worker_idx = worker_idx;
                    shared_state.slots[next_slot as usize].state = THREAD_SLOT_STATE_RUNNING;
                }
            }
        }
        drain_started_us = thread_shared_finish_drain(shared_state, drain_started_us);
    }
}

fn thread_worker_main(arg: &void) &void {
    const start: &ThreadWorkerStart = arg as &ThreadWorkerStart;
    if start == null {
        return null;
    }
    thread_worker_loop(start.worker_idx, start.cmd_read_fd, start.result_write_fd, start.shared_state);
    _ = sys_close(start.cmd_read_fd);
    _ = sys_close(start.result_write_fd);
    free(start as &void);
    return null;
}

fn thread_pool_spawn_worker(pool: &ThreadPool, worker_idx: i32) !i32 {
    if thread_pool_ensure_shared_state(pool) == 0 {
        return thread_generic_error_i32();
    }
    if thread_pool_init_worker_storage(pool) == 0 {
        return thread_generic_error_i32();
    }

    var cmd_fds: [i32: 2] = [];
    const cmd_result: !i32 = sys_pipe2(&cmd_fds[0], 0);
    _ = cmd_result catch {
        return cmd_result as! i32;
    };

    var result_fds: [i32: 2] = [];
    const result_result: !i32 = sys_pipe2(&result_fds[0], 0);
    _ = result_result catch {
        _ = sys_close(cmd_fds[0]);
        _ = sys_close(cmd_fds[1]);
        return result_result as! i32;
    };

    const nonblock_result: !i32 = thread_worker_set_nonblock(result_fds[0]);
    _ = nonblock_result catch {
        _ = sys_close(cmd_fds[0]);
        _ = sys_close(cmd_fds[1]);
        _ = sys_close(result_fds[0]);
        _ = sys_close(result_fds[1]);
        return nonblock_result as! i32;
    };

    const start: &ThreadWorkerStart = malloc(@size_of(ThreadWorkerStart) as usize) as &ThreadWorkerStart;
    if start == null {
        _ = sys_close(cmd_fds[0]);
        _ = sys_close(cmd_fds[1]);
        _ = sys_close(result_fds[0]);
        _ = sys_close(result_fds[1]);
        return thread_generic_error_i32();
    }

    start.worker_idx = worker_idx;
    start.cmd_read_fd = cmd_fds[0];
    start.result_write_fd = result_fds[1];
    start.shared_state = pool._shared_state;

    if worker_idx < 0 || worker_idx >= pool.worker_count {
        free(start as &void);
        _ = sys_close(cmd_fds[0]);
        _ = sys_close(cmd_fds[1]);
        _ = sys_close(result_fds[0]);
        _ = sys_close(result_fds[1]);
        return thread_generic_error_i32();
    }

    pool._workers[worker_idx as usize] = ThreadWorker{
        thread: pthread_t{},
        cmd_write_fd: cmd_fds[1],
        result_read_fd: result_fds[0],
        busy: 0,
        active: 0,
        active_slot: 0 - 1,
    };

    if worker_idx >= 0 && worker_idx < pool.worker_count {
        const create_result: i32 = pthread_create(&pool._workers[worker_idx as usize].thread,
                                                  null as &const pthread_attr_t,
                                                  &thread_worker_main as &void,
                                                  start as &void);
        if create_result != 0 {
            free(start as &void);
            _ = sys_close(cmd_fds[0]);
            _ = sys_close(cmd_fds[1]);
            _ = sys_close(result_fds[0]);
            _ = sys_close(result_fds[1]);
            pool._workers[worker_idx as usize] = ThreadWorker{
                thread: pthread_t{},
                cmd_write_fd: 0 - 1,
                result_read_fd: 0 - 1,
                busy: 0,
                active: 0,
                active_slot: 0 - 1,
            };
            return thread_generic_error_i32();
        }

        pool._workers[worker_idx as usize].active = 1;
        pool._started_workers = pool._started_workers + 1;
        return 0;
    }
    return thread_generic_error_i32();
}

fn thread_pool_try_acquire_idle_worker(pool: &ThreadPool) i32 {
    if pool._started_workers <= 0 {
        return 0 - 1;
    }

    var offset: i32 = 0;
    while offset < pool._started_workers {
        const idx: i32 = (pool._next_worker + offset) % pool._started_workers;
        if idx >= 0 && idx < pool.worker_count {
            if pool._workers[idx as usize].active != 0 && pool._workers[idx as usize].busy == 0 {
                pool._workers[idx as usize].busy = 1;
                pool._workers[idx as usize].active_slot = 0 - 1;
                pool._next_worker = idx + 1;
                if pool._next_worker >= pool._started_workers {
                    pool._next_worker = 0;
                }
                return idx;
            }
        }
        offset = offset + 1;
    }
    return 0 - 1;
}

fn thread_pool_refresh_worker_state(pool: &ThreadPool, worker_idx: i32) void {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) {
        return;
    }
    if worker_idx < 0 || worker_idx >= pool._started_workers || worker_idx >= pool.worker_count {
        return;
    }
    if worker_idx >= 0 && worker_idx < pool.worker_count {
        if pool._workers[worker_idx as usize].active == 0 {
            return;
        }
    }

    var slot_idx: i32 = 0;
    const slot_capacity: i32 = thread_pool_task_slot_capacity(pool);
    while slot_idx < slot_capacity {
        const slot_state: i32 = pool._shared_state.slots[slot_idx as usize].state;
        // 仅 RUNNING 视为占用：worker 正在执行该 slot。
        // DONE 表示任务已算完、结果待 future 读取，worker 旋即回到 pop/阻塞读，
        // 实际可立即复用；若把 DONE 也算占用，会让"刚完成上一个任务的 worker"
        // 在下一次 acquire 时被误判为忙，从而多 spawn 一个冗余 worker（CI 少核下偶发）。
        if slot_state == THREAD_SLOT_STATE_RUNNING &&
           pool._shared_state.slots[slot_idx as usize].worker_idx == worker_idx {
            if worker_idx >= 0 && worker_idx < pool.worker_count {
                pool._workers[worker_idx as usize].busy = 1;
                pool._workers[worker_idx as usize].active_slot = slot_idx;
            }
            return;
        }
        slot_idx = slot_idx + 1;
    }

    if worker_idx >= 0 && worker_idx < pool.worker_count {
        pool._workers[worker_idx as usize].busy = 0;
        pool._workers[worker_idx as usize].active_slot = 0 - 1;
    }
}

fn thread_pool_acquire_worker(pool: &ThreadPool) !i32 {
    var refresh_idx: i32 = 0;
    while refresh_idx < pool._started_workers {
        thread_pool_refresh_worker_state(pool, refresh_idx);
        refresh_idx = refresh_idx + 1;
    }

    const idle_idx: i32 = thread_pool_try_acquire_idle_worker(pool);
    if idle_idx >= 0 {
        return idle_idx;
    }

    // 只有在确实仍有待处理任务时才扩容 worker。
    // acquire 入口与此处之间，既有 worker 可能已 pop 并跑完该 slot（pending 归零），
    // 此时再 spawn 出来的 worker 无事可做，只是把 _started_workers 抬高——
    // 这正是少核/高负载环境下 started_workers 偶发等于 2 的直接原因。
    if pool._started_workers < pool.worker_count
        && thread_pool_has_shared_state(pool) && pool._shared_state.pending_count > 0 {
        if thread_pool_ensure_shared_state(pool) == 0 {
            return 0 - 1;
        }

        const new_idx: i32 = pool._started_workers;
        _ = try thread_pool_spawn_worker(pool, new_idx);
        if new_idx >= 0 && new_idx < pool.worker_count {
            pool._workers[new_idx as usize].busy = 1;
            pool._workers[new_idx as usize].active_slot = 0 - 1;
            pool._next_worker = 0;
            return new_idx;
        }
    }

    return 0 - 1;
}

fn thread_pool_release_worker(pool: &ThreadPool, worker_idx: i32) void {
    if pool == null as &ThreadPool {
        return;
    }
    if worker_idx < 0 || worker_idx >= pool._started_workers || worker_idx >= pool.worker_count {
        return;
    }
    if worker_idx >= 0 && worker_idx < pool.worker_count {
        if pool._workers[worker_idx as usize].active == 0 {
            return;
        }
        thread_pool_refresh_worker_state(pool, worker_idx);
    }
}

fn thread_pool_has_pending(pool: &ThreadPool) bool {
    if pool == null as &ThreadPool {
        return false;
    }
    if !thread_pool_has_shared_state(pool) {
        return false;
    }
    return pool._shared_state.pending_count > 0;
}

fn thread_pool_pending_len(pool: &ThreadPool) i32 {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) {
        return 0;
    }
    const pending_count: i32 = pool._shared_state.pending_count;
    return pending_count;
}

fn thread_pool_try_kick_drain(pool: &ThreadPool) !i32 {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) || pool._shared_state.pending_count <= 0 {
        return 0;
    }

    const worker_result: !i32 = thread_pool_acquire_worker(pool);
    const worker_idx: i32 = worker_result catch {
        return worker_result as! i32;
    };
    if worker_idx < 0 || worker_idx >= pool.worker_count {
        return 0;
    }

    if !thread_pool_has_pending(pool) {
        thread_pool_release_worker(pool, worker_idx);
        return 0;
    }

    var cmd: ThreadWorkerCommand = ThreadWorkerCommand{
        slot_idx: THREAD_WORKER_DRAIN_QUEUE,
        reserved: 0,
    };
    if worker_idx >= 0 && worker_idx < pool.worker_count {
        const cmd_fd: i32 = pool._workers[worker_idx as usize].cmd_write_fd;
        const write_result: !isize = sys_write(cmd_fd, (&cmd) as *const byte, @size_of(ThreadWorkerCommand));
        const written: isize = write_result catch {
            thread_pool_release_worker(pool, worker_idx);
            return write_result as! i32;
        };
        if written != @size_of(ThreadWorkerCommand) as isize {
            thread_pool_release_worker(pool, worker_idx);
            return thread_generic_error_i32();
        }
    }

    return 1;
}

fn thread_pool_try_progress_slot(pool: &ThreadPool, slot_idx: i32) !i32 {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) || !thread_pool_slot_is_valid(pool, slot_idx) {
        return 0;
    }
    if thread_pool_slot_is_valid(pool, slot_idx) {
        if pool._shared_state.slots[slot_idx as usize].state != THREAD_SLOT_STATE_QUEUED {
            return 0;
        }
    }
    const kick_result: !i32 = thread_pool_try_kick_drain(pool);
    const kicked: i32 = kick_result catch {
        return kick_result as! i32;
    };
    return kicked;
}

// 显式替代旧 one-shot fallback：先走共享 pending 队列，容量不足时直接返回资源错误。
fn thread_pool_queue_or_error_slot(pool: &ThreadPool, slot_idx: i32) !i32 {
    if thread_pool_enqueue_slot(pool, slot_idx) != 0 {
        const queued_idx: i32 = slot_idx;
        return queued_idx;
    }
    thread_pool_release_slot(pool, slot_idx);
    return thread_capacity_error_i32();
}

fn thread_pool_apply_submission_strategy(pool: &ThreadPool, slot_idx: i32) !i32 {
    const submission_strategy: i32 = thread_pool_submission_strategy(pool);
    if submission_strategy == THREAD_POOL_SUBMIT_STRATEGY_QUEUE_OR_ERROR {
        return thread_pool_queue_or_error_slot(pool, slot_idx);
    }
    thread_pool_release_slot(pool, slot_idx);
    return thread_generic_error_i32();
}

fn thread_pool_submit_slot_raw(pool: &ThreadPool, compute_fn: &void, task_kind: i32, arg_bits: usize) !i32 {
    const slot_idx: i32 = try thread_pool_reserve_slot_raw(pool, compute_fn, task_kind, arg_bits);
    return try thread_pool_apply_submission_strategy(pool, slot_idx);
}

fn thread_pool_submit_slot_i32(pool: &ThreadPool, compute_fn: &void, arg: i32) !i32 {
    return thread_pool_submit_slot_raw(pool, compute_fn, THREAD_TASK_KIND_I32, arg as usize);
}

fn thread_pool_submit_slot_usize(pool: &ThreadPool, compute_fn: &void, arg: usize) !i32 {
    return thread_pool_submit_slot_raw(pool, compute_fn, THREAD_TASK_KIND_USIZE, arg);
}

fn thread_pool_submit_slot_u32(pool: &ThreadPool, compute_fn: &void, arg: u32) !i32 {
    return thread_pool_submit_slot_raw(pool, compute_fn, THREAD_TASK_KIND_U32, arg as usize);
}

fn thread_pool_enqueue_slot(pool: &ThreadPool, slot_idx: i32) i32 {
    if pool == null as &ThreadPool || !thread_pool_slot_is_valid(pool, slot_idx) || !thread_pool_has_shared_state(pool) {
        return 0;
    }
    const pending_capacity: i32 = thread_shared_pending_capacity(pool._shared_state);
    if pool._shared_state.pending_count >= pending_capacity {
        return 0;
    }
    if pool._shared_state.pending_tail >= 0 && pool._shared_state.pending_tail < pending_capacity {
        pool._shared_state.pending_slots[pool._shared_state.pending_tail as usize] = slot_idx;
        pool._shared_state.pending_tail = pool._shared_state.pending_tail + 1;
        if pool._shared_state.pending_tail >= pending_capacity {
            pool._shared_state.pending_tail = 0;
        }
        pool._shared_state.pending_count = pool._shared_state.pending_count + 1;
        thread_shared_record_peak_queue_depth(pool._shared_state);
        if thread_shared_slot_is_valid(pool._shared_state, slot_idx) {
            pool._shared_state.slots[slot_idx as usize].state = THREAD_SLOT_STATE_QUEUED;
        }
        thread_pool_record_saturation_if_needed(pool);
        return 1;
    }
    return 0;
}

fn thread_shared_remove_pending_slot(shared_state: &ThreadPoolSharedState, slot_idx: i32) i32 {
    if shared_state == null as &ThreadPoolSharedState || shared_state.pending_count <= 0 {
        return 0;
    }

    var remaining: i32 = shared_state.pending_count;
    var read_idx: i32 = shared_state.pending_head;
    var write_idx: i32 = 0;
    var kept_count: i32 = 0;
    var removed: i32 = 0;
    const pending_capacity: i32 = thread_shared_pending_capacity(shared_state);

    while remaining > 0 {
        if read_idx >= 0 && read_idx < pending_capacity {
            const pending_idx: i32 = read_idx;
            if pending_idx >= 0 && pending_idx < pending_capacity {
                const queued_slot: i32 = shared_state.pending_slots[pending_idx as usize];
                shared_state.pending_slots[pending_idx as usize] = 0;
                if removed == 0 && queued_slot == slot_idx {
                    removed = 1;
                } else if kept_count >= 0 && kept_count < pending_capacity {
                    shared_state.pending_slots[write_idx as usize] = queued_slot;
                    write_idx = write_idx + 1;
                    kept_count = kept_count + 1;
                }
                read_idx = read_idx + 1;
                if read_idx >= pending_capacity {
                    read_idx = 0;
                }
                remaining = remaining - 1;
            } else {
                break;
            }
        } else {
            break;
        }
    }

    shared_state.pending_head = 0;
    shared_state.pending_tail = 0;
    shared_state.pending_count = 0;
    shared_state.pending_tail = kept_count;
    if shared_state.pending_tail >= pending_capacity {
        shared_state.pending_tail = 0;
    }
    shared_state.pending_count = kept_count;
    return removed;
}

fn thread_shared_pop_slot(shared_state: &ThreadPoolSharedState) i32 {
    if shared_state == null as &ThreadPoolSharedState || shared_state.pending_count <= 0 {
        return 0 - 1;
    }

    const pending_capacity: i32 = thread_shared_pending_capacity(shared_state);
    const slot_capacity: i32 = thread_shared_task_slot_capacity(shared_state);
    while shared_state.pending_count > 0 {
        if shared_state.pending_head >= 0 && shared_state.pending_head < pending_capacity {
            const slot_idx: i32 = shared_state.pending_slots[shared_state.pending_head as usize];
            shared_state.pending_slots[shared_state.pending_head as usize] = 0;
            shared_state.pending_head = shared_state.pending_head + 1;
            if shared_state.pending_head >= pending_capacity {
                shared_state.pending_head = 0;
            }
            shared_state.pending_count = shared_state.pending_count - 1;

            if !thread_shared_slot_is_valid(shared_state, slot_idx) {
                continue;
            }
            if slot_idx < 0 || slot_idx >= slot_capacity {
                continue;
            }

            if thread_shared_slot_is_valid(shared_state, slot_idx) {
                const slot_state: i32 = shared_state.slots[slot_idx as usize].state;
                if slot_state == THREAD_SLOT_STATE_QUEUED {
                    return slot_idx;
                }
                if slot_state == THREAD_SLOT_STATE_CANCELLED {
                    thread_shared_clear_slot(shared_state, slot_idx);
                }
            }
        } else {
            break;
        }
    }
    return 0 - 1;
}

fn thread_async_try_slot_result_fd(pool: &ThreadPool, slot_idx: i32) i32 {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) || !thread_pool_slot_is_valid(pool, slot_idx) {
        return 0 - 1;
    }

    const slot_state: i32 = pool._shared_state.slots[slot_idx as usize].state;
    if slot_state != THREAD_SLOT_STATE_RUNNING && slot_state != THREAD_SLOT_STATE_DONE {
        return 0 - 1;
    }

    const worker_idx: i32 = pool._shared_state.slots[slot_idx as usize].worker_idx;
    if worker_idx >= 0 && worker_idx < pool._started_workers && worker_idx < pool.worker_count {
        if pool._workers[worker_idx as usize].active != 0 {
            return pool._workers[worker_idx as usize].result_read_fd;
        }
    }

    return 0 - 1;
}

fn thread_async_slot_is_done(pool: &ThreadPool, slot_idx: i32) bool {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) || !thread_pool_slot_is_valid(pool, slot_idx) {
        return false;
    }
    return pool._shared_state.slots[slot_idx as usize].state == THREAD_SLOT_STATE_DONE;
}

fn thread_async_drain_result_fd(read_fd: i32) void {
    if read_fd < 0 {
        return;
    }
    while true {
        var raw_value: usize = 0 as usize;
        const read_result: !isize = sys_read(read_fd, (&raw_value) as *byte, @size_of(usize));
        const n: isize = read_result catch |err| {
            if thread_error_id_is_would_block(@error_id(err)) {
                return;
            }
            return;
        };
        if n != @size_of(usize) as isize {
            return;
        }
    }
}

// worker bridge substrate：当前 runtime 中第二类允许保留的手写 poll() 例外。
// 它直接承接 ThreadPool shared slot / result pipe / cooperative cancel / cleanup 协议，当前不能无损下沉成通用 fd wait substrate。
// 对外业务入口继续只暴露 `@async_fn async_compute<T>`；这组 leaf 只负责线程调度桥接。
// 拆出 slot-wait awaitable，供后续 `@async_fn` 直接复用。
struct AsyncThreadSlotWaitFuture : Future<!usize> {
    pool: &ThreadPool,
    slot_idx: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!usize> {
        const read_fd: i32 = thread_async_try_slot_result_fd(self.pool, self.slot_idx);
        if read_fd >= 0 {
            return async_poll_ready_ok_usize(read_fd as usize);
        }

        const progress_result: !i32 = thread_pool_try_progress_slot(self.pool, self.slot_idx);
        const progressed: i32 = progress_result catch {
            const err_value: !usize = progress_result as! usize;
            return Poll<!usize>.Ready(err_value);
        };
        if progressed != 0 {
            waker.wake();
        }
        return Poll<!usize>.Pending({});
    }

    fn release(self: &Self) void {
        async_box_free_current(self as &byte);
    }
}

fn async_thread_slot_wait(pool: &ThreadPool, slot_idx: i32) Future<!usize> {
    if slot_idx < 0 {
        return Future<!usize>{ state: Poll<!usize>.Ready(thread_generic_error_usize()) };
    }
    return AsyncThreadSlotWaitFuture{
        pool: pool,
        slot_idx: slot_idx,
    };
}

// 拆出 worker submit/queue awaitable，后续 `@async_fn` 组合层可直接 await。
struct AsyncWorkerSubmitFuture : Future<!usize> {
    pool: &ThreadPool,
    compute_fn: &void,
    task_kind: i32,
    arg_bits: usize,

    fn poll(self: &Self, waker: &Waker) Poll<!usize> {
        const submit_result: !i32 = thread_pool_submit_slot_raw(self.pool, self.compute_fn, self.task_kind, self.arg_bits);
        const slot_idx: i32 = submit_result catch {
            const err_value: !usize = submit_result as! usize;
            return Poll<!usize>.Ready(err_value);
        };
        if thread_pool_has_pending(self.pool) {
            waker.wake();
        }
        return async_poll_ready_ok_usize(slot_idx as usize);
    }

    fn release(self: &Self) void {
        async_box_free_current(self as &byte);
    }
}

fn async_worker_submit(pool: &ThreadPool, compute_fn: &void, task_kind: i32, arg_bits: usize) Future<!usize> {
    return AsyncWorkerSubmitFuture{
        pool: pool,
        compute_fn: compute_fn,
        task_kind: task_kind,
        arg_bits: arg_bits,
    };
}

// worker result leaf 仍留在上述 substrate 内部：
// 它依赖 ThreadPool slot/worker 协议，而不是通用 fd runtime 叶子。
// raw compute substrate 只对上层暴露单个 awaitable，不再让 typed wrapper 手工拼接 slot wait + pipe read 两段桥接。
struct AsyncWorkerResultFuture : Future<!usize> {
    pool: &ThreadPool,
    slot_idx: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!usize> {
        if thread_async_slot_is_done(self.pool, self.slot_idx) {
            const done_fd: i32 = thread_async_try_slot_result_fd(self.pool, self.slot_idx);
            thread_async_drain_result_fd(done_fd);
            return async_poll_ready_ok_usize(self.slot_idx as usize);
        }

        const wait_future: Future<!usize> = async_thread_slot_wait(self.pool, self.slot_idx);
        const wait_poll: Poll<!usize> = wait_future.poll(waker);
        var read_fd: i32 = 0 - 1;
        match wait_poll {
            .Ready(wait_result) => {
                const read_fd_bits: usize = wait_result catch {
                    return wait_poll;
                };
                read_fd = read_fd_bits as i32;
            },
            .Pending(_) => {
                return wait_poll;
            },
        };

        var raw_value: usize = 0 as usize;
        const read_result: !isize = sys_read(read_fd, (&raw_value) as *byte, @size_of(usize));
        const n: isize = read_result catch |err| {
            if thread_error_id_is_would_block(@error_id(err)) {
                return async_poll_pending_readable_usize(waker, read_fd);
            }
            const err_value: !usize = read_result as! usize;
            return Poll<!usize>.Ready(err_value);
        };
        if n != @size_of(usize) as isize {
            return Poll<!usize>.Ready(thread_generic_error_usize());
        }
        if raw_value != self.slot_idx as usize {
            if thread_async_slot_is_done(self.pool, self.slot_idx) {
                thread_async_drain_result_fd(read_fd);
                return async_poll_ready_ok_usize(self.slot_idx as usize);
            }
            return Poll<!usize>.Pending({});
        }
        return async_poll_ready_ok_usize(raw_value);
    }

    fn release(self: &Self) void {
        async_box_free_current(self as &byte);
    }
}

fn async_worker_result(pool: &ThreadPool, slot_idx: i32) Future<!usize> {
    if slot_idx < 0 {
        return Future<!usize>{ state: Poll<!usize>.Ready(thread_generic_error_usize()) };
    }
    return AsyncWorkerResultFuture{
        pool: pool,
        slot_idx: slot_idx,
    };
}

struct AsyncWorkerCancelFuture : Future<!usize> {
    pool: &ThreadPool,
    slot_idx: i32,

    fn poll(self: &Self, waker: &Waker) Poll<!usize> {
        if thread_async_try_cancel_now(self.pool, self.slot_idx) != 0 {
            return Poll<!usize>.Ready(thread_cancelled_error_usize());
        }

        const raw_future: Future<!usize> = async_worker_result(self.pool, self.slot_idx);
        const raw_poll: Poll<!usize> = raw_future.poll(waker);
        match raw_poll {
            .Ready(_) => {
                return Poll<!usize>.Ready(thread_cancelled_error_usize());
            },
            .Pending(_) => {
                return Poll<!usize>.Pending({});
            },
        };
        abort();
        return Poll<!usize>.Pending({});
    }

    fn release(self: &Self) void {
        async_box_free_current(self as &byte);
    }
}

fn async_worker_cancel(pool: &ThreadPool, slot_idx: i32) Future<!usize> {
    return AsyncWorkerCancelFuture{
        pool: pool,
        slot_idx: slot_idx,
    };
}

fn thread_async_active_worker_idx(pool: &ThreadPool, slot_idx: i32) i32 {
    if pool == null as &ThreadPool || !thread_pool_has_shared_state(pool) || !thread_pool_slot_is_valid(pool, slot_idx) {
        return 0 - 1;
    }

    const slot_state: i32 = pool._shared_state.slots[slot_idx as usize].state;
    if slot_state != THREAD_SLOT_STATE_RUNNING && slot_state != THREAD_SLOT_STATE_DONE {
        return 0 - 1;
    }

    const worker_idx: i32 = pool._shared_state.slots[slot_idx as usize].worker_idx;
    if worker_idx < 0 || worker_idx >= pool._started_workers || worker_idx >= pool.worker_count {
        return 0 - 1;
    }
    if pool._workers[worker_idx as usize].active == 0 {
        return 0 - 1;
    }
    return worker_idx;
}

fn thread_async_cleanup_slot(pool: &ThreadPool, slot_idx: i32) i32 {
    const worker_idx: i32 = thread_async_active_worker_idx(pool, slot_idx);
    if worker_idx >= 0 {
        thread_pool_release_worker(pool, worker_idx);
    }
    if slot_idx >= 0 {
        thread_pool_release_slot(pool, slot_idx);
    }
    return 0 - 1;
}

fn thread_async_try_cancel_now(pool: &ThreadPool, slot_idx: i32) i32 {
    if slot_idx < 0 {
        return 1;
    }

    if !thread_pool_has_shared_state(pool) || !thread_pool_slot_is_valid(pool, slot_idx) {
        return 1;
    }

    const shared_state: &ThreadPoolSharedState = pool._shared_state;
    const slot_state: i32 = shared_state.slots[slot_idx as usize].state;
    if slot_state == THREAD_SLOT_STATE_READY {
        thread_shared_clear_slot(shared_state, slot_idx);
        return 1;
    }
    if slot_state == THREAD_SLOT_STATE_QUEUED {
        if thread_shared_remove_pending_slot(shared_state, slot_idx) != 0 {
            thread_shared_clear_slot(shared_state, slot_idx);
        } else {
            shared_state.slots[slot_idx as usize].state = THREAD_SLOT_STATE_CANCELLED;
        }
        return 1;
    }
    return 0;
}

fn thread_async_compute_resolve_raw_value(pool: &ThreadPool, slot_idx: i32, raw_value: usize) !usize {
    if slot_idx < 0 {
        return raw_value;
    }

    if !thread_pool_has_shared_state(pool) || !thread_pool_slot_is_valid(pool, slot_idx) {
        return thread_generic_error_usize();
    }
    if raw_value != slot_idx as usize {
        return thread_generic_error_usize();
    }

    const slot_state: i32 = pool._shared_state.slots[slot_idx as usize].state;
    if slot_state != THREAD_SLOT_STATE_DONE {
        return thread_generic_error_usize();
    }
    return pool._shared_state.slots[slot_idx as usize].result_bits;
}

struct AsyncWorkerComputeFuture : Future<!usize> {
    pool: &ThreadPool,
    compute_fn: &void,
    task_kind: i32,
    arg_bits: usize,
    slot_idx: i32,
    first_poll: i32,
    done: i32,
    cancel_requested: i32,
    state: Poll<!usize>,

    fn finish(self: &Self, result: !usize) Poll<!usize> {
        self.slot_idx = thread_async_cleanup_slot(self.pool, self.slot_idx);
        self.state = Poll<!usize>.Ready(result);
        self.done = 1;
        return self.state;
    }

    fn finish_with_pending_wake(self: &Self, result: !usize, waker: &Waker) Poll<!usize> {
        const result_poll: Poll<!usize> = self.finish(result);
        if thread_pool_has_pending(self.pool) {
            waker.wake();
        }
        return result_poll;
    }

    fn finish_cancelled(self: &Self, waker: &Waker) Poll<!usize> {
        const cancelled_value: !usize = error.Cancelled;
        return self.finish_with_pending_wake(cancelled_value, waker);
    }

    fn finish_from_raw_poll(self: &Self, raw_poll: Poll<!usize>, waker: &Waker) Poll<!usize> {
        match raw_poll {
            .Ready(raw_result) => {
                if self.cancel_requested != 0 {
                    return self.finish_cancelled(waker);
                }
                return self.finish_with_pending_wake(raw_result, waker);
            },
            .Pending(_) => {
                return Poll<!usize>.Pending({});
            },
        };
        abort();
        return Poll<!usize>.Pending({});
    }

    fn poll(self: &Self, waker: &Waker) Poll<!usize> {
        if self.done != 0 {
            return self.state;
        }
        if self.first_poll == 0 {
            self.first_poll = 1;
            waker.wake();
            return Poll<!usize>.Pending({});
        }
        if waker.is_cancelled() && self.cancel_requested == 0 {
            self.cancel_requested = 1;
            thread_pool_record_cancel(self.pool);
        }
        if self.cancel_requested != 0 {
            const cancel_future: Future<!usize> = async_worker_cancel(self.pool, self.slot_idx);
            const cancel_poll: Poll<!usize> = cancel_future.poll(waker);
            match cancel_poll {
                .Ready(_) => {
                    return self.finish_cancelled(waker);
                },
                .Pending(_) => {
                    return Poll<!usize>.Pending({});
                },
            };
        }
        if self.slot_idx < 0 {
            const submit_future: Future<!usize> = async_worker_submit(self.pool, self.compute_fn, self.task_kind, self.arg_bits);
            const submit_poll: Poll<!usize> = submit_future.poll(waker);
            match submit_poll {
                .Ready(submit_result) => {
                    const submitted_slot_bits: usize = submit_result catch {
                        return self.finish_from_raw_poll(submit_poll, waker);
                    };
                    self.slot_idx = submitted_slot_bits as i32;
                },
                .Pending(_) => {
                    return Poll<!usize>.Pending({});
                },
            };
        }

        const raw_future: Future<!usize> = async_worker_result(self.pool, self.slot_idx);
        const raw_poll: Poll<!usize> = raw_future.poll(waker);
        match raw_poll {
            .Ready(raw_result) => {
                const raw_value: usize = raw_result catch {
                    return self.finish_from_raw_poll(raw_poll, waker);
                };
                const resolved_value: !usize = thread_async_compute_resolve_raw_value(self.pool, self.slot_idx, raw_value);
                const value_poll: Poll<!usize> = Poll<!usize>.Ready(resolved_value);
                return self.finish_from_raw_poll(value_poll, waker);
            },
            .Pending(_) => {
                return Poll<!usize>.Pending({});
            },
        };
        abort();
        return Poll<!usize>.Pending({});
    }

    fn release(self: &Self) void {
        async_box_free_current(self as &byte);
    }
}

fn async_worker_compute(pool: &ThreadPool, compute_fn: &void, task_kind: i32, arg_bits: usize) Future<!usize> {
    return AsyncWorkerComputeFuture{
        pool: pool,
        compute_fn: compute_fn,
        task_kind: task_kind,
        arg_bits: arg_bits,
        slot_idx: 0 - 1,
        first_poll: 0,
        done: 0,
        cancel_requested: 0,
        state: Poll<!usize>.Pending({}),
    };
}

@async_fn fn thread_async_compute_i32(pool: &ThreadPool, compute_fn: &void, arg: i32) Future<!i32> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_I32, arg as usize);
    return (try @await compute_future) as i32;
}

@async_fn fn thread_async_compute_usize(pool: &ThreadPool, compute_fn: &void, arg: usize) Future<!usize> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_USIZE, arg);
    return try @await compute_future;
}

@async_fn fn thread_async_compute_u32(pool: &ThreadPool, compute_fn: &void, arg: u32) Future<!u32> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_U32, arg as usize);
    const value: u32 = (try @await compute_future) as u32;
    return value;
}

@async_fn fn thread_async_compute_i64(pool: &ThreadPool, compute_fn: &void, arg: i64) Future<!i64> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_I64, arg as usize);
    const value: i64 = (try @await compute_future) as i64;
    return value;
}

@async_fn fn thread_async_compute_u64(pool: &ThreadPool, compute_fn: &void, arg: u64) Future<!u64> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_U64, arg as usize);
    const value: u64 = (try @await compute_future) as u64;
    return value;
}

@async_fn fn thread_async_compute_i16(pool: &ThreadPool, compute_fn: &void, arg: i16) Future<!i16> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_I16, arg as usize);
    const value: i16 = (try @await compute_future) as i16;
    return value;
}

@async_fn fn thread_async_compute_u16(pool: &ThreadPool, compute_fn: &void, arg: u16) Future<!u16> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_U16, arg as usize);
    const value: u16 = (try @await compute_future) as u16;
    return value;
}

@async_fn fn thread_async_compute_i8(pool: &ThreadPool, compute_fn: &void, arg: i8) Future<!i8> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_I8, arg as usize);
    const value: i8 = (try @await compute_future) as i8;
    return value;
}

@async_fn fn thread_async_compute_u8(pool: &ThreadPool, compute_fn: &void, arg: u8) Future<!u8> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_U8, arg as usize);
    const value: u8 = (try @await compute_future) as u8;
    return value;
}

@async_fn fn thread_async_compute_bool(pool: &ThreadPool, compute_fn: &void, arg: bool) Future<!bool> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_BOOL, thread_bool_to_usize(arg));
    return (try @await compute_future) != 0 as usize;
}

@async_fn fn thread_async_compute_f32(pool: &ThreadPool, compute_fn: &void, arg: f32) Future<!f32> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_F32, thread_f32_arg_bits(arg));
    const bits_u32: u32 = (try @await compute_future) as u32;
    const f32_val: f32 = *((&bits_u32 as *const u32) as *const f32);
    return f32_val;
}

@async_fn fn thread_async_compute_f64(pool: &ThreadPool, compute_fn: &void, arg: f64) Future<!f64> {
    const compute_future: Future<!usize> = async_worker_compute(pool, compute_fn, THREAD_TASK_KIND_F64, thread_f64_arg_bits(arg));
    const bits_u64: u64 = (try @await compute_future) as u64;
    const f64_val: f64 = *((&bits_u64 as *const u64) as *const f64);
    return f64_val;
}

fn thread_pool_default_scaled_capacity(worker_count: i32, per_worker: i32) i32 {
    var normalized_workers: i32 = thread_pool_normalize_config_capacity(worker_count);
    var normalized_per_worker: i32 = per_worker;
    if normalized_per_worker <= 0 {
        normalized_per_worker = 1;
    }
    if normalized_workers > THREAD_POOL_MAX_CONFIG_CAPACITY / normalized_per_worker {
        return THREAD_POOL_MAX_CONFIG_CAPACITY;
    }
    return thread_pool_normalize_config_capacity(normalized_workers * normalized_per_worker);
}

fn thread_pool_normalize_submit_strategy(value: i32) i32 {
    if value == THREAD_POOL_SUBMIT_STRATEGY_QUEUE_OR_ERROR {
        return value;
    }
    return THREAD_POOL_SUBMIT_STRATEGY_QUEUE_OR_ERROR;
}

// 线程池最小构造：使用懒启动 worker 池，默认 pending/task slot 随 worker 数扩展。
export fn thread_pool_new(worker_count: i32) ThreadPool {
    const pending_capacity: i32 = thread_pool_default_scaled_capacity(worker_count, THREAD_POOL_DEFAULT_PENDING_PER_WORKER);
    const task_slot_capacity: i32 = thread_pool_default_scaled_capacity(worker_count, THREAD_POOL_DEFAULT_SLOT_PER_WORKER);
    return thread_pool_new_with_config(ThreadPoolConfig{
        worker_count: worker_count,
        pending_capacity: pending_capacity,
        task_slot_capacity: task_slot_capacity,
        submit_strategy: THREAD_POOL_SUBMIT_STRATEGY_QUEUE_OR_ERROR,
    });
}

fn thread_pool_normalize_capacity(value: i32, max_value: i32) i32 {
    var normalized: i32 = value;
    if normalized <= 0 {
        normalized = 1;
    }
    if normalized > max_value {
        normalized = max_value;
    }
    return normalized;
}

fn thread_pool_normalize_config_capacity(value: i32) i32 {
    return thread_pool_normalize_capacity(value, THREAD_POOL_MAX_CONFIG_CAPACITY);
}

/// 使用显式容量配置构造 `ThreadPool`。
/// 参数：`config` 提供 worker、pending 队列、task slot 容量和显式提交策略；无效或极端过大的值会归一化到资源保护上限。
/// 返回值：返回懒启动线程池，实际容量保存在公开字段中，后续调度按这些容量边界执行。
export fn thread_pool_new_with_config(config: ThreadPoolConfig) ThreadPool {
    const normalized: i32 = thread_pool_normalize_config_capacity(config.worker_count);
    const normalized_pending: i32 = thread_pool_normalize_config_capacity(config.pending_capacity);
    const normalized_slots: i32 = thread_pool_normalize_config_capacity(config.task_slot_capacity);
    const normalized_submit_strategy: i32 = thread_pool_normalize_submit_strategy(config.submit_strategy);
    return ThreadPool{
        worker_count: normalized,
        pending_capacity: normalized_pending,
        task_slot_capacity: normalized_slots,
        submit_strategy: normalized_submit_strategy,
        _started_workers: 0,
        _next_worker: 0,
        _shared_state: null as &ThreadPoolSharedState,
        _workers: null as &ThreadWorker,
        _workers_bytes: 0 as usize,
        _metrics_peak_queue_depth: 0,
        _metrics_saturation_count: 0u64,
        _metrics_cancel_count: 0u64,
        _metrics_drain_count: 0u64,
        _metrics_last_drain_time_us: 0u64,
        _metrics_max_drain_time_us: 0u64,
        _metrics_total_drain_time_us: 0u64,
    };
}

/// 读取线程池当前生效的提交策略。
/// 参数：`pool` 为待读取的线程池；空指针按默认策略处理。
/// 返回值：返回归一化后的提交策略，当前默认值为 `THREAD_POOL_SUBMIT_STRATEGY_QUEUE_OR_ERROR`。
export fn thread_pool_submission_strategy(pool: &ThreadPool) i32 {
    if pool == null as &ThreadPool {
        return THREAD_POOL_SUBMIT_STRATEGY_QUEUE_OR_ERROR;
    }
    return thread_pool_normalize_submit_strategy(pool.submit_strategy);
}

export fn thread_pool_started_workers(pool: &ThreadPool) i32 {
    return pool._started_workers;
}

export fn thread_pool_pending_count(pool: &ThreadPool) i32 {
    return thread_pool_pending_len(pool);
}

/// 获取线程池当前指标快照。
/// 参数：`pool` 为线程池实例；空指针返回全零快照。
/// 返回值：包含容量、队列深度、当前运行 worker 数、饱和累计次数、取消次数和排空耗时等当前已知指标。
export fn thread_pool_metrics(pool: &ThreadPool) ThreadPoolMetrics {
    if pool == null as &ThreadPool {
        return ThreadPoolMetrics{};
    }
    thread_pool_cache_shared_metrics(pool);
    return ThreadPoolMetrics{
        worker_capacity: pool.worker_count,
        queue_capacity: pool.pending_capacity,
        task_slot_capacity: pool.task_slot_capacity,
        started_workers: pool._started_workers,
        running_workers: thread_pool_running_worker_count(pool),
        queue_depth: thread_pool_pending_len(pool),
        peak_queue_depth: pool._metrics_peak_queue_depth,
        saturation_count: pool._metrics_saturation_count,
        cancel_count: pool._metrics_cancel_count,
        drain_count: pool._metrics_drain_count,
        last_drain_time_us: pool._metrics_last_drain_time_us,
        max_drain_time_us: pool._metrics_max_drain_time_us,
        total_drain_time_us: pool._metrics_total_drain_time_us,
    };
}

export fn thread_pool_shutdown(pool: &ThreadPool) void {
    var i: i32 = 0;
    while i < pool._started_workers {
        if i >= 0 && i < pool.worker_count {
            if pool._workers[i as usize].active != 0 {
                var cmd: ThreadWorkerCommand = ThreadWorkerCommand{ slot_idx: THREAD_WORKER_STOP_SLOT, reserved: 0 };
                _ = sys_write(pool._workers[i as usize].cmd_write_fd, (&cmd) as *const byte, @size_of(ThreadWorkerCommand)) catch {};
                _ = pthread_join(&pool._workers[i as usize].thread, null as & &void);
                if pool._workers[i as usize].cmd_write_fd > 0 {
                    _ = sys_close(pool._workers[i as usize].cmd_write_fd);
                }
                if pool._workers[i as usize].result_read_fd > 0 {
                    _ = sys_close(pool._workers[i as usize].result_read_fd);
                }
                pool._workers[i as usize] = ThreadWorker{
                    thread: pthread_t{},
                    cmd_write_fd: 0 - 1,
                    result_read_fd: 0 - 1,
                    busy: 0,
                    active: 0,
                    active_slot: 0 - 1,
                };
            }
        }
        i = i + 1;
    }

    if thread_pool_has_shared_state(pool) {
        thread_pool_cache_shared_metrics(pool);
        const mapped_bytes: usize = pool._shared_state.mapped_bytes;
        _ = sys_munmap(pool._shared_state as *void, mapped_bytes) catch {};
        pool._shared_state = null as &ThreadPoolSharedState;
    }

    if pool._workers != null as &ThreadWorker {
        free(pool._workers as &void);
        pool._workers = null as &ThreadWorker;
        pool._workers_bytes = 0 as usize;
    }

    pool._started_workers = 0;
    pool._next_worker = 0;
}

fn thread_f32_arg_bits(arg: f32) usize {
    const bits: u32 = *(&arg as *const u32);
    return bits as usize;
}

fn thread_f64_arg_bits(arg: f64) usize {
    const bits: u64 = *(&arg as *const u64);
    return bits as usize;
}

// 执行 T -> T 计算，并返回 Future<!T>（装箱后的接口对象）。
// 说明：复用 ThreadPool 的 worker 线程；池满载时进入共享槽位 FIFO，容量不足时返回资源错误。
// 通用 async_compute<T> 顶层入口：对外只暴露 @async_fn 组合层，内部 substrate 由 raw compute awaitable 驱动。
export @async_fn fn async_compute<T>(pool: &ThreadPool, compute_fn: &void, arg: T) Future<!T> {
    if thread_type_is_i32(T) {
        const compute_future: Future<!i32> = thread_async_compute_i32(pool, compute_fn, arg as i32);
        return (try @await compute_future) as T;
    }
    if thread_type_is_usize(T) {
        const compute_future: Future<!usize> = thread_async_compute_usize(pool, compute_fn, arg as usize);
        return (try @await compute_future) as T;
    }
    if thread_type_is_u32(T) {
        const compute_future: Future<!u32> = thread_async_compute_u32(pool, compute_fn, arg as u32);
        return (try @await compute_future) as T;
    }
    if thread_type_is_i64(T) {
        const compute_future: Future<!i64> = thread_async_compute_i64(pool, compute_fn, arg as i64);
        return (try @await compute_future) as T;
    }
    if thread_type_is_u64(T) {
        const compute_future: Future<!u64> = thread_async_compute_u64(pool, compute_fn, arg as u64);
        return (try @await compute_future) as T;
    }
    if thread_type_is_i16(T) {
        const compute_future: Future<!i16> = thread_async_compute_i16(pool, compute_fn, arg as i16);
        return (try @await compute_future) as T;
    }
    if thread_type_is_u16(T) {
        const compute_future: Future<!u16> = thread_async_compute_u16(pool, compute_fn, arg as u16);
        return (try @await compute_future) as T;
    }
    if thread_type_is_i8(T) {
        const compute_future: Future<!i8> = thread_async_compute_i8(pool, compute_fn, arg as i8);
        return (try @await compute_future) as T;
    }
    if thread_type_is_u8(T) {
        const compute_future: Future<!u8> = thread_async_compute_u8(pool, compute_fn, arg as u8);
        return (try @await compute_future) as T;
    }
    if thread_type_is_bool(T) {
        const compute_future: Future<!bool> = thread_async_compute_bool(pool, compute_fn, arg as bool);
        return (try @await compute_future) as T;
    }
    if thread_type_is_f32(T) {
        const compute_future: Future<!f32> = thread_async_compute_f32(pool, compute_fn, arg as f32);
        return (try @await compute_future) as T;
    }
    if thread_type_is_f64(T) {
        const compute_future: Future<!f64> = thread_async_compute_f64(pool, compute_fn, arg as f64);
        return (try @await compute_future) as T;
    }
    const close_result: !i32 = sys_close(0 - 1);
    const _unreachable: i32 = close_result catch |err| {
        return err;
    };
    return _unreachable as T;
}
