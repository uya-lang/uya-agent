// lib/std/net/addr.uya - IP 与 socket 地址基础类型
// 模块路径：use std.net.addr

export error NetAddrInvalidIpv4;
export error NetAddrInvalidIpv6;
export error NetAddrBufferTooSmall;
export error NetAddrUnsupportedIpv6;

export enum IpFamily {
    IPv4,
    IPv6,
}

export struct IpAddr {
    family: IpFamily,
    bytes: [byte: 16],
    len: usize,
}

export struct SocketAddr {
    ip: IpAddr,
    port: u16,
}

fn net_addr_is_digit(c: byte) bool {
    return c >= (48 as byte) && c <= (57 as byte);
}

fn net_addr_parse_ipv4_octet(input: &[byte], pos: &usize, out: &byte) !void {
    if pos[0] >= input.len || !net_addr_is_digit(input.ptr[pos[0]]) {
        return error.NetAddrInvalidIpv4;
    }
    var value: usize = 0;
    var digits: usize = 0;
    while pos[0] < input.len && net_addr_is_digit(input.ptr[pos[0]]) {
        value = value * 10 + (input.ptr[pos[0]] as usize - 48usize);
        if value > 255usize {
            return error.NetAddrInvalidIpv4;
        }
        pos[0] = pos[0] + 1;
        digits = digits + 1;
        if digits > 3usize {
            return error.NetAddrInvalidIpv4;
        }
    }
    out[0] = (value as! byte).value;
}

fn net_addr_write_decimal(out: &byte, pos: usize, value: byte) usize {
    var digits: [byte: 3] = [0: 3];
    var len: usize = 0;
    var remaining: usize = value as usize;
    if remaining == 0usize {
        out[pos] = 48 as byte;
        return pos + 1usize;
    }
    while remaining > 0usize {
        digits[len] = (((remaining % 10usize) + 48usize) as! byte).value;
        remaining = remaining / 10usize;
        len = len + 1usize;
    }
    var i: usize = 0;
    while i < len {
        out[pos + i] = digits[len - i - 1usize];
        i = i + 1usize;
    }
    return pos + len;
}

fn net_addr_copy_bytes(dst: &byte, src: &const byte, len: usize) void {
    var i: usize = 0;
    while i < len {
        dst[i] = src[i];
        i = i + 1;
    }
}

/// 返回零值 IP 地址。
/// 参数说明：无。
/// 返回值说明：返回长度为 0 的零初始化地址对象。
export fn ip_addr_zero() IpAddr {
    return IpAddr{
        family: IpFamily.IPv4,
        bytes: [0: 16],
        len: 0,
    };
}

/// 构造 IPv4 地址。
/// 参数说明：`a`/`b`/`c`/`d` 为 4 个 IPv4 octet。
/// 返回值说明：返回长度为 4 的 IPv4 地址对象。
export fn ip_addr_ipv4(a: byte, b: byte, c: byte, d: byte) IpAddr {
    var ip: IpAddr = ip_addr_zero();
    ip.family = IpFamily.IPv4;
    ip.len = 4;
    ip.bytes[0] = a;
    ip.bytes[1] = b;
    ip.bytes[2] = c;
    ip.bytes[3] = d;
    return ip;
}

/// 构造 IPv6 地址。
/// 参数说明：`bytes` 指向 16 字节 IPv6 地址内容，`len` 必须为 16。
/// 返回值说明：成功时返回长度为 16 的 IPv6 地址对象；长度非法时返回错误。
export fn ip_addr_ipv6(bytes: &const byte, len: usize) !IpAddr {
    if bytes == null || len != 16usize {
        return error.NetAddrInvalidIpv6;
    }
    var ip: IpAddr = ip_addr_zero();
    ip.family = IpFamily.IPv6;
    ip.len = 16;
    net_addr_copy_bytes(&ip.bytes[0], bytes, 16usize);
    return ip;
}

/// 判断地址是否为 IPv4。
/// 参数说明：`ip` 为待判断地址。
/// 返回值说明：当地址族为 IPv4 且长度为 4 时返回 true。
export fn ip_addr_is_ipv4(ip: &IpAddr) bool {
    return ip != null && ip.family == IpFamily.IPv4 && ip.len == 4usize;
}

/// 判断地址是否为 IPv6。
/// 参数说明：`ip` 为待判断地址。
/// 返回值说明：当地址族为 IPv6 且长度为 16 时返回 true。
export fn ip_addr_is_ipv6(ip: &IpAddr) bool {
    return ip != null && ip.family == IpFamily.IPv6 && ip.len == 16usize;
}

/// 解析 IPv4 字面量。
/// 参数说明：`input` 为不带端口的点分十进制 IPv4 文本切片。
/// 返回值说明：成功时返回 IPv4 地址对象；格式非法时返回错误。
export fn ip_addr_parse_ipv4(input: &[byte]) !IpAddr {
    if input.len < 7usize || input.len > 15usize {
        return error.NetAddrInvalidIpv4;
    }
    var octets: [byte: 4] = [0: 4];
    var pos: usize = 0;
    var index: usize = 0;
    while index < 4usize {
        try net_addr_parse_ipv4_octet(input, &pos, &octets[index]);
        if index < 3usize {
            if pos >= input.len || input.ptr[pos] != (46 as byte) {
                return error.NetAddrInvalidIpv4;
            }
            pos = pos + 1usize;
        }
        index = index + 1usize;
    }
    if pos != input.len {
        return error.NetAddrInvalidIpv4;
    }
    return ip_addr_ipv4(octets[0], octets[1], octets[2], octets[3]);
}

/// 解析 IPv6 字面量。
/// 参数说明：`input` 为 IPv6 文本切片。
/// 返回值说明：当前阶段未实现 IPv6 文本解析，始终返回显式不支持错误。
export fn ip_addr_parse_ipv6(input: &[byte]) !IpAddr {
    _ = input;
    return error.NetAddrUnsupportedIpv6;
}

/// 把 IP 地址格式化为文本。
/// 参数说明：`ip` 为待格式化地址；`out`/`out_max` 为输出缓冲区；`out_len` 返回文本长度。
/// 返回值说明：成功时返回写入长度；缓冲区不足或地址族暂未支持时返回错误。
export fn ip_addr_format(ip: &IpAddr, out: &byte, out_max: usize, out_len: &usize) !usize {
    if ip == null || out == null || out_len == null {
        return error.NetAddrBufferTooSmall;
    }
    if ip_addr_is_ipv4(ip) {
        if out_max < 15usize {
            return error.NetAddrBufferTooSmall;
        }
        var pos: usize = 0;
        pos = net_addr_write_decimal(out, pos, ip.bytes[0]);
        out[pos] = 46 as byte;
        pos = pos + 1usize;
        pos = net_addr_write_decimal(out, pos, ip.bytes[1]);
        out[pos] = 46 as byte;
        pos = pos + 1usize;
        pos = net_addr_write_decimal(out, pos, ip.bytes[2]);
        out[pos] = 46 as byte;
        pos = pos + 1usize;
        pos = net_addr_write_decimal(out, pos, ip.bytes[3]);
        out_len[0] = pos;
        return pos;
    }
    return error.NetAddrUnsupportedIpv6;
}

/// 构造 socket 地址。
/// 参数说明：`ip` 为 IP 地址，`port` 为 0-65535 端口号。
/// 返回值说明：返回包含地址与端口的 socket 地址对象。
export fn socket_addr_new(ip: IpAddr, port: u16) SocketAddr {
    return SocketAddr{
        ip: ip,
        port: port,
    };
}

/// 把 socket 地址格式化为文本。
/// 参数说明：`addr` 为待格式化 socket 地址；`out`/`out_max` 为输出缓冲区；`out_len` 返回文本长度。
/// 返回值说明：成功时返回写入长度；缓冲区不足或地址族暂未支持时返回错误。
export fn socket_addr_format(addr: &SocketAddr, out: &byte, out_max: usize, out_len: &usize) !usize {
    if addr == null || out == null || out_len == null {
        return error.NetAddrBufferTooSmall;
    }
    var pos: usize = 0;
    pos = try ip_addr_format(&addr.ip, out, out_max, out_len);
    if pos + 1usize >= out_max {
        return error.NetAddrBufferTooSmall;
    }
    out[pos] = 58 as byte;
    pos = pos + 1usize;
    if addr.port == 0u16 {
        if pos >= out_max {
            return error.NetAddrBufferTooSmall;
        }
        out[pos] = 48 as byte;
        pos = pos + 1usize;
        out_len[0] = pos;
        return pos;
    }
    var digits: [byte: 5] = [0: 5];
    var digit_len: usize = 0;
    var remaining: usize = addr.port as usize;
    while remaining > 0usize {
        digits[digit_len] = (((remaining % 10usize) + 48usize) as! byte).value;
        remaining = remaining / 10usize;
        digit_len = digit_len + 1usize;
    }
    if pos + digit_len > out_max {
        return error.NetAddrBufferTooSmall;
    }
    var i: usize = 0;
    while i < digit_len {
        out[pos + i] = digits[digit_len - i - 1usize];
        i = i + 1usize;
    }
    pos = pos + digit_len;
    out_len[0] = pos;
    return pos;
}
