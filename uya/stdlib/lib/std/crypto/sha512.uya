// lib/std/crypto/sha512.uya — SHA-512 摘要与 HMAC-SHA512（FIPS 180-4 / RFC 2104）
//
// 模块路径：use std.crypto.sha512
//
// 为什么需要它：SHA-384 是 SHA-512 的截断（lib/tls/crypto/sha384.uya），两者压缩函数与
// 常量表相同，但那条路只给一次性接口且输出 48 字节。Ed25519（RFC 8032）要 64 字节、
// HMAC-SHA512（RFC 4231）要增量喂入，故在此补一份 64 位字实现。

fn sha512_rotr64(x: u64, n: i32) u64 {
    const r: i32 = 64 - n;
    return (x >> n) | (x << r);
}

fn sha512_ch(x: u64, y: u64, z: u64) u64 {
    return (x & y) ^ ((~x) & z);
}

fn sha512_maj(x: u64, y: u64, z: u64) u64 {
    return (x & y) ^ (x & z) ^ (y & z);
}

fn sha512_bsig0(x: u64) u64 {
    return sha512_rotr64(x, 28) ^ sha512_rotr64(x, 34) ^ sha512_rotr64(x, 39);
}

fn sha512_bsig1(x: u64) u64 {
    return sha512_rotr64(x, 14) ^ sha512_rotr64(x, 18) ^ sha512_rotr64(x, 41);
}

fn sha512_ssig0(x: u64) u64 {
    return sha512_rotr64(x, 1) ^ sha512_rotr64(x, 8) ^ (x >> 7);
}

fn sha512_ssig1(x: u64) u64 {
    return sha512_rotr64(x, 19) ^ sha512_rotr64(x, 61) ^ (x >> 6);
}

fn sha512_load_be64(block: &[byte], off: usize) u64 {
    return
        ((block.ptr[off] as u64) << 56) |
        ((block.ptr[off + 1] as u64) << 48) |
        ((block.ptr[off + 2] as u64) << 40) |
        ((block.ptr[off + 3] as u64) << 32) |
        ((block.ptr[off + 4] as u64) << 24) |
        ((block.ptr[off + 5] as u64) << 16) |
        ((block.ptr[off + 6] as u64) << 8) |
        (block.ptr[off + 7] as u64);
}

fn sha512_store_be64(digest: &[byte], off: usize, v: u64) void {
    digest.ptr[off] = ((v >> 56) & 0xff) as byte;
    digest.ptr[off + 1] = ((v >> 48) & 0xff) as byte;
    digest.ptr[off + 2] = ((v >> 40) & 0xff) as byte;
    digest.ptr[off + 3] = ((v >> 32) & 0xff) as byte;
    digest.ptr[off + 4] = ((v >> 24) & 0xff) as byte;
    digest.ptr[off + 5] = ((v >> 16) & 0xff) as byte;
    digest.ptr[off + 6] = ((v >> 8) & 0xff) as byte;
    digest.ptr[off + 7] = (v & 0xff) as byte;
}

/// SHA-512 轮常量（FIPS 180-4 §4.2.3）：80 个 64 位字。
const SHA512_K: [u64: 80] = [
    0x428a2f98d728ae22u64, 0x7137449123ef65cdu64, 0xb5c0fbcfec4d3b2fu64, 0xe9b5dba58189dbbcu64,
    0x3956c25bf348b538u64, 0x59f111f1b605d019u64, 0x923f82a4af194f9bu64, 0xab1c5ed5da6d8118u64,
    0xd807aa98a3030242u64, 0x12835b0145706fbeu64, 0x243185be4ee4b28cu64, 0x550c7dc3d5ffb4e2u64,
    0x72be5d74f27b896fu64, 0x80deb1fe3b1696b1u64, 0x9bdc06a725c71235u64, 0xc19bf174cf692694u64,
    0xe49b69c19ef14ad2u64, 0xefbe4786384f25e3u64, 0x0fc19dc68b8cd5b5u64, 0x240ca1cc77ac9c65u64,
    0x2de92c6f592b0275u64, 0x4a7484aa6ea6e483u64, 0x5cb0a9dcbd41fbd4u64, 0x76f988da831153b5u64,
    0x983e5152ee66dfabu64, 0xa831c66d2db43210u64, 0xb00327c898fb213fu64, 0xbf597fc7beef0ee4u64,
    0xc6e00bf33da88fc2u64, 0xd5a79147930aa725u64, 0x06ca6351e003826fu64, 0x142929670a0e6e70u64,
    0x27b70a8546d22ffcu64, 0x2e1b21385c26c926u64, 0x4d2c6dfc5ac42aedu64, 0x53380d139d95b3dfu64,
    0x650a73548baf63deu64, 0x766a0abb3c77b2a8u64, 0x81c2c92e47edaee6u64, 0x92722c851482353bu64,
    0xa2bfe8a14cf10364u64, 0xa81a664bbc423001u64, 0xc24b8b70d0f89791u64, 0xc76c51a30654be30u64,
    0xd192e819d6ef5218u64, 0xd69906245565a910u64, 0xf40e35855771202au64, 0x106aa07032bbd1b8u64,
    0x19a4c116b8d2d0c8u64, 0x1e376c085141ab53u64, 0x2748774cdf8eeb99u64, 0x34b0bcb5e19b48a8u64,
    0x391c0cb3c5c95a63u64, 0x4ed8aa4ae3418acbu64, 0x5b9cca4f7763e373u64, 0x682e6ff3d6b2b8a3u64,
    0x748f82ee5defb2fcu64, 0x78a5636f43172f60u64, 0x84c87814a1f0ab72u64, 0x8cc702081a6439ecu64,
    0x90befffa23631e28u64, 0xa4506cebde82bde9u64, 0xbef9a3f7b2c67915u64, 0xc67178f2e372532bu64,
    0xca273eceea26619cu64, 0xd186b8c721c0c207u64, 0xeada7dd6cde0eb1eu64, 0xf57d4f7fee6ed178u64,
    0x06f067aa72176fbau64, 0x0a637dc5a2c898a6u64, 0x113f9804bef90daeu64, 0x1b710b35131c471bu64,
    0x28db77f523047d84u64, 0x32caab7b40c72493u64, 0x3c9ebe0a15c9bebcu64, 0x431d67c49c100d4cu64,
    0x4cc5d4becb3e42b6u64, 0x597f299cfc657e2au64, 0x5fcb6fab3ad6faecu64, 0x6c44198c4a475817u64,
];

/// `block.len` 须为 128；`st.len` 须为 8。就地更新状态字。
fn sha512_compress(st: &[u64], block: &[byte]) void {
    if st.len != 8 || block.len != 128 {
        return;
    }
    var w: [u64: 80] = [];
    var t: usize = 0;
    while t < 16 {
        w[t] = sha512_load_be64(block, t * 8);
        t = t + 1;
    }
    while t < 80 {
        // 显式写出下界：直接写 `w[t - 16]` 会被边界证明判为"安全证明失败"
        if t >= 16 && t < 80 {
            const s0: u64 = sha512_ssig0(w[t - 15]);
            const s1: u64 = sha512_ssig1(w[t - 2]);
            w[t] = w[t - 16] + s0 + w[t - 7] + s1;
        }
        t = t + 1;
    }
    var a: u64 = st.ptr[0];
    var b: u64 = st.ptr[1];
    var c: u64 = st.ptr[2];
    var d: u64 = st.ptr[3];
    var e: u64 = st.ptr[4];
    var f: u64 = st.ptr[5];
    var g: u64 = st.ptr[6];
    var h: u64 = st.ptr[7];
    t = 0;
    while t < 80 {
        const t1: u64 = h + sha512_bsig1(e) + sha512_ch(e, f, g) + SHA512_K[t] + w[t];
        const t2: u64 = sha512_bsig0(a) + sha512_maj(a, b, c);
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        t = t + 1;
    }
    st.ptr[0] = st.ptr[0] + a;
    st.ptr[1] = st.ptr[1] + b;
    st.ptr[2] = st.ptr[2] + c;
    st.ptr[3] = st.ptr[3] + d;
    st.ptr[4] = st.ptr[4] + e;
    st.ptr[5] = st.ptr[5] + f;
    st.ptr[6] = st.ptr[6] + g;
    st.ptr[7] = st.ptr[7] + h;
}

/// 计算 SHA-512；`digest.len` 须 ≥ 64，仅写入前 64 字节。
export fn sha512_digest(data: &[byte], digest: &[byte]) void {
    if digest.len < 64 {
        return;
    }
    var ctx: Sha512Ctx = Sha512Ctx{};
    ctx.init();
    ctx.update(data);
    ctx.final(digest);
}

/// 增量（流式）SHA-512 上下文。
export struct Sha512Ctx {
    state: [u64: 8],
    buf: [byte: 128],
    buf_len: usize,
    total_len: u64,

    /// 初始化上下文。
    /// 参数：无。
    /// 返回值：无。
    fn init(self: &Self) void {
        self.state[0] = 0x6a09e667f3bcc908u64;
        self.state[1] = 0xbb67ae8584caa73bu64;
        self.state[2] = 0x3c6ef372fe94f82bu64;
        self.state[3] = 0xa54ff53a5f1d36f1u64;
        self.state[4] = 0x510e527fade682d1u64;
        self.state[5] = 0x9b05688c2b3e6c1fu64;
        self.state[6] = 0x1f83d9abfb41bd6bu64;
        self.state[7] = 0x5be0cd19137e2179u64;
        var i: usize = 0;
        while i < 128 {
            self.buf[i] = 0 as byte;
            i = i + 1;
        }
        self.buf_len = 0;
        self.total_len = 0u64;
    }

    /// 追加数据（可多次调用）。
    /// 参数：data 为待追加字节。
    /// 返回值：无。
    fn update(self: &Self, data: &[const byte]) void {
        if data.len == 0 {
            return;
        }
        self.total_len = self.total_len + (data.len as u64);
        var off: usize = 0;
        if self.buf_len > 0 {
            const need: usize = 128 - self.buf_len;
            var copy: usize = need;
            if copy > data.len {
                copy = data.len;
            }
            var ci: usize = 0;
            while ci < copy {
                self.buf[self.buf_len + ci] = data.ptr[ci];
                ci = ci + 1;
            }
            self.buf_len = self.buf_len + copy;
            off = off + copy;
            if self.buf_len == 128 {
                sha512_compress(self.state[0: 8], self.buf[0: 128]);
                self.buf_len = 0;
            }
            if off >= data.len {
                return;
            }
        }
        while off + 128 <= data.len {
            sha512_compress(self.state[0: 8], data[off: 128]);
            off = off + 128;
        }
        if off < data.len {
            var ri: usize = 0;
            while ri < (data.len - off) {
                self.buf[ri] = data.ptr[off + ri];
                ri = ri + 1;
            }
            self.buf_len = data.len - off;
        }
    }

    /// 收尾并输出 64 字节摘要。`digest.len` 须 ≥ 64。
    /// 参数：digest 为输出缓冲。
    /// 返回值：无。
    fn final(self: &Self, digest: &[byte]) void {
        if digest.len < 64 {
            return;
        }
        // 补 0x80 + 补零到 112 (mod 128) + 16 字节大端位长（128 位，高位恒 0）
        var tail: [byte: 256] = [];
        var ti: usize = 0;
        while ti < self.buf_len {
            tail[ti] = self.buf[ti];
            ti = ti + 1;
        }
        tail[ti] = 0x80 as byte;
        ti = ti + 1;
        const bitlen: u64 = self.total_len * 8u64;
        // SHA-512 的长度域是 **128 位**大端（FIPS 180-4 §5.1.2）：高 64 位恒为 0，
        // 低 64 位必须落在块内**最后 8 字节**（total-8）。写到 total-16 会让
        // 字节 120..127 全为 0、长度信息丢失——空串因为 bitlen=0 恰好看不出来。
        const lenfield: usize = 16;
        const bl128: usize = 128;
        const pad: usize = (bl128 - ((ti + lenfield) % bl128)) % bl128;
        const total: usize = ti + pad + lenfield;
        var ei: i32 = 0;
        while ei < 8 {
            const sh: i32 = (7 - ei) * 8;
            tail[total - 8 + ei as usize] = ((bitlen >> sh) & 0xffu64) as byte;
            ei = ei + 1;
        }
        var tb: usize = 0;
        while tb < total {
            sha512_compress(self.state[0: 8], tail[tb: 128]);
            tb = tb + 128;
        }
        var di: usize = 0;
        while di < 8 {
            sha512_store_be64(digest, di * 8, self.state[di]);
            di = di + 1;
        }
    }
}

/// HMAC-SHA512（RFC 2104）；`mac_out.len` 须 ≥ 64，仅写入前 64 字节。
/// 参数：key 为密钥（任意长度），msg 为消息，mac_out 为输出缓冲。
/// 返回值：无。
export fn hmac_sha512(key: &[byte], msg: &[byte], mac_out: &[byte]) void {
    if mac_out.len < 64 {
        return;
    }
    var kbuf: [byte: 128] = [];
    if key.len > 128 {
        var kh: [byte: 64] = [];
        sha512_digest(key, kh[0: 64]);
        var ki: usize = 0;
        while ki < 64 {
            kbuf[ki] = kh[ki];
            ki = ki + 1;
        }
    } else {
        var kj: usize = 0;
        while kj < key.len {
            kbuf[kj] = key.ptr[kj];
            kj = kj + 1;
        }
    }
    // 内层：SHA512((K^ipad) || msg)，用流式上下文避免拼接大缓冲
    var ipad: [byte: 128] = [];
    var ii: usize = 0;
    while ii < 128 {
        ipad[ii] = kbuf[ii] ^ (0x36 as byte);
        ii = ii + 1;
    }
    var ih: [byte: 64] = [];
    var ctx: Sha512Ctx = Sha512Ctx{};
    ctx.init();
    ctx.update(ipad[0: 128]);
    ctx.update(msg);
    ctx.final(ih[0: 64]);
    // 外层：SHA512((K^opad) || inner)
    var opad: [byte: 128] = [];
    var oi: usize = 0;
    while oi < 128 {
        opad[oi] = kbuf[oi] ^ (0x5c as byte);
        oi = oi + 1;
    }
    var octx: Sha512Ctx = Sha512Ctx{};
    octx.init();
    octx.update(opad[0: 128]);
    octx.update(ih[0: 64]);
    octx.final(mac_out[0: 64]);
}

/// HMAC-SHA512 的增量版本上下文。
export struct HmacSha512Ctx {
    inner: Sha512Ctx,
    opad: [byte: 128],

    /// 用密钥初始化（keylen 任意；超长先哈希）。
    /// 参数：key 为密钥。
    /// 返回值：无。
    fn init(self: &Self, key: &[byte]) void {
        var kbuf: [byte: 128] = [];
        if key.len > 128 {
            var kh: [byte: 64] = [];
            sha512_digest(key, kh[0: 64]);
            var ki: usize = 0;
            while ki < 64 {
                kbuf[ki] = kh[ki];
                ki = ki + 1;
            }
        } else {
            var kj: usize = 0;
            while kj < key.len {
                kbuf[kj] = key.ptr[kj];
                kj = kj + 1;
            }
        }
        var ipad: [byte: 128] = [];
        var i: usize = 0;
        while i < 128 {
            ipad[i] = kbuf[i] ^ (0x36 as byte);
            self.opad[i] = kbuf[i] ^ (0x5c as byte);
            i = i + 1;
        }
        self.inner.init();
        self.inner.update(ipad[0: 128]);
    }

    /// 追加消息字节。
    /// 参数：data 为消息分片。
    /// 返回值：无。
    fn update(self: &Self, data: &[const byte]) void {
        self.inner.update(data);
    }

    /// 输出 64 字节 MAC。
    /// 参数：mac_out 为输出缓冲（须 ≥ 64 字节）。
    /// 返回值：无。
    fn final(self: &Self, mac_out: &[byte]) void {
        if mac_out.len < 64 {
            return;
        }
        var ih: [byte: 64] = [];
        self.inner.final(ih[0: 64]);
        var octx: Sha512Ctx = Sha512Ctx{};
        octx.init();
        octx.update(self.opad[0: 128]);
        octx.update(ih[0: 64]);
        octx.final(mac_out[0: 64]);
    }
}
