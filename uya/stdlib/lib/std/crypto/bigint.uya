// lib/std/crypto/bigint.uya — 定长大数与模幂（SOS Montgomery）
//
// 模块路径：use std.crypto.bigint
//
// 为什么需要它：lib/tls/base/mpi.uya 的 MPI_MAX_LIMBS = 32（2048 位），且 mpi_mul 在
// a.n + b.n > 32 时直接返回 TlsBadInput，因此 2048 位平方（需 64 limb）根本跑不动；
// RSA-4096 更无可能。本模块给一份**定长**大数，用 Montgomery 乘法（SOS 变体，
// 参考 Koç《Analyzing and Comparing Montgomery Multiplication Algorithms》）把
// RSA-2048 的一次模幂压到毫秒级。
//
// 表示与约定：
//   * limb 为 u64，limbs[0] 是最低有效 limb（小端）；数值按大端字节序进出。
//   * 全部接口**定长**：长度由 BIGINT_LIMBS 决定，不做动态分配。
//   * mont_mul 只接受 n 为奇数（Montgomery 前提）；n0inv = -n^{-1} mod 2^64。
//   * 结果都做一次条件减，保证落在 [0, n)。

/// limb 数量：64 × 64 = 4096 位，覆盖 RSA-4096 的模数与中间积。
export const BIGINT_LIMBS: usize = 64;

/// 每个 limb 的字节数。
export const BIGINT_LIMB_BYTES: usize = 8;

/// 定长大数：limbs[0] 为最低有效 limb。
export struct BigInt {
    limbs: [u64: BIGINT_LIMBS],
    len: usize,
}

/// u64 相乘取 128 位结果（拆 32 位半字，不依赖 u128）。
/// 参数：a/b 为乘数，lo/hi 为输出指针。
/// 返回值：无。
fn bigint_mul_wide(a: u64, b: u64, lo: &u64, hi: &u64) void {
    const m32: u64 = 0xFFFFFFFFu64;
    const al: u64 = a & m32;
    const ah: u64 = a >> 32;
    const bl: u64 = b & m32;
    const bh: u64 = b >> 32;
    const p0: u64 = al * bl;
    const p1: u64 = ah * bl + (p0 >> 32);
    const p2: u64 = al * bh + (p1 & m32);
    const p3: u64 = ah * bh + (p1 >> 32) + (p2 >> 32);
    lo[0] = (p0 & m32) | ((p2 & m32) << 32);
    hi[0] = p3;
}

/// 单字乘加：lo = (x*y + acc + cin) 低 64 位，hi = 其高 64 位（含全部进位）。
/// 参数：x/y 为乘数，acc 为累加字，cin 为进位输入；lo/hi 为输出。
/// 返回值：无。
fn bigint_mac(x: u64, y: u64, acc: u64, cin: u64, lo: &u64, hi: &u64) void {
    var l: u64 = 0;
    var h: u64 = 0;
    bigint_mul_wide(x, y, &l, &h);
    const s: u64 = l + acc;
    var c1: u64 = 0;
    if s < l {
        c1 = 1;
    }
    const s2: u64 = s + cin;
    var c2: u64 = 0;
    if s2 < s {
        c2 = 1;
    }
    lo[0] = s2;
    hi[0] = h + c1 + c2;
}

/// 无符号比较两个 n 字大数。
/// 参数：a/b 为待比较数，n 为 limb 数。
/// 返回值：a>b 返回 1，a<b 返回 -1，相等返回 0。
export fn bigint_cmp(a: &const u64, b: &const u64, n: usize) i32 {
    var res: i32 = 0;
    var i: usize = 0;
    while i < n {
        const ai: u64 = a[i];
        const bi: u64 = b[i];
        if ai > bi {
            res = 1;
        }
        if ai < bi {
            res = 0 - 1;
        }
        i = i + 1;
    }
    return res;
}

/// r = a - b（无符号，调用方须保证 a >= b）。
/// 参数：r 为输出，a/b 为操作数，n 为 limb 数。
/// 返回值：无。
export fn bigint_sub(r: &u64, a: &const u64, b: &const u64, n: usize) void {
    var borrow: u64 = 0;
    var i: usize = 0;
    while i < n {
        const ai: u64 = a[i];
        const bi: u64 = b[i];
        const d: u64 = ai - bi;
        var b1: u64 = 0;
        if ai < bi {
            b1 = 1;
        }
        const d2: u64 = d - borrow;
        var b2: u64 = 0;
        if d < borrow {
            b2 = 1;
        }
        r[i] = d2;
        borrow = b1 + b2;
        i = i + 1;
    }
}

/// r = a + b，返回最高位进位（0 或 1）。
/// 参数：r 为输出，a/b 为操作数，n 为 limb 数。
/// 返回值：进位。
export fn bigint_add(r: &u64, a: &const u64, b: &const u64, n: usize) u64 {
    var carry: u64 = 0;
    var i: usize = 0;
    while i < n {
        const ai: u64 = a[i];
        const bi: u64 = b[i];
        const s: u64 = ai + bi;
        var c: u64 = 0;
        if s < ai {
            c = 1;
        }
        const s2: u64 = s + carry;
        var c2: u64 = 0;
        if s2 < s {
            c2 = 1;
        }
        r[i] = s2;
        carry = c + c2;
        i = i + 1;
    }
    return carry;
}

/// 从大端字节串装载。bytes[0] 是最高有效字节；字节数不足 8n 时高位补 0。
/// 参数：l 为输出 limb 数组（n 个），bytes 为输入，nbytes 为字节数，n 为 limb 数。
/// 返回值：无。
export fn bigint_from_be(l: &u64, bytes: &const byte, nbytes: usize, n: usize) void {
    var i: usize = 0;
    while i < n {
        var v: u64 = 0;
        var j: usize = 0;
        while j < BIGINT_LIMB_BYTES {
            // limb i 内第 j 个「从低位起」的字节，对应整体下标 nbytes-1-(8i+j)
            const idx_from_end: usize = i * BIGINT_LIMB_BYTES + (BIGINT_LIMB_BYTES - 1 - j);
            if idx_from_end < nbytes {
                const idx: usize = nbytes - 1 - idx_from_end;
                v = (v << 8) | (bytes[idx] as u64);
            } else {
                v = v << 8;
            }
            j = j + 1;
        }
        l[i] = v;
        i = i + 1;
    }
}

/// 导出为固定 n*8 字节的大端字节串。
/// 参数：bytes 为输出缓冲，l 为输入 limb 数组，n 为 limb 数。
/// 返回值：无。
export fn bigint_to_be(bytes: &byte, l: &const u64, n: usize) void {
    var i: usize = 0;
    while i < n {
        const v: u64 = l[i];
        var j: usize = 0;
        while j < BIGINT_LIMB_BYTES {
            const idx: usize = (n - 1 - i) * BIGINT_LIMB_BYTES + j;
            const sh: i32 = (7 - (j as i32)) * 8;
            bytes[idx] = ((v >> sh) & 0xffu64) as byte;
            j = j + 1;
        }
        i = i + 1;
    }
}

/// 计算 n0inv = -n^{-1} mod 2^64（n 必须为奇数）。
/// 牛顿迭代 x ← x·(2 − n·x)：从 x=1（mod 2 正确）起，每轮正确位翻倍，
/// 6 轮覆盖 2 → 4 → 8 → 16 → 32 → 64 位。
/// 参数：n 为奇数模数（limb 视图，只用 n[0]）。
/// 返回值：n0inv。
export fn bigint_n0inv(n: &const u64) u64 {
    var inv: u64 = 1u64;
    var round: usize = 0;
    while round < 6 {
        var lo: u64 = 0;
        var hi: u64 = 0;
        bigint_mul_wide(n[0], inv, &lo, &hi);
        // 关键：迭代式是 x ← x·(2 − n·x)，常数 2 不能漏。写成 `0u64 - lo`（即 −n·x）
        // 会让每轮都算错，最终值与正确的 n0inv 毫无关系（Montgomery 乘法则全盘失效）。
        const two_minus: u64 = 2u64 - lo;
        var lo2: u64 = 0;
        var hi2: u64 = 0;
        bigint_mul_wide(inv, two_minus, &lo2, &hi2);
        inv = lo2;
        round = round + 1;
    }
    return 0u64 - inv;
}

/// Montgomery 乘法：r = a·b·R^{-1} mod n，R = 2^(64n)。
/// 两遍法（SOS）：先算完整 2k 字乘积，再逐字用 m = t[i]·n0inv 约简。
/// 参数：r 为输出，a/b 为操作数，n 为奇数模数，n0inv 为 bigint_n0inv 的结果。
/// 返回值：无。
export fn bigint_mont_mul(r: &u64, a: &const u64, b: &const u64, n: &const u64, n0inv: u64) void {
    const k: usize = BIGINT_LIMBS;
    var t: [u64: BIGINT_LIMBS * 2 + 2] = [0: BIGINT_LIMBS * 2 + 2];

    // 1) t = a · b（完整 2k 字）
    var i: usize = 0;
    while i < k {
        var c: u64 = 0;
        var j: usize = 0;
        while j < k {
            var lo: u64 = 0;
            var hi: u64 = 0;
            bigint_mac(a[j], b[i], t[i + j], c, &lo, &hi);
            t[i + j] = lo;
            c = hi;
            j = j + 1;
        }
        const acc: u64 = t[i + k] + c;
        var cy: u64 = 0;
        if acc < c {
            cy = 1;
        }
        t[i + k] = acc;
        var idx: usize = i + k + 1;
        while cy != 0 && idx < BIGINT_LIMBS * 2 + 2 {
            const nv: u64 = t[idx] + cy;
            var cy2: u64 = 0;
            if nv < cy {
                cy2 = 1;
            }
            t[idx] = nv;
            cy = cy2;
            idx = idx + 1;
        }
        i = i + 1;
    }

    // 2) 逐字约简 t ← (t + m·n) / 2^64
    i = 0;
    while i < k {
        const m: u64 = t[i] * n0inv;
        var c: u64 = 0;
        var j: usize = 0;
        while j < k {
            var lo: u64 = 0;
            var hi: u64 = 0;
            bigint_mac(m, n[j], t[i + j], c, &lo, &hi);
            t[i + j] = lo;
            c = hi;
            j = j + 1;
        }
        const acc2: u64 = t[i + k] + c;
        var cy3: u64 = 0;
        if acc2 < c {
            cy3 = 1;
        }
        t[i + k] = acc2;
        var idx2: usize = i + k + 1;
        while cy3 != 0 && idx2 < BIGINT_LIMBS * 2 + 2 {
            const nv2: u64 = t[idx2] + cy3;
            var cy4: u64 = 0;
            if nv2 < cy3 {
                cy4 = 1;
            }
            t[idx2] = nv2;
            cy3 = cy4;
            idx2 = idx2 + 1;
        }
        i = i + 1;
    }

    // 3) 取高 k 字并条件减
    //
    // **必须考虑溢出字 t[2k]**：Montgomery 归约的定理是「结果 V < 2n」，
    // 而 n < 2^(64k)，所以 V 可能要 k+1 个字才装得下。
    // 只取 t[k..2k) 会在 t[2k] != 0 时丢掉最高位——症状是**输出最高字节错**，
    // 而小模数（或小指数）时 t[2k] 恒为 0，所以先前的测试全都漏掉了这个缺陷。
    // 这个缺陷在 SSH 的 RSA-4096 签名上直接暴露：n 接近 2^4096，
    // 几乎每次归约都溢出，签名于是完全不可用。
    const overflow: u64 = t[k + k];
    i = 0;
    while i < k {
        r[i] = t[k + i];
        i = i + 1;
    }
    if overflow != 0 {
        // V >= 2^(64k) > n，必然要减一次；减法回绕正好给出 V - n
        bigint_sub(r, r, n, k);
    } else if bigint_cmp(r, n, k) >= 0 {
        bigint_sub(r, r, n, k);
    }
}

/// R² mod n（R = 2^(64n)）：从 1 起在普通域倍增 128n 次。
/// 参数：r2 为输出，n 为奇数模数。
/// 返回值：无。
export fn bigint_mont_r2(r2: &u64, n: &const u64) void {
    const k: usize = BIGINT_LIMBS;
    var acc: [u64: BIGINT_LIMBS] = [0: BIGINT_LIMBS];
    acc[0] = 1u64;
    const doublings: usize = k * 64 * 2;
    var step: usize = 0;
    while step < doublings {
        var carry: u64 = 0;
        var i: usize = 0;
        while i < k {
            const v: u64 = acc[i];
            const sh: u64 = (v << 1) | carry;
            carry = v >> 63;
            acc[i] = sh;
            i = i + 1;
        }
        if carry != 0 || bigint_cmp(&acc[0], n, k) >= 0 {
            bigint_sub(&acc[0], &acc[0], n, k);
        }
        step = step + 1;
    }
    var j: usize = 0;
    while j < k {
        r2[j] = acc[j];
        j = j + 1;
    }
}

/// 普通域 → Montgomery 域：out = a·R mod n。
/// 参数：out 为输出，a 为普通域值，r2 为 R² mod n，n 为模数，n0inv 为 n0inv。
/// 返回值：无。
export fn bigint_to_mont(out: &u64, a: &const u64, r2: &const u64, n: &const u64, n0inv: u64) void {
    bigint_mont_mul(out, a, r2, n, n0inv);
}

/// Montgomery 域 → 普通域：out = a·R^{-1} mod n。
/// 参数：out 为输出，a 为 Montgomery 域值，n 为模数，n0inv 为 n0inv。
/// 返回值：无。
export fn bigint_from_mont(out: &u64, a: &const u64, n: &const u64, n0inv: u64) void {
    var one: [u64: BIGINT_LIMBS] = [0: BIGINT_LIMBS];
    one[0] = 1u64;
    bigint_mont_mul(out, a, &one[0], n, n0inv);
}

/// 模幂：out = base^exp mod n（从左到右平方乘，全程留在 Montgomery 域）。
/// 参数：out 为输出（普通域），base 为底数（普通域，须 < n），exp 为大端指数字节，
///       exp_bytes 为指数字节数，n 为奇数模数，n0inv 为 n0inv（r2 由本函数内部算）。
/// 返回值：无。
export fn bigint_modexp_be(out: &u64, base: &const u64, exp: &const byte, exp_bytes: usize,
    n: &const u64, n0inv: u64) void {
    const k: usize = BIGINT_LIMBS;
    var r2: [u64: BIGINT_LIMBS] = [0: BIGINT_LIMBS];
    bigint_mont_r2(&r2[0], n);
    var base_m: [u64: BIGINT_LIMBS] = [0: BIGINT_LIMBS];
    bigint_to_mont(&base_m[0], base, &r2[0], n, n0inv);
    // acc ← 1 的 Montgomery 表示
    var one: [u64: BIGINT_LIMBS] = [0: BIGINT_LIMBS];
    one[0] = 1u64;
    var acc: [u64: BIGINT_LIMBS] = [0: BIGINT_LIMBS];
    bigint_to_mont(&acc[0], &one[0], &r2[0], n, n0inv);
    // 指数最高位到最低位：每轮先平方、该位为 1 再乘底数。
    // 首轮平方 1 仍得 1，因此无需特判「第一位」。
    var byte_idx: usize = 0;
    while byte_idx < exp_bytes {
        var bit: i32 = 7;
        while bit >= 0 {
            bigint_mont_mul(&acc[0], &acc[0], &acc[0], n, n0inv);
            const mask: u32 = (1u32) << ((bit as i32));
            const taken: u32 = (exp[byte_idx] as u32) & mask;
            if taken != 0 {
                bigint_mont_mul(&acc[0], &acc[0], &base_m[0], n, n0inv);
            }
            bit = bit - 1;
        }
        byte_idx = byte_idx + 1;
    }
    bigint_from_mont(out, &acc[0], n, n0inv);
}

/// 便捷封装：从大端字节把一枚定长数装进 BigInt。
/// 参数：bi 为输出结构，bytes 为大端输入，nbytes 为字节数。
/// 返回值：无。
export fn bigint_load_be(bi: &BigInt, bytes: &const byte, nbytes: usize) void {
    bigint_from_be(&bi.limbs[0], bytes, nbytes, BIGINT_LIMBS);
    bi.len = BIGINT_LIMBS;
}
