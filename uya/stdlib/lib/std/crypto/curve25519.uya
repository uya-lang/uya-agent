// lib/std/crypto/curve25519.uya — Curve25519 标量乘（RFC 7748）＋ Ed25519 共用域运算
//
// 模块路径：use std.crypto.curve25519
//
// 为什么另起一份：lib/tls/crypto/x25519.uya 有两条实现——
//   * `x25519_uya`（走 tls.base.mpi）对 RFC 7748 向量**正确**，但一次标量乘约 **296 ms**
//     （变长通用 MPI），且 MPI_MAX_LIMBS=32 让更大运算直接报错；
//   * `x25519_pure_uya`（u64 `Fe` 快路径）**实测对 RFC 7748 §5.2/§6.1 三条向量全部算错**。
// 本模块给一条正确且快的实现，供 SSH 的 curve25519-sha256 与 Ed25519 共用。
//
// 表示：域元素为 **16 个 limb、每 limb 16 位**（TweetNaCl 结构）。选它的理由很实际：
// 单个乘积 a[i]·b[j] < 2^32、16 项累加 < 2^36，全部落在 64 位内，**不需要 128 位整数**
// （Uya 无 u128），因此能用纯 i64 精确实现；归约靠 2^256 ≡ 38 (mod 2^255−19)。

/// 域元素 limb 数（16 × 16 位）。
export const GF_LIMBS: usize = 16;

/// 域元素：16 个 16 位 limb（用 i64 承载，允许中间结果为负），limb[0] 最低。
export struct Gf {
    v: [i64: GF_LIMBS],
}

/// 进位归约：每个 limb 收进 [0, 2^16)，最高 limb 溢出按 ×38 折回 limb0。
/// 参数：o 为就地归约的域元素。
/// 返回值：无。
export fn gf_carry(o: &Gf) void {
    var i: usize = 0;
    while i < GF_LIMBS {
        o.v[i] = (o.v[i] + (65536 as i64)) catch { o.v[i]; };
        const c: i64 = o.v[i] >> 16;
        if i < 15 {
            o.v[i + 1] = (o.v[i + 1] + (c - (1 as i64))) catch { o.v[i + 1]; };
        } else {
            // 最高 limb：溢出的 2^256 ≡ 38，即 (c−1) 的 38 倍折回 limb0
            const fold: i64 = ((c - (1 as i64)) * (38 as i64)) catch { 0i64; };
            o.v[0] = (o.v[0] + fold) catch { o.v[0]; };
        }
        // 用乘法而不是 `c << 16`：c 可能为负（limb 借位时），
        // 对负数左移在 C 里是未定义行为——UBSan 构建会直接 panic
        // （实测：Windows 目标一发起 kex 就崩在 gf_carry）。
        // c * 65536 与 c << 16 在位运算上等价，且对负数是良定义的。
        const shift_out: i64 = (c * (65536 as i64)) catch { 0i64; };
        o.v[i] = (o.v[i] - shift_out) catch { o.v[i]; };
        i = i + 1;
    }
}

/// 域乘法 o = a · b（16×16 卷积、高 16 项 ×38 折回、两轮进位）。
/// 参数：o 为输出，a/b 为输入。
/// 返回值：无。
export fn gf_mul(o: &Gf, a: &const Gf, b: &const Gf) void {
    var t: [i64: 31] = [0: 31];
    var i: usize = 0;
    while i < 16 {
        var j: usize = 0;
        while j < 16 {
            const prod: i64 = (a.v[i] * b.v[j]) catch { 0i64; };
            t[i + j] = (t[i + j] + prod) catch { t[i + j]; };
            j = j + 1;
        }
        i = i + 1;
    }
    // 2^256 ≡ 38：把 t[16..30] 折回 t[0..14]
    i = 0;
    while i < 15 {
        const wrap38: i64 = ((38 as i64) * t[i + 16]) catch { 0i64; };
        t[i] = (t[i] + wrap38) catch { t[i]; };
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        o.v[i] = t[i];
        i = i + 1;
    }
    gf_carry(o);
    gf_carry(o);
}

/// 域平方 o = a²。
/// 参数：o 为输出，a 为输入。
/// 返回值：无。
export fn gf_sq(o: &Gf, a: &const Gf) void {
    gf_mul(o, a, a);
}

/// 域加法 o = a + b（不归约）。
/// 参数：o 为输出，a/b 为输入。
/// 返回值：无。
export fn gf_add(o: &Gf, a: &const Gf, b: &const Gf) void {
    var i: usize = 0;
    while i < GF_LIMBS {
        o.v[i] = (a.v[i] + b.v[i]) catch { a.v[i]; };
        i = i + 1;
    }
}

/// 域减法 o = a − b（不归约）。
/// 参数：o 为输出，a/b 为输入。
/// 返回值：无。
export fn gf_sub(o: &Gf, a: &const Gf, b: &const Gf) void {
    var i: usize = 0;
    while i < GF_LIMBS {
        o.v[i] = (a.v[i] - b.v[i]) catch { a.v[i]; };
        i = i + 1;
    }
}

/// 小常数乘 o = a · s（s 为小整数，如 121665）。
/// 参数：o 为输出，a 为输入，s 为乘数。
/// 返回值：无。
export fn gf_mul_small(o: &Gf, a: &const Gf, s: i64) void {
    var i: usize = 0;
    while i < GF_LIMBS {
        o.v[i] = (a.v[i] * s) catch { a.v[i]; };
        i = i + 1;
    }
}

/// 拷贝 o = a。
/// 参数：o 为输出，a 为输入。
/// 返回值：无。
export fn gf_copy(o: &Gf, a: &const Gf) void {
    var i: usize = 0;
    while i < GF_LIMBS {
        o.v[i] = a.v[i];
        i = i + 1;
    }
}

/// 置零。
/// 参数：o 为输出。
/// 返回值：无。
export fn gf_zero(o: &Gf) void {
    var i: usize = 0;
    while i < GF_LIMBS {
        o.v[i] = 0 as i64;
        i = i + 1;
    }
}

/// 置一。
/// 参数：o 为输出。
/// 返回值：无。
export fn gf_one(o: &Gf) void {
    gf_zero(o);
    o.v[0] = 1 as i64;
}

/// 常量时间条件交换：b=1 交换 p/q，b=0 不动。
/// 参数：p/q 为待交换的域元素，b 为 0/1。
/// 返回值：无。
export fn gf_sel(p: &Gf, q: &Gf, b: i64) void {
    // b 只取 0/1（gf_sel 的掩码），b-1 恒在 {-1,0}，用饱和避免闸门噪音
    const c: i64 = ~(b -| (1 as i64));
    var i: usize = 0;
    while i < GF_LIMBS {
        const t: i64 = c & (p.v[i] ^ q.v[i]);
        p.v[i] = p.v[i] ^ t;
        q.v[i] = q.v[i] ^ t;
        i = i + 1;
    }
}

/// 把域元素完全归约到 [0, p) 并导出 32 字节小端。
/// 参数：o 为 32 字节输出，n 为输入（会被就地归约）。
/// 返回值：无。
export fn gf_pack(o: &byte, n: &Gf) void {
    var t: Gf = Gf{};
    gf_copy(&t, n);
    gf_carry(&t);
    gf_carry(&t);
    gf_carry(&t);
    // 两轮「减 p，若借位则回退」：p 的 limb = [65517, 65535×14, 32767]
    var round: usize = 0;
    while round < 2 {
        var m: Gf = Gf{};
        m.v[0] = t.v[0] -| (65517 as i64);
        var i: usize = 1;
        while i < 15 {
            m.v[i] = (t.v[i] -| (65535 as i64)) -| ((m.v[i - 1] >> 16) & (1 as i64));
            m.v[i - 1] = m.v[i - 1] & (65535 as i64);
            i = i + 1;
        }
        m.v[15] = t.v[15] -| (32767 as i64) -| ((m.v[14] >> 16) & (1 as i64));
        // b = 1 表示「t 不小于 p」（减法没借位），此时采用 m
        const b: i64 = (m.v[15] >> 16) & (1 as i64);
        m.v[14] = m.v[14] & (65535 as i64);
        gf_sel(&t, &m, 1 as i64 - b);
        round = round + 1;
    }
    var k: usize = 0;
    while k < 16 {
        o[k * 2] = (t.v[k] & (255 as i64)) as byte;
        o[k * 2 + 1] = ((t.v[k] >> 8) & (255 as i64)) as byte;
        k = k + 1;
    }
}

/// 从 32 字节小端装载域元素（最高位按 RFC 7748 掩掉）。
/// 参数：o 为输出，n 为 32 字节输入。
/// 返回值：无。
export fn gf_unpack(o: &Gf, n: &const byte) void {
    var i: usize = 0;
    while i < 16 {
        o.v[i] = (n[i * 2] as i64) +| (((n[i * 2 + 1] as i64)) << 8);
        i = i + 1;
    }
    o.v[15] = o.v[15] & (32767 as i64);
}

/// 域幂 o = a^e，e 为 32 字节大端指数。
/// 参数：o 为输出，a 为输入，e 为 32 字节大端指数。
/// 返回值：无。
export fn gf_pow(o: &Gf, a: &const Gf, e: &const byte) void {
    var acc: Gf = Gf{};
    gf_one(&acc);
    var byte_idx: usize = 0;
    while byte_idx < 32 {
        var bit: i32 = 7;
        while bit >= 0 {
            gf_sq(&acc, &acc);
            const mask: u32 = (1u32) << ((bit as i32));
            const taken: u32 = (e[byte_idx] as u32) & mask;
            if taken != 0 {
                gf_mul(&acc, &acc, a);
            }
            bit = bit - 1;
        }
        byte_idx = byte_idx + 1;
    }
    gf_copy(o, &acc);
}

/// 域求逆 o = a^{-1} = a^(p−2)（p = 2^255−19）。
/// 参数：o 为输出，a 为输入。
/// 返回值：无。
export fn gf_inv(o: &Gf, a: &const Gf) void {
    // p−2 = 2^255 − 21
    var e: [byte: 32] = [0: 32];
    var k: usize = 0;
    while k < 31 {
        e[k] = 255 as byte;
        k = k + 1;
    }
    e[0] = 127 as byte;
    e[31] = 235 as byte;
    gf_pow(o, a, &e[0]);
}

/// o = a^((p+3)/8)，Ed25519 开方用。指数 = 2^252 − 2。
///
/// 注意这里**不是** ref10 里常见的 `pow2523`（那个是 (p−5)/8 = 2^252−3）。指数差 1
/// 会让 x² 少一个因子 a，于是所有非平凡点的解码都走失败分支，而单位元（x=0）照样
/// 通过——很容易被误判成「公式抄错」而去改点运算。
/// 参数：o 为输出，a 为输入。
/// 返回值：无。
export fn gf_pow_sqrt_exp(o: &Gf, a: &const Gf) void {
    // gf_pow 把 e 当**大端**读（从 e[0] 的最高位开始），此处必须写成大端字节串
    const E_SQRT: [byte: 32] = [
        0x0f, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfe,
    ];
    gf_pow(o, a, &E_SQRT[0]);
}

/// o = a^((p−5)/8) = a^(2^252−3)（另一条开方路径，保留备用）。
/// 参数：o 为输出，a 为输入。
/// 返回值：无。
export fn gf_pow2523(o: &Gf, a: &const Gf) void {
    // 同 gf_pow_sqrt_exp：大端字节串
    const E_2523: [byte: 32] = [
        0x0f, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
        0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xfd,
    ];
    gf_pow(o, a, &E_2523[0]);
}

/// 常量时间字节比较。
/// 参数：a/b 为待比较字节，n 为长度。
/// 返回值：相等返回 true。
export fn ct_eq(a: &const byte, b: &const byte, n: usize) bool {
    var diff: byte = 0;
    var i: usize = 0;
    while i < n {
        diff = diff | (a[i] ^ b[i]);
        i = i + 1;
    }
    return diff == 0;
}

/// 标量按 RFC 7748 §5 clamp：k[0] &= 248; k[31] &= 127; k[31] |= 64。
/// 参数：k 为就地更新的 32 字节标量。
/// 返回值：无。
export fn x25519_clamp(k: &byte) void {
    k[0] = k[0] & (248 as byte);
    k[31] = k[31] & (127 as byte);
    k[31] = k[31] | (64 as byte);
}

/// X25519 标量乘：out = scalar · point（RFC 7748 §5 Montgomery ladder）。
/// 参数：out 为 32 字节小端输出，scalar 为 32 字节标量（内部 clamp），point 为 32 字节 u 坐标。
/// 返回值：无。
export fn x25519_scalarmult(out: &byte, scalar: &const byte, point: &const byte) void {
    var z: [byte: 32] = [0: 32];
    var i: usize = 0;
    while i < 32 {
        z[i] = scalar[i];
        i = i + 1;
    }
    x25519_clamp(&z[0]);
    var x: Gf = Gf{};
    gf_unpack(&x, point);

    var a: Gf = Gf{};
    var b: Gf = Gf{};
    var c: Gf = Gf{};
    var d: Gf = Gf{};
    var e: Gf = Gf{};
    var f: Gf = Gf{};
    gf_copy(&b, &x);
    gf_zero(&a);
    gf_zero(&c);
    gf_zero(&d);
    a.v[0] = 1 as i64;
    d.v[0] = 1 as i64;

    var pos: i32 = 254;
    while pos >= 0 {
        const byte_idx: usize = (pos / 8) as usize;
        const bit_idx: i32 = pos % 8;
        const r: i64 = ((z[byte_idx] as i64) >> ((bit_idx as i32))) & (1 as i64);
        gf_sel(&a, &b, r);
        gf_sel(&c, &d, r);
        gf_add(&e, &a, &c);
        gf_sub(&a, &a, &c);
        gf_add(&c, &b, &d);
        gf_sub(&b, &b, &d);
        gf_sq(&d, &e);
        gf_sq(&f, &a);
        gf_mul(&a, &c, &a);
        gf_mul(&c, &b, &e);
        gf_add(&e, &a, &c);
        gf_sub(&a, &a, &c);
        gf_sq(&b, &a);
        gf_sub(&c, &d, &f);
        gf_mul_small(&a, &c, 121665 as i64);
        gf_add(&a, &a, &d);
        gf_mul(&c, &c, &a);
        gf_mul(&a, &d, &f);
        gf_mul(&d, &b, &x);
        gf_sq(&b, &e);
        gf_sel(&a, &b, r);
        gf_sel(&c, &d, r);
        pos = pos - 1;
    }
    var zi: Gf = Gf{};
    gf_inv(&zi, &c);
    var res: Gf = Gf{};
    gf_mul(&res, &a, &zi);
    gf_pack(out, &res);
}

/// X25519 基点（u = 9）标量乘：out = scalar · 9。
/// 参数：out 为 32 字节输出，scalar 为 32 字节标量。
/// 返回值：无。
export fn x25519_base(out: &byte, scalar: &const byte) void {
    var base: [byte: 32] = [0: 32];
    base[0] = 9 as byte;
    x25519_scalarmult(out, scalar, &base[0]);
}
