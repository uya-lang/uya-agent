// std.env - 当前环境读取与 child-only env block 构造
// 模块路径：lib/std/env.uya → use std.env;

use std.runtime.saved_envp;

use std.collections.vec.Vec;
use std.collections.vec.vec_new;
use std.mem.allocator.IAllocator;

error EnvInvalidName;
error EnvInvalidValue;

struct EnvOverlayOp {
    key: &const byte,
    value: &const byte,
    remove: bool,
}

/// 校验环境变量名是否非空且不包含 `=`。
/// 参数：name 为以 `\0` 结尾的环境变量名。
/// 返回：名称可用于 child env overlay 时为 true，否则为 false。
export fn env_key_valid(name: &const byte) bool {
    if name == null || name[0] == 0 {
        return false;
    }

    var i: usize = 0;
    while name[i] != 0 {
        if name[i] == 61 as byte {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn env_cstr_len(s: &const byte) usize {
    if s == null {
        return 0;
    }

    var len: usize = 0;
    while s[len] != 0 {
        len = len + 1;
    }
    return len;
}

fn env_key_equals(a: &const byte, b: &const byte) bool {
    if a == null || b == null {
        return false;
    }

    var i: usize = 0;
    while a[i] != 0 && b[i] != 0 {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return a[i] == 0 && b[i] == 0;
}

fn env_entry_key_equals(entry: &const byte, key: &const byte) bool {
    if entry == null || !env_key_valid(key) {
        return false;
    }

    var i: usize = 0;
    while key[i] != 0 {
        if entry[i] == 0 || entry[i] != key[i] {
            return false;
        }
        i = i + 1;
    }
    return entry[i] == 61 as byte;
}

fn env_entry_keys_equal(a: &const byte, b: &const byte) bool {
    if a == null || b == null {
        return false;
    }

    var i: usize = 0;
    while a[i] != 0 && a[i] != 61 as byte && b[i] != 0 && b[i] != 61 as byte {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return a[i] == 61 as byte && b[i] == 61 as byte;
}

fn env_entry_key_len(entry: &const byte) usize {
    if entry == null {
        return 0;
    }

    var i: usize = 0;
    while entry[i] != 0 && entry[i] != 61 as byte {
        i = i + 1;
    }
    return i;
}

/// 读取当前进程启动时保存的环境变量值。
/// 参数：
/// - name: 以 '\\0' 结尾的环境变量名，不允许为空或包含 '='。
/// 返回：
/// - 找到时返回变量值指针。
/// - 未找到或参数非法时返回 null。
export fn get(name: &const byte) &const byte {
    if !env_key_valid(name) || saved_envp == null {
        return null;
    }

    var i: usize = 0;
    while saved_envp[i] != null {
        const entry: &const byte = saved_envp[i] as &const byte;
        if env_entry_key_equals(entry, name) {
            const offset: usize = env_cstr_len(name) + 1;
            return @ptr_from_usize(@usize_from_ptr(entry as &void) + offset) as &const byte;
        }
        i = i + 1;
    }
    return null;
}

/// 判断当前进程启动时保存的环境变量是否存在。
/// 参数：
/// - name: 以 '\\0' 结尾的环境变量名，不允许为空或包含 '='。
/// 返回：
/// - true: 环境变量存在。
/// - false: 环境变量不存在或参数非法。
export fn has(name: &const byte) bool {
    return get(name) != null;
}

/// 为子进程构造专属 envp 的 builder。
/// 参数：
/// - allocator: 用于保存最终指针数组和 `KEY=VALUE` 字符串存储的分配器。
/// 返回：
/// - 新建的空 builder；默认不继承环境，调用 `inherit_current` 或 `inherit_from` 后才有 base env。
export fn env_block_builder_new(allocator: IAllocator) EnvBlockBuilder {
    return EnvBlockBuilder{
        base_envp: null,
        ops: vec_new<EnvOverlayOp>(allocator),
        storage: vec_new<byte>(allocator),
        entries: vec_new<usize>(allocator),
        entry_count: 0,
    };
}

export struct EnvBlockBuilder {
    base_envp: &(&const byte),
    ops: Vec<EnvOverlayOp>,
    storage: Vec<byte>,
    entries: Vec<usize>,
    entry_count: usize,

    /// 使用当前进程启动时保存的 envp 作为 base 环境。
    /// 参数：
    /// - self: 当前 builder。
    /// 返回：
    /// - 无返回值；后续 build 会以当前 saved_envp 快照为 base。
    fn inherit_current(self: &Self) void {
        if saved_envp == null {
            self.base_envp = null;
            return;
        }
        self.base_envp = saved_envp as &(&const byte);
    },

    /// 使用调用方提供的 envp 作为 base 环境。
    /// 参数：
    /// - self: 当前 builder。
    /// - envp: 以 null 结尾的 `KEY=VALUE` 指针数组。
    /// 返回：
    /// - 无返回值；builder 不接管 envp 所指向内存。
    fn inherit_from(self: &Self, envp: &(&const byte)) void {
        self.base_envp = envp;
    },

    /// 为子进程新增或覆盖一个环境变量。
    /// 参数：
    /// - self: 当前 builder。
    /// - key: 环境变量名，不允许为空或包含 '='。
    /// - value: 环境变量值，允许为空字符串，不允许 null。
    /// 返回：
    /// - ok: 已记录 child-only 覆盖操作。
    /// - error.EnvInvalidName: key 非法。
    /// - error.EnvInvalidValue: value 为 null。
    /// - error: 分配器扩容失败。
    fn with(self: &Self, key: &const byte, value: &const byte) !void {
        if !env_key_valid(key) {
            return error.EnvInvalidName;
        }
        if value == null {
            return error.EnvInvalidValue;
        }

        try self.ops.push(EnvOverlayOp{
            key: key,
            value: value,
            remove: false,
        });
    },

    /// 从子进程最终 env block 中删除一个环境变量。
    /// 参数：
    /// - self: 当前 builder。
    /// - key: 环境变量名，不允许为空或包含 '='。
    /// 返回：
    /// - ok: 已记录 child-only 删除操作。
    /// - error.EnvInvalidName: key 非法。
    /// - error: 分配器扩容失败。
    fn without(self: &Self, key: &const byte) !void {
        if !env_key_valid(key) {
            return error.EnvInvalidName;
        }

        try self.ops.push(EnvOverlayOp{
            key: key,
            value: null,
            remove: true,
        });
    },

    fn last_op_index_for_key(self: &Self, key: &const byte) usize {
        var i: usize = self.ops.len();
        while i > 0 {
            i = i - 1;
            const op: EnvOverlayOp = self.ops.get(i) catch {
                return self.ops.len();
            };
            if env_key_equals(op.key, key) {
                return i;
            }
        }
        return self.ops.len();
    },

    fn base_has_key(self: &Self, key: &const byte) bool {
        if self.base_envp == null {
            return false;
        }

        var i: usize = 0;
        while self.base_envp[i] != null {
            if env_entry_key_equals(self.base_envp[i], key) {
                return true;
            }
            i = i + 1;
        }
        return false;
    },

    fn key_seen_in_ops_before(self: &Self, idx: usize, key: &const byte) bool {
        var i: usize = 0;
        while i < idx {
            const op: EnvOverlayOp = self.ops.get(i) catch {
                return false;
            };
            if env_key_equals(op.key, key) {
                return true;
            }
            i = i + 1;
        }
        return false;
    },

    fn final_set_op_for_key(self: &Self, key: &const byte) !EnvOverlayOp {
        const idx: usize = self.last_op_index_for_key(key);
        if idx >= self.ops.len() {
            return error.EnvInvalidName;
        }
        return try self.ops.get(idx);
    },

    fn base_entry_key_seen_before(self: &Self, idx: usize, entry: &const byte) bool {
        if self.base_envp == null {
            return false;
        }

        var i: usize = 0;
        while i < idx {
            if env_entry_keys_equal(self.base_envp[i], entry) {
                return true;
            }
            i = i + 1;
        }
        return false;
    },

    fn visible_entry_count(self: &Self) usize {
        var count: usize = 0;

        if self.base_envp != null {
            var i: usize = 0;
            while self.base_envp[i] != null {
                const entry: &const byte = self.base_envp[i];
                const key_len: usize = env_entry_key_len(entry);
                if key_len > 0 && entry[key_len] == 61 as byte &&
                    !self.base_entry_key_seen_before(i, entry) {
                    const idx: usize = self.last_op_index_for_entry(entry);
                    if idx >= self.ops.len() {
                        count = count + 1;
                    } else {
                        const op: EnvOverlayOp = self.ops.get(idx) catch {
                            return count;
                        };
                        if !op.remove {
                            count = count + 1;
                        }
                    }
                }
                i = i + 1;
            }
        }

        var j: usize = 0;
        while j < self.ops.len() {
            const op: EnvOverlayOp = self.ops.get(j) catch {
                return count;
            };
            if !self.base_has_key(op.key) && !self.key_seen_in_ops_before(j, op.key) {
                const final_op: EnvOverlayOp = self.final_set_op_for_key(op.key) catch {
                    return count;
                };
                if !final_op.remove {
                    count = count + 1;
                }
            }
            j = j + 1;
        }

        return count;
    },

    fn last_op_index_for_entry(self: &Self, entry: &const byte) usize {
        var i: usize = self.ops.len();
        while i > 0 {
            i = i - 1;
            const op: EnvOverlayOp = self.ops.get(i) catch {
                return self.ops.len();
            };
            if env_entry_key_equals(entry, op.key) {
                return i;
            }
        }
        return self.ops.len();
    },

    fn total_storage_bytes(self: &Self) usize {
        var bytes: usize = 0;

        if self.base_envp != null {
            var i: usize = 0;
            while self.base_envp[i] != null {
                const entry: &const byte = self.base_envp[i];
                const key_len: usize = env_entry_key_len(entry);
                if key_len > 0 && entry[key_len] == 61 as byte &&
                    !self.base_entry_key_seen_before(i, entry) {
                    const idx: usize = self.last_op_index_for_entry(entry);
                    if idx >= self.ops.len() {
                        bytes = bytes + env_cstr_len(entry) + 1;
                    } else {
                        const op: EnvOverlayOp = self.ops.get(idx) catch {
                            return bytes;
                        };
                        if !op.remove {
                            bytes = bytes + env_cstr_len(op.key) + env_cstr_len(op.value) + 2;
                        }
                    }
                }
                i = i + 1;
            }
        }

        var j: usize = 0;
        while j < self.ops.len() {
            const op: EnvOverlayOp = self.ops.get(j) catch {
                return bytes;
            };
            if !self.base_has_key(op.key) && !self.key_seen_in_ops_before(j, op.key) {
                const final_op: EnvOverlayOp = self.final_set_op_for_key(op.key) catch {
                    return bytes;
                };
                if !final_op.remove {
                    bytes = bytes + env_cstr_len(final_op.key) + env_cstr_len(final_op.value) + 2;
                }
            }
            j = j + 1;
        }

        return bytes;
    },

    fn push_entry_cstr(self: &Self, entry: &const byte) !void {
        const start: usize = self.storage.len();
        var i: usize = 0;
        while entry[i] != 0 {
            try self.storage.push(entry[i]);
            i = i + 1;
        }
        try self.storage.push(0 as byte);
        const ptr: &const byte = @ptr_from_usize(@usize_from_ptr(self.storage.data as &void) + start) as &const byte;
        try self.entries.push(@usize_from_ptr(ptr as &void));
    },

    fn push_entry_pair(self: &Self, key: &const byte, value: &const byte) !void {
        const start: usize = self.storage.len();

        var i: usize = 0;
        while key[i] != 0 {
            try self.storage.push(key[i]);
            i = i + 1;
        }
        try self.storage.push(61 as byte);

        var j: usize = 0;
        while value[j] != 0 {
            try self.storage.push(value[j]);
            j = j + 1;
        }
        try self.storage.push(0 as byte);

        const ptr: &const byte = @ptr_from_usize(@usize_from_ptr(self.storage.data as &void) + start) as &const byte;
        try self.entries.push(@usize_from_ptr(ptr as &void));
    },

    fn append_base_entry(self: &Self, entry: &const byte) !void {
        const idx: usize = self.last_op_index_for_entry(entry);
        if idx >= self.ops.len() {
            try self.push_entry_cstr(entry);
            return;
        }

        const op: EnvOverlayOp = try self.ops.get(idx);
        if op.remove {
            return;
        }
        try self.push_entry_pair(op.key, op.value);
    },

    fn append_overlay_entries(self: &Self) !void {
        var i: usize = 0;
        while i < self.ops.len() {
            const op: EnvOverlayOp = try self.ops.get(i);
            if !self.base_has_key(op.key) && !self.key_seen_in_ops_before(i, op.key) {
                const final_op: EnvOverlayOp = try self.final_set_op_for_key(op.key);
                if !final_op.remove {
                    try self.push_entry_pair(final_op.key, final_op.value);
                }
            }
            i = i + 1;
        }
    },

    /// 构造以 null 结尾、可直接传给 execve/os_execve 的 envp。
    /// 参数：
    /// - self: 当前 builder。
    /// 返回：
    /// - ok: 已刷新 builder 内部 envp 指针数组；可通过 `envp()` 取得。
    /// - error: 分配器扩容失败。
    fn build(self: &Self) !void {
        self.storage.clear();
        self.entries.clear();
        self.entry_count = 0;

        try self.storage.try_reserve(self.total_storage_bytes());
        try self.entries.try_reserve(self.visible_entry_count() + 1);

        if self.base_envp != null {
            var i: usize = 0;
            while self.base_envp[i] != null {
                const entry: &const byte = self.base_envp[i];
                const key_len: usize = env_entry_key_len(entry);
                if key_len > 0 && entry[key_len] == 61 as byte &&
                    !self.base_entry_key_seen_before(i, entry) {
                    try self.append_base_entry(entry);
                }
                i = i + 1;
            }
        }

        try self.append_overlay_entries();
        self.entry_count = self.entries.len();
        try self.entries.push(0 as usize);
    },

    /// 返回上一次 build 生成的 envp 指针数组。
    /// 参数：
    /// - self: 当前 builder。
    /// 返回：
    /// - 指向 builder 内部 envp 指针数组；下次 build 或 builder drop 后失效。
    fn envp(self: &Self) &(&const byte) {
        return self.entries.data as &(&const byte);
    },

    /// 返回上一次 build 生成的有效环境变量数量，不包含 null sentinel。
    /// 参数：
    /// - self: 当前 builder。
    /// 返回：
    /// - 上一次 build 的 env entry 数量。
    fn len(self: &Self) usize {
        return self.entry_count;
    },

    /// 释放 builder 持有的动态存储。
    /// 参数：
    /// - self: 按值传入的 builder。
    /// 返回：
    /// - 无返回值。
    fn drop(self: EnvBlockBuilder) void {
        // 字段按逆序自动 drop；这里保留显式 drop 入口说明所有权语义。
    },
}
