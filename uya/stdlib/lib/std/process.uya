/// Pipeline stage 的稳定执行状态类别。
export enum PipelineStageStatusKind {
    not_started,
    spawn_failed,
    cancelled,
    exited,
    signaled,
    completed,
    stage_failed,
}

/// Process stage 启动失败的稳定跨平台分类。
export enum PipelineSpawnFailureKind {
    none,
    path_not_found,
    cwd_unavailable,
    permission_denied,
    process_create_failed,
    execution_domain_failed,
    stdio_setup_failed,
    exec_failed,
    platform_error,
}

/// 单个完整 pipeline stage 的执行状态。
export struct PipelineStageStatus {
    stage_index: usize,
    kind: PipelineStageStatusKind,
    exit_code: u32,
    signal: i32,
    spawn_failure: PipelineSpawnFailureKind,
    platform_code: u32,
    error_name: &const byte,
}

/// Pipeline 执行结果摘要；不保存 caller statuses 缓冲区借用。
export struct PipelineResult {
    stage_count: usize,
}

/// 单路 capture 的长度与完整性摘要。
export struct CaptureStreamResult {
    captured: bool,
    byte_count: usize,
    complete: bool,
}

/// Pipeline capture 摘要；不保存 stdout/stderr caller buffer 借用。
export struct PipelineCaptureResult {
    result: PipelineResult,
    stdout: CaptureStreamResult,
    stderr: CaptureStreamResult,
}

/// Pipeline stage 的阻塞字节输入流；实例由 executor 提供，不拥有底层 fd。
export struct StreamReader {
    _fd: i32,

    /// 阻塞读取至多 output.len 字节。
    /// 参数：output 为调用方可写缓冲区。
    /// 返回：读取字节数；仅在已观察到 EOF 且未读取字节时返回 0。
    fn read(self: &Self, output: &[byte]) !usize {
        if self == null || output.ptr == null && output.len != 0usize { return error.InvalidPipeline; }
        while true {
            const received: !isize = sys_read(self._fd, output.ptr, output.len);
            const count: isize = received catch |err| {
                if @error_id(err) as i32 == EINTR { continue; }
                return error.PipelineIoError;
            };
            if count < 0isize { return error.PipelineIoError; }
            return count as usize;
        }
    }

    /// 阻塞读取一行，换行符包含在返回数据中。
    /// 参数：output 为调用方可写缓冲区；缓冲区满时返回当前片段。
    /// 返回：本次写入字节数；EOF 前已有字节时先返回该尾段，下一次调用返回 0。
    fn read_line(self: &Self, output: &[byte]) !usize {
        if self == null || output.ptr == null && output.len != 0usize { return error.InvalidPipeline; }
        var count: usize = 0usize;
        var one: [byte: 1] = [];
        while count < output.len {
            const read_count: usize = try self.read(&one[0:1]);
            if read_count == 0usize { return count; }
            output[count] = one[0];
            count = count + 1usize;
            if output[count - 1usize] == 10 as byte { return count; }
        }
        return count;
    }
}

/// Pipeline stage 的阻塞字节输出流；实例由 executor 提供，不拥有底层 fd。
export struct StreamWriter {
    _fd: i32,

    /// 阻塞写入一次，允许底层返回短写。
    /// 参数：input 为待写入字节。
    /// 返回：本次成功写入的字节数。
    fn write(self: &Self, input: &[const byte]) !usize {
        if self == null || input.ptr == null && input.len != 0usize { return error.InvalidPipeline; }
        while true {
            const sent: !isize = sys_write(self._fd, input.ptr, input.len);
            const count: isize = sent catch |err| {
                if @error_id(err) as i32 == EINTR { continue; }
                return error.PipelineIoError;
            };
            if count < 0isize { return error.PipelineIoError; }
            return count as usize;
        }
    }

    /// 阻塞写完全部输入，自动处理短写与 EINTR。
    /// 参数：input 为完整待写入字节。
    /// 返回：成功时无返回值；写入停滞或失败时返回 PipelineIoError。
    fn write_all(self: &Self, input: &[const byte]) !void {
        if self == null || input.ptr == null && input.len != 0usize { return error.InvalidPipeline; }
        var offset: usize = 0usize;
        while offset < input.len {
            const sent: !isize = sys_write(self._fd, &input.ptr[offset], input.len - offset);
            const count: isize = sent catch |err| {
                if @error_id(err) as i32 == EINTR { continue; }
                return error.PipelineIoError;
            };
            if count <= 0isize { return error.PipelineIoError; }
            offset = offset + count as usize;
        }
    }
}

/// 自定义 Uya pipeline stage 的同步流处理接口。
export interface PipelineStage {
    /// 阻塞运行 stage，直到输入 EOF、成功完成或返回 Uya error。
    fn run(self: &Self, input: &StreamReader, output: &StreamWriter) !void;
}

interface PipelineErasedStageOps {
    fn run_erased(self: &Self, input: &StreamReader, output: &StreamWriter) !void;
    fn clone_erased(self: &Self) !PipelineErasedStageOps;
    fn drop_erased(self: &Self) void;
}

struct PipelineErasedStageBox : PipelineErasedStageOps {
    value: PipelineStage,
    owned_value: &void,

    fn run_erased(self: &Self, input: &StreamReader, output: &StreamWriter) !void {
        try self.value.run(input, output);
    }

    fn clone_erased(self: &Self) !PipelineErasedStageOps {
        _ = self;
        return error.InvalidPipeline;
    }

    fn drop_erased(self: &Self) void {
        if self.owned_value != null { free(self.owned_value); }
        free(self as &void);
    }
}

