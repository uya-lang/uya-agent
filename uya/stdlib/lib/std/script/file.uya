// std.script - 脚本作者使用的高层 facade。
// 当前只重导出 std.process 的 process-only typed pipeline 常用 API。

use std.process.Pipeline;
use std.process.PipelineResult;
use std.process.PipelineStageStatus;
use std.process.PipelineCaptureResult;

extern fn std_pipeline() Pipeline;
extern fn std_clone(input: &Pipeline) !Pipeline;
extern fn std_cmd_argv(input: Pipeline, program: &const byte, args: &[&const byte]) !Pipeline;
extern fn std_cmd_path_argv(input: Pipeline, path: &const byte, args: &[&const byte]) !Pipeline;
extern fn std_cwd(input: Pipeline, path: &const byte) !Pipeline;
extern fn std_env(input: Pipeline, key: &const byte, value: &const byte) !Pipeline;
extern fn std_unset_env(input: Pipeline, key: &const byte) !Pipeline;
extern fn std_stdin_file(input: Pipeline, path: &const byte) !Pipeline;
extern fn std_stdout_file(input: Pipeline, path: &const byte) !Pipeline;
extern fn std_stderr_file(input: Pipeline, path: &const byte) !Pipeline;
extern fn std_stdout_capture(input: Pipeline) !Pipeline;
extern fn std_stderr_capture(input: Pipeline) !Pipeline;
extern fn std_stderr_to_stdout(input: Pipeline) !Pipeline;
extern fn std_inherit_stdio(input: Pipeline) !Pipeline;
extern fn std_check(input: Pipeline) !void;
extern fn std_check_into(input: Pipeline, statuses: &[PipelineStageStatus], result: &PipelineResult) !void;
extern fn std_status_into(input: Pipeline, statuses: &[PipelineStageStatus], result: &PipelineResult) !void;
extern fn std_capture_into(input: Pipeline, statuses: &[PipelineStageStatus], stdout_buf: &[byte],
    stderr_buf: &[byte], result: &PipelineCaptureResult) !void;
extern fn std_capture_limit_into(input: Pipeline, max_bytes: usize, statuses: &[PipelineStageStatus],
    stdout_buf: &[byte], stderr_buf: &[byte], result: &PipelineCaptureResult) !void;
extern fn std_stage_count(input: &Pipeline) !usize;

/// 创建一个空的 typed pipeline 计划。
/// 参数：无。
/// 返回：成功时返回新的 Pipeline capability。
export fn pipeline() Pipeline {
    return std_pipeline();
}

/// 深拷贝 pipeline 执行计划。
/// 参数：input 为有效且仍存活的只读 pipeline capability。
/// 返回：成功时返回独立 pipeline 副本；计划不可克隆或无效时返回 InvalidPipeline。
export fn clone(input: &Pipeline) !Pipeline {
    return std_clone(input);
}

/// 向 pipeline 追加一个通过 PATH 查找的 process stage。
/// 参数：input 为按值消费的 pipeline；program 为命令名；args 不包含 argv[0]。
/// 返回：成功时返回追加 stage 后的 pipeline；参数或 capability 无效时返回错误。
export fn cmd_argv(input: Pipeline, program: &const byte, args: &[&const byte]) !Pipeline {
    return std_cmd_argv(input, program, args);
}

/// 向 pipeline 追加一个按 exact path 执行的 process stage。
/// 参数：input 为按值消费的 pipeline；path 可为绝对或相对路径；args 不包含 argv[0]。
/// 返回：成功时返回追加 stage 后的 pipeline；参数或 capability 无效时返回错误。
export fn cmd_path_argv(input: Pipeline, path: &const byte, args: &[&const byte]) !Pipeline {
    return std_cmd_path_argv(input, path, args);
}

/// 为最近追加的 process stage 设置最终工作目录。
/// 参数：input 为按值消费的 pipeline；path 在 sink 开始时相对 canonical cwd 解释。
/// 返回：成功时返回修改后的 pipeline；没有最近 process stage 时返回 InvalidPipeline。
export fn cwd(input: Pipeline, path: &const byte) !Pipeline {
    return std_cwd(input, path);
}

/// 为最近追加的 process stage 设置 child-only 环境变量覆盖。
/// 参数：input 为按值消费的 pipeline；key/value 会复制到计划中。
/// 返回：成功时返回修改后的 pipeline；名称或值无效时返回 std.env 校验错误。
export fn env(input: Pipeline, key: &const byte, value: &const byte) !Pipeline {
    return std_env(input, key, value);
}

/// 从最近追加的 process stage 最终 child 环境中移除变量。
/// 参数：input 为按值消费的 pipeline；key 会复制到计划中。
/// 返回：成功时返回修改后的 pipeline；名称无效时返回 std.env 校验错误。
export fn unset_env(input: Pipeline, key: &const byte) !Pipeline {
    return std_unset_env(input, key);
}

/// 将 pipeline 第一段 stdin 配置为文件输入。
/// 参数：input 为按值消费的 pipeline；path 在 sink-time cwd 规则下解析。
/// 返回：成功时返回新 pipeline；路径无效或 stdin 已配置时返回 InvalidPipeline。
export fn stdin_file(input: Pipeline, path: &const byte) !Pipeline {
    return std_stdin_file(input, path);
}

/// 将 pipeline 最后一段 stdout 配置为文件输出。
/// 参数：input 为按值消费的 pipeline；path 在 sink-time cwd 规则下解析。
/// 返回：成功时返回新 pipeline；路径无效或 stdout 已配置时返回 InvalidPipeline。
export fn stdout_file(input: Pipeline, path: &const byte) !Pipeline {
    return std_stdout_file(input, path);
}

/// 将 pipeline 全部 process stage 的 stderr 配置为同一文件输出。
/// 参数：input 为按值消费的 pipeline；path 在 sink-time cwd 规则下解析。
/// 返回：成功时返回新 pipeline；路径无效或 stderr 已配置时返回 InvalidPipeline。
export fn stderr_file(input: Pipeline, path: &const byte) !Pipeline {
    return std_stderr_file(input, path);
}

/// 捕获 pipeline 最后一段 stdout。
/// 参数：input 为按值消费的 pipeline。
/// 返回：成功时返回新 pipeline；stdout 已配置时返回 InvalidPipeline。
export fn stdout_capture(input: Pipeline) !Pipeline {
    return std_stdout_capture(input);
}

/// 捕获 pipeline 的 stderr。
/// 参数：input 为按值消费的 pipeline。
/// 返回：成功时返回新 pipeline；stderr 已配置时返回 InvalidPipeline。
export fn stderr_capture(input: Pipeline) !Pipeline {
    return std_stderr_capture(input);
}

/// 将 pipeline 的 stderr 合并到 stdout policy。
/// 参数：input 为按值消费的 pipeline。
/// 返回：成功时返回新 pipeline；stderr 已配置时返回 InvalidPipeline。
export fn stderr_to_stdout(input: Pipeline) !Pipeline {
    return std_stderr_to_stdout(input);
}

/// 原子地让 pipeline 的 stdin/stdout/stderr 继承宿主标准流。
/// 参数：input 为按值消费的 pipeline。
/// 返回：成功时返回新 pipeline；任一路已配置时返回 InvalidPipeline。
export fn inherit_stdio(input: Pipeline) !Pipeline {
    return std_inherit_stdio(input);
}

/// 执行 pipeline，并按 pipefail 语义要求所有 process stage 成功。
/// 参数：input 为按值消费的 pipeline。
/// 返回：成功无返回值；启动失败或非零退出返回对应错误。
export fn check(input: Pipeline) !void {
    return std_check(input);
}

/// 执行 checked pipeline，并将完整 stage 状态写入调用方缓冲区。
/// 参数：input 为按值消费的 pipeline；statuses/result 为调用方可写区域。
/// 返回：成功无返回值；错误返回前仍保留已获得的结果。
export fn check_into(input: Pipeline, statuses: &[PipelineStageStatus], result: &PipelineResult) !void {
    return std_check_into(input, statuses, result);
}

/// 观察执行 pipeline，非零退出和 signal 通过 statuses 报告而不转为 ProcessFailed。
/// 参数：input 为按值消费的 pipeline；statuses/result 为调用方可写区域。
/// 返回：执行基础设施成功时无错误，启动失败返回 PipelineSpawnFailed。
export fn status_into(input: Pipeline, statuses: &[PipelineStageStatus], result: &PipelineResult) !void {
    return std_status_into(input, statuses, result);
}

/// 观察执行 pipeline，并把捕获流写入调用方缓冲区。
/// 参数：statuses/stdout_buf/stderr_buf/result 均由调用方持有；stdout 默认隐式 capture。
/// 返回：正常 stage 失败仍成功；基础设施或容量超限返回错误。
export fn capture_into(input: Pipeline, statuses: &[PipelineStageStatus], stdout_buf: &[byte],
    stderr_buf: &[byte], result: &PipelineCaptureResult) !void {
    return std_capture_into(input, statuses, stdout_buf, stderr_buf, result);
}

/// 观察执行 pipeline，并对每个捕获流应用显式最大字节数。
/// 参数：有效上限为 min(max_bytes, 对应 buffer.len)。
/// 返回：超过任一路有效上限时取消 pipeline 并返回 CaptureLimitExceeded。
export fn capture_limit_into(input: Pipeline, max_bytes: usize, statuses: &[PipelineStageStatus],
    stdout_buf: &[byte], stderr_buf: &[byte], result: &PipelineCaptureResult) !void {
    return std_capture_limit_into(input, max_bytes, statuses, stdout_buf, stderr_buf, result);
}

/// 返回计划中的完整可执行 stage 数量，不消费或执行计划。
/// 参数：input 为只读 pipeline capability。
/// 返回：成功时返回 stage 数量；无效 capability 返回 InvalidPipeline。
export fn stage_count(input: &Pipeline) !usize {
    return std_stage_count(input);
}
