// lib/std/image/jpeg_tables.uya - JPEG 基线码表（Annex K）
//
// 模块路径：use std.image.jpeg_tables
//
// 本文件：**只放表与查表工具，不放流程** —— 标准推荐量化表（亮度/色度，自然顺序）、
//   标准 Huffman 表（DC/AC × 亮度/色度：BITS 16 项 + HUFFVAL）、zigzag 顺序表、
//   质量 → 量化表的缩放（`jpeg_quality_scale`）、以及解码/编码两侧共用的
//   Huffman 译码表装配（`JpegHuffDecoder`）。
// 不变量：① 表值**必须是机器提取的**，不许手抄 —— 下面的量化表与 Huffman 表是用
//   `cjpeg -quality 50 -baseline -dct int` 压一张空图，再从输出的 DQT/DHT 段里
//   dump 出来的（命令见本段末尾），已断言等于 ITU T.81 Annex K 的经典表；
//   ② **自然顺序 vs zigzag 顺序不能混**：`*_NATURAL` 的索引是 `v*8+u`（DCT 系数
//   位置），`JPEG_ZIGZAG[k]` 给出 zigzag 第 k 个位置对应的自然索引 —— 熵段里
//   一律走 zigzag，FDCT/IDCT 一律走自然顺序，转换只在这张表上做；
//   ③ BITS 是 16 项（长度 1..16 的码字个数），HUFFVAL 长度 = sum(BITS)；
//   ④ 本文件不分配内存、不报错（纯查表）。
// 依赖：无（零 use、零 libc —— 表和缩放只做整数算术）。
// 命名：`JPEG_*`（表）、`JpegHuffDecoder`、`jpeg_*`。
//
// 表值提取命令（可复现；cjpeg 来自 libjpeg-turbo）：
//   printf 'P6\n16 16\n255\n' > /tmp/t.ppm
//   head -c 768 /dev/zero >> /tmp/t.ppm
//   cjpeg -quality 50 -baseline -dct int -sample 1x1 \
//         -outfile /tmp/t.jpg /tmp/t.ppm
// 然后按 T.81 B.2.4.1（DQT）/ B.2.4.2（DHT）解析段体即可（本轮用一次性脚本做的）。

const JPEG_ZIGZAG: [u8: 64] = [
    0u8, 1u8, 8u8, 16u8, 9u8, 2u8, 3u8, 10u8, 17u8, 24u8,
    32u8, 25u8, 18u8, 11u8, 4u8, 5u8, 12u8, 19u8, 26u8, 33u8,
    40u8, 48u8, 41u8, 34u8, 27u8, 20u8, 13u8, 6u8, 7u8, 14u8,
    21u8, 28u8, 35u8, 42u8, 49u8, 56u8, 57u8, 50u8, 43u8, 36u8,
    29u8, 22u8, 15u8, 23u8, 30u8, 37u8, 44u8, 51u8, 58u8, 59u8,
