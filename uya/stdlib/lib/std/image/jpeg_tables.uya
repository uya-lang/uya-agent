// ============================================================
// 质量 → 量化表（T.81 Annex K.4 的缩放规则）
// ============================================================

// 把标准量化表按 quality(1..100) 缩放，写进 out（必须至少 64 项）。
// 规则（libjpeg 同款，也是 T.81 推荐做法）：
//   quality < 50 → scale = 5000 / quality；否则 scale = 200 - quality*2；
//   q = (base*scale + 50) / 100，再夹到 1..255。
// 参数：
// - base: 基准量化表（64 项，自然顺序）。
// - quality: 1..100（越界先夹）。
// - out: 输出表（64 项，自然顺序；调用方分配）。
// 返回：
// - 无。表值恒在 1..255。
export fn jpeg_quality_scale(base: &const u8, quality: i32, out: &u8) void {
    var q: i32 = quality;
    if q < 1 {
        q = 1;
    }
    if q > 100 {
        q = 100;
    }
    var scale: i32 = 0;
    if q < 50 {
        scale = 5000 / q;
    } else {
        scale = 200 - q * 2;
    }
    var i: usize = 0;
    while i < 64 {
        const b: i32 = base[i] as i32;
        var v: i32 = (b * scale + 50) / 100;
        if v < 1 {
            v = 1;
        }
        if v > 255 {
            v = 255;
        }
        out[i] = v as u8;
        i = i + 1;
    }
}

// ============================================================
// Huffman 译码表
// ============================================================

// 译码表容量：JPEG 的 Huffman 码最长 16 bit。
export const JPEG_HUFF_MAX_BITS: i32 = 16;
// 一次查表覆盖的位数（8 = 快表一字节；余下 8 bit 走逐位慢路径）。
export const JPEG_HUFF_LOOK_BITS: i32 = 8;
// 快表槽位数（2^8）。
export const JPEG_HUFF_FAST_SLOTS: usize = 256;

// 一张 Huffman 译码表（libjpeg 那套「快表 + 规范码上下界」的形状）。
//
// * `fast[l]`（l = 接下来 8 bit 的值，高位在前）：`(码长 << 8) | 符号`；
//   `码长 == 0` 表示「这个 8 位前缀不是任何短码」→ 走慢路径。**注意**：
//   慢路径的入口正是「先吃掉这 8 位」，所以 0 也必须能被调用方区分开
//   （读流耗尽时 fast 查不了，由 nbits 检查挡住）。
// * 慢路径（9..16 位码）用规范码的区间：
//   `mincode[l]` / `maxcode[l]` 是长度 l 的码字下/上界，`valptr[l]` 是该长度
//   第一个符号在 `vals` 里的下标 ⇒ 符号 = vals[valptr[l] + code - mincode[l]]。
//   `maxcode[l] == -1` 表示没有这个长度的码。
// * `vals` 是 HUFFVAL 的副本（最多 256 项 —— 基线 JPEG 的符号只有 8 位），
//   慢路径要按全局下标取符号，不能只留每长度的个数。
export struct JpegHuffDecoder {
    fast: [u16: 256],
    mincode: [i32: 17],
    maxcode: [i32: 17],
    valptr: [i32: 17],
    vals: [u8: 256],
    nvals: i32,
}

// 从 BITS/HUFFVAL 装配一张译码表。
// 参数：
// - bits: 16 项，bits[i] = 长度 i+1 的码字个数。
// - vals: 符号表（长度必须 >= sum(bits)；最多 256 项）。
// - d: 输出译码表（调用方分配，本函数整体重写）。
// 返回：
// - 无。表非法（符号数超 256、或某个长度的码字超出码空间）时按「没这张表」
//   处理：maxcode 全 -1、fast 全 0 —— 解码侧于是会在取码时报 JpegCorrupt，
//   而不是拿乱码往下算。
// 清零一张译码表（fast 全 0 = 未命中；maxcode 全 -1 = 没有该长度的码）。
fn jpeg_huff_reset(d: &JpegHuffDecoder) void {
    var i: usize = 0;
    while i < JPEG_HUFF_FAST_SLOTS {
        d.fast[i] = 0 as u16;
        i = i + 1;
    }
    i = 0;
    while i < 17 {
        d.mincode[i] = 0;
        d.maxcode[i] = 0 - 1;
        d.valptr[i] = 0;
        i = i + 1;
    }
    i = 0;
    while i < 256 {
        d.vals[i] = 0 as u8;
        i = i + 1;
    }
    d.nvals = 0;
}

// 按规范码填 mincode / maxcode / valptr（T.81 的「同长度递增、长度加一左移」）。
// 返回 false = 码空间矛盾（这个表非法），调用方按「没这张表」处理。
fn jpeg_huff_canonical(bits: &const u8, d: &JpegHuffDecoder) bool {
    var code: i32 = 0;
    var si: i32 = 0;
    var len: i32 = 1;
    while len <= JPEG_HUFF_MAX_BITS {
        const cntn: i32 = bits[(len - 1) as usize] as i32;
        if cntn > 0 {
            d.valptr[len] = si;
            d.mincode[len] = code;
            code = code + cntn;
            d.maxcode[len] = code - 1;
            si = si + cntn;
            if code > (1 << len) {
                d.maxcode[len] = 0 - 1;
                return false;
            }
        }
        code = code << 1;
        len = len + 1;
    }
    return true;
}

// 填快表：长度 1..8 的码，把以该码开头的所有 8 位前缀都指向它。
//
// **idx 必须跟着 j 走**：同一长度桶里第 j 个码字的符号是 vals[idx + j]，
// 漏掉那个 `+ j` 会让同长度的所有码都指向桶里第一个符号 —— 症状是
// 「DC 看着对、AC 从某个系数起整块跑飞」（实测踩到过）。
fn jpeg_huff_fill_fast(bits: &const u8, d: &JpegHuffDecoder) void {
    var len: i32 = 1;
    var idx: i32 = 0;
    while len <= JPEG_HUFF_LOOK_BITS {
        const c: i32 = bits[(len - 1) as usize] as i32;
        var j: i32 = 0;
        while j < c {
            const vidx: i32 = idx + j;
            if vidx < 0 || vidx >= d.nvals {
                return;
            }
            const vsym: u8 = d.vals[vidx as usize];
            const shift: i32 = JPEG_HUFF_LOOK_BITS - len;
            const span: i32 = 1 << shift;
            const first: i32 = (d.mincode[len] + j) << shift;
            var t: i32 = 0;
            while t < span {
                const slot: i32 = first + t;
                if slot >= 0 && slot < 256 {
                    const packed: i32 = (len << 8) | (vsym as i32);
                    d.fast[slot as usize] = packed as u16;
                }
                t = t + 1;
            }
            j = j + 1;
        }
        idx = idx + c;
        len = len + 1;
    }
}

// 从 BITS/HUFFVAL 装配一张译码表。
// 参数：
// - bits: 16 项，bits[i] = 长度 i+1 的码字个数。
// - vals: 符号表（长度必须 >= sum(bits)；最多 256 项）。
// - d: 输出译码表（调用方分配，本函数整体重写）。
// 返回：
// - 无。表非法（符号数超 256、或码空间矛盾）时按「没这张表」处理：
//   maxcode 全 -1、fast 全 0 —— 解码侧于是会在取码时报 JpegCorrupt，
//   而不是拿乱码往下算。
export fn jpeg_huff_build(bits: &const u8, vals: &const u8,
                          d: &JpegHuffDecoder) void {
    jpeg_huff_reset(d);
    var total: i32 = 0;
    var k: usize = 0;
    while k < 16 {
        total = total + (bits[k] as i32);
        k = k + 1;
    }
    if total > 256 {
        return;
    }
    k = 0;
    while k < (total as usize) {
        d.vals[k] = vals[k];
        k = k + 1;
    }
    d.nvals = total;
    if !jpeg_huff_canonical(bits, d) {
        return;
    }
    jpeg_huff_fill_fast(bits, d);
}

// ============================================================
// Huffman 编码表（编码侧；规范码，不做码长优化）
// ============================================================

// 一张 Huffman 编码表：BITS + 每个符号的（码字, 码长）。
// 码字**低位对齐**：写位时取低 `size` 位即可。
export struct JpegHuffEncoder {
    bits: [u8: 16],            // 长度 1..16 的码字个数（直接写进 DHT）
    code: [u16: 256],          // 符号 → 码字（低位对齐）
    size: [u8: 256],           // 符号 → 码长（0 = 该符号不在表里）
}

// 从 BITS/HUFFVAL 装配编码表（与 jpeg_huff_build 同一套规范码规则）。
// 参数：
// - bits: 16 项码长计数。
// - vals: 符号表。
// - e: 输出编码表（调用方分配，本函数整体重写）。
// 返回：
// - 无。表里没覆盖的符号 size 为 0，编码侧据此报告内部错误。
export fn jpeg_huff_encoder_build(bits: &const u8, vals: &const u8,
                                  e: &JpegHuffEncoder) void {
    var i: usize = 0;
    while i < 256 {
        e.code[i] = 0 as u16;
        e.size[i] = 0 as u8;
        i = i + 1;
    }
    i = 0;
    while i < 16 {
        e.bits[i] = bits[i];
        i = i + 1;
    }
    var code: u32 = 0;
    var si: usize = 0;
    var len: i32 = 1;
    while len <= JPEG_HUFF_MAX_BITS {
        const cnt: i32 = bits[(len - 1) as usize] as i32;
        var j: i32 = 0;
        while j < cnt {
            const sym: usize = vals[si] as usize;
            e.code[sym] = code as u16;
            e.size[sym] = len as u8;
            si = si + 1;
            code = code + 1;
            j = j + 1;
        }
        code = code << 1;
        len = len + 1;
    }
}

// 标准表 → 编码表（亮度/色度 DC/AC 四张）。
// 参数：
// - tbl: 0 = 亮度 DC，1 = 亮度 AC，2 = 色度 DC，3 = 色度 AC。
// - e: 输出编码表。
// 返回：
// - 无。tbl 越界按 0 处理。
export fn jpeg_std_encoder(tbl: i32, e: &JpegHuffEncoder) void {
    if tbl == 1 {
        jpeg_huff_encoder_build(&JPEG_BITS_AC_LUMA[0],
            &JPEG_VALS_AC_LUMA[0], e);
        return;
    }
    if tbl == 2 {
        jpeg_huff_encoder_build(&JPEG_BITS_DC_CHROMA[0],
            &JPEG_VALS_DC_CHROMA[0], e);
        return;
    }
    if tbl == 3 {
        jpeg_huff_encoder_build(&JPEG_BITS_AC_CHROMA[0],
            &JPEG_VALS_AC_CHROMA[0], e);
        return;
    }
    jpeg_huff_encoder_build(&JPEG_BITS_DC_LUMA[0], &JPEG_VALS_DC_LUMA[0],
        e);
}

// 标准表 → 译码表（编码侧自测与「读回自己写的码流」用）。
// 参数：
// - tbl: 0 = 亮度 DC，1 = 亮度 AC，2 = 色度 DC，3 = 色度 AC。
// - d: 输出译码表。
// 返回：
// - 无。tbl 越界按 0 处理。
export fn jpeg_std_decoder(tbl: i32, d: &JpegHuffDecoder) void {
    if tbl == 1 {
        jpeg_huff_build(&JPEG_BITS_AC_LUMA[0], &JPEG_VALS_AC_LUMA[0], d);
        return;
    }
    if tbl == 2 {
        jpeg_huff_build(&JPEG_BITS_DC_CHROMA[0], &JPEG_VALS_DC_CHROMA[0], d);
        return;
    }
    if tbl == 3 {
        jpeg_huff_build(&JPEG_BITS_AC_CHROMA[0], &JPEG_VALS_AC_CHROMA[0], d);
        return;
    }
    jpeg_huff_build(&JPEG_BITS_DC_LUMA[0], &JPEG_VALS_DC_LUMA[0], d);
}

// 标准 BITS/HUFFVAL 的只读引用（写 DHT 段用）。
// 参数：
// - tbl: 0 = 亮度 DC，1 = 亮度 AC，2 = 色度 DC，3 = 色度 AC。
// - bits_out: 接收 16 项 BITS。
// - vals_out: 接收 HUFFVAL（数组必须够长：DC 12 项、AC 162 项）。
// - n_out: 接收 HUFFVAL 的实际长度。
// 返回：
// - 无。tbl 越界按 0 处理。
export fn jpeg_std_huffval(tbl: i32, bits_out: &u8, vals_out: &u8,
                           n_out: &usize) void {
    var t: i32 = tbl;
    if t < 0 || t > 3 {
        t = 0;
    }
    var src_bits: &const u8 = &JPEG_BITS_DC_LUMA[0];
    var src_vals: &const u8 = &JPEG_VALS_DC_LUMA[0];
    var n: usize = 12 as usize;
    if t == 1 {
        src_bits = &JPEG_BITS_AC_LUMA[0];
        src_vals = &JPEG_VALS_AC_LUMA[0];
        n = 162 as usize;
    } else if t == 2 {
        src_bits = &JPEG_BITS_DC_CHROMA[0];
        src_vals = &JPEG_VALS_DC_CHROMA[0];
    } else if t == 3 {
        src_bits = &JPEG_BITS_AC_CHROMA[0];
        src_vals = &JPEG_VALS_AC_CHROMA[0];
        n = 162 as usize;
    }
    var i: usize = 0;
    while i < 16 {
        bits_out[i] = src_bits[i];
        i = i + 1;
    }
    i = 0;
    while i < n {
        vals_out[i] = src_vals[i];
        i = i + 1;
    }
    n_out[0] = n;
}
