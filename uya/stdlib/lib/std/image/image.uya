// lib/std/image/image.uya - 内存位图（JPEG 解码结果 / 编码输入）
//
// 模块路径：use std.image.image

use std.mem.allocator.IAllocator;

error ImageBadSize;
error ImageBadChannels;
error ImageOutOfBounds;

// 通道数：1 = 灰度，3 = RGB（顺序固定 R,G,B）。
export const IMAGE_GRAY: i32 = 1;
export const IMAGE_RGB: i32 = 3;

// 单张位图的上限（宽 / 高各自的绝对值）。
// 定这个数是为了让 w*h*通道 恒不溢出 i32：46341*46341 已经超过 2^31，
// 所以取 32767（32767*32767*3 ≈ 3.2e9 仍然超 i32，所以下面每个中间量都走
// usize —— 上界检查保证乘法结果落在 usize 能表示的范围内）。
export const IMAGE_MAX_DIM: i32 = 32767;

// 内存位图：**行优先、无填充**，每像素 channels 个字节（灰度 1、RGB 3）。
// pixels 由 allocator 一次分配（大小 = width*height*channels），
// image_free 之后不得再用。
//
// 像素类型是 `&u8` 而**不是** `&byte`：`byte` 在 Uya 里是**独立的**类型
// （不是 u8 别名），`b[i]` 读出来是 byte，要进算术/查表每次都得 `as! u8`。
// 编解码器的热循环里那是每像素一次的转换，所以缓冲一次转好（`p as &u8`
// 是同一块内存的重解释，零成本），对外仍用 `&byte` 交接。
export struct Image {
    width: i32,
    height: i32,
    channels: i32,
    pixels: &u8,
    allocator: IAllocator,
}

// `&byte` → `&u8`（同一块内存的重解释，不复制）。
// 调用方负责长度：这里只看指针，字节数由 width/height/channels 推。
export fn image_pixels_as_u8(raw: &byte) &u8 {
    return raw as &u8;
}

// `&u8` → `&byte`（反向重解释，交给只认 byte 的 API）。
export fn image_pixels_as_byte(px: &u8) &byte {
    return px as &byte;
}

// 空位图：宽高与通道全 0、pixels = null（**不是**合法图像，只用于初始化局部变量
// 或表示「还没解出来」）。判断合法性用 image_valid，别只看 pixels。
fn image_blank() Image {
    var z: Image = Image{
        width: 0,
        height: 0,
        channels: 0,
        pixels: null,
        allocator: null,
    };
    return z;
}

/// 判断位图是否可用（宽高 > 0、通道是 1 或 3、像素缓冲非空）。
/// 参数：
/// - img: 待检查的位图。
/// 返回：
/// - ok: true 表示可以安全读写像素。
fn image_valid(img: &const Image) bool {
    if img.pixels == null {
        return false;
    }
    if img.width <= 0 || img.height <= 0 {
        return false;
    }
    if img.channels != IMAGE_GRAY && img.channels != IMAGE_RGB {
        return false;
    }
    if img.width > IMAGE_MAX_DIM || img.height > IMAGE_MAX_DIM {
        return false;
    }
    return true;
}

/// 像素缓冲需要的字节数（非法尺寸返回 0）。
/// 参数：
/// - width: 宽（像素）。
/// - height: 高（像素）。
/// - channels: 通道数（1 或 3）。
/// 返回：
/// - 字节数；尺寸/通道非法时为 0。
export fn image_bytes_for(width: i32, height: i32, channels: i32) usize {
    if width <= 0 || height <= 0 || width > IMAGE_MAX_DIM {
        return 0 as usize;
    }
    if height > IMAGE_MAX_DIM {
        return 0 as usize;
    }
    if channels != IMAGE_GRAY && channels != IMAGE_RGB {
        return 0 as usize;
    }
    const w: usize = width as usize;
    const h: usize = height as usize;
    const c: usize = channels as usize;
    return w * h * c;
}

/// 分配一张 width*height 的位图，像素全部清零。
/// 参数：
/// - width: 宽（像素，1..IMAGE_MAX_DIM）。
/// - height: 高（像素，1..IMAGE_MAX_DIM）。
/// - channels: 通道数（1 灰度 / 3 RGB）。
/// - alloc: 像素缓冲的分配器（image_free 时用同一个释放）。
/// 返回：
/// - ok: 已清零的位图，pixels 由 alloc 分配。
/// - error: 尺寸或通道非法（ImageBadSize/ImageBadChannels）、分配失败。
export fn image_new(width: i32, height: i32, channels: i32,
                    alloc: IAllocator) !Image {
    const need: usize = image_bytes_for(width, height, channels);
    if need == 0 as usize {
        if channels != IMAGE_GRAY && channels != IMAGE_RGB {
            return error.ImageBadChannels;
        }
        return error.ImageBadSize;
    }
    const raw: &byte = try alloc.alloc(need);
    const px: &u8 = raw as &u8;
    var i: usize = 0;
    while i < need {
        px[i] = 0 as u8;
        i = i + 1;
    }
    var img: Image = Image{
        width: width,
        height: height,
        channels: channels,
        pixels: px,
        allocator: alloc,
    };
    return img;
}

/// 释放位图像素缓冲，并把结构体复位成 image_blank（重复调用安全）。
/// 参数：
/// - img: 待释放的位图。
/// 返回：
/// - 无。
export fn image_free(img: &Image) void {
    if img.pixels != null {
        img.allocator.dealloc(img.pixels as &byte);
    }
    img.pixels = null;
    img.width = 0;
    img.height = 0;
    img.channels = 0;
}

// 像素偏移：已确认 (x,y,c) 在界内时用它，避免调用方重复算乘法。
// 走 usize（IMAGE_MAX_DIM 的上界检查保证不溢出）。
fn image_off(img: &const Image, x: i32, y: i32, c: i32) usize {
    const w: usize = img.width as usize;
    const xa: usize = x as usize;
    const ya: usize = y as usize;
    const ca: usize = c as usize;
    const ch: usize = img.channels as usize;
    return (ya * w + xa) * ch + ca;
}

/// 读一个像素分量。
/// 参数：
/// - img: 位图（必须合法）。
/// - x: 列号（0 起）。
/// - y: 行号（0 起）。
/// - c: 分量号（灰度恒为 0；RGB 为 0/1/2）。
/// 返回：
/// - ok: 该分量的值。
/// - error: 位图非法或坐标越界（ImageOutOfBounds）。
export fn image_get(img: &const Image, x: i32, y: i32, c: i32) !u8 {
    if x < 0 || y < 0 || x >= img.width || y >= img.height {
        return error.ImageOutOfBounds;
    }
    if c < 0 || c >= img.channels {
        return error.ImageOutOfBounds;
    }
    const off: usize = image_off(img, x, y, c);
    return img.pixels[off];
}

/// 写一个像素分量。
/// 参数：
/// - img: 位图（必须合法，且是可写内存）。
/// - x: 列号（0 起）。
/// - y: 行号（0 起）。
/// - c: 分量号（灰度恒为 0；RGB 为 0/1/2）。
/// - v: 要写入的值。
/// 返回：
/// - ok: 写入成功。
/// - error: 位图非法或坐标越界（ImageOutOfBounds）。
export fn image_set(img: &Image, x: i32, y: i32, c: i32, v: u8) !void {
    if x < 0 || y < 0 || x >= img.width || y >= img.height {
        return error.ImageOutOfBounds;
    }
    if c < 0 || c >= img.channels {
        return error.ImageOutOfBounds;
    }
    const off: usize = image_off(img, x, y, c);
    img.pixels[off] = v;
}

/// 把整张图的所有分量填成同一个值（常见用途：填 0 = 黑、填 255 = 白）。
/// 参数：
/// - img: 位图（必须合法）。
/// - v: 填充值。
/// 返回：
/// - 无。
export fn image_fill(img: &Image, v: u8) void {
    if !image_valid(img) {
        return;
    }
    const need: usize = image_bytes_for(img.width, img.height, img.channels);
    var i: usize = 0;
    while i < need {
        img.pixels[i] = v;
        i = i + 1;
    }
}

/// 判断位图是否可用（image_valid 的导出包装）。
/// 参数：
/// - img: 待检查的位图。
/// 返回：
/// - true 表示宽高与通道合法、像素缓冲非空。
export fn image_is_valid(img: &const Image) bool {
    return image_valid(img);
}

/// 造一张空位图（宽高与通道 0、pixels = null）。
/// 参数：
/// - 无。
/// 返回：
/// - 空位图；交给 image_new 之前不得读写像素。
export fn image_empty() Image {
    return image_blank();
}
