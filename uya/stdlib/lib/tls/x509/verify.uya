// lib/tls/x509/verify.uya - X.509 证书验证（最小子集：RSA 签名、自签验证）

use tls.common;
use tls.x509.cert;
use tls.x509.cert.cert_check_validity;
use tls.crypto.sha256;
use tls.crypto.rsa;
use tls.base.mpi;
use tls.x509.asn1;
use tls.crypto.ec_p256;
use tls.crypto.ec_p384;
use tls.crypto.sha384;

const VERIFY_SHA256_LEN: usize = 32;
const TBS_MAX_COPY: usize = 4096;

// keyUsage 位掩码（按 RFC 5280，比特从高位开始）
export const KU_DIGITAL_SIGNATURE: u16 = 0x80;
export const KU_KEY_ENCIPHERMENT: u16 = 0x20;
export const KU_KEY_CERT_SIGN: u16 = 0x04;

// 使用 signer 的 RSA 公钥验证 cert 的签名（TBSCertificate 的 SHA-256 + PKCS#1 v1.5）
// ECDSA 的 DER 签名 = SEQUENCE { r INTEGER, s INTEGER }，转成两个 32 字节大端数
fn cert_sig_pad32(src: &const byte, src_len: usize, out: &byte) bool {
    var start: usize = 0;
    while start < src_len && src[start] == 0 as byte {
        start = start + 1;
    }
    const n: usize = src_len - start;
    if n > 32 {
        return false;
    }
    var i: usize = 0;
    while i < 32 {
        out[i] = 0 as byte;
        i = i + 1;
    }
    var k: usize = 0;
    while k < n {
        out[32 - n + k] = src[start + k];
        k = k + 1;
    }
    return true;
}

fn cert_sig_pad_n(src: &const byte, src_len: usize, out: &byte, out_len: usize) bool {
    var start: usize = 0;
    while start < src_len && src[start] == 0 as byte {
        start = start + 1;
    }
    const n: usize = src_len - start;
    if n > out_len {
        return false;
    }
    var i: usize = 0;
    while i < out_len {
        out[i] = 0 as byte;
        i = i + 1;
    }
    var k: usize = 0;
    while k < n {
        out[out_len - n + k] = src[start + k];
        k = k + 1;
    }
    return true;
}

// 按目标长度 n（32=P-256，48=P-384）解析 DER 的 (r, s)
fn cert_ecdsa_sig_parts_n(cert: &const Cert, r: &byte, s: &byte, n: usize) bool {
    var rd: Asn1Reader = Asn1Reader{ data: &cert.sig[0], len: cert.sig_len, pos: 0 };
    var seq_len: usize = 0;
    if !asn1_get_tlv_to(&rd, ASN1_TAG_SEQUENCE, &seq_len) {
        return false;
    }
    var rb: [byte: 56] = [0: 56];
    var rl: usize = 0;
    asn1_get_integer_to(&rd, &rb[0], 56, &rl) catch { return false; };
    var sb: [byte: 56] = [0: 56];
    var sl: usize = 0;
    asn1_get_integer_to(&rd, &sb[0], 56, &sl) catch { return false; };
    if !cert_sig_pad_n(&rb[0], rl, r, n) {
        return false;
    }
    return cert_sig_pad_n(&sb[0], sl, s, n);
}

fn cert_ecdsa_sig_parts(cert: &const Cert, r32: &byte, s32: &byte) bool {
    var r: Asn1Reader = Asn1Reader{ data: &cert.sig[0], len: cert.sig_len, pos: 0 };
    var seq_len: usize = 0;
    if !asn1_get_tlv_to(&r, ASN1_TAG_SEQUENCE, &seq_len) {
        return false;
    }
    var rb: [byte: 40] = [0: 40];
    var rl: usize = 0;
    asn1_get_integer_to(&r, &rb[0], 40, &rl) catch { return false; };
    var sb: [byte: 40] = [0: 40];
    var sl: usize = 0;
    asn1_get_integer_to(&r, &sb[0], 40, &sl) catch { return false; };
    if !cert_sig_pad32(&rb[0], rl, r32) {
        return false;
    }
    return cert_sig_pad32(&sb[0], sl, s32);
}

fn cert_tbs_sha256(cert: &const Cert, hash: &byte) !void {
    if cert.tbs_tlv_len == 0 || cert.tbs_tlv_len > TBS_MAX_COPY {
        return error.TlsBadInput;
    }
    if cert.tbs_offset + cert.tbs_tlv_len > cert.der_len {
        return error.TlsBadInput;
    }
    var tbs_buf: [byte: TBS_MAX_COPY] = [0:TBS_MAX_COPY];
    var i: usize = 0;
    while i < cert.tbs_tlv_len {
        tbs_buf[i] = cert.der[cert.tbs_offset + i];
        i = i + 1;
    }
    sha256(&tbs_buf[0], cert.tbs_tlv_len, hash);
}

// 用 signer 的公钥验证 cert 的签名：RSA 走 PKCS#1 v1.5 + SHA-256，
// EC 走 ECDSA-P256 + SHA-256（现代站点普遍是后者）。
export fn cert_verify_signature(cert: &const Cert, signer: &const Cert) !void {
    if signer.pub_kind == 2 || signer.pub_kind == 3 {
        // P-256 配 SHA-256、P-384 配 SHA-384
        var hlen: usize = 48;
        if signer.pub_kind == 2 {
            hlen = 32;
        }
        if signer.pub_kind == 2 && signer.ec_pub_len != 65 {
            return error.TlsBadInput;
        }
        if signer.pub_kind == 3 && signer.ec_pub_len != 97 {
            return error.TlsBadInput;
        }
        if cert.tbs_tlv_len == 0 || cert.tbs_tlv_len > TBS_MAX_COPY {
            return error.TlsBadInput;
        }
        if cert.tbs_offset + cert.tbs_tlv_len > cert.der_len {
            return error.TlsBadInput;
        }
        var tbs_buf: [byte: TBS_MAX_COPY] = [0:TBS_MAX_COPY];
        var bi: usize = 0;
        while bi < cert.tbs_tlv_len {
            tbs_buf[bi] = cert.der[cert.tbs_offset + bi];
            bi = bi + 1;
        }
        var hash_ec: [byte: 48] = [0: 48];
        if hlen == 32 {
            sha256(&tbs_buf[0], cert.tbs_tlv_len, &hash_ec[0]);
        } else {
            sha384(&tbs_buf[0], cert.tbs_tlv_len, &hash_ec[0]);
        }
        var rb: [byte: 48] = [0: 48];
        var sb: [byte: 48] = [0: 48];
        if !cert_ecdsa_sig_parts_n(cert, &rb[0], &sb[0], hlen) {
            return error.TlsBadInput;
        }
        var rc: i32 = -1;
        if hlen == 32 {
            var r32: [byte: 32] = [0: 32];
            var s32: [byte: 32] = [0: 32];
            var k: usize = 0;
            while k < 32 {
                r32[k] = rb[k];
                s32[k] = sb[k];
                k = k + 1;
            }
            rc = ec_p256_ecdsa_verify(&signer.ec_pub[0], &hash_ec[0],
                &r32[0], &s32[0]);
        } else {
            rc = ec_p384_ecdsa_verify(&signer.ec_pub[0], &hash_ec[0],
                &rb[0], &sb[0]);
        }
        if rc != 0 {
            return error.TlsInvalidMac;
        }
        return;
    }
    if signer.rsa_n_len == 0 || signer.rsa_e_len == 0 {
        return error.TlsBadInput;
    }
    if cert.tbs_tlv_len == 0 || cert.tbs_offset + cert.tbs_tlv_len > cert.der_len {
        return error.TlsBadInput;
    }
    if cert.tbs_tlv_len > TBS_MAX_COPY {
        return error.TlsBadInput;
    }
    var tbs_buf: [byte: TBS_MAX_COPY] = [0:TBS_MAX_COPY];
    var i: usize = 0;
    while i < cert.tbs_tlv_len {
        tbs_buf[i] = cert.der[cert.tbs_offset + i];
        i = i + 1;
    }
    var hash: [byte: VERIFY_SHA256_LEN] = [0:VERIFY_SHA256_LEN];
    sha256(&tbs_buf[0], cert.tbs_tlv_len, &hash[0]);
    var n_mpi: Mpi = Mpi{};
    var e_mpi: Mpi = Mpi{};
    mpi_from_bytes_be(&n_mpi, &signer.rsa_n[0], signer.rsa_n_len) catch {
        return error.TlsBadInput;
    };
    mpi_from_bytes_be(&e_mpi, &signer.rsa_e[0], signer.rsa_e_len) catch {
        return error.TlsBadInput;
    };
    rsa_verify_pkcs1_v15_sha256(&n_mpi, &e_mpi, &hash[0], VERIFY_SHA256_LEN, &cert.sig[0], cert.sig_len) catch {
        return error.TlsInvalidMac;
    };
}

// 自签名证书：用自身公钥验证自身签名
export fn cert_verify_self(cert: &const Cert) !void {
    cert_verify_signature(cert, cert) catch {
        return error.TlsInvalidMac;
    };
}

fn cert_same_rsa_key(a: &const Cert, b: &const Cert) bool {
    if a.pub_kind == 2 || b.pub_kind == 2 {
        if a.pub_kind != 2 || b.pub_kind != 2 {
            return false;
        }
        if a.ec_pub_len != b.ec_pub_len || a.ec_pub_len == 0 {
            return false;
        }
        var e: usize = 0;
        while e < a.ec_pub_len {
            if a.ec_pub[e] != b.ec_pub[e] {
                return false;
            }
            e = e + 1;
        }
        return true;
    }
    if a.rsa_n_len == 0 || b.rsa_n_len == 0 {
        return false;
    }
    if a.rsa_e_len == 0 || b.rsa_e_len == 0 {
        return false;
    }
    if a.rsa_n_len != b.rsa_n_len {
        return false;
    }
    if a.rsa_e_len != b.rsa_e_len {
        return false;
    }
    if a.rsa_n_len > 512 || b.rsa_n_len > 512 {
        return false;
    }
    if a.rsa_e_len > 8 || b.rsa_e_len > 8 {
        return false;
    }
    var i: usize = 0;
    while i < 512 {
        if i >= a.rsa_n_len {
            break;
        }
        if a.rsa_n[i] != b.rsa_n[i] {
            return false;
        }
        i = i + 1;
    }
    var j: usize = 0;
    while j < 8 {
        if j >= a.rsa_e_len {
            break;
        }
        if a.rsa_e[j] != b.rsa_e[j] {
            return false;
        }
        j = j + 1;
    }
    return true;
}

fn cert_is_ca_for_chain(cert: &const Cert) bool {
    if !cert.has_basic_constraints || !cert.is_ca {
        return false;
    }
    if cert.has_key_usage {
        if (cert.key_usage_bits & KU_KEY_CERT_SIGN) == (0 as u16) {
            return false;
        }
    }
    return true;
}

// RSA-only 证书链验证（不含主机名）：leaf → chain[0..chain_len-1] → trust_anchors
// required_leaf_ku 为 0 时不检查叶子 keyUsage。


export fn verify_chain_rsa(
    leaf: &const Cert,
    chain: &const Cert,
    chain_len: usize,
    trust_anchors: &const Cert,
    trust_len: usize,
    required_leaf_ku: u16,
) !void {

    if trust_len == 0 {
        return error.TlsBadInput;
    }
    if leaf.pub_kind == 0 {
        return error.TlsBadInput;
    }
    var leaf_copy: Cert = leaf[0];
    cert_check_validity(&leaf_copy) catch {
        return error.TlsHandshakeFailure;
    };

    // 沿对端给的链逐级验签；遇到"不是 CA 的证书"就停（有些服务器会在链尾附带
    // 额外证书）。真正的信任判断交给下一步：由信任锚直接验签。
    // 之前这里只比"顶端公钥 == 锚公钥"、而且要求每一级都是 CA，真实站点两者都不满足
    // ⇒ 校验证书的 HTTPS 永远握手失败。
    var top: &const Cert = leaf;
    var i: usize = 0;
    while i < chain_len {
        var parent: &const Cert = &chain[i];
        if !cert_is_ca_for_chain(parent) {
            break;
        }
        var parent_copy: Cert = parent[0];
        cert_check_validity(&parent_copy) catch {
            return error.TlsHandshakeFailure;
        };
        if parent.pub_kind == 0 {
            return error.TlsBadInput;
        }
        cert_verify_signature(top, parent) catch {
            return error.TlsHandshakeFailure;
        };
        top = parent;
        i = i + 1;
    }

    // 顶端证书要能被某个信任锚验签（或本身与锚公钥相同）
    var found: bool = false;
    var k: usize = 0;
    while k < trust_len {
        var anchor: &const Cert = &trust_anchors[k];
        if cert_same_rsa_key(top, anchor) {
            found = true;
            break;
        }
        if anchor.pub_kind != 0 {
            cert_verify_signature(top, anchor) catch {
                k = k + 1;
                continue;
            };
            found = true;
            break;
        }
        k = k + 1;
    }
    if !found {
        return error.TlsHandshakeFailure;
    }

    // 叶子用途（keyUsage）检查
    if required_leaf_ku != (0 as u16) && leaf.has_key_usage {
        if (leaf.key_usage_bits & required_leaf_ku) == (0 as u16) {
            return error.TlsHandshakeFailure;
        }
    }
}

fn ascii_lower(b: byte) byte {
    if b >= 65 && b <= 90 {  // 'A' - 'Z'
        return (b + 32) as byte;  // 'a' - 'A' = 32
    }
    return b;
}

fn hostname_eq_case_insensitive(a: &const byte, a_len: usize, b: &const byte, b_len: usize) bool {
    if a_len != b_len {
        return false;
    }
    var i: usize = 0;
    while i < a_len {
        const ca: byte = ascii_lower(a[i]);
        const cb: byte = ascii_lower(b[i]);
        if ca != cb {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn hostname_match_wildcard(pattern: &const byte, pattern_len: usize, hostname: &const byte, hostname_len: usize) bool {
    if pattern_len < 3 {
        return false;
    }
    if pattern[0] != 42 || pattern[1] != 46 {  // '*', '.'
        return false;
    }
    const suffix: &const byte = &pattern[1];
    const suffix_len: usize = pattern_len - 1;
    if hostname_len <= suffix_len {
        return false;
    }
    // hostname 末尾必须与后缀匹配（大小写不敏感）
    var i: usize = 0;
    while i < suffix_len {
        const h_index: usize = hostname_len - suffix_len + i;
        const ch: byte = ascii_lower(hostname[h_index]);
        const cp: byte = ascii_lower(suffix[i]);
        if ch != cp {
            return false;
        }
        i = i + 1;
    }
    const prefix_len: usize = hostname_len - suffix_len;
    if prefix_len == 0 {
        return false;
    }
    // 前缀中不允许再出现 '.'，避免 *.example.com 匹配 foo.bar.example.com
    var j: usize = 0;
    while j < prefix_len {
        if hostname[j] == 46 {  // '.'
            return false;
        }
        j = j + 1;
    }
    return true;
}

// 简化版主机名匹配：支持精确匹配与单个左侧 label wildcard（*.example.com）
export fn hostname_match(pattern: &const byte, pattern_len: usize, hostname: &const byte, hostname_len: usize) bool {
    if pattern_len == 0 || hostname_len == 0 {
        return false;
    }
    var has_wildcard: bool = false;
    var i: usize = 0;
    while i < pattern_len {
        if pattern[i] == 42 {  // '*'
            has_wildcard = true;
            break;
        }
        i = i + 1;
    }
    if !has_wildcard {
        return hostname_eq_case_insensitive(pattern, pattern_len, hostname, hostname_len);
    }
    return hostname_match_wildcard(pattern, pattern_len, hostname, hostname_len);
}

// SAN/CN 与 hostname 比较：若传入 SAN 非空则优先使用 SAN，否则退回到 CN。
// san_dns/cn 可以来自调用方已解析好的 dNSName / CN 字节序列。
export fn verify_hostname_bytes(
    hostname: &const byte,
    hostname_len: usize,
    san_dns: &const byte,
    san_dns_len: usize,
    cn: &const byte,
    cn_len: usize,
) !void {
    if hostname_len == 0 {
        return error.TlsBadInput;
    }
    if san_dns_len > 0 {
        if hostname_match(san_dns, san_dns_len, hostname, hostname_len) {
            return;
        }
        return error.TlsHandshakeFailure;
    }
    if cn_len == 0 {
        return error.TlsHandshakeFailure;
    }
    if hostname_match(cn, cn_len, hostname, hostname_len) {
        return;
    }
    return error.TlsHandshakeFailure;
}
