// drama_plugin/src/bytes.uya — 字节级小工具（P1 骨架）
//
// 为什么手写：`call` 的输出必须是**单行紧凑 JSON**（DESIGN §4.6），
// 用固定缓冲拼字节比通用格式化更可控，也不依赖具体 stdlib 版本。

use libc.syscall;
use libc.unistd;

// C 串长度
export fn b_len(p: &const byte) usize {
    var i: usize = 0;
    while p[i] != 0 as byte {
        i = i + 1;
    }
    return i;
}

// n 字节是否等于 C 串
export fn b_eq(p: &const byte, n: usize, q: &const byte) bool {
    const qn: usize = b_len(q);
    if n != qn {
        return false;
    }
    var i: usize = 0;
    while i < n {
        if p[i] != q[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 前缀判断（命令行解析用）
export fn b_starts(p: &const byte, n: usize, want: &const byte) bool {
    const wn: usize = b_len(want);
    if n < wn {
        return false;
    }
    var i: usize = 0;
    while i < wn {
        if p[i] != want[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 写满 fd（短写要接着写）
export fn fd_write_all(fd: i32, p: &const byte, n: usize) bool {
    var off: usize = 0;
    while off < n {
        const w: isize = sys_write(fd, &p[off], n - off) catch { -1 as isize; };
        if w <= 0 {
            return false;
        }
        off = off + (w as usize);
    }
    return true;
}

export fn say(p: &const byte) void {
    _ = fd_write_all(1, p, b_len(p));
}

export fn say_err(p: &const byte) void {
    _ = fd_write_all(2, p, b_len(p));
}

export fn put_byte(fd: i32, c: byte) void {
    var one: [byte: 1] = [c];
    _ = fd_write_all(fd, &one[0], 1);
}

// 十进制输出（负数带 '-'）
export fn put_i64(fd: i32, v: i64) void {
    var x: i64 = v;
    if x == 0 {
        put_byte(fd, 48 as byte);
        return;
    }
    if x < 0 {
        put_byte(fd, 45 as byte);
        x = 0 -| x;
    }
    var tmp: [byte: 24] = [0: 24];
    var n: usize = 0;
    while x > 0 {
        const t10: i64 = (x / 10) *| 10;
        const rem: i64 = x -| t10;
        tmp[n] = (rem +| 48) as! byte catch { 48 as byte; };
        n = n + 1;
        x = x / 10;
    }
    while n > 0 {
        n = n - 1;
        put_byte(fd, tmp[n]);
    }
}

export fn say_num(prefix: &const byte, v: i64) void {
    say(prefix);
    put_i64(1, v);
    say("\n" as &const byte);
}

// FNV-1a 64：仅用于"能比较、可复现"的 input_hash（正式实现换 sha256）
export fn fnv64(p: &const byte, n: usize) u64 {
    var h: u64 = 14695981039346656037;
    var i: usize = 0;
    while i < n {
        const b: u64 = p[i] as u64;
        const x: u64 = h ^ b;
        h = x *% (1099511628211 as u64);
        i = i + 1;
    }
    return h;
}

export fn put_hex64(fd: i32, v: u64) void {
    const hexd: &const byte = "0123456789abcdef" as &const byte;
    var i: i32 = 15;
    while i >= 0 {
        const sh: i32 = i * 4;
        const nib: u64 = (v >> sh) & (15 as u64);
        put_byte(fd, hexd[nib as! usize catch { 0 as usize; }]);
        i = i - 1;
    }
}

// 把 p[0:n] 拷进固定缓冲（带边界检查，留一个 NUL 位）
export fn copy_to(p: &const byte, n: usize, out: &[byte],
    out_len: &usize) bool {
    if n + 1 > out.len {
        return false;
    }
    var i: usize = 0;
    while i < n {
        out[i] = p[i];
        i = i + 1;
    }
    out[n] = 0 as byte;
    out_len[0] = n;
    return true;
}
