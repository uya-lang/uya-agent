// PipelineProvider：把既有产线（lint_shots / run_shots / check_join / qc /
// cards / build_film）当 VideoProvider 用。子进程壳，白名单入口，退出码 +
// 日志尾部 + 已知产物回给调用方。产线勘定见 docs/DRAMA_PROVIDER.md。

// pipeline_root 必须是绝对路径，episode 是它下面的相对目录，两段都不许含
// ".."、不许有 shell 元字符（命令还是要 quote，但先挡掉明显越界）。
fn pl_safe(p: &const byte, n: usize) bool {
    if n == 0 || n >= 500 {
        return false;
    }
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c == 0 as byte || c == 59 as byte || c == 124 as byte
            || c == 38 as byte || c == 36 as byte || c == 96 as byte
            || c == 10 as byte || c == 13 as byte || c == 34 as byte
            || c == 39 as byte || c == 92 as byte {
            return false;
        }
        if c == 46 as byte && i + 1 < n && p[i + 1] == 46 as byte {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 布尔字段（JSON true/false，不能当整数读）
fn pl_true(buf: &const byte, n: usize, key: &const byte) bool {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte || ln[0] < 4 {
        return false;
    }
    return buf[st[0]] == 116 as byte;
}

fn pl_abs(p: &const byte, n: usize) bool {
    return n > 1 && p[0] == 47 as byte;
}

// 入口白名单 → 真正要跑的命令尾巴（不含 python3 与脚本名）
// 返回 false 表示不认识的入口
fn pl_entry(entry: &const byte, en: usize, shot: i64, dry: bool,
    force: bool, out: &[byte], out_len: &usize) bool {
    out_len[0] = 0;
    var w: usize = 0;
    if b_eq(entry, en, "lint" as &const byte) {
        w = w + j_put(out, w, "lint_shots.py" as &const byte);
    } else if b_eq(entry, en, "generate" as &const byte) {
        w = w + j_put(out, w, "run_shots.py" as &const byte);
        if dry {
            w = w + j_put(out, w, " --dry" as &const byte);
        } else if shot > 0 {
            w = w + j_put(out, w, " " as &const byte);
            w = w + j_put_i64(out, w, shot);
        }
    } else if b_eq(entry, en, "join" as &const byte) {
        w = w + j_put(out, w, "check_join.py" as &const byte);
    } else if b_eq(entry, en, "asr" as &const byte) {
        w = w + j_put(out, w, "qc.py asr" as &const byte);
        if shot > 0 {
            w = w + j_put(out, w, " " as &const byte);
            w = w + j_put_i64(out, w, shot);
        }
    } else if b_eq(entry, en, "vision" as &const byte) {
        w = w + j_put(out, w, "qc.py vision" as &const byte);
        if shot > 0 {
            w = w + j_put(out, w, " " as &const byte);
            w = w + j_put_i64(out, w, shot);
        }
    } else if b_eq(entry, en, "continuity" as &const byte) {
        w = w + j_put(out, w, "qc.py continuity" as &const byte);
    } else if b_eq(entry, en, "cards" as &const byte) {
        w = w + j_put(out, w, "cards.py" as &const byte);
    } else if b_eq(entry, en, "build" as &const byte) {
        w = w + j_put(out, w, "build_film.py" as &const byte);
        if dry {
            w = w + j_put(out, w, " --dry" as &const byte);
        }
    } else if b_eq(entry, en, "final" as &const byte) {
        w = w + j_put(out, w, "qc.py final" as &const byte);
    } else {
        return false;
    }
    out_len[0] = w;
    return w + 600 < 2048;
}

// 只读文件尾部 cap 字节（产线日志可能很大，不能整份读进来）
fn read_tail(path: &const byte, cap: usize, buf: &byte, n: usize,
    out_len: &usize) bool {
    out_len[0] = 0;
    const fd: i32 = sys_open(path, 0 as i32, 0) catch {
        return false;
    };
    const end: i64 = sys_lseek(fd, 0 as i64, 2 as i32) catch {
        -1 as i64;
    };
    if end <= 0 {
        _ = sys_close(fd) catch { 0 as i32; };
        return false;
    }
    var want: i64 = n as i64;
    if end < want {
        want = end;
    }
    const off: i64 = end - want;
    _ = sys_lseek(fd, off, 0 as i32) catch {
        _ = sys_close(fd) catch { 0 as i32; };
        return false;
    };
    var total: usize = 0;
    while total < cap && total < n {
        const got: isize = sys_read(fd, &buf[total], n - total) catch {
            break;
        };
        if got <= 0 {
            break;
        }
        total = total + (got as usize);
    }
    _ = sys_close(fd) catch { 0 as i32; };
    out_len[0] = total;
    return total > 0;
}

// shots/shotNN/shotNN<.mp4|/last.png|/done.json>；k=0/1/2
fn pl_shot_rel(out: &[byte], shot: i64, k: usize) usize {
    var w: usize = 0;
    w = w + j_put(out, w, "shots/shot" as &const byte);
    if shot < 10 {
        w = w + j_put(out, w, "0" as &const byte);
    }
    w = w + j_put_i64(out, w, shot);
    if k == 0 {
        w = w + j_put(out, w, "/shot" as &const byte);
        if shot < 10 {
            w = w + j_put(out, w, "0" as &const byte);
        }
        w = w + j_put_i64(out, w, shot);
        w = w + j_put(out, w, ".mp4" as &const byte);
    } else if k == 1 {
        w = w + j_put(out, w, "/last.png" as &const byte);
    } else {
        w = w + j_put(out, w, "/done.json" as &const byte);
    }
    return w;
}

// 跑一条入口：cd <root>/<episode>/scripts && timeout N [FORCE=1] python3 <cmd>
// 日志落到 <root>/<episode>/.pipeline_<entry>.log，只回尾部 600 字节。
export fn op_pipeline_run(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    var root: [byte: 400] = [0: 400];
    var rl: [usize: 1] = [0];
    var ep: [byte: 200] = [0: 200];
    var el: [usize: 1] = [0];
    var entry: [byte: 20] = [0: 20];
    var en: [usize: 1] = [0];
    if !input_str(line, n, "pipeline_root" as &const byte, &root[0: 400],
        &rl[0])
        || !input_str(line, n, "episode" as &const byte, &ep[0: 200],
            &el[0])
        || !input_str(line, n, "entry" as &const byte, &entry[0: 20],
            &en[0]) {
        return 13;
    }
    if !pl_abs(&root[0], rl[0]) || !pl_safe(&root[0], rl[0])
        || !pl_safe(&ep[0], el[0]) || ep[0] == 47 as byte {
        return 13;
    }
    const shot: i64 = int_arg(line, n, "shot" as &const byte, 0);
    const dry: bool = pl_true(line, n, "dry" as &const byte);
    const force: bool = pl_true(line, n, "force" as &const byte);
    var to: i64 = int_arg(line, n, "timeout_s" as &const byte, 1800);
    if to <= 0 || to > 7200 {
        to = 1800;
    }
    var cmd1: [byte: 600] = [0: 600];
    var c1: [usize: 1] = [0];
    if !pl_entry(&entry[0], en[0], shot, dry, force, &cmd1[0: 600],
        &c1[0]) {
        return 13;
    }
    // 目录：<root>/<episode>
    var dir: [byte: 700] = [0: 700];
    var dl: [usize: 1] = [0];
    if !path_join(&root[0], rl[0], &ep[0], el[0], &dir[0: 700], &dl[0]) {
        return 13;
    }
    var logp: [byte: 800] = [0: 800];
    var lg: [usize: 1] = [0];
    var logrel: [byte: 120] = [0: 120];
    var lrl: [usize: 1] = [0];
    var w0: usize = 0;
    w0 = w0 + j_put(&logrel[0: 120], w0, ".pipeline_" as &const byte);
    w0 = w0 + j_put_raw(&logrel[0: 120], w0, &entry[0], en[0]);
    w0 = w0 + j_put(&logrel[0: 120], w0, ".log" as &const byte);
    lrl[0] = w0;
    if !path_join(&dir[0], dl[0], &logrel[0], lrl[0], &logp[0: 800],
        &lg[0]) {
        return 13;
    }
    var cmd: [byte: 2048] = [0: 2048];
    var w: usize = 0;
    w = w + j_put(&cmd[0: 2048], w, "cd " as &const byte);
    w = quote_into(&cmd[0: 2048], w, &dir[0], dl[0]);
    w = w + j_put(&cmd[0: 2048], w, "/scripts && " as &const byte);
    if force {
        w = w + j_put(&cmd[0: 2048], w, "FORCE=1 " as &const byte);
    }
    w = w + j_put(&cmd[0: 2048], w, "timeout " as &const byte);
    w = w + j_put_i64(&cmd[0: 2048], w, to);
    w = w + j_put(&cmd[0: 2048], w, " python3 " as &const byte);
    w = w + j_put_raw(&cmd[0: 2048], w, &cmd1[0], c1[0]);
    w = w + j_put(&cmd[0: 2048], w, " >" as &const byte);
    w = quote_into(&cmd[0: 2048], w, &logp[0], lg[0]);
    w = w + j_put(&cmd[0: 2048], w, " 2>&1" as &const byte);
    if w + 1 >= 2048 {
        return 13;
    }
    cmd[w] = 0 as byte;
    const t0: i64 = now_s();
    const st: i32 = system(&cmd[0]);
    const t1: i64 = now_s();
    var code: i64 = ((st >> 8) & 255) as i64;
    if st == -1 {
        code = -1;
    }
    // 日志尾部 600 字节
    var lb: [byte: 600] = [0: 600];
    var lbl: [usize: 1] = [0];
    const has_log: bool = read_tail(&logp[0], lg[0], &lb[0], 600,
        &lbl[0]);
    w = 0;
    w = w + j_put(out, w, "{\"entry\":" as &const byte);
    w = w + j_put_str(out, w, &entry[0], en[0]);
    w = w + j_put(out, w, ",\"exit_code\":" as &const byte);
    w = w + j_put_i64(out, w, code);
    w = w + j_put(out, w, ",\"ok\":" as &const byte);
    if code == 0 {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"seconds\":" as &const byte);
    w = w + j_put_i64(out, w, t1 - t0);
    w = w + j_put(out, w, ",\"log_path\":" as &const byte);
    w = w + j_put_str(out, w, &logrel[0], lrl[0]);
    w = w + j_put(out, w, ",\"log_tail\":" as &const byte);
    if has_log && lbl[0] > 0 {
        w = w + j_put_str(out, w, &lb[0], lbl[0]);
    } else {
        w = w + j_put(out, w, "\"\"" as &const byte);
    }
    // 已知产物：run_shots 的 shotNN（mp4 / last.png / done.json）
    w = w + j_put(out, w, ",\"products\":[" as &const byte);
    var first: bool = true;
    if shot > 0 && b_eq(&entry[0], en[0], "generate" as &const byte) {
        var k: usize = 0;
        while k < 3 {
            var rp: [byte: 128] = [0: 128];
            const rw: usize = pl_shot_rel(&rp[0: 128], shot, k);
            var ap: [byte: 900] = [0: 900];
            var an: [usize: 1] = [0];
            if rw > 0 && path_join(&dir[0], dl[0], &rp[0], rw,
                &ap[0: 900], &an[0]) {
                var stt: Stat = Stat{};
                const src: i32 = sys_stat(&ap[0], &stt) catch {
                    -1 as i32;
                };
                if src == 0 {
                    if !first {
                        w = w + j_put(out, w, "," as &const byte);
                    }
                    first = false;
                    w = w + j_put(out, w, "{\"path\":" as &const byte);
                    w = w + j_put_str(out, w, &rp[0], rw);
                    w = w + j_put(out, w, ",\"bytes\":" as &const byte);
                    w = w + j_put_i64(out, w, stt.st_size);
                    w = w + j_put(out, w, "}" as &const byte);
                }
            }
            k = k + 1;
        }
    }
    w = w + j_put(out, w, "]}" as &const byte);
    out_len[0] = w;
    return 0;
}

// ---- pipeline.capacity：从真实产线日志算产能，再和 DESIGN §0.3 基线比 ----

// 数一段字节里 needle 出现次数
fn pl_count(buf: &const byte, n: usize, needle: &const byte,
    nn: usize) i64 {
    var c: i64 = 0;
    var i: usize = 0;
    while i + nn <= n {
        var k: usize = 0;
        var hit: bool = true;
        while k < nn {
            if buf[i + k] != needle[k] {
                hit = false;
                break;
            }
            k = k + 1;
        }
        if hit {
            c = c +| 1;
            i = i + nn;
        } else {
            i = i + 1;
        }
    }
    return c;
}

// "用时 14.3 分钟" → 14300（毫秒）；找不到回 -1
fn pl_minutes_after(buf: &const byte, n: usize, key: &const byte,
    kn: usize) i64 {
    var i: usize = 0;
    while i + kn < n {
        var k: usize = 0;
        var hit: bool = true;
        while k < kn {
            if buf[i + k] != key[k] {
                hit = false;
                break;
            }
            k = k + 1;
        }
        if hit {
            var j: usize = i + kn;
            var whole: i64 = 0;
            var frac: i64 = 0;
            var digits: i64 = 0;
            var seen_dot: bool = false;
            while j < n {
                const c: byte = buf[j];
                if c >= 48 as byte && c <= 57 as byte {
                    if seen_dot {
                        if digits < 3 {
                            frac = frac *| 10 +| (c - 48 as byte) as i64;
                            digits = digits + 1;
                        }
                    } else {
                        whole = whole *| 10 +| (c - 48 as byte) as i64;
                    }
                    j = j + 1;
                    continue;
                }
                if c == 46 as byte && !seen_dot {
                    seen_dot = true;
                    j = j + 1;
                    continue;
                }
                break;
            }
            if whole == 0 && frac == 0 {
                return -1;
            }
            while digits < 3 {
                frac = frac *| 10;
                digits = digits + 1;
            }
            return whole *| 60000 +| frac *| 60;
        }
        i = i + 1;
    }
    return -1;
}

// 解析全部 "用时 X.Y 分钟"：回条数与总毫秒（逐行扫，不能跨行）
fn pl_sum_minutes(buf: &const byte, n: usize, tot: &[i64: 1],
    cnt: &[i64: 1]) void {
    tot[0] = 0;
    cnt[0] = 0;
    const key: &const byte = "用时 " as &const byte;
    var i: usize = 0;
    while i < n {
        var e: usize = i;
        while e < n && buf[e] != 10 as byte {
            e = e + 1;
        }
        if e > i + 7 {
            const v: i64 = pl_minutes_after(&buf[i], e - i, key, 7);
            if v >= 0 {
                tot[0] = tot[0] +| v;
                cnt[0] = cnt[0] +| 1;
            }
        }
        i = e + 1;
    }
}

// 提交次数里最大的镜号 = 这一集有多少镜
fn pl_max_shot(buf: &const byte, n: usize) i64 {
    const key: &const byte = "shot" as &const byte;
    var best: i64 = 0;
    var i: usize = 0;
    while i + 6 < n {
        if buf[i] == 115 as byte && buf[i + 1] == 104 as byte
            && buf[i + 2] == 111 as byte && buf[i + 3] == 116 as byte {
            var j: usize = i + 4;
            var v: i64 = 0;
            var got: bool = false;
            while j < n && buf[j] >= 48 as byte && buf[j] <= 57 as byte {
                v = v *| 10 +| (buf[j] - 48 as byte) as i64;
                got = true;
                j = j + 1;
            }
            // 只认 "shotN 已提交" 这种
            if got && j + 1 < n && buf[j] == 32 as byte {
                if v > best {
                    best = v;
                }
            }
        }
        i = i + 1;
    }
    return best;
}

// 真实产能：input = {pipeline_root, episode, log(默认 build.log),
//                  target_episodes(默认 100)}
export fn op_pipeline_capacity(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    var root: [byte: 400] = [0: 400];
    var rl: [usize: 1] = [0];
    var ep: [byte: 200] = [0: 200];
    var el: [usize: 1] = [0];
    if !input_str(line, n, "pipeline_root" as &const byte, &root[0: 400],
        &rl[0])
        || !input_str(line, n, "episode" as &const byte, &ep[0: 200],
            &el[0]) {
        return 13;
    }
    if !pl_abs(&root[0], rl[0]) || !pl_safe(&root[0], rl[0])
        || !pl_safe(&ep[0], el[0]) || ep[0] == 47 as byte {
        return 13;
    }
    var logn: [byte: 40] = [0: 40];
    var ln: [usize: 1] = [0];
    if !input_str(line, n, "log" as &const byte, &logn[0: 40], &ln[0]) {
        _ = copy_to("build.log" as &const byte, 9, &logn[0: 40],
            &ln[0]);
    }
    if !pl_safe(&logn[0], ln[0]) {
        return 13;
    }
    var target: i64 = int_arg(line, n, "target_episodes" as &const byte, 100);
    if target <= 0 || target > 10000 {
        target = 100;
    }
    var dir: [byte: 700] = [0: 700];
    var dl: [usize: 1] = [0];
    if !path_join(&root[0], rl[0], &ep[0], el[0], &dir[0: 700], &dl[0]) {
        return 13;
    }
    var ap: [byte: 800] = [0: 800];
    var an: [usize: 1] = [0];
    if !path_join(&dir[0], dl[0], &logn[0], ln[0], &ap[0: 800], &an[0]) {
        return 13;
    }
    var st2: Stat = Stat{};
    const src: i32 = sys_stat(&ap[0], &st2) catch { -1 as i32; };
    if src != 0 {
        return 87;
    }
    var cap: usize = 262144;
    if st2.st_size < 262144 {
        cap = st2.st_size as usize;
    }
    var buf: &byte = malloc(cap + 8) as &byte;
    defer { free(buf as &void); }
    if (buf as usize) == 0 {
        return 91;
    }
    // 空日志不算错：回 measured=false 的全零报告，让调用方自己判断
    var bl: [usize: 1] = [0];
    if cap > 0 {
        const okread: bool = read_tail(&ap[0], an[0], buf, cap, &bl[0]);
        if !okread {
            return 87;
        }
    }
    const runs: i64 = pl_count(buf, bl[0], " 已提交 " as &const byte, 10);
    var tsum: [i64: 1] = [0];
    var tcnt: [i64: 1] = [0];
    pl_sum_minutes(buf, bl[0], &tsum[0: 1], &tcnt[0: 1]);
    const shots: i64 = pl_max_shot(buf, bl[0]);
    const measured: bool = runs > 0 && tcnt[0] > 0 && shots > 0;
    // 每镜均值（毫秒）
    var mean_ms: i64 = 0;
    if tcnt[0] > 0 {
        mean_ms = tsum[0] / tcnt[0];
    }
    // 重做率（千分比）：提交次数 / 镜数
    var redo_milli: i64 = 0;
    if shots > 0 {
        redo_milli = (runs *| 1000) / shots;
    }
    // 一集 GPU 毫秒 = 实际总生成时间（含重做）；再外推到 target_episodes
    const ep_ms: i64 = tsum[0];
    const ideal_ms: i64 = mean_ms *| shots;
    // 毫秒 → 毫小时：先乘目标集数再除 3600，避免 32 位中间值回绕
    const proj_hour_milli: i64 = (ep_ms *| target) / 3600;
    // DESIGN §0.3 基线：292 GPU h / 100 集
    const base_hour_milli: i64 = 292000;
    var err_milli: i64 = 0;
    if base_hour_milli > 0 {
        if proj_hour_milli >= base_hour_milli {
            err_milli = ((proj_hour_milli -| base_hour_milli) *| 1000)
                / base_hour_milli;
        } else {
            err_milli = ((base_hour_milli -| proj_hour_milli) *| 1000)
                / base_hour_milli;
        }
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"log\":" as &const byte);
    w = w + j_put_str(out, w, &logn[0], ln[0]);
    w = w + j_put(out, w, ",\"bytes\":" as &const byte);
    w = w + j_put_i64(out, w, bl[0]);
    w = w + j_put(out, w, ",\"runs\":" as &const byte);
    w = w + j_put_i64(out, w, runs);
    w = w + j_put(out, w, ",\"finished\":" as &const byte);
    w = w + j_put_i64(out, w, tcnt[0]);
    w = w + j_put(out, w, ",\"shots\":" as &const byte);
    w = w + j_put_i64(out, w, shots);
    w = w + j_put(out, w, ",\"mean_shot_ms\":" as &const byte);
    w = w + j_put_i64(out, w, mean_ms);
    w = w + j_put(out, w, ",\"ideal_episode_gpu_ms\":" as &const byte);
    w = w + j_put_i64(out, w, ideal_ms);
    w = w + j_put(out, w, ",\"episode_gpu_ms\":" as &const byte);
    w = w + j_put_i64(out, w, ep_ms);
    w = w + j_put(out, w, ",\"redo_rate_milli\":" as &const byte);
    w = w + j_put_i64(out, w, redo_milli);
    w = w + j_put(out, w, ",\"target_episodes\":" as &const byte);
    w = w + j_put_i64(out, w, target);
    w = w + j_put(out, w, ",\"projection\":{\"gpu_hours_milli\":" as
        &const byte);
    w = w + j_put_i64(out, w, proj_hour_milli);
    w = w + j_put(out, w, ",\"baseline_gpu_hours_milli\":" as &const byte);
    w = w + j_put_i64(out, w, base_hour_milli);
    w = w + j_put(out, w, ",\"ideal_gpu_hours_milli\":" as &const byte);
    w = w + j_put_i64(out, w, (ideal_ms *| target) / 3600);
    w = w + j_put(out, w, ",\"error_pct_milli\":" as &const byte);
    w = w + j_put_i64(out, w, err_milli);
    w = w + j_put(out, w, "},\"measured\":" as &const byte);
    if measured {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}
