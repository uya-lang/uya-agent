// drama_plugin/src/ops.uya — 业务操作的实际执行（P3 起为真实现）
//
// 分工：`server.uya` 只管协议与错误包装；这里只管"做事"并把结果写成
// JSON 片段（`data` 的内容），用返回码表达失败原因。
//
// 返回码：
//   0  成功（out 里是 data 的 JSON）
//   10 名字非法        11 项目已存在      12 写失败
//   13 项目 ID 非法    14 项目不存在      15 读失败
//   20 该操作还没实现（P4/P5 之后补，调用方退回 mock 行为）

use libc.syscall;
use libc.unistd;

// 参数只在 `arguments.input` 里找：整行里还有工具名 "name"，全局搜会串。
fn input_span(line: &const byte, n: usize, st: &usize, ln: &usize) bool {
    return schema_input_span(line, n, st, ln);
}

fn input_str(line: &const byte, n: usize, key: &const byte,
    out: &[byte], out_len: &usize) bool {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if !input_span(line, n, &st[0], &ln[0]) {
        return false;
    }
    return j_str(&line[st[0]], ln[0], key, out, out_len);
}

// 取整数参数（可选，缺省 defaultValue）
fn int_arg(line: &const byte, n: usize, key: &const byte,
    dflt: i64) i64 {
    var ist: [usize: 1] = [0];
    var iln: [usize: 1] = [0];
    if !input_span(line, n, &ist[0], &iln[0]) {
        return dflt;
    }
    const sub: &const byte = &line[ist[0]];
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    const k: byte = j_span(sub, iln[0], key, &st[0], &ln[0]);
    if k == 0 as byte || k == 34 as byte || k == 123 as byte {
        return dflt;
    }
    var i: usize = 0;
    var neg: bool = false;
    var v: i64 = 0;
    if ln[0] > 0 && sub[st[0]] == 45 as byte {
        neg = true;
        i = 1;
    }
    while i < ln[0] {
        const c: byte = sub[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| (c as i64) -| 48;
        i = i + 1;
    }
    if neg {
        return 0 -| v;
    }
    return v;
}

// project.create
fn op_project_create(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var name: [byte: 128] = [0: 128];
    var nl: usize = 0;
    if !input_str(line, n, "name" as &const byte, &name[0: 128], &nl) {
        return 10;
    }
    const episodes: i64 = int_arg(line, n, "episode_count" as &const byte, 0);
    var id: [byte: 16] = [0: 16];
    var il: usize = 0;
    const rc: i32 = project_create(data_root_ptr(), data_root_len(),
        &name[0], nl, episodes, &id[0: 16], &il);
    if rc == 1 {
        return 10;
    }
    if rc == 2 {
        return 11;
    }
    if rc != 0 {
        return 12;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"project_id\":" as &const byte);
    w = w + j_put_str(out, w, &id[0], il);
    w = w + j_put(out, w, ",\"created\":true}" as &const byte);
    out_len[0] = w;
    return 0;
}

// project.get
fn op_project_get(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64],
        &il) {
        return 13;
    }
    var body: [byte: 1024] = [0: 1024];
    var bl: usize = 0;
    const rc: i32 = project_get(data_root_ptr(), data_root_len(),
        &id[0], il, &body[0], 1024, &bl);
    if rc == 4 {
        return 13;
    }
    if rc == 5 {
        return 14;
    }
    if rc != 0 {
        return 15;
    }
    const w: usize = j_put_raw(out, 0, &body[0], bl);
    out_len[0] = w;
    return 0;
}

// project.list：把 index.jsonl 的每行包成数组元素
fn op_project_list(out: &[byte], out_len: &usize) i32 {
    var raw: [byte: 16384] = [0: 16384];
    var rl: usize = 0;
    const rc: i32 = project_list(data_root_ptr(), data_root_len(),
        &raw[0], 16384, &rl);
    if rc != 0 {
        return 15;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"projects\":[" as &const byte);
    var i: usize = 0;
    var first: bool = true;
    while i < rl {
        var j: usize = i;
        while j < rl && raw[j] != 10 as byte {
            j = j + 1;
        }
        if j > i {
            if !first {
                w = w + j_put(out, w, "," as &const byte);
            }
            w = w + j_put_raw(out, w, &raw[i], j - i);
            first = false;
        }
        i = j + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    out_len[0] = w;
    return 0;
}

// 入口：按操作下标分派
export fn ops_run(op_i: usize, line: &const byte, n: usize,
    out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    const nm: &const byte = registry_name(op_i);
    if b_eq(nm, b_len(nm), "project.create" as &const byte) {
        return op_project_create(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "project.get" as &const byte) {
        return op_project_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "project.list" as &const byte) {
        return op_project_list(out, out_len);
    }
    return 20;
}
