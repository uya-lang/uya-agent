fn op_production_status(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    var tid: [byte: 32] = [0: 32];
    var tdl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    if !input_str(line, n, "task_id" as &const byte, &tid[0: 32], &tdl) {
        return 13;
    }
    const rc: i32 = task_get(data_root_ptr(), data_root_len(), &pid[0], pl,
        &tid[0], tdl, out, out_len);
    if rc == 56 {
        return 17;
    }
    if rc != 0 {
        return 15;
    }
    if out_len[0] < 2 || out[out_len[0] - 1] != 125 as byte {
        return 15;
    }
    var w: usize = out_len[0] - 1;
    const ws: i32 = worker_state(data_root_ptr(), data_root_len());
    w = w + j_put(out, w, ",\"worker\":\"" as &const byte);
    if ws == 1 {
        w = w + j_put(out, w, "busy" as &const byte);
    } else {
        w = w + j_put(out, w, "idle" as &const byte);
    }
    w = w + j_put(out, w, "\"}" as &const byte);
    out_len[0] = w;
    return 0;
}

// 重试：把失败/完成的任务重置成 queued，让 worker 再跑一遍（不动 Canon）
fn op_episode_retry(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    var tid: [byte: 32] = [0: 32];
    var tdl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    if !input_str(line, n, "task_id" as &const byte, &tid[0: 32], &tdl) {
        return 13;
    }
    const rc: i32 = task_reset(data_root_ptr(), data_root_len(), &pid[0], pl,
        &tid[0], tdl);
    if rc == 56 {
        return 17;
    }
    if rc != 0 {
        return 15;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"task_id\":" as &const byte);
    w = w + j_put_str(out, w, &tid[0], tdl);
    w = w + j_put(out, w, ",\"state\":\"queued\"}" as &const byte);
    out_len[0] = w;
    return 0;
}


