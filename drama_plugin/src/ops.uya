    const rc: i32 = board_build(data_root_ptr(), data_root_len(), &pid[0],
        pl, ver, out, out_len);
    if rc == 96 {
        return 17;
    }
    if rc == 98 {
        return 98;
    }
    if rc != 0 {
        return 18;
    }
    return 0;
}

