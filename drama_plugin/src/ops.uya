// drama_plugin/src/ops.uya — 业务操作的实际执行（P3 起为真实现）
//
// 分工：`server.uya` 只管协议与错误包装；这里只管"做事"并把结果写成
// JSON 片段（`data` 的内容），用返回码表达失败原因。
//
// 返回码：
//   0  成功（out 里是 data 的 JSON）
//   10 名字非法        11 项目已存在      12 写失败
//   13 项目 ID 非法    14 项目不存在      15 读失败
//   20 该操作还没实现（P4/P5 之后补，调用方退回 mock 行为）

use libc.syscall;
use libc.unistd;

// 参数只在 `arguments.input` 里找：整行里还有工具名 "name"，全局搜会串。
fn input_span(line: &const byte, n: usize, st: &usize, ln: &usize) bool {
    return schema_input_span(line, n, st, ln);
}

fn input_str(line: &const byte, n: usize, key: &const byte,
    out: &[byte], out_len: &usize) bool {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if !input_span(line, n, &st[0], &ln[0]) {
        return false;
    }
    return j_str(&line[st[0]], ln[0], key, out, out_len);
}

// 取整数参数（可选，缺省 defaultValue）
fn int_arg(line: &const byte, n: usize, key: &const byte,
    dflt: i64) i64 {
    var ist: [usize: 1] = [0];
    var iln: [usize: 1] = [0];
    if !input_span(line, n, &ist[0], &iln[0]) {
        return dflt;
    }
    const sub: &const byte = &line[ist[0]];
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    const k: byte = j_span(sub, iln[0], key, &st[0], &ln[0]);
    if k == 0 as byte || k == 34 as byte || k == 123 as byte {
        return dflt;
    }
    var i: usize = 0;
    var neg: bool = false;
    var v: i64 = 0;
    if ln[0] > 0 && sub[st[0]] == 45 as byte {
        neg = true;
        i = 1;
    }
    while i < ln[0] {
        const c: byte = sub[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| (c as i64) -| 48;
        i = i + 1;
    }
    if neg {
        return 0 -| v;
    }
    return v;
}

// project.create
fn op_project_create(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var name: [byte: 128] = [0: 128];
    var nl: usize = 0;
    if !input_str(line, n, "name" as &const byte, &name[0: 128], &nl) {
        return 10;
    }
    const episodes: i64 = int_arg(line, n, "episode_count" as &const byte, 0);
    var id: [byte: 16] = [0: 16];
    var il: usize = 0;
    const rc: i32 = project_create(data_root_ptr(), data_root_len(),
        &name[0], nl, episodes, &id[0: 16], &il);
    if rc == 1 {
        return 10;
    }
    if rc == 2 {
        return 11;
    }
    if rc != 0 {
        return 12;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"project_id\":" as &const byte);
    w = w + j_put_str(out, w, &id[0], il);
    w = w + j_put(out, w, ",\"created\":true}" as &const byte);
    out_len[0] = w;
    return 0;
}

// project.get
fn op_project_get(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64],
        &il) {
        return 13;
    }
    var body: [byte: 1024] = [0: 1024];
    var bl: usize = 0;
    const rc: i32 = project_get(data_root_ptr(), data_root_len(),
        &id[0], il, &body[0], 1024, &bl);
    if rc == 4 {
        return 13;
    }
    if rc == 5 {
        return 14;
    }
    if rc == 7 {
        return 16;
    }
    if rc != 0 {
        return 15;
    }
    const w: usize = j_put_raw(out, 0, &body[0], bl);
    out_len[0] = w;
    return 0;
}

// project.list：把 index.jsonl 的每行包成数组元素
fn op_project_list(out: &[byte], out_len: &usize) i32 {
    var raw: [byte: 16384] = [0: 16384];
    var rl: usize = 0;
    const rc: i32 = project_list(data_root_ptr(), data_root_len(),
        &raw[0], 16384, &rl);
    if rc != 0 {
        return 15;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"projects\":[" as &const byte);
    var i: usize = 0;
    var first: bool = true;
    while i < rl {
        var j: usize = i;
        while j < rl && raw[j] != 10 as byte {
            j = j + 1;
        }
        if j > i {
            if !first {
                w = w + j_put(out, w, "," as &const byte);
            }
            w = w + j_put_raw(out, w, &raw[i], j - i);
            first = false;
        }
        i = j + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    out_len[0] = w;
    return 0;
}


// input 里某个对象的原始字节区间（bible / locks 这类要原样存的字段）
fn input_raw(line: &const byte, n: usize, key: &const byte,
    st: &usize, ln: &usize) bool {
    var ist: [usize: 1] = [0];
    var iln: [usize: 1] = [0];
    if !input_span(line, n, &ist[0], &iln[0]) {
        return false;
    }
    const sub: &const byte = &line[ist[0]];
    const k: byte = j_span(sub, iln[0], key, st, ln);
    if k != 123 as byte {
        return false;
    }
    st[0] = st[0] + ist[0];
    return true;
}

fn op_bible_put(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    var bs: [usize: 1] = [0];
    var bl: [usize: 1] = [0];
    if !input_raw(line, n, "bible" as &const byte, &bs[0], &bl[0]) {
        return 10;
    }
    var ls: [usize: 1] = [0];
    var ll: [usize: 1] = [0];
    if !input_raw(line, n, "locks" as &const byte, &ls[0], &ll[0]) {
        return 10;
    }
    return bible_put(data_root_ptr(), data_root_len(), &id[0], il,
        &line[bs[0]], bl[0], &line[ls[0]], ll[0], out, out_len);
}

fn op_bible_get(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    const v: i64 = int_arg(line, n, "version" as &const byte, 0);
    return bible_get(data_root_ptr(), data_root_len(), &id[0], il, v,
        out, out_len);
}

fn op_bible_history(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    return bible_history(data_root_ptr(), data_root_len(), &id[0], il,
        out, out_len);
}

fn op_asset_register(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    var nm: [byte: 128] = [0: 128];
    var nl: usize = 0;
    if !input_str(line, n, "name" as &const byte, &nm[0: 128], &nl) {
        return 31;
    }
    var mt: [byte: 64] = [0: 64];
    var ml: usize = 0;
    _ = input_str(line, n, "mime" as &const byte, &mt[0: 64], &ml);
    const rc: i32 = asset_register(data_root_ptr(), data_root_len(),
        &id[0], il, &nm[0], nl, &mt[0], ml);
    if rc != 0 {
        return rc;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"registered\":true,\"name\":" as &const byte);
    w = w + j_put_str(out, w, &nm[0], nl);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

fn op_asset_list(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    var raw: [byte: 16384] = [0: 16384];
    var rl: usize = 0;
    const rc: i32 = asset_index(data_root_ptr(), data_root_len(), &id[0],
        il, &raw[0: 16384], &rl);
    if rc == 34 {
        out_len[0] = 0;
        var w0: usize = 0;
        w0 = w0 + j_put(out, w0, "{\"assets\":[]}" as &const byte);
        out_len[0] = w0;
        return 0;
    }
    if rc != 0 {
        return 15;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"assets\":[" as &const byte);
    var i: usize = 0;
    var first: bool = true;
    while i < rl {
        var j: usize = i;
        while j < rl && raw[j] != 10 as byte {
            j = j + 1;
        }
        if j > i {
            if !first {
                w = w + j_put(out, w, "," as &const byte);
            }
            w = w + j_put_raw(out, w, &raw[i], j - i);
            first = false;
        }
        i = j + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    out_len[0] = w;
    return 0;
}


fn op_canon_inspect(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    const rc: i32 = canon_inspect(data_root_ptr(), data_root_len(),
        &id[0], il, out, out_len);
    if rc == 50 {
        return 13;
    }
    if rc != 0 {
        return 15;
    }
    return 0;
}

// 取 input 里任意容器（对象或数组）的原始字节区间
fn input_boxed(line: &const byte, n: usize, key: &const byte,
    st: &usize, ln: &usize) bool {
    var ist: [usize: 1] = [0];
    var iln: [usize: 1] = [0];
    if !input_span(line, n, &ist[0], &iln[0]) {
        return false;
    }
    const sub: &const byte = &line[ist[0]];
    const k: byte = j_span(sub, iln[0], key, st, ln);
    if k != 123 as byte && k != 91 as byte {
        return false;
    }
    st[0] = st[0] + ist[0];
    return true;
}

fn op_canon_commit(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    var es: [usize: 1] = [0];
    var el: [usize: 1] = [0];
    if !input_boxed(line, n, "events" as &const byte, &es[0], &el[0]) {
        return 10;
    }
    const base: i64 = int_arg(line, n, "base_revision" as &const byte, -1);
    const rc: i32 = canon_commit(data_root_ptr(), data_root_len(), &id[0],
        il, base, &line[es[0]], el[0], out, out_len);
    if rc == 50 {
        return 13;
    }
    return rc;
}

fn op_canon_recover(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    const rc: i32 = canon_recover(data_root_ptr(), data_root_len(), &id[0],
        il, out, out_len);
    if rc == 50 {
        return 13;
    }
    return rc;
}


fn op_llm_ping(out: &[byte], out_len: &usize) i32 {
    var c: LlmConfig = cfg_default();
    var w: usize = 0;
    w = w + j_put(out, w, "{\"provider\":\"" as &const byte);
    if c.is_mock {
        w = w + j_put(out, w, "mock" as &const byte);
    } else {
        w = w + j_put(out, w, "openai" as &const byte);
    }
    w = w + j_put(out, w, "\",\"model\":" as &const byte);
    w = w + j_put_str(out, w, &c.model[0], c.model_len);
    w = w + j_put(out, w, ",\"timeout_ms\":" as &const byte);
    w = w + j_put_i64(out, w, c.timeout_ms as i64);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

fn op_llm_complete(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pr: [byte: 1024] = [0: 1024];
    var pl: usize = 0;
    if !input_str(line, n, "prompt" as &const byte, &pr[0: 1024], &pl) {
        return 10;
    }
    var content: &byte = malloc(16384) as &byte;
    defer { free(content as &void); }
    if (content as usize) == 0 {
        return 15;
    }
    var cl: [usize: 1] = [0];
    const rc: i32 = llm_complete(data_root_ptr(), data_root_len(),
        &pr[0], pl, &content[0: 16384], &cl[0]);
    if rc != 0 {
        return rc;
    }
    const vr: i32 = llm_validate_screenplay(&content[0], cl[0]);
    if vr != 0 {
        return vr;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"content\":" as &const byte);
    w = w + j_put_raw(out, w, &content[0], cl[0]);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}


// 组装给模型的上下文提示（Bible 版本 + Canon revision + 目标时长）
fn build_prompt(id: &const byte, il: usize, secs: i64, out: &[byte],
    out_len: &usize) void {
    var w: usize = 0;
    w = w + j_put_raw(out, w, "写一集短剧剧本，返回 JSON：" as &const byte, 39);
    w = w + j_put_raw(out, w,
        "{\"title\":…,\"hook\":…,\"scenes\":[{\"no\":1," as &const byte, 44);
    w = w + j_put_raw(out, w,
        "\"action\":…,\"dialogue\":[{\"who\":…," as &const byte, 35);
    w = w + j_put_raw(out, w, "\"line\":…}]}]," as &const byte, 14);
    w = w + j_put_raw(out, w, "\"candidate_events\":[]}。" as &const byte, 24);
    w = w + j_put_raw(out, w, "项目 " as &const byte, 7);
    w = w + j_put_raw(out, w, id, il);
    w = w + j_put_raw(out, w, "，目标时长 " as &const byte, 16);
    w = w + j_put_i64(out, w, secs);
    w = w + j_put_raw(out, w, " 秒。" as &const byte, 7);
    out_len[0] = w;
}

fn op_episode_generate(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    if !project_id_ok(&id[0], il) {
        return 13;
    }
    const secs: i64 = int_arg(line, n, "target_seconds" as &const byte, 120);
    var ctxbuf: [byte: 8192] = [0: 8192];
    var ctxl: [usize: 1] = [0];
    const cx: i32 = ctx_build(data_root_ptr(), data_root_len(), &id[0], il,
        4096, &ctxbuf[0: 8192], &ctxl[0]);
    if cx != 0 {
        return cx;
    }
    var prompt: [byte: 8192] = [0: 8192];
    var pl: usize = 0;
    build_prompt(&id[0], il, secs, &prompt[0: 8192], &pl);
    pl = pl + j_put_raw(&prompt[0: 8192], pl,
        " 上下文：" as &const byte, 13);
    pl = pl + j_put_raw(&prompt[0: 8192], pl, &ctxbuf[0], ctxl[0]);
    var content: &byte = malloc(16384) as &byte;
    defer { free(content as &void); }
    if (content as usize) == 0 {
        return 15;
    }
    var cl: [usize: 1] = [0];
    const rc: i32 = llm_complete(data_root_ptr(), data_root_len(),
        &prompt[0], pl, &content[0: 16384], &cl[0]);
    if rc != 0 {
        return rc;
    }
    const vr: i32 = story_validate(&content[0], cl[0]);
    if vr != 0 {
        return vr;
    }
    var dump: [byte: 64] = [0: 64];
    var dump_len: [usize: 1] = [0];
    const svr: i32 = story_save(data_root_ptr(), data_root_len(), &id[0], il,
        &content[0], cl[0], &dump[0: 64], &dump_len[0]);
    if svr != 0 {
        return svr;
    }
    const ver: i64 = story_current_version(data_root_ptr(), data_root_len(),
        &id[0], il);
    const dur: i64 = story_duration_ms(&content[0], cl[0]);
    var w: usize = 0;
    w = w + j_put(out, w, "{\"script_version\":" as &const byte);
    w = w + j_put_i64(out, w, ver);
    w = w + j_put(out, w, ",\"duration_ms\":" as &const byte);
    w = w + j_put_i64(out, w, dur);
    w = w + j_put(out, w, ",\"target_ms\":" as &const byte);
    w = w + j_put_i64(out, w, secs *| 1000);
    w = w + j_put(out, w, ",\"delta_ms\":" as &const byte);
    w = w + j_put_i64(out, w, dur -| (secs *| 1000));
    w = w + j_put(out, w, ",\"canon_revision\":" as &const byte);
    w = w + j_put_i64(out, w, canon_revision(data_root_ptr(),
        data_root_len(), &id[0], il));
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

fn op_episode_approve(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    const ver: i64 = int_arg(line, n, "script_version" as &const byte, 0);
    // 同一个版本重复批准：回放上次结果，不重复应用事件
    var aver: [i64: 1] = [0];
    var arev: [i64: 1] = [0];
    if story_approved(data_root_ptr(), data_root_len(), &id[0], il,
        &aver[0], &arev[0]) && aver[0] == ver {
        var w0: usize = 0;
        w0 = w0 + j_put(out, w0, "{\"revision\":" as &const byte);
        w0 = w0 + j_put_i64(out, w0, arev[0]);
        w0 = w0 + j_put(out, w0, ",\"events_applied\":0," as &const byte);
        w0 = w0 + j_put(out, w0, "\"duplicate\":true}" as &const byte);
        out_len[0] = w0;
        return 0;
    }
    var rec: &byte = malloc(32768) as &byte;
    defer { free(rec as &void); }
    if (rec as usize) == 0 {
        return 15;
    }
    var rl: [usize: 1] = [0];
    const lrc: i32 = story_load(data_root_ptr(), data_root_len(), &id[0], il,
        ver, &rec[0: 32768], &rl[0]);
    if lrc != 0 {
        return 96;
    }
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(&rec[0], rl[0], "screenplay" as &const byte, &ss[0],
        &sl[0]) != 123 as byte {
        return 94;
    }
    const sp: &const byte = &rec[ss[0]];
    const vr: i32 = story_validate(sp, sl[0]);
    if vr != 0 {
        return vr;   // 审核失败不能批准
    }
    var es: [usize: 1] = [0];
    var el: [usize: 1] = [0];
    if j_span(sp, sl[0], "candidate_events" as &const byte, &es[0],
        &el[0]) != 91 as byte {
        return 97;   // 没有候选事件，批准了也没有状态可提交
    }
    const base: i64 = canon_revision(data_root_ptr(), data_root_len(),
        &id[0], il);
    const crc: i32 = canon_commit(data_root_ptr(), data_root_len(), &id[0],
        il, base, &sp[es[0]], el[0], out, out_len);
    if crc == 50 {
        return 13;
    }
    if crc == 0 {
        const newrev: i64 = canon_revision(data_root_ptr(), data_root_len(),
            &id[0], il);
        _ = story_mark_approved(data_root_ptr(), data_root_len(), &id[0],
            il, ver, newrev);
        append_summary(&id[0], il, sp, sl[0], ver, newrev);
    }
    return crc;
}


fn op_context_inspect(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    const mb: i64 = int_arg(line, n, "max_bytes" as &const byte, 8192);
    const rc: i32 = ctx_build(data_root_ptr(), data_root_len(), &id[0], il,
        mb as! usize catch { 8192 as usize; }, out, out_len);
    if rc == 50 {
        return 13;
    }
    return rc;
}


// episode.produce：落盘建任务，立刻回 queued（不在这里跑模型）
fn op_episode_produce(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        // 兼容老调用：只给 episode_id 时用不到项目
        if !input_str(line, n, "episode_id" as &const byte, &pid[0: 64],
            &pl) {
            return 13;
        }
    }
    var tgt: [byte: 32] = [0: 32];
    var tgl: usize = 0;
    if !input_str(line, n, "stage" as &const byte, &tgt[0: 32], &tgl) {
        _ = copy_to("script" as &const byte, 6, &tgt[0: 32], &tgl);
    }
    var tid: [byte: 32] = [0: 32];
    var tdl: [usize: 1] = [0];
    const rc: i32 = task_create(data_root_ptr(), data_root_len(), &pid[0],
        pl, &tgt[0], tgl, input_hash(line, n), &tid[0: 32], &tdl[0]);
    if rc == 50 {
        return 13;
    }
    if rc != 0 {
        return 15;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"status\":\"queued\",\"task_id\":" as &const byte);
    w = w + j_put_str(out, w, &tid[0], tdl[0]);
    w = w + j_put(out, w, ",\"target\":" as &const byte);
    w = w + j_put_str(out, w, &tgt[0], tgl);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

fn op_task_run(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    var tid: [byte: 32] = [0: 32];
    var tdl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    if !input_str(line, n, "task_id" as &const byte, &tid[0: 32], &tdl) {
        return 13;
    }
    const rc: i32 = task_run(data_root_ptr(), data_root_len(), &pid[0], pl,
        &tid[0], tdl, out, out_len);
    if rc == 56 {
        return 17;
    }
    if rc == 57 {
        return 18;
    }
    if rc == 58 {
        return 98;
    }
    if rc != 0 {
        return 15;
    }
    return 0;
}

fn op_task_get(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    var tid: [byte: 32] = [0: 32];
    var tdl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    if !input_str(line, n, "task_id" as &const byte, &tid[0: 32], &tdl) {
        return 13;
    }
    const rc: i32 = task_get(data_root_ptr(), data_root_len(), &pid[0], pl,
        &tid[0], tdl, out, out_len);
    if rc == 56 {
        return 17;
    }
    if rc != 0 {
        return 15;
    }
    return 0;
}

fn op_task_list(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    var raw: [byte: 16384] = [0: 16384];
    var rl: [usize: 1] = [0];
    const rc: i32 = task_list(data_root_ptr(), data_root_len(), &pid[0], pl,
        &raw[0: 16384], &rl[0]);
    if rc != 0 {
        return 15;
    }
    // 索引是"一行一个任务"，这里包成数组交给调用方
    var w: usize = 0;
    w = w + j_put(out, w, "{\"tasks\":[" as &const byte);
    var i: usize = 0;
    var first: bool = true;
    while i < rl[0] {
        var j: usize = i;
        while j < rl[0] && raw[j] != 10 as byte {
            j = j + 1;
        }
        if j > i {
            if !first {
                w = w + j_put(out, w, "," as &const byte);
            }
            w = w + j_put_raw(out, w, &raw[i], j - i);
            first = false;
        }
        i = j + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    out_len[0] = w;
    return 0;
}


fn op_storyboard_build(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    const ver: i64 = int_arg(line, n, "script_version" as &const byte, 0);
    const rc: i32 = board_build(data_root_ptr(), data_root_len(), &pid[0],
        pl, ver, out, out_len);
    if rc == 96 {
        return 17;
    }
    if rc == 98 {
        return 98;
    }
    if rc != 0 {
        return 18;
    }
    return 0;
}

fn op_storyboard_get(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    const ver: i64 = int_arg(line, n, "board_version" as &const byte, 0);
    const rc: i32 = board_get(data_root_ptr(), data_root_len(), &pid[0], pl,
        ver, out, out_len);
    if rc == 96 {
        return 17;
    }
    if rc != 0 {
        return 15;
    }
    return 0;
}


fn op_provider_capabilities(out: &[byte], out_len: &usize) i32 {
    out_len[0] = provider_capabilities(out);
    return 0;
}

// 入口：按操作下标分派
export fn ops_run(op_i: usize, line: &const byte, n: usize,
    out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    const nm: &const byte = registry_name(op_i);
    if b_eq(nm, b_len(nm), "project.create" as &const byte) {
        return op_project_create(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "project.get" as &const byte) {
        return op_project_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "project.list" as &const byte) {
        return op_project_list(out, out_len);
    }
    if b_eq(nm, b_len(nm), "bible.put" as &const byte) {
        return op_bible_put(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "bible.get" as &const byte) {
        return op_bible_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "bible.history" as &const byte) {
        return op_bible_history(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "asset.register" as &const byte) {
        return op_asset_register(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "asset.list" as &const byte) {
        return op_asset_list(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "canon.inspect" as &const byte) {
        return op_canon_inspect(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "canon.commit" as &const byte) {
        return op_canon_commit(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "canon.recover" as &const byte) {
        return op_canon_recover(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "llm.ping" as &const byte) {
        return op_llm_ping(out, out_len);
    }
    if b_eq(nm, b_len(nm), "llm.complete" as &const byte) {
        return op_llm_complete(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "episode.generate" as &const byte) {
        return op_episode_generate(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "episode.approve" as &const byte) {
        return op_episode_approve(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "context.inspect" as &const byte) {
        return op_context_inspect(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "episode.produce" as &const byte) {
        return op_episode_produce(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "task.run" as &const byte) {
        return op_task_run(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "task.get" as &const byte) {
        return op_task_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "task.list" as &const byte) {
        return op_task_list(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "storyboard.build" as &const byte) {
        return op_storyboard_build(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "storyboard.get" as &const byte) {
        return op_storyboard_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "provider.capabilities" as &const byte) {
        return op_provider_capabilities(out, out_len);
    }
    return 20;
}

// 批准后写一集摘要（episode 号用 canon revision，口径写死在这里）
fn append_summary(pid: &const byte, pn: usize, sp: &const byte,
    sn: usize, ver: i64, rev: i64) void {
    var title: [byte: 128] = [0: 128];
    var tl: usize = 0;
    var hook: [byte: 256] = [0: 256];
    var hl: usize = 0;
    _ = j_str(sp, sn, "title" as &const byte, &title[0: 128], &tl);
    _ = j_str(sp, sn, "hook" as &const byte, &hook[0: 256], &hl);
    var line: [byte: 1024] = [0: 1024];
    var w: usize = 0;
    w = w + j_put(&line[0: 1024], w, "{\"episode\":" as &const byte);
    w = w + j_put_i64(&line[0: 1024], w, rev);
    w = w + j_put(&line[0: 1024], w, ",\"script_version\":" as &const byte);
    w = w + j_put_i64(&line[0: 1024], w, ver);
    w = w + j_put(&line[0: 1024], w, ",\"title\":" as &const byte);
    w = w + j_put_str(&line[0: 1024], w, &title[0], tl);
    w = w + j_put(&line[0: 1024], w, ",\"hook\":" as &const byte);
    w = w + j_put_str(&line[0: 1024], w, &hook[0], hl);
    w = w + j_put(&line[0: 1024], w, "}" as &const byte);
    _ = ctx_append_summary(data_root_ptr(), data_root_len(), pid, pn,
        &line[0], w);
}
