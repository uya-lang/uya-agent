// continuity.inspect：跨集连续性检查（账本 + 不变量 + 全历史重放）
fn op_continuity_inspect(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    const rc: i32 = audit_run(data_root_ptr(), data_root_len(), &pid[0], pl,
        out, out_len);
    if rc == 50 {
        // 项目不存在/还没提交过：和 canon.inspect 一样回空账本，不报错
        var w: usize = 0;
        w = w + j_put(out, w,
            "{\"ok\":true,\"revision\":0,\"commits\":0," as &const byte);
        w = w + j_put(out, w, "\"replay_ok\":true,\"ledger\":{" as &const byte);
        w = w + j_put(out, w,
            "\"props\":0,\"characters\":0,\"scenes\":0," as &const byte);
        w = w + j_put(out, w,
            "\"promises_open\":0,\"promises_closed\":0," as &const byte);
        w = w + j_put(out, w,
            "\"promises_overdue\":0,\"rules\":0,\"timeline_ms\":0}," as
            &const byte);
        w = w + j_put(out, w, "\"violations\":[]}" as &const byte);
        out_len[0] = w;
        return 0;
    }
    if rc != 0 {
        return 15;
    }
    return 0;
}

// episode.get：一集的"生产摘要"（剧本/分镜/成片版本 + Canon + 任务数）
fn op_episode_get(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    if !project_id_ok(&pid[0], pl) {
        return 13;
    }
    const sv: i64 = story_current_version(root, rn, &pid[0], pl);
    const bv: i64 = board_version(root, rn, &pid[0], pl);
    const av: i64 = assemble_current_version(root, rn, &pid[0], pl);
    const cr: i64 = canon_revision(root, rn, &pid[0], pl);
    var tasks: [byte: 65536] = [0: 65536];
    var tl: [usize: 1] = [0];
    _ = task_list(root, rn, &pid[0], pl, &tasks[0: 65536], &tl[0]);
    var tcount: i64 = 0;
    var i: usize = 0;
    while i < tl[0] {
        if tasks[i] == 10 as byte {
            tcount = tcount +| 1;
        }
        i = i + 1;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"project_id\":" as &const byte);
    w = w + j_put_str(out, w, &pid[0], pl);
    w = w + j_put(out, w, ",\"script_version\":" as &const byte);
    w = w + j_put_i64(out, w, sv);
    w = w + j_put(out, w, ",\"board_version\":" as &const byte);
    w = w + j_put_i64(out, w, bv);
    w = w + j_put(out, w, ",\"assembly_version\":" as &const byte);
    w = w + j_put_i64(out, w, av);
    w = w + j_put(out, w, ",\"canon_revision\":" as &const byte);
    w = w + j_put_i64(out, w, cr);
    w = w + j_put(out, w, ",\"tasks\":" as &const byte);
    w = w + j_put_i64(out, w, tcount);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}


// budget.report：项目级成本账本（渲染次数 / GPU 分钟 / 集数 / 重做率）
fn op_budget_report(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    if !project_id_ok(&pid[0], pl) {
        return 13;
    }
    var idx: [byte: 65536] = [0: 65536];
    var il: [usize: 1] = [0];
    _ = task_list(root, rn, &pid[0], pl, &idx[0: 65536], &il[0]);
    var renders: i64 = 0;
    var gpu_ms: i64 = 0;
    var tasks: i64 = 0;
    var i: usize = 0;
    while i < il[0] {
        var e: usize = i;
        while e < il[0] && idx[e] != 10 as byte {
            e = e + 1;
        }
        if e > i {
            var tid: [byte: 32] = [0: 32];
            var tidl: usize = 0;
            _ = j_str(&idx[i], e - i, "id" as &const byte, &tid[0: 32],
                &tidl);
            if tidl > 0 {
                tasks = tasks +| 1;
                var rec: [byte: 2048] = [0: 2048];
                var rl: [usize: 1] = [0];
                if task_get(root, rn, &pid[0], pl, &tid[0], tidl,
                    &rec[0: 2048], &rl[0]) == 0 {
                    renders = renders +| anum_of(&rec[0], rl[0],
                        "renders" as &const byte);
                    gpu_ms = gpu_ms +| anum_of(&rec[0], rl[0],
                        "gpu_ms" as &const byte);
                }
            }
        }
        i = e + 1;
    }
    const episodes: i64 = canon_revision(root, rn, &pid[0], pl);
    var w: usize = 0;
    w = w + j_put(out, w, "{\"project_id\":" as &const byte);
    w = w + j_put_str(out, w, &pid[0], pl);
    w = w + j_put(out, w, ",\"episodes\":" as &const byte);
    w = w + j_put_i64(out, w, episodes);
    w = w + j_put(out, w, ",\"tasks\":" as &const byte);
    w = w + j_put_i64(out, w, tasks);
    w = w + j_put(out, w, ",\"renders\":" as &const byte);
    w = w + j_put_i64(out, w, renders);
    w = w + j_put(out, w, ",\"gpu_ms\":" as &const byte);
    w = w + j_put_i64(out, w, gpu_ms);
    w = w + j_put(out, w, ",\"gpu_minutes\":" as &const byte);
    w = w + j_put_i64(out, w, gpu_ms / 60000);
    // 重做率：渲染次数 / 集数（产线基线 1.56×，>2.0× 该告警）
    w = w + j_put(out, w, ",\"renders_per_episode\":" as &const byte);
    if episodes > 0 {
        w = w + j_put_i64(out, w, (renders *| 100) / episodes);
    } else {
        w = w + j_put_i64(out, w, 0);
    }
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}


// 数任务状态：done / failed，最多记 3 个失败任务 id（逗号分隔）
fn count_tasks(root: &const byte, rn: usize, id: &const byte, idn: usize,
    done: &i64, failed: &i64, fids: &[byte], fnel: &usize) void {
    var idx: [byte: 65536] = [0: 65536];
    var il: [usize: 1] = [0];
    _ = task_list(root, rn, id, idn, &idx[0: 65536], &il[0]);
    var i: usize = 0;
    while i < il[0] {
        var e: usize = i;
        while e < il[0] && idx[e] != 10 as byte {
            e = e + 1;
        }
        if e > i {
            var tid: [byte: 32] = [0: 32];
            var tidl: usize = 0;
            _ = j_str(&idx[i], e - i, "id" as &const byte, &tid[0: 32],
                &tidl);
            var st: [byte: 16] = [0: 16];
            var stl: usize = 0;
            var rec: [byte: 2048] = [0: 2048];
            var rl: [usize: 1] = [0];
            if tidl > 0 && task_get(root, rn, id, idn, &tid[0], tidl,
                &rec[0: 2048], &rl[0]) == 0 {
                _ = j_str(&rec[0], rl[0], "state" as &const byte,
                    &st[0: 16], &stl);
                if eqb(&st[0], stl, "done" as &const byte, 4) {
                    done[0] = done[0] +| 1;
                } else if eqb(&st[0], stl, "failed" as &const byte, 6) {
                    failed[0] = failed[0] +| 1;
                    if fnel[0] < 3 {
                        fnel[0] = fnel[0] + j_put_str(fids, fnel[0],
                            &tid[0], tidl);
                        fnel[0] = fnel[0] + j_put_raw(fids, fnel[0],
                            "," as &const byte, 1);
                    }
                }
            }
        }
        i = e + 1;
    }
}

// media.encode：把数据根下的媒体文件转成 h264/aac
fn op_media_encode(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var rel: [byte: 256] = [0: 256];
    var rl: [usize: 1] = [0];
    if !input_str(line, n, "path" as &const byte, &rel[0: 256], &rl[0]) {
        return 13;
    }
    var nm: [byte: 64] = [0: 64];
    var nl: [usize: 1] = [0];
    if !input_str(line, n, "output" as &const byte, &nm[0: 64], &nl[0]) {
        return 13;
    }
    return provider_encode_file(data_root_ptr(), data_root_len(), &rel[0],
        rl[0], &nm[0], nl[0], out, out_len);
}

// media.subtitle：按分镜时间轴生成 SRT
