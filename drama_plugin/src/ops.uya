// production.cancel：取消还没跑完的任务
fn op_production_cancel(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    var tid: [byte: 32] = [0: 32];
    var tdl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    if !input_str(line, n, "task_id" as &const byte, &tid[0: 32], &tdl) {
        return 13;
    }
    const rc: i32 = task_cancel(data_root_ptr(), data_root_len(), &pid[0],
        pl, &tid[0], tdl);
    if rc == 56 {
        return 17;
    }
    if rc == 59 {
        return 22;   // 已经完成，不能取消
    }
    if rc != 0 {
        return 15;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"task_id\":" as &const byte);
    w = w + j_put_str(out, w, &tid[0], tdl);
    w = w + j_put(out, w, ",\"state\":\"cancelled\"}" as &const byte);
    out_len[0] = w;
    return 0;
}


// project.configure：改项目名字/集数，保留 id，config_version 递增
fn op_project_configure(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    var nm: [byte: 128] = [0: 128];
    var nl: usize = 0;
    const has_name: bool = input_str(line, n, "name" as &const byte,
        &nm[0: 128], &nl);
    var es: [usize: 1] = [0];
    var el: [usize: 1] = [0];
    const has_eps: bool = j_span(line, n, "episode_count" as &const byte,
        &es[0], &el[0]) != 0 as byte;
    var eps: i64 = 0;
    if has_eps {
        eps = int_arg_scoped(line, es[0], el[0]);
    }
    const rc: i32 = project_configure(data_root_ptr(), data_root_len(),
        &pid[0], pl, &nm[0], nl, eps, has_name, has_eps, out, out_len);
    if rc == 4 {
        return 13;
    }
    if rc == 5 {
        return 14;
    }
    if rc == 1 {
        return 10;
    }
    if rc != 0 {
        return 15;
    }
    return 0;
}

// 从给定区间里读一个整数（project.configure 的 episode_count）
fn int_arg_scoped(line: &const byte, st: usize, ln: usize) i64 {
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln {
        const c: byte = line[st + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}


// episode.review：一次拿齐"确定性 QA + 九条不变量"，并落一份审核记录
fn op_episode_review(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    const ver: i64 = int_arg(line, n, "script_version" as &const byte, 0);
    var qa: [byte: 8192] = [0: 8192];
    var ql: [usize: 1] = [0];
    const qrc: i32 = qa_run(data_root_ptr(), data_root_len(), &pid[0], pl,
        ver, &qa[0: 8192], &ql[0]);
    if qrc != 0 {
        return 17;
    }
    var inv: [byte: 4096] = [0: 4096];
    var il: [usize: 1] = [0];
    const irc: i32 = invariant_check(data_root_ptr(), data_root_len(),
        &pid[0], pl, &inv[0: 4096], &il[0]);
    if irc != 0 {
        return 15;
    }
    // 两份结果里各有一个 ok，取交集
    const qa_ok: bool = field_is_true(&qa[0], ql[0], "ok" as &const byte);
    var inv_ok: bool = true;
    var ps: [usize: 1] = [0];
    var pnl: [usize: 1] = [0];
    if j_span(&inv[0], il[0], "predicates" as &const byte, &ps[0],
        &pnl[0]) == 91 as byte {
        var idx: usize = 0;
        while true {
            var es: [usize: 1] = [0];
            var el: [usize: 1] = [0];
            if !j_arr_item(&inv[ps[0]], pnl[0], idx, &es[0], &el[0]) {
                break;
            }
            if !field_is_true(&inv[ps[0] + es[0]], el[0],
                "ok" as &const byte) {
                inv_ok = false;
            }
            idx = idx + 1;
        }
    }
    var rec: [byte: 16384] = [0: 16384];
    var w: usize = 0;
    w = w + j_put(&rec[0: 16384], w, "{\"qa\":" as &const byte);
    w = w + j_put_raw(&rec[0: 16384], w, &qa[0], ql[0]);
    w = w + j_put(&rec[0: 16384], w, ",\"invariants\":" as &const byte);
    w = w + j_put_raw(&rec[0: 16384], w, &inv[0], il[0]);
    w = w + j_put(&rec[0: 16384], w, "}" as &const byte);
    var rv: [byte: 256] = [0: 256];
    var rvl: [usize: 1] = [0];
    const svr: i32 = review_save(data_root_ptr(), data_root_len(), &pid[0],
        pl, &rec[0], w, &rv[0: 256], &rvl[0]);
    if svr != 0 {
        return 15;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"review_version\":" as &const byte);
    ow = ow + j_put_raw(out, ow, &rv[0], rvl[0]);
    ow = ow + j_put(out, ow, ",\"ok\":" as &const byte);
    if qa_ok && inv_ok {
        ow = ow + j_put(out, ow, "true" as &const byte);
    } else {
        ow = ow + j_put(out, ow, "false" as &const byte);
    }
    ow = ow + j_put(out, ow, ",\"qa_ok\":" as &const byte);
    if qa_ok {
        ow = ow + j_put(out, ow, "true" as &const byte);
    } else {
        ow = ow + j_put(out, ow, "false" as &const byte);
    }
    ow = ow + j_put(out, ow, ",\"invariants_ok\":" as &const byte);
    if inv_ok {
        ow = ow + j_put(out, ow, "true" as &const byte);
    } else {
        ow = ow + j_put(out, ow, "false" as &const byte);
    }
    ow = ow + j_put(out, ow, "}" as &const byte);
    out_len[0] = ow;
    return 0;
}

// 字节区间里某个布尔字段是不是 true
fn field_is_true(buf: &const byte, n: usize, key: &const byte) bool {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return false;
    }
    if ln[0] < 4 {
        return false;
    }
    return buf[st[0]] == 116 as byte;   // 't'
}


// budget.limit：设置项目级上限（渲染次数 / GPU 分钟；0 = 放开）
fn op_budget_limit(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    const mr: i64 = int_arg(line, n, "max_renders" as &const byte, 0);
    const mg: i64 = int_arg(line, n, "max_gpu_minutes" as &const byte, 0);
    const rc: i32 = budget_set(data_root_ptr(), data_root_len(), &pid[0], pl,
        mr, mg);
    if rc != 0 {
        return 15;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"max_renders\":" as &const byte);
    w = w + j_put_i64(out, w, mr);
    w = w + j_put(out, w, ",\"max_gpu_minutes\":" as &const byte);
    w = w + j_put_i64(out, w, mg);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

fn op_media_assemble(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    const bv: i64 = int_arg(line, n, "board_version" as &const byte, 0);
    const rc: i32 = assemble_run(data_root_ptr(), data_root_len(), &pid[0],
        pl, bv, out, out_len);
    if rc == 96 {
        return 17;
    }
    if rc == 97 {
        return 19;   // 镜头文件缺失
    }
    if rc != 0 {
        return 15;
    }
    return 0;
}

// 入口：按操作下标分派
export fn ops_run(op_i: usize, line: &const byte, n: usize,
    out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    const nm: &const byte = registry_name(op_i);
    if b_eq(nm, b_len(nm), "project.create" as &const byte) {
        return op_project_create(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "project.get" as &const byte) {
        return op_project_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "project.list" as &const byte) {
        return op_project_list(out, out_len);
    }
    if b_eq(nm, b_len(nm), "bible.put" as &const byte) {
        return op_bible_put(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "bible.get" as &const byte) {
        return op_bible_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "bible.history" as &const byte) {
        return op_bible_history(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "asset.register" as &const byte) {
        return op_asset_register(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "asset.list" as &const byte) {
        return op_asset_list(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "asset.get" as &const byte) {
        return op_asset_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "canon.inspect" as &const byte) {
        return op_canon_inspect(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "canon.commit" as &const byte) {
        return op_canon_commit(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "canon.recover" as &const byte) {
        return op_canon_recover(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "llm.ping" as &const byte) {
        return op_llm_ping(out, out_len);
    }
    if b_eq(nm, b_len(nm), "llm.complete" as &const byte) {
        return op_llm_complete(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "episode.generate" as &const byte) {
        return op_episode_generate(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "episode.approve" as &const byte) {
        return op_episode_approve(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "context.inspect" as &const byte) {
        return op_context_inspect(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "episode.produce" as &const byte) {
        return op_episode_produce(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "task.run" as &const byte) {
        return op_task_run(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "task.get" as &const byte) {
        return op_task_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "task.list" as &const byte) {
        return op_task_list(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "storyboard.build" as &const byte) {
        return op_storyboard_build(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "storyboard.get" as &const byte) {
        return op_storyboard_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "provider.capabilities" as &const byte) {
        return op_provider_capabilities(out, out_len);
    }
    return ops_run_ops(nm, line, n, out, out_len);
}

// 批准后写一集摘要（episode 号用 canon revision，口径写死在这里）
fn append_summary(pid: &const byte, pn: usize, sp: &const byte,
    sn: usize, ver: i64, rev: i64) void {
    var title: [byte: 128] = [0: 128];
    var tl: usize = 0;
    var hook: [byte: 256] = [0: 256];
    var hl: usize = 0;
    _ = j_str(sp, sn, "title" as &const byte, &title[0: 128], &tl);
    _ = j_str(sp, sn, "hook" as &const byte, &hook[0: 256], &hl);
    var line: [byte: 1024] = [0: 1024];
    var w: usize = 0;
    w = w + j_put(&line[0: 1024], w, "{\"episode\":" as &const byte);
    w = w + j_put_i64(&line[0: 1024], w, rev);
    w = w + j_put(&line[0: 1024], w, ",\"script_version\":" as &const byte);
    w = w + j_put_i64(&line[0: 1024], w, ver);
    w = w + j_put(&line[0: 1024], w, ",\"title\":" as &const byte);
    w = w + j_put_str(&line[0: 1024], w, &title[0], tl);
    w = w + j_put(&line[0: 1024], w, ",\"hook\":" as &const byte);
    w = w + j_put_str(&line[0: 1024], w, &hook[0], hl);
    w = w + j_put(&line[0: 1024], w, "}" as &const byte);
    _ = ctx_append_summary(data_root_ptr(), data_root_len(), pid, pn,
        &line[0], w);
}

// 生产/运维类操作（QA、任务状态、审计、合成、索引、账本）
fn ops_run_ops(nm: &const byte, line: &const byte, n: usize,
    out: &[byte], out_len: &usize) i32 {
    if b_eq(nm, b_len(nm), "qa.run" as &const byte) {
        return op_qa_run(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "production.status" as &const byte) {
        return op_production_status(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "episode.retry" as &const byte) {
        return op_episode_retry(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "canon.audit" as &const byte) {
        return op_canon_audit(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "continuity.inspect" as &const byte) {
        return op_continuity_inspect(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "media.assemble" as &const byte) {
        return op_media_assemble(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "media.probe" as &const byte) {
        return op_media_probe(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "media.encode" as &const byte) {
        return op_media_encode(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "media.subtitle" as &const byte) {
        return op_media_subtitle(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "media.mux" as &const byte) {
        return op_media_mux(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "media.mix" as &const byte) {
        return op_media_mix(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "media.loudnorm" as &const byte) {
        return op_media_loudnorm(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "episode.get" as &const byte) {
        return op_episode_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "budget.report" as &const byte) {
        return op_budget_report(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "production.report" as &const byte) {
        return op_production_report(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "index.rebuild" as &const byte) {
        return op_index_rebuild(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "index.list" as &const byte) {
        return op_index_list(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "series.plan" as &const byte) {
        return op_series_plan(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "outline.approve" as &const byte) {
        return op_outline_approve(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "series.get" as &const byte) {
        return op_series_get(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "promise.report" as &const byte) {
        return op_promise_report(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "invariant.check" as &const byte) {
        return op_invariant_check(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "production.cancel" as &const byte) {
        return op_production_cancel(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "project.configure" as &const byte) {
        return op_project_configure(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "episode.review" as &const byte) {
        return op_episode_review(line, n, out, out_len);
    }
    if b_eq(nm, b_len(nm), "budget.limit" as &const byte) {
        return op_budget_limit(line, n, out, out_len);
    }
    return 20;
}
