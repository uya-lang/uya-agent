// drama_plugin/src/provider.uya — Provider 接口与能力表（P8 第一段）
//
// 首版只做 **mock VideoProvider**：不联网、确定性产出，用来把"任务 → 分镜 →
// 镜头产物 → 资产登记"这条链路跑通；真实产线（本机队列 / 云 API）按 P0 契约
// 另起 Adapter，替换点就在这里。
//
// 能力表（`video.capabilities`）是**版本化**的：动作能不能演在这里说了算，
// 不能等生成完才发现（P7 的静态体检用同一张表）。
//
// 返回码：0 成功 94 写失败 98 动作不在能力表内

use libc.syscall;
use libc.unistd;

const CAP_VERSION: &const byte = "mock-video-cap-1" as &const byte;
const PROVIDER_ID: &const byte = "mock.video" as &const byte;

fn put_bool_raw(out: &[byte], w: usize, v: bool) usize {
    if v {
        return j_put(out, w, "true" as &const byte);
    }
    return j_put(out, w, "false" as &const byte);
}

// 常见 bin 目录里是否存在可执行文件（不读宿主 PATH）
fn check_dir(dir: &const byte, prog: &const byte) bool {
    var c: [byte: 512] = [0: 512];
    var cl: [usize: 1] = [0];
    if !path_join(dir, b_len(dir), prog, b_len(prog), &c[0: 512],
        &cl[0]) {
        return false;
    }
    return access(&c[0], 1) == 0;
}

fn emit_bin(out: &[byte], w: usize, idx: i32, probe: bool) usize {
    if idx == 1 {
        if probe {
            return w + j_put_str(out, w, "/usr/bin/ffprobe" as &const byte, 16);
        }
        return w + j_put_str(out, w, "/usr/bin/ffmpeg" as &const byte, 15);
    }
    if idx == 2 {
        if probe {
            return w + j_put_str(out, w,
                "/usr/local/bin/ffprobe" as &const byte, 22);
        }
        return w + j_put_str(out, w,
            "/usr/local/bin/ffmpeg" as &const byte, 21);
    }
    if probe {
        return w + j_put_str(out, w, "/bin/ffprobe" as &const byte, 12);
    }
    return w + j_put_str(out, w, "/bin/ffmpeg" as &const byte, 11);
}

fn find_bin(prog: &const byte) i32 {
    if check_dir("/usr/bin" as &const byte, prog) {
        return 1;
    }
    if check_dir("/usr/local/bin" as &const byte, prog) {
        return 2;
    }
    if check_dir("/bin" as &const byte, prog) {
        return 3;
    }
    return 0;
}

// 媒体工具探测结果并入能力表；路径只报常见目录里的确定值
fn emit_media(out: &[byte], w0: usize) usize {
    const ff: i32 = find_bin("ffmpeg" as &const byte);
    const fp: i32 = find_bin("ffprobe" as &const byte);
    var w: usize = w0;
    w = w + j_put(out, w, ",\"media\":{\"ffmpeg\":" as &const byte);
    w = w + put_bool_raw(out, w, ff != 0);
    w = w + j_put(out, w, ",\"ffmpeg_path\":" as &const byte);
    if ff != 0 {
        w = emit_bin(out, w, ff, false);
    } else {
        w = w + j_put_str(out, w, "" as &const byte, 0);
    }
    w = w + j_put(out, w, ",\"ffprobe\":" as &const byte);
    w = w + put_bool_raw(out, w, fp != 0);
    w = w + j_put(out, w, ",\"ffprobe_path\":" as &const byte);
    if fp != 0 {
        w = emit_bin(out, w, fp, true);
    } else {
        w = w + j_put_str(out, w, "" as &const byte, 0);
    }
    // 云 API（HttpProvider）只留占位：首版不实现，免得被误当成可用能力
    w = w + j_put(out, w, ",\"http_provider\":false" as &const byte);
    return w + j_put(out, w, "}" as &const byte);
}

// ---- 媒体输出编码：按 format.encode 参数转码 ----

fn out_name_ok(nm: &const byte, n: usize) bool {
    if n == 0 || n > 63 {
        return false;
    }
    var i: usize = 0;
    while i < n {
        const c: byte = nm[i];
        const digit: bool = c >= 48 as byte && c <= 57 as byte;
        const upper: bool = c >= 65 as byte && c <= 90 as byte;
        const lower: bool = c >= 97 as byte && c <= 122 as byte;
        if !digit && !upper && !lower && c != 46 as byte && c != 95 as byte
            && c != 45 as byte {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn build_encode_cmd(inp: &const byte, inn: usize, outp: &const byte,
    outn: usize, cmd: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(cmd, w, "ffmpeg -v error -y -i " as &const byte);
    w = quote_into(cmd, w, inp, inn);
    w = w + j_put(cmd, w, " -c:v libx264 -crf 20 " as &const byte);
    w = w + j_put(cmd, w, "-pix_fmt yuv420p " as &const byte);
    w = w + j_put(cmd, w, "-c:a aac -b:a 128k -ar 32000 " as &const byte);
    w = w + j_put(cmd, w, "-movflags +faststart " as &const byte);
    w = quote_into(cmd, w, outp, outn);
    w = w + j_put(cmd, w, " 2>/dev/null" as &const byte);
    return w;
}

// 把数据根下的媒体文件转成 h264/aac（输出在 encodes/<name>）
export fn provider_encode_file(root: &const byte, rn: usize, rel: &const byte,
    reln: usize, name: &const byte, nn: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    if !probe_path_ok(rel, reln) || !out_name_ok(name, nn) {
        return 86;
    }
    if !sh_safe(root, rn) || !sh_safe(rel, reln) {
        return 86;
    }
    var abs: [byte: 512] = [0: 512];
    var an: [usize: 1] = [0];
    if !path_join(root, rn, rel, reln, &abs[0: 512], &an[0]) {
        return 86;
    }
    var edir: [byte: 512] = [0: 512];
    var el: [usize: 1] = [0];
    if !path_join(root, rn, "encodes" as &const byte, 7, &edir[0: 512],
        &el[0]) {
        return 86;
    }
    _ = mkdir_p(&edir[0], el[0]);
    var outp: [byte: 512] = [0: 512];
    var on: [usize: 1] = [0];
    if !path_join(&edir[0], el[0], name, nn, &outp[0: 512], &on[0]) {
        return 86;
    }
    var cmd: [byte: 2048] = [0: 2048];
    var w: usize = build_encode_cmd(&abs[0], an[0], &outp[0], on[0],
        &cmd[0: 2048]);
    if w + 1 >= 2048 {
        return 86;
    }
    cmd[w] = 0 as byte;
    _ = system(&cmd[0]);
    const fd: i32 = sys_open(&outp[0], 0 as i32, 0) catch {
        return 91;
    };
    const end: i64 = sys_lseek(fd, 0 as i64, 2 as i32) catch {
        -1 as i64;
    };
    _ = sys_close(fd) catch { 0 as i32; };
    if end <= 0 {
        return 91;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"output\":\"encodes/" as &const byte);
    ow = ow + j_put_raw(out, ow, name, nn);
    ow = ow + j_put(out, ow, "\",\"size\":" as &const byte);
    ow = ow + j_put_i64(out, ow, end);
    ow = ow + j_put(out, ow, "}" as &const byte);
    out_len[0] = ow;
    return 0;
}

// ---- 字幕合成：把 SRT 作为 mov_text 轨道混进 MP4 ----

fn build_mux_cmd(vid: &const byte, vn: usize, sub: &const byte, sn: usize,
    outp: &const byte, on: usize, cmd: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(cmd, w, "ffmpeg -v error -y -i " as &const byte);
    w = quote_into(cmd, w, vid, vn);
    w = w + j_put(cmd, w, " -i " as &const byte);
    w = quote_into(cmd, w, sub, sn);
    w = w + j_put(cmd, w, " -c:v copy -c:a copy " as &const byte);
    w = w + j_put(cmd, w, "-c:s mov_text -movflags +faststart " as &const byte);
    w = quote_into(cmd, w, outp, on);
    w = w + j_put(cmd, w, " 2>/dev/null" as &const byte);
    return w;
}

export fn provider_mux_file(root: &const byte, rn: usize, vid: &const byte,
    vn: usize, sub: &const byte, sn: usize, name: &const byte, nn: usize,
    out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !probe_path_ok(vid, vn) || !probe_path_ok(sub, sn) {
        return 86;
    }
    if !out_name_ok(name, nn) || !sh_safe(root, rn) {
        return 86;
    }
    var va: [byte: 512] = [0: 512];
    var val: [usize: 1] = [0];
    if !path_join(root, rn, vid, vn, &va[0: 512], &val[0]) {
        return 86;
    }
    var sa: [byte: 512] = [0: 512];
    var sal: [usize: 1] = [0];
    if !path_join(root, rn, sub, sn, &sa[0: 512], &sal[0]) {
        return 86;
    }
    var edir: [byte: 512] = [0: 512];
    var el: [usize: 1] = [0];
    if !path_join(root, rn, "encodes" as &const byte, 7, &edir[0: 512],
        &el[0]) {
        return 86;
    }
    _ = mkdir_p(&edir[0], el[0]);
    var outp: [byte: 512] = [0: 512];
    var on: [usize: 1] = [0];
    if !path_join(&edir[0], el[0], name, nn, &outp[0: 512], &on[0]) {
        return 86;
    }
    var cmd: [byte: 2048] = [0: 2048];
    var w: usize = build_mux_cmd(&va[0], val[0], &sa[0], sal[0],
        &outp[0], on[0], &cmd[0: 2048]);
    if w + 1 >= 2048 {
        return 86;
    }
    cmd[w] = 0 as byte;
    _ = system(&cmd[0]);
    const fd: i32 = sys_open(&outp[0], 0 as i32, 0) catch {
        return 91;
    };
    const end: i64 = sys_lseek(fd, 0 as i64, 2 as i32) catch {
        -1 as i64;
    };
    _ = sys_close(fd) catch { 0 as i32; };
    if end <= 0 {
        return 91;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"output\":\"encodes/" as &const byte);
    ow = ow + j_put_raw(out, ow, name, nn);
    ow = ow + j_put(out, ow, "\",\"size\":" as &const byte);
    ow = ow + j_put_i64(out, ow, end);
    ow = ow + j_put(out, ow, "}" as &const byte);
    out_len[0] = ow;
    return 0;
}

// ---- 音轨混入：用给定音频替换/混入成片音轨 ----

fn build_mix_cmd(vid: &const byte, vn: usize, aud: &const byte, an: usize,
    outp: &const byte, on: usize, cmd: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(cmd, w, "ffmpeg -v error -y -i " as &const byte);
    w = quote_into(cmd, w, vid, vn);
    w = w + j_put(cmd, w, " -i " as &const byte);
    w = quote_into(cmd, w, aud, an);
    w = w + j_put(cmd, w, " -map 0:v:0 -map 1:a:0 " as &const byte);
    w = w + j_put(cmd, w, "-c:v copy -c:a aac " as &const byte);
    w = w + j_put(cmd, w, "-b:a 128k -ar 32000 " as &const byte);
    w = w + j_put(cmd, w, "-shortest " as &const byte);
    w = quote_into(cmd, w, outp, on);
    w = w + j_put(cmd, w, " 2>/dev/null" as &const byte);
    return w;
}

export fn provider_mix_file(root: &const byte, rn: usize, vid: &const byte,
    vn: usize, aud: &const byte, an: usize, name: &const byte, nn: usize,
    out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !probe_path_ok(vid, vn) || !probe_path_ok(aud, an) {
        return 86;
    }
    if !out_name_ok(name, nn) || !sh_safe(root, rn) {
        return 86;
    }
    var va: [byte: 512] = [0: 512];
    var val: [usize: 1] = [0];
    if !path_join(root, rn, vid, vn, &va[0: 512], &val[0]) {
        return 86;
    }
    var aa: [byte: 512] = [0: 512];
    var aal: [usize: 1] = [0];
    if !path_join(root, rn, aud, an, &aa[0: 512], &aal[0]) {
        return 86;
    }
    var edir: [byte: 512] = [0: 512];
    var el: [usize: 1] = [0];
    if !path_join(root, rn, "encodes" as &const byte, 7, &edir[0: 512],
        &el[0]) {
        return 86;
    }
    _ = mkdir_p(&edir[0], el[0]);
    var outp: [byte: 512] = [0: 512];
    var on: [usize: 1] = [0];
    if !path_join(&edir[0], el[0], name, nn, &outp[0: 512], &on[0]) {
        return 86;
    }
    var cmd: [byte: 2048] = [0: 2048];
    var w: usize = build_mix_cmd(&va[0], val[0], &aa[0], aal[0],
        &outp[0], on[0], &cmd[0: 2048]);
    if w + 1 >= 2048 {
        return 86;
    }
    cmd[w] = 0 as byte;
    _ = system(&cmd[0]);
    const fd: i32 = sys_open(&outp[0], 0 as i32, 0) catch {
        return 91;
    };
    const end: i64 = sys_lseek(fd, 0 as i64, 2 as i32) catch {
        -1 as i64;
    };
    _ = sys_close(fd) catch { 0 as i32; };
    if end <= 0 {
        return 91;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"output\":\"encodes/" as &const byte);
    ow = ow + j_put_raw(out, ow, name, nn);
    ow = ow + j_put(out, ow, "\",\"size\":" as &const byte);
    ow = ow + j_put_i64(out, ow, end);
    ow = ow + j_put(out, ow, "}" as &const byte);
    out_len[0] = ow;
    return 0;
}

// ---- loudnorm 两遍：先测，再带 measured_* 归一 ----

struct LoudMeas {
    i: [byte: 32],
    il: usize,
    tp: [byte: 32],
    tpl: usize,
    lra: [byte: 32],
    lral: usize,
    th: [byte: 32],
    thl: usize,
    off: [byte: 32],
    offl: usize,
}

fn num_str_ok(p: &const byte, n: usize) bool {
    if n == 0 || n > 24 {
        return false;
    }
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        const digit: bool = c >= 48 as byte && c <= 57 as byte;
        if !digit && c != 45 as byte && c != 46 as byte && c != 43 as byte {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn meas_field(buf: &const byte, n: usize, key: &const byte, out: &[byte],
    out_len: &usize) bool {
    if !j_str(buf, n, key, out, out_len) {
        return false;
    }
    return num_str_ok(out, out_len[0]);
}

fn build_loud1_cmd(inp: &const byte, inn: usize, tmp: &const byte,
    tn: usize, cmd: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(cmd, w, "ffmpeg -hide_banner -nostats -i " as &const byte);
    w = quote_into(cmd, w, inp, inn);
    w = w + j_put(cmd, w, " -af " as &const byte);
    w = w + j_put(cmd, w, "loudnorm=I=-16:TP=-1.5:LRA=11:" as &const byte);
    w = w + j_put(cmd, w, "print_format=json -f null - 2> " as &const byte);
    w = quote_into(cmd, w, tmp, tn);
    return w;
}

fn build_loud2_cmd(inp: &const byte, inn: usize, outp: &const byte,
    on: usize, m: &const LoudMeas, cmd: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(cmd, w, "ffmpeg -v error -y -i " as &const byte);
    w = quote_into(cmd, w, inp, inn);
    w = w + j_put(cmd, w, " -c:v copy -af " as &const byte);
    w = w + j_put(cmd, w, "loudnorm=I=-16:TP=-1.5:LRA=11" as &const byte);
    w = w + j_put(cmd, w, ":measured_I=" as &const byte);
    w = w + j_put_raw(cmd, w, &m.i[0], m.il);
    w = w + j_put(cmd, w, ":measured_TP=" as &const byte);
    w = w + j_put_raw(cmd, w, &m.tp[0], m.tpl);
    w = w + j_put(cmd, w, ":measured_LRA=" as &const byte);
    w = w + j_put_raw(cmd, w, &m.lra[0], m.lral);
    w = w + j_put(cmd, w, ":measured_thresh=" as &const byte);
    w = w + j_put_raw(cmd, w, &m.th[0], m.thl);
    w = w + j_put(cmd, w, ":offset=" as &const byte);
    w = w + j_put_raw(cmd, w, &m.off[0], m.offl);
    w = w + j_put(cmd, w, ":linear=true -c:a aac " as &const byte);
    w = w + j_put(cmd, w, "-b:a 128k -ar 32000 " as &const byte);
    w = quote_into(cmd, w, outp, on);
    w = w + j_put(cmd, w, " 2>/dev/null" as &const byte);
    return w;
}

export fn provider_loudnorm_file(root: &const byte, rn: usize,
    rel: &const byte, reln: usize, name: &const byte, nn: usize,
    out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !probe_path_ok(rel, reln) || !out_name_ok(name, nn)
        || !sh_safe(root, rn) {
        return 86;
    }
    var abs: [byte: 512] = [0: 512];
    var an: [usize: 1] = [0];
    if !path_join(root, rn, rel, reln, &abs[0: 512], &an[0]) {
        return 86;
    }
    var tmp: [byte: 512] = [0: 512];
    var tn: [usize: 1] = [0];
    if !path_join(root, rn, ".loud.tmp" as &const byte, 9, &tmp[0: 512],
        &tn[0]) {
        return 86;
    }
    var cmd: [byte: 4096] = [0: 4096];
    var w: usize = build_loud1_cmd(&abs[0], an[0], &tmp[0], tn[0],
        &cmd[0: 4096]);
    cmd[w] = 0 as byte;
    _ = system(&cmd[0]);
    var buf: [byte: 4096] = [0: 4096];
    var bl: [usize: 1] = [0];
    const ok: bool = read_file(root, rn, ".loud.tmp" as &const byte, 9,
        &buf[0], 4096, &bl[0]);
    _ = unlink(&tmp[0]);
    if !ok {
        return 91;
    }
    var m: LoudMeas = LoudMeas{ i: [0: 32], il: 0, tp: [0: 32], tpl: 0,
        lra: [0: 32], lral: 0, th: [0: 32], thl: 0, off: [0: 32], offl: 0 };
    if !meas_field(&buf[0], bl[0], "input_i" as &const byte, &m.i[0: 32],
        &m.il) || !meas_field(&buf[0], bl[0], "input_tp" as &const byte,
        &m.tp[0: 32], &m.tpl) || !meas_field(&buf[0], bl[0],
        "input_lra" as &const byte, &m.lra[0: 32], &m.lral)
        || !meas_field(&buf[0], bl[0], "input_thresh" as &const byte,
        &m.th[0: 32], &m.thl) || !meas_field(&buf[0], bl[0],
        "target_offset" as &const byte, &m.off[0: 32], &m.offl) {
        return 91;
    }
    var edir: [byte: 512] = [0: 512];
    var el: [usize: 1] = [0];
    if !path_join(root, rn, "encodes" as &const byte, 7, &edir[0: 512],
        &el[0]) {
        return 86;
    }
    _ = mkdir_p(&edir[0], el[0]);
    var outp: [byte: 512] = [0: 512];
    var on: [usize: 1] = [0];
    if !path_join(&edir[0], el[0], name, nn, &outp[0: 512], &on[0]) {
        return 86;
    }
    w = build_loud2_cmd(&abs[0], an[0], &outp[0], on[0], &m,
        &cmd[0: 4096]);
    cmd[w] = 0 as byte;
    _ = system(&cmd[0]);
    const fd: i32 = sys_open(&outp[0], 0 as i32, 0) catch {
        return 91;
    };
    const end: i64 = sys_lseek(fd, 0 as i64, 2 as i32) catch {
        -1 as i64;
    };
    _ = sys_close(fd) catch { 0 as i32; };
    if end <= 0 {
        return 91;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"output\":\"encodes/" as &const byte);
    ow = ow + j_put_raw(out, ow, name, nn);
    ow = ow + j_put(out, ow, "\",\"size\":" as &const byte);
    ow = ow + j_put_i64(out, ow, end);
    ow = ow + j_put(out, ow, "}" as &const byte);
    out_len[0] = ow;
    return 0;
}

// ---- 媒体输入探测：ffprobe 取首条视频流宽高与容器时长 ----

// 只接受数据根下的相对路径，拒绝绝对路径和 ".." 段
fn probe_path_ok(rel: &const byte, n: usize) bool {
    if n == 0 || rel[0] == 47 as byte {
        return false;
    }
    var i: usize = 0;
    while i < n {
        if rel[i] == 46 as byte && i + 1 < n && rel[i + 1] == 46 as byte {
            const before: bool = i == 0 || rel[i - 1] == 47 as byte;
            const after: bool = i + 2 >= n || rel[i + 2] == 47 as byte;
            if before && after {
                return false;
            }
        }
        i = i + 1;
    }
    return true;
}

fn sh_safe(p: &const byte, n: usize) bool {
    var i: usize = 0;
    while i < n {
        if p[i] == 39 as byte || p[i] == 10 as byte || p[i] == 13 as byte {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn quote_into(dst: &[byte], w0: usize, src: &const byte, n: usize) usize {
    var w: usize = w0;
    if w < dst.len {
        dst[w] = 39 as byte;
        w = w + 1;
    }
    var i: usize = 0;
    while i < n && w < dst.len {
        dst[w] = src[i];
        w = w + 1;
        i = i + 1;
    }
    if w < dst.len {
        dst[w] = 39 as byte;
        w = w + 1;
    }
    return w;
}

fn build_probe_cmd(abs: &const byte, an: usize, tmp: &const byte, tn: usize,
    ver: &const byte, vn: usize, fver: &const byte, fn2: usize,
    cmd: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(cmd, w, "ffprobe -v error " as &const byte);
    w = w + j_put(cmd, w, "-select_streams v:0 " as &const byte);
    w = w + j_put(cmd, w, "-show_entries stream=width,height " as &const byte);
    w = w + j_put(cmd, w, "-of csv=p=0:s=, " as &const byte);
    w = quote_into(cmd, w, abs, an);
    w = w + j_put(cmd, w, " > " as &const byte);
    w = quote_into(cmd, w, tmp, tn);
    w = w + j_put(cmd, w, " 2>/dev/null ; ffprobe -v error " as &const byte);
    w = w + j_put(cmd, w, "-show_entries format=duration " as &const byte);
    w = w + j_put(cmd, w, "-of default=nw=1:nk=1 " as &const byte);
    w = quote_into(cmd, w, abs, an);
    w = w + j_put(cmd, w, " >> " as &const byte);
    w = quote_into(cmd, w, tmp, tn);
    w = w + j_put(cmd, w, " 2>/dev/null ; ffprobe -version > " as &const byte);
    w = quote_into(cmd, w, ver, vn);
    w = w + j_put(cmd, w, " 2>/dev/null ; ffmpeg -version > " as &const byte);
    w = quote_into(cmd, w, fver, fn2);
    w = w + j_put(cmd, w, " 2>/dev/null" as &const byte);
    return w;
}

fn parse_u64_at(buf: &const byte, st: usize, n: usize) i64 {
    var v: i64 = 0;
    var i: usize = 0;
    while i < n {
        const c: byte = buf[st + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}

// "1.234567" → 1234；非法/负数返回 0
fn millis_at(buf: &const byte, st: usize, n: usize) i64 {
    var i: usize = 0;
    var sec: i64 = 0;
    var nd: usize = 0;
    while i < n {
        const c: byte = buf[st + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        sec = sec *| 10;
        sec = sec +| ((c as i64) -| 48);
        nd = nd + 1;
        i = i + 1;
    }
    if nd == 0 || i >= n || buf[st + i] != 46 as byte {
        return 0;
    }
    i = i + 1;
    var ms: i64 = 0;
    var div: i64 = 100;
    var k: usize = 0;
    while i < n && k < 3 {
        const c: byte = buf[st + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        ms = ms +| (((c as i64) -| 48) *| div);
        div = div / 10;
        k = k + 1;
        i = i + 1;
    }
    return sec *| 1000 +| ms;
}

// 版本与参数：ffprobe -version 首行 + 实际探测参数
fn put_probe_meta(out: &[byte], w0: usize, vb: &const byte, vl: usize,
    fb: &const byte, fl: usize) usize {
    var w: usize = w0;
    w = w + j_put(out, w, ",\"tool\":\"ffprobe\"" as &const byte);
    w = w + j_put(out, w, ",\"args\":\"-v error " as &const byte);
    w = w + j_put(out, w, "-select_streams v:0 " as &const byte);
    w = w + j_put(out, w, "-show_entries stream=width,height " as &const byte);
    w = w + j_put(out, w, "-of csv=p=0:s=,\"" as &const byte);
    w = w + j_put(out, w, ",\"version\":" as &const byte);
    var n: usize = 0;
    while n < vl && n < 64 && vb[n] != 10 as byte {
        n = n + 1;
    }
    w = w + j_put_str(out, w, vb, n);
    w = w + j_put(out, w, ",\"ffmpeg_version\":" as &const byte);
    var m: usize = 0;
    while m < fl && m < 64 && fb[m] != 10 as byte {
        m = m + 1;
    }
    w = w + j_put_str(out, w, fb, m);
    return w;
}

// 探测数据根下的媒体文件；成功写宽高与时长
export fn provider_probe_file(root: &const byte, rn: usize, rel: &const byte,
    reln: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !probe_path_ok(rel, reln) || !sh_safe(root, rn) || !sh_safe(rel, reln) {
        return 86;
    }
    var abs: [byte: 512] = [0: 512];
    var an: [usize: 1] = [0];
    if !path_join(root, rn, rel, reln, &abs[0: 512], &an[0]) {
        return 86;
    }
    var tmp: [byte: 512] = [0: 512];
    var tn: [usize: 1] = [0];
    if !path_join(root, rn, ".probe.tmp" as &const byte, 10, &tmp[0: 512],
        &tn[0]) {
        return 86;
    }
    var ver: [byte: 512] = [0: 512];
    var vn: [usize: 1] = [0];
    if !path_join(root, rn, ".probe.ver" as &const byte, 10, &ver[0: 512],
        &vn[0]) {
        return 86;
    }
    var fver: [byte: 512] = [0: 512];
    var fn2: [usize: 1] = [0];
    if !path_join(root, rn, ".probe.fver" as &const byte, 11,
        &fver[0: 512], &fn2[0]) {
        return 86;
    }
    var cmd: [byte: 2048] = [0: 2048];
    var w: usize = build_probe_cmd(&abs[0], an[0], &tmp[0], tn[0],
        &ver[0], vn[0], &fver[0], fn2[0], &cmd[0: 2048]);
    if w + 1 >= 2048 {
        return 86;
    }
    cmd[w] = 0 as byte;
    _ = system(&cmd[0]);
    var buf: [byte: 2048] = [0: 2048];
    var bl: [usize: 1] = [0];
    const ok: bool = read_file(root, rn, ".probe.tmp" as &const byte, 10,
        &buf[0], 2048, &bl[0]);
    _ = unlink(&tmp[0]);
    var vbuf: [byte: 512] = [0: 512];
    var vbl: [usize: 1] = [0];
    _ = read_file(root, rn, ".probe.ver" as &const byte, 10, &vbuf[0], 512,
        &vbl[0]);
    _ = unlink(&ver[0]);
    var fbuf: [byte: 512] = [0: 512];
    var fbl: [usize: 1] = [0];
    _ = read_file(root, rn, ".probe.fver" as &const byte, 11, &fbuf[0], 512,
        &fbl[0]);
    _ = unlink(&fver[0]);
    if !ok || bl[0] < 3 {
        return 87;
    }
    var nl: usize = 0;
    while nl < bl[0] && buf[nl] != 10 as byte {
        nl = nl + 1;
    }
    var comma: usize = 0;
    while comma < nl && buf[comma] != 44 as byte {
        comma = comma + 1;
    }
    if comma == 0 || comma >= nl {
        return 87;
    }
    const vw: i64 = parse_u64_at(&buf[0], 0, comma);
    const vh: i64 = parse_u64_at(&buf[0], comma + 1, nl - comma - 1);
    if vw <= 0 || vh <= 0 || nl + 1 >= bl[0] {
        return 87;
    }
    var e2: usize = nl + 1;
    while e2 < bl[0] && buf[e2] != 10 as byte {
        e2 = e2 + 1;
    }
    const dur: i64 = millis_at(&buf[0], nl + 1, e2 - nl - 1);
    if dur <= 0 {
        return 87;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"width\":" as &const byte);
    ow = ow + j_put_i64(out, ow, vw);
    ow = ow + j_put(out, ow, ",\"height\":" as &const byte);
    ow = ow + j_put_i64(out, ow, vh);
    ow = ow + j_put(out, ow, ",\"duration_ms\":" as &const byte);
    ow = ow + j_put_i64(out, ow, dur);
    ow = put_probe_meta(out, ow, &vbuf[0], vbl[0], &fbuf[0], fbl[0]);
    ow = ow + j_put(out, ow, "}" as &const byte);
    out_len[0] = ow;
    return 0;
}

// 能力表：能力 = 允许的镜头数上限 + 禁用动作词
export fn provider_capabilities(out: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(out, w, "{\"provider\":" as &const byte);
    w = w + j_put_str(out, w, PROVIDER_ID, b_len(PROVIDER_ID));
    w = w + j_put(out, w, ",\"capability_version\":" as &const byte);
    w = w + j_put_str(out, w, CAP_VERSION, b_len(CAP_VERSION));
    w = w + j_put(out, w, ",\"max_shots\":" as &const byte);
    w = w + j_put_i64(out, w, 64);
    w = w + j_put(out, w, ",\"max_shot_ms\":" as &const byte);
    w = w + j_put_i64(out, w, 30000);
    w = w + j_put(out, w,
        ",\"forbidden_actions\":[\"跳切\",\"爆炸\"]" as &const byte);
    w = w + j_put(out, w,
        ",\"supports\":[\"anchor\",\"hard_cut\"]" as &const byte);
    w = emit_media(out, w);
    w = w + j_put(out, w, "}" as &const byte);
    return w;
}

fn has_sub(p: &const byte, n: usize, w: &const byte, wn: usize) bool {
    if wn == 0 || n < wn {
        return false;
    }
    var i: usize = 0;
    while i + wn <= n {
        var k: usize = 0;
        var same: bool = true;
        while k < wn {
            if p[i + k] != w[k] {
                same = false;
                break;
            }
            k = k + 1;
        }
        if same {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 这个动作能不能演（能力表）
export fn provider_can_render(action: &const byte, n: usize) bool {
    if n == 0 {
        return true;   // 空动作 = 对白镜头，不需要动作能力
    }
    if has_sub(action, n, "跳切" as &const byte, 6)
        || has_sub(action, n, "爆炸" as &const byte, 6) {
        return false;
    }
    return true;
}

fn asset_dir(root: &const byte, rn: usize, id: &const byte, idn: usize,
    out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, "assets" as &const byte, 6, out, out_len);
}

// mock 渲染：写一个确定性占位文件（同一个镜头两次渲染字节一致）
export fn provider_render(root: &const byte, rn: usize, id: &const byte,
    idn: usize, board_ver: i64, shot_no: i64, action: &const byte,
    an: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !provider_can_render(action, an) {
        return 98;
    }
    var adir: [byte: 512] = [0: 512];
    var al: usize = 0;
    if !asset_dir(root, rn, id, idn, &adir[0: 512], &al) {
        return 94;
    }
    // 按分镜版本分目录：不同集的分镜版本不同，同号镜头不会互相覆盖
    var vn: [byte: 16] = [0: 16];
    var vnn: usize = 0;
    vnn = vnn + j_put_raw(&vn[0: 16], vnn, "v" as &const byte, 1);
    vnn = vnn + j_put_i64(&vn[0: 16], vnn, board_ver);
    var sdir: [byte: 512] = [0: 512];
    var sl: usize = 0;
    if !path_join(&adir[0], al, &vn[0], vnn, &sdir[0: 512], &sl) {
        return 94;
    }
    if !mkdir_p(&sdir[0], sl) {
        return 94;
    }
    // 文件内容 = 固定头 + shot_no + action 的 SHA-256（重复 8 遍 = 256B）
    var seed: [byte: 512] = [0: 512];
    var sw: usize = 0;
    sw = sw + j_put_raw(&seed[0: 512], sw, "mock-video:" as &const byte, 11);
    sw = sw + j_put_i64(&seed[0: 512], sw, shot_no);
    sw = sw + j_put_raw(&seed[0: 512], sw, action, an);
    var hex: [byte: 64] = [0: 64];
    var hl: [usize: 1] = [0];
    if !sha256_hex(&seed[0], sw, &hex[0: 64], &hl[0]) {
        return 94;
    }
    var body: [byte: 256] = [0: 256];
    var i: usize = 0;
    while i < 256 {
        body[i] = hex[i - (i / 64) * 64];
        i = i + 1;
    }
    var nm: [byte: 32] = [0: 32];
    var nn: usize = 0;
    nn = nn + j_put_raw(&nm[0: 32], nn, "shot_" as &const byte, 5);
    nn = nn + j_put_i64(&nm[0: 32], nn, shot_no);
    nn = nn + j_put_raw(&nm[0: 32], nn, ".mp4" as &const byte, 4);
    if !write_atomic(&sdir[0], sl, &nm[0], nn, &body[0], 256) {
        return 94;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"shot_no\":" as &const byte);
    w = w + j_put_i64(out, w, shot_no);
    w = w + j_put(out, w, ",\"asset\":" as &const byte);
    w = w + j_put_str(out, w, &nm[0], nn);
    w = w + j_put(out, w, ",\"size\":256,\"sha256\":\"" as &const byte);
    w = w + j_put_raw(out, w, &hex[0], hl[0]);
    w = w + j_put(out, w, "\"}" as &const byte);
    out_len[0] = w;
    return 0;
}
