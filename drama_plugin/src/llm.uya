// drama_plugin/src/llm.uya — LLM Provider 适配层（P5 传输层 + Adapter 骨架）
//
// 配置来源是**文件**不是环境变量（MCP 子进程只拿到白名单 env，见
// P0_FINDINGS §2.2）：<root>/llm.json
//   {"provider":"mock|openai","base_url":"127.0.0.1","port":8080,
//    "tls":false,"path":"/v1/chat/completions","model":"m",
//    "timeout_ms":3000,"max_retries":1}
//
// 支持的 Provider：
//   * mock   —— 确定性输出，不联网；单测与离线环境用
//   * openai —— 任何 OpenAI 兼容的 /chat/completions（含本机网关/ollama）
//
// 返回码：0 成功 70 连接失败 71 写失败 72 超时/读失败 73 响应格式不认识
//         75 DNS 失败 80 配置缺失/非法 81 Provider 不支持
//         82 HTTP 非 200 83 模型输出不是 JSON 84 结构化校验失败

use libc.syscall;
use libc.unistd;

const LLM_BUF: usize = 32768;
const CFG_FILE: &const byte = "llm.json" as &const byte;

struct LlmConfig {
    is_mock: bool,
    host: [byte: 128],
    host_len: usize,
    port: u16,
    use_tls: bool,
    path: [byte: 128],
    path_len: usize,
    model: [byte: 64],
    model_len: usize,
    timeout_ms: i32,
    max_retries: i32,
    api_key: [byte: 256],
    api_key_len: usize,
}

// 默认 = mock、不联网：没配置也能跑（离线环境 / 单测）
fn cfg_default() LlmConfig {
    return LlmConfig{ is_mock: true, host: [0: 128], host_len: 0,
        port: 8080, use_tls: false, path: [0: 128], path_len: 0,
        model: [0: 64], model_len: 0, timeout_ms: 3000, max_retries: 1,
        api_key: [0: 256], api_key_len: 0 };
}

fn get_str_or(buf: &const byte, n: usize, key: &const byte,
    out: &[byte], out_len: &usize) bool {
    return j_str(buf, n, key, out, out_len);
}

fn get_int_or(buf: &const byte, n: usize, key: &const byte, dflt: i64) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    const k: byte = j_span(buf, n, key, &st[0], &ln[0]);
    if k == 0 as byte || k == 34 as byte || k == 123 as byte {
        return dflt;
    }
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}

// 读 <root>/llm.json；没有就用 mock 默认
export fn llm_config_load(root: &const byte, rn: usize,
    c: &LlmConfig) i32 {
    c[0] = cfg_default();
    var buf: [byte: 4096] = [0: 4096];
    var bl: usize = 0;
    if !read_file(root, rn, CFG_FILE, b_len(CFG_FILE), &buf[0], 4096, &bl) {
        return 0;   // 没有配置 = mock，可离线跑
    }
    var prov: [byte: 32] = [0: 32];
    var pl: usize = 0;
    if get_str_or(&buf[0], bl, "provider" as &const byte, &prov[0: 32], &pl) {
        if b_eq(&prov[0], pl, "mock" as &const byte) {
            c.is_mock = true;
        } else if b_eq(&prov[0], pl, "openai" as &const byte) {
            c.is_mock = false;
        } else {
            return 81;
        }
    }
    _ = get_str_or(&buf[0], bl, "base_url" as &const byte, &c.host[0: 128],
        &c.host_len);
    _ = get_str_or(&buf[0], bl, "path" as &const byte, &c.path[0: 128],
        &c.path_len);
    _ = get_str_or(&buf[0], bl, "model" as &const byte, &c.model[0: 64],
        &c.model_len);
    const port: i64 = get_int_or(&buf[0], bl, "port" as &const byte, 8080);
    c.port = port as! u16 catch { 8080 as u16; };
    const tls: i64 = get_int_or(&buf[0], bl, "tls" as &const byte, 0);
    c.use_tls = tls != 0;
    const tmo: i64 = get_int_or(&buf[0], bl, "timeout_ms" as &const byte,
        3000);
    c.timeout_ms = tmo as! i32 catch { 3000 as i32; };
    _ = get_str_or(&buf[0], bl, "api_key" as &const byte,
        &c.api_key[0: 256], &c.api_key_len);
    const retries: i64 = get_int_or(&buf[0], bl, "max_retries" as &const byte,
        1);
    c.max_retries = retries as! i32 catch { 1 as i32; };
    if !c.is_mock && (c.host_len == 0 || c.path_len == 0) {
        return 80;
    }
    return 0;
}

// ---- 请求体与响应解析 ----

// 组 OpenAI 兼容的 chat/completions 请求体（messages 只有一条 user）
fn build_body(c: &const LlmConfig, prompt: &const byte, pn: usize,
    out: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(out, w, "{\"model\":" as &const byte);
    w = w + j_put_str(out, w, &c.model[0], c.model_len);
    w = w + j_put(out, w, ",\"temperature\":0," as &const byte);
    w = w + j_put(out, w,
        "\"messages\":[{\"role\":\"user\",\"content\":" as &const byte);
    w = w + j_put_str(out, w, prompt, pn);
    w = w + j_put(out, w, "}]}" as &const byte);
    return w;
}

// JSON 字符串反转义（只处理 OpenAI 会用的那几种）
fn copy_unescaped(src: &const byte, n: usize, out: &[byte],
    out_len: &usize) bool {
    var i: usize = 0;
    var w: usize = 0;
    while i < n && w < out.len {
        const c: byte = src[i];
        if c != 92 as byte {
            out[w] = c;
            w = w + 1;
            i = i + 1;
        } else if i + 1 < n {
            const nx: byte = src[i + 1];
            var rep: byte = nx;
            if nx == 110 as byte {
                rep = 10 as byte;
            } else if nx == 116 as byte {
                rep = 9 as byte;
            } else if nx == 114 as byte {
                rep = 13 as byte;
            }
            out[w] = rep;
            w = w + 1;
            i = i + 2;
        } else {
            break;
        }
    }
    out_len[0] = w;
    return w > 0;
}

// 从响应里取 choices[0].message.content（OpenAI 兼容形状）
fn extract_content(buf: &[byte], n: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    var cs: [usize: 1] = [0];
    var cl: [usize: 1] = [0];
    if j_span(buf, n, "choices" as &const byte, &cs[0], &cl[0])
        != 91 as byte {
        return 73;
    }
    var is0: [usize: 1] = [0];
    var il0: [usize: 1] = [0];
    if !j_arr_item(&buf[cs[0]], cl[0], 0, &is0[0], &il0[0]) {
        return 73;
    }
    const item: &const byte = &buf[cs[0] + is0[0]];
    var ms: [usize: 1] = [0];
    var ml: [usize: 1] = [0];
    if j_span(item, il0[0], "message" as &const byte, &ms[0], &ml[0])
        != 123 as byte {
        return 73;
    }
    const msg: &const byte = &item[ms[0]];
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    const k: byte = j_span(msg, ml[0], "content" as &const byte,
        &st[0], &ln[0]);
    if k != 34 as byte || ln[0] < 3 {
        return 73;
    }
    if !copy_unescaped(&msg[st[0] + 1], ln[0] - 2, out, out_len) {
        return 73;
    }
    return 0;
}

// 结构化输出校验：剧本必须是对象且带 scenes 数组
export fn llm_validate_screenplay(buf: &const byte, n: usize) i32 {
    if n == 0 {
        return 83;
    }
    // 第一层：模型返回的 content 本身得是 JSON 对象
    var s0: usize = 0;
    while s0 < n && (buf[s0] == 32 as byte || buf[s0] == 10 as byte) {
        s0 = s0 + 1;
    }
    if s0 >= n || buf[s0] != 123 as byte {
        return 83;
    }
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, "scenes" as &const byte, &st[0], &ln[0]) != 91 as byte {
        return 84;
    }
    var ts: [usize: 1] = [0];
    var tl: [usize: 1] = [0];
    if j_span(buf, n, "title" as &const byte, &ts[0], &tl[0]) != 34 as byte {
        return 84;
    }
    return 0;
}

// mock Provider：确定性输出，形状与真实模型一致
fn mock_response(out: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(out, w,
        "{\"title\":\"mock-episode\"," as &const byte);
    w = w + j_put(out, w,
        "\"hook\":\"冰箱里的遥控器是谁放的？\"," as &const byte);
    w = w + j_put(out, w, "\"scenes\":[" as &const byte);
    w = w + j_put(out, w, "{\"no\":1," as &const byte);
    w = w + j_put(out, w,
        "\"action\":\"爸爸把遥控器放回茶几。\"," as &const byte);
    w = w + j_put(out, w,
        "\"dialogue\":[{\"who\":\"dad\"," as &const byte);
    w = w + j_put(out, w,
        "\"line\":\"谁把冰箱门开着？\"}]}," as &const byte);
    w = w + j_put(out, w, "{\"no\":2," as &const byte);
    w = w + j_put(out, w,
        "\"action\":\"孩子把遥控器塞进冰箱\"," as &const byte);
    w = w + j_put(out, w, "\"dialogue\":[]}" as &const byte);
    w = w + j_put(out, w, "]," as &const byte);
    w = w + j_put(out, w,
        "\"candidate_events\":[{\"type\":\"scene.define\"," as &const byte);
    w = w + j_put(out, w,
        "\"scene\":\"kitchen\",\"time_of_day\":\"night\"}," as &const byte);
    w = w + j_put(out, w,
        "{\"type\":\"timeline.advance\",\"minutes\":5}]}" as &const byte);
    return w;
}

// 一次调用（含重试）；out 是模型返回的 content（不是 HTTP 体）
export fn llm_complete(root: &const byte, rn: usize, prompt: &const byte,
    pn: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var c: LlmConfig = cfg_default();
    const crc: i32 = llm_config_load(root, rn, &c);
    if crc != 0 {
        return crc;
    }
    if c.is_mock {
        out_len[0] = mock_response(out);
        return 0;
    }
    var body: [byte: 8192] = [0: 8192];
    const bn: usize = build_body(&c, prompt, pn, &body[0: 8192]);
    var attempt: i32 = 0;
    var last: i32 = 72;
    while attempt <= c.max_retries {
        last = llm_once(&c, &body[0], bn, out, out_len);
        if last == 0 {
            return 0;
        }
        // 只有网络类错误才重试；4xx/解析错误重试没意义
        if last != 70 && last != 71 && last != 72 && last != 75 {
            return last;
        }
        attempt = attempt + 1;
    }
    return last;
}

fn llm_once(c: &const LlmConfig, body: &const byte, bn: usize,
    out: &[byte], out_len: &usize) i32 {
    var resp: &byte = malloc(LLM_BUF) as &byte;
    defer { free(resp as &void); }
    if (resp as usize) == 0 {
        return 72;
    }
    var rl: [usize: 1] = [0];
    var status: [i32: 1] = [0];
    var hdr: [usize: 1] = [0];
    const rc: i32 = httpc_post(&c.host[0], c.host_len, c.port, c.use_tls,
        &c.path[0], c.path_len, body, bn, &c.api_key[0], c.api_key_len,
        c.timeout_ms,
        &resp[0: LLM_BUF], &rl[0], &status[0], &hdr[0]);
    if rc != 0 {
        return rc;
    }
    if status[0] != 200 {
        return 82;
    }
    if hdr[0] >= rl[0] {
        return 73;
    }
    const body_n: usize = rl[0] - hdr[0];
    return extract_content(&resp[hdr[0]: LLM_BUF], body_n, out, out_len);
}
