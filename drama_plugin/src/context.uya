// drama_plugin/src/context.uya — 生成前上下文组装（P5 第三段）
//
// 目标（DESIGN §7.2）：给模型的材料必须**有来源、可裁剪、可复现**。
//   * 来源 ID：bible:v<N>、canon:r<R>、summary:e<N>——回写进上下文本身；
//   * 材料优先级：Bible 冻结口径 > Canon 现状 > 最近摘要 > 其余；
//   * 裁剪：超出 max_bytes 时先丢摘要、再丢道具/场景细节，最后截断，
//     并在 `truncated` 里说明丢了什么。
//
// 输出形状：
//   {"project_id":"p_…","bible_version":2,"canon_revision":3,
//    "characters":[{"name":…,"scene":…,"knows":…}],
//    "scenes":[{"name":…,"time_of_day":…,"variant":…}],
//    "props":[{"name":…,"holder":…,"scene":…}],
//    "promises":[{"id":…,"state":"open"}],
//    "recent_summaries":[{"episode":1,"title":…,"hook":…}],
//    "sources":["bible:v2","canon:r3","summary:e1"],
//    "truncated":["summaries"]}
//
// 返回码：0 成功 50 ID 非法 94 读失败

use libc.syscall;
use libc.unistd;

const CTX_BUF: usize = 16384;
const SUMMARY_MAX: usize = 5;

// Bible 当前版本号（没有就 0）
fn bible_ver(root: &const byte, rn: usize, id: &const byte,
    idn: usize) i64 {
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return 0;
    }
    var dir: [byte: 512] = [0: 512];
    var dl0: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl0) {
        return 0;
    }
    if !path_join(&dir[0], dl0, "bible" as &const byte, 5,
        &dpath[0: 512], &dl) {
        return 0;
    }
    var buf: [byte: 128] = [0: 128];
    var bl: usize = 0;
    if !read_file(&dpath[0], dl, "current.json" as &const byte, 12,
        &buf[0], 128, &bl) {
        return 0;
    }
    return num_at(&buf[0], bl, "version" as &const byte);
}

fn num_at(buf: &const byte, n: usize, key: &const byte) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return 0;
    }
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}

// 项目目录
fn proj_dir2(root: &const byte, rn: usize, id: &const byte, idn: usize,
    out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    return path_join(&pdir[0], pdl, id, idn, out, out_len);
}

// 最近 N 条摘要（summaries.jsonl 的尾部）
fn put_summaries(buf: &const byte, n: usize, out: &[byte], w0: usize,
    clip: &bool) usize {
    var w: usize = w0;
    // 收集每行的起止
    var starts: [usize: SUMMARY_MAX] = [0: SUMMARY_MAX];
    var ends: [usize: SUMMARY_MAX] = [0: SUMMARY_MAX];
    var cnt: usize = 0;
    var i: usize = 0;
    var ls: usize = 0;
    while i <= n {
        if i == n || buf[i] == 10 as byte {
            if i > ls {
                // 环形保留最后 SUMMARY_MAX 条
                if cnt < SUMMARY_MAX {
                    starts[cnt] = ls;
                    ends[cnt] = i;
                    cnt = cnt + 1;
                } else {
                    var k: usize = 1;
                    while k < SUMMARY_MAX {
                        starts[k - 1] = starts[k];
                        ends[k - 1] = ends[k];
                        k = k + 1;
                    }
                    starts[SUMMARY_MAX - 1] = ls;
                    ends[SUMMARY_MAX - 1] = i;
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }
    var j: usize = 0;
    while j < cnt {
        if j > 0 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = w + j_put_raw(out, w, &buf[starts[j]], ends[j] - starts[j]);
        j = j + 1;
    }
    _ = clip;
    return w;
}

// 把 canon.json 里的一串数组原样拷进上下文（带字段裁剪留给 P6）
fn put_canon_array(src: &const byte, n: usize, key: &const byte,
    out: &[byte], w0: usize) usize {
    var w: usize = w0;
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(src, n, key, &ss[0], &sl[0]) != 91 as byte {
        w = w + j_put(out, w, "[]" as &const byte);
        return w;
    }
    w = w + j_put_raw(out, w, &src[ss[0]], sl[0]);
    return w;
}

// 未回收的承诺（只留 open）
fn put_open_promises(src: &const byte, n: usize, out: &[byte],
    w0: usize) usize {
    var w: usize = w0;
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(src, n, "promises" as &const byte, &ss[0], &sl[0])
        != 91 as byte {
        w = w + j_put(out, w, "[]" as &const byte);
        return w;
    }
    w = w + j_put(out, w, "[" as &const byte);
    var idx: usize = 0;
    var first: bool = true;
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&src[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const it: &const byte = &src[ss[0] + es[0]];
        var st: [byte: 16] = [0: 16];
        var stl: usize = 0;
        if j_str(it, el[0], "state" as &const byte, &st[0: 16], &stl)
            && stl == 4 {
            if !first {
                w = w + j_put(out, w, "," as &const byte);
            }
            w = w + j_put_raw(out, w, it, el[0]);
            first = false;
        }
        idx = idx + 1;
    }
    w = w + j_put(out, w, "]" as &const byte);
    return w;
}

// 组装上下文；max_bytes 是软上限（超了就丢摘要并标 truncated）
export fn ctx_build(root: &const byte, rn: usize, id: &const byte,
    idn: usize, max_bytes: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 50;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !proj_dir2(root, rn, id, idn, &dir[0: 512], &dl) {
        return 94;
    }
    var canon: [byte: CTX_BUF] = [0: CTX_BUF];
    var cn: usize = 0;
    _ = read_file(&dir[0], dl, "canon.json" as &const byte, 10, &canon[0],
        CTX_BUF, &cn);
    var sums: [byte: CTX_BUF] = [0: CTX_BUF];
    var sn: usize = 0;
    _ = read_file(&dir[0], dl, "summaries.jsonl" as &const byte, 15,
        &sums[0], CTX_BUF, &sn);
    const bver: i64 = bible_ver(root, rn, id, idn);
    const crec: i64 = canon_revision(root, rn, id, idn);

    var w: usize = 0;
    w = w + j_put(out, w, "{\"project_id\":" as &const byte);
    w = w + j_put_str(out, w, id, idn);
    w = w + j_put(out, w, ",\"bible_version\":" as &const byte);
    w = w + j_put_i64(out, w, bver);
    w = w + j_put(out, w, ",\"canon_revision\":" as &const byte);
    w = w + j_put_i64(out, w, crec);
    w = w + j_put(out, w, ",\"characters\":" as &const byte);
    w = put_canon_array(&canon[0], cn, "characters" as &const byte, out, w);
    w = w + j_put(out, w, ",\"scenes\":" as &const byte);
    w = put_canon_array(&canon[0], cn, "scenes" as &const byte, out, w);
    w = w + j_put(out, w, ",\"props\":" as &const byte);
    w = put_canon_array(&canon[0], cn, "props" as &const byte, out, w);
    w = w + j_put(out, w, ",\"promises\":" as &const byte);
    w = put_open_promises(&canon[0], cn, out, w);
    // 来源 ID：让下游能追到材料出处
    w = w + j_put(out, w, ",\"sources\":[" as &const byte);
    w = w + j_put(out, w, "\"bible:v" as &const byte);
    w = w + j_put_i64(out, w, bver);
    w = w + j_put(out, w, "\",\"canon:r" as &const byte);
    w = w + j_put_i64(out, w, crec);
    w = w + j_put(out, w, "\"]" as &const byte);
    // 摘要按预算裁剪
    var truncated: bool = false;
    var probe: usize = w + 256 + sn;
    if probe > max_bytes {
        truncated = true;
        sn = 0;
    }
    w = w + j_put(out, w, ",\"recent_summaries\":[" as &const byte);
    if sn > 0 {
        w = put_summaries(&sums[0], sn, out, w, &truncated);
    }
    w = w + j_put(out, w, "],\"truncated\":" as &const byte);
    if truncated {
        w = w + j_put(out, w, "[\"summaries\"]}" as &const byte);
    } else {
        w = w + j_put(out, w, "[]}" as &const byte);
    }
    out_len[0] = w;
    return 0;
}

// 批准后追加一集摘要（append-only；行格式与 summary 解析一致）
export fn ctx_append_summary(root: &const byte, rn: usize, id: &const byte,
    idn: usize, line: &const byte, ln: usize) bool {
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !proj_dir2(root, rn, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    var old: [byte: CTX_BUF] = [0: CTX_BUF];
    var ol: usize = 0;
    _ = read_file(&dir[0], dl, "summaries.jsonl" as &const byte, 15,
        &old[0], CTX_BUF, &ol);
    var merged: [byte: CTX_BUF + 1024] = [0: CTX_BUF + 1024];
    if ol + ln + 1 > CTX_BUF + 1024 {
        return false;
    }
    var i: usize = 0;
    while i < ol {
        merged[i] = old[i];
        i = i + 1;
    }
    i = 0;
    while i < ln {
        merged[ol + i] = line[i];
        i = i + 1;
    }
    merged[ol + ln] = 10 as byte;
    return write_atomic(&dir[0], dl, "summaries.jsonl" as &const byte, 15,
        &merged[0], ol + ln + 1);
}
