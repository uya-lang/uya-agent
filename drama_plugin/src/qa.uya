// drama_plugin/src/qa.uya — 确定性 QA（P9 第一段）
//
// 只做**能确定性判定**的检查（AI 辅助的观感检查留到后面）：
//   剧本：title / hook 非空、scenes ≥1、每条对白有 who 与 line；
//   分镜：镜号连续、timeline 首尾相接、无空动作镜头、cut_type 合法、
//         Σ镜头时长 == 剧本时长（同一套口径）。
//
// 产出：qa/v<N>.json（不可变报告，带 content_hash 与逐条 issue）。
// 返回码：0 成功 90 剧本缺失/结构不对 96 分镜不存在 94 写失败

use libc.syscall;
use libc.unistd;

const QA_BUF: usize = 16384;
const QA_DIR: &const byte = "qa" as &const byte;
const ISSUE_MAX: usize = 32;

// 报告里的一条问题
struct Issue {
    code: [byte: 32],
    code_len: usize,
    detail: [byte: 128],
    detail_len: usize,
}

struct Report {
    issues: [Issue: ISSUE_MAX],
    n: usize,
    checked_shots: i64,
}

fn blank_report() Report {
    return Report{ issues: [Issue{ code: [0: 32], code_len: 0,
        detail: [0: 128], detail_len: 0 }: ISSUE_MAX], n: 0,
        checked_shots: 0 };
}

fn add_issue(r: &Report, code: &const byte, detail: &const byte) void {
    if r.n >= ISSUE_MAX {
        return;
    }
    var i: Issue = Issue{ code: [0: 32], code_len: 0,
        detail: [0: 128], detail_len: 0 };
    var l: usize = 0;
    _ = copy_to(code, b_len(code), &i.code[0: 32], &l);
    i.code_len = l;
    _ = copy_to(detail, b_len(detail), &i.detail[0: 128], &l);
    i.detail_len = l;
    r.issues[r.n] = i;
    r.n = r.n + 1;
}

// 剧本检查：结构 + 对白完整
export fn qa_screenplay(sp: &const byte, sn: usize, r: &Report) void {
    var ts: [usize: 1] = [0];
    var tl: [usize: 1] = [0];
    if j_span(sp, sn, "title" as &const byte, &ts[0], &tl[0]) != 34 as byte {
        add_issue(r, "QA_TITLE_MISSING" as &const byte,
            "screenplay has no title" as &const byte);
    }
    var hs: [usize: 1] = [0];
    var hl: [usize: 1] = [0];
    if j_span(sp, sn, "hook" as &const byte, &hs[0], &hl[0]) != 34 as byte {
        add_issue(r, "QA_HOOK_MISSING" as &const byte,
            "screenplay has no episode hook" as &const byte);
    }
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(sp, sn, "scenes" as &const byte, &ss[0], &sl[0]) != 91 as byte {
        add_issue(r, "QA_SCENES_MISSING" as &const byte,
            "screenplay has no scenes" as &const byte);
        return;
    }
    var idx: usize = 0;
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&sp[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sc: &const byte = &sp[ss[0] + es[0]];
        var ds: [usize: 1] = [0];
        var dl: [usize: 1] = [0];
        if j_span(sc, el[0], "dialogue" as &const byte, &ds[0],
            &dl[0]) == 91 as byte {
            qa_dialogue(sc, el[0], &sc[ds[0]], dl[0], r);
        }
        idx = idx + 1;
    }
}

fn qa_dialogue(sc: &const byte, scn: usize, arr: &const byte, an: usize,
    r: &Report) void {
    var j: usize = 0;
    while true {
        var ls: [usize: 1] = [0];
        var ll: [usize: 1] = [0];
        if !j_arr_item(arr, an, j, &ls[0], &ll[0]) {
            break;
        }
        const line: &const byte = &arr[ls[0]];
        var w: [byte: 32] = [0: 32];
        var wl: usize = 0;
        if !j_str(line, ll[0], "who" as &const byte, &w[0: 32], &wl)
            || wl == 0 {
            add_issue(r, "QA_LINE_NO_SPEAKER" as &const byte,
                "dialogue without who" as &const byte);
        }
        var xs: [usize: 1] = [0];
        var xl: [usize: 1] = [0];
        if j_span(line, ll[0], "line" as &const byte, &xs[0],
            &xl[0]) != 34 as byte || xl[0] < 3 {
            add_issue(r, "QA_LINE_EMPTY" as &const byte,
                "dialogue with empty text" as &const byte);
        }
        _ = sc;
        _ = scn;
        j = j + 1;
    }
}

// 分镜检查：镜号连续、timeline 相接、无空动作、Σ时长 == 期望
export fn qa_board(bd: &const byte, bn: usize, expect_ms: i64,
    r: &Report) void {
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(bd, bn, "shots" as &const byte, &ss[0], &sl[0]) != 91 as byte {
        add_issue(r, "QA_SHOTS_MISSING" as &const byte,
            "board has no shots" as &const byte);
        return;
    }
    var idx: usize = 0;
    var prev_out: i64 = 0;
    var sum: i64 = 0;
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&bd[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sh: &const byte = &bd[ss[0] + es[0]];
        const no: i64 = qa_num(sh, el[0], "sequence" as &const byte);
        const tin: i64 = qa_num(sh, el[0], "timeline_in" as &const byte);
        const tout: i64 = qa_num(sh, el[0], "timeline_out" as &const byte);
        const dur: i64 = qa_num(sh, el[0], "duration_ms" as &const byte);
        if no != (idx as i64) + 1 {
            add_issue(r, "QA_SEQ_GAP" as &const byte,
                "shot sequence not continuous" as &const byte);
        }
        if tin != prev_out {
            add_issue(r, "QA_TIMELINE_GAP" as &const byte,
                "timeline not contiguous" as &const byte);
        }
        if dur <= 0 {
            add_issue(r, "QA_SHOT_ZERO" as &const byte,
                "shot with non-positive duration" as &const byte);
        }
        var act: [byte: 256] = [0: 256];
        var al: usize = 0;
        _ = j_str(sh, el[0], "action" as &const byte, &act[0: 256], &al);
        var ln: [byte: 256] = [0: 256];
        var lnl: usize = 0;
        _ = j_str(sh, el[0], "line" as &const byte, &ln[0: 256], &lnl);
        if al == 0 && lnl == 0 {
            add_issue(r, "QA_SHOT_EMPTY" as &const byte,
                "shot has neither action nor line" as &const byte);
        }
        prev_out = tout;
        sum = sum +| dur;
        idx = idx + 1;
    }
    r.checked_shots = idx as i64;
    if expect_ms > 0 && sum != expect_ms {
        add_issue(r, "QA_DURATION_MISMATCH" as &const byte,
            "sum(shot durations) != screenplay duration" as &const byte);
    }
}

fn qa_num(buf: &const byte, n: usize, key: &const byte) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return 0;
    }
    var i: usize = 0;
    var neg: bool = false;
    var v: i64 = 0;
    if ln[0] > 0 && buf[st[0]] == 45 as byte {
        neg = true;
        i = 1;
    }
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    if neg {
        return 0 -| v;
    }
    return v;
}

// 报告 → JSON
fn qa_serialize(r: &const Report, script_ver: i64, board_ver: i64,
    out: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(out, w, "{\"format_version\":1,\"ok\":" as &const byte);
    if r.n == 0 {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"script_version\":" as &const byte);
    w = w + j_put_i64(out, w, script_ver);
    w = w + j_put(out, w, ",\"board_version\":" as &const byte);
    w = w + j_put_i64(out, w, board_ver);
    w = w + j_put(out, w, ",\"checked_shots\":" as &const byte);
    w = w + j_put_i64(out, w, r.checked_shots);
    w = w + j_put(out, w, ",\"issues\":[" as &const byte);
    var i: usize = 0;
    while i < r.n {
        if i > 0 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = w + j_put(out, w, "{\"code\":" as &const byte);
        w = w + j_put_str(out, w, &r.issues[i].code[0],
            r.issues[i].code_len);
        w = w + j_put(out, w, ",\"detail\":" as &const byte);
        w = w + j_put_str(out, w, &r.issues[i].detail[0],
            r.issues[i].detail_len);
        w = w + j_put(out, w, "}" as &const byte);
        i = i + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    return w;
}

fn qa_dir(root: &const byte, rn: usize, id: &const byte, idn: usize,
    out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, QA_DIR, b_len(QA_DIR), out, out_len);
}

fn qa_version(root: &const byte, rn: usize, id: &const byte,
    idn: usize) i64 {
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !qa_dir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 0;
    }
    var buf: [byte: 128] = [0: 128];
    var bl: usize = 0;
    if !read_file(&dpath[0], dl, "current.json" as &const byte, 12,
        &buf[0], 128, &bl) {
        return 0;
    }
    return qa_num(&buf[0], bl, "version" as &const byte);
}

// 跑一轮 QA：读剧本与分镜 → 检查 → 存报告
export fn qa_run(root: &const byte, rn: usize, id: &const byte, idn: usize,
    script_ver: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var rec: [byte: QA_BUF] = [0: QA_BUF];
    var rl: [usize: 1] = [0];
    if story_load(root, rn, id, idn, script_ver, &rec[0: QA_BUF],
        &rl[0]) != 0 {
        return 90;
    }
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(&rec[0], rl[0], "screenplay" as &const byte, &ss[0],
        &sl[0]) != 123 as byte {
        return 90;
    }
    const sp: &const byte = &rec[ss[0]];
    const expect_ms: i64 = story_duration_ms(sp, sl[0]);
    var r: Report = blank_report();
    qa_screenplay(sp, sl[0], &r);
    var bver: i64 = 0;
    var bbuf: [byte: QA_BUF] = [0: QA_BUF];
    var bl2: [usize: 1] = [0];
    if board_get(root, rn, id, idn, 0, &bbuf[0: QA_BUF], &bl2[0]) == 0 {
        bver = qa_num(&bbuf[0], bl2[0], "version" as &const byte);
        var bs: [usize: 1] = [0];
        var bsl: [usize: 1] = [0];
        if j_span(&bbuf[0], bl2[0], "board" as &const byte, &bs[0],
            &bsl[0]) == 123 as byte {
            qa_board(&bbuf[bs[0]], bsl[0], expect_ms, &r);
        }
    }
    var body: [byte: QA_BUF] = [0: QA_BUF];
    const bn: usize = qa_serialize(&r, script_ver, bver, &body[0: QA_BUF]);
    var hex: [byte: 64] = [0: 64];
    var hl: [usize: 1] = [0];
    if !sha256_hex(&body[0], bn, &hex[0: 64], &hl[0]) {
        return 94;
    }
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !qa_dir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 94;
    }
    const ver: i64 = qa_version(root, rn, id, idn) +| 1;
    var saved: [byte: QA_BUF + 256] = [0: QA_BUF + 256];
    var sw: usize = 0;
    sw = sw + j_put(&saved[0: QA_BUF + 256], sw,
        "{\"format_version\":1,\"version\":" as &const byte);
    sw = sw + j_put_i64(&saved[0: QA_BUF + 256], sw, ver);
    sw = sw + j_put(&saved[0: QA_BUF + 256], sw,
        ",\"content_hash\":\"" as &const byte);
    sw = sw + j_put_raw(&saved[0: QA_BUF + 256], sw, &hex[0], 64);
    sw = sw + j_put(&saved[0: QA_BUF + 256], sw,
        "\",\"report\":" as &const byte);
    sw = sw + j_put_raw(&saved[0: QA_BUF + 256], sw, &body[0], bn);
    sw = sw + j_put(&saved[0: QA_BUF + 256], sw, "}" as &const byte);
    var nm: [byte: 32] = [0: 32];
    var nn: usize = 0;
    nn = nn + j_put_raw(&nm[0: 32], nn, "v" as &const byte, 1);
    nn = nn + j_put_i64(&nm[0: 32], nn, ver);
    nn = nn + j_put_raw(&nm[0: 32], nn, ".json" as &const byte, 5);
    if !write_atomic(&dpath[0], dl, &nm[0], nn, &saved[0], sw) {
        return 94;
    }
    var cur: [byte: 128] = [0: 128];
    var cw: usize = 0;
    cw = cw + j_put(&cur[0: 128], cw, "{\"version\":" as &const byte);
    cw = cw + j_put_i64(&cur[0: 128], cw, ver);
    cw = cw + j_put(&cur[0: 128], cw, "}" as &const byte);
    _ = write_atomic(&dpath[0], dl, "current.json" as &const byte, 12,
        &cur[0], cw);
    var w: usize = 0;
    w = w + j_put(out, w, "{\"report_version\":" as &const byte);
    w = w + j_put_i64(out, w, ver);
    w = w + j_put(out, w, ",\"ok\":" as &const byte);
    if r.n == 0 {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"issue_count\":" as &const byte);
    w = w + j_put_i64(out, w, r.n as i64);
    w = w + j_put(out, w, ",\"report\":" as &const byte);
    w = w + j_put_raw(out, w, &body[0], bn);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}
