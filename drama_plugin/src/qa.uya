// drama_plugin/src/qa.uya — 确定性 QA（P9 第一段）
//
// 只做**能确定性判定**的检查（AI 辅助的观感检查留到后面）：
//   剧本：title / hook 非空、scenes ≥1、每条对白有 who 与 line；
//   分镜：镜号连续、timeline 首尾相接、无空动作镜头、cut_type 合法、
//         Σ镜头时长 == 剧本时长（同一套口径）。
//
// 产出：qa/v<N>.json（不可变报告，带 content_hash 与逐条 issue）。
// 返回码：0 成功 90 剧本缺失/结构不对 96 分镜不存在 94 写失败

use libc.syscall;
use libc.unistd;

const QA_BUF: usize = 16384;
const QA_DIR: &const byte = "qa" as &const byte;
const ISSUE_MAX: usize = 32;

// 报告里的一条问题
struct Issue {
    code: [byte: 32],
    code_len: usize,
    detail: [byte: 128],
    detail_len: usize,
}

struct Report {
    issues: [Issue: ISSUE_MAX],
    n: usize,
    checked_shots: i64,
}

fn blank_report() Report {
    return Report{ issues: [Issue{ code: [0: 32], code_len: 0,
        detail: [0: 128], detail_len: 0 }: ISSUE_MAX], n: 0,
        checked_shots: 0 };
}

fn add_issue(r: &Report, code: &const byte, detail: &const byte) void {
    if r.n >= ISSUE_MAX {
        return;
    }
    var i: Issue = Issue{ code: [0: 32], code_len: 0,
        detail: [0: 128], detail_len: 0 };
    var l: usize = 0;
    _ = copy_to(code, b_len(code), &i.code[0: 32], &l);
    i.code_len = l;
    _ = copy_to(detail, b_len(detail), &i.detail[0: 128], &l);
    i.detail_len = l;
    r.issues[r.n] = i;
    r.n = r.n + 1;
}

// 剧本检查：结构 + 对白完整
export fn qa_screenplay(sp: &const byte, sn: usize, r: &Report) void {
    var ts: [usize: 1] = [0];
    var tl: [usize: 1] = [0];
    if j_span(sp, sn, "title" as &const byte, &ts[0], &tl[0]) != 34 as byte {
        add_issue(r, "QA_TITLE_MISSING" as &const byte,
            "screenplay has no title" as &const byte);
    }
    var hs: [usize: 1] = [0];
    var hl: [usize: 1] = [0];
    if j_span(sp, sn, "hook" as &const byte, &hs[0], &hl[0]) != 34 as byte {
        add_issue(r, "QA_HOOK_MISSING" as &const byte,
            "screenplay has no episode hook" as &const byte);
    }
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(sp, sn, "scenes" as &const byte, &ss[0], &sl[0]) != 91 as byte {
        add_issue(r, "QA_SCENES_MISSING" as &const byte,
            "screenplay has no scenes" as &const byte);
        return;
    }
    var idx: usize = 0;
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&sp[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sc: &const byte = &sp[ss[0] + es[0]];
        var ds: [usize: 1] = [0];
        var dl: [usize: 1] = [0];
        if j_span(sc, el[0], "dialogue" as &const byte, &ds[0],
            &dl[0]) == 91 as byte {
            qa_dialogue(sc, el[0], &sc[ds[0]], dl[0], r);
        }
        idx = idx + 1;
    }
}

fn qa_dialogue(sc: &const byte, scn: usize, arr: &const byte, an: usize,
    r: &Report) void {
    var j: usize = 0;
    while true {
        var ls: [usize: 1] = [0];
        var ll: [usize: 1] = [0];
        if !j_arr_item(arr, an, j, &ls[0], &ll[0]) {
            break;
        }
        const line: &const byte = &arr[ls[0]];
        var w: [byte: 32] = [0: 32];
        var wl: usize = 0;
        if !j_str(line, ll[0], "who" as &const byte, &w[0: 32], &wl)
            || wl == 0 {
            add_issue(r, "QA_LINE_NO_SPEAKER" as &const byte,
                "dialogue without who" as &const byte);
        }
        var xs: [usize: 1] = [0];
        var xl: [usize: 1] = [0];
        if j_span(line, ll[0], "line" as &const byte, &xs[0],
            &xl[0]) != 34 as byte || xl[0] < 3 {
            add_issue(r, "QA_LINE_EMPTY" as &const byte,
                "dialogue with empty text" as &const byte);
        }
        _ = sc;
        _ = scn;
        j = j + 1;
    }
}

// 分镜检查：镜号连续、timeline 相接、无空动作、Σ时长 == 期望
export fn qa_board(bd: &const byte, bn: usize, expect_ms: i64,
    r: &Report) void {
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(bd, bn, "shots" as &const byte, &ss[0], &sl[0]) != 91 as byte {
        add_issue(r, "QA_SHOTS_MISSING" as &const byte,
            "board has no shots" as &const byte);
        return;
    }
    var idx: usize = 0;
    var prev_out: i64 = 0;
    var sum: i64 = 0;
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&bd[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sh: &const byte = &bd[ss[0] + es[0]];
        const no: i64 = qa_num(sh, el[0], "sequence" as &const byte);
        const tin: i64 = qa_num(sh, el[0], "timeline_in" as &const byte);
        const tout: i64 = qa_num(sh, el[0], "timeline_out" as &const byte);
        const dur: i64 = qa_num(sh, el[0], "duration_ms" as &const byte);
        if no != (idx as i64) + 1 {
            add_issue(r, "QA_SEQ_GAP" as &const byte,
                "shot sequence not continuous" as &const byte);
        }
        if tin != prev_out {
            add_issue(r, "QA_TIMELINE_GAP" as &const byte,
                "timeline not contiguous" as &const byte);
        }
        if dur <= 0 {
            add_issue(r, "QA_SHOT_ZERO" as &const byte,
                "shot with non-positive duration" as &const byte);
        }
        var act: [byte: 256] = [0: 256];
        var al: usize = 0;
        _ = j_str(sh, el[0], "action" as &const byte, &act[0: 256], &al);
        var ln: [byte: 256] = [0: 256];
        var lnl: usize = 0;
        _ = j_str(sh, el[0], "line" as &const byte, &ln[0: 256], &lnl);
        if al == 0 && lnl == 0 {
            add_issue(r, "QA_SHOT_EMPTY" as &const byte,
                "shot has neither action nor line" as &const byte);
        }
        prev_out = tout;
        sum = sum +| dur;
        idx = idx + 1;
    }
    r.checked_shots = idx as i64;
    if expect_ms > 0 && sum != expect_ms {
        add_issue(r, "QA_DURATION_MISMATCH" as &const byte,
            "sum(shot durations) != screenplay duration" as &const byte);
    }
}

// ---- 引用与事件核对（P12：场景/道具引用、动作呈现、状态变化可追） ----
const QA_REF_MAX: usize = 40;

fn qa_eqn(a: &const byte, an: usize, b: &const byte, bn: usize) bool {
    if an != bn {
        return false;
    }
    var i: usize = 0;
    while i < an {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn qa_collect(arr: &const byte, an: usize, out: &[byte],
    lens: &[usize], cnt: &usize) void {
    _ = lens;
    var idx: usize = 0;
    while cnt[0] < QA_REF_MAX {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(arr, an, idx, &es[0], &el[0]) {
            break;
        }
        const it: &const byte = &arr[es[0]];
        var b1: [byte: 32] = [0: 32];
        var b1l: usize = 0;
        _ = j_str(it, el[0], "name" as &const byte, &b1[0: 32], &b1l);
        var k: usize = 0;
        while k < b1l && k < 31 {
            out[cnt[0] * 32 + k] = b1[k];
            k = k + 1;
        }
        lens[cnt[0]] = k;
        cnt[0] = cnt[0] + 1;
        idx = idx + 1;
    }
}

fn qa_in_list(list: &[byte], lens: &[usize], cnt: usize,
    s: &const byte, sn: usize) bool {
    var i: usize = 0;
    while i < cnt {
        if qa_eqn(&list[i * 32], lens[i], s, sn) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

fn qa_count_items(buf: &const byte, n: usize, key: &const byte) i64 {
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(buf, n, key, &ss[0], &sl[0]) != 91 as byte {
        return 0;
    }
    var idx: usize = 0;
    var c: i64 = 0;
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&buf[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        c = c +| 1;
        idx = idx + 1;
    }
    return c;
}

// 人物一致性：说话的人必须在 Bible 角色表里；对白镜头的人必须在该场景
fn qa_cast(bible: &const byte, bn: usize, canon: &const byte, cn: usize,
    sp: &const byte, spn: usize, r: &Report) void {
    var nm: [byte: 1024] = [0: 1024];
    var nl: [usize: 24] = [0: 24];
    var nch: usize = 0;
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(bible, bn, "characters" as &const byte, &ss[0],
        &sl[0]) == 91 as byte {
        var idx: usize = 0;
        while idx < 24 {
            var es: [usize: 1] = [0];
            var el: [usize: 1] = [0];
            if !j_arr_item(&bible[ss[0]], sl[0], idx, &es[0], &el[0]) {
                break;
            }
            const ch: &const byte = &bible[ss[0] + es[0]];
            var b1: [byte: 32] = [0: 32];
            var b1l: usize = 0;
            if j_str(ch, el[0], "id" as &const byte, &b1[0: 32], &b1l)
                || j_str(ch, el[0], "name" as &const byte, &b1[0: 32],
                    &b1l) {
                var k: usize = 0;
                while k < b1l && k < 31 {
                    nm[idx * 32 + k] = b1[k];
                    k = k + 1;
                }
                nl[idx] = k;
            }
            idx = idx + 1;
            nch = idx;
        }
    }
    if nch == 0 {
        return;
    }
    // 剧本每条对白的 who 必须在角色表里
    var ss2: [usize: 1] = [0];
    var sl2: [usize: 1] = [0];
    if j_span(sp, spn, "scenes" as &const byte, &ss2[0],
        &sl2[0]) == 91 as byte {
        var idx: usize = 0;
        while true {
            var es: [usize: 1] = [0];
            var el: [usize: 1] = [0];
            if !j_arr_item(&sp[ss2[0]], sl2[0], idx, &es[0], &el[0]) {
                break;
            }
            const sc: &const byte = &sp[ss2[0] + es[0]];
            var ds: [usize: 1] = [0];
            var dl: [usize: 1] = [0];
            if j_span(sc, el[0], "dialogue" as &const byte, &ds[0],
                &dl[0]) == 91 as byte {
                var k: usize = 0;
                while true {
                    var xs: [usize: 1] = [0];
                    var xl: [usize: 1] = [0];
                    if !j_arr_item(&sc[ds[0]], dl[0], k, &xs[0],
                        &xl[0]) {
                        break;
                    }
                    const ln: &const byte = &sc[ds[0] + xs[0]];
                    var who: [byte: 32] = [0: 32];
                    var wl: usize = 0;
                    if j_str(ln, xl[0], "who" as &const byte,
                        &who[0: 32], &wl) && wl > 0
                        && !qa_in_list(&nm[0: 1024], &nl[0: 24], nch,
                            &who[0], wl) {
                        add_issue(r, "QA_WHO_UNKNOWN" as &const byte,
                            "speaker is not in the bible cast"
                            as &const byte);
                    } else if wl == 0 {
                        add_issue(r, "QA_WHO_MISSING" as &const byte,
                            "dialogue without a speaker" as &const byte);
                    }
                    k = k + 1;
                }
            }
            idx = idx + 1;
        }
    }
    // 说话的人必须在这个场景里（人物位置合理）
    var cs: [usize: 1] = [0];
    var cl: [usize: 1] = [0];
    // Canon 里还没有任何角色（还没批准过）⇒ 没法判在场，跳过
    if qa_count_items(canon, cn, "characters" as &const byte) == 0 {
        return;
    }
    if j_span(canon, cn, "characters" as &const byte, &cs[0],
        &cl[0]) == 91 as byte {
        var ss3: [usize: 1] = [0];
        var sl3: [usize: 1] = [0];
        if j_span(sp, spn, "scenes" as &const byte, &ss3[0],
            &sl3[0]) == 91 as byte {
            var idx: usize = 0;
            while true {
                var es: [usize: 1] = [0];
                var el: [usize: 1] = [0];
                if !j_arr_item(&sp[ss3[0]], sl3[0], idx, &es[0],
                    &el[0]) {
                    break;
                }
                const sc: &const byte = &sp[ss3[0] + es[0]];
                var ds: [usize: 1] = [0];
                var dl: [usize: 1] = [0];
                if j_span(sc, el[0], "dialogue" as &const byte, &ds[0],
                    &dl[0]) == 91 as byte {
                    var k: usize = 0;
                    while true {
                        var xs: [usize: 1] = [0];
                        var xl: [usize: 1] = [0];
                        if !j_arr_item(&sc[ds[0]], dl[0], k, &xs[0],
                            &xl[0]) {
                            break;
                        }
                        const ln: &const byte = &sc[ds[0] + xs[0]];
                        var who: [byte: 32] = [0: 32];
                        var wl: usize = 0;
                        if j_str(ln, xl[0], "who" as &const byte,
                            &who[0: 32], &wl) && wl > 0 {
                            if !qa_actor_seen(&canon[cs[0]], cl[0],
                                &who[0], wl) {
                                add_issue(r,
                                    "QA_ACTOR_OFFSTAGE" as &const byte,
                                    "speaker has no known location"
                                    as &const byte);
                            }
                        }
                        k = k + 1;
                    }
                }
                idx = idx + 1;
            }
        }
    }
}

fn qa_actor_seen(chars: &const byte, cn: usize, who: &const byte,
    wn: usize) bool {
    var idx: usize = 0;
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(chars, cn, idx, &es[0], &el[0]) {
            break;
        }
        const ch: &const byte = &chars[es[0]];
        var b1: [byte: 32] = [0: 32];
        var b1l: usize = 0;
        if j_str(ch, el[0], "name" as &const byte, &b1[0: 32], &b1l)
            && qa_eqn(&b1[0], b1l, who, wn) {
            return true;
        }
        idx = idx + 1;
    }
    return false;
}

export fn qa_refs(bd: &const byte, bn: usize, canon: &const byte,
    cn: usize, sp: &const byte, spn: usize, r: &Report) void {
    var snm: [byte: 1280] = [0: 1280];
    var sln: [usize: QA_REF_MAX] = [0: QA_REF_MAX];
    var nsc: usize = 0;
    var pnm: [byte: 1280] = [0: 1280];
    var pln: [usize: QA_REF_MAX] = [0: QA_REF_MAX];
    var npr: usize = 0;
    var cs: [usize: 1] = [0];
    var cl: [usize: 1] = [0];
    if j_span(canon, cn, "scenes" as &const byte, &cs[0],
        &cl[0]) == 91 as byte {
        qa_collect(&canon[cs[0]], cl[0], &snm[0: 1280],
            &sln[0: QA_REF_MAX], &nsc);
    }
    cs[0] = 0;
    cl[0] = 0;
    if j_span(canon, cn, "props" as &const byte, &cs[0],
        &cl[0]) == 91 as byte {
        qa_collect(&canon[cs[0]], cl[0], &pnm[0: 1280],
            &pln[0: QA_REF_MAX], &npr);
    }
    // 1. 镜头的场景必须在 Canon 里（说不清在哪拍的镜头 = 穿帮）
    const evn: i64 = qa_count_items(sp, spn, "candidate_events" as
        &const byte);
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    var mapped: i64 = 0;
    if j_span(bd, bn, "shots" as &const byte, &ss[0], &sl[0]) == 91 as byte {
        var idx: usize = 0;
        while true {
            var es: [usize: 1] = [0];
            var el: [usize: 1] = [0];
            if !j_arr_item(&bd[ss[0]], sl[0], idx, &es[0], &el[0]) {
                break;
            }
            const sh: &const byte = &bd[ss[0] + es[0]];
            var scn: [byte: 32] = [0: 32];
            var scl: usize = 0;
            _ = j_str(sh, el[0], "scene" as &const byte, &scn[0: 32],
                &scl);
            if scl > 0 && nsc > 0
                && !qa_in_list(&snm[0: 1280], &sln[0: QA_REF_MAX], nsc,
                    &scn[0], scl) {
                add_issue(r, "QA_SCENE_UNKNOWN" as &const byte,
                    "shot scene is not in canon" as &const byte);
            }
            // 3. 状态变化要能追到批准过的候选事件
            var ps: [usize: 1] = [0];
            var pl: [usize: 1] = [0];
            if j_span(sh, el[0], "source" as &const byte, &ps[0],
                &pl[0]) == 123 as byte {
                var evs: [usize: 1] = [0];
                var evl: [usize: 1] = [0];
                if j_span(&sh[ps[0]], pl[0], "events" as &const byte,
                    &evs[0], &evl[0]) == 91 as byte {
                    var k: usize = 0;
                    while true {
                        var xs: [usize: 1] = [0];
                        var xl: [usize: 1] = [0];
                        if !j_arr_item(&sh[ps[0] + evs[0]], evl[0], k,
                            &xs[0], &xl[0]) {
                            break;
                        }
                        k = k + 1;
                        mapped = mapped +| 1;
                    }
                    if k > evn {
                        add_issue(r, "QA_EVENT_INDEX" as &const byte,
                            "shot refers to unknown screenplay event"
                            as &const byte);
                    }
                }
            }
            idx = idx + 1;
        }
    }
    if evn > 0 && mapped == 0 {
        add_issue(r, "QA_EVENT_UNMAPPED" as &const byte,
            "no shot maps the approved candidate events" as &const byte);
    }
    // 2. 候选事件里的道具必须已经在 Canon 里定义过
    var es2: [usize: 1] = [0];
    var el2: [usize: 1] = [0];
    if j_span(sp, spn, "candidate_events" as &const byte, &es2[0],
        &el2[0]) == 91 as byte && npr > 0 {
        var idx: usize = 0;
        while true {
            var xs: [usize: 1] = [0];
            var xl: [usize: 1] = [0];
            if !j_arr_item(&sp[es2[0]], el2[0], idx, &xs[0], &xl[0]) {
                break;
            }
            const ev: &const byte = &sp[es2[0] + xs[0]];
            var pb: [byte: 32] = [0: 32];
            var pbl: usize = 0;
            if j_str(ev, xl[0], "prop" as &const byte, &pb[0: 32], &pbl)
                && pbl > 0
                && !qa_in_list(&pnm[0: 1280], &pln[0: QA_REF_MAX], npr,
                    &pb[0], pbl) {
                add_issue(r, "QA_PROP_UNKNOWN" as &const byte,
                    "event refers to a prop not in canon" as &const byte);
            }
            idx = idx + 1;
        }
    }
}


// ---- 人物位置 / 服装 / 情绪 -------------------------------------------
// 三条确定性判据（剧本层）：
//   * 位置：台词的人必须在 Canon 里被放到某个场景里（否则全场没有落脚点）
//   * 服装：他必须有冻结的外观文本（Bible locks）；台词里写了 outfit 时，
//           outfit 必须出现在冻结文本里 —— 换装得先改 Bible
//   * 情绪：台词可带 emotion（平静/紧张/难过/害怕/生气/开心），必须在集合内；
//           同一角色相邻两句的情绪档位跳 >2 档却没有 cause（reversal/reveal/
//           loss）就算情绪断裂

const EM_MAX: usize = 16;
const EM_SLOT: usize = 24;

// 情绪字面量 → 档位（0..5），不认识的给 -1
fn em_level(p: &const byte, n: usize) i64 {
    if b_eq(p, n, "平静" as &const byte) {
        return 0;
    }
    if b_eq(p, n, "紧张" as &const byte) {
        return 1;
    }
    if b_eq(p, n, "难过" as &const byte) {
        return 2;
    }
    if b_eq(p, n, "害怕" as &const byte) {
        return 3;
    }
    if b_eq(p, n, "生气" as &const byte) {
        return 4;
    }
    if b_eq(p, n, "开心" as &const byte) {
        return 5;
    }
    return -1;
}

// a 里是否含有 b（子串）
fn em_has(hay: &const byte, hn: usize, needle: &const byte,
    nn: usize) bool {
    if nn == 0 || nn > hn {
        return false;
    }
    var i: usize = 0;
    while i + nn <= hn {
        var k: usize = 0;
        var same: bool = true;
        while k < nn {
            if hay[i + k] != needle[k] {
                same = false;
                break;
            }
            k = k + 1;
        }
        if same {
            return true;
        }
        i = i + 1;
    }
    return false;
}

export fn qa_character(bible: &const byte, bn: usize, canon: &const byte,
    cn: usize, sp: &const byte, spn: usize, r: &Report) void {
    // Canon 里被放到场景的角色（"落点"）
    var placed: [byte: 1024] = [0: 1024];
    var placed_l: [usize: 24] = [0: 24];
    var npl: usize = 0;
    var cs: [usize: 1] = [0];
    var cl: [usize: 1] = [0];
    if j_span(canon, cn, "characters" as &const byte, &cs[0],
        &cl[0]) == 91 as byte {
        var idx: usize = 0;
        while idx < 24 {
            var es: [usize: 1] = [0];
            var el: [usize: 1] = [0];
            if !j_arr_item(&canon[cs[0]], cl[0], idx, &es[0], &el[0]) {
                break;
            }
            const ch: &const byte = &canon[cs[0] + es[0]];
            var nm: [byte: 32] = [0: 32];
            var nl: usize = 0;
            var sc: [byte: 32] = [0: 32];
            var scl: usize = 0;
            if j_str(ch, el[0], "name" as &const byte, &nm[0: 32], &nl)
                && j_str(ch, el[0], "scene" as &const byte, &sc[0: 32],
                    &scl) && nl > 0 && scl > 0 && npl < 24 {
                var k: usize = 0;
                while k < nl && k < 32 {
                    placed[npl * 32 + k] = nm[k];
                    k = k + 1;
                }
                placed_l[npl] = k;
                npl = npl + 1;
            }
            idx = idx + 1;
        }
    }
    // 逐句对白看位置 / 服装 / 情绪
    var last_nm: [byte: 384] = [0: 384];
    var last_l: [usize: EM_MAX] = [0: EM_MAX];
    var last_lv: [byte: EM_MAX] = [0: EM_MAX];
    var nlast: usize = 0;
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(sp, spn, "scenes" as &const byte, &ss[0],
        &sl[0]) != 91 as byte {
        return;
    }
    var idx: usize = 0;
    while idx < 64 {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&sp[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sc: &const byte = &sp[ss[0] + es[0]];
        var cause: [byte: 16] = [0: 16];
        var causel: usize = 0;
        _ = j_str(sc, el[0], "cause" as &const byte, &cause[0: 16],
            &causel);
        const strong: bool = em_has(&cause[0], causel,
            "reversal" as &const byte, 8)
            || em_has(&cause[0], causel, "reveal" as &const byte, 6)
            || em_has(&cause[0], causel, "loss" as &const byte, 4);
        var ds: [usize: 1] = [0];
        var dl: [usize: 1] = [0];
        if j_span(sc, el[0], "dialogue" as &const byte, &ds[0],
            &dl[0]) == 91 as byte {
            var j: usize = 0;
            while j < 32 {
                var ls: [usize: 1] = [0];
                var ll: [usize: 1] = [0];
                if !j_arr_item(&sc[ds[0]], dl[0], j, &ls[0], &ll[0]) {
                    break;
                }
                const ln: &const byte = &sc[ds[0] + ls[0]];
                var who: [byte: 32] = [0: 32];
                var whol: usize = 0;
                _ = j_str(ln, ll[0], "who" as &const byte, &who[0: 32],
                    &whol);
                if whol > 0 {
                    // 位置
                    var found: bool = false;
                    var k: usize = 0;
                    while k < npl {
                        if placed_l[k] == whol && em_has(&placed[k * 32],
                            placed_l[k], &who[0], whol) {
                            found = true;
                            break;
                        }
                        k = k + 1;
                    }
                    if npl > 0 && !found {
                        add_issue(r, "QA_POSITION_UNKNOWN" as &const byte,
                            "a speaking character has no scene placement"
                            as &const byte);
                    }
                    // 服装：冻结外观文本必须在
                    var locks: [usize: 1] = [0];
                    var locksl: [usize: 1] = [0];
                    var lock: [byte: 256] = [0: 256];
                    var lockl: [usize: 1] = [0];
                    var has_lock: bool = false;
                    if j_span(bible, bn, "locks" as &const byte,
                        &locks[0], &locksl[0]) == 123 as byte {
                        var key: [byte: 40] = [0: 40];
                        var kk: usize = 0;
                        while kk < whol && kk < 40 {
                            key[kk] = who[kk];
                            kk = kk + 1;
                        }
                        key[kk] = 0 as byte;
                        if j_str(&bible[locks[0]], locksl[0], &key[0],
                            &lock[0: 256], &lockl[0]) && lockl[0] > 0 {
                            has_lock = true;
                        }
                    }
                    if !has_lock {
                        add_issue(r, "QA_COSTUME_UNFROZEN" as &const byte,
                            "a speaking character has no frozen look text"
                            as &const byte);
                    } else {
                        var outfit: [byte: 64] = [0: 64];
                        var outfitl: usize = 0;
                        if j_str(ln, ll[0], "outfit" as &const byte,
                            &outfit[0: 64], &outfitl) && outfitl > 0
                            && !em_has(&lock[0], lockl[0], &outfit[0],
                                outfitl) {
                            add_issue(r,
                                "QA_COSTUME_UNFROZEN" as &const byte,
                                "outfit is not in the frozen look text"
                                as &const byte);
                        }
                    }
                    // 情绪
                    var emo: [byte: 16] = [0: 16];
                    var emol: usize = 0;
                    if j_str(ln, ll[0], "emotion" as &const byte,
                        &emo[0: 16], &emol) && emol > 0 {
                        const lv: i64 = em_level(&emo[0], emol);
                        if lv < 0 {
                            add_issue(r,
                                "QA_EMOTION_UNKNOWN" as &const byte,
                                "emotion is not in the allowed set"
                                as &const byte);
                        } else {
                            var prev: i64 = -1;
                            var k2: usize = 0;
                            while k2 < nlast {
                                if last_l[k2] == whol && em_has(
                                    &last_nm[k2 * EM_SLOT], last_l[k2],
                                    &who[0], whol) {
                                    prev = last_lv[k2] as i64;
                                    last_lv[k2] = lv as byte;
                                    break;
                                }
                                k2 = k2 + 1;
                            }
                            if k2 == nlast && nlast < EM_MAX {
                                var k3: usize = 0;
                                while k3 < whol && k3 < EM_SLOT {
                                    last_nm[nlast * EM_SLOT + k3] = who[k3];
                                    k3 = k3 + 1;
                                }
                                last_l[nlast] = k3;
                                last_lv[nlast] = lv as byte;
                                nlast = nlast + 1;
                            }
                            if prev >= 0 && !strong {
                                const d: i64 = lv -| prev;
                                const d2: i64 = prev -| lv;
                                if d > 2 || d2 > 2 {
                                    add_issue(r,
                                        "QA_EMOTION_JUMP" as &const byte,
                                        "emotion jumps without a cause"
                                        as &const byte);
                                }
                            }
                        }
                    }
                }
                j = j + 1;
            }
        }
        idx = idx + 1;
    }
}
fn qa_num(buf: &const byte, n: usize, key: &const byte) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return 0;
    }
    var i: usize = 0;
    var neg: bool = false;
    var v: i64 = 0;
    if ln[0] > 0 && buf[st[0]] == 45 as byte {
        neg = true;
        i = 1;
    }
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    if neg {
        return 0 -| v;
    }
    return v;
}

// 报告 → JSON
fn qa_serialize(r: &const Report, script_ver: i64, board_ver: i64,
    out: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(out, w, "{\"format_version\":1,\"ok\":" as &const byte);
    if r.n == 0 {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"script_version\":" as &const byte);
    w = w + j_put_i64(out, w, script_ver);
    w = w + j_put(out, w, ",\"board_version\":" as &const byte);
    w = w + j_put_i64(out, w, board_ver);
    w = w + j_put(out, w, ",\"checked_shots\":" as &const byte);
    w = w + j_put_i64(out, w, r.checked_shots);
    w = w + j_put(out, w, ",\"issues\":[" as &const byte);
    var i: usize = 0;
    while i < r.n {
        if i > 0 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = w + j_put(out, w, "{\"code\":" as &const byte);
        w = w + j_put_str(out, w, &r.issues[i].code[0],
            r.issues[i].code_len);
        w = w + j_put(out, w, ",\"detail\":" as &const byte);
        w = w + j_put_str(out, w, &r.issues[i].detail[0],
            r.issues[i].detail_len);
        w = w + j_put(out, w, "}" as &const byte);
        i = i + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    return w;
}

fn qa_dir(root: &const byte, rn: usize, id: &const byte, idn: usize,
    out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, QA_DIR, b_len(QA_DIR), out, out_len);
}

fn qa_version(root: &const byte, rn: usize, id: &const byte,
    idn: usize) i64 {
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !qa_dir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 0;
    }
    var buf: [byte: 128] = [0: 128];
    var bl: usize = 0;
    if !read_file(&dpath[0], dl, "current.json" as &const byte, 12,
        &buf[0], 128, &bl) {
        return 0;
    }
    return qa_num(&buf[0], bl, "version" as &const byte);
}

// 跑一轮 QA：读剧本与分镜 → 检查 → 存报告
fn qa_subdir(root: &const byte, rn: usize, id: &const byte, idn: usize,
    name: &const byte, nn: usize, out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8, &pdir[0: 512],
        &pl) {
        return false;
    }
    var idir: [byte: 512] = [0: 512];
    var il: usize = 0;
    if !path_join(&pdir[0], pl, id, idn, &idir[0: 512], &il) {
        return false;
    }
    return path_join(&idir[0], il, name, nn, out, out_len);
}

// 成片终检（确定性部分）：manifest 可读、字段完整、文件存在且大小一致
fn qa_assembly(root: &const byte, rn: usize, id: &const byte, idn: usize,
    r: &Report) void {
    var ad: [byte: 512] = [0: 512];
    var al: usize = 0;
    if !qa_subdir(root, rn, id, idn, "assemblies" as &const byte, 10,
        &ad[0: 512], &al) {
        return;
    }
    var cur: [byte: 128] = [0: 128];
    var cl: [usize: 1] = [0];
    if !read_file(&ad[0], al, "current.json" as &const byte, 12,
        &cur[0], 128, &cl[0]) {
        return;
    }
    const ver: i64 = qa_num(&cur[0], cl[0], "version" as &const byte);
    if ver <= 0 {
        return;
    }
    var mn: [byte: 32] = [0: 32];
    var mnl: usize = 0;
    mnl = mnl + j_put_raw(&mn[0: 32], mnl, "v" as &const byte, 1);
    mnl = mnl + j_put_i64(&mn[0: 32], mnl, ver);
    mnl = mnl + j_put_raw(&mn[0: 32], mnl, ".json" as &const byte, 5);
    var man: [byte: 2048] = [0: 2048];
    var ml: [usize: 1] = [0];
    if !read_file(&ad[0], al, &mn[0], mnl, &man[0], 2048, &ml[0]) {
        add_issue(r, "ASSEMBLY_CORRUPT" as &const byte,
            "assembly manifest missing" as &const byte);
        return;
    }
    var outn: [byte: 64] = [0: 64];
    var onl: [usize: 1] = [0];
    _ = j_str(&man[0], ml[0], "output" as &const byte, &outn[0: 64],
        &onl[0]);
    const size: i64 = qa_num(&man[0], ml[0], "size" as &const byte);
    var sha: [byte: 72] = [0: 72];
    var shl: [usize: 1] = [0];
    _ = j_str(&man[0], ml[0], "sha256" as &const byte, &sha[0: 72],
        &shl[0]);
    if onl[0] == 0 || size <= 0 || shl[0] != 64 {
        add_issue(r, "ASSEMBLY_CORRUPT" as &const byte,
            "assembly manifest invalid" as &const byte);
        return;
    }
    var fdir: [byte: 512] = [0: 512];
    var fdl: usize = 0;
    if !qa_subdir(root, rn, id, idn, "assets" as &const byte, 6,
        &fdir[0: 512], &fdl) {
        add_issue(r, "ASSEMBLY_CORRUPT" as &const byte,
            "assets dir missing" as &const byte);
        return;
    }
    var fp: [byte: 512] = [0: 512];
    var fl: usize = 0;
    if !path_join(&fdir[0], fdl, &outn[0], onl[0], &fp[0: 512], &fl) {
        add_issue(r, "ASSEMBLY_CORRUPT" as &const byte,
            "assembly path invalid" as &const byte);
        return;
    }
    const fd: i32 = sys_open(&fp[0], 0 as i32, 0) catch {
        add_issue(r, "ASSEMBLY_CORRUPT" as &const byte,
            "assembly file missing" as &const byte);
        return;
    };
    const end: i64 = sys_lseek(fd, 0 as i64, 2 as i32) catch {
        -1 as i64;
    };
    _ = sys_close(fd) catch { 0 as i32; };
    if end != size {
        add_issue(r, "ASSEMBLY_CORRUPT" as &const byte,
            "assembly size mismatch" as &const byte);
    }
}

// ---- 成片审批 ----------------------------------------------------------
// 判定只看已有的 QA 报告：某个剧本版本的最新报告绿了才允许 final approve。

fn qa_flag(buf: &const byte, n: usize, key: &const byte) bool {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return false;
    }
    const v: &const byte = &buf[st[0]];
    if ln[0] >= 4 && v[0] == 116 as byte && v[1] == 114 as byte
        && v[2] == 117 as byte && v[3] == 101 as byte {
        return true;
    }
    return false;
}

fn qa_read_ver(dir: &const byte, dl: usize, v: i64, buf: &[byte],
    cap: usize, out_len: &usize) bool {
    var nm: [byte: 32] = [0: 32];
    var nn: usize = 0;
    nn = nn + j_put_raw(&nm[0: 32], nn, "v" as &const byte, 1);
    nn = nn + j_put_i64(&nm[0: 32], nn, v);
    nn = nn + j_put_raw(&nm[0: 32], nn, ".json" as &const byte, 5);
    return read_file(dir, dl, &nm[0], nn, buf, cap, out_len);
}

// 0 = 绿，1 = 红，2 = 没有该剧本版本的报告；out 里带元信息
export fn qa_verdict(root: &const byte, rn: usize, id: &const byte,
    idn: usize, script_ver: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !qa_dir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 2;
    }
    const top: i64 = qa_version(root, rn, id, idn);
    var best: i64 = 0;
    var v: i64 = 1;
    while v <= top {
        var buf: [byte: 16640] = [0: 16640];
        var bl: [usize: 1] = [0];
        if qa_read_ver(&dpath[0], dl, v, &buf[0: 16640], 16640, &bl[0]) {
            var rs: [usize: 1] = [0];
            var rl: [usize: 1] = [0];
            if j_span(&buf[0], bl[0], "report" as &const byte, &rs[0],
                &rl[0]) == 123 as byte {
                const sv: i64 = qa_num(&buf[rs[0]], rl[0],
                    "script_version" as &const byte);
                if sv == script_ver {
                    best = v;
                }
            }
        }
        v = v + 1;
    }
    if best == 0 {
        return 2;
    }
    var buf: [byte: 16640] = [0: 16640];
    var bl: [usize: 1] = [0];
    if !qa_read_ver(&dpath[0], dl, best, &buf[0: 16640], 16640, &bl[0]) {
        return 2;
    }
    var ok: bool = false;
    var bv: i64 = 0;
    var rs: [usize: 1] = [0];
    var rl: [usize: 1] = [0];
    if j_span(&buf[0], bl[0], "report" as &const byte, &rs[0],
        &rl[0]) == 123 as byte {
        ok = qa_flag(&buf[rs[0]], rl[0], "ok" as &const byte);
        bv = qa_num(&buf[rs[0]], rl[0],
            "board_version" as &const byte);
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"report_version\":" as &const byte);
    w = w + j_put_i64(out, w, best);
    w = w + j_put(out, w, ",\"board_version\":" as &const byte);
    w = w + j_put_i64(out, w, bv);
    w = w + j_put(out, w, ",\"script_version\":" as &const byte);
    w = w + j_put_i64(out, w, script_ver);
    w = w + j_put(out, w, ",\"ok\":" as &const byte);
    if ok {
        w = w + j_put(out, w, "true}" as &const byte);
        out_len[0] = w;
        return 0;
    }
    w = w + j_put(out, w, "false}" as &const byte);
    out_len[0] = w;
    return 1;
}

// 审批 final cut：QA 绿 + 有成片清单才放行；不碰 Canon
export fn final_approve(root: &const byte, rn: usize, id: &const byte,
    idn: usize, script_ver: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var meta: [byte: 256] = [0: 256];
    var ml: [usize: 1] = [0];
    const vr: i32 = qa_verdict(root, rn, id, idn, script_ver,
        &meta[0: 256], &ml[0]);
    if vr != 0 {
        return 89;
    }
    const bver: i64 = qa_num(&meta[0], ml[0],
        "board_version" as &const byte);
    var ad: [byte: 512] = [0: 512];
    var al: usize = 0;
    if !qa_subdir(root, rn, id, idn, "assemblies" as &const byte, 10,
        &ad[0: 512], &al) {
        return 89;
    }
    var cur: [byte: 128] = [0: 128];
    var cl: [usize: 1] = [0];
    if !read_file(&ad[0], al, "current.json" as &const byte, 12,
        &cur[0], 128, &cl[0]) {
        return 89;
    }
    const aver: i64 = qa_num(&cur[0], cl[0], "version" as &const byte);
    if aver <= 0 {
        return 89;
    }
    var man: [byte: 4096] = [0: 4096];
    var mnl: [usize: 1] = [0];
    if !qa_read_ver(&ad[0], al, aver, &man[0: 4096], 4096, &mnl[0]) {
        return 89;
    }
    var sha: [byte: 72] = [0: 72];
    var shl: [usize: 1] = [0];
    _ = j_str(&man[0], mnl[0], "sha256" as &const byte, &sha[0: 72],
        &shl[0]);
    var outn: [byte: 64] = [0: 64];
    var onl: [usize: 1] = [0];
    _ = j_str(&man[0], mnl[0], "output" as &const byte, &outn[0: 64],
        &onl[0]);
    const size: i64 = qa_num(&man[0], mnl[0], "size" as &const byte);
    if shl[0] != 64 || onl[0] == 0 || size <= 0 {
        return 89;
    }
    const rev: i64 = canon_revision(root, rn, id, idn);
    var body: [byte: 1024] = [0: 1024];
    var w: usize = 0;
    w = w + j_put(&body[0: 1024], w,
        "{\"format_version\":1,\"approved\":true,\"script_version\":" as
        &const byte);
    w = w + j_put_i64(&body[0: 1024], w, script_ver);
    w = w + j_put(&body[0: 1024], w, ",\"board_version\":" as &const byte);
    w = w + j_put_i64(&body[0: 1024], w, bver);
    w = w + j_put(&body[0: 1024], w, ",\"assembly_version\":" as
        &const byte);
    w = w + j_put_i64(&body[0: 1024], w, aver);
    w = w + j_put(&body[0: 1024], w, ",\"size\":" as &const byte);
    w = w + j_put_i64(&body[0: 1024], w, size);
    w = w + j_put(&body[0: 1024], w, ",\"output\":" as &const byte);
    w = w + j_put_str(&body[0: 1024], w, &outn[0], onl[0]);
    w = w + j_put(&body[0: 1024], w, ",\"sha256\":\"" as &const byte);
    w = w + j_put_raw(&body[0: 1024], w, &sha[0], 64);
    w = w + j_put(&body[0: 1024], w, "\",\"canon_revision\":" as
        &const byte);
    w = w + j_put_i64(&body[0: 1024], w, rev);
    w = w + j_put(&body[0: 1024], w, "}" as &const byte);
    var fdir: [byte: 512] = [0: 512];
    var fdl: usize = 0;
    if !qa_subdir(root, rn, id, idn, "final" as &const byte, 5,
        &fdir[0: 512], &fdl) {
        return 94;
    }
    var nm: [byte: 32] = [0: 32];
    var nn: usize = 0;
    nn = nn + j_put_raw(&nm[0: 32], nn, "v" as &const byte, 1);
    nn = nn + j_put_i64(&nm[0: 32], nn, aver);
    nn = nn + j_put_raw(&nm[0: 32], nn, ".json" as &const byte, 5);
    if !write_atomic(&fdir[0], fdl, &nm[0], nn, &body[0], w) {
        return 94;
    }
    out_len[0] = w;
    var i: usize = 0;
    while i < w && i < out_len[0] {
        out[i] = body[i];
        i = i + 1;
    }
    return 0;
}

// 找出 source_script_version == script_ver 的最新一版分镜（没有回 0）
fn board_for_script(root: &const byte, rn: usize, id: &const byte,
    idn: usize, script_ver: i64) i64 {
    if script_ver <= 0 {
        return 0;
    }
    var hit: i64 = 0;
    var v: i64 = 1;
    while v <= 64 {
        var buf: [byte: QA_BUF] = [0: QA_BUF];
        var bl: [usize: 1] = [0];
        if board_get(root, rn, id, idn, v, &buf[0: QA_BUF], &bl[0]) != 0 {
            break;
        }
        if qa_num(&buf[0], bl[0], "source_script_version" as &const byte)
            == script_ver {
            hit = v;
        }
        v = v + 1;
    }
    return hit;
}

export fn qa_run(root: &const byte, rn: usize, id: &const byte, idn: usize,
    script_ver: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var rec: [byte: QA_BUF] = [0: QA_BUF];
    var rl: [usize: 1] = [0];
    if story_load(root, rn, id, idn, script_ver, &rec[0: QA_BUF],
        &rl[0]) != 0 {
        return 90;
    }
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(&rec[0], rl[0], "screenplay" as &const byte, &ss[0],
        &sl[0]) != 123 as byte {
        return 90;
    }
    const sp: &const byte = &rec[ss[0]];
    const expect_ms: i64 = story_duration_ms(sp, sl[0]);
    var r: Report = blank_report();
    qa_screenplay(sp, sl[0], &r);
    var bver: i64 = 0;
    var bbuf: [byte: QA_BUF] = [0: QA_BUF];
    var bl2: [usize: 1] = [0];
    // 优先用"由这份剧本构建的那版分镜"，没有才退回当前分镜
    const pick: i64 = board_for_script(root, rn, id, idn, script_ver);
    if board_get(root, rn, id, idn, pick, &bbuf[0: QA_BUF], &bl2[0]) == 0 {
        bver = qa_num(&bbuf[0], bl2[0], "version" as &const byte);
        var bs: [usize: 1] = [0];
        var bsl: [usize: 1] = [0];
        if j_span(&bbuf[0], bl2[0], "board" as &const byte, &bs[0],
            &bsl[0]) == 123 as byte {
            qa_board(&bbuf[bs[0]], bsl[0], expect_ms, &r);
            var cb: [byte: QA_BUF] = [0: QA_BUF];
            var cbl: [usize: 1] = [0];
            if canon_inspect(root, rn, id, idn, &cb[0: QA_BUF],
                &cbl[0]) == 0 {
                qa_refs(&bbuf[bs[0]], bsl[0], &cb[0], cbl[0], sp, sl[0],
                    &r);
                var bb2: [byte: 8192] = [0: 8192];
                var bb2l: [usize: 1] = [0];
                if bible_get(root, rn, id, idn, 0, &bb2[0: 8192],
                    &bb2l[0]) == 0 {
                    qa_cast(&bb2[0], bb2l[0], &cb[0], cbl[0], sp, sl[0],
                        &r);
                    qa_character(&bb2[0], bb2l[0], &cb[0], cbl[0], sp,
                        sl[0], &r);
                }
            }
        }
        const srcver: i64 = qa_num(&bbuf[0], bl2[0],
            "source_script_version" as &const byte);
        if srcver > 0 && script_ver > 0 && srcver != script_ver {
            add_issue(&r, "STALE_BOARD" as &const byte,
                "board built from a different screenplay version"
                as &const byte);
        }
    }
    qa_assembly(root, rn, id, idn, &r);
    var body: [byte: QA_BUF] = [0: QA_BUF];
    const bn: usize = qa_serialize(&r, script_ver, bver, &body[0: QA_BUF]);
    var hex: [byte: 64] = [0: 64];
    var hl: [usize: 1] = [0];
    if !sha256_hex(&body[0], bn, &hex[0: 64], &hl[0]) {
        return 94;
    }
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !qa_dir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 94;
    }
    const ver: i64 = qa_version(root, rn, id, idn) +| 1;
    var saved: [byte: QA_BUF + 256] = [0: QA_BUF + 256];
    var sw: usize = 0;
    sw = sw + j_put(&saved[0: QA_BUF + 256], sw,
        "{\"format_version\":1,\"version\":" as &const byte);
    sw = sw + j_put_i64(&saved[0: QA_BUF + 256], sw, ver);
    sw = sw + j_put(&saved[0: QA_BUF + 256], sw,
        ",\"content_hash\":\"" as &const byte);
    sw = sw + j_put_raw(&saved[0: QA_BUF + 256], sw, &hex[0], 64);
    sw = sw + j_put(&saved[0: QA_BUF + 256], sw,
        "\",\"report\":" as &const byte);
    sw = sw + j_put_raw(&saved[0: QA_BUF + 256], sw, &body[0], bn);
    sw = sw + j_put(&saved[0: QA_BUF + 256], sw, "}" as &const byte);
    var nm: [byte: 32] = [0: 32];
    var nn: usize = 0;
    nn = nn + j_put_raw(&nm[0: 32], nn, "v" as &const byte, 1);
    nn = nn + j_put_i64(&nm[0: 32], nn, ver);
    nn = nn + j_put_raw(&nm[0: 32], nn, ".json" as &const byte, 5);
    if !write_atomic(&dpath[0], dl, &nm[0], nn, &saved[0], sw) {
        return 94;
    }
    var cur: [byte: 128] = [0: 128];
    var cw: usize = 0;
    cw = cw + j_put(&cur[0: 128], cw, "{\"version\":" as &const byte);
    cw = cw + j_put_i64(&cur[0: 128], cw, ver);
    cw = cw + j_put(&cur[0: 128], cw, "}" as &const byte);
    _ = write_atomic(&dpath[0], dl, "current.json" as &const byte, 12,
        &cur[0], cw);
    var w: usize = 0;
    w = w + j_put(out, w, "{\"report_version\":" as &const byte);
    w = w + j_put_i64(out, w, ver);
    w = w + j_put(out, w, ",\"ok\":" as &const byte);
    if r.n == 0 {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"issue_count\":" as &const byte);
    w = w + j_put_i64(out, w, r.n as i64);
    w = w + j_put(out, w, ",\"report\":" as &const byte);
    w = w + j_put_raw(out, w, &body[0], bn);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

// 审核记录：reviews/v<N>.json（内容 = QA + 不变量两份结果的合并）
export fn review_save(root: &const byte, rn: usize, id: &const byte,
    idn: usize, body: &const byte, bn: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return 94;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return 94;
    }
    var rdir: [byte: 512] = [0: 512];
    var rdl: usize = 0;
    if !path_join(&dir[0], dl, "reviews" as &const byte, 7, &rdir[0: 512],
        &rdl) {
        return 94;
    }
    var cur: [byte: 128] = [0: 128];
    var cl: usize = 0;
    _ = read_file(&rdir[0], rdl, "current.json" as &const byte, 12,
        &cur[0], 128, &cl);
    const ver: i64 = qa_num(&cur[0], cl, "version" as &const byte) +| 1;
    var nm: [byte: 32] = [0: 32];
    var nn: usize = 0;
    nn = nn + j_put_raw(&nm[0: 32], nn, "v" as &const byte, 1);
    nn = nn + j_put_i64(&nm[0: 32], nn, ver);
    nn = nn + j_put_raw(&nm[0: 32], nn, ".json" as &const byte, 5);
    if !write_atomic(&rdir[0], rdl, &nm[0], nn, body, bn) {
        return 94;
    }
    var cb: [byte: 128] = [0: 128];
    var cw: usize = 0;
    cw = cw + j_put(&cb[0: 128], cw, "{\"version\":" as &const byte);
    cw = cw + j_put_i64(&cb[0: 128], cw, ver);
    cw = cw + j_put(&cb[0: 128], cw, "}" as &const byte);
    _ = write_atomic(&rdir[0], rdl, "current.json" as &const byte, 12,
        &cb[0], cw);
    var ow: usize = 0;
    ow = ow + j_put_i64(out, ow, ver);
    out_len[0] = ow;
    return 0;
}
