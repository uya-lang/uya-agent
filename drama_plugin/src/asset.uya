// drama_plugin/src/asset.uya — Asset Store（P3）
//
// 定位：插件只登记**项目目录里**的文件，不接受任意绝对路径。
//   <root>/projects/<id>/assets/<name>     实际文件（由外部拷贝进来）
//   <root>/projects/<id>/assets.jsonl      元数据索引（一行一条）
//
// 登记时现场读文件算 SHA-256 与大小，元数据里存下来；查询只读索引，
// 不碰原文件。文件名只允许 [A-Za-z0-9._-]，且不许以 '.' 开头——
// `../` 与隐藏路径都进不来。
//
// 返回码：
//   0 成功   30 项目 ID 非法   31 文件名非法   32 文件不存在/读失败
//   33 写索引失败   34 资产不存在

use libc.syscall;
use libc.unistd;


const ASSET_NAME_MAX: usize = 96;
const ASSET_MIME_MAX: usize = 48;
const ASSET_BUF: usize = 262144;          // 单文件上限 256 KiB（P3 够用）
const ASSET_INDEX: &const byte = "assets.jsonl" as &const byte;

// 资产名允许子目录（v3/shot_1.mp4）：逐段校验，段不许空、不许 '.' 开头，
// 所以绝对路径和 `../` 都进不来
export fn asset_name_ok(name: &const byte, n: usize) bool {
    if n == 0 || n > ASSET_NAME_MAX {
        return false;
    }
    var i: usize = 0;
    var seg: usize = 0;
    while i <= n {
        if i == n || name[i] == 47 as byte {
            if i == seg || i - seg > 64 || name[seg] == 46 as byte {
                return false;
            }
            var k: usize = seg;
            while k < i {
                const c: byte = name[k];
                const alnum: bool = (c >= 48 as byte && c <= 57 as byte)
                    || (c >= 65 as byte && c <= 90 as byte)
                    || (c >= 97 as byte && c <= 122 as byte);
                const sep: bool = c == 46 as byte || c == 95 as byte
                    || c == 45 as byte;
                if !alnum && !sep {
                    return false;
                }
                k = k + 1;
            }
            seg = i + 1;
        }
        i = i + 1;
    }
    return true;
}

// 项目内路径：projects/<id>/<leaf...>
fn project_path(root: &const byte, rn: usize, id: &const byte, idn: usize,
    leaf: &const byte, ln: usize, out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, leaf, ln, out, out_len);
}

// 资产目录：projects/<id>/assets（审计报告等派生文件也放这里）
export fn asset_dir_path(root: &const byte, rn: usize, id: &const byte,
    idn: usize, out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8, &pdir[0: 512],
        &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, "assets" as &const byte, 6, out, out_len);
}

// 资产文件路径：projects/<id>/assets/<name>
fn asset_file_path(root: &const byte, rn: usize, id: &const byte,
    idn: usize, name: &const byte, nn: usize, out: &[byte],
    out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    var adir: [byte: 512] = [0: 512];
    var al: usize = 0;
    if !path_join(&dir[0], dl, "assets" as &const byte, 6,
        &adir[0: 512], &al) {
        return false;
    }
    return path_join(&adir[0], al, name, nn, out, out_len);
}

// 索引里是否已经有这个资产：任务重置后重跑不重复登记
export fn asset_registered(root: &const byte, rn: usize, id: &const byte,
    idn: usize, name: &const byte, nn: usize) bool {
    var buf: [byte: 65536] = [0: 65536];
    var bl: [usize: 1] = [0];
    if asset_index(root, rn, id, idn, &buf[0: 65536], &bl[0]) != 0 {
        return false;
    }
    var pat: [byte: 128] = [0: 128];
    var pn: usize = 0;
    pn = pn + j_put_raw(&pat[0: 128], pn, "\"name\":\"" as &const byte, 8);
    var k: usize = 0;
    while k < nn && pn < 127 {
        pat[pn] = name[k];
        pn = pn + 1;
        k = k + 1;
    }
    pn = pn + j_put_raw(&pat[0: 128], pn, "\"" as &const byte, 1);
    if pn > bl[0] {
        return false;
    }
    var i: usize = 0;
    while i + pn <= bl[0] {
        var m: usize = 0;
        while m < pn && buf[i + m] == pat[m] {
            m = m + 1;
        }
        if m == pn {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 登记：读文件算 hash/大小，然后把元数据追加进索引
export fn asset_register(root: &const byte, rn: usize, id: &const byte,
    idn: usize, name: &const byte, nn: usize, mime: &const byte,
    mn: usize) i32 {
    if !project_id_ok(id, idn) {
        return 30;
    }
    if !asset_name_ok(name, nn) {
        return 31;
    }
    var fpath: [byte: 512] = [0: 512];
    var fl: usize = 0;
    if !asset_file_path(root, rn, id, idn, name, nn, &fpath[0: 512], &fl) {
        return 31;
    }
    var buf: &byte = malloc(ASSET_BUF) as &byte;
    defer { free(buf as &void); }
    if (buf as usize) == 0 {
        return 32;
    }
    const fd: i32 = sys_open(&fpath[0], 0 as i32, 0) catch {
        return 32;
    };
    var total: usize = 0;
    while total < ASSET_BUF {
        const got: isize = sys_read(fd, &buf[total], ASSET_BUF - total) catch {
            break;
        };
        if got <= 0 {
            break;
        }
        total = total + (got as usize);
    }
    _ = sys_close(fd) catch { 0 as i32; };
    var hex: [byte: 64] = [0: 64];
    var hl: [usize: 1] = [0];
    if !sha256_hex(&buf[0], total, &hex[0: 64], &hl[0]) {
        return 32;
    }
    const hn: usize = hl[0];

    var line: [byte: 1024] = [0: 1024];
    var w: usize = 0;
    w = w + j_put(&line[0: 1024], w, "{\"name\":" as &const byte);
    w = w + j_put_str(&line[0: 1024], w, name, nn);
    w = w + j_put(&line[0: 1024], w, ",\"mime\":" as &const byte);
    w = w + j_put_str(&line[0: 1024], w, mime, mn);
    w = w + j_put(&line[0: 1024], w, ",\"size\":" as &const byte);
    w = w + j_put_i64(&line[0: 1024], w, total as i64);
    w = w + j_put(&line[0: 1024], w, ",\"sha256\":\"" as &const byte);
    w = w + j_put_raw(&line[0: 1024], w, &hex[0], hn);
    w = w + j_put(&line[0: 1024], w, "\"}" as &const byte);
    return append_asset_line(root, rn, id, idn, &line[0], w);
}

fn append_asset_line(root: &const byte, rn: usize, id: &const byte,
    idn: usize, line: &const byte, ln: usize) i32 {
    var ipath: [byte: 512] = [0: 512];
    var il: usize = 0;
    if !project_path(root, rn, id, idn, ASSET_INDEX, b_len(ASSET_INDEX),
        &ipath[0: 512], &il) {
        return 33;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !project_path(root, rn, id, idn, "" as &const byte, 0,
        &dir[0: 512], &dl) {
        return 33;
    }
    var old: [byte: 65536] = [0: 65536];
    var ol: usize = 0;
    _ = read_file(&dir[0], dl - 1, ASSET_INDEX, b_len(ASSET_INDEX),
        &old[0], 65536, &ol);
    var merged: [byte: 66560] = [0: 66560];
    if ol + ln + 1 > 66560 {
        return 33;
    }
    var i: usize = 0;
    while i < ol {
        merged[i] = old[i];
        i = i + 1;
    }
    i = 0;
    while i < ln {
        merged[ol + i] = line[i];
        i = i + 1;
    }
    merged[ol + ln] = 10 as byte;
    if !write_atomic(&dir[0], dl - 1, ASSET_INDEX, b_len(ASSET_INDEX),
        &merged[0], ol + ln + 1) {
        return 33;
    }
    _ = il;
    return 0;
}

// 按名字查一条资产：找到时把该行 JSON 抄进 out
export fn asset_lookup(root: &const byte, rn: usize, id: &const byte,
    idn: usize, name: &const byte, nn: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 30;
    }
    if !asset_name_ok(name, nn) {
        return 31;
    }
    var buf: [byte: 65536] = [0: 65536];
    var bl: [usize: 1] = [0];
    const rc: i32 = asset_index(root, rn, id, idn, &buf[0: 65536], &bl[0]);
    if rc != 0 {
        return rc;
    }
    var pat: [byte: 160] = [0: 160];
    var pn: usize = 0;
    pn = pn + j_put_raw(&pat[0: 160], pn, "\"name\":\"" as &const byte, 8);
    var k: usize = 0;
    while k < nn && pn < 150 {
        pat[pn] = name[k];
        pn = pn + 1;
        k = k + 1;
    }
    pn = pn + j_put_raw(&pat[0: 160], pn, "\"" as &const byte, 1);
    var i: usize = 0;
    var hit: usize = bl[0];
    while i + pn <= bl[0] {
        var m: usize = 0;
        while m < pn && buf[i + m] == pat[m] {
            m = m + 1;
        }
        if m == pn {
            hit = i;
            break;
        }
        i = i + 1;
    }
    if hit >= bl[0] {
        return 35;
    }
    var st: usize = 0;
    var j: usize = 0;
    while j < hit && j < 65536 {
        if buf[j] == 10 as byte {
            st = j + 1;
        }
        j = j + 1;
    }
    var en: usize = hit + pn;
    while en < bl[0] && buf[en] != 10 as byte {
        en = en + 1;
    }
    var w: usize = 0;
    while st < en && w < out.len {
        if st < 65536 {
            out[w] = buf[st];
            w = w + 1;
        } else {
            break;
        }
        st = st + 1;
    }
    out_len[0] = w;
    return 0;
}

// 查询：把索引原文回给调用方（上层再挑某个 name）
export fn asset_index(root: &const byte, rn: usize, id: &const byte,
    idn: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 30;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !project_path(root, rn, id, idn, "" as &const byte, 0,
        &dir[0: 512], &dl) {
        return 33;
    }
    if !read_file(&dir[0], dl - 1, ASSET_INDEX, b_len(ASSET_INDEX),
        &out[0], out.len, out_len) {
        out_len[0] = 0;
        return 34;
    }
    return 0;
}
