// drama_plugin/src/media_ops.uya — 媒资/成片/生产报告相关的操作实现
//
// 从 ops.uya 拆出来（一文件一职责）：媒体四件套 + 单镜头重试 + 资产取回
// + 生产报告。参数解析与 JSON 片段工具仍在 ops.uya，跨文件用 export 的名字。

export fn op_media_encode(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var rel: [byte: 256] = [0: 256];
    var rl: [usize: 1] = [0];
    if !input_str(line, n, "path" as &const byte, &rel[0: 256], &rl[0]) {
        return 13;
    }
    var nm: [byte: 64] = [0: 64];
    var nl: [usize: 1] = [0];
    if !input_str(line, n, "output" as &const byte, &nm[0: 64], &nl[0]) {
        return 13;
    }
    const rc: i32 = provider_encode_file(data_root_ptr(), data_root_len(),
        &rel[0], rl[0], &nm[0], nl[0], out, out_len);
    if rc == 91 {
        return 15;
    }
    return rc;
}

// media.subtitle：按分镜时间轴生成 SRT
export fn op_media_subtitle(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl[0]) {
        return 13;
    }
    const bv: i64 = int_arg(line, n, "board_version" as &const byte, 0);
    const rc: i32 = subtitle_build(data_root_ptr(), data_root_len(), &pid[0],
        pl[0], bv, out, out_len);
    if rc == 96 {
        return 17;
    }
    if rc != 0 {
        return 15;
    }
    return 0;
}

// media.mux：把 SRT 混进 MP4（mov_text）
export fn op_media_mux(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var vid: [byte: 256] = [0: 256];
    var vl: [usize: 1] = [0];
    if !input_str(line, n, "video" as &const byte, &vid[0: 256], &vl[0]) {
        return 13;
    }
    var sub: [byte: 256] = [0: 256];
    var sl: [usize: 1] = [0];
    if !input_str(line, n, "subtitle" as &const byte, &sub[0: 256],
        &sl[0]) {
        return 13;
    }
    var nm: [byte: 64] = [0: 64];
    var nl: [usize: 1] = [0];
    if !input_str(line, n, "output" as &const byte, &nm[0: 64], &nl[0]) {
        return 13;
    }
    const rc: i32 = provider_mux_file(data_root_ptr(), data_root_len(), &vid[0],
        vl[0], &sub[0], sl[0], &nm[0], nl[0], out, out_len);
    if rc == 91 {
        return 15;
    }
    return rc;
}

// media.mix：把音频轨混入成片
export fn op_media_mix(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var vid: [byte: 256] = [0: 256];
    var vl: [usize: 1] = [0];
    if !input_str(line, n, "video" as &const byte, &vid[0: 256], &vl[0]) {
        return 13;
    }
    var aud: [byte: 256] = [0: 256];
    var al: [usize: 1] = [0];
    if !input_str(line, n, "audio" as &const byte, &aud[0: 256], &al[0]) {
        return 13;
    }
    var nm: [byte: 64] = [0: 64];
    var nl: [usize: 1] = [0];
    if !input_str(line, n, "output" as &const byte, &nm[0: 64], &nl[0]) {
        return 13;
    }
    const rc: i32 = provider_mix_file(data_root_ptr(), data_root_len(), &vid[0],
        vl[0], &aud[0], al[0], &nm[0], nl[0], out, out_len);
    if rc == 91 {
        return 15;
    }
    return rc;
}

