// shot.retry：只重渲一镜（资产按名字去重）
export fn op_shot_retry(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl[0]) {
        return 13;
    }
    const bv: i64 = int_arg(line, n, "board_version" as &const byte, 0);
    const seq: i64 = int_arg(line, n, "sequence" as &const byte, 0);
    const rc: i32 = task_retry_shot(data_root_ptr(), data_root_len(), &pid[0],
        pl[0], bv, seq, out, out_len);
    if rc == 17 {
        return 17;
    }
    if rc == 60 {
        return 23;
    }
    if rc != 0 {
        return 15;
    }
    return 0;
}

// asset.get：按名字查一条资产，附数据根相对路径
export fn op_asset_get(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl[0]) {
        return 13;
    }
    var nm: [byte: 96] = [0: 96];
    var nl: [usize: 1] = [0];
    if !input_str(line, n, "name" as &const byte, &nm[0: 96], &nl[0]) {
        return 13;
    }
    var ab: [byte: 1024] = [0: 1024];
    var al: [usize: 1] = [0];
    const rc: i32 = asset_lookup(data_root_ptr(), data_root_len(), &pid[0],
        pl[0], &nm[0], nl[0], &ab[0: 1024], &al[0]);
    if rc != 0 {
        return rc;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"asset\":" as &const byte);
    w = w + j_put_raw(out, w, &ab[0], al[0]);
    w = w + j_put(out, w, ",\"path\":\"projects/" as &const byte);
    w = w + j_put_raw(out, w, &pid[0], pl[0]);
    w = w + j_put(out, w, "/assets/" as &const byte);
    w = w + j_put_raw(out, w, &nm[0], nl[0]);
    w = w + j_put(out, w, "\"}" as &const byte);
    out_len[0] = w;
    return 0;
}

// 从媒体探测 JSON 里取整数字段；缺字段返回 -1
export fn json_i64_at(buf: &[byte], n: usize, key: &const byte) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    const k: byte = j_span(buf, n, key, &st[0], &ln[0]);
    if k == 0 as byte || k == 34 as byte || k == 123 as byte {
        return 0 - 1;
    }
    var v: i64 = 0;
    var i: usize = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}

// media.probe：对数据根下的媒体文件跑 ffprobe，报宽高与时长
export fn op_media_probe(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var rel: [byte: 256] = [0: 256];
    var rl: [usize: 1] = [0];
    if !input_str(line, n, "path" as &const byte, &rel[0: 256], &rl[0]) {
        return 13;
    }
    const rc: i32 = provider_probe_file(data_root_ptr(), data_root_len(),
        &rel[0], rl[0], out, out_len);
    if rc != 0 {
        return rc;
    }
    const ew: i64 = int_arg(line, n, "expect_width" as &const byte, 0);
    const eh: i64 = int_arg(line, n, "expect_height" as &const byte, 0);
    const ed: i64 = int_arg(line, n, "expect_duration_ms" as &const byte, 0);
    if ew <= 0 && eh <= 0 && ed <= 0 {
        return 0;
    }
    const vw: i64 = json_i64_at(out, out_len[0], "width" as &const byte);
    const vh: i64 = json_i64_at(out, out_len[0], "height" as &const byte);
    const vd: i64 = json_i64_at(out, out_len[0],
        "duration_ms" as &const byte);
    if vw < 0 || vh < 0 || vd < 0 {
        return 88;
    }
    if ew > 0 && vw != ew {
        return 88;
    }
    if eh > 0 && vh != eh {
        return 88;
    }
    if ed > 0 {
        const dd: i64 = vd - ed;
        if dd > 100 || dd < 0 - 100 {
            return 88;
        }
    }
    return 0;
}

// production.report：日终报告（完成集数、任务、成本、异常清单、不变量）

// ---- qa.align：把 ASR 文本按镜头台词逐条比对（阈值 85%）-------------------
// 真实 ASR 还没接；这里吃调用方给的转录文本（一行一条台词，按对白镜头顺序），
// 用编辑距离算每镜相似度——接上真 ASR 后只换文本来源，判据不用改。

fn align_lev(a: &const byte, an: usize, b: &const byte, bn: usize) i64 {
    var prev: [i64: 512] = [0: 512];
    var cur: [i64: 512] = [0: 512];
    var j: usize = 0;
    while j <= bn && j < 512 {
        prev[j] = j as i64;
        j = j + 1;
    }
    var i: usize = 1;
    while i <= an && i < 512 {
        cur[0] = i as i64;
        j = 1;
        while j <= bn && j < 512 {
            var cost: i64 = 1;
            if a[i - 1] == b[j - 1] {
                cost = 0;
            }
            var best: i64 = prev[j] +| 1;
            const ins: i64 = cur[j - 1] +| 1;
            if ins < best {
                best = ins;
            }
            const sub: i64 = prev[j - 1] +| cost;
            if sub < best {
                best = sub;
            }
            cur[j] = best;
            j = j + 1;
        }
        j = 0;
        while j <= bn && j < 512 {
            prev[j] = cur[j];
            j = j + 1;
        }
        i = i + 1;
    }
    const at: usize = bn;
    if at < 512 {
        return prev[at];
    }
    return prev[511];
}

fn align_pct(a: &const byte, an: usize, b: &const byte, bn: usize) i64 {
    var mx: i64 = bn as i64;
    if an as i64 > mx {
        mx = an as i64;
    }
    if mx == 0 {
        return 100;
    }
    const d: i64 = align_lev(a, an, b, bn);
    return 100 -| ((d *| 100) / mx);
}

export fn op_qa_align(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) {
        return 13;
    }
    var tr: [byte: 256] = [0: 256];
    var trl: [usize: 1] = [0];
    if !input_str(line, n, "transcript" as &const byte, &tr[0: 256],
        &trl[0]) {
        return 13;
    }
    const bv: i64 = int_arg(line, n, "board_version" as &const byte, 0);
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8, &pdir[0: 512],
        &pdl) {
        return 15;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, &pid[0], pl[0], &dir[0: 512], &dl) {
        return 13;
    }
    var txt: [byte: 8192] = [0: 8192];
    var tl: [usize: 1] = [0];
    if !read_file(&dir[0], dl, &tr[0], trl[0], &txt[0], 8192, &tl[0]) {
        return 17;
    }
    var bb: [byte: 32768] = [0: 32768];
    var bl: [usize: 1] = [0];
    if board_get(root, rn, &pid[0], pl[0], bv, &bb[0: 32768], &bl[0])
        != 0 {
        return 17;
    }
    var bs: [usize: 1] = [0];
    var bsl: [usize: 1] = [0];
    if j_span(&bb[0], bl[0], "board" as &const byte, &bs[0],
        &bsl[0]) != 123 as byte {
        return 17;
    }
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(&bb[bs[0]], bsl[0], "shots" as &const byte, &ss[0],
        &sl[0]) != 91 as byte {
        return 17;
    }
    const sbase: usize = bs[0] + ss[0];
    var idx: usize = 0;
    var pos: usize = 0;
    var checked: i64 = 0;
    var total: i64 = 0;
    var minp: i64 = 100;
    var bad: i64 = 0;
    var seqs: [i64: 8] = [0: 8];
    var pcts: [i64: 8] = [0: 8];
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&bb[sbase], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sh: &const byte = &bb[sbase + es[0]];
        var ls: [usize: 1] = [0];
        var ll: [usize: 1] = [0];
        if j_span(sh, el[0], "line" as &const byte, &ls[0],
            &ll[0]) == 34 as byte && ll[0] > 2 {
            var e: usize = pos;
            while e < tl[0] && txt[e] != 10 as byte {
                e = e + 1;
            }
            const pct: i64 = align_pct(&sh[ls[0] + 1], ll[0] - 2,
                &txt[pos], e - pos);
            checked = checked +| 1;
            total = total +| pct;
            if pct < minp {
                minp = pct;
            }
            if pct < 85 && bad < 8 {
                seqs[bad] = (idx as i64) +| 1;
                pcts[bad] = pct;
                bad = bad +| 1;
            }
            pos = e + 1;
        }
        idx = idx + 1;
    }
    var avg: i64 = 100;
    if checked > 0 {
        avg = total / checked;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"ok\":" as &const byte);
    if bad == 0 {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"threshold_pct\":85,\"checked\":" as
        &const byte);
    w = w + j_put_i64(out, w, checked);
    w = w + j_put(out, w, ",\"avg_pct\":" as &const byte);
    w = w + j_put_i64(out, w, avg);
    w = w + j_put(out, w, ",\"min_pct\":" as &const byte);
    w = w + j_put_i64(out, w, minp);
    w = w + j_put(out, w, ",\"mismatches\":[" as &const byte);
    var k: i64 = 0;
    while k < bad {
        if k > 0 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = w + j_put(out, w, "{\"shot\":" as &const byte);
        w = w + j_put_i64(out, w, seqs[k as usize]);
        w = w + j_put(out, w, ",\"pct\":" as &const byte);
        w = w + j_put_i64(out, w, pcts[k as usize]);
        w = w + j_put(out, w, "}" as &const byte);
        k = k + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    out_len[0] = w;
    return 0;
}

// ---- 抽样审批：队列（抽样集 + 异常任务）与裁决记录 ------------------------
fn decisions_dir(root: &const byte, rn: usize, id: &const byte,
    idn: usize, out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8, &pdir[0: 512],
        &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    if !path_join(&dir[0], dl, "reviews" as &const byte, 7, out, out_len) {
        return false;
    }
    return mkdir_p(out, out_len[0]);
}

fn count_lines(buf: &const byte, n: usize) i64 {
    var i: usize = 0;
    var c: i64 = 0;
    while i < n {
        if buf[i] == 10 as byte {
            c = c +| 1;
        }
        i = i + 1;
    }
    return c;
}

export fn op_review_queue(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    var done: [i64: 1] = [0];
    var failed: [i64: 1] = [0];
    var fids: [byte: 96] = [0: 96];
    var fnel: [usize: 1] = [0];
    count_tasks(root, rn, &pid[0], pl[0], &done[0], &failed[0],
        &fids[0: 96], &fnel[0]);
    var rs: [byte: 2048] = [0: 2048];
    var rsl: [usize: 1] = [0];
    const ns: i64 = review_sample(root, rn, &pid[0], pl[0], &rs[0: 2048],
        &rsl[0]);
    var decided: i64 = 0;
    var rdir: [byte: 512] = [0: 512];
    var rdl: usize = 0;
    if decisions_dir(root, rn, &pid[0], pl[0], &rdir[0: 512], &rdl) {
        var dec: [byte: 16384] = [0: 16384];
        var decl: [usize: 1] = [0];
        if read_file(&rdir[0], rdl, "decisions.jsonl" as &const byte, 15,
            &dec[0], 16384, &decl[0]) {
            decided = count_lines(&dec[0], decl[0]);
        }
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"sample\":[" as &const byte);
    if ns > 0 {
        w = w + j_put_raw(out, w, &rs[0], rsl[0]);
    }
    w = w + j_put(out, w, "],\"anomalies\":[" as &const byte);
    if fnel[0] > 0 {
        w = w + j_put_raw(out, w, &fids[0], fnel[0] - 1);
    }
    w = w + j_put(out, w, "],\"decided\":" as &const byte);
    w = w + j_put_i64(out, w, decided);
    w = w + j_put(out, w, ",\"tasks_failed\":" as &const byte);
    w = w + j_put_i64(out, w, failed[0]);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

export fn op_review_decide(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) {
        return 13;
    }
    var ep: [byte: 32] = [0: 32];
    var epl: [usize: 1] = [0];
    if !input_str(line, n, "episode_id" as &const byte, &ep[0: 32],
        &epl[0]) || epl[0] == 0 {
        return 13;
    }
    var dc: [byte: 16] = [0: 16];
    var dcl: [usize: 1] = [0];
    if !input_str(line, n, "decision" as &const byte, &dc[0: 16],
        &dcl[0]) {
        return 13;
    }
    const appr: bool = b_eq(&dc[0], dcl[0], "approve" as &const byte);
    const rej: bool = b_eq(&dc[0], dcl[0], "reject" as &const byte);
    if !appr && !rej {
        return 13;
    }
    var note: [byte: 64] = [0: 64];
    var nl: [usize: 1] = [0];
    _ = input_str(line, n, "note" as &const byte, &note[0: 64], &nl[0]);
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    var rdir: [byte: 512] = [0: 512];
    var rdl: usize = 0;
    if !decisions_dir(root, rn, &pid[0], pl[0], &rdir[0: 512], &rdl) {
        return 15;
    }
    var old: [byte: 16384] = [0: 16384];
    var oldl: [usize: 1] = [0];
    _ = read_file(&rdir[0], rdl, "decisions.jsonl" as &const byte, 15,
        &old[0], 16384, &oldl[0]);
    var rec: [byte: 256] = [0: 256];
    var rw: usize = 0;
    rw = rw + j_put(&rec[0: 256], rw, "{\"episode\":" as &const byte);
    rw = rw + j_put_str(&rec[0: 256], rw, &ep[0], epl[0]);
    rw = rw + j_put(&rec[0: 256], rw, ",\"decision\":\"" as &const byte);
    rw = rw + j_put_raw(&rec[0: 256], rw, &dc[0], dcl[0]);
    rw = rw + j_put(&rec[0: 256], rw, "\",\"note\":" as &const byte);
    rw = rw + j_put_str(&rec[0: 256], rw, &note[0], nl[0]);
    rw = rw + j_put(&rec[0: 256], rw, "}\n" as &const byte);
    if oldl[0] + rw > 16384 {
        return 15;
    }
    var all: [byte: 16384] = [0: 16384];
    var i: usize = 0;
    while i < oldl[0] {
        all[i] = old[i];
        i = i + 1;
    }
    i = 0;
    while i < rw {
        all[oldl[0] + i] = rec[i];
        i = i + 1;
    }
    if !write_atomic(&rdir[0], rdl, "decisions.jsonl" as &const byte, 15,
        &all[0], oldl[0] + rw) {
        return 15;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"recorded\":true,\"episode\":" as
        &const byte);
    w = w + j_put_str(out, w, &ep[0], epl[0]);
    w = w + j_put(out, w, ",\"decision\":\"" as &const byte);
    w = w + j_put_raw(out, w, &dc[0], dcl[0]);
    w = w + j_put(out, w, "\"}" as &const byte);
    out_len[0] = w;
    return 0;
}

export fn op_production_report(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64], &pl) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    if !project_id_ok(&pid[0], pl) {
        return 13;
    }
    var renders: [i64: 1] = [0];
    var gpu: [i64: 1] = [0];
    _ = sum_renders(root, rn, &pid[0], pl, &renders[0], &gpu[0]);
    var done: [i64: 1] = [0];
    var failed: [i64: 1] = [0];
    var fids: [byte: 96] = [0: 96];
    var fnel: [usize: 1] = [0];
    count_tasks(root, rn, &pid[0], pl, &done[0], &failed[0], &fids[0: 96],
        &fnel[0]);
    const overdue: i64 = count_overdue(root, rn, &pid[0], pl, now_s());
    var ab: [byte: 32768] = [0: 32768];
    var al: [usize: 1] = [0];
    const arc: i32 = audit_run(root, rn, &pid[0], pl, &ab[0: 32768],
        &al[0]);
    var inv_ok: bool = false;
    if arc == 0 {
        var st2: [usize: 1] = [0];
        var ln2: [usize: 1] = [0];
        if j_span(&ab[0], al[0], "ok" as &const byte, &st2[0],
            &ln2[0]) != 0 as byte && ln2[0] >= 4 {
            inv_ok = ab[st2[0]] == 116 as byte;
        }
    }
    const episodes: i64 = canon_revision(root, rn, &pid[0], pl);
    var w: usize = 0;
    w = w + j_put(out, w, "{\"project_id\":" as &const byte);
    w = w + j_put_str(out, w, &pid[0], pl);
    w = w + j_put(out, w, ",\"episodes\":" as &const byte);
    w = w + j_put_i64(out, w, episodes);
    w = w + j_put(out, w, ",\"tasks_done\":" as &const byte);
    w = w + j_put_i64(out, w, done[0]);
    w = w + j_put(out, w, ",\"tasks_failed\":" as &const byte);
    w = w + j_put_i64(out, w, failed[0]);
    w = w + j_put(out, w, ",\"tasks_overdue\":" as &const byte);
    w = w + j_put_i64(out, w, overdue);
    w = w + j_put(out, w, ",\"renders\":" as &const byte);
    w = w + j_put_i64(out, w, renders[0]);
    w = w + j_put(out, w, ",\"gpu_ms\":" as &const byte);
    w = w + j_put_i64(out, w, gpu[0]);
    w = w + j_put(out, w, ",\"gpu_minutes\":" as &const byte);
    w = w + j_put_i64(out, w, gpu[0] / 60000);
    w = w + j_put(out, w, ",\"renders_per_episode\":" as &const byte);
    if episodes > 0 {
        w = w + j_put_i64(out, w, (renders[0] *| 100) / episodes);
    } else {
        w = w + j_put_i64(out, w, 0);
    }
    w = w + j_put(out, w, ",\"invariants_ok\":" as &const byte);
    if inv_ok {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"failed_tasks\":[" as &const byte);
    if fnel[0] > 0 {
        w = w + j_put_raw(out, w, &fids[0], fnel[0] - 1);
    }
    w = w + j_put(out, w, "],\"review_sample\":[" as &const byte);
    var rs: [byte: 2048] = [0: 2048];
    var rsl: [usize: 1] = [0];
    const rn2: i64 = review_sample(root, rn, &pid[0], pl, &rs[0: 2048],
        &rsl[0]);
    if rn2 > 0 {
        w = w + j_put_raw(out, w, &rs[0], rsl[0]);
    }
    w = w + j_put(out, w, "]}" as &const byte);
    out_len[0] = w;
    return 0;
}

export fn op_story_review(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    const ver: i64 = int_arg(line, n, "script_version" as &const byte, 0);
    var rec: [byte: 32768] = [0: 32768];
    var rl: [usize: 1] = [0];
    const lrc: i32 = story_load(data_root_ptr(), data_root_len(), &id[0],
        il, ver, &rec[0: 32768], &rl[0]);
    if lrc != 0 {
        return 96;
    }
    // review_id 要对"剧本内容"取，不能对整条版本记录取（批准时也一样）
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(&rec[0], rl[0], "screenplay" as &const byte, &ss[0],
        &sl[0]) != 123 as byte {
        return 96;
    }
    return story_review(&rec[ss[0]], sl[0], out, out_len);
}

export fn op_canon_diff(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var id: [byte: 64] = [0: 64];
    var il: usize = 0;
    if !input_str(line, n, "project_id" as &const byte, &id[0: 64], &il) {
        return 13;
    }
    var es: [usize: 1] = [0];
    var el: [usize: 1] = [0];
    if !input_boxed(line, n, "events" as &const byte, &es[0], &el[0]) {
        return 10;
    }
    const rc: i32 = canon_diff(data_root_ptr(), data_root_len(), &id[0],
        il, &line[es[0]], el[0], out, out_len);
    if rc == 50 {
        return 13;
    }
    return rc;
}

// ---- space.report：场景连通 / 陈设 hash / 时段 / 变体 ---------------------
// 连通性从提交记录里的移动事件推：character.place 换场景、prop.move 换场景
// 都算一条无向边；陈设 hash 对 variant 文本取 SHA-256 前 16 位。

const SP_SLOT: usize = 24;
const SP_MAX: usize = 40;

struct SpTxt {
    b: [byte: SP_SLOT],
    l: usize,
}

fn sp_set(s: &SpTxt, src: &const byte, n: usize) void {
    var i: usize = 0;
    while i < n && i < SP_SLOT - 1 {
        s.b[i] = src[i];
        i = i + 1;
    }
    s.l = i;
}

fn sp_is(s: &SpTxt, src: &const byte, n: usize) bool {
    if s.l != n {
        return false;
    }
    var i: usize = 0;
    while i < n {
        if s.b[i] != src[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn sp_str(out: &[byte], w0: usize, s: &SpTxt) usize {
    return j_put_str(out, w0, &s.b[0], s.l);
}

fn sp_json(f: &const byte, fn_: usize, out: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(out, w, "{" as &const byte);
    w = w + j_put(out, w, f, fn_);
    w = w + j_put(out, w, "}" as &const byte);
    return w;
}

export fn op_space_report(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    var st: [byte: 32768] = [0: 32768];
    var stl: [usize: 1] = [0];
    if canon_inspect(root, rn, &pid[0], pl[0], &st[0: 32768], &stl[0])
        != 0 {
        return 15;
    }
    var snm: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var stod: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var svar: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var ns: usize = 0;
    var sss: [usize: 1] = [0];
    var ssl: [usize: 1] = [0];
    if j_span(&st[0], stl[0], "scenes" as &const byte, &sss[0],
        &ssl[0]) == 91 as byte {
        var idx: usize = 0;
        while idx < SP_MAX {
            var es: [usize: 1] = [0];
            var el: [usize: 1] = [0];
            if !j_arr_item(&st[sss[0]], ssl[0], idx, &es[0], &el[0]) {
                break;
            }
            const sc: &const byte = &st[sss[0] + es[0]];
            var b1: [byte: SP_SLOT] = [0: SP_SLOT];
            var b1l: usize = 0;
            _ = j_str(sc, el[0], "name" as &const byte, &b1[0: SP_SLOT],
                &b1l);
            sp_set(&snm[idx], &b1[0], b1l);
            _ = j_str(sc, el[0], "time_of_day" as &const byte,
                &b1[0: SP_SLOT], &b1l);
            sp_set(&stod[idx], &b1[0], b1l);
            _ = j_str(sc, el[0], "variant" as &const byte,
                &b1[0: SP_SLOT], &b1l);
            sp_set(&svar[idx], &b1[0], b1l);
            idx = idx + 1;
            ns = ns + 1;
        }
    }
    var cnm: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var csc: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var nc: usize = 0;
    var chs: [usize: 1] = [0];
    var chl: [usize: 1] = [0];
    if j_span(&st[0], stl[0], "characters" as &const byte, &chs[0],
        &chl[0]) == 91 as byte {
        var idx: usize = 0;
        while idx < SP_MAX {
            var es: [usize: 1] = [0];
            var el: [usize: 1] = [0];
            if !j_arr_item(&st[chs[0]], chl[0], idx, &es[0], &el[0]) {
                break;
            }
            const ch: &const byte = &st[chs[0] + es[0]];
            var b1: [byte: SP_SLOT] = [0: SP_SLOT];
            var b1l: usize = 0;
            _ = j_str(ch, el[0], "name" as &const byte, &b1[0: SP_SLOT],
                &b1l);
            sp_set(&cnm[idx], &b1[0], b1l);
            _ = j_str(ch, el[0], "scene" as &const byte, &b1[0: SP_SLOT],
                &b1l);
            sp_set(&csc[idx], &b1[0], b1l);
            idx = idx + 1;
            nc = nc + 1;
        }
    }
    var pnm: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var psc: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var np: usize = 0;
    var pps: [usize: 1] = [0];
    var ppl: [usize: 1] = [0];
    if j_span(&st[0], stl[0], "props" as &const byte, &pps[0],
        &ppl[0]) == 91 as byte {
        var idx: usize = 0;
        while idx < SP_MAX {
            var es: [usize: 1] = [0];
            var el: [usize: 1] = [0];
            if !j_arr_item(&st[pps[0]], ppl[0], idx, &es[0], &el[0]) {
                break;
            }
            const pp: &const byte = &st[pps[0] + es[0]];
            var b1: [byte: SP_SLOT] = [0: SP_SLOT];
            var b1l: usize = 0;
            _ = j_str(pp, el[0], "name" as &const byte, &b1[0: SP_SLOT],
                &b1l);
            sp_set(&pnm[idx], &b1[0], b1l);
            _ = j_str(pp, el[0], "scene" as &const byte, &b1[0: SP_SLOT],
                &b1l);
            sp_set(&psc[idx], &b1[0], b1l);
            idx = idx + 1;
            np = np + 1;
        }
    }
    // 重放提交记录，攒无向边
    var ea: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var eb: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var ne: usize = 0;
    var mnm: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var msc: [SpTxt: SP_MAX] = [SpTxt{ b: [0: SP_SLOT], l: 0 }: SP_MAX];
    var nmv: usize = 0;
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    var cdir: [byte: 512] = [0: 512];
    var cdl: usize = 0;
    const cur: i64 = json_i64_at(&st[0: 32768], stl[0],
        "revision" as &const byte);
    var ok_dir: bool = false;
    if path_join(root, rn, "projects" as &const byte, 8, &pdir[0: 512],
        &pdl) {
        var d2: [byte: 512] = [0: 512];
        var d2l: usize = 0;
        if path_join(&pdir[0], pdl, &pid[0], pl[0], &d2[0: 512], &d2l) {
            ok_dir = path_join(&d2[0], d2l, "commits" as &const byte, 7,
                &cdir[0: 512], &cdl);
        }
    }
    var rev: i64 = 1;
    while ok_dir && rev <= cur {
        var fnm: [byte: 24] = [0: 24];
        var fnl: usize = 0;
        fnl = fnl + j_put_i64(&fnm[0: 24], fnl, rev);
        fnl = fnl + j_put_raw(&fnm[0: 24], fnl, ".json" as &const byte, 5);
        var cb: [byte: 16384] = [0: 16384];
        var cbl: [usize: 1] = [0];
        if read_file(&cdir[0], cdl, &fnm[0], fnl, &cb[0], 16384,
            &cbl[0]) {
            var evs: [usize: 1] = [0];
            var evl: [usize: 1] = [0];
            if j_span(&cb[0], cbl[0], "events" as &const byte, &evs[0],
                &evl[0]) == 91 as byte {
                var k: usize = 0;
                while true {
                    var xs: [usize: 1] = [0];
                    var xl: [usize: 1] = [0];
                    if !j_arr_item(&cb[evs[0]], evl[0], k, &xs[0],
                        &xl[0]) {
                        break;
                    }
                    const ev: &const byte = &cb[evs[0] + xs[0]];
                    var ty: [byte: SP_SLOT] = [0: SP_SLOT];
                    var tyl: usize = 0;
                    _ = j_str(ev, xl[0], "type" as &const byte,
                        &ty[0: SP_SLOT], &tyl);
                    var a1: [byte: SP_SLOT] = [0: SP_SLOT];
                    var a1l: usize = 0;
                    var b2: [byte: SP_SLOT] = [0: SP_SLOT];
                    var b2l: usize = 0;
                    if b_eq(&ty[0], tyl,
                        "character.place" as &const byte) {
                        var who: [byte: SP_SLOT] = [0: SP_SLOT];
                        var wl: usize = 0;
                        _ = j_str(ev, xl[0], "character" as &const byte,
                            &who[0: SP_SLOT], &wl);
                        _ = j_str(ev, xl[0], "scene" as &const byte,
                            &b2[0: SP_SLOT], &b2l);
                        var at: isize = -1 as isize;
                        var d: usize = 0;
                        while d < SP_MAX && d < nmv {
                            if sp_is(&mnm[d], &who[0], wl) {
                                at = d as isize;
                                break;
                            }
                            d = d + 1;
                        }
                        if at >= 0 {
                            const ai: usize = at as! usize
                                catch { return 15; };
                            if ai < SP_MAX
                                && !sp_is(&msc[ai], &b2[0], b2l) {
                                if ne < SP_MAX {
                                    sp_set(&ea[ne], &msc[ai].b[0], msc[ai].l);
                                    sp_set(&eb[ne], &b2[0], b2l);
                                    ne = ne + 1;
                                }
                                sp_set(&msc[ai], &b2[0], b2l);
                            }
                        } else if nmv < SP_MAX {
                            sp_set(&mnm[nmv], &who[0], wl);
                            sp_set(&msc[nmv], &b2[0], b2l);
                            nmv = nmv + 1;
                        }
                    } else if b_eq(&ty[0], tyl,
                        "prop.move" as &const byte) {
                        _ = j_str(ev, xl[0], "at_scene" as &const byte,
                            &a1[0: SP_SLOT], &a1l);
                        _ = j_str(ev, xl[0], "to_scene" as &const byte,
                            &b2[0: SP_SLOT], &b2l);
                        if a1l > 0 && b2l > 0 && ne < SP_MAX {
                            sp_set(&ea[ne], &a1[0], a1l);
                            sp_set(&eb[ne], &b2[0], b2l);
                            ne = ne + 1;
                        }
                    }
                    k = k + 1;
                }
            }
        }
        rev = rev + 1;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"scenes\":[" as &const byte);
    var i: usize = 0;
    while i < SP_MAX && i < ns {
        if i > 0 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = w + j_put(out, w, "{\"name\":" as &const byte);
        w = w + sp_str(out, w, &snm[i]);
        w = w + j_put(out, w, ",\"time_of_day\":" as &const byte);
        w = w + sp_str(out, w, &stod[i]);
        w = w + j_put(out, w, ",\"variant\":" as &const byte);
        w = w + sp_str(out, w, &svar[i]);
        w = w + j_put(out, w, ",\"variant_hash\":" as &const byte);
        if svar[i].l == 0 {
            w = w + j_put_str(out, w, "" as &const byte, 0);
        } else {
            var hex: [byte: 64] = [0: 64];
            var hl: [usize: 1] = [0];
            _ = sha256_hex(&svar[i].b[0], svar[i].l, &hex[0: 64], &hl[0]);
            var hn: usize = hl[0];
            if hn > 16 {
                hn = 16;
            }
            var q: [byte: 20] = [0: 20];
            var ql: usize = 0;
            ql = ql + j_put(&q[0: 20], ql, "\"" as &const byte);
            ql = ql + j_put_raw(&q[0: 20], ql, &hex[0], hn);
            ql = ql + j_put(&q[0: 20], ql, "\"" as &const byte);
            w = w + j_put_raw(out, w, &q[0], ql);
        }
        w = w + j_put(out, w, ",\"characters\":[" as &const byte);
        var k: usize = 0;
        var first: bool = true;
        while k < SP_MAX && k < nc {
            if sp_is(&csc[k], &snm[i].b[0], snm[i].l) {
                if !first {
                    w = w + j_put(out, w, "," as &const byte);
                }
                w = w + sp_str(out, w, &cnm[k]);
                first = false;
            }
            k = k + 1;
        }
        w = w + j_put(out, w, "],\"props\":[" as &const byte);
        k = 0;
        first = true;
        while k < SP_MAX && k < np {
            if sp_is(&psc[k], &snm[i].b[0], snm[i].l) {
                if !first {
                    w = w + j_put(out, w, "," as &const byte);
                }
                w = w + sp_str(out, w, &pnm[k]);
                first = false;
            }
            k = k + 1;
        }
        w = w + j_put(out, w, "],\"links\":[" as &const byte);
        k = 0;
        first = true;
        while k < SP_MAX && k < ne {
            var tb: isize = -1 as isize;   // 0=ea, 1=eb
            if sp_is(&ea[k], &snm[i].b[0], snm[i].l) {
                tb = 1 as isize;
            } else if sp_is(&eb[k], &snm[i].b[0], snm[i].l) {
                tb = 0 as isize;
            }
            if tb >= 0 {
                if !first {
                    w = w + j_put(out, w, "," as &const byte);
                }
                if tb == 0 {
                    w = w + sp_str(out, w, &ea[k]);
                } else {
                    w = w + sp_str(out, w, &eb[k]);
                }
                first = false;
            }
            k = k + 1;
        }
        w = w + j_put(out, w, "]}" as &const byte);
        i = i + 1;
    }
    w = w + j_put(out, w, "],\"edges\":[" as &const byte);
    i = 0;
    while i < SP_MAX && i < ne {
        if i > 0 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = w + j_put(out, w, "{\"from\":" as &const byte);
        w = w + sp_str(out, w, &ea[i]);
        w = w + j_put(out, w, ",\"to\":" as &const byte);
        w = w + sp_str(out, w, &eb[i]);
        w = w + j_put(out, w, "}" as &const byte);
        i = i + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    out_len[0] = w;
    return 0;
}
