// drama_plugin/src/digest.uya — SHA-256 → 十六进制（跨模块用同一份实现）
//
// 为什么不用 `std/crypto/sha256.sha256_digest`：它收 `&[byte]` 切片，而本仓
// 里"数组 + 动态长度"的切片会被检查器拒（DEBUG_BYTE_PTR_SUBSCRIPT_ERROR /
// 实参类型不兼容）。`tls.crypto.sha256.sha256(p, len, out)` 收指针 + 长度，
// 正好规避这个坑，代价只是多链进一点 crypto 代码。

use tls.crypto.sha256;

// p[0:n] 的 SHA-256，写成 64 个小写十六进制字符（不带 NUL）
export fn sha256_hex(p: &const byte, n: usize, out: &[byte],
    out_len: &usize) bool {
    out_len[0] = 0;
    if out.len < 64 {
        return false;
    }
    var dig: [byte: 32] = [0: 32];
    sha256(p, n, &dig[0]);
    var hd: [byte: 17] = [0: 17];   // copy_to 要留一个 NUL 位
    var hl: usize = 0;
    if !copy_to("0123456789abcdef" as &const byte, 16, &hd[0: 17], &hl) {
        return false;
    }
    var i: usize = 0;
    while i < 32 {
        const hi: usize = ((dig[i] as i32) >> 4) as! usize catch {
            0 as usize;
        };
        const lo: usize = ((dig[i] as i32) & 15) as! usize catch {
            0 as usize;
        };
        const at: usize = 2 * i;
        if at + 1 < out.len && hi < 16 && lo < 16 {
            out[at] = hd[hi];
            out[at + 1] = hd[lo];
        }
        i = i + 1;
    }
    out_len[0] = 64;
    return true;
}
