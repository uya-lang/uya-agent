// drama_plugin/src/main.uya — Drama CLI 入口（P1 骨架）
//
// 现在只有三种模式：
//   drama version                 打印版本
//   drama health                  打印一行 JSON 健康检查（含数据根目录）
//   drama mcp serve               stdio MCP server（三个工具）
//   drama worker run              Worker 骨架（P1 只报"未接任务"）
//
// 契约（DESIGN §2.3）：MCP 进程只处理控制面；Worker 独立进程；
// 两者共享同一数据根目录（现在只解析路径，还没有落盘逻辑）。

use std.runtime;
use libc.syscall;
use libc.unistd;

const VERSION: &const byte = "0.1.0" as &const byte;
const DIRCAP: usize = 512;

export fn version_string() &const byte {
    return VERSION;
}

// 数据根目录：P1 只认 `--data-dir`，缺省用 `./drama-data`（P3 起读配置文件）
var g_data_dir: [byte: 512] = [0: 512];

export fn data_root_ptr() &const byte {
    return &g_data_dir[0];
}

export fn data_root_len() usize {
    return b_len(&g_data_dir[0]);
}

fn set_default_data_dir() void {
    const d: &const byte = "./drama-data" as &const byte;
    var i: usize = 0;
    while i < 13 {
        g_data_dir[i] = d[i];
        i = i + 1;
    }
}

fn usage() void {
    say("drama " as &const byte);
    say(VERSION);
    say("\n用法：\n" as &const byte);
    say("  drama version\n" as &const byte);
    say("  drama health [--config FILE] [--data-dir DIR]\n" as &const byte);
    say("  drama mcp serve [--config FILE] [--data-dir DIR]\n" as &const byte);
    say("  drama worker run [--config FILE] [--data-dir DIR]\n" as &const byte);
}

fn cmd_version() i32 {
    say("drama " as &const byte);
    say(VERSION);
    say("\n" as &const byte);
    return 0;
}

fn cmd_health() i32 {
    say("{\"ok\":true,\"name\":\"drama\",\"version\":\"" as &const byte);
    say(VERSION);
    say("\",\"data_dir\":" as &const byte);
    var out: [byte: 640] = [0: 640];
    const dl: usize = b_len(&g_data_dir[0]);
    const w: usize = j_put_str(&out[0: 640], 0, &g_data_dir[0], dl);
    _ = fd_write_all(1, &out[0], w);
    say(",\"modes\":[\"mcp\",\"worker\"]," as &const byte);
    say("\"protocol\":\"2024-11-05\"}\n" as &const byte);
    return 0;
}

// worker run：扫一遍所有项目里未完成的任务并执行（P8 第一段）
fn cmd_worker() i32 {
    const rn: usize = data_root_len();
    // 单 Worker 锁：同一数据根只允许一个 worker 在跑
    if !worker_lock(data_root_ptr(), rn) {
        say("{\"busy\":true," as &const byte);
        say("\"reason\":\"another worker holds the lock\"}" as &const byte);
        say("\n" as &const byte);
        return 0;
    }
    defer { worker_unlock(data_root_ptr(), rn); }
    var out: [byte: 1024] = [0: 1024];
    var ol: [usize: 1] = [0];
    const rc: i32 = task_worker_run(data_root_ptr(), rn, &out[0: 1024],
        &ol[0]);
    if rc != 0 {
        say_err("drama: worker failed\n" as &const byte);
        return 1;
    }
    say(&out[0]);
    say("\n" as &const byte);
    return 0;
}

// 读 `--config FILE` 里的 data_dir（文件只认这一个字段，其余设置各有其文件）
fn config_read(path: &const byte, pn: usize, out: &[byte],
    out_len: &usize) bool {
    if pn == 0 || pn + 1 >= 512 {
        return false;
    }
    var p: [byte: 512] = [0: 512];
    var i: usize = 0;
    while i < pn {
        p[i] = path[i];
        i = i + 1;
    }
    p[i] = 0 as byte;
    const fd: i32 = sys_open(&p[0], 0, 0) catch { return false; };
    var buf: [byte: 4096] = [0: 4096];
    var total: usize = 0;
    while total < 4096 {
        const got: isize = sys_read(fd, &buf[total], 4096 - total) catch {
            break;
        };
        if got <= 0 {
            break;
        }
        total = total + (got as usize);
    }
    _ = sys_close(fd) catch { 0 as i32; };
    return j_str(&buf[0], total, "data_dir" as &const byte, out, out_len);
}

fn take_config(argc: i32) bool {
    var i: i32 = 1;
    while i + 1 < argc {
        const a: &byte = get_argv(i);
        if b_eq(a, b_len(a as &const byte), "--config" as &const byte) {
            const v: &byte = get_argv(i + 1);
            var out: [byte: 512] = [0: 512];
            var ol: usize = 0;
            if !config_read(v as &const byte, b_len(v as &const byte),
                &out[0: 512], &ol) {
                return false;
            }
            var k: usize = 0;
            while k < ol && k + 1 < DIRCAP {
                g_data_dir[k] = out[k];
                k = k + 1;
            }
            g_data_dir[k] = 0 as byte;
        }
        i = i + 1;
    }
    return true;
}

// 解析 `--data-dir DIR`
fn take_data_dir(argc: i32) void {
    var i: i32 = 1;
    while i + 1 < argc {
        const a: &byte = get_argv(i);
        if b_eq(a, b_len(a as &const byte), "--data-dir" as &const byte) {
            const v: &byte = get_argv(i + 1);
            const vn: usize = b_len(v as &const byte);
            // 不把全局数组切成 slice：`&g_data_dir[0: N]` 的 codegen 会把元素
            // 类型推断成 i32（生成 uya_slice_int32_t），直接逐字节拷更稳。
            var k: usize = 0;
            while k < vn && k + 1 < DIRCAP {
                g_data_dir[k] = v[k];
                k = k + 1;
            }
            g_data_dir[k] = 0 as byte;
        }
        i = i + 1;
    }
}

export fn main() i32 {
    set_default_data_dir();
    const argc: i32 = get_argc();
    if argc < 2 {
        usage();
        return 2;
    }
    if !take_config(argc) {
        say_err("drama: config unreadable or missing data_dir\n" as
            &const byte);
        return 2;
    }
    take_data_dir(argc);
    const a1: &byte = get_argv(1);
    const n1: usize = b_len(a1 as &const byte);
    if b_eq(a1 as &const byte, n1, "version" as &const byte) {
        return cmd_version();
    }
    if b_eq(a1 as &const byte, n1, "health" as &const byte) {
        return cmd_health();
    }
    if b_eq(a1 as &const byte, n1, "--help" as &const byte) {
        usage();
        return 0;
    }
    if b_eq(a1 as &const byte, n1, "mcp" as &const byte) {
        return serve();
    }
    if b_eq(a1 as &const byte, n1, "worker" as &const byte) {
        return cmd_worker();
    }
    say_err("drama: unknown command\n" as &const byte);
    usage();
    return 2;
}
