// drama_plugin/src/series.uya — 系列层：百集大纲与批准（P5 系列层 / P13 百集前提）
//
// 为什么需要它：百集不是"把一集重复一百遍"，得先有一张**大纲**——每集抛什么
// 钩子、兑现上一集的哪一个承诺、哪些人/场景/道具上场。大纲没批准之前，
// 逐集生成应当被拒绝（否则等于没有计划地产出）。
//
// 落盘（都在项目目录下）：
//   series/outline.json    {"format_version":1,"version":N,"episodes":[...]}
//   series/approved.json   {"outline_version":N}
//
// 大纲是用**确定性规则**从 Bible + 现有 Canon 生成的首版（mock 阶段不调模型）：
//   第 1 集开 1 个钩子；之后每集"兑现上一集钩子 + 开一个新钩子"；
//   每 3 集插一个笑点节拍；角色按 Bible 顺序轮换出场。
// 接真实模型后，替换点就是 plan_episode()。
//
// 返回码：0 成功 50 ID 非法 94 读写失败 96 大纲不存在 99 参数非法

use libc.syscall;
use libc.unistd;

const SER_BUF: usize = 24576;
const SER_DIR: &const byte = "series" as &const byte;
const PLAN_MAX: usize = 200;

fn sdir(root: &const byte, rn: usize, id: &const byte, idn: usize,
    out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, SER_DIR, b_len(SER_DIR), out, out_len);
}

fn snum(buf: &const byte, n: usize, key: &const byte) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return 0;
    }
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}

// 大纲当前版本（没有 = 0）
export fn series_version(root: &const byte, rn: usize, id: &const byte,
    idn: usize) i64 {
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !sdir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 0;
    }
    var buf: [byte: 512] = [0: 512];
    var bl: usize = 0;
    if !read_file(&dpath[0], dl, "outline.json" as &const byte, 12,
        &buf[0], 512, &bl) {
        return 0;
    }
    return snum(&buf[0], bl, "version" as &const byte);
}

// 已批准的大纲版本（没有批准记录 = 0）
export fn series_approved_version(root: &const byte, rn: usize,
    id: &const byte, idn: usize) i64 {
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !sdir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 0;
    }
    var buf: [byte: 256] = [0: 256];
    var bl: usize = 0;
    if !read_file(&dpath[0], dl, "approved.json" as &const byte, 13,
        &buf[0], 256, &bl) {
        return 0;
    }
    return snum(&buf[0], bl, "outline_version" as &const byte);
}

// 有没有大纲但没批准（逐集生成要不要拒绝，就看这个）
export fn series_blocks_generation(root: &const byte, rn: usize,
    id: &const byte, idn: usize) bool {
    const v: i64 = series_version(root, rn, id, idn);
    if v == 0 {
        return false;   // 没有大纲 = 自由生成（P5 早期链路保持可用）
    }
    return series_approved_version(root, rn, id, idn) < v;
}

// 一集的大纲条目
fn put_episode(out: &[byte], w0: usize, ep: i64, hook_prev: i64,
    hook_new: i64, gag: bool, who: &const byte, wn: usize) usize {
    var w: usize = w0;
    w = w + j_put(out, w, "{\"episode\":" as &const byte);
    w = w + j_put_i64(out, w, ep);
    w = w + j_put(out, w, ",\"pays_off\":" as &const byte);
    w = w + j_put_i64(out, w, hook_prev);
    w = w + j_put(out, w, ",\"opens_hook\":" as &const byte);
    w = w + j_put_i64(out, w, hook_new);
    w = w + j_put(out, w, ",\"comedy_beat\":" as &const byte);
    if gag {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"lead\":" as &const byte);
    w = w + j_put_str(out, w, who, wn);
    w = w + j_put(out, w, "}" as &const byte);
    return w;
}

// 从 Bible 里取第一个角色的名字（没有就用 dad）
fn pick_lead(root: &const byte, rn: usize, id: &const byte, idn: usize,
    out: &[byte], out_len: &usize) void {
    out_len[0] = 0;
    if !copy_to("dad" as &const byte, 3, out, out_len) {
        return;
    }
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8, &pdir[0: 512],
        &pdl) {
        return;
    }
    var dir: [byte: 512] = [0: 512];
    var dl0: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl0) {
        return;
    }
    var bdir: [byte: 512] = [0: 512];
    var bl0: usize = 0;
    if !path_join(&dir[0], dl0, "bible" as &const byte, 5, &bdir[0: 512],
        &bl0) {
        return;
    }
    // 先看当前版本号，再读那一版的快照（角色在里面）
    var cur: [byte: 128] = [0: 128];
    var cl0: usize = 0;
    if !read_file(&bdir[0], bl0, "current.json" as &const byte, 12,
        &cur[0], 128, &cl0) {
        return;
    }
    const ver: i64 = snum(&cur[0], cl0, "version" as &const byte);
    if ver <= 0 {
        return;
    }
    var snake: [byte: 32] = [0: 32];
    var snl: usize = 0;
    snl = snl + j_put_raw(&snake[0: 32], snl, "v" as &const byte, 1);
    snl = snl + j_put_i64(&snake[0: 32], snl, ver);
    snl = snl + j_put_raw(&snake[0: 32], snl, ".json" as &const byte, 5);
    var buf: [byte: 4096] = [0: 4096];
    var bl: usize = 0;
    if !read_file(&bdir[0], bl0, &snake[0], snl, &buf[0], 4096, &bl) {
        return;
    }
    // 抓 "characters" 数组里第一个对象的 name/id
    var cs: [usize: 1] = [0];
    var cl: [usize: 1] = [0];
    if j_span(&buf[0], bl, "characters" as &const byte, &cs[0],
        &cl[0]) != 91 as byte {
        return;
    }
    var es: [usize: 1] = [0];
    var el: [usize: 1] = [0];
    if !j_arr_item(&buf[cs[0]], cl[0], 0, &es[0], &el[0]) {
        return;
    }
    const first: &const byte = &buf[cs[0] + es[0]];
    var nm: [byte: 32] = [0: 32];
    var nl: usize = 0;
    if j_str(first, el[0], "name" as &const byte, &nm[0: 32], &nl)
        && nl > 0 {
        _ = copy_to(&nm[0], nl, out, out_len);
        return;
    }
    if j_str(first, el[0], "id" as &const byte, &nm[0: 32], &nl)
        && nl > 0 {
        _ = copy_to(&nm[0], nl, out, out_len);
    }
}

// 一季一条：起止集 + 一条弧（冲突/兑现点/角色成长）
fn put_season(out: &[byte], w0: usize, no: i64, from: i64, to: i64,
    who: &const byte, wn: usize) usize {
    var w: usize = w0;
    w = w + j_put(out, w, "{\"no\":" as &const byte);
    w = w + j_put_i64(out, w, no);
    w = w + j_put(out, w, ",\"from\":" as &const byte);
    w = w + j_put_i64(out, w, from);
    w = w + j_put(out, w, ",\"to\":" as &const byte);
    w = w + j_put_i64(out, w, to);
    w = w + j_put(out, w, ",\"arcs\":[{\"no\":1," as &const byte);
    w = w + j_put(out, w, "\"conflict\":\"处境恶化，误会叠误会\"," as
        &const byte);
    w = w + j_put(out, w, "\"payoff_episode\":" as &const byte);
    w = w + j_put_i64(out, w, to);
    w = w + j_put(out, w, ",\"character_arc\":" as &const byte);
    var arc: [byte: 96] = [0: 96];
    var al: usize = 0;
    al = al + j_put(&arc[0: 96], al, "\"" as &const byte);
    al = al + j_put_raw(&arc[0: 96], al, who, wn);
    al = al + j_put(&arc[0: 96], al, " 从被动到担当\"}" as &const byte);
    w = w + j_put_raw(out, w, &arc[0], al);
    w = w + j_put(out, w, "]}" as &const byte);
    return w;
}

// 生成大纲：确定性规则（接真实模型后替换这里）
export fn series_plan(root: &const byte, rn: usize, id: &const byte,
    idn: usize, total: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 50;
    }
    if total <= 0 || total > (PLAN_MAX as i64) {
        return 99;
    }
    var lead: [byte: 32] = [0: 32];
    var ll: [usize: 1] = [0];
    pick_lead(root, rn, id, idn, &lead[0: 32], &ll[0]);
    var body: [byte: SER_BUF] = [0: SER_BUF];
    var w: usize = 0;
    w = w + j_put(&body[0: SER_BUF], w,
        "{\"format_version\":1," as &const byte);
    w = w + j_put(&body[0: SER_BUF], w, "\"total_episodes\":" as &const byte);
    w = w + j_put_i64(&body[0: SER_BUF], w, total);
    w = w + j_put(&body[0: SER_BUF], w, ",\"episodes\":[" as &const byte);
    var ep: i64 = 1;
    while ep <= total {
        if ep > 1 {
            w = w + j_put(&body[0: SER_BUF], w, "," as &const byte);
        }
        // 第 1 集不兑现，之后每集兑现上一集的钩子；每集开一个新钩子
        var pays: i64 = 0;
        if ep > 1 {
            pays = ep -| 1;
        }
        // 每 3 集插一个笑点节拍（第 4、7、10… 集）
        const prev: i64 = ep -| 1;
        const mod: i64 = prev -| ((prev / 3) *| 3);
        const gag: bool = ep > 1 && mod == 0;
        w = put_episode(&body[0: SER_BUF], w, ep, pays, ep, gag, &lead[0],
            ll[0]);
        ep = ep + 1;
    }
    w = w + j_put(&body[0: SER_BUF], w, "]}" as &const byte);
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !sdir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 94;
    }
    const ver: i64 = series_version(root, rn, id, idn) +| 1;
    var saved: [byte: SER_BUF] = [0: SER_BUF];
    var sw: usize = 0;
    sw = sw + j_put(&saved[0: SER_BUF], sw,
        "{\"format_version\":1," as &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw, "\"version\":" as &const byte);
    sw = sw + j_put_i64(&saved[0: SER_BUF], sw, ver);
    // 系列层：题材模板 + 画布/时长 + 系列承诺 + 冻结口径
    sw = sw + j_put(&saved[0: SER_BUF], sw, ",\"series\":{" as &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw,
        "\"genre_template\":\"family_comedy.v1\"," as &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw, "\"format\":{" as &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw,
        "\"canvas\":\"440x800\",\"target_seconds\":90}," as &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw, "\"promises\":[" as &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw,
        "\"每集一个钩子\",\"钩子下一集兑现\",\"每 3 集一个笑点\"]," as
        &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw, "\"frozen\":{" as &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw,
        "\"genre_template\":true,\"format\":true," as &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw,
        "\"promises\":true}},\"seasons\":[" as &const byte);
    var sn: i64 = 1;
    const seas: i64 = (total +| 9) / 10;
    while sn <= seas {
        if sn > 1 {
            sw = sw + j_put(&saved[0: SER_BUF], sw, "," as &const byte);
        }
        var from: i64 = ((sn -| 1) *| 10) +| 1;
        var to: i64 = from +| 9;
        if to > total {
            to = total;
        }
        sw = put_season(&saved[0: SER_BUF], sw, sn, from, to, &lead[0],
            ll[0]);
        sn = sn + 1;
    }
    sw = sw + j_put(&saved[0: SER_BUF], sw, "]," as &const byte);
    sw = sw + j_put(&saved[0: SER_BUF], sw, "\"plan\":" as &const byte);
    sw = sw + j_put_raw(&saved[0: SER_BUF], sw, &body[0], w);
    sw = sw + j_put(&saved[0: SER_BUF], sw, "}" as &const byte);
    if !write_atomic(&dpath[0], dl, "outline.json" as &const byte, 12,
        &saved[0], sw) {
        return 94;
    }
    // 新大纲自动作废旧批准
    _ = sys_unlink(&dpath[0]) catch { 0 as i32; };
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"outline_version\":" as &const byte);
    ow = ow + j_put_i64(out, ow, ver);
    ow = ow + j_put(out, ow, ",\"total_episodes\":" as &const byte);
    ow = ow + j_put_i64(out, ow, total);
    ow = ow + j_put(out, ow, ",\"approved\":false}" as &const byte);
    out_len[0] = ow;
    return 0;
}

// 批准当前大纲（只有批了才允许逐集生成）
export fn series_approve(root: &const byte, rn: usize, id: &const byte,
    idn: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    const ver: i64 = series_version(root, rn, id, idn);
    if ver <= 0 {
        return 96;
    }
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !sdir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 94;
    }
    var b: [byte: 128] = [0: 128];
    var w: usize = 0;
    w = w + j_put(&b[0: 128], w, "{\"outline_version\":" as &const byte);
    w = w + j_put_i64(&b[0: 128], w, ver);
    w = w + j_put(&b[0: 128], w, "}" as &const byte);
    if !write_atomic(&dpath[0], dl, "approved.json" as &const byte, 13,
        &b[0], w) {
        return 94;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"outline_version\":" as &const byte);
    ow = ow + j_put_i64(out, ow, ver);
    ow = ow + j_put(out, ow, ",\"approved\":true}" as &const byte);
    out_len[0] = ow;
    return 0;
}

// 读大纲（原文）
export fn series_get(root: &const byte, rn: usize, id: &const byte,
    idn: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !sdir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 94;
    }
    if !read_file(&dpath[0], dl, "outline.json" as &const byte, 12,
        &out[0], out.len, out_len) {
        return 96;
    }
    return 0;
}
