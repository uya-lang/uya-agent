// drama_plugin/src/bible.uya — Bible 版本化存储（P3）
//
// 落盘形态：
//   <root>/projects/<id>/bible/v<N>.json   第 N 版快照
//   <root>/projects/<id>/bible/current.json {"version":N}
//
// 不变量（DESIGN §6.3 / TODO §5）：
//   * 每次内容变化生成新版本，旧版本永不覆盖 ⇒ "Bible 版本可追溯"；
//   * `locks` 里每个条目是「冻结描述文本」，写入时现场算 SHA-256 存进快照，
//     之后任何一次写入都能比对出「这段文本被改过」；
//   * 内容没变时不产生新版本（幂等），只回当前版本号。
//
// 输入约定：`bible` 是调用方给的 JSON 对象（原样存），`locks` 是
// `{"锁ID": "冻结文本"}` 形状的对象。
//
// 返回码：0 成功  40 项目 ID 非法  41 读写失败  42 版本不存在

use libc.syscall;
use libc.unistd;


const BIBLE_DIR: &const byte = "bible" as &const byte;
const BIBLE_BUF: usize = 32768;

fn same_hex(a: &const byte, b: &const byte, n: usize) bool {
    var i: usize = 0;
    while i < n {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 读某一版快照里的 content_hash（去掉引号，写回 buf 开头）
fn snapshot_hash(dpath: &const byte, dl: usize, version: i64,
    buf: &byte, cap: usize, out_len: &usize) bool {
    out_len[0] = 0;
    var namebuf: [byte: 32] = [0: 32];
    const nn: usize = snapshot_name(version, &namebuf[0: 32]);
    var sl: usize = 0;
    if !read_file(dpath, dl, &namebuf[0], nn, buf, cap, &sl) {
        return false;
    }
    var hs: [usize: 1] = [0];
    var hl: [usize: 1] = [0];
    const k: byte = j_span(buf, sl, "content_hash" as &const byte,
        &hs[0], &hl[0]);
    if k != 34 as byte || hl[0] < 2 || hl[0] - 2 > cap {
        return false;
    }
    var i: usize = 0;
    while i < hl[0] - 2 {
        buf[i] = buf[hs[0] + 1 + i];
        i = i + 1;
    }
    out_len[0] = hl[0] - 2;
    return true;
}

// bible 目录路径
fn bible_dir(root: &const byte, rn: usize, id: &const byte, idn: usize,
    out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, BIBLE_DIR, b_len(BIBLE_DIR), out, out_len);
}

// 读当前版本号；没有则 0
fn current_version(dpath: &const byte, dl: usize) i64 {
    var buf: [byte: 256] = [0: 256];
    var bl: usize = 0;
    if !read_file(dpath, dl, "current.json" as &const byte, 12,
        &buf[0], 256, &bl) {
        return 0;
    }
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    const k: byte = j_span(&buf[0], bl, "version" as &const byte,
        &st[0], &ln[0]);
    if k == 0 as byte {
        return 0;
    }
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| (c as i64) -| 48;
        i = i + 1;
    }
    return v;
}

fn snapshot_name(version: i64, out: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put_raw(out, w, "v" as &const byte, 1);
    w = w + j_put_i64(out, w, version);
    w = w + j_put_raw(out, w, ".json" as &const byte, 5);
    return w;
}

// 把 locks 对象转成 {"id":"<hash>"}，值缺失或非字符串就跳过
fn locks_hashed(locks: &const byte, ln: usize, out: &[byte],
    at0: usize) usize {
    var w: usize = at0;
    var first: bool = true;
    var idx: usize = 0;
    while true {
        var key: [byte: 128] = [0: 128];
        var kl: usize = 0;
        if !j_key_at(locks, ln, idx, &key[0: 128], &kl) {
            break;
        }
        var st: [usize: 1] = [0];
        var sl: [usize: 1] = [0];
        const k: byte = j_span(locks, ln, &key[0], &st[0], &sl[0]);
        if k == 34 as byte && sl[0] >= 3 {
            var tbuf: [byte: 1024] = [0: 1024];
            var tl: usize = 0;
            if copy_to(&locks[st[0] + 1], sl[0] - 2, &tbuf[0: 1024],
                &tl) {
                var hex: [byte: 64] = [0: 64];
                var hl: usize = 0;
                if !sha256_hex(&tbuf[0], tl, &hex[0: 64], &hl) {
                    idx = idx + 1;
                    continue;
                }
                const hn: usize = hl;
                if !first {
                    w = w + j_put_raw(out, w, "," as &const byte, 1);
                }
                w = w + j_put_str(out, w, &key[0], kl);
                w = w + j_put_raw(out, w, ":\"" as &const byte, 2);
                w = w + j_put_raw(out, w, &hex[0], hn);
                w = w + j_put_raw(out, w, "\"" as &const byte, 1);
                first = false;
            }
        }
        idx = idx + 1;
    }
    return w;
}

// 新版 locks 里有没有"同一个 ID、hash 变了"的条目
fn locks_drifted(dpath: &const byte, dl: usize, cur: i64,
    new_locks: &const byte, nn: usize) bool {
    var nm: [byte: 32] = [0: 32];
    var nl: usize = 0;
    nl = nl + j_put_raw(&nm[0: 32], nl, "v" as &const byte, 1);
    nl = nl + j_put_i64(&nm[0: 32], nl, cur);
    nl = nl + j_put_raw(&nm[0: 32], nl, ".json" as &const byte, 5);
    var buf: [byte: BIBLE_BUF] = [0: BIBLE_BUF];
    var bl: usize = 0;
    if !read_file(dpath, dl, &nm[0], nl, &buf[0], BIBLE_BUF, &bl) {
        return false;
    }
    var ls: [usize: 1] = [0];
    var ll: [usize: 1] = [0];
    if j_span(&buf[0], bl, "locks" as &const byte, &ls[0],
        &ll[0]) != 123 as byte {
        return false;
    }
    const old_locks: &const byte = &buf[ls[0]];
    var idx: usize = 0;
    while true {
        var key: [byte: 64] = [0: 64];
        var kl: usize = 0;
        if !j_key_at(new_locks, nn, idx, &key[0: 64], &kl) {
            return false;
        }
        var oh: [byte: 72] = [0: 72];
        var ohl: usize = 0;
        if j_str(old_locks, ll[0], &key[0], &oh[0: 72], &ohl) && ohl > 0 {
            var nh: [byte: 72] = [0: 72];
            var nhl: usize = 0;
            if j_str(new_locks, nn, &key[0], &nh[0: 72], &nhl)
                && nhl == ohl && !same_hex(&oh[0], &nh[0], nhl) {
                return true;
            }
        }
        idx = idx + 1;
    }
}

// 写入一版；返回值语义见文件头
export fn bible_put(root: &const byte, rn: usize, id: &const byte,
    idn: usize, bible: &const byte, bl: usize, locks: &const byte,
    ll: usize, allow_drift: bool, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 40;
    }
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !bible_dir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 41;
    }
    // 先把「正文 + 锁哈希」拼成 payload，再对整个 payload 取 hash：
    // 冻结文本改了也必须产生新版本，所以锁的哈希要进 content_hash 的覆盖面。
    var payload: [byte: BIBLE_BUF] = [0: BIBLE_BUF];
    var pw: usize = 0;
    pw = pw + j_put(&payload[0: BIBLE_BUF], pw, "\"bible\":" as &const byte);
    pw = pw + j_put_raw(&payload[0: BIBLE_BUF], pw, bible, bl);
    pw = pw + j_put(&payload[0: BIBLE_BUF], pw, ",\"locks\":{" as &const byte);
    pw = locks_hashed(locks, ll, &payload[0: BIBLE_BUF], pw);
    pw = pw + j_put(&payload[0: BIBLE_BUF], pw, "}" as &const byte);
    var hex: [byte: 64] = [0: 64];
    var hl0: [usize: 1] = [0];
    if !sha256_hex(&payload[0], pw, &hex[0: 64], &hl0[0]) {
        return 41;
    }
    const hn: usize = hl0[0];
    const cur: i64 = current_version(&dpath[0], dl);
    // 冻结文本漂移：同一个锁 ID 的 hash 变了却没人显式允许 ⇒ CHARACTER_DRIFT
    if cur > 0 && !allow_drift {
        // payload 里 locks 是最后一段 {"locks":{...}}，取它的对象区间来比
        var lks: [usize: 1] = [0];
        var lkl: [usize: 1] = [0];
        if j_span(&payload[0], pw, "locks" as &const byte, &lks[0],
            &lkl[0]) == 123 as byte {
            if locks_drifted(&dpath[0], dl, cur, &payload[lks[0]], lkl[0]) {
                return 99;
            }
        }
    }
    var version: i64 = cur +| 1;
    var created: bool = true;
    if cur > 0 {
        // 内容没变就不产生新版本（幂等）
        var pbuf: &byte = malloc(4096) as &byte;
        defer { free(pbuf as &void); }
        var phl: usize = 0;
        if (pbuf as usize) != 0
            && snapshot_hash(&dpath[0], dl, cur, pbuf, 4096, &phl)
            && phl == hn && same_hex(&pbuf[0], &hex[0], hn) {
            version = cur;
            created = false;
        }
    }
    var namebuf: [byte: 32] = [0: 32];
    const nn: usize = snapshot_name(version, &namebuf[0: 32]);
    var body: [byte: BIBLE_BUF] = [0: BIBLE_BUF];
    var w: usize = 0;
    w = w + j_put(&body[0: BIBLE_BUF], w,
        "{\"format_version\":1,\"version\":" as &const byte);
    w = w + j_put_i64(&body[0: BIBLE_BUF], w, version);
    w = w + j_put(&body[0: BIBLE_BUF], w,
        ",\"content_hash\":\"" as &const byte);
    w = w + j_put_raw(&body[0: BIBLE_BUF], w, &hex[0], hn);
    w = w + j_put(&body[0: BIBLE_BUF], w, "\"," as &const byte);
    w = w + j_put_raw(&body[0: BIBLE_BUF], w, &payload[0], pw);
    w = w + j_put(&body[0: BIBLE_BUF], w, "}" as &const byte);
    if !write_atomic(&dpath[0], dl, &namebuf[0], nn, &body[0], w) {
        return 43;
    }
    var cur_body: [byte: 128] = [0: 128];
    var cw: usize = 0;
    cw = cw + j_put(&cur_body[0: 128], cw, "{\"version\":" as &const byte);
    cw = cw + j_put_i64(&cur_body[0: 128], cw, version);
    cw = cw + j_put(&cur_body[0: 128], cw, "}" as &const byte);
    if !write_atomic(&dpath[0], dl, "current.json" as &const byte, 12,
        &cur_body[0], cw) {
        return 44;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"version\":" as &const byte);
    ow = ow + j_put_i64(out, ow, version);
    ow = ow + j_put(out, ow, ",\"content_hash\":\"" as &const byte);
    ow = ow + j_put_raw(out, ow, &hex[0], hn);
    ow = ow + j_put(out, ow, "\",\"created\":" as &const byte);
    if created {
        ow = ow + j_put(out, ow, "true}" as &const byte);
    } else {
        ow = ow + j_put(out, ow, "false}" as &const byte);
    }
    out_len[0] = ow;
    return 0;
}

// 取某一版（version=0 表示当前版）
export fn bible_get(root: &const byte, rn: usize, id: &const byte,
    idn: usize, version: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 40;
    }
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !bible_dir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 41;
    }
    var v: i64 = version;
    if v <= 0 {
        v = current_version(&dpath[0], dl);
    }
    if v <= 0 {
        return 42;
    }
    var namebuf: [byte: 32] = [0: 32];
    const nn: usize = snapshot_name(v, &namebuf[0: 32]);
    if !read_file(&dpath[0], dl, &namebuf[0], nn, &out[0], out.len,
        out_len) {
        return 42;
    }
    return 0;
}

// 历史：逐版取 content_hash，拼成数组
export fn bible_history(root: &const byte, rn: usize, id: &const byte,
    idn: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 40;
    }
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !bible_dir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 41;
    }
    const cur: i64 = current_version(&dpath[0], dl);
    var w: usize = 0;
    w = w + j_put(out, w, "{\"versions\":[" as &const byte);
    var v: i64 = 1;
    var first: bool = true;
    var sn: &byte = malloc(4096) as &byte;
    defer { free(sn as &void); }
    while v <= cur {
        var namebuf: [byte: 32] = [0: 32];
        const nn: usize = snapshot_name(v, &namebuf[0: 32]);
        var sl: usize = 0;
        if read_file(&dpath[0], dl, &namebuf[0], nn, sn, 4096, &sl) {
            var hs: [usize: 1] = [0];
            var hl: [usize: 1] = [0];
            const k: byte = j_span(sn, sl, "content_hash" as &const byte,
                &hs[0], &hl[0]);
            if !first {
                w = w + j_put(out, w, "," as &const byte);
            }
            w = w + j_put(out, w, "{\"version\":" as &const byte);
            w = w + j_put_i64(out, w, v);
            w = w + j_put(out, w, ",\"content_hash\":" as &const byte);
            if k == 34 as byte {
                w = w + j_put_raw(out, w, &sn[hs[0]], hl[0]);
            } else {
                w = w + j_put(out, w, "\"\"" as &const byte);
            }
            w = w + j_put(out, w, "}" as &const byte);
            first = false;
        }
        v = v + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    out_len[0] = w;
    return 0;
}
