// drama_plugin/src/assemble.uya — 成片合成（P10 第一段，mock 拼接）
//
// 首版不做真实转码（stdlib 里没有 ffmpeg 绑定，产线脚本在宿主侧跑）：
// 这里把分镜里每个镜头的占位文件**按顺序**拼成一个成片文件，并写一份清单
// （镜头顺序、每镜大小、总时长、成片 SHA-256）。真接产线时，替换点就是
// `concat_shots`：入参不变、只换成调 PipelineProvider。
//
// 确定性：同一份分镜、同一批镜头文件 ⇒ 成片字节一致（manifest 里也记 hash）。
//
// 返回码：0 成功 94 读写失败 96 分镜不存在 97 镜头文件缺失

use libc.syscall;
use libc.unistd;

const ASM_BUF: usize = 262144;
const ASM_DIR: &const byte = "assemblies" as &const byte;
const SHOT_MAX_A: usize = 64;

// 平铺存文件名：Uya 的嵌套定长数组类型过不了 codegen，这里按 32 字节一格
const NAME_SLOT: usize = 32;

struct AsmList {
    names: [byte: SHOT_MAX_A * NAME_SLOT],
    lens: [usize: SHOT_MAX_A],
    count: usize,
    total_ms: i64,
}

fn blank_list() AsmList {
    return AsmList{ names: [0: SHOT_MAX_A * NAME_SLOT],
        lens: [0: SHOT_MAX_A], count: 0, total_ms: 0 };
}

fn name_at(l: &AsmList, i: usize) &const byte {
    if i >= SHOT_MAX_A {
        return &l.names[0];
    }
    return &l.names[i * NAME_SLOT];
}

fn adir2(root: &const byte, rn: usize, id: &const byte, idn: usize,
    leaf: &const byte, ln: usize, out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, leaf, ln, out, out_len);
}

fn anum2(buf: &const byte, n: usize, key: &const byte) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return 0;
    }
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}

// 从分镜里收集镜头文件名（shot_<seq>.mp4）
fn collect_shot_names(bd: &const byte, bn: usize, l: &AsmList) bool {
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(bd, bn, "shots" as &const byte, &ss[0], &sl[0]) != 91 as byte {
        return false;
    }
    var idx: usize = 0;
    while l.count < SHOT_MAX_A {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&bd[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sh: &const byte = &bd[ss[0] + es[0]];
        const seq: i64 = anum2(sh, el[0], "sequence" as &const byte);
        const dur: i64 = anum2(sh, el[0], "duration_ms" as &const byte);
        var nm: [byte: 32] = [0: 32];
        var nn: usize = 0;
        nn = nn + j_put_raw(&nm[0: 32], nn, "shot_" as &const byte, 5);
        nn = nn + j_put_i64(&nm[0: 32], nn, seq);
        nn = nn + j_put_raw(&nm[0: 32], nn, ".mp4" as &const byte, 4);
        if l.count < SHOT_MAX_A && nn <= NAME_SLOT {
            const base: usize = l.count * NAME_SLOT;
            var k: usize = 0;
            while k < nn {
                l.names[base + k] = nm[k];
                k = k + 1;
            }
        }
        l.lens[l.count] = nn;
        l.count = l.count + 1;
        l.total_ms = l.total_ms +| dur;
        idx = idx + 1;
    }
    return l.count > 0;
}

// 逐个镜头读出来，顺序拼进 out；返回写入字节数，-1 = 有镜头文件缺失
fn concat_shots(adir: &const byte, al: usize, l: &AsmList,
    out: &[byte]) i64 {
    var buf: &byte = malloc(ASM_BUF) as &byte;
    defer { free(buf as &void); }
    if (buf as usize) == 0 {
        return -1;
    }
    var w: usize = 0;
    var i: usize = 0;
    while i < l.count {
        var bl: [usize: 1] = [0];
        if !read_file(adir, al, name_at(l, i), l.lens[i], &buf[0],
            ASM_BUF, &bl[0]) {
            return -1;
        }
        var k: usize = 0;
        while k < bl[0] && w < out.len {
            out[w] = buf[k];
            w = w + 1;
            k = k + 1;
        }
        i = i + 1;
    }
    return w as i64;
}

export fn asm_version(dpath: &const byte, dl: usize) i64 {
    var buf: [byte: 128] = [0: 128];
    var bl: usize = 0;
    if !read_file(dpath, dl, "current.json" as &const byte, 12, &buf[0],
        128, &bl) {
        return 0;
    }
    return anum2(&buf[0], bl, "version" as &const byte);
}

// 帧数硬约束：25 fps 下成片必须是 17k+5 帧（不足则向上取到最近的合法帧数）
fn snap_frames(ms: i64) i64 {
    const base: i64 = (ms *| 25) / 1000;
    var b: i64 = base -| 5;
    if b < 0 {
        b = 0;
    }
    var k: i64 = (b +| 16) / 17;
    if k < 1 {
        k = 1;
    }
    return (k *| 17) +| 5;
}

// manifest：合成清单（镜头数、时长、大小、输出名、hash）
fn put_manifest(out: &[byte], ver: i64, board_ver: i64, shots: usize,
    total_ms: i64, size: i64, name: &const byte, nn: usize,
    hex: &const byte) usize {
    var w: usize = 0;
    w = w + j_put(out, w, "{\"format_version\":1," as &const byte);
    w = w + j_put(out, w, "\"assembly_version\":" as &const byte);
    w = w + j_put_i64(out, w, ver);
    w = w + j_put(out, w, ",\"board_version\":" as &const byte);
    w = w + j_put_i64(out, w, board_ver);
    w = w + j_put(out, w, ",\"shots\":" as &const byte);
    w = w + j_put_i64(out, w, shots as i64);
    w = w + j_put(out, w, ",\"duration_ms\":" as &const byte);
    w = w + j_put_i64(out, w, total_ms);
    w = w + j_put(out, w, ",\"fps\":25,\"frames\":" as &const byte);
    w = w + j_put_i64(out, w, snap_frames(total_ms));
    w = w + j_put(out, w, ",\"size\":" as &const byte);
    w = w + j_put_i64(out, w, size);
    w = w + j_put(out, w, ",\"output\":" as &const byte);
    w = w + j_put_str(out, w, name, nn);
    w = w + j_put(out, w, ",\"sha256\":\"" as &const byte);
    w = w + j_put_raw(out, w, hex, 64);
    w = w + j_put(out, w, "\"}" as &const byte);
    return w;
}

// 调用方给的 board_ver 为 0 时用当前版本；镜头目录必须落到真实版本号
fn resolved_board(root: &const byte, rn: usize, id: &const byte,
    idn: usize, board_ver: i64) i64 {
    if board_ver > 0 {
        return board_ver;
    }
    return board_version(root, rn, id, idn);
}

// 镜头目录：<assets>/v<board_version>
fn board_dir(base: &const byte, bl: usize, bv: i64, out: &[byte],
    out_len: &usize) bool {
    var vn: [byte: 16] = [0: 16];
    var vnn: usize = 0;
    vnn = vnn + j_put_raw(&vn[0: 16], vnn, "v" as &const byte, 1);
    vnn = vnn + j_put_i64(&vn[0: 16], vnn, bv);
    return path_join(base, bl, &vn[0], vnn, out, out_len);
}

// 合成一集成片：读分镜 → 收集镜头 → 拼接 → 写 manifest
export fn assemble_run(root: &const byte, rn: usize, id: &const byte,
    idn: usize, board_ver: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    // 调用方可以只给 0 表示"当前版本"；镜头目录要按真实版本号找
    const bv: i64 = resolved_board(root, rn, id, idn, board_ver);
    var rec: [byte: ASM_BUF] = [0: ASM_BUF];
    var rl: [usize: 1] = [0];
    if board_get(root, rn, id, idn, bv, &rec[0: ASM_BUF],
        &rl[0]) != 0 {
        return 96;
    }
    var bs: [usize: 1] = [0];
    var bl2: [usize: 1] = [0];
    if j_span(&rec[0], rl[0], "board" as &const byte, &bs[0],
        &bl2[0]) != 123 as byte {
        return 96;
    }
    const bd: &const byte = &rec[bs[0]];
    var lst: AsmList = blank_list();
    if !collect_shot_names(bd, bl2[0], &lst) {
        return 96;
    }
    var adir: [byte: 512] = [0: 512];
    var al: usize = 0;
    if !adir2(root, rn, id, idn, "assets" as &const byte, 6,
        &adir[0: 512], &al) {
        return 94;
    }
    // 镜头按分镜版本分目录存，拼接只在本次分镜自己的目录里找
    var vdir: [byte: 512] = [0: 512];
    var vl: usize = 0;
    if !board_dir(&adir[0], al, bv, &vdir[0: 512], &vl) {
        return 94;
    }
    var film: &byte = malloc(ASM_BUF) as &byte;
    defer { free(film as &void); }
    if (film as usize) == 0 {
        return 94;
    }
    const fn_len: i64 = concat_shots(&vdir[0], vl, &lst,
        &film[0: ASM_BUF]);
    if fn_len < 0 {
        return 97;   // 有镜头文件缺失
    }
    const fsize: usize = fn_len as! usize catch { 0 as usize; };
    var hex: [byte: 64] = [0: 64];
    var hl: [usize: 1] = [0];
    if !sha256_hex(&film[0], fsize, &hex[0: 64], &hl[0]) {
        return 94;
    }
    var dd: [byte: 512] = [0: 512];
    var ddl: usize = 0;
    if !adir2(root, rn, id, idn, ASM_DIR, b_len(ASM_DIR), &dd[0: 512],
        &ddl) {
        return 94;
    }
    const ver: i64 = asm_version(&dd[0], ddl) +| 1;
    // 成片文件
    var fname: [byte: 48] = [0: 48];
    var fnl: usize = 0;
    fnl = fnl + j_put_raw(&fname[0: 48], fnl, "episode_" as &const byte, 8);
    fnl = fnl + j_put_i64(&fname[0: 48], fnl, ver);
    fnl = fnl + j_put_raw(&fname[0: 48], fnl, ".mp4" as &const byte, 4);
    if !write_atomic(&adir[0], al, &fname[0], fnl, &film[0], fsize) {
        return 94;
    }
    // 成片登记进资产账本（asset_register 会重新读文件算 hash/大小）
    if !asset_registered(root, rn, id, idn, &fname[0], fnl) {
        const arc: i32 = asset_register(root, rn, id, idn, &fname[0], fnl,
            "video/mp4" as &const byte, 9);
        if arc != 0 {
            return 94;
        }
    }
    var man: [byte: 4096] = [0: 4096];
    const w: usize = put_manifest(&man[0: 4096], ver,
        anum2(&rec[0], rl[0], "version" as &const byte), lst.count,
        lst.total_ms, fsize as i64, &fname[0], fnl, &hex[0]);
    // manifest + current.json（合成清单是不可变版本，current 指最新）
    var mn: [byte: 32] = [0: 32];
    var mnl: usize = 0;
    mnl = mnl + j_put_raw(&mn[0: 32], mnl, "v" as &const byte, 1);
    mnl = mnl + j_put_i64(&mn[0: 32], mnl, ver);
    mnl = mnl + j_put_raw(&mn[0: 32], mnl, ".json" as &const byte, 5);
    if !write_atomic(&dd[0], ddl, &mn[0], mnl, &man[0], w) {
        return 94;
    }
    var cur: [byte: 128] = [0: 128];
    var cw: usize = 0;
    cw = cw + j_put(&cur[0: 128], cw, "{\"version\":" as &const byte);
    cw = cw + j_put_i64(&cur[0: 128], cw, ver);
    cw = cw + j_put(&cur[0: 128], cw, "}" as &const byte);
    _ = write_atomic(&dd[0], ddl, "current.json" as &const byte, 12,
        &cur[0], cw);
    out_len[0] = w;
    var i: usize = 0;
    while i < w && i < out.len {
        out[i] = man[i];
        i = i + 1;
    }
    return 0;
}

// 当前合成版本（给 episode.get 汇总用）
export fn assemble_current_version(root: &const byte, rn: usize,
    id: &const byte, idn: usize) i64 {
    var dd: [byte: 512] = [0: 512];
    var ddl: usize = 0;
    if !adir2(root, rn, id, idn, ASM_DIR, b_len(ASM_DIR), &dd[0: 512],
        &ddl) {
        return 0;
    }
    return asm_version(&dd[0], ddl);
}
