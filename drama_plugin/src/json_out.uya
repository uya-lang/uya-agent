// drama_plugin/src/json_out.uya — 定长缓冲上的 JSON 写手（P1 骨架）
//
// 每个函数返回"写了多少字节"，调用方自己累加偏移；写不下就少写（由调用方的
// 缓冲余量保证够用，够不够由 emit_* 的 OUT_MAX 兜底）。

fn put_raw(out: &[byte], at: usize, p: &const byte, n: usize) usize {
    var i: usize = 0;
    while i < n && at + i < out.len {
        out[at + i] = p[i];
        i = i + 1;
    }
    return i;
}

export fn j_put(out: &[byte], at: usize, s: &const byte) usize {
    return put_raw(out, at, s, b_len(s));
}

export fn j_put_i64(out: &[byte], at: usize, v: i64) usize {
    if v == 0 {
        return put_raw(out, at, "0" as &const byte, 1);
    }
    var x: i64 = v;
    var pre: usize = 0;
    if x < 0 {
        pre = put_raw(out, at, "-" as &const byte, 1);
        x = 0 -| x;
    }
    var tmp: [byte: 24] = [0: 24];
    var n: usize = 0;
    while x > 0 {
        const t10: i64 = (x / 10) *| 10;
        const rem: i64 = x -| t10;
        tmp[n] = (rem +| 48) as! byte catch { 48 as byte; };
        n = n + 1;
        x = x / 10;
    }
    var k: usize = 0;
    while n > 0 {
        n = n - 1;
        k = k + put_raw(out, at + pre + k, &tmp[n] as &const byte, 1);
    }
    return pre + k;
}

// 带引号、按 JSON 规则转义
export fn j_put_str(out: &[byte], at: usize, p: &const byte, n: usize) usize {
    var w: usize = 0;
    w = w + put_raw(out, at + w, "\"" as &const byte, 1);
    const hexd: &const byte = "0123456789abcdef" as &const byte;
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c == 34 as byte {
            w = w + put_raw(out, at + w, "\\\"" as &const byte, 2);
        } else if c == 92 as byte {
            w = w + put_raw(out, at + w, "\\\\" as &const byte, 2);
        } else if c == 10 as byte {
            w = w + put_raw(out, at + w, "\\n" as &const byte, 2);
        } else if c == 13 as byte {
            w = w + put_raw(out, at + w, "\\r" as &const byte, 2);
        } else if c == 9 as byte {
            w = w + put_raw(out, at + w, "\\t" as &const byte, 2);
        } else if c < 32 as byte {
            const hi: usize = ((c as i32) >> 4) as! usize catch { 0 as usize; };
            const lo: usize = ((c as i32) & 15) as! usize catch { 0 as usize; };
            w = w + put_raw(out, at + w, "\\u00" as &const byte, 4);
            w = w + put_raw(out, at + w, &hexd[hi] as &const byte, 1);
            w = w + put_raw(out, at + w, &hexd[lo] as &const byte, 1);
        } else {
            w = w + put_raw(out, at + w, &p[i] as &const byte, 1);
        }
        i = i + 1;
    }
    w = w + put_raw(out, at + w, "\"" as &const byte, 1);
    return w;
}

export fn j_put_hex(out: &[byte], at: usize, v: u64) usize {
    const hexd: &const byte = "0123456789abcdef" as &const byte;
    var w: usize = 0;
    var i: i32 = 15;
    while i >= 0 {
        const sh: i32 = i * 4;
        const nib: u64 = (v >> sh) & (15 as u64);
        const idx: usize = nib as! usize catch { 0 as usize; };
        w = w + put_raw(out, at + w, &hexd[idx] as &const byte, 1);
        i = i - 1;
    }
    return w;
}
