// drama_plugin/src/json_min.uya — 一行 JSON 的最小读取器（P1 骨架）
//
// 只做 MCP 请求需要的那几件事：找键、取字符串值、取 id、比较方法名。
// 不追求通用：完整 JSON 解析留给 `std/json`（嵌套上限 256，见 DESIGN §18.1）。

// 找 `"key"`（必须是键：后面跳过空白跟 ':'），返回冒号之后的下标；-1 = 没有
export fn j_find_key(p: &const byte, n: usize, key: &const byte) isize {
    const kl: usize = b_len(key);
    var i: usize = 0;
    while i + kl + 2 <= n {
        if p[i] != 34 as byte {
            i = i + 1;
            continue;
        }
        var same: bool = true;
        var k: usize = 0;
        while k < kl {
            if p[i + 1 + k] != key[k] {
                same = false;
                break;
            }
            k = k + 1;
        }
        if !same || p[i + 1 + kl] != 34 as byte {
            i = i + 1;
            continue;
        }
        var j: usize = i + 2 + kl;
        while j < n && (p[j] == 32 as byte || p[j] == 9 as byte) {
            j = j + 1;
        }
        if j < n && p[j] == 58 as byte {
            return (j + 1) as isize;
        }
        i = i + 1;
    }
    return -1;
}

// 取 `"key":"value"` 的值（反转义 `\"` 与 `\\`），写入 out（NUL 结尾）
export fn j_str(p: &const byte, n: usize, key: &const byte,
    out: &[byte], out_len: &usize) bool {
    out_len[0] = 0;
    const at: isize = j_find_key(p, n, key);
    if at < 0 {
        return false;
    }
    var i: usize = at as! usize catch { return false; };
    while i < n && (p[i] == 32 as byte || p[i] == 9 as byte) {
        i = i + 1;
    }
    if i >= n || p[i] != 34 as byte {
        return false;
    }
    i = i + 1;
    var esc: bool = false;
    var w: usize = 0;
    while i < n {
        const c: byte = p[i];
        if esc {
            esc = false;
            if w + 1 >= out.len {
                return false;
            }
            out[w] = c;
            w = w + 1;
        } else if c == 92 as byte {
            esc = true;
        } else if c == 34 as byte {
            out[w] = 0 as byte;
            out_len[0] = w;
            return true;
        } else {
            if w + 1 >= out.len {
                return false;
            }
            out[w] = c;
            w = w + 1;
        }
        i = i + 1;
    }
    return false;
}

// 取 `"id":<整数>`；没有或不是非负整数返回 -1
export fn j_id(p: &const byte, n: usize) i64 {
    const at: isize = j_find_key(p, n, "id" as &const byte);
    if at < 0 {
        return -1;
    }
    var i: usize = at as! usize catch { return -1; };
    while i < n && (p[i] == 32 as byte || p[i] == 9 as byte) {
        i = i + 1;
    }
    var v: i64 = 0;
    var digits: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = (v *| 10) +| ((c as i64) - 48);
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        return -1;
    }
    return v;
}

// `"method"` 的值是否等于 want
export fn j_method_is(p: &const byte, n: usize, want: &const byte) bool {
    var buf: [byte: 64] = [0: 64];
    var bl: usize = 0;
    if !j_str(p, n, "method" as &const byte, &buf[0: 64], &bl) {
        return false;
    }
    return b_eq(&buf[0], bl, want);
}

// 取字符串字段并放进调用方缓冲（j_str 的薄封装，省一层 out_len）
export fn j_field(p: &const byte, n: usize, key: &const byte, out: &[byte]) bool {
    var l: usize = 0;
    return j_str(p, n, key, out, &l);
}
