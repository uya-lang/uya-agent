// drama_plugin/src/json_min.uya — 一行 JSON 的最小读取器（P1 骨架）
//
// 只做 MCP 请求需要的那几件事：找键、取字符串值、取 id、比较方法名。
// 不追求通用：完整 JSON 解析留给 `std/json`（嵌套上限 256，见 DESIGN §18.1）。

// 找 `"key"`（必须是键：后面跳过空白跟 ':'），返回冒号之后的下标；-1 = 没有
export fn j_find_key(p: &const byte, n: usize, key: &const byte) isize {
    const kl: usize = b_len(key);
    var i: usize = 0;
    while i + kl + 2 <= n {
        if p[i] != 34 as byte {
            i = i + 1;
            continue;
        }
        var same: bool = true;
        var k: usize = 0;
        while k < kl {
            if p[i + 1 + k] != key[k] {
                same = false;
                break;
            }
            k = k + 1;
        }
        if !same || p[i + 1 + kl] != 34 as byte {
            i = i + 1;
            continue;
        }
        var j: usize = i + 2 + kl;
        while j < n && (p[j] == 32 as byte || p[j] == 9 as byte) {
            j = j + 1;
        }
        if j < n && p[j] == 58 as byte {
            return (j + 1) as isize;
        }
        i = i + 1;
    }
    return -1;
}

// 取 `"key":"value"` 的值（反转义 `\"` 与 `\\`），写入 out（NUL 结尾）
export fn j_str(p: &const byte, n: usize, key: &const byte,
    out: &[byte], out_len: &usize) bool {
    out_len[0] = 0;
    const at: isize = j_find_key(p, n, key);
    if at < 0 {
        return false;
    }
    var i: usize = at as! usize catch { return false; };
    while i < n && (p[i] == 32 as byte || p[i] == 9 as byte) {
        i = i + 1;
    }
    if i >= n || p[i] != 34 as byte {
        return false;
    }
    i = i + 1;
    var esc: bool = false;
    var w: usize = 0;
    while i < n {
        const c: byte = p[i];
        if esc {
            esc = false;
            if w + 1 >= out.len {
                return false;
            }
            out[w] = c;
            w = w + 1;
        } else if c == 92 as byte {
            esc = true;
        } else if c == 34 as byte {
            out[w] = 0 as byte;
            out_len[0] = w;
            return true;
        } else {
            if w + 1 >= out.len {
                return false;
            }
            out[w] = c;
            w = w + 1;
        }
        i = i + 1;
    }
    return false;
}

// 取 `"id":<整数>`；没有或不是非负整数返回 -1
export fn j_id(p: &const byte, n: usize) i64 {
    const at: isize = j_find_key(p, n, "id" as &const byte);
    if at < 0 {
        return -1;
    }
    var i: usize = at as! usize catch { return -1; };
    while i < n && (p[i] == 32 as byte || p[i] == 9 as byte) {
        i = i + 1;
    }
    var v: i64 = 0;
    var digits: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = (v *| 10) +| ((c as i64) - 48);
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        return -1;
    }
    return v;
}

// `"method"` 的值是否等于 want
export fn j_method_is(p: &const byte, n: usize, want: &const byte) bool {
    var buf: [byte: 64] = [0: 64];
    var bl: usize = 0;
    if !j_str(p, n, "method" as &const byte, &buf[0: 64], &bl) {
        return false;
    }
    return b_eq(&buf[0], bl, want);
}

// 取字符串字段并放进调用方缓冲（j_str 的薄封装，省一层 out_len）
export fn j_field(p: &const byte, n: usize, key: &const byte,
    out: &[byte]) bool {
    var l: usize = 0;
    return j_str(p, n, key, out, &l);
}

// ---- 值的定位（P2：校验 input 对象用） ----

fn skip_ws(p: &const byte, n: usize, i0: usize) usize {
    var i: usize = i0;
    while i < n && (p[i] == 32 as byte || p[i] == 9 as byte
        || p[i] == 10 as byte || p[i] == 13 as byte) {
        i = i + 1;
    }
    return i;
}

// 从 i（指向开引号）走到配对的后引号之后；失败返回 n
fn skip_string(p: &const byte, n: usize, i0: usize) usize {
    var i: usize = i0;
    if i >= n || p[i] != 34 as byte {
        return n;
    }
    i = i + 1;
    var esc: bool = false;
    while i < n {
        const c: byte = p[i];
        if esc {
            esc = false;
        } else if c == 92 as byte {
            esc = true;
        } else if c == 34 as byte {
            return i + 1;
        }
        i = i + 1;
    }
    return n;
}

// 定位 `"key":<value>` 的原始字节区间 [st, st+ln)。
// 返回值的首字节类别：'{' '[' '"' 's'（其它标量）；0 = 没找到
export fn j_span(p: &const byte, n: usize, key: &const byte,
    st: &usize, ln: &usize) byte {
    const at: isize = j_find_key(p, n, key);
    if at < 0 {
        return 0 as byte;
    }
    var i: usize = skip_ws(p, n, at as! usize catch { return 0 as byte; });
    if i >= n {
        return 0 as byte;
    }
    const first: byte = p[i];
    if first == 123 as byte || first == 91 as byte {
        // 对象或数组：按深度走，跳过字符串内部
        var depth: i32 = 0;
        while i < n {
            const c: byte = p[i];
            if c == 34 as byte {
                i = skip_string(p, n, i);
                continue;
            }
            if c == 123 as byte || c == 91 as byte {
                depth = depth + 1;
            } else if c == 125 as byte || c == 93 as byte {
                depth = depth - 1;
                if depth == 0 {
                    st[0] = skip_ws(p, n, at as! usize catch { 0 as usize; });
                    ln[0] = (i + 1) - st[0];
                    return first;
                }
            }
            i = i + 1;
        }
        return 0 as byte;
    }
    if first == 34 as byte {
        const e: usize = skip_string(p, n, i);
        if e >= n {
            return 0 as byte;
        }
        st[0] = i;
        ln[0] = e - i;
        return first;
    }
    // 标量：走到分隔符
    var j: usize = i;
    while j < n {
        const c: byte = p[j];
        if c == 44 as byte || c == 125 as byte || c == 93 as byte
            || c == 32 as byte || c == 9 as byte || c == 10 as byte
            || c == 13 as byte {
            break;
        }
        j = j + 1;
    }
    st[0] = i;
    ln[0] = j - i;
    return 115 as byte;   // 's'
}

// 在子区间里查键（用于 input 对象的 required 校验）
export fn j_sub_has(p: &const byte, st: usize, ln: usize,
    key: &const byte) bool {
    const sub: &const byte = &p[st];
    return j_find_key(sub, ln, key) >= 0;
}

// 在子区间里取字符串字段
export fn j_sub_str(p: &const byte, st: usize, ln: usize, key: &const byte,
    out: &[byte], out_len: &usize) bool {
    const sub: &const byte = &p[st];
    return j_str(sub, ln, key, out, out_len);
}

// ---- 对象键枚举（P2：additionalProperties 策略用） ----

// 跳过一个 JSON 值（从 i 开始），返回其后的位置
fn skip_value(p: &const byte, n: usize, i0: usize) usize {
    var i: usize = skip_ws(p, n, i0);
    if i >= n {
        return n;
    }
    const c: byte = p[i];
    if c == 34 as byte {
        return skip_string(p, n, i);
    }
    if c == 123 as byte || c == 91 as byte {
        var depth: i32 = 0;
        while i < n {
            const d: byte = p[i];
            if d == 34 as byte {
                i = skip_string(p, n, i);
                continue;
            }
            if d == 123 as byte || d == 91 as byte {
                depth = depth + 1;
            } else if d == 125 as byte || d == 93 as byte {
                depth = depth - 1;
                if depth == 0 {
                    return i + 1;
                }
            }
            i = i + 1;
        }
        return n;
    }
    var j: usize = i;
    while j < n {
        const d: byte = p[j];
        if d == 44 as byte || d == 125 as byte || d == 93 as byte {
            break;
        }
        j = j + 1;
    }
    return j;
}

// 取对象里第 idx 个键名（p 指向 '{'），成功返回 true 并写入 out
export fn j_key_at(p: &const byte, n: usize, idx: usize,
    out: &[byte], out_len: &usize) bool {
    out_len[0] = 0;
    var i: usize = skip_ws(p, n, 0);
    if i >= n || p[i] != 123 as byte {
        return false;
    }
    i = i + 1;
    var seen: usize = 0;
    while i < n {
        i = skip_ws(p, n, i);
        if i >= n || p[i] == 125 as byte || p[i] != 34 as byte {
            return false;
        }
        const ks: usize = i;
        const ke: usize = skip_string(p, n, i);
        if ke > n || ke < ks + 2 {
            return false;
        }
        if seen == idx {
            var l: usize = 0;
            if !copy_to(&p[ks + 1], ke - ks - 2, out, &l) {
                return false;
            }
            out_len[0] = l;
            return true;
        }
        seen = seen + 1;
        i = skip_ws(p, n, ke);
        if i >= n || p[i] != 58 as byte {
            return false;
        }
        i = skip_value(p, n, i + 1);
        i = skip_ws(p, n, i);
        if i < n && p[i] == 44 as byte {
            i = i + 1;
        }
    }
    return false;
}
