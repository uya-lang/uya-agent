// drama_plugin/src/schema.uya — 最小输入校验（P2）
//
// P2 的操作只有 mock，但契约要与 DESIGN §4.5 对齐：
//   * `input` 必须是对象；
//   * 每个操作声明自己的 required 字段；
//   * 字段类型错误要与"缺字段"分开报（`TYPE_MISMATCH` vs `SCHEMA_INVALID`）；
//   * 失败一律是**业务失败**（`isError:false`），让模型自己纠正。
//
// 完整的 JSON Schema（enum/range/additionalProperties）等 P3 有真实操作了再扩。

// 每个操作的 required 字段数
export fn schema_required_count(op_i: usize) usize {
    if op_i == 0 {
        return 1;   // project.create: name
    }
    if op_i == 1 {
        return 1;   // episode.produce: episode_id
    }
    return 1;       // continuity.inspect: episode_id
}

export fn schema_required_name(op_i: usize, k: usize) &const byte {
    _ = k;
    if op_i == 0 {
        return "name" as &const byte;
    }
    return "episode_id" as &const byte;
}

// 字段是否为字符串类型（P2 的所有 required 字段都是字符串）
export fn schema_field_is_str(p: &const byte, st: usize, ln: usize,
    field: &const byte) bool {
    var buf: [byte: 256] = [0: 256];
    var bl: usize = 0;
    return j_sub_str(p, st, ln, field, &buf[0: 256], &bl);
}

// 校验结果：0 通过；1 缺 input；2 input 不是对象；3 缺字段；4 类型不对
// 失败时把字段名写进 field_out（供错误信息用）
export fn schema_validate(op_i: usize, line: &const byte, n: usize,
    field_out: &[byte], field_len: &usize) i32 {
    field_len[0] = 0;
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    const kind: byte = j_span(line, n, "input" as &const byte, &st[0], &ln[0]);
    if kind == 0 as byte {
        return 1;
    }
    if kind != 123 as byte {
        return 2;
    }
    var k: usize = 0;
    while k < schema_required_count(op_i) {
        const f: &const byte = schema_required_name(op_i, k);
        if !j_sub_has(line, st[0], ln[0], f) {
            var fl: usize = 0;
            _ = copy_to(f, b_len(f), &field_out[0: 256], &fl);
            field_len[0] = fl;
            return 3;
        }
        if !schema_field_is_str(line, st[0], ln[0], f) {
            var fl2: usize = 0;
            _ = copy_to(f, b_len(f), &field_out[0: 256], &fl2);
            field_len[0] = fl2;
            return 4;
        }
        k = k + 1;
    }
    return 0;
}

// input 的原始字节区间（给 input_hash 用）
export fn schema_input_span(line: &const byte, n: usize,
    st: &usize, ln: &usize) bool {
    const kind: byte = j_span(line, n, "input" as &const byte, st, ln);
    return kind == 123 as byte;
}
