// drama_plugin/src/schema.uya — Input Schema 校验（P2）
//
// 契约与 `describe` 同源：字段名/类型/required/enum 全部从
// `registry.uya` 的 FieldSpec 读，**不允许**这里另写一套字面量。
//
// 校验结果码（业务失败，`isError:false`，让模型自己纠正）：
//   0 通过
//   1 缺 `input`
//   2 `input` 不是对象
//   3 缺 required 字段
//   4 类型不符
//   5 出现未声明的字段（additionalProperties = false）
//   6 枚举值非法
//
// 失败时把出错字段名写进 field_out（`input` 层面的错误留空）。

const K_MISSING: u8 = 0;
const K_STR: u8 = 1;
const K_INT: u8 = 2;
const K_BOOL: u8 = 3;
const K_OBJ: u8 = 4;
const K_ARR: u8 = 5;
const K_OTHER: u8 = 6;

// 值的字面量类别
fn kind_of(p: &const byte, n: usize, i: usize) u8 {
    if i >= n {
        return K_MISSING;
    }
    const c: byte = p[i];
    if c == 34 as byte {
        return K_STR;
    }
    if c == 123 as byte {
        return K_OBJ;
    }
    if c == 91 as byte {
        return K_ARR;
    }
    if c == 116 as byte || c == 102 as byte {
        return K_BOOL;
    }
    if c == 110 as byte {
        return K_OTHER;
    }
    return K_INT;
}

// 字段在对象里的值类别；K_MISSING = 没这个字段
fn field_kind(p: &const byte, st: usize, ln: usize, f: &const byte) u8 {
    var s2: [usize: 1] = [0];
    var l2: [usize: 1] = [0];
    const sub: &const byte = &p[st];
    const k: byte = j_span(sub, ln, f, &s2[0], &l2[0]);
    if k == 0 as byte {
        return K_MISSING;
    }
    if k == 34 as byte {
        return K_STR;
    }
    if k == 123 as byte {
        return K_OBJ;
    }
    if k == 91 as byte {
        return K_ARR;
    }
    return kind_of(sub, ln, s2[0]);
}

// 声明类型 ↔ 实际类别是否兼容
fn type_ok(t: u8, k: u8) bool {
    if t == 1 {
        return k == K_STR;
    }
    if t == 2 {
        return k == K_INT;
    }
    if t == 3 {
        return k == K_BOOL;
    }
    return k == K_OBJ;
}

// 字符串值是否在 'a|b|c' 里（空串 = 不限制）
fn enum_ok(p: &const byte, s2: usize, l2: usize, allow: &const byte) bool {
    if b_len(allow) == 0 {
        return true;
    }
    var v: [byte: 128] = [0: 128];
    var vl: usize = 0;
    if !copy_to(&p[s2 + 1], l2 - 2, &v[0: 128], &vl) {
        return false;
    }
    var i: usize = 0;
    const an: usize = b_len(allow);
    while i <= an {
        var j: usize = i;
        while j < an && allow[j] != 124 as byte {
            j = j + 1;
        }
        if j - i == vl && b_starts(&allow[i], an - i, &v[0]) {
            return true;
        }
        i = j + 1;
    }
    return false;
}

fn put_field(f: &const byte, field_out: &[byte], field_len: &usize) void {
    var fl: usize = 0;
    _ = copy_to(f, b_len(f), field_out, &fl);
    field_len[0] = fl;
}

// 逐字段检查：类型 + 枚举
fn check_typed(op_i: usize, line: &const byte, st: usize, ln: usize,
    field_out: &[byte], field_len: &usize) i32 {
    var k: usize = 0;
    while k < registry_field_count(op_i) {
        const f: &const byte = registry_field_name(op_i, k);
        const fk: u8 = field_kind(line, st, ln, f);
        if fk == K_MISSING {
            if registry_field_required(op_i, k) {
                put_field(f, field_out, field_len);
                return 3;
            }
        } else {
            if !type_ok(registry_field_type(op_i, k), fk) {
                put_field(f, field_out, field_len);
                return 4;
            }
            if registry_field_type(op_i, k) == 1 {
                var s3: [usize: 1] = [0];
                var l3: [usize: 1] = [0];
                _ = j_span(&line[st], ln, f, &s3[0], &l3[0]);
                if !enum_ok(&line[st], s3[0], l3[0],
                    registry_field_enum(op_i, k)) {
                    put_field(f, field_out, field_len);
                    return 6;
                }
            }
        }
        k = k + 1;
    }
    return 0;
}

// 未声明字段（additionalProperties = false）
fn check_extra(op_i: usize, line: &const byte, st: usize, ln: usize,
    field_out: &[byte], field_len: &usize) i32 {
    var idx: usize = 0;
    while true {
        var key: [byte: 128] = [0: 128];
        var kl: usize = 0;
        if !j_key_at(&line[st], ln, idx, &key[0: 128], &kl) {
            return 0;
        }
        if registry_field_index(op_i, &key[0], kl) < 0 {
            put_field(&key[0], field_out, field_len);
            return 5;
        }
        idx = idx + 1;
    }
}

// 主校验：op_i 是操作下标，line/n 是整行请求
export fn schema_validate(op_i: usize, line: &const byte, n: usize,
    field_out: &[byte], field_len: &usize) i32 {
    field_len[0] = 0;
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if !schema_input_span(line, n, &st[0], &ln[0]) {
        var st2: [usize: 1] = [0];
        var ln2: [usize: 1] = [0];
        const kind: byte = j_span(line, n, "input" as &const byte,
            &st2[0], &ln2[0]);
        if kind == 0 as byte {
            return 1;
        }
        return 2;
    }
    const r1: i32 = check_typed(op_i, line, st[0], ln[0],
        field_out, field_len);
    if r1 != 0 {
        return r1;
    }
    return check_extra(op_i, line, st[0], ln[0], field_out, field_len);
}

// input 的原始字节区间（给 input_hash 用）
export fn schema_input_span(line: &const byte, n: usize,
    st: &usize, ln: &usize) bool {
    const kind: byte = j_span(line, n, "input" as &const byte, st, ln);
    return kind == 123 as byte;
}
