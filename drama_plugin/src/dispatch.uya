// drama_plugin/src/dispatch.uya — `call` 的幂等与审计（P2）
//
// 幂等键 = (operation, input_hash)（DESIGN §4.5）：
//   * 同键再来 ⇒ 复用同一个 task_id，并回 `idempotent_replay: true`；
//   * 同 `request_id` 但 `input_hash` 变了 ⇒ 报 `REQUEST_REUSED`；
//   * 首版把这两张表放内存（进程重启即丢），P3 落到 `idempotency/` 与提交记录。
//
// 审计：P2 只记计数与最后一条操作，`health` 会报出来；P3 落 jsonl。

const SLOT_MAX: usize = 16;
const RID_MAX: usize = 16;
const RID_LEN: usize = 64;

struct IdemSlot {
    used: bool,
    op: &const byte,
    key: u64,
    task: [byte: 24],
}

struct RidSlot {
    used: bool,
    rid: [byte: RID_LEN],
    key: u64,
}

var g_idem: [IdemSlot: SLOT_MAX] = [IdemSlot{ used: false, op: "" as &const byte, key: 0, task: [0: 24] }: SLOT_MAX];
var g_rid: [RidSlot: RID_MAX] = [RidSlot{ used: false, rid: [0: RID_LEN], key: 0 }: RID_MAX];
var g_audit_count: i64 = 0;
var g_task_seq: i64 = 0;

export fn audit_count() i64 {
    return g_audit_count;
}

export fn audit_note() void {
    g_audit_count = g_audit_count +| 1;
}

// 记一条 request_id ↔ input_hash 的绑定；返回 false 表示"同 rid 不同 payload"
export fn rid_bind(rid: &const byte, rl: usize, key: u64) bool {
    if rl == 0 {
        return true;
    }
    var i: usize = 0;
    while i < RID_MAX {
        if g_rid[i].used && b_eq(&g_rid[i].rid[0], b_len(&g_rid[i].rid[0]), rid) {
            return g_rid[i].key == key;
        }
        i = i + 1;
    }
    i = 0;
    while i < RID_MAX {
        if !g_rid[i].used {
            g_rid[i].used = true;
            g_rid[i].key = key;
            _ = copy_to(rid, rl, &g_rid[i].rid[0: RID_LEN], &g_rid[i].rid_l());
            return true;
        }
        i = i + 1;
    }
    return true;   // 表满：退化成"不做这项检查"，不误拒业务
}

// 幂等查找：命中则把 task_id 写进 out，返回 true
export fn idem_find(op: &const byte, key: u64, out: &[byte]) bool {
    var i: usize = 0;
    while i < SLOT_MAX {
        if g_idem[i].used && g_idem[i].key == key
            && b_eq(g_idem[i].op, b_len(g_idem[i].op), op) {
            _ = copy_to(&g_idem[i].task[0], b_len(&g_idem[i].task[0]),
                out, b_len(&g_idem[i].task[0]) + 1, &g_tmp_len());
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 新任务：生成 task_id 并登记
export fn idem_insert(op: &const byte, oplen: usize, key: u64, out: &[byte]) void {
    g_task_seq = g_task_seq +| 1;
    var buf: [byte: 24] = [0: 24];
    var w: usize = 0;
    w = w + j_put(&buf[0: 24], w, "task_p2_" as &const byte);
    w = w + j_put_i64(&buf[0: 24], w, g_task_seq);
    buf[w] = 0 as byte;
    _ = copy_to(&buf[0], w, out, w + 1, &g_tmp_len());
    var i: usize = 0;
    while i < SLOT_MAX {
        if !g_idem[i].used {
            g_idem[i].used = true;
            g_idem[i].op = op;
            g_idem[i].key = key;
            _ = copy_to(&buf[0], w, &g_idem[i].task[0: 24], &g_tmp_len());
            break;
        }
        i = i + 1;
    }
    _ = oplen;
}
