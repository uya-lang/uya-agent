// 本地队列 Video Adapter 的操作层：取消、结果取回、参考素材参数转换。
// 队列记录格式见 task.uya（<proj>/queue/<task_id>.json）。

fn qo_str(s: &[byte], sl: &usize, src: &const byte, n: usize) void {
    sl[0] = 0;
    _ = copy_to(src, n, s, &sl[0]);
}

// 文件字节数（取不到给 -1）
fn qo_size(root: &const byte, rn: usize, rel: &const byte, n: usize) i64 {
    var ap: [byte: 512] = [0: 512];
    var an: [usize: 1] = [0];
    if !path_join(root, rn, rel, n, &ap[0: 512], &an[0]) {
        return -1;
    }
    var stt: Stat = Stat{};
    const rc: i32 = sys_stat(&ap[0], &stt) catch { -1 as i32; };
    if rc != 0 {
        return -1;
    }
    return stt.st_size;
}

// 数据根下的资产目录：projects/<pid>/assets/v<ver>（probe 要整条相对路径）
fn qo_vdir(out: &[byte], ol: &usize, pid: &const byte, pl: usize,
    ver: i64) void {
    var w: usize = 0;
    w = w + j_put(out, w, "projects/" as &const byte);
    w = w + j_put_raw(out, w, pid, pl);
    w = w + j_put(out, w, "/assets/v" as &const byte);
    w = w + j_put_i64(out, w, ver);
    ol[0] = w;
}

// provider.cancel：真停 job（标记文件 + 记录改 canceled + 有 pid 就 TERM）
fn op_provider_cancel(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    var tid: [byte: 40] = [0: 40];
    var tl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) || !input_str(line, n, "task_id" as &const byte,
        &tid[0: 40], &tl[0]) {
        return 13;
    }
    if tl[0] == 0 {
        return 13;
    }
    return queue_cancel(data_root_ptr(), data_root_len(), &pid[0], pl[0],
        &tid[0], tl[0], out, out_len);
}

// provider.result：done 的任务把 mp4 清单 + 末帧图 + 元数据一次取回
fn op_provider_result(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    var tid: [byte: 40] = [0: 40];
    var tl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) || !input_str(line, n, "task_id" as &const byte,
        &tid[0: 40], &tl[0]) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    var rec: [byte: 4096] = [0: 4096];
    var rl: [usize: 1] = [0];
    if queue_get(root, rn, &pid[0], pl[0], &tid[0], tl[0],
        &rec[0: 4096], &rl[0]) != 0 {
        return 56;
    }
    var st: [byte: 16] = [0: 16];
    var sl: [usize: 1] = [0];
    _ = j_str(rec, rl[0], "state" as &const byte, &st[0: 16], &sl[0]);
    if !eqb(&st[0], sl[0], "done" as &const byte, 4) {
        return 54;   // 还没跑完：结果取回不成立
    }
    const bver: i64 = json_i64_at(&rec[0: 4096], rl[0], "board_version" as
        &const byte);
    const shots: i64 = json_i64_at(&rec[0: 4096], rl[0], "shots" as &const byte);
    if bver <= 0 || shots <= 0 {
        return 54;
    }
    var vb: [byte: 128] = [0: 128];
    var vl: [usize: 1] = [0];
    qo_vdir(&vb[0: 128], &vl[0], &pid[0], pl[0], bver);
    var w: usize = 0;
    w = w + j_put(out, w, "{\"task_id\":" as &const byte);
    w = w + j_put(out, w, "\"" as &const byte);
    w = w + j_put_raw(out, w, &tid[0], tl[0]);
    w = w + j_put(out, w, "\",\"board_version\":" as &const byte);
    w = w + j_put_i64(out, w, bver);
    w = w + j_put(out, w, ",\"gpu_ms\":" as &const byte);
    w = w + j_put_i64(out, w, json_i64_at(&rec[0: 4096], rl[0],
        "gpu_ms" as &const byte));
    w = w + j_put(out, w, ",\"videos\":[" as &const byte);
    var i: i64 = 1;
    var total: i64 = 0;
    while i <= shots && i <= 64 {
        var rel: [byte: 96] = [0: 96];
        var rn2: usize = 0;
        rn2 = rn2 + j_put_raw(&rel[0: 96], rn2, &vb[0], vl[0]);
        rn2 = rn2 + j_put(&rel[0: 96], rn2, "/shot_" as &const byte);
        rn2 = rn2 + j_put_i64(&rel[0: 96], rn2, i);
        rn2 = rn2 + j_put(&rel[0: 96], rn2, ".mp4" as &const byte);
        var pb: &byte = malloc(2048) as &byte;
        var pbl: [usize: 1] = [0];
        var bytes: i64 = 0;
        var dur: i64 = 0;
        if (pb as usize) != 0 && provider_probe_file(root, rn, &rel[0],
            rn2, &pb[0: 2048], &pbl[0]) == 0 {
            bytes = qo_size(root, rn, &rel[0], rn2);
            dur = json_i64_at(&pb[0: 2048], pbl[0],
                "duration_ms" as &const byte);
        }
        if (pb as usize) != 0 {
            free(pb as &void);
        }
        total = total +| dur;
        if i > 1 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = w + j_put(out, w, "{\"shot\":" as &const byte);
        w = w + j_put_i64(out, w, i);
        w = w + j_put(out, w, ",\"path\":" as &const byte);
        w = w + j_put(out, w, "\"" as &const byte);
        w = w + j_put_raw(out, w, &rel[0], rn2);
        w = w + j_put(out, w, "\",\"bytes\":" as &const byte);
        w = w + j_put_i64(out, w, bytes);
        w = w + j_put(out, w, ",\"duration_ms\":" as &const byte);
        w = w + j_put_i64(out, w, dur);
        w = w + j_put(out, w, "}" as &const byte);
        i = i + 1;
    }
    w = w + j_put(out, w, "],\"total_ms\":" as &const byte);
    w = w + j_put_i64(out, w, total);
    // 末帧图：接戏基准与缩略图都用它
    var lrel: [byte: 96] = [0: 96];
    var ll: usize = 0;
    ll = ll + j_put_raw(&lrel[0: 96], ll, &vb[0], vl[0]);
    ll = ll + j_put(&lrel[0: 96], ll, "/last.jpg" as &const byte);
    var lb: &byte = malloc(1024) as &byte;
    defer { free(lb as &void); }
    var lbl: [usize: 1] = [0];
    var lsz: i64 = 0;
    if (lb as usize) != 0 && shots >= 1 {
        var vrel: [byte: 96] = [0: 96];
        var vn: usize = 0;
        vn = vn + j_put_raw(&vrel[0: 96], vn, &vb[0], vl[0]);
        vn = vn + j_put(&vrel[0: 96], vn, "/shot_" as &const byte);
        vn = vn + j_put_i64(&vrel[0: 96], vn, shots);
        vn = vn + j_put(&vrel[0: 96], vn, ".mp4" as &const byte);
        if provider_last_frame(root, rn, &vrel[0], vn, &lrel[0], ll,
            &lb[0: 1024], &lbl[0]) == 0 {
            lsz = json_i64_at(&lb[0: 1024], lbl[0], "bytes" as &const byte);
        }
    }
    w = w + j_put(out, w, ",\"last_frame\":\"" as &const byte);
    w = w + j_put_raw(out, w, &lrel[0], ll);
    w = w + j_put(out, w, "\",\"last_frame_bytes\":" as &const byte);
    w = w + j_put_i64(out, w, lsz);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

// provider.refs：把 shot.state 的 references 顺序翻成出图参数
// （参考图槽位 + 帧索引引导：第 0 帧锁首帧、-1 锁末帧）
fn op_provider_refs(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) {
        return 13;
    }
    const want: i64 = int_arg(line, n, "board_version" as &const byte, 0);
    const shot: i64 = int_arg(line, n, "shot" as &const byte, 1);
    var sb: &byte = malloc(8192) as &byte;
    defer { free(sb as &void); }
    if (sb as usize) == 0 {
        return 15;
    }
    var sl: [usize: 1] = [0];
    // 状态连续断点（77）不该挡住参考图参数：断点由 shot.state 自己报
    const src_rc: i32 = op_shot_state(line, n, &sb[0: 8192], &sl[0]);
    if src_rc != 0 && src_rc != 77 {
        return 96;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"shot\":" as &const byte);
    w = w + j_put_i64(out, w, shot);
    w = w + j_put(out, w, ",\"refs\":[" as &const byte);
    var ss: [usize: 1] = [0];
    var ssl: [usize: 1] = [0];
    if j_span(sb, sl[0], "shots" as &const byte, &ss[0],
        &ssl[0]) != 91 as byte {
        return 96;
    }
    var es: [usize: 1] = [0];
    var el: [usize: 1] = [0];
    if !j_arr_item(&sb[ss[0]], ssl[0], shot -| 1, &es[0], &el[0]) {
        return 96;
    }
    const sh: &const byte = &sb[ss[0] + es[0]];
    var nref: usize = 0;
    var kind: [byte: 2] = [0: 2];
    var k: usize = 0;
    while k < 2 {
        if k == 0 {
            kind[0] = 99 as byte;   // 'c' 角色
        } else {
            kind[0] = 112 as byte;  // 'p' 道具
        }
        var rs: [usize: 1] = [0];
        var rsl: [usize: 1] = [0];
        if j_span(sh, el[0], "references" as &const byte, &rs[0],
            &rsl[0]) == 123 as byte {
            var keyb: &const byte = "";
            if k == 0 {
                keyb = "characters" as &const byte;
            } else {
                keyb = "props" as &const byte;
            }
            var a0: [usize: 1] = [0];
            var asl: [usize: 1] = [0];
            if j_span(&sh[rs[0]], rsl[0], keyb, &a0[0],
                &asl[0]) == 91 as byte {
                var idx: usize = 0;
                while idx < 16 {
                    var xs: [usize: 1] = [0];
                    var xl: [usize: 1] = [0];
                    if !j_arr_item(&sh[rs[0] + a0[0]], asl[0], idx,
                        &xs[0], &xl[0]) {
                        break;
                    }
                    const it: &const byte = &sh[rs[0] + a0[0] + xs[0]];
                    var id: [byte: 32] = [0: 32];
                    var idl: [usize: 1] = [0];
                    _ = j_str(it, xl[0], "id" as &const byte,
                        &id[0: 32], &idl[0]);
                    var fz: [byte: 16] = [0: 16];
                    var fzl: [usize: 1] = [0];
                    _ = j_str(it, xl[0], "frozen_hash" as &const byte,
                        &fz[0: 16], &fzl[0]);
                    if nref > 0 {
                        w = w + j_put(out, w, "," as &const byte);
                    }
                    w = w + j_put(out, w, "{\"order\":" as &const byte);
                    w = w + j_put_i64(out, w, nref as i64);
                    w = w + j_put(out, w, ",\"role\":\"" as &const byte);
                    if k == 0 {
                        w = w + j_put(out, w, "character" as &const byte);
                    } else {
                        w = w + j_put(out, w, "prop" as &const byte);
                    }
                    w = w + j_put(out, w, "\",\"id\":\"" as &const byte);
                    w = w + j_put_raw(out, w, &id[0], idl[0]);
                    w = w + j_put(out, w, "\",\"asset_version\":" as
                        &const byte);
                    w = w + j_put_i64(out, w, json_i64_at(&it[0: xl[0]], xl[0],
                        "asset_version" as &const byte));
                    w = w + j_put(out, w, ",\"frozen_hash\":\"" as
                        &const byte);
                    w = w + j_put_raw(out, w, &fz[0], fzl[0]);
                    // 帧索引引导：第一张参考锁首帧，其余按顺序排在中间
                    w = w + j_put(out, w, "\",\"frame_index\":" as
                        &const byte);
                    w = w + j_put_i64(out, w, 0);
                    w = w + j_put(out, w, ",\"slot\":\"" as &const byte);
                    if nref == 0 {
                        w = w + j_put(out, w, "first_frame" as &const byte);
                    } else {
                        w = w + j_put(out, w, "ref_" as &const byte);
                        w = w + j_put_i64(out, w, nref as i64);
                    }
                    w = w + j_put(out, w, "\"}" as &const byte);
                    nref = nref + 1;
                    idx = idx + 1;
                }
            }
        }
        k = k + 1;
    }
    w = w + j_put(out, w, "],\"ref_count\":" as &const byte);
    w = w + j_put_i64(out, w, nref as i64);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}


// provider.poll：看任务状态 + 给出下次该等多久（本地队列的轮询口径）
// 状态映射：queued/running/done/failed/canceled；记录不存在给 unknown。
fn qo_now() i64 {
    var ts: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_clock_gettime(0, &ts) catch { 0 as i32; };
    return ts.tv_sec;
}

fn op_provider_poll(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    var tid: [byte: 40] = [0: 40];
    var tl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) || !input_str(line, n, "task_id" as &const byte,
        &tid[0: 40], &tl[0]) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    var rec: [byte: 4096] = [0: 4096];
    var rl: [usize: 1] = [0];
    var st: [byte: 16] = [0: 16];
    var sl: [usize: 1] = [0];
    var known: bool = true;
    if queue_get(root, rn, &pid[0], pl[0], &tid[0], tl[0],
        &rec[0: 4096], &rl[0]) != 0 {
        known = false;
    } else {
        _ = j_str(&rec[0], rl[0], "state" as &const byte, &st[0: 16],
            &sl[0]);
    }
    const done: bool = known && eqb(&st[0], sl[0], "done" as &const byte, 4);
    const failed: bool = known && eqb(&st[0], sl[0], "failed" as &const byte,
        6);
    const canceled: bool = known && eqb(&st[0], sl[0],
        "canceled" as &const byte, 8);
    const terminal: bool = done || failed || canceled;
    // 退避：排队 500 ms、跑着 1500 ms、终态不用再问
    var wait: i64 = 0;
    if known && !terminal {
        if eqb(&st[0], sl[0], "queued" as &const byte, 6) {
            wait = 500;
        } else {
            wait = 1500;
        }
    }
    var upd: i64 = 0;
    if known {
        upd = json_i64_at(&rec[0: 4096], rl[0], "updated_at" as &const byte);
    }
    var age: i64 = 0;
    if known {
        age = qo_now() -| upd;
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"task_id\":\"" as &const byte);
    w = w + j_put_raw(out, w, &tid[0], tl[0]);
    w = w + j_put(out, w, "\",\"state\":\"" as &const byte);
    if !known {
        w = w + j_put(out, w, "unknown" as &const byte);
    } else {
        w = w + j_put_raw(out, w, &st[0], sl[0]);
    }
    w = w + j_put(out, w, "\",\"terminal\":" as &const byte);
    if terminal {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"poll_after_ms\":" as &const byte);
    w = w + j_put_i64(out, w, wait);
    w = w + j_put(out, w, ",\"age_s\":" as &const byte);
    w = w + j_put_i64(out, w, age);
    var nshot: i64 = 0;
    if known {
        nshot = json_i64_at(&rec[0: 4096], rl[0], "shots" as &const byte);
    }
    w = w + j_put(out, w, ",\"shots\":" as &const byte);
    w = w + j_put_i64(out, w, nshot);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

// 分发：本文件四个操作，其余返回 -1
export fn dispatch_queue(nm: &const byte, n: usize, line: &const byte,
    ln: usize, out: &[byte], out_len: &usize) i32 {
    if b_eq(nm, n, "provider.cancel" as &const byte) {
        return op_provider_cancel(line, ln, out, out_len);
    }
    if b_eq(nm, n, "provider.result" as &const byte) {
        return op_provider_result(line, ln, out, out_len);
    }
    if b_eq(nm, n, "provider.refs" as &const byte) {
        return op_provider_refs(line, ln, out, out_len);
    }
    if b_eq(nm, n, "provider.poll" as &const byte) {
        return op_provider_poll(line, ln, out, out_len);
    }
    return -1;
}
