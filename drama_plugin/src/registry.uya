// drama_plugin/src/registry.uya — 操作目录（P2：真正的 Registry）
//
// 不变量（DESIGN §4.1/§4.7）：
//   * 工具面固定三个：list / describe / call；
//   * 业务操作只在这里登记，`call` 拒绝未登记的名字；
//   * `describe` 的契约与 `call` 的校验用**同一份**定义（同一张表、同一个
//     字段规格），不允许两边各写一份 JSON 文案。
//
// 字段规格（FieldSpec）就是契约：required/type/enum 都从这里读。
// P2 的类型集合：str/int/bool/obj —— 够覆盖现有三个操作。

// 字段类型编号
const T_STR: u8 = 1;
const T_INT: u8 = 2;
const T_BOOL: u8 = 3;
const T_OBJ: u8 = 4;
const T_ARR: u8 = 5;

export struct FieldSpec {
    name: &const byte,
    type_: u8,
    required: bool,
    // 允许的枚举值（用 '|' 分隔，空串 = 不限制），P2 只给少数操作用
    enum_: &const byte,
}

export struct OpInfo {
    name: &const byte,
    version: &const byte,
    mutates: bool,
    async_: bool,
    permission: &const byte,
    // 幂等键口径（写操作必须有）
    idem_key: &const byte,
    // 成本档位：none / low / gpu（给 P6 预算熔断用）
    cost: &const byte,
    // 字段在 FIELDS 里的起始下标与个数（不存指针：数组元素取址过不了
    // 边界证明）
    field_start: usize,
    field_count: usize,
}

const OP_PROJECT_CREATE: &const byte = "project.create" as &const byte;
