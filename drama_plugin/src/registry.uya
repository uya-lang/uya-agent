// 操作总数
export fn registry_count() usize {
    return @len(OPS);
}

fn op_at(i: usize) usize {
    if i < @len(OPS) {
        return i;
    }
    return 0;
}

fn field_at(i: usize, k: usize) usize {
    const base: usize = OPS[op_at(i)].field_start;
    const idx: usize = base + k;
    if idx < @len(FIELDS) {
        return idx;
    }
    return 0;
}

export fn registry_name(i: usize) &const byte {
    return OPS[op_at(i)].name;
}

export fn registry_version(i: usize) &const byte {
    return OPS[op_at(i)].version;
}

export fn registry_mutates(i: usize) bool {
    return OPS[op_at(i)].mutates;
}

export fn registry_async(i: usize) bool {
    return OPS[op_at(i)].async_;
}

export fn registry_permission(i: usize) &const byte {
    return OPS[op_at(i)].permission;
}

export fn registry_idem_key(i: usize) &const byte {
    return OPS[op_at(i)].idem_key;
}

export fn registry_cost(i: usize) &const byte {
    return OPS[op_at(i)].cost;
}

export fn registry_field_count(i: usize) usize {
    return OPS[op_at(i)].field_count;
}

export fn registry_field_name(i: usize, k: usize) &const byte {
    return FIELDS[field_at(i, k)].name;
}

export fn registry_field_type(i: usize, k: usize) u8 {
    return FIELDS[field_at(i, k)].type_;
}

export fn registry_field_required(i: usize, k: usize) bool {
    return FIELDS[field_at(i, k)].required;
}

export fn registry_field_enum(i: usize, k: usize) &const byte {
    return FIELDS[field_at(i, k)].enum_;
}

// 名字是否已登记；返回下标，-1 = 没有
export fn registry_find(name: &const byte, n: usize) isize {
    var i: usize = 0;
    while i < registry_count() {
        const op: &const byte = registry_name(i);
        if b_eq(name, n, op) {
            return i as isize;
        }
        i = i + 1;
    }
    return -1;
}

// 类型名（describe 输出与错误信息共用的同一套字面量）
export fn registry_type_name(t: u8) &const byte {
    if t == T_STR {
        return "string" as &const byte;
    }
    if t == T_INT {
        return "integer" as &const byte;
    }
    if t == T_BOOL {
        return "boolean" as &const byte;
    }
    if t == T_ARR {
        return "array" as &const byte;
    }
    return "object" as &const byte;
}

// 字段下标（按名字找）；-1 = 没有声明
export fn registry_field_index(op_i: usize, name: &const byte,
    n: usize) isize {
    var k: usize = 0;
    while k < registry_field_count(op_i) {
        const f: &const byte = registry_field_name(op_i, k);
        if b_eq(name, n, f) {
            return k as isize;
        }
        k = k + 1;
    }
    return -1;
}
