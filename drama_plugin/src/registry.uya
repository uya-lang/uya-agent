// drama_plugin/src/registry.uya — 操作目录（P1 骨架，P2 会扩成真正的 Registry）
//
// 不变量（DESIGN §4.1/§4.7）：
//   * 工具面固定三个：list / describe / call；
//   * 业务操作只在这里登记，`call` 拒绝未登记的名字；
//   * `describe` 的契约与 `call` 的校验用同一份定义（P1 先保持同一张表）。

// 一条操作的静态描述
export struct OpInfo {
    name: &const byte,
    mutates: bool,
    async_: bool,
}

const OP_PROJECT_CREATE: &const byte = "project.create" as &const byte;
const OP_EPISODE_PRODUCE: &const byte = "episode.produce" as &const byte;
const OP_CONTINUITY_INSPECT: &const byte = "continuity.inspect" as &const byte;

// 操作总数（P1 只有三条 mock，P2 起由 Registry 动态登记）
export fn registry_count() usize {
    return 3;
}

export fn registry_name(i: usize) &const byte {
    if i == 0 {
        return OP_PROJECT_CREATE;
    }
    if i == 1 {
        return OP_EPISODE_PRODUCE;
    }
    return OP_CONTINUITY_INSPECT;
}

export fn registry_mutates(i: usize) bool {
    return i != 2;
}

export fn registry_async(i: usize) bool {
    return i == 1;
}

// 名字是否已登记；返回下标，-1 = 没有
export fn registry_find(name: &const byte, n: usize) isize {
    var i: usize = 0;
    while i < registry_count() {
        const op: &const byte = registry_name(i);
        if b_eq(name, n, op) {
            return i as isize;
        }
        i = i + 1;
    }
    return -1;
}
