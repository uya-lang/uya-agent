// drama_plugin/src/project.uya — Project 的持久化（P3）
//
// 落地形态（DESIGN §8）：
//   <root>/projects/<project_id>/project.json   单个项目的完整记录
//   <root>/projects/index.jsonl                 一行一个项目（列表用）
//
// ID 规则：`p_` + fnv64(name) 的后 8 位十六进制。同一名字得到同一个 ID，
// 重名创建直接判「已存在」，不会悄悄覆盖。
//
// 路径安全：ID 只允许 [0-9a-f_]，长度固定，因此 `../` 与绝对路径进不来；
// 上层传进来的路径永远是「根 + 已校验 ID」，不接受调用方给的任意路径。

use libc.syscall;
use libc.unistd;

const ID_MAX: usize = 16;
const NAME_MAX: usize = 64;
const PROJECT_FILE: &const byte = "project.json" as &const byte;
const INDEX_FILE: &const byte = "index.jsonl" as &const byte;
const PLUGIN_FMT: i32 = 1;

export fn project_name_ok(name: &const byte, n: usize) bool {
    if n == 0 || n > NAME_MAX {
        return false;
    }
    var i: usize = 0;
    while i < n {
        const c: byte = name[i];
        if c < 32 as byte || c == 127 as byte {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 生成的 ID 只含 [0-9a-f_]：直接可以进路径
export fn project_id_ok(id: &const byte, n: usize) bool {
    if n != 10 {
        return false;
    }
    if id[0] != 112 as byte || id[1] != 95 as byte {
        return false;
    }
    var i: usize = 2;
    while i < n {
        const c: byte = id[i];
        const is_digit: bool = c >= 48 as byte && c <= 57 as byte;
        const is_hex: bool = c >= 97 as byte && c <= 102 as byte;
        if !is_digit && !is_hex {
            return false;
        }
        i = i + 1;
    }
    return true;
}

export fn project_id_of(name: &const byte, n: usize, out: &[byte],
    out_len: &usize) bool {
    if n == 0 || out.len < ID_MAX {
        return false;
    }
    const h: u64 = fnv64(name, n);
    var hexbuf: [byte: 20] = [0: 20];
    const hn: usize = j_put_hex(&hexbuf[0: 20], 0, h);
    if hn < 8 {
        return false;
    }
    out[0] = 112 as byte;   // 'p'
    out[1] = 95 as byte;    // '_'
    var i: usize = 0;
    while i < 8 {
        out[2 + i] = hexbuf[hn - 8 + i];
        i = i + 1;
    }
    out[10] = 0 as byte;
    out_len[0] = 10;
    return true;
}

fn projects_dir(root: &const byte, rn: usize, out: &[byte],
    out_len: &usize) bool {
    return path_join(root, rn, "projects" as &const byte, 8, out, out_len);
}

// 项目 JSON：字段顺序固定，方便人肉 diff
fn build_project_json(id: &const byte, idn: usize, name: &const byte,
    nn: usize, episodes: i64, out: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(out, w, "{\"format_version\":" as &const byte);
    w = w + j_put_i64(out, w, PLUGIN_FMT as i64);
    w = w + j_put(out, w, ",\"id\":" as &const byte);
    w = w + j_put_str(out, w, id, idn);
    w = w + j_put(out, w, ",\"name\":" as &const byte);
    w = w + j_put_str(out, w, name, nn);
    w = w + j_put(out, w, ",\"episode_count\":" as &const byte);
    w = w + j_put_i64(out, w, episodes);
    w = w + j_put(out, w, "}" as &const byte);
    return w;
}

// 结果码：0 成功；1 名字非法；2 已存在；3 写失败；4 ID 非法
export fn project_create(root: &const byte, rn: usize, name: &const byte,
    nn: usize, episodes: i64, id_out: &[byte], id_len: &usize) i32 {
    id_len[0] = 0;
    if !project_name_ok(name, nn) {
        return 1;
    }
    var id: [byte: ID_MAX] = [0: ID_MAX];
    var il: usize = 0;
    if !project_id_of(name, nn, &id[0: ID_MAX], &il) {
        return 1;
    }
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !projects_dir(root, rn, &pdir[0: 512], &pdl) {
        return 3;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, &id[0], il, &dir[0: 512], &dl) {
        return 3;
    }
    if file_exists(&dir[0], dl, PROJECT_FILE, b_len(PROJECT_FILE)) {
        return 2;
    }
    var body: [byte: 1024] = [0: 1024];
    const bl: usize = build_project_json(&id[0], il, name, nn, episodes,
        &body[0: 1024]);
    if !write_atomic(&dir[0], dl, PROJECT_FILE, b_len(PROJECT_FILE),
        &body[0], bl) {
        return 3;
    }
    if !append_index(&pdir[0], pdl, &body[0], bl) {
        return 3;
    }
    var k: usize = 0;
    while k < il {
        id_out[k] = id[k];
        k = k + 1;
    }
    id_out[il] = 0 as byte;
    id_len[0] = il;
    return 0;
}

// 索引追加：读旧内容 + 追加一行 + 原子替换（P3 单进程，够用；
// 多进程并发写索引留到 P4 用锁解决）
fn append_index(pdir: &const byte, pdl: usize, line: &const byte,
    ln: usize) bool {
    var old: [byte: 16384] = [0: 16384];
    var ol: usize = 0;
    const il: usize = b_len(INDEX_FILE);
    _ = read_file(pdir, pdl, INDEX_FILE, il, &old[0], 16384, &ol);
    var merged: [byte: 17408] = [0: 17408];
    if ol + ln + 1 > 17408 {
        return false;
    }
    var i: usize = 0;
    while i < ol {
        merged[i] = old[i];
        i = i + 1;
    }
    var k: usize = 0;
    while k < ln {
        merged[ol + k] = line[k];
        k = k + 1;
    }
    merged[ol + ln] = 10 as byte;   // '\n'
    return write_atomic(pdir, pdl, INDEX_FILE, il, &merged[0],
        ol + ln + 1);
}

// 结果码：0 成功；4 ID 非法；5 不存在；6 读失败
export fn project_get(root: &const byte, rn: usize, id: &const byte,
    idn: usize, out: &byte, cap: usize, out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 4;
    }
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !projects_dir(root, rn, &pdir[0: 512], &pdl) {
        return 6;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return 6;
    }
    if !read_file(&dir[0], dl, PROJECT_FILE, b_len(PROJECT_FILE),
        out, cap, out_len) {
        return 5;
    }
    if !fmt_version_ok(&out[0: cap], out_len[0], PLUGIN_FMT as i64) {
        return 7;   // 不认识的 format_version：只读故障态，不猜
    }
    return 0;
}

// 列表：返回 index.jsonl 原文（上层包成 JSON 数组/行）
export fn project_list(root: &const byte, rn: usize, out: &byte,
    cap: usize, out_len: &usize) i32 {
    out_len[0] = 0;
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !projects_dir(root, rn, &pdir[0: 512], &pdl) {
        return 6;
    }
    const il: usize = b_len(INDEX_FILE);
    if !read_file(&pdir[0], pdl, INDEX_FILE, il, out, cap, out_len) {
        out_len[0] = 0;
        return 0;   // 没有索引 = 空列表，不是错误
    }
    return 0;
}

// 改项目配置：只改 name / episode_count，保留 id；config_version 递增
export fn project_configure(root: &const byte, rn: usize, id: &const byte,
    idn: usize, name: &const byte, nl: usize, episodes: i64,
    has_name: bool, has_eps: bool, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 4;
    }
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !projects_dir(root, rn, &pdir[0: 512], &pdl) {
        return 6;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return 6;
    }
    var old: [byte: 1024] = [0: 1024];
    var ol: usize = 0;
    if !read_file(&dir[0], dl, PROJECT_FILE, b_len(PROJECT_FILE),
        &old[0], 1024, &ol) {
        return 5;
    }
    if !fmt_version_ok(&old[0: 1024], ol, PLUGIN_FMT as i64) {
        return 7;
    }
    var cur_name: [byte: NAME_MAX] = [0: NAME_MAX];
    var cnl: usize = 0;
    _ = j_str(&old[0], ol, "name" as &const byte, &cur_name[0: NAME_MAX],
        &cnl);
    const cur_eps: i64 = num_of(&old[0], ol, "episode_count" as &const byte);
    const cfg_ver: i64 = num_of(&old[0], ol, "config_version" as &const byte);
    var new_name: &const byte = &cur_name[0];
    var new_nl: usize = cnl;
    if has_name {
        if !project_name_ok(name, nl) {
            return 1;
        }
        new_name = name;
        new_nl = nl;
    }
    var new_eps: i64 = cur_eps;
    if has_eps {
        if episodes < 0 {
            return 1;
        }
        new_eps = episodes;
    }
    var body: [byte: 1024] = [0: 1024];
    var w: usize = 0;
    w = w + j_put(&body[0: 1024], w, "{\"format_version\":" as &const byte);
    w = w + j_put_i64(&body[0: 1024], w, PLUGIN_FMT as i64);
    w = w + j_put(&body[0: 1024], w, ",\"id\":" as &const byte);
    w = w + j_put_str(&body[0: 1024], w, id, idn);
    w = w + j_put(&body[0: 1024], w, ",\"name\":" as &const byte);
    w = w + j_put_str(&body[0: 1024], w, new_name, new_nl);
    w = w + j_put(&body[0: 1024], w, ",\"episode_count\":" as &const byte);
    w = w + j_put_i64(&body[0: 1024], w, new_eps);
    w = w + j_put(&body[0: 1024], w, ",\"config_version\":" as &const byte);
    w = w + j_put_i64(&body[0: 1024], w, cfg_ver +| 1);
    w = w + j_put(&body[0: 1024], w, "}" as &const byte);
    if !write_atomic(&dir[0], dl, PROJECT_FILE, b_len(PROJECT_FILE),
        &body[0], w) {
        return 3;
    }
    // 索引是创建日志，配置变更再追加一行（读侧以 project.json 为准）
    _ = append_index(&pdir[0], pdl, &body[0], w);
    var i: usize = 0;
    while i < w && i < out.len {
        out[i] = body[i];
        i = i + 1;
    }
    out_len[0] = w;
    return 0;
}

fn num_of(buf: &const byte, n: usize, key: &const byte) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return 0;
    }
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}
