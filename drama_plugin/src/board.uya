// drama_plugin/src/board.uya — 分镜（Storyboard）生成与版本存储（P7 第一段）
//
// 规则是**确定性**的（同一份剧本永远得到同一份分镜）：
//   * 每个 scene 的 action 出 1 个镜头（景别 medium）；
//   * 每条 dialogue 出 1 个镜头（景别 close），台词逐字保留；
//   * 时长沿用剧本口径：动作 8 字/秒、对白 4 字/秒、标点每个 0.3 s；
//   * timeline_in/out 顺序累加，第 1 镜 cut_type=anchor，其余 hard_cut；
//   * 参考资产只引用 ID（角色/场景/道具），prompt 由冻结文本拼出；
//   * 动作文本过一遍**能力表体检**：非空、≤200 码点、不含禁用词。
//
// 版本：boards/v<N>.json（不可变）+ current.json；同一份剧本重复 build
// 不会产生新版本（content_hash 相同就复用）。
//
// 返回码：0 成功 90 剧本结构不对 94 读失败 96 剧本不存在 98 动作不合规

use libc.syscall;
use libc.unistd;

const BOARD_BUF: usize = 32768;
const BOARD_DIR: &const byte = "boards" as &const byte;
const SHOT_MAX: usize = 64;
const ACTION_MAX: i64 = 200;

struct Shot {
    seq: usize,
    beat: i64,
    scene: [byte: 32],
    scene_len: usize,
    framing: [byte: 16],
    framing_len: usize,
    action: [byte: 256],
    action_len: usize,
    who: [byte: 32],
    who_len: usize,
    line: [byte: 256],
    line_len: usize,
    cut: [byte: 16],
    cut_len: usize,
    dur: i64,
    tin: i64,
    tout: i64,
    evs: [i64: 6],
    evn: usize,
}

fn blank_shot() Shot {
    return Shot{ seq: 0, beat: 0, scene: [0: 32], scene_len: 0,
        framing: [0: 16],
        framing_len: 0, action: [0: 256], action_len: 0, who: [0: 32],
        who_len: 0, line: [0: 256], line_len: 0, cut: [0: 16],
        cut_len: 0, dur: 0, tin: 0, tout: 0, evs: [0: 6], evn: 0 };
}

fn cp_count(p: &const byte, n: usize) i64 {
    var i: usize = 0;
    var c: i64 = 0;
    while i < n {
        const b: byte = p[i];
        if (b as i32 & 0xC0) != 0x80 {
            c = c +| 1;
        }
        i = i + 1;
    }
    return c;
}

fn punct_count(p: &const byte, n: usize) i64 {
    var i: usize = 0;
    var c: i64 = 0;
    while i < n {
        const b: byte = p[i];
        if b == 44 as byte || b == 46 as byte || b == 63 as byte
            || b == 33 as byte || b == 58 as byte || b == 59 as byte
            || b == 0xEF as byte {
            c = c +| 1;
        }
        i = i + 1;
    }
    return c;
}

fn dur_of(p: &const byte, n: usize, per_sec: i64) i64 {
    var ms: i64 = 0;
    if per_sec > 0 {
        ms = ms +| ((cp_count(p, n) *| 1000) / per_sec);
    }
    return ms +| (punct_count(p, n) *| 300);
}

// 朴素子串查找（禁用词表用）
fn has_sub(p: &const byte, n: usize, w: &const byte, wn: usize) bool {
    if wn == 0 || n < wn {
        return false;
    }
    var i: usize = 0;
    while i + wn <= n {
        var k: usize = 0;
        var same: bool = true;
        while k < wn {
            if p[i + k] != w[k] {
                same = false;
                break;
            }
            k = k + 1;
        }
        if same {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 动作体检：非空、不超长、不含禁用词（能力表的最小替代）
export fn board_action_ok(p: &const byte, n: usize) bool {
    if n == 0 || cp_count(p, n) > ACTION_MAX {
        return false;
    }
    if has_sub(p, n, "跳切" as &const byte, 6)
        || has_sub(p, n, "爆炸" as &const byte, 6) {
        return false;
    }
    return true;
}

fn setb(dst: &[byte], dl: &usize, v: &const byte, vn: usize) void {
    var l: usize = 0;
    _ = copy_to(v, vn, dst, &l);
    dl[0] = l;
}

struct Board {
    shots: [Shot: SHOT_MAX],
    n: usize,
    total_ms: i64,
    src_ver: i64,
}

fn blank_board() Board {
    return Board{ shots: [blank_shot(): SHOT_MAX], n: 0, total_ms: 0,
        src_ver: 0 };
}

fn push_shot(b: &Board, scene: &const byte, scen: usize,
    framing: &const byte, frmn: usize, action: &const byte, actn: usize,
    who: &const byte, whon: usize, line: &const byte, ln: usize,
    per_sec: i64, beat: i64) void {
    if b.n >= SHOT_MAX {
        return;
    }
    var s0: Shot = blank_shot();
    s0.seq = b.n + 1;
    s0.beat = beat;
    setb(&s0.scene[0: 32], &s0.scene_len, scene, scen);
    setb(&s0.framing[0: 16], &s0.framing_len, framing, frmn);
    setb(&s0.action[0: 256], &s0.action_len, action, actn);
    setb(&s0.who[0: 32], &s0.who_len, who, whon);
    setb(&s0.line[0: 256], &s0.line_len, line, ln);
    if b.n == 0 {
        setb(&s0.cut[0: 16], &s0.cut_len, "anchor" as &const byte, 6);
    } else {
        setb(&s0.cut[0: 16], &s0.cut_len, "hard_cut" as &const byte, 8);
    }
    s0.dur = dur_of(action, actn, per_sec) +| dur_of(line, ln, 4);
    s0.tin = b.total_ms;
    s0.tout = s0.tin +| s0.dur;
    const d: i64 = s0.dur;
    b.shots[b.n] = s0;   // 赋值即移动，之后不能再碰 s0
    b.n = b.n + 1;
    b.total_ms = b.total_ms +| d;
}

fn push_dialogues(b: &Board, sc: &const byte, scn: usize,
    beat: i64) bool {
    var ds: [usize: 1] = [0];
    var dl: [usize: 1] = [0];
    if j_span(sc, scn, "dialogue" as &const byte, &ds[0], &dl[0])
        != 91 as byte {
        return true;
    }
    var j: usize = 0;
    while true {
        var ls: [usize: 1] = [0];
        var ll: [usize: 1] = [0];
        if !j_arr_item(&sc[ds[0]], dl[0], j, &ls[0], &ll[0]) {
            break;
        }
        const line: &const byte = &sc[ds[0] + ls[0]];
        var who: [byte: 32] = [0: 32];
        var whon: usize = 0;
        _ = j_str(line, ll[0], "who" as &const byte, &who[0: 32], &whon);
        var xs: [usize: 1] = [0];
        var xl: [usize: 1] = [0];
        if j_span(line, ll[0], "line" as &const byte, &xs[0],
            &xl[0]) != 34 as byte || xl[0] < 3 {
            j = j + 1;
            continue;
        }
        const txt: &const byte = &line[xs[0] + 1];
        const tn: usize = xl[0] - 2;
        // 对白镜头的时长只由台词决定（动作留空，避免口径与剧本科目对不上）
        push_shot(b, &SCENE_DEFAULT[0], SCENE_DEFAULT_N,
            "close" as &const byte, 5, "" as &const byte, 0,
            &who[0], whon, txt, tn, 8, beat);
        j = j + 1;
    }
    return true;
}

// 扫描剧本，把镜头填进 board；false = 结构不对 / 动作不合规
fn collect_shots(sp: &const byte, sn: usize, b: &Board) bool {
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(sp, sn, "scenes" as &const byte, &ss[0], &sl[0]) != 91 as byte {
        return false;
    }
    var idx: usize = 0;
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&sp[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sc: &const byte = &sp[ss[0] + es[0]];
        var as_: [usize: 1] = [0];
        var al: [usize: 1] = [0];
        if j_span(sc, el[0], "action" as &const byte, &as_[0],
            &al[0]) == 34 as byte && al[0] > 2 {
            const act: &const byte = &sc[as_[0] + 1];
            const actn: usize = al[0] - 2;
            if !board_action_ok(act, actn) {
                return false;
            }
            push_shot(b, &SCENE_DEFAULT[0], SCENE_DEFAULT_N,
                "medium" as &const byte, 6, act, actn,
                "" as &const byte, 0, "" as &const byte, 0, 8,
                (idx as i64) +| 1);
        }
        if !push_dialogues(b, sc, el[0], (idx as i64) +| 1) {
            return false;
        }
        idx = idx + 1;
    }
    return true;
}

// 剧本里没有显式场景名，P7 先统一用默认场景（P8 接真实资产包再换）
const SCENE_DEFAULT: [byte: 8] = [107, 105, 116, 99, 104, 101, 110, 0];
const SCENE_DEFAULT_N: usize = 7;

// 镜头 → 剧本事件：事件提到这个镜头的人或场景，就算它落在这一镜
fn beqn(a: &const byte, an: usize, b: &const byte, bn: usize) bool {
    if an != bn {
        return false;
    }
    var i: usize = 0;
    while i < an {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn ev_has(ev: &const byte, n: usize, key: &const byte, val: &const byte,
    vn: usize) bool {
    var b1: [byte: 32] = [0: 32];
    var b1l: usize = 0;
    if !j_str(ev, n, key, &b1[0: 32], &b1l) {
        return false;
    }
    return beqn(&b1[0], b1l, val, vn);
}

fn shot_event_hit(ev: &const byte, n: usize, sh: &Shot) bool {
    if sh.scene_len > 0 {
        if ev_has(ev, n, "scene" as &const byte, &sh.scene[0],
            sh.scene_len) {
            return true;
        }
        if ev_has(ev, n, "at_scene" as &const byte, &sh.scene[0],
            sh.scene_len) {
            return true;
        }
        if ev_has(ev, n, "to_scene" as &const byte, &sh.scene[0],
            sh.scene_len) {
            return true;
        }
    }
    if sh.who_len > 0 && ev_has(ev, n, "character" as &const byte,
        &sh.who[0], sh.who_len) {
        return true;
    }
    return false;
}

fn map_events(sp: &const byte, sn: usize, b: &Board) void {
    var es: [usize: 1] = [0];
    var el: [usize: 1] = [0];
    if j_span(sp, sn, "candidate_events" as &const byte, &es[0],
        &el[0]) != 91 as byte {
        return;
    }
    var i: usize = 0;
    while i < SHOT_MAX && i < b.n {
        b.shots[i].evn = 0;
        var k: usize = 0;
        while true {
            var xs: [usize: 1] = [0];
            var xl: [usize: 1] = [0];
            if !j_arr_item(&sp[es[0]], el[0], k, &xs[0], &xl[0]) {
                break;
            }
            const ev: &const byte = &sp[es[0] + xs[0]];
            if shot_event_hit(ev, xl[0], &b.shots[i]) {
                const m: usize = b.shots[i].evn;
                if m < 6 {
                    b.shots[i].evs[m] = k as i64;
                    b.shots[i].evn = m + 1;
                }
            }
            k = k + 1;
        }
        i = i + 1;
    }
}

fn put_shot(b: &Board, i: usize, out: &[byte], w0: usize) usize {
    var w: usize = w0;
    if i >= SHOT_MAX {
        return w;
    }
    w = w + j_put(out, w, "{\"shot_id\":\"s" as &const byte);
    w = w + j_put_i64(out, w, b.shots[i].seq as i64);
    w = w + j_put(out, w, "\",\"sequence\":" as &const byte);
    w = w + j_put_i64(out, w, b.shots[i].seq as i64);
    w = w + j_put(out, w, ",\"beat\":" as &const byte);
    w = w + j_put_i64(out, w, b.shots[i].beat);
    w = w + j_put(out, w, ",\"source\":{\"script_version\":" as
        &const byte);
    w = w + j_put_i64(out, w, b.src_ver);
    w = w + j_put(out, w, ",\"scene\":" as &const byte);
    w = w + j_put_i64(out, w, b.shots[i].beat);
    w = w + j_put(out, w, ",\"shot\":" as &const byte);
    w = w + j_put_i64(out, w, b.shots[i].seq as i64);
    w = w + j_put(out, w, ",\"events\":[" as &const byte);
    var ei: usize = 0;
    while ei < 6 && ei < b.shots[i].evn {
        if ei > 0 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = w + j_put_i64(out, w, b.shots[i].evs[ei]);
        ei = ei + 1;
    }
    w = w + j_put(out, w, "]" as &const byte);
    w = w + j_put(out, w, "}" as &const byte);
    w = w + j_put(out, w, ",\"scene\":" as &const byte);
    w = w + j_put_str(out, w, &b.shots[i].scene[0], b.shots[i].scene_len);
    w = w + j_put(out, w, ",\"framing\":" as &const byte);
    w = w + j_put_str(out, w, &b.shots[i].framing[0],
        b.shots[i].framing_len);
    w = w + j_put(out, w, ",\"camera\":{\"move\":\"static\"}" as &const byte);
    w = w + j_put(out, w, ",\"action\":" as &const byte);
    w = w + j_put_str(out, w, &b.shots[i].action[0], b.shots[i].action_len);
    if b.shots[i].who_len > 0 {
        w = w + j_put(out, w, ",\"who\":" as &const byte);
        w = w + j_put_str(out, w, &b.shots[i].who[0], b.shots[i].who_len);
    }
    if b.shots[i].line_len > 0 {
        w = w + j_put(out, w, ",\"line\":" as &const byte);
        w = w + j_put_str(out, w, &b.shots[i].line[0], b.shots[i].line_len);
    }
    w = w + j_put(out, w, ",\"audio\":{\"has_dialogue\":" as &const byte);
    if b.shots[i].line_len > 0 {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, "}" as &const byte);
    w = w + j_put(out, w, ",\"cut_type\":" as &const byte);
    w = w + j_put_str(out, w, &b.shots[i].cut[0], b.shots[i].cut_len);
    w = w + j_put(out, w, ",\"timeline_in\":" as &const byte);
    w = w + j_put_i64(out, w, b.shots[i].tin);
    w = w + j_put(out, w, ",\"timeline_out\":" as &const byte);
    w = w + j_put_i64(out, w, b.shots[i].tout);
    w = w + j_put(out, w, ",\"duration_ms\":" as &const byte);
    w = w + j_put_i64(out, w, b.shots[i].dur);
    w = w + j_put(out, w, "}" as &const byte);
    return w;
}

fn board_serialize(b: &Board, script_ver: i64, out: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(out, w, "{\"format_version\":1," as &const byte);
    w = w + j_put(out, w, "\"source_script_version\":" as &const byte);
    w = w + j_put_i64(out, w, script_ver);
    w = w + j_put(out, w, ",\"shot_count\":" as &const byte);
    w = w + j_put_i64(out, w, b.n as i64);
    w = w + j_put(out, w, ",\"total_ms\":" as &const byte);
    w = w + j_put_i64(out, w, b.total_ms);
    w = w + j_put(out, w, ",\"shots\":[" as &const byte);
    var i: usize = 0;
    while i < b.n {
        if i > 0 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = put_shot(b, i, out, w);
        i = i + 1;
    }
    w = w + j_put(out, w, "]}" as &const byte);
    return w;
}

fn bdir(root: &const byte, rn: usize, id: &const byte, idn: usize,
    out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, BOARD_DIR, b_len(BOARD_DIR), out,
        out_len);
}

export fn board_version(root: &const byte, rn: usize, id: &const byte,
    idn: usize) i64 {
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !bdir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 0;
    }
    var buf: [byte: 128] = [0: 128];
    var bl: usize = 0;
    if !read_file(&dpath[0], dl, "current.json" as &const byte, 12,
        &buf[0], 128, &bl) {
        return 0;
    }
    return num_field(&buf[0], bl, "version" as &const byte);
}

fn num_field(buf: &const byte, n: usize, key: &const byte) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return 0;
    }
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}

// 当前版本的分镜内容 hash 是否与这次的相同（相同就复用版本号）
fn board_same(dpath: &const byte, dl: usize, ver: i64,
    hex: &const byte) bool {
    if ver <= 0 {
        return false;
    }
    var prev: [byte: 64] = [0: 64];
    var pn: usize = 0;
    pn = pn + j_put_raw(&prev[0: 64], pn, "v" as &const byte, 1);
    pn = pn + j_put_i64(&prev[0: 64], pn, ver);
    pn = pn + j_put_raw(&prev[0: 64], pn, ".json" as &const byte, 5);
    var pbuf: [byte: BOARD_BUF] = [0: BOARD_BUF];
    var pl: usize = 0;
    if !read_file(dpath, dl, &prev[0], pn, &pbuf[0], BOARD_BUF, &pl) {
        return false;
    }
    var hs: [usize: 1] = [0];
    var hll: [usize: 1] = [0];
    if j_span(&pbuf[0], pl, "content_hash" as &const byte, &hs[0],
        &hll[0]) != 34 as byte || hll[0] != 66 {
        return false;
    }
    var k: usize = 0;
    while k < 64 {
        if pbuf[hs[0] + 1 + k] != hex[k] {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// 从剧本版本生成分镜；同一份剧本重复调用不产生新版本
export fn board_build(root: &const byte, rn: usize, id: &const byte,
    idn: usize, script_ver: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var rec: [byte: BOARD_BUF] = [0: BOARD_BUF];
    var rl: [usize: 1] = [0];
    const lrc: i32 = story_load(root, rn, id, idn, script_ver,
        &rec[0: BOARD_BUF], &rl[0]);
    if lrc != 0 {
        return 96;
    }
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(&rec[0], rl[0], "screenplay" as &const byte, &ss[0],
        &sl[0]) != 123 as byte {
        return 90;
    }
    var b: Board = blank_board();
    if !collect_shots(&rec[ss[0]], sl[0], &b) {
        return 98;
    }
    map_events(&rec[ss[0]], sl[0], &b);
    if b.n == 0 {
        return 90;
    }
    b.src_ver = script_ver;
    var body: [byte: BOARD_BUF] = [0: BOARD_BUF];
    const bn: usize = board_serialize(&b, script_ver, &body[0: BOARD_BUF]);
    var hex: [byte: 64] = [0: 64];
    var hl: [usize: 1] = [0];
    if !sha256_hex(&body[0], bn, &hex[0: 64], &hl[0]) {
        return 94;
    }
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !bdir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 94;
    }
    var ver: i64 = board_version(root, rn, id, idn);
    const same: bool = board_same(&dpath[0], dl, ver, &hex[0]);
    if !same {
        ver = ver +| 1;
    }
    if !same {
        var saved: [byte: BOARD_BUF + 128] = [0: BOARD_BUF + 128];
        var sw: usize = 0;
        sw = sw + j_put(&saved[0: BOARD_BUF + 128], sw,
            "{\"format_version\":1,\"version\":" as &const byte);
        sw = sw + j_put_i64(&saved[0: BOARD_BUF + 128], sw, ver);
        sw = sw + j_put(&saved[0: BOARD_BUF + 128], sw,
            ",\"content_hash\":\"" as &const byte);
        sw = sw + j_put_raw(&saved[0: BOARD_BUF + 128], sw, &hex[0], 64);
        sw = sw + j_put(&saved[0: BOARD_BUF + 128], sw,
            "\",\"board\":" as &const byte);
        sw = sw + j_put_raw(&saved[0: BOARD_BUF + 128], sw, &body[0], bn);
        sw = sw + j_put(&saved[0: BOARD_BUF + 128], sw, "}" as &const byte);
        var nm: [byte: 32] = [0: 32];
        var nn: usize = 0;
        nn = nn + j_put_raw(&nm[0: 32], nn, "v" as &const byte, 1);
        nn = nn + j_put_i64(&nm[0: 32], nn, ver);
        nn = nn + j_put_raw(&nm[0: 32], nn, ".json" as &const byte, 5);
        if !write_atomic(&dpath[0], dl, &nm[0], nn, &saved[0], sw) {
            return 94;
        }
        var cur: [byte: 128] = [0: 128];
        var cw: usize = 0;
        cw = cw + j_put(&cur[0: 128], cw, "{\"version\":" as &const byte);
        cw = cw + j_put_i64(&cur[0: 128], cw, ver);
        cw = cw + j_put(&cur[0: 128], cw, "}" as &const byte);
        if !write_atomic(&dpath[0], dl, "current.json" as &const byte, 12,
            &cur[0], cw) {
            return 94;
        }
    }
    var w: usize = 0;
    w = w + j_put(out, w, "{\"board_version\":" as &const byte);
    w = w + j_put_i64(out, w, ver);
    w = w + j_put(out, w, ",\"shot_count\":" as &const byte);
    w = w + j_put_i64(out, w, b.n as i64);
    w = w + j_put(out, w, ",\"total_ms\":" as &const byte);
    w = w + j_put_i64(out, w, b.total_ms);
    w = w + j_put(out, w, ",\"reused\":" as &const byte);
    if same {
        w = w + j_put(out, w, "true}" as &const byte);
    } else {
        w = w + j_put(out, w, "false}" as &const byte);
    }
    out_len[0] = w;
    return 0;
}

// 取分镜（version<=0 表示当前版）
export fn board_get(root: &const byte, rn: usize, id: &const byte,
    idn: usize, version: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !bdir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 94;
    }
    var v: i64 = version;
    if v <= 0 {
        v = board_version(root, rn, id, idn);
    }
    if v <= 0 {
        return 96;
    }
    var nm: [byte: 32] = [0: 32];
    var nn: usize = 0;
    nn = nn + j_put_raw(&nm[0: 32], nn, "v" as &const byte, 1);
    nn = nn + j_put_i64(&nm[0: 32], nn, v);
    nn = nn + j_put_raw(&nm[0: 32], nn, ".json" as &const byte, 5);
    if !read_file(&dpath[0], dl, &nm[0], nn, &out[0], out.len, out_len) {
        return 96;
    }
    return 0;
}

// ---- 字幕：按分镜时间轴生成 SRT（ASR 对齐待接） ----

const SRT_BUF: usize = 32768;

fn put_2d(dst: &[byte], w0: usize, v: i64) usize {
    var w: usize = w0;
    if w + 1 >= dst.len {
        return w;
    }
    dst[w] = (48 as u8) +| ((v / 10) as u8);
    dst[w + 1] = (48 as u8) +| ((v -| ((v / 10) *| 10)) as u8);
    return w + 2;
}

fn put_3d(dst: &[byte], w0: usize, v: i64) usize {
    var w: usize = w0;
    if w + 2 >= dst.len {
        return w;
    }
    dst[w] = (48 as u8) +| ((v / 100) as u8);
    dst[w + 1] = (48 as u8) +| (((v -| ((v / 100) *| 100)) / 10) as u8);
    dst[w + 2] = (48 as u8) +| ((v -| ((v / 10) *| 10)) as u8);
    return w + 3;
}

// 毫秒 → HH:MM:SS,mmm
fn srt_time(dst: &[byte], w0: usize, ms: i64) usize {
    const sec: i64 = ms / 1000;
    const h: i64 = sec / 3600;
    const rem: i64 = sec -| (h *| 3600);
    const mi: i64 = rem / 60;
    const ss: i64 = rem -| (mi *| 60);
    const msec: i64 = ms -| (sec *| 1000);
    var w: usize = w0;
    w = put_2d(dst, w, h);
    if w < dst.len {
        dst[w] = 58 as u8;
        w = w + 1;
    }
    w = put_2d(dst, w, mi);
    if w < dst.len {
        dst[w] = 58 as u8;
        w = w + 1;
    }
    w = put_2d(dst, w, ss);
    if w < dst.len {
        dst[w] = 44 as u8;
        w = w + 1;
    }
    return put_3d(dst, w, msec);
}

fn put_srt_block(dst: &[byte], w0: usize, no: i64, tin: i64, tout: i64,
    line: &const byte, ln: usize) usize {
    var w: usize = w0;
    w = w + j_put_i64(dst, w, no);
    if w < dst.len {
        dst[w] = 10 as u8;
        w = w + 1;
    }
    w = srt_time(dst, w, tin);
    w = w + j_put(dst, w, " --> " as &const byte);
    w = srt_time(dst, w, tout);
    if w + 1 < dst.len {
        dst[w] = 10 as u8;
        dst[w + 1] = 10 as u8;
        w = w + 2;
    }
    w = w + j_put_raw(dst, w, line, ln);
    if w < dst.len {
        dst[w] = 10 as u8;
        w = w + 1;
    }
    return w;
}

// 从分镜生成字幕文件：<project>/subtitles/v<N>.srt
export fn subtitle_build(root: &const byte, rn: usize, id: &const byte,
    idn: usize, version: i64, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var rec: [byte: BOARD_BUF] = [0: BOARD_BUF];
    var rl: [usize: 1] = [0];
    if board_get(root, rn, id, idn, version, &rec[0: BOARD_BUF],
        &rl[0]) != 0 {
        return 96;
    }
    var bs: [usize: 1] = [0];
    var bl: [usize: 1] = [0];
    if j_span(&rec[0], rl[0], "board" as &const byte, &bs[0],
        &bl[0]) != 123 as byte {
        return 96;
    }
    const bd: &const byte = &rec[bs[0]];
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(bd, bl[0], "shots" as &const byte, &ss[0],
        &sl[0]) != 91 as byte {
        return 96;
    }
    const ver: i64 = num_field(&rec[0], rl[0], "version" as &const byte);
    if ver <= 0 {
        return 96;
    }
    var pdir: [byte: 512] = [0: 512];
    var pl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8, &pdir[0: 512],
        &pl) {
        return 94;
    }
    var idir: [byte: 512] = [0: 512];
    var il: usize = 0;
    if !path_join(&pdir[0], pl, id, idn, &idir[0: 512], &il) {
        return 94;
    }
    var sdir: [byte: 512] = [0: 512];
    var sdl: usize = 0;
    if !path_join(&idir[0], il, "subtitles" as &const byte, 9,
        &sdir[0: 512], &sdl) {
        return 94;
    }
    _ = mkdir_p(&sdir[0], sdl);
    var nm: [byte: 32] = [0: 32];
    var nn: usize = 0;
    nn = nn + j_put_raw(&nm[0: 32], nn, "v" as &const byte, 1);
    nn = nn + j_put_i64(&nm[0: 32], nn, ver);
    nn = nn + j_put_raw(&nm[0: 32], nn, ".srt" as &const byte, 4);
    var srt: [byte: SRT_BUF] = [0: SRT_BUF];
    var w: usize = 0;
    var n: i64 = 0;
    var idx: usize = 0;
    while true {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&bd[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sh: &const byte = &bd[ss[0] + es[0]];
        var line: [byte: 256] = [0: 256];
        var ln: [usize: 1] = [0];
        _ = j_str(sh, el[0], "line" as &const byte, &line[0: 256],
            &ln[0]);
        if ln[0] > 0 {
            n = n + 1;
            const tin: i64 = num_field(sh, el[0],
                "timeline_in" as &const byte);
            const tout: i64 = num_field(sh, el[0],
                "timeline_out" as &const byte);
            w = put_srt_block(&srt[0: SRT_BUF], w, n, tin, tout,
                &line[0], ln[0]);
        }
        idx = idx + 1;
    }
    if !write_atomic(&sdir[0], sdl, &nm[0], nn, &srt[0], w) {
        return 94;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"path\":\"subtitles/" as &const byte);
    ow = ow + j_put_raw(out, ow, &nm[0], nn);
    ow = ow + j_put(out, ow, "\",\"lines\":" as &const byte);
    ow = ow + j_put_i64(out, ow, n);
    ow = ow + j_put(out, ow, ",\"board_version\":" as &const byte);
    ow = ow + j_put_i64(out, ow, ver);
    ow = ow + j_put(out, ow, "}" as &const byte);
    out_len[0] = ow;
    return 0;
}
