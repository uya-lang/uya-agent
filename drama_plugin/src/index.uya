// drama_plugin/src/index.uya — 派生索引（P13 第二段）
//
// 索引不是真相，只是"查得快"的投影：真相在 commits/ 与各版本文件里。
// 所以这里只做两件事——
//   * index_rebuild：从盘上的真相**全量重建** index/episodes.jsonl；
//   * index_list   ：读索引（没有就顺手重建一次）。
//
// 一行一集：
//   {"revision":N,"script_version":N,"board_version":N,"assembly_version":N,
//    "renders":N,"gpu_ms":N}
//
// 设计取舍：现在一集 = 一个 canon revision，剧本/分镜/成片的版本号与它对齐；
// 接真实产线后如果一集多版本，重建逻辑要改成按 commits 里的 events 归集。
//
// 返回码：0 成功 50 ID 非法 94 读写失败

use libc.syscall;
use libc.unistd;

const IDX_BUF: usize = 16384;
const IDX_DIR: &const byte = "index" as &const byte;
const IDX_FILE: &const byte = "episodes.jsonl" as &const byte;

fn idir(root: &const byte, rn: usize, id: &const byte, idn: usize,
    out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, IDX_DIR, b_len(IDX_DIR), out, out_len);
}

fn inum(buf: &const byte, n: usize, key: &const byte) i64 {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte {
        return 0;
    }
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| ((c as i64) -| 48);
        i = i + 1;
    }
    return v;
}

// 一集一行的 JSON
fn put_line(out: &[byte], w0: usize, rev: i64, sv: i64, bv: i64,
    av: i64, renders: i64, gpu_ms: i64) usize {
    var w: usize = w0;
    w = w + j_put(out, w, "{\"revision\":" as &const byte);
    w = w + j_put_i64(out, w, rev);
    w = w + j_put(out, w, ",\"script_version\":" as &const byte);
    w = w + j_put_i64(out, w, sv);
    w = w + j_put(out, w, ",\"board_version\":" as &const byte);
    w = w + j_put_i64(out, w, bv);
    w = w + j_put(out, w, ",\"assembly_version\":" as &const byte);
    w = w + j_put_i64(out, w, av);
    w = w + j_put(out, w, ",\"renders\":" as &const byte);
    w = w + j_put_i64(out, w, renders);
    w = w + j_put(out, w, ",\"gpu_ms\":" as &const byte);
    w = w + j_put_i64(out, w, gpu_ms);
    w = w + j_put(out, w, "}" as &const byte);
    return w;
}

// 从任务索引累计"渲染次数 / GPU 时长"（按项目汇总，不再拆到集）
fn sum_cost(root: &const byte, rn: usize, id: &const byte, idn: usize,
    renders: &i64, gpu_ms: &i64) bool {
    var idx: [byte: IDX_BUF] = [0: IDX_BUF];
    var il: [usize: 1] = [0];
    if task_list(root, rn, id, idn, &idx[0: IDX_BUF], &il[0]) != 0 {
        return false;
    }
    var i: usize = 0;
    while i < il[0] {
        var e: usize = i;
        while e < il[0] && idx[e] != 10 as byte {
            e = e + 1;
        }
        if e > i {
            var tid: [byte: 32] = [0: 32];
            var tidl: usize = 0;
            _ = j_str(&idx[i], e - i, "id" as &const byte, &tid[0: 32],
                &tidl);
            if tidl > 0 {
                var rec: [byte: 2048] = [0: 2048];
                var rl: [usize: 1] = [0];
                if task_get(root, rn, id, idn, &tid[0], tidl,
                    &rec[0: 2048], &rl[0]) == 0 {
                    renders[0] = renders[0] +| inum(&rec[0], rl[0],
                        "renders" as &const byte);
                    gpu_ms[0] = gpu_ms[0] +| inum(&rec[0], rl[0],
                        "gpu_ms" as &const byte);
                }
            }
        }
        i = e + 1;
    }
    return true;
}

// 全量重建：把 index/episodes.jsonl 按当前真相重写一遍
export fn index_rebuild(root: &const byte, rn: usize, id: &const byte,
    idn: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    if !project_id_ok(id, idn) {
        return 50;
    }
    const rev: i64 = canon_revision(root, rn, id, idn);
    if rev < 0 {
        return 50;
    }
    var renders: [i64: 1] = [0];
    var gpu: [i64: 1] = [0];
    _ = sum_cost(root, rn, id, idn, &renders[0], &gpu[0]);
    var body: [byte: IDX_BUF] = [0: IDX_BUF];
    var w: usize = 0;
    var r: i64 = 1;
    while r <= rev {
        const sv: i64 = script_version_at(root, rn, id, idn, r);
        const bv: i64 = board_version_at(root, rn, id, idn, r);
        const av: i64 = assembly_version_at(root, rn, id, idn, r);
        w = put_line(&body[0: IDX_BUF], w, r, sv, bv, av,
            if_eq(r, rev, renders[0]), if_eq2(r, rev, gpu[0]));
        body[w] = 10 as byte;
        w = w + 1;
        r = r + 1;
    }
    if w == 0 {
        w = 0;
    }
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !idir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 94;
    }
    if !write_atomic(&dpath[0], dl, IDX_FILE, b_len(IDX_FILE), &body[0], w) {
        return 94;
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"episodes\":" as &const byte);
    ow = ow + j_put_i64(out, ow, rev);
    ow = ow + j_put(out, ow, ",\"renders\":" as &const byte);
    ow = ow + j_put_i64(out, ow, renders[0]);
    ow = ow + j_put(out, ow, ",\"gpu_ms\":" as &const byte);
    ow = ow + j_put_i64(out, ow, gpu[0]);
    ow = ow + j_put(out, ow, "}" as &const byte);
    out_len[0] = ow;
    return 0;
}

fn if_eq(r: i64, rev: i64, v: i64) i64 {
    if r == rev {
        return v;
    }
    return 0;
}

fn if_eq2(r: i64, rev: i64, v: i64) i64 {
    if r == rev {
        return v;
    }
    return 0;
}

// 某一集的剧本版本（没有就是 0）
fn script_version_at(root: &const byte, rn: usize, id: &const byte,
    idn: usize, rev: i64) i64 {
    const cur: i64 = story_current_version(root, rn, id, idn);
    if rev <= cur {
        return rev;
    }
    return 0;
}

// 分镜/成片只在真做过的时候才算数：按"该版本文件是否存在"判定
fn board_version_at(root: &const byte, rn: usize, id: &const byte,
    idn: usize, rev: i64) i64 {
    var tmp: [byte: 256] = [0: 256];
    var tl: [usize: 1] = [0];
    if board_get(root, rn, id, idn, rev, &tmp[0: 256], &tl[0]) == 0 {
        return rev;
    }
    return 0;
}

fn assembly_version_at(root: &const byte, rn: usize, id: &const byte,
    idn: usize, rev: i64) i64 {
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8,
        &pdir[0: 512], &pdl) {
        return 0;
    }
    var dir: [byte: 512] = [0: 512];
    var dl0: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl0) {
        return 0;
    }
    if !path_join(&dir[0], dl0, "assemblies" as &const byte, 10,
        &dpath[0: 512], &dl) {
        return 0;
    }
    var nm: [byte: 32] = [0: 32];
    var nn: usize = 0;
    nn = nn + j_put_raw(&nm[0: 32], nn, "v" as &const byte, 1);
    nn = nn + j_put_i64(&nm[0: 32], nn, rev);
    nn = nn + j_put_raw(&nm[0: 32], nn, ".json" as &const byte, 5);
    var tmp: [byte: 256] = [0: 256];
    var tl: [usize: 1] = [0];
    if read_file(&dpath[0], dl, &nm[0], nn, &tmp[0], 256, &tl[0]) {
        return rev;
    }
    return 0;
}

// 读索引；没有就重建一次
export fn index_list(root: &const byte, rn: usize, id: &const byte,
    idn: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var dpath: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !idir(root, rn, id, idn, &dpath[0: 512], &dl) {
        return 94;
    }
    if read_file(&dpath[0], dl, IDX_FILE, b_len(IDX_FILE), &out[0],
        out.len, out_len) {
        return 0;
    }
    var tmp: [byte: 256] = [0: 256];
    var tl: [usize: 1] = [0];
    const rc: i32 = index_rebuild(root, rn, id, idn, &tmp[0: 256], &tl[0]);
    if rc != 0 {
        return rc;
    }
    _ = read_file(&dpath[0], dl, IDX_FILE, b_len(IDX_FILE), &out[0],
        out.len, out_len);
    return 0;
}
