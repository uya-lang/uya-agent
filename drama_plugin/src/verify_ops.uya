// drama_plugin/src/verify_ops.uya — 成片终检（final.verify）
//
// 从 ops.uya 再拆一份出来（ops.uya 已接近 2000 行）：本文件的操作只读，
// 但要让结果可复核，所以每条判据都单独列进 checks，失败返回 90。

// <proj>/<sub> 目录
fn vr_sub_dir(root: &const byte, rn: usize, id: &const byte, idn: usize,
    sub: &const byte, sn: usize, out: &[byte], out_len: &usize) bool {
    var pdir: [byte: 512] = [0: 512];
    var pdl: usize = 0;
    if !path_join(root, rn, "projects" as &const byte, 8, &pdir[0: 512],
        &pdl) {
        return false;
    }
    var dir: [byte: 512] = [0: 512];
    var dl: usize = 0;
    if !path_join(&pdir[0], pdl, id, idn, &dir[0: 512], &dl) {
        return false;
    }
    return path_join(&dir[0], dl, sub, sn, out, out_len);
}

// canvas "440x800" → 宽高（非该格式返回 false）
fn vr_canvas(cv: &const byte, cn: usize, w: &i64, h: &i64) bool {
    var i: usize = 0;
    while i < cn && cv[i] != 120 as byte {
        i = i + 1;
    }
    if i == 0 || i + 1 >= cn {
        return false;
    }
    var a: i64 = 0;
    var k: usize = 0;
    while k < i {
        if cv[k] < 48 as byte || cv[k] > 57 as byte {
            return false;
        }
        a = a *| 10;
        a = a +| ((cv[k] as i64) -| 48);
        k = k + 1;
    }
    var b: i64 = 0;
    k = i + 1;
    while k < cn {
        if cv[k] < 48 as byte || cv[k] > 57 as byte {
            return false;
        }
        b = b *| 10;
        b = b +| ((cv[k] as i64) -| 48);
        k = k + 1;
    }
    if a <= 0 || b <= 0 {
        return false;
    }
    w[0] = a;
    h[0] = b;
    return true;
}

// SRT 最后一个 "-->" 的结束时刻（毫秒）；没有字幕返回 0
fn vr_srt_end(raw: &const byte, n: usize) i64 {
    var last: i64 = 0;
    var i: usize = 0;
    while i + 3 < n {
        if raw[i] == 45 as byte && raw[i + 1] == 45 as byte
            && raw[i + 2] == 62 as byte {
            // "-->" 之后跳过空白，读 HH:MM:SS,mmm
            var k: usize = i + 3;
            while k < n && (raw[k] == 32 as byte || raw[k] == 9 as byte) {
                k = k + 1;
            }
            const t: i64 = vr_clock(raw, n, k);
            if t > last {
                last = t;
            }
            i = k;
        }
        i = i + 1;
    }
    return last;
}

fn vr_clock(raw: &const byte, n: usize, st: usize) i64 {
    if st + 12 > n {
        return 0;
    }
    var h: i64 = 0;
    var m: i64 = 0;
    var s: i64 = 0;
    var ms: i64 = 0;
    var ok: bool = true;
    var k: usize = 0;
    while k < 2 {
        if raw[st + k] < 48 as byte || raw[st + k] > 57 as byte {
            ok = false;
        }
        h = h *| 10;
        h = h +| ((raw[st + k] as i64) -| 48);
        k = k + 1;
    }
    k = 3;
    while k < 5 {
        if raw[st + k] < 48 as byte || raw[st + k] > 57 as byte {
            ok = false;
        }
        m = m *| 10;
        m = m +| ((raw[st + k] as i64) -| 48);
        k = k + 1;
    }
    k = 6;
    while k < 8 {
        if raw[st + k] < 48 as byte || raw[st + k] > 57 as byte {
            ok = false;
        }
        s = s *| 10;
        s = s +| ((raw[st + k] as i64) -| 48);
        k = k + 1;
    }
    k = 9;
    while k < 12 {
        if raw[st + k] < 48 as byte || raw[st + k] > 57 as byte {
            ok = false;
        }
        ms = ms *| 10;
        ms = ms +| ((raw[st + k] as i64) -| 48);
        k = k + 1;
    }
    if !ok {
        return 0;
    }
    return ((h *| 3600) +| (m *| 60) +| s) *| 1000 +| ms;
}

fn vr_eq(a: &const byte, an: usize, b: &const byte, bn: usize) bool {
    if an != bn {
        return false;
    }
    var i: usize = 0;
    while i < an {
        if a[i] != b[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 读 {"decodable":true} 这类布尔字段（布尔字面量按 115/4 处理）
fn vr_flag(o: &const byte, n: usize, key: &const byte) bool {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(o, n, key, &st[0], &ln[0]) != 115 as byte || ln[0] != 4 {
        return false;
    }
    const t: &const byte = "true" as &const byte;
    var i: usize = 0;
    while i < 4 {
        if o[st[0] + i] != t[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// 一条判据
fn vr_check(out: &[byte], w0: usize, name: &const byte, ok: bool,
    n: &usize) usize {
    var w: usize = w0;
    if n[0] > 0 {
        w = w + j_put(out, w, "," as &const byte);
    }
    w = w + j_put(out, w, "{\"name\":" as &const byte);
    w = w + j_put(out, w, "\"" as &const byte);
    w = w + j_put_raw(out, w, name, b_len(name));
    w = w + j_put(out, w, "\",\"ok\":" as &const byte);
    if ok {
        w = w + j_put(out, w, "true}" as &const byte);
    } else {
        w = w + j_put(out, w, "false}" as &const byte);
    }
    n[0] = n[0] + 1;
    return w;
}

// final.verify：解码 + 编码参数/分辨率/时长对 format + 字幕末条对齐
export fn op_final_verify(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) {
        return 13;
    }
    var rel: [byte: 256] = [0: 256];
    var rl: [usize: 1] = [0];
    if !input_str(line, n, "path" as &const byte, &rel[0: 256], &rl[0]) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    const bv: i64 = int_arg(line, n, "board_version" as &const byte, 0);
    const ed: i64 = int_arg(line, n, "expect_duration_ms" as &const byte, 0);
    var pb: [byte: 512] = [0: 512];
    var pbl: [usize: 1] = [0];
    const rc: i32 = provider_verify_file(root, rn, &rel[0], rl[0],
        &pb[0: 512], &pbl[0]);
    if rc != 0 {
        return rc;
    }
    const pw: i64 = json_i64_at(&pb[0: 512], pbl[0], "width" as &const byte);
    const ph: i64 = json_i64_at(&pb[0: 512], pbl[0],
        "height" as &const byte);
    const pd: i64 = json_i64_at(&pb[0: 512], pbl[0],
        "duration_ms" as &const byte);
    const dec: bool = vr_flag(&pb[0], pbl[0], "decodable" as &const byte);
    var codec: [byte: 32] = [0: 32];
    var cl: [usize: 1] = [0];
    _ = j_str(&pb[0], pbl[0], "codec" as &const byte, &codec[0: 32],
        &cl[0]);
    // Bible 里的 format 是唯一来源
    var bible: [byte: 16384] = [0: 16384];
    var bl: [usize: 1] = [0];
    var fw: i64 = 0;
    var fh: i64 = 0;
    var fcodec: [byte: 32] = [0: 32];
    var fcl: [usize: 1] = [0];
    if bible_get(root, rn, &pid[0], pl[0], 0, &bible[0: 16384],
        &bl[0]) == 0 {
        var fs: [usize: 1] = [0];
        var fl: [usize: 1] = [0];
        if j_span(&bible[0], bl[0], "format" as &const byte, &fs[0],
            &fl[0]) == 123 as byte {
            var cv: [byte: 32] = [0: 32];
            var cvl: [usize: 1] = [0];
            if j_str(&bible[fs[0]], fl[0], "canvas" as &const byte,
                &cv[0: 32], &cvl[0]) {
                _ = vr_canvas(&cv[0], cvl[0], &fw, &fh);
            }
            _ = j_str(&bible[fs[0]], fl[0], "codec" as &const byte,
                &fcodec[0: 32], &fcl[0]);
        }
    }
    var ck: [byte: 512] = [0: 512];
    var cn: [usize: 1] = [0];
    var w: usize = 0;
    var fails: i64 = 0;
    if !dec {
        fails = fails +| 1;
    }
    w = vr_check(&ck[0: 512], w, "decode" as &const byte, dec, &cn);
    if fw > 0 && fh > 0 {
        const rok: bool = pw == fw && ph == fh;
        if !rok {
            fails = fails +| 1;
        }
        w = vr_check(&ck[0: 512], w, "resolution" as &const byte, rok, &cn);
    }
    if fcl[0] > 0 {
        const cok: bool = vr_eq(&codec[0], cl[0], &fcodec[0], fcl[0]);
        if !cok {
            fails = fails +| 1;
        }
        w = vr_check(&ck[0: 512], w, "codec" as &const byte, cok, &cn);
    }
    if ed > 0 {
        const dok: bool = pd <= ed +| 100 && pd +| 100 >= ed;
        if !dok {
            fails = fails +| 1;
        }
        w = vr_check(&ck[0: 512], w, "duration" as &const byte, dok, &cn);
    }
    // 字幕同步：SRT 最后一条的结束时刻要贴住成片时长
    var srt: &byte = malloc(16384) as &byte;
    defer { free(srt as &void); }
    var srln: [usize: 1] = [0];
    if bv > 0 {
        var sdir: [byte: 512] = [0: 512];
        var sdl: [usize: 1] = [0];
        if vr_sub_dir(root, rn, &pid[0], pl[0], "subtitles" as &const byte,
            9, &sdir[0: 512], &sdl[0]) {
            var nm: [byte: 24] = [0: 24];
            var nn: usize = 0;
            nn = nn + j_put_raw(&nm[0: 24], nn, "v" as &const byte, 1);
            nn = nn + j_put_i64(&nm[0: 24], nn, bv);
            nn = nn + j_put_raw(&nm[0: 24], nn, ".srt" as &const byte, 4);
            if (srt as usize) != 0
                && read_file(&sdir[0], sdl[0], &nm[0], nn, srt, 16384,
                    &srln[0]) {
                const se: i64 = vr_srt_end(srt, srln[0]);
                const sok: bool = se > 0 && pd <= se +| 1000
                    && pd +| 1000 >= se;
                if !sok {
                    fails = fails +| 1;
                }
                w = vr_check(&ck[0: 512], w, "subtitle_sync" as &const byte,
                    sok, &cn);
            }
        }
    }
    var ow: usize = 0;
    ow = ow + j_put(out, ow, "{\"path\":" as &const byte);
    ow = ow + j_put_str(out, ow, &rel[0], rl[0]);
    ow = ow + j_put(out, ow, ",\"width\":" as &const byte);
    ow = ow + j_put_i64(out, ow, pw);
    ow = ow + j_put(out, ow, ",\"height\":" as &const byte);
    ow = ow + j_put_i64(out, ow, ph);
    ow = ow + j_put(out, ow, ",\"codec\":" as &const byte);
    ow = ow + j_put_str(out, ow, &codec[0], cl[0]);
    ow = ow + j_put(out, ow, ",\"duration_ms\":" as &const byte);
    ow = ow + j_put_i64(out, ow, pd);
    ow = ow + j_put(out, ow, ",\"decodable\":" as &const byte);
    if dec {
        ow = ow + j_put(out, ow, "true" as &const byte);
    } else {
        ow = ow + j_put(out, ow, "false" as &const byte);
    }
    ow = ow + j_put(out, ow, ",\"checks\":[" as &const byte);
    ow = ow + j_put_raw(out, ow, &ck[0], w);
    ow = ow + j_put(out, ow, "],\"ok\":" as &const byte);
    const all_ok: bool = fails == 0;
    if all_ok {
        ow = ow + j_put(out, ow, "true}" as &const byte);
    } else {
        ow = ow + j_put(out, ow, "false}" as &const byte);
    }
    out_len[0] = ow;
    if !all_ok {
        return 78;
    }
    return 0;
}


// ---- shot.anchor：锚帧接戏差（上一镜末帧 vs 这一镜首帧的 PSNR）----------
// 判据：PSNR ≥ 阈值（默认 30 dB）视为接得上；差得越多越可能是"人/景跳了"。
const AN_MAX: usize = 64;

// 第 i 镜的 cut_type 是不是 anchor
fn an_anchored(bd: &const byte, n: usize, i: usize) bool {
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(bd, n, "shots" as &const byte, &ss[0], &sl[0]) != 91 as byte {
        return false;
    }
    var es: [usize: 1] = [0];
    var el: [usize: 1] = [0];
    if !j_arr_item(&bd[ss[0]], sl[0], i, &es[0], &el[0]) {
        return false;
    }
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(&bd[ss[0] + es[0]], el[0], "cut_type" as &const byte,
        &st[0], &ln[0]) != 34 as byte || ln[0] < 7 {
        return false;
    }
    const a: &const byte = "anchor" as &const byte;
    var j: usize = 0;
    while j < 6 {
        // j_span 对字符串回"开引号位置"，值从 +1 开始
        if bd[ss[0] + es[0] + st[0] + 1 + j] != a[j] {
            return false;
        }
        j = j + 1;
    }
    return true;
}

// 镜头文件相对路径：projects/<pid>/assets/v<bv>/shot_<no>.mp4
fn an_rel(pid: &const byte, pl: usize, bv: i64, no: i64, out: &[byte],
    out_len: &usize) bool {
    var w: usize = 0;
    w = w + j_put_raw(out, w, "projects/" as &const byte, 9);
    w = w + j_put_raw(out, w, pid, pl);
    w = w + j_put_raw(out, w, "/assets/v" as &const byte, 9);
    w = w + j_put_i64(out, w, bv);
    w = w + j_put_raw(out, w, "/shot_" as &const byte, 6);
    w = w + j_put_i64(out, w, no);
    w = w + j_put_raw(out, w, ".mp4" as &const byte, 4);
    out_len[0] = w;
    return w > 0;
}

export fn op_shot_anchor(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    const want: i64 = int_arg(line, n, "board_version" as &const byte, 0);
    const thr: i64 = int_arg(line, n, "threshold_db" as &const byte, 30);
    var bb: [byte: 16384] = [0: 16384];
    var bl: [usize: 1] = [0];
    if board_get(root, rn, &pid[0], pl[0], want, &bb[0: 16384],
        &bl[0]) != 0 {
        return 96;
    }
    const bver: i64 = json_i64_at(&bb[0: 16384], bl[0],
        "version" as &const byte);
    // board_get 返回的就是分镜文件本身（没有外层 "board" 包装）
    const bd: &const byte = &bb[0];
    const bdn: usize = bl[0];
    const cnt: i64 = json_i64_at(&bb[0: 16384], bl[0],
        "shot_count" as &const byte);
    var w: usize = 0;
    var checked: i64 = 0;
    var passed: i64 = 0;
    w = w + j_put(out, w, "{\"board_version\":" as &const byte);
    w = w + j_put_i64(out, w, bver);
    w = w + j_put(out, w, ",\"threshold_db\":" as &const byte);
    w = w + j_put_i64(out, w, thr);
    w = w + j_put(out, w, ",\"results\":[" as &const byte);
    var idx: usize = 1;
    var first: bool = true;
    while (idx as i64) < cnt && idx < AN_MAX {
        if !an_anchored(bd, bdn, idx) {
            idx = idx + 1;
            continue;
        }
        var rel_prev: [byte: 192] = [0: 192];
        var rpn: [usize: 1] = [0];
        var rel_cur: [byte: 192] = [0: 192];
        var rcn: [usize: 1] = [0];
        _ = an_rel(&pid[0], pl[0], bver, idx as i64, &rel_prev[0: 192],
            &rpn[0]);
        _ = an_rel(&pid[0], pl[0], bver, (idx as i64) +| 1,
            &rel_cur[0: 192], &rcn[0]);
        var pb: [byte: 256] = [0: 256];
        var pbl: [usize: 1] = [0];
        const rc: i32 = provider_anchor_psnr(root, rn, &rel_prev[0],
            rpn[0], &rel_cur[0], rcn[0], &pb[0: 256], &pbl[0]);
        checked = checked +| 1;
        if !first {
            w = w + j_put(out, w, "," as &const byte);
        }
        first = false;
        w = w + j_put(out, w, "{\"shot_no\":" as &const byte);
        w = w + j_put_i64(out, w, (idx as i64) +| 1);
        if rc != 0 {
            w = w + j_put(out, w, ",\"ok\":false,\"error\":true}" as
                &const byte);
        } else {
            const mdb: i64 = json_i64_at(&pb[0: 256], pbl[0],
                "average_mdb" as &const byte);
            const ok1: bool = mdb >= thr *| 1000;
            if ok1 {
                passed = passed +| 1;
            }
            w = w + j_put(out, w, ",\"average_mdb\":" as &const byte);
            w = w + j_put_i64(out, w, mdb);
            w = w + j_put(out, w, ",\"ok\":" as &const byte);
            if ok1 {
                w = w + j_put(out, w, "true}" as &const byte);
            } else {
                w = w + j_put(out, w, "false}" as &const byte);
            }
        }
        idx = idx + 1;
    }
    w = w + j_put(out, w, "],\"checked\":" as &const byte);
    w = w + j_put_i64(out, w, checked);
    w = w + j_put(out, w, ",\"passed\":" as &const byte);
    w = w + j_put_i64(out, w, passed);
    w = w + j_put(out, w, ",\"ok\":" as &const byte);
    if checked == passed {
        w = w + j_put(out, w, "true}" as &const byte);
    } else {
        w = w + j_put(out, w, "false}" as &const byte);
    }
    out_len[0] = w;
    if checked != passed {
        return 79;
    }
    return 0;
}


// ---- character.voice：台词语料画像（人称 / 句长），跨集比对找漂移 ----
// 只吃剧本：逐版扫 scenes[].dialogue[{who,line}]，比"基线版"和"最新版"两张画像。
const CV_MAX: usize = 16;

fn cv_cp(p: &const byte, n: usize) i64 {
    var i: usize = 0;
    var c: i64 = 0;
    while i < n {
        const b: byte = p[i];
        if b < 128 as byte || b >= 192 as byte {
            c = c +| 1;
        }
        i = i + 1;
    }
    return c;
}

// 数某个三字节 UTF-8 串出现几次
fn cv_count(p: &const byte, n: usize, pat: &const byte) i64 {
    var i: usize = 0;
    var c: i64 = 0;
    while i + 3 <= n {
        if p[i] == pat[0] && p[i + 1] == pat[1] && p[i + 2] == pat[2] {
            c = c +| 1;
            i = i + 3;
        } else {
            i = i + 1;
        }
    }
    return c;
}

// 找一个角色槽（没有就新建）；满了返回 CV_MAX
fn cv_slot(names: &[byte], lens: &[usize], cnt: &usize, who: &const byte,
    wn: usize) usize {
    var i: usize = 0;
    while i < cnt[0] && i < CV_MAX {
        if lens[i] == wn {
            var k: usize = 0;
            var same: bool = true;
            while k < wn {
                if names[i * 24 + k] != who[k] {
                    same = false;
                    break;
                }
                k = k + 1;
            }
            if same {
                return i;
            }
        }
        i = i + 1;
    }
    if cnt[0] >= CV_MAX {
        return CV_MAX;
    }
    var k: usize = 0;
    while k < wn && k < 24 {
        names[cnt[0] * 24 + k] = who[k];
        k = k + 1;
    }
    lens[cnt[0]] = k;
    cnt[0] = cnt[0] + 1;
    return cnt[0] - 1;
}

// 扫一版剧本，累加到这一版的画像里
fn cv_scan(sp: &const byte, sn: usize, names: &[byte], lens: &[usize],
    cnt: &usize, lines: &[i64], cps: &[i64], prons: &[i64]) void {
    var ss: [usize: 1] = [0];
    var sl: [usize: 1] = [0];
    if j_span(sp, sn, "scenes" as &const byte, &ss[0], &sl[0]) != 91 as byte {
        return;
    }
    var idx: usize = 0;
    while idx < 64 {
        var es: [usize: 1] = [0];
        var el: [usize: 1] = [0];
        if !j_arr_item(&sp[ss[0]], sl[0], idx, &es[0], &el[0]) {
            break;
        }
        const sc: &const byte = &sp[ss[0] + es[0]];
        var ds: [usize: 1] = [0];
        var dl: [usize: 1] = [0];
        if j_span(sc, el[0], "dialogue" as &const byte, &ds[0],
            &dl[0]) == 91 as byte {
            var k: usize = 0;
            while k < 64 {
                var xs: [usize: 1] = [0];
                var xl: [usize: 1] = [0];
                if !j_arr_item(&sc[ds[0]], dl[0], k, &xs[0], &xl[0]) {
                    break;
                }
                const ln: &const byte = &sc[ds[0] + xs[0]];
                var who: [byte: 24] = [0: 24];
                var wl: usize = 0;
                var txt: [usize: 1] = [0];
                var txl: [usize: 1] = [0];
                if j_str(ln, xl[0], "who" as &const byte, &who[0: 24],
                    &wl) && wl > 0 && j_span(ln, xl[0], "line" as
                    &const byte, &txt[0], &txl[0]) == 34 as byte {
                    const sidx: usize = cv_slot(names, lens, cnt, &who[0],
                        wl);
                    if sidx < CV_MAX {
                        // j_span 对字符串回开引号位置：正文从 +1 起
                        const body: &const byte = &ln[txt[0] + 1];
                        const bn: usize = txl[0] -| 2;
                        lines[sidx] = lines[sidx] +| 1;
                        cps[sidx] = cps[sidx] +| cv_cp(body, bn);
                        var pr: i64 = cv_count(body, bn,
                            "\xe6\x88\x91" as &const byte);
                        pr = pr +| cv_count(body, bn,
                            "\xe4\xbd\xa0" as &const byte);
                        pr = pr +| cv_count(body, bn,
                            "\xe4\xbb\x96" as &const byte);
                        pr = pr +| cv_count(body, bn,
                            "\xe5\xa5\xb9" as &const byte);
                        prons[sidx] = prons[sidx] +| pr;
                    }
                }
                k = k + 1;
            }
        }
        idx = idx + 1;
    }
}

export fn op_character_voice(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0]) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    const fv: i64 = int_arg(line, n, "from_version" as &const byte, 1);
    const tv: i64 = int_arg(line, n, "to_version" as &const byte, 0);
    var sdir: [byte: 512] = [0: 512];
    var sdl: [usize: 1] = [0];
    if !vr_sub_dir(root, rn, &pid[0], pl[0], "scripts" as &const byte, 7,
        &sdir[0: 512], &sdl[0]) {
        return 15;
    }
    // 没有给 to_version 就一路读到读不出来为止（上限 200 版）
    var to: i64 = tv;
    if to <= 0 {
        to = fv;
        var probe: &byte = malloc(64) as &byte;
        defer { free(probe as &void); }
        while to < 200 {
            var nm: [byte: 24] = [0: 24];
            var nn: usize = 0;
            nn = nn + j_put_raw(&nm[0: 24], nn, "v" as &const byte, 1);
            nn = nn + j_put_i64(&nm[0: 24], nn, to +| 1);
            nn = nn + j_put_raw(&nm[0: 24], nn, ".json" as &const byte, 5);
            var got: [usize: 1] = [0];
            if (probe as usize) == 0
                || !read_file(&sdir[0], sdl[0], &nm[0], nn, probe, 64,
                    &got[0]) {
                break;
            }
            to = to +| 1;
        }
    }
    if to < fv {
        return 15;
    }
    var names: [byte: 384] = [0: 384];
    var lens: [usize: 16] = [0: 16];
    var cnt: [usize: 1] = [0];
    var f_lines: [i64: 16] = [0: 16];
    var f_cps: [i64: 16] = [0: 16];
    var f_pr: [i64: 16] = [0: 16];
    var t_lines: [i64: 16] = [0: 16];
    var t_cps: [i64: 16] = [0: 16];
    var t_pr: [i64: 16] = [0: 16];
    var buf: &byte = malloc(65536) as &byte;
    defer { free(buf as &void); }
    if (buf as usize) == 0 {
        return 15;
    }
    var v: i64 = fv;
    while v <= to {
        var nm: [byte: 24] = [0: 24];
        var nn: usize = 0;
        nn = nn + j_put_raw(&nm[0: 24], nn, "v" as &const byte, 1);
        nn = nn + j_put_i64(&nm[0: 24], nn, v);
        nn = nn + j_put_raw(&nm[0: 24], nn, ".json" as &const byte, 5);
        var bl: [usize: 1] = [0];
        if read_file(&sdir[0], sdl[0], &nm[0], nn, buf, 65536, &bl[0]) {
            var ss: [usize: 1] = [0];
            var sl: [usize: 1] = [0];
            if j_span(buf, bl[0], "screenplay" as &const byte, &ss[0],
                &sl[0]) == 123 as byte {
                const sp: &const byte = &buf[ss[0]];
                if v == fv {
                    cv_scan(sp, sl[0], &names[0: 384], &lens[0: 16],
                        &cnt[0], &f_lines[0: 16], &f_cps[0: 16],
                        &f_pr[0: 16]);
                }
                if v == to {
                    cv_scan(sp, sl[0], &names[0: 384], &lens[0: 16],
                        &cnt[0], &t_lines[0: 16], &t_cps[0: 16],
                        &t_pr[0: 16]);
                }
            }
        }
        v = v + 1;
    }
    var w: usize = 0;
    var drifted: i64 = 0;
    w = w + j_put(out, w, "{\"from_version\":" as &const byte);
    w = w + j_put_i64(out, w, fv);
    w = w + j_put(out, w, ",\"to_version\":" as &const byte);
    w = w + j_put_i64(out, w, to);
    w = w + j_put(out, w, ",\"characters\":[" as &const byte);
    var i: usize = 0;
    while i < cnt[0] && i < CV_MAX {
        const ok_base: bool = f_lines[i] >= 3;
        const ok_last: bool = t_lines[i] >= 3;
        // 句长（码点 ×1000）与人称占比（百分点）各自比一次
        var fa: i64 = 0;
        var ta: i64 = 0;
        var fr: i64 = 0;
        var tr: i64 = 0;
        if ok_base {
            fa = (f_cps[i] *| 1000) / f_lines[i];
            fr = (f_pr[i] *| 100) / f_cps[i];
        }
        if ok_last {
            ta = (t_cps[i] *| 1000) / t_lines[i];
            tr = (t_pr[i] *| 100) / t_cps[i];
        }
        var drift: bool = false;
        if ok_base && ok_last && fv != to {
            const da: i64 = ta - fa;
            if da *| 2 > fa || (0 -| da) *| 2 > fa {
                drift = true;
            }
            const dr: i64 = tr - fr;
            if dr > 30 || (0 -| dr) > 30 {
                drift = true;
            }
        }
        if drift {
            drifted = drifted +| 1;
        }
        if i > 0 {
            w = w + j_put(out, w, "," as &const byte);
        }
        w = w + j_put(out, w, "{\"id\":" as &const byte);
        w = w + j_put_str(out, w, &names[i * 24], lens[i]);
        w = w + j_put(out, w, ",\"lines\":" as &const byte);
        w = w + j_put_i64(out, w, f_lines[i]);
        w = w + j_put(out, w, ",\"lines_last\":" as &const byte);
        w = w + j_put_i64(out, w, t_lines[i]);
        w = w + j_put(out, w, ",\"avg_cp_milli\":" as &const byte);
        w = w + j_put_i64(out, w, fa);
        w = w + j_put(out, w, ",\"avg_cp_milli_last\":" as &const byte);
        w = w + j_put_i64(out, w, ta);
        w = w + j_put(out, w, ",\"pronoun_pct\":" as &const byte);
        w = w + j_put_i64(out, w, fr);
        w = w + j_put(out, w, ",\"pronoun_pct_last\":" as &const byte);
        w = w + j_put_i64(out, w, tr);
        w = w + j_put(out, w, ",\"drift\":" as &const byte);
        if drift {
            w = w + j_put(out, w, "true}" as &const byte);
        } else {
            w = w + j_put(out, w, "false}" as &const byte);
        }
        i = i + 1;
    }
    w = w + j_put(out, w, "],\"drifted\":" as &const byte);
    w = w + j_put_i64(out, w, drifted);
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}

// 分发：只认本文件的三个操作，其余返回 -1 交回 ops.uya
export fn dispatch_verify(nm: &const byte, n: usize, line: &const byte,
    ln: usize, out: &[byte], out_len: &usize) i32 {
    if b_eq(nm, n, "final.verify" as &const byte) {
        return op_final_verify(line, ln, out, out_len);
    }
    if b_eq(nm, n, "shot.anchor" as &const byte) {
        return op_shot_anchor(line, ln, out, out_len);
    }
    if b_eq(nm, n, "character.voice" as &const byte) {
        return op_character_voice(line, ln, out, out_len);
    }
    return -1;
}
