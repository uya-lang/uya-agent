// drama_plugin/src/server.uya — `mcp serve` 的 stdio 主循环（P1 骨架）
//
// 硬约束（DESIGN §4.2/§4.6）：
//   * stdin/stdout 一行一条**紧凑** JSON；日志只走 stderr；
//   * 单条 ≤1 MiB，超限整行丢弃且不中断服务；
//   * 未知方法回 -32601（宿主据此放行）；
//   * 业务校验失败用 `{"success":false,…}` + `isError:false`；
//     协议/基础设施失败用 JSON-RPC `error`。

use libc.syscall;
use libc.unistd;
use libc.heap;

const LINE_MAX: usize = 1048576;
const OUT_MAX: usize = 65536;

fn emit_tool_text(id: i64, text: &const byte, n: usize, is_err: bool) void {
    var out: [byte: OUT_MAX] = [0: OUT_MAX];
    var w: usize = 0;
    w = w + j_put(&out[0: OUT_MAX], w, "{\"jsonrpc\":\"2.0\",\"id\":" as &const byte);
    w = w + j_put_i64(&out[0: OUT_MAX], w, id);
    w = w + j_put(&out[0: OUT_MAX], w,
        ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":" as &const byte);
    w = w + j_put_str(&out[0: OUT_MAX], w, text, n);
    if is_err {
        w = w + j_put(&out[0: OUT_MAX], w, "}],\"isError\":true}}\n" as &const byte);
    } else {
        w = w + j_put(&out[0: OUT_MAX], w, "}],\"isError\":false}}\n" as &const byte);
    }
    _ = fd_write_all(1, &out[0], w);
}

fn emit_error(id: i64, code: i64, msg: &const byte) void {
    var out: [byte: 512] = [0: 512];
    var w: usize = 0;
    w = w + j_put(&out[0: 512], w, "{\"jsonrpc\":\"2.0\",\"id\":" as &const byte);
    if id < 0 {
        w = w + j_put(&out[0: 512], w, "null" as &const byte);
    } else {
        w = w + j_put_i64(&out[0: 512], w, id);
    }
    w = w + j_put(&out[0: 512], w, ",\"error\":{\"code\":" as &const byte);
    w = w + j_put_i64(&out[0: 512], w, code);
    w = w + j_put(&out[0: 512], w, ",\"message\":" as &const byte);
    w = w + j_put_str(&out[0: 512], w, msg, b_len(msg));
    w = w + j_put(&out[0: 512], w, "}}\n" as &const byte);
    _ = fd_write_all(1, &out[0], w);
}

// 读一行；超限则丢弃整行（继续读到 '\n'）。返回字节数，0 = EOF
fn read_line(buf: &byte, cap: usize, over: &bool) usize {
    var i: usize = 0;
    while true {
        var c: [byte: 1] = [0: 1];
        const n: isize = sys_read(0, &c[0], 1) catch { 0 as isize; };
        if n <= 0 {
            return i;
        }
        if c[0] == 10 as byte {
            return i;
        }
        if i < cap {
            buf[i] = c[0];
            i = i + 1;
        } else {
            over[0] = true;
        }
    }
}

// `list` 的业务文本
fn do_list(t: &[byte]) usize {
    var w: usize = 0;
    w = w + j_put(t, w, "{\"success\":true,\"operation\":\"list\",\"data\":{\"operations\":[" as &const byte);
    var i: usize = 0;
    while i < registry_count() {
        if i > 0 {
            w = w + j_put(t, w, "," as &const byte);
        }
        w = w + j_put(t, w, "{\"name\":" as &const byte);
        const nm: &const byte = registry_name(i);
        w = w + j_put_str(t, w, nm, b_len(nm));
        w = w + j_put(t, w, ",\"mutates\":" as &const byte);
        if registry_mutates(i) {
            w = w + j_put(t, w, "true" as &const byte);
        } else {
            w = w + j_put(t, w, "false" as &const byte);
        }
        w = w + j_put(t, w, "}" as &const byte);
        i = i + 1;
    }
    w = w + j_put(t, w, "]}}" as &const byte);
    return w;
}

// 业务错误文本：`{"success":false,"error":{…}}`（isError 仍为 false）
fn do_business_error(t: &[byte], code: &const byte, msg: &const byte) usize {
    var w: usize = 0;
    w = w + j_put(t, w, "{\"success\":false,\"error\":{\"code\":" as &const byte);
    w = w + j_put_str(t, w, code, b_len(code));
    w = w + j_put(t, w, ",\"message\":" as &const byte);
    w = w + j_put_str(t, w, msg, b_len(msg));
    w = w + j_put(t, w, ",\"retryable\":false}}" as &const byte);
    return w;
}

fn handle_describe(id: i64, op: &const byte, opn: usize) void {
    var t: [byte: 4096] = [0: 4096];
    var w: usize = 0;
    if registry_find(op, opn) < 0 {
        w = do_business_error(&t[0: 4096],
            "OPERATION_NOT_FOUND" as &const byte,
            "operation not registered" as &const byte);
        emit_tool_text(id, &t[0], w, false);
        return;
    }
    w = w + j_put(&t[0: 4096], w, "{\"success\":true,\"operation\":" as &const byte);
    w = w + j_put_str(&t[0: 4096], w, op, opn);
    w = w + j_put(&t[0: 4096], w,
        ",\"data\":{\"input_schema\":{\"type\":\"object\",\"required\":[\"operation\",\"input\"]},\"output_schema\":{\"type\":\"object\"},\"permission\":\"write\"}}" as &const byte);
    emit_tool_text(id, &t[0], w, false);
}

fn handle_call(id: i64, line: &const byte, n: usize, op: &const byte, opn: usize) void {
    var t: [byte: 4096] = [0: 4096];
    var w: usize = 0;
    if registry_find(op, opn) < 0 {
        w = do_business_error(&t[0: 4096],
            "OPERATION_NOT_FOUND" as &const byte,
            "operation not registered" as &const byte);
        emit_tool_text(id, &t[0], w, false);
        return;
    }
    // input_hash：P1 只用整行做占位（P2 起按 operation+input 归一化后算）
    const h: u64 = fnv64(line, n);
    var rid: [byte: 128] = [0: 128];
    const has_rid: bool = j_field(line, n, "request_id" as &const byte, &rid[0: 128]);
    w = w + j_put(&t[0: 4096], w, "{\"success\":true,\"operation\":" as &const byte);
    w = w + j_put_str(&t[0: 4096], w, op, opn);
    if has_rid {
        w = w + j_put(&t[0: 4096], w, ",\"request_id\":" as &const byte);
        w = w + j_put_str(&t[0: 4096], w, &rid[0], b_len(&rid[0]));
    }
    w = w + j_put(&t[0: 4096], w, ",\"input_hash\":\"" as &const byte);
    w = w + j_put_hex(&t[0: 4096], w, h);
    w = w + j_put(&t[0: 4096], w, "\",\"data\":{\"status\":\"queued\",\"task_id\":\"task_p1_0001\"}}" as &const byte);
    emit_tool_text(id, &t[0], w, false);
}

// 一条请求 → 一条响应（或零条响应：通知）
fn handle_line(line: &const byte, n: usize) void {
    const id: i64 = j_id(line, n);
    if j_method_is(line, n, "initialize" as &const byte) {
        var out: [byte: 512] = [0: 512];
        var w: usize = 0;
        w = w + j_put(&out[0: 512], w, "{\"jsonrpc\":\"2.0\",\"id\":" as &const byte);
        w = w + j_put_i64(&out[0: 512], w, id);
        w = w + j_put(&out[0: 512], w,
            ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"drama\",\"version\":\"" as &const byte);
        w = w + j_put(&out[0: 512], w, version_string());
        w = w + j_put(&out[0: 512], w, "\"}}}\n" as &const byte);
        _ = fd_write_all(1, &out[0], w);
        return;
    }
    if j_method_is(line, n, "notifications/initialized" as &const byte) {
        return;
    }
    if j_method_is(line, n, "tools/list" as &const byte) {
        var out: [byte: 4096] = [0: 4096];
        var w: usize = 0;
        w = w + j_put(&out[0: 4096], w, "{\"jsonrpc\":\"2.0\",\"id\":" as &const byte);
        w = w + j_put_i64(&out[0: 4096], w, id);
        w = w + j_put(&out[0: 4096], w,
            ",\"result\":{\"tools\":[{\"name\":\"list\",\"description\":\"List business operations.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{},\"additionalProperties\":false}}," as &const byte);
        w = w + j_put(&out[0: 4096], w,
            "{\"name\":\"describe\",\"description\":\"Describe one operation contract.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\"}},\"required\":[\"operation\"]}}," as &const byte);
        w = w + j_put(&out[0: 4096], w,
            "{\"name\":\"call\",\"description\":\"Invoke one operation.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"operation\":{\"type\":\"string\"},\"input\":{\"type\":\"object\"},\"request_id\":{\"type\":\"string\"}},\"required\":[\"operation\",\"input\"]}}]}}\n" as &const byte);
        _ = fd_write_all(1, &out[0], w);
        return;
    }
    if j_method_is(line, n, "tools/call" as &const byte) {
        var tool: [byte: 64] = [0: 64];
        if !j_field(line, n, "name" as &const byte, &tool[0: 64]) {
            emit_error(id, -32602, "missing tool name" as &const byte);
            return;
        }
        const tn: usize = b_len(&tool[0]);
        var op: [byte: 128] = [0: 128];
        const has_op: bool = j_field(line, n, "operation" as &const byte, &op[0: 128]);
        if b_eq(&tool[0], tn, "list" as &const byte) {
            var t: [byte: 4096] = [0: 4096];
            const w: usize = do_list(&t[0: 4096]);
            emit_tool_text(id, &t[0], w, false);
            return;
        }
        if b_eq(&tool[0], tn, "describe" as &const byte) {
            if !has_op {
                var t2: [byte: 512] = [0: 512];
                const w2: usize = do_business_error(&t2[0: 512],
                    "SCHEMA_INVALID" as &const byte,
                    "describe requires arguments.operation" as &const byte);
                emit_tool_text(id, &t2[0], w2, false);
                return;
            }
            handle_describe(id, &op[0], b_len(&op[0]));
            return;
        }
        if b_eq(&tool[0], tn, "call" as &const byte) {
            if !has_op {
                var t3: [byte: 512] = [0: 512];
                const w3: usize = do_business_error(&t3[0: 512],
                    "SCHEMA_INVALID" as &const byte,
                    "call requires arguments.operation" as &const byte);
                emit_tool_text(id, &t3[0], w3, false);
                return;
            }
            handle_call(id, line, n, &op[0], b_len(&op[0]));
            return;
        }
        emit_error(id, -32602, "unknown tool" as &const byte);
        return;
    }
    if id >= 0 {
        emit_error(id, -32601, "Method not found" as &const byte);
    }
}

// `drama mcp serve`：读到 EOF 退出
export fn serve() i32 {
    var raw: &byte = malloc(LINE_MAX) as &byte;
    defer { free(raw as &void); }
    if (raw as usize) == 0 {
        say_err("drama: out of memory\n" as &const byte);
        return 1;
    }
    while true {
        var over: [bool: 1] = [false];
        const n: usize = read_line(raw, LINE_MAX, &over[0]);
        if over[0] {
            continue;
        }
        if n == 0 {
            break;
        }
        handle_line(raw as &const byte, n);
    }
    return 0;
}
