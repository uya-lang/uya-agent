// 人物外观/服装检查（模型辅助）+ 外观锚帧比对（像素门）。
// 两条判据分开：PSNR 是确定性的门（同一机位同一个人才能这么比），模型是
// 语义判断（"这身衣服和冻结文本对得上吗"）。口径见 docs/DRAMA_QA.md。

const VA_IMG_BUF: usize = 1048576;

// 布尔字段（JSON true/false）
fn vl_true(buf: &const byte, n: usize, key: &const byte) bool {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    if j_span(buf, n, key, &st[0], &ln[0]) == 0 as byte || ln[0] < 4 {
        return false;
    }
    return buf[st[0]] == 116 as byte;
}

// Bible 的 locks[character_id]：冻结的外观/服装文本
fn bible_lock_text(root: &const byte, rn: usize, pid: &const byte,
    pl: usize, ch: &const byte, chl: usize, out: &[byte],
    out_len: &usize) bool {
    out_len[0] = 0;
    if chl == 0 {
        return false;
    }
    var buf: &byte = malloc(65536) as &byte;
    defer { free(buf as &void); }
    if (buf as usize) == 0 {
        return false;
    }
    var bl: [usize: 1] = [0];
    if bible_get(root, rn, pid, pl, 0, &buf[0: 65536], &bl[0]) != 0 {
        return false;
    }
    var ls: [usize: 1] = [0];
    var ll: [usize: 1] = [0];
    if j_span(&buf[0], bl[0], "locks" as &const byte, &ls[0],
        &ll[0]) != 123 as byte {
        return false;
    }
    if ls[0] >= bl[0] || ls[0] > 60000 {
        return false;
    }
    return j_sub_str(&buf[0], ls[0], ll[0], ch, out, out_len);
}


// 两个图（都是项目内相对路径）的 PSNR，单位毫分贝；取不到回 -1
export fn va_psnr_mdb(root: &const byte, rn: usize, a: &const byte,
    an: usize, b: &const byte, bn: usize) i64 {
    var ap: [byte: 512] = [0: 512];
    var an2: [usize: 1] = [0];
    var bp: [byte: 512] = [0: 512];
    var bn2: [usize: 1] = [0];
    var tp: [byte: 512] = [0: 512];
    var tn: [usize: 1] = [0];
    if !path_join(root, rn, a, an, &ap[0: 512], &an2[0])
        || !path_join(root, rn, b, bn, &bp[0: 512], &bn2[0])
        || !path_join(root, rn, ".va.txt" as &const byte, 7, &tp[0: 512],
            &tn[0]) {
        return -1;
    }
    var cmd: [byte: 2048] = [0: 2048];
    var w: usize = 0;
    w = w + j_put(&cmd[0: 2048], w, "ffmpeg -nostats -i " as &const byte);
    w = quote_into(&cmd[0: 2048], w, &ap[0], an2[0]);
    w = w + j_put(&cmd[0: 2048], w, " -i " as &const byte);
    w = quote_into(&cmd[0: 2048], w, &bp[0], bn2[0]);
    w = w + j_put(&cmd[0: 2048], w,
        " -lavfi \"[0:v]scale=64:64,format=gray[x];" as &const byte);
    w = w + j_put(&cmd[0: 2048], w,
        "[1:v]scale=64:64,format=gray[y];[x][y]psnr\" " as &const byte);
    w = w + j_put(&cmd[0: 2048], w, "-f null - 2>&1 | grep -o \"average:" as
        &const byte);
    w = w + j_put(&cmd[0: 2048], w, "[0-9.a-z]*\" | tail -n 1 >" as
        &const byte);
    w = quote_into(&cmd[0: 2048], w, &tp[0], tn[0]);
    if w + 1 >= 2048 {
        return -1;
    }
    cmd[w] = 0 as byte;
    _ = system(&cmd[0]);
    var buf: [byte: 128] = [0: 128];
    var bl: [usize: 1] = [0];
    const ok: bool = read_file(root, rn, ".va.txt" as &const byte, 7,
        &buf[0], 128, &bl[0]);
    _ = unlink(&tp[0]);
    if !ok || bl[0] < 10 {
        return -1;
    }
    // 两张图一模一样时 ffmpeg 回 "average:inf"
    if bl[0] >= 11 && buf[8] == 105 as byte && buf[9] == 110 as byte
        && buf[10] == 102 as byte {
        return 999999;
    }
    // "average:7.546259" → 7546
    var i: usize = 8;
    var whole: i64 = 0;
    var frac: i64 = 0;
    var nd: i64 = 0;
    var dot: bool = false;
    while i < bl[0] {
        const c: byte = buf[i];
        if c >= 48 as byte && c <= 57 as byte {
            if dot {
                if nd < 3 {
                    frac = frac *| 10 +| (c - 48 as byte) as i64;
                    nd = nd + 1;
                }
            } else {
                whole = whole *| 10 +| (c - 48 as byte) as i64;
            }
            i = i + 1;
            continue;
        }
        if c == 46 as byte && !dot {
            dot = true;
            i = i + 1;
            continue;
        }
        break;
    }
    while nd < 3 {
        frac = frac *| 10;
        nd = nd + 1;
    }
    return whole *| 1000 +| frac;
}

// 读整个文件到 malloc 的缓冲（图片最多 1 MB）
fn va_read(root: &const byte, rn: usize, rel: &const byte, n: usize,
    len_out: &usize) &byte {
    len_out[0] = 0;
    var pb: [byte: 512] = [0: 512];
    var pn: [usize: 1] = [0];
    if !path_join(root, rn, rel, n, &pb[0: 512], &pn[0]) {
        return 0 as &byte;
    }
    var st: Stat = Stat{};
    const src: i32 = sys_stat(&pb[0], &st) catch { -1 as i32; };
    if src != 0 || st.st_size <= 0 || st.st_size > 1048576 {
        return 0 as &byte;
    }
    var buf: &byte = malloc(VA_IMG_BUF) as &byte;
    if (buf as usize) == 0 {
        return 0 as &byte;
    }
    var bl: [usize: 1] = [0];
    if !read_file(root, rn, rel, n, buf, VA_IMG_BUF, &bl[0]) || bl[0] == 0 {
        free(buf as &void);
        return 0 as &byte;
    }
    len_out[0] = bl[0];
    return buf;
}

// 有没有在这段文字里出现某个词（模型回话里的 DRIFT / OK）
fn va_has(buf: &const byte, n: usize, w: &const byte, wn: usize) bool {
    if wn == 0 || n < wn {
        return false;
    }
    var i: usize = 0;
    while i + wn <= n {
        var k: usize = 0;
        var hit: bool = true;
        while k < wn {
            if buf[i + k] != w[k] {
                hit = false;
                break;
            }
            k = k + 1;
        }
        if hit {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// 问一次模型：给图 + 冻结文本，要它先回 OK / DRIFT 再解释
// 回 0 表示问到了，out 里是模型原话
fn va_ask(root: &const byte, rn: usize, img: &const byte, imn: usize,
    frozen: &const byte, fn2: usize, out: &[byte], out_len: &usize) i32 {
    out_len[0] = 0;
    var c: LlmConfig = LlmConfig{};
    const lrc: i32 = llm_config_load(root, rn, &c);
    if lrc != 0 {
        return 81;
    }
    if c.is_mock {
        return 83;
    }
    var raw: [usize: 1] = [0];
    var fb: &byte = va_read(root, rn, img, imn, &raw[0]);
    defer { free(fb as &void); }
    if (fb as usize) == 0 {
        return 87;
    }
    // base64：输入先拷进数组（切片参数要给数组）
    var src: [byte: VA_IMG_BUF] = [0: VA_IMG_BUF];
    _ = copy_to(fb, raw[0], &src[0: VA_IMG_BUF], &raw[0]);
    var n64: usize = ((raw[0] + 2) / 3) * 4;
    if n64 + 1 > VA_IMG_BUF {
        return 91;
    }
    var b64: &byte = malloc(n64 + 8) as &byte;
    defer { free(b64 as &void); }
    if (b64 as usize) == 0 {
        return 91;
    }
    const enc: usize = encode_base64(&src[0: raw[0]], &b64[0: n64]) catch {
        return 91;
    };
    // 请求体
    const body_cap: usize = 1572864;
    var body: &byte = malloc(body_cap) as &byte;
    defer { free(body as &void); }
    if (body as usize) == 0 {
        return 91;
    }
    var w: usize = 0;
    w = w + j_put(&body[0: body_cap], w,
        "{\"model\":" as &const byte);
    w = w + j_put_str(&body[0: body_cap], w, &c.model[0],
        c.model_len);
    w = w + j_put(&body[0: body_cap], w,
        ",\"stream\":false,\"messages\":[{\"role\":\"user\",\"content\":[" as
        &const byte);
    w = w + j_put(&body[0: body_cap], w,
        "{\"type\":\"text\",\"text\":" as &const byte);
    var pb: [byte: 1024] = [0: 1024];
    var pw: usize = 0;
    pw = pw + j_put(&pb[0: 1024], pw,
        "只看这张图里的人物外观与服装。冻结文本：" as &const byte);
    var k: usize = 0;
    while k < fn2 && k < 400 {
        pb[pw + k] = frozen[k];
        k = k + 1;
    }
    pw = pw + k;
    pw = pw + j_put(&pb[0: 1024], pw,
        "。第一行只回一个词：OK（对得上）或 DRIFT（对不上）；" as &const byte);
    pw = pw + j_put(&pb[0: 1024], pw,
        "第二行一句话说明差在哪。不要思考过程。" as &const byte);
    w = w + j_put_str(&body[0: body_cap], w, &pb[0], pw);
    w = w + j_put(&body[0: body_cap], w,
        "},{\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64," as
        &const byte);
    w = w + j_put_raw(&body[0: body_cap], w, b64, enc);
    w = w + j_put(&body[0: body_cap], w,
        "\"}}]}]}" as &const byte);
    if w + 1 >= body_cap {
        return 91;
    }
    body[w] = 0 as byte;
    const resp_cap: usize = 1048576;
    var resp: &byte = malloc(resp_cap) as &byte;
    defer { free(resp as &void); }
    if (resp as usize) == 0 {
        return 91;
    }
    var rl: [usize: 1] = [0];
    var status: [i32: 1] = [0];
    var hdr: [usize: 1] = [0];
    const rc: i32 = httpc_post(&c.host[0], c.host_len, c.port,
        c.use_tls, &c.path[0], c.path_len, body, w,
        &c.api_key[0], c.api_key_len, 60000,
        &resp[0: resp_cap], &rl[0], &status[0], &hdr[0]);
    if rc != 0 {
        return rc;
    }
    if status[0] != 200 {
        return 82;
    }
    if hdr[0] >= rl[0] {
        return 73;
    }
    const bn: usize = rl[0] - hdr[0];
    var txt: [usize: 1] = [0];
    var tl: [usize: 1] = [0];
    if j_span(&resp[hdr[0]], bn, "content" as &const byte, &txt[0],
        &tl[0]) == 0 as byte {
        return 73;
    }
    var s0: usize = txt[0] + 1;
    var ln0: usize = 0;
    if tl[0] >= 2 {
        ln0 = tl[0] - 2;
    }
    if ln0 == 0 || s0 >= rl[0] {
        return 73;
    }
    var note: [byte: 4096] = [0: 4096];
    var o: usize = 0;
    const at: usize = hdr[0] + s0;
    while o < ln0 && o < 4096 && at < rl[0] && at < 65536
        && o < 4096 - 1 {
        note[o] = resp[at + o];
        o = o + 1;
    }
    _ = copy_to(&note[0], o, out, out_len);
    return 0;
}

// qa.appearance：人物外观/服装检查 + 外观锚帧比对
//   input: {project_id, character_id?, image, baseline?, min_psnr_db?,
//           use_model?, frozen?}
// 判据：
//   - 给了 baseline ⇒ 算 PSNR，低于 min_psnr_db 记 QA_ANCHOR_DRIFT；
//   - use_model ⇒ 问本机 VLM（llm.json 指向 vision 模型），第一行 DRIFT
//     ⇒ QA_APPEARANCE_DRIFT；
//   - 冻结文本优先用入参 frozen，其次用 Bible 的 locks[character_id]。
export fn op_qa_appearance(line: &const byte, n: usize, out: &[byte],
    out_len: &usize) i32 {
    out_len[0] = 0;
    var pid: [byte: 64] = [0: 64];
    var pl: [usize: 1] = [0];
    var img: [byte: 256] = [0: 256];
    var imn: [usize: 1] = [0];
    if !input_str(line, n, "project_id" as &const byte, &pid[0: 64],
        &pl[0])
        || !input_str(line, n, "image" as &const byte, &img[0: 256],
            &imn[0]) {
        return 13;
    }
    const root: &const byte = data_root_ptr();
    const rn: usize = data_root_len();
    var ch: [byte: 64] = [0: 64];
    var chl: [usize: 1] = [0];
    _ = input_str(line, n, "character_id" as &const byte, &ch[0: 64],
        &chl[0]);
    var base: [byte: 256] = [0: 256];
    var basel: [usize: 1] = [0];
    const has_base: bool = input_str(line, n, "baseline" as &const byte,
        &base[0: 256], &basel[0]);
    var min_db: i64 = int_arg(line, n, "min_psnr_db" as &const byte, 15);
    if min_db <= 0 || min_db > 60 {
        min_db = 15;
    }
    const use_model: bool = vl_true(line, n, "use_model" as &const byte);
    // 冻结文本：入参 > Bible locks
    var frozen: [byte: 512] = [0: 512];
    var fz: [usize: 1] = [0];
    if !input_str(line, n, "frozen" as &const byte, &frozen[0: 512],
        &fz[0]) {
        _ = bible_lock_text(root, rn, &pid[0], pl[0], &ch[0], chl[0],
            &frozen[0: 512], &fz[0]);
    }
    var psnr: i64 = -1;
    if has_base {
        psnr = va_psnr_mdb(root, rn, &base[0], basel[0], &img[0], imn[0]);
        if psnr < 0 {
            return 87;
        }
    }
    var model_rc: i32 = 0;
    var model_said: [byte: 4096] = [0: 4096];
    var msl: [usize: 1] = [0];
    var drift_model: bool = false;
    if use_model {
        model_rc = va_ask(root, rn, &img[0], imn[0], &frozen[0], fz[0],
            &model_said[0: 4096], &msl[0]);
        if model_rc == 0
            && va_has(&model_said[0], msl[0], "DRIFT" as &const byte, 5) {
            drift_model = true;
        }
    }
    const psnr_ok: bool = psnr >= min_db *| 1000;
    const judge_ok: bool = (!has_base || psnr_ok) && !drift_model;
    var w: usize = 0;
    w = w + j_put(out, w, "{\"image\":" as &const byte);
    w = w + j_put_str(out, w, &img[0], imn[0]);
    w = w + j_put(out, w, ",\"character_id\":" as &const byte);
    w = w + j_put_str(out, w, &ch[0], chl[0]);
    w = w + j_put(out, w, ",\"psnr_mdb\":" as &const byte);
    w = w + j_put_i64(out, w, psnr);
    w = w + j_put(out, w, ",\"min_psnr_mdb\":" as &const byte);
    w = w + j_put_i64(out, w, min_db *| 1000);
    w = w + j_put(out, w, ",\"psnr_ok\":" as &const byte);
    if !has_base || psnr_ok {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"model_used\":" as &const byte);
    if use_model && model_rc == 0 {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, ",\"model_rc\":" as &const byte);
    w = w + j_put_i64(out, w, model_rc as i64);
    w = w + j_put(out, w, ",\"model_verdict\":" as &const byte);
    if drift_model {
        w = w + j_put(out, w, "\"DRIFT\"" as &const byte);
    } else if use_model && model_rc == 0 {
        w = w + j_put(out, w, "\"OK\"" as &const byte);
    } else {
        w = w + j_put(out, w, "\"\"" as &const byte);
    }
    w = w + j_put(out, w, ",\"note\":" as &const byte);
    w = w + j_put_str(out, w, &model_said[0], msl[0]);
    w = w + j_put(out, w, ",\"ok\":" as &const byte);
    if judge_ok {
        w = w + j_put(out, w, "true" as &const byte);
    } else {
        w = w + j_put(out, w, "false" as &const byte);
    }
    w = w + j_put(out, w, "}" as &const byte);
    out_len[0] = w;
    return 0;
}
