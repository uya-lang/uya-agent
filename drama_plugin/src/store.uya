// drama_plugin/src/store.uya — 基础存储：路径、目录、原子写、读回
//
// 契约（DESIGN §8.2 / P0 txn 原型结论）：
//   * 写入先落 `<name>.tmp`（O_CREAT|O_EXCL|O_WRONLY + 0600），写完 rename；
//   * 没有 fsync（stdlib 没有），所以只承诺「不留半个文件 + 崩溃后可重建」；
//   * 所有路径都是显式拼接 + 边界校验，不接受调用方给的任意绝对路径；
//   * 每类 JSON 自带 `format_version`，读到不认识的版本由上层进只读故障态。
//
// 为什么要自己拼路径：`sys_*` 收 C 串（必须 NUL 结尾），而 Uya 的字符串
// 切片不带 NUL；这里统一在本地缓冲里补 0 再调。

use libc.syscall;
use libc.unistd;

const PATH_MAX: usize = 512;
const TMP_SUFFIX: &const byte = ".tmp" as &const byte;

// a + "/" + b（NUL 结尾）；放不下就整体失败，绝不截断
export fn path_join(a: &const byte, an: usize, b: &const byte, bn: usize,
    out: &[byte], out_len: &usize) bool {
    if an + bn + 2 > out.len {
        return false;
    }
    var i: usize = 0;
    while i < an {
        out[i] = a[i];
        i = i + 1;
    }
    if an > 0 && a[an - 1] != 47 as byte {
        out[i] = 47 as byte;
        i = i + 1;
    }
    var k: usize = 0;
    while k < bn {
        out[i] = b[k];
        i = i + 1;
        k = k + 1;
    }
    out[i] = 0 as byte;
    out_len[0] = i;
    return true;
}

// a + "/" + b + "/" + c
export fn path_join3(a: &const byte, an: usize, b: &const byte, bn: usize,
    c: &const byte, cn: usize, out: &[byte], out_len: &usize) bool {
    var mid: [byte: PATH_MAX] = [0: PATH_MAX];
    var ml: usize = 0;
    if !path_join(a, an, b, bn, &mid[0: PATH_MAX], &ml) {
        return false;
    }
    return path_join(&mid[0], ml, c, cn, out, out_len);
}

// 逐级 mkdir；已存在不算错
export fn mkdir_p(path: &const byte, n: usize) bool {
    var i: usize = 1;
    while i <= n {
        if i == n || path[i] == 47 as byte {
            var buf: [byte: PATH_MAX] = [0: PATH_MAX];
            if i >= PATH_MAX {
                return false;
            }
            var k: usize = 0;
            while k < i {
                buf[k] = path[k];
                k = k + 1;
            }
            buf[i] = 0 as byte;
            _ = sys_mkdir(&buf[0], 493) catch {
                // 已存在 / 不可创建：都不在这里报错，交给后续 open 判定
                0 as i32;
            };
        }
        i = i + 1;
    }
    return true;
}

fn exists(path: &const byte) bool {
    const fd: i32 = sys_open(path, 0 as i32, 0) catch {
        return false;
    };
    _ = sys_close(fd) catch { 0 as i32; };
    return true;
}

// 原子写：<dir>/<name> ← data。dir 不存在会先建。
export fn write_atomic(dir: &const byte, dn: usize, name: &const byte,
    nn: usize, data: &const byte, dl: usize) bool {
    var dpath: [byte: PATH_MAX] = [0: PATH_MAX];
    var dl2: usize = 0;
    if !path_join(dir, dn, "" as &const byte, 0, &dpath[0: PATH_MAX], &dl2) {
        return false;
    }
    if !mkdir_p(&dpath[0], dl2 - 1) {
        return false;
    }
    var tmpname: [byte: 256] = [0: 256];
    var tn: usize = 0;
    if nn + 4 >= 256 {
        return false;
    }
    var i: usize = 0;
    while i < nn {
        tmpname[i] = name[i];
        i = i + 1;
    }
    var k: usize = 0;
    while k < 4 {
        tmpname[nn + k] = TMP_SUFFIX[k];
        k = k + 1;
    }
    tn = nn + 4;
    var tpath: [byte: PATH_MAX] = [0: PATH_MAX];
    var tl: usize = 0;
    if !path_join(dir, dn, &tmpname[0], tn, &tpath[0: PATH_MAX], &tl) {
        return false;
    }
    var fpath: [byte: PATH_MAX] = [0: PATH_MAX];
    var fl: usize = 0;
    if !path_join(dir, dn, name, nn, &fpath[0: PATH_MAX], &fl) {
        return false;
    }
    // 陈旧 tmp 先清掉（O_EXCL 才不会误判）
    _ = sys_unlink(&tpath[0]) catch { 0 as i32; };
    // O_WRONLY(1) | O_CREAT(64) | O_EXCL(128)，权限 0600
    const flags: i32 = (1 + 64 + 128) as i32;
    const fd: i32 = sys_open(&tpath[0], flags, 384) catch {
        return false;
    };
    var wrote: usize = 0;
    while wrote < dl {
        const got: isize = sys_write(fd, &data[wrote], dl - wrote) catch {
            _ = sys_close(fd) catch { 0 as i32; };
            _ = sys_unlink(&tpath[0]) catch { 0 as i32; };
            return false;
        };
        if got <= 0 {
            _ = sys_close(fd) catch { 0 as i32; };
            _ = sys_unlink(&tpath[0]) catch { 0 as i32; };
            return false;
        }
        wrote = wrote + (got as usize);
    }
    _ = sys_close(fd) catch { 0 as i32; };
    const rc: i32 = sys_rename(&tpath[0], &fpath[0]) catch {
        _ = sys_unlink(&tpath[0]) catch { 0 as i32; };
        return false;
    };
    _ = rc;
    return true;
}

// 读整个文件；成功返回 true 并写 out_len
export fn read_file(dir: &const byte, dn: usize, name: &const byte,
    nn: usize, buf: &byte, cap: usize, out_len: &usize) bool {
    out_len[0] = 0;
    var fpath: [byte: PATH_MAX] = [0: PATH_MAX];
    var fl: usize = 0;
    if !path_join(dir, dn, name, nn, &fpath[0: PATH_MAX], &fl) {
        return false;
    }
    const fd: i32 = sys_open(&fpath[0], 0 as i32, 0) catch {
        return false;
    };
    var total: usize = 0;
    while total < cap {
        const got: isize = sys_read(fd, &buf[total], cap - total) catch {
            break;
        };
        if got <= 0 {
            break;
        }
        total = total + (got as usize);
    }
    _ = sys_close(fd) catch { 0 as i32; };
    out_len[0] = total;
    return true;
}

// 读出来的 JSON 是否是认识的 format_version（不认识 ⇒ 上层进只读故障态）
export fn fmt_version_ok(buf: &[byte], n: usize, want: i64) bool {
    var st: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    const k: byte = j_span(&buf[0], n, "format_version" as &const byte,
        &st[0], &ln[0]);
    if k == 0 as byte || k == 34 as byte || k == 123 as byte {
        return false;
    }
    var i: usize = 0;
    var v: i64 = 0;
    while i < ln[0] {
        const c: byte = buf[st[0] + i];
        if c < 48 as byte || c > 57 as byte {
            break;
        }
        v = v *| 10;
        v = v +| (c as i64) -| 48;
        i = i + 1;
    }
    return v == want;
}

// 同上，但收指针 + 长度（canon 这类"缓冲区 + 长度"的调用方用）
// 只看开头 512 字节（format_version 写在最前面）；缓冲区必须多留一格，
// 因为 copy_to 会补一个 0 结尾。以前 take 与缓冲区同为 512，凡 ≥512 字节的
// 状态文件都被判成"格式不认识"（第 11 集之后 canon.json 就过 512 字节）。
export fn fmt_version_ok_p(p: &const byte, n: usize, want: i64) bool {
    var tmp: [byte: 520] = [0: 520];
    var tl: usize = 0;
    var take: usize = 512;
    if n < 512 {
        take = n;
    }
    if !copy_to(p, take, &tmp[0: 520], &tl) {
        return false;
    }
    return fmt_version_ok(&tmp[0: 520], tl, want);
}

// 文件是否存在（给"已存在"判定用）
export fn file_exists(dir: &const byte, dn: usize, name: &const byte,
    nn: usize) bool {
    var fpath: [byte: PATH_MAX] = [0: PATH_MAX];
    var fl: usize = 0;
    if !path_join(dir, dn, name, nn, &fpath[0: PATH_MAX], &fl) {
        return false;
    }
    return exists(&fpath[0]);
}
