+// 从"裸握手消息流"抓证书链。
+//
+// 为什么需要这条路径：`hs_remember_message` 保存服务器 flight 时**跳过了 5 字节
+// 记录头**（`&send_buf[5]`），所以 `server_flight_msg` 里是裸握手消息
+// （首字节就是消息类型：2=ServerHello、11=Certificate…）。只按记录头解析的实现
+// 会在第一步 `data[0] != 22` 处直接返回，链永远抓不到 ⇒ 客户端永远
+// `peer_verified=false` ⇒ 校验证书的 HTTPS 一律握手失败。
+fn ssl_capture_peer_chain_bare(ctx: &SslContext, data: &const byte, data_len: usize) void {
+    var pos: usize = 0;
+    while pos + 4 <= data_len {
+        const mtype: byte = data[pos];
+        const mlen: usize = ssl_read_u24(&data[pos + 1]);
+        if pos + 4 + mlen > data_len {
+            return;
+        }
+        if mtype == SSL_TLS_HANDSHAKE_CERTIFICATE {
+            if mlen < 6 {
+                return;
+            }
+            const chain_len: usize = ssl_read_u24(&data[pos + 4]);
+            var cert_pos: usize = pos + 7;
+            const chain_end: usize = cert_pos + chain_len;
+            if chain_end > pos + 4 + mlen {
+                return;
+            }
+            while cert_pos + 3 <= chain_end
+                && ctx.peer_chain_storage_count < SSL_PEER_CHAIN_MAX {
+                const cert_len: usize = ssl_read_u24(&data[cert_pos]);
+                cert_pos = cert_pos + 3;
+                if cert_pos + cert_len > chain_end {
+                    return;
+                }
+                cert_parse(&data[cert_pos], cert_len,
+                    &ctx.peer_chain_storage[ctx.peer_chain_storage_count]) catch {
+                    return;
+                };
+                ctx.peer_chain_storage_count = ctx.peer_chain_storage_count + 1;
+                cert_pos = cert_pos + cert_len;
+            }
+            if ctx.peer_chain_storage_count > 0 {
+                ctx.peer_leaf = &ctx.peer_chain_storage[0] as &const Cert;
+                if ctx.peer_chain_storage_count > 1 {
+                    ctx.peer_chain = &ctx.peer_chain_storage[1] as &const Cert;
+                    ctx.peer_chain_len = ctx.peer_chain_storage_count - 1;
+                } else {
+                    ctx.peer_chain = null as &const Cert;
+                    ctx.peer_chain_len = 0;
+                }
+            }
+            return;
+        }
+        pos = pos + 4 + mlen;
+    }
+}
