// drama_plugin/proto/https_probe.uya
//
// P0 探针：stdlib 的 HTTPS 客户端到底能不能用。
//
// 两条路径都测：
//   默认配置（校验证书）  -> 实测在 "Handshake not done (peer not verified)" 失败
//   insecure（跳过校验）  -> 实测握手完成、status 200
//
// 运行（这一步要联网）：
//   UYA_ROOT=<repo>/uya/stdlib <repo>/uya/bin/uya build https_probe.uya -o /tmp/p
//   /tmp/p insecure     # 期望 stderr 出现 S: 200
//   /tmp/p              # 期望 stderr 出现 ERR https_get + peer not verified
//
// 结论记在 P0_FINDINGS §1.10：客户端存在、证书校验未完成。

use libc.syscall;
use std.runtime;
use tls.https;

fn fetch(host: &const byte, path: &[byte], insecure: bool) !HttpsResponse {
    if insecure {
        return https_get_insecure(host, 11, 443 as u16, path);
    }
    return https_get(host, 11, 443 as u16, path);
}

export fn main() i32 {
    const host: &const byte = "example.com" as &const byte;
    var path: [byte: 16] = [0: 16];
    path[0] = 47 as byte;   // '/'
    // 参数：带 `insecure` 就走跳过证书校验的路径，否则走默认（校验）路径
    var insecure: bool = false;
    if get_argc() > 1 {
        const a: &byte = get_argv(1);
        if a[0] == 105 as byte && a[1] == 110 as byte && a[2] == 115 as byte {
            insecure = true;
        }
    }
    _ = sys_write(2, "MODE " as &const byte, 5) catch { 0 as isize; };
    if insecure {
        _ = sys_write(2, "insecure\n" as &const byte, 9) catch { 0 as isize; };
    } else {
        _ = sys_write(2, "verified\n" as &const byte, 9) catch { 0 as isize; };
    }
    const resp2: HttpsResponse = fetch(host, &path[0: 1], insecure) catch {
        _ = sys_write(2, "ERR https_get\n" as &const byte, 14) catch { 0 as isize; };
        return 1;
    };
    // 把状态码打到 stderr，便于脚本断言
    var buf: [byte: 32] = [0: 32];
    buf[0] = 83 as byte; buf[1] = 58 as byte; buf[2] = 32 as byte;
    var st: i32 = resp2.status;
    var n: usize = 3;
    var tmp: [byte: 8] = [0: 8];
    var k: usize = 0;
    if st == 0 { tmp[0] = 48 as byte; k = 1; }
    while st > 0 {
        const t10: i32 = (st / 10) *| 10;
        const rem: i32 = st -| t10;
        tmp[k] = (rem +| 48) as! byte catch { 48 as byte; };
        k = k + 1;
        st = st / 10;
    }
    while k > 0 {
        k = k - 1;
        buf[n] = tmp[k];
        n = n + 1;
    }
    buf[n] = 10 as byte;
    n = n + 1;
    _ = sys_write(2, &buf[0], n) catch { 0 as isize; };
    return 0;
}
