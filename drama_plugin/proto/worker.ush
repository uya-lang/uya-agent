// drama_plugin/proto/worker.ush
//
// P0 原型 B4 的补充：Worker 的中断/重启语义 —— "杀进程后从检查点继续，
// 且已完成的步骤不会被重复执行"。
//
// 它只做一件事，但正是 DESIGN §9.3 的核心断言：
//   每个步骤完成后追加一行 `done <n>`（追加写 + close），
//   启动时读 journal 找到最大已完成步骤，从下一 步继续。
//
// stdin 命令：
//   run <dir> <steps>   跑 steps 个步骤（每步 sleep 200ms，便于中途杀）
//   state <dir>         打印 DONE <n> / NEXT <k>
//   q                   退出
//
// 输出：
//   STEP <n>            开始第 n 步
//   DONE <n>            完成第 n 步
//   FINAL <n>           全部完成
//   RESUME <k>          从第 k 步继续（k=1 表示没有历史）

use libc.syscall;
use libc.unistd;
use libc.heap;

const LINE_MAX: usize = 1024;
const JMAX: usize = 65536;

const O_RDONLY: i32 = 0;
const O_WRONLY: i32 = 1;
const O_CREAT: i32 = 64;
const O_APPEND: i32 = 1024;
const MODE_0600: i32 = 384;

fn slen(p: &const byte) usize {
    var i: usize = 0;
    while p[i] != 0 as byte {
        i = i + 1;
    }
    return i;
}

fn say(p: &const byte) void {
    _ = sys_write(1, p, slen(p)) catch { 0 as isize; };
}

fn write_all(fd: i32, p: &const byte, n: usize) bool {
    var off: usize = 0;
    while off < n {
        const w: isize = sys_write(fd, &p[off], n - off) catch { -1 as isize; };
        if w <= 0 {
            return false;
        }
        off = off + (w as usize);
    }
    return true;
}

fn put_byte_fd(fd: i32, c: byte) void {
    var one: [byte: 1] = [c];
    _ = write_all(fd, &one[0], 1);
}

fn say_num(prefix: &const byte, v: i64) void {
    say(prefix);
    var tmp: [byte: 24] = [0: 24];
    var n: usize = 0;
    var x: i64 = v;
    if x < 0 {
        say("-" as &const byte);
        x = 0 -| x;
    }
    while x > 0 {
        const t10: i64 = (x / 10) *| 10;
        const rem: i64 = x -| t10;
        tmp[n] = (rem +| 48) as! byte catch { 48 as byte; };
        n = n + 1;
        x = x / 10;
    }
    if n == 0 {
        say("0" as &const byte);
    }
    while n > 0 {
        n = n - 1;
        put_byte_fd(1, tmp[n]);
    }
    say("\n" as &const byte);
}

fn sleep_ms(ms: i64) void {
    var req: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    req.tv_sec = ms / 1000;
    const sec_ms: i64 = req.tv_sec *| 1000;
    req.tv_nsec = (ms -| sec_ms) *| 1000000;
    var rem: TimeSpec = TimeSpec{ tv_sec: 0, tv_nsec: 0 };
    _ = sys_nanosleep(&req, &rem) catch { 0 as i32; };
}

fn read_line(buf: &byte, cap: usize) usize {
    var i: usize = 0;
    while true {
        var c: [byte: 1] = [0: 1];
        const n: isize = sys_read(0, &c[0], 1) catch { 0 as isize; };
        if n <= 0 {
            return i;
        }
        if c[0] == 10 as byte {
            return i;
        }
        if i < cap {
            buf[i] = c[0];
            i = i + 1;
        }
    }
}

fn starts_with(line: &const byte, n: usize, want: &const byte) bool {
    const wl: usize = slen(want);
    if n < wl {
        return false;
    }
    var i: usize = 0;
    while i < wl {
        if line[i] != want[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
}

fn copy_span(line: &const byte, n: usize, at: usize, ln: usize, out: &[byte]) bool {
    if at + ln > n || ln + 1 > out.len {
        return false;
    }
    var i: usize = 0;
    while i < ln {
        out[i] = line[at + i];
        i = i + 1;
    }
    out[ln] = 0 as byte;
    return true;
}

fn arg_at(line: &const byte, n: usize, from: usize, at: &usize, ln: &usize) bool {
    var i: usize = from;
    while i < n && line[i] == 32 as byte {
        i = i + 1;
    }
    const s: usize = i;
    while i < n && line[i] != 32 as byte {
        i = i + 1;
    }
    if i == s {
        return false;
    }
    at[0] = s;
    ln[0] = i - s;
    return true;
}

fn parse_num(p: &const byte, n: usize) i64 {
    var v: i64 = 0;
    var digits: usize = 0;
    var i: usize = 0;
    while i < n {
        const c: byte = p[i];
        if c < 48 as byte || c > 57 as byte {
            return -1;
        }
        v = (v *| 10) +| ((c as i64) - 48);
        digits = digits + 1;
        i = i + 1;
    }
    if digits == 0 {
        return -1;
    }
    return v;
}

// journal 路径 = <dir>/journal.log
fn journal_path(dir: &const byte, plen: usize, out: &[byte]) bool {
    const suffix: &const byte = "/journal.log";
    const sl: usize = 12;
    if plen + sl + 1 > out.len {
        return false;
    }
    var i: usize = 0;
    while i < plen {
        out[i] = dir[i];
        i = i + 1;
    }
    i = 0;
    while i < sl {
        out[plen + i] = suffix[i];
        i = i + 1;
    }
    out[plen + sl] = 0 as byte;
    return true;
}

// 读 journal，返回最大已完成步骤（0 = 没有）
fn max_done(path: &const byte) i64 {
    const fd: i32 = sys_open(path, O_RDONLY, 0) catch { -1 as i32; };
    if fd < 0 {
        return 0;
    }
    defer { _ = sys_close(fd) catch { 0 as i32; }; }
    var buf: &byte = malloc(JMAX) as &byte;
    defer { free(buf as &void); }
    if (buf as usize) == 0 {
        return 0;
    }
    var total: usize = 0;
    while total < JMAX {
        const got: isize = sys_read(fd, &buf[total], JMAX - total) catch { -1 as isize; };
        if got <= 0 {
            break;
        }
        total = total + (got as usize);
    }
    // 逐行解析 "done <n>"
    var best: i64 = 0;
    var i: usize = 0;
    while i < total {
        var e: usize = i;
        while e < total && buf[e] != 10 as byte {
            e = e + 1;
        }
        var line: &const byte = &buf[i];
        const ln: usize = e - i;
        if ln > 5 && line[0] == 100 as byte && line[1] == 111 as byte
            && line[2] == 110 as byte && line[3] == 101 as byte
            && line[4] == 32 as byte {
            const v: i64 = parse_num(&line[5], ln - 5);
            if v > best {
                best = v;
            }
        }
        i = e + 1;
    }
    return best;
}

fn append_done(path: &const byte, step: i64) bool {
    const fd: i32 = sys_open(path, O_WRONLY | O_CREAT | O_APPEND, MODE_0600)
        catch { -1 as i32; };
    if fd < 0 {
        return false;
    }
    defer { _ = sys_close(fd) catch { 0 as i32; }; }
    const head: &const byte = "done ";
    var i: usize = 0;
    while i < 5 {
        put_byte_fd(fd, head[i]);
        i = i + 1;
    }
    var tmp: [byte: 24] = [0: 24];
    var n: usize = 0;
    var x: i64 = step;
    while x > 0 {
        const t10: i64 = (x / 10) *| 10;
        const rem: i64 = x -| t10;
        tmp[n] = (rem +| 48) as! byte catch { 48 as byte; };
        n = n + 1;
        x = x / 10;
    }
    while n > 0 {
        n = n - 1;
        put_byte_fd(fd, tmp[n]);
    }
    put_byte_fd(fd, 10 as byte);
    return true;
}

fn run_steps(dir: &const byte, dlen: usize, steps: i64) void {
    var jp: [byte: 512] = [0: 512];
    if !journal_path(dir, dlen, &jp[0: 512]) {
        say("ERR path too long\n" as &const byte);
        return;
    }
    const done0: i64 = max_done(&jp[0]);
    say_num("RESUME " as &const byte, done0 +| 1);
    var step: i64 = done0 +| 1;
    while step <= steps {
        say_num("STEP " as &const byte, step);
        sleep_ms(200);
        if !append_done(&jp[0], step) {
            say("ERR journal\n" as &const byte);
            return;
        }
        say_num("DONE " as &const byte, step);
        step = step +| 1;
    }
    say_num("FINAL " as &const byte, steps);
}

fn report_state(dir: &const byte, dlen: usize) void {
    var jp: [byte: 512] = [0: 512];
    if !journal_path(dir, dlen, &jp[0: 512]) {
        say("ERR path too long\n" as &const byte);
        return;
    }
    const d: i64 = max_done(&jp[0]);
    say_num("DONE " as &const byte, d);
    say_num("NEXT " as &const byte, d +| 1);
}

export fn main() i32 {
    var raw: &byte = malloc(LINE_MAX) as &byte;
    defer { free(raw as &void); }
    if (raw as usize) == 0 {
        return 1;
    }
    var at: [usize: 1] = [0];
    var ln: [usize: 1] = [0];
    while true {
        const n: usize = read_line(raw, LINE_MAX);
        if n == 0 {
            break;
        }
        const line: &const byte = raw as &const byte;
        if starts_with(line, n, "q" as &const byte) {
            break;
        }
        var pb: [byte: 512] = [0: 512];
        if starts_with(line, n, "run " as &const byte) {
            if !arg_at(line, n, 4, &at[0], &ln[0])
                || !copy_span(line, n, at[0], ln[0], &pb[0: 512]) {
                say("ERR usage: run <dir> <steps>\n" as &const byte);
                continue;
            }
            const dlen: usize = ln[0];
            if !arg_at(line, n, at[0] + dlen, &at[0], &ln[0]) {
                say("ERR usage: run <dir> <steps>\n" as &const byte);
                continue;
            }
            var nb: [byte: 24] = [0: 24];
            if !copy_span(line, n, at[0], ln[0], &nb[0: 24]) {
                continue;
            }
            const steps: i64 = parse_num(&nb[0], ln[0]);
            if steps <= 0 {
                say("ERR steps\n" as &const byte);
                continue;
            }
            run_steps(&pb[0], dlen, steps);
            continue;
        }
        if starts_with(line, n, "state " as &const byte) {
            if !arg_at(line, n, 6, &at[0], &ln[0])
                || !copy_span(line, n, at[0], ln[0], &pb[0: 512]) {
                say("ERR usage: state <dir>\n" as &const byte);
                continue;
            }
            report_state(&pb[0], ln[0]);
            continue;
        }
        say("ERR unknown\n" as &const byte);
    }
    return 0;
}
